=00_AQQ6C1148omzvB1tu70SeouCR0TMJle_wyzmemlB3eFxLw&oe=6AFC6875"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WInIqzWrvAQ7kNvwFT7GCz&_nc_oc=AdqpmJsYW93oqA0hNh4uVqCRWHvWQuaWXhr69PyOdfIhzzgqe2zEEHyx9i1n-CgvPxA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmz9G0PXrSY9k12qNsBjNFhWMXfDtz_RAzLK7ypZhq5g&oe=6AFC6729"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQU-Vjg5nxAQ7kNvwHZox4k&_nc_oc=AdoYmKq-Ek63Q7fkLhHvLGfgTV9gn2urIVxwGaIjXJZLKq1vEjmWl0gwB3bdu9qj5uw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_GNZy0CO-Cc2QwoG3rkMxTTgKwgcyCGPDIRyAoyMtMw&oe=6AFC68EB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67Uy4NiCWLsQ7kNvwGb28GB&_nc_oc=Adpa8soEpYaSHmQAd8WY3bTxRsh26MoH4VeS9KYeUIBiXZ1wDNJ_LxgNXjhj3wUybEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI3NGCy6zwGehqApG3f1V-NXe4Y2pMbrkFmTHSjvYl9g&oe=6AFC910F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f14fYIza-dQQ7kNvwH7MlUg&_nc_oc=AdrKxS0UY-JwpJ6ttXzaSE_x3l3yBCsJ8VkgkK2QR8vff10B1iuYDBF7ATxGrLnR7HU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTDi2O5yN6GZu1fVCnz4sC1c5uWjUI7NAiZvHc3P9cOQ&oe=6AFC72E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28Yxbr3IAhwQ7kNvwGGE-aX&_nc_oc=AdrVQcmK7WTpHjAlTaYk7th6V2VnJEtB056c8kP8dCPs2E8heJG0C84jfL2JXh6Blcs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsNav-B2QCCq-y6YhO5UT2MS7sPk3kTDeWL6M3cfHh0Q&oe=6B0B21AB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2t20KdszoIQ7kNvwFXBY5d&_nc_oc=AdpCC-HRHHxG854YWujw8sX1U5MopNQluLNgk7U_FuWQPpFBCazoB48FXsH0V_MQE_0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDNv9g9smerzmuAUdZAf7YW4E8YjKLN0t_BrvOTDfO4A&oe=6B0B118F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRiy5zYqBxkQ7kNvwGebMqw&_nc_oc=Adorg5SVjwAjzuIex_do9gNWqiIbGFFt6eAM5Bx9X6C2fLJTK-33JICUfyICGaypBgc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPTssMA__BrZWGiIiaDE5uO6SAVL-vGIlaIrg0VzPq1g&oe=6B0B2BA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "267352502145255"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3616011291795395"}]}, "baseline_offer": {"id": "3616011291795395"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1605204000, "status": "PUBLISHED", "id": "3616011291795395"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3347073218734439", "version": "1.2"}, "id": "855578151638656", "channel_nam
=00_AQXarDn8vGwJKp-jPog5g-kjbePSkOYKBTbmRATfob8J5A&oe=6B0F15B5"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zf3P7OOkiqwQ7kNvwE8Ua-z&_nc_oc=Ado5oU1TzPh3XnXKNUl8e0zTfyjEgw0XAujMD93gtbTYs4BKsDVpm4yJ4-6EAt-B4s0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFmcs7Ztig3GjC0QWiMSf5xP0NLTBoeo6hkxh38yQ5Jg&oe=6B0F1469"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uiIUb3JK-oQ7kNvwGe57Fc&_nc_oc=AdpPt7opGHoWZJ5KSbR5R2ECsf_HZpy1JUA8G1uMUIPXsl5MN8Q8I1NRYttEqkmr-Uo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXaws4lI4eKDxJvrzyXCfaSs60WXXwgr5G6b-TQseUYnA&oe=6B0F162B"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtMVfTeHZXcQ7kNvwHIenc1&_nc_oc=AdpG5Y4Uys2Tw40YvDiXIGaHEJs1U3klFUIxn92Wwh2qotYZUprShkg1l9kbR0gy8SI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWjmQEgvkG4omAxrOt75r64_8P4mFpM1aCxFSl-494kA&oe=6B0F060F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQI91Q1JhxgQ7kNvwGc3krO&_nc_oc=AdpIH2cLxwXaVswYmvmHTi7M60sk6EBBcWxuQX3E9OUySGJ6gRCFtLk-xfNMbcwLFXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSlCpty0M3KFapE5q65FIutgxSjzGCiuHlGnf4QerAlQ&oe=6B0F2028"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzzoHmjCah8Q7kNvwF6BkFj&_nc_oc=AdovUBUOnXcWW4_9_UNt7ZxzPthff6YdLGTY_vOvSiKYAC6xSMjmp11CrXqL1DX2LfQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIAOELB08_dfR1aMWovzWrNWUHY9SyXzJ8CD-ON_eTFA&oe=6A54F8A9"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE9tJsbqz3sQ7kNvwEsADFy&_nc_oc=AdolHEtHukL4CSfU6spCtuQkcMRzzp58VfPusTk9aPGhCaFyczgDAyqReK-l8JCsIkY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_gL8pWYEKkxxPjxXY0ixwfc0M3n1Am5WgdZMP4C3GPg&oe=6A54FA6B"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDRlGkcn2fwQ7kNvwHiICbP&_nc_oc=Ador7gMzhcdF3Kzq_1WfLjtM5k3ZadWadzp3hJ83NSqfZgzMpMzH7cA-cBNEBVDvHEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsfII0BvSKxmSbtLgNXastT6VDkJbeUw3SEsv1jbvKrQ&oe=6A54EA4F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRxQ-QZ4W6MQ7kNvwEcuHgw&_nc_oc=AdoXt1ZjlXORmgVcOB-Rk4ej5oEIwTrw-EBpyfrxT04lKaXVq_Dji6gjmbxRdlJd_kI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Ohz3GPpq45vuO6QWYc-UICH81J2vqMoORBOh0KF81A&oe=6A550468"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "653358692678114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculu
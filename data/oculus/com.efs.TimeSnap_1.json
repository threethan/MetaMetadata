_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5iEw14F6wwQ7kNvwFF41HU&_nc_oc=AdpeYJNuMvqdcXuatBlxUiOwJC6qMoE_9aHDjupa6D3H5Hw8nG83G-dXldBYr7kXEyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaDpav0iabHK4rIO_OI3bXcdG4ofAm9zW_B4XFn00t1A&oe=69C269E9"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3agtN3Mn4AQ7kNvwFhr6fg&_nc_oc=AdppH2UHNRStFD-KdSzWiz7zToaxVuZrDmf4YjmT25bpWq3omb6p7aHN8vfBL9QYfpE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxK7xy-Gx1PY5HRGZc5rUgA2cSzauLxnQJbYqrv2hjNEg&oe=69C26BAB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JH-_RMJWu0Q7kNvwG8IAEh&_nc_oc=AdqDk6mOwjv6ty05vm4BUWwMOn10JZhElO1v4ZrrkbtSRqLXMakWx8jCNF_fAcwgnGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybUYcZk3q_NNGJLo7m4euCuAspLjPEb5an9eyCVodA4w&oe=69C293CF"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9VYZ4XA1jMQ7kNvwHmxg1R&_nc_oc=Adr-mhJI_AeJ9og4BxG3FzZJp_03Nh2AV4ch9gFzIbBzviqEhgfM4Ziodh7oWKBXezI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy66HU5RjXa1_jDHHFxpvKVP6fZMQFRG_wX3Hvojx5B9w&oe=69C275A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "653358692678114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculu
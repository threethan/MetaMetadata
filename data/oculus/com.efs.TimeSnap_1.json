=00_AQTIyTVvVNx5LNFVTlb4nQo3t-MFVu3VLnUeoG47V_sqtQ&oe=6B01E6B5"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR4D6CoYPqAQ7kNvwFNCYGl&_nc_oc=AdozEykbHtc2GJ9Dgj6pgodcPWSeLefWXaE6MkREASg5JNg0wLeyIgaJTS019X3xDuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGwsmiwTKO5H1e9NMGJehzIXCoS4vOG37WtfE6n-OG2w&oe=6B01E569"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws1SOjkyMk4Q7kNvwESZgQS&_nc_oc=AdpvHl0ugDBwikgLeRCVDQHL-KJZJrnZrf91beexAPG1F5v--rcHkZGSPOF7lbhrp_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7wJ6fCvVqaTwk1wZN0A6czZSGVsYLl4-RO-h0cC6MiQ&oe=6B01E72B"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk7Y3a08mDQQ7kNvwHKzGJ9&_nc_oc=AdpTg5QTUcT72I1kvOLmP4bxtMLpyseaSBstvb7kpcqVFMLAiV-YO1mrJfrHKukszxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaDa8stfAX5DRjND2dOn_Ruy33ruAL8o79k5Z0-9HyXg&oe=6B01D70F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik6JLKZYM-oQ7kNvwGRuc8V&_nc_oc=AdqXHCsRwMBmQFaTArrpdeHtSnY9bghB45eSZ5YpieXdu9TKw_NHdb6zpuq2oFmlk7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGZxgntFH8ONhomYq_oey-xRkA3Lqsg-BipE8bpnCWSA&oe=6B01B8E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z02-0aLEaSMQ7kNvwGoWb2o&_nc_oc=AdqEqDZChKAX9vok_PsHbCunYQpAcVIfNwW4FlSyK-uuLaDkmEP4XtqPbiktphrt6DE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzkcpjlJk0Bw2sPPGTj7JARJ_zxEdojgVS0yGLhSe4RQ&oe=6A6CB3A9"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9RDIFB42UoQ7kNvwEqw7vs&_nc_oc=AdpYjVeALWfJLfd9R4ubFOzZYQS7sl_ozbqRpDfu3N2imxwfzO5j7vbgCQygwrjR2cc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJMUgM68P2TdPQjqDhwBwCHa0H5c3RjCHddUML8m2EzQ&oe=6A6CB56B"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVPonTKezMwQ7kNvwFncZCm&_nc_oc=AdqJmZYEiEvp8853vMrIqwUdtVisa9gQiRPjflGhnYoXNW6hrFPaZCHqzftvOmACRTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjfp0FnUQN-O_GbgSR-z8JJjmycNHacLoghdq-5-RPlw&oe=6A6CA54F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdY88Ddjwq4Q7kNvwEy4OpG&_nc_oc=AdrXZOGZCsc78FvRy1rvqZWyMI1AK-05BEAKTF_3LLQB_1dJjXIficB-m3wtdoLGj4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGfjl8cBDuyqbBg0kuz1T682S7iAkOJRaraIUfEZRvxA&oe=6A6CBF68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "653358692678114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculu
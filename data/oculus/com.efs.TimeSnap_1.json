ohc=RYM0P4jG1-EQ7kNvwEouy4X&_nc_oc=Adp8C6szOLC0LSmUxO9rh688wwNbbIq_WK1FzFWXrXe6IOI642AiJJZdM6Yx2bT6xs0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1fV6x188vC8WUJXswRJFVn7oPaXTEqGuNmm11e8Ut0dw&oe=69F21829"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfo-Ch25tx8Q7kNvwE6yv__&_nc_oc=AdovIKzdpUvQVkumCfirIokyaLeBNaPGqwKXd349fnL4ghlg38iBGaxp81XfriNFsnw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1hGAMM2G-KFJ49vnxZG7F5QL0hwsBA-RfN_ytmkuaN9g&oe=69F219EB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQkwNlVYw6EQ7kNvwEbHMCT&_nc_oc=AdrAlr9qHW-i_H8JQNpw9Ddqrm1KkKBzLK4Hx_lnfPXoz_QQ-ZT4qO4mtMiyNNv0deQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wdQBWeLZZoOpiewKZN2n6qA1h7iKgQHcLplpdCeOGhg&oe=69F209CF"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY034pyYbtIQ7kNvwEcVo26&_nc_oc=AdrzvQmYm2x5wMaCjvjO4jTIOdyMUF9oojv-YKP4-AP8yMG7tP_qw_FzsS8TvG2CLpI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2ik6JFsp8vW73wdBJZ2KWjeQl6NAzXznvksUsY2u4f0w&oe=69F1EBA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "653358692678114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001693_386637445856346_8023834355871516827_n.png?stp=dst-png_s360x360&_nc_cat=1
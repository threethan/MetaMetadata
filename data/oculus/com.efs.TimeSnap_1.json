1688_347388886336803_3938685633159959883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbTej-OGGt8Q7kNvwHdi_YU&_nc_oc=AdoQzf2hu_LX1wnwdK926yYgYCIxAUKLrQdu7t6X0_bAWrnIG7gPDTcloITTsJouwsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84q8ZNE7ZRG2ekHJO7Z7oKP3e8gvp6QN1xz3HgnyJ1nA&oe=6A3FC226"}]}, "id": "920605115090481", "locale": "en_US", "screenshots": [{"file_name": "Screenshot1.png", "id": "1229688317403814", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575369_1229688320737147_6287395094218696818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oi_Z1iuTts8Q7kNvwFP9Xiy&_nc_oc=Adq4UIYcFteko_LZMwivX4m2hyPEGDhgQxd1gwduoHodqqW31WYL6ZOsrvXDcrf8Eps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T-7J7MaShpToC7EJakKQMuZ0d_vzVq4Ky1--2XLiZ2A&oe=6A3FE1F5"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAphbeMGWowQ7kNvwFrqIlm&_nc_oc=AdpSvRJ5S6V-01rMqDuWyfJMNatr38Uo8buyfpDEyb8Vy05nMJZk5D8wllgastpGeT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R8LeiGPitvp7OgtkUuMX0B1XE6ydMn6XdfH5EAi9_Fg&oe=6A3FE0A9"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xr3YZQNnqnMQ7kNvwFDvH0g&_nc_oc=AdpAWAD9MCgdds8OHR9KQgCXocsvEG5lZ1aoy-vUx_7gO10bLC74QpLpPbBYjF9NYoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CETNiDIb__8Uce0uisMtjeDb5Tee7t101HQFydo4fZg&oe=6A3FE26B"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pyCHJmsX94Q7kNvwG_KPlY&_nc_oc=Adq2-m1hZkhBP0vD1htNKQnrzCkzK0afj3d_If38diHCgFqn0HWlEx40mkzu5jKPS2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WfVDAadRHF1jkkU-LGhclaAF5vLx4KOLIQvEbBuzGsw&oe=6A3FD24F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTvG7mfADksQ7kNvwEFC9rz&_nc_oc=AdoVPofu3Gej4ZKRLByh033VfjVbG3CxhTR3U7T6X-gU2X_pK3CODv1jd8QzClDNA9M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fH9tE1Fd1Kyq11aE9i4p76WRJNftrxTmzFeYwnucxkw&oe=6A3FEC68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_po
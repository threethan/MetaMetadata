-25/39001688_347388886336803_3938685633159959883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5qS2lG3IM0Q7kNvwG_EpcY&_nc_oc=AdprlwnguTXW6vOvEK9tjc56MVJZ6mvLGlSlPCoR-oLAnm6ykrsgJkZIoMwGNpn-AUc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMDMobgAFSOMZZo05Bl6WYmC98eVqBGbL172ti79O_Xg&oe=6A7DB8A6"}]}, "id": "920605115090481", "locale": "en_US", "screenshots": [{"file_name": "Screenshot1.png", "id": "1229688317403814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57575369_1229688320737147_6287395094218696818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXIjt8XdSMgQ7kNvwEfpC-9&_nc_oc=AdrN_XgcftFxlmrYNCvjQS952HH6MN98fnUzqqmhPWltbkbN3yK0VfbT4e2uIaAVkdg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx3VQLHpUriijADQ6hMsvGMy6bAEUgpCbRraIfrPVJ0Q&oe=6A7DA035"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgjmwDsRb6sQ7kNvwEDbD-Y&_nc_oc=AdpOaITTBelHDMR4z1eqmGa3-fe9c4Zx7rsai8eWCdcq1WIMuklPF90Z78bgLdMLwBU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbawNbMrmD_ZqbULL9MhoCD-AL575xmkODQjMjCg-fYg&oe=6A7D9EE9"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A0D4IBvRZwQ7kNvwHKsbDx&_nc_oc=AdpMy_f2J-9gbvGUQx3cr2XYve-hrJ7b9sqN5EkfJJBkPeZUpHNk0eJVEO6ogD0UGOQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-GWBF7rqkjOOVZiEw4Z2ALnltoFnxnmsYkiyJdo_Oug&oe=6A7DA0AB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZIqpbxbwJsQ7kNvwEctNFs&_nc_oc=Ado4kDSr_A2R6I_e3sXBNKXCQeN07skeqL2c_XqKOSf5KPvu0Fh9QGqt5lo_KHSEfFk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcM6dOUqFVXeAaiYuFS7bBxE88_S8xKsuyMDuBYvg-TQ&oe=6A7DC8CF"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhtS3jL-23IQ7kNvwH-BC0i&_nc_oc=AdpQEYlaKcNc1DHZnANFMKcYBzWqKvc3mETACgqhOhTLE9Z3sPYT_VnHl5Ndxs8ua6s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHju7dln_HGsuY-GBsHy5TbzCqq0O-bwCY5d7E9CQzp2A&oe=6A7DAAA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_pr
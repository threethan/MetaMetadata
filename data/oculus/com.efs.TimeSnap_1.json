9992_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF1Ka2h451UQ7kNvwF4Yb93&_nc_oc=AdqRxJppCOIbHqjtZLUdNsRKSUYs5P3Pj0dVQsDeC9iTCyIYX7exDcgAiHlU_fba97A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V4nYTXvvdYveHNtSWe2D9_K0uooxm2V9fikCC8U6EzA&oe=6A36A629"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLUfEluT7yYQ7kNvwEcdBBq&_nc_oc=AdrbBkVQ9MfL7soPOkiYNz8PobMHmSoawL9vnE5s_8w9H0AOIM0Z3SEK7vGPLtOq4EY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X5ojbcp4ftHBaXpw0BZhfU_XV1EWHmO3apaPODXaN3A&oe=6A36A7EB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pz2mhzpq98Q7kNvwGIJoC7&_nc_oc=AdrzgmFo4eHUWAKnAqNeljcr9LxS5c9IV8JPDo3K-4u0s7VdAw5qc60HLx-6vjORDd0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SzMdbfvHO8U2wxvdUSSrOnaL9uGcVibLk5rw8wrjn5A&oe=6A3697CF"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDITu3cdhjgQ7kNvwFSwKZl&_nc_oc=Ado_rahftsCVFNZOX1GCu78gRat5ewGmcxgGaulCmxbQgaIe9VHnBWKjRAtn2fQy3J0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FxBzm1NU5wDvNvWfAPBp8BFN6ZoygdGXFzrt6BmLvbg&oe=6A36B1E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "653358692678114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.o
1688_347388886336803_3938685633159959883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vcq7863AxMQ7kNvwFn_Sr-&_nc_oc=AdoOPHsDs4N3RlA0YWRxvonJmJbdo8x4YseDOPp8zsy2_fv3GFPfZZD39nYkL1s0VKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo5ukgnYAK5Ae66vruyGaF29iB4AWsMUewqxZELT8img&oe=69CD0FA6"}]}, "id": "920605115090481", "locale": "en_US", "screenshots": [{"file_name": "Screenshot1.png", "id": "1229688317403814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575369_1229688320737147_6287395094218696818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRMJukRv1hEQ7kNvwHxCIES&_nc_oc=Adr8mmC4vFWUthIYZ8f_PVYGhUVMEeVfCAiYnZQF9VR16j3Bsnso214y8iLTPpASOb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7bIyHQMnV_xZ7LLLVC9GXhsVYQSSPUwVjU8G0BxXYkg&oe=69CCF735"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FEo41sWWWsQ7kNvwHH6VL9&_nc_oc=Ado_L90s7r8dTe5HyNgzT1hfCwvg2SnjDx2Mdmt44vZsB4f-6TiMrrGf4I4eFPnU2EM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzf59XmLRgrpgdn4sOH3SmM7mLNTCTBP7JzlVCjRUhDHg&oe=69CD2E29"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3gMVFSR0QQQ7kNvwGzp09r&_nc_oc=AdoQspXLZrMynrhgv_8B9esLlHnaZqMHekDLXk-zeu1Uok6PJdoZNT06gwGEvoYH3ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCfh8FaCRG8Btm4W1807JYDHmOqeiBwM0TamIZ07Dh2w&oe=69CCF7AB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuLAlmZ67-MQ7kNvwGZiWvj&_nc_oc=AdrPsW6nv9duNMDLV8nu5r6zvYG5LnvJv7twvhOR3GV7QP4oJBjBLrjFKIFp4AnKhT0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afylo-ahlPUGBenzkhjNI2V5Wd95AqK61wyqgUMaWoYeQg&oe=69CD1FCF"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mldgunj5sDcQ7kNvwE8bNxv&_nc_oc=AdpTtH-dhJhDRR4wyMdgh2WKmEzirbJY0NwR9GZgJ-o7mc1IV4mMNWhdEvlFPN4M19o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5fLxB-RO1rHO8P4z49Q0HzRPQ7s6DYlqiNjgQ6DspUw&oe=69CD01A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_po
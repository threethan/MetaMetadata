_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8WpXPbZqV4Q7kNvwFBEvkk&_nc_oc=Adm8EKMJbuf8V3xwFnUmpNQ3YfBbX4SbbzvfFioXzhMgI1UOIt-cp6y3dxAK4DWc9K4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsu-zLx2ACq8nAqUT75MWFmAVyYEJcgke9Q7cdtPvBIvQ&oe=69A43533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.cover_image.png", "id": "1884274831968886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441573_1884274835302219_8104546380846034540_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj3Q__GORPsQ7kNvwECB1gx&_nc_oc=Adnarw1SQsxVThtvFqksCHq654GDRxKcFhL6BqUKqWkirqbRBoWD7t9k6J8n3V3AZAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuXOchGg4mqhJ5wCrtB7erBqVS3w3rBTHhWO9DsvpxNXg&oe=69A42E1B"}, "display_name": "Creating Amusement Park - ContentsDa Science Experiment", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support
creenshot.png", "id": "1029013538099439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_1029013541432772_2432045287368527656_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV4p4VUibXgQ7kNvwEe84HR&_nc_oc=AdobpmnU-e0IX238k3lki_3EapfK8ftyEIyOCnGYBYs-YKw8CK_H9dVViuGzHmY_ifM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLjJcc48FX2K9umAqRiOPfs976Mu_zOxygX5CkcHFyog&oe=6B0DB5FB"}, {"file_name": "screenshot.png", "id": "316948190859911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282167_316948194193244_7020211037579823565_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVIpAW5F4zgQ7kNvwHdl7sY&_nc_oc=AdrU_ql9N6tPXyztoh5BBwj_mpjzv82ObjWNN6OCa5e7sdWGZEYanolG-YvcAoCuV90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTsy9lZErIfoKWGKlVUyGDb5f95qTKScpCeYGnI7kw8Mw&oe=6B0DC649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1364375944157641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1364375947490974_1925180101065875905_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7qfcslgTwcQ7kNvwFLx3zH&_nc_oc=AdqIi9VKGIHJrJrDIl4cSbb6dQ-QjxbegQVne74sJGYjSSrIQwN6DX3aMuC4TDVAudY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSR9eRBm3SxiHhoEWpL5TBNMm-XSFIeLMtve9uRUDHitQ&oe=6B0DD064"}, "display_name": "Microsoft Mesh", "keywords": [], "long_description": "Microsoft Mesh will enable collaboration, presence, and shared immersive experiences from anywhere, on any device\u2014whether that\u2019s a virtual reality headset or a PC\u2014and regardless of where you are physically located. Rebuilding social capital is therefore a business imperative. Our vision for Mesh is to make collaboration more effective, more natural, and ultimately more human in hybrid environments, unconstrained by physical boundaries. Mesh enables you to create virtual spaces where people can interact with one another and with objects in new, fully immersive ways. Personalized avatars provide presence and expression, so you can engage others with eye contact, facial expressions, and gestures. Spatial audio adds dimensionality to sounds and conversations in virtual spaces, enabling you to naturally feel the presence and proximity of others and have side conversations. Integration with Microsoft Teams brings these immersive experiences into the place where work happens.", "short_description": "Microsoft Mesh enables you to create virtual spaces where people can interact with one another and with objects in new, fully immersive ways. Personalized avatars provide presence and expression, so you can engage others with eye contact, facial expressions, and gestures. Spatial audio adds dimensionality to sounds and conversations in virtual spaces, enabling you to naturally feel the presence and proximity of others and have side conversations."}]}, "developer_name": "Microsoft", "developer_privacy_policy_url": "https://go.microsoft.com/fwlink/?LinkId=521839", "developer_terms_of_service_url": "https://www.microsoft.com/licensing/terms/product/ForallOnlineServices/all", "publisher_name": "Microsoft", "support_website_url": null, "website_url": "https://www.microsoft.com/mesh", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "6750166411689689"
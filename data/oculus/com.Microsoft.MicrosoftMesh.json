PsFdNJkGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxbPWgTxg83mwNorArnEaMjgnI93LcWAXL9C3ij9_few&oe=6A621ABB"}, {"file_name": "screenshot.png", "id": "316948190859911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75282167_316948194193244_7020211037579823565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzZM_C8-FBYQ7kNvwHhCp4y&_nc_oc=AdoFLYMzeS5RrbLr01A6Xg9by3DPqu5utEuH0x77v-6T9aP6nsk0Jnuku6Pf0vxE6jo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHd_V81Y9ob__DfUX3F9jXmTW1Xvb5SrC8mdVcZjcglg&oe=6A622B09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1364375944157641", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035347_1364375947490974_1925180101065875905_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYFJXoSwHJ4Q7kNvwF99dnX&_nc_oc=AdqkGRFJK8WTZMfHyZjOpjWDNGWv38gxyO920hIluhAixHANBe161NsofsFhiHiIlBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2AMKfcA6a-GLQbfCqGre_hHSTFn0C2YShsZTzHZ6Xow&oe=6A61FCE4"}, "display_name": "Microsoft Mesh", "keywords": [], "long_description": "Microsoft Mesh will enable collaboration, presence, and shared immersive experiences from anywhere, on any device\u2014whether that\u2019s a virtual reality headset or a PC\u2014and regardless of where you are physically located. Rebuilding social capital is therefore a business imperative. Our vision for Mesh is to make collaboration more effective, more natural, and ultimately more human in hybrid environments, unconstrained by physical boundaries. Mesh enables you to create virtual spaces where people can interact with one another and with objects in new, fully immersive ways. Personalized avatars provide presence and expression, so you can engage others with eye contact, facial expressions, and gestures. Spatial audio adds dimensionality to sounds and conversations in virtual spaces, enabling you to naturally feel the presence and proximity of others and have side conversations. Integration with Microsoft Teams brings these immersive experiences into the place where work happens.", "short_description": "Microsoft Mesh enables you to create virtual spaces where people can interact with one another and with objects in new, fully immersive ways. Personalized avatars provide presence and expression, so you can engage others with eye contact, facial expressions, and gestures. Spatial audio adds dimensionality to sounds and conversations in virtual spaces, enabling you to naturally feel the presence and proximity of others and have side conversations."}]}, "developer_name": "Microsoft", "developer_privacy_policy_url": "https://go.microsoft.com/fwlink/?LinkId=521839", "developer_terms_of_service_url": "https://www.microsoft.com/licensing/terms/product/ForallOnlineServices/all", "publisher_name": "Microsoft", "support_website_url": null, "website_url": "https://www.microsoft.com/mesh", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "6750166411689689"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "190532494118649"}, {"status": "PUBLISHED", "id": "1054394595577860"}]}, "baseline_offer": {"id": "190532494118649"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706205600, "status": "PUBLISHED", "id": "190532494118649"}]}, "liveChannel": {"nodes": [{"latest_supporte
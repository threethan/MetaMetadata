986474167178_753409849808991897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru6muwmmRVMQ7kNvwHqotY7&_nc_oc=AdqK0vvfKEIerJFCX820e4WcC75xUl8eNjbU4FK5kXxlncuaclAmQIxvb_Z1O2hosTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDxNTDm2bqD28ByI4G6nGUdbeELdzpbFUNJRRkV8RWjQ&oe=6AAC03CE"}, {"file_name": "6.png", "id": "4118330751822520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473397287_4118330755155853_4355503460853985722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoaGihlIYcgQ7kNvwEUTAAo&_nc_oc=Adq6cMZkutvzMOTLAcmy1VLrxrw1W_cQwhPw80F39ofEaNFt7Edj8zsjCKDow87u7Z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXClIeSNzjpO8XmobAheWiRNVFfC6wvAgpe9jRIwfiiw&oe=6AABE37B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 v02.png", "id": "658475203483572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473400233_658475206816905_9163647557174549354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8bzKZMKOfcQ7kNvwHCSxXQ&_nc_oc=AdqKUyztwarRnztNvSlwADddX80ZEd0BFknhbZHxjBUlowCsByooJyUoULoqc-piAp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ArbN2Wps02HLw9TXw30ICAgjSWsFArVNyqy2wDUwLQ&oe=6AAC0478"}, "display_name": "SensiSpark Relaxation Stress Relief Game", "keywords": ["liminal", "cosmic", "relax", "mindfulness", "TRIPP"], "long_description": "# Drift into a world of pure sensory relaxation with SensiSpark\nStep into a world of relaxation with a VR experience crafted to calm the mind and engage the senses. Explore tranquil environments, create soothing visuals, and interact with serene elements that help you unwind and find peace.\n\n{1659489498100905}\n\nSlow down and immerse yourself in a stress-free moment of serene gameplay.\n\n{731289859249555}\n\nLight up the night sky with floating lanterns\u2014relax, release, and feel the calm take over.\n\n{1849948609128646}\n\nA calming celebration in the sky\u2014set off fireworks and enjoy the beauty in every burst.\n\n{1703512913602425}\n\nGlide through a glowing world of neon particles\u2014relax, flow, and feel the rhythm of light.\n\n{1782134385988136}", "short_description": "Drift into a world of pure sensory relaxation with SensiSpark \u2014 a calming VR experience designed to soothe your senses and ease your mind. Explore peaceful, sensory-rich environments where gentle sounds, soft colors, and mindful interactions help you relax, de-stress, and restore balance. Whether you're watching waves, painting with light, or floating through the clouds, SensiSpark invites you to unwind and reconnect with calm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idzdigital.com/privacypolicy-vr.php", "developer_terms_of_service_url": null, "publisher_name": " IDZ Digital Private Limited", "support_website_url": null, "website_url": "https://idzdigital.com/vr-games.php", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9733651410086809"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "852401757644549"}, {"status": "PUBLISHED", "id": "1893136668214506"}, {"status": "PUBLISHED", "id": "1456028862195101"}, {"status": "PUBLISHED", "id": "1802593520284652"}]}, "baseline_offer": {"id": "852401757644549"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 177
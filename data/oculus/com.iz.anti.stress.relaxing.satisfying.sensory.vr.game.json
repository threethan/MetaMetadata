-7&_nc_sid=6e7a0a&_nc_ohc=1GZZYUliFooQ7kNvwEAP2RW&_nc_oc=AdlHKHsErQHBOmtPmPTsPdUcrSFiBLZOEwtc_zCZzucvKgdoK5c207ApiAuiOXq_dEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxEZc7V5zXO5qb7u87dEMPQ10xrQCx-c383ee-8BDUwVA&oe=69BC0774"}, {"file_name": "4.png", "id": "1467986470833845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394284_1467986474167178_753409849808991897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4DZNcEkegoQ7kNvwG_vDoR&_nc_oc=AdmJW7IwjdroHW_o6ZGKtaqazQCPo5saUVzquYyN2y1B3QGEobQHudHfWh7DExWuDn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEfyqLRn3uBOdmCrt2cZK7P9ElMVz6aAjDGlVeuXS4gA&oe=69BBDA8E"}, {"file_name": "6.png", "id": "4118330751822520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397287_4118330755155853_4355503460853985722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKTxxlQ-SEQQ7kNvwEKknVC&_nc_oc=AdnI8YMQ8YUcSBiFQjhkrxpIrLskZK-Majh6R0TOdo1r7OquNYG5ok9b1FOIPLDQlf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlU_l7L9oVkSeuahFMZwepGPraGQ1iMk8YFk-YBjinhA&oe=69BBF27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 v02.png", "id": "658475203483572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473400233_658475206816905_9163647557174549354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty0Yx232ZbsQ7kNvwFfdvNx&_nc_oc=AdmdJhZ0jxgy-8ZSr-uxoLS9_ScwrocUs6-qDIMAxAUjuptBrIdcO-VxPhbpr8FdNxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTBtyoGysk3Q2XshVEeJAnCepTqPHs-Llj01W7YLNBSg&oe=69BBDB38"}, "display_name": "SensiSpark - Calm Meditation Relaxation", "keywords": ["cosmic", "mindfulness"], "long_description": "# Drift into a world of pure sensory relaxation with SensiSpark\nStep into a world of relaxation with a VR experience crafted to calm the mind and engage the senses. Explore tranquil environments, create soothing visuals, and interact with serene elements that help you unwind and find peace.\n\n{1659489498100905}\n\nSlow down and immerse yourself in a stress-free moment of serene gameplay.\n\n{731289859249555}\n\nLight up the night sky with floating lanterns\u2014relax, release, and feel the calm take over.\n\n{1849948609128646}\n\nA calming celebration in the sky\u2014set off fireworks and enjoy the beauty in every burst.\n\n{1703512913602425}\n\nGlide through a glowing world of neon particles\u2014relax, flow, and feel the rhythm of light.\n\n{1782134385988136}", "short_description": "Drift into a world of pure sensory relaxation with SensiSpark \u2014 a calming VR experience designed to soothe your senses and ease your mind. Explore peaceful, sensory-rich environments where gentle sounds, soft colors, and mindful interactions help you relax, de-stress, and restore balance. Whether you're watching waves, painting with light, or floating through the clouds, SensiSpark invites you to unwind and reconnect with calm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kidloland.com/privacypolicy-vr.php", "developer_terms_of_service_url": null, "publisher_name": " IDZ Digital Private Limited", "support_website_url": null, "website_url": "https://idzdigital.com/vr-games.php", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25650872194604809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn
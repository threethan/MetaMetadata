404799574_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X7WKLokYoIQ7kNvwHfcPDx&_nc_oc=AdpTlQCsAZmpUprJRAvMg6Ce4a2mdXapyCgtfVXOTLMXoMj_6z-H5REeSGMp4_ptOjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCie9HvrZLRhD2WtMsFzUizCUZoMkeS73sBIXtrlFOThg&oe=6A676A74"}, {"file_name": "4.png", "id": "1467986470833845", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394284_1467986474167178_753409849808991897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvRtLDFRSF4Q7kNvwHOMAUH&_nc_oc=AdracrYFk9-k357mvVWSnK0_is5sG06cQY1drIWr_CSzJpjvk3uNeifBVrjYl_RsatM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_Axlwj6bNSY_dRzROHnTbRcKYhVpOSTA8s92yq_oO5g&oe=6A6775CE"}, {"file_name": "6.png", "id": "4118330751822520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473397287_4118330755155853_4355503460853985722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pda2YuBnV94Q7kNvwEXZmGW&_nc_oc=Adr3Yjwq4-tWzZ7Ul2Dw4COc9csjoz8eMD6TS7pzx95NY1sq-Dd4jk1TsIkEiUHpGto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqx-lJZyVAUP4XJJUHIilkFFSdFVWS7ZdnXHXsdNMSrA&oe=6A67557B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 v02.png", "id": "658475203483572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473400233_658475206816905_9163647557174549354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1_W1Ti-cbEQ7kNvwGvNgn4&_nc_oc=AdrO9R5jQlwvHqeyooVJL6iVNUmQjTblXJum5w_hEIQ2bMrIeP_oL9zBPxhSAtm4mNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvG7o2VKD3e2APwtSMuHwPFnNARewt5CfURjLcr7LaGg&oe=6A677678"}, "display_name": "SensiSpark - Calm Meditation Relaxation", "keywords": ["cosmic", "mindfulness"], "long_description": "# Drift into a world of pure sensory relaxation with SensiSpark\nStep into a world of relaxation with a VR experience crafted to calm the mind and engage the senses. Explore tranquil environments, create soothing visuals, and interact with serene elements that help you unwind and find peace.\n\n{1659489498100905}\n\nSlow down and immerse yourself in a stress-free moment of serene gameplay.\n\n{731289859249555}\n\nLight up the night sky with floating lanterns\u2014relax, release, and feel the calm take over.\n\n{1849948609128646}\n\nA calming celebration in the sky\u2014set off fireworks and enjoy the beauty in every burst.\n\n{1703512913602425}\n\nGlide through a glowing world of neon particles\u2014relax, flow, and feel the rhythm of light.\n\n{1782134385988136}", "short_description": "Drift into a world of pure sensory relaxation with SensiSpark \u2014 a calming VR experience designed to soothe your senses and ease your mind. Explore peaceful, sensory-rich environments where gentle sounds, soft colors, and mindful interactions help you relax, de-stress, and restore balance. Whether you're watching waves, painting with light, or floating through the clouds, SensiSpark invites you to unwind and reconnect with calm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kidloland.com/vr-privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Kidloland", "support_website_url": null, "website_url": "https://kidloland.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26662656833426335"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
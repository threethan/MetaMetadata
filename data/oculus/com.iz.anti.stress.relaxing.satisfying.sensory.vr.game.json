404799574_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-LN1TIiPyIQ7kNvwEXgoTT&_nc_oc=Adok5OtNqnirX6dxyN_hcsmbzCHqOkwACgbz-LuZYTuX31KhvN_n9CFRIgs0oNODBcc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59uEEFemQwY7qVNB8HOA3zqWqp_r77RZAwpLJCS8h3aw&oe=69FDF274"}, {"file_name": "4.png", "id": "1467986470833845", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394284_1467986474167178_753409849808991897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RICEwhke-LoQ7kNvwE13EiL&_nc_oc=Adr2Q94VsYc5grDMWcMZ4vGGhr7Qgi7IfcRUgljGWFxtRBG_BBmwzNsCF5aoWZWdw54&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tA405FqCyhhY5Lh7UzDJz30MbLQHNTk9zLudrQAUk8Q&oe=69FDFDCE"}, {"file_name": "6.png", "id": "4118330751822520", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473397287_4118330755155853_4355503460853985722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0uTreq-IQ0Q7kNvwHihw1O&_nc_oc=AdoQRavkJrLHHurD-gcMgUICv5kpzP_Tz6XCbTNnbgjU8a-hs8hi1Yc0V9q3EKfGQmk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dv5h_cfqXmM_ChtM8zTy3tlWfj0nt3x8FP671vdbN2Q&oe=69FDDD7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 v02.png", "id": "658475203483572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400233_658475206816905_9163647557174549354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5eZ0U5fSKkQ7kNvwGVY4ns&_nc_oc=AdoiXkfKdHeJosZmYnzdhAsgD7dQfnzuBtBZm1vaYW-RDtcJUrKWokyQNjT15AJ3Xl8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TsnewmDpTw8bYJhQhK35yBneyioea1hmL0nOjTV4OKg&oe=69FDFE78"}, "display_name": "SensiSpark - Calm Meditation Relaxation", "keywords": ["cosmic", "mindfulness"], "long_description": "# Drift into a world of pure sensory relaxation with SensiSpark\nStep into a world of relaxation with a VR experience crafted to calm the mind and engage the senses. Explore tranquil environments, create soothing visuals, and interact with serene elements that help you unwind and find peace.\n\n{1659489498100905}\n\nSlow down and immerse yourself in a stress-free moment of serene gameplay.\n\n{731289859249555}\n\nLight up the night sky with floating lanterns\u2014relax, release, and feel the calm take over.\n\n{1849948609128646}\n\nA calming celebration in the sky\u2014set off fireworks and enjoy the beauty in every burst.\n\n{1703512913602425}\n\nGlide through a glowing world of neon particles\u2014relax, flow, and feel the rhythm of light.\n\n{1782134385988136}", "short_description": "Drift into a world of pure sensory relaxation with SensiSpark \u2014 a calming VR experience designed to soothe your senses and ease your mind. Explore peaceful, sensory-rich environments where gentle sounds, soft colors, and mindful interactions help you relax, de-stress, and restore balance. Whether you're watching waves, painting with light, or floating through the clouds, SensiSpark invites you to unwind and reconnect with calm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kidloland.com/privacypolicy-vr.php", "developer_terms_of_service_url": null, "publisher_name": " IDZ Digital Private Limited", "support_website_url": null, "website_url": "https://idzdigital.com/vr-games.php", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25650872194604809"}, "review_messages": []}]}, "cover_square_i
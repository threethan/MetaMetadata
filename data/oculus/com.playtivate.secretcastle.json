. Walk around and explore the environment, find the required objects in the list, within the given time. The more items you find, the higher is your score. Click on the menu buttons on your left wrist to access the object list and settings. Click on the objects to pick them up, if it is a correct object, a score will be awarded. Enjoy the game!", "short_description": "Put on your VR headset, immerse in the beautiful environment, find the hidden objects and discover the secrets of the castle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playtivate.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Playtivate", "support_website_url": null, "website_url": "https://www.playtivate.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "795712571438631"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1372060007441148"}, {"status": "PUBLISHED", "id": "1194288441416437"}]}, "baseline_offer": {"id": "1372060007441148"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739593500, "status": "PUBLISHED", "id": "1372060007441148"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5360702207332768", "version": "0.1"}, "id": "713605622990691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fals
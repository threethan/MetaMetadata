n.com/v/t64.5771-25/499303280_1418527226060258_6961125146783970557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqhr4GiaBUgQ7kNvwGDL370&_nc_oc=AdrDOVoKlDQm2Nei9wLf4hnV-trCMhvk_lK7MxnoWrxnCYdZUBhZhq6fT6SBUiDeYmI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KauOTzO5KtyM-Y_vWtSBUA67wMJOKiTgUDiNsosvR1Q&oe=6A450D0E"}, {"file_name": "Untitled design (14).png", "id": "1261739602339632", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307326_1261739609006298_7211239725518713908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icBfHdOgJEYQ7kNvwEn9oS9&_nc_oc=Adoc6ay1kU8oIx0mz1Mc-5I4tOMeKdhd5Eav2pULkJU9ES0iH1JYSdeMdIHOeQbVe_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SU8SjK9UEMC6QIaUI7zr1CS1Ccb2QEUu0vAU2xL3g9Q&oe=6A4519FC"}, {"file_name": "Untitled design (10).png", "id": "2323485591381520", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310720_2323485594714853_6058710605340418867_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w0cRsX3TkUQ7kNvwGQC68S&_nc_oc=Adr-HCNrd5aA7Uu3T2xjK6FIIzrIIz7uyXw9a4a8JZMzTl2lJEC_bKip9ZuXOxGMUTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rAMlJ1LRxDxorV0bZac4xKBxVVjxhaHLnH9Fsio7FGw&oe=6A452E49"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Runners VR", "keywords": ["dino", "arms", "gorilla", "locomotion", "fun"], "long_description": "Dino Runners is a fun and fast-paced game where you play as a dinosaur and move using your arms! Run, swing, and dash forward by physically pumping your arms to control your dino as you race through different environments.\n\nThe dinos have already taken down their first major enemy \u2014 the snowmen. While the snowmen are defeated for now, there\u2019s more to come. The game is still in development, and some things are scheduled to change, so stay tuned for updates and new content.\n\nWhether you're testing your speed or just enjoying the movement-based gameplay, Dino Runners brings active fun to life. Jump in and run like a true dino!", "short_description": "Move with your arms and run as a dino in this fun VR adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://free-4138534.webador.ie/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HyroxGAMES", "support_website_url": null, "website_url": "https://free-4138534.webador.ie/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23925573367106280"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "607242291580536"}]}, "baseline_offer": {"id": "607242291580536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752922800, "status": "PUBLISHED", "id": "607242291580536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24845202658476675", "version": "4.3"}, "id": "660013672744972", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6514076312015922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24845202658476675"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LI
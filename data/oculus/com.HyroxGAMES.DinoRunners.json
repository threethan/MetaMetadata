25146783970557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9ITainnyqIQ7kNvwEw2-AD&_nc_oc=AdrHhiVHmBYIxZExZ2QcEmileQRCCXSDdgTBnwl9nMtPr_cMhMX3fhmGSugPHYOuU1o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3v2E9WMt05jEEuMywKWmjJ3fVpjPg_V7hg78emoXTnbQ&oe=69F1FE8E"}, {"file_name": "Untitled design (14).png", "id": "1261739602339632", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307326_1261739609006298_7211239725518713908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxVFlvTIveAQ7kNvwEEwaVz&_nc_oc=AdoGHlhWIuiq_8tv83iE36-3JduSbWYjGARNAN5Toz5cyfmGmPsBjcCauHSGA2BBapc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1CPhw-kNdpWkwr7GoBKsQFZhgDIl9pRbUnL2tnYcIsLQ&oe=69F20B7C"}, {"file_name": "Untitled design (10).png", "id": "2323485591381520", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310720_2323485594714853_6058710605340418867_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySxhfIMpACsQ7kNvwH-t2es&_nc_oc=Adrq8WN3R4JVuIPiog_CixQA34mYJWyBng-RMP2mI2ZCTS68u8eFfmE9Licm6PlMQzQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0HntKWEenovjiKttC4T4W9BIFjlef-tITbWLdl_8WwIQ&oe=69F1E789"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Runners VR", "keywords": ["dino", "arms", "gorilla", "locomotion", "fun"], "long_description": "Dino Runners is a fun and fast-paced game where you play as a dinosaur and move using your arms! Run, swing, and dash forward by physically pumping your arms to control your dino as you race through different environments.\n\nThe dinos have already taken down their first major enemy \u2014 the snowmen. While the snowmen are defeated for now, there\u2019s more to come. The game is still in development, and some things are scheduled to change, so stay tuned for updates and new content.\n\nWhether you're testing your speed or just enjoying the movement-based gameplay, Dino Runners brings active fun to life. Jump in and run like a true dino!", "short_description": "Move with your arms and run as a dino in this fun VR adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://free-4138534.webador.ie/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HyroxGAMES", "support_website_url": null, "website_url": "https://free-4138534.webador.ie/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23925573367106280"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "607242291580536"}]}, "baseline_offer": {"id": "607242291580536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752922800, "status": "PUBLISHED", "id": "607242291580536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24845202658476675", "version": "4.3"}, "id": "660013672744972", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6514076312015922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24845202658476675"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "660013672744972"}]}, "change_log": null, "created_date": 1762004340, "id": "248
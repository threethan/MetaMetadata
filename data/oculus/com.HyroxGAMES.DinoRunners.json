n.com/v/t64.5771-25/499303280_1418527226060258_6961125146783970557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZucPP0F5KUQ7kNvwEneNDO&_nc_oc=Adp9rDqOSt4C1eep5zkrii8R4xcIRF_0vtI2bNptRvXbSZqKYAwVMck3PxecWirIsng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vl6TagBaATWUxYAAnELpZO9s_oErFYUZQB9GCuMjwfA&oe=6A01D08E"}, {"file_name": "Untitled design (14).png", "id": "1261739602339632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307326_1261739609006298_7211239725518713908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY5ktI25R9wQ7kNvwE672QF&_nc_oc=AdoEif9GYFIDHISSCwYkloCLzRY2Qi4-Q-Yg7_BuZvncUYTY18m0vZ71_U-tE1ALk1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eLEeoDiw4IEHbvHbVMsGJVdmHZeu6niQP-8b_t73ooA&oe=6A01DD7C"}, {"file_name": "Untitled design (10).png", "id": "2323485591381520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310720_2323485594714853_6058710605340418867_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-20SkFuCPEAQ7kNvwHcLotT&_nc_oc=AdruVm1hQHm_wr3_HFHJS-FscEGlt58zJzDTB9qm6_zFQvj-rVofGXet3rzbQBLgXE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tR27_SOv6cDqnr6Dp-hJlZ39p4Yt7HevrCik4raqnxw&oe=6A01F1C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Runners VR", "keywords": ["dino", "arms", "gorilla", "locomotion", "fun"], "long_description": "Dino Runners is a fun and fast-paced game where you play as a dinosaur and move using your arms! Run, swing, and dash forward by physically pumping your arms to control your dino as you race through different environments.\n\nThe dinos have already taken down their first major enemy \u2014 the snowmen. While the snowmen are defeated for now, there\u2019s more to come. The game is still in development, and some things are scheduled to change, so stay tuned for updates and new content.\n\nWhether you're testing your speed or just enjoying the movement-based gameplay, Dino Runner
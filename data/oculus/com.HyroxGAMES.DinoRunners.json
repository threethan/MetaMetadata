n.com/v/t64.5771-25/499303280_1418527226060258_6961125146783970557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Toyca8cpa4Q7kNvwHGFlJf&_nc_oc=AdpP0ph5J0eTg19NgQNndsvRnbiAlUgz0drrUgLfcVZbjmhbNbh_5JSk-MSe55CTvOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGSWxV-O2llmFGcGKhlAo_GfiZA2UxkLKPcO7cHbu9kw&oe=6A8AEC8E"}, {"file_name": "Untitled design (14).png", "id": "1261739602339632", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307326_1261739609006298_7211239725518713908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8ZSFOLaL5gQ7kNvwGQtsec&_nc_oc=Adr2L1UuLH78i3zPM49HxsG0zU6NLHd9riIgnKqjrpWk0nC7JiQJh7cN7GCMQzReHHA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgADlPnCLdu6pb02sudvkOKmZAi-RyCyVlxQtyo8_Rig&oe=6A8AC13C"}, {"file_name": "Untitled design (10).png", "id": "2323485591381520", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310720_2323485594714853_6058710605340418867_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPsrG10wxg8Q7kNvwEldp3m&_nc_oc=AdobpL0AlF9S3kP-FKjvT8oZ7DqRsumC7BmpO_L9jcG0AF3nhNnBqvUL-XHNtRRKzPU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtGHOxM5UbNa_PrXobkiyfA-foV3Lh3dfkWiydNDnQ-Q&oe=6A8AD589"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Runners VR", "keywords": ["dino", "arms", "gorilla", "locomotion", "fun"], "long_description": "Dino Runners is a fun and fast-paced game where you play as a dinosaur and move using your arms! Run, swing, and dash forward by physically pumping your arms to control your dino as you race through different environments.\n\nThe dinos have already taken down their first major enemy \u2014 the snowmen. While the snowmen are defeated for now, there\u2019s more to come. The game is still in development, and some things are scheduled to change, so stay tuned for updates and new content.\n\nWhether you're testing your speed or just enjoying the movement-based gameplay, Dino Runner
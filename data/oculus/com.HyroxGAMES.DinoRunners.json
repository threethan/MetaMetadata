n.com/v/t64.5771-25/499303280_1418527226060258_6961125146783970557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFBMpdP2np0Q7kNvwFTsT-s&_nc_oc=AdqC160lZ7asJsEKRtL3lycihTCqkIPHgTWQNXFH7615ft4ofLM9k2jN5UdpM5Bqq-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYBg1ls1WqkqyG5EuAlcZxWq9_5rpwFk84BRKYOP7cSg&oe=6AA2A78E"}, {"file_name": "Untitled design (14).png", "id": "1261739602339632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1261739609006298_7211239725518713908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn4Kvlr8G4YQ7kNvwGYyQ-S&_nc_oc=AdoJ0kvFyq1KkW1HV-O6KmINSHeDGDWGCxkBO4AlanGPylxN7qTwEvzymy8l9WDF-6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzCiygr-Bu11Ud00mek186wPTi143kq3Q25VIZZGzbSQ&oe=6AA2B47C"}, {"file_name": "Untitled design (10).png", "id": "2323485591381520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310720_2323485594714853_6058710605340418867_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTbEZLEnZNcQ7kNvwHkA2J-&_nc_oc=AdrNWOIPy2go1nVcAjJge1ybK35TSX6a1xI1bObFi2BKy_nDqPBmMyx9LAWsFbpd8Xg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtRKowKgWI9Is40O-BneCLvISJec2-noV4oLPUVzXyIA&oe=6AA2C8C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Runners VR", "keywords": ["dino", "arms", "gorilla", "locomotion", "fun"], "long_description": "Dino Runners is a fun and fast-paced game where you play as a dinosaur and move using your arms! Run, swing, and dash forward by physically pumping your arms to control your dino as you race through different environments.\n\nThe dinos have already taken down their first major enemy \u2014 the snowmen. While the snowmen are defeated for now, there\u2019s more to come. The game is still in development, and some things are scheduled to change, so stay tuned for updates and new content.\n\nWhether you're testing your speed or just enjoying the movement-based gameplay, Dino Runner
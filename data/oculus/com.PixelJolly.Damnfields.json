lduEriQp6_d26rdXmw8FbRFH8e75tSH7sLyql50CV1Zbs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8xpTRBQNM4VhaPDNtG6ox67ZVIHimrLiF117GmnFb5w&oe=6B031F87"}, {"file_name": "damnfields_screenshot_3.png", "id": "3615516102038217", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984465_3615516105371550_8755386997252617318_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ov-Quwcb0UQ7kNvwGrW3GH&_nc_oc=Adq7VXhiH7IoNtD0aI9CEsCXiKTL-pXoYv8fwU_bomQsFTQCn4_3G_9ssAwN5TxNnMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPwAb2glTIpZzc0ASsqb0rY8v_MHbKot0wuHRW2pp2Lg&oe=6B0335BB"}, {"file_name": "damnfields_screenshot_4.png", "id": "695355846136537", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223483_695355849469870_4916025199314149793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdf4l2D_m94Q7kNvwGd3Oip&_nc_oc=AdqJAXsblT_DEZyxxjabzMsfWPLFMmJKseI7a1jnb7XRvvmHV7BcfZ6Im6Rg7eWBF8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQluzrVw0BboXiWMxUXIA36SuZeF3XDk-NmSiuGt2wh5g&oe=6B032D66"}, {"file_name": "damnfields_screenshot_5.png", "id": "754811223260508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367592_754811229927174_1775564479522726241_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeuAMFWDLuwQ7kNvwG5Woad&_nc_oc=AdpfZ5gdQBshZp5Q8aycG5AlYLNulgITlIalq_h16uSD2mCKLT-C9vOlJpYGoU8P2ok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeqLSeHuAO9o6eF2pTA9bd0BEjAzVIeGQ7_gp1CY4Arg&oe=6B032F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "damnfields.png", "id": "1114791939713170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031431_1114791943046503_5827272108841194958_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAP9Zlr8srsQ7kNvwE33mCP&_nc_oc=AdqcZRbje_QFuDDEnYfMOoEx4ekZlJ8u86a9CulY1vqbE4LF50Ssn-lFt_vOZP5gHy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR47s6O7kIVPht99nsiD1d7izCrLjC21y7fDuDIBfYZgw&oe=6B031100"}, "display_name": "Damnfields", "keywords": [], "long_description": "With Damnfields you will get lost in a fun, engaging and challenging action/puzzle game, where you will have to use your head alone to complete all the levels.\n\nMaster all the four game modes (Defuse, Antagonists, Maze and Nature) before entering the DAMNfields, which you will have to complete before the time expires!\n\nAnd if you manage to complete the game, you will unlock something that will make you want to play it again!\nIn fact, Damnfields is perfect to challenge yourself and to speedrun!\n\nThis game is a love letter to the 80s and 90s golden era of videogames: if you enjoy challenging games and/or you are a fan of pixel-art and chiptune music, this game is definitely for you!\n\nDamnfileds was picked from stellar judges (including the legendary John Carmack) as one of the finalists in the Oculus Mobile VR Jam, in 2015.", "short_description": "The 2015 Mobile VR Jam finalist is back on Quest Devices!\n\nImmerse yourself in pixel-art and chiptune music with this addictive action/puzzle game, where you will have to gaze your way around challenges in order to escape...the Damnfields!"}]}, "developer_name": "Marco Colombo", "developer_privacy_policy_url": "https://www.pixeljolly.com/damnfields-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Marco Colombo", "support_website_url": null, "website_url": "https://www.facebook.com/damnfields", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
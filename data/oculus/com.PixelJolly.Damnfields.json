2038217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984465_3615516105371550_8755386997252617318_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZW8xPibxwkQ7kNvwF1wU9x&_nc_oc=Adpmipqkhz50VT7u26ct_Jx64_lAtJeV7BKqyWBTfaB15Y0rHczc8L64spyBWNhU7SA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SXRIG6Wwr24y_c7MJ39eA3rUDGBEGWiV9pjQJZnCOig&oe=69EE227B"}, {"file_name": "damnfields_screenshot_4.png", "id": "695355846136537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_695355849469870_4916025199314149793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy8l_L_3i0YQ7kNvwH6v5Xb&_nc_oc=AdqOPLmPymsmKF1e-e8yToWhYUa3YLyfR6_M7oNqYMtrIhxMxpqe-0vBRAI7vBzGvUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OzmxerFwHZZGmIHGJhexFUFjetXMqZro0VtqwjAStGw&oe=69EE1A26"}, {"file_name": "damnfields_screenshot_5.png", "id": "754811223260508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75367592_754811229927174_1775564479522726241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIc1CCPlIdoQ7kNvwFS2Oow&_nc_oc=AdrkE5wXd1RpbT98Wkxw8RpFjTQZXDJ59K7aznR2PN4HAPNbHnOGfTp5tMxYzuttdHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nUII3PPAVaU6a5ZOOn3QD_Pn12D6oFHbfCWy9qw3wiQ&oe=69EE1C1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "damnfields.png", "id": "1114791939713170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031431_1114791943046503_5827272108841194958_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBpBSGy5YgUQ7kNvwHMiXhn&_nc_oc=Adq3a8wtnrqdCeHleHQLJ5Xu-mquFnoa2FkvE9z9rtMFlsgkcIrCGV2Vex4eM1hL3VY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YXNHlCGmv_xzDbdOA5_RyMKQZkTljEpQjV9fiRKHAoA&oe=69EDFDC0"}, "display_name": "Damnfields", "keywords": [], "long_description": "With Damnfields you will get lost in a fun, engaging and challenging action/puzzle game, where you will have to use your head alone to complete all the levels.\n\nMaster all the four game modes (Defuse, Antagonists, Maze and Nature) before entering the DAMNfields, which you will have to complete before the time expires!\n\nAnd if you manage to complete the game, you will unlock something that will make you want to play it again!\nIn fact, Damnfields is perfect to challenge yourself and to speedrun!\n\nThis game is a love letter to the 80s and 90s golden era of videogames: if you enjoy challenging games and/or you are a fan of pixel-art and chiptune music, this game is definitely for you!\n\nDamnfileds was picked from stellar judges (including the legendary John Carmack) as one of the finalists in the Oculus Mobile VR Jam, in 2015.", "short_description": "The 2015 Mobile VR Jam finalist is back on Quest Devices!\n\nImmerse yourself in pixel-art and chiptune music with this addictive action/puzzle game, where you will have to gaze your way around challenges in order to escape...the Damnfields!"}]}, "developer_name": "Marco Colombo", "developer_privacy_policy_url": "https://www.pixeljolly.com/damnfields-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Marco Colombo", "support_website_url": null, "website_url": "https://www.facebook.com/damnfields", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7351551154906203"}, "review_messages": []}]}, "cover_square_image": {"uri":
.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOgB2fnXLOYQ7kNvwGlNebH&_nc_oc=Adnas-uoni-dG7WOcKPRTAbGitgYCQBwJ5RURWgnbwoufzXxuBwRzh2RWiu0-4hpVmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPIhLn80_5EbvOeI5LITFsL1uveCXqfcwe29jvXRh3og&oe=699DB6FB"}, {"file_name": "damnfields_screenshot_4.png", "id": "695355846136537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_695355849469870_4916025199314149793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BDWmElkv6MQ7kNvwFomskr&_nc_oc=AdkpXylQtipZoa9SzDgswDYgTpn9x9aK-IiwAq3GL2tDdzahJ5noomvhlNKeWQMcVlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPckEEQFAC_pPMAB9lWR6dfLmLywUa9dnIFpi-dJAxCw&oe=699DAEA6"}, {"file_name": "damnfields_screenshot_5.png", "id": "754811223260508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367592_754811229927174_1775564479522726241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNkVzqXR5lkQ7kNvwF6n9o4&_nc_oc=AdkhlModSnb9-YEdMkKKHTtSR2ZPM-WyjnxSuTC71LvtH0kSoANe5yASEIi9mGMQWKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8A9Wo9ESqlG0QQnB12VvncxiKKx_VbNX_bmX6N7pqIg&oe=699DB09F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "damnfields.png", "id": "1114791939713170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031431_1114791943046503_5827272108841194958_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGGhzjDT_KAQ7kNvwEKlxd0&_nc_oc=AdklUf_K6H46wjMeTv-HZanxbhj4xrgCMErtvD6hISnb_hBpRyIz8MhY2G_FSZWDTD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsuftjQndgqUb2nX-eayk_KRwv9nGC_TLjqFz1bitOIXA&oe=699D9240"}, "display_name": "Damnfields", "keywords": [], "long_description": "With Damnfields you will get lost in a fun, engaging and challenging action/puzzle game, where you will have to use your head alone to complete all the levels.\n\nMaster all the four game modes (Defuse, Antagonists, Maze and Nature) before entering the DAMNfields, which you will have to complete before the time expires!\n\nAnd if you manage to complete the game, you will unlock something that will make you want to play it again!\nIn fact, Damnfields is perfect to challenge yourself and to speedrun!\n\nThis game is a love letter to the 80s and 90s golden era of videogames: if you enjoy challenging games and/or you are a fan of pixel-art and chiptune music, this game is definitely for you!\n\nDamnfileds was picked from stellar judges (including the legendary John Carmack) as one of the finalists in the Oculus Mobile VR Jam, in 2015.", "short_description": "The 2015 Mobile VR Jam finalist is back on Quest Devices!\n\nImmerse yourself in pixel-art and chiptune music with this addictive action/puzzle game, where you will have to gaze your way around challenges in order to escape...the Damnfields!"}]}, "developer_name": "Marco Colombo", "developer_privacy_policy_url": "https://www.pixeljolly.com/damnfields-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Marco Colombo", "support_website_url": null, "website_url": "https://www.facebook.com/damnfields", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7351551154906203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580061_968847461517156_2584387789659157469_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=
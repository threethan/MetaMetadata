r8krv5oWGGDe6IhtX8bdNCcx6h4kzF5PIYFbVp3daDEBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv9LIl_6zoiLspZNQ0H9cem_u6LbxSdfyGKlSRHqIcrg&oe=6B071407"}, {"file_name": "damnfields_screenshot_3.png", "id": "3615516102038217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984465_3615516105371550_8755386997252617318_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAyIlgbcAyEQ7kNvwFHrkYm&_nc_oc=AdpwEDJBOB21EBLF69ENPKBcRqNP-groolp5b-bHdmse79QxQ4oYFJOXdG-RpmjdOhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLuqLRVLXHgcJ2s93rYYp0-KVk9GutZRm3dSPcnCGdZA&oe=6B06F1FB"}, {"file_name": "damnfields_screenshot_4.png", "id": "695355846136537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_695355849469870_4916025199314149793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYOWkNPqfZkQ7kNvwHJHkDI&_nc_oc=AdrjdkoWfHPY0NSLUyIpkQXqsS3lge1C4VADT3-4u-Ms9m3fedZVZ7fLDNHrK0HJ4g4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI_eOBfdXD9kT2G70p3scksLX2w_fgVnWhC6EaT8MFcA&oe=6B0721E6"}, {"file_name": "damnfields_screenshot_5.png", "id": "754811223260508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367592_754811229927174_1775564479522726241_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nd2pTcHJU8Q7kNvwHssGo2&_nc_oc=AdoQFpuOXfGr1klNhxFthgjFouQ1CRq5fYTWVjRdErGz-nc67f4xn5xrVuE77iSVnG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTl8LCx9Pzr0HOR-raeqB-xEBM_8D529CJ_bZIxhXS0A&oe=6B0723DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "damnfields.png", "id": "1114791939713170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031431_1114791943046503_5827272108841194958_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L792zRj_d28Q7kNvwGVzfE5&_nc_oc=Adr7j4cP0ccUhkD1WblHR5Bs1gbiT3jdnE3FRJd-Zn8ju9HT8HNJFGwkVE4SyaDbQ6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjv_Geh7fA39CKQz1S8P8Klz8ITUJk4uZklE6FXOhcfw&oe=6B070580"}, "display_name": "Damnfields", "keywords": [], "long_description": "With Damnfields you will get lost in a fun, engaging and challenging action/puzzle game, where you will have to use your head alone to complete all the levels.\n\nMaster all the four game modes (Defuse, Antagonists, Maze and Nature) before entering the DAMNfields, which you will have to complete before the time expires!\n\nAnd if you manage to complete the game, you will unlock something that will make you want to play it again!\nIn fact, Damnfields is perfect to challenge yourself and to speedrun!\n\nThis game is a love letter to the 80s and 90s golden era of videogames: if you enjoy challenging games and/or you are a fan of pixel-art and chiptune music, this game is definitely for you!\n\nDamnfileds was picked from stellar judges (including the legendary John Carmack) as one of the finalists in the Oculus Mobile VR Jam, in 2015.", "short_description": "The 2015 Mobile VR Jam finalist is back on Quest Devices!\n\nImmerse yourself in pixel-art and chiptune music with this addictive action/puzzle game, where you will have to gaze your way around challenges in order to escape...the Damnfields!"}]}, "developer_name": "Marco Colombo", "developer_privacy_policy_url": "https://www.pixeljolly.com/damnfields-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Marco Colombo", "support_website_url": null, "website_url": "https://www.facebook.com/damnfields", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
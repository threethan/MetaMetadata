Czi6iJKQT6BdqFZl0o46l6EJxT01jGH_QRHYL4nOWBtgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQo8spTUdgU2sWYMkcvYHJNITE7o8Cd972oNJe9NqMrHg&oe=6B0DAB87"}, {"file_name": "damnfields_screenshot_3.png", "id": "3615516102038217", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984465_3615516105371550_8755386997252617318_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l110ZxDTF38Q7kNvwF-teTd&_nc_oc=AdoSuxPNXDI-K_2zQO9JXIUUmvh7MeJIreeG8eazHFaGyg7pom2HMSi4uB1lufsQXuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIH5KmgzrHLfOAoE0SaIVDZkEm1CCLbO79_Ii8fKsVrg&oe=6B0DC1BB"}, {"file_name": "damnfields_screenshot_4.png", "id": "695355846136537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_695355849469870_4916025199314149793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtwITgQPLlgQ7kNvwEPyh7h&_nc_oc=AdoaGFWe7dnr_bU8x-5KrBZzTaYphii9e9P2Ipq3-_MKiE7S8x1jsuBG4Bm_df2bFYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSagNJFHKwOOvSFAT6PDdYlY3ZcRBr9ku9urDlVM5k_Q&oe=6B0DB966"}, {"file_name": "damnfields_screenshot_5.png", "id": "754811223260508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75367592_754811229927174_1775564479522726241_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZLWapaXjoQQ7kNvwFoG6a3&_nc_oc=AdpEoeGpzuU71-teF1W5o-DLk0g01QVdNCpLSE2z2Db4rcg9jxx6l3TZRBHh-rXZCWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_Unw46jwqsSJKvtQLCZMD0gvp9fAHMWbfET0Ws2ogag&oe=6B0DBB5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "damnfields.png", "id": "1114791939713170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031431_1114791943046503_5827272108841194958_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwDROHPt4akQ7kNvwHaFiJV&_nc_oc=Adp9QfQvXHs7emQogfKGWNRRcfMrgEAwa_KfYdinoY8FWYcchpqQRKxvfVQmWYNTt64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5yk7w2o4beKxlHOmlISKQO5yBJiHwpooeDa5dqeXQ0A&oe=6B0D9D00"}, "display_name": "Damnfields", "keywords": [], "long_description": "With Damnfields you will get lost in a fun, engaging and challenging action/puzzle game, where you will have to use your head alone to complete all the levels.\n\nMaster all the four game modes (Defuse, Antagonists, Maze and Nature) before entering the DAMNfields, which you will have to complete before the time expires!\n\nAnd if you manage to complete the game, you will unlock something that will make you want to play it again!\nIn fact, Damnfields is perfect to challenge yourself and to speedrun!\n\nThis game is a love letter to the 80s and 90s golden era of videogames: if you enjoy challenging games and/or you are a fan of pixel-art and chiptune music, this game is definitely for you!\n\nDamnfileds was picked from stellar judges (including the legendary John Carmack) as one of the finalists in the Oculus Mobile VR Jam, in 2015.", "short_description": "The 2015 Mobile VR Jam finalist is back on Quest Devices!\n\nImmerse yourself in pixel-art and chiptune music with this addictive action/puzzle game, where you will have to gaze your way around challenges in order to escape...the Damnfields!"}]}, "developer_name": "Marco Colombo", "developer_privacy_policy_url": "https://www.pixeljolly.com/damnfields-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Marco Colombo", "support_website_url": null, "website_url": "https://www.facebook.com/damnfields", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
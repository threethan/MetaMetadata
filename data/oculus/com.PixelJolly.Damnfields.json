2038217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984465_3615516105371550_8755386997252617318_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYGtc0-Z33gQ7kNvwEKqdTp&_nc_oc=Adr5RuNwRgdaXTlUeMSQ4DdFQ4S3Gp8Bm6_0tseCGy-96_aE98Edj-ugQxVz2p5NDyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxJMRP3dAZN8Xmrq7RFbS5-8UcytP3LlG4WFXzDEg9SQ&oe=6AEB427B"}, {"file_name": "damnfields_screenshot_4.png", "id": "695355846136537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_695355849469870_4916025199314149793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUztR3um9j0Q7kNvwHdzso4&_nc_oc=AdolkRkK5nBAxcfdDhTAeA0Vta5uP9aZmWhm-4avWTl85fYJ2gj82WFSGJLacdub2A8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhK3oBHOJTcZ2LVRnQl89wNTxkN8kBbyShSZ4TTNB6kA&oe=6AEB3A26"}, {"file_name": "damnfields_screenshot_5.png", "id": "754811223260508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75367592_754811229927174_1775564479522726241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPtNUMyzgtMQ7kNvwEDpCiW&_nc_oc=Adrt5Dy8zkJ3C0uZW5W0LXxg9hesBeF6WhQ_wOwvMXCg4nJcIHbS00_E0YUyVwdRJUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGOk19I6SjT9S3T_OwoTEOiR6JGM_LbQdruITwThhpCQ&oe=6AEB3C1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "damnfields.png", "id": "1114791939713170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031431_1114791943046503_5827272108841194958_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-rJvfQuhYgQ7kNvwEAqIMz&_nc_oc=AdriQTFZyjM0bxk1mFIL-pzDkahokUX8a_uZaAuJp4hNYBqRteHPfPNs8GyDST6JnT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR57YIEezzjc7dwu8Dtq0uDsBdVh10V8VGKTisEj1RxPw&oe=6AEB5600"}, "display_name": "Damnfields", "keywords": [], "long_description": "With Damnfields you will get lost in a fun, engaging and challenging action/puzzle game, where you will have to use your head alone to complete all the levels.\n\nMaster all the four game modes (Defuse, Antagonists, Maze and Nature) before entering the DAMNfields, which you will have to complete before the time expires!\n\nAnd if you manage to complete the game, you will unlock something that will make you want to play it again!\nIn fact, Damnfields is perfect to challenge yourself and to speedrun!\n\nThis game is a love letter to the 80s and 90s golden era of videogames: if you enjoy challenging games and/or you are a fan of pixel-art and chiptune music, this game is definitely for you!\n\nDamnfileds was picked from stellar judges (including the legendary John Carmack) as one of the finalists in the Oculus Mobile VR Jam, in 2015.", "short_description": "The 2015 Mobile VR Jam finalist is back on Quest Devices!\n\nImmerse yourself in pixel-art and chiptune music with this addictive action/puzzle game, where you will have to gaze your way around challenges in order to escape...the Damnfields!"}]}, "developer_name": "Marco Colombo", "developer_privacy_policy_url": "https://www.pixeljolly.com/damnfields-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Marco Colombo", "support_website_url": null, "website_url": "https://www.facebook.com/damnfields", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7351551154906203"}, "review_messages": []}]}, "cover_square_image": {"uri":
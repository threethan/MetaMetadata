nK-nQp3oBr5I8yA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H929r2Ivr4ziVNM3XINUvHN2EoKVr3_vwQ_TK_Q_BkQ&oe=69E398F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_en.png", "id": "1084540680086032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468917843_1084540683419365_3591522666418303168_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6Zr-BMNMlsQ7kNvwFQsrjZ&_nc_oc=AdoFLPmjOkVxAqIlGlnV0A4vhBdH_e_Klzc_HXHlM1JQsvXnnr-a3ewVs00Y2rjncgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JeMHYSnSMYPpOL11zdsu8aH4rFizy7PThrakZNZjZmA&oe=69E369B8"}, "display_name": "Unimo: StarTrip VR", "keywords": ["casual", "dodge", "cute", "easy", "arcade"], "long_description": "Unimo: StarTrip is a casual farming and dodging game where you help Ribee, an adorable creature, avoid space bugs, collect spirits, and illuminate the stars. With simple slide controls, guide Ribee safely through the levels and complete missions. Experience the thrill of dodging attacks from various space bugs and the satisfaction of collecting spirits to progress through the stages. Prove your skills in the endless mode with increasingly challenging levels.\n\nKey Features:\n\nHeart-pounding dodging gameplay: Maneuver through the onslaught of space bugs to complete your tasks.\n\nSpirit collection: Gather essential spirits as you clear the stages.\n\nInfinite stages: Conquer increasingly difficult stages to test your limits.\n\nPower up Ribee: Utilize Stardust to enhance Ribee's abilities.\n\nSpecial game modes: Experience unique gameplay challenges in specific stages.\n\nRibee's house: Discover fun interactions and unlock new spaceships in Ribee's house.\n\nDiverse spaceships: Pilot a variety of spaceships with unique designs for added fun.\n\nUnimo: StarTrip offers a simple yet addictive gaming experience. With its charming characters, thrilling gameplay, and diverse content, it's sure to provide hours of entertainment. Join Uni on their quest to brighten the universe today!", "short_description": "Embark on a journey to brighten the universe with Ribee!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hwig.games/privacypolicy", "developer_terms_of_service_url": "https://hwiggames38434.imweb.me/termofuse", "publisher_name": "contact HelloVR", "support_website_url": null, "website_url": "https://www.hellovr.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286810218003948"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982476_1145365297238041_8314852898887075765_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KQFw06zAl0Q7kNvwEEQ51Y&_nc_oc=Adr6z3LWGznIKve6xw7xboMfdswj3cLZ3C9lxYiuFR_yluRfkry3MlnfY0ub9tt6l3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lU82_tEZgX_W5rSPM4xgOfwA3k9FVZn4hU73bqhbhHg&oe=69E394F0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unimo: StarTrip VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Action", "id": "459781504968480"}], 
uhz2yvRTm1b9tYY5qrCuU2xJ12S-if2-5NxYj6Gh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxkvO_bfhpQfcCUtbGvgHKC5Nilvf931-m3mc3KNcmwA&oe=6ABD0106"}, {"file_name": "4.png", "id": "1649862782259142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974755_1649862785592475_6281731294808583661_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzDm5b1mr7oQ7kNvwHsbX2q&_nc_oc=AdoWPTwTebrbvUq2R_OaZqDFfkZAs87NEnsArsCE9p7ZPkQxcc6d0VMqBQsPW2xddks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNxG6aQcl1KgjMiHdfCfPIFNIjtNGpAHHp8HpKi7L2Zw&oe=6ABD1C2A"}, {"file_name": "5.png", "id": "2197020174025069", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974792_2197020177358402_9029376058492809916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPPeUVvGYHAQ7kNvwHHK5Zr&_nc_oc=AdqB2WHmDbpmRgqEyr2gcJfAP3DxNhpSWZzaGdqJCLOBhsTykT_FYUt2fdPSgbE-e6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK6RKcOTepl6uoRn-MaT-UNX7MFyGoHaVNX-DTi0LLkg&oe=6ABD3247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_kr.png", "id": "947894243385821", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566688_947894246719154_3571825911710120802_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IwloUaxYW8Q7kNvwEAsP8p&_nc_oc=AdrHOj-ei75ouR2ePaDpS9L2B8Iezain6xObAZDS1Fc7QRLuFRMUZJXp3VDYhxJvMO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDU5dLI4-CJbGcsTEkMKuTyt7Fom_YtQmUqYAvSFk-WQ&oe=6ABD0B87"}, "display_name": "\uc720\ub2c8\ubaa8: \ubcc4\ubaa8\ud5d8VR", "keywords": [], "long_description": "\uc720\ub2c8\ubaa8: \ubcc4\ubaa8\ud5d8\uc740 \uc6b0\uc8fc\ubc8c\ub808\ub97c \ud53c\ud558\uace0, \uc815\ub839\uc744 \ubaa8\uc73c\uace0, \ubcc4\uc744 \ubc1d\ud788\ub294 \uce90\uc8fc\uc5bc \ud30c\ubc0d&\ub2f7\uc9c0 \uac8c\uc784\uc785\ub2c8\ub2e4. \uac04\ub2e8\ud55c \uc2ac\ub77c\uc774\ub4dc \uc870\uc791\uc73c\ub85c \uadc0\uc5ec\uc6b4 \ub9ac\ube44\uac00 \uc6b0\uc8fc\ubc8c\ub808\ub97c \ud53c\ud574 \ubb34\uc0ac\ud788 \uc784\ubb34\ub97c \ub9c8\uce60 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc8fc\uc138\uc694!\n\n\ud575\uc2ec \ud2b9\uc9d5:\n\n\uc544\uc2ac\uc544\uc2ac\ud55c \ub2f7\uc9c0 \uac8c\uc784: \ub2e4\uc591\ud55c \uc6b0\uc8fc\ubc8c\ub808\ub4e4\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uba70 \uc784\ubb34\ub97c \uc218\ud589\ud558\uc138\uc694.\n\n\uc815\ub839 \uc218\uc9d1: \uc2a4\ud14c\uc774\uc9c0\ub97c \ud074\ub9ac\uc5b4\ud558\uba74\uc11c \ud544\uc694\ud55c \uc815\ub839\ub4e4\uc744 \ubaa8\uc544\ubcf4\uc138\uc694.\n\n\ubb34\ud55c\ud55c \uc2a4\ud14c\uc774\uc9c0: \uc810\uc810 \uc5b4\ub824\uc6cc\uc9c0\ub294 \uc2a4\ud14c\uc774\uc9c0\ub4e4\uc744 \ub3cc\ud30c\ud558\uba70 \uc2e4\ub825\uc744 \uc99d\uba85\ud558\uc138\uc694.\n\n\ub9ac\ube44 \uac15\ud654: \ubcc4\ube5b \uacb0\uc815\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub9ac\ube44\uc758 \ub2a5\ub825\uce58\ub97c \uac15\ud654\ud558\uc138\uc694.\n\n\ud2b9\ubcc4\ud55c \uac8c\uc784 \ubaa8\ub4dc: \ud2b9\uc815 \uc2a4\ud14c\uc774\uc9c0\ub9c8\ub2e4 \ub3c4\uc804\uc801\uc778 \uac8c\uc784 \ubaa8\ub4dc\ub97c \uacbd\ud5d8\ud558\uc138\uc694.\n\n\ub9ac\ube44\uc758 \uc9d1: \ub9ac\ube44\uc758 \uc9d1\uc5d0\uc11c \uc7ac\ubbf8\uc788\ub294 \ubc18\uc751\ub4e4\uc744 \uc990\uae30\uace0 \uc0c8\ub85c\uc6b4 \uc6b0\uc8fc\uc120\uc744 \ud574\uae08\ud558\uc138\uc694.\n\n\ub2e4\uc591\ud55c \uc6b0\uc8fc\uc120: \ub2e4\ucc44\ub85c\uc6b4 \uac1c\uc131\uc744 \uac00\uc9c4 \uc6b0\uc8fc\uc120\ub4e4\uc744 \ubc14\uafd4 \ud0d1\uc2b9\ud558\uba70 \uc0c9\ub2e4\ub978 \uc7ac\ubbf8\ub97c \ub290\uaef4\ubcf4\uc138\uc694.\n\n\uc720\ub2c8\ubaa8: \ubcc4\ubaa8\ud5d8\uc740 \uac04\ub2e8\ud558\uba74\uc11c\ub3c4 \uc911\ub3c5\uc131 \uc788\ub294 \uac8c\uc784\uc785\ub2c8\ub2e4. \uadc0\uc5ec\uc6b4 \uce90\ub9ad\ud130, \uc544\uc2ac\uc544\uc2ac\ud55c \uac8c\uc784 \ud50c\ub808\uc774, \ub2e4\uc591\ud55c \ucf58\ud150\uce20 \ub4f1 \ubaa8\ub450\uac00 \uc990\uac70\uc6c0\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4. \uc9c0\uae08 \ubc14\ub85c \ub9ac\ube44\uc640 \ud568\uaed8 \uc6b0\uc8fc\ub97c \ub2e4\uc2dc \u
a0a&_nc_ohc=fe7kCQ_02DcQ7kNvwF6HKzj&_nc_oc=AdosETeTn_9AAdGPMZo01rF-8Y9p-H6J4IVbX9Oh0OcsTKRkN5Xb3HUDuGTiF1tsbtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzItb3joSeu8w3O0BNO3M6W1lpSdENhQ0VRNGGPCTbtbg&oe=69CE7FAC"}, {"file_name": "3.png", "id": "8786790398068603", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569475_8786790404735269_6604407083120629571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe0EHMPO4fYQ7kNvwFI-MN6&_nc_oc=AdpxLXubwXp1ByZPBZIOYzEhySfHzALlK2IOz0E6c5ZHwgqLVS9DUyOtBzn4taigtIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcSgtF49xBESMFj4Xlv0OPUC_QWu98q0HaudARZdlMUA&oe=69CE80F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_en.png", "id": "1084540680086032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468917843_1084540683419365_3591522666418303168_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnP6kwS8-bsQ7kNvwHGKeCJ&_nc_oc=AdptAY96KnY8Mnz6W59ujJXlQ1p12DXKf5vQYSI8_HaoK0zngCrxTugt1Ghk2LKetCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp6JhLss6YLm4dDhwDa142hR9NCp0guub_TdGsiEEKeQ&oe=69CE51B8"}, "display_name": "Unimo: StarTrip VR", "keywords": ["casual", "dodge", "cute", "easy", "arcade"], "long_description": "Unimo: StarTrip is a casual farming and dodging game where you help Ribee, an adorable creature, avoid space bugs, collect spirits, and illuminate the stars. With simple slide controls, guide Ribee safely through the levels and complete missions. Experience the thrill of dodging attacks from various space bugs and the satisfaction of collecting spirits to progress through the stages. Prove your skills in the endless mode with increasingly challenging levels.\n\nKey Features:\n\nHeart-pounding dodging gameplay: Maneuver through the onslaught of space bugs to complete your tasks.\n\nSpirit collection: Gather essential spirits as you clear the stages.\n\nInfinite stages: Conquer increasingly difficult stages to test your limits.\n\nPower up Ribee: Utilize Stardust to enhance Ribee's abilities.\n\nSpecial game modes: Experience unique gameplay challenges in specific stages.\n\nRibee's house: Discover fun interactions and unlock new spaceships in Ribee's house.\n\nDiverse spaceships: Pilot a variety of spaceships with unique designs for added fun.\n\nUnimo: StarTrip offers a simple yet addictive gaming experience. With its charming characters, thrilling gameplay, and diverse content, it's sure to provide hours of entertainment. Join Uni on their quest to brighten the universe today!", "short_description": "Embark on a journey to brighten the universe with Ribee!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hwig.games/privacypolicy", "developer_terms_of_service_url": "https://hwiggames38434.imweb.me/termofuse", "publisher_name": "contact HelloVR", "support_website_url": null, "website_url": "https://www.hellovr.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286810218003948"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9261956653822638", "version": "1.0.1"}, "id": "2967392620089
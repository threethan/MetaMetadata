png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ugn7rff9FAQ7kNvwGt2oYB&_nc_oc=AdolQnxirZFXnTUStVefF-iMld8dd2emz4zdg8uPIV_gza1jcULl9P6ZX96OTlao6Vk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFwirAr91HqjAPVC03z7woIq1FCmO2n5PDk1iqT_BO_g&oe=6A79B527"}, {"file_name": "ttag4.png", "id": "1964516027478768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296157_1964516030812101_5270262760619717080_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2oE8TeKoeQQ7kNvwHE2gLU&_nc_oc=AdqjobaEithC200Ky_J7wQu8mKBEk6y92jN97bxsGcGewSMlWy0dTsY3DEhDmOKLSB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhU5tXgcpnaunyu8_VZYFOzoqBB7tZn2XexxmXYcvlnw&oe=6A79C37C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ground runners", "keywords": ["tag", "monkey", "ground", "runners", "project"], "long_description": "Welcome to the jungle\u2014where the trees are tall, the vines stretch for miles, and adventure is everywhere. In this immersive VR experience, you take on the role of a curious and energetic monkey exploring a vibrant jungle world filled with surprises.\n\nMove the way a monkey would. Use your hands to climb towering trees, pull yourself across branches, swing from vines, and leap across the jungle canopy. Every movement is designed for VR, giving you a natural and exciting way to explore the environment.\n\nAs you travel deeper into the jungle, you'll discover hidden locations, mysterious areas, and challenges that reward curiosity and exploration. From dense forests and high treetops to secret paths tucked away in the wild, the jungle is packed with places waiting to be uncovered.\n\nThe world is alive with color, movement, and adventure. Whether you're racing through the treetops, exploring new terrain, or simply enjoying the freedom of the jungle, every moment puts you right in the middle of the action.\n\nThis is a playground built for movement, exploration, and fun. Jump, climb, swing, and explore at your own pace as you experience the jungle from a monkey\u2019s point of view.\n\nFeatures\n\n\ud83d\udc12 Play as a monkey and explore a lively jungle environment\n\n\ud83c\udf34 Climb trees, rocks, and cliffs using natural VR hand movement\n\n\ud83c\udf3f Swing across vines and travel through the jungle canopy\n\n\ud83c\udf4c Discover hidden areas and collect items along the way\n\n\ud83e\udded Explore freely and find secrets throughout the jungle\n\n\n{1611127863429432}", "short_description": "Swing, climb, and explore the wild jungle in an unforgettable VR adventure!\n\nGame Description\nStep into the jungle and become a fearless monkey in this immersive VR adventure. Climb towering trees, swing across vines, and explore a vibrant jungle filled with secrets, challenges, and hidden paths.\n\nUse your hands to move through the world just like a real monkey\u2014leaping between branches, scaling cliffs, and navigating dense jungle environments. Along the way you'll discover mysterious ruins, coll"}]}, "developer_name": null, "developer_privacy_policy_url": "https://groundrunners-privacy-page.base44.app/", "developer_terms_of_service_url": null, "publisher_name": "UltimateJungleMonkeyVirtualRealityAdventureStudiosInteractiveLab", "support_website_url": null, "website_url": "https://discord.gg/q8fgufqPCw", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
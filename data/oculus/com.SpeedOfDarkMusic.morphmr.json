ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxbDJx-_XaAQ7kNvwF_PGdj&_nc_oc=AdptkbWE-r4NPEnvRwZ28Ph6ZkxP_o0i_pPObv1qWw585pL2jPn5SffyaIeB_kOmwUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUnFAdGpa8BOz9uXeL_xQ66uey9SVAbKNyFAOQclcp6w&oe=6AFDC3F1"}, {"file_name": "MorphMixed_Screenshot2_2560x1440.png", "id": "1615833446186555", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308522_1615833449519888_3602940541540318180_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2xHu0_ruWUQ7kNvwGH0rqy&_nc_oc=AdpnRa671rglIlCBjRxRacODE5CeCD7wCAgt_Db-JYQDfOzviAPA9jNoA-G7sv-pTj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9KOjO67v5JL3dqJ4fTP4AYu0YS7aVWowQvjN1W1Q0kA&oe=6AFDCEB1"}, {"file_name": "MorphMixed_Screenshot4_2560x1440.png", "id": "1024390740010818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_1024390743344151_1734622323071757498_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZRY5hYOeHEQ7kNvwG8b6hv&_nc_oc=Adpl04SYEzN4gsldrndPCblJcgOe2K5OUJFLjxK34_rua8rrsuVAG9TwtIrYxVAKuP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJmzUF-grrTD0c2188S95IDdLnM3X-NlIus1L1wMlnGg&oe=6AFDBFDC"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMiTrdfSOzgQ7kNvwE5JK1x&_nc_oc=Adq4rGIEH2ELo42qR1FeHKGZ98EIicsH5wqB1VganRqURHuyE13N7Z6hxg-38i2u9aA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQByAdU1fBCNaH5vxcTMGa3wxi0TmSwC6MyiP6cDF_kNQ&oe=6AFDC89E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I4De8dwKzEQ7kNvwGnQ54Q&_nc_oc=AdovdLZ7I2UdwVlIYlH1qvaoyJdGrJbnFbMnUWThB20q3GbcgQ-2VY0M66sT_51_Jvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr9lpuGPeZSJSuMXpLH1CEb61LDYEqWLnGOmY_BsX8eQ&oe=6AFDAEFA"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality music experience created by audio technologist Kasson Crooker. Interact with sound objects floating around your room to create an immersive sonic experience. Morph Mixed is a free app that comes with single player and local multiplayer modes, along with 14 songs from indie artists from around the world. \n\n**(m)ORPH Mixed** is not a game, but lets you interact with songs in real-time to create an evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around you, yielding an 360-degree experience that you get to control and explore. The original Morph VR-Music app (still available!) was released in 2021 and this brand new version focuses on mixed reality and bringing the music into **your** room. \n\n{1474403690676889}\n\n- Brand new local Multiplayer Mode lets you experience music with friends!\n- Grab, throw, smack, and freeze Orph sound objects using your hands\n- Spatial audio fills your space with immersive 3D sound\n- Move around your room to change the music mix dynamically\n- Grab Orphs sound objects to solo them, Clap your hands to disperse them\n- Control resonant filters by rotating your hands\n- Use microgestures to change visual FX in your space\n- Localized in English, \u65e5\u672c\u8a9e, Fran\u00e7ais\n\n{1525521452555623}\n\n- Bluetech\n- Freezepop\n- Kodomo\n- Yumi Iwaki\n- dvdv\n- Micah Frank\n- Symbion Project (ft Melissa R Kaplan)\n- Symbion Project (ft Mars Nord)\n- The JD's\n- Dispak\n- Tawnylawns\n- ELYXR\n- Khems\n- Rocococo", "short_description": "(m)ORPH Mixed is an immersive mixed reality music experience for Quest 3/3s/Pro. (m)ORPH is not a game, but lets players interact with music to create evolving sonic environments. Interactive sound objects and abstract, audio-reactive visuals float all around your room, yielding a 360-degree spatial audio experience that you get to control and explore. The (m)ORPH app is free and comes with single player and local multiplayer modes, along with 14 songs from indie artists from around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29001679806179485"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620403_1864429794541963_5176123340191706674_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csv9oSBawc0Q7kNvwFVXvk0&_nc_oc=Adq-TvxEj-P6dikDu4twcV-K6F4prF05RIWATEe1W4zywlAsAh0LP5fE_yB_uUA4pPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqv7zKnNEP13QG0DrjW4mtVJ4SjcgoqUkaoKQ0if5NnA&oe=6AFDB4C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "(m)ORPH Mixed", "
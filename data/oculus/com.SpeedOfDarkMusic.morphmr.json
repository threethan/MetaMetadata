=7f20f&oh=00_AQLiBI_SOasPq6OrTQW-_uvNZ_7BdvCAWBpdNPaaJjNpDw&oe=6ABA8771"}, {"file_name": "MorphMixed_Screenshot2_2560x1440.png", "id": "1615833446186555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308522_1615833449519888_3602940541540318180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53Tr2m7Re4kQ7kNvwG4lNG-&_nc_oc=AdqdZKhv5Mf2lgLBNrqfH_EfclKE_szCnaHZ2o5AowZ2DIliag7L5idhxfdTzDSBLMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3kD8U-sNWPyKQEbPjB9cIEN3PnE6FXCTFQRI-7XUJUA&oe=6ABA59F1"}, {"file_name": "MorphMixed_Screenshot4_2560x1440.png", "id": "1024390740010818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628050_1024390743344151_1734622323071757498_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJUif4JlkjIQ7kNvwGs-GVs&_nc_oc=Adrbu--zkCMmeXXzoLI5z-UBGh2bejaBlO80M8ibVyY3JTatlnXHM1y_QzaXtTps2wQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQUFWsEDycjJcF8GOSgKomJBAGiYH2SpwGWm8ZbcHeZQ&oe=6ABA835C"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CngyxVAqqgQ7kNvwGCjmAQ&_nc_oc=AdqEZ5Ib6d7aOEY65FmaChh3fewZ9BHsr6cQcBtJbXp5Nu_oOqIsNTDcUced4WtCc3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVDRQ8fyXb4KdNEKGZmtRim9B5U8O8SieY0DSESjEg4Q&oe=6ABA8C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wArndSTN5pEQ7kNvwG7oAqB&_nc_oc=AdrBEEK7UfNcmwo-uErVYF-O2FpZrUU45jYf5xtRmD_bATXQHct41QjaPw-C_rX4fCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInXTVx2XzczDtoK_TwVMMdnQ52gQHcGTy6-BKMH2QERw&oe=6ABA727A"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality music experience created by audio technologist Kasson Crooker. Interact with sound objects floating around your room to create an immersive sonic experience.\n\nDownload the free app and get 2 songs to experience; Purchase local multiplayer mode and 12 additional songs for $5. Future versions of the app will add new features and more songs for free!\n\n**(m)ORPH Mixed** is not a game, but lets you interact with songs in real-time to create an evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around you, yielding an 360-degree experience that you get to control and explore. The original Morph VR-Music app was released in 2021 and this brand new version focuses on mixed reality and bringing the music into **your** room. \n\n{1474403690676889}\n\n- Brand new local Multiplayer Mode lets you experience music with friends!\n- Grab, throw, smack, and freeze Orph sound objects using your hands\n- Spatial audio fills your space with immersive 3D sound\n- Move around your room to change the music mix dynamically\n- Grab Orphs sound objects to solo them, Clap your hands to disperse them\n- Control resonant filters by rotating your hands\n- Use microgestures to change visual FX in your space\n- Localized in English, \u65e5\u672c\u8a9e, Fran\u00e7ais\n\n{1525521452555623}\n\n- Bluetech\n- Freezepop\n- Kodomo\n- Yumi Iwaki\n- dvdv\n- Micah Frank\n- Symbion Project\n- The JD's\n- Dispak\n- Tawnylawns\n- ELYXR\n- Khems\n- Rocococo", "short_description": "(m)ORPH Mixed is a unique mixed reality music experience for Meta Quest 3/3s/Pro. (m)ORPH is not a game, but lets players interact with music to create evolving sonic environments. Immersive sound objects and abstract, audio-reactive visuals float all around your room, yielding a 360-degree spatial audio experience that you get to control and explore. The (m)ORPH app is free and comes with 2 songs, and a small $5 fee unlocks local multiplayer mode and 12 extra songs from indie artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173470905667050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620403_1864429794541963_5176123340191706674_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iybUBNuEgHIQ7kNvwHcB9Ii&_nc_oc=Adr6Op-DGMuBFAvJrVScuw0g68gqH37CLiiu3l4zSKKr2wk0IzSh9Tf0kE8ED_mD520&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfRCj0kt2OpV_7UpSTH-o4rxiPvJSMBLrMq01k6kbjhQ&oe=6ABA7840"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "(m)ORPH Mixed", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1782514800, "lastRevision": {"nodes": [{"id": "25267120719635431", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"appl
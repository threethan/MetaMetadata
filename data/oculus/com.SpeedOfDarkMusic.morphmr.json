7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sA_s7fWFhMQ7kNvwE4VW4d&_nc_oc=Adr9wKtrygiaSHEbf6p_WiJ_4Ky65bKNQ7P1KhLcP4PHaMaPDke4KN3iecOz4oJlDOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLql4OV-nl6eoPYrF2tGo_iQmGZ2gIazpC90gEuU4WApg&oe=6AB53D5C"}, {"file_name": "MorphMixed_Screenshot3_2560x1440.png", "id": "1585430036252215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628447_1585430039585548_3080045616923216069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfRRz4cA54kQ7kNvwFUauEy&_nc_oc=Adqd_zY72v3_uus_kgh7zztbYT6mkaYUeR2_v4AUjtcGVBGuUH6Aj02_nn6ep1HypEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrxERc9HzH2T6LRZS5_SXUTDSnWiQZ1bUTePfF7luuxg&oe=6AB54171"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkPcfMTLtEQQ7kNvwGLhnlk&_nc_oc=AdpYfyFjlK5VtL7lYB4WTggo5PEEwtzLUpGxQFuf8ilD_EVmmE7-Reutvpi9bBLiA-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKabbLqrnv0USiDVsQYUysPtBbLOMTP-BbmQvTT79lbdA&oe=6AB5461E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMm4El1U3QgQ7kNvwFXfGBY&_nc_oc=AdouVQwzfa2hwyQ5Fi8vDm2Tcn0oLOZNfOGjI5lfTswGEgVqls09wycWYaJsWFJavCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlFyqPDnZ-dVxuC4U9BtOPn7Pjr6by0uTRjEXaNAq5qA&oe=6AB52C7A"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality VR-Music experience created by audio technologist Kasson Crooker. The original Morph VR-Music app was released in 2021 and this brand new version focuses on an immersive, mixed reality experience.\n\n(m)ORPH is not a game, but lets players interact with spatial audio in real-time to create a dynamically evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. Morph was a 3rd place winner in the Meta Start Developers competition in 2025.\n\n# Musical Artists\n- Freezepop ~ \"Swimming Pool\"\n- Kodomo ~ \"Light Rain\"\n- Yumi Iwaki ~ \"Residual Echo\"\n- Tawnylawns ~ \"Easy Work\"\n- Khems ~ \"Forest Bathing\"\n- Dispak ~ \"Koshkina\"\n- Symbion Project ~ \"Nodus Tollens\" ft Mars Nord\n- ELYXR ~ \"Strange Stubborn Proud\" ft Kurt Larson\n- The JD's ~ \"Proust\"\n- Rocococo ~ \"Reject the Data\"", "short_description": "(m)ORPH Mixed is a mixed reality music experience for Meta Quest 3/3s created by audio technologist Kasson Crooker. (m)ORPH is not a game, but lets players interact with music in real-time to create a dynamically evolving sonic environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. The Morph app is free and comes with 2 songs and a small fee to unlock the rest of the songs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
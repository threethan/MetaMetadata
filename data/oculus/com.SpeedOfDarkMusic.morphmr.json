//scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB7ywqee68YQ7kNvwH8ou4c&_nc_oc=AdofyP_5kwpa1ceaJPKl_7fz_pJXt_8H8_GvVP_wexWIJhmfiq8IX_muY5gJ_bJ9l-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqdcsQbSG1ZV8ARezZ7cXaI2XaqQ1CfIINm_hEDBgtbA&oe=6A9023DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4gZwyeCuOgQ7kNvwG_keCj&_nc_oc=Adr_7YjlXNQnj4n3xaBWQ14X3y-m_zwcNHokmOd4iBTcV4EahoXYC77BN_zvLdKhL2U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvq0vwoR5yL9RHallguqtKm6vL1AICBy5ojc-6YOWDEQ&oe=6A900A3A"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality VR-Music experience created by audio technologist Kasson Crooker. The original Morph VR-Music app was released in 2021 and this brand new version focuses on an immersive, mixed reality experience.\n\n(m)ORPH is not a game, but lets players interact with spatial audio in real-time to create a dynamically evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. Morph was a 3rd place winner in the Meta Start Developers competition in 2025.\n\n# Musical Artists\n- Freezepop ~ \"Swimming Pool\"\n- Kodomo ~ \"Light Rain\"\n- Yumi Iwaki ~ \"Residual Echo\"\n- Tawnylawns ~ \"Easy Work\"\n- Khems ~ \"Forest Bathing\"\n- Dispak ~ \"Koshkina\"\n- Symbion Project ~ \"Nodus Tollens\" ft Mars Nord\n- ELYXR ~ \"Strange Stubborn Proud\" ft Kurt Larson\n- The JD's ~ \"Proust\"\n- Rocococo ~ \"Reject the Data\"", "short_description": "(m)ORPH Mixed is a mixed reality music experience for Meta Quest 3/3s created by audio technologist Kasson Crooker. (m)ORPH is not a game, but lets players interact with music in real-time to create a dynamically evolving sonic environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. The Morph app is free and comes with 2 songs and a small fee to unlock the rest of the songs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25267120679635435"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4186404881503225"}]}, "baseline_offer": {"id": "4186404881503225"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782514800, "status": "PUBLISHED", "id": "4186404881503225"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27279881925025957", "version": "1.0.2"}, "id": "1389872692503577", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries":
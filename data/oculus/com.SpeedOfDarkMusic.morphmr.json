7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMAxSw60eT4Q7kNvwGwbQys&_nc_oc=AdrBQIOakeFkbVGwKkE7vl-nnV4WK6xGXHFK_0f0M-34PkxeTl_Bm025uaZrK7dw7CU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8X8R4YZh8093e9fwx_xvbk3bxA8udShe2754VKtk2Yg&oe=6AC660DC"}, {"file_name": "MorphMixed_Screenshot3_2560x1440.png", "id": "1585430036252215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_1585430039585548_3080045616923216069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqGpeCV6gMIQ7kNvwF4waCI&_nc_oc=AdrDdVEot2PBOMoGAZW71znKA-59mn7enpAOPAzCmXDlm-gVqUUa7UtlEclgyFV42Y0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmSgnc8x5FHUPNFWBqGZlDDDjSo5cXhS-uZ1-MxCX_xg&oe=6AC664F1"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXB1DyG30voQ7kNvwHDl8Ta&_nc_oc=Adpdg3gPJgsiPNsZzsvuK1bjKEwhBieVrB8TBsLK2Lc4e7Vzt4xk67dzDDpaHZ3d8Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7u0C-pWKfL1ZIBWkJlo0e_q1jGYWGg8Kfk_o6SBYJog&oe=6AC6699E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cSFJRNSTfwQ7kNvwFC51N1&_nc_oc=Adooecl5jim0zeIqAjr1rseVvPAsDdU2aBGpWjt_TO9ZGDSdgVxRcQzENT1LexAHArI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3d2QALY4VXBEBVHGx9mVYCJOHarmpxRnhgx4T4qiGxg&oe=6AC64FFA"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality VR-Music experience created by audio technologist Kasson Crooker. The original Morph VR-Music app was released in 2021 and this brand new version focuses on an immersive, mixed reality experience.\n\n(m)ORPH is not a game, but lets players interact with spatial audio in real-time to create a dynamically evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. Morph was a 3rd place winner in the Meta Start Developers competition in 2025.\n\n# Musical Artists\n- Freezepop ~ \"Swimming Pool\"\n- Kodomo ~ \"Light Rain\"\n- Yumi Iwaki ~ \"Residual Echo\"\n- Tawnylawns ~ \"Easy Work\"\n- Khems ~ \"Forest Bathing\"\n- Dispak ~ \"Koshkina\"\n- Symbion Project ~ \"Nodus Tollens\" ft Mars Nord\n- ELYXR ~ \"Strange Stubborn Proud\" ft Kurt Larson\n- The JD's ~ \"Proust\"\n- Rocococo ~ \"Reject the Data\"", "short_description": "(m)ORPH Mixed is a mixed reality music experience for Meta Quest 3/3s created by audio technologist Kasson Crooker. (m)ORPH is not a game, but lets players interact with music in real-time to create a dynamically evolving sonic environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. The Morph app is free and comes with 2 songs and a small fee to unlock the rest of the songs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
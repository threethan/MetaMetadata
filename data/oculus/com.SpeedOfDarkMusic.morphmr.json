7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB7PPO8ZN7gQ7kNvwGyi9hn&_nc_oc=Adocx72dUqiWCph98BzttdYivvLUK6esitRj5ShBHGY54gjRBdSW5ZMMwEsAAP3JuvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQng6hOFYaygSj5-1qIt-mJI_Lu5jPjNofC-mSz8w7kdA&oe=6AE9F95C"}, {"file_name": "MorphMixed_Screenshot3_2560x1440.png", "id": "1585430036252215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_1585430039585548_3080045616923216069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfgNE5KCp-4Q7kNvwGwarSy&_nc_oc=AdoO47EauhQvWroaKNYDXVrk3WrXXSGHt66zAAVT0HR7N1HFTnAVvJEZuWnWthntpOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFdBlISni2d_TfPAk0AHs6j1E2aC8R5V6YZfHQgVaN3Q&oe=6AE9FD71"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LITpBD2pessQ7kNvwGJAqd5&_nc_oc=Adp5Uu5T3ZGkVV5AmCc65120ttFfPpJTyBnqw8PnbyUbBQ1nyhRZ4gwYSOPTVGkkE4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTkXopwDwAuA6gvlxLv46a5UizgEetHGYzRZqHuOJezA&oe=6AEA021E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl6cBSxYUb8Q7kNvwGeS_Xf&_nc_oc=Adr6J6zAbgOBAJMcNf91rjp-A-oci4zz7m3vhi3uKy47BuYXtFnfkLWhttJD_lE8o54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGs81iblxR7qqnYP9yrID8jS88UUl3yviF-SBx5UhQlQ&oe=6AE9E87A"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality VR-Music experience created by audio technologist Kasson Crooker. The original Morph VR-Music app was released in 2021 and this brand new version focuses on an immersive, mixed reality experience.\n\n(m)ORPH is not a game, but lets players interact with spatial audio in real-time to create a dynamically evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. Morph was a 3rd place winner in the Meta Start Developers competition in 2025.\n\n# Musical Artists\n- Freezepop ~ \"Swimming Pool\"\n- Kodomo ~ \"Light Rain\"\n- Yumi Iwaki ~ \"Residual Echo\"\n- Tawnylawns ~ \"Easy Work\"\n- Khems ~ \"Forest Bathing\"\n- Dispak ~ \"Koshkina\"\n- Symbion Project ~ \"Nodus Tollens\" ft Mars Nord\n- ELYXR ~ \"Strange Stubborn Proud\" ft Kurt Larson\n- The JD's ~ \"Proust\"\n- Rocococo ~ \"Reject the Data\"", "short_description": "(m)ORPH Mixed is a mixed reality music experience for Meta Quest 3/3s created by audio technologist Kasson Crooker. (m)ORPH is not a game, but lets players interact with music in real-time to create a dynamically evolving sonic environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. The Morph app is free and comes with 2 songs and a small fee to unlock the rest of the songs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB7PPO8ZN7gQ7kNvwGI7Xq0&_nc_oc=AdrshTWbvcMLPpqF98Q_DuURV5gyHfT0yvxFdzN-L_sYVIgon3X_jyi9bsduwxIUbdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmkusyXmywe99bp1-WJ4fgIwSAMFc9-unAXwkCDakcSA&oe=6AEB4ADC"}, {"file_name": "MorphMixed_Screenshot3_2560x1440.png", "id": "1585430036252215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628447_1585430039585548_3080045616923216069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0b_2tkRwCwQ7kNvwGLVh3G&_nc_oc=AdqKXWUPap6gShd13sUvsxBHMT3P9_-PFuGBAQbjaGJW-9QX4ncpOS1frKtJyGGQCSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0atcGtwijltEbpef6rD2iJ0-G_ldKERQ2PP0gq87deA&oe=6AEB4EF1"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM0bAr0TfWoQ7kNvwHe8QTF&_nc_oc=AdoP7ZrY53q1hEUXzE-_Am2E3L4jN-fj9d0FIg4zgk8PLc8lDFaLv7dBHSL58keezUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSN7-QsObF9zIV5GUrfAPn3KYi0cFqKn-yt6IjSnyrgg&oe=6AEB539E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl6cBSxYUb8Q7kNvwHMJT6M&_nc_oc=AdrKvUnKuhGGwi4uT5oiQMpNxOZrEliWtDKtZPygPI1twRr8cIG2-t2_7QQJdhgxZm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvR9iEoFOTpXMFqCDjq3PvzmPEFiIHzmL1OpnZMvm2AA&oe=6AEB39FA"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality VR-Music experience created by audio technologist Kasson Crooker. The original Morph VR-Music app was released in 2021 and this brand new version focuses on an immersive, mixed reality experience.\n\n(m)ORPH is not a game, but lets players interact with spatial audio in real-time to create a dynamically evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. Morph was a 3rd place winner in the Meta Start Developers competition in 2025.\n\n# Musical Artists\n- Freezepop ~ \"Swimming Pool\"\n- Kodomo ~ \"Light Rain\"\n- Yumi Iwaki ~ \"Residual Echo\"\n- Tawnylawns ~ \"Easy Work\"\n- Khems ~ \"Forest Bathing\"\n- Dispak ~ \"Koshkina\"\n- Symbion Project ~ \"Nodus Tollens\" ft Mars Nord\n- ELYXR ~ \"Strange Stubborn Proud\" ft Kurt Larson\n- The JD's ~ \"Proust\"\n- Rocococo ~ \"Reject the Data\"", "short_description": "(m)ORPH Mixed is a mixed reality music experience for Meta Quest 3/3s created by audio technologist Kasson Crooker. (m)ORPH is not a game, but lets players interact with music in real-time to create a dynamically evolving sonic environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. The Morph app is free and comes with 2 songs and a small fee to unlock the rest of the songs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
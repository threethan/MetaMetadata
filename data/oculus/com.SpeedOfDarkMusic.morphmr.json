7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJUif4JlkjIQ7kNvwGs-GVs&_nc_oc=Adrbu--zkCMmeXXzoLI5z-UBGh2bejaBlO80M8ibVyY3JTatlnXHM1y_QzaXtTps2wQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQUFWsEDycjJcF8GOSgKomJBAGiYH2SpwGWm8ZbcHeZQ&oe=6ABA835C"}, {"file_name": "MorphMixed_Screenshot3_2560x1440.png", "id": "1585430036252215", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628447_1585430039585548_3080045616923216069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVRc37dhEd0Q7kNvwEbPKuK&_nc_oc=AdpVRTZkhNDV-lwK1mzZIpNfV9UaMdXIFMcN3tkyXeLTNecAtjgzF1R3glEauibghH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiBI_SOasPq6OrTQW-_uvNZ_7BdvCAWBpdNPaaJjNpDw&oe=6ABA8771"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CngyxVAqqgQ7kNvwGCjmAQ&_nc_oc=AdqEZ5Ib6d7aOEY65FmaChh3fewZ9BHsr6cQcBtJbXp5Nu_oOqIsNTDcUced4WtCc3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVDRQ8fyXb4KdNEKGZmtRim9B5U8O8SieY0DSESjEg4Q&oe=6ABA8C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wArndSTN5pEQ7kNvwG7oAqB&_nc_oc=AdrBEEK7UfNcmwo-uErVYF-O2FpZrUU45jYf5xtRmD_bATXQHct41QjaPw-C_rX4fCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInXTVx2XzczDtoK_TwVMMdnQ52gQHcGTy6-BKMH2QERw&oe=6ABA727A"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality VR-Music experience created by audio technologist Kasson Crooker. The original Morph VR-Music app was released in 2021 and this brand new version focuses on an immersive, mixed reality experience.\n\n(m)ORPH is not a game, but lets players interact with spatial audio in real-time to create a dynamically evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. Morph was a 3rd place winner in the Meta Start Developers competition in 2025.\n\n# Musical Artists\n- Freezepop ~ \"Swimming Pool\"\n- Kodomo ~ \"Light Rain\"\n- Yumi Iwaki ~ \"Residual Echo\"\n- Tawnylawns ~ \"Easy Work\"\n- Khems ~ \"Forest Bathing\"\n- Dispak ~ \"Koshkina\"\n- Symbion Project ~ \"Nodus Tollens\" ft Mars Nord\n- ELYXR ~ \"Strange Stubborn Proud\" ft Kurt Larson\n- The JD's ~ \"Proust\"\n- Rocococo ~ \"Reject the Data\"", "short_description": "(m)ORPH Mixed is a mixed reality music experience for Meta Quest 3/3s created by audio technologist Kasson Crooker. (m)ORPH is not a game, but lets players interact with music in real-time to create a dynamically evolving sonic environment. Immersive sound objects and abstract, audio-reactive visuals are all around your room, yielding an 360-degree experience that you get to control and explore. The Morph app is free and comes with 2 songs and a small fee to unlock the rest of the songs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
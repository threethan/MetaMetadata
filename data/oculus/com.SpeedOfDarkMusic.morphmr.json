=7f20f&oh=00_AQT0atcGtwijltEbpef6rD2iJ0-G_ldKERQ2PP0gq87deA&oe=6AEB4EF1"}, {"file_name": "MorphMixed_Screenshot2_2560x1440.png", "id": "1615833446186555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308522_1615833449519888_3602940541540318180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DA1-mfLsf9IQ7kNvwHDMd4a&_nc_oc=AdpmYqO_uTympaFQDnI4nv2kmieV1E_6Thef3smleUDHDTG-43vnYHFVHXp5NQcwd88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSHmTF-GPcniMZkK8oWYEZ5ZsIMDB1IVNSF3LM9ORzeQ&oe=6AEB59B1"}, {"file_name": "MorphMixed_Screenshot4_2560x1440.png", "id": "1024390740010818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628050_1024390743344151_1734622323071757498_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB7PPO8ZN7gQ7kNvwGI7Xq0&_nc_oc=AdrshTWbvcMLPpqF98Q_DuURV5gyHfT0yvxFdzN-L_sYVIgon3X_jyi9bsduwxIUbdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmkusyXmywe99bp1-WJ4fgIwSAMFc9-unAXwkCDakcSA&oe=6AEB4ADC"}, {"file_name": "MorphMixed_Screenshot5_2560x1440.png", "id": "2505860233172637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_2505860236505970_4365992515863016933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM0bAr0TfWoQ7kNvwHe8QTF&_nc_oc=AdoP7ZrY53q1hEUXzE-_Am2E3L4jN-fj9d0FIg4zgk8PLc8lDFaLv7dBHSL58keezUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSN7-QsObF9zIV5GUrfAPn3KYi0cFqKn-yt6IjSnyrgg&oe=6AEB539E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morph Mixed app logo_V2 2560x1440.png", "id": "1017669154139104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308063_1017669157472437_7783909032279688869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl6cBSxYUb8Q7kNvwHMJT6M&_nc_oc=AdrKvUnKuhGGwi4uT5oiQMpNxOZrEliWtDKtZPygPI1twRr8cIG2-t2_7QQJdhgxZm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvR9iEoFOTpXMFqCDjq3PvzmPEFiIHzmL1OpnZMvm2AA&oe=6AEB39FA"}, "display_name": "(m)ORPH Mixed", "keywords": ["music", "mixed", "creativity", "audio", "immersive"], "long_description": "**(m)ORPH Mixed** is a mixed reality music experience created by audio technologist Kasson Crooker. Interact with sound objects floating around your room to create an immersive sonic experience.\n\nDownload the free app and get 2 songs to experience; Purchase local multiplayer mode and 12 additional songs for $5. Future versions of the app will add new features and more songs for free!\n\n**(m)ORPH Mixed** is not a game, but lets you interact with songs in real-time to create an evolving music environment. Immersive sound objects and abstract, audio-reactive visuals are all around you, yielding an 360-degree experience that you get to control and explore. The original Morph VR-Music app was released in 2021 and this brand new version focuses on mixed reality and bringing the music into **your** room. \n\n{1474403690676889}\n\n- Brand new local Multiplayer Mode lets you experience music with friends!\n- Grab, throw, smack, and freeze Orph sound objects using your hands\n- Spatial audio fills your space with immersive 3D sound\n- Move around your room to change the music mix dynamically\n- Grab Orphs sound objects to solo them, Clap your hands to disperse them\n- Control resonant filters by rotating your hands\n- Use microgestures to change visual FX in your space\n- Localized in English, \u65e5\u672c\u8a9e, Fran\u00e7ais\n\n{1525521452555623}\n\n- Bluetech\n- Freezepop\n- Kodomo\n- Yumi Iwaki\n- dvdv\n- Micah Frank\n- Symbion Project\n- The JD's\n- Dispak\n- Tawnylawns\n- ELYXR\n- Khems\n- Rocococo", "short_description": "(m)ORPH Mixed is a unique mixed reality music experience for Meta Quest 3/3s/Pro. (m)ORPH is not a game, but lets players interact with music to create evolving sonic environments. Immersive sound objects and abstract, audio-reactive visuals float all around your room, yielding a 360-degree spatial audio experience that you get to control and explore. The (m)ORPH app is free and comes with 2 songs, and a small $5 fee unlocks local multiplayer mode and 12 extra songs from indie artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/morph-mixed-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": null, "website_url": "https://www.speedofdarkmusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28173470905667050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620403_1864429794541963_5176123340191706674_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6KUcZ8whOUQ7kNvwF6Xsus&_nc_oc=Adqa29ZaX_8At6i_cVIxSpbE4dNF99J4hpeCFvwvFmBjndQ3dgTGnzvsGu0aUHRcJk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5GCthf_V5W9Uq5MC0ZvazzmMdIQO-5qyMX32qEDyOLA&oe=6AEB3FC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "(m)ORPH Mixed", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1782514800, "lastRevision": {"nodes": [{"id": "25267120719635431", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"appl
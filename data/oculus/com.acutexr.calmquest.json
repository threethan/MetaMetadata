g", "id": "1631150894205742", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391761_1631150897539075_3532776644571767313_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kQVxIh1AesQ7kNvwH3R26P&_nc_oc=AdqVPgxNLlWhF_pFoEhC7siqVaqbRVWNBgOanoFvuuzlbvIXCi-u3TaCr3r6QcqmWKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0vbroPu22r3Z6HgBxJbKt9HnnxT0PnjglcLBSQ0JcSw&oe=6A6CAFA2"}, {"file_name": "Waves_MQ.png", "id": "1088645343298840", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473397150_1088645346632173_5154651879213960730_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4VM5JlkwqgQ7kNvwHS1z-a&_nc_oc=AdoPblaKGuxx_C6P3AxxosaionvQP5AP7G8N1hv4_qFgWe3OmdGxRncXwZ_wUJ3pDrk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzNZEy_YTim5U15RzYnLqxrdtkweLJxDe7SGkBHh2RYg&oe=6A6C9255"}, {"file_name": "Tower.png", "id": "30203371962583253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473400713_30203371992583250_2302382378997594063_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC5x2SuOsTgQ7kNvwEsD4pj&_nc_oc=Adqcjf9OzukMJCEMh9dL45U_QyF5o2P-cumvpRthTRirEqoEoReCQZf6y3o5xJzEvU8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP9r79WSmczZQH3g28xR1cyagQxUEbCcPNAsT3XrSu_Q&oe=6A6CC225"}, {"file_name": "Circles_MQ.png", "id": "1956758908189239", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_1956758911522572_3780879742703143327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-3fPneVgb8Q7kNvwHRvJZA&_nc_oc=Adr529fR-x50mfxzdQvmYBpKg-whZrJiembXziaMe5WukMTL5nqKa2cI7rh4mfnJ4dc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYAhWMoq3LqRiWJKtBT9I_hD3xZwHE--OXwByBsy1gqw&oe=6A6CB6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calm Quest Trailer Cover Image.png", "id": "1467222140828410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822819_1467222144161743_1557896597955807849_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfwMxk1YaXcQ7kNvwGJfm6h&_nc_oc=AdpgYJRtakPKg46lI9o8RleEmm1tzq0v6_OcxJDDtOsPKTus8ERPXX3OEveORd0Umc0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5Cb1JxSy6VENP3V2U9M1tFyyHbmYXSgG7A9tmGL_G-g&oe=6A6CA48F"}, "display_name": "Calm Quest Pro", "keywords": ["Mindfulness", "Wellness", "Relaxation", "biofeedback", "Calm"], "long_description": "Don\u2019t just go to therapy! Step into a living, responsive world where you are the architect of calm. **Calm Quest Pro** leverages cutting-edge heart-rate variability (HRV) biofeedback to let your own physiology sculpt the virtual landscape in real time. As your HRV stabilizes through mindful breathing, watch lush forests bloom, floods ebb, or magical books return to their places\u2014each environment attuned to your inner state.\n\n**Key Features**\n- HRV-Driven Environments: Your heartbeat is the controller. Grow blossoms, shift sunsets, or calm stormy seas simply by modulating your HRV through guided breathwork.\n- Progress & Insights: Your therapist can track your HRV improvements, total biofeedback sessions, and stress-reduction milestones and tailor your therapy sessions better than before.\n\nWhether you\u2019re aiming to sharpen focus, relieve stress, or enhance sleep quality, Calm Quest Pro turns your Meta Quest headset into a living mirror of your physiology. Slip on your headset and heartrate sensor, tune into your heartbeat, and begin crafting inner peace in worlds that bloom, breathe, and respond\u2014one beat at a time.\n\n***Therapist-Guided Only**\n\nCalm Quest Pro is available exclusively through licensed mental health professionals. Calm Quest is not a medical device, but a gamification tool that assists therapists and turns your therapy into play.", "short_description": "Don\u2019t just go to therapy! Embark on immersive mindfulness journeys in stunning VR worlds. Tailored for therapists and Meta Quest headsets, Calm Quest Pro helps you unwind, focus, and learn about your own body. \n\nStep into a new realm of relaxation with Calm Quest Pro, the ultimate VR experience designed to center your mind and soothe your senses. Harness your heartbeat to shape serene VR environments. Calm Quest Pro uses real-time HRV biofeedback to guide your relaxation, modulate the world arou"}]}, "developer_name": null, "developer_privacy_policy_url": "https://acutexr.com/calm-quest-privacy-policy", "developer_terms_of_service_url": "https://acutexr.com/calm-quest-website-terms-of-use/", "publisher_name": "Acute XR", "support_website_url": null, "website_url": "https://www.acutexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9740844182672833"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473404015_577618204846434_5145652026548880300_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipnj3h3gVdcQ7kNvwFxp9fv&_nc_oc=Adok1-vaeMUjAw-tMeyCX1nGGCx7_MVcvjkCUuixCGnHMqi531u2ufbdio8R8Zg1qVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD1N0IUFTxYdTBtSU00b3rlSvd5q9z1rKAEpilhB19tg&oe=6A6CB39D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Calm Quest Pro", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_n
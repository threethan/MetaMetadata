keAcQ7kNvwH4XrP2&_nc_oc=AdoEebEEFS1oa-D592CzwGQ6atQAQB-yWwGxnWx2lzrS26mh78DOY8i1Vfc1MYgm2R4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAk0rjNJkF9F_59jzk4ognMEOZl6LI23I1qIGD8aljaA&oe=6AFDC731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1755997718856108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1755997722189441_6627962559273065949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRtacDfoNUEQ7kNvwEXt65p&_nc_oc=Adr7Ir-e7pjPpSuKrghmIciPt-RGmKeJWUCRSFZgywTf0aJTt5tYfIyQSjgIizSQ608&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdr5V3BTDU99BftD0zfw_W_ZM7fqviOZ2vX_lEEPKf9Q&oe=6AFDBB02"}, "display_name": "Flight Simulator Milan", "keywords": ["flight", "simulator", "milan", "italy", "jet"], "long_description": "Flight Simulator Milan puts you in the captain's seat over the real Lombardy.\n\nTHE REAL MILAN\nReal satellite, elevation and map data: the Duomo and the gold Madonnina, the Galleria, La Scala, the Castello Sforzesco, the Arco della Pace, the Navigli, Torre Velasca, Centrale, the Pirelli tower, the Unicredit tower, Bosco Verticale, CityLife's three towers and San Siro.\n\nMONZA, THE LAKES AND THE ALPS\nOver Monza's circuit and the Villa Reale to Como's Duomo, Brunate and Lake Como, Varese's Sacro Monte, Lake Maggiore's Rocca di Angera and San Carlone, south to the Certosa di Pavia - with the Alps on the horizon.\n\nBETWEEN THE CITYLIFE TOWERS\nLow through the piazza between Isozaki's, Hadid's and Libeskind's towers.\n\nA LIVING CITY\nTrains on their real tracks, traffic on the real roads. At night the Duomo, Porta Nuova and San Siro light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar at Scalo Farini, Porta Nuova out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nCity approach, lakes approach, Malpensa hop, the Naviglio + Ticino run, the CityLife towers, Lake Como, a scramble, Milan by night, a city tour.\n\nENGLISH AND ITALIAN\nMenus in English or Italian.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Milan, built from real satellite and map data: the Duomo and its Madonnina, the Galleria, the Castello Sforzesco, Porta Nuova's towers, CityLife and San Siro - then over Monza's circuit to Lake Como, Lake Maggiore and the Alps. Start in your own glass hangar, talk to air traffic control, thread the CityLife towers and land at Malpensa, Linate and Bresso. English and Italian menus."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatormilan/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatormilan/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381751051688097"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__t
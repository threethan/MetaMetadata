5/604385997_965376816009058_99026214440418829_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q3orhYCv64Q7kNvwE3O6Zc&_nc_oc=AdrjFEtjOlsdx6X26HlnWEy5loSA6KG0mWqBMpHjlv2HKroduga4KYRu-1WTryB-J0w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFUz5DWHwcmIWWg27VwX2jtuumIAzgm7u9Aw_6UX2rgw&oe=6AFC8F30"}, {"file_name": "screenshot_5.png", "id": "1508188061049063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/814574569_1508188064382396_2690057372990690512_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYOIE-nGW90Q7kNvwH9MIpO&_nc_oc=Adqy3o0CpSUtHUHlsAl4d4TYNWWTe3tAg30q-n93n3HyVRjFXKldEwokFTedFTDr0yg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlHzkGB38Ydfi86YpyhNgWLW5Y079fyoK59d_jruuxzg&oe=6AFC8127"}, {"file_name": "screenshot_2.png", "id": "1653108536520019", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673652249_1653108539853352_3464338724831862743_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRUrqNtz7sgQ7kNvwER2T6d&_nc_oc=AdqqXFxGivp4vYlphl0IERzH0xxSFzRLeuofhDzfZED5QMJu7X7dlPoRa0UR_5dxDmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5RQy1rF2Z06wo0v861mtbsw9uw2IMGTLR7eMwMj5rgg&oe=6AFC7F87"}, {"file_name": "screenshot_3.png", "id": "2523717474800532", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_2523717478133865_3840871955966366907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvjp-XW5RhUQ7kNvwHDDPrH&_nc_oc=Adoae_G-auwnRaUGjVzd5frSOCCK0xWHwu9-sn8QowGTvvUphJYXa9qbPHUxI1rJU_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj1fRjrQfgoF0-H2qr_nXWY9eNPEG8OFH1Ypbh2PaPQg&oe=6AFC6060"}, {"file_name": "screenshot_4.png", "id": "4447705918812368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_4447705922145701_5551791111130984268_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGGB4-dkeAcQ7kNvwGad2vY&_nc_oc=AdpRTcGmqNCkSkPHmJiHkKuNSi7L00ELWHftCOg7V8I2HcblfsL2EjKNuFlpWVNa0eo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ZlXV7-sYYI0rMQ0nNeEzw4MGjwVFAibFhLTdIEqa2A&oe=6AFC75B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1755997718856108", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830904_1755997722189441_6627962559273065949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRtacDfoNUEQ7kNvwECwJZg&_nc_oc=AdoH6ikRUdAGxZ06AqC4TLehqVKhRHRYK93b2CVB3r5ItmG0zXBjSATOOE3lU4p20nE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG6QHaoCKfKAClVLsvaldnuPFrV6JcOeAeOFS0moOH4A&oe=6AFC6982"}, "display_name": "Flight Simulator Milan", "keywords": ["flight", "simulator", "milan", "italy", "jet"], "long_description": "Flight Simulator Milan puts you in the captain's seat over the real Lombardy.\n\nTHE REAL MILAN\nReal satellite, elevation and map data: the Duomo and the gold Madonnina, the Galleria, La Scala, the Castello Sforzesco, the Arco della Pace, the Navigli, Torre Velasca, Centrale, the Pirelli tower, the Unicredit tower, Bosco Verticale, CityLife's three towers and San Siro.\n\nMONZA, THE LAKES AND THE ALPS\nOver Monza's circuit and the Villa Reale to Como's Duomo, Brunate and Lake Como, Varese's Sacro Monte, Lake Maggiore's Rocca di Angera and San Carlone, south to the Certosa di Pavia - with the Alps on the horizon.\n\nBETWEEN THE CITYLIFE TOWERS\nLow through the piazza between Isozaki's, Hadid's and Libeskind's towers.\n\nA LIVING CITY\nTrains on their real tracks, traffic on the real roads. At night the Duomo, Porta Nuova and San Siro light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar at Scalo Farini, Porta Nuova out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nCity approach, lakes approach, Malpensa hop, the Naviglio + Ticino run, the CityLife towers, Lake Como, a scramble, Milan by night, a city tour.\n\nENGLISH AND ITALIAN\nMenus in English or Italian.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Milan, built from real satellite and map data: the Duomo and its Madonnina, the Galleria, the Castello Sforzesco, Porta Nuova's towers, CityLife and San Siro - then over Monza's circuit to Lake Como, Lake Maggiore and the Alps. Start in your own glass hangar, talk to air traffic control, thread the CityLife towers and land at Malpensa, Linate and Bresso. English and Italian menus."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatormilan/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatormilan/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381751051688097"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1121829473621928"}]}, "baseline_offer": {"id": "1121829473621928"}, "is_approved": true, "firstOffer": {"n
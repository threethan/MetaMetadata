kNvwEGe_hJ&_nc_oc=AdkWVViuBTM95aVsWb-juWzBLE3689uF7dFDvU25iRxw4HC9GOZS6m-Xrvnzww9VW1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxsvGPkMZEN4XNQRKy675eroLBOaEQe8UDPafrF0WiBA&oe=69B29EC3"}, {"file_name": "38974500_357368075045296_1291658929771642880_n.png", "id": "257358954110865", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031441_257358957444198_1243485050372084504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzGTFCU_JmwQ7kNvwHJzDqD&_nc_oc=AdkidBw-GngP-hh4VmrFnyF-xHj0Q903amaFzRpcPF_f_46A5XnAPtWDW_iCwIsKPv4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFotAMDpADpePAAfPiumkX08gqJFbxPUlsRFVC1oVSTw&oe=69B2A34D"}, {"file_name": "38974776_145862073032626_7297916684566790144_n.png", "id": "1554773452038676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982548_1554773455372009_2813697591237283979_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5ECbT4BEWwQ7kNvwFlhw0t&_nc_oc=AdmZVtHJq6q_pqkdrKTeSKuu3HgLl3rxiZDVv3T3VBqX2XgNe_PRt9puSBc6akWNv4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxPKWdJEj_hSdh7RjTwSKrZ6gLPUtYlYtkv6jC8aA93MA&oe=69B2BCFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974546_439839219876673_5452841653813379072_n.png", "id": "355975184104668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982608_355975187438001_5373475364883358199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViKoaKPA_g0Q7kNvwFjE389&_nc_oc=AdmcchvkAgY9NrAZCa3CQ7HnqbaIRXv_JFwov6CjnFuVFuv2DhALxkC0ma8ubT6kT1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6d2Ys__SYNHEexwyjCZp_522onS9AtZxB4sozAn4y7g&oe=69B2C135"}, "display_name": "Pool Game", "keywords": [], "long_description": "Enter the immersive world of Pool Game Solo, the VR billiards experience that lets you hone your skills or simply unwind in style.  Step into a meticulously detailed virtual pool hall, complete with rich textures and atmospheric lighting.  Pick up your virtual cue with intuitive controls that mimic the real deal - feel the weight, the balance, and the satisfying click of a perfect shot. \n\nChallenge yourself in Solo Mode, perfecting trick shots, mastering spins, and racking up impressive scores.  In the mood for competition?  Face off against a cunning AI opponent in various difficulty levels, each offering a unique test of pool prowess.  Showcase your skills with a variety of classic game modes, from the timeless Eight-Ball to the fast-paced Nine-Ball. \n\nPool Game Solo isn't just about competition - it's about pure VR billiards bliss.  Soundtrack to your liking?   No problem!  The game integrates with your personal music library for a truly personalized experience.   Pool Game Solo - Rack up some fun, all by yourself, or go toe-to-toe with the AI.  The choice is yours.\n\nGame Features :\n- Play Solo or with AI\n- Impressive visuals, great animations and double fun\n- Play easy, hard\n- Supports battery saver\n\nTips: The goal of game is for simulation realistic experience only.", "short_description": "Step into the world of billiards like never before with Pool Game Solo VR!  Sharpen your skills or unwind in stunning virtual environments. Play solo, hone your technique, or challenge the cunning AI.  Intuitive VR controls put the perfect shot at your fingertips.  Rack up some fun with Pool Game Solo VR! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/metapolicy.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
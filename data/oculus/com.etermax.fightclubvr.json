dn.com/v/t64.5771-25/499620504_1338987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fz4mqwlLaVoQ7kNvwF_XHOa&_nc_oc=AdqpDwR1gqBo3G3QBuIZ3jn9aVZ5BoKBW1HrdTy5jJQkaA6EbcrKaYosAabULLsnf7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wgodIcbpG_0dXxGhLnKGKdEh3oZpsFfRcYqJe-tQWHg&oe=6A356DC0"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdTbWD2g3hkQ7kNvwG2u01E&_nc_oc=Adp-J6H9uoZHctHuVggf9AH-BP9K4UNm0H60CP3T8Ub2n0VFqFSDgE2hUFJ19OkgBFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qcCUsAjp7hty-mpfynw6lgJv3i6XV2dCB8ramMUY7BA&oe=6A3566CD"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4cSoTv5C1QQ7kNvwHT7thA&_nc_oc=AdpxKQSg_bXm0bDF9v-UFGPFgxirV64LFWo9g0V4dhAcuzIOOgb8rtG4w70EZn6Kj_Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7bDBxjpjQCUzawkQSYxQqkVYL5Ed9GIIB0eF73Zcjhg&oe=6A357453"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1lj9JmIYY0Q7kNvwFLYD_W&_nc_oc=Adrqa3xTz6l0PNbmf5MyqacL5YwpUH5mSPw9vi1ulCYlB9pFxkE2WUGNOo8si32ijws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MAZokl1VZaLB0CEgfFWIu7VTJrCoNTigjXLoVtJQwIA&oe=6A35694D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MimKVR0tkgQ7kNvwEPgOMB&_nc_oc=AdoDOYjXq2-Ad2Hmn1bKsy_7GSlovxgGM25RqmE8gK1ciWglxLUkrNYSeXJPGT-XkxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97ytzL9jfqr8yLzgpPep45aIX8t1DnBFSW8XDaMQfZbQ&oe=6A3567E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
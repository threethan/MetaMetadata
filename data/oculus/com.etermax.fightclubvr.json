AdpfQNYzPSM7xWINVHnzAtzsKvjum45XrZ81HQn068Ej6kFkhWv55oj7kCRqVvei_KY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wZEA_VGegkRI3rZ8k_8mLLP-V4IW-dKxeKzRhFc1z_w&oe=6A2FF32B"}, {"file_name": "ClubFight_SS_02 (2).png", "id": "2056041242010705", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_2056041245344038_1140570332157909224_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvViEFddbrAQ7kNvwEYvPlg&_nc_oc=AdqxN4IDRzxJu21WeJeTbkEHg-76qeE7ABT7nDdzT5P54mpEknkcYSZT5Mo66W9g7ZI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91066z_ZiR4B4vpvEoTSyVemSo-PugLNHNcvceGcOllQ&oe=6A30097C"}, {"file_name": "ClubFight_SS_03 (1).png", "id": "776643005130072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499302770_776643008463405_6069648674534822235_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7h8exUhvQqQQ7kNvwFonUOo&_nc_oc=AdrEJaqnSMzjYGou3dZZkBkbqywzYqda0gUWXH3MAy51z2xm3CaqkkSy6qraCEIGyNA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-mLboAoGNSOdyZ2vvn7yDVo1MPOYCoqH4BIN8Y7iQEw&oe=6A2FFEC1"}, {"file_name": "ClubFight_SS_07 (1).png", "id": "2344355519324603", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308131_2344355522657936_321363102922850579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DC0oWMSynMQ7kNvwGWdXf0&_nc_oc=AdpTpidiyvwJfGS51otv5YCLMbdlZQmGBTHEk_XSjB-4TTDopO7aqH6NOyWetGztNys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uXIidQjP7VRdcHzmAV-IY0MEjKKvwv0i_97vro9kVHA&oe=6A2FF7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FightClub_2560x1440_acid.png", "id": "1638639523857521", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623370_1638639533857520_2782320622910168269_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHoo1lAJBf4Q7kNvwFnVgsQ&_nc_oc=AdqU-4naRbyhaYCyy0Gj6BYgC0e9OVzCqT8VSP3K3iDbec0AA7b1ODhGvNzrydMqyRc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kg1uOsN9IdAv1NBV4_AxisxwhrcmdMjGRX55-kPeXCw&oe=6A301338"}, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub", "sandbox"], "long_description": "                                                                                                                                                                                    \n                                                                                                                                                                                  \n            \n{1226775152723303}\n# \ud83d\udd34\ud83d\udd35 Squad Royale: Red vs Blue\n\nThe fight just got bigger. Step into **team-based battles** where Red faces Blue in chaotic, high-energy matchups. **Fight together**, control the floor, and push your team to the top.\n\n# \ud83d\udcb0 Earn Coins. Get Stronger. \ud83e\ude99\n\nEarn coins for **every kill**\ud83e\udd4a, boost rewards with **finishers**, and secure bonuses by placing in the **Top 3** \ud83c\udfc6. Climb the weekly leaderboard for the biggest payouts.\n\n{842520541811586}\n\n# \ud83e\uddea Unlock the Chemical Path\n\nStart with the **Acid Gun**, upgrade to the **Acid Cannon**, and reach the **Plasma Corruptor** \u26a1 \u2014 more damage, more pressure, more control.\n\n\n# \ud83e\udd4a Finish Strong\n\nFinishers give you control over the final moment \u2014 turning every win into a visible, player-driven outcome.\n\n**\ud83d\udca5 Brain Blaster** \u2014 fast, clean, final.\n{1272255454245155}\n**\ud83d\ude08 Devil\u2019s Hand** \u2014 close, controlled, personal.\n{2729715327393179}\n**\ud83e\ude78 Gut Ripper** \u2014 aggressive, high-impact, unforgettable.\nNow you can also become a **Butcher** and end the fight with the **Gut Ripper**\n\n\n# Club Fight\n\nA **multiplayer combat experience** where fights become public moments.\n\n\ud83d\udd25 Fast, physical, unpredictable fights \u2014 **now with team play**. \n\n\ud83d\udcac**https://discord.gg/aNgksnfvGN**\n", "short_description": "\ud83e\udd4a Some nights leave a mark.\n\nFight real players in a packed nightclub where the crowd is watching \ud83d\udc40 and every match ends with a brutal, player-controlled final strike \ud83d\udc4a\n\n\ud83d\udd25 Now featuring **Squad Royale team fights** \u2014 Red vs Blue. Pick a side, fight together, and take over the club.\n\n\ud83d\udeab No bots.\nJust after-hours combat \ud83c\udf19, team clashes \u2694\ufe0f, public finishes \ud83d\udca5, and nights people remember. \ud83d\udd25\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "28067447216191886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314634_1235974265088612_5394917892301593392_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM5pT7tkfYsQ7kNvwHspGaT&_nc_oc=AdpBvsQ0cO-UUpp9kAEKpgfYqhgL7x7CYYHDMGYv8vp-KCGws9r3BRgbuXcqDYs9RyY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&o
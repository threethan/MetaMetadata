600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnDVfvvO7-AQ7kNvwH8dX4S&_nc_oc=AdrrH1VLfJuSvdDN6xszBXKkl2n4cGVw0OmfezDqOP30vcRlOlyUIEN5vHCJV_0tYEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Hnv7pLBnw10zaSH5Tljwlm61qb86FC3RQ2_RimaKSBA&oe=69D8EC80"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvdZNeiZhboQ7kNvwGfvdZD&_nc_oc=AdpXieEw0sAHEGAiRBEDXcoioyHILWUSUl1AtrIt1IwavcZUTyULp9RkAH84Anwn0g8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DcuMcNxlhZ7xVD3vILPb-tjy8LPgBcgK0w7YiS9dQRw&oe=69D8E58D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AynsExtMGMoQ7kNvwG6Enle&_nc_oc=Ado0-lajeIABR9aHW26dcFO4g8AJWjDiOapYM2iOW7et-0ZHGftBLIgddrgA5qhC840&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YhRzb58-NE1m8XmzYzel1eAdyKcEsUmSErx-m8gR7GA&oe=69D8F313"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIKA3XodejAQ7kNvwFuxhNL&_nc_oc=AdqIsMo4mXpVWj6d-G8an5iC-IxQg2KmDt0C_4Spq3ZungcpjOE1AZ8zb12l-FbkpCk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af114epyWXWKCYPuCEz95XEOy1gGjz9axvHfukdJ8Rrx2Q&oe=69D8E80D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r96Z82fcMkgQ7kNvwGJNxNg&_nc_oc=Adra_4sA1jL9FRNvGjGqxdht4JUYnKdEOsMs_NmkhR1PhVnV9YHVU75WK_JlH5nyhYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_JmRaajFYFNpt7NmJj6AAdwp8yXodpllQFdXKBjyTbQ&oe=69D8E6A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541
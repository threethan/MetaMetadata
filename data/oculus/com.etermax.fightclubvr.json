dn.com/v/t64.5771-25/499620504_1338987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_j0aSTP6QkQ7kNvwE1F_RJ&_nc_oc=AdqiPbQvuaZARzIG-JuLxtxkUuywv6WdHi6yTR_D-vGVbXo5Xl0FWkxwa4jSFG8hbDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aKt8Sqak1pHe0XLK9MM6JO4-TwyWv-xud0GbcAIQRtA&oe=6A314100"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpxT1SMV-joQ7kNvwGUCuok&_nc_oc=AdoRyfbkvaBJtOykmGc8mfoJBPyqgHzy_SIxSGtpspmTkKGezLghjVJ8H2cagSu8A-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80Uv3N5nrcMlkSoxQOO8SxTWoLBm0pzhkzAKjajBfpFQ&oe=6A31724D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XHGW-9Y9akQ7kNvwFNi5gs&_nc_oc=AdrLlAepFGgiBvM5G4E9T88LHTOEoMKp8I01vUfxrR1UOl26fGC_TfhoVhJmffWf5vU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZCbd-ygrtsJIxvD92U-bYRHyMp6WgWlxYcFovLeon-w&oe=6A314793"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p34S1DNxH5oQ7kNvwEI-AjX&_nc_oc=Adoosp_LS_IQDW0LNjmRs73kmu8KeJaBDr135zyDRd8umw4WgSUWGp8UkK32usDE2QM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ivW2VxAbsP5bvS3kwWI0ix73i21eIYGEWVLGe9X3sFg&oe=6A3174CD"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHP7jGYfYhoQ7kNvwEkC5Cv&_nc_oc=AdpIQ29iraCZGzMd69NHfVYkN-0cg-cxwB5W8yhnnkPuyFYe3fqWjpEhoqINv2pRrMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xBk-99X5e1sQyAlVIjaYtxGc33c_4GGJfu4V-BLTxKA&oe=6A317361"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
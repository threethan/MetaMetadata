dn.com/v/t64.5771-25/499620504_1338987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhTiLesgtIsQ7kNvwH0cKru&_nc_oc=AdpYTskZKuFdSZa1IzXmuDmTfNFaIjKv4_7wXFoxnCGx4wrzZuafJ1kLto8pNGqsbow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uT49rh47yUXeaQvk_cEHab9Ptnc3YmUh5oosxhzKPsQ&oe=6A2AE1C0"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPeuLu7WoAMQ7kNvwFoZy6G&_nc_oc=AdoczzlkN6EDQvvx0W-iYuGoULdD0_bKGWV5R9sImQ6YaWXpQeSda1wNgvm0nGE2LNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fdvwcuOEv8EmCN2dn8yQUFEZVtqCFmiHw8CwEZBUnhg&oe=6A2ADACD"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmKtIqaIvFoQ7kNvwEPuFM1&_nc_oc=AdogxvcWkIuYtkVqIKsl4yrBYl1BMALBcVuldeHg7wczABKYyDPJDkvMlp3OxFKnfb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wMdsRS7YrRFrpdiHurEKfv3wHgpNTasM4MRBW9361bA&oe=6A2AB013"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8td2F9ipVmEQ7kNvwH1PcTt&_nc_oc=Adq1LEk9r8C-0PQAwVkiDQmE6gq9E1dwcv8ySPX8L7cmjPbTskk1-XCvfWNMdtrkWGA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JTnitdp2TlKvKwZ3ItX74p0MTqmtxe9v15ovSC9PV6w&oe=6A2ADD4D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXTldGpp6HgQ7kNvwGijh8C&_nc_oc=Adp0qBC-zJ2R7H3_mMAVaerfCUmh8CVxq9yZxWopCT8XXpitaUKgYBe4w2pL7VW478Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95sKupH-23rxlvo0fH0nf74MlHB7Errx01t-6BDZbiZg&oe=6A2ADBE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
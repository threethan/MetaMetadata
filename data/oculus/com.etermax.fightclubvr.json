dn.com/v/t64.5771-25/499620504_1338987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhTiLesgtIsQ7kNvwHhFIvy&_nc_oc=Adp3dJ7-qsfO86vQ0sFbBtFj7W2MYVMKl7lKNzx45Jmc5jiXTGvHHBb3M8vvMOfr2es&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oft8obrxvmukNC2UqrBzN66ez73dkyAyBr6WShfxMJg&oe=6A2D4C80"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in-m4Bu0dvAQ7kNvwFDV8-1&_nc_oc=AdpyvHgfwo3XkATV0nayseT59v_tE9x4vy0xD8YK6OcFYZ8WHgCgz72jHz4vld7XjUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LdoO4cugss1q0fcjTVq0t69omSPPR25Hux6b3L3vWwA&oe=6A2D7DCD"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmKtIqaIvFoQ7kNvwGZPACp&_nc_oc=AdoVI1ytDx7HdrtGSIxvCRBmMo1uRFwSjuk6R0C1ZH6DAoOaagCfEItuBM5nSOpZEUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S19dNuvjT6ngJrBcmYGDXcV52mKVO8zJBiD7oYNApMA&oe=6A2D5313"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUKQDkXkTOsQ7kNvwFUzEl0&_nc_oc=Adp-nuf6PTshEuTGaePlUSYuj1_LtGChi6b4ERZke4y6rE8cu7XrDN36ZTrcGOovzzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L_NPEfrvA9FFdBny_0pAandCrZzulvCP-7ngSGJe1Yw&oe=6A2D480D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXTldGpp6HgQ7kNvwHKWgIP&_nc_oc=AdoGCLEZ247CIXgppMlviBPrB9YQny_XSi56unQ_XCybiDpxr2aHGzWbtdN__yawhD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tYBf2sA0cnYU1rdKz_wlthY2vmEEDnzMnIuE52fQVog&oe=6A2D7EE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
&oh=00_AQBmUfhUMXnIVCw5Kj1rH14diIrKOO01vlGkngqQJ7WQNQ&oe=6A577C80"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcPt9_XOpLMQ7kNvwGrvdBD&_nc_oc=AdqPlN-cJF1nx1Hr4efdhBB-uGefYnT8cexH34qDm__QQBUDeQlbpNaws6a-JEjnx-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqH_DkaZoItejgAEj_czcUrEBJyoTeHQRYZ3Re5SEz3Q&oe=6A57758D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUlw1uTk01YQ7kNvwESZxYo&_nc_oc=Ado8uMglVhz_TEwPkZOZbhHBd7abZTsPeIMHZ-J__4rYbR4dQzEZgydQDsaSoHXVgro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1QkqibMGPRiBa3NJbblRGzP8f0cT5hMIGY5uBZcwx5w&oe=6A578313"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUq-x_bFPk4Q7kNvwGJsep6&_nc_oc=AdpKI_CDzWDbP2uWlxfr3WgjhHURE9sRRu6UZ4MWwaYSSrPFvXPnLxKh-Guy7iuIu3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAToUBJXupxClIMQ1OQxV0N6mrLaghbtb6ELslZm19mCA&oe=6A57780D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNURY_KczRYQ7kNvwHQKOoF&_nc_oc=AdrQcinslUGEyigBW7d9SGgbisCpi9r21iHlN4QRtSk9jbTIYdqH-Ii_T8traqKQYMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB908O7LwstheUJZYqc3mjSMHlvndGFC-gCI-tf9AJE8w&oe=6A5776A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
f-B&_nc_oc=AdpD-mufxkANhGLAH_RQewaKL4lAsB3plRsagJLTo_opjKvH2p3KT-MsxZeCl8v4UGQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3ArmmyNTYhbyPZRAq6-KrNsQvtV4codMlvPP42DALuHw&oe=69F1F900"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xofSh5MYhwQ7kNvwFw0mBL&_nc_oc=AdrJ1cnKHp_03RULeFD4zmmsQvBWW2vcs4JbYH3_hzeF1FWXmGB60MpnyAiG689S164&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J-sZg1rJBXhaBYR19d85hkbeREZH4t5GMC9-fCojpiw&oe=69F1F20D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KOLbdAE28UQ7kNvwEAD-7v&_nc_oc=AdqTnl0iTMxC0bem7r9_4Xm5OJvl2beXHyQjENJzC3tYzxN3BjuBQ_Hb0DGB6KuASGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3GIRlV8ZeLDoXUJjhi3lEVwjqYxwaCtA4BkbBYTBzlWQ&oe=69F1FF93"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a39TqYwbpxAQ7kNvwEjMey0&_nc_oc=AdoaZ1DsJ1RseYLCfijkm5pBdoj3_aQkCoV5ExihBxzS4sRtC_7YBGmRaWnMv4R9pWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XWc8jRhk35Uw6MoElEbpW7eYqi1XLBsFB1oFhKWwYmw&oe=69F1F48D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNQYqY4_d-UQ7kNvwGDOgDc&_nc_oc=AdrZy3LQsi2Pt6FtiuEyvVpvIPh5C0HBYeb3iuxZLpGEKvFuPBZ1_i_fkY_nfvbHZZs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Ja2LZOZAZfpgSsdddVB4b2M-tv5aPYW7QUSpALI-T0w&oe=69F1F321"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
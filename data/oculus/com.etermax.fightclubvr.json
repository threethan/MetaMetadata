cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nHG_1RTG-AQ7kNvwHDF26d&_nc_oc=AdpTbBlrryO9E4b_zQg7zVHci_tGBvDPTQS0H-6I82EunFwjDslzg0cPJejUoa4YkLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWosJNvEeSgo1cQDr8zHNixf2ClOaEwVBdEc7sFpUrOg&oe=6A95BA81"}, {"file_name": "CF_Explosive Path_SS_01.png", "id": "1061811969503984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310726_1061811972837317_2339861085013489409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyKxPhR-ZBEQ7kNvwG1t7mQ&_nc_oc=AdofmvwDg1ttoXZMaHlFxalC4Ow75qi_nLeCqm3uftsxcOuQ9CrdnHm-B7V1Ey4cjh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKbIBQjriVQxgdNE3WMvM7GTwQcM0nLmKATOupw0FwjA&oe=6A95CE48"}, {"file_name": "ClubFight_SS_02 (2).png", "id": "2056041242010705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620860_2056041245344038_1140570332157909224_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCt9dZoywWMQ7kNvwFuF6G8&_nc_oc=AdrihLfOdxEy94lRPXjqr58YkX8kiH5mNV84b1VI9QkwM8hbEpdbsg3wPofQ7iSjUC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG16FjOtyRAKMpDL7oM1ci7DPoXn9YSK1aLo6j_o80NBQ&oe=6A95C53C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FightClub_2560x1440_v3 (4).png", "id": "2735375720195901", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313107_2735375723529234_1944657012741286643_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCc8yqpCFe8Q7kNvwEFb5wh&_nc_oc=Ado5ogLoxqIveTLCB65HNrHFuLm_K9cDChCF8K_mrZrU8-wrU9hDHI56eDOURQbkkC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE__s_bP5axc2_qfYVnCWRPVohwIS7ae8tNXfisdCCRIw&oe=6A95B2D9"}, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub", "sandbox"], "long_description": "                                                                                                                                                                                     \n                                                                                                                                                                                      \n                                                                     \n# \ud83d\udcb0 Earn Coins. Get Stronger. \ud83e\ude99\n\nEvery fight moves you forward. Earn coins for **every kill \ud83e\udd4a**, boost your rewards with **finisher takedowns**, and secure bonuses by placing in the **Top 3 \ud83c\udfc6**.\n\nClimb the weekly leaderboard for the biggest payouts and turn every match into progress.\n\n# \ud83e\udd4a Finish Strong\n\nWinning isn't just about knocking someone out \u2014 it's about how you end it.\n\n**Finishers give you full control over the final moment**, turning every victory into a decisive, visible, player-driven outcome.\n\n{1023239330144977}\n\n**\ud83d\udca5 Brain Blaster**\nFast. Clean. Final.\n\n{1755506795804400}\n\n**\ud83d\ude08 Devil's Hand**\nClose-range. Personal. Unforgiving.\n\n{1656420708919051}\n\n**\ud83e\ude78 Gut Ripper**\nAggressive. Brutal. Impossible to ignore.\n\nEvery fight ends in front of others.\n**How you finish defines how you're remembered.**\n\n# Club Fight\n\nStep into a nightclub after midnight, where real players collide and every match ends with a decisive final strike \ud83d\udc4a\n\nNo combos to memorize. No scripted outcomes. Just your timing, your positioning, and your nerve.\n\n\ud83d\udd25 **Fast, physical, unpredictable fights.**\n\n\ud83d\udca5 **Explosive weapons.**\n\n\ud83d\udd34\ud83d\udd35 **Squad-based battles.**\n\n\ud83d\udcac Find players, improve faster, and stay in the loop:\n**https://discord.com/invite/etermaxrstudio**\"\n                                                                                                                                                                                          \n\n\n\n\n", "short_description": "\ud83e\udd4a Some nights leave a mark.\n\nFight real players in a packed nightclub where the crowd is watching \ud83d\udc40 and every match ends with a brutal, player-controlled final strike \ud83d\udc4a\n\n\ud83d\udd25 Now featuring Squad Royale \u2014 Red vs Blue team battles where you fight together and take over the club.\n\n\ud83d\udca3 Unlock devastating Explosive Weapons including the Sticky Grenade, Cluster Launcher, and Detonation Core to bring even more chaos to every fight.\n\nAfter-hours combat \ud83c\udf19, team clashes \u2694\ufe0f and explosive firepower \ud83d\udca5"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "28520819464187990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_964409779934482_2978040090858908413_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_isgtExL4BgQ7kNvwFWIbnH&_nc_oc=AdpZTTxe-UaMR24GiJ-cnHBnxu0z3f5x1wMF0gW0mxx1Eoie8TzFWHjjSYsokq5D7Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsVMh
600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtNdduWNCewQ7kNvwF2B7tE&_nc_oc=Adp5i9zxilcGpv_JYor7grs-FIjMiHsaExmXiNjMdqQBs7uDoH0MnWfylryMUNmuero&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01yJHtXVwXth5GuQPfdqqPlVuvgTmjomcRWsUO6kUDCw&oe=69D4F800"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zJSzTb8Kt4Q7kNvwFAax-h&_nc_oc=AdpRQWYLWxxXjis-eSb4c-W-d4HJW_wMhviaejAj2B9I0Lw0hYDNAbWLxnCE2KZ9lvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GxBO4jBDEgNTkBe0PxM85h8J70yM69wcD1pu_47iKRw&oe=69D4F10D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWdNR891PjcQ7kNvwHDux4w&_nc_oc=AdrWaJ7P-lF8umYQURKPAZaXmpbCIt5mTitv10ulwdU_oHwP8dK5qZRpZ-13Qh-xKbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kpogVPfQr3P5TKr74j9ttP044HvZNGNYMf-DHy5Jpcw&oe=69D4FE93"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFwjR0RjDgcQ7kNvwGAOiEf&_nc_oc=AdoM_jOd9AYGRPuE7UYh41yH6K1hhLjI85nUiz5mUnp3uoi-vLiifiBSZYIcZwJhIY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FEKD1XBm3tYBzIocmSHYxYvJvoQBJVYsIQ_mSlDazLw&oe=69D4F38D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKXFUbtP74oQ7kNvwGJkYjw&_nc_oc=AdqEDiykjtasbjrf2R8u5iz52AB0SnwxI44HkFOIwgpTKJ7F9D6ZArwsXMCix_wjpv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gDiK_y7b7zy04LJlH8DLNPAxo6XiwfvyvY1aUiWuPPg&oe=69D4F221"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541
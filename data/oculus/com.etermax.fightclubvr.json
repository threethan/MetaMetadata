sFightClub_1.png", "id": "1338987378267273", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620504_1338987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl3gPWSIhKwQ7kNvwHPEEwY&_nc_oc=AdrumpW9hcXhwCD_t0IjOG-9ID0trLX4SJR5ampgD7bMhBVePtQ7wmih3NQCZBDvNnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpatUTiCTYTid4UrT2INJsWZN0d8tPb_ZILj_roSsSEg&oe=69C28300"}, {"file_name": "ClubFight_SS_07 (1).png", "id": "2344355519324603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308131_2344355522657936_321363102922850579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UphWzxIe8gQ7kNvwHUH2-F&_nc_oc=AdpFQDoyjqkWXhbGnRBFB18_wVHLwoWggccKAgrNxk2VlKBkZoLyhv_NAzK2ffGhVgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-jVJK676QAsANcWQCKmnU5MLZgbeX02Vz67QopvGFpw&oe=69C28B26"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnYpxpy0qQcQ7kNvwH7OGg0&_nc_oc=AdqFw3wFKszGUTo9qlRjZCYBJmVLTAMcG3Ag5tsv6t483DdnRZE5eDEx4BTWBElkdrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuzESxofRW-ekhE8909Brtd8O5uu7XyjUgXHtzFIqVRA&oe=69C28993"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpfVhOshnyYQ7kNvwEBz4d6&_nc_oc=Adr_FBgBXvwHM3VycN1Y0LlvCGEeUxG5Xjv8NZJo_sCXYQw-P13pGAzLSAX7ZCzx79E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqPBOiflN8Pe8l4ItVFXuIuY12Oldwim2DuTirRIuRXg&oe=69C27E8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FightClub_2560x1440_v3 (1).png", "id": "2180475462701488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308699_2180475466034821_6201021035749813429_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iz7xDv7rIvwQ7kNvwH22yws&_nc_oc=AdpjIG7ASR92I68JX0kyRJH33Rka-sFR2MtbjCoYikCiyiPxICK8_Oz8_mnllznpPO8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9-kjZ-pgah6kR32ObWnm1HdBzgnLewVkr1CqxY-lyUA&oe=69C27974"}, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "                                                                                                                                                                                \n                                                                                                                                                                              \n{2373761599759299}\n\n# \ud83e\udd4a Some nights leave a mark\n\nThe lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight** is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.** \ud83d\udc4a\n\n{807698295701647}\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve.\n\n\ud83d\udd25 **Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. **The final moment is THE point.**\n\n{916483617676976}\n\n\ud83d\udeab No bots. No practice matches.  \nJust whoever shows up \u2014 and whatever happens next.\n\n\ud83c\udf19 **This is what nights are for.**\n\n\ud83d\udcac Join the community and step into the club with other fighters:  \n**https://discord.gg/aNgksnfvGN**", "short_description": "\ud83e\udd4a Some nights leave a mark.\n\nFight real players in a packed nightclub where the crowd is watching \ud83d\udc40 and every match ends with a brutal, player-controlled final strike \ud83d\udc4a\n\n\ud83d\udeab No bots. \ud83d\udeab No solos.\nJust after-hours combat \ud83c\udf19, public finishes \ud83d\udca5, and nights people remember. \ud83d\udd25"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "27067900866146531"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303672_915114838045734_6601893050238987795_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pI-BLKNiFgQ7kNvwFf-MQU&_nc_oc=Adr_WfHH6zK7K8p0dNgb7TyZ48ZbmZQpXvApX2ZMckcNkgITOt6N06uNiarastt1sk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOCtq-0r1m9Ykd01v9aqHw5zlmMvTK_tfrNzf7kMZdVQ&oe=69C276D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Club Fight", "platform": "ANDROID_6DOF", "context_category": {"context_cat
600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ49J5SGAVMQ7kNvwFYxA86&_nc_oc=AdqX0U1aDG-JUy2RkL1GFY4Bk2N784JHI55wJE1sl8T6JOODLXSo19f3YoLHLpa1ckM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfgDYNOVkJCOoKn5jV8RzvRlKM8gq6ARCcbqibfGwAGQ&oe=69CFB200"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50NHIoov1pEQ7kNvwEI52wA&_nc_oc=AdrxD1hgJJjTxm01r8fzwAYzmCSGTyVjBTzT-QiUDUDosm4SUEQktjp9ukPwEElS5gc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTzurx9HI9HEglaqyvhAAfzmBcCItTkfae6GkPD08c1Q&oe=69CFAB0D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_sHmaYnc04Q7kNvwGOJrb8&_nc_oc=AdrzDqpbXbYQ8ipdH5Z1Ua5bWqoxKxPwlz1xbCIznH2bwhuXn-cUDy2Jbr6fXnlS72c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgO4X5RIunSfZQidz5I2Jlz0KQlS1Ql4IsFezzSyMiSg&oe=69CFB893"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjehGZ9NE0EQ7kNvwEl9bsA&_nc_oc=Adq8HrFq2ZepYf_hVvVZE7-5SLLbPGzB2FHgj9sT8Ds4S6J7FPlhv5rYapXQlcYqiIc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwdg8CEEXPUAFYhm-cl7eKZGGnO55pwk1c_AfM8aFSn5w&oe=69CFAD8D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng-GX9JFGJcQ7kNvwH78At9&_nc_oc=AdoZ1reoEtQwx-SJDG8M-Z4LD3nO0fEYa7Jzrz7iH75DIqxBD8X9YGNk2vNcwUBwuM8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGAxYdDIzST1NcgAmA7kgqPrBL96DlxZz_xHo2LmBMcg&oe=69CFAC21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541
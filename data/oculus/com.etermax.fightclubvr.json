600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnDVfvvO7-AQ7kNvwH-0n-P&_nc_oc=AdpDS69lbvS8ehet3w5YJhhNoKUBCLYqh0QAlByg7GgomBtBU9i7ZkelUC_tqV0vqdo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l9qparzL_A45XWcdCCe2Or3HvNZ3ZDtJdQukFdhw6ww&oe=69D79B00"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zJSzTb8Kt4Q7kNvwHv7moE&_nc_oc=AdpT81GNbDTl5sYSHM2ZIXrqxz_iQiM8r4QDTfCgdwFUnqKX2LF7rF_1V_hK10b_pBE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UgfzP6PIIHwAowH2k8Nfsq2ftLdAAoJiwwleNRBPeBg&oe=69D7940D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AynsExtMGMoQ7kNvwGEgON_&_nc_oc=AdqE6yE3OT6srZCEzo76anB0fiIhEAEdo-XC4na5HYWf9mvNcTLwJ5NNKbuyZklE5SI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gy1yKdIILxhoKfk-GiXfi51mvQjbjy1OFHkS6Ea0hTw&oe=69D7A193"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIKA3XodejAQ7kNvwHPJrv1&_nc_oc=AdrNkabtuOjaVfBX2mv1if8I2s9F14xQbHIB00pbRUM4EUPtOjKe9nslDCAvhIrWf5s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HMEn1CvfFujP_iBjuZRRumt_3xgrvPx-HFEcD6v74lQ&oe=69D7968D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r96Z82fcMkgQ7kNvwH0p4Og&_nc_oc=AdrSvbX-rX7j9L441v_awbewTWW5QuWEXfNzmqq0mJehGd_5y2WW-SmeaF27QD07nic&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01nFAOdd2zrbTRTdAtjbGJS0B3hebMUljmsyrylMhMTg&oe=69D79521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541
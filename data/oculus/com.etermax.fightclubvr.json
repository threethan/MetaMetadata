600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtNdduWNCewQ7kNvwEWqj2Z&_nc_oc=AdqY6I-Pw3PEdG2rVcWstACx71RaM8jTYZs8f5zf-GHY544F9U9S5oq0LLpKR0LYIBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oYpRog21jHJsz5eDaamvXRTx2IdJarS-YzpAubVWhcA&oe=69D64980"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zJSzTb8Kt4Q7kNvwFOvezG&_nc_oc=AdpbXaCVlp7Ubk9xeD-QSFH7HqFWBoRDder4NQ2yXFvFUgyt4SnD8KZxXk9v4yu4aOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T9b4no8634nOjwc5qV4XM_c6ftbxq5scHMbhvvU2gbQ&oe=69D6428D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWdNR891PjcQ7kNvwHuhKhY&_nc_oc=AdqAM9861Y7cZCOtU4GElAPpTksuIyh-4YtCb94QjBDF2R8AnAK6XVNNK_Ny54v6Mws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yFfhVciRVDMMELY2UCGwxkGa_kyCR_Z_3PyMD06lyIw&oe=69D65013"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIKA3XodejAQ7kNvwHvMwHX&_nc_oc=AdqB3HTAVdeDVtJz9LEpgFniXC7TmNz8tPZNSp1hfPaiUQRifbsouqYR33yKmt73Zhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E0XbKVlSR-W4zmYT8yO7iFiGBfzyM4ZvX0-d8vXSTLw&oe=69D6450D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKXFUbtP74oQ7kNvwG8fvs0&_nc_oc=Adoeo9U_zm5HrxCJimWztkneThaV7SfjWQss9AHKRCJ8BTHlfzNoOFKhdtQ8CKCTKl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OK5WQuBSKJHF4gFUSS4XkSImR2_UYVszxss0fHgqZbw&oe=69D643A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541
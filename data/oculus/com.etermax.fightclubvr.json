769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wteD5fGZk-8Q7kNvwEeud1q&_nc_oc=AdlI38ILeyN5is9EVZl7suk6J-2X48ND9UdwWdfe455zEeZ6C3P0kwtMNeyX2NOiqoc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyzid5X_LXBHR5_6Tr8UCG4RaR3ZtvcJXxuQ9OEpNapwQ&oe=69BE878D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Mbsj3CB1uwQ7kNvwFoduXy&_nc_oc=AdlrhBEjUQdURFHPLSytLDTTxhRkandA8roP8SlTVN_60sRd_nUDDkNjI2c57965Cr4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnAB-hAZwa2WBYq6tM_4if7urT298C8CS61JuYMPAB8A&oe=69BE9513"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1w56-B8kqAQ7kNvwGE7dwx&_nc_oc=Adlms3Ny2sms3bQLBFGWiPGKZomk862-6LRWS7Ax6xPPScM8iwxA-4_EDSs9Hd2YJ9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzaS0JtyehpcuzMLMhF8XKEDXDzTFyOmPRyktpoX72Mg&oe=69BE8A0D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irC0RLeUc1IQ7kNvwGmehHf&_nc_oc=AdkZ1R5MjjuiF1WaEFlHULPp2qVk-0lN5hfMUAeNNZOq-yMNCq_9Q586TbRZxP8dt0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuxrB7Ulvvt2B438bo0iI01lyf59Sx_Gz9IvL5-bbWuQ&oe=69BE88A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USE
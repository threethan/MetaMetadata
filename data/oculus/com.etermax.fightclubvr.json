606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai6b7rFmES8Q7kNvwFaNd65&_nc_oc=AdrfQuZKAEDJG9RXEcCnZcgBIBGxgBn9fDWkVDU0_Z_12mujn-ZMEeO3XVRgHo6O3Oc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FquER2Jmu0Re2UjVnZ7YQ3iFYnM_1OLPKbSE4fsxZPQ&oe=69E76D00"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFTnnMXXLksQ7kNvwGtY4AM&_nc_oc=AdqTHhv8n3wcxPCAc89jbMqzGxL4W5HUlQoQX3ythCckxQoaY6OAOtgn3otFUBs25CU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vr_ChepYiF3FktSiKqzbmYmrRRj4ajUZVxlEJFJ4gAA&oe=69E7660D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYH0KWRqn1MQ7kNvwFm7Edj&_nc_oc=AdrMSS3MyRlL8qcbkk1ee7PgzPwEY6Ip9PeGLsUsobwu9C2Lf4moTwAzbbGazWVE8xo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27nOtR0yoMwwOCQWgCZrBClqmG-cX71SoCkNddN7RrLg&oe=69E77393"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzStIggPgjQQ7kNvwH3XFUV&_nc_oc=Adoc6GobzAgq_2gMqgvjRJ9Vi1CLe7tr1sP5F99BJoodSiUmxZeObGZ4XvaezrXtozo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29ywUL2rWn4kDNcO54WgicrQHc4yNT39FJcaGAQu8R4A&oe=69E7688D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhzEiW1hCBsQ7kNvwE7623P&_nc_oc=Adpd3Arti3yyuLV-9mu4PJKv_NNj4A4SPHYx-f4Uhss8yR4-B3Kgmk8Irmpir42M9bQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35D8RuUhh9m5vH3wLdTbxK_HsC_tQWPfy0J5fF8BJESg&oe=69E76721"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308
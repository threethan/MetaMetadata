38987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVjVyF_-SX0Q7kNvwGj1tzC&_nc_oc=AdoTpSZrTrFPqAaFE5OTqAFvl46e4yNIkF-G39qrxve8aUY0FBgwuPIEXx76a-hB_7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DdobzW4PmoY5d3EKESHcQvmQB9SR920JZutz1Jcc9Hw&oe=6A183480"}, {"file_name": "ClubFight_SS_07 (1).png", "id": "2344355519324603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308131_2344355522657936_321363102922850579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLVOOMcR8c0Q7kNvwGM3W3m&_nc_oc=AdohIjc8ECN0mnIVl7QXZ0l9v8ld9k6ql93c1oBA899gyQ6PiYnf6nT_eRVRC93A8Cc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IzH-uQ2bfizM-XfTCUEcOApBWUSmZmRoHAye-FvzJOw&oe=6A183CA6"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PDjE39Vl1UQ7kNvwG05DHP&_nc_oc=AdqqYnfCOLBP6VTw5tIsDcGQNj5HmqGTU9IKh8YEhZk1KU9Ay6wwqzcFbO7o5VJk294&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pJggsCQQ3eMiefrTY63SS_fNQPxidg1uAWkifR8MCxQ&oe=6A183B13"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKmiXvQaIM0Q7kNvwEgfYye&_nc_oc=Ado2NiZsL4-4pK1PtnGOof9LdTFiPqoU8yb_ccWjqS9Zz0DhzN1WBTt9gx6moT59Wig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55deN3Oydtb2ZuNXuQmhMhmITTg0x06vQlJuhHrGMZaQ&oe=6A18684D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FightClub_2560x1440_acid.png", "id": "1638639523857521", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_1638639533857520_2782320622910168269_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siRI7iSwhCkQ7kNvwHipcEG&_nc_oc=Adrp7EAK6MblmjM66hcieYYt5OZGhCWyqHqjfk_D3OuJQ-1E9C-zLqQ5e4F5HatLWWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I97o7L_y1Y6wM8NtN_pWJfEbXSQneo3OFVo_fOw4cKg&oe=6A185838"}, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub", "sandbox"], "long_description": "# \ud83d\udcb0 Earn Coins. Get Stronger. \ud83e\ude99\n\nEvery fight moves you forward. Earn coins for **every kil**l \ud83e\udd4a, **boost** your rewards with **finisher takedowns**, and **secure bonuses** by placing in the **Top 3**\ud83c\udfc6.\n\n**Climb the weekly leaderboard for the biggest payouts**\u2014 and turn every match into progress.\n\n# \ud83e\uddea Unlock the Chemical Path\n\nStep into a new level of power with the **Chemical weapon branch.**\n\nStart with the **Acid Gun**, upgrade to the **Acid Cannon**, and reach the **Plasma Corruptor \u26a1** \u2014 each weapon hitting harder and changing how you control the fight.\n\nMore damage. More pressure. More control.\n\n# \ud83e\udd4a Finish Strong\n\nWinning isn\u2019t just about knocking someone out \u2014 it\u2019s about how you end it.\n\n**Finishers give you full control over the final moment**, turning every victory into a decisive, visible, player-driven outcome.\n\n{1700545737974174}\n\n**\ud83d\udca5 Brain Blaster**\n\nA fast, high-impact finish. Clean, direct, and immediate \u2014 perfect for shutting fights down with zero hesitation.\n\n{1272255454245155}\n\n**\ud83d\ude08 Devil\u2019s Hand**\n\nClose-range and deliberate. Slows the moment down and puts the focus on control \u2014 a finish that feels personal.\n\n{2729715327393179}\n\n**\ud83e\ude78 Gut Ripper**\n\nAggressive and unapologetic. High-intensity, high-visibility \u2014 designed to make every win impossible to ignore.\n\n**How you finish defines how you\u2019re remembered.**\n\n{807698295701647}\n\n# Club Fight\n\nis a **multiplayer-only combat experience where physical fighting turns into a public moment**. \n\n\ud83d\udd25 **Fast, physical, unpredictable fights** Winning isn\u2019t quiet here.\nThe final moment is everything.\n\n\ud83d\udcac Find players, improve faster, and stay in the loop:\n**https://discord.gg/aNgksnfvGN**\n\n\n\n", "short_description": "\ud83e\udd4a Some nights leave a mark.\n\nFight real players in a packed nightclub where the crowd is watching \ud83d\udc40 and every match ends with a brutal, player-controlled final strike \ud83d\udc4a\n\n\ud83d\udeab No bots. \ud83d\udeab No solos.\nJust after-hours combat \ud83c\udf19, public finishes \ud83d\udca5, and nights people remember. \ud83d\udd25"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "27881658821437394"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314634_1235974265088612_5394917892301593392_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku-XsZ9LkAUQ7kNvwGuSauS&_nc_oc=AdpfYAENJkoFCm0K5tO3XBm0fTPOYTR32hOIPWazaZooCTI_Q38b_bfliYNLosNJ
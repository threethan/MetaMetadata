ntent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB17QvXunh0-NCBvwL0rwVlsB4R4mB6hIFgXezO5Ugmg&oe=6AAD56FB"}, {"file_name": "CF_SP_SS_05.png", "id": "1086791923745927", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831299_1086791927079260_6720287032874959517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euQ-lgE_u0AQ7kNvwGPneMp&_nc_oc=Adrn8q44CZYar3RWQWwqrSSfmRn3LmdQmZ25I5Uca8cK0Ez0gg3xX9DyBPepQje37Dc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxiyGf_-_9Lf54jFzZG_5kAccy-Iv_zZcunMcFN2XBZQ&oe=6AAD3CBA"}, {"file_name": "ClubFight_SS_03.png", "id": "1378074807293274", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830822_1378074810626607_8038384945192969356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaTCIZWsnTUQ7kNvwEP8ejM&_nc_oc=AdqDeArNtA8YLZ0qUzFbTRyz5HBAB_t9_FbXjmJRcPW6gXqLHsJkYbR_z6RPIqT8VMo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ095qCcRacoRodYEwiwIc2lzrTVctHaZdTl10aUFOrGQ&oe=6AAD3EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FightClub_2560x1440_v5.png", "id": "1826483931820812", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/791586454_1826483935154145_8224963458771882354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phd60IT9AjcQ7kNvwG2jbyA&_nc_oc=AdqqQQs2H5zVvH9LNNlvaw04w5aqrUPH_kV_lrMXP5oHs_oh6Rzhn1ZjbhO0wXY35kI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRZCMQjePwwem9bgVj-Zy1sVn4yJRftA2_bQE54w08PQ&oe=6AAD63FD"}, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub", "sandbox", "solo"], "long_description": "                                                                                                                                                                              \n\n# \ud83e\udd4a THE NEW CLUB FIGHT EXPERIENCE IS HERE! \ud83d\udd25\n\n{2162430521347031}\n\n**The Club has changed.**\n\nClub Fight is now a **solo combat** experience where you **face powerful bosses**, **master different weapons**, and **fight your way** through a series of increasingly difficult locations. \ud83d\udc4a\n\n\n# \ud83d\udca5 FOUR FIGHTS. FOUR BOSSES. ONE FINAL CHALLENGE.\n\n{1056188914000668}\n\n**\ud83e\udd4a TITAN \u2014 THE CLUB**\n\nStart your journey against the Titan, a **massive powerhouse** who brings **brute strength** and **heavy hits** to the dance floor. \n\n**\ud83d\udc31 CATGIRL \u2014 THE ROOFTOP**\n\nTake the fight outside and up to the Rooftop, where Catgirl awaits. **Faster**, **more unpredictable**, and **ready to test your reactions**, she\u2019ll push you to fight smarter and stay on your toes.\n\n**\ud83d\udd28 BLACKSMITH \u2014 THE FORGE** \n\nThings get serious at the Forge. Face the **imposing Blacksmith**, armed with his **massive hammer** and built for **close-range destruction.** \n\n**\ud83e\uddea CHEMIST \u2014 THE LAB \u2014 COMING SOON**\nThe final challenge is waiting in the Lab. The Chemist is preparing something dangerous, and this fight will push your skills even further. **Coming soon.**\n\n{2722082028213272}\n\n# \ud83e\udd4b TRAIN BEFORE YOU FIGHT\n\nNeed to sharpen your skills? **Step into the Dojo** and test different weapons in a risk-free environment. Practice your aim, experiment with your arsenal, and prepare for your next boss.\n\n# \ud83d\udd25 CHOOSE YOUR FIGHTER\n\n**Pick your fighter skin**, choose your weapons, and step into the Club your way. \n\nThe new Club is open. The bosses are waiting. **Are you ready to fight your way to the end? \ud83d\udc80**\n\n\ud83d\udcac Join the community and share your progress: **https://discord.com/invite/etermaxrstudio**\n\n\n", "short_description": "\ud83e\udd4a Welcome to the NEW Club Fight experience! \nStep into the club and take on brutal solo boss fights across unique locations. \n\ud83d\udca5 Choose your fighter, master your weapons, train in the Dojo, and fight your way from the Club to the Lab.\nAre you ready? \ud83d\udd25"}]}, "developer_name": "etermax XR 
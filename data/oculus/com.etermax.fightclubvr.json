dn.com/v/t64.5771-25/499620504_1338987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_j0aSTP6QkQ7kNvwHMskZc&_nc_oc=AdoymLvqlpRdDQnbRd66BJto-E93VBg3yyjvqgZcaT8gwsLlihVvO0iIRL44kRY4Pw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BDge-pnIyFuumCEJumq-ERBEKkrNSlgDjanBW2ZVulQ&oe=6A2E9E00"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in-m4Bu0dvAQ7kNvwHdsA2_&_nc_oc=Adoy90Wv01ZxPqYXzjdaT6rvXBkCaMgyq2GR3i6_0kibdJyT14TI81uHJGwXWR5rGJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88beQeSEqaOTjgeVlGgOYBpBwLPM-dfqfLfSvZSXUqHg&oe=6A2ECF4D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XHGW-9Y9akQ7kNvwFxLJbr&_nc_oc=AdoB16iUZnsOYpruZ3Byka51UKfBTaHXhbiQ79dcTz5NlkdwamSNqyQtddxQK8e2RiE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ch8oFEN57w3aoXF5jqsh7_2-EPw2fcz4OQbjL4i9DPA&oe=6A2EA493"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUKQDkXkTOsQ7kNvwGRyzVy&_nc_oc=Adrz7pt0NUFJML_ioaz1MmEpEaqTlUXAsgcngZO66YxLL9e4QagHAuWk6DsZVbIvggU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ByDe6kemPkr_mzHBeYg-065gAN3dEhY3msWxdJmVmlg&oe=6A2ED1CD"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHP7jGYfYhoQ7kNvwG1zt9G&_nc_oc=AdprdNLVsFaL85lv-S0hW3VdCYxIHQ7bYpi1aZTU91jvvbrwRZw08SYSsw6E2MXr2fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93TRonzQSqzRwmxucVZxo4wPWueDh_xrM9EJR1x7Bukw&oe=6A2ED061"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
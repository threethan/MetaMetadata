dn.com/v/t64.5771-25/499620504_1338987381600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrSzFneYCxQQ7kNvwE7mq8i&_nc_oc=Adox4EsnPkNgUdGXG3iF2BSp-GArIMq8oDLl1_rqiPOyIzoH_6lupRFzEIYH_WAQtxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FgGdKxkTFXl9S4-jptgOE4usTWoEJGD3OEEUWvqDbJA&oe=6A295800"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPeuLu7WoAMQ7kNvwGh7DOo&_nc_oc=AdpCc6ljXCrGxR_-HJiBZTTVqwGQ99VYosvWuLOId8QeN8qD0PrKPi_48rwGu0auHH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y2swT-VD_BYIPDGpKtB4jv5B7ZELPCieHx0ppskR8mg&oe=6A29894D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKk7le3xgMsQ7kNvwEaLInj&_nc_oc=AdrEmrmf13KqkD9A0jtz-UO1ZUoKiHDpkfKsjcJQ3tAArcv0lbM0lVho1oD3OwhMrG8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MlyKy6b9NbANObJZrq0K7m9pU0_TdjxKaqeTu2CsHCg&oe=6A295E93"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8td2F9ipVmEQ7kNvwGZNhA1&_nc_oc=AdrF4VHMAqVLolWk9IWPHuzciW6CNvmvY61rks33DZYJpElHfS-MScIWyfMVFRP93Mc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mWn2ZJ2i4Ox5LNgoEUXVwrPTFlamDioHp2a3IKltbSA&oe=6A29538D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilMkeS3RiewQ7kNvwHzFMq6&_nc_oc=Adq3qCryDSGATzwbIq1LK3bSFsJxJVmIC90Zh4vZ4rz5eijoKP3gdxgQWLjSosIk2xI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v9InmlO1ipmSu5WGwbZ22zTw_-gLxtsiqiU7UgWaoPg&oe=6A298A61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
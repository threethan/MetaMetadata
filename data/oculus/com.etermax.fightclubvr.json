600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoR-uaSuKJAQ7kNvwE6PbKV&_nc_oc=AdrLOaDhHCo2GK5s9RhfXubtZJmGKT8L0awrzPD4hGmE9imC9tEy_r63OO3lC9FaXS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ewjzANtO0Wr-hL6uIdsIAfxWJdefOdfS6GOBTiZDlXA&oe=69DB8F80"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvdZNeiZhboQ7kNvwFEpGVF&_nc_oc=Adpy7ixMUZ-hhIaSQUSuXixJZcjkSqvBS_5gjcgmg0ymWh5K1x7HinpyRJzf3cyDWL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qoqc2QvYekI28BXrOY_H8sSJo9sFE9_KRUoojMyMBvg&oe=69DB888D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlNAtC4FbfgQ7kNvwHQdlyQ&_nc_oc=AdpHM33N0Y5GO0lRcn6N6VMH9EXuGRvpsOjBhitOf4W6hQbp0hEl4FrGHeDU04Go1d0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tEbeoYTxMmw25vclnInjX5o1qOFOxXgQiHvWdDo1s-g&oe=69DB9613"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qkh5rmzpfMUQ7kNvwGaC6wO&_nc_oc=AdqS_y_H3FwFQJM9uPNRpBsSJqWr06oT3PCH3naHM9v-ZMWJwU50DhEQ7Gyz3nmmhxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07vun5v43ZPDkvxWar7ep8nDoYVeM_MSFgwb3KSzPtrQ&oe=69DB8B0D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQyq8hZcFSkQ7kNvwFzFyCC&_nc_oc=AdrHKKl23mIUkRJF8-Ozm_mTL19VB0xxXyluoXQjmngOItKTxgYPX6Fl5i1BsZYw1po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ntkPRj5SWVndD8Stnzjj_jKDuZ39V9AysvwJGhUS_Eg&oe=69DB89A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541
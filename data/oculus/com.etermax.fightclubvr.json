600606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ6gf7pLw-kQ7kNvwEW6OgH&_nc_oc=AdoSs1AHkq0P7AyvgDZV0ncmC7l3lrvPB92Q0y-63_4Vn35MkURxzpvjzixdXRJRDzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEB71MoGfKfiphgQKdF3a2CNbE7xhIUVoQlq9a6tihaQ&oe=69CE6080"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50NHIoov1pEQ7kNvwGGjJcW&_nc_oc=Adp0txvjLChNJALhzMlKGNTeZMAYX87KlLa4F8gwCvd7K0xiL-na6Fk_EOLPMG9G9KA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnvIclnG4Vj6ZJcYqVraZT0p_m2qgjbolOH9VZwF_E6g&oe=69CE598D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIFM7MnogVwQ7kNvwH0N6cL&_nc_oc=AdqF0SVr-LtvjvpWgBYGMh0wLB2L6BGWC3w8VBTFV1xMS0alQ6Jx-bSfLGSuApWtR6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtitqXc58-LBuXPV7ofMvJ8GmRnewSJcaJI70J0Mj0dg&oe=69CE6713"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjehGZ9NE0EQ7kNvwEUyooU&_nc_oc=AdrJa0SrNEh7fF-Lj28SQUtuePyVxeKikUnTn5JlS7pTgef-OS8kZmXxQS21H-ihRHs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcrK_5alLR_dpjw7P53gVu0ambuPT1-6yFCPHF2NC3kA&oe=69CE5C0D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1ybgmaeW7YQ7kNvwFwNImk&_nc_oc=AdpHwk5mB0mYOZTgruoDf0nYSDIToGXJeBCFKyd7ptZpRisHANUfonzWnrUIkMmPn-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_U_bF03dK5DyfEw4wWY90Ao9eNZ-GWgduZVoQe3BN1w&oe=69CE5AA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541
png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB9RVTxrlB4Q7kNvwFVYXCl&_nc_oc=AdlOGsdHQAyX_9vySlzFTsWl5d4kmz6toSRolNpJd7w43J9P3GDXxUy5FyB7ykcYAgs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTsUqbeNcpOGkvzKqZLUJnTlpze-ndGBTn5PJnvsRsyw&oe=69BD3D00"}, {"file_name": "ClubFight_SS_07 (1).png", "id": "2344355519324603", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308131_2344355522657936_321363102922850579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEHM7zKBAfwQ7kNvwG67wPd&_nc_oc=AdkRYMZw-_rZ1kB0HlVVcN_2V_fznL-x92HHyw_9mriCFDMh9sE7l7BreFe6HSCs-xM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoyDVKWY3wlpKKyaPUHjNMRa13PT1qpjmisjIoFjnkFQ&oe=69BD4526"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Mbsj3CB1uwQ7kNvwGaCyzx&_nc_oc=Adkg7KJCHgw3wsxfbUXn0l6RLjuI4Rsg-7IW3v6PikTtyzjFAoJpTC3eziYwVrzIOmM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp9qbqPowQaCknllG_svoW52IXy2CBx-fXxg_aPL_WCg&oe=69BD4393"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTmEiZbw-1gQ7kNvwHDK9Ji&_nc_oc=AdnNzVoy5CQIAwZW4Lp65et67nm5wpBS-AqJh-dypoi1x9Pzy-VUTQx1tiWXRWYA_bw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afya2arIxT7foP7weUeZfK_6K0x0bjc4OX0TeL71udd3Cg&oe=69BD388D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FightClub_2560x1440_v3 (1).png", "id": "2180475462701488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308699_2180475466034821_6201021035749813429_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wU77R8EGG5oQ7kNvwGeET27&_nc_oc=AdkCyNElths8ddeoZHJ7WCwKlQE_hAdx0TWyp-KxroVGPEHwcdmStTHAGruu8upGous&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySR-N1baNRyNiSba1pDJpV4Swd2ZFcflEljCE6u7qK7A&oe=69BD3374"}, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "                                                                                                                                                                                \n                                                                                                                                                                              \n{2373761599759299}\n\n# \ud83e\udd4a Some nights leave a mark\n\nThe lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight** is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.** \ud83d\udc4a\n\n{807698295701647}\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve.\n\n\ud83d\udd25 **Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. **The final moment is THE point.**\n\n{916483617676976}\n\n\ud83d\udeab No bots. No practice matches.  \nJust whoever shows up \u2014 and whatever happens next.\n\n\ud83c\udf19 **This is what nights are for.**\n\n\ud83d\udcac Join the community and step into the club with other fighters:  \n**https://discord.gg/aNgksnfvGN**", "short_description": "\ud83e\udd4a Some nights leave a mark.\n\nFight real players in a packed nightclub where the crowd is watching \ud83d\udc40 and every match ends with a brutal, player-controlled final strike \ud83d\udc4a\n\n\ud83d\udeab No bots. \ud83d\udeab No solos.\nJust after-hours combat \ud83c\udf19, public finishes \ud83d\udca5, and nights people remember. \ud83d\udd25"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "27067900866146531"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303672_915114838045734_6601893050238987795_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clvu2RHA9EYQ7kNvwHFjOXV&_nc_oc=AdnmMHiFww1GIFy7qzK5ebZamV_nOBvyIT9dhL2UDUCYP2q20U7Bpkvfzty6Q1QAfxw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzN-c1N0GeMqrILuU56vaTeNPqj9bd5Q2bv9dV0lc8eOg&oe=69BD30D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Club Fight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "
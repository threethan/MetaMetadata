3hplfZtJi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B72bRJ5PFq3RtxMmEUkQ7skDACS7grsGuazyGB0XshA&oe=6A43BC93"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OLNRwCn4wcQ7kNvwGRash2&_nc_oc=AdpZiuPn-r2MBAeFZkarfd22rO50JtX_r4VB863us1NH9OeBWwnIZ1-zAlwjE8OP_tU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ISB6QuNH6AW0VpukgoEKo67g1GoQjUwGssNepFYs9HA&oe=6A43E9CD"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ptk9oLNDLZUQ7kNvwEP8Wa8&_nc_oc=AdqwKALiV_qFtRwfeZwbI7Nfqvt3CMvEN3R5mCaxSgp2z-3HoUDQql_jMj-leygmWcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JMnYTmikbzHpDCnC9zrCbEPOf2QNJY5OxBayqm1Tk2Q&oe=6A43E861"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "25993348476935114"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1962759090992489"}]}, "baseline_offer": {"id": "1962759090992489"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773318240, "status": "PUBLISHED", "id": "1962759090992489"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28317725431164062", "version": "0.12.0"}, "id": "1362779491924852", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prim
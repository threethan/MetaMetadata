tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308131_2344355522657936_321363102922850579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hvBQDePrDUQ7kNvwGnU1q1&_nc_oc=AdpAEvGU-4bCXGQWylQfB7Mxg1PhO2xYAd2j4GitIgn7PKGihPiyujO0n0OQxX1iiAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uwADJbKCjZlQ6JZ0XLrCG-Ur_2S9MVb5RAfbbHDMpJw&oe=69E4D226"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aAF0MRtxIkQ7kNvwE4sVEP&_nc_oc=AdrYTZFv_IsGmc0qCs_D4n8Occ8WWd4NdjXHUXylbPuOCUST2NtfuxIQ4Llj9GokBb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A1FKwtTjQWMvbwfWlJBzBSXDfOjEz3BQ8YPJwDGqOzQ&oe=69E4D093"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzDkUlCGcLQQ7kNvwFosZwl&_nc_oc=AdoO4F7b7UetF0ANF_8WJnOMdC6FYnvIS7zj_jO9_AQx7Q4nl-avoGtKpkbkpqqGH7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XO1oJ884a-FITOJ7UzEFY139aJToBk1kBo2uSEwxBMA&oe=69E4C58D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FightClub_2560x1440_v3 (1).png", "id": "2180475462701488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308699_2180475466034821_6201021035749813429_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV32_dKKpRcQ7kNvwEIBN9T&_nc_oc=AdpAUYnn86Fmu0whhvHmoHR3X55eyysIOSzEwdEC34l76vmHyY70EMOTGhmNFv2SJm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dXknl6ygGEmmZGfmne8yZsBzzbF8Vp3dDQLC_vC1-_w&oe=69E4C074"}, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "                                                                                                                                                                                      \n                                                                                                                                                                               \n \n# Finishers are here \ud83e\udd4a\ud83d\udd25 \nEnd every fight with a final move.\n\n{1700545737974174}\n\n**\ud83d\udca5 Brain Blaster** \n\nClean. Fast. Final.\n\n{1272255454245155}\n\n**\ud83d\ude08 Devil\u2019s Hand**\n\nUp close. Personal. Unforgiving.\n\n{2729715327393179}\n\n**\ud83e\ude78 Gut Ripper**\n\nRaw. Aggressive. Unstoppable.\n\n**Every win now leaves a mark.**\n\n{3062325903975848}\n\n# Step into fights with the people you choose \ud83e\udd4a\n**Private Rooms** are now live \u2014 making it easier to run rematches, train, or face off with friends \ud83d\udd12\n\nAlso, **moderation features**  let you **mute** or **report disruptive players** \ud83d\udee1\ufe0f, all backed by a **Code of Conduct** that keeps the experience competitive without crossing the line.                                                                                                                                                                      \n\n{2373761599759299}\n\n# \ud83e\udd4a Some nights leave a mark\n\n**Club Fight** is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.** \ud83d\udc4a\n\n{807698295701647}\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve.\n\n\ud83d\udd25 **Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. **The final moment is THE point.**\n\n{916483617676976}\n\n\n\ud83d\udcac Join the community and step into the club with other fighters:  \n**https://discord.gg/aNgksnfvGN**\n", "short_description": "\ud83e\udd4a Some nights leave a mark.\n\nFight real players in a packed nightclub where the crowd is watching \ud83d\udc40 and every match ends with a brutal, player-controlled final strike \ud83d\udc4a\n\n\ud83d\udeab No bots. \ud83d\udeab No solos.\nJust after-hours combat \ud83c\udf19, public finishes \ud83d\udca5, and nights people remember. \ud83d\udd25"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27227449306858352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303672_915114838045734_6601893050238987795_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08YKoa9vOY0Q7kNvwGSq0f1&_nc_oc=AdpaoKO2bwQkFaQ085lag8AGW-EFyYSFhK7d2Rxg0nPRrRyKd3usOefMgl2oBz87e_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZrU8QyyZTYpoYqS2I7b-xU1s5hWCw3vavi
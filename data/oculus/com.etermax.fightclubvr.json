606_5415291928374593976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIArnDekiSIQ7kNvwFsdcrM&_nc_oc=Adpx5A_Txk_63Duc_LxQQDt_hzTn5G6K-cFCvOVn4Om_Pb9PXMrC25ZieoMCevwq3E4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rfCg7kFlZKv_nrjmw866i584W6rV8V4PgwfPR949xUw&oe=69E0D580"}, {"file_name": "screensFightClub_2.png", "id": "1675940030435869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619098_1675940033769202_8114572645260538718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgUY_jGel9AQ7kNvwG4KpKN&_nc_oc=Adp6iQY9oK7m44kYRh0wT6G7xNq1ota-OkUgBz-QvN1jpuBm4_4R5fBGfTZR8U-LXmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af203QF7NcwGVSYRprp9tCweqdfRsGJb575E0O6h7ELGIw&oe=69E0CE8D"}, {"file_name": "screensFightClub_3.png", "id": "1579138430029937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618472_1579138436696603_3262320420274094015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4blotfVI3QQ7kNvwEaQrgw&_nc_oc=AdrGwru_efeELwiqqZEHy3cHrzNeZFI-4nPcnB4qSZ_jRKWga3frnzklhmvxNi59Jbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UgOTnBIq6s2vzNJNF0-EYWaEyH0bMPB2UIrEF_6jlqw&oe=69E0DC13"}, {"file_name": "screensFightClub_4.png", "id": "1976303226284381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_1976303229617714_414310914909442648_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRs1hnq2cGMQ7kNvwFGPHvA&_nc_oc=AdraE1tJmE4vG6aZk_qAyOHKlvTZ2lbchUnhgJ1M7TTPw0OIs9fGHEe2dOsTjpS_DmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Edvvpnux3dMI--tnKdMHZL27hI6YU5Tc9KeZ65kYGFA&oe=69E0D10D"}, {"file_name": "screensFightClub_5.png", "id": "2776591086022879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619145_2776591089356212_4643171090317340902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DRMYbTesjoQ7kNvwGJJNJl&_nc_oc=AdqVeokkWrrai42O46x5j97UMdBWeFLLGoE9E83HrUWb7Wki2NW79luSHsXsb4p2rn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_KDspy2p0I3wyGSZEANADHmWsgfV9ezepSSP8vq7i8Q&oe=69E0CFA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Fight", "keywords": ["fight", "fighting", "nightclub"], "long_description": "The lights are low. The music is loud. The crowd is too close.  \n**And when the fight starts, everyone sees how it ends.**\n\n**Club Fight**  is a **multiplayer-only combat experience** where physical fighting turns into a public moment. You\u2019re not playing through rounds \u2014 you\u2019re stepping into a nightclub after midnight, where real players collide and every match finishes with a decisive, player-controlled **final strike.**\n\nThere are no combos to memorize and no scripted outcomes. What happens comes from how you move \u2014 your timing, your positioning, your nerve. \n\n**Fights are fast, physical, and unpredictable**, ending in front of a crowd that reacts, remembers, and judges.\n\nWinning isn\u2019t quiet here. The final moment is the point.\n\nNo bots. No practice matches. Just whoever shows up \u2014 and whatever happens next. This is what nights are for.  \n\nComing soon to Meta Quest\n", "short_description": "Some nights leave a mark.\nFight real players in a packed nightclub where the crowd is watching and every match ends with a brutal, player-controlled final strike. \nNo bots. No solos. \nJust after-hours combat, public finishes, and nights people remember. "}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308
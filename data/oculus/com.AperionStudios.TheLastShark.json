985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya6_zeWxBLsQ7kNvwEq6Jmi&_nc_oc=AdpHX8VWJseKjKy3akQypF1CSq1RTwNM5vpQRWZr8E2N4yTl3KoNKZbbm0NlDDd3tHI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqoUOPZutQatlpBfWSYhIsmKb0HPv2PFR2-OGzs1x22w&oe=69D0F93D"}, {"file_name": "Screenshot 4.png", "id": "468561867492043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203615_468561870825376_6124789836982841141_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTWo5MN87DsQ7kNvwGmn7rp&_nc_oc=AdrQvptcR5_xBtxGwb1cWFuiR3TfinfJEMVIUHiI8JWNs_9wGCyqguSqy1wG_NudfRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIAn8DhAm1p3JDfTedM9JpRLf0qn4N3llLN2G-6IPzzA&oe=69D0FFE5"}, {"file_name": "Screenshot 5.png", "id": "753800175574109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031471_753800178907442_3961110468239992768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcgzX8x2R2gQ7kNvwEXKZSW&_nc_oc=Adr8PKMorX3PNZPknmspUosFeV0nlMkpTOHU6JZ3ZcqCsgv3RsOObBvuc4rHvEx2SXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKXBzGN4fmCisLqVROdFtbIDRchIhuhak8a2gsa6HS6A&oe=69D111FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "192504729288700", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974547_192504732622033_8303222572694861350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmpY6Z8INpcQ7kNvwFrQpYK&_nc_oc=AdpGTsrEir070gAgiWanVe18OJWX_14WsktJkW_cEzKaADTrvBPMu_O2BsG8YIJIbGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx5deYur1YJ6WN415GiYpvGL8AyIZIjaiC4kk7dsXquQ&oe=69D11DCD"}, "display_name": "The Last Shark", "keywords": [], "long_description": "For years the shark population has dwindled due to improper fishing practices and illegal trade. Now a gang of shark-fin traders has attacked and captured the last two remaining sharks on Earth, a mother shark, and her child. What lengths will you go to protect and rescue these majestic creatures?\n\nThe Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?\n", "short_description": "The Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tejasshroff.com/privacy-policy-aperion-studios/", "developer_terms_of_service_url": "https://www.tejasshroff.com/terms-of-service-aperion-studios/", "publisher_name": "Aperion Studios", "support_website_url": null, "website_url": "https://www.tejasshroff.com/the-last-shark-aperion-studios/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7991354247622825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974781_164307445259624_3713507482895648790_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdCcrEOTSyEQ7kNv
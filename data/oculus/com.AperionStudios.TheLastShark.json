?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://aperionstudios.com/privacy-policy/", "developer_terms_of_service_url": "http://aperionstudios.com/tos/", "publisher_name": "Aperion Studios", "support_website_url": null, "website_url": "http://aperionstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "280957380798329"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "467665884377723"}]}, "baseline_offer": {"id": "467665884377723"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617408060, "status": "PUBLISHED", "id": "467665884377723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3766505790107713", "version": "0.26"}, "id": "415774862839999", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3661952167229743", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3766505790107713"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "415774862839999"}]}, "change_log": null, "created_date": 1615671643, "id"
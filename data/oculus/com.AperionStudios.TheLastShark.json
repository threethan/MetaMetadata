a0a&_nc_ohc=1HKQfMbFJu0Q7kNvwHrPE0n&_nc_oc=Adr3Lo33q83NyOK50GD8Kn_y3Ws3BLq4PMDHzA1i_m5aGjSqmsAp7zmAihDXOxghcSA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3yp406Hq_XgZ8xdeUSAVnEmfJD-qoQk5pqNlbqSwT_A&oe=6A8D8665"}, {"file_name": "Screenshot 5.png", "id": "753800175574109", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031471_753800178907442_3961110468239992768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml2awKDHyzMQ7kNvwFG1SGk&_nc_oc=AdqV3FzJJjboNgeilvOPxTAzcbzsu9dUSBKZGmge9xdCIDyGWgqQ3KRpg21jbLGLMqc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxK73Ik65j7GOT0rX1MK9ZTcUn2NjG4ZiLS5XnR-razw&oe=6A8D987E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "192504729288700", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974547_192504732622033_8303222572694861350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7pA9pY6fCsQ7kNvwEkA8uu&_nc_oc=AdpIHSuJx1uKJ0kM5UqVjTdp3z1-07kZ3AsYJ9P9vZ5tDdlovBnSB_HTvgnNFdcmle0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkrtDhGcdby_UFeBulrtvx6lFL3qMcAYyCIV4BiabHLA&oe=6A8D6C0D"}, "display_name": "The Last Shark", "keywords": [], "long_description": "For years the shark population has dwindled due to improper fishing practices and illegal trade. Now a gang of shark-fin traders has attacked and captured the last two remaining sharks on Earth, a mother shark, and her child. What lengths will you go to protect and rescue these majestic creatures?\n\nThe Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?\n", "short_description": "The Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothi
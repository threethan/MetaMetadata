eatures?\n\nThe Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?\n", "short_description": "The Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tejasshroff.com/privacy-policy-aperion-studios/", "developer_terms_of_service_url": "https://www.tejasshroff.com/terms-of-service-aperion-studios/", "publisher_name": "Aperion Studios", "support_website_url": null, "website_url": "https://www.tejasshroff.com/the-last-shark-aperion-studios/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7991354247622825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974781_164307445259624_3713507482895648790_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqZEykAWeTQQ7kNv
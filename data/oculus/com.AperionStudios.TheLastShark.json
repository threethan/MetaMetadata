985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ5iKEVXvZEQ7kNvwGqKqie&_nc_oc=Adouk_WCThjUk_WxnZBcdBDDQOL3C6pzzYZ3FfPV8U7zw4aPrlL0wLoETK5TqjhONmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FU4lx_byNzjsOc3HnI74u_AfQb3wGrOYau3YWxOSMBg&oe=6A05ED7D"}, {"file_name": "Screenshot 4.png", "id": "468561867492043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203615_468561870825376_6124789836982841141_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Mc0wCkq7YEQ7kNvwHZ45LA&_nc_oc=AdrfjOAsyQ_pIBPmdGJW6FsccqAA_uA5Gnj4Xr6HQWv4Z8BGT46ax1D-L-E8wQtOHyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67GFvyKB9Hm7ocGBXzMwbjb16Ae1-ShjrNbcJu_4Kg_w&oe=6A05BBE5"}, {"file_name": "Screenshot 5.png", "id": "753800175574109", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031471_753800178907442_3961110468239992768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhZokCn93U0Q7kNvwFM9iqA&_nc_oc=Adp3rrLvgctLhZHztIY8590To0O-lWQO4XvqKtTWw4D8LgnWUrl903j31-Gzd_upbqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mz8UHwQkjWwypp0hGT8U3wCIYDF-lxM82vlUAU9_4gA&oe=6A05CDFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "192504729288700", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974547_192504732622033_8303222572694861350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg5R2dgEqfQQ7kNvwETDEKI&_nc_oc=Ado6rA67E4kelT8dA6_EwBjhnEYUP5wjunKAdZzWoIgp4jKJXPxvXkXT_aA12uKsYRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WZcT5sQHmI1uuysTTyUR8ziVCyrsHwGCrtckPItJ7Lw&oe=6A05D9CD"}, "display_name": "The Last Shark", "keywords": [], "long_description": "For years the shark population has dwindled due to improper fishing practices and illegal trade. Now a gang of shark-fin traders has attacked and captured the last two remaining sharks on Earth, a mother shark, and her child. What lengths will you go to protect and rescue these majestic creatures?\n\nThe Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?\n", "short_description": "The Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tejasshroff.com/privacy-policy-aperion-studios/", "developer_terms_of_service_url": "https://www.tejasshroff.com/terms-of-service-aperion-studios/", "publisher_name": "Aperion Studios", "support_website_url": null, "website_url": "https://www.tejasshroff.com/the-last-shark-aperion-studios/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7991354247622825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974781_164307445259624_3713507482895648790_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBW6iE8m8psQ7kNv
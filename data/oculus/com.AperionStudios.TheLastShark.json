-Gn6vu5gPYKcDynZHdFxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWR88c7kM9vFSEVK3becBkG1PVZvouIieCXtVzWOQfLg&oe=6A95B9BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "192504729288700", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974547_192504732622033_8303222572694861350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjrl4-ytZP0Q7kNvwGjo-nw&_nc_oc=AdqQZcSMcJ1VXTiXJ0ULoNIPrJglvoBzBmAgM23jGCnCJXL2spDqL6i4hwR9V6d06Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJzA_ZZspQWVG3DYlTcObtToe0po213C1RJMS1z7KlDw&oe=6A95C58D"}, "display_name": "The Last Shark (Demo)", "keywords": [], "long_description": "For years the shark population has dwindled due to improper fishing practices and illegal trade. Now a gang of shark-fin traders has attacked and captured the last two remaining sharks on Earth, a mother shark, and her child. What lengths will you go to protect and rescue these majestic creatures?\n\nThe Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?\n", "short_description": "The Last Shark is a stealth action-adventure VR game where you must protect and rescue the last living sharks on Earth. Armed with nothing but your two bare hands, you infiltrate illegal fishing operations and retrieve information on where these sharks are held. Will you find them before it's too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://aperionstudios.com/privacy-policy/", "developer_terms_of_service_url": "http://aperionstudios.com/tos/", "publisher_name": "Aperion Studios", "support_website_url": null, "website_url": "http://aperionstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": []
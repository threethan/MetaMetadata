XQ&oe=69E24D49"}, {"file_name": "MainGame 1_2026-02-20_01-50-12.png", "id": "1442727487224670", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499622276_1442727490558003_3253759537065510051_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XZqfJDCERcQ7kNvwFc-6Rm&_nc_oc=AdqCDgzb5dNmN0BGKODuyXAtXNqUyn40KWa-NkRremWomuYRq9U3w3AVQI9yQVKt778&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pMcvqOJN3AWWtmF5NIuHrDR6dVBGvlFpCaXkrk6EsWQ&oe=69E2316E"}, {"file_name": "MainGame 1_2026-02-20_01-49-17.png", "id": "2750446598655085", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619465_2750446605321751_9020235368350718638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8dJL5TsQxMQ7kNvwFRFR3-&_nc_oc=Adp0noNG4c9PPdLcOEFnX6xY8SLW1UcYNsjUoe_JfwYq5m3R2I634hNichwmZGEKHoY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EpaabVa3mAlZKkV-RBzbW02ZUKPU7rpAW-XAnrka-Jg&oe=69E2386F"}, {"file_name": "MainGame 1_2026-02-20_01-49-50.png", "id": "806889065781823", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619680_806889069115156_3612575533288755157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViMsJRl0EHsQ7kNvwFdCo9Z&_nc_oc=Ado_9VYtZmzC7ZEtAJkUcmxwRMcX-Z48Jn2W4IthwqihRSZ2M4XS02Sz9kEKIiYWMSw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pvarlYpooYX9ynORH7Y_93LNa7lmvIhBVfTBnMAF7Nw&oe=69E249C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainGame 1_2026-02-20_01-50-12.png", "id": "911962895061369", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619751_911962898394702_2280370344947495902_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaAWhvKTKxAQ7kNvwHtW1nz&_nc_oc=AdopOCZO224jBVShq2Zl5YaCnUr0XVsfZbNosqdV6HZGy3wdI5nAf1j56de0fo_5CqM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3asHuq5u-Jcrr1eOJrZ4TWB0sZBmcQrbV_pYIWeqqCqw&oe=69E228B4"}, "display_name": "I Am Gorilla", "keywords": ["hangout", "social"], "long_description": "Welcome to I Am Gorilla \u2014 the next big Gorilla Tag-inspired fan game!\n\nJoin a thriving community of players in an ever-evolving world where updates drop weekly \u2014 sometimes even daily! Whether you're here to tag, explore, or create, I Am Gorilla has something for everyone.\n\n\ud83c\udfad Customize Your Gorilla\nChoose from 80+ unique cosmetics (and growing!) \u2014 from seasonal styles to wild, creative fits. Express yourself your way!\n\n\ud83d\udee0\ufe0f Creator & Sandbox Tools\nBuild, explore, and experiment in Sandbox Mode and try out our Creator Tools \u2014 perfect for custom maps, fun experiments, or horror-level builds.\n\n\ud83d\udea8 Report Cheaters In-Game\nKeep the game fair and fun with built-in reporting tools to stop cheaters in their tracks.\n\n\ud83d\udcac Active Community & Socials\nWe're always listening. Join our active community, follow us on socials, and become part of something big.", "short_description": "Welcome to I Am Gorilla, the next big gorilla tag inspired fan game, we have a good community and are active on our socials, we update the game every week, sometimes every day"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/dwA0AjLa", "developer_terms_of_service_url": null, "publisher_name": "SunVrr", "support_website_url": null, "website_url": "https://pastebin.com/dwA0AjLa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "sup
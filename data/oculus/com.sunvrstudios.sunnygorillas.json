nw&oe=69FA0849"}, {"file_name": "MainGame 1_2026-02-20_01-50-12.png", "id": "1442727487224670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622276_1442727490558003_3253759537065510051_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YojMVgir60IQ7kNvwEmUMal&_nc_oc=AdrwVi_ZRuH5wNKYkJW5itC7dlFdl3qTH8ES9MoMqeLYiMSvd-JK1FIhMjoQEkRD-wY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DqwPOUnI78TH0qVeksQLcm1zh79QhRlMM9CmzgNGS4Q&oe=69F9EC6E"}, {"file_name": "MainGame 1_2026-02-20_01-49-17.png", "id": "2750446598655085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619465_2750446605321751_9020235368350718638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18xoL8GDjN8Q7kNvwGQYSdh&_nc_oc=Adrx3BHCaYLt8CE7zaDmRZqb7ahzj5MEmbOl-4Chx3VC9iJByqxi-AZVPQBqvCs-5gI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nzFTJ-tATlHnBsETjFxuwaLChwDg0D3Deck-waCsa2Q&oe=69F9F36F"}, {"file_name": "MainGame 1_2026-02-20_01-49-50.png", "id": "806889065781823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_806889069115156_3612575533288755157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9Z37BdIVcAQ7kNvwF3gEnw&_nc_oc=AdqwICTGkB2JG0dBkCUPyCAwYo7gmXondbrJz6SSzDBB-K0uVXEJ3Tx44udKUoBy2h8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63IzdaYGNRR5SeMRlwhyy8O0cUwyKMWBXcR-WnDBcXIg&oe=69FA04C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainGame 1_2026-02-20_01-50-12.png", "id": "911962895061369", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_911962898394702_2280370344947495902_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvfQZTWE1OYQ7kNvwHGwV7-&_nc_oc=Adr3JQdPkMqNRdpGaTDOfI6GpGzOFiF0n22v7xBMdAea7JMkSYyRCL6hTopzw0zUVjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7grd67p4TD3-t91Itx1qIqpCmpHoJvpIbQKgeyzkdX7w&oe=69F9E3B4"}, "display_name": "I Am Gorilla", "keywords": ["hangout", "social"], "long_description": "Welcome to I Am Gorilla \u2014 the next big Gorilla Tag-inspired fan game!\n\nJoin a thriving community of players in an ever-evolving world where updates drop weekly \u2014 sometimes even daily! Whether you're here to tag, explore, or create, I Am Gorilla has something for everyone.\n\n\ud83c\udfad Customize Your Gorilla\nChoose from 80+ unique cosmetics (and growing!) \u2014 from seasonal styles to wild, creative fits. Express yourself your way!\n\n\ud83d\udee0\ufe0f Creator & Sandbox Tools\nBuild, explore, and experiment in Sandbox Mode and try out our Creator Tools \u2014 perfect for custom maps, fun experiments, or horror-level builds.\n\n\ud83d\udea8 Report Cheaters In-Game\nKeep the game fair and fun with built-in reporting tools to stop cheaters in their tracks.\n\n\ud83d\udcac Active Community & Socials\nWe're always listening. Join our active community, follow us on socials, and become part of something big.", "short_description": "Welcome to I Am Gorilla, the next big gorilla tag inspired fan game, we have a good community and are active on our socials, we update the game every week, sometimes every day"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/dwA0AjLa", "developer_terms_of_service_url": null, "publisher_name": "SunVrr", "support_website_url": null, "website_url": "https://pastebin.com/dwA0AjLa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "sup
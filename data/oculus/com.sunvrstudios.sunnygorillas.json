8w&oe=6A26DB49"}, {"file_name": "MainGame 1_2026-02-20_01-50-12.png", "id": "1442727487224670", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622276_1442727490558003_3253759537065510051_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tO8w0AJmq4Q7kNvwGZ0JAY&_nc_oc=Adp_H4nCjOvivK5xuBnh2SYP5pHrmvCq49Q79yaWdJwxZ8NMc5qdgxmxF3S7SkXRkM4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m6S7VbMBN5dmp3XjQcsPQpQWyGJyaRO_1rKPbSudXIA&oe=6A26BF6E"}, {"file_name": "MainGame 1_2026-02-20_01-49-17.png", "id": "2750446598655085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619465_2750446605321751_9020235368350718638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYl7COV3SVUQ7kNvwEBfUiv&_nc_oc=AdprzV3bEQB15AlHZSGyiIEd8EUStJbZcgk0hQ0wK6cojz61xDzmXuWgweKpaLwptbI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80920frV22TBL91u1GPlzzH1qpJwg-tL4CTT3XnthI7g&oe=6A26C66F"}, {"file_name": "MainGame 1_2026-02-20_01-49-50.png", "id": "806889065781823", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_806889069115156_3612575533288755157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKb0PwChShEQ7kNvwF1ElJM&_nc_oc=AdrKAj2Ium-PGDLT6aRZArcD97ujje4HuPkFr0ZKKu1epeTR7vshiTIh6opilQQCR2w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yh_5Hjr1gJHbE5SSeJa3DsxERuAKlu3J4-fwYDpJqzA&oe=6A26D7C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainGame 1_2026-02-20_01-50-12.png", "id": "911962895061369", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619751_911962898394702_2280370344947495902_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xup_GzM8PFAQ7kNvwH1opB9&_nc_oc=Adp3pctpUoFqKtm1v1F9iE_GkQmuX_10rxcW-dg4korBmvduUJcmZgbRdAKhk5DRWms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a5DOssKK266R-clool6nN1OQhyiGLVEYMAL_0QC1k_Q&oe=6A26EEF4"}, "display_name": "I Am Gorilla", "keywords": ["hangout", "social"], "long_description": "Welcome to I Am Gorilla \u2014 the next big Gorilla Tag-inspired fan game!\n\nJoin a thriving community of players in an ever-evolving world where updates drop weekly \u2014 sometimes even daily! Whether you're here to tag, explore, or create, I Am Gorilla has something for everyone.\n\n\ud83c\udfad Customize Your Gorilla\nChoose from 80+ unique cosmetics (and growing!) \u2014 from seasonal styles to wild, creative fits. Express yourself your way!\n\n\ud83d\udee0\ufe0f Creator & Sandbox Tools\nBuild, explore, and experiment in Sandbox Mode and try out our Creator Tools \u2014 perfect for custom maps, fun experiments, or horror-level builds.\n\n\ud83d\udea8 Report Cheaters In-Game\nKeep the game fair and fun with built-in reporting tools to stop cheaters in their tracks.\n\n\ud83d\udcac Active Community & Socials\nWe're always listening. Join our active community, follow us on socials, and become part of something big.", "short_description": "Welcome to I Am Gorilla, the next big gorilla tag inspired fan game, we have a good community and are active on our socials, we update the game every week, sometimes every day"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/dwA0AjLa", "developer_terms_of_service_url": null, "publisher_name": "SunVrr", "support_website_url": null, "website_url": "https://pastebin.com/dwA0AjLa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "sup
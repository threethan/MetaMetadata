71-25/499620432_1247506207295398_5813205486607490886_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YelI1s-nWCgQ7kNvwFJqemG&_nc_oc=Adk3nKh5O7bRlJmWl03WxjzN0RomwcGNrahXriEK78CVDNmkqDWUA8kgjyJCOvcDiwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvj3I1EJJXfMP2yLTJg8Toq6MxSrUECyXyu-gtU7Iwa3Q&oe=699D9B8E"}, {"file_name": "MainGame 1_2026-01-20_15-06-38.png", "id": "870331852645749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_870331855979082_3550133164174373792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpmTU5A-a6cQ7kNvwFfjHwS&_nc_oc=AdlLsNBYh6b5s1IpVIe0qdba-k6pNXZfgrZ7vIzZzPXXc60YHwdvSqI33SiM1_qvKJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZvSFtNsknYYfAQDZiZhYT57KPkcDzd0z6XbXIkycQlQ&oe=699D8F00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainGame 1_2026-01-20_15-02-28.png", "id": "904113465921541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300686_904113469254874_6860921394867920662_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpxymGNWgzEQ7kNvwG4eu7a&_nc_oc=AdnkqoOu4SsEcRozR2VwpHkK_nxokucJWMaRLQkI_xRzTD6oOGfZf77K_l02WhdnF2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6smhfcN48jpGs49lKhes8D-diloMk2DmWq28xBf2f8A&oe=699DA08D"}, "display_name": "I Am Gorilla", "keywords": ["hangout", "social"], "long_description": "Welcome to I Am Gorilla \u2014 the next big Gorilla Tag-inspired fan game!\n\nJoin a thriving community of players in an ever-evolving world where updates drop weekly \u2014 sometimes even daily! Whether you're here to tag, explore, or create, I Am Gorilla has something for everyone.\n\n\ud83c\udfad Customize Your Gorilla\nChoose from 80+ unique cosmetics (and growing!) \u2014 from seasonal styles to wild, creative fits. Express yourself your way!\n\n\ud83d\udee0\ufe0f Creator & Sandbox Tools\nBuild, explore, and experiment in Sandbox Mode and try out our Creator Tools \u2014 perfect for custom maps, fun experiments, or horror-level builds.\n\n\ud83d\udea8 Report Cheaters In-Game\nKeep the game fair and fun with built-in reporting tools to stop cheaters in their tracks.\n\n\ud83d\udcac Active Community & Socials\nWe're always listening. Join our active community, follow us on socials, and become part of something big.", "short_description": "Welcome to I Am Gorilla, the next big gorilla tag inspired fan game, we have a good community and are active on our socials, we update the game every week, sometimes every day"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/dwA0AjLa", "developer_terms_of_service_url": null, "publisher_name": "SunVrr", "support_website_url": null, "website_url": "https://pastebin.com/dwA0AjLa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25533088059681562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818925_1838823470182642_2991056016390632131_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Cf8lwLkulMQ7kNvwHFZf3y&_nc_oc=Adlx2xC0m6Gpu1CkjbilHcZdlIluegoD-mAZkfr63tyE61A53rSwvt0m3sHB7340ohM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYDvOmE5qkEQzj3tFLZO0YCc98jrYY835etKS8Wbw5LA&oe=699DA5A0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Gorilla", "platform"
48", "keywords": [], "long_description": "Play the classic viral 2048 game but now in 3 dimensions.  Move blocks around the board to combine similar blocks to create higher and higher numbers until you reach 2048 and beyond.\n\nPlay again and again to attain the highest score or fastest time to 2048.  Select levels with varying difficulty for increasing challenge.  Use the timer to setting to race against the clock.  Choose from various block configurations for greater and more engaging challenges.", "short_description": "Play the classic 2048 number game by combining equal blocks to achieve 2048, but in now in 3D.  Many different block configurations and settings available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.goodsoulgames.com/privacy-policy-vr-2048/", "developer_terms_of_service_url": null, "publisher_name": "Good Soul Games", "support_website_url": null, "website_url": "https://goodsoulgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29968291089453222"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619715_704098249104347_3117348371831132189_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMTUOhKpKQQ7kNvwEsAFuD&_nc_oc=Adm0YDRLIG7iin3wo6AOygGG-1djYDQmiDIkVyMqBCqEpfeBQ-vPeRQOA99CWrPdEWU&_nc_zt=3
s=7f20f&oh=00_AQQPilNsvmYW5RuDHMz6t-ZhWrMQCUwcZnF4aukDwOks0w&oe=6AFF15CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover landscape (2560x1440).png", "id": "595714068231801", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982691_595714071565134_1437073675977404134_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38VlaMMOr9UQ7kNvwHFOLHc&_nc_oc=AdqTeAmAAxgILt2htuugNvu_20snGqqbNmmH4cDVEVGt66IAgLTp44LoFyjlbUKDVx4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOIIlew9LBwTiuxmuh5Qde8yUZjxeriXjcXhsjz-si7g&oe=6AFF114F"}, "display_name": "Jogja Gamelan Virtual", "keywords": [], "long_description": "Gamelan VR is the futuristic instrument music gamelan for everyone from beginners to professionals who want to enrich their musical experience. Lets you hit the instrument in VR without the limitations of the real world. It also opens up many possibilities for learning how to play gamelan (through an intuitive interface) with a realistic sound experience and bring traditional dan futuristic atmosphere into one musical experience. Happy Playing Gamelan!\n\nKey feature:\n- Responsive and realistic sounds\n- Futuristic environment stage\n- Unable to play multiplayer in the future\"", "short_description": "\"Want to learn gamelan but you don't have an instrument? Now you can practice gamelan by playing an instrument virtually on your VR set."}]}, "developer_name": "ARUTALA", "developer_privacy_policy_url": "https://www.arutala.id/privacy/jogja-gamelan-virtual/", "developer_terms_of_service_url": null, "publisher_name": "ARUTALA", "support_website_url": null, "website_url": "https://www.arutala.id/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_
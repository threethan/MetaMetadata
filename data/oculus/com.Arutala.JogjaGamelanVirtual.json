_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUTqHqNb0QYQ7kNvwFTt-aY&_nc_oc=Adql_NZSRiNxel725nMUIrMG2qaQANc3cgg35p4Wug_znY27iNvyYyahYckQJxyPmpg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D45KkZ5Wkzmts4GrjIEKB3foRKPHACQ4tedluGVzTlg&oe=6A467F4F"}, "display_name": "Jogja Gamelan Virtual", "keywords": [], "long_description": "Gamelan VR is the futuristic instrument music gamelan for everyone from beginners to professionals who want to enrich their musical experience. Lets you hit the instrument in VR without the limitations of the real world. It also opens up many possibilities for learning how to play gamelan (through an intuitive interface) with a realistic sound experience and bring traditional dan futuristic atmosphere into one musical experience. Happy Playing Gamelan!\n\nKey feature:\n- Responsive and realistic sounds\n- Futuristic environment stage\n- Unable to play multiplayer in the future\"", "short_description": "\"Want to learn gamelan but you don't have an instrument? Now you can practice gamelan by playing an instrument virtually on your VR set."}]}, "developer_name": "ARUTALA", "developer_privacy_policy_url": "https://www.arutala.id/privacy/jogja-gamelan-virtual/", "developer_terms_of_service_url": null, "publisher_name": "ARUTALA", "support_website_url": null, "website_url": "https://www.arutala.id/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mo
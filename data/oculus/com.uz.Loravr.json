45429710_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaSokbQNq5gQ7kNvwG6wING&_nc_oc=Adn2iDd97vDN-TB9GmBdCVd0hxJRBtVSxnRmFto0WRbDVOrPd_fXWvnr4tcPKIlliOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpzXd77WkYtO4SemhmKGilEKwgSIKm0FmifSyYa-UVbA&oe=69BBF353"}, {"file_name": "Capture d\u2019e\u0301cran 2024-09-12 a\u0300 15.04.06.png", "id": "858893073026095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_858893076359428_1991372004950307960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRkmpwe95SsQ7kNvwG85-qG&_nc_oc=Adkh52ftegmyiPwg7rJqaakyETHzsNMbHBA3Eo2fO53cxixUSsY0Qs3QbyeRQDtLtHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0DHBcr1-vF3SiiQJhjdUXSkRpxB3m1IAcjvXU4JW19A&oe=69BBEB0A"}, {"file_name": "Capture d\u2019e\u0301cran 2024-09-12 a\u0300 15.02.48.png", "id": "838117281636166", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031628_838117284969499_1323471632720408850_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-BpcPrE4u4Q7kNvwEivAew&_nc_oc=AdkjrFjCGB9Sb05hb6wdflhc6iorsLPubiKIWcDLM6jN9ZOyrjMpyKEMQmbdwFcpu9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfznIuTL1_Hi_8N43OaFPcgsSZtXp7ibEEyOwVzIqp15BQ&oe=69BBFF13"}, {"file_name": "Capture d\u2019e\u0301cran 2024-09-12 a\u0300 15.02.19.png", "id": "530390976143241", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982494_530390979476574_2491008067569155987_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr2IzuYVyaQQ7kNvwFUcoSP&_nc_oc=AdkjSfGzEkgMw_UYapy7evYWSzsoISWMC0326XGmdgn1HZk2GznMysFr29KjM5XAjcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwSxNTka4DjheX31VUUEjQp9d4CLzmWiogI6B8MKeu7Q&oe=69BBFD57"}, {"file_name": "Capture d\u2019e\u0301cran 2024-09-12 a\u0300 15.03.06.png", "id": "468082222859750", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_468082226193083_3012830010448882828_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwuVqPSitOcQ7kNvwFX0O31&_nc_oc=AdnGcG1P4c8wH3pZdqbRNZGjTpKIr0eHPulrISEdRL6xsQmOaDHV2lbxn4gYVP97c9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzW4U-XctIWNb3DK6SF1vBC6NfdHgQO1CDxLwTGRyrTPQ&oe=69BBF5BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "new-cover.png", "id": "1083875176554408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982531_1083875179887741_3807487453316345065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfIKHjoJ6VUQ7kNvwGANbfG&_nc_oc=AdkF9by2PgIIU9Lbw9QQE8JpJGXLlwywqxyuscgbVPdYW0ACnwd_AcRsfmBqGIxDCUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz43Cx9Hx32GJ3HG6OluGqG7V64Ua5FfjO7iUnX1ja5DA&oe=69BBE6F2"}, "display_name": "Lora", "keywords": [], "long_description": "**Lora** is a language learning application that is fun, easy, and immersive, focusing on your goals and the key points you want to learn. \n\nMaster over **10 languages**, including **French** \ud83c\uddeb\ud83c\uddf7, **Spanish** \ud83c\uddea\ud83c\uddf8, **English** \ud83c\uddec\ud83c\udde7, **Japanese** \ud83c\uddef\ud83c\uddf5, **Korean** \ud83c\uddf0\ud83c\uddf7, **Chinese** \ud83c\udde8\ud83c\uddf3, **Portuguese** \ud83c\uddf5\ud83c\uddf9, **Dutch** \ud83c\uddf3\ud83c\uddf1, **Arabic** \ud83c\udde6\ud83c\uddea, and **German** \ud83c\udde9\ud83c\uddea.\n{1289756182314655}\n\nSupport us to keep Lora VR free for everyone! Your contribution helps us develop new features, expand language options, and make language learning accessible to all. \nYou can **support us** by purchasing items in the store, such as **weapon skins, coins, and special packs!**\n\n\u2694\ufe0f **Slice and Shoot Modes**\n\nChoose your vocabulary and engage in sword or gun mode to interact with objects while hearing or reading their names. Play in arcade mode for fast-paced action or learning mode for focused memorization with visual and auditory cues.\n\n{1278897050049188}\n\n**Word Explorer** \ud83c\udf0d\ud83d\udd0d\n\nIn **Word Explorer**, test your vocabulary skills in a fun and interactive way! An object, animal, profession, or other word will appear in front of you, and you must choose the correct answer from **four options**. Select the right one to progress and expand your knowledge across different categories!\n{1314933709835484}\n\nLessons AI! \ud83e\udd16\ud83c\udf93\n\nBoost your language skills with **Lessons AI**, an interactive mode designed for real-world practice!\n\n\ud83d\udcdd **Grammar Lessons**: Master sentence structure with guided grammar exercises.\n\n\ud83c\udfa4 **Immersive Mode**: Choose between free conversation or a **job interview simulation** to practice professional discussions.\n{610984161702914}", "short_description": "Lora VR is a game whose goal is to offer you a unique immersive experience that makes learning languages easy, fun, and engaging.\n\nLearn 10+ languages: French, Spanish, English, Japanese, Korean, Chinese, Portuguese, Dutch, Arabic, German, and more.\n\nWith Lora VR, language learning is no longer a chore but an exciting adventure that opens the doors to a world of possibilities. Ready "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lora-learning.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://lora-learning.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interacti
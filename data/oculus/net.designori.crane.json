7kNvwE0Rr09&_nc_oc=AdoGj6OKRR7p-dBTpOCXDLrYcDwZDG_Dc69KErxQH_DPIRfZFIhB8q_pHQ6YTtzRvmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6D9_Cb18nmzdTwjKoQqQ27IazDLo4Ly7ifCQgC4bJrg&oe=6A3150F9"}, {"file_name": "screenshot4.png", "id": "4067422416841650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830599_4067422420174983_2260996550380276533_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeNwHQMAl8QQ7kNvwGXtGVf&_nc_oc=Adrxc_xOw1DuztU7xGIgL7fyFGB5bDNnYJogujEoJBGQ0fK_gQ4CR4KGnwWqAvPSZA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pr8OBpRxEaeyo_A1KV98Byb_TCBZ_K9N46KDCIM_0hQ&oe=6A31460C"}, {"file_name": "screenshot5.png", "id": "738539269143695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830589_738539272477028_2490874811966012004_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aISOk-6EJDkQ7kNvwE8itJy&_nc_oc=AdqmCCXh_HNA2epLl9K54NJHqNVASZ3fAciNO07WLj4un-JfmIZg_gNixtar4XWa6zI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AFfm1LXTXWT8eP2mS3bA2aScTXaOc5TSc-XlBJ3-ySQ&oe=6A3154B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i5QzAVX2jsQ7kNvwFCd0PV&_nc_oc=AdoKeXwP7ethDA7qzh5SWtEuDMFBl0uuSn365wNar9pSAg1fCy2ZD3Z7GBmhMC5F_us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gQpwiIaJTfcW064SRKuTtdRIybYraWGJAyHpIxzxhWQ&oe=6A314B89"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
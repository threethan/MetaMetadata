cb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHmk4NcyuxEQ7kNvwGyVDWS&_nc_oc=AdmmqwIWrCP_G4bg80HeQavNqtVtemCujT51-dd2WU5vsVUQHm2jawvRWbxb5gSB9rU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuCkq-gn3foGn9R2z16oxEV6YUXLPT1bL7xJ-0mY_itkQ&oe=699EFE39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i6cqA9HdH8Q7kNvwETz7CG&_nc_oc=Adk-sEBlVtpdK6CXL7zzOslUpxiI-c2vxkO5OY2RdsI9RkWQsYvU1Ki8xhe_diuqd44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft6M680EbXKmWzOQFNdsdrYpstikOOID9xe5LWaOp8EQw&oe=699EF509"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24343735101987957"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1968082270328400"}]}, "baseline_offer": {"id": "1968082270328400"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756406880, "status": "PUBLISHED", "id": "1968082270328400"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24293847160310085", "version": "0.13"}, "id": "1525043151556620", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": 
enshot3.png", "id": "1391543485249581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824592_1391543488582914_2552783215541715767_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5l55lpUCmMQ7kNvwGw5_k6&_nc_oc=AdqBugCWB0rxHunqii13RgXr3n-khT_ySMVR6WR-vcXmWqd0dAHNX4gcNVA-1xN4iVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSImpJ_hXYSucSgYa_D3Dkvxslx_iO_881JOstjOkw26A&oe=6AFDE1B9"}, {"file_name": "screenshot4.png", "id": "4067422416841650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_4067422420174983_2260996550380276533_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv2H6bJ2V2MQ7kNvwEZgMD0&_nc_oc=AdpYV8kqWdVqTDCtbjTLigaNu82LUg8EhICQT3yHfNdGjmUEVOqhST-o0pSYGMD36k4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA6Pxm7wWkgArjKAjo9VBTVxfsNAc-6JhnrrC_Amge3w&oe=6AFDD6CC"}, {"file_name": "screenshot5.png", "id": "738539269143695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830589_738539272477028_2490874811966012004_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK5si2SKrZAQ7kNvwGQrjmP&_nc_oc=AdoMnS6_EeLGVUONLf1XD-iPoC7c9qLO2KuUZeUcKu79RxejlaEsu5qQ2N7JfPpsUbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj6gsOUN_aMS2WlUqA1HyN3ZLM6hBXndSq5HObo5rB3Q&oe=6AFDE579"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1o8f7BuK5rIQ7kNvwEmElQ_&_nc_oc=AdrHlPTWp75WA3uPf8mjU6m18i5bedGbKry4XueBei2xdhltsBRjhjT9US958jKKmbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMom9WciTAJoKiKOSz2zcsH-NPmAXJmVhZxSfQa3F7dg&oe=6AFDDC49"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
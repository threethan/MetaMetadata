7kNvwEfUQXR&_nc_oc=AdoKj25B0w1AY2m3Yb_iGs5bXNo5hi_mMsD8pMWd0xlaBW0a--HLYPIz71t5ukmVqwk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hICUf2uMXnkaq0lTTi_mP6GXLlSDJ8gveDYEb6_MSGQ&oe=6A217EF9"}, {"file_name": "screenshot4.png", "id": "4067422416841650", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830599_4067422420174983_2260996550380276533_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpsLrvpgbscQ7kNvwE0dIWz&_nc_oc=Adp3q4stEMfs58IQi35p-XrdeiY8H5q5pHn_rltPGI9WQDE11IyIerD09T9vQqXH6Ic&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85xTq2R3Nyrerww8xR8MWYRzTUar7rdvMjmp_FZqeCTw&oe=6A21740C"}, {"file_name": "screenshot5.png", "id": "738539269143695", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830589_738539272477028_2490874811966012004_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QrDhpx6jVMQ7kNvwEul3mc&_nc_oc=AdoaTFz31wEv_JFvdpa8u98rNJZE3sH9KzCskSvlLwQ9Xt_V9Isef0GZ2Z1TopndHIQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_focAR0U7RSqKtX0hPf2JjEnzPOGjFrwS7hYC0EBVIPA&oe=6A2182B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn9k-Od15JsQ7kNvwHriWq3&_nc_oc=AdpxtUds1RdTq0_8f7T88wmu9D4heq5pS8MR0xfoXRvOlWBrZuSWN7aFfVYwav0b0qQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YGWwhDqBswxqW0tN6A08EgWRZxNts1fXpPx3Rxh2dVQ&oe=6A217989"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
enshot3.png", "id": "1391543485249581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824592_1391543488582914_2552783215541715767_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMZ1N6J5GzIQ7kNvwEf9UBn&_nc_oc=AdrlQEksh9SDQBDtIZA6Wy2U0XKK6Sc6_g27v2oEUw7edh14paWkfG8Ez5EYawuBIeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV81mFkSUqraQmqu4mVEstAaN1L925Ws8tQOgyW18QL1Q&oe=6B1056B9"}, {"file_name": "screenshot4.png", "id": "4067422416841650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830599_4067422420174983_2260996550380276533_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrGNloHqzzMQ7kNvwE1Nkue&_nc_oc=AdrIF010ASH-NM5wfwuZXu-Wlyn--Cphkts_U5Kwt9CZA4BBr1q-lUk9TA9QJXiZJRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqyQXj9U2CaKgE_LKF8mqm870CFolKnM61eeEVp4rvVw&oe=6B104BCC"}, {"file_name": "screenshot5.png", "id": "738539269143695", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830589_738539272477028_2490874811966012004_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fljqnfUqvAQ7kNvwHVDBh4&_nc_oc=AdontS37jNJAwM3CVkbJa2_qiWRRVvxKreI5nkuR162Uk2EkWCJf5fEV88VAYkLT0hQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUeNsyUpv27eVHgx_mshKWA4HyF2HWdbrZbr213ViEixg&oe=6B105A79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USGOgksXr0oQ7kNvwFsvjUm&_nc_oc=AdrERq5nDy8nEUAuNhKziDVTMY6IkeFOUlp2WUs2x4kXIY09KlI8lQoIjAI8Bn-WgZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTXb49RPLY_gEslJsMDmFGQryOr-duQcLhdgG3FFSFKg&oe=6B105149"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
c_sid=6e7a0a&_nc_ohc=Z6wPfG5gWGkQ7kNvwEVqic1&_nc_oc=Adpop89v3JniWhIsahS1ZXvHeHehqVrQscbyuBsnbhCgWpeMzE6oA4reY_7sfH3VscI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzLoIk31jcc9m88GRzWlCtU-ymBzGRJhYqta5tPAu6Yg&oe=6B0B10B9"}, {"file_name": "screenshot4.png", "id": "4067422416841650", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830599_4067422420174983_2260996550380276533_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58ISeJX8i3wQ7kNvwEM5oI9&_nc_oc=AdpiKrbPuJREySlHSjQHUDEOeYrxhoPI9SxughW7dn-rSgFM689j3VXYG2l9s6VmKPY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlGa4pF2agHPadxqNTBzoDF7rTEDwAfVQK-cH4os8yJQ&oe=6B0B3E0C"}, {"file_name": "screenshot5.png", "id": "738539269143695", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830589_738539272477028_2490874811966012004_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d-V1fMNdpwQ7kNvwGL_c2Z&_nc_oc=Adqk3TF44FGJvhlk2Drm2QFORmwAtPe5iElKZqEXb8y6nfzM80ULd6GeJX0jzzxDtsE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzZEYhTmWIN_AaWFzNCzveeq6Y1hXAOsAN2Hupa8JNeA&oe=6B0B1479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqdtpsHge9YQ7kNvwFtH0eN&_nc_oc=AdpV1Okhyhh5_EJhmG_w0HtDCfcWg9rzCBFxEM-ALksnLsHh2u4iSPyxveWrNJDlg8o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaTwHW-B7HlvmqB3rbKsQu30xLUsc-s3o0QjvpJFizqQ&oe=6B0B4389"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
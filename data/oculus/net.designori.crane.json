.com/v/t64.5771-25/491827718_1104884325070636_8243893476419562166_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm9cR6Pb9gQQ7kNvwHgQRi9&_nc_oc=AdqARtbCDJupuocJ5O4Bqr6xqqyd2IutInNMC06HElA0wFSU1CCmuEF_OTMs2EXSn7Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtfQBxro2xWX6aZem7kZ_hkFs7K7suQpDjyG3Gfs884A&oe=6A973307"}, {"file_name": "crane-signals-logo.png", "id": "730568490015741", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823893_730568493349074_7807301505606066518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLie4QiYH0IQ7kNvwGSNhJ5&_nc_oc=AdrVMPVAm3r5efoDwrpmvA8HiHMhR68L_uDagzYCAuSX3m9oB-jv1SwZpcqYfIbLbmM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2i40JobfmMgstdY-qhlWoqnHUISq6pNFiG3c2LKY4TQ&oe=6A973EB8"}]}, "id": "1457360235569937", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1582705639357215", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491824611_1582705642690548_5571060347862522207_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC62CrC1YWQQ7kNvwFj0BdI&_nc_oc=AdriekwsefrAfJodr24X_3ylMHTC5h7XDnux0g2oEZ0mdk-uiobutr7V0EFOpzZDTSM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg96vtWmFnFl3f9LMrAWYJips5RGm0erCWlbbW6yOoQQ&oe=6A974EC7"}, {"file_name": "screenshot2.png", "id": "1190160926165154", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827282_1190160929498487_394144849730058820_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exX6poTKwFAQ7kNvwGGMqCi&_nc_oc=AdrERevAq1i0_it4IU6oCjoTjz8FJmlduekZUG_Bd0kDASMuypQdxrQCkmBTr2TPZkQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR5jzg2GpnlTjzdT2aVywvBnAmiWqduPsNrRP6cUqrYg&oe=6A972CEF"}, {"file_name": "screenshot3.png", "id": "1391543485249581", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824592_1391543488582914_2552783215541715767_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD0mFI-3NFUQ7kNvwEnifFO&_nc_oc=Ado8drd51PL_-2YANl1_RqTu_EQpguYoJXfV1Z-oi-qt95WwwSFTBoV2DMjpXHy9WsU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9H2koC2hXmYRHHtjcvfUjH51NQ4bGdCnOzwTl9m1kPw&oe=6A9744F9"}, {"file_name": "screenshot4.png", "id": "4067422416841650", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491830599_4067422420174983_2260996550380276533_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3VoZeQU1BYQ7kNvwFKgBy2&_nc_oc=AdrCY5hRfnhwp8PUYBzF3fGWd2vpLZK7YZ8eCQkYh9m8RWO__abPjr1yUe0JH1sLHzA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvLBWlaZmE49fXnZOAdr6bkrolNQLiBm6TEh--tQSJgg&oe=6A973A0C"}, {"file_name": "screenshot5.png", "id": "738539269143695", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491830589_738539272477028_2490874811966012004_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPl3jBFYlgsQ7kNvwGl2jfI&_nc_oc=AdrXFFq2bcGuS2pKY_vLbVBMCboD0m-a2wkSfRhCqxUX6I4i9Am3xPCK-YmLL5Z7r24&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBs1KSCvxrMYMJtXlOSOVXlrL7AvI9sYxqzjmf7bS5nA&oe=6A9748B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLhkeeB0FTsQ7kNvwGzgDfG&_nc_oc=Adr7QmolUZtaUqHVW8KEWfuAMh9TDkrhqvsShUCbqZYgL8LUk_8hsVBKvCxSg1MWniM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvjuZ-PCsk5a9tgAJhodvycyvjlwWzdbP4OPNyJoCr5w&oe=6A973F89"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
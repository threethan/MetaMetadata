c_sid=6e7a0a&_nc_ohc=31Oh0_9b-AAQ7kNvwHSlenk&_nc_oc=Adp03XRqpZ0sIVFLuVdQJ8XHv1eC8BXCaq-5enAdfMS71W6FjhHueSK903_3dhCJpRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaGMbEqWVbPiSS4PKySKFDkrmHv534-TEI7KeY4LG3xg&oe=6B05CAB9"}, {"file_name": "screenshot4.png", "id": "4067422416841650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830599_4067422420174983_2260996550380276533_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YA3-VgofxT4Q7kNvwFKSxCy&_nc_oc=AdpHBAiE1TQkmajpvskWo3iek4y1wgeM3lY9MgE15x8DDiav-rLDHwW6Nn2Q2CpZAHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXljGw-x425YXSQ1px5qyrnxeKo4YUBTdNJ-tbqWArgQ&oe=6B05BFCC"}, {"file_name": "screenshot5.png", "id": "738539269143695", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830589_738539272477028_2490874811966012004_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5Ig7nNSGVwQ7kNvwFzCwsF&_nc_oc=Ado8nZuh6T1CJ6mudv4TeqD3YkUeYgp7NDIYKL2OGb2cSkGPc9KapDqAbruBaUwqNFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJsvlVR8Kt09_l3bdGZ1Zm4y5YONTl-C5MteaRF1WzKg&oe=6B05CE79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1536060407557291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823854_1536060410890624_9222553092136700266_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m_CUXaDAeoQ7kNvwG828vp&_nc_oc=AdoIB_YeF0fR6yRyguZgeB0k889vkYQe89WyLY1XKfKtOQNzfHFWri5Gdk8zCO3fA3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbQ2iJkDARAMCFWLygIZn9CoQ2JY1o5MyANwfMsZArug&oe=6B05C549"}, "display_name": "Crane Signals", "keywords": ["crane", "signals", "hand", "training", "learning"], "long_description": "Crane Signals is a groundbreaking initiative aimed at teaching users the Standard Method hand signals required to communicate with a crane operator and offers a safe, risk-free environment to practice hand signal communications with a responsive crane, load, and realistic physics. Leveraging immersive technologies like VR and hand tracking, we're creating an unparalleled learning journey that captivates and educates like never before. \n\nKey Features:\nStandard Method Tutorial-- Immerse yourself in a realistic simulation that brings learning to life by discovering what each hand signal communicates to the crane operator. \nPractice Your skills-- Now that you know your signals, practice moving a load as you signal to the crane operator.\nHand Tracking-- By using your hands, you learn through embodied cognition, improving retention of knowledge. No more hand controller batteries!\n\nImpact and Benefits: \nCrane Signals promises to revolutionize crane signal training by engaging the trainee in an immersive and risk-free virtual environment. No need to sacrifice the productivity of real-world equipment and operators in order to train. Asynchronous training offers flexibility to those charged with training new personnel, and devices can be sent to training sites at a fraction of the cost associated with moving personnel and equipment. ", "short_description": "Crane Signals is a hand-tracking Virtual Reality (VR) application aimed at teaching users the Standard Method hand signals required to communicate with a crane operator. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://designori.online/crane_signals/", "developer_terms_of_service_url": null, "publisher_name": "Designori LLC", "support_website_url": null, "website_url": "https://designori.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
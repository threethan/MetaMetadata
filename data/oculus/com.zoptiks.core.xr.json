ss=7f20f&oh=00_AQTARBPOLd4UBa8mHChJuHDNl0IYD46dHa11eTRn6Bh5hw&oe=6B09BDA6"}, {"file_name": "05-island-trek.png", "id": "1432072482349441", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831279_1432072485682774_4862318757357080348_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-bdn7g9dc0Q7kNvwFDiWGN&_nc_oc=Adou_znQPgpR2uGcC0uMFIzEF4UsBUcEefn5YA7r0hQpicF6-lT2OZY7pEwsgHvhpa8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIi-j4Nk_EUyc1M-9_y8Ksso8qvzueg35uNHKMyR3NzA&oe=6B09BF74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoptiks", "keywords": ["science", "animals", "biology", "robotics", "dinosaurs"], "long_description": "Put a dinosaur on your desk. Step into a BioDome. Build a rover and test your ideas.\n\nZoptiks brings wildlife, living worlds and hands-on science into your room.\n\nYOUR SPACE\nArrange floating windows, customize your virtual desk or place supported activities on a real table. Bring 3D models within reach to move, turn and resize them.\n\nLIVING WORLDS\nInvestigate 60 BioDome destinations, including six prehistoric reconstructions. Record observations, compare study conditions and explore at tabletop scale, in mixed reality or in immersive VR.\n\nHANDS-ON LABS\nExperiment with rovers, drones, humanoids and biology workbenches. Make a prediction, change a variable and compare results with graphs and saved trials. Inspect selected animal, plant and dinosaur studies, explore their structures and prepare an observation for your journal.\n\nRESCUE CASES\nGrounded: find out why a bald eagle won't fly.\nAlone: care for a black bear cub found on its own.\nTangled: free a bull moose caught in old fence wire.\nHouse call: treat a great horned owl's hurt wing.\n\nKEEP EXPLORING\nTake on guided science missions, choose expeditions on the globe, watch field-trip films or try hands-on simulations: lion surgery, a broken bone, a rescue drone and a car repair.\n\nSome organisms and anatomy layers use schematic teaching models. Internet is required for content downloads and online features. Online journal features require a Zoptiks account.\nSome features require Zoptiks Plus.", "short_description": "Bring living worlds, 3D animals and hands-on science into your room. Explore 60 BioDome destinations, build robots and take on Rescue cases in mixed reality and VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoptiks.com/legal/privacy-policy", "developer_terms_of_service_url": "https://www.zoptiks.com/legal/terms-and-conditions", "publisher_name": "Zoptiks LLC", "support_website_url": "https://www.zoptiks.com/docs/devices/zoptiks-xr", "website_url": "https://www.zoptiks.com/apps/xr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1418277121367373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293803_1137885538772501_8797845933421559427_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxnlRRDDSw4Q7kNvwEjyrt1&_nc_oc=Ado_WH2xPR4PKt3q7q8XQO9l1CkcXxb2TsvYU9yC314Vai1sYH0UW-3SjdzGAHteKP0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeBDptNo9ff642ci1d1_q-FI1aHSDn5BJXWi9V5uSE1w&oe=6B09C322"}, "is_concept": false, "is_test": false, "is_trial_
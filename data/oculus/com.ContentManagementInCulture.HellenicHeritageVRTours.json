6cEZY-QixRqP1FQR7eCr7zYb-y_Vw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIVK3ocIT5CJyfpRALqK9mxsRjoPDhGNgIsKjOL7BrUw&oe=6B0864F3"}, {"file_name": "Arxaia-Olympia-Screenshot5.png", "id": "1248583373881792", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818885_1248583377215125_7765665746880398548_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04yUU0-h3lMQ7kNvwGrYViJ&_nc_oc=AdrExkFNeYoy4zjKlJOk5I25mSQYSdBnv7X2MD5aBCDo1ktBQiTP9MTriWV9mUp2QG4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLz8QoBp2i3YynFjHZn0D_tLbgNQuqwehvp3rNh62Alw&oe=6B084DD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellenic Heritage VR Tours", "keywords": [], "long_description": " Hellenic Heritage VR Tours is a digital virtual tour platform dedicated to showcasing Greek cultural heritage through modern technologies.\nThe app allows users to explore archaeological sites, monuments, and museums throughout Greece via virtual tours, providing a comprehensive and accessible cultural experience from anywhere in the world.\nIt is designed for:\n\n    visitors and travelers,\n    educators and students,\n    researchers and history enthusiasts,\n    as well as anyone interested in Greek culture.\n\n\ud83d\udd39 In the current version of the app, the virtual tour of the archaeological site of Ancient Olympia is the only available experience.\n\ud83d\udd39 The platform will be gradually enriched with additional archaeological sites, monuments, and museums from across Greece through future updates.", "short_description": "Hellenic Heritage VR Tours: a virtual tour app for archaeological sites, monuments, and museums across Greece, offering a modern digital exploration of Greek culture."}]}, "developer_name": "Content Management In Culture", "developer_privacy_policy_url": "https://www.hh.gr/en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hellenic Heritage"
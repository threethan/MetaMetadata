.com&_nc_ss=7f20f&oh=00_Af5rq8ajJIiXLsYpKGmTldEuTXa4viAhEcl2oAwolY24nA&oe=6A202461"}, {"file_name": "migrated_image.png", "id": "641817503053381", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410455_569324216591957_4916963940115677184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJjNi6-x41EQ7kNvwF2ccCo&_nc_oc=AdpEzlB30L3z7CkSR6JdANQ_PEXHZp7z0LaKCouUSw8H-uwxFya2pMD1wKQ_CxRqu4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r45tlWSF49_RL-mTfhpywmpdtkAOmTj3mZ30pIpQhWg&oe=6A202102"}, {"file_name": "migrated_image.png", "id": "595112647744733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162677_1198589813563936_7473868880364961792_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ricOQo4LD40Q7kNvwHqsBUZ&_nc_oc=AdoCrZSCRR0VuAPrmVXO2bfdTvx-N2gPVb5XQjvr-HfCn0gGzAiZ08KkgbDxoIGDOds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yCL9Yywd4av3Svfpo7DyCHe7eU7tIOsJIUgPUOMF8kA&oe=6A203258"}, {"file_name": "migrated_image.png", "id": "204378410887462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138848_1809810552570128_5458078636286410752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCafQkubwXwQ7kNvwHq7PCH&_nc_oc=AdrFAhDwPMqG7i8kRy-QeTYzPxT4GDmxnA2YWBxZcK8f8VDdHDhxBPysslo0GUeeYLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BjcBOI0EL6ElS_n-7YcqXF9Zn54inDG6ARWUnuQDVAw&oe=6A202839"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cali", "keywords": ["puzzle", "platform", "empathy", "quest", "fantasy"], "long_description": "A sacred coming-of-age ritual brings a young man, Massi, to a tower filled with obstacles he must overcome to save his village from destruction by the powerful Atau. However, Massi soon falls in love with the goddess, Cali, and discovers that the true cost of becoming a man may be higher than he expected. Cali is an allegorical tale, based on a personal narrative, exploring power and the loss of innocence in South American culture.\n\nFEATURES\n\nHours of Puzzle-Platform VR Gameplay: Explore a surreal world filled with monumental structures. Manipulate and move them by solving puzzles to reach your destiny.\nCaptivating Isometric View: Look down upon the world of Massi and Cali as if playing with a scale model. \nEvocative Music: An immersive soundscape that will take you to an age of myth. \n\nNote: Bluetooth controller required.", "short_description": "A sacred coming-of-age ritual brings a young man, Massi, to a tower filled with obstacles he must overcome to save his village from destruction by the powerful Atau. However, Massi soon falls in love with the goddess, Cali, and discovers that the true cost of becoming a man may be higher than expected. \n\nBluetooth controller required"}, {"images": {"nodes": []}, "id": "901660056913811", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cali", "keywords": ["puzzle", "plateforme", "empathie", "quete", "fantaisie"], "long_description": "Du cr\u00e9ateur de Papo & Yo\n\nUn rituel sacr\u00e9 initie le jeune Massi \u00e0 l\u2019\u00e2ge adulte en le confrontant \u00e0 une tour parsem\u00e9e d\u2019obstacles qu\u2019il doit surmonter. Le sort de son village aux mains des puissants Atau en d\u00e9pend. Massi tombe alors amoureux de la d\u00e9esse, Cali, et d\u00e9couvre que devenir un homme lui exigera du courage. Cali est un conte all\u00e9gorique inspir\u00e9 d\u2019un r\u00e9cit personnel, explorant le pouvoir et la perte de l\u2019innocence au sein de la culture sud-am\u00e9ricaine.\n\nCARACT\u00c9RISTIQUES\n\nDes heures de jeu de plateforme et puzzle en VR : Explorez un monde surr\u00e9aliste parsem\u00e9 de structures grandioses. Manipulez et d\u00e9placez-les en r\u00e9solvant des puzzles pour suivre votre destin.\nInteraction face \u00e0 face avec un personnage VR unique : D\u00e9couvrez le pouvoir de l\u2019empathie en VR.\nUne vue isom\u00e9trique captivante : D\u00e9couvrez Massi et Cali dans un univers en mod\u00e8le r\u00e9duit.\nMusique \u00e9vocatrice : Un paysage sonore immersif qui vous transportera vers un monde mythique.\n\nNote : contr\u00f4leur Bluetooth requis", "short_description": "Du cr\u00e9ateur de Papo & Yo\n\nUn rituel sacr\u00e9 initie le jeune Massi \u00e0 l\u2019\u00e2ge adulte en le confrontant \u00e0 une tour parsem\u00e9e d\u2019obstacles qu\u2019il doit surmonter. Le sort de son village aux mains des puissants Atau en d\u00e9pend. Massi tombe alors amoureux de la d\u00e9esse, Cali, et d\u00e9couvre que devenir un homme lui exigera du courage. Cali est un conte all\u00e9gorique inspir\u00e9 d\u2019un r\u00e9cit personnel, explorant le pouvoir et la perte de l\u2019innocence au sein de la culture sud-am\u00e9ricaine.\n\nNote : contr\u00f4leur Bluetooth requis"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.weareminority.com/privacy-policy/", "developer_terms_of_service_url": "http://www.weareminority.com/privacy-policy/", "publisher_name": "Minority Media Inc", "support_website_url": null, "website_url": "http://www.weareminority.com/calivr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "NARRATIVE", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638942630686938"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138842_1220568374696351_1624844904704245760_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_o
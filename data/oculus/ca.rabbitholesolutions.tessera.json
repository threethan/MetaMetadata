0f&oh=00_AQNVmmEV-4EOd1k21jF_0iSKR2bNeJoFWP6H_yvQOtdhdA&oe=6AC6680C"}, {"file_name": "spatialized_icon_180.png", "id": "1034675626289588", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_1034675629622921_9008613617161650804_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYn7wWdPKAEQ7kNvwE-rbWM&_nc_oc=AdojTL4ekLS7aCmNFxMkt0UZ5lwc6tnK53I1DYhV72C0hukvGwkONLO2gaoc70NMLes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYWm3mOLkmBfDEBVIwj7LzaC3GAKQZmd01NWDd4Z4oVA&oe=6AC6534D"}]}, "id": "4174461586020597", "locale": "en_US", "screenshots": [{"file_name": "tessera_store_03.png", "id": "1608581747384936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619602_1608581750718269_3632399404490573550_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNwWYMSRwTAQ7kNvwHfgApq&_nc_oc=AdqS2ZXU-irGJFPDwTBgr8j_h3y74PiOffIwGxfFDJdaxcBQW573ozC4NX9egFJLwWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUlQkje8jtRpauwXj6XZv_-0AgvYietHmjBuyokRzcSQ&oe=6AC643E3"}, {"file_name": "tessera_store_01.png", "id": "2291783388252518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2291783391585851_3828178407808481511_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTe7niMNoY8Q7kNvwETK-7j&_nc_oc=AdpIbKWSP4lzfMNWcGPK-426y44hpj1aLFYJCpAV2nauygTOhy91OuINb-v1zKb12ZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFIc5DUm7pr5MGwuTww0jJ6Ba0cF2U5alES2IkaiThSQ&oe=6AC66BFF"}, {"file_name": "tessera_store_02.png", "id": "4408292786151003", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622202_4408292789484336_3691544982917773902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BctuSAINYkoQ7kNvwEo-f8n&_nc_oc=Adrbi7UMIAEsQaCwISMNALYdKW7AnZUEmiRhV2cVyTG2UohhDdAyAmDafjysQ6EEeco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnS5UpCxpp08zTyEeAoVB_13Yb7-MuKjN_1mfqoCiEMw&oe=6AC65389"}, {"file_name": "tessera_store_07.png", "id": "2320254002046832", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624851_2320254005380165_3693775318131307839_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5iM1UQzS3sQ7kNvwF51sR4&_nc_oc=Adr5SX96damGUZldg0B1bSAdil7s60mZl5CO3WvU6BGzVRKpf-lp8_rkr__qPVZa0Cw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2e5Uks3AfY06cCMZf34_zHHK43EmkgpN4IwJIhhp6uQ&oe=6AC6487C"}, {"file_name": "tessera_store_08.png", "id": "1404622358300885", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628455_1404622361634218_8140842371592572862_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOFmnJlrFAsQ7kNvwFSTtVh&_nc_oc=AdomeYuUulRwvNsDF-jOUsudEIH9Z6xEIg904MI45BA6Uk5Dd0W5Y1QKwxEGytKxiQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcMcPaRW6oj8TecK9c_zMA-K02K18Vmdve3ANeAHRerA&oe=6AC65A82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tessera", "keywords": ["video", "player", "plex", "jellyfin", "SBS"], "long_description": "Most video players on Quest give you one screen. Tessera gives you as many as your headset can decode, and lets you put them wherever you like.\n\nStart in a 2D window as a tiled wall, then press Immersive and the same videos lift out into the room around you; grab a screen, push it back, pull it in, grow it, curve it. What's playing keeps playing across the switch.\n\nWHERE YOUR VIDEO COMES FROM\n\n- Files already on the headset\n- USB drives; including NTFS and exFAT drives Horizon OS won't mount itself\n- SMB / Windows network shares\n- Jellyfin and Plex servers\n\n3D AND VR VIDEO\n\nSide-by-side, over-under, 180, 360 and fisheye are detected from the file's metadata, its name and its shape. If a file is read wrong, set the format by hand and it's remembered.\n\nHONEST LIMITS\n\nHow many stream at once depends on what they are. Twelve small files is realistic; heavy 4K is two or three. Past what the headset can handle, the oldest screen pauses on its last frame rather than everything stuttering.\n\nThis is a player, not a service. No catalogue, no subscription, nothing\nstreamed from us. Five sample clips are included so there's something to watch out of the box.\n\nTALK TO ME\n\nThere's one rabbit in this warren, and he reads everything.\nTell me your troubles and desires.  I aim to make this product a pleasure to use.\nhello@rabbitholesolutions.ca", "short_description": "Tessera can play many videos at once. A wall of tiles in a 2D window, or screens floating anywhere around you in your room; each one playing, paused on its last frame, or grabbed and moved wherever you want it.\n\nIt plays your own files, from your headset, a USB drive, an SMB share, Jellyfin or Plex, flat or SBS.  Nothing is streamed from us \u2014 bring your own library.\n\nIndeed, it also will play single videos like a normal video player ;)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rabbitholesolutions.ca/privacy/tessera/", "developer_terms_of_service_url": null, "publisher_name": "Rabbit Hole Solutions Inc", "support_website_url": null, "website_url": "https://rabbitholesolutions.ca/tessera/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1245755598625120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_2237052106868163_4249583097441771942_n.png?stp
nc_ohc=FKHXQCXTcm4Q7kNvwGwXX2q&_nc_oc=Adp4r2Kbuce51zBwSRTYy09QMDo5TORBlx3cAcyp3z6-Tpo7onUnusFaNw0nr3XTusM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcu2TjWUTaBr3L58A7dSjc1SRPl-g1MvdokrUvxpqzWA&oe=6AFB28C9"}, {"file_name": "Screenshot5.png", "id": "863477259505664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825575_863477266172330_3867165375991365194_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkPUrFzZlrQQ7kNvwGIMILW&_nc_oc=AdocBOoxJrpXPUiVshZw4a3azBSZddI1PxNrEL0gNzBSM-ao9WlHdh1JQq2rXZK6TKQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ7p9OqthI-fTL8RXoTAwuykmAgzXPOWPBva64Y9Bf5w&oe=6AFB3811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "25989610197292116", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823279_25989610207292115_3934177984597325315_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB1GSsOC6IAQ7kNvwFzwjvF&_nc_oc=AdpZPcymsPNIoaHkAyrezQVcT2rKqC0fB6bUWaFX488M79OZdGOdgeL_4zXpr08S9IU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIHkCitKz8b3LeQzt6u2flF2tVrGRG1ihs7pVheiPHCw&oe=6AFB2C2A"}, "display_name": "Olympic Arena 10m Air Pistol Shooting", "keywords": [], "long_description": "\ud83c\udfc5 Train Like an Olympian\n\nStep into a lifelike Olympic 10m pistol arena right from your room, school, or training center. No travel. No expensive gear. Just pure focus, discipline, and practice.\n\n\ud83d\udc65 Room-Based Multiplayer\nCreate your own match room and invite your friends to join you for a 10m air pistol. Shoot together in real time, compare scores instantly, and enjoy a friendly, competitive Olympic-style experience.\n\n\ud83c\udf0d Built for Everyone\n\nFrom aspiring athletes in small towns to professionals aiming for the big stage, SportyXR makes world-class training accessible and affordable.\n\n\nshooting skills.\n\n{889818826907910}", "short_description": "Olympic Arena 10m Air Pistol Shooting is a realistic shooting game that brings the 10-meter air pistol experience to your device. Compete in exciting multiplayer matches or train solo to improve your accuracy, timing, and focus. Use Training Mode to practice aim stability, timing drills, and shot control. Step into an Olympic-style arena from the comfort of your own room and sharpen your focus through immersive VR practice. Anytime, anywhere, your journey to pro-level shooting begins here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25917437361196320"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1079730068432150"}, {"status": "PUBLISHED", "id": "1530941745473618"}, {"status": "PUBLISHED", "id": "1575039650671524"}, {"status": "PUBLISHED", "id": "4546447708946294"}, {"status": "PUBLISHED", "id": "1672169383829374"}, {"status": "PUBLISHED", "id": "944228338402622"}, {"status": "PUBLISHED", "id": "921582467407245"}, {"status": "PUBLISHED", "id": "931699772862182"}, {"status": "PUBLISHED", "id": "804293232612388"}, {"status": "PUBLI
nc_ohc=C9ZTuKcCyBsQ7kNvwGvCeMi&_nc_oc=Adp37aIjIuxFzm5SagfjT0N9DTvKvEbrK3wAriTHzmo6gchjQ1w5qubZFVbbI3xW-rU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyTFEtgLkAA0S7wc720wxGEoxBXhm2-5KOh9tHm0Fgmg&oe=6B0B3309"}, {"file_name": "Screenshot5.png", "id": "863477259505664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825575_863477266172330_3867165375991365194_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30M-DT56XKAQ7kNvwGb9Znd&_nc_oc=AdrrAjdsJqtZJjiYBDydWnuJqat2Blgptba00LMdMHiLcXlir5CwFsHym2WPb_RWUwc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRiBrFfRVjR7PH7KGAEyQ8LIN_Q05ZUWkoJLn_TyL2iVQ&oe=6B0B4251"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "25989610197292116", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823279_25989610207292115_3934177984597325315_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxS1jJSHxCoQ7kNvwHQkR0R&_nc_oc=AdqivMjnqtgdbSZ4Fe_GddY3-ZXpCUfdbs6IJEVZ0LMebfIJxpuYXgleTgTjqNfOxK4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpVaFIaBB8zaZg6ev_ZFekiET1T0wO0UhxpNCERxuVwQ&oe=6B0B366A"}, "display_name": "Olympic Arena 10m Air Pistol Shooting", "keywords": [], "long_description": "\ud83c\udfc5 Train Like an Olympian\n\nStep into a lifelike Olympic 10m pistol arena right from your room, school, or training center. No travel. No expensive gear. Just pure focus, discipline, and practice.\n\n\ud83d\udc65 Room-Based Multiplayer\nCreate your own match room and invite your friends to join you for a 10m air pistol. Shoot together in real time, compare scores instantly, and enjoy a friendly, competitive Olympic-style experience.\n\n\ud83c\udf0d Built for Everyone\n\nFrom aspiring athletes in small towns to professionals aiming for the big stage, SportyXR makes world-class training accessible and affordable.\n\n\nshooting skills.\n\n{889818826907910}", "short_description": "Olympic Arena 10m Air Pistol Shooting is a realistic shooting game that brings the 10-meter air pistol experience to your device. Compete in exciting multiplayer matches or train solo to improve your accuracy, timing, and focus. Use Training Mode to practice aim stability, timing drills, and shot control. Step into an Olympic-style arena from the comfort of your own room and sharpen your focus through immersive VR practice. Anytime, anywhere, your journey to pro-level shooting begins here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25917437361196320"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1079730068432150"}, {"status": "PUBLISHED", "id": "1530941745473618"}, {"status": "PUBLISHED", "id": "1575039650671524"}, {"status": "PUBLISHED", "id": "4546447708946294"}, {"status": "PUBLISHED", "id": "1672169383829374"}, {"status": "PUBLISHED", "id": "944228338402622"}, {"status": "PUBLISHED", "id": "921582467407245"}, {"status": "PUBLISHED", "id": "931699772862182"}, {"status": "PUBLISHED", "id": "804293232612388"}, {"status": "PUBLI
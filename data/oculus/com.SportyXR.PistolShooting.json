g?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJTlUdGoKaQQ7kNvwFCShQY&_nc_oc=AdpPLWZebD6G8y9gV1X2qajg2g0IGWS6rBDYJvtFzAzi0nnYtk-CkytMbqFqryYYomg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P9CZluo96JE9o5Iu0XIP8SxoaA-UIA9WRyficawYkTw&oe=6A393351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "25989610197292116", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823279_25989610207292115_3934177984597325315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kmAYx6FVx8Q7kNvwFK5SDq&_nc_oc=AdraDTl4r2Tr_bHMX7xAQGBuh4XNFLDeANTDgJyh1xoPPSD_WkHuwmc34bbe4SqPf_k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85KBgh-qIvvgqbgboS_33qgCSB0IdcSFZQF8MbTT2DBw&oe=6A395FAA"}, "display_name": "Olympic Arena 10m Air Pistol Shooting", "keywords": [], "long_description": "\ud83c\udfc5 Train Like an Olympian\n\nStep into a lifelike Olympic 10m pistol arena right from your room, school, or training center. No travel. No expensive gear. Just pure focus, discipline, and practice.\n\n\ud83d\udc65 Room-Based Multiplayer\nCreate your own match room and invite your friends to join you for a 10m air pistol. Shoot together in real time, compare scores instantly, and enjoy a friendly, competitive Olympic-style experience.\n\n\ud83c\udf0d Built for Everyone\n\nFrom aspiring athletes in small towns to professionals aiming for the big stage, SportyXR makes world-class training accessible and affordable.\n\n\nshooting skills.\n\n{889818826907910}", "short_description": "Olympic Arena 10m Air Pistol Shooting is a realistic shooting game that brings the 10-meter air pistol experience to your device. Compete in exciting multiplayer matches or train solo to improve your accuracy, timing, and focus. Use Training Mode to practice aim stability, timing drills, and shot control. Step into an Olympic-style arena from the comfort of your own room and sharpen your focus through immersive VR practice. Anytime, anywhere, your journey to pro-level shooting begins here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25917437361196320"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1672169383829374"}, {"status": "PUBLISHED", "id": "944228338402622"}, {"status": "PUBLISHED", "id": "921582467407245"}, {"status": "PUBLISHED", "id": "931699772862182"}, {"status": "PUBLISHED", "id": "804293232612388"}, {"status": "PUBLISHED", "id": "1405903904248141"}]}, "baseline_offer": {"id": "1405903904248141"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1672169383829374"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27781834051423299", "version": "2.0.1"}, "id": "886475754049571", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25827550760184981", "is_concept": fa
n.com/v/t64.5771-25/491827718_1252550892834752_693022476294496844_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VV2_PRBYQ4Q7kNvwExd7p3&_nc_oc=AdpqKMvFEc81gN4sQvzkYw9PQVeGiW4ePdwV0pp6hf8VILu8UnK0pBdDEon1_IaXGpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm_7aV-TlK278H84aZJgsnDF2S7l5onT4-JKQh2Jm3Qw&oe=6ACCF780"}, {"file_name": "SS 4 Dimensions.png", "id": "1253762939553786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827718_1253762942887119_8488239969572667980_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DPKLg7b-_EQ7kNvwGKOKQe&_nc_oc=Adpa1YpM2dFORkglAzUFR1mzrONoK1_M8Df4xoDZSW398_5jR2UObMjwRCNjrbv5jz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBzf6GXhCeuuvW1RrTUTIZve7GgTiSCCJLVhXJUxSPqQ&oe=6ACCFD95"}, {"file_name": "SS 5 Dimensions.png", "id": "1095257286066738", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307451_1095257289400071_6180033133646205285_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwMfmNYi6h4Q7kNvwE9LPWp&_nc_oc=AdpBZJsFOnC6PrkHkohjTe2PH_ADgjEhQFmpgCF0JW1Vz8LBqRbwGLiBgK1MmIlnU9w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNex9704EyOq-VRlJW9AAckUC9Ky2Tj2zWMARMyOTuhcg&oe=6ACCF177"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gobbo", "keywords": ["Monkey", "Horror", "Scary", "Monster", "Fun"], "long_description": "Gobbo is an online multiplayer game that mixes horror, exploration, and the movement style from Gorilla Tag to make something that\u2019s fast, fun, and easy to pick up. You don\u2019t need to be super skilled to enjoy it, and you can go at your own pace whether that means running around with friends or taking your time exploring on your own. The goals are simple, so you can jump in and start having fun right away. You can play solo if you want something a little more tense, or hop into a game with other people for a more chaotic and social experience. There are in game moderators too, so no one\u2019s left out and the vibe stays friendly. You can make your character your own with custom colors, a name, and different cosmetics so people can spot you right away. Whether you\u2019re creeping through dark hallways, running through a dark forest, or just hanging out with others, Gobbo is about having a good time your way with a bit of horror mixed in.", "short_description": "Gobbo is a Horror/Progression game that requires players to use their hands to move. There are many levels to explore with way more coming in the future. The game can be played with random people, friends or just by yourself. Public servers are actively moderated to ensure that no players are being treated unfairly. If you are looking for a fun fast paced game that's a little scary but very fun... Download Gobbo"}]}, "developer_name": "CGDStudio", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR5I1grYisrbcNjkGtbUxKzqJ47w2u-EWiRzYjMV_LFyuhaF2y53jIjkRuu5cxh0ez9rbhw62_oVzUb/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vQa0IQrKDWiq_FRgXOzhsLjv2FMeS9shQPXJy8doaXLOxwwLWAvuMuQvwmuu23o4Lgy94PG9HZPkOj_/pub", "publisher_name": "GDStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/gobbo-web?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_
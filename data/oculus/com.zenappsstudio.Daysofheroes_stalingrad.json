wFgjO-n&_nc_oc=AdrIDgFWV8SwepG2AK9R4w-baqrFZTPMT1hTUkRTWKNzxCgFlnCSJd5w88_TKSCmV3k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDwOUMYyFwx9CZ6JtFaajwm6dfbSPJBa2UTmQk7t68Ww&oe=6A9FFDE0"}, {"file_name": "4.png", "id": "474196488890275", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391893_474196492223608_3301862359262464841_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44tu0wz_se0Q7kNvwF_cM-Y&_nc_oc=Ado5n2lB_e9aKJ7bEVzAFEN4_KQSrtYfWDSPNaH2akvpKaFN7L2VV5yRxvaFRCp2EaA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcHggNOTOrcgPs_ykOD7Cmm9RVMmQvoaJ2JMBk4Nh9zA&oe=6AA02274"}, {"file_name": "3.png", "id": "2054259055090498", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391904_2054259058423831_5002497712917902267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbsBL7NOwS0Q7kNvwHjwYJ1&_nc_oc=Adp5QCVx4D8ETqv6A7flRxjo1yCMq-Sd_R1p7q0AaFcEBdlsNfierii_64Bz1Pvee8Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSJhTIstMiPThaWMMojchdZop4Nk9IAgxEl4B0S6QBEw&oe=6AA0101B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mini_oculus.png", "id": "1698014947422058", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391924_1698014950755391_1866131896025672864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFNAfk-T3ywQ7kNvwHs1DNS&_nc_oc=AdqFMarCF--ZUCVHkuTK9OtnKo35yBA8Ogb94UoNpKxsaprPHc1hFGc5wl7qZvtAXq4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg19nY9w_AY7m5aGD8LTGbOKOLcKKUbyPlnVU-CxpERw&oe=6A9FFE56"}, "display_name": "Days of Heroes: Stalingrad", "keywords": ["shooter", "war", "action", "ww2", "FPS"], "long_description": "\"Days of Heroes: Stalingrad\" is an action-packed VR adventure set during one of the bloodiest battles of World War II. Step onto the Eastern Front, where every decision and movement matters. Engage in brutal assaults, eliminate strategic targets, and face the enemy in intense, realistic combat.\nFrom dramatic urban warfare in the ruins of Stalingrad to stealthy infiltration through underground tunnels, every mission demands courage, cunning, and determination. Take part in fierce tank battles and brutal trench warfare, where every step could mean life or death. Experience a variety of complex objectives, from capturing strategic resources to defending key locations like factories, railway stations, and high ground, or leading assaults to break through enemy resistance.\nGameplay requires a diverse skill set\u2014from precise sniper operations to urban skirmishes, explosive sabotage missions, and close-quarters combat. In \"Days of Heroes: Stalingrad\", you will experience the conflict from two perspectives: fight as a Soviet soldier reclaiming the city or as a Wehrmacht defender struggling to hold the line against relentless attacks.\nDo you have the courage to endure the horrors of the Eastern Front and influence the outcome of this historic battle? Enter the battlefield, test your skills, and make history!\n", "short_description": "\"Days of Heroes: Stalingrad\" \u2013 Immerse yourself in one of the bloodiest battles of World War II on the Eastern Front. Take part in brutal assaults, trench warfare, and strategic attacks as you fight for survival in intense combat. Experience the battle from two perspectives\u2014fight to reclaim the city as a Soviet soldier or defend your position as a Wehrmacht soldier.\n\nStep onto the battlefield, face the relentless challenges of war, and prove your courage in the fight for Stalingrad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dohvr.com/privacy_policy/stalingrad/", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://dohvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, 
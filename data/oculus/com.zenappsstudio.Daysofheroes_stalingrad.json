 "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393911_1802225900601595_4754662093559538320_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piaQycZZe90Q7kNvwERKZPd&_nc_oc=Adq4laR5ffrOQsoOxFO-ElCt5rYGEWuZ9ntQx9mkiuzsDGGSx1RrCasEyWYfQhQfcRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAXEdMaEbvBFPYe-aq0pGD23lsTqvUB4CMx_dtoYX0Sw&oe=6A6C9360"}, {"file_name": "com.zenappsstudio.Daysofheroes_stalingrad-20260724-181610.png", "id": "1515483067001547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1515483070334880_6475588640915297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix-CEaUtpaYQ7kNvwFkl3BO&_nc_oc=AdpisrZfRKPEspzIJ5cKkkeDIs9H6ApI1_bgteEvp97l4kybC2iRfMW6rsFpdOIBkSQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKvcgeArgyAHSoYBtSrIY9KwA6OAwh8abTSNOTbVPrpg&oe=6A6C94C4"}, {"file_name": "Zrzut ekranu 2026-07-24 200251.png", "id": "4655013124771137", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_4655013128104470_1934057828903381622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQhvgQ7oIvEQ7kNvwHmmy7-&_nc_oc=AdpQom4Kz623JYX7njZhAoV5yCLSUIEoBionBVhPQpPAj03O5b3BpVRg21XPLL7xPj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiNnHiVPoofFceWIu_hWn0VODEZN8WSgPM9IHLzauRig&oe=6A6C8B3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stalingrad_MainTheme_shadow_demo_b.png", "id": "1579305530482827", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823259_1579305537149493_7094326053250392950_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAV1-lo3dQMQ7kNvwG0Y5Pc&_nc_oc=Ado1XPviaKjcCcrH3sn7QQDksrjGSgBg_u2694zcqv0D2O9JaVesiwP5RqIB_gBgj1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx5zgAy7I7OB6dH1HitTROCl6y4l_j_P2k6IhZKD95hw&oe=6A6C92EB"}, "display_name": "Days of Heroes: Stalingrad", "keywords": ["shooter", "FPS", "Stalingrad", "War", "lowpoly"], "long_description": "# Experience the Siege of Stalingrad Like Never Before\nImmerse yourself in the most intense chapter of World War II in this cinematic VR action adventure. Every shot, every explosion, and the roar of artillery draw you deeper into the chaos of urban combat.\n\n# 25 Adrenaline\u2011Fueled Missions\n\nFrom frontal assaults on fortified lines, through daring sabotage operations, to relentless trench battles\u2014each mission delivers unique challenges and pure adrenaline in this VR shooter.\n\n**\ud83d\udca3 Gear up, soldier\u2014Stalingrad awaits your courage! \ud83d\udca3**\n{1818531499047444}\n# Full VR Immersion\n\n\u2022 Traverse ruined factories, rubble\u2011strewn streets, and muddy trenches\n\n\u2022 Take cover under a rain of bullets and feel the thunder of artillery around you\n\n\u2022 Operate heavy machine guns, sniper rifles, grenades, and explosive charges\n\n\u2022 Command a tank in a crushing armored assault and unleash the power of steel beasts\n\n**\ud83c\udfc5 Will you survive? \ud83c\udfc5**\n{1049639910664390}\n\n# Two Perspectives\n\nLive the conflict as both a Soviet soldier and a German combatant\u2014each side fighting for victory in the ultimate World War II showdown. \nEach campaign offers a unique storyline, weapons, and challenges\u2014giving you two different experiences in one game.\n\n**\u2694\ufe0f Two sides. One city. Will you claim victory? \u2694\ufe0f**\n{1740696729893276}\nPrepare for a visceral VR odyssey that will test your courage, skill, and resolve in an action\u2011packed, historical setting.\n\n# \ud83c\udfaf Play Days of Heroes: Stalingrad - fight, survive, and claim victory in VR!\n\n", "short_description": "Step into the shattered streets of Stalingrad in this epic single\u2011player VR shooter!!! Face brutal urban assaults, daring sabotage runs, fierce trench warfare, and heart\u2011stopping sniper duels in World War II action. Feel a rain of bullets and the thunder of artillery as every street becomes a battlefield. Command a tank in a crushing armored assault! 25 cinematic missions, two perspectives\u2014both striving for victory. Do you have the courage to change history? Play Days of Heroes: Stalingrad now!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dohvr.com/privacy_policy/stalingrad/", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://dohvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27911126011861621"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824671_1728427924740605_3581478372611720305_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8te2spVxd-sQ7kNvwH_4A7r&_nc_oc=Adq3owNz5zLBJND9BZuLXRxUPlyWW0ry5cIVuy1rULM0000PrFJJnypnYxXAOedjEQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoYvEhWi4Aw0eTV2CgCFMdkrmakbpR87UgbWPmPyNFlw&oe=6A6CBC44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Days of Heroes: Stalingrad", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1752260400, "lastRevision": {"nodes": [{"id": "9217
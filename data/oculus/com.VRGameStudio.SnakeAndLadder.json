c_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLAcfkamBnHUDhXRGEgtHV2gITFlwvD_60FM03fm7d1A&oe=6AC8F821"}, {"file_name": "4.png", "id": "1029263119508910", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499301555_1029263122842243_2373312298298631797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAYWFxq1mdgQ7kNvwE6VYS_&_nc_oc=AdqUgLEebF2IpWuMCO21oOyI4wC7jvSIDg3gudShNom9xRk9SomQfoFm5yTmZ43sVKk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMYExBDBnuXsMkjWYbZclHjmrbdDvdTcHlRfTwSDD1dQ&oe=6AC9026B"}, {"file_name": "1.png", "id": "2195673061209519", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825481_2195673067876185_9144958151711906169_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv1uiCKBmQYQ7kNvwGdBrPI&_nc_oc=AdoOk9EY6w0NsEfeMRsFxQegU8GDmfjLLuKEGl6UzEGVfN0A8s5Z5IEVVJEVil8DpgI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPGzjtIv-Y1UYOV3Xr2rrmY6jHanct72leYPMGOyuUlQ&oe=6AC9024F"}, {"file_name": "5.png", "id": "1027406096733613", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828050_1027406100066946_6804299137646654494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVPNrwbpet8Q7kNvwGUgYWz&_nc_oc=AdrGhkJO62oxS5kJhU7_oKbSH8ZO_hUpLb7auhVEVFKC9LBIRd3aHkgQpHAb3Eqr99Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP67WJ_ARfvQW04T1axMYoypcL2VQC7SCD06tyJXn4uA&oe=6AC91A3F"}, {"file_name": "3.png", "id": "1399452432057893", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825415_1399452435391226_6194342771741861845_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y6I8SjJhZgQ7kNvwEJU_af&_nc_oc=AdqqjZA5Kh8PsnE56hkAE70bfSvgJ5SMniNXw0lNEiUTU3pbVqQ2w6YNFTrQNbhBbBs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHBOlXnKgrYspO9KrOt7gXn8oPjSh0Aw8VJj8ZHYBYAw&oe=6AC909DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Snake And Ladder", "keywords": ["BoardGame", "DiceRoller", "CasualGame", "OnlineMultiplayer", "SnakeandLadder"], "long_description": "Experience the Thrill of Snakes and Ladders!\nStep into a world of unpredictable twists, dramatic falls, and exhilarating climbs! Snakes and Ladders is the classic board game of chance that has captivated generations. Whether reliving childhood memories or introducing the magic to new players, this game promises endless suspense and family-friendly competition.\n\nHow to Play\nStarting at square one, players take turns rolling the dice to navigate a grid of 100 squares. Every roll holds the promise of victory or the threat of a sudden plunge. Your goal is to be the first to reach the final square. But beware\u2014the path is never a straight line!\n\nFortune and Setbacks\nThe board is filled with iconic shortcuts and traps:\n\nLight Green Tile: Land exactly on the light green Tile, and you will instantly ascend, leaping ahead of your rivals.\n\nRed Tile: Danger lurks! If you land on a Red Tile, you must slide down , watching your progress slip away.\n\nGather your friends and family, embrace the luck of the roll, and see who has what it takes to conquer the board!", "short_description": "Snake and Ladder is a classic, luck-based race game played by two or more players on a grid of numbered squares, typically ranging from 1 to 100. The ultimate objective is simple: be the first person to navigate your token from the starting square all the way to the final space. On each turn, players roll a die to determine how many steps forward they can take, making the entire outcome a matter of pure chance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQWuaxxDwKCcVoTBmUs6vpkCNpTcA7zuJWUcqgcA9ODt2Pz9nLAeF_ncHUigGaPp7eOQle6ITyG3Htl/pub", "developer_terms_of_service_url": null, "publisher_name": "VR GameStudio", "support_website_url": "https://discord.gg/PYwVCuT4zw", "website_url": "https://vrgamestudio.mobirisesite.com/", "category": null, "comfort_rating": "COMFOR
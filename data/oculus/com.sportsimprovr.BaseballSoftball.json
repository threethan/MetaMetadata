_8502800640176104500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKMH8p-HW6wQ7kNvwEXuPMk&_nc_oc=Ado9pL1i9A0RTkoPIV_5NMpebRH3d5eZ4PssJFsfxC7b7J_j4WdI9YUeURx-RL3-7bM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1nsu2svKYm7Olbz7B-iszslrP11w6B0F1fK7mNCIpY2g&oe=69F1FE49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover AppLab Trailer.png", "id": "1070433643593417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610704_1070433650260083_9089712345028087544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woF5aVv7dfoQ7kNvwFlhSb3&_nc_oc=Adqlg9Cbw_7QZIZHXxFcY5Mcwu90jZeL0IMZ4a-9wC8j5mXnv4_wBJOZxai5VDuSoks&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Nb5kJO0HEh5tX8wp7IFFPMD4Nem9UvBm1SL0s4D6ljw&oe=69F20880"}, "display_name": "Baseball Softball Training", "keywords": [], "long_description": "This training covers all aspects of the baseball and softball game: hitting, fielding, pitching, focus and reaction speed.\nWork on your hitting skills in the Batting Practice drill where you can set the speed, location and spin of the pitch. And to force a late swing or no-swing decision you can make the ball invisible. Or practice directional hitting with our multi-functional tee that you can adjust for position, height and launch angle.\nWant to practice groundballs or flyballs? The fielding drill allows you to play any position on the field, set the speed and range of the balls that are hit towards you.\nOr work on your pitching focus or technique, that's also possible. Just as improving your reaction skills.", "short_description": "Improve your baseball and softball skills using groundbreaking Virtual Reality drills that go beyond the limits of the real world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://license.sportsimprovr.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", 
e3UQ7kNvwEChT6I&_nc_oc=Adlu07jnOUQ6r6538l5E5NJo9frivUytf-vMUKCTp7ueJQz5DoZdRb0GlDs7GhZwiaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftU7-Q3kH440EpkaG4PqyVtU6m8rer-kzbFpZ6JoThSJQ&oe=699D9E49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover AppLab Trailer.png", "id": "1070433643593417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610704_1070433650260083_9089712345028087544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JreJZX_IyUQ7kNvwE1tRxQ&_nc_oc=AdnpHe59DNKdSfPX4axL4_i3P_vrtzhjrRcyqEfIGYwfnD1HV_ujPRbEL-dJwzd5AY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufTHV21z5sAfZFXT3mFK5LIyDoJG-vj_RexkCGHUvT-g&oe=699DA880"}, "display_name": "Baseball Softball Training", "keywords": [], "long_description": "This training covers all aspects of the baseball and softball game: hitting, fielding, pitching, focus and reaction speed.\nWork on your hitting skills in the Batting Practice drill where you can set the speed, location and spin of the pitch. And to force a late swing or no-swing decision you can make the ball invisible. Or practice directional hitting with our multi-functional tee that you can adjust for position, height and launch angle.\nWant to practice groundballs or flyballs? The fielding drill allows you to play any position on the field, set the speed and range of the balls that are hit towards you.\nOr work on your pitching focus or technique, that's also possible. Just as improving your reaction skills.", "short_description": "Improve your baseball and softball skills using groundbreaking Virtual Reality drills that go beyond the limits of the real world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://license.sportsimprovr.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
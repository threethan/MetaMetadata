enu_2560x1440.png", "id": "415602297138491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295751_415602300471824_8028504007211688257_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUuUdozyw98Q7kNvwFU_2S1&_nc_oc=AdlJQLmTZ1BSHr2hBEVF98Dpj8iOedzsXyh581M67wcmnba17pnMsYt2CjFcN8end6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvOYIONPfzAFHxly8xXeqhP8dkTxJzZmg8Kkho7FWbROQ&oe=69986B4E"}, {"file_name": "Screenshot Directional Hitting_2560x1440.png", "id": "406192064896411", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035338_406192068229744_1624260456966728174_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNnIy3ZVaFwQ7kNvwEs9Uou&_nc_oc=AdkVOHIfXR8qFHLKWaEF3sGDTUu5rZIMXb4NdauwI-cZM2IVjwgiv5HOdJ1E3RqxEMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfszdGW11kBsNu4aiGwbaIJpCipBHRIAE_dTOBowfS8KFw&oe=699840D7"}, {"file_name": "Screenshot Pitching Focus_2560x1440.png", "id": "574645060927542", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982497_574645064260875_2276229677728320493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKjTOp8xhDwQ7kNvwG18XM4&_nc_oc=Adm3pEb4b00qad2dphZ9uTTicBJlRBrILiYFiRrbAZxQ9nZ7ycaoTgo5YcOOsECF87g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftfL_KzgEdY_RUFgheNCYcUSuw28kWKzwUzAjeY7ufg5w&oe=69984A70"}, {"file_name": "Screenshot Fielding_2560x1440.png", "id": "1488034254944276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404383_1488034258277609_7410707247810562726_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDnhiA_cpZUQ7kNvwENd9K0&_nc_oc=AdmlVxaZh-GCG5lMSphyceKJP-cfR7r_6c2a3zvjiBqm2HUt-waAYa5hNrCVd0wj2UY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afun0eMwbYWXIHACHF-MUXH_ycpqH9Kzl6jg21nuJ05PUw&oe=699868C6"}, {"file_name": "Screenshot Reaction_2560x1440.png", "id": "1145515816017245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_1145515819350578_8502800640176104500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=181mXDJ07ZoQ7kNvwGnSGfg&_nc_oc=AdnbqjZtmcePxljSyOAAB0QZ4pOvFpmIVOrkqqYm5ujfzniJerPEw5I-gp-c8JlwZr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs54SFdMYKeb-b1w6Kn3Pi0yt01xud9gL1HPMGMQH84ag&oe=69985849"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover AppLab Trailer.png", "id": "1070433643593417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610704_1070433650260083_9089712345028087544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSrYnJPKcAEQ7kNvwF1JjW3&_nc_oc=AdmGa4UT5K7BSrP1utw-Vi0mjzSeK6S54eprgEscUJHEEurUnnCkAcInbWLgz_AdcYA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuhxdFbQumXeEtJ04aLrTLNCrolsqZHAXfI76KnOJCf_w&oe=69986280"}, "display_name": "Baseball Softball Training", "keywords": [], "long_description": "This training covers all aspects of the baseball and softball game: hitting, fielding, pitching, focus and reaction speed.\nWork on your hitting skills in the Batting Practice drill where you can set the speed, location and spin of the pitch. And to force a late swing or no-swing decision you can make the ball invisible. Or practice directional hitting with our multi-functional tee that you can adjust for position, height and launch angle.\nWant to practice groundballs or flyballs? The fielding drill allows you to play any position on the field, set the speed and range of the balls that are hit towards you.\nOr work on your pitching focus or technique, that's also possible. Just as improving your reaction skills.", "short_description": "Improve your baseball and softball skills using groundbreaking Virtual Reality drills that go beyond the limits of the real world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://license.sportsimprovr.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
enu_2560x1440.png", "id": "415602297138491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295751_415602300471824_8028504007211688257_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHMqMgf3wP8Q7kNvwGcXLUo&_nc_oc=AdkO7kuLpPgAIjEIjW0zcVkdyzXqnnqWtrNwdsit6_J4qHsv4TM_g74wVuzxjCUgWFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfstfMz6epBOsPd3SCmjgWocknMISZWlemFU2Z4BOGW9uA&oe=699C5FCE"}, {"file_name": "Screenshot Directional Hitting_2560x1440.png", "id": "406192064896411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035338_406192068229744_1624260456966728174_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p48HnBDADCcQ7kNvwH2FhNe&_nc_oc=AdnqAilK7rVcYsqjT9W5_dRJMWSaPfe0S920IXIX6wW_kuYy6jzngVM8QB1kBL-grI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftGP31BmTf6qnJ6VrN128XYpLouzFf84F0yCrsQylrRPA&oe=699C3557"}, {"file_name": "Screenshot Pitching Focus_2560x1440.png", "id": "574645060927542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982497_574645064260875_2276229677728320493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16EcaqAhKBgQ7kNvwE91OQF&_nc_oc=AdnBhQYWpOQ6QuVf1BL9o812SlDOL1pCkP-2iOUu92J-kK5MsLURqz-w2w9nq04aUes&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu-GB1YRj_Qv4m-XCTYG47JyDgA3jeq1ugDAWUD7PmpVQ&oe=699C3EF0"}, {"file_name": "Screenshot Fielding_2560x1440.png", "id": "1488034254944276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404383_1488034258277609_7410707247810562726_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tJtRFlgQAEQ7kNvwHBAHYM&_nc_oc=AdnzuYJAjCfF_7qYag_PXvDL3-BmFyduSXHSs7MzdlFWqIqwi-Z55FH7EqodJ8u8cY4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvfbh9NFxnsjLDWSygC_9xtBA5s6sADFtu9QVd-J_zK5A&oe=699C5D46"}, {"file_name": "Screenshot Reaction_2560x1440.png", "id": "1145515816017245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031339_1145515819350578_8502800640176104500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcc4CoXKe3UQ7kNvwEtVdn7&_nc_oc=AdnfkUbAK2SKPO2KilwuUOnGY4VHbIDTH5gxXO_ZzDepG8mE0e696C7ypbFgSRgQqZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvkucG1zjJFF7ueV4BZMCre9lRahgnToLjRzyNF63PQwQ&oe=699C4CC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover AppLab Trailer.png", "id": "1070433643593417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610704_1070433650260083_9089712345028087544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17r7iRyhXYIQ7kNvwG8D1g4&_nc_oc=Adn9RhXXl3h94iRfzlA4wRvK6fSjixML4MWaqkiJtWRRt3FT2D3ouczPwDNVMOUpzQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv_fD5492Q5KHQC0N9gfov8yVVSJKv7oKYYUoiDKQ3QTg&oe=699C5700"}, "display_name": "Baseball Softball Training", "keywords": [], "long_description": "This training covers all aspects of the baseball and softball game: hitting, fielding, pitching, focus and reaction speed.\nWork on your hitting skills in the Batting Practice drill where you can set the speed, location and spin of the pitch. And to force a late swing or no-swing decision you can make the ball invisible. Or practice directional hitting with our multi-functional tee that you can adjust for position, height and launch angle.\nWant to practice groundballs or flyballs? The fielding drill allows you to play any position on the field, set the speed and range of the balls that are hit towards you.\nOr work on your pitching focus or technique, that's also possible. Just as improving your reaction skills.", "short_description": "Improve your baseball and softball skills using groundbreaking Virtual Reality drills that go beyond the limits of the real world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://license.sportsimprovr.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
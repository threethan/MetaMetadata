enu_2560x1440.png", "id": "415602297138491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295751_415602300471824_8028504007211688257_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd4Zn4KSJ5oQ7kNvwHykSkH&_nc_oc=AdlDNbt3vuYcPUqGtL-7UoZKREfJ8ARmIgaOpOO5Hsl20Z-mqg2eTkRljXuk1qwOiyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsTE_okGz-6b6TqVCoiMp4_LPNvoKg1iArfGKg8YE0tiw&oe=69A448CE"}, {"file_name": "Screenshot Directional Hitting_2560x1440.png", "id": "406192064896411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035338_406192068229744_1624260456966728174_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfHrDpJjZIYQ7kNvwH0jld2&_nc_oc=Adk8eP1qbReij24ePLUClLUDP5PTDKqWlk8yI0AAzt2I9qCM7iEYwHYbMvW-ilJUaxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu9U-p6nqOhgZB9oakin_XfoUFMqxWY05OsVE0pskeEJQ&oe=69A41E57"}, {"file_name": "Screenshot Pitching Focus_2560x1440.png", "id": "574645060927542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982497_574645064260875_2276229677728320493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-_ZVlZ6Ph0Q7kNvwGiUwBJ&_nc_oc=Adk6UdlsiPE2QcEL18eF4q4yPZi_y04K30E9VvFIMbvnXdo6LA0CocmYFs3A6VJ_y6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv21-EbNNvmxhlD3GR-TpT9WXdtADoZqz014hDP-DrsAg&oe=69A427F0"}, {"file_name": "Screenshot Fielding_2560x1440.png", "id": "1488034254944276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404383_1488034258277609_7410707247810562726_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lK1PjY2ZSnkQ7kNvwGi3rHd&_nc_oc=Adk1A1nI79q9qG_fb5vwKJ2KoipdjHKsmkKO-lyx6Z0Xsycuz058cMc3STT9RvcLU-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsJVqgyVNWcpI-g1Utgj0JXBQ2gR8FbXgcuSHKN3Psg7A&oe=69A44646"}, {"file_name": "Screenshot Reaction_2560x1440.png", "id": "1145515816017245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031339_1145515819350578_8502800640176104500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yikz7Q8F0qUQ7kNvwHL-KH6&_nc_oc=Adn-jWVNdD-SZEec1IwJ7r3z4DFTWDXa8q17XhGz_lQ4ct3gGr5zYp1ubGdUE5y9djs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftHbjXUbN1IEf4zTXZohQqmXsqDabMexOd7a2urS_gTwQ&oe=69A435C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover AppLab Trailer.png", "id": "1070433643593417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610704_1070433650260083_9089712345028087544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHRG5IUwrwgQ7kNvwFEKUyN&_nc_oc=Adkfbr1kyuGyzq-dP0jxHNlA6YA79gueQ1IgdPB6EDkaK5Dnl5ij_IbVBkoGkw9OARg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfugOfq3m790ZqGLWprv_FnDhg3Leo6drpZsHhuXJ2Cz7A&oe=69A44000"}, "display_name": "Baseball Softball Training", "keywords": [], "long_description": "This training covers all aspects of the baseball and softball game: hitting, fielding, pitching, focus and reaction speed.\nWork on your hitting skills in the Batting Practice drill where you can set the speed, location and spin of the pitch. And to force a late swing or no-swing decision you can make the ball invisible. Or practice directional hitting with our multi-functional tee that you can adjust for position, height and launch angle.\nWant to practice groundballs or flyballs? The fielding drill allows you to play any position on the field, set the speed and range of the balls that are hit towards you.\nOr work on your pitching focus or technique, that's also possible. Just as improving your reaction skills.", "short_description": "Improve your baseball and softball skills using groundbreaking Virtual Reality drills that go beyond the limits of the real world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://license.sportsimprovr.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
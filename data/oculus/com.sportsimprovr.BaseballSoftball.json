enu_2560x1440.png", "id": "415602297138491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295751_415602300471824_8028504007211688257_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHMqMgf3wP8Q7kNvwGAs-9K&_nc_oc=Adm9Wfk5FimNNHZ9jlZa3BJW9PDep3ScJ-M3tCSUu-VbR4-u7W4VsMQPG03Svm_PKNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft_KzbNyUBszvUYSFpODmZ54Yq8O909FcJq1oWPzXVpkQ&oe=699F02CE"}, {"file_name": "Screenshot Directional Hitting_2560x1440.png", "id": "406192064896411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035338_406192068229744_1624260456966728174_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p48HnBDADCcQ7kNvwH3JuBq&_nc_oc=AdmMlI7JXTr1lzl5_ztJg9PuAcX1qvKroNFkV2dab8LrIP0mtzFkjzGqxXh_PN31jBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvCkBYUM0LdhKaJnZhS0EAF4f6XYjincVUCUQvOK8hHpA&oe=699ED857"}, {"file_name": "Screenshot Pitching Focus_2560x1440.png", "id": "574645060927542", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982497_574645064260875_2276229677728320493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzN-lkQ8QpsQ7kNvwEDARN-&_nc_oc=AdkxGp8a0QEn1IRmL92iBr65NIGGEJ0ZpggkMLvgiI08aene9WJjAeOInj3n4tmfNe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftFvF9jovEIU8QtMAACpw8xnA8dR2nUm_KGrzQbaHxbrw&oe=699EE1F0"}, {"file_name": "Screenshot Fielding_2560x1440.png", "id": "1488034254944276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404383_1488034258277609_7410707247810562726_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tJtRFlgQAEQ7kNvwFxkVXV&_nc_oc=AdkktMsQF-uWQkIm-rXq3Dp9ddcD5qZOsqOLYUZRlUAsoym9yW55UOWW2UdidGV7iz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftoh1VPUzhoFqbZw_wN28KTBFQUgDA1TPtAN9mJASKFRg&oe=699F0046"}, {"file_name": "Screenshot Reaction_2560x1440.png", "id": "1145515816017245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_1145515819350578_8502800640176104500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4C_Ge1boyUQ7kNvwEJfLZZ&_nc_oc=AdnaKoVxNwz53rcSXrp4LL26Ski7hXtjmK8lHG3R0RmRM4ClvdUKpkziXNgkNudzKCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuSQhYP151VtUGQFcQbsmAaoihaF_nd0Eiu2yZXBOIeAA&oe=699EEFC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover AppLab Trailer.png", "id": "1070433643593417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610704_1070433650260083_9089712345028087544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JreJZX_IyUQ7kNvwEfs72Z&_nc_oc=Adk8BATQF0c6-6JSpmIb8QyZNYI_QTF_0d25tWIuQAobCIS3Cv_5XTuwZ2ywyo3e3gQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftq6PYTD805B8zp9Fn3B3ahxZbX7DqAluSr-ezVKY-K4A&oe=699EFA00"}, "display_name": "Baseball Softball Training", "keywords": [], "long_description": "This training covers all aspects of the baseball and softball game: hitting, fielding, pitching, focus and reaction speed.\nWork on your hitting skills in the Batting Practice drill where you can set the speed, location and spin of the pitch. And to force a late swing or no-swing decision you can make the ball invisible. Or practice directional hitting with our multi-functional tee that you can adjust for position, height and launch angle.\nWant to practice groundballs or flyballs? The fielding drill allows you to play any position on the field, set the speed and range of the balls that are hit towards you.\nOr work on your pitching focus or technique, that's also possible. Just as improving your reaction skills.", "short_description": "Improve your baseball and softball skills using groundbreaking Virtual Reality drills that go beyond the limits of the real world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://license.sportsimprovr.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
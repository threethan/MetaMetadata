e3UQ7kNvwEr-IAi&_nc_oc=AdnPB8Wq7tlXX57gCR6yW8vXtb73TR6gXkCrEkIqxG23lKS9copMbzWDfsa6yvmsiOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvm0vWOSnoKQOL_EMVuKomnwm27fum6k2UVcBXgUzFcnA&oe=699AFB49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover AppLab Trailer.png", "id": "1070433643593417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610704_1070433650260083_9089712345028087544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17r7iRyhXYIQ7kNvwFHAfeK&_nc_oc=AdlBbyCUU9TOwwz1w2ULDxpVcHUM7XD-NcP3EtBLjmj64to6GAw2HIKbqKtT8YwP5s0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvpAz1QgLKWsYoJfph7RVEey5CsnqN26ELPAkhv-Wox0g&oe=699B0580"}, "display_name": "Baseball Softball Training", "keywords": [], "long_description": "This training covers all aspects of the baseball and softball game: hitting, fielding, pitching, focus and reaction speed.\nWork on your hitting skills in the Batting Practice drill where you can set the speed, location and spin of the pitch. And to force a late swing or no-swing decision you can make the ball invisible. Or practice directional hitting with our multi-functional tee that you can adjust for position, height and launch angle.\nWant to practice groundballs or flyballs? The fielding drill allows you to play any position on the field, set the speed and range of the balls that are hit towards you.\nOr work on your pitching focus or technique, that's also possible. Just as improving your reaction skills.", "short_description": "Improve your baseball and softball skills using groundbreaking Virtual Reality drills that go beyond the limits of the real world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://license.sportsimprovr.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
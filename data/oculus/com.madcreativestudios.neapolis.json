_typename": "AndroidBinary", "id": "25142522728738213"}, "release_status": "RELEASED"}, "id": "25142522728738213", "version": "0.1.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1753696345, "id": "24089464364044060", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "24089464334044063"}, "release_status": "RELEASED", "id": "24089464317377398"}, "id": "24089464334044063", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24089464317377398", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1147448573919328"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "750749120833321", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neapolis", "keywords": ["escape", "neapolis", "puzzle", "multiplayer", "coperative"], "long_description": "\ud83c\udfdb\ufe0f Esplora. Sopravvivi. Scopri la Citt\u00e0 Perduta.\n\nNeapolis \u00e8 un\u2019avventura VR cinematografica dove i miti antichi prendono vita sotto la citt\u00e0 moderna.\nGioca da solo o in cooperativa, esplora rovine nascoste, risolvi enigmi e comunica con chat vocale o testuale per svelare i segreti dimenticati.\n\n\ud83e\udded Esplorazione Immersiva \u2013 Viaggia in mondi misteriosi.\n\n\ud83e\udde9 Enigmi Antichi \u2013 Risolvi puzzle che rivelano la storia perduta di Neapolis.\n\n\ud83c\udfa7 Chat Vocale e Testuale \u2013 Comunica e collabora in tempo reale.\n\n\ud83e\udd1d Giocatore Singolo o Co-op \u2013 Vivi l\u2019avventura da solo o con gli amici.\n\n\ud83d\udd26 Ottimizzato per Meta Quest  \u2013 Grafica fluida e illuminazione atmosferica.\n\nSe giocando trovi bug o incongruenze non esitare a contattarci tramite il modulo sul nostro sito!", "short_description": "Entra in Neapolis, un\u2019avventura VR che unisce mistero, esplorazione e sopravvivenza. Scopri antichi segreti in ambienti immersivi, da solo o in cooperativa con gli amici. Con chat vocale e testuale, Neapolis ti invita a comunicare, esplorare e svelare la verit\u00e0 nascosta sotto la citt\u00e0."}, {"images": {"nodes": [{"file_name": "Hero.png", "id": "24100819449573273", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819854_24100819459573272_1971628793653409179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTxuWZNq_OsQ7kNvwHSDJW4&_nc_oc=AdqE2jdoC0lMwNTmT7Fsl30Jm3IE3daezOZROkfzHswYEX7K4LqNFDiNRf_jZ0qtJG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3O5921kwdnr-Y6oypGY-IZGab2FBR4pE97tttwByOpAg&oe=69F34AB1"}, {"file_name": "Logo.png", "id": "2403426636709602", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825575_2403426643376268_7334529317163047522_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmVFEN00aZwQ7kNvwF1PyGV&_nc_oc=AdqaGCQqgul9-j03xfPNeI9wjw1Z47B79QB83e2S73SvhPybn7Kse3g7f5ggWtQcNyw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12g38p8BPxVY9_3Qg9YkJJsPaOXNXaX3dZQn3eWkAHxg&oe=69F35E22"}, {"file_name": "Logo.png", "id": "1934222840697760", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820428_1934222844031093_624612047905600410_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQhY0d-0rDcQ7kNvwF_O_kB&_nc_oc=AdpCE98tkEyygHqSq9mgkfaIdsqy-Z8bgkVW63BfKzyfCNfRnTET_Tq9iuJ_Kk2pwfM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gX0a76SHB4Va6JEPkBpk6CQDMnahk5LZuJp6_82aPFg&oe=69F34234"}, {"file_name": "Square.png", "id": "114178684
91014822_7391473295310154839_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geZ3H76O_a0Q7kNvwHA_1jn&_nc_oc=AdrdDydgGo5l-kNoNSw44R3NCGOBnQZc3IhdRg09b336TPdHCBmnQMth9mIRgJ0lWWY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1P04A5qR_OcEa1U2npQLMspZR6ti7S7RTi73KJrE4R4Q&oe=69F36008"}, {"file_name": "3.png", "id": "1323010889566311", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821682_1323010892899644_8062645833311599822_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzBo8_aZ5acQ7kNvwHrG0FJ&_nc_oc=AdowHuBxFWMknY6gOewiKlY7j9IKIO6wSv6Wer9--zs9WKB_mP2oVpKF8PcahBauZu8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AdmD6Kazuz1b34QbzJ1tnJVRlxhjyCmSNYCx8G0qpjw&oe=69F35206"}, {"file_name": "4.png", "id": "1662188451426608", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824303_1662188454759941_2272023276789620395_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q7hgGEd_2IQ7kNvwFG5ZJK&_nc_oc=Adrl980XaRhdn3FBKFvGzBxIK7EQJuPMndijzJg5leGalPNEw9yfEfKMYc_lZ10w2Pw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1S28GwQxennVeT5CfZOtlm7ZiT5-B80aiXOJI-NTMH7Q&oe=69F355B3"}, {"file_name": "5.png", "id": "3416021151869971", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825305_3416021155203304_4956640117422391553_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNb0YZZkjscQ7kNvwHilLTg&_nc_oc=AdriK6LN2Ua-SKkiHi6364f4W3Fi_xC0oU24jm-E6yePOL41Mo0uVLbdUp4HcXlMO0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mgfzhBBssGajOWHwc5w1GYynuBEsv_gublmGkdH8Pvw&oe=69F36625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1936887830543755", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831569_1936887833877088_7076852272251569590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luWayUNVm2oQ7kNvwEdJ1Wd&_nc_oc=Adq9joFOSTBNvdmdOqlWOrgy-3HpT750TT7Vu2HTsTIzZFE0s6EYc6Wk0YNl_R5LdPI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0U70wxNFAd5Y1yVFOdS6NI1_jJIBv9SVGjRWoBMOsnHQ&oe=69F3650E"}, "display_name": "Neapolis", "keywords": ["escape", "neapolis", "puzzle", "multiplayer", "coperative"], "long_description": "\ud83c\udfdb\ufe0f Explore. Survive. Uncover the Lost City.\n\nNeapolis is a cinematic VR adventure where ancient myths come to life beneath the modern world.\nPlay solo or co-op, explore hidden ruins, solve ancient puzzles, and communicate via voice or text chat as you uncover the secrets buried below.\n\n\ud83e\udded Immersive Exploration \u2013 Walk through vast, mysterious worlds.\n\n\ud83e\udde9 Puzzles & Secrets \u2013 Ancient enigmas reveal the city\u2019s forgotten history.\n\n\ud83c\udfa7 Voice & Text Chat \u2013 Speak and strategize naturally with your team.\n\n\ud83e\udd1d Single or Co-op \u2013 Experience Neapolis alone or with friends.\n\n\ud83d\udd26 Optimized for Meta Quest  \u2013 Smooth visuals and atmospheric lighting.\n\n\nIf you find bugs or inconsistencies while playing, do not hesitate to contact us via the form on our site!", "short_description": "Step into Neapolis, a VR adventure that merges mystery, exploration, and survival. Discover ancient secrets in immersive environments, alone or with friends in co-op mode. Featuring voice and text chat, Neapolis invites you to explore, communicate, and uncover the truth hidden beneath the city."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.madcreativestudios.com/privacy-policy-neapolis/", "developer_terms_of_service_url": "https://www.madcreativestudios.com/terms-conditions-neapolis/", "publisher_name": "Mad Creative Studios", "support_website_url": "https://www.madcreativestudios.com/contacts/", "website_url": "https://www.madcreativestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188
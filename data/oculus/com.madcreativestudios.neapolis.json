dfw6-1.oculuscdn.com/v/t64.5771-25/491825305_3416021155203304_4956640117422391553_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNb0YZZkjscQ7kNvwHilLTg&_nc_oc=AdriK6LN2Ua-SKkiHi6364f4W3Fi_xC0oU24jm-E6yePOL41Mo0uVLbdUp4HcXlMO0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mgfzhBBssGajOWHwc5w1GYynuBEsv_gublmGkdH8Pvw&oe=69F36625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1936887830543755", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831569_1936887833877088_7076852272251569590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luWayUNVm2oQ7kNvwEdJ1Wd&_nc_oc=Adq9joFOSTBNvdmdOqlWOrgy-3HpT750TT7Vu2HTsTIzZFE0s6EYc6Wk0YNl_R5LdPI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0U70wxNFAd5Y1yVFOdS6NI1_jJIBv9SVGjRWoBMOsnHQ&oe=69F3650E"}, "display_name": "Neapolis", "keywords": ["escape", "neapolis", "puzzle", "multiplayer", "coperative"], "long_description": "\ud83c\udfdb\ufe0f Explore. Survive. Uncover the Lost City.\n\nNeapolis is a cinematic VR adventure where ancient myths come to life beneath the modern world.\nPlay solo or co-op, explore hidden ruins, solve ancient puzzles, and communicate via voice or text chat as you uncover the secrets buried below.\n\n\ud83e\udded Immersive Exploration \u2013 Walk through vast, mysterious worlds.\n\n\ud83e\udde9 Puzzles & Secrets \u2013 Ancient enigmas reveal the city\u2019s forgotten history.\n\n\ud83c\udfa7 Voice & Text Chat \u2013 Speak and strategize naturally with your team.\n\n\ud83e\udd1d Single or Co-op \u2013 Experience Neapolis alone or with friends.\n\n\ud83d\udd26 Optimized for Meta Quest  \u2013 Smooth visuals and atmospheric lighting.\n\n\nIf you find bugs or inconsistencies while playing, do not hesitate to contact us via the form on our site!", "short_description": "Step into Neapolis, a VR adventure that merges mystery, exploration, and survival. Discover ancient secrets in immersive environments, alone or with friends in co-op mode. Featuring voice and text chat, Neapolis invites you to explore, communicate, and uncover the truth hidden beneath the city."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.madcreativestudios.com/privacy-policy-neapolis/", "developer_terms_of_service_url": "https://www.madcreativestudios.com/terms-conditions-neapolis/", "publisher_name": "Mad Creative Studios", "support_website_url": "https://www.madcreativestudios.com/contacts/", "website_url": "https://www.madcreativestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "24089464334044063"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1512985443371256"}]}, "baseline_offer": {"id": "1512985443371256"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764166920, "status": "PUBLISHED", "id": "1512985443371256"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25142522728738213", "version": "0.1.1"}, "id": "1056417159894806", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24089464317377398", "is_
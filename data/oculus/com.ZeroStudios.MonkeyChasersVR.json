1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng9sy1UzDckQ7kNvwEwaI0w&_nc_oc=AdobAjYQkbEugUBY0Xd6z_J0ORsbptzacJNQY3WMkYjg4Y0ppEp7hGQyxHh07g2UC2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDumJDjTiaqRfBlwumjg5ncxrZbdf8VRXcML0Ca0bv9AQ&oe=6A5B8805"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QVpNKf-yEwQ7kNvwGkVCHx&_nc_oc=AdqyitiVrwvoKjqZWhZKiR_8s1ED3oCCSrb7Yx_Mg3NQi-2ssJbdqL9Eo_5NMMXdQ7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwFScaQVbfts1Kq3AlnfgmClNIT2zrl1Nds0sLTvoTuA&oe=6A5B7093"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYCV5s_9BikQ7kNvwErh2W6&_nc_oc=Adp5W8H22c6Dm2zEMpAvvbssrvs56NwpTOGfyGZ0vnK1OD-nG73AACLKDVzJfS4Ifis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv0u4GKRjJ_cfkvB489SJJng6jbVYPsIVf3dntKnN9Hw&oe=6A5B7606"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdB31S7HhMkQ7kNvwGl6Pi6&_nc_oc=AdrEJNd52evjMbdjnjXtk2k56Wr-S3EzmtZfouzMvVpDdSY6sJAZf3C5Jacn55U-ERc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAood5T68FaO1Y66CkrIIzwgMxVUNl8lwkCGZQnaFS0GQ&oe=6A5B8507"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1Aa7-rcMLAQ7kNvwGbaM9M&_nc_oc=AdoHF8StAjLU5LyPibgPfNIiS6WebEc1uYNNPt0QvbDfsoDG6wk4HamV4vHarvf0-5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ20oaUWsivgNm3NDJs9-5FIpJnC3L0jGz-i01i2thMQ&oe=6A5B8FE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
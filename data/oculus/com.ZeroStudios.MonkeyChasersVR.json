-nme5J64FdXNHImdLDbE6h5LMeM2uaKStWeQvM2zVY4Sikijm_LERHyPF6B2S4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KspqwxIqZa_1WhjdxdByXdN4KDBO_VMZBG05Nf1MrPg&oe=6A281D85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZnqXVXjRTEQ7kNvwFF6mPQ&_nc_oc=AdrC5JhI1t0kcMZN5VCIq6l1xftpqS4-o3D_YK2YxGgZEjlXEmd_kEYviNntYSAysC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y53t4Mz8IdW0hcKFhnHsMZH0moaKTseo_YUiuEsBqYw&oe=6A280613"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f1RZeRSlSoQ7kNvwGZ4TqQ&_nc_oc=AdpyW5zfsZvTQ63i0Gyke6mxTdHEznc7f0-7FIRxQbpLZtdkeP3mSybflAbVIb3iQRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sJ8ghQhw0zR2J71lOcLqaVZh06MJ8HuKuI16cV86YIQ&oe=6A280B86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7pNQrBLNxEQ7kNvwE-iFlT&_nc_oc=AdrSvLk53-BYEXgGpAEH8kTrKx8QiUGltcYUViYxXcCn4kztxgZ7pVTYExCPCqdCQNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EzkQV6H-N6SiwK-UEq2CX2HBrc8ONxIIahEwNZUoNgA&oe=6A281A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUT67lDf4TMQ7kNvwF6hSVc&_nc_oc=AdrwgQeCmWrdS34FI1SZBB7X1-fZKRMpZiUudvfZvFvqm1WheRv-D5ghxg3EJsEKVEE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_igC5WlG6DiEP6WUNCnd6hcVVmyVvJr5Wb_HQb1s66wQ&oe=6A282567"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supp
5/39031643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KpG5pKraysQ7kNvwHas0Wi&_nc_oc=AdrL98hTJLJ09eRitEPVUCfFC5abVFcwqECb3Jq6COlyiW7hag_usE8yqklKNDEb_PY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbLAC1aD56j1MeA7EisoNzqVbz31rUw831n8XAWukQAw&oe=6AAE9685"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJwR7mWcD3AQ7kNvwE4PHYD&_nc_oc=Adpju-k0UptXTiSB_yQcVPFFglkVfuQSdwZDUNRokbRAOn2H_Qbsb_ZMV3WoxwcnP9E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc8jzfdTMzTPhP41bB4MbfFezzlTYoCQUdiMpkgmPfzA&oe=6AAE7F13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4OVfl4chfIQ7kNvwEDqyQb&_nc_oc=AdqxNbBg38EHPZdOzMtRMUYcvG-nrr9xQ-sFdeNfkGx7IArz3VI3nsZoXimKgQvjtLM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnIsNpxBY7fnV98LmRj57paLi2VkRSdQhpmmSsu1umAA&oe=6AAE8486"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STxCCJk_LXgQ7kNvwE-jZea&_nc_oc=Adrd43o9EPJefXtaw5J-8tztIxV3fE2tMYbk3aUkiylODqRN0EgO2qo2a2Tu86BQ_Aw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIveu_M-buEx4uiRFfzRFegkIelkuubvTYgiBVGdmIAGA&oe=6AAE9387"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9eQHrxWCesQ7kNvwEaTpsg&_nc_oc=AdrEc3V-OBZKTdjFn0aJ6wv5y8utn1iv_qwb0cTP9iR0K0pWuKx_nYYp4-2lZCQ2guw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUH0WDqGrsMG4r2XuOFZnUN9dG6FT4drvEqDgxuSPkdA&oe=6AAE9E67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
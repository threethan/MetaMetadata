_C_ABI-29DNMogT4w3bSiqkTiSW7xFyLyh2a9q25t7Fz8pvewrNcuUT51Ugik4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qL3ATEMs79vlbMfxFOhQmdm8LEIPYwdfgJIfy0iNhhg&oe=6A26CC05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZnqXVXjRTEQ7kNvwE2jAtq&_nc_oc=AdriwLb8S8MkAXGYRpNej7unYXMOyWfYHkuRo9OQMytWHCpUyeNsKdPBPXirriwSRUU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1U2ErGOPLIBJfFJfi91DSFmDY6OIS9-2-fO8tDSgDuA&oe=6A26ECD3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjM-JxDh0rAQ7kNvwFVqrr-&_nc_oc=AdrXf2Gl5OWDxDuIg_UAhrvH4-dAoGwITB1PwU_9VdOH-G-waR3RsrX9bZHKvuVrXNo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jbYbrsLk2YYmGPLi5UY_E1-ED-YfZOVE8a2krvHdYQQ&oe=6A26BA06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7pNQrBLNxEQ7kNvwHLBf0F&_nc_oc=Adq_a2NvzbcwpaTP13VwpRAsVDabx6d1rGVSbFYQFYE7cGW0DeE0lWmRhq7ueIFvdfM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-92tagizn_8V1d6md-7_Q1uqM2pofH1aeR2532Crt8Q&oe=6A26C907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQCiqBU0ssIQ7kNvwG_JLAr&_nc_oc=Adojk2w4liUlgeG7gZFSOUBmCMHfrh7BQAig4UqbkGyMeGmLEEi2_xv9ZIWdE7df7kw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wsUmKtyB0cUmh8IeE-2Tew6XyynOX0PrtJn9TVLWufQ&oe=6A26D3E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supp
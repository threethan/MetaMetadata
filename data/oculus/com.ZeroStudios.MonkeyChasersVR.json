1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMV4lwvS2LMQ7kNvwEocanC&_nc_oc=AdolP-BsAaTBEWpmMLYf5hJjtRUlOe5SRspSMw_3_cAUGcyRYr5unvaaN4HQrvZxQKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK670A6e3QBBHL_fLeGLx8VLDuVVZ8ueZM6wn73XWnCLQ&oe=6AAAA205"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArzzsgTeR_wQ7kNvwFO0g3I&_nc_oc=Adp0utulCMZOP26MBVEnOBJU8wVSvdvZ-NNnqwqKtQ_2jE6TQ2nSJQFp4CGrqgdft4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRHsYFzOnfLbCHejp4EE40YN2HQ_2whdXNECsiBK194w&oe=6AAA8A93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp_D10E2wRsQ7kNvwF3_aK0&_nc_oc=AdoPgrP2On9VEjJvyxi5ZjW7vm0iRRNCahnyDfP95KNf9ROxqwrrXE_Ff2Pt5uUrAQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn1KFyef8TPd6-1ACtiOxtdYEF2tHR_EDAxMO_KEAsIA&oe=6AAA9006"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVkCT6gPw0cQ7kNvwEeODno&_nc_oc=AdpySK6n3yuUrLa7YYgZ0ihpT9pbr1Ch4WNxnl1R6ckm-E7ykzrgAZ3ybtwbi7EOFiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIY68Y08lnUbeIo3Ygdp1VDEY8Dm9r7OYGtmyCTZtAew&oe=6AAA9F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VlevYnONScQ7kNvwE7XUWi&_nc_oc=AdoV-q7MCHZIn9ICSKct5DDlH45v4e2s1S8oYIFhc1x3ufoAHkyirxgmVMVO7QbY3uM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJjY83yzaHcR3u2pf_iMSh2GH6Lbc1vgPo46hTkirAKQ&oe=6AAAA9E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
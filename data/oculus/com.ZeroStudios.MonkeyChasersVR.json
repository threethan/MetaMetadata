R1ChXG_t8Z4Y06xk0TGidqGvfjrfHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzaraPpEhNFJ6GRR7xkIW6J87YG3_kwTLCwOKPJ3_Tg3w&oe=69B95F85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvK5VMIm564Q7kNvwGrfRwu&_nc_oc=AdmgcpGI9z5KoYZ0G5e1lk6lmg3rKOVAu5TWDE0PzIEX-hUklqaEUzhKqgxlHvNZ25k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfQ_bfiQ50-nBLolYweIpzYLu17o3KBTgR5xJVKG09WA&oe=69B94813"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3uDbO1e1O8Q7kNvwFaPyjw&_nc_oc=Adk-RQAl3dHehtsfvk7eph27PQ6XPpDKSx_TeyVdIbbxwPrR8J8VDw6q80XrbwdKX1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUNU4jVKF5O2qL4z7xrMOzS5WVlX-__A0omVbVG247Ow&oe=69B94D86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaSJWRPR9JoQ7kNvwFX7zAo&_nc_oc=Adlxf5hGYTdWwnBh3gCSYgo4RDrDcQRWHB3rYhwuN5RwcfFYYDP3KBHxkNxQFdZMH3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2QYi8BuhSRinUwmG1MFSinXJlaH9nzPQUhUmLzkwvdQ&oe=69B95C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGznq_MxmWsQ7kNvwHphpAu&_nc_oc=AdlAXFUG6RrLKNe0k7vBZNamtOO5Y7e_K9gTmJh4O9-4g6YhYbrB6blvYT35Or8X4Sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzk_CMoq16plztZSz3s_mz8cI-S7XVE_QbP8L5U3EDR0w&oe=69B92F27"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
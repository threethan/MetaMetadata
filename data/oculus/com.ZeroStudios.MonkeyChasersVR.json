1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUfeGSl8shIQ7kNvwGS_boL&_nc_oc=AdonfEpcB2DNHzLOA3GDx8W-2BNYjSDCvZfW68LkyQ3wMLD5ExiU3CQElnQVu_HTSks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT6oTz7fXZ6lwEI-MlguOQzU6Z6gFdoDrQ7oiRriBHTA&oe=6AEB3B85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQI3oGjWIeAQ7kNvwEfI4Pg&_nc_oc=AdqeU_UQtKupi_5fEuZF2SdBagfxmWytW17aCha7llUPN_5ua3Kv6CfD_RQvAhdt8WQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFQ2i5f0KDMXW3Azg0Lcvb3IMCZ2vgC5G4Yw75HySeWQ&oe=6AEB5C53"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNlyXx5R8fgQ7kNvwFgowca&_nc_oc=AdqUaJpRiW29bOZlkLoJPwB1Dj7fsm_jrz66s2PMekSw9FUqehSuWRhF4WUJxJ7K1Ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf1KcNWQdrr5b84bIMLbz-4CwoS175eX9rF5A5COn-NQ&oe=6AEB61C6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDrcbXW4v0QQ7kNvwFD4e2x&_nc_oc=AdoEYHDgwDj2htqjmFkQFImubzDOLpMS-WNTScLd2T3qpz_MPKdbRihYAh2jnFgrTJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0xe9g9Tfn0tavwBUVS67iJrRLWmcjJbIvANF8ZvR8MA&oe=6AEB3887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGA4vgVNAo0Q7kNvwEFDdEc&_nc_oc=AdoMwFJ8j8CxFMa8VaEIMOEj4S388qWfzBrF_LY586Cr5KmbeAinbq_vzhztC7tih6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSumr9Ayy0KNIYWHUlB8oBV2rhxHmXFHbxMzUW9kcIAMA&oe=6AEB4367"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng9sy1UzDckQ7kNvwGDcRqV&_nc_oc=Ado1PYFk3b5DkbgirQ21PeN2IeiXmDQv4iXOG88p1LNZsQ26hXJB5KUbUODfZsOwBfc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvpQjIhpxRqzkR-Rq3ZpcnSFrKj-gjD724PZ3pNIHtnA&oe=6A5A3685"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QVpNKf-yEwQ7kNvwEosITZ&_nc_oc=Adp2KtfvAw6JpZ7djTP9xTZUwcM9hdWAfUM7s_haPD5b5M2gCyofJFoY4B8zr9OJg5Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6KNU0PjWkU-8leqWH9Z5rq3zNPkRo-gHWkFc6YvgO5w&oe=6A5A1F13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXssmMMnqxUQ7kNvwH0zMhi&_nc_oc=AdrfvwsDLGiDm4ry2ze6i8Fhr7Ob809vjZrNbCahJAv94ew7xI_oSe3j-ofGTRM09zw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnC9BflakW6ks051fsWo0L6Ow7XGmMM5kZUauIj3esgA&oe=6A5A2486"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdB31S7HhMkQ7kNvwHak9VE&_nc_oc=Adppkc6pYAlASjbYAruDTZTAB4GIPzJBhFsTj34-NTiO1J4upp1hQePlr5onq706Zxk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC03u625udocJdEdMdF8GhedEun4byGsAa2TMdWoaZZYw&oe=6A5A3387"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdVKLoL5tQ4Q7kNvwE_Y280&_nc_oc=Adps-ABVGkIO9z8VCIfxoahompIlzTW4LbDYx-QUjgH4DMj1x3-LlU73ZxRtfBQ129U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLjmbspEva_yjZGkYBnEAB_U_BDQuzxaizPiIKvXoeIg&oe=6A5A3E67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgtqKS6-QTIQ7kNvwHgQ-rz&_nc_oc=AdrL7g55cTfFm9Fnnztj-xnwUmwW_sKn0jetxPRCZmoL-NEhQ2z20wMoXGBm5ltf35Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIrkIF5bAbrT12JNQVB5BZt_srQLBLNk-nkhxyEafTMg&oe=6A986545"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBx1gBTKSQQ7kNvwGlx-EA&_nc_oc=AdqnB6OhQz7e18rCThIsokJU8OmMAzbcX4TS_Lwb46Htnmq-eyLm6in5l_cwP3v6l2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYWF2lBHbt5_GPcuMGHicFGEw9WG_hf7yIVdS9zCpk_A&oe=6A984DD3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI5vWwAtMYUQ7kNvwHcXSU6&_nc_oc=AdqNmIP4X0yiZhJSqUS1xT1EP244uNCRXI1LYzj9I-jZ3d40QGezmgh5lcnsJPdV9OE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-WTWNXz3Vii9rUmxZ8wNgbuHSONpjYKxWMPIHHx-5CA&oe=6A985346"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSQGpYV_EUYQ7kNvwFOfV_Z&_nc_oc=Adpr_EgWawRYwEOVmXEdqR-XkffQrB3hnP7vps2fMvG-8tnH4OJ0livXzFjGKaDiNLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh0-Fvl0jGHIBmljuIbBFKI5RYTlMXQ2GHtexJ_1egSg&oe=6A986247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19Kprux4Jn8Q7kNvwGslbib&_nc_oc=Adohq266iKy7tcIAS0UmFONp5PT4WhdYJEBdzHleK_80jKDvGw2B6YE2lTATe1v9RSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVbAvCUUq3TV4v8xZzHqviA3TebekSn8RsV3TBomxp2A&oe=6A9834E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
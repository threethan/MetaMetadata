1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYFoXRkZXO8Q7kNvwFoCDmT&_nc_oc=AdoVyOsVqJ8zlE7m9ryrwjBzj2oi0A4MfP9pTeWNWoCjLA4OHl4aLtd2C0uqnAvWpcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqOchra5qowvAio9CaceBpKBp1hY8BFb7BAnToJZjgVg&oe=6ABE6885"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oYFIYcMC1YQ7kNvwH8u7cQ&_nc_oc=AdodKWmHwErzgRi2BwRlxXAlpViBbTJVUw-I4zfhgxeycuMZyjG8m8TYpmS6oOk4Y18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSbkuHfCJQdxA5f__7mNJx6x-NI7ACjZFkPpeW_RaxAg&oe=6ABE8953"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqQHo9tC5AkQ7kNvwGtjNQE&_nc_oc=AdqSNi_uzRRb06FyrB9RPwhvYY0d_B66DAHp26I_QMYH6Z5SK5xWY84gXQvGbxHfOso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRqttAvreHM5VKzHgqFeZZONIuzFm4g0XlOhRlSzws5g&oe=6ABE5686"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=286Rxx_jDyYQ7kNvwG_zw2m&_nc_oc=Ado98dpiwpGR9X2RcxbfsISIW4dWO6oZwsqOl-kGWlwcp0KBe4SW8tUPewWPaTqWzpA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPKkf89yze8LVAsC_nXU1s7wKsJwP-_5QN5zzjv3Ixhg&oe=6ABE6587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTQxI3XtUHAQ7kNvwF5GISZ&_nc_oc=Adr1mKnh8t1WSq8pjBIYD6ud94MpJDDWCoxopVSMpl_7gJCubTTDWdIFXXm2i-u927w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5HzXSTcbsPunKd4KPKwqgq0JME2T9ZEUkVktq4_RUvw&oe=6ABE7067"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
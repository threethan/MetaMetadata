oYzqhCPgLuEcG-2iPR_OIpUx5fNGa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF8cLgqDkDz_yO6eHaUXPyUkbpW51y1pgJ05c-f70tgA&oe=69B56B05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07FBnFrbWysQ7kNvwGBIvMT&_nc_oc=AdnSiobkIAwW_e2qMmmi3cVjSDyL1aDhJsx9-wrlVex4NJSJ8PwZu90VNaM_FqKXHKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxhqHLu3OrCLxwmVFCqcXog9POxB0MtyXdSgxrw2HyCDA&oe=69B55393"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP7pOkyUoRUQ7kNvwFCbSxl&_nc_oc=Adku4fX6bMPpLwhjfNh2TdTTvR9JPrMrg6Z0oUrZLDx-fuYwlLQEqolS8IAg4qIfvkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxl_k8RX5zdIzw3L8hAXTPNNk6OfUp0NOuciHt9o9xCUA&oe=69B55906"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okVT1vLUC-AQ7kNvwGE-euh&_nc_oc=Adl4mN79Nc1eRHVYyjA4lh6Md9eM6WFrBDnK6JlBWQNi4DrGV3PU8qsNWy5VlTsmkZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeIew5620GC2Br5RHDXj1ypMNw1ro7s5lxLZObkXAOTg&oe=69B56807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V0DVfzdjQEQ7kNvwHIDc7q&_nc_oc=AdlmDTtD46_i5je8JZasuTPsAAt4hpNIxQFJ4HihO-p3RxaTKAhz55pP7Y2weBxNGrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzrJLcQeFBJLOnlXqnY91tBwAYUX_8Irbat19ayyyKZQ&oe=69B53AA7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
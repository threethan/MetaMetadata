71-25/39031643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR5xGTW1BpgQ7kNvwFDKp2r&_nc_oc=AdrN9QtMmyFDlHUkcotg9W6jSrKDKnRHn_x8nsk8bbn7V2P9t5i41kmoFH7rSCD1Moc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGytaH9jcfm1VvVABKNwjePhkpSXw1wPOgYFjJccE07Mg&oe=6A857FC5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_WUabqchfAQ7kNvwGB24F2&_nc_oc=Adr675mQx2GJZ5KPFbEAvlWQXFA-ZVja3SpjAk1d_mfdFrGIMvs7qrGaKEtzTIuVBAM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3L961EItGgLDQYGgHUGp7gI4Httf-ES3mrEfPUlAKgw&oe=6A85A093"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-o1tL-Ce6wQ7kNvwHLBbDX&_nc_oc=AdokWEanXL-Fk1gw6pJHDqKUUn9NdybSpxNfI4iqWZ4VM3DNgMW0EPqNcIoYIw0Y1og&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq3wccp0kV6hJMHKBKQ9WIdayZAyKreIMdVeuWX95koA&oe=6A85A606"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_syTBmhCXsQ7kNvwF7OY_N&_nc_oc=AdpdudQTo0K9Z5e9tt96Gd8h4Kq2EDqbGjS4S1oDaGmU_IgQH0hirb2LbONIzzp1XXA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8jLVOfckMZ-yfdDGLu9KiXaBKm_ggmXiJoLfTai6uLA&oe=6A857CC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m6cRV0aPRIQ7kNvwHh_Nbj&_nc_oc=AdqB6WeZWA599hdg9Db6ZwlGUt6Wga8j-dDxqnRdRcRQFxvNzVXFQge9XvB0tqVRd3Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWmAbS1Y7p7sQkw6ONVNRA9nTur7UlsGAUnixDj3Pc1g&oe=6A8587A7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, 
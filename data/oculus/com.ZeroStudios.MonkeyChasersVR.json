1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fel7_-wugFQQ7kNvwFpH47M&_nc_oc=AdoVa2AGQZq_P3tvXpQgHCc8AMhe7l-pD9AsTvX4m_CoTP6_YCQGYZAm899jqX80esg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL3MAikdtXj8CrBgnVPsADnmf5Cz3X6rfxAwHb5wFrLA&oe=6AF8A2C5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9GydZ_UV7kQ7kNvwH7WVs-&_nc_oc=AdpBPlA_n_XAEdSrqepURxIr0r09l1N-lhTr5NdC_nz9xy_Qk2jEiJPZ5wNJDj5V6X8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiLl8-lov783fx3d8u7uv-lpjD2YS6BjO4z5KJ5g1VWA&oe=6AF88B53"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj1r-E7H64oQ7kNvwGTDw_m&_nc_oc=AdpoEVWKzsIidJXNQtfovlewnQwjpn7KanD4GtYJUz62zHSUjypSp3m4VH8d6C5MmBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBwKzr5uz-wZ3D7NUVvPiU1kzn56PFuPab8EjotPtQcg&oe=6AF890C6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIrpSpq1jYEQ7kNvwFUwXrI&_nc_oc=AdokMpCKjGJire1_3_snjYhSVfAky7ECZd-UcAj_2YOcZuoKFe6yigL72SH1JNIbJJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPWc7PFetr8JT0gVeGtclugp5AgCcGLkZgNVWar2qYDQ&oe=6AF89FC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgGrjL7zUs8Q7kNvwF-WSDG&_nc_oc=AdqJoqVfiD3vhmuOw4WQKNOfJ5W486UYTmRdiDnEM7YTz209_bfh9ool2WgCsKaA9fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJvqCurKmWvzaZ92f3AblagNfQfCvlej5jB5QHP6e8rg&oe=6AF8AAA7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
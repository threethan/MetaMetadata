5/39031643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdRUAIwMqjgQ7kNvwEuPMFF&_nc_oc=AdrP1ML7q6_etmc7A3U9jHALi1vMu0n96K7-nBYm_EX288BmOKrj9RMK_OLTAWQzuhw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDOjZuVkVkDLOb8W4IJKxIyDi_vvx0Burg5LNf-aT08A&oe=6AA40A85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH05RxKsTO8Q7kNvwEsUDZC&_nc_oc=AdqeagR20NIlmOAbK5xDqRlYQlzL7Ob_URWDiedJjnzvhaTLhuQ-Dl54uBeZ3NRTMgM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYU6k_efIwKBuDxiNq3OmvIbQ36wP3BdngrHFC71bgDg&oe=6AA3F313"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHod2QetDxEQ7kNvwFX8m7H&_nc_oc=AdovKRaxq58ThGC4aK11WkqF2wMS3kkHOMGZS29mwOQ6qPIeq8dLSdp6z87xkuzw5Vo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcwu_j85eHeKAyh3H0bjvoKee00sjdmkNg-htFh5IqLw&oe=6AA3F886"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxB2BWXNpuMQ7kNvwE66p-X&_nc_oc=AdruKCoJ6o1yrGH-1QcEEQBHZU6KmcxCciVfb6w4fGw7THaRPHqFMK-wAhfKdmjk-6g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw8PZF3uH48ISA_1ZlIjrStPWk-7Z1-hbfjD4dX6XGtg&oe=6AA40787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLO6D90W1EIQ7kNvwHqtCQx&_nc_oc=Adp-cj4p189UahCXbo5r0hQhjKYIsH2nNXizaYSOEtZE-F4vqFzOJhKztx2KhPEbKoo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPcjM9ILIkSGte07vuSMsORmEXiWYFxXeqBu4Hyqtz1Q&oe=6AA41267"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
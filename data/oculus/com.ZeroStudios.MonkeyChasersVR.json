1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNj5thebnIEQ7kNvwHLrFx5&_nc_oc=AdrdFu5taVdNLHlxi-9IYNYzCUcq2YLL4zOrnVZB4X-m3UCu5vyXZ5vsNGpFh46MT7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7f-c8DX6QNbIYByy9o25ytUcmSr33yxnXqhMu0iuqwA&oe=6AF5C785"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDum9ZpiYs8Q7kNvwFntxLb&_nc_oc=Adq5xoq2BPIt1LclSxn8LWX6vJhYifpiRUMbL28iZvOCgMP87Ynw9CSPbOta0yZYE9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5fMJdmdQR_V5uW0-YW8brIb-m1zyq-d8_rZ_Gsat9Dw&oe=6AF5E853"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj1r-E7H64oQ7kNvwHODXzO&_nc_oc=AdoPGWzrp5l0rnbdYwDmSv75LFwlzmWwgqNW-dTJfXPaUuiMz1z5Orwv1mXm8LGrQTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqLJ6-cbPBmytnOzmtemfdVIAfaj2UW0Yx6JmqZKw70Q&oe=6AF5EDC6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akxK61kyth8Q7kNvwFcIeMh&_nc_oc=AdoYRmnk9ANi_lmo0W1MZVWPo4NxB7Nj-HYMuseSdlObyRCJIJAhCFMt5p17C4uRSDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRr7U4d4aIJnR3MUFsqBJ099takao0wf3Hz46k8Au_dQ&oe=6AF5C487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgGrjL7zUs8Q7kNvwFNmYiy&_nc_oc=AdoAIicAP-8FrAopbDJGsO9J1ATCn9xhabKp2WYlT71ZCi4PNSgW7a2AFTf5ld-tLmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwaw5ZwAJgO-cW1OMQkwG6Dq4t3pbYHUGNvWohlkCNqA&oe=6AF5CF67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
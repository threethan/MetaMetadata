-BYRVROFHu2q3Daddjw_LEgutoYmhTiAb2voNZ1sm3E88vE0U6P0FVPVAfZdiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r9FsiIsF-6QcPZYNdX9zPkxckICuEjHcScJOOUz5KQA&oe=69D66085"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TLWx9Lm5eYQ7kNvwFsCAMj&_nc_oc=AdqKV6Cmd2hp9rH8lDzuDpEZxxrfck-HXRSNTUvOz6kuVPn0-VvwA34yO-XiHX7yIWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KQJQm9zE0wpbmPnobnESd3Mo0PQk_-Q9TrEy5qxy6xw&oe=69D64913"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMJWoSMxxXIQ7kNvwGpPGt3&_nc_oc=Adqt1QSVZIWsyKhxdk28x52T9qXjWica_vP36RsJlx4XvFQ2WDG6VzA15yQ0kKk1kQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cGiq1M_nOGsZgRtEpHyb5VwO4az6MWn6kf2GgXeTrkw&oe=69D64E86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzjVKtbMMeMQ7kNvwF5ltyh&_nc_oc=AdrXMTE_NBRFNHmHFdzjRo-2yuDokcLeyTRsHo4jDvH7bBfRNqZAB1UZKZ4sLIV4Bf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xEqRABK30fS3JXnmRnSoewPKXA20u7jn5nDWUrb74uw&oe=69D65D87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCEZ7_nCfpYQ7kNvwG1WXT3&_nc_oc=Adq_n5JbkmBM96MvbQy6RKh9pQz1B5hVNuOeAlQ6jvaxKJNHyRJfuFiGxu0Wuz355ds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cdBeM5bFOLRx7m7pj6ldhutcAeDgQHSXHEDdOMVMgfQ&oe=69D66867"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supp
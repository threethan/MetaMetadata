1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gxz5Q-Oj8EQ7kNvwFeWtT_&_nc_oc=AdpZ5j48Lh3-KNk38-ZdtvWbC4q_EBldFxP7c8Oi8UGLKhOjdumozW0Cu1SQ--i-Zzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7hdUI3EhtNQY3zfhUXrl-iuYsHV3BmoMXh9oGESk98w&oe=6AB67F85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THjJqc0pSOMQ7kNvwF5FPXa&_nc_oc=Adqj3cT1rt9DRiQvLXZfYxibe9kT58ljDQP88Bf350KV8R99sUNIlLU9d4EcdxFP--0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWMhnWhpcgg3zOSZerUDVNvA-lMZZLcoY0P1iCJsJ0sA&oe=6AB6A053"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnGq8OKkZZYQ7kNvwGy-7T6&_nc_oc=AdpDO7eSqop7F5SCzU2FJllLEcfxcn1jg26_1GfMoAXX0EKUoQqsyrGYxoHNkfKcS90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPnwP9k8Ra1urshIKqW1U-6sySZcD6XIPIaeH5Wg0tmA&oe=6AB66D86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaBKETT-J78Q7kNvwHW1mIg&_nc_oc=AdoXRfBk_y0YE6SdDvhPLiqVOQHcv5yCSpRW1qZ7nHJOfTiUTbWMyvFTI_aw-UcF-ZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrQNnNu3GKwlm7XSGodTu4KBqdItcnxOuPpu_tq7U4ig&oe=6AB67C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x3tOftNzy0Q7kNvwE_EvPQ&_nc_oc=Ado-h-AK5vyqhfXnWub-RL0goJM1AP2RpEGDa8z0NCxOYqlN9WCEXcsuDLB8mKokB6E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRZESVMJYSD7WiQqVuffr7xQJOx-fGwLDKPZxxOdyUFQ&oe=6AB68767"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
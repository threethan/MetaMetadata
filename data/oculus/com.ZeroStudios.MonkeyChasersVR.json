1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R627uDP_uXsQ7kNvwH7KKOt&_nc_oc=Adqi_UgBV9HRxhCbvY03UHfoGXPWIct2N5MAv29fl-9fij8tDUDYD-moSG_jpYiMSQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmvd2RTFr-Z36q4yKZFfwt0UjwpGGzBe-7RpDjOMZ1iw&oe=6A524D85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPf1eJaa0BIQ7kNvwEq5z89&_nc_oc=AdoJ9J36psqfKVHqD-2PuXjlGxXAk5ldU5asDvbrwYvW9pmIUmP4VrjCsPJcDMDrZQ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh6jgBdVueOUN_318r2xK9FYzbdYGQJz0Ib4DeJ84WaA&oe=6A523613"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZPJ83G5x1YQ7kNvwHXG2XM&_nc_oc=AdrWaxTDrs1Fh30hQIqu4DwHGDE0fRIPj-3wgldixTBN2vdBr2v-Ov01X3JMmr_oszg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN2XH-jvNpN-WdvMfkdvQiqCt1iCa6mq8TI_tB-UUKPw&oe=6A523B86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XRnHeMz5fkQ7kNvwEtkmm0&_nc_oc=AdrQfPFJScIoZNIoPql2gCiheemhZELdto01sfG7B5zrrFllZvPQyB3qHo4AK19REEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk4ZbbM3PpRq6HAYalANtZ2GHftQfZGN6_pxvGwqiBqQ&oe=6A524A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY9JjhrLnDoQ7kNvwHJogx8&_nc_oc=AdoCNOrb_41m2xJ_BXSL9I3RevAh5BSo5Xe6uRbnlvUR67KW649tgHPQmbDvv3LNq1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPDTI6dQkZ70rwfDn4Ip0OcIIEJH1mEhmdRk3GPj8Fdw&oe=6A525567"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
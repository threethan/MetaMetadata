1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5WBR1GAyboQ7kNvwHbvtK_&_nc_oc=AdpXvBWBVOumbhn3SAieeEYq79sDqK6gMMPKLIJRds5KvppQocfgGRa9qiJ-jlQ8Jfs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR4Tosw-ofpCNtnbpP9f3Wd4Mn6JaXhzJ20Xvu_6ylYg&oe=6A68B705"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p3P7HVWwvAQ7kNvwHcuHsw&_nc_oc=Adpa82Pdg67CGWkyWWdL3DeIkU42f22Og6xiZIXoQXinKYoXokq-aIpCqqzneMH8uVo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUCcdUXah92P-9PP08zuNqDSh1QIYD9U1hP_k8Sbc4DQ&oe=6A689F93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tzhDfehtXMQ7kNvwHJkHD5&_nc_oc=AdqEVflJn-EO8Aeqq8w0y1yAzY3QMHsE7tulA6tlsMOpMZkcTkLIbOWkpOIr3qJv48g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-ymlnff0LmDgeb4ekF9lyLZ35UuxxHOiWPsIXvMvrVg&oe=6A68A506"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_FvdBIUv4IQ7kNvwFZJ2Ps&_nc_oc=AdrBvUVZVr3wNSwINSQP32HsGB4jfyd59AkUVnaD92Kf-dKUAxAnCw4kca5qqucbcUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2VG2KtWRYumm8ykse1THC3jNwhXwmjOHuEsi_42qQUg&oe=6A68B407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVUFqAbdq2AQ7kNvwHDExvp&_nc_oc=AdoHAO_7IXyDz12NxM1m7UKhTOsi1T-T5pwvPnA2GcbhHLHsvDueJmXj-KSrN606Gs8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5G5OJhKilNrHwD9dDz62P-wqIgrm6Na545x4OSbVLoA&oe=6A68BEE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
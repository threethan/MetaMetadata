71-25/39031643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgdAm7DheqkQ7kNvwG0-FUE&_nc_oc=AdoP9oRMxCCWhRQC1D2iKVLAQOjK4EcLMaUp48cAaQJKtdgB8eF0WMxio-2Ix-1_kPE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh2Uxm5mSFI4A_lr2cKc4iLSTAQEj6gQfR-57ZxxXXXQ&oe=6A8D68C5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPi0QeyFUCsQ7kNvwHNcPkW&_nc_oc=Adr7SFl1tIFTQV3t6wuQdyEiMFB4qv_aA6BJxlSDZQzNsQLJtzs4DRpp1yeeDmMwDpY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ-3ccR-6U0HfWbdWUObNPhBXjpW0H8SRWQuFDTG-b4g&oe=6A8D8993"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ri5q6gHWkEQ7kNvwH7_Y7k&_nc_oc=Adp4-Gqc2sH19ea3uFGrNUMOQIJzFrLguKGLoVT3xo7YQB1ebNr46EtyZ91VLi63XoQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt1F19SQpNKUtGEZUmUivPlikIlh9ebbvTO7i0HhoG6A&oe=6A8D8F06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmZkFM9C6BgQ7kNvwHpZ1Ei&_nc_oc=AdpmxX948Xji_oGb-qDywl4mnR3oTXLvBzKGPweiWvBmso7sJtcF7k20Zdx6ocbNVeM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu2Zho8m3p6SjbSJdMEyDfdd0fE-PZTrdDT2sbf59erg&oe=6A8D65C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_1WoGJW7NAQ7kNvwF-_NwL&_nc_oc=AdqUJkbKXV1-81I5lvHqcS3CcJHnNbZ-MUa7cQMf6wQmptFpbFUltAZjJ6gP7zgP_nY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8DfK1yWxFnh4JrNw0M6j4VTLQdoJzQPO7kSIcK3eH2A&oe=6A8D70A7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, 
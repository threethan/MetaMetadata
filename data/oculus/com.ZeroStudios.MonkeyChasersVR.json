1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir499kz1T7YQ7kNvwEZL8qr&_nc_oc=AdpSlkZQjTFjurSQebdGeIlRuOGQujH09s7FUB3a9Jpsfla7pPEfqQZ72cJ8DcRnQVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfMpqCn2PbLZXsPBEn1OIzdCIRHm1o1dR9Za8DQWGaFA&oe=6AE74705"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9b5GJDKrqwQ7kNvwF1gOjc&_nc_oc=AdquLDYh6M2Nhk83C_7wJbnhreOfTHQ_VyPbz4MkEtlMwBJanUHRcp2-K0m4yQGFsho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPCDC_4KlTE_LBeBvdPVclKHIpcOwxeMixq3fL2BP_SA&oe=6AE767D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39zs3hKfg28Q7kNvwEij_wd&_nc_oc=AdrvG1khPYR8uWgnnFFYZGd8gs-RBIaEKFbyIIrCoPwU_SeOhJ779xEGoSWqIO8Feyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFJKrGWwdBeeijo5bgopbrN3mesyp0s8a26x7BjnHM8w&oe=6AE76D46"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HOIpNkdJHEQ7kNvwHhDHEV&_nc_oc=AdqBXry6VSOl6L2SZJ6L43T3UySsd1--AIHGKDTO4Rzq6XVseS_Q7GJ3jhfiMM_GJbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2lwoF68-FGFouR5gS3WYiMu80hA_FyhHQSt5RUoJbTw&oe=6AE74407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmhTdyrvJz8Q7kNvwHDNrtZ&_nc_oc=Adr0pPShO7oX12WPRsTXObAHkcvbgY_I10UTm13-q1MaFcwT2zrhvUqgtC0bgUJrw4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR91StGgO9SqrcyNr7lM4pr5juw7JqjihM0mEFTgB4shQ&oe=6AE74EE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
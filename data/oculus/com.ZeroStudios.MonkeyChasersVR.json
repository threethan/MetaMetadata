1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9DIS0uSQp8Q7kNvwFyEE9X&_nc_oc=AdpPszLJhi1V3yQXj70pDrqLDuJ7dy42ExutuSg9GHap9Y1_wJmjUktjRGlZXB2TWr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9Zrx_1tnwRm2W9IH5gynpR3A0T67qOD3ZmFOtfUaI9A&oe=6A6A0885"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHyy4Ctmov8Q7kNvwFAG0E6&_nc_oc=AdqelEAzIaXnmMQUSFimcGwFqfq8h5zfY9kRcmkI8l7IJPZRk2kV-e4x3B_HK0X3u1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdH1pF5rP-nMf8npb_SuSdueD8fjfe55gvn95SqD5mMw&oe=6A69F113"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tzhDfehtXMQ7kNvwFYwPWT&_nc_oc=AdoGRfSDLZaISqojUluS_n3DNreFkIGOzPXbAyrlPhUjgBxv7WNOGX5Be3QKktCADzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAViWs68mLxgb-p_PZHBKPSEDvec-AGlcqsjJohYAH2uQ&oe=6A69F686"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=920NOxbQpIYQ7kNvwH_Vhb_&_nc_oc=AdoC9zOPt3e73fYPqPJ_BN-6THV8BY3adYif4RdzYB7oRsXLvi6UjFZBTwhsI6a4m7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1_UZBhYPdvZFF-zo-Zg6VmfnG8ljUHfy8hOH1Ll3X9Q&oe=6A6A0587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVUFqAbdq2AQ7kNvwE8G6m-&_nc_oc=AdoJbu1zKIleYtB95sGUNfbbr8TdprpOZIuxE27X0Yx9DMqhXaajdX4PKVGQkNcuWZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaTK2BkHmCnpLmTGzP6jHBthU2qsk2EmFq1DE92KuYsQ&oe=6A6A1067"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHn6KWP-0xUQ7kNvwFt8zaV&_nc_oc=AdrYguiP_R43q5J9FxEpL9g8B6rNRcR6idmUuIQWQgWkRze_0fD9Zfobc0xTgZxlu1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5CLPLnjSSS9ZwORkKmbkxRnuraTMfCDCdcrf_48GH2A&oe=6A4FAA85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-wXXhfnWhcQ7kNvwH5J3Ke&_nc_oc=AdqC7JHWR4vJVjchgel-qBq3uRF5apX97eurNoeBEAYG97wAEJwq-SF0E5S_cxNR64M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFUgJNpDilVbSbqm83u7hW08Ffvh7QYeBAKr9UFnjM9Q&oe=6A4F9313"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZPJ83G5x1YQ7kNvwHEJXiG&_nc_oc=AdoPotOQJ-1cM8F4jQTlbSCWO6fx1Or_99-n4jYHnvvlplz785ngj8qqmyJRdZ-cHf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzz1VQaqMW1atBLMcgpTtPh2K9i_2cV2rV6AxTlodMng&oe=6A4F9886"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa_zkpBmSvMQ7kNvwFV4PQi&_nc_oc=AdrF-iogCmyYu3KAf5CUzgUPggfcPATRTJMIi8cVRvlU_aMzDjKATlV3y_-paNh_6-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXds7kfVaLIC-LXLbMUB2XWrR57e871UeV39yd5T_xfQ&oe=6A4FA787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY9JjhrLnDoQ7kNvwG8wsH0&_nc_oc=Adp2f1Og0A7oYsl1h03emUKRq0VQk8tBBzJHwlr7OLGBrwVoWDgWRbH5nalnwlqbR_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQrxAPqARHsTprop3wKrCUxvpekcIyopilc-fhDGKzjg&oe=6A4FB267"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
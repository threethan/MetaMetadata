3i7cFJRwmfgu04HhXEVfT2XTrzeLqA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuFLJvJs_0X6IVGRWJKjlXQZcwvTxxD2TV1hN71yJI5g&oe=69BD5405"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNXkTAlgnZIQ7kNvwH2E6cx&_nc_oc=AdlZZAHihC3M0BOlAWIq2iIktZA3gw1-tSmpa1gfrq0S09-iUJOjgptUcCLAoi7Pd7Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlUKF75xkrlfkzg6N661_j1L3I5xqZucGAYjmgZU9QSQ&oe=69BD3C93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AvK-y3LLm0Q7kNvwHRyFdZ&_nc_oc=AdmaDQRiJr-4mHr64ZmXlo2WJf3hm9jn2WtjqgoU_oADtrAY0gmF9TyQ-9RBpCfAgxc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYAMINMkQOPql0E3CDnz8GDWm91ksj3ZkoNvcyiY5Jzw&oe=69BD4206"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD_7YS_gr-oQ7kNvwHhBS5O&_nc_oc=Admi8dVZWw0Z55ZYEglOitpzOIfVXEn03gzRmfZeJ7sr_tKBwgPms1Lp4CAdWMZGzKM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZbYp2yV03_RkXptb8g22vpOkTeWrnC3bViXj_Ml-dyw&oe=69BD5107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmG7yxIcbSsQ7kNvwGVbs04&_nc_oc=Adl8noNDzoIPYYgfd_6pOIgl0lyYbTIEnXXrmSFAfxIHjkJRV4ORwcY3U-d8v212KRQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS1Y42Vhff9qRdX3EMiZPMUaFS2Ua5x-_F8Ro11uOX-A&oe=69BD5BE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
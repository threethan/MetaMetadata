1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmp_IhLrMSUQ7kNvwE5Hy2K&_nc_oc=AdrCV-_kaakmk6F-lCDcgU6dHqsbHIgS70FkrHa9r6fywGCqvN_83irhj4r8ihp1ZS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy3kH7a8JxCknHlbDIJw0VK-M_s6xvjMeKsRfgUaOLGA&oe=6AB3DC85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyaYW2v9r3cQ7kNvwEtK2Kf&_nc_oc=Adp3DSRnodXJ-spacDufMlj9hXHidD4og_J_9mEXMrq5-sIM0mmBGCCNxP4VvNNaICQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKysWmKgMxWG0oRp2MxdJIO0N8uDqjSqWHrvv5lQuoJuQ&oe=6AB3C513"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaN7Wj4vSEcQ7kNvwHB7PFQ&_nc_oc=AdqCNJ8uz8--lvPaUpMEWBx9pgAv-Hd9QAuJqSFtnqWQc5i_dUhdXnzZGoq89hdQPPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItMvEzgh3oePKZZzHjwOoYTM1_k9v6yQ2z_-QJ-hcDcQ&oe=6AB3CA86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hds-QFYWifQQ7kNvwHfn8K1&_nc_oc=Adogl0eGVfU_SL29glx8WVuQ9DBuqXlUpJLF3uvHVovih6p2eSjNpq57obSCj2vSWAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4cX38F9Zab-fXBKr-8cB3Lc8kOGbg_KKGbDY0JJxtEw&oe=6AB3D987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ9AxUqATXEQ7kNvwFnpghX&_nc_oc=AdpLWhORb0D2JEqYk8hlAE6opWOvwDfrOqR2cAdfL_x6-eitCVITvdRLk_XSkCRlxic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKwaUPGRMy96QlojOtboXRdNC1ecJOL3zz67nXUC6akg&oe=6AB3E467"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzfRGP0iqqcQ7kNvwHNcNCU&_nc_oc=AdrdVyWebAXyGyLOqvUodmIqD3G86VcJ5N84UVBnZrG4RQg-zwMwYyU4OEJRE2Teq8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk4kuD2uavdHZW6xgZ5KxDlQdCJqM8lNWZ2pxPkRgvXQ&oe=6A9EC485"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC1CJpjAQfYQ7kNvwFFBphO&_nc_oc=AdoZQpidtz7LTluSX-c5pwOGkJg8ldQUyugVohcKuJHPTcQGg8PJDLk--K2vUGJK99U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImDz4z8yYEHX5jYLhVy-zW8-ZNa4T4sB-jIMBv61QroQ&oe=6A9EAD13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPGwpZCW910Q7kNvwEMfAyP&_nc_oc=AdpUjyDog20CTDnciC3eS_cwDpiLr3xc_8gGzJr-Urf-PsB_bi7AdJ5iKzIbDBIr5Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCLAaI5P6jiVFLW6CEWyruhBwOETHYVlI0BWXYvTxTbg&oe=6A9EB286"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gp8sUuP5DgQ7kNvwHVAWK0&_nc_oc=Adp4Fh2KXFhKo21MU6NCj1wNuz2eqEmsZlu4snwhdZkMQ5AaE5jmYYheHFMkh24rTxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8xjgY-BJlnOX1bsYovNqoeIynSgNav8i0Mu8qOg9hKA&oe=6A9EC187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W24f2HuLTs0Q7kNvwFNkNR1&_nc_oc=Adp7knNw1SrcPyH3PKZdxpBCizAQAaK-3Ca_vptLHVPYY8E8zC4EeRcn3WErlLx4bng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXVBmMsGAnCgLUv-MWUEKJLU8cufEKAqljq-GYupbmiw&oe=6A9ECC67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
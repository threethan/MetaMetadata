1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR5xGTW1BpgQ7kNvwGkEVDY&_nc_oc=AdoV4kRCgiYaINKItt2_wb6PuFgURdaOOUcukA9uPkVGeGkc6KQrkzpGYa9wOL797JE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcMvPJ_eQMXKkulMYAfMUzessfusGG47GAsLKAK80vjw&oe=6A831505"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KtfRNkxnKYQ7kNvwFzXVFC&_nc_oc=AdrMdbzFIKA9UG9bq5O1lZgG-UKc93KVbCd_QzksB24cuGpcRDMu4TD6xnuPeRvwiJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeZG4JlJKCZaaLBQ3MavcjIu1RfNubkYimLY9WsJLRiQ&oe=6A82FD93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-o1tL-Ce6wQ7kNvwFiju40&_nc_oc=AdoSmHTnoKHVnotwdGHVZ80aC4txUsiJv-uRbcj8r08omr2zST2MAtF0pNhZLuz9-fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEv1GjcOZB34XP5NMFG3WZjCyT0tg5nN0PSar-HtR5mw&oe=6A830306"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4lkmgmFk9sQ7kNvwG51QQs&_nc_oc=Adr5IjtmlCg9qS6HOViL9MdwlE_BmUkROvgW-wZxJJbJfWbiUIZSnXGFIAj4715xf5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj5kVfvVYTH2mvMRYCqwgbHZmly5_rEnQ9Jt8Eyi5Y4Q&oe=6A831207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry6SuZjbkjEQ7kNvwFF6p5y&_nc_oc=AdpKnvD2bwreAQFlD15HAhP27tQ5oMpAs3FHKXZKNFKXSOA5ZKyn8jAiIIGohse_d04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy6DGxz6kC6Hu7tvA9fnBOxO1yr92-CeCHd6I9ibo0uQ&oe=6A82E4A7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
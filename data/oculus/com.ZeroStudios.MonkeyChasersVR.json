1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng9sy1UzDckQ7kNvwErEODd&_nc_oc=AdpYwxYAqlBNJC72AlSDtPBE-ebCLVJF5d5gdzFTpkzTbrn4QnTV1QCZEnAXMT2BokI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3HgqQYAbwmrTDtePfiFdUj5glnMlzUqo6v0r8cAA3-A&oe=6A5CD985"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QVpNKf-yEwQ7kNvwFlaf6O&_nc_oc=Adqt68wpDa4QvAZ67V1BgeUN1efupO5qNka6OImx2A3180FsNxQ4FK-ciJjLQHqLXa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4rE-Nxk5f6kX8IetTMCvk7f-vEgvvVMPhU3uyXKK2SA&oe=6A5CC213"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYCV5s_9BikQ7kNvwGLjm5o&_nc_oc=AdqY5RY25Jn2_X-vcHiytr0SBaDU2CYNr_qbUY-Srb7j56UlARAczYl9hJgtididw8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcT1CqomzHXBKVCsXjsDJm2wSTjj4b7WTOyEIF4Zpjrw&oe=6A5CC786"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdB31S7HhMkQ7kNvwGpzPJn&_nc_oc=AdrU48iNKrp5mZ6FS2XvnoDoQuQ9dVvG-6B8vGOn4XmM3W5hhs-8ROoUm1f9aZdKpwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMPJ9pUmGrRvi7Uex_c5sbMwe_yqxpB-fUvf_B9QobMA&oe=6A5CD687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1Aa7-rcMLAQ7kNvwE_Anq3&_nc_oc=AdqnBUJ70CESfkkYxR5WPoRk9HaTSotgrjwOAOBqHlui2_KrHwN_2GimhJ_N_egJtYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB4ry6rrnBoMa-uT4NlI3xfKKyFJr_M1yn4xYIa0heng&oe=6A5CE167"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
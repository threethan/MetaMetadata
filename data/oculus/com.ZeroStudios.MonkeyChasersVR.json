1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgtqKS6-QTIQ7kNvwFr_xb0&_nc_oc=Adrg4-eHjuKXnGGb5SlI6wSkMa-0KP-uKY1VaeZ8bo3Q8kmTfrypjEz_Ucboi2KCn3U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr1m7t68V5pJajnuNAvanTl6PHS2BVRHAJgNdhvoiiyg&oe=6A974C05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBx1gBTKSQQ7kNvwEV5iRI&_nc_oc=Adr7CsQIgjIhaVWS7EZtngmMdCtguK26BuYeLjKWRYVeAkgQo06PkQIPUQW3lLE-Hqo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF1KaqKYmLMkJoxW2KKZBm6wRR8gdYxLxnPqbw5fmK5A&oe=6A973493"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI5vWwAtMYUQ7kNvwFNhkD5&_nc_oc=AdpNOAL9crb-b1ui5Kqcx_lw5zObxiw-swl8V_JKzpgr-tgH-bt3-Try4p6TAMkDL0Y&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb2-Pwbj2N234pMW9f53nGiWhBdn2hvTJ6HN3yGoCJQg&oe=6A973A06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSQGpYV_EUYQ7kNvwFyF2oS&_nc_oc=Ado2cmiIjLOKoGP5oZBKMlY1ijtLDqs-1yR0boUs8biH7Yfh3IC1rmk0_fD1y46-nH8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw4sTAOGHGGyUy1MNFgDQUa5oRB04UiaS5X0JGoDcgjA&oe=6A974907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19Kprux4Jn8Q7kNvwEuUfmu&_nc_oc=Ado6AFLDzieDkjrLRES4XmBn3cC2joNOiTH13xToKRO0pj3Itz3T4ydtQwxuLSGRQ8c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNCJ46ZKVcWWJ7QpTamNlcaUIv5z5k_iuiD7TP5EvXwA&oe=6A971BA7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
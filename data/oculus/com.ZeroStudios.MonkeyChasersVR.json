1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39N-qLa9JIUQ7kNvwEckMq4&_nc_oc=Adp_nby-_QbxGQgQUd3Jf_qCJ34VEPFaNSZ8_u502xPgtSKfonLbkMu-_2fpAd9RuKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWRdIrEcsqc4gT3JdNnW9BbA3trMFLU3jNxzTOPZUx4A&oe=6A79DA85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnmrsxM7OtMQ7kNvwFjEbdV&_nc_oc=AdqY3vKmtr8ffWFTvgdMxUrlNWab_IrKPi_Oc_27eGnmnNy8GLObJh-5eBc3t82AaNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh8sfyXWsBiezE6cIL8rrIOwsScXmaubrpdc5STSBo6A&oe=6A79C313"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZUvQMnmyJwQ7kNvwG0U-LZ&_nc_oc=AdoXm-CnLa-V8XZ2dHANrxj45YPztoFsbNAtvzsFNguhnPbMu6F_WOfDichz5E8wpHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBwWFcOVYIkmn8zNtLzJ8B1BY-D3Kb0FiGCzgRPp7gIA&oe=6A79C886"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=511pfpn4_j4Q7kNvwFidnqm&_nc_oc=Adq1KANkMzup2OTQHD0is4AXO9y8hNXDGSPLqmh_vvttGj6fn4hH-0ET6GHDLuSWIso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPYmj9o-1B3iDqLgGDQTx4h_BVmN7wUQ8SizIUj4-JTA&oe=6A79D787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QtKIDk9UrYQ7kNvwGJg1AB&_nc_oc=AdqNIhDvAkfN2WRNHE6KwCbYKFXQ1nVr29bpkOmepxJnJXHzjbREkda77v9vIHxvSzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_Ix9FxbdLiWGBu590wLrQwEbUGmGaWTM1e-o78dIMKw&oe=6A79E267"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
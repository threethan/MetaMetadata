1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw-y3IQyymQQ7kNvwGYYu2k&_nc_oc=AdqgZFA_AiYir8pD8C0QMTIR2wTo8xSUc-ELufEnFwOnhIJ2fBzU-KsyC_k6YcqBA6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgCUXdTGp_aME4xufUDMtSKi4KM-rdd7G-18rMnKmA0w&oe=6A75E605"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InT6fBzWUwoQ7kNvwErgVOx&_nc_oc=Adp1NqB5sCpyaBdDutV0ho1D0uvhhQ29OFtrmrLYOQGvf1xDOnFmaNoC5Z2l8ROvOzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1xpzrq8ZJHPvXd2VVbfj9lwfOEOhuaqHcBwbeGf5BCA&oe=6A75CE93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWwJYA5L6fcQ7kNvwG2zUlp&_nc_oc=AdoJ7oPcOJb90O9H3zGz21_2IhAgEo7IpDWsky-VADznhZKmRjlj65C0XL8tvJ7AlYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE72KFTGLURqWqyQeeqi-HnUB7Y-6aFABoh2mBgsz9gdQ&oe=6A75D406"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLKYQyJ-0lMQ7kNvwEgn6ef&_nc_oc=AdoeS11WDmaIusVzf9z9eAfmMXx_HxACu30W6ldgubnqqnF60tnvM88a7oVsHphl-Qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIPJpn4MaHKtARsreOSYeqSLe_BVC-WDKX_jYIx0A5HQ&oe=6A75E307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z51Siemc6VkQ7kNvwGSnHTl&_nc_oc=Ado50hlyEXslM9jFTD0SDBtVVqt86U9T_gX6HGr7owGWlNZ3buOk3idh3kwD4wnD5v4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_eWhyyl0oSJNSYv93KnLkG_k4TalCM-TpfYGxYBBbMg&oe=6A75EDE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
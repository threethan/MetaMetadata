1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgdAm7DheqkQ7kNvwEh_Rlg&_nc_oc=Adq-7wN3vThaG8XJ0in1Mx2pUsk06R5BWFUKKMOGA_UJHMgOv_890_BQ-id-L8xT1VU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2OKTixzGmsGhezPrrnMvY2uGfgIRHUmNkN0PzY6zWvQ&oe=6A8C1745"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9EAbl8SFDQQ7kNvwE8FUYy&_nc_oc=Adq2cJYO-WzDhWntlqXT04sF6OdxgZeahePo8TwImGkji9vbMwt8LVUG5M20XkL7OPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl6ZiHWt1rSZPjYE83HPhyqt6OEYXTg2nRviNju6fuQQ&oe=6A8C3813"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ri5q6gHWkEQ7kNvwHtFkEJ&_nc_oc=Ado8cDDIYKR8aBd03OR7shcgoUS1RYMldQ3ySl8-pX9zg1mP4w4aUec13R9I2a7eOls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESQvk4v5lBDF-5qfHisim0in71h9OqWiLNYZ-zmtHeWQ&oe=6A8C3D86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYB0m7_9UoAQ7kNvwFvuT-K&_nc_oc=AdoTl2l2kIto4aamZI9WuHUmTUHiCrN2HDOYqyhd36UDJbeCT8I0h5Z5QIrHyVkuxcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnHu33WX8_7cWXASj86xgL35GZQdGamqpHYbY1waOziQ&oe=6A8C1447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_1WoGJW7NAQ7kNvwEbT-WL&_nc_oc=AdqgSsf6l6leARuDJ-guHsSFTxEe-gqdLTZH1V6xj5EXAzZxM1OAhznxL2XWtIiqTx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIm61RvETSs-qW76VymGU5Ap2AG6r9NH0ITsVfOg2tKQ&oe=6A8C1F27"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-Cy19AXaUgQ7kNvwEHZq6s&_nc_oc=Adol7IJPylrku7P_tvqby3TbqxfNX4wgXLuR1WUIXr_yVmUm5eb0nr1WORxsJ5jVZYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4zgvqitgtOU580Qhy1d3o_oTbnDP4ZUD4s_kSlmy3Uw&oe=6ACCE905"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLWUa9c2L7EQ7kNvwGwt6Ee&_nc_oc=AdosbShf0ze1VgFONiXArHRlMk1mDtmvvfAeEjoFwFKlnERwAh95B_Efz0Jj7wwj_nY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7l2KXGmfYH_FnzG0ELWI6Mbn0gJlBGzkt0kS-f2hwzw&oe=6ACD09D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWwiYNmE4RIQ7kNvwGzHC7B&_nc_oc=AdouUsqEmGmDfmIghttBoJiOH8ogCGEQ-ePXZHXrjxpSRNejid0c9_D_aZQ4Ws3kZqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTEhXK1VNA92D4r_SqMsXN_TRHg5obdY4Vh6kY3yGb-w&oe=6ACD0F46"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3vF0e8H1DEQ7kNvwGZ21fK&_nc_oc=AdqMpPDBUsnDj4jHJBHtlsYTHZH2uyrtPHRIwInWJwFCc8nHAVGm5Vi1uWZa1Yh2t2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAzOtV1Nt1D_GXmK-6NtpHr7K3aoCNefHRPl7oZcnDFQ&oe=6ACCE607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr5MeBeyveAQ7kNvwFTpWGY&_nc_oc=Adr27ve09PO4iZ6DESHHWIvQV7T2L1-BrzGXdyUCQ7PHth0MB5aeMZp9bJjejgcjc9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9hQp21lDCKMi_gxyG_ccBGcXp7qauxAcNckv3rKpISQ&oe=6ACCF0E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R627uDP_uXsQ7kNvwEKWnHk&_nc_oc=Adq9VJb0Bdrwbmv0I0TOOnydaZrIupvweUNxp-rMfhdIDnx-0Zi2BavIUJWOrD3s-pU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzjaDuqCEw8wgQT7b1FMhkGADscFYA9-5ybhHX1x5v_A&oe=6A539F05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPf1eJaa0BIQ7kNvwEVqW97&_nc_oc=Adoa_pljH5r-bS1C2M742bxHgdoZyb5iFdPy11FUez9mRniOWYteBo3iO050ipUEJoY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGalx6mg_bLj4cOiECKeSDEKBs2gRSGdUlgi59jYLNhQ&oe=6A538793"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlYN-apE_bkQ7kNvwG4xGYE&_nc_oc=AdpR39ZrsxYqSrM-l3px2jQzj14AcdWxLNxb0MsW9eo_rv1zmnHXdK6nzj1LxkTi8BQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1-cIF2VFsWcmnq_5UaqvEU1spw-OKsm4lJngzIW02lg&oe=6A538D06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XRnHeMz5fkQ7kNvwGiLVBZ&_nc_oc=Adp5IhFEsrmxHO6JBXE3Tznitn_M1iPdnq9R6EykaqFcmKxoTBUZBXApTF0ogqcq6Bg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd5QHWNQCyY0LZ5oRol1i3BIoxFfV64Hdo391tA52ytw&oe=6A539C07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsQzd0KsqmsQ7kNvwGjtl37&_nc_oc=AdoSLRhGH0i053J8S1cS2oslC8QVn3PsRdbRlh2DW7xY_MxU1-M6t4CID71lfpdqGSw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7qSpQQO4ixy5QdkCSBgFLzAd494wyHnfebkeH4U9WHg&oe=6A53A6E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
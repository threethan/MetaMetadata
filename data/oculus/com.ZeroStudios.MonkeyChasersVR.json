1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdiriKakdP0Q7kNvwFllvnD&_nc_oc=Ado7yWyplKkXAjMpe8oJ1KwmGFmTAKNyRndJGqMBuFzvZw_KB9fYf8v4kHHlw1Urnds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa21AO8uu8Pl69LglKrKR_STzIV7gFM-PU4PcRxpQtoQ&oe=6A9C2185"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZargJYuiOkQ7kNvwGeY_bZ&_nc_oc=AdpqQFpOfcLqNGGbYgTRik12mz6Ig0JIAgkMcJ8LskUK6AJiqISPix_1eaKn3BnKMcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC2ZNoAhfMPmJ_viEC3yM3UAo45hRiwXV2v4P140G71A&oe=6A9C4253"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWITR6R7ZGoQ7kNvwHIgpy0&_nc_oc=AdrP33JsywrggUbHJl3vUhAroZzsP4e8HE7JkigfA8Mns3_GP2jjXekBICVmJ56H77w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQKzjGCL5uU1oqEnTrtceqhOffGejGtscySp_F6Gv2CA&oe=6A9C0F86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRnbd5VK2GUQ7kNvwF4eJfC&_nc_oc=AdrChLAs-GDOFfo2g09JadCBpP1JfilPOqQSqnPQjTI3NPNjE1aQV_wGfJgP-PxkXRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoRJ8Loh2EO0Qz0Pd0HhP_1L3-Joct093VxjzLEi-ktg&oe=6A9C1E87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAkaXjMkYQ0Q7kNvwEnm1wg&_nc_oc=AdpMCj44i--f_8e8Q2gvhnl-PkbN93fx85qnYn2cOQVKZvbZi2IMIVq-eHx-M0C4j6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjK_TTa6GoRKsk2r4hTvXwwFCv8ClFTTx9bsDvwhxKbw&oe=6A9C2967"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
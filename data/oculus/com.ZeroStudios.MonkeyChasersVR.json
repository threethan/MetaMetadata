1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoAUWmYb2wAQ7kNvwFOL7pH&_nc_oc=AdqMDRd_X7CRZsXnv8j0potG32eSoNd5tKCE2Es-vR1nSMeEbxGDm46oMX6ZyKeUGnI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM3i8yygLDH03ASAAWc7aXT9NfSmXX1GXO9wIWZveqog&oe=6AD0DD85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icLnYVdX39kQ7kNvwGiXD33&_nc_oc=Adq2GwPnZQGrcxKunS5_j55Vr_ZVtKhTjzwjXk2Jb3e3LPjxoIhy8pwy6qnlKRTsiOY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOIsasHaqTLtGLa3uvZVKQAzu1VDq4E0CKg41PdZb1uA&oe=6AD0FE53"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqyoDIOwAKIQ7kNvwH3XvNJ&_nc_oc=Ado23FoP_r-woPM3ybNIWYECXRfYIt9dPu9cPj9-x2hLrF2N_jlUkroD8NjfbnHU5AI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVJOSnE_x4hZEdGs-rf4q4Mer-NBnFZz9mFduY8kF1Nw&oe=6AD103C6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HckH5TMrS8AQ7kNvwEuk1Fg&_nc_oc=Ado71xrdpqlLSzUhHSWVJy6Ea3NxR3-Npq-nylnxfoKm5iTB5kH_1dXRx76etcGuHxQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3oFX11nEcPtK2S2Jyppe_xBjtVlMA2lPXeu4ci4I6Sw&oe=6AD0DA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wj_k4G_pI4Q7kNvwEArCWU&_nc_oc=AdrQJRi48sw3bZanNs_UIsZjydhNde106G8OIy4uLYIh65l1nLsf291k-nOT5MRg-Qs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZZpbWWIMzQO5pR6QoNjudEe46Azc9xOW_mFNrI6NOhg&oe=6AD0E567"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
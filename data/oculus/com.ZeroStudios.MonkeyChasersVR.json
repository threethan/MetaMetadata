1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqmaS3Pozx4Q7kNvwF82lHH&_nc_oc=Adr36XoNGkza97_IIzqfMfT8kixGuzm1fKaJ9r8y7UpwehRKYD0h7dQqrP3th8vtD3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXpNWmgEBbnmpWVEY24MyRhVFvPLb4CXDXYzzWlb1_cQ&oe=6AEDDE85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFDkhbpZ9YgQ7kNvwHwpTe0&_nc_oc=Adq9JHm_-1VYotObzuYSzNQ6TqWN9y1rtxiD-neiq-3ktPVaKYPVWbY2m1Y0ka98x5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Lw-rZvqhBAA-vS7ZtjL_6Sq-HZM7Ha6VAeDCIsBM3g&oe=6AEDFF53"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VORJlwIl4VgQ7kNvwH0oQaW&_nc_oc=AdpWoajHOgItP6CE3BAgXhQCBeOMwkfm8M30auRfI6D4ELJJUp5R8P8KKNNTSo7fPxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLB7rG91ruFduki_mW1BVMLJ66LtyIVWue3ylujrnLPQ&oe=6AEE04C6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc89qARgSEQQ7kNvwH8QeUn&_nc_oc=Adr1AK1iG5qe0Fzk6JV3Di7dDNTPhjM9N46fXnfd6QA2q96C7aNUc8UxAvl8EPKVHnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWVyj1QezP8cQosVeyL0C99j20Tbdxf_CR2MrQRFPfuQ&oe=6AEDDB87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZbmeyGlBSAQ7kNvwHG1ql1&_nc_oc=AdowsWetc3MwZ2rbsIWTOSsM44wvQRfNNOQnjyd_L_sKBu-_jq5upUwJk9cezh0AyGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Xav7fROgmH5xxKtCrjE0x30srmbzXeBhCVhN4msF7g&oe=6AEDE667"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
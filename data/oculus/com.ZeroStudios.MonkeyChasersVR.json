1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1k2bFV6J0QQ7kNvwHXRJOF&_nc_oc=Ado7lJrS09AU1jw8LKjexn_0u8I-Ps9NcSVR1u1x7Vx0mjYVc4bFKvkS9DpzfiSWf8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbsCk5bNEArL5zoJLhrRfjPMmZNx9jc2INJ7emrqvZ-w&oe=6A92AEC5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSPJuhCECSoQ7kNvwEdCbJ1&_nc_oc=AdrPLG4f2KiZ1fIrM0b-rMM_BgNSyqHlrXqiO490Frh5Du9055iiVjio6jKJecmUy34&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtMEJDzrTeUUyZJonz-C8nEO_9DGYF2lf23FSjUkGD_g&oe=6A92CF93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrMTuUptu5MQ7kNvwGZA55r&_nc_oc=Ado_ZmXmaV6Z4oXW0yUMiQSGHK56O1gnqX7ymc0YNtA4xaa6hHTFTPKH1i29Ypdg-kE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmj4SFxMCoTgQ4Dar-NI1_DUUJnLRwNFeaG2rlwBf-VA&oe=6A92D506"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL862ZBN-QoQ7kNvwERf0qX&_nc_oc=AdrHZiE8rNroPtLAjGZOJWKPEix0jh02YQ6C3jIu9gsv0oSkOShCHbVbcepklK9sodQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWCe5j4wHPVJ7zrGxmWu9YRIvTOo9mcxZ34sakAwifYA&oe=6A92ABC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iQVQdzpvkAQ7kNvwECQhGu&_nc_oc=AdrUY6hbuZGf_XcErLv0UrrIaUwnSBAQ4wE4R486RQD225DS83ANwEJL9J_W-VdiIP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_O4WIb0sPx2Wm8M71Ka9uRny0Uj3KIGSDLX-Rq0Molg&oe=6A92B6A7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4k1x2uJXrYQ7kNvwEdAJXU&_nc_oc=AdoZZ-IVsPHIG9TOcISif9ra3tgRIh1BKbPdehqu5f0PaFN2IaOeSnr8UWJfBmGEuSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApMJbr_TGTDYe1IHACrj3jkdCEd1OACa8-FWD3NZAXeQ&oe=6A6DFD05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9QLn_mxZfEQ7kNvwFdSLyH&_nc_oc=Adqb_fUs1Ye9RLaFWavMyZK9wlZQdChU05U8seEM-lLsBFYUGlzztiziaI0epfvb1g8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXDURoM7Ig6N4j18JLy6wRW8X2gRNSx2lPttmfZQLtqg&oe=6A6DE593"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4OOhM3Ux7AQ7kNvwE4LiIC&_nc_oc=AdpUn2GMbsqytSX5Oh56EDziZsfSVgQpmKrEHodRS7Z28WW-Q9-oYYguYdu1NeW4j-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6MLdhzH0E2rHjGWfnpk7Yb3hGqxiNR1uGdBuzUiSCHw&oe=6A6DEB06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilNVZ6UxXTUQ7kNvwHNl94r&_nc_oc=Adq-WLWalLQLVt_AVxYo11Ac6dXPEOkai-wAQaUfzBF52MkQadYk_FhS6hWZKS8MfUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFLAtXbnkXnusE0OUoApMSsRYb9dAeLSpVXVZhkppH6Q&oe=6A6DFA07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVcRijm5mWwQ7kNvwF9EJxm&_nc_oc=AdrNUN-MBL3i_mgHW61q9LqVUsO_eqaWDPl4T9vvN3OmginLbQpa63uy6lxyz7ya4r0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlsOcCKoQ5IdyXb-TB_3RmdtyAJ6zZ37pB6KlRxhyjFg&oe=6A6E04E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
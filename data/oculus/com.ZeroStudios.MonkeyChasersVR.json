O9PsVwO1oHpPgNEBuQOxUEd17Y-yoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3T1xJEK12nlcV3Iyxy7P4EKOIIto9Cs_nM2HnJ_TC0Q&oe=69B02505"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ny0te8VeY4Q7kNvwGJ6SBk&_nc_oc=AdleGRfrnVy8GAdEZtiplWg4nu8ESc-fy49eTn9289dvWUzjqvCPc-fUd6bJ5oC6RFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYxKkjfU8vSWVn6By7i8jWlMeC6mJCpb7o7FmgbZKO-A&oe=69B00D93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci5jPyHTgUMQ7kNvwGehKiv&_nc_oc=AdnXX2W9AUbPoL_1TsNmQx_LJzQtC-0WUCBEVjYKffOtKnbph-WkkOY2UGHeMY6svUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvV6MOAl8s3GTl0nexSyky5c7Y1rzYpr0oCJf5ouRD8g&oe=69B01306"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvsb39OO4iMQ7kNvwEzDrVE&_nc_oc=Adl93_pl7aypndtmmU01-UCnDmjtIX1EDqbp-zXv4Oo2Qv5VkvJDFB65WkjCNNcxOtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSAPtrvJPi5EWxlnHDEK754KcjHItiNtmQlcCTa5FPrg&oe=69B02207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnncIsfARrgQ7kNvwEbPzGu&_nc_oc=AdmFQi3n5R02Qj2Y6Nh0Uva3cj1e4f5Yx0gdya_IY-L6VNq95oDnWYzDNozow2er3Fc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHw8KrWjMxwz-aegyifWw8EVu1sh0K-PEMPcoGfl0Tcw&oe=69AFF4A7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
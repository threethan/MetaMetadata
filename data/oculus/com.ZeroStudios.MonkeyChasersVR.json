1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoAUWmYb2wAQ7kNvwFmcDhf&_nc_oc=AdrsNRzNuwqkrsbkkBU6hiOUqktKX4KzhuNm4vAOj9mV7r-tCu4A0L7nB--O3sNV08M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu7VFgyUqpCcSB8iyRzX_lOviXYqD9ngK9bUcBcQr19g&oe=6AD3B8C5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icLnYVdX39kQ7kNvwEFOcGh&_nc_oc=Adr1fGA9ZeVYbN4TbWJfevqLlnq2mmPWn_AjIp_r6xbhXwAmdu2kXpk9zf3h2bauxAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOraCnIlNRsYwhBKI_FQvwjcQ8DSG9VTC1GO-aIcDlD-Q&oe=6AD3A153"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIv3CO1QOVQQ7kNvwGkak_m&_nc_oc=Adpy3afUKKHeLIrzu9eripXMZGY7Hf0lleXmfQfUQ4oG0gq3K5mixbtMOIgyMfhNnCc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRwcu2AG7EFUq_H9FjEHnmAdpWJpTewF9azKixI8RSNw&oe=6AD3A6C6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HckH5TMrS8AQ7kNvwFuLrxQ&_nc_oc=AdrbTRD2HjbmAqXqcT_JyTyWgOL4bzuLSe7Z_Y6A255wMlvxAxuMcCCBQPu55Oe6ev0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL9UOG58pBlvmOnNLE93W9k5diQ2DibLnSLgNIgQ6EcQ&oe=6AD3B5C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4O5v1QpcC6QQ7kNvwFN_LJR&_nc_oc=AdqQ4Uh7Z6Z_daiPgOM3ZLg7W9zNYBufwH1sfd7CYkt0YGFHDFHxLzSeP1Ypg0GZCGM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHFIV9rEHdRhjlztOfdJzLTv5KRbo_XzJ549IrO9Mrqw&oe=6AD38867"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgJ7EAHh5hEQ7kNvwHmzg8R&_nc_oc=AdpeabARwHaxSf_6aznNindsXzFRHke0FdmY6ATc1aZnTxekYuEpt7nz9pQPvK6H6-g&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs4ryZwVqotOTCGRM2nt51z1DtlpxsrNIzUZRJKtRJFA&oe=6A915D45"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSPJuhCECSoQ7kNvwGp6qOL&_nc_oc=AdrggWwg-FxBaRqhW8jNx1hHg54Sm6AaJshGkx5zfUZbNz22jPuuHZlE00cCPOHr7b8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtMUuOIhSjN9w_wxDmOYR7zzSxjLHTosWHoSD-7rYlKw&oe=6A917E13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBg_SAia1uEQ7kNvwHnmiuJ&_nc_oc=AdpGTG0O1-2ud1RwuBm4LolVKFHMrSgzX-z7b7J7CBS_6lU8OlJdE61BuZlgxtAdcG0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXdaVPTJyYcKk_ywin4HowrSaB-H3FPliETJqnzxqwng&oe=6A918386"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL862ZBN-QoQ7kNvwFfGECB&_nc_oc=AdqQL3ve7v4qrX86FMaYF-DpFpPF2ZchIRAmG5pzJaQBcjfI5g46b5RHo-pk8zBFyko&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtLIojpX8x6PB_Jwn23r4HaSS9i9DukMwScGC-XS5NBg&oe=6A915A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iQVQdzpvkAQ7kNvwHdD2ks&_nc_oc=AdrloAoj8eDeMZQmNT1wDT2MSobRNg-591UWytOpgFru7-C8z4EZvJFheSwVC7BZxw8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3VUfgdJhmR96jFozCB45fmdfWFMLCFQAae-IDf3LLCg&oe=6A916527"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
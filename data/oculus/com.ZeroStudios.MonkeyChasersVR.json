.com&oh=00_Afvtw5Xa-guNxbXoTfevcAbjSmG0LSggx60lV_8RNk2sdw&oe=699DB005"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2ZGnRhFnJAQ7kNvwG6_i9P&_nc_oc=AdmePyoL3WAnfO_BaucvKS1XkZ-mbgzBB4_WvF0gU3OJjJMBmxea1MwQqO3eyRadulc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXWhQBmYZj5u5VUiDgLlQZ2NXe79zzqwFYKxNtbVJWlA&oe=699D9893"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncQAgIkfKaMQ7kNvwH6o4h2&_nc_oc=AdlUSnN1FnbmWZJ9dWH4OP7dQohOWuzCebNzm7SQLwMLQt_U3sm0tn4gvND6WNGcAKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEAK0qsvdWewVGc2cH6muBexAWtsR-_Hb8ImZDPmV4Dw&oe=699D9E06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-mzpl7tj48Q7kNvwHr1Ze3&_nc_oc=AdkUKCh4J4a2ZkXlnMz3VDeXThCpEUtWg1WQ-jNEFE3cbccCsItbfw6o8V9mOIIQ_Yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSTTK1hOM4UZVCKnsBirPvGpt3TKM0nMUg9Qss6vibZQ&oe=699DAD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e4StbtOWpAQ7kNvwHFcP5m&_nc_oc=AdkeTg5GvC5rwBNvnVgj8s9Z6SYqptNXoHpudGGD1-hVTCyzXXiDfXO5dcWmdRRie3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsAAMKAAA5VibhG6fbhH9xAIh1QvahB-8ViLTbezstZIg&oe=699D7FA7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1707473176360113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gxz5Q-Oj8EQ7kNvwHKCOIT&_nc_oc=AdpXbScDJ4CebCSWh-M5Sn6r5xRTkBfXJOzzNz2pxemNSDCTsolFIYrrEp6h-gYGMhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaI3izBC68xVFtwuXEgP-ArBwKFkStgqWaUcAmwePV4w&oe=6AB52E05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THjJqc0pSOMQ7kNvwEqJ1TB&_nc_oc=Adr9i7f4kFYYdDXRkG_5k35NeqLSisEiP9gjrTpFSWHtX9ki-5LePgzzEzkLCL3t5ho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX3CpSbe6kPLmVdRl3L5-bf02HAZ94WOktFq5r4qBi2w&oe=6AB51693"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaN7Wj4vSEcQ7kNvwFxE1ss&_nc_oc=Adoa-A_wpwdPATLao05JmMLyOTYfdpOlAyAACvRT4dcx8n2BgClDlzr3Y1tLmZUdh6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2e9kj8G2WesIhJAhxuRcvrtgmRL4HQQqkcIrcYEmVEg&oe=6AB51C06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaBKETT-J78Q7kNvwEtrqlu&_nc_oc=AdqeEEIKE2h2ewvCx4Tee88hfBJJniITPQdN0jv_cp_h4ZkzCvjSVgIYDG9Mk7QfSb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL0KCWE1o1z_I9IKjmRMaVg3OwA5gZKCOs7QFu6ISOkw&oe=6AB52B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ9AxUqATXEQ7kNvwHVUk-e&_nc_oc=AdrWgGhnDGjBxYYDWP2dmENAgZCBob2kK4kf5g6IonL-mORwzaBcmHQZlzHHpXrJglk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjmNaCH20apfwTZgV8ddPPKRYpbCLV4M0r4d1W5iWpsA&oe=6AB535E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
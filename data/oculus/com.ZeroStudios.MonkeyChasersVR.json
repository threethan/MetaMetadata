1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgdAm7DheqkQ7kNvwEDpiXd&_nc_oc=AdqcoXOLy1U26QH-aAm9VT_g9lauZlDmYSRaxkIR2Ep2XbB2XaA2PLlnlTjLtdKNCJE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCrw0aNUWfMo6yqVmrVm4coFlUOyTulI9OB5U0xQxaog&oe=6A8AC5C5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9EAbl8SFDQQ7kNvwE-ctm5&_nc_oc=AdpLSI4kUDsZFUIP-LNtGlzym7KNV4Ihp49JAWU0EPxqn3LAVUOBw-LivUGkfwiOQ6w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlXj0aVnZ6wJpEU5iDKr1Bf8H17JpklJFsfS9owyUD0g&oe=6A8AE693"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ri5q6gHWkEQ7kNvwHRpdUB&_nc_oc=AdrHV59g2TojxGwap0ov_tCQhxuzmop9vcR0U3v52I3wdEOvZ9Cz292sydqbze9EIlY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDmNhTF2sv9DK1Xe416Kdz2_7mk3dl2ULy0gLeYvWvLQ&oe=6A8AEC06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYB0m7_9UoAQ7kNvwEdQy5K&_nc_oc=AdqFWRrJflGrMmrQ56bQNGVqP-LEUv1xBUf2pCFxz_ffkTwIcyvnjWkpdQq6DvPYsdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl8scUOwLfjeojW-lC6qA76Kx34gm8jdKZr1ej3FMrxw&oe=6A8AC2C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZV7LuPfsZcQ7kNvwGjjn_3&_nc_oc=Adr0jKL6c2JkWaBoPGQRqJcJ-_GQeb1rxUn7UgJb4d4BwOqAGsOasyS3-dKuAaL7SF8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW6gWyTEfkoiRQyoWkqhTXdaIt8tccDqZCkRNKhLgLrw&oe=6A8ACDA7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
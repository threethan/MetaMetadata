5/39031643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMV4lwvS2LMQ7kNvwEA0mgG&_nc_oc=Adq6VVGo7TSxFEsF1pYKzztV7j0yarzmhR5JicmT8k4kiajzUnuwjc3Q0gA55NDe1m4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWH1xPK4SLuPuq0Dx3H1UcBPyBqOzOsKAbeuKaslqCIQ&oe=6AA95085"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArzzsgTeR_wQ7kNvwEsSowf&_nc_oc=Adp4kbjvBFzlATw2jeOM8x_0Jqasz6bIJTqe-gfvCsrPN10YDrGeFYDH0blu2QqOZ5s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSZI8BEx6ShD7JYpr174aFfOYvYnzjSPf4rA1MBY6rhw&oe=6AA93913"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqIly_FMRbEQ7kNvwGsJ2P2&_nc_oc=Ado5j-VVPGe2m0wrdp8zntnn9II7GpqqhsOxUsAnbDSLoOIYTPwT_SyjTAnzDylZLJw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEabuPA-O12Yl_gCId05BG7pjq223DcB66-9FtKYrovQ&oe=6AA93E86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVkCT6gPw0cQ7kNvwHgK5Pj&_nc_oc=AdoI6DJYp6Vkv6nHEBIqCwcYVl439c8cyK9jjQFypZAmvP-DsUAVu7-CFfFF-Fgl_yk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEolrczKQsJZ-XxHuo7Zhyys8TQqdbi2XKSfV_zD1ekA&oe=6AA94D87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3G6twqvWzwQ7kNvwH_Gfan&_nc_oc=AdqPD7q8_BQ3_zgXibKdjEEdCFMX7UqRzVlZmAGWes3VMYBhgPK7rQsG2NMtr0dP8ng&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf0TOhDhxxI7rrroHV8xQZvdijgt2AGVmgIkoeSdpezQ&oe=6AA95867"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
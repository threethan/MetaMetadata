1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYFoXRkZXO8Q7kNvwGWjYu-&_nc_oc=Adqy0z5db4wt5i9T6jejpZFRFzWo6BSc99H6OO7KBqrT6uk1u9eF5YfSuo8kKEQ-yD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQFnWEfCDy28ACqW133KdgZF94iMy6Nt7IPL_YanFxWQ&oe=6ABD1705"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oYFIYcMC1YQ7kNvwGqctJJ&_nc_oc=Ado3P5qVkpxBvT5wdMenPmUvBKoVh3B2JBckLfowuhLtvT9QoJISFHcXpYX5cQDG954&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaghpLv0W94uVyefzGWOMsmTeCjpJuVHKqNnGEfWfKJg&oe=6ABD37D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMQYcsnwUM8Q7kNvwG48V3W&_nc_oc=AdpvdHXnQ_LOEkyeMmcYjDYKUu_kU9I3MEwdgUTtVtXaCe168YgSipmxRAo_joirruM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSd1ECvYJE8Y1b8JXN2cuc25H6OXsOHGOsWl955NXiMA&oe=6ABD0506"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=286Rxx_jDyYQ7kNvwFfEA8q&_nc_oc=AdqkilFUrH7qkO58XBVAcP78iP5K7XU6AwaQ_dEudfTnDa5RYqIWjRbR-LzGiIztLKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL46cLFvOJLxc2h0aGUfzOR6vYDc4gWFF8_sThuuC8nQ&oe=6ABD1407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VYIAbEMxPAQ7kNvwHNM9xG&_nc_oc=AdpklMI_z9NdNSCQbR3VTsgi4IDEE7sLrnvW8zmGlgfWX67z5TCfTRxUvz-NyYHQQ7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGPeeGtUPUGte3nGXtX_qWd-VHJz4h3oaQ6e4zTbgW3g&oe=6ABD1EE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
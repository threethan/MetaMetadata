1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An9Gy9bnwKEQ7kNvwHkmh3D&_nc_oc=Adrm9lvczBvprm0oa8870pRpRsg7KRTnjwBRpTmO4injLPoGaGgxce3lkPXixDqfawE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGit6GA3joFnUX9SUko8aIU7-N3K89r7OQy0bVbK5UXg&oe=6AC10B85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-PkUYk0evkQ7kNvwFM-z7m&_nc_oc=AdronCCdopw5XYqHwDA0lclEB6urUA8hbPFPHXi8cv7JrxejzCk9dyVQTTqn3__GkrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdmssv7uxoXJ74Hcu43pPghxVQnDgjXW1uZIxQzLF90Q&oe=6AC12C53"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqQHo9tC5AkQ7kNvwF22_rX&_nc_oc=AdrrMcjRnxZFrNG00g-fBKEsvBZ_EJODP8bi67bra-jXSsNi-VV409f8E7QCdN2oCsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd1CVPIMeyXsN4poL1P3pS3d9RJeEJDVGab0UIJ1u0oQ&oe=6AC131C6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odNf1UmzH3IQ7kNvwHEvXqs&_nc_oc=Adqr0Rhv__4uYUmoRleTaqMG5WNoN56gafk1Q9yUnf6SID_4tObNP-hfbl3Cqdd0PvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX139MgjX-V6wd2sYcU9KlQKrRFcPWiI7aljDj-H6oqg&oe=6AC10887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTQxI3XtUHAQ7kNvwEDEJl-&_nc_oc=AdogPsEfanHAmwzZM0dHnoY6I4ynAYvANIgn3OvWjJSFIHv10lePZTWgRc2oQ2oewcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_xoxkrdXbCLEPIhLJQ2jui_YR9S4GFmv-Cxe1pNrKPw&oe=6AC11367"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
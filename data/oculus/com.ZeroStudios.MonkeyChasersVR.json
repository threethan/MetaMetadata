.com&oh=00_Aft5T4WHKYUeynQyQW7roKBCD-sHtAznqb4wlHEUi7_eKw&oe=69A44785"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2hTzcoTVT8Q7kNvwHyjIy2&_nc_oc=AdlEklNbupwZKML22OkXpQu3td6spbTp-tqjSz4Ygg8-2kGlFPleRDH40NrAencBReo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftKOsRY2LJDQaWaccJOIs23OjQCA3HQg64uXUPyWXpaUA&oe=69A43013"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDcLevB1YHQQ7kNvwEGWo4a&_nc_oc=AdnLV-XS_5XEP7Z0Ze_CwiWC3oxJ_iIMLI-NyYDKbJSbq-VqTCgL7UPhvgQYoLnzDiw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsR04ytBqdEbP6kOttefwL_nRD9LgRjVmmP2agRUghMAA&oe=69A43586"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UM-wYsAeVbEQ7kNvwE32pBL&_nc_oc=AdmcfbaFQenFtO5UQfZuWkmged3nF2vTdta8NwY66EddvEU49_VGFxDe7wYEWMwwiGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft9b-KfNN1SGBanq3ZyR3k1FaDBp2L8TCMIQ5dlVRtRxg&oe=69A44487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsLpe0LZIS4Q7kNvwGrwiHa&_nc_oc=AdmUh1R3kTvOPT2LI5daY3b4diCtpvoDZHJ_s83T7Au7DOipYmj6i60Dkg9f7OWh0lA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afva69XJQQhmKXS-qoLMnt261LMv_oFKjZSlPt-9BSX5PQ&oe=69A44F67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1707473176360113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
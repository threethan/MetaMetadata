1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXS8wR9CpDMQ7kNvwHmTelh&_nc_oc=Adpp03zt9J5bk9fc0GPbxz6laytOmuYhIJaR8BCsB0SVHV8iVDPp7rYu0rGEMKhafTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVS1f-k6J45Ven1vJ1o0ISrF2McbS46O_IYg2MT6Dy0Q&oe=6ACB9785"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tARhk9TqVKQQ7kNvwEUn88n&_nc_oc=AdpoP2OTO-eCuSmrUqgA-UjQLjIRikLNHzCdHxOsG-hf6EFogpvS6YKLhICgc3Mpc50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPixoLgIjGpkYSgykGcMuyEYJ4sLpnx7ySUMwgRDPhRIg&oe=6ACBB853"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWwiYNmE4RIQ7kNvwEQrSYA&_nc_oc=Adp_n4ZBsfbfHhkv5urShWbmGHrHpaum7ACTN7OY0ZOvJbFRaP8Qs_Kn8xsyQat-mo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBdZWF_fDjfLQDK_U9pbKCvxEc0mFZX12mSXHo2xJySw&oe=6ACBBDC6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i40NQdwTmIgQ7kNvwFJakxr&_nc_oc=AdqI1xjn8pUb5HTxoJlOLjslMXWA23Vo7xI-oLtPEmWy5I3zHPvao-xBLHOWkQmhWS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVBcOBrdyEtNeSkppP3bNfYrSCBCXgaaXduy1N1FDF4g&oe=6ACB9487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr5MeBeyveAQ7kNvwE8LfcZ&_nc_oc=Adom0xRp7wFgtQYU_rAQcrjRWyseWIKx5ZKGGQp9bf5HMsBoNnsB8C6waGN2-JwItLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdduCazmXQdvC7Q5Q23JS2WBT8AADlT2OR17_mnscnIQ&oe=6ACB9F67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
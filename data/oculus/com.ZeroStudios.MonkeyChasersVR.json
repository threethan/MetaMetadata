1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udqGNMqAZGcQ7kNvwGo0G2v&_nc_oc=AdpuVEND1j_ZSNtrq4VtxIRCQ6qHrW7-ON8bVJt7xeR5S66qoduaWf2jpHvWK68AtCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvnBuPwKml1ymwL1PdJJPmhiPPxwI8Ktb0cd7c4gcatw&oe=6ADE0C85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bBzCRnmCtYQ7kNvwG3SlKU&_nc_oc=AdorsrFFqC-1hClNl0BA6iRM6ZyDjLj8VOWRDMBKhzQ2LHXcdeOTQUauWvSZumm2X-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTy14tlGFmfnvxMO_KajFmF-hxyRv0P8t0_YCymCoBJA&oe=6ADDF513"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdRhHYhHAoYQ7kNvwE1LWMz&_nc_oc=AdqT_dVojlPviShPv2JeiM_loxqGLRIzUrs9WsxFr1PpLM4XV0dckaoUnE3NVStcybU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGtOfjR6LJHh1EkL2gFn0UEqZZjJdJTxecRIgP2W2v8w&oe=6ADDFA86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS1xHm8B07oQ7kNvwHRgjse&_nc_oc=AdowIMnrEOnMq3F3bZHz4eVYE7vFGF4O3h8Q5Wq_7g1jXvaYBh_ZvI29SOz0GMq-7Fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN23Ev2pnQkriyUhtG6gY8Yn8SPQzBui1dYVlHYj3X3MQ&oe=6ADE0987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84xsSBLrfdwQ7kNvwFtbPWN&_nc_oc=Adrfy-r9SP7gO0FoqbHCIiH0c60x1CeVFNbSOmBpDEj7digulw84-GCCPLexpiKLc0g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAXz_E4jLS9cJzTfCxc5cn0fUztxcZSKv1t9ugDtpeVA&oe=6ADE1467"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
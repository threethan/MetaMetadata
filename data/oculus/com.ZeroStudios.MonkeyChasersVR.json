1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0bRr565NikQ7kNvwGplyPT&_nc_oc=AdpWikXJ-Sut5UC4O_y9TuTf9X4mXOE8BVhyTIPftS0rijWmUeItCRsq1eu7Zjv9ORg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5k3J1rQy-_P0RAilbcxdTiClP0l6eqeKV4P74kM5dLQ&oe=6AA7FF05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3Ysv7S8O-8Q7kNvwEjYxwG&_nc_oc=AdqgXdtqruD_J1WXLQTlY6H3l_ozVDDyv9JczE5GYZeqBX6sQex1RdhSOY5KC0P4RQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIjjj1WPwyUP3_J0SzjGFkZ2aDB9HlST3Y5eymkzPFJg&oe=6AA7E793"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqIly_FMRbEQ7kNvwHZOYiz&_nc_oc=AdqsiS7zbKufm2eGwa7WTv__4BX2N62fR2e_o-n4Do7mVtbfxzQ9Cjb4PPxxjMR8kKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8IIP2U6fiCdg2qlMCnYL_n6NHnreHGfHIBFChTOSTJA&oe=6AA7ED06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGQKbHKudowQ7kNvwE4d0RZ&_nc_oc=Adp0IMv7zKhkzQec9ALLXHC8D1xHFgmHQO4vEJk220NkcQ3G2JSpSzvhrBxoGnOtmHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpu1qLmP3zZvdBfQLs3qv709FXAE7JvGVCaTQuAv-BwQ&oe=6AA7FC07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3G6twqvWzwQ7kNvwFAYZtf&_nc_oc=AdptBYx6NoesdZvUuy1jUhkbeuCBMk4NYfkYWW16BtHFl5cRmv9XtTR8cVFZlIfF2IE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJo3u8Dx3LBg8hqpt5kHl4o4ZOc2SN6Fvtx4GX2Mv9QQ&oe=6AA806E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
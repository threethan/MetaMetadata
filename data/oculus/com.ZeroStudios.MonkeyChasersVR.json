1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R627uDP_uXsQ7kNvwFZIBn5&_nc_oc=AdoiWPI0x7B3uwzc3IbRbAL0JVJQz0RtfRs1wBRz0tNkTqX9Bb5AzPp9Furv1S0yCQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFBA8LjJB2a9uRSUPeqEURJlCod1SfIUrF-jJMUZZ82w&oe=6A54F085"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPf1eJaa0BIQ7kNvwHMwI9q&_nc_oc=AdoDHRC1qt_sN9bB5tMHc4hlZq76hntsLwTCftX0iFrRtmiPs5fyTLkXj-bO3Yy2MO4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJTfUZG2EZ0e2nzKLUiY7p2n6bpwNpwQi6uLeZkDFdJA&oe=6A54D913"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlYN-apE_bkQ7kNvwGqOle2&_nc_oc=Adp93y3b3uwItseBxK_OMVcjJjEcOv0QIzdGhpsxLUMv85AJJWE_ejsZ8xtY6jMQwCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFoPFAF2DPatEMididtqVDgsdJGjJkcb3qQcITxglaKA&oe=6A54DE86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XRnHeMz5fkQ7kNvwGH0wXx&_nc_oc=AdqKOZ0oNF6oyVdg2IhHbtjkn1ZhBpLv1UkskThHSW2GO4fMLKW5w0U8b6wPTs6r9oU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGgrcyJIK_mwZ35oKcT2hA3AWA4ZdOAG-0bcY--ahb0Q&oe=6A54ED87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsQzd0KsqmsQ7kNvwE9OhxZ&_nc_oc=AdqDoxwOoO7cbYtBSw5ELEOdQQ-0_Ij7GGMFq9Om6RDgwrDsfq5M3rEoVTfl3Rtdrfk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6x2Q9i95yct80i3N0f_8CUaRaRI5eIIAcRTbE2lX7sw&oe=6A54F867"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
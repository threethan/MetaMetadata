1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXS8wR9CpDMQ7kNvwHTCSDc&_nc_oc=AdoAFYVHpj05HTC0SuSznJA64YjMLsdmAOJZan_31AZPL9c3oCtYZJOSWakExgVBW_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp4xjry77uAgyaHf3hILxo2AY4sSn4_enPCZ8oxUra0A&oe=6ACA4605"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tARhk9TqVKQQ7kNvwH4bZ1l&_nc_oc=AdpqJWMFcQ_K_FVFpZ4_DPeipr8lyjiHoRSBEBfn2wmSCaGTb_bfhkS5fwia_M0GgRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjLR1VzSUxphW3FJ1UsLmmw67NAm0P9nm_FtbIkLpk6A&oe=6ACA66D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWwiYNmE4RIQ7kNvwFf61nu&_nc_oc=Adp5sElL_3oukIBsMsH2S1HE_qeW0qLB5WUtM5YJIcmrM3uNPfkaLOQaZV3ofKHHVsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcTE0WZCboPtFtlGkLr4zsUpmXPGEwopSwv7p9DaDDMQ&oe=6ACA6C46"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i40NQdwTmIgQ7kNvwEqg0Eh&_nc_oc=AdpxI9PDWOamJqf0E2-cgV5b33iLTQXECSSZxF61Q7C1OI8ikflpKvPFtbcEIR9ft8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODZ0alifO10A6KJjPDAYDmFeUydt5ccwEBkgAY7-52_Q&oe=6ACA4307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr5MeBeyveAQ7kNvwHV1z2I&_nc_oc=AdqEerlYMqztqrZ7W-mcuYxzj1GjpETJNC9U7wq1oMiDRCDOH-LdZqGTn17E4V1pgQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUW86UZ3OfaVdWMji1FZny9OOKSKJ7MWwDVvalb-Qy9Q&oe=6ACA4DE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwAVO_MzFyMQ7kNvwF5nQwm&_nc_oc=AdpSujrkz6YSLj8eq7zTtlcu3JRk8rQMrDra4mlfIH7PeM9I1Xjz4072sxeDh9ESAkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm3nZQiRXLhlC-FetObRbWAMEJsZTUabF_B51IQJvmDg&oe=6AE0AF85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBcZftYvFEUQ7kNvwFzlmd-&_nc_oc=Adr2vY3-hoXEQqo61u-fuonLYmFUdwU-D4ifgCd5QAcrEeLxafzyy12hiaIDVZ9U6cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6XLT-ojYoP7rPqWaiIpZc3TzrqtxmZXvNpYPuMUq9-A&oe=6AE09813"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdRhHYhHAoYQ7kNvwHuzF1g&_nc_oc=AdrXY2JkMnAgJFfACznloBPRzY-YXV1rRV-bwVEC_J7-27l49tGnMuZ6RbxgtW3y5rw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5MR42DgLRteE6HEKxD1_zotxBAfhMnoAvbvaSae-qng&oe=6AE09D86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5PZdNv5p-sQ7kNvwHfYu9_&_nc_oc=AdoP_qulJao68S-5o9J7z80t09RWJwzjYvIhGTGZv6rJ-CFDyokIQRwqUgey8QGr6RM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr1OJ5ZTwpsYT6Wvj5JW_kGo58GZXTho6OdnW90HBuoQ&oe=6AE0AC87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84xsSBLrfdwQ7kNvwGsND9q&_nc_oc=Adrk14-NCYKXKT0_-xFIw77gZyIp2WK9Yqc3VvfkpNnoIUCAOml2e_eZOAuxaWG0p9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqmYJJkX6UR6RIw9oNi7zTQgOlj0j-7Km3GuCbZTNMZg&oe=6AE0B767"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
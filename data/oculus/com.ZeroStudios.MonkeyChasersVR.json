1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir499kz1T7YQ7kNvwFd7hep&_nc_oc=AdpQ8NqtBObKo4SbN0Iy5v9aRONOh-q0sO38xIb5nf2-0pLQdJySroP-Uowg61oIjfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeSTZfIqq6j4AFG3_ZqbLAU9jiBdgS9G35ZmjqyjaEmQ&oe=6AE4A405"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9b5GJDKrqwQ7kNvwEwiuNh&_nc_oc=Adqp-ZiZmqtTppAgzXqhrl0PXiAhKCKMOruCnFoLhAGxif0SqAZLJKFQg_F3KG0fmM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl_kNn7GqJlH58Eltf5IyFpEcg22trQ4mcVjCE1srXOQ&oe=6AE48C93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gplo-bJV4IMQ7kNvwHt_R2_&_nc_oc=Adq111SLsZY5kgQY2HGURj0TNHq-KiWjUKy_eWD081l-8JUnYFyJWVE9d7MH9JnrVJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtmxY7siFcEl4r-WwvT8GhvewThFZ0Sb6zqaNphPI3yA&oe=6AE49206"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HOIpNkdJHEQ7kNvwFZQ5Gj&_nc_oc=Adp1MZwhq0wdJa861GApCGPRUQLu9VXHFJimcUOikR-sWZuT_Z481dm4a6MlUd5b980&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjaqKRGs0jL9wrdPaz-QQZBorrG52Gar_iVb1rSrOtlA&oe=6AE4A107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKO0aTm_VrQQ7kNvwE2tmSn&_nc_oc=Adoyr6OV5Fu42RQRmRA-vaMu2W5b7LUvMIOxAJkwk6QuNj2t88Cupxoxws8yNFkh4ds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhgHwc9_IlsHofTtOZT4yxj5O70LOOWHhKD6OS965rWA&oe=6AE4ABE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
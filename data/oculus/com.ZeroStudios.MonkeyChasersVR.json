1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzfRGP0iqqcQ7kNvwEAfizM&_nc_oc=AdpQdXSCT4LZvXsirKffKov7N2CxBAG814hiHq5gs3OyB9o8J6mO_4gz78Rmx8f09Bs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp4cIJ1pY8Ty0BofX31ev24ubg3E-b7e9Rl1OLVB2Odg&oe=6A9D7305"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC1CJpjAQfYQ7kNvwGdISXS&_nc_oc=Adr7tFCmc6KtPKWmQVNUkcomXYlkg91pkyzi5fWJa2m1QNdy0mb4IcqTVdpVFg2onfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaJKqQl4E8-Cv3POO2vdEGic9w4BA66Ele1xYyQVODnw&oe=6A9D5B93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWITR6R7ZGoQ7kNvwEqR2Ny&_nc_oc=AdpzCfQyQ7ogRRow62u81tr7c4Vg8Z9saqfzu4GlwpvgqN_320WQW22KC25n4M-LaSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Ix86cIODBzPbCa8O8vCy91XJEwAm8MwddXlqJRPyng&oe=6A9D6106"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gp8sUuP5DgQ7kNvwH7U_Ja&_nc_oc=Adq_VeXElIKxVxFCwmzPY2AC869uJmJ3uEYyii81W2D5SDF4iIZtNNi-3pDTuNoXLhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPanpWpzqJIi3H_NWRlKMs-0v_XOcPUfb_gTOhFXpHTw&oe=6A9D7007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAkaXjMkYQ0Q7kNvwHITeXR&_nc_oc=AdqcCv--vbZGbQR69GuNdlkX90u6pTsFwXuYuPf38GLqFJX9gigDKwuD4pfDEncXnCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBH-3-xutEiFiksf8ZePi0s2ENfm9EaPdOFNwG0CQNSg&oe=6A9D7AE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1k2bFV6J0QQ7kNvwHHrR4K&_nc_oc=AdrixCl78QH3Y0932Mn2kLXdd22nQTSWATitaSEHTYmnNKp9Ml4x5aJb96MJIGJy6g4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDdD5d0-95ELJg9fu8voXKe5Glk5p1G32rLTeep1_6tA&oe=6A940045"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSPJuhCECSoQ7kNvwHYLvKC&_nc_oc=Adqy7mME2Msw8LXX2lpl7zcvpDw4zWoLue_E5WIFkjaD0vaqoKlrdhY1wgfSekKQgZQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgZfMLKpRgZv9Swrw1cJPPG_pMqw3Szj-lOtTGakEXyQ&oe=6A942113"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrMTuUptu5MQ7kNvwFsKJBx&_nc_oc=Adqdxnw0Q3RZ3hodcSe6FAK1GzWIBnM0RjSk9r2ux25zKZDyzSK3cmJSLmYCoF5X1WY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFrgRsR9b9TTENeAwvsTeWJyNXVrVUsuAKiSezVfBvPA&oe=6A942686"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL862ZBN-QoQ7kNvwEQMk_k&_nc_oc=Adqd4hx5kDdsS7_M344VzHdIhiCkMDcJ0wXA06UydbaermMB3NA96MLzxy5_-g-GQ2c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5gOTBoYcjXsRLu1PK3fZDR16KwukHDZrhOqHofJFPug&oe=6A93FD47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVa2riJoObYQ7kNvwE-OsSn&_nc_oc=AdpPXOIV37VTOGUt_QsXaN11PZ7b0bNJiLzdZ4ifK7iMqr63kBCtqBOmxtXzHThgpLo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWIyWJ_pkToG0pCrv-uC7z353CLncvbPDmjjQppJQoDg&oe=6A940827"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
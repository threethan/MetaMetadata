1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udqGNMqAZGcQ7kNvwHlo4hN&_nc_oc=AdqZ4knt8lFU5Y5KShrD--hm0L6m8rmHc1vTmq8Lj-r1ROjUAKONhZdFLz_fG7863J0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh2I9cFmtDSrdF8LwukAZnm4Dyn-6RzjTZ2Hh4-rEeSg&oe=6ADF5E05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bBzCRnmCtYQ7kNvwGWYuhf&_nc_oc=AdqEb5Hrj2XOKr7ywKl01ngP-WL7zUpwhjuzk_QmE_iANz4IeWP3VUJISOrbll0VdAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1tq6AnZz-axbHSv2eBpyecqUxYVNPawLjCkUx1hgOPQ&oe=6ADF4693"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdRhHYhHAoYQ7kNvwFGCcht&_nc_oc=AdoMHD5GpCKk_kD9bvwUmOVjrw4-8kFp-wuZPtzNH___PXlMqoPDtJBrlRs7QgYnI3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnkeGgaaayulS3Da3h-7V1vftAG4SlOIcsE1FYAbrK3w&oe=6ADF4C06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS1xHm8B07oQ7kNvwHd4JXc&_nc_oc=Adrr3MuMMoS7En0d5k_KfM6gOE8GC9KkiCQ0c4gMKV5FKfZphselPa6oAR4hsxcEyog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbeNa9aTM-E8fPeqWYC96EcIW_ODJ7c-OQrvahh0rYCg&oe=6ADF5B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84xsSBLrfdwQ7kNvwEbH0K-&_nc_oc=AdqZHI6oJZ_KeiMWpkX_4D1W45wC45XIrxhe614VObQ6RzNT-GTlfqJUbJKUh5UDaqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMrovKuOGvUNXyVXGx98Wp8ck_LZFcdAsIo9cf6bspxQ&oe=6ADF65E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
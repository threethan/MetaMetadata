1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgtqKS6-QTIQ7kNvwHNfquS&_nc_oc=AdrIpcv483tPLbfzvcXCAUIiYvh2COVhO5R0BWO-jp1qAUJ9B3k2AQYlw02sp943xcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmgMaaJs48C39v8RI8xSOqDJl8VEYpkjFOaKJ0T_cRHg&oe=6A95C245"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBx1gBTKSQQ7kNvwF6A5Qz&_nc_oc=AdoVUC7g-B7fserptFza5s0wEPf6-n28bph17zAg_hvEfWVmN7oOlci3taxm8k28jmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbNwq03NbiGyGPF7DUjEC-iLruVMxqrZH3VFKoiy9nkw&oe=6A95E313"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrMTuUptu5MQ7kNvwHU4txi&_nc_oc=Ado4iLBWz339psDVKybCr2FOOmkk6mjomUSgiKYrn5e4vaYJUcTMDdrOIJOCWXspiRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4lPD_FNgK7VNfRLrEYPBD-4l6hwpsJ5Ha4cvMowiIPQ&oe=6A95B046"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSQGpYV_EUYQ7kNvwFK16vr&_nc_oc=AdqVyywnLAV5mdUVTcx_Ex95EBLUH1DlvYEyeS3DHP86mlHr94B7X5kXqIe0wKh7jsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZReS5a7-B5bbiYnmGFNogM8P3M5B_NQbexW4azbnHxQ&oe=6A95BF47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVa2riJoObYQ7kNvwFIw-GA&_nc_oc=Adqz2pY3vqrhxpbCtw_3fQp5m641na_YOfD1IGdKV3x4-VjT4d66ezkVmHH9mBU82Gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4kNC-pKTjF1Gy4UPb4sMrl9VBC8IPfi392JKhuZ8sFQ&oe=6A95CA27"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
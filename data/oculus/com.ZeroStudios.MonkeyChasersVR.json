1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC77BDzzUDEQ7kNvwEIBeQ5&_nc_oc=AdqwDdewM61V9PesgF6WpkprP0WCV5LFFqE_QUtOi7wwLCqCFKb9N7W3rO_PY0hw0i0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHqsq1yfn1BLN5tFnxNi1uG4owmaq_WRMQnydEJ5whcg&oe=6A564205"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxwzjnqV_cgQ7kNvwHGy0dA&_nc_oc=AdpBJlS5OhkE8BnK-U4bVaQjspcG6kcpAc7YUJxHQGJR8S6qhyb500LAw3Z0wUKqIZI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq0IwUJImDQMCXpMCD-xyuQaGmwU9DavubLDn4hOZ4kA&oe=6A562A93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlYN-apE_bkQ7kNvwEXgZPM&_nc_oc=AdqhfutHaMyTaz7jOhs41f96-81VT083hM54plkeUGb5dB8bFB5TsTCwixkogcGho7w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp6J5Aut3qiURkDhJfgIA9gkozWjieFpfxSzgsEPtUzQ&oe=6A563006"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWG7tkuNLFAQ7kNvwE19krX&_nc_oc=Adr6o0YICzJf57quB2E07-D1j-MeE-9nfCG9TB1AcJfHhNhitr_Q80LXU24niyid8IU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqHKcNqK8vn9oR3xoPi_bPc0H-1Rtb__bXPsUE9EpGJQ&oe=6A563F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsQzd0KsqmsQ7kNvwHCAlH1&_nc_oc=AdphMbImWM08S6RWI6xm7-gL9uKycM_j-_rCCCZYTChUy0fR5iWuxrCMvP-WS5X1Fzg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTx_bElnlDy7F73omN3YFtCVjmuj2dOH6kjzdPtpd5RQ&oe=6A5649E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
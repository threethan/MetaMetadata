1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwAVO_MzFyMQ7kNvwFP5CU-&_nc_oc=Adp2Ds5YWrhxH221j1I-cFbx8hkhkcC71VjLorrotsfRUhMsv5YItOCYNBldqyxCKzg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfOg7f2geGovev8m5XIcpjbxEyFBst2R-_9qRaiEJiew&oe=6AE20105"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBcZftYvFEUQ7kNvwHDDcVx&_nc_oc=AdrN5awerDDNCiVhz2MpOKNctJtfIxi3HQZKlvbM9qCj-UH7DpU0IQrXES-imcigjVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs6R8ei5rsZbhqfxti2dAUKrDzvfJ1GxtIXu3A_lgT8A&oe=6AE1E993"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gplo-bJV4IMQ7kNvwFPcypI&_nc_oc=AdrgGqPn4WZei7Uqt1GiKxRDhH8_wHa8kfdkqP5WzhkGTs_DcWOP2wvuYfd0hz0zh70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuNkc69rn7mUjPT5xiIEHzQeFdIHikAwsYr0_hy4nS4A&oe=6AE1EF06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5PZdNv5p-sQ7kNvwEthBuE&_nc_oc=AdopO3-8Nx-t5jgRm1suC3Jh7vxfmXvWHEeMF7F6TKRxwI6T1aPzfnLcwYH7p_yyGeI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORGpspfqWQmo2zIxyrz4ln8eMb0fhmbPfxUnYl2RU3KQ&oe=6AE1FE07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKO0aTm_VrQQ7kNvwGtoEC8&_nc_oc=Adr9itpfOL-Eui4oF1wawQcHiRII9AYJPrR-xys7Ct4D9j6CjUiUnXM52EBNCH2ImX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHN_ggRbgQ-LautIDzxCxfePtV06k73vaBAfNXPy6EtQ&oe=6AE208E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udqGNMqAZGcQ7kNvwGrxTGB&_nc_oc=Adr6Uviwvg07bx1PjDBWmQto4Tv9q5IqRb2JN1LS95q4MQO6P9zEWXtDkE-9CM73vkQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0q4Jp4luZ5F_oIQOq3KbXS6sO9_f24vpDPEnGcr76EA&oe=6ADCBB05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bBzCRnmCtYQ7kNvwGDNjyB&_nc_oc=AdpQhxUnJDAtKwhzMLB-6wvKyM4D-StmzMko4Cpz2lsWu1Gy58HAGkjOXJBx7nNE3XU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_KIU2p3jnCa_OuSC_QDDhbwUsJ7KKbJSmSZxOnHSmpw&oe=6ADCA393"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNVkX24d-bEQ7kNvwHKh0Wb&_nc_oc=AdqOY2YRKhnE98p8UpyfLfWkW-c6A3bnaMECpwkDQO4BdHiQbXniebw5olrnHt2aaF0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4kqJCgsRb-5LjtxLL8MJlamSYdJLR6NvUuBb1RlN72Q&oe=6ADCA906"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS1xHm8B07oQ7kNvwFZQPED&_nc_oc=Ado0Nbm_o27bFHrqVT5hEREA80cByLt90RhnhrpOgwkOB41UT94pnMk2MC3prjE2HFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVLz8Z5yP2nMbhjBzk9E4LFnCIzo2q7huODnFu0e_nRA&oe=6ADCB807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_ZHOcWU4UgQ7kNvwEaDcrI&_nc_oc=Adq6lpFAKmvXImNoGCjkLw_W7B9kIMyeDy6AmaCuzG7pW1S2Hl1HJZ0phN-21B25eHQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4GGd71C7maziUus8PP2SM7-q9FOk5ALY9g-osDDfaaA&oe=6ADCC2E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
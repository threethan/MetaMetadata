1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fel7_-wugFQQ7kNvwEDtuAp&_nc_oc=AdpI9BPxGT_u80FOwTjXTGf5lXs4JxoRhGq0XHLY8qJmGnfa-E5JporXR0ROuhBqpmQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHubpalfjBsL2b4i2mONLErc_db3v7vH8tbAgfN28gjQ&oe=6AF9BC05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9GydZ_UV7kQ7kNvwFqxHXx&_nc_oc=AdodDaDcnROpe5VgGE-SsZiDvELPiOvFCZau6E1JdKUT3uwXhYkT28DroEDi6QfPJSI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR7gVX519HKoAdQywrQxIyAcTHNZ69fBd3veNoveRvqQ&oe=6AF9DCD3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNLVxLA-IQ8Q7kNvwHd1-Fv&_nc_oc=AdolUkGADxdxHSIaT5ecjWmJy5P4qCa5piWlz3UnSTQXuJxTpWJfNNG_lSvpgsr4Fjg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxrPhSQNWbxK-c8aQgjXarY4ALgcVUQXqFRqxGld1R8w&oe=6AF9E246"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIrpSpq1jYEQ7kNvwG886dG&_nc_oc=AdpG0E6Zm1R8VZkGFaxN_VxagJ8bHyz9AdcG6pdHpFFQcAK4g-v4LMfMqY0xVVxLIN4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEk-NYiR9fF7OLYIoejtHc2rVglJ0VK0uJJ_WKlpd8cg&oe=6AF9B907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTx4L1gGnq8Q7kNvwFMq-Mx&_nc_oc=AdrlDU9u6qWl43hycmihS07tNOo4L0T_9p5b6j3Fxm-CiJYQTVULfkBtzYbxSDOWVq4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYZelHSlcvCj3mW4UgQROHt6vIVE0oTmhdfTVV1o4jVg&oe=6AF9C3E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
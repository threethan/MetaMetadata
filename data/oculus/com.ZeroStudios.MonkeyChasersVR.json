1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9DIS0uSQp8Q7kNvwFBU-cN&_nc_oc=AdpOTU97j2hUiwq5C_zKRJyONhvEVw04lV-IYhk-vzCWbwHZA5wgY-eOysVHD05FUlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoQLePd-zNRum70dggEjbdcfUq8BFruWpDzfYlyQHeWQ&oe=6A6CAB85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHyy4Ctmov8Q7kNvwHAGxpc&_nc_oc=AdrJPRevo8G5nqPBiMuMMSH5CJ_Yl_vX6dwQfWStR_-4dVjdop1xiRPsVYXQispJJwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmFp5GtC9EZ1InplASbgEmGEX_OHBUVqPs9NdaN-VUlg&oe=6A6C9413"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4OOhM3Ux7AQ7kNvwE6p6GX&_nc_oc=AdrsPtgaBBtAuPqWYTRiZ4qtxG1PKtWCKZgj46a5punE2QPgHjQDvfWRA2pP9wRKMHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF74klps8NupdSzcEE_g-ML62OgJCkdDF1ZYxMi3RKzw&oe=6A6C9986"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=920NOxbQpIYQ7kNvwH0V2v2&_nc_oc=Adr43tTk6QDkL0UHs-9BIRSEIO1vh_DG1tZvlTDm3gCe6HkSkCCU3KRJtvalIKzpaPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArNf-mfsj2MbzX5DaHC_B_vvrjS8JgpFHjKsi1UGqilw&oe=6A6CA887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVcRijm5mWwQ7kNvwFoDnfB&_nc_oc=AdothbDGyPjotGMlTv54OV1F1of8cTgSrGkBjqMz-YxKCeQoZizLn9Nx9Pv-L4orMMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHZfL5AqdQJgvXbQGJAzSyf1aDiGtikLOOwHyWbFZVgg&oe=6A6CB367"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
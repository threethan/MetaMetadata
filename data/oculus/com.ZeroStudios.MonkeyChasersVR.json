1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqmaS3Pozx4Q7kNvwErizu-&_nc_oc=AdqSxN7op-EXz0Ug7PKDbnaS9A-jPc5PULJxiAM1M4WxjDUniVbJaigVTsZkc4d8wdA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0_V-cLqznY_x062L4sUsjMH_1AaodZC-P9BCPolrFXQ&oe=6AEC8D05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFDkhbpZ9YgQ7kNvwErvyJT&_nc_oc=Ado42mO3Yh624UC71zAiuDHhEUklaJ0HLqhh4MfzYiZ-cdCOQ6wPHSEDb2KKzPKI2XU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuDjkdNgagHigKdlHBPeNkKLdi_RJd7By7DN5tf9KGmQ&oe=6AECADD3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNlyXx5R8fgQ7kNvwGczATJ&_nc_oc=AdrymsZHGw3sp_tdudHS9pY8-rgYULkEWvRFl_kXG7xwly73En5tlXkeUigRpzDVmXQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl6A4nP2KdvD2qyVvcIVxyIHU_BAEaq6lZNjPsinttrA&oe=6AECB346"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc89qARgSEQQ7kNvwG4gEX3&_nc_oc=AdqIIg0TQslfKQ8_qSTascDFwBnAx7ng8_qua77WDg0Twxz2zx_eKBwsOLe3AHdRF7s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy5wyOj02NvM8eEay9U-dpHeNl88dXV2IpDakemfWvjA&oe=6AEC8A07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGA4vgVNAo0Q7kNvwEBNBJP&_nc_oc=AdowAd7mzlqo0ozemKEOqJyQT9T65ygxgWLyCt-4b0O523WVJv6h2bsm28dxT1XZ_Nk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3mpFIdibFIvIXc2R_G7OyzkbYQ7sShozuQrW-gSdNqA&oe=6AEC94E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
p9udnaATIo8JeTFVcNfwY8Q4mXWMkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNFLZcfQycNq-MgfwQCTIRUQX-ZugMwRUk_X6kPZCpDw&oe=69AED385"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWnMoLF3KR0Q7kNvwHvz_Vc&_nc_oc=Admy0gII15OhVWfb5WJZpx2-ycHdtckSVgaZeUtIXgdbMmJdriCnoIAegbtmNZikp1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaJOpJUiWotw9ebbstl4z2Yrr_7vP0e9RNM9BvogqMmQ&oe=69AEBC13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci5jPyHTgUMQ7kNvwFforPC&_nc_oc=AdnrYngetfdCBLfs-Zr2GsLvnn5dJuIGkRX19B2SYs5I2gXNQEnPFU8nbPp89vbcb3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK_G83m4Ap3PoMwC8Zi4tr2agENP-Fnbo40ghhgZLEbg&oe=69AEC186"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp2wtLYExkwQ7kNvwEE8SOc&_nc_oc=AdlS-a_8AwWgBcS1dJaM4fYcUVtx82BCq2u_TH4YBWMk4QBc7AmGjH_rm9zAtcGauCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-iQQAbZkFOUpATkwLpl7D9YAJxje9LBW56alBZpo_Ew&oe=69AED087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnncIsfARrgQ7kNvwHNpZzv&_nc_oc=AdkbH1IMA4h7_6lfUlu0VmqK09nUv9iO1DgzkvcQTWPxREIpoZv1Ps7kU16GVPqAeLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-5EGGbGxcGno-W3Ldh3Y0vgjB7GXjlynNwkc_Yt4glw&oe=69AEDB67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
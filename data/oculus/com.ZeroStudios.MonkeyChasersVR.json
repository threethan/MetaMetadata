1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgJ7EAHh5hEQ7kNvwGNFaDv&_nc_oc=AdrAA8XXuw7zc9SVGdg19A7abd7_cWqXUxnQA1iGObSSt8yosZKNoPRL6oLT5qDCVp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmr9Z0EkIu9fJ18LjBSZUuN2F_A1uSjfdSvMSutZEoEQ&oe=6A900BC5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPi0QeyFUCsQ7kNvwHq_FdD&_nc_oc=Adr35nSuxPXq6Y0SeMFPZQJS2KxXb2FurM-tXrD7Kdfae6wyqQ0-uHYV3Czmy8yDPCo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsqYqWlqflX18RwssOlq6bynNqu2JIn6HwVPFekWsk1Q&oe=6A902C93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBg_SAia1uEQ7kNvwFwGrx4&_nc_oc=AdobabwHS2HXLRreA3ob0GA7Sue8ArqTMhLVVNGDSnafMSINw-LTWhE4aaPloF8VwMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYShl_QvPhGcILo_2q_t3Pd9CLysSNrAxZzo8BwZHiwg&oe=6A903206"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmZkFM9C6BgQ7kNvwGHrHIt&_nc_oc=AdpUDL_NnfinjRRc4Z1mO9lHwXcAVP_A4r1jSGbRhxVIkRWkdsu5W9UaEISPlC6MSqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFU0GOTThAsj4X4VEGvV0Kj8I0IVvKNemKaKiBRxb4EQ&oe=6A9008C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iQVQdzpvkAQ7kNvwF3ttej&_nc_oc=AdrwDulqYosmzq9Q2X7GSyXvLrqFM5nNZqPn1Jq-e9epXdU0drxJz-9i6gzTMa9CxJY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC6YWtk_tNfN6cj_6ej3iF4_sediop-zjIlqu2AZ8h-w&oe=6A9013A7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tALc-e8XR04Q7kNvwEqmzAt&_nc_oc=AdrbElXqP2BfnsZU-d_FW97yNg9uc9hhsLyumrwQ71Z791RcmGGZ1MaqHWDaB-fyhno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUA1ej3yrnonvT6Dg2VpJtSbtEVoKRh5-j9a6F-mMI7w&oe=6A86D145"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_WUabqchfAQ7kNvwHt_7Tn&_nc_oc=AdqYp-ZRzID0ykP70hHgB_pZpJz50jn9z1GZcqSW_NkGtNynGrpdJflzk3M9g9CXcms&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuaARbIwtQ3XozFp4t_WFADbfZO6mp8BU5FXjUuvFUqw&oe=6A86F213"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_fW3A-oQ-EQ7kNvwEsEtY2&_nc_oc=Adr6dYdu0xiTfpovV2m-_-XNQ0wqiHftq3yS2Dqo0GDj4UDCJwVG67KtQUid1XBYDrk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWWdhZ2nhkBAyLcLjdnE-u5PpUF5EahrV6csucYjcJbQ&oe=6A86F786"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_syTBmhCXsQ7kNvwGkC9zj&_nc_oc=Ado33mK_qV1JCbQuBQCB44QP3THyVGM_rgDxPDiNfojrPlyyrVLf0uA6Jwh-fWuj0pI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPS5dwmn14Hbc5M2nFoDMecqrBjlrp3aWIzFfmYkq3gA&oe=6A86CE47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m6cRV0aPRIQ7kNvwFVHnKI&_nc_oc=AdpXUJIiyy-MaaK6ZIC4hhvytLZ-MHGBiwcrqMmfh4ooCurjcZa1rdtbxR6hlUKOLPM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEqiELxCemymZCD40OyRqwDWejCe_nojEu3gN5ucNmCA&oe=6A86D927"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
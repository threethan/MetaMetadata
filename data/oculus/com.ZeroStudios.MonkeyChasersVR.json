1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdRUAIwMqjgQ7kNvwGTpzvw&_nc_oc=AdrnloecyIRrcpjV75SW_f9WZ0zwqmSgGFtuYYpcla4ofbqpLjjE-gmVwDPLvaXpiR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrref2U7V-0bM5WoIWgfo-1IzrfaI8c3irtjgdG7y6Gg&oe=6AA2B905"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH05RxKsTO8Q7kNvwEXWFfE&_nc_oc=Ado8hjMgeAB3346hMCQSInDAn4iVWLCwQNPoSD71UMEaesriV4ss1ehMBjQfKjmwSbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ-YvKBU2lHJnwbVez-8nYHkl7WOMx2Ha2aczr3-Bz-w&oe=6AA2A193"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHod2QetDxEQ7kNvwFFkTcE&_nc_oc=AdpbEX3hYoEp3DXkVjIu2Bo5nDGBa2JNFj8db4Gv8bMponqRl35vjLPXjAC7Fr6JKjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoLZuK9t_-AiaDg1eZDxNkhEb0f7AhKL7oCC0T03lO_A&oe=6AA2A706"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxB2BWXNpuMQ7kNvwHjagUD&_nc_oc=Adplhd93GhckL8PQS6SlqCw_JPH72j_Yxj2HW-6yUfa1DP2W7-Bg_3gqCUQPu2EWeeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-3xLwsMfzr2spRKZyZIqWAf-ebgU1Bv-8j2YR7gy0rg&oe=6AA2B607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLO6D90W1EIQ7kNvwFleL0s&_nc_oc=AdpkuZz4Pi2HOqcEHfd_LwVxL3WrbYp-uRKqeDfYqPFOba4SP-rZ_r_8VjZIP9J6Q2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMqmcWLI4gc7XrQaGajtR8L9R8Ms3dhKrHK5xKaVwejQ&oe=6AA2C0E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
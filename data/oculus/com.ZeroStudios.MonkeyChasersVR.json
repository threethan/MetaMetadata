1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0bRr565NikQ7kNvwG9V7aK&_nc_oc=AdryCkr49_rf91Mbv0Kk5Ev4Wa6R3gGghmvxVxaTqbtx2ngTFY-7qy3EB5NLRwD4Ges&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGALdk9ML_JlJbSct3twSEne_bNgC3LWEL8C7JsSJ1QA&oe=6AA6AD85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3Ysv7S8O-8Q7kNvwF_EE74&_nc_oc=AdoErPNbolwGAkVPyqWY36Ys-orp1s4itOwuYozkQ8fMaggF7TVISN9s5VUOwoNCmNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOlcdbt5ZFWZ9elI9LJDfKUIxeu6RNg8SCsEfF1CnBbw&oe=6AA69613"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqIly_FMRbEQ7kNvwH23VIV&_nc_oc=AdoSFOdwc4mL_d9OhlMR0couCLqXnd1irXBD5ycP3JCDYwHwDFByigNS8h0pAjo8PXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGDEhpflnKw7YcQm98X8nquQPYIMp6Q535AIbb_n9wJw&oe=6AA69B86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGQKbHKudowQ7kNvwG9Oxb9&_nc_oc=Ado6_7VjdnM0fCUHLEaO2tl-mfj2DpnmIj6LffE3hZx1HI67dqk28jwjLApOqLyNywU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI519ZPQuOvnIpl1r1LGpKlm71nEQCDTd4UKhlBg-flbQ&oe=6AA6AA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3G6twqvWzwQ7kNvwFsOduw&_nc_oc=Adr1ZrYj-42nDKrbHAuwKrfPFtKqbEYOy1eSSxP3hQp6vOaUfEwS6pFJ5UJJIEaUOtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFV6vxclAjcSjj1-LnUb-lrHDv2gY1DZdU2mHC5JEz2Q&oe=6AA6B567"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
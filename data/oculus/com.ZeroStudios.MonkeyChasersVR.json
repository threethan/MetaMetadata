1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-Cy19AXaUgQ7kNvwEIJO5L&_nc_oc=AdrX98KMBCHm4QWCPow0hbPByH8-l_kM2DDtNkQBl4ljjhgQmoMyd09YpdVRz0yRAV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv-D52CkFj-zCVrALGYzgjLcX-Hns_bN84f6rSlq2eYg&oe=6ACE3A85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLWUa9c2L7EQ7kNvwEuwGL5&_nc_oc=Adoi_FO9qUib9BlMRZWJtYFgeN_yRvTNDOeTCuFw5vc-4FAr1tDf6-QfCbiQMutrKUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3G90imyNq215UPKEftEg-9V9O1-6kMZU163sowKpbRg&oe=6ACE5B53"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqyoDIOwAKIQ7kNvwF5b-eK&_nc_oc=AdoxrkvyFOLQuh2Fi4LR3x_av6WQTmx7-n6veH5BhQfjFSbWLmJFDgh0vbhU6os_SpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8StQn4EUVOQc9Xvc_kpmDS2cliab1a99LYF0r_uxPaA&oe=6ACE60C6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3vF0e8H1DEQ7kNvwEm5D82&_nc_oc=Adrg7NcabE4IlWJuWrwzE42K-PNJqbJGynk4b9mu2myaLPmGKx1dWXx-5EhPEc7aWo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOshcp1HJ2R8hqMAkBiJygggdFdNv5QkOhWT_Fgl79lHQ&oe=6ACE3787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wj_k4G_pI4Q7kNvwFMQHnt&_nc_oc=Adrz-WARlLmMAnrTnXpMhUHGyOj50Apngq3VYR9w-BRn-Ukq7dZSa1R_M4fl31GPjrI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpSg00cRICIhJbCO9GtyT3dBzlYnnqvn5dJaUFqXG3_A&oe=6ACE4267"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
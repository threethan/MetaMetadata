1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39N-qLa9JIUQ7kNvwFMUs_M&_nc_oc=AdqDotgyvCithXxXXbnKyQ_hZSFdyNRXiOfO3S_X0nlFXWSPqy9825LsIK4gPtEu6y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSED8RCVDKoEDXvSCEdCHyKRk-3Ikuskg4pYQKb0SYYg&oe=6A7C7D85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnmrsxM7OtMQ7kNvwGoeOF6&_nc_oc=AdrSKbdPsPt6wWh-NpPZNlKpP3kiuCwjWFkYokFzihY9TVikrKQxwUmtipU-7TqOYRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvjwzF0KkqQ_tUu6IGi06Dz8UTTO1EGCCUvfcbDVS14A&oe=6A7C6613"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQlDeu1G_h8Q7kNvwG903P3&_nc_oc=AdqadQTFPyz9sbTfCeQk4-YrpwE6h-jiViHtB_gdFo70Kyffa8Bm_BDqVtPiE6H2He4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3CfWMnIiKXJikuehKy1JKCNzinJt203qoTX1r43Bn1g&oe=6A7C6B86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=511pfpn4_j4Q7kNvwH6iiPf&_nc_oc=AdoBL5ShItVwJpm3HcuXZpbr4oKQubLjyhqi_U7MyayUDJeLBjlNZ3BwhuIdI4AyjcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPO4eARDDxSBB8s4XClQYSXhkMDUAmOymtO_UfT2LbaA&oe=6A7C7A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4xHJzBJKvEQ7kNvwFmBOoC&_nc_oc=Adr-RCUbfmM9B_-i6M6V2xXTh_J74e0RTl51YETUqttvxbbjJPVr-K6tK6qfM71Zh0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl0hLGimEsxpAYscWL5M_0_RgLJLY8Zv3S5wenMXyuOQ&oe=6A7C4D27"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
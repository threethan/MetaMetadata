1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39N-qLa9JIUQ7kNvwGO5T0r&_nc_oc=AdrgnWbSw0xpBRc3H7O5xCsc8WZUjyI3319YEthaeAqTKjnAVBzYYdme6aUHuv_w-hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf5FupGjj23cWWNVynHlLFuGHwVpCOf3RIugYNJHk76w&oe=6A7B2C05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnmrsxM7OtMQ7kNvwEEHphh&_nc_oc=AdqcZge5IVUkKek0hCBEsIAOu3Znow1fV5f8nTjEWK0JKttINZUAxEjogvMaiLFCD1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_2M1HaIxFqh53_26amIm-dW0LnvvyGgaWSNuRminOmQ&oe=6A7B1493"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQlDeu1G_h8Q7kNvwE21mfw&_nc_oc=AdocQE3rawxkQNlg96pmn2aSC_3wYwusb5U9D0hChSGDVd4tN_ywPHKx2v7zrRBXsno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEihwuBrFcN-WhzJi5OSWQFnUlALH1EZlvJ5oW_pDmm2g&oe=6A7B1A06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=511pfpn4_j4Q7kNvwHogX4U&_nc_oc=AdoB6FUSCFDY8iLU4bz8Z4z8bZTqXjqDet3lMa02y04n1xdNZP_DbxVvoU9ZvXkoY9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxF8B8nnhRyFZaIpvhJCEh1ssvobugrP1Tpaee3LPotQ&oe=6A7B2907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4xHJzBJKvEQ7kNvwHVJZ-f&_nc_oc=Adpv3YrZmDRalHO4krco-DQK_b0msyJRmk4cKoZNb9eIjUGBartVNUL74d3o_lFilgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyzb3-11eRZvJom_MHJGP9ML1MjBTZ_Bwu3Is-ViZDSg&oe=6A7B33E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
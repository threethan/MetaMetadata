1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUfeGSl8shIQ7kNvwEL_oVy&_nc_oc=AdqF99ToYXDu8wktPhKFux4WYMdKqqKvl84cTDDiuCJb6_yIpHXsCLLuVNWop9DEMiw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp0KSFtuoRfypUfijtvIMECTkdZr9E7YkbqKpdc7o-HQ&oe=6AE89885"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQI3oGjWIeAQ7kNvwEE67QT&_nc_oc=AdqJksttB2MQb1bc8-8HfEfI1ZcpFfantk5ib8x52607V0vQxaJ41Ac7IVx6XXVwAgw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7DiEYyUyYkcUz-HsLdgMkViC-uRmtrEnQq8eNNX3kTw&oe=6AE8B953"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39zs3hKfg28Q7kNvwGpmRuC&_nc_oc=Adq3LBuxir__m0ZWTIJNJWplcFzOSr7elf5bB7yLXMhhba5c2SCQvobfN-XVexcmO3w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcGN8cWLg6weDhMR_E6uhziB8aoYfbGW78Js3fhoh8Qw&oe=6AE8BEC6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDrcbXW4v0QQ7kNvwHnueFu&_nc_oc=AdqdmQLsTIPN8wFBQ2sYKJQQFVELu8kfOsq0NRQMLIM_fy0GtSz614ZVkOw4TomFUPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS93TsZhsP7Wz980B89hI92o5jsmFCZ_8rMeZ7TkT2Y0Q&oe=6AE89587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmhTdyrvJz8Q7kNvwHTCsyT&_nc_oc=AdpWwKjZEP73YPY8sGWkMCO4qlWwOeTF0Ajt9aabS0PybztFJlhLKTRtHvhVy282Tl0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeD4GreJMeYSgx8EiuebmaQ07egTxaZFN5b6Ei3wwPfg&oe=6AE8A067"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
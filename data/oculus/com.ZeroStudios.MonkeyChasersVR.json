1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdRUAIwMqjgQ7kNvwGq9Xps&_nc_oc=Adp15iVc-qo0LBe-F0TRYL0rhO-yZ3tXNAgzFfF8h6-p8NiBzJmppCbp9nwf5E9FRkk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb5fmjaCgEi-SECwwagS4yc3LGehq2d1FFbulFrNjSBA&oe=6AA16785"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH05RxKsTO8Q7kNvwEbChAJ&_nc_oc=AdqIo3R7cWK-fbOV50PP8u-aOZRRr7-cqFp3pG1rplX9hXVwWy7cHStJ9ErZR-ijq64&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH-9s3D8iug5iJK8Mc86IWxI78zLrxTw7DjkPFlLHnQg&oe=6AA15013"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPGwpZCW910Q7kNvwEdxYdW&_nc_oc=AdrwL2WW2FtmK0H7HVYn1FGGPIYPGZAkK4ksxcX7aVi6fR2oXaH93rfshqnMeU-68jI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITASgasqkXJQ6P-qrD-Ck1KINcRZieXcUpb2Jz8oERog&oe=6AA15586"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxB2BWXNpuMQ7kNvwFcfiR_&_nc_oc=Adpddnp6CA3bpkXocjU87dGwxtyv2O6z1HO7mt1V8vJsuhdyPQRgVMek39ajwsXOchA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKXIX_9EvFX-wPuEPR4R3vda3koMiRxVRATxHb_1yObA&oe=6AA16487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W24f2HuLTs0Q7kNvwFVHvuS&_nc_oc=AdrRViV8HSNKhxouovM6RJp301I7X_xtHXG5nMfeNds-t6fKJxxe0sC8Jpl_5hjweHs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUL5Z2DddpSc-dKLoZRRKjE9OBFnsL_PgZ7SvLEjGJjg&oe=6AA16F67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
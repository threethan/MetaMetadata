1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwAVO_MzFyMQ7kNvwGxXNdG&_nc_oc=AdrZbR3L6fXUWI__MO5GNSgNbjJgwjdI9W3XAsStqU8tw8tDgf758tcqqtCybhCNuFA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUJbRd_Rb_fcYjAZYd-oujd3MhpFiTTiuxtebQB9vThw&oe=6AE35285"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBcZftYvFEUQ7kNvwH04AdC&_nc_oc=AdoKc1WYN4ypBRHBTm0Jkou1INvcfPth6qpYntoKic6DnJtCZm9kAmXdb3zyhYoJwYg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTZnpt7eZrsIM4CS844QS33Ljr2WZKSI0XRla0tYBdlQ&oe=6AE33B13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gplo-bJV4IMQ7kNvwEWo1e0&_nc_oc=AdrEDXL3J-24V8L2MtC98NigNvgPZgntFfZYrZ90SlptdxMonSgisQckYk2WSdn6snQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTf2H6I2wT-JEQaUWddS5jhtk_4QvtDr_dCUxHsXGUNw&oe=6AE34086"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5PZdNv5p-sQ7kNvwFGm_Ce&_nc_oc=Adpz6OZIw2KNbVyKpVdp8gwqVs0BpPeIFyxfPqakPFrC9UCc1sew9tpF8NT0p2wabh4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuHcjOaoXtiQohyQ0CoCz_Q1jRBBovM3Kgix_Jqd3IjA&oe=6AE34F87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKO0aTm_VrQQ7kNvwGmDH1x&_nc_oc=AdryFNNDdJ8uk3ClY2sETr2tyY1LpB-n9qVYwDINhrWcuefP6Oxahq8t3ZDkHyLb2lw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVpQtCgrILvl5rtBrisgIicq5ilGEtONHnOW0jmLEmsA&oe=6AE35A67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKplFYVetlYQ7kNvwGeuiX5&_nc_oc=Ado_xQg-gHk4vytwj6FVQ85pgKY_abwSwZiePTaUwwQZsGvuTHWr8VZT91HkHfDrsAQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQQvfNy7EWTNP0KEgjwtTsqsdk7khMSI46uA1Jj4gtcw&oe=6A71F185"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bcyWBVr8acQ7kNvwH8FCTs&_nc_oc=AdrY-1Sc8f3xb8kAlGtehq86nufrT5Fj0Pn_qQxlorwo8QdprSc9ktpseTjNYaE69zY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiBYLWl1ua9XUol-4srcI44QdwfacwWC_PF5f74t2T0Q&oe=6A71DA13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leK6leAT9XcQ7kNvwEY50Lq&_nc_oc=AdrV1kc2wqk0pKyBhTZdurb7sqwA334j8YwMnJWDnhaYt0f5aNr8RdQwi2EszUDWbJc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHss6k1Tvm5cCeDI_7HJmtCBFRI9p1-eDOI-U_rL8yu6A&oe=6A71DF86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ni3ra__S0AQ7kNvwH14FDN&_nc_oc=Adp_1fcuSNPbpuZ0CC9-l9KxUtsVzNo3Rhkp8HGqr3TkoozrLtTr8wBItZiNxX5Jdgs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEy_LIjUn8EqGdjb7s94W1oUaUJZwhFQlAhm8aomTOog&oe=6A71EE87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMDifbksSlsQ7kNvwECgeME&_nc_oc=AdrvFhuaKNwOJKY3Bz83S5IswGyyGojNU0wNylOSlEbf37HvvYk24VQaKodNBpmGCRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiMrxghW1ejkGJ7Nni26Hb3DcJ7axBK1Z7PCaPNmS7OQ&oe=6A71F967"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
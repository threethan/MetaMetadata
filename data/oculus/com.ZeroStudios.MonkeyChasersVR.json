.com&oh=00_AfsZbgMza5huGD9ZPMjxidyTZazkHFeSe-hpnwlrOWhenA&oe=69A59905"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2hTzcoTVT8Q7kNvwFAEemI&_nc_oc=Adm_USAIQhRTArnjYtzqbAh237xnCC4Gp2vqgTJGSSRP-wgwNFgGuIBnUz7xkZVWpfk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs3gJEmX-w8EfEkstDAQJk9Kek-MGz4iX4OmKcUUy6a0g&oe=69A58193"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djK2_nLiMdAQ7kNvwEyOPbE&_nc_oc=Adk7T_SFC_kXQqVYOPBQ8GJbNbl-yOXRyfBacqa8AIab0qiNboWBtZM2voytGut10XI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftXGVTqBeNZ02IfvOcKkQ5-0fiFs-0DZsHxLKg5xf4vdQ&oe=69A58706"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UM-wYsAeVbEQ7kNvwHWyEvW&_nc_oc=AdkrJ1hRKzB0sveeuIuva9OGc7zc_o_lVIr-whYCokmksFG7VclYQ6tjRAQ7QKW3uys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftm6O4B0-NRzClUTn7lfoYWfDCsnwJCgYEI5BbOqgXiOg&oe=69A59607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvE4nfuWU4IQ7kNvwGshGhP&_nc_oc=AdnMF_SxmWvVGaGrWqyBd4eGjFD_Dx8LY_dhslW8Umy8QZUko9c6XULCpPFnexAarVM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuUbCFjhhoTfE9cGgK00T6S5gboUriUssi9I9uSjOBgGQ&oe=69A5A0E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1707473176360113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
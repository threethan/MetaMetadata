.com&oh=00_AfsZAIxFwVPbcoAWazAeCkPuwv4yVwbtoAgj4KOxukzKdg&oe=69A2F605"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgbztTjeDIEQ7kNvwHjUo1_&_nc_oc=Adno-mDJ87_SbkZbLfRn22N8YCSbmH8fTk5eBK8iX9GPOQydhHZabTaLmgrFf0cFTuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afscne3UtV8yae5qW3y0aOy60d4NSkMX0Xv-Goiblj1eKg&oe=69A2DE93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDcLevB1YHQQ7kNvwEIM_54&_nc_oc=AdmChP6DsiQ2KfH0-Gop8z4GJImAOK4gYpSjGGDIjhhl4DoKnLMxrWkZzf7JCfqy3ZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuo3eXTXLxUQunotOm133JgTn-knLHE4Itfy6QMzcZiag&oe=69A2E406"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dy2JrhCIO5QQ7kNvwFGyjSA&_nc_oc=AdnwLlSE2KWvOpBiTrRwwKWjZB8VMT9xN8keHlmt_PusKRImMwv810D80VV9mu21WHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQpd4RL5_snmx-8HzvuNtqXwWiQFg_-apj-HEAdvGb5w&oe=69A2F307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsLpe0LZIS4Q7kNvwFuflSg&_nc_oc=Adl0XPYjvWGywov1n0ZctDaySQbxyi_1OAa6IllbPUTY4I_r-xOi7jqcHQU5OS_XGWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvESw48IlJGk_Z7pL5WN4v2cZQdX6Pr3FsKfgxgBQrOCQ&oe=69A2FDE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1707473176360113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
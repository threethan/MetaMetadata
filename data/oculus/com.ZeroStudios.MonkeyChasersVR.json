1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJqCGswZG2EQ7kNvwEhQWeP&_nc_oc=AdpYQtrimEI0kTI42f1HQxFGcL8tz24DkPdURe_xKOkq8MihQSfyIqry6_y4f1yT7Ks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvS755wWVoJIKLhtdEwRwCbG0JHMGZNRp9lWGSqjQwEg&oe=6AC7A305"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTOYmc9_rcYQ7kNvwEJm_Nd&_nc_oc=Adq_QSe6WhWqHI_lp7nolOJoAvEcCWNSnG7pM2tZ18VY2aKTLTMv4DotnZ2vPPkaTFU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6NuNRbkFaj7-sIDDGSSQ_deW_ilELRScSN4_NCv4v3w&oe=6AC7C3D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8B2ct27Bt8Q7kNvwEJksBW&_nc_oc=AdoUPi47BDpJp9hItNTXWFUGuFlpDyMcnP_IzUywTyLXJ9E1oRq-UoH_4CEbaGbTcXY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKZKstMpoGTWwA6MAFbDM9CX-JvlIWKonnw86uWTUzQg&oe=6AC7C946"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6S4QdfLbE0Q7kNvwF0vigw&_nc_oc=AdptFgRlHCIx882e6FfB2iS_V9iGshNWtLNNFj8BtxjeXgcyajXbHS2xtq7Vs0tzANQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAKHvyCaYEMXp98l_Wi4ztGsIpsxvd7Ir73dkGn1Oh2w&oe=6AC7A007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk1TWSXY2TUQ7kNvwEjFAvh&_nc_oc=Ado2i2UqEm8e7lHKeYfjZ4bErsU_jHtZAlJUA0fXgZK9CdxcgXUOYtgbWB8cwkrEB4c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2Ii0ke5LfbgrDtD6cpapb7-WPuYB9bnuEsGymqemYVg&oe=6AC7AAE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
ZrH3X9zenwbDgaOrCUSwk_zxk66SCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxr3iqPtX2GwBhEFvMzW4yLux8m3xN4LO2qhhKtP_wu4Q&oe=69BC0285"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNXkTAlgnZIQ7kNvwFKgbj3&_nc_oc=AdlTxj128L38igA-6I5BBS-rF-sPnLFxipnC9fJN1PIZdbuqksR-fMl4oIBkm3zVMeI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_OtVz623IDlhuGbUoJmFjh-o71xlwsDhfhHsCi8Ii9A&oe=69BBEB13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3uDbO1e1O8Q7kNvwGUvsRn&_nc_oc=AdkTAvN3o7VHhpRB2BxA5SujeCN6G3Ix2cBp0K8TasMKfi9Zj7pxbeV96vPZw2f6LQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxjU5TrgDBghbVP_BHU7D9iT5c_r-l-dU-5hd8unNX4aQ&oe=69BBF086"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD_7YS_gr-oQ7kNvwFRqGhW&_nc_oc=Adn5s47E_iIxpHGJ1annhXVVSRvjTAGFkM0muXYkkWr6sM7fkJHRNHQGO5QuOrav3Xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfylR_7JqESL_RyPwQYMGV-77S8hs3OYhkYqLAXCw1pcrw&oe=69BBFF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGznq_MxmWsQ7kNvwE9jVVN&_nc_oc=AdmPlvg5gSuVRFKSiUKhcUVz2RyEDYJi_XHBg5kjDBS-O4Rx34bAS4shM-B9WXVpnrg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQ369AvDfN96J_jphZRp2SbW_D5lk4YUBWB2MHF2H2qg&oe=69BC0A67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
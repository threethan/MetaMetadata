=AdpQzdbFVVDp7yJI7n7INBgNqUC64kQTkTf-YWmz34yA2k__1Za5-JsbJYc3QJGFHEM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A-OVGyZGZTBGSatBTNweM97e6nhcFPX_L7nFUREnrzA&oe=6A394105"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id5KwnJLxoYQ7kNvwG5QDXa&_nc_oc=AdrPfXgnWTjUVR0YefV3bNBfXyJP4NrxoYi3fktziplo-LeG5lQI6AxaR5qqZitpSK0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OS1NoHlSiHXzlx1wgRf4wN-oLkzehCWyY4rbUJYgJnQ&oe=6A3961D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3dq1vfKwj8Q7kNvwFIsoz8&_nc_oc=AdpPb1GrggIKQp9pWLoNSv0dvSJbw1yQuiG1FnKe9RC0ZUsaWGCTzYTkQKHMMYCQXlk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af910DLfqG7vrhZvwh49wi1yXFHRKA-DqmnGMgZRXT2ung&oe=6A392F06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYlBoWNNJtcQ7kNvwGWATvn&_nc_oc=AdqLf3fkwBrKQyhPumLYmUKNUh3xwoVp0VO5Mw1OhJiTRdqEHOqXU88oRKpNXEgxm_c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L1c9nahAyGAIBb9VMnazCun2ihK5BoYjrLNORDSCx8A&oe=6A393E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA0TeDKfRawQ7kNvwHrUf5n&_nc_oc=Adou1fN0fxXSUmQe_AOxY36Rr3DVK-qjSYqB03ResqYC0EKEBr5cwd4MVJEUL1idVQU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I1PH8w0EuzK5OcO4sUozgUl7p4ARn-RAXxm6GNP34tg&oe=6A3948E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"],
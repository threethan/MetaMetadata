1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4k1x2uJXrYQ7kNvwHF35xg&_nc_oc=Ado_c2bnkLr7c2IH2ZJCO5e0YU1RcDirDJE6LNMXt2yXnotV5bWVsliWh8DvkfIGsiI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGlHEWCwL6Dl3qzV6_4jNPzy7WHyRqQp6qrm0ih26E8Q&oe=6A6F4E85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9QLn_mxZfEQ7kNvwGpBO0j&_nc_oc=AdooeU66M_M9X4nC48zdO5jEfECNPvQwGkfJpJiuAg8Huw-LRgryppw4XHgnOpnIwvM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOP8-kwEVXooDPzwwT_FqoLmZHeMhYp7WJOdmkVsNmLg&oe=6A6F3713"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leK6leAT9XcQ7kNvwHC_CxF&_nc_oc=AdrXq6xAZZJhMnGAeBkeXo4Lt00L363bHEr8WZtIVIJRwHW0kHgIcwy2_71wZOSX3Uk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwhREAMDwXclvhKi1qtT4AI4W3psGtDWPHjdMw-m9Zgw&oe=6A6F3C86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilNVZ6UxXTUQ7kNvwGwnfcD&_nc_oc=AdoRJ0DTm4Qnn6eyaENB0eSxUkcKWFr6B122nUDRB58QKeq9TXnrtEAK-KaoKSAC15Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo4NBULjeSU8Y1Rb4GBcEpjQY7LjjGp6Axh-gyYGT_Gw&oe=6A6F4B87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMDifbksSlsQ7kNvwGxNNNW&_nc_oc=AdoWFZEJ0t6Ww_L21h6pHa8qywa9Gl_V4uH9FJwjoasRXBdR9MlrBciPH4ebB-vPt8o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDErSmVZOtnBvuj570XM1H6hsCbVkxwMsnpNCRQAzvyMQ&oe=6A6F5667"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
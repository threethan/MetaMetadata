1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4k1x2uJXrYQ7kNvwGo_eOA&_nc_oc=Ado0tolPjIKbX0wHuXNystXysYBgnizgX7NDoTaX1fAk3EWaJvBA5iuNF2sIiEwfIOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF20tae8zGXD6yZFdUIB_1mhOBPf3nBLaqJmIcjNmEr-g&oe=6A70A005"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9QLn_mxZfEQ7kNvwGJN2Zh&_nc_oc=AdrIixGWfwN3vAj39wVpObfezci6E45xqtRJ6GEa6jTv9a_COgu9g4BgTDYE9fzyBSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRGZ1Fy0OOh3Oo5z18NrDi_Y3Vlz81f-_06eCNQYd-VQ&oe=6A708893"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leK6leAT9XcQ7kNvwE-8AQZ&_nc_oc=Adq4kICIltQyZEo051UHbSYaieJzeToNAPb6uVaEh_y3E7tcHncVpyhQiRGX7CUvAnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcblTeOOUSOHFMYWagsYctvb3QOLNhCry-9rjYc2_hJg&oe=6A708E06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilNVZ6UxXTUQ7kNvwEru93b&_nc_oc=Adrwq1RBqywRpJyFjDADW5PWuKAGpi4mUhkHOj-TPzeiRfcFtOaEl-2qj33ef8Pi8yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFExirFee8Yp-Z6vN0_O9YwNx72RI-p89vZy8wjzn8peg&oe=6A709D07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMDifbksSlsQ7kNvwHz2G7T&_nc_oc=AdqM-qUvthswtVMBYNet6mqmnh9auOKxhX_5daCilJiISlyKaiooS1si-iXxbjb1dig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER3bTlWyVVDHAoPOihMUVBW23KYU4AU_rXV_EO2tPYxQ&oe=6A70A7E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
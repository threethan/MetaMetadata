1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir499kz1T7YQ7kNvwGji2U7&_nc_oc=AdoxCwI7pMqx4y3Cv633CdchVUJHA7wFUDAoNeRx0wva0sE_CtIcmevjgamRj6VLwuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN66UM1Bydq9pI-0Yen3_rQHRfsOMt2IDekrmZ0GQTCHw&oe=6AE5F585"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9b5GJDKrqwQ7kNvwHd3aUi&_nc_oc=AdqaLpmVQsDsCoKR9iuWsfRoRY9wXDg2P49v_K1yMJ7FzJ7iSFfnVh9NRM28YV3fzMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2jn_mJ4720ulACeDVxKuwCTc3NTtIBWitEdor_Biu0g&oe=6AE61653"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39zs3hKfg28Q7kNvwHGzB3g&_nc_oc=AdqIgZUTQyd5d9Rt-4z8o0VGwzJzGqPc1S73XM3olgwOe4EqHN2sVO9mA1Tl2Cl_I3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM2gW098QoCzQ3iNQiyd6w0buJWavlwM-NYVKdVGOKSQ&oe=6AE5E386"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HOIpNkdJHEQ7kNvwG1L0GG&_nc_oc=Adrk-A2FSpEO4YouEkclwpvLLchwA2wrhMZk7Lis2zA7xGgOVIdlRB4Lf5AL9RR3Acc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPx-MkuDL9MJ6TOXE155O3MefjEKAsNbI57PRpzhVWRw&oe=6AE5F287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmhTdyrvJz8Q7kNvwFw0VBL&_nc_oc=AdruXflnT6ueCksypvJHfmr0OZJnhS1WvuUtvjTXkq1eBZ1DSt7DPXZN7ZDz2zoMmHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPywBet8s5Ye5ZRUXW0pSjtK5k2xbPVu16kxyy_t8Q5Zg&oe=6AE5FD67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC77BDzzUDEQ7kNvwGDKNpQ&_nc_oc=Adpk6MXaJf9cmCUeVwFLAw1U7mNaQCiQP3BLmFdc2yZ_VICaSSLjd6E2Qckhvc-WTes&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw1Ga9pBYyT0MYDA2OsSZ5h9aycACsVeiyp-VWBd_1Hw&oe=6A58E505"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxwzjnqV_cgQ7kNvwFKSitQ&_nc_oc=AdpYLygOFvvZk-ewZoffLHYM-5R7WwCbWHhbWplnaqg9TCP84ei4xmb9tQvjgNx6E8w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6hbL4xUxV0hKUBBKEnKbi5TYH5wi2QEo5bCj9n3ns1Q&oe=6A58CD93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXssmMMnqxUQ7kNvwGv89Up&_nc_oc=Adp0sH-Jjy7zKClAiiqIGf4_ESOIE2iWTpqAyA1iF3ANEyaCHVJU9OLTaNKEi9qxi84&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA5PmaPKf5VZqZCqOkp5tnXvosKexJ1UqvlNNinn8v1A&oe=6A58D306"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWG7tkuNLFAQ7kNvwGU7gdQ&_nc_oc=AdrWQpYMzpzrcOTCE05sXxpYX0-PGRxfC_awIAbDz_QeFRT8nyLoireBdEkQlZ3mcqU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCTRGghgPaV-T6A-tf7HQDcViLDQqfY8kA-4V-BeRppA&oe=6A58E207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdVKLoL5tQ4Q7kNvwGFS7wj&_nc_oc=AdomGeKYdNrceOy67tAk4nN61lLJ_dBoLgNgkN-IuFeLNRJI47EDqnlsiRB0S0W4vxE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGJSnlTgiHZFQSu0TIJFLtVIiBiPseOOEJ20Xe4qIz8Q&oe=6A58ECE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXS8wR9CpDMQ7kNvwFslshR&_nc_oc=AdrBsBbS3IppZNQ3OF_Sump7dDDbUYfHaILiIRDD66Rpc6sJ_yuRruFjfgolhwq0TgQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeKPcL__rIru9T1IDWiA1TRYNNMVtz5_7fDTUAviLK-A&oe=6AC8F485"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tARhk9TqVKQQ7kNvwHHldzE&_nc_oc=AdpC80-r8ShCeuX1fc_myxjLieON2HbEicMPPsR24bW5DJyUSXqD29v0n5IoR3inBi0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5RfeqBf0KgjwUn4c9WfcDFKsg5WMbSy7bg9uK18iOJg&oe=6AC91553"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8B2ct27Bt8Q7kNvwGE09CE&_nc_oc=AdoR7PfZqXnEnNyoCYwdeDZDAUKB3JRsd5ps8wV2M-J2gqKjjtqxzDIXCfLlcTr1ijs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMKpCwkPdM5_GvT2GgrbcMw_qKBxl7o0BPxiZMgsdclQ&oe=6AC91AC6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i40NQdwTmIgQ7kNvwFPvI1M&_nc_oc=AdqMUKSi-mWlNtygJ6tevOjgV4e9xDwsvLSh5XFRx-HjXULZSPFsJOW24W5Q13mST38&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs6OpXu_r9HcO9p3oRAt47hHnPBXRPng6UTmk88Ma2cg&oe=6AC8F187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk1TWSXY2TUQ7kNvwHJarRH&_nc_oc=AdpnxV8ZOEMOXzXszmQS-CauxT10_1U4LTRwiPJfU8DA_EpY_Z1IKmRb3yeWWC6lj9U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnQCPq79Hx-qKiESn7f0o1y2rahWNyHXhkA7JbpKGqBA&oe=6AC8FC67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
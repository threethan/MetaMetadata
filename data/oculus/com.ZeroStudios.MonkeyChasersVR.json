1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tALc-e8XR04Q7kNvwGAVLiN&_nc_oc=AdpyD8De_49Cxbg5HMCGOwhF-PTZNrvrbbRrGSPOoyj6q2kumavYT_Rd_6tmUat0PUA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGSu7biqyH50WHUZrtXoY-KP7FbMt1RVSbq1KPQMry6Q&oe=6A8822C5"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_WUabqchfAQ7kNvwHT64gd&_nc_oc=AdrYmLZL7IkkhbCJtNlPvbVv-pTJYIM48-OTGQH4lUwu4M3PsMv7Yae4t3Te8Vv5DHs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAsjA_0-5K3GPr27n25A_ahXRcpb72afvAfrfuQCZsWg&oe=6A884393"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_fW3A-oQ-EQ7kNvwFMbmsc&_nc_oc=Adozbzzh2QkEq1jxynwR0_gQLjTiEzKT8GW8oT2cyYSLFt6eVmkwzm3fZ0_FWVraFUA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED9VZdEoOX20pwN3nbHgPIRzsKSoFiaD6aZOdEteZtpA&oe=6A884906"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_syTBmhCXsQ7kNvwG7-Nmq&_nc_oc=Adr8X_L8oz3vug8vGoLREdwmjyE25k9TBYoMlANJgMGU7BFSE0NZK2UgtPcbygl_Kys&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNE_meqkdSshkGtlhj4QUZ5RuErg2JTrqu3DpVQKjS0A&oe=6A881FC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZV7LuPfsZcQ7kNvwG-qmFv&_nc_oc=AdrJ_AvDA9FUVYrJbZVOF1bNUH-IYj9wIYGrk5OW6GWdEzhW_P7XS3vYLKWoEXoOleo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-gvInx3ENOQIKOzOJnLRoPFiVoUnSa2CLoA9JeXx5tg&oe=6A882AA7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
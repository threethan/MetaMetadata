1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKplFYVetlYQ7kNvwHcmF7U&_nc_oc=AdpOSdQgBeglkRHR6sFHH_glCuiZ9fhpkxhDrp0_EE8dUREUzWHKSEAcxH2ZBw9Pg3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFecvoPKFcZUcOMn8LYzf7LKWNrlQY6zzr5-oT7kGrwA&oe=6A734305"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bcyWBVr8acQ7kNvwHStAoO&_nc_oc=Adp5jFiIW-wgDl8eY07i6V5uuVpagjQC-otS84pued1c5ZMa9qwZvl5Tgy4MbXFsFKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAw5atrJPPYZrlbuEBya5vfU2_ITYpywbn8UrQlyP7eg&oe=6A732B93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWwJYA5L6fcQ7kNvwGk1B4c&_nc_oc=AdqeQG6MT11K-54d6uDSVZI0o1r400SxHd3RMyP_N8GAban5jvAEYds24AN2NqKSJJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH739Vi4Y19RzU4kUAB_ohZK2-z_EDWoUktF2Ewc5IAWg&oe=6A733106"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ni3ra__S0AQ7kNvwEum7G3&_nc_oc=AdptJXExUsCCri5xckSkHfoIFWs5xhaMBbg5GcVOXIO4Kxn_TtejbDDlAL9i4uv4Jzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH6av6YZpHIoTTIpEw0fnA7jHjwKRrzg0JTqcySh03OQ&oe=6A734007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z51Siemc6VkQ7kNvwGGs3B8&_nc_oc=AdqHqSiyDDVCOnwN1QECWXSTdlQjCx35nyXfPGs7zVB68IKPO8WaKpxtUKRjxMYOGgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMeIWigDNmo_Rfi1CQUQd2-lMRn6FniJhhpynIKzVjsA&oe=6A734AE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
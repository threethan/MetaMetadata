1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJqCGswZG2EQ7kNvwES0Ubf&_nc_oc=AdpHpSLF-IHOYd3xx4p4o5_x-5N-_kGAvN2F9HKek6BVxI_3Ctxtglof1rePVFphWEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMgplJo-qBqgM8SAHvGMmow2uD8EeufodEgMjhUaXxHA&oe=6AC65185"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTOYmc9_rcYQ7kNvwGJk7my&_nc_oc=Adrsh945oKDp42glRZKhLXWmNy95cPufxQ0L19jeoOI5FYhTRdW8F6cXrKUx2A0VKd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdy5rbUAFHM0-SnSpETUl89vQIt96D6mTpvw3vyJ7vmg&oe=6AC67253"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8B2ct27Bt8Q7kNvwHLkXbu&_nc_oc=AdpIJHffmyH52jkJcStpZtbNL71CxbUEW2N5msmV7cpSQRMH4t58IBjIciiPqzng5AY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhK8KOp7v2M8rmK5-Ijof2FZmk6mKWTxBq1Dvzu7gA0A&oe=6AC63F86"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6S4QdfLbE0Q7kNvwEMb_rt&_nc_oc=AdpCHsXqQYqG68kEg53k5bxc-1Ga483HcEY81mwJr8zUTuNbV3pUdPs9oRHeiC3mqCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlSXYIU_qjHuq0f6FUYQe8RuFbSlavYYYK-T1xZ9t3Rw&oe=6AC64E87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk1TWSXY2TUQ7kNvwGeuGFs&_nc_oc=AdrCRRZG4F__LNccPsZwo10ZvjKwbhzao1Z2BjuukCu1Q3P8U92yvKBvfu5BHQF-H1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmdl30Vh6LUXtsScBdBA2MuzSctrM9cT-rf5SGj3xJcA&oe=6AC65967"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
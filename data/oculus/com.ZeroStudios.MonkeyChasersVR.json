71-25/39031643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgJ7EAHh5hEQ7kNvwHXOnLn&_nc_oc=Adpltqv2zZfML0iq1M4v9idW1U1v-LRU6DGRbGjrbH98j2iRXEEJqEMs3YZqZk35l0I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHna7J4h5MINdH5b-ej6q7XpxD9apm744My8AtxT7XBg&oe=6A8EF285"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPi0QeyFUCsQ7kNvwEjSUkY&_nc_oc=AdpdzCxIkXVA_Wwzym7vTNRgPWuH4ohqOtUpUP_9Xj8Ed3ws3cqv1y6MxqFIDLEofX0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuhDauzP0JOIMN1vXxPI0cv44oA13gDsbYEyN6o2vZAA&oe=6A8EDB13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBg_SAia1uEQ7kNvwFamvDl&_nc_oc=AdoJVicvp6Y_n94VYgtTURL6z-kLSf1JDoMlzmc36VqFTL3FdwfbGyq5V6tYK9uCiPs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3PmVNHLwHaqztYgdOjFG7r7U52NR3LcxW6uPeJfARXw&oe=6A8EE086"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmZkFM9C6BgQ7kNvwFVXsG1&_nc_oc=AdqDbQXlkOeddyAd8AegH7GDnUJG3T9MEA5EgUeemF8fvg6QYxnw1aSoZO-muV-EoCU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ1xfkhHWyPi_Yci09rwa7fu3_bPHiD7tIuvdaIzAsrQ&oe=6A8EEF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_1WoGJW7NAQ7kNvwFmVMqC&_nc_oc=Adq9pDAEhUzfRrFMgIIlI2I_C9NznPoQJxl7XAzrz5B-Yb59rosvKryIwmJkotH31v8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdOXJX05Ye51oD5LsGiCLBf903TsG1m-ZnAXv8hfohUQ&oe=6A8EC227"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, 
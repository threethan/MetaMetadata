1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An9Gy9bnwKEQ7kNvwGfx3jw&_nc_oc=AdpwV-1cr5JJF4rlEHxmefZBapb6JtHO51zqdYfHWShVWhJuGPLYA4agxgGzCTlz9kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE7MoDRyAmY2vimQoKvc55zPJ6Ct97ug-GeYkOvgExwA&oe=6AC25D05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-PkUYk0evkQ7kNvwFsKKaD&_nc_oc=Adp4vBzE6ALUoglR3yYdps04cSpUY0osYhsP9ontAVrwxBxLdPU1DY0WCfFZ2BYSnO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUVEUdCj3lY1qmGFJqyFNpipLslN-S255Z61lrwz1bzQ&oe=6AC27DD3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs0Q41n_gZAQ7kNvwElalzY&_nc_oc=AdpmsRjx2Zz1v_3GJEcSXHqQ1V3z53mLcuGVdbdLcRMN3Hh-6DVEUss8xjKw4f3LSkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhwTHJaao1obSU9wkGOU0VAF4avt-tZVPZDLC6S4nYfw&oe=6AC28346"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odNf1UmzH3IQ7kNvwGZoBDJ&_nc_oc=AdpjehJ9zA3ZWOENzuIQLdbxmMJrSury5F_1JmhFgO6tqaoEJt4wOgtrLTUX4GJQXDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrvnw3SzWxVhkqiQFJKBxRMTnTvWCEJ1B04WmJG37gEg&oe=6AC25A07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zeGmMYgDgwQ7kNvwGEPLsU&_nc_oc=AdqAC-Hv8F1Wk7h5CY3NnATYp51zU9FDj6CPtLfZ3Km2YsLV0CYeVszB_oZGhcLgu_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYEM8Z2SFlgc_pMWkCmKenurP_VTTafuWzreLP4aouNA&oe=6AC264E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
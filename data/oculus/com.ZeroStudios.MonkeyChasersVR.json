ibfMMxiQhRaUGRE3i7bm4hWYSYehEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afway9uh0ok9ZPq4moIstYGJZUnJOfg8m8jT3F3qLjyl9w&oe=69BFF705"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abAupRx4S78Q7kNvwGKrhcn&_nc_oc=AdnbWELy4AIvN4LhH_TCPmaNtvPWmbg5LXsCV-hvRQrXkgP2lytKk-xdou30861q2-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5m9anxzHU5OncoPX6BOV6y5_QjFuqTEnLoOtE9lc9pg&oe=69BFDF93"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AvK-y3LLm0Q7kNvwH8_Z0t&_nc_oc=AdkhyWP3aoMKfaIfiAiN3f78NjtFG0N4wgZ0IuBc0GbT-WwqLxAJZXCG9ivN5cTu8l4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl5lQHifJv6t3SWv17ARFB4Q3FUdkegxWI9I0HYm2kLQ&oe=69BFE506"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KncQ-bl88L0Q7kNvwGrTkQ3&_nc_oc=AdmwQs2E0E6tLcihZ2WXzGSmU8oDHoQ1U6RzdTydkjhALilm_1Ym5FT_s0Zn1bRFHgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzymrc_AzrWTfi0c2-gCyWsKMXwH9ls6Noej1M04jmqRg&oe=69BFF407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmG7yxIcbSsQ7kNvwFY_weH&_nc_oc=Admfv4H_UwXyVO7ubN68b7bohUwxc6WDBQQ4cysI0VZUyc6QJLAfSasxHz7ORaksiMM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPQkugjntKT38zJRe4DU9zkQMd9VXYJOMTBUiI6xEtjA&oe=69BFFEE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
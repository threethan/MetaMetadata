.com&oh=00_AfuE3FiEI0xH_fjzuXdT0j2wPku_Iwq4TEl5BwNZH12-oQ&oe=6999BB85"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YFqGb61_LsQ7kNvwH6Usyz&_nc_oc=Admi27lFDKQMh2FPr-bYOP_Asjvdt1ktpT12RCbsHnNnxSuP5oGHA7jKzEUSMWVDbkc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftHyOpgkCYrbzduCcjwOrVFuHp_IBSJCRwDhtuaIGdiuQ&oe=6999A413"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-EzpIBEU2YQ7kNvwGZu7eZ&_nc_oc=AdnRfSXZLzMttqU0TVYMSdxxv4WX-Lul3JjfVCAxrhTIcHf6-85YGst-q6Lj0J3sgrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKTSz7KW5oPmbSMJ9eNJHxHWmGZ5Ti_fbRJr1AXzQ9PQ&oe=6999A986"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWPa4S3KeIQ7kNvwGoXzSo&_nc_oc=AdlvY79S3mlnzRxVQUsdwugNEdqI6EFCCY7iNZ2tWJUi8H3zkqcK-yuQToFrj6YD5p0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJ3rokO4dl9KNryFKAIwRlKc2FsOm2LrGIT1RhiOQnbQ&oe=6999B887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHxIsdJQh1oQ7kNvwGba1xq&_nc_oc=Adk0RaI2YS7C1pdD6s0wMTlN8LcAXm8_5JluUyGNPkcytiSnQXOhX_04ZMpsqKOnmBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4i6P4nqjsLJISGT7hM0_sfvOSanySvDZ2UmhxLKgtxA&oe=6999C367"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1707473176360113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYFoXRkZXO8Q7kNvwFzOr24&_nc_oc=AdoTtQR5I_ZDDULSkP9tZnvZcp_5rG0kurPLE41WlZ7o6LnAysMA6khgAY7c8E83s8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ-9KNrkg9XPNk06DzyrbQjMYW3PWA6RQ5egvGzB7ckQ&oe=6ABFBA05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oYFIYcMC1YQ7kNvwHxldrb&_nc_oc=AdryQjwVkHYaI6xVUeVllTRS3dpKJYbzb4ve8x7HXX6V9ppHVR1Xa0YwnBfaIST8nn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTbdGh26pZi9ELfV77UUXoXGg4dArDb8Dx82CjY6W_ig&oe=6ABFDAD3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqQHo9tC5AkQ7kNvwFHNMgt&_nc_oc=Adqv4aRcJW_OP7cZb5oOnf9uXrZRsbjnrzMQDmN85sk1xpyVqtJlIez5wSsKTeQ1hSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTxfyd9qIVzm6nkOzmjUQ8qK5dY8AwF0aYtb7KIW4hDQ&oe=6ABFE046"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=286Rxx_jDyYQ7kNvwFhx6eG&_nc_oc=AdoRIHe2Vrz2FRDmYevvxx4oelXngaJByb8_Z63W5H6Xi1Xogl6jlSnG72XbLiD2Lbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9QjfAhlzsHzcIdSg_so3kaJZN1Jr_A3Ho-SjVItEaAw&oe=6ABFB707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTQxI3XtUHAQ7kNvwHqQ-pr&_nc_oc=AdrSL4NclK7yDlXx0PezIWv0paZjcJ6O9jAN2m7BFR_5ba--SY3EnmRAIWn85Tvh2IY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIZ0h3IJYlutp2BVx-Zl2ORDdNA50hLZGRzD9d8MMw0A&oe=6ABFC1E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
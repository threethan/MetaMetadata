1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoQvwhNUTMcQ7kNvwFWA4fh&_nc_oc=AdpEh9DyMS_t8pZ0MshtE9e0LQmJV3H4DmSsrLAE6cFC8b4PR3x3lWRLGRsWmm8fF_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdETB6D8Gvz8xFHOH42GjLmb4QfteAD7_5V93dwaJ03g&oe=6ABBC585"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZJ_taUP920Q7kNvwH1tp8F&_nc_oc=AdqpC_idWAlpz3bpchgGF8kK8eoxxN-k8llgJVjEjHBPS_G1mf_MvA4ageJqUk_gtKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNcgwG9Fcqb5aIuTHclJHmz_eeyfMaj3M6cmk05mx-8A&oe=6ABBE653"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMQYcsnwUM8Q7kNvwFLsiuj&_nc_oc=Adqeq4bHAfVgjAS7KTo_gawwptcAVlHmrJk_ijSUNqA-_grscA6cuF8pMvM38AC7vjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFJKp1q8_CiKbyWJWZfMaybS2iEyi1X3oV5EG0DyOXew&oe=6ABBB386"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43zmLH3OKlcQ7kNvwErMOAo&_nc_oc=Adq3G10bNxy6DX4AeKvlHo-dd81SlEje3PqpLVvd3stxjxuj1OoSKb7fElMgD2yvFIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3tYKGa45qCRBzF9Ud-WbubzRyFqqKeajDsVUfiVAw8A&oe=6ABBC287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VYIAbEMxPAQ7kNvwG9fhFl&_nc_oc=AdoQ7KgwjWOkIkD_8e9TydJnkv_EGFwf38JSXe47UDE_anVqGKoZtja4AvZQBAjb7d0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv1oHAW8LuMlxsdPalcezjfjknqyrOMZphOMNWuBpzbw&oe=6ABBCD67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
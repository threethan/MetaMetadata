=AdqKP6SfHWBfvdTyOOwSVRbGGO_gYERItXJdi8qsOt_eEEw0ukGhl_-Z4mYGTPGOz-s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aBpxsCpAcegG0R5jv5Bedv58rV21ItTqKVup6l4IOMA&oe=6A22D785"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5vo2BiE6V4Q7kNvwGC7gK8&_nc_oc=Adr4PNK0jDWzSrsWRhWfURumqF6uJvzhNxJENpKR27FthE2tcd5obuCYZf7m0_s2e98&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b8t7g4a5tLIGM6dHO1fdX7ms6oxmd79zyKpExf97dNg&oe=6A22F853"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXJVw4O9cFQQ7kNvwHFO3Iv&_nc_oc=Adq56v5w27r7nOni3YEi2YrEl1vEQafi-9qpxlCw-HUtlk6_UtmR_Ly-ZO3PN9-yVnw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K0EO5HBBtbJB3nuYYcSH_cxkqbyQMaiiJbrLDc7UsAA&oe=6A22FDC6"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3EnJN1ss5cQ7kNvwGR785D&_nc_oc=Adogh2MpbBeABoItAAB1eKrQhOd_xfsGqgrAoDUaOwXuIt0sUvpMaOPwd7vdaTrUWTQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KkhEFIwbVKZ9q6_JgxYteC3bi03g8iI2c9Q_NY1Ljbg&oe=6A22D487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i47V94vCJQUQ7kNvwEfQuIL&_nc_oc=AdrdwclSKHoks4MzjpLJ01wZ4R5UGfgAV-reDOUPHl65VEujl4StMQXBN_23RugMp2o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hPka9QewZ-CjwNQreuGBdADl6tUVL9SETL3xvHaHviw&oe=6A22DF67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"],
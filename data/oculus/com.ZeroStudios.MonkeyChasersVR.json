dEmIPnoc8Ns1cAL1FffbBJeZnhng20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWeDuyZzGJh21k8LgZu3QdNVKQ5sGjz0sCeA6yxTSmAg&oe=69BEA585"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNXkTAlgnZIQ7kNvwG2hiYl&_nc_oc=Adm8kDUg9LSKgGsyMGrWudPb5ZW99muK6mLFuDQ91ZMMj3FJeaZve3GTiwwmIBW5HEE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNmMCHHJ-1QFOr58kefGiWGiqE7ueBGdK0w6u5Xb0l8g&oe=69BE8E13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AvK-y3LLm0Q7kNvwFpXaUT&_nc_oc=AdmZs28dz1dvlqsl0pU_1lAUqR_JxSO-IfKqjbEljaH3jr1Iu7wE07-phtO-u-dJHow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzU_-MYmyzDOWcVbI82uihaCijj9OASHI069PM-3-cyQ&oe=69BE9386"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD_7YS_gr-oQ7kNvwGqLKfd&_nc_oc=AdlEwC_CcWvA4AuCoW2_U868eeSjQUk3HFPSRTphqD0i-KP21uWg2K5_RezQjB_FDgg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFhKOr6EzYQF3HOdOTVg703yqpAFbdccOsJaDRxS8Lag&oe=69BEA287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmG7yxIcbSsQ7kNvwEnMt-m&_nc_oc=AdkxMCvQfbWibIT7voaSzCC5chB5M2pltEqf_NbZYpPicefxzEYlIXinVkL-rlJZ498&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtvM8-rKzc9iwWMrmGpq19jgdzqqoA0QcY-HkVSrFb0g&oe=69BEAD67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSGxxvkg024Q7kNvwGo4DG8&_nc_oc=Ado6ywTLpPDtKmTIgjOdPb47Utup-sNC77oeQUjPWQslyTjwXWpC91jc0QkOG9Zs4a4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiCumR2MBaK7Cg5AtZZWtfGP2MFKSXanFxs5q19YknnQ&oe=6AF1D305"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkEGhMcIHi4Q7kNvwHyrtrG&_nc_oc=AdoNV8FIiU-mhclVHUMrUnGUn6yUXxkCnTkZU0KQfgEpTTWGEnRsBYQYkGlIY_Y4Ivc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTtx_zcr-CaR9eeFBqZdDnmfSAfVDz_PtWuj3_JdENbg&oe=6AF1F3D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UAPKHQUfIEQ7kNvwHTiFGM&_nc_oc=Adr2AgW8N3Rli0axAsG6HY9UedI2dYH2DDVmwuKmurK868Vg7u2YdKkGR5Hsd08T1a0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCSG2IIlAWZwN_3KAKhMh1TXZzXHXEGd7HtxGxnhRSig&oe=6AF1F946"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbQyL331s2oQ7kNvwFQBsqt&_nc_oc=AdqvsKYus6fS28d_a-0ktivbhznAQPIgV3-sJyODsHCXKDmWhpwpIjMMX0cOo4Qg1XY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeqFAeWhjEbHxrKcBtUphf9zRlHKNnLnkXoClYP4dyAg&oe=6AF20847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_1s4gXFq8QQ7kNvwFYbyOK&_nc_oc=AdriKDEB2Y554BWvBYcTBh9CCG9M7sSTSChJuQt7qdPvYz6NTDgcA37F2Yci3GDHH2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFYLVsaKibriki0s4XTMuxvxl7g7wZ6kSbXRwJD2APwQ&oe=6AF1DAE7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
1643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqmaS3Pozx4Q7kNvwFLNl-I&_nc_oc=Adr6rHgxtTh7bQsX7hpALfEq3DuE-2ABGWzoufZ2mRhF5mMzCpdT0FoiZWYY6-oIhIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp30lroMHfrLmCuZEvtAJQHjvgW08RK3iX8S3TNFLbow&oe=6AEF6845"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFDkhbpZ9YgQ7kNvwESHsLC&_nc_oc=AdoqVW0SCktCavI0UDpDON0G0BkxaBeqeIyUr2XI6urxRfLkd9JAS8sG9MMybxcKQOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzTslCD-BG1b4guXoWFGFJ27rb3OMYzFiTvdAiM2IK1w&oe=6AEF50D3"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VORJlwIl4VgQ7kNvwHBl5oW&_nc_oc=AdpUqHL3k6-_HGqBpSf5qvkL820PkNoWTveQcUIa8tiBmWnhtNZNjPsjawDv0eOISW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR80k3ftO6IMSbTHm-WhjsqEzTHMndLwvWc5_q1SrCpEg&oe=6AEF5646"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc89qARgSEQQ7kNvwHDssp_&_nc_oc=AdqWvrRoBEA-Ih4oUlg85G91n5B2LGo_y1MZtKUG2A0sIVxRwi8CbCWyEh2DabuAPVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUBpl85lCltGvzbU1JkjijLohGmEHlGJtftQulJDtbLQ&oe=6AEF6547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZbmeyGlBSAQ7kNvwHS2c3L&_nc_oc=AdrPssURffbWMZ8D_BG7-EyioQZa5dCPhTo5fcBPBBEy9MYAhBCgTzBSkC2bUxbzdZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc7i8Bh7VNbZi_vB5bNTx2Wr80aAqLdz_n5RBE82S_PQ&oe=6AEF37E7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
.com&oh=00_Aft_KgvB1Zk5mK4VCa_hu4kzzdYQwr_LsSJBzz08oOwvpA&oe=69A1A485"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgbztTjeDIEQ7kNvwEOMNAn&_nc_oc=Admqb8aIhBO-AIr1gDKNQ348LnVdtUDjPTAXBF-b8UoKekgXVRNAzD-ns4WCQalzMSA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsyowvg41YscC4kxi4WFu_emlxF7b73hBNHcW5KnVCiSA&oe=69A18D13"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDcLevB1YHQQ7kNvwHhIAAJ&_nc_oc=Adk9LwkxBQEIRQRLQis2fBvfrX824HPL20mZ5ybdD48t8wOCesrzkKL3SmtvDCqSMeA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfteuFhBci-7651idBURvtEgVUQrMac6joxSHWgQY21gCQ&oe=69A19286"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dy2JrhCIO5QQ7kNvwEu85Vq&_nc_oc=AdnJSF7-oHF4peT-dv4rEg0a3FLNUeQ1sFlOL2Kve2ikGesjwZdpP7DbFf7Iqtt6osU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs9-FZC3y1xZDAelk4x_-BIgVIhXZENUDvPgG0PPYRj1A&oe=69A1A187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsLpe0LZIS4Q7kNvwE67J1a&_nc_oc=Adlea1c2IZmQO4rLgVc1_YdCxxvUC7GqCiNaPVYLzksN6Q09Tkth_Bnv_vCXttPbJM0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft3Lf1jReZoKhYEztmpUNryqZeC2KlckyIyDCLiOqQjLw&oe=69A1AC67"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1707473176360113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
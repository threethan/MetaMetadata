5/39031643_195190316661467_7270701466420662718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39N-qLa9JIUQ7kNvwENtFXH&_nc_oc=AdpGrM6oqR1qFf3dFMfS5CmKzqZGHWmLjjf0KCpF5NHdWirSl1iytsjqXF-YnG2y1hI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX3ItenHQel3zb_zn97-jI77SmtabNHRsEsRPhwkoKCg&oe=6A7DCF05"}, {"file_name": "applabphoto1.png", "id": "162428536487551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566685_162428539820884_1480262513992233524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSwkSGSspZAQ7kNvwFjBShk&_nc_oc=AdoS_GzgHzzzuPtAD2dWUHcLooWD21hKmsLeexwQBp_DOXpuBeNp7e83Uqqh9rf3dow&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO231HUykGWi9XhSVAHJDr_uGExvbl7u16J8BUccB7rQ&oe=6A7DB793"}, {"file_name": "applabphoto1.png", "id": "570000955199841", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982716_570000958533174_6500966283419905728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQlDeu1G_h8Q7kNvwHvYH8a&_nc_oc=AdpJx0irp4sEK127d8SmyEEtqgW2yajtAEhCx4NjAvCXZcob-Dp46HAg1toWrO6hEgE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBowpf0ZWLmmNMaYwBwnABYo9EBsz5-K6haDfUFqDQFg&oe=6A7DBD06"}, {"file_name": "applabphoto1.png", "id": "1911894462517883", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982644_1911894465851216_7497401258512777597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIZ0YJe-d10Q7kNvwGfWGnw&_nc_oc=Adran0gSeD5AyFVT9cfyyCVN-ln4OznfOs_KS79t6cYrdSOdccUei14RCoNDGBIPa6M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHosQ-mLGv_0tpEGHBEP1hgTwCFN_6vzzNyyBCES4CLwA&oe=6A7DCC07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applabimage.png", "id": "1956101441419456", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001724_1956101444752789_6204534661575219481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4xHJzBJKvEQ7kNvwHKDcTg&_nc_oc=Adow10WUjzr_uazp_XmC9-1KkHAyhY9AWlUqqoN26VwzhA45fFv73MPAWQXGtS2a_pc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNTVJTmvoO_hBZzBQu6_UqlRA4PlOanAamaZbXmDd46w&oe=6A7D9EA7"}, "display_name": "Monkey Chasers VR", "keywords": [], "long_description": "Become Monkey and Reject Humanity!\n\nRun, climb, and jump in VR using the unique Gorilla Tag locomotion method that only needs the movement of your hands and arms. Push off a surface to jump around the environment and maps.\n\nThere are five different maps:\nThe Jungle is the main map where you can jump from one branch to another. \nThe Monkey Store has cosmetics as such to put on your monkey.  Zero Gravity is a map where you can swim and float without gravity. The Beach has slides and places to relax in the sun. \nThe Mines is a \"different\" place.\n\nChase monkeys, parkour up trees and cliff faces to evade and chase monkeys down. Hang out in the virtual jungle with randoms or group up in a private room with friends to hang out and play. The possibilities are endless, just chat or make up your own games! The movement is easy to use as an advantage.\n\nBecome Monkey!", "short_description": "Become Monkey and Reject Humanity.\nWelcome to Monkey Chasers VR!"}]}, "developer_name": "Zero Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkeychasersvr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkeychasersvr/terms-of-service?authuser=0", "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeychasersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
3.png", "id": "1074895857368260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQJO96bvuE0Q7kNvwG5tjFD&_nc_oc=AdraxDbWL-Gp1cjgIpXfcFfzKw7I2tQtseRscqPPcXg1qnASUZtZ6mSVlVpQKI0L92w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5Ulmkxp4VGu9b1LecjEgZsBLHPvD_lyMpyXXMC1I3Qg&oe=6A53A6D7"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byrEZDSVb_wQ7kNvwHJyD0x&_nc_oc=AdoCE_bWuYfZ3pi7mlfwJ-DJh59vkkd4BBCv9npOBOSBrKWWTZ3lzVyNH1TCDbkFOWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIjGCLNIEtvt3nQnTGnfGc40oiNnBr9Na4-038AxsxGw&oe=6A537E7A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qR1NLPmhxYQ7kNvwFxJYL0&_nc_oc=Ado6C7VHAaa0zDOFep1tOaQapt6WzxxMNkLHeY-AnLFNj0OtyL-GBqK-aqdTZI9eVgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUDOW7ijuZPH_JvS_4OGmCXmBHWIdQaE1K8whJIpzrLw&oe=6A53A1DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7upYp3BVwMQQ7kNvwFy47gu&_nc_oc=AdpwaqPpg7zacgONmSidIYPfmdnAAil4Xtc7t42SfDhcPjH24DIB-EQ6z61J73GHX3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFSfgT6jbUSBuZTrLsDGwct11CcbwVO-oC06_1PGRBDQ&oe=6A537C62"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions to unlock each new world.", "short_description": "RUN, JUMP, PUNCH & SMASH your way through over 40 levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy.html", "developer_terms_of_service_url": null, "publishe
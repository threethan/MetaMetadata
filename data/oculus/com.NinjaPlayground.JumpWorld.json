8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OactXsjGCvAQ7kNvwHam1oX&_nc_oc=AdqDTSMFUUMjnJBGXOHSk8naL7iQAoeKHv8EamBHhUBYbW4wO-aO2t7M5TwJxMHU6Ks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCijrup88YC_f1QqvZWxt1iMFHDioO8MLEIIrU9QEIhQ&oe=6AFB1AC0"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPG9tYtUN0UQ7kNvwF-1Vsw&_nc_oc=Adqi9a8pMxGvCC5R5I6QCOJHQu-ezUozSu0OebIwXrcexkyhwzuAtrDDxW_tAuMDA9c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLLhu5YNtybSltmMKJuJZoFrEdp-jxtYdqoiPwjJ2tUQ&oe=6AFB1557"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLrtGSa3TXgQ7kNvwGlC1Tb&_nc_oc=Adp7mXwLhkMbQQoF485VBHhj6W4lK1a4wCcA_25bmvJ6eEdzEryOqdToT5TW6Ew1xtI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6in4oI9YqNvexIKGmBP6mCs8SuF7C69hrI3vI5j5_Aw&oe=6AFB253A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrD0Uu577hgQ7kNvwHI-eXr&_nc_oc=AdqXem-1ofEq7yuloBwIUonCJYJ1BHrLprVWP23qjqbVg8bGhi2CAkc19pFMv4-kBW8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQhhAwwFirv8PF4lhSn0o4E10avuTxXDthR6pzEyBs6w&oe=6AFB489C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC6RXV7pxO8Q7kNvwE9gqgl&_nc_oc=Adp1hFmTpVk8bs6XoEhEh2Af3UcY3Jaa9SmNNyhG5XsekaUpa0_CtWYMI-P_IlsptY0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRztRuBUI0wU9mWWB2SWTr1yj6uGi7r3MVKopn2CDnvCg&oe=6AFB2322"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
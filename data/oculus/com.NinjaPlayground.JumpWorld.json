8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j6sDDqBHDMQ7kNvwGvAVOk&_nc_oc=AdqhCfcRY4OEVo47tkQeCWzquRax2xXToDg3oD495TBFgA1cDwCaLiZiobA4ZBjGvrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_rW5k5VgUYlP-h_3M_b18ENbtkV0bgZpUTwC7mLan9w&oe=6B0060C0"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ3HGVpfMRkQ7kNvwEWetfx&_nc_oc=AdqXRdC5Zc7PLnaJ3IwqrM9AFaGWqgELLGwO4zNFpxIYhevASzWqElBL7XHRjsDeuG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBqWLSGYjoy7Wbf61xo2JMgkJIAVqrrwyKtyO6Eh3yXg&oe=6B005B57"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slfYkC4YeEAQ7kNvwFrBtXi&_nc_oc=Adr7PfWRkIExeevGaUoibZf6_wBlsFcqrEj9JMbJiTFDcY9K-8I7Gqm1c1OuL2Fu9KY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8rGk2GI4k1R8Jg_kGekip5V0NAw-x60TIw1XvLjSQUA&oe=6B006B3A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQJ8wrBGSRYQ7kNvwHmcrFs&_nc_oc=Adoc1uukfMesw__weBz5heSHNtKotQeeS7KoZHUsiR2et6iRXY-cc4x4i_qLTxPK9-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbmD_uOYIDST72HSMorLZvPkLtEdYmHa8NLhmSL6Wg6Q&oe=6B00565C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akdH1Wq66s0Q7kNvwEuYzgo&_nc_oc=AdpjvW--k-r2qMLulKpb70TXnfxrYUcRG2YY0u5g72s59mwxNyBn2XVdDiAyq9ctlgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR451S2JAqEb0EvQUtLJeteNH_rGKM50a8wHKOek-YRTg&oe=6B006922"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
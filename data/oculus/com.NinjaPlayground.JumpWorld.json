50341165404444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8qrXEjWdDEQ7kNvwF0aibw&_nc_oc=Adp-tQvxh57AW-lBtNoF62pU1JqEQwIxUVg-6E8ZPXojlOtDFAncSf8mbG3huKOgbzQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfRgTnM_N3a6tzrqKm572Phx4dqT0kFv29e7_OZaFRPw&oe=69C7AF97"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS75qg6smxEQ7kNvwGsufxN&_nc_oc=AdrOaVoLF7fcaehr05fyuXXs__MAvoSuEGMpJKsr7VWI8FrzDZPnlAGPEZUBa63O5BU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxs1zGUS8UhmQd8UO-mWsaRl3q_e6QaoWiJqiY6acgvPg&oe=69C7BF7A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eglpJBFk2IkQ7kNvwESHjkR&_nc_oc=Adq3lpCOrJTYC7TJIcwqYO4TXJHF25M_5ot_qxGusKVJ-jceKAjOQMdOwBk73wBP2CA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzb8IDbozBu9ZbJ5gHeTrTnS4PavXJ1SvqAcLP-mqTQjg&oe=69C7E2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdunhoWQ6eIQ7kNvwFK5ZqP&_nc_oc=Adr0tOHG4YOzLtO3aRhhXz0k0NbEKOFfV0bEFEDjMrlqzH3Hw6E2zJgZ3Uc1d-bMVKQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPdxYDJ7vurDj80OP_PR6jeXim9mV1ts9avWSBlROq_A&oe=69C7BD62"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions to unlock each new world.", "short_description": "RUN, JUMP, PUNCH & SMASH your way through over 40 levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ludus Vision", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "c
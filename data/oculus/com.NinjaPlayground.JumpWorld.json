50341165404444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOeRRFhhoKwQ7kNvwEvhBR0&_nc_oc=AdrFsbVkw6XxduiRXRusc4-bWEt3U39Ji55No-azQd08XcRtXqw0rQItXXx2WC0k0H4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rDNyzCuZG7-bqKq8tylc4K98IXO_Z-04KSO1dJuOdyQ&oe=69FDF557"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyvNITtgo9QQ7kNvwHIheD_&_nc_oc=AdpcU3n8kHSht5L6Ie5MOhAAw33I4WXhPESGY6DUoOwzJc50Dch0GW2-rZ3QoZ4PnG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GxSCNDJ90fKV2Kq8yy7HzETxNgrxbCxrDOajDxq6Kiw&oe=69FDCCFA"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBTQJ66trxEQ7kNvwG4rB4_&_nc_oc=AdpLL1LvtR5Gv-n8l6IVLbDjFp4CkabM_5DcBUbb38xXF-0rLQSrBayuDBlRzsZtGd4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-iqJ-jU-OlfnVVCyKrMBopvF66Ek2QHHTemSY31jZ7Q&oe=69FDF05C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY9W3EP173wQ7kNvwEzhpav&_nc_oc=AdpTxrTt_KufX7nxrluIksYGqgtMIMZJXdlux7T4t1DFG7syhGqOmeChhNXY0v9aS84&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qKMhWTcLpRnlykGxMLLco5BuOiyxpKNC2_OiHSd8Zlw&oe=69FE0322"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions to unlock each new world.", "short_description": "RUN, JUMP, PUNCH & SMASH your way through over 40 levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ludus Vision", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "c
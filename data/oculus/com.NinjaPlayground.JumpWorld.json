8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j6sDDqBHDMQ7kNvwHSDpbg&_nc_oc=AdpR9DB7ceTjk_xr0iPHSQrpEhaY3ASMPpc5CLmKd8A95Y_a77mSGWPCLg1rZHdiFqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBc7BU0PRQcAbCAY5xqejJGeo0iN6oYuQgD_gn-KG5Qw&oe=6AFF0F40"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsgF9FMrziIQ7kNvwGVr0G9&_nc_oc=AdoEEPYFp3XcgkxOutCUyrSjCOZLZhF5BsIlhUC_QHnACGqBoUGjeU4FEjoXsgZl_K8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD_MGayQ0hbosYvgnQSoGvEYFt_Bswp1uyv1N2x_9LKg&oe=6AFF09D7"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slfYkC4YeEAQ7kNvwHixZxi&_nc_oc=AdqiGLtwuIPwnEDpy_ETR0AsKGaj_YbIXYFruAl_IRbYIWZDK7WXLA4D6reiRkbG4k8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoeAtMi-ZGVT2WNFke-0iZ4mBWsCTjVZbesgWG_SPg0A&oe=6AFF19BA"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiMVUkOolgcQ7kNvwEObTxM&_nc_oc=AdoNzwXC5zjQRGAj-hm2q77beqwAsn5Yqerb19oLk76epwsV2qh918n0oft38Nm54zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9QDxvar6GaTviOl0ZqBfusli-hbc1cUdecEEknRuVEw&oe=6AFF04DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akdH1Wq66s0Q7kNvwE7ASXu&_nc_oc=AdpiPTR85Zi4QBemnXgaU7a-aI_PjP2QZ9pACOjiqXBzmeVBarG9tpmLOOkDSGVywl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdGdDnavfv7YpZzxDMxPesdVE5gtT1y7FoD63z3dPYrQ&oe=6AFF17A2"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
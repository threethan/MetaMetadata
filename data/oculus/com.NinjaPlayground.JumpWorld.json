8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTayqpHI6J8Q7kNvwGIPLrP&_nc_oc=Adqh2OtU6Dn7U-_oq7A2Dk8pfExiXw8gk59-SQZsyp5MYiuo1wjdcwQ4gwrCnphPTVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPV88XnTIUdLRgfOi4e2MCdg8sCIjVvK6i-uSGuvkALA&oe=6B01EA80"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ3HGVpfMRkQ7kNvwHvq0Vj&_nc_oc=Adq4zNgtC2JKUXFVXYnOumYzRFC0v9QZRdziDYez42jfjxMpheX4CHw7dPCD1KIYm6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSppY9-iwhNJs_sShDhfW7PQOy0z8hlpAfgh1x48w0Fjg&oe=6B01E517"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8PA9SCHewUQ7kNvwHfg0na&_nc_oc=AdphmvCUhhP90o5jqa-mlJatpOVmjA0l304tS-ZP8OVkAgxhAidpmYwtcJuTTlwJcYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjFbzBmhivlQlHDJhFwlEBTnrNOmgkyrXgWeH1SRVbMw&oe=6B01BCBA"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQJ8wrBGSRYQ7kNvwEQX1C8&_nc_oc=AdoUpm0n1HxwQdpbdViVyTxBU3g_mLBz_8zi73nZR5Q6HhQzNqgpLMN_LWo3OgRfLj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQhDNoM064qPerfJ5bUPD9PTMh1WjQkkmlGkhxvOMH0Q&oe=6B01E01C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yNi8bubr1gQ7kNvwGHhzRE&_nc_oc=AdqxKvC2be2ZYjHmXi0RdlQLIV4Wbqrm1O9HKltDyU6NAB17ew96uiTyUfvux1ATIMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw9_RE5zBZ8qVs0mPrtLbdfaxOWuRVfNbOOgnXz4LFuw&oe=6B01BAA2"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
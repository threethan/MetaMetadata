8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTayqpHI6J8Q7kNvwEYl6uv&_nc_oc=AdpjBbCp4_mSKykIKD17LbV4PXCBoukgAm-4-YSJEzh_xyWx1qVdP4PNxneVBBFiL50&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3On0hVAK6hNRZbkxj8y-kVWSeIiMj-st23cFQClL1vA&oe=6B0303C0"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ3HGVpfMRkQ7kNvwF96fRI&_nc_oc=Adoy7pzJHINamAz40xDAQEr-iszpNj-y63GwmPvuBG_RmaJOxyoK-i6SZYi-bUn7Hr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrccVCPB_nRysbp-wvOVTWvt7TlZzEm301-OYa0CUq5Q&oe=6B033697"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8PA9SCHewUQ7kNvwFctgRv&_nc_oc=Adodzb-AqkBfcVoZtlNpYuPENF0qUb7ZZIVE_x7w9h1R4VoHpf1AvZqZQ47G4XdBEUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmpB5haM1gT-4iro3LFlBZkTcGbKHpNZKjOY66QMI2SA&oe=6B030E3A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQJ8wrBGSRYQ7kNvwEhDRF5&_nc_oc=AdrjM8G7gHyL_0ANatjf3mrG4xiItcfI1dILhi6-z-M-BeYBXPtva6uDcwqAhWfKMyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCZQH7dRFkzyg8drDChIJ7rHfjAtO3Zy4EQNUvcdyArQ&oe=6B03319C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yNi8bubr1gQ7kNvwGuEMB1&_nc_oc=Adq-LGmTENq-uIIPB_KkHaHjy0ICEmqw7ob-fpwn6jrNDFl-i1SjYXGRXiL_c4i0UYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBtC0OCO88rlAo5jM4wVN2eKd_9VUjq1ommwpfSDxiOQ&oe=6B030C22"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
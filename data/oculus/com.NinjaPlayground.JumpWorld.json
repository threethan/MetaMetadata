8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YS05_OhjWsQ7kNvwH0Zuba&_nc_oc=AdqCjVeds7zInsEoMPpjfHK7wzb-IEUXLV95iaxEc5B_lyR0kVwQhe_h2DdFu9zJr9c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMpfig0iaye4gw8-K9SkLiW7Ukgk1V7_58lzxuGn0TRA&oe=6B0849C0"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqi1Dz6jB8cQ7kNvwEb0BUd&_nc_oc=AdqMmfkcfLAZu58EgnHyqIvTxaq_6608LnG-r8JgJHTmSF8Z_3vhBxm8Dohvr37ZxKU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPDP8etH1V99hu1Tyq2FZGPpfNtH0tau1qcd6q7DwAPg&oe=6B084457"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoDmcf0DkNwQ7kNvwFqdTug&_nc_oc=AdomhJm81ZZaeUImtUJVJvQr68uohTFvXxMGLZYbplRmPV24u8sDrmEHeMUzb_fmx0E&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLk7-sOQQtaLHYP5UlUuJwK3jcEgKRlEbjBOMlYBQCJg&oe=6B08543A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6jkoF6n-UIQ7kNvwEB1rz-&_nc_oc=AdoxBvZ7lXLjMMlRtCH5eQoEch8DCN_wh5Le6MumAONaUL-fsYoCsUWw_uNw_dJtxuM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRztPBHT-O4r9F-vNZLkHiwjPDSpF35h1sOEaGqnT89-Q&oe=6B083F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=380tGfXCa7UQ7kNvwHls78O&_nc_oc=AdrNxIcVE1RSzrqseNeaElG7X-fJOAJedGlWHt3RckrJf3g1p-uZIQ9PMrw2rdExSD4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgHUIBRu9fxXg4Gt-Cgi9HaYYtdQ_itdn30Lof9xI4Rw&oe=6B085222"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
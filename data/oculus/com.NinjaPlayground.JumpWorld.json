8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTayqpHI6J8Q7kNvwHg3qrB&_nc_oc=Adqoxg0W8_OFDtyNJS3Sxm3TEx20vi2NFaP81Lt_L0j3hJ5cJeGO4ALmdJin-pEMCz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1blLcrIsLSZFas-Itg5gxr_B04lKJeS0y5XuOIGKmZA&oe=6B045540"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXkFrwOFCxgQ7kNvwHEX3Xs&_nc_oc=AdrJmW6ZpAOaTw-njQKWk0zvdJw23-0G-7qZ3gJ_p3fcz6FlQSoDqI3hnmCvk0QcstA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgNcZ2_jVqa3m1SwXB-_yRkbV-he5rITcmaiqbuEzAxw&oe=6B048817"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8PA9SCHewUQ7kNvwF1-xNZ&_nc_oc=AdpADtd72oBh55C2B9Ksf53amcDBG6GL7MQfTzKuQXxVrPyA4authxjcDv9jkApZ2mI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnh6fUIZlsxS5-au0rNeDSWIXE8Wzjeyh23PMgYvN5yA&oe=6B045FBA"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p4ID17B5qEQ7kNvwG3-12K&_nc_oc=AdpHlkVj7he9uRiVi9rTjQX6fTO7fpbAKNUvWL6MycON3HOi7k2a3dlMbrnt9y4w7yc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIGazXsj5gaSDq5VF_tc2ihIMfjnTnlDaz1h1IGRO1gQ&oe=6B04831C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yNi8bubr1gQ7kNvwHJw2-I&_nc_oc=AdrjGrTVpR7vCtRk98OlsGa-9mNDDK67BsVhCcGindrooOPuMSaIaGFwxwEsi1Sj2gY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0QogDRoNcueb9NysH8z_1flZSyObAjhDEm5jyLwJdAw&oe=6B045DA2"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
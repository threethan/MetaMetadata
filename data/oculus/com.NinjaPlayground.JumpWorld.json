50341165404444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOMRi0fNfpQQ7kNvwHqHjXB&_nc_oc=AdoZUm8sspBTNMPOJfxPx-RoXNJE4qyKk70SySXElHlQq29p3CLQMPvdo6Pz_uVpw_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H8Pt2JoXCd4i967k9Jar4FmpK050VyewpRf79aMPLkQ&oe=6A0B2457"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRDG6pELSewQ7kNvwF5pc6G&_nc_oc=Adqux7zZQDGE0XLtFKsOzL2mB2kBSS07npypejhCnwUR0yvFBPkt5bATdFTcrurq__U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fNucQ15_pD7aCJ4xqvcQQ2njvrLzegj875-8B0pTSqw&oe=6A0B343A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9gowiN7gKoQ7kNvwEzXwLr&_nc_oc=AdpSEmi-AbVPYk5-ov69zC8eWxEjqBu0nRNcVShK2uI4VRUpsW48HbIxhjR0mrUEdLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oAkkOQiYjVKzzMMGPSUhEMYUYtooCrVxS1ENKZEka1w&oe=6A0B1F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PnGw5W-uqcQ7kNvwFkUHKH&_nc_oc=AdrZ-2V_qQiVXgj0nNOB-2iYVyvKC-m9QgkoBnz7ai5xLtBAbFouQ3WeRdxaacPgEEE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DH3UTTCyJt4oazxzSQs1OHjPYvWUn_7WCekv59t-zyw&oe=6A0B3222"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions to unlock each new world.", "short_description": "RUN, JUMP, PUNCH & SMASH your way through over 40 levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ludus Vision", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "c
8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OactXsjGCvAQ7kNvwFrsQQr&_nc_oc=AdoJOrKvTNnteUylN6ecN4De_5MnuqoU1-xK5a6dA7Zt9CEJVJa1wP2xbLkZ-weGJAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIGkwIDWNcMtHt6kQxy-oh80h5FcMMM_GJmsZ6PEY9NQ&oe=6AFC6C40"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsgF9FMrziIQ7kNvwEEr0D0&_nc_oc=Ado861Xzi5CX4frlIf_C3Sfe_c4IG1Ro79Ck7ACXPErGeKaQayiG71D_pvHyrdFEpto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgflYda5hdlHED_Lt9JdB3gvdQUCcb9Un8wZS3cxnXxQ&oe=6AFC66D7"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLrtGSa3TXgQ7kNvwEwuRe8&_nc_oc=AdonTxrMV9imiRM-FYyPkN9LxWcu4bK-kC-9d9rkMIR_b26_9ZGbm-D_hola3df3FnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW4ayEzNh9KLTWL2S3ZqtQ_YGsd-UxWt1mGVWs2zktJw&oe=6AFC76BA"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiMVUkOolgcQ7kNvwHv9OPk&_nc_oc=AdrXET7TxfrdPK7McfWZ6cLyL9FADR9z5D6Im2n6lbF_PxaujrNINZfm4Vf3kdngITo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyD7SPFFLZ5VjFqzhrEOUHRfG0tgvY1BBEz-xKmwkvrA&oe=6AFC61DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC6RXV7pxO8Q7kNvwEX6Hkq&_nc_oc=AdqRXz_r-RpqBljfYecc5akGWkf3xV8jT8RMyhvk4LA6oDnmb1gcJyuLoLBXIzap8Kc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGAmcYikgwF8Wa5YHttrCPazBf_YtG2hznB9ncR4o3mQ&oe=6AFC74A2"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
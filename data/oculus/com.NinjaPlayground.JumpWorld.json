8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j6sDDqBHDMQ7kNvwEZxlNj&_nc_oc=Adr128F72wMxWloJVmRi1fC4R5YTHP38nWd4oWC9KTaf32z9oDxUT5iBFB-k3w-mxR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX5E10GeVzqxsZUb2Tl2HY_ZeR1bjnv7lQcVclfr4EZw&oe=6AFDBDC0"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsgF9FMrziIQ7kNvwEWLEE0&_nc_oc=Adrdb13y7Mnob08CZ1xqq0GalF7kG2BIPSLy_Ejr_ysEP-evFmu-G9gGgXqO-9jGxGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD9g8tBii8E9Oc8Cx6oeZLJwbrwNPxiS5qyM3aiuSRZw&oe=6AFDB857"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slfYkC4YeEAQ7kNvwGfr2vE&_nc_oc=AdpJH5XZq9jOxqT1M6hBtIJg_HxUbpUXc-hKXe2kI0tuF1WOwqTJKVncaKMPJtwZ588&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD-1xKSIxK1I1EjK7OEX59R4Y0UCSzMEbNzwGXW_DSAw&oe=6AFDC83A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiMVUkOolgcQ7kNvwGvhIQK&_nc_oc=Adp0S97WNYOMz_4OLZjHcKAKWla_qrB1i8-UZSahRRMJEUmlGXSY1Zq-xJB6ocETmIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT51rTpsKoYyyzMi0ObOEkAh8_54TKljii8js2DLaoyRA&oe=6AFDB35C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akdH1Wq66s0Q7kNvwEgGRQJ&_nc_oc=AdokuZs5qjdhnTgzLLo-18pg3uU9pB7ZeKx6Tf8cMoIrfGldElndxfQd-JMQvdbn2Uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVzPFEqYWSp8Zd_3BSQ8choJ5SuirtLYaQyRoECHuDvQ&oe=6AFDC622"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
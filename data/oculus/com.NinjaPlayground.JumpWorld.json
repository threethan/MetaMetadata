8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg15ETI_gHkQ7kNvwF-woDP&_nc_oc=AdqJxInbzmi5HCrm3rJjzT5ets4EhA1VSaKTxiclsfxA4JgUm-B9gvxn5HkEaekWWyo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMQRyIBuA2Zr6sh3ywP7p8nM0MgMG7rA0DKOo_8eNjCQ&oe=6B099B40"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqi1Dz6jB8cQ7kNvwGyd_3A&_nc_oc=Adq9AHfnmHWeauETZAiLN1S67RaZE7Rw2RWm7ymcq5xzZMEzzgRhGmPsSEqB4grIvTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTobdrBOceyaAQQG6K8wy81IvBEPvI8y88s_H-GjTKyvw&oe=6B09CE17"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gycxXifV-ocQ7kNvwGIZggb&_nc_oc=AdqsxExnWAjOZQQGh-S7iNORbHDfsNbLHY1-B7F_h3iBAKoPVOmJJoj5aUEE8a9u5rc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFsd9yMzncDaqJPI7RwiRejKEoNkB0YkEhkoMAYgaGag&oe=6B09A5BA"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6jkoF6n-UIQ7kNvwGjm-U3&_nc_oc=AdopIeYWJ1HNC-nLYu9V23bBq7LnYOCnsDPN5c8mIgBSa7QdFFYnIGnOv53s0Z49Pgg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRohLZIh1i_QZIcTkK1Q9J6SOTDiYtycIpnRcKDBmD4Vw&oe=6B09C91C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkpuRsBtKwMQ7kNvwHNTGlf&_nc_oc=Adp41VDMCrzkcnR0pfpeQ64FtpEoS_Bi54xLV-MkDCFZbF4jjyj12Fd1MNSUDoHY4tI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfs220FPwQjzoYK7MkD3cPNKEdwVv_-EX8isYlAfoEeQ&oe=6B09A3A2"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
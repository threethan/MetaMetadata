50341165404444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOMRi0fNfpQQ7kNvwFhNsUw&_nc_oc=AdoRXbwzNjENz11mOzZfM73Nv4lK0IRTrrwArnsIwOVAfFB7GJnqEE8z8fx3PLKa03s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OFPRFJU5P8EYpRtaGLDi6fmUyMa4r5eae-i-EGFNYig&oe=6A0C75D7"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EC3oPiMpwAQQ7kNvwGdAPxR&_nc_oc=AdpblVA7aAkLFx9hyNQRCnUIAYXeIfigdq2hBwC1RtA420tLMRw52-WV_FJURXs-zNU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79zdWy7T0sVusB9_MmxA-C4NEU2Kc06iIptGQTU9dL_Q&oe=6A0C85BA"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9gowiN7gKoQ7kNvwHuKTrT&_nc_oc=AdoCx_vh7X5ZwSFhfYLFZ68njwVWB4nPukHO4OSAqN2NUzZO2GnWGZfuhYon4LstX90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RRHhtCItRnaHBZjQDJe5dQoU8MMz2lhhkkXzsh4lp7g&oe=6A0C70DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaApmbueteMQ7kNvwHOEgHY&_nc_oc=AdoRDnsvivlWw5DCAI_slQdUDfFr2WLbD1OHz72kN8r22amQWWX21EMbQBcKcCNrWK0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JA4a2xZ9trcjkMaCtAD2c0Xy9qHBJPTLpEf_H5zVXFw&oe=6A0C83A2"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions to unlock each new world.", "short_description": "RUN, JUMP, PUNCH & SMASH your way through over 40 levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ludus Vision", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "c
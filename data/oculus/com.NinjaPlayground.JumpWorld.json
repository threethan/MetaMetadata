8222185_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v7o3GA3SNoQ7kNvwFqZUtD&_nc_oc=AdpFXzg4rfqzk1s0rXRQsw1DhfX1cbC3pd5ia_VyyfP5P-9n4nqA-Mu7sUqZ5W9GLP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUsGFVkbmhqUVQHae8ZKleDaAHa80w9Ucs02pY8Yv55w&oe=6B0DC800"}, {"file_name": "Screenshot_03.png", "id": "1074895857368260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610711_1074895860701593_7275850341165404444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URsxBaLKZzoQ7kNvwHtTrt7&_nc_oc=Adp-R_Slo6fV5JWlefJH3as-xAi4MfldFySFCdW2VC7tzs8dmMwHbR9hbKEG4mziyNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtDATLre8R9dXX3qHVYb5fDHPD5Kh1xP_Bjybr_ibe4g&oe=6B0DC297"}, {"file_name": "Screenshot_04.png", "id": "319481737914327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240109_319481741247660_2311776443441155712_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J1XWm1oG_4Q7kNvwE-cSkC&_nc_oc=AdqR2uFNHO0l110t7hajUjGS5TEbZcMsmaEtK_M-pf9RgAG4sYr1a3EmWbib16s6ias&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVRK4aQk6xOqf4CTlu4UzDNPTtmn10hFJUgTuCooQnqg&oe=6B0DD27A"}, {"file_name": "Screenshot_05.png", "id": "1218222189322091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974829_1218222192655424_6704110728869486582_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEenNKgY-1QQ7kNvwHUrom5&_nc_oc=Ados5cgc0XVgqHeQvhaXbKC_D7r55k0yoOkBLCM-sWY68u2j23LunX-Zk1xFmkfEc6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7JjjwjO0SywcZCUvfzZa28oYv42dMdQIRCZxDnqnJaw&oe=6B0DBD9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JumpWorld_Cover_Landscape.png", "id": "1630745394490612", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203626_1630745397823945_773068501026464412_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUYjYdB8qTQQ7kNvwFQgBiC&_nc_oc=AdpIzxKghxRl8wRwjxkLmN09Mfz-twaidyOzILDF18oDg2R6DRpcmJoglfKg-B_b6hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQODFDDacvEakQIvxGdOOLRwgZ_KtgXyZacOZx8LbZmWQ&oe=6B0DD062"}, "display_name": "Jump World", "keywords": ["Platformer", "racing", "fantasy", "obstacle", "course"], "long_description": "# The Obstacle Course Game You\u2019ve Been Waiting For!\n\n**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n{2113431872727583}\n\n# Easy to pickup and play.\n\n- Play seated or standing.\n- Lots of challenges. Both easy and difficult courses.\n- Use your Super Punch and Ground Smash abilities.\n- Breakable block types to smash as you race.\n- Purchase weapons to help you destroy obstacles in your way!\n\n{519192847571723}\n\n# Race to the finish line!\n- Compete to achieve Bronze, Silver or Gold Trophies!\n- Checkpoints so you can keep going when things get tough!\n- As long as you can complete each course, you can progress!\n\n{838018525686038}\n\n# Find potions that open doorways to the Shadow Realm. \n- Unique areas that provide difficult challenges.\n- Listen for the sound of lightning to know one is nearby.\n- Grab the special key hidden inside to unlock special rewards.\n\n{867564849358937}\n\n# Collect hidden stars & gold chests\n- You can never have enough gold! Find chests filled with coins!\n- Find and collect the super stars hidden in every level.\n\n{1823549005022863}\n\n# Each world contains a hidden pipe.\n- Find new ways to navigate Jump World.\n- Complete dungeons to unlock new pipes.\n\n{1286291519924049}\n\n# Costume & weapon shop.\n- Dress for success with various costumes & hand colors.\n- Purchase weapons to destroy obstacles in your way!\n\n{745204831357554}\n\n# Retro-Dungeons.\n- Finish these extra missions t
60169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818849_1318468470093502_4268045043540325159_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zskyghlyxOYQ7kNvwG7mcBq&_nc_oc=AdozcYItqoRJCJLTPlUXAZtj17TsmHwMU9cLjg3BfDB97DCe4dnlmAtx4JMmNto5EKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxdRyPNZmJFhG8qRCUAAv8h3IwCuetg-yylMR5wppGLw&oe=6AE2142B"}, {"file_name": "SC_3.png", "id": "1475710777310924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_1475710783977590_4965618075896948407_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOt8S9cuyI0Q7kNvwHZWVFb&_nc_oc=AdoDrZgBlQFFh4lcOF_FR-8y2pvtN0mu6f3J37FKpgqNulVzlGJNLdDIltzWZpO_NTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsavSb1pMEMEC2br2TaWMWzjKTTWyHm3-pFp0NA6X5aQ&oe=6AE1EEF6"}, {"file_name": "SC_4.png", "id": "4269491236657093", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_4269491239990426_8356055370383711404_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxuUblOY0L0Q7kNvwEwraBB&_nc_oc=AdqmgwfPMh_mRc3uxYf6ticY5gwzGHl77ZgmEtp1I32QO9iWOO5TWrjLKPWxkFOFAKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYlMUA0RFgtdPC4vnrhn4xpL8i_6ZIj_h_0s9Iee40Xw&oe=6AE2063F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clonk Beta", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "                                                                                                                                                                                                      \n\n# NEW UPDATE: Trouble in Clonksville!\n\nThe mayor has been Clonked! Track down the Evil Clonks before they strike again in our new social deduction murder mystery game mode! Explore a giant new map, full of traps and secret passageways! And remember - Trust no one!\n\n{1608296893724686}\n\n\n# Move Different. Play Different.\n\nSwing your arms to run. Triple jump in mid air. Climb any yellow clay. Fire oversized projectiles from your hand cannon and cause pure chaos in races, arenas, and social modes. Earn Clay to unlock new gadgets and cosmetics.\n\n{929798519403506}\n\n\n# Early Access Rewards + Clonk OG Hoodie\n\nPlay during Beta and unlock the exclusive Clonk OG Hoodie before it\u2019s gone forever. Join now, shape the game, and jump into the Discord for events, secrets, and rewards! (https://discord.gg/7PWqcxdZ9Q)\n\n\n{3971744683117252}\n\n# Prepare to get Clonked!\n", "short_description": "A chaotic free to play VR party game with wild movement, gadgets, and social game modes.\nJump into Early Access, help us test new updates, and earn exclusive rewards before full release."}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25819707710985629"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822034_742935432136653_8996639133147479096_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVD91trI
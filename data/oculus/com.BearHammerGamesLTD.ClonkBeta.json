xXSU5tuy3W0sS6rbEE8i58KbXWGKwRJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlRmDCO0OoXOIUnGfvODA2UOBDrOqNIPmPmzCDac8pTw&oe=69C91E3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clonk Weekly Beta", "keywords": ["Racing", "Social", "Free", "Hangout", "Climb"], "long_description": "# Calling all Clonkers! \nStarting November 8 and on every Saturday after, Clonk will have weekly one-day-only lottery playtests every Saturday! This is your chance to dive into crazy obstacle courses with your friends and unleash as much clay chaos as you can while providing feedback to help to shape the future of Clonk.\n\n# Here\u2019s How It Works:\n- Join the Clonk Discord to apply each week\n- On Saturdays, jump into Clonk on your headset during open hours - to see if you made it in.\n- If you\u2019re in, congratulations! You\u2019ll be able play for the entire playtest session that day.\n\nIf you don\u2019t get in, no worries! You can try again next week.\n\nAdditionally, any players who making into a playtest session in any week will score the exclusive Clonk OG Hoodie, a cosmetic only available through this test. This is your only opportunity to get this cosmetic, as it won\u2019t be available during any other event or from the in-game store.", "short_description": "Weekly beta playtests have begun! Join the Clonk Discord to learn how to join!"}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQU
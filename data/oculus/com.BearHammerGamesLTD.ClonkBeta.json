zWtnZ0KweXiPpT0gU_1Q6WMBS_6KbsEMfcciGamUjHjRBzzo9FJjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afst-x2tTWsAZxslVpuMmOMFxStN8AwQ0skiGxD69TapDA&oe=69A045A3"}, {"file_name": "Clonk - Beta 2.png", "id": "3154921074806595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296033_3154921078139928_1062561620295420047_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns0czwXA6agQ7kNvwGfPWVD&_nc_oc=AdnMvJzchEXbOsUXMC649jfYN8utbQZVP0zivv2-QKweBlR21a-mN7HfSyPf7TaVSqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBFlfCzbTViE5Ay7vqc9f3MxGToXuJO1P-vgrJxADRpA&oe=69A04109"}, {"file_name": "Clonk - Beta 5.png", "id": "1233006548637422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822823_1233006551970755_5345857119776754470_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0sSnWtoabEQ7kNvwEceZjp&_nc_oc=Adm4frYw817zfx9u8-iQJBdcYfEnv68lLuDJpkwEI9EA3MgssPgYSE44Xa61Q0uHIoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQwFI2_ogfToHF2RnXpaQncBwuNvwJxDJa6IH35gyLjA&oe=69A04BDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clonk Weekly Beta", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "#                                                                                                                                                                                                      \n{1151719726665828}\n\n# PLAYTESTS EXTENDED THROUGH DECEMBER!\n\nWe've enjoyed your feedback and participation so far, and we would like to give you more chances to join in and try new stuff by EXTENDING OUR PLAYTESTS!\n\nSign up for playtest sessions through December and get access to exclusive items, new features, and in-game dev meetups!\n\n{890492060070427}\n\n# How to Join:\n- Join the Clonk Discord to apply each week (https://discord.gg/7PWqcxdZ9Q).\n- On Saturdays, open Clonk on your headset to see if you made it in.\n- If you\u2019re in, you\u2019ll be able play for the entire playtest session that day.\n- If you don\u2019t get in, no worries! You can try again next week.\n\nAny players who make it into a playtest session will receive the exclusive Clonk OG Hoodie. You can also try out outfits and throwable cosmetics using the in-game shops!\n\n{866891162541405}\n\n**Join now and get Clonk'd!**", "short_description": "Join our playtests every Saturday and get access to exclusive items and early peeks at upcoming features!"}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25088231880799886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_742935432136653_8996639133147479096_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ9ieyEI0GIQ7kNvwFgjylR&_nc_oc=AdlVQgs9vzqY8-jC8s0dIsxr9EWNTUv-Ij8Sw7VvhwVicYkEirEufswyYteXL2qUa14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsTL4hB0daeDkhTOY8CS2GiM8v3cuYmrKHLv1eLZf3trQ&oe=69A03B66"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
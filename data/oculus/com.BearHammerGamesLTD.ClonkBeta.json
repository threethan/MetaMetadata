&_nc_ss=7f30f&oh=00_AQUahqWAmMzQ6X_if6O62bblCDOIzDTFUn4NTvSeWjmDDg&oe=6B0F0E64"}, {"file_name": "491821765_663139873124383_8754525683620193224_n.png", "id": "701755136296317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304019_701755139629650_4543184855569206587_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV-zGZydfhQQ7kNvwHLH11i&_nc_oc=AdodxVcSf7GgkzLFI2S9cWh7mN8cMc54CvGNnAhEAuRmevMJom4Ttnai-9diZOVWE5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlNLqgN-vZ3Acqyf8vhx4gLKSebLpPT5q7TK6bUdjehw&oe=6B0EEE56"}, {"file_name": "491824080_599947393096426_5988359839016862872_n.png", "id": "4250741681828038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_4250741688494704_7402521577207994888_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MqxcZxCInYQ7kNvwE7Qs33&_nc_oc=AdrWAs-GuhKbAUTZLDkcYTSsd62p2mt7h8qFxeIyVTfPsbvJI4kIAOzUotxQTtPYJRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWC1WjlStdad7ZDPBKmag_0bPud_Rl8K6CKqIrghPakWw&oe=6B0EF8FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clonk Weekly Beta", "keywords": ["Racing", "Social", "Free", "Hangout", "Climb"], "long_description": "# Calling all Clonkers! \nStarting November 8 and on every Saturday after, Clonk will have weekly one-day-only lottery playtests every Saturday! This is your chance to dive into crazy obstacle courses with your friends and unleash as much clay chaos as you can while providing feedback to help to shape the future of Clonk.\n\n# Here\u2019s How It Works:\n- Join the Clonk Discord to apply each week\n- On Saturdays, jump into Clonk on your headset during open hours - to see if you made it in.\n- If you\u2019re in, congratulations! You\u2019ll be able play for the entire playtest session that day.\n\nIf you don\u2019t get in, no worries! You can try again next week.\n\nAdditionally, any players who making into a playtest session in any week will score the exclusive Clonk OG Hoodie, a cosmetic only available through this test. This is your only opportunity to get this cosmetic, as it won\u2019t be available during any other event or from the in-game store.", "short_description": "Weekly beta playtests have begun! Join the Clonk Discord to learn how to join!"}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24635583382731407"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26096521626637568", "version": "1.0"}, "id": "1326528888883245", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24635583336064745", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "i
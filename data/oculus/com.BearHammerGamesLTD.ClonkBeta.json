2Qw0codqPHy_Pdm0nh2DKCbckYQeeU6hs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftBvvSGGieETXo6bNcCKp4hGmxpFEQeQrDzlwgPk9nshQ&oe=69A98FA4"}, {"file_name": "491821765_663139873124383_8754525683620193224_n.png", "id": "701755136296317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_701755139629650_4543184855569206587_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihgQGyUa4CMQ7kNvwFEXysK&_nc_oc=AdktNgIM7xvArUFFsVwh3LuVGXbx72bXG2JBdOgY22pHA-jGSiVrmbWwVBa0a0pA20k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afutft2tIikqMPSWMFw1ORWL3I3oNKCiLMQ-GGOy4twjnQ&oe=69A96F96"}, {"file_name": "491824080_599947393096426_5988359839016862872_n.png", "id": "4250741681828038", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_4250741688494704_7402521577207994888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr3iNqUnfM8Q7kNvwGzBXcb&_nc_oc=AdndDTz5MsOVfBm45WbXFx1t39U-YEQklb7LgTzuA4yweya27uYiZVF8kEJ5ry0lOgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuu4ex6DDDVTqvmuKBghMXsPoLGZyk2EVcUOjWMJLNJAg&oe=69A97A3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clonk Weekly Beta", "keywords": ["Racing", "Social", "Free", "Hangout", "Climb"], "long_description": "# Calling all Clonkers! \nStarting November 8 and on every Saturday after, Clonk will have weekly one-day-only lottery playtests every Saturday! This is your chance to dive into crazy obstacle courses with your friends and unleash as much clay chaos as you can while providing feedback to help to shape the future of Clonk.\n\n# Here\u2019s How It Works:\n- Join the Clonk Discord to apply each week\n- On Saturdays, jump into Clonk on your headset during open hours - to see if you made it in.\n- If you\u2019re in, congratulations! You\u2019ll be able play for the entire playtest session that day.\n\nIf you don\u2019t get in, no worries! You can try again next week.\n\nAdditionally, any players who making into a playtest session in any week will score the exclusive Clonk OG Hoodie, a cosmetic only available through this test. This is your only opportunity to get this cosmetic, as it won\u2019t be available during any other event or from the in-game store.", "short_description": "Weekly beta playtests have begun! Join the Clonk Discord to learn how to join!"}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24635583382731407"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "755612040848697"}]}, "baseline_offer": {"id": "755612040848697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762606800, "status": "PUBLISHED", "id": "755612040848697"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25802543819368685", "version": "1.0"}, "id": "1326528888883245", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "b
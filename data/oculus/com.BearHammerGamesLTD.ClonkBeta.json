228194742_2805953435622511318_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oyGnOm8pvEQ7kNvwFeRCRx&_nc_oc=AdlmTWzzPyvBiChtznvCbvmf6wIehXBgcNjmA7pqrd8XxWEGcloREl6972NSpT1-kdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvgeUjuUw0Ha1h66T9eGENcW_4Hsf0B9zJm9QKZYDLXqQ&oe=699AFFA3"}, {"file_name": "Clonk - Beta 2.png", "id": "3154921074806595", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296033_3154921078139928_1062561620295420047_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp1C-AQih6kQ7kNvwFmzILm&_nc_oc=AdmOWAFRx80LlGW_VxkEQJ-TZLhozDkzr2XgN502IcXGDYce2qTdrDBkwc_9cnW3MfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft4vmrksnV6J_lWQuTzOGYmbkt4ppQbxOukbGN4p8UGRQ&oe=699AFB09"}, {"file_name": "Clonk - Beta 5.png", "id": "1233006548637422", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822823_1233006551970755_5345857119776754470_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0jgd_jaQFAQ7kNvwH5SxEA&_nc_oc=Adk4Qg4ONcANfj1RDQ4X0gggjAXIwamenwNrvMpdj5sO66tCWHpbp6GBsDegYhH5phs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv5ciVThtAebHrEDj2l6XJlbycLHEQJ6akmN9FrwHhtLw&oe=699B05DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clonk Weekly Beta", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "#                                                                                                                                                                                                      \n{1151719726665828}\n\n# PLAYTESTS EXTENDED THROUGH DECEMBER!\n\nWe've enjoyed your feedback and participation so far, and we would like to give you more chances to join in and try new stuff by EXTENDING OUR PLAYTESTS!\n\nSign up for playtest sessions through December and get access to exclusive items, new features, and in-game dev meetups!\n\n{890492060070427}\n\n# How to Join:\n- Join the Clonk Discord to apply each week (https://discord.gg/7PWqcxdZ9Q).\n- On Saturdays, open Clonk on your headset to see if you made it in.\n- If you\u2019re in, you\u2019ll be able play for the entire playtest session that day.\n- If you don\u2019t get in, no worries! You can try again next week.\n\nAny players who make it into a playtest session will receive the exclusive Clonk OG Hoodie. You can also try out outfits and throwable cosmetics using the in-game shops!\n\n{866891162541405}\n\n**Join now and get Clonk'd!**", "short_description": "Join our playtests every Saturday and get access to exclusive items and early peeks at upcoming features!"}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25088231880799886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_742935432136653_8996639133147479096_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy6XIphHEzcQ7kNvwGV1mUJ&_nc_oc=AdlqiztDw2_VrEQtAq92ki8vce5jIjrmNJluRIEM3lP2CEC0TZ_BZk7kAMaAatT-96Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv0i8OnI
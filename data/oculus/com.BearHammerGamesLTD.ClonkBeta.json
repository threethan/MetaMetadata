=6e7a0a&_nc_ohc=bRpooCFeURAQ7kNvwFOZlXD&_nc_oc=AdoPNtY60e1nbXeR7NIKAfvs6fivafri-VwKt7uIA-ca-lvwvo1HIHDYrfIFvXscSw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSuba_sHIzGGocxrK_5pP9u5K82lPAnEBAr5mkoEWtlA&oe=6AFDC4CC"}, {"file_name": "SC_5.png", "id": "1318468466760169", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818849_1318468470093502_4268045043540325159_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE-Ho6wAgZgQ7kNvwF2j0n2&_nc_oc=Adq8C7q6bL9-udjuCjUP7Tedy3ms-GTHZHIgzRzq-CFg5R2PK1f2mseziGO3dddhlVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8bMxaUqeOinh0ddTIQ5C6R_KzWPfIy06NQEYA8E4cOQ&oe=6AFDC3AB"}, {"file_name": "SC_3.png", "id": "1475710777310924", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_1475710783977590_4965618075896948407_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obiI3yZq934Q7kNvwER30ta&_nc_oc=Adr8Gi_pFZHr25IdTPkNjHzHr4_zAp9XqqHMXv6Ip2rYuv8gorCwQkxWRyFCZvJxWTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSix5mUzeKY6xn3Tf-cY_LktRTUP9Regeol_rZR8m27DA&oe=6AFDD6B6"}, {"file_name": "SC_4.png", "id": "4269491236657093", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_4269491239990426_8356055370383711404_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp8PZYfWWN0Q7kNvwHXAYsI&_nc_oc=AdqscF_RMbaOezQ4K6XPYhbeSU6KznzOQOFpk2P7jjCD4i1SNdJjMh5Wr-0k4kLF3rs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyc1-a4Xtyo-R3D1PCc8IwRf-xJ3IcxuckTSCBgknCWw&oe=6AFDB5BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clonk Beta", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "                                                                                                                                                                                                      \n\n# NEW UPDATE: Trouble in Clonksville!\n\nThe mayor has been Clonked! Track down the Evil Clonks before they strike again in our new social deduction murder mystery game mode! Explore a giant new map, full of traps and secret passageways! And remember - Trust no one!\n\n{1608296893724686}\n\n\n# Move Different. Play Different.\n\nSwing your arms to run. Triple jump in mid air. Climb any yellow clay. Fire oversized projectiles from your hand cannon and cause pure chaos in races, arenas, and social modes. Earn Clay to unlock new gadgets and cosmetics.\n\n{929798519403506}\n\n\n# Early Access Rewards + Clonk OG Hoodie\n\nPlay during Beta and unlock the exclusive Clonk OG Hoodie before it\u2019s gone forever. Join now, shape the game, and jump into the Discord for events, secrets, and rewards! (https://discord.gg/7PWqcxdZ9Q)\n\n\n{3971744683117252}\n\n# Prepare to get Clonked!\n", "short_description": "A chaotic free to play VR party game with wild movement, gadgets, and social game modes.\nJump into Early Access, help us test new updates, and earn exclusive rewards before full release."}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
qFLJbyEmjaVN6cfPo4ukQ4j-0QaaneHep64&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMixjFTO3AC3iZLR5zpopGYpWNsM0jbFRQcdefqIdUow&oe=6AFF052A"}, {"file_name": "switchboard ss4.png", "id": "1700564057821396", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823783_1700564061154729_4391242742190225656_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MV-qCoDQ5FcQ7kNvwGBM2BU&_nc_oc=AdqX8fLuvYkIQ3MEO4xgBj3kLmh6US5OMfHVvmFOxfRWm0nG2HwJISCg840WFyf9LnM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnWyMpX2Z6qIDVCHsk25NCUd9OB5v8JliFgpVSbdsTZQ&oe=6AFF13E1"}, {"file_name": "switchboard ss5.png", "id": "28112519345039742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_28112519371706406_294227374045790391_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6NMJJpKVbYQ7kNvwHWKdWJ&_nc_oc=AdorippGhPYjhblaWIK3pAOI9oCa4m1K4GkgUspD7fNQ1EFIHLvdezzN1ehSsUBuj-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRUZvls0eD75JM8Qy1wuE25IcudjqsXMwcqAoGe_kyPQ&oe=6AFF2D9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AryaXR coverart landscape for elect.png", "id": "1742795146912470", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1742795150245803_4012088548481930381_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU2oI3Bi5Y4Q7kNvwHShro3&_nc_oc=AdrVnvz8DonPRDYQ86RczvS-79HTQTtozLEK-Mq9G6MkY5l3QaLcY8sUeX9ZthU_49A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM7O0duX7fG7vgrpbSbN2cVIQ_DzFOevc8bbTdZbV65g&oe=6AFF1CC8"}, "display_name": "AryaXR Switchboard Electrical Wiring", "keywords": ["electrical", "wiring", "Switchboard", "aryaxr", "simulator"], "long_description": "Step into a hazard-free virtual workshop to learn the fundamentals of electrical wiring! The AryaXR Switchboard Electrical Wiring Simulator provides students with a fully immersive, hands-on educational experience covering the wiring procedures for fan regulators, two-way switches, and standard switches.\n\nUnderstand not just how to connect the wires, but why proper procedures are vital, and experience the consequences of skipped safety steps in a completely safe environment.\n\nKey Features:\n-> Guided Practice Mode: Learn at your own pace with visual clues and step-by-step on-screen instructions that guide you through the complete wiring process.\n\n-> Assessment & Test Mode: Ready to prove your skills? Enter Test Mode to complete the wiring without any visual aids or instructions. Your performance is tracked, and you will receive a final assessment score out of 10 based on the accuracy of your steps.\n\n-> Safe & Replayable: Repeat the practice and test modules as many times as you want. Build confidence through repetition in a 100% safe, hazard-free digital workspace.\n\n-> Safety First: Begin your training by selecting and equipping the necessary Personal Protective Equipment (PPE) before handling any tools.\n\nWhether you are a beginner looking to understand basic circuits or a student mastering electrical safety, this simulator provides the perfect hands-on environment.", "short_description": "Master basic electrical wiring in a fully immersive, 100% safe virtual environment with AryaXR VR Switchboard Electrical wiring module. Practice, test your skills, and learn the fundamentals without the real-world hazards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aryaxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ARYAXR AI SOLUTIONS (OPC) PRIVATE LIMITED", "support_website_url": null, "website_url": "https://aryaxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
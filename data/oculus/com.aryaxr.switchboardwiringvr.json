700564057821396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1700564061154729_4391242742190225656_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cfQgy-mlZMQ7kNvwHfCbno&_nc_oc=AdpXs3z-cU6In0keW8PzOaezI-y1ZTUav671jVc2N80HlkK3sh2LfmpEpAzqcnv_4Ow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqxETbmEsg38NCZZrduLK2pt2-TY_1tFl0sxtqqFR8ww&oe=6ACF9DE1"}, {"file_name": "switchboard ss5.png", "id": "28112519345039742", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_28112519371706406_294227374045790391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE3_sqOnIDsQ7kNvwFABHcq&_nc_oc=AdrzxhxV81YfuuHyfDudEtvFv50Ijc9erPOPL0gyZXejtJMxCpCP_gYO7dqIEaGEFTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8d-kzzu_tJk-4AGtqW2kse_MW5k1p33Q5DjSdYBCvsw&oe=6ACFB79B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AryaXR coverart landscape for elect.png", "id": "1742795146912470", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1742795150245803_4012088548481930381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0qP61bcfzYQ7kNvwGLOGti&_nc_oc=AdoGAuZOSdrsLyD-BkTye_VFeH3fwEtBKaibTMjejxqpnxjn9-xAq7GFY1paFnsqlvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_lGtKs_oK8Z6Sb6xF5BlOsNTihAGmyvsKavxo8ItjQg&oe=6ACFA6C8"}, "display_name": "AryaXR Switchboard Electrical Wiring", "keywords": ["electrical", "wiring", "Switchboard", "aryaxr", "simulator"], "long_description": "Step into a hazard-free virtual workshop to learn the fundamentals of electrical wiring! The AryaXR Switchboard Electrical Wiring Simulator provides students with a fully immersive, hands-on educational experience covering the wiring procedures for fan regulators, two-way switches, and standard switches.\n\nUnderstand not just how to connect the wires, but why proper procedures are vital, and experience the consequences of skipped safety steps in a completely safe environment.\n\nKey Features:\n-> Guided Practice Mode: Learn at your own pace with visual clues and step-by-step on-screen instructions that guide you through the complete wiring process.\n\n-> Assessment & Test Mode: Ready to prove your skills? Enter Test Mode to complete the wiring without any visual aids or instructions. Your performance is tracked, and you will receive a final assessment score out of 10 based on the accuracy of your steps.\n\n-> Safe & Replayable: Repeat the practice and test modules as many times as you want. Build confidence through repetition in a 100% safe, hazard-free digital workspace.\n\n-> Safety First: Begin your training by selecting and equipping the necessary Personal Protective Equipment (PPE) before handling any tools.\n\nWhether you are a beginner looking to understand basic circuits or a student mastering electrical safety, this simulator provides the perfect hands-on environment.", "short_description": "Master basic electrical wiring in a fully immersive, 100% safe virtual environment with AryaXR VR Switchboard Electrical wiring module. Practice, test your skills, and learn the fundamentals without the real-world hazards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aryaxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ARYAXR AI SOLUTIONS (OPC) PRIVATE LIMITED", "support_website_url": null, "website_url": "https://aryaxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
5P4Q7kNvwF7R8mP&_nc_oc=AdqLvdKVYBdq-hXMNvvciAhVlZjLI144rZNSQ_M8s2i79F_SNuo5DLGhir78j29Kyxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVTjuagqv34MbiR43xMYNa98YeCFFNvho1paBsEqNpvg&oe=6AE09D4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_nUZxP-pJwQ7kNvwHBfxwi&_nc_oc=AdpBC2Gc_s31YP3vILRzDOuRhgzaTB058Nh8k2dpqnbb_70MPhWG_nBYc3tvO0b9QEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_oAEl3Ibrw9aUY3IgTpURIfuBBiif1UVSlAGpFvzt7Q&oe=6AE0BFEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv9cseZ4g5UQ7kNvwEK68ya&_nc_oc=AdrunwhObFfmAlsGOGf3hUGmADVpuuyvdo7VJFCyzZR8waQoPIjl6IhPBUVicpgXCwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9OPkj6J2i_sWrk01hoz9RvMcUcMmTcUd9uxtFIWpUiQ&oe=6AE0C71F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQIk6w_UT8QQ7kNvwEKocUd&_nc_oc=Adr7PQjZfvv6B3GELn9j90x0QZMXNyN5kaeGN0Gm_NmjrNPdKeJmG0o4oOWT4y6tvr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq4TSBYQkvDTpmY27UJaMOnjSshyEFY8Bc0gu2GpXjCA&oe=6AE0A30A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMPNbnNeUekQ7kNvwHsuSUm&_nc_oc=Ado2rY6h9rniGU64dXTVWIIIA0QkjG2bo7QeByPVa-QM288KSsJqH2pRQPjP6_-p9yY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxLGD1NAq_abc3TnJqNtdY28Z1z2X6CMFcje4tGpRB7w&oe=6AE0BADC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
u1kQ7kNvwFPM5BK&_nc_oc=Adpc1v2wzzOGliTkeSMzFaajQaqhGeFQoNC9Z3h1au1sx5IZ9I6MkjEv-AI1woQycl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFOK25EThZYyizL2qPYRLXAJrmMlvorapGmYXaL4MZUw&oe=6AB3CA4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb4SLTgBpZkQ7kNvwHmCoC-&_nc_oc=AdrSP-eUYiK3plT12ZL4kJSJIu26ku5MhMvCjPEnOhrzzVm4uKZlIRkvSf_BngwT14Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLETG7414p-fDRQ_4x-hzImjYdK8LpTZj-aXbReMOMm1g&oe=6AB3ECEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJuOTWHI6DEQ7kNvwFxR2M9&_nc_oc=Ado9gyI0Ivuz0_GmEDB5DGNvsisMuW415VdY07rW9bhr4M5Yf6OuQvNyw9QVPgerb98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYqBoQAw1jzPnTrizGXsRjYxIbuwlIE-Z5YGWB-DOsqw&oe=6AB3F41F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPt4YM4g2usQ7kNvwETq8o6&_nc_oc=Adr3m2V8xw6QSU2ZjhfXL-06ckZJ3YjMOCUeg2IQ_TlappZe9iD-8cLg4gI0iHiejiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ67jPgKUwN5E0V_N21YH7agcLcZycJHanYb-IjSvY8Hw&oe=6AB3D00A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=logazJMxHZsQ7kNvwGWYUv7&_nc_oc=Adqb2-N92xLPFj5wOvWWPuFRuU8wRQD5hKKJSYJsHpl20ZspApRwwQ1gkuSyY3SZ6T8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-RbMQ-bpSbr1KBKkfPB_uoejQbUpg7LsrwtEOG_5Y5g&oe=6AB3E7DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
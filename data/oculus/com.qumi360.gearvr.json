XIwQ7kNvwGHZrlF&_nc_oc=AdoEi-Bf6v8rFyR_Y5PlEwbnZHoHUM9lwvJlaaf0iqwybtl8lq8N0It-E5X95JKTVJA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y1e9d8gnzdv5-4TSgnf_7t3jPZ3a8ww3b07d_tTG0iw&oe=69FF2CCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmOu_hMoJLsQ7kNvwG2RBSn&_nc_oc=AdqMk1opFR-SLTKDWmFLHQsLSPxBM5tmKHOXSxnuZlIThbXE2KgwEQZV2ASxcuOsq3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qo8WOV0_vm0rqO4LB0Jvz1f6PHKwS5hB-8eLQCur_Rg&oe=69FF4F6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5rtioKmOVkQ7kNvwF-oNlZ&_nc_oc=Ado954VxaH2Owi6LkYFqBi0pjLoQzpoZQx2NR2TxC-ByIksv2d2JC7y1WtJFtCfTBIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eIjT2tJ0LJ9PdO4ClQpThFDMRHzgyNjVkyXPnUGhGsg&oe=69FF1E5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9Az-pP04eQQ7kNvwGCGqGE&_nc_oc=AdriRfbB9Pl3oUjgvQwGgmoZlJgIFS63ash5gqs-eUXzGKnuYk1pm9JyHluXA2P8mIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EktYhjoEA1n7SkNaCGkEuVXoQ8-ehYBvHFD5TyZTwiw&oe=69FF328A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZmpB0YmA0YQ7kNvwF8dhga&_nc_oc=AdqN4SsQ3xOf9ZE2Veu_uszYqhxOoBKNpvOjLuxBXgu_rmNYlmBOQEirH6dM0QbLuRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_0C6xZMfbiyiVen6qYGWka4DE_XxlBVfW7g_t_vGY1w&oe=69FF4A5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
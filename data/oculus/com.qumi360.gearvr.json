9y8Q7kNvwFQ_oDM&_nc_oc=AdoJx7mPTXAml1TWiuhglyZxYwkSpn1kIzAESaL6gP5LTRe8ZF0dm96Kfdwu6oxzr4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-hEmbYbr64l2JPmriRcNhFAmI3lJIwFlDG_Pv7-KSfQ&oe=6A9D60CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quZFVHDpXP4Q7kNvwExHXI0&_nc_oc=AdoZBhFRezUEzblQC_aFa6fZwl1ddzVt6ITxe2u65nomaJ9pRK4zZBxzes6QgTidR7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG3AAyVEvRSNjDJU6khOy0NQLmIGvIytuwMDtks_cDDA&oe=6A9D836F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8XlOotfO8gQ7kNvwHGYfsa&_nc_oc=AdprhZZEUzhVXWXDVz1EVO7IRqPKAtWcNsqtpZbiDFmpPBX9W5EAMONgf8x3gJA3M9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKinKICspHC36T8iEwJqvqJ1V3Rr8fp44INnWRG97ji7w&oe=6A9D8A9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsra-A6NWiUQ7kNvwHiwoM3&_nc_oc=Adr1KL9XxOUZoxHc_JSwqIn4-AYlcuKZhb48QUnnE8KaLgENBTahQHQ0IHmQoiHkQuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvpO1g7s6WgazWJtcSgwbDkJZAdfXBKpBc9GSZ7mfmfA&oe=6A9D668A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQGoBd7fF3YQ7kNvwHsCl-b&_nc_oc=AdrQjjFYbF1YivRuwNjwUgOwDyHk3pBiRjipP060HxpOcVADLQLsAxrsBYHH6Sgtu7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUd_QnylM6NUCVRUN3Z2ehV3z64gn3xkcL4Z_98e-7OQ&oe=6A9D7E5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
HhIQ7kNvwGbGS2g&_nc_oc=AdoItY5hiES8P0mZ9HeykZqhNS8Ozp9D0M8lshMZshLr9cs_PMfiI0Qm_UKdPE3qj5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fsuIch9ttBFsKmTsENjKCVgNdLg55hwIryq9BzYhxAA&oe=6A1ED0CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aVCKZgAV3kQ7kNvwFUNmny&_nc_oc=AdomZtlMpVlRwgf8wxeP8qI4gSc4gkh7NQ-kITMU5IxZX1Sd5jAd-Q3yOv_rT6waBrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xN6c8-x7rR14_moC7FSXHEzL3OQ3PMF5Ht94JiFP9Tw&oe=6A1EF36F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ops-5MKoKQcQ7kNvwFuwc-w&_nc_oc=Adot41Ha9euFl7lKvHYPT4kYaAPsv4SpUdOnpkhWhalm1Z2owPV_kEwOxpw6QSmZvp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aDw4G3NNE2n1f4T78cyfMAjNe8NDhWABPLteXxmXmRA&oe=6A1EFA9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnon3XtELikQ7kNvwG6lp9w&_nc_oc=AdqyXFDuppQFpqgHzKBR8-BOVghZlp48b2tycN9DM2441HPKXEueejAAdqkZCwkJbTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FZ3xQZyOhbToH5sV8k38dt5Hx1js86_VwP8LkefCMJA&oe=6A1ED68A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsHu4i85uh0Q7kNvwH0kFhZ&_nc_oc=AdpQNPiMmky5XfUoO77arMHf8SrMHJzD4m7EJygtvnTt-mAM9J1kRzx3IH7GrkPND1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49jx0x21gmajoPRQjG0rWQS514sozgiHKaZHEor2dk2A&oe=6A1EEE5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
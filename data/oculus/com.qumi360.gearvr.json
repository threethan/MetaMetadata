-QgQ7kNvwFukpPI&_nc_oc=AdotAivLINWV2D5BlSzjBDYMby83H-vNfsVlmZmgDtMiEGhtEBv4Eu36dJUHZ3fcBNQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPzirKfaFpUn8-Z8kOdNBAQgR-LNseiX5eekq19ktoHg&oe=6ABA61CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciq9FHIXxnEQ7kNvwFdY346&_nc_oc=Adpvg-6T4LT2BCL2DNJgGno2puxJ8XohkWvTlMYEWMrsm6YMupFCKOJzLJbnTknNW0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO6SArTdTTjI5bUsIBGox16P1ajhDm5r6yeNKRzf6V0Q&oe=6ABA846F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIBcL3L8YxwQ7kNvwEl9E5u&_nc_oc=AdpIPReYd0vDP_kcWC9tSiZi_GAlhgA-qCEWiVsZqjj4OKO8j7iS5pB_rezXrOpjDDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSyvknFU-CRySwH03vik_xBOd9G2Qz1yr3SyWEzxIkiw&oe=6ABA8B9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVoyKeWk_tsQ7kNvwGqnMza&_nc_oc=AdqOo3BWBdtr0sH7pg0xxzHsFIVpdIoRDM-pjac3LsH1Wi76az8AddWt_K0JRuwTQ8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLErC8UdPgN6gfpy635DEij8VkDwHl95jxc1IeNgjBuzQ&oe=6ABA678A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzjmbvQniQAQ7kNvwGPQWQD&_nc_oc=Adov_XI0UhYUVc-Muhyq0gDV8gSK5oBxaPHeZHb82872mlWbDKsS-5aZ9jWtwJbs6fg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz5jzL4L0nGlQgx5gtmeUbj6aejDv-TQP2s2EQL9KXKw&oe=6ABA7F5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
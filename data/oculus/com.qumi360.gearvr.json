hc8Q7kNvwF-mAYC&_nc_oc=Ados2jeG3YZHkLHkz8tTPSW9OOe9JDBWQyIRFDrEE6qnabCYIpkWT2NOV-uJkHe49jc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyk9EJ15e6OsU5Ehqio8XEiPBiY7Mi1BPg9V73W2--lg&oe=6ADCA8CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-_LBc4bhKkQ7kNvwExpYmt&_nc_oc=AdoRt2RdBZVV3-n4UmntjlSBpKBKnA4bZn_spLMzXItLwvhzkKMlMCPuvSCb42JJbNc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWtSjlrM7hS2B-kum72YR8k72AZPz3OPZYXnqLNfYVrg&oe=6ADCCB6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLfD3A2IPsIQ7kNvwGbFvCQ&_nc_oc=AdoGWcC41B7pU5IkSVXgYUA5ZhBIIuZHv0vlNBfMtC_Ffw2I6BDondm3e_LBCpShNqg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLxu_W8ZdlMerbhTs5y__B81J_EfETJ35aL057trByRw&oe=6ADCD29F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZb_VAOLOCgQ7kNvwHQcRBj&_nc_oc=AdpgM02bPBGDsXNpeVj62elfH-NhhP9-VZvN2BfZp3-AMHOzQEXTsQS-kgz2py1egVY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgGRPOKMqW-I0asCfhng8jrsv-um2YreWr-INbixnuHg&oe=6ADCAE8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N58vofhHUvsQ7kNvwHhnXI7&_nc_oc=AdpgE29FDrbS7XQMko9JwxUbqzxHq6cWRRDmOhkOZIf0sj2NE_8s_eq0k42yJrAcYfI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7PspDmgCD92_PQk8lTXaZ9gdmF51KTvljuJYjzeaq2Q&oe=6ADCC65C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
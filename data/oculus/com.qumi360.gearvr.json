y9QQ7kNvwGwPgXn&_nc_oc=AdqVlddc0MtLeb3UbdHt1tldH5ZOecJ7oR_3umf89nLWS6RS6GPF6EO3unBqSkLMmiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHjqbEJ3DEDAHkwBliEozjQrdZldP4UgeK_h2Tvjn5pg&oe=6AEF560A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTOO7sOsuAwQ7kNvwEaTEzn&_nc_oc=AdrzqWTyT7Rkow2ZwI8I8efk3-XFWcs5-wdzOuw1A-j5_3SIYVUB_3ZWkI3-pxQ3a5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTfZ1mlLmoBS-UjVfTAh3qvgM0rGA3u8Prct_JSEYi-g&oe=6AEF406F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D74EFmXm_2YQ7kNvwGz2Cet&_nc_oc=AdpMEn0nB2KUk9PylWeWG_rxkVT6uDiL2sILWRRcmrYlrqI2vo4chIp8yKp-1_W8vlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbGfXN5ArgeFzn-uF7iH2chyvQZADuZMgcdP3LnMR3gA&oe=6AEF479F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b65fBZxnO9QQ7kNvwFtG3Le&_nc_oc=AdqU6Lra5bSBbrgLjvbh8uGwUsBVWbY_ZMCxg-lr-VFLUrtbmbYwfujLsp7xOWPjumM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKuylBLQZOjqu-Og5o3Drv1Dxp6xCkiGhLU_tz0xrzKw&oe=6AEF5BCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjDEOhIBuq4Q7kNvwE-HcH0&_nc_oc=Ador6TDOdn8fYr3ybuad3hY5YZMyswKxhqBGasynEcRXjgEGNNOqkIHVNZAT7EQHxZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSDWGKauUeEJO-i3cPPc44lh2Nr8V4pQQJTJYNYJMjVg&oe=6AEF3B5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
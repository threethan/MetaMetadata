DEoQ7kNvwHYt-MU&_nc_oc=AdpAPb_9-2_ZJ_HGNaM9e-AWTKWkDp5vpG7fnkuPJRKTxDvphMRDXgtK9REnGiEvQf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2nQ_QuXYHo6kPA4au9bZAqpsOdTkk6fgW6pcImvcDCQ&oe=6ABFA7CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53PREDL019QQ7kNvwE-jUON&_nc_oc=AdqrYj4PNQLJib_OoafaY8RmV9eNZ0omW5YEYXQqj-cCck8NWj0R0b924K_EJLQh3W4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT41vR10pYiwAgJ-0BZTm0tShuFe6ugzt970O54WUHRg&oe=6ABFCA6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43J0GCqyLFcQ7kNvwGBZWK6&_nc_oc=AdquQnA3LrvXLegjUW0nOLDfpIS1jybQXePhCIcPtTxCnE6u1AZB4tAX6GFpw7KsPmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPZo88R-lQt0kDPnkHFhrpU-lXhec3Pyf8Sn2sWxd-EA&oe=6ABFD19F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fdvPE-p0RoQ7kNvwEG6iuE&_nc_oc=AdraIfc14fuonbmqc-qqCV17e0PYwmhHxs7n7yFTC-7f2jEPshfgeQhyPXiitzPw1BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4h29BE48iS2z3wHyZ0fvfSP5luXRj7n_5lRlyid4_lw&oe=6ABFAD8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmHMPFAqHsUQ7kNvwF2Ye1L&_nc_oc=AdonTiuOOAH519-YHMaKZU2HJj5m7nUISlN68ETzF96DBlSSgbpb4IdiUF4do_ZVKSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB5y6AryhOeyKfb_NrQNKT_65uKn3-WiCTBoWMdr_WEw&oe=6ABFC55C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
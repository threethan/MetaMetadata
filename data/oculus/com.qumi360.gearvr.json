TtsQ7kNvwEQX84T&_nc_oc=Adq_JlZy6lSL071fdPHJsnObp8kwyPnGlxDE7GK3nikCt7J92IPKxRxtGnU9gTPzjsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJC5Y9KLcRlYVqNLqw_SwMbGn5WiHgJWttZnYMUxI0vw&oe=6A635ECA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LAbZxN2NMwQ7kNvwGspw8w&_nc_oc=Adq_AM40tCxsaCBaHOE8SMUlYlycs39FNGjNuU_elwpteAs_pJ3fkYaHqYSj69Fnc-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHJREhmnueHDeWUhLdY1Bf0OPm2eWjxyWmBHFx97jp8Q&oe=6A63816F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFl2AwUKCuAQ7kNvwFiuOC5&_nc_oc=AdpPA75xEs68PHM-FC4LSC2dBvAxVp-5XjIkxnOgXnzCzTN0u3UeypfOt2aZnV1mays&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbKiTgvNIbA9gt1P7qZPa6Z0BLkViTVsioHO4G9LYxlA&oe=6A63505F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFlHO2tYnOoQ7kNvwFvuH4_&_nc_oc=AdrFYs98KvPULH_rU2aTHQCezhSv9poTV6IjSEYoLkKkteOSj6wlKUB2dW798WCxWTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMo3uenLgP-OweAWy7wyDZYmv-fOvQMtHWzjS27mFq-Q&oe=6A63648A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAF_EHiYeTYQ7kNvwFmBdgR&_nc_oc=AdoKVwQJLmPak6rrEp7UC33N0QK_Tg7Z89UgmAveoQ_sJXxBZst8-XOTsRAEWePOrQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7jAIyhDfOi16VAP-F1WDNha4UpkwhMoL0KCLt1HRgtw&oe=6A637C5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
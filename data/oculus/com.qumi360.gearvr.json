8eKb_bkpf9qctlQ0-wka6S4Ww&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2J9pfOwKyCBx9r4iKKZGzXBYpXPbuuoHyRNeZq00cq9w&oe=69F1FDCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXnTDrqtYacQ7kNvwFBToiS&_nc_oc=Adr18NK4UHR3F9eOwH2PPcR4togPiXwbMKjF7oD2QOx50w4oDWirSkuKuFfkzItzFDI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WOnTn7px5PUWg9WD7SU2xvm5iqUXcHlM2cFjbiRYYnQ&oe=69F1E82F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu5ZZ7MdD94Q7kNvwGwNQhN&_nc_oc=Adqzq5lvIFUWkwEd0bG2JTEY42Zv1Y4nfWuSkkMkKs4Xc2vdHuQhdCvDXvzxEXJu8XA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2nheVgfhYsoRlMiz9GIjWP4HJBw83R00NVOgVh6L_mqA&oe=69F1EF5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDqjfWmmUlEQ7kNvwGZNGjc&_nc_oc=Ado92ujA51a6mO4k8yM04gIHw1u5ZnX-aJaJIp_buzHOAW0T5OiKPWDefrUQH7FXDoQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19dLGInQs4jGz6TAz7M1h__gYCXG73dHqIug_k6M0sEQ&oe=69F2038A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QelKctYMOAQ7kNvwEpvaOr&_nc_oc=AdrIDx36Yn4xN-F3JsEBh2rKxKntPoS9FQt9pVu-8iRI2nusxEzlte-0-STOR_pGb70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af32GOYzmMuqpHZ1rm2adMiMplAN8d7HmEGUnxeaSgjJQw&oe=69F21B5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_129530761062596_5
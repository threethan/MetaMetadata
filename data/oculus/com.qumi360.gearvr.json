oYoQ7kNvwGdAJWy&_nc_oc=AdoL1flH1yIBuimH_UHqRmbm9klaT_Q_RP6E0MRreyKl9HgbK5nedKhcgMdKDWwvb2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwo52nLK88-rDemefW_Ts6P3fTO0VaxTKFaWFwZaHLubA&oe=69C91F4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U_z_AHz0jkQ7kNvwGML0FO&_nc_oc=AdpxpEgDwbfhoEuGK8oA8HLSO-6otyXJ8nh7lVrX7Q2dOYW6Cqu86LuQewg1NXWM9IQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwgbyu9OofPQAtQR_PhsAlVkdemxLzExvOKGQAVz_d_fA&oe=69C909AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHGpFEhhmeoQ7kNvwFIx6d7&_nc_oc=AdqyDTBKBqg5frNCkoVxNK-m80qXUD_xEX82dgZ_VZwmHYWI9HxSTDSc3p3IydbDMPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdJ1VrLEGK-d59B6GXoDNwIXyHRGhCDJW6Cp_VMzsVOA&oe=69C910DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7ENxUVIT28Q7kNvwGalE3H&_nc_oc=AdocC-oLXYBcbWWn3xCM0ZxR4wwhczaxUQvSY8bzTTBWlI9_ygCdPUTgfBgP6uhQQic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyD8hc9qfQS6gQRSDnLk5GiNw6pPxTBKJJ5bTucb81p_Q&oe=69C9250A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIrFMPNyeegQ7kNvwHL_CTc&_nc_oc=AdqHM6rNo7mpf2Tb_kewZl_ez5lPBNiP-LRcVfyfvqut_6h3MQb7TYGo3wF3V1hC5-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9x7OQoXL8QF9US8TCcoqM-fUbyHHEcZZLk-lLo4H-YA&oe=69C9049C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
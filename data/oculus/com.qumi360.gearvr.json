wvUQ7kNvwG8UCNJ&_nc_oc=AdopTCNaVL5i-k-pVX2dN8sraR9jPvVhhqZgW6zKCEDPGslcEZeG9FXGq9Ok3WgyZl0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6O-ppqGcpP8y9ccBShwN0ffndAcyjMQMpfLTjI_qx7w&oe=6A94264A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqmfcFH9tikQ7kNvwEFiHpb&_nc_oc=Adr-S4G8TI7WsHqMKYzR9K18JetdSd5RrfQ2a44Fy-_BmPTn4mZqeYY-kOcSTJ9wGGc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnQf_wPqsJJrb2Sgkwf9m7XMsEk8dvvDBEPnoAMj831g&oe=6A9410AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggrM2nwXkQcQ7kNvwFMhBi6&_nc_oc=AdqexW9QTFxjGgMp_vkRsZcNphPldrvY4_5fZIx1xDhYC4qew7OIZXHLo6UuxCb0UJ4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-ixZWvK-DBD-VHAun52wgVUsxN5pZIRhOmfRbFWCKHg&oe=6A9417DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA1QCf4jA5AQ7kNvwHgWt3M&_nc_oc=AdpeisPpPDolJaofIvdoVYhpTbWzNLv71IT84ZW70OGH8gCUWU1dl-6dKkFrRNliH0g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwnOWa-zeWdMunCJSrNXNPiRKlDtfKpTvCX5PDTzdUlg&oe=6A942C0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KzTXxhwsjQQ7kNvwGqo5vV&_nc_oc=Adov_e1A3L3cGB-yXXUewrp8BDwILfc7vKXHF7xq4qTLOUEn6zu6Y9suFukO74R7Qlk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnfrMvdeGqriBMMNvu6zfxnBOfCx4LhvLmNWJDAci7Vg&oe=6A940B9C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
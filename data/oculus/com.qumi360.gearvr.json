wUUQ7kNvwGf_A3I&_nc_oc=AdotsqpX1OyOEp3IqBLgeZa6kdcY3tK79CiTwshy9hgQA-5Z83-S3YE5MTQd0XBRwaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4LvMJHvfc0JxC2OXiLCJ3R0KYvhlApjU99YXOnjt2kQ&oe=6AB51BCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb4SLTgBpZkQ7kNvwH6dRrJ&_nc_oc=AdrLaIBBwrcLihZQcR5h6K-8j4ALIQvcr1eHxjm6xkXRcMYRCKhQUdpS8Fi4llRjCnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlEUYj1jkKLBD7Wa3fnrsLk6sxptw4v6R50N4puawoRg&oe=6AB53E6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJuOTWHI6DEQ7kNvwHz3bAE&_nc_oc=AdobyiEZFxAUl54Va0jLSjreHql01Db14thKYkorpSlcGsKFc3eg4aqIl3JmPNzWQqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKesWJPCP-7lBoQwspB3GiOfuEowlDLfdVgk00_eCufpw&oe=6AB5459F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lN5WYR2c6eAQ7kNvwG3laho&_nc_oc=AdpSk-SOsnQpf8rig_6wQ9HW2kHM-CpQrglUm0EF6u84o6ZEkZm7-TSrxW1i-nLjpUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAbTcqZk4f85LvlmF8lh25PEs2HykjYCM7QItQOPLrZg&oe=6AB5218A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=logazJMxHZsQ7kNvwFClLcd&_nc_oc=AdrgYqwQMkexNtvq1CuXO9O6KE12MFsLjWqbEtxbOsXGFIFfs_Z8Ef655ENsX8ihtew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLHKIRPElHHUTMgj0QUOhkQD2C67358e_rnI8Zp9SijA&oe=6AB5395C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
Hp4Q7kNvwFtJEpw&_nc_oc=AdrIHrW0wa6Ims58ccBiBY4vTfj69sx0USe3gs4dsC0qwEIeTwyb6D0YL3aYk2NyMI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9ad68WYkFC0J0HqGNuWe44UGhOAcp3WJL9zZKj8WA_A&oe=6A708DCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BHD_Ccd1uIQ7kNvwFequ-R&_nc_oc=AdqpcrkBacJjFIWWuNMxe3A6U-syC62jRrpIpa01__jcVUBj_iNEtvFyXM183pYVYKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8qRBIqdZNx3VL-KcBdh7BKx9wJPia0d1aXR3u9mBB3A&oe=6A70782F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmeK5DkbfMQQ7kNvwGVli7B&_nc_oc=AdofIlbS47EyVXWhlkQ67iinuyW9e5tNMMqMJol41FswwFqkdvkMZFbEN57w_2MML60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXE3O4POwrAgTjY5grtcqF7TFzI6wXMqY-SvhY2lHY6g&oe=6A707F5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpNGapSzKv8Q7kNvwHyiAs2&_nc_oc=AdrvsitWAdp7Ynll6oGv4OWMBa71xYyJXwevwptuT2oWqqcfUVQFqs37Ywhx3Bt5fd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtrPSQTo_2BPMx3hRNbJI3SiSC0MKEzteM_bSz4gVgbw&oe=6A70938A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGm_UEtmELUQ7kNvwHxuOiQ&_nc_oc=Adqsg_yhLX471S0778kSHpNCAwBZ8jooSJyifkmueL9FcUeffoUNlEQ7-OaRZDSGf4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7WRUjqxRQiCAtoTtT11JV8pTK2NfzCooHMdsXW-fT5Q&oe=6A70731C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
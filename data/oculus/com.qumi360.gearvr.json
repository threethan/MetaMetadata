g_IQ7kNvwE6p5Ad&_nc_oc=AdqRhLOXQcvfD90ejNKau7D9lG3vS7iZ1XlB86BakEcvlseLd-R9gbsAMJuUvjDPDr4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTejTK3KOszqf2FiJjQjGuhizpmmzOuxZTGeA80JodcA&oe=6A538CCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c7ttV3hv6oQ7kNvwHqGJRv&_nc_oc=AdrgtTMdEP0YYD-WeoxV_ijA1iFA0Cbf1vDQdU2-3f0dppNkp27C2cwAFkSWMahvF0w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8zLor1qvqiV8pLdPnGDU6wbxQpwO-7D_JnTtx2IBJQw&oe=6A53AF6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWeKkfziUmkQ7kNvwFjuTcC&_nc_oc=Adr8stsxqPD0rSNsaH4fgmIQ-yq7nG3T3ldH9FEuIi8Z3ibC8zLXKCRyytK6ZSxN6tY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6dIpIHySe1sxhabIojmiJjS__7l9fXSZ_E3yL-qIRyA&oe=6A537E5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U31mzJKyeDEQ7kNvwFZ4y1I&_nc_oc=Ado9EJt3LcPjztiF37RSnEYtaS_isj3qZkUrX1_VdnVdF9EikdNGI8fWoAKh5nv57w0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6fiDf5Ge1tU-UKttDy80EGX2m7RND6A3Dtl-1zpNZqw&oe=6A53928A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bAR3WtUVLYQ7kNvwHYf6Fv&_nc_oc=Adr2p1LDEBSJkRtvXlanAEBsvuUFWko7EoJdxCEofLKVODFOwFnnPF7Pin2j4whbgKQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGOAEcE3-UuJrJlZBmnK9IwacL3vVlR_UpjK2vOsP8yA&oe=6A53AA5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
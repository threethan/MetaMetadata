CK8Q7kNvwEPjvHh&_nc_oc=AdpzroBBUgbqETim4CAEkWhfvULtHa0igsJzWueTrzg1ybqY_KfoWzlzkkrhnkB9mZE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIZ0zYT4aJnfLFcyfkF2vv6pJt0hz64g5K_SbszmkglA&oe=6A81B14A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9INdJU1pMkMQ7kNvwEQCYeI&_nc_oc=Adpj6NAEWO99vLSxj0xhRUeKLieT1xSw3E8yqm0HCooPsEz2Rhosh2HKhdRPsjZ8GGw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZtgGV1F1n_USQCxHADGZgyG6B5-M87NlhfAY7Hdznaw&oe=6A819BAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmplwjxN_SAQ7kNvwGFyD_H&_nc_oc=AdoB_J44W-5pRqBWmaHiefLH5GAOPSt0OvrMimSZsCVmvx9n5NI1xQFhO0fDywYS6uc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwGEAtM5LoWVQMR7ymePcJSMDOq2-X5M-6LVbX2mGX0Q&oe=6A81A2DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG6kiCmeAd0Q7kNvwHeLdvq&_nc_oc=AdrIM9CZ8pnG2OklN9EZPflp7WxSSBIZ04Bq7br3TnKFdeh13nl08p98LG5fDVrZjhE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgkhtUaxhPiHNHsXOkxdec74miQ75FuyKIwWiAMg0oRA&oe=6A81B70A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwRxb5uCEjkQ7kNvwH3oX9K&_nc_oc=AdoMtK8mWJ9WP3KowUWNNIPlZmWEsFCeXeRKYFor1C9Nw8bXNYmw19wMKWBKbwgs06Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbGoy92Aec_9hipUJOMU7aI-EwzLUvusMtsqe06vL7Jw&oe=6A81969C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
oYoQ7kNvwEVuJYA&_nc_oc=AdrhvSmI60bFeA7o9XFIx5JNp4Z0AeRKx-nfE06EQMCAxlPiGE8LC7HNom-ZNHzBTEU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHcUQd43xrseiZ5uGunU7vf9mRpJcqoMaqn10Xe9RBLQ&oe=69CBC24A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjcfKuKOdxUQ7kNvwEls9dG&_nc_oc=Adrt3usRFmvj7uGERPmIASRA4toP03sERY1_qsNgNwmiSWQDyN_I2JFwz5guO4IBMK8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzVzP4zTbXo1rIWXdDSCWaw6pRcT8679ZNDMKlxKDn2Q&oe=69CBACAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J65SJpHr4lEQ7kNvwGY4qx9&_nc_oc=AdrfSkxCdzZZAI7dyQuRIa8_IgqP_ZrxRnJJBtLXaTf3b-AVaUE-R0AcpmIb3eS9pGc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkljEcFgQe3fyJtK5qAUwsWPMAVYfalX_x4VdKAORATw&oe=69CBB3DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlq9nVCI4ycQ7kNvwGW49dl&_nc_oc=AdodUtgd4mNZmQ5nYGP8aDL9PLI0VajGEvebjWJG1HC3TY7odKhpNqJFyrdJ-l_ZO8Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhsNF-OGgXhRhif43N8Wfc5eP6aENFG-8F6HC83T0HgA&oe=69CBC80A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjyABNAhc5YQ7kNvwFd1dbX&_nc_oc=AdoJMMoOfTMnDGy74H_py5nYQki8nHPhjzPdKsPFiWk4-J3sETD7zKrdhbIdmiRq24k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRk1BrTeohLBTNNJm-kzm7Yz1Ql_K84vC_9imO_-f1_w&oe=69CBDFDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
OYMQ7kNvwEyH0Mw&_nc_oc=AdpOwzfdhW2VNCGnQ8SDitf_EqZdkjQTAWFJmdYtSUEA9HXYTLwRKyeexVK4oca8dgY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x69iF-dtFvJasLRWQx15VDhW9qJJRcyycXH9u6dqAMg&oe=6A16E7CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=islxxbp90O4Q7kNvwE4PcSV&_nc_oc=AdoAELbchVb6SHZo-w_NGZNiqb0WVcykAtxbgSQsf76UHVge6hY7G9tByRu5nusXpx8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49owNFadtVEC1BgPidVzBl9-zo-gU5So3sZlqq0sV3jw&oe=6A170A6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z14qVlYWxNIQ7kNvwFYvZq0&_nc_oc=AdqGXz5VEQKU67xoXrWGnSd_O19jDUpWVNKWBDKLSdxARijgJV4NK9vYGFnxQyqOtoI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Iwa6_Ds081ljB0f3xts5ljt6HHzCYJFgrh_2koaq1qQ&oe=6A17119F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGkgDABM1DEQ7kNvwEjuDSu&_nc_oc=AdqVI_VSjw9_erVPaf2nbm6li_MfrNjxrZpCYjnQjyABsa4Mgb75bEZsmqsmVOYcSLI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O93tlHlyLKg2iT5yxC1C4Yj_tDdTmefbOpVlCugUs5w&oe=6A16ED8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfvjGh-7EPYQ7kNvwGa858D&_nc_oc=AdoH3smWGxHqKQVKqKj_ovK_-cnqfH5D4SYhjZUjOcgDJHJBhL0ZeQxJvW53-dSU2gI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78TvmGDIWIK7Qn_WLRWcJeRRm9Yn8y2uIkblxKoKam0Q&oe=6A17055C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
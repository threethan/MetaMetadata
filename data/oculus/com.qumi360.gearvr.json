-rysn4vo8Q7kNvwHRr7_l&_nc_oc=Adql7B625OwsxyNgP-N7cOMa4LgtNGhbjO2EWXyHAOkvf1E2MZTXhF6LJonLen3Ve5s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76UDnUB6JQUoNLshamfKjtT3U4VPPHyWwArOkMFLxxBQ&oe=6A11A1CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUSjiEWyKm4Q7kNvwG6npkA&_nc_oc=AdoIbEi8PRncGESaQd4meX47yGcHSC0epF152gkV-A_g_R18MwwLWs7TgQgMZJ6LZFk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56M3YPUpUodksxCxi5n35Mle8GZHDRfzfCVVPKZdKjUA&oe=6A11C46F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mjbp9QZehAQ7kNvwGimT0r&_nc_oc=AdqtIvPEgbsJmmj5UHPDiMQlJoLUH2-7jMAThxbL7feZfNrG5aUtbkbEbOg8uyKhL-I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J-oqe3SrztL8M_2NroH1iLwHzk9Ly4rFdBWRPaacIwg&oe=6A11CB9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPCAJWZGsuoQ7kNvwFmXAB2&_nc_oc=AdrPQ82CSvS3YxobteBZAh-rfrgWbSVR4YIbXagVOul3JfxrdfBq8zljd5F1V-noHK4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7woI3EoETq_Q_wa7J1ynba4QopI_SVR9KnrlC72idfHw&oe=6A11A78A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuW3UsC5S88Q7kNvwGBqnK-&_nc_oc=AdqwE98UG5fM5mubgrILoyp73ozGTfrlhn3GXrNOPLVCmYD3VU70OxsOq10A7RBEZMA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UWlHkGSzENRAItZ5EXAuHwft2eMLm1x4bsqfgkOqhGw&oe=6A11BF5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover
w_QQ7kNvwE5PoGk&_nc_oc=AdpFAcNSvmqMXTrxtk2qRIsbwNhMpuSbCy3DHd8Kv6Udq4KpfjkHMVrN-uLk8pKaFOk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECMxfNJYE97NI0eDbcnnDPmBZr9Q7XxZLMHQVNpue9nQ&oe=6A86F74A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd2FyBqAClUQ7kNvwGfUYSQ&_nc_oc=AdpdXFhGTU2vFwes338-wcaWoo0YWlcv-ikSur3br9XD3EWPMBpLX1vRuhUwjmNSz4Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6AH9WpI-0kuQhv0JlXAz6IS-OUFGeY3EqmHqCXWrtUQ&oe=6A86E1AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARMM8oS7frgQ7kNvwHrCs7v&_nc_oc=AdqbpvXDOdiWtKJz3sUTDzzLhxaJ5qttiEoLHsXmSIPvrQ6cO56Uq4NpN5LaLTxtNJA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYPAmi8SVYnKhyeTahPFjbGuyWD_woD4871zxW490LaQ&oe=6A86E8DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRtY-7-bEsAQ7kNvwFbWKTU&_nc_oc=AdrczdF91HlFgtSCh3jYzAdHQUAhQuUwnyOGSYqdVHMyCjQTszpH5O9XLtyZ-HtDkwU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFYsi8h73Azv3JV0nHcpOZdjjA8-gPAYkFVRTkYFcQ6w&oe=6A86FD0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr5zYDV5E-0Q7kNvwEHMy1j&_nc_oc=AdrJCXy3kL_RD8Lzm5EU2goLPfYg1h0-QAux9fB7BLaNvJYXMo8iYAGs2tE8omzHknY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWjd47wYgwgOPIATdrMpmss6nkpIratIMn9zgetYxT6A&oe=6A86DC9C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
LaEQ7kNvwHVKrJE&_nc_oc=AdqnBJK2G_n1y44s3VOLB4mVTsovcJvPSPcEecKF8PGM2jAX1u0ov3-LZ7zLH4zKlwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyS_XKPIZeUU5eqkfGAzT4ykVe2oN6YrgXfa44_oRdgQ&oe=6A4BA3CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewzCY078iEIQ7kNvwHZoNmO&_nc_oc=AdrdgH0vd2EPVXQrUKQmAfbYfrNL_fiMjN3WaHFZh_vuq4Zmxj4P4MFlgp0j6lCza_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-IpNklFQaddgsDEcUJWS2iKN8ykjQ-5bqX6XmFY6EtA&oe=6A4BC66F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIs8NeqwqLMQ7kNvwFGo9I8&_nc_oc=AdomBbUt2InYLypHjfuP57qyJRmk9mFpE8BCTo-f7AL2SsDLBpfHf4VY4mXojrP4j2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwPnC29XQl6whVpVJQ_mfUU15BivAzHRnvWTE1ER-Znw&oe=6A4BCD9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFwqhktk9XUQ7kNvwFxBpAv&_nc_oc=AdqBXTKDp4OrPrME4qZFAMXHzP1azrlR7OxSoIqwFDEDwvvcmSYNX2jYnPwFYBnRe1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhCP3Qw0B2ybVeyKHyaggQotPHfBXCqmuO5plWUiwmbw&oe=6A4BA98A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd4osG4jV9sQ7kNvwGI2PrP&_nc_oc=Adomve_-gPoGBu4Dfjq6HsoM8S5P02AdKaNXVwT7LsOBEDg6uIUBuCLj5LwDDI9hj4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJq2i0ZoF587XF3aDJubdk5E-uBDnqQQ6T32iZswzIcw&oe=6A4BC15C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
P20Q7kNvwEX0jof&_nc_oc=AdrMxpO59t39aXrwX4tKeltuUma3Qj467Fp3yie5LUZZpVHCVW5QwZ6XGkLvMhFr8FA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCFpBMEj0zZqKKh7PQvGIsWsUfV9norfiBeuWCZoelBw&oe=6A79C84A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdlK1ticdQsQ7kNvwFFDjeQ&_nc_oc=Adrf_nm1-rZ2DZFH7OUco7_GmfWBzfiZRYbF_eEFxKXnSUWp9uoyiHm6ivZB-W2NWRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRLwrW3bLiQOluPhP507XOJVsOOv78HTqyAf4Qcac-Jw&oe=6A79B2AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OgnhuF4McwQ7kNvwH9fGqM&_nc_oc=Adoc2a5ySRau6DW-YUOD1TK3WGkcCl5om1hwSJLp2AcOMLBtexz1apsDcQ4o6qdRLr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZxc7jKrrmyEdzK_7dq8kf1JKycKcX-wA9zLvpHTsC4A&oe=6A79B9DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai88arjZzQwQ7kNvwHf4xzc&_nc_oc=Adq9JVy2kPAU3WjN09otD-_YNUkHrpg_jVxLgz1SC8to4T0GeH_gyXO5wnrC1ky7OfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBIkKP5T4kJuvi2C5KCmMuIyCJMkUeCJSBEWiYTaAheA&oe=6A79CE0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjoeFnLT1QQQ7kNvwGEuSIa&_nc_oc=Adot7cIkDokiQghzOvHoNrhJOxYNwebufql4dt_mF-9xclgpo79XYYHBS2RZ79lWsBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgNJ4YwtfST6jXRmqjopy-BEwRueF64hA62UxYzceSsw&oe=6A79E5DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
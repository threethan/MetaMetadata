9y8Q7kNvwFg6sDC&_nc_oc=AdrH60aGP3JKaSNAayVmLFuue_Y37Mxl8kLQNYZHz0h3ErXsJ3bgTxidOg0fyvmdfZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHZJ6VbT-xK1QKXAQ-obO8BtQNEj3FlbivSdDw0Tl8KQ&oe=6A9EB24A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quZFVHDpXP4Q7kNvwHn8Tpw&_nc_oc=Adqi1unLQmt3iu5ZxOVDiBWyKy-PbUUmVu08BbotzgmjOUIU2SDkLpbQKRREB37UDBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcU6cgLsod6f7RDxcBAodStl-8pr3DxfsMPhTuiXvWgQ&oe=6A9ED4EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8XlOotfO8gQ7kNvwE36e1b&_nc_oc=Adq9CbVg4VWkogi70afDpNXrzsbwzl-dP5cc38ckKTe4Ca37c9XBkxOM8MfzF6TjvbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ6yt49QH_mzz6ktAOo2BDhpX3i5E4iU-VJ6Rli2zAww&oe=6A9EDC1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsra-A6NWiUQ7kNvwGaCqNx&_nc_oc=AdokCyi1nKHJ8HzS1O4tcmeJSmBccPzVhfNV2LCPfybmwjaQaO3MtsYvIvHIJO6z8iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA8Fbf3-opMGSD-3FyzP-VH4vr187QPW-1IlMWA6pE_g&oe=6A9EB80A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQGoBd7fF3YQ7kNvwGBT7tl&_nc_oc=Adrt3VF5hsj0Yvsa5-rN4OKR4PPJ_j5PYHDDna4xDXFgaZn8-zff8zMBKjnRz_NIhqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlUNh5PgHWr7YYJIZiqan4ke3i71nqAJeyHDxmVNKkUA&oe=6A9ECFDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
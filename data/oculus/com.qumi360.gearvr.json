rm4Q7kNvwG0UpFF&_nc_oc=AdoI_KQO5VuVWFNJj2HFdVB5CKeITuFDsWqzRXZSUs7yUMo_uC1blm26xNq4hDWdTfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sfn5tkhXVQRkIvPchLinBGoVPmwXji4owJAAbzjy-uQ&oe=69D259CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spL8DTK3G20Q7kNvwGv6oTR&_nc_oc=AdqL4IpGeNWpe_B-Qyc7I_-kwnJ4YTMIxCJ9XnDYuE9CW5Rc1CB0I9D3Mi679LAlAkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ACpW9cvPDLnyaRCBwA47m6aFoXgK5HY7abh4FSjhtKA&oe=69D27C6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjyWs37243MQ7kNvwHjy4JW&_nc_oc=AdoWqjCx2xAAiLf26v_4GQA8b-wF2bo4UbN5DHcwj5bfbnZeNch9MXdcUaLY86WgcxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X0mgzPE_8mMm13EGFuF1lvktKUuVPu_UHtYKRuPP8GA&oe=69D24B5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SybTfO3MoAQ7kNvwFtuu6_&_nc_oc=AdrmQcNcCK1zc2jDo6kPMwBEH_5AbbPJ5u9DgC_JVWP9io4OPqxZUeea8cwRU9jE1l0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GeeFHOycFDAaywtJuWEXwlSVN3aBYoNspFMUh_9xUow&oe=69D25F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE-zndQGEcYQ7kNvwFiPZO6&_nc_oc=Ado-wEF_keqi44z1J9vD_Z4n0ZMZkpJ1zeS0dm6W7huhOvlJsrMRdXSn5DAQ6TNZNbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v76H_OCPvog6z6td9vJwCnAEpJq_yDQDOk3rlPbj3Dw&oe=69D2775C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
vIN6&_nc_oc=AdrjFTjH_yoMrbewwH4o5y5RF8EJtirrbKfEIr3awBLGnfsDq1YiuAMuJ_Q2Aa68Q7o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPey-aY83lABaf0G0LlkIODNT55Ru96mPa4c0BSiGTS5A&oe=6AC90C1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi5ZUrcuG2MQ7kNvwFn2sN2&_nc_oc=AdpvOoQv_FG87J4adGbD2rZWq5GaNOWuwegZR-A0j_LPFrELqJoO_-qVrWZqnTZTQ-4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpBuze2a-ravlIhDtmRft-tANum1PLxDZ3CDFXcQFOrg&oe=6AC8E80A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfh1nBteI5sQ7kNvwGOSnrO&_nc_oc=Adok3K_t3DP5KA6B6kScmjmYfMRZmvbjifQOxf6K1BcBQQvOc7-RFAVTFSDwZS5k5LQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx71c74cgK1FHxUVfH7lg7tglpVz8iv3GccVx9ZHcBpg&oe=6AC8FFDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1773554239383655", "version": "1.0"}, "id": "1452944214828237", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1773539719385107", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1773554239383655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1452944214828237"}]}, "change_log": null, "created_date": 1511259800, "id": "1773554239383655", "version": "1.0", "version_code": 1, "release_status": "RELEASED", "status": "
q9qmiD0XMag9oELk558IAuRbgYjsQdsbUR2gHQLS7WC7p6k-HkTy3THGvg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTefn6t40Xs7WBmSlN8OpBMDe9zro7f0imSqaKB6Ukjg&oe=69B7FBCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScSBcrflsIsQ7kNvwGiOh8X&_nc_oc=Adkk8xEBsLx2o7VWfJ_7f_9Hlhn9sRha3HjS16SKStkeyO1Uofrd5een4lUVLnjQqDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBAOhflqPP5dp_jiXCTo2aRvuKY3L9E9mvZKAvyqArQw&oe=69B7E62F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtweXndKRRYQ7kNvwEWqBP9&_nc_oc=AdnOiehWIUCFmW3McKG-_vOVz_N9vxsxzv-qMwi4rjjfaWZ7oxvalojPmX9RQ4OHf1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_Ghx_o5s6v-M7_sAWb4ahJKkWoLg3ptXvsHV6ikFNLQ&oe=69B7ED5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0GHHEMrsp8Q7kNvwFbrz30&_nc_oc=AdmpoFyng1LOOOZB0LPWWlO3xO_gOSnZ_yCsf8ISDc3eVGztngzRWnTHgbjmc5cDflU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZxijL75NWq7lPHMGf-uvMe8LpaSdvDXs08PTIOFq1hQ&oe=69B8018A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_OI4vLlq8EQ7kNvwFw__B0&_nc_oc=Adn2EHbGAbcD9goleoKWOmaPpoT3JTH8_BChh4DoPfLHwcui3h6WgZTHalqkJUvzO6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxaWNLwjTk7v-gDfLSKZyjnndxle1chWUdHWX30ojQjfg&oe=69B7E11C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v
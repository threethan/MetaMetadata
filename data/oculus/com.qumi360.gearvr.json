vo8Q7kNvwF7AVUi&_nc_oc=Ado2_7YpBczN-cUlCCYx1lomyeq4fuApumFLjN87hPHwiLFqbXEN6jb_snJvf2HEdIM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_AbDPsgTqkZL3bhJ5NS670arZ0DyQTmAw7zdW-Ymjzw&oe=6A0EFECA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHDSFlb7blYQ7kNvwHmrInk&_nc_oc=AdpDm8nrDb7dRBIw-AgdGXs0PsCmgEuZk6fkGfqvs5WPINWqT7iuR4wA599Vzjc7Agk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ESsJn3tCMdD801mdVskBchwB2A_Yd-M7QUtSALygSvQ&oe=6A0F216F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qryeStsScOsQ7kNvwHc-O8E&_nc_oc=AdoEye1bMCRKPqhtrONempmZ1E_ixBzA938sm2G4MQflyTaDnDBB825VN5PPdmpTTxA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xaoHTdYGBadBbysHmCv-z5zYnrNdXbsajeFOK64q7iw&oe=6A0F289F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPCAJWZGsuoQ7kNvwFCM7tq&_nc_oc=AdoYLtY6B4N4-2y0lnUohCfz5_eW_DI01kueDcXDdQXlWxD3mKdlrp7REOXSyiiD4uk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dNbaHHlWWbQ6S5y-iKsQ93Kl9It9Tg3PjI_nMnuGF8g&oe=6A0F048A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7rg0HooSngQ7kNvwEHeZBZ&_nc_oc=AdpjgEas4PEVjlh9PMNl_y6GJzV2nrrPGzfMXGzs4QnDwXsBZCCet9RqyHhYrZiK2HY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_CymGrASecmkP8vyjruc3SZzSkJvSiOHzFrDZxhw8cg&oe=6A0F1C5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
issQ7kNvwE7yjcp&_nc_oc=AdoyPCLVMyUWBi6MOWHd2H7Le_h94R5sHVyXRmwqs7Z1H-HgMX339jVCg4jQGPpq6ns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVDbA08aOj0SXXDsEYE3UGUKqo5nbcBiS_LlF5yI4eyw&oe=6A5F6A4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQW8lkpcLc8Q7kNvwGgZlbH&_nc_oc=AdpIxkFRPZqIy24atJMZb-kpQ7CK1csyb_h6erG01cHX6FxihWOFcD47X0l-3NKg_w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZQTnz9fixK7SVcD4BmohB0VBjqmSaAwxYWlHU8dY0gw&oe=6A5F54AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBfblKY0DI0Q7kNvwGwI3Yk&_nc_oc=AdpUJNCtGbLjIiOphT9kcPgKIe543uajPwxPQMlPQuHcrHaYMb_czMHmT5L99jhOkO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-a-yHPzre44e-RJOQF_jnRdkAFTKE1diVcN1G1NcKvQ&oe=6A5F5BDF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLJexbAJ308Q7kNvwG7mGyW&_nc_oc=Ado9tPUrqz1XymC5EZeh7BNoWhqPFx-xSuW7Q3MToXMyhAQrJagEzSOrorlmkefnaqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAfZbSME0UalAq0rtcINFZFX9OcwwymTwUivb21JqtOg&oe=6A5F700A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl2L8jvoyFMQ7kNvwF7TpsA&_nc_oc=Ado_HdioSrJj6piYEySa4RTcOcnVkE-fxipwM0FXVZ6-_bwFAF2NFdJJjYAIiJxuyxc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfoD5eRCjRo1ET4UYzOe7ajp2NnHUuy7y_yqJ-GJLf3Q&oe=6A5F87DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
Iw4Q7kNvwHYfAFL&_nc_oc=AdrsBUzVkRP6Rg2FE4OyGL80r1MWXvyzI44Imudr8iJUuhBCvgkCiXJoy1z2gZ53NDY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8Px6xPzndW_O2mdY9Xszaz9or8xk8K4lSw12-eeavjg&oe=6A9031CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KeTR20IGW0Q7kNvwEakw5b&_nc_oc=AdrWrg7c5XXin3bT-4YlhHb5HInqhz5A0wYX2PZ9y1lzZyAOZmiQlqsudqM2gSpup50&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHViRKdfjKalsS-9n7nnrfjo56ecUBod2KdMfQNwo-0Lw&oe=6A901C2F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgIA1lYovL4Q7kNvwFHUdPI&_nc_oc=AdqgEJiFFf7gPHFQlMq2nUiojN3zuBzaTSuHxEB1oHVW5i7pOKufQnB_6nOzZT-VmP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGySx9JhuHhHGQ7o9J3NlBjeUf-rsO8lNJyIIp5YqTUxQ&oe=6A90235F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqjU_Xn7KQcQ7kNvwEFYjv1&_nc_oc=Adr8LfOsp0gZq5wN5fc1JktJVzW9t2ZIEiyTq2SeiGz0R6RQnyM02iXDsOrYvu8SXeU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCRgUAYkAgkN1ghu2WRa_ufuHDSbgZy54CoaY87VUHHQ&oe=6A90378A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ2VhwIFSHQQ7kNvwFoAUjk&_nc_oc=Adpfk0m1uas1o2hgXDzJsQDarFWAdg_aiIigO16sOeYYDaWQqJV3GcP2JjC-oCo9HbU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHauun4_e4iZm05refhDhyk6a0O8lWuhobwHDN_phAatg&oe=6A90171C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
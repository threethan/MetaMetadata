gT0Q7kNvwFmzowY&_nc_oc=Adqrgf0Ry771eJOAs1fW4mCq2HS08PFMcULmCJ2gSDcjacpQ70Yr7Q_N3FH4w9z_g7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp3lL7lr_N6s8aMq6glYtW3WLQ5tQ8OHpyHnlJ9Gw_nA&oe=6A6601CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC5yo1Ng_W0Q7kNvwEi7R0K&_nc_oc=Adr-uKeUSHbeoVnyO00nWmQhbMesFGDNFl7NSb5nRkYzy6qjZlT4v7xERl8KK5JqS8A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB20OZNu7Uz0q8x3IPBdYAEz0GJS90_cHWAxAWT3pZ7VA&oe=6A66246F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6AOZd-M9lwQ7kNvwEfVObG&_nc_oc=Adrw9IrcfRExPyJO2-XA4n2UCy1ZmOgffETcyDjKrbBo4RMcHyrrUHGmVDf8UUlkeT8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB__L5DFU7kCIekAiOMvMN9wtZlIxcBslb8p92KeCM-Lg&oe=6A65F35F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Xi5c_cQvZUQ7kNvwE79pra&_nc_oc=AdozOG4mTjJV7VrDlDnTXoYkWRYFHyd89Od_hDUk-HLJlIF7O1jloKw1rn1PneihV2E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZqYAesptbjsy3_sjL6hKBWlL1pDtqMz8hwpZHYpZXpg&oe=6A66078A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFvTbdHWB-MQ7kNvwHGUK14&_nc_oc=Adpaz9MEsDmkhr4IVs3idN-_ALp3wEsoqsNnlSThySHVbUCoBPRo5LrcDfjAIp_dg70&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJdVaoWZBxjI7QalFb3VK26kFvITC5J4hhmOMBRxevmA&oe=6A661F5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
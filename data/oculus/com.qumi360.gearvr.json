dT0Q7kNvwHC4Mko&_nc_oc=AdrtrQ4r3Mxr8BbANfHq32fTHU_G4zsbTgFBvyTGUYFt5B_Zi_cWiM0duLh4TZJRm38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1ncehOENqpQ_XAcCpkEtQE9Ioe5Ehw7WEkiURuNg6uw&oe=6A2D514A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzk4mxA85loQ7kNvwHLvRPX&_nc_oc=AdqFCrquDG76qpnIPtvyXWNeunvD7usJdviIEyKko2Mz42wZQ1W2flhy8f2eJ3d0Yt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F9cI_0DV8HS3oZSpM7K73hA706vNaHAIY0aARsQ7-BA&oe=6A2D73EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONcv0Cyqk5cQ7kNvwGd5Aw-&_nc_oc=AdoR1n_WB1VaIlKWsjhQU_cs4KmuLnCiKE-lKFGdMmEH0A6CHnLgw0EIHXWbKXNdTBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9swjYTH1NfwmrYjb5aQ0lC3LYlZfhNPx4pomHiLBARYA&oe=6A2D7B1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr1GQJ4HUz4Q7kNvwGEuH2r&_nc_oc=AdpBxXPstfdTCvPHhq-wPWvIc74W_oSkOVpni1yaj_bosl1AdUZgQ3r-ZfggslT-1bo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9deD3m5PPPa48B6CRCp0k2DRWCFm2XRVrT9m5M5OgeNA&oe=6A2D570A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eESB1aQbWIEQ7kNvwEpdHnp&_nc_oc=Ado1W0HyNxjEswhyhp8xWt9siheho-zrrUbCy1GrXNI0ok588CfsgvCKjcs33PgsMUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WYcEyyS1ASStgDZ8kVSQBpLNhkZB5AZyCJqOoXQB5uw&oe=6A2D6EDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
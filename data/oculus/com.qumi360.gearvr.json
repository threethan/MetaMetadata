hc8Q7kNvwG1BoC3&_nc_oc=AdqMY7Zfku0h3mf1AUbfhY93bCjPN0AOM5To1BcsQLfmS8ZCB0yI5a3ouSFLMmjSz_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFsZz5wM0MZZFydV22Pw2B5vnP0_WGXVXGkqvCuIjvIA&oe=6ADF4BCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_nUZxP-pJwQ7kNvwH3EYVW&_nc_oc=AdrSCxiuv5pphyU_rDqaIK7XMRAV7MV3mmRLKF9hYWgKUuBmm0uq-33I8R_1C9tkN74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjo7qqJAS9ZxPDtF5eBvek_Brk7QD2bbZwl20c8hTM9Q&oe=6ADF6E6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv9cseZ4g5UQ7kNvwERXGEF&_nc_oc=AdoyOEi8a2vsmzpenPmKt-en23M31d57Cerm4sSn2QOnX4Zk5VKwYGF0qlSpI8pcOww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdV2BQunjzkTCYRfXJAQPVi3QOdLWxkNhKdmirzUVtUQ&oe=6ADF759F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZb_VAOLOCgQ7kNvwHKi1_E&_nc_oc=AdqJjTwHY_YerOAXGlU9uvb9_yVXx0UrqkeMK0XLJg-QGP2yhx9l_pqDkXdIlFNGlxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4N0vLLnWhOX04uq_2nXTO4iU2-Lwa04KkIgYLb08Fog&oe=6ADF518A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMPNbnNeUekQ7kNvwGMBylM&_nc_oc=AdoloY6rf-1dCbyYxIKEseif6ogrVijRzza5Checerp0PLqK7zn0svOl5rmJ5Pp3das&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjlpUdowfOpAn123O7dl6N5jyO_BO-lJZyy4Bpe3pcsw&oe=6ADF695C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
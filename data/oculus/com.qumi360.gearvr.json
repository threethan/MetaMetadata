dT0Q7kNvwEsQt7a&_nc_oc=AdrJuuW2lG0W0gCp41SqyzCweByr7f1elfMUKnV_kmETDzz--OkMTlrod4R5CkJ7vNw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Id-BTkiFoOALLAX8WoMwvPTNi2iw23eoljkyRBnAKtw&oe=6A2BFFCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6OjFUofbVoQ7kNvwFhSe-y&_nc_oc=AdqS2XriE31syM20Ewr02-XVqufNMBc_0h4LidYqFf3zoWd5zy4oNGRsYjeJjnkQlHo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y_JGq9GzYZTeRLhG4X_3-4It1IRmLEu6ZlxZh04B8AQ&oe=6A2C226F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLGBvxt4XlIQ7kNvwHjAs5Z&_nc_oc=AdpYsMwTSyx6nitv4eyHcDNE32dUBD0ubnvF8BExixAQTeLIWP9x52ZbQ_5wIL-ALfQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s_eJrDGUNz_UupP8Vj-4vWIplQa0km6Oumcvf-SPanw&oe=6A2C299F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr1GQJ4HUz4Q7kNvwGQCoXS&_nc_oc=AdoNzfAamNrKO7P0IrMDmO_eydWPaR1cLM9_2qhuqZrqXCWVprSz25E6Iy6NxjwEVWw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9GRlw9UxDVAvCpIzJvoeWobNV3ojjFtNvfXbfhuwygw&oe=6A2C058A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYdHZ4t0C_sQ7kNvwHp_iSY&_nc_oc=AdrJkg-qthLxw0q5mwG73gUEzCbfXXZ7XE0ojIv1lPGHaGSnCmVOhX1s5yy4AWQZu4Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9neGInqx4hVYJUtx2tZs552VFOcE1niHMFGEITj053zw&oe=6A2C1D5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
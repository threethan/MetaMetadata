vI0Q7kNvwEZQRHi&_nc_oc=Adr-b2Pc9F3MF1AM3OghHSs82jpIMFuNfiu_ovWbpqU3JAXDHm-p_DPRpeSr_FsBuoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvrLHpP7XX7hNx-s8Oqo8jdq7krKg0D3x51P5w_fJ4-g&oe=6AE5E34A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0c96rCS1c4Q7kNvwFTMBU1&_nc_oc=AdoGVsbd01Amd0BOY6tZyeNNlWELpnATxwZIKMIZAFrB9otFAw9Yp1lqWYoFeufbaUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBeIpUV6A2g5Z5enJsqQexA4nthtEFKPQU6Mu2n2GxCg&oe=6AE605EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss6QnmitzkIQ7kNvwHU82Ms&_nc_oc=AdogGomJK9uV09-3N_N51ipWWY3Y5Kic7fOD5xXEU0umHDk8VtVciej2TYF9IdnxmXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV-aEGfvUIRMNxbuHhNqFduF4LJK1WUUGswQmO8uEdWg&oe=6AE60D1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw37yLCxeqkQ7kNvwHKjhEz&_nc_oc=Adq20CZwxrF1MpqfSPEtShv9rP1jZtDs6M3_krgcd-zND3th4dF1zYvp83uGsJc8XDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTfd2j4-1ZbudGf_-DbDANDWYQKsdSSql2nU015LHkNQ&oe=6AE5E90A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEZKPAU_lzoQ7kNvwFoPc8Q&_nc_oc=Adq_MBCGPKkHiI8d47yaMnSqrECciCNFUwLcBe2TrgmzfuvT2U11p5gdytU3aBACkh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsiIqHdv62PmuKZFadUzt2Zt8LrZkWfFnBYWee24az8Q&oe=6AE600DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
xJQQ7kNvwGDq8Tw&_nc_oc=AdpEWOf9_OSVHjdcQ9t1KXbmQCeNp19qgQnxXXvMfJNWLYtQ2pTqb0Lj1VZtdf68Li0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGhtPA9FfkVhAByJNafBnS-F4FvU765P5CnmMsCKpWWQ&oe=6A95B00A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqmfcFH9tikQ7kNvwEf43C0&_nc_oc=AdrF3Eea11AvorgI8Z80Iu9xFhM1HXjHfeF5oFfDc2GxuBn_nV35Yq1LcWIPtFNAPcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpYTwqsi_CiraspkjAGFK_hl__9ju6otkcm6PY8zEb2A&oe=6A95D2AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggrM2nwXkQcQ7kNvwG2Aup8&_nc_oc=AdoqNoUTbN3lAsA8-GnAqU8VKp6wulFRjFW8T06ZeuhSmGNxPLWjaOtnMU54M5FHPqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4UAFw6ODeMyw8fJeLj8kxdRkDbmcFUP8SGtHcEjxoCA&oe=6A95D9DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHQigcqcX54Q7kNvwEr8RHo&_nc_oc=Adp4KtID5seREzxeWyHwZfKiP8uTyALjY60YXYqJZKwzPGx1KfZTpvlsk7J0T0rylEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWirSn00wzQsjqKacRYNtbmui_ZxpRuDQYQPGTa4Eqrw&oe=6A95B5CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KzTXxhwsjQQ7kNvwG4l3Eo&_nc_oc=AdroSIJVaP1Xrd5ZTbzjJKSjD7NhbJG5Xw2kctOo1Sd_4yGtkgGDGxBlBraORxk7G9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaWpLVwc07U_UoUws4pP4ymmxxadfdvmfVSvtBDClmTQ&oe=6A95CD9C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
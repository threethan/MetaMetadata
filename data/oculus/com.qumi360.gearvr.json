gw4Q7kNvwG1vjpr&_nc_oc=Ado8Wok4xfZeljERWhCalyTwni5NtubuUvnH-shVu6ZoIRqpj52xGe7Ewt0Y6Q6_BnY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m-CHmoGozOaYtWrvgyd2JcT5sLIA6WAlXXH5rAZ2ayg&oe=6A1C2DCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOezTi17u1wQ7kNvwGBLpHV&_nc_oc=AdqmeFQEELsNxsvlmzeCJG4ygDFWPuPVXpyETMudDiYcXoe-uST3-AXX_wSr57oo048&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RULuNxGV35RnxY6plOg9uYZOBgKoh8ZGHguuLYQwJvQ&oe=6A1C506F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCsR0GDnzWIQ7kNvwFljj2f&_nc_oc=Adp6DDpew3SM3WgEibRGpMwQ4vBYeC4Gg1l-IYpW51lUCdpytfrofJIn4yEDI3i5RjI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gKf3QI4y37hevdwBRDKAzfgb9pNXULI8n16hozYFsGg&oe=6A1C579F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA1DKxz0D-sQ7kNvwGG4T8H&_nc_oc=AdqsbmKgmHZ7PcuCZEbPe9KpzvP-vJphwoWAesH9IlTc5prv8HX71-QYPUz_zlvk6rQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AvtM78jjO9RYqBWmA3NXQ572LO0CGW6dVgJPp22KINg&oe=6A1C338A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO9ZiKVywccQ7kNvwGHTRC5&_nc_oc=AdooYgDrHv5uiwvrzplPmZDCO7LUXbG7WDav0Vz_54K8QdjoONX2q25_8jBW3LfFnCE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L_eq6N-_HO1jKNWHihXX7qgMvfG71d8fPMHjfXqpbsg&oe=6A1C4B5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
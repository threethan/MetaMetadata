1CUQ7kNvwE7p0bP&_nc_oc=Ado9Hfiy4zHDSHHD95nNjybagYRkqzUkBNQ7YKn100UvBifsDBwuJC0DSn0_xu2Oxic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsz0NydyGLHIdXZWivZpwpyaQxLVVwzXrNnlZu7VAILw&oe=6A6B47CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrgQJ6X3ia8Q7kNvwE_50sT&_nc_oc=Adrf-rQt0kuSjBzPPZYGoKnSNgOHS9UTk4nzKTA4rbTAbFKch8Q3b5VDV_Ker2E76iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa9NLxWDcBhjUgP7qqF7EoSA52yrapxKiLV-zu9mUoXg&oe=6A6B6A6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yd2oSlseIOMQ7kNvwH0LL-_&_nc_oc=AdpxiZ9EdnVzRLpTEwfJJWH387tnOvoWTpZhtHzFnCM_ul2yv6nlnswrghaNlEo4k0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNBDA_CACeBtam93JLkSuNJZr2iTQ4ln1jxILYRQUFBA&oe=6A6B395F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeZbH3TQQRQQ7kNvwG5J94f&_nc_oc=AdptruzISclj8RUBmDWUtYGLVW1GHHXJHTvtrN-_CSdDm7_CUf74x5Mt4lqnrCibRSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhs5akOWRfqc5G1qhtu3d_vdkQJTTiGz3H2gSpmfHMzA&oe=6A6B4D8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0cayb7vP70Q7kNvwFN8ac5&_nc_oc=AdqStQCPjUCutks5ZfmzcIKQGzRuC_v1TzjMZFOOiNZiFIAi1poTOsne_qov-23DI18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnkmnTo8kXnvdAQF1CqD17_E0su2-aVoGqazzv64BwqA&oe=6A6B655C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
nFEQ7kNvwGnANg4&_nc_oc=AdoCPUOa8br8bUWToO8iSrWoxn4-YXLZMMjwpPms3J4vs99ll6HXnKjwbpFr38hAdWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pHX3Liqw7sjogl5hIEf74_IFmjOujvegBFtjJhe8LBg&oe=69DB944A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI9YNvCpr3UQ7kNvwGH5aw-&_nc_oc=Ado3BZAkdtynwOB4sSo9GDR5XniiJ0NQkcsvD2jr8xbUUDcN_cpg7jrk2q15WPYR0zQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r4jKQ8Zsx84DENlIXSXIiOle5tNPvYhdqxE5_XCeMRg&oe=69DB7EAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbMIoT_Fa0QQ7kNvwGkvQlf&_nc_oc=AdpJcwrtqJtloL-8lO7xxJzz16BFUgEpivGX19TECHczdriG75kbnR0uBqukEwN3Tac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11T1JhSvioYkp3b5gU9lzmKgWYOHGOHnctkfK74yTZ_A&oe=69DB85DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-lNZVShWx8Q7kNvwHfssj7&_nc_oc=AdohGDxy3PRoNrOtsJR3fQ2qDS5h6UXVhgfg00QWbEyQwB177P4doSqMx3PPiAEp6I8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KjM0O1ZBWlf0NvmeHCQjv38biqdCaEJJp7iLSb60-Dw&oe=69DB9A0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mU2tv7J5PEQ7kNvwHBLrTl&_nc_oc=AdqFrdGTR5TMDjUVsTCMy38ZPjq3DYP_BOE8PdNORmZ30LMkx58ruy6BzdVCPTV8xIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c4iYWEOw-xmIGlcFRZ-oSVJtmKn3NivvFjtoOze6tIA&oe=69DBB1DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
HkhQ0EexWpweptU6zeme8POvc1Ws-NX_uk0zwdX6v-rD-Ok4FLp1WG2FwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfziIAtnzAB5dDoZfEIHxbeEE2smh1d13Hj8ZwD0EuP-9A&oe=69AEC14A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JerikiTs3MQ7kNvwE7qqKQ&_nc_oc=Adk6OpUMzLFkMXF617y_lkMCNG8nStAEqK77WVRXbWpI-MjKneWB3-mAEPcKAGQqDfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVsLA0z8uiUuwq6VXrtyEhOfF1qX7tR6SjqYPKK0WzkQ&oe=69AEABAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eaYs8AHeQsQ7kNvwEKGxmu&_nc_oc=AdmBKO4OrGUrcQDwk1qXngUv9rWBRV7u76AvRPdiuxSzW9JKlUGlvjT0V1otc9JZ7QI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxE_OTer6wEu7upA5VrcbkaWyUFYTf6b2xauS546c2s5Q&oe=69AEB2DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRKYFUvNXAkQ7kNvwGq4kpQ&_nc_oc=Adl3UefIm4y3QRPWpMNkmMaAVDdxT-qSB-BBpMuu40T0fT2zKlV5Kqt_UTwz33UCp54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzolY7FzErbX7uXQYFTE4dp0A1Lgm6Eju6quM9zjVG1BQ&oe=69AEC70A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2TgeEXFeWkQ7kNvwEWFeIZ&_nc_oc=AdmxpEz02Zg6q4IqgJGwRJLWQRxIeUHV5CzOhUFVT72_gMI2d7HNpHlSxzNZBaFxBD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwhc2Mnb8gO7HMJ1Z25wBr0uMzx2Uq6wPA8nyzioJF5vg&oe=69AEA69C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v
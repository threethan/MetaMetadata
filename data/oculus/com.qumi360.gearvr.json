GGcQ7kNvwEqErJw&_nc_oc=AdosidiNv7-RJ3bdG4esCIWgNkR9S1CPznlMMtcWatf9kNzQG5sFuQe1RR3Qy1P0n8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M02x062NWe4eemndYa9s52B_yrUmEwXLXqFNvLhXtww&oe=6A03214A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS5BQ2vdXFgQ7kNvwE1a3Ya&_nc_oc=AdrraIicnUB7bGoStErMFq5GjLRvOoK-jcIkSSiq5Rf04JvEI07atSgvQSZIf7qxuT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Alpw4eBbhiok3j0dGAzsaunpt5MEA0hQs8qLEWgd5rg&oe=6A0343EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8ROH-DDsHwQ7kNvwHwakqK&_nc_oc=Adot_hxA0BFQYzEpCRkJQUJu_nJphRblkYopn8yxWhodO3KkpY5V3mrPKEDpz90Vyao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JB-TJmTTzS9RVtQPfrKlsoIkwbVI1zRu9nIvo994xjw&oe=6A0312DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0eyxsOCJ_8Q7kNvwEcD02C&_nc_oc=AdoBjS6rd1msjU6nGt19MgUID_PdYG7mby5V6mbwjDwGrWAXHt7E6NaMkIR30W8Hss0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4giBSVnWrNRGmYq4nwp9krxkdq3hBywiX60wmWdiiZCQ&oe=6A03270A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfzZV0OFkoQ7kNvwEMbaa8&_nc_oc=AdrDG73GzRMchW21hWTXfnqXkgR2wkXvIn0sy-LoIuHLt9sJMokdddJQkAmC-haTdkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LSO5wzaqEh2HwKVf8JADufNNLNTMHyvZXnEfot1yFqw&oe=6A033EDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
nFEQ7kNvwE2joY-&_nc_oc=AdqUvoZb2n6WrJm6wbgGUV262zNa-Wh8BpoGRtW2JaEUZskwBOG3AoqRiK2_AThfAxY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pPl3SW3FMe1yTuig_mroA8BMHQG8U14xHYq9NKf0Idg&oe=69D8F14A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iai2qSAEHlcQ7kNvwFDXsV0&_nc_oc=AdoWyARZu5-_w7pt8zzx2AKHeVYbbUKiijtvdu4EE544SVk-5UEuSQN60_DQD6oYshw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25mGC_SBgjLavsQmpjql7Li5d5W3y_faQNO3atcGySsw&oe=69D8DBAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXVT4CAfRikQ7kNvwGH36BQ&_nc_oc=Adq1Jo85gl2i4kTITO5hkHsFDZ_vTHszKpsVWE0aabbFRwFaQijvTPY0RZcrIv1WTDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04Pe9qwfzRohwBYwaEltXIDb1n1GwoA56nYGXO-4APFw&oe=69D8E2DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me_4wG8YDr4Q7kNvwHr-Z5i&_nc_oc=AdqnrmFR-GfzX74_etivP8rByauHrFihAc4K-chqzgczUCsAyv4qbwAC0pJVYG076Ts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PM-SvnaqHXwf1h8gRG_qUklenDTJ6FQ4VMnpzo56ppg&oe=69D8F70A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDdX3V2_T88Q7kNvwG8e6iW&_nc_oc=AdpSaQAHuGbKa3w35fx5zyG-A4AvkR5gHX7db7fe3s_uxdwyPiYgueTOD5JRRc2nUpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26PU2ArdZ3u8yb_QuFk7sKkgeNTlLy3kOaFhoN_0P4KA&oe=69D90EDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
Q_cQ7kNvwF8c3Kr&_nc_oc=AdpNTySp8Nb2UJqpm7sZGK9q2PeirYMkbM4Lk938NSFq52Dv7shuZPGkvFmRkcUIgD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57_rteLy4IqLtMRkXzpQ32XioAAQCjTK3XvtXIT4Cfrg&oe=69FB384A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWpsYA9XYxMQ7kNvwE0G7ai&_nc_oc=Ado43j0y4i35Cns6xpg-qTH0L6X76XCEAycxw5wJT3uNSq3-AAA5Fq5zPfxVdQxH5r4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DIIJuzmiq_3BEOT1Mll-v_WGL7OnM1dGA3bMr5HkhOw&oe=69FB5AEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jbXZZhFUxwQ7kNvwHKHcG7&_nc_oc=AdqTSxwzLVhpCbi-ldTLYDPuScTs1VtT1b1fcfmBw6cPjRWeLllxILDhgLN3AFCbKrE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XeqCvzfgFD05A0-4LNL4hsPiiMpjWDdLuh0LP9n7pCQ&oe=69FB29DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAVDohyTdekQ7kNvwE139H2&_nc_oc=Adr1WwTH_mXToY-CqDwpzgtaWXjotH7XNNR6x5jCmxDAgaYQuCljL1eK8GYLUWCJQB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bOicI2QfUvMShEzbNkFNYtCoz-nMyx4ufm24kZLIcBA&oe=69FB3E0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiueBsWPlOEQ7kNvwF5MHCB&_nc_oc=Adpqe6--yAtxEn2H4ahpz2PlV0qCCtirI5qEbBUxYl-uQeycBIwqglvzX0Rw_KOetRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p-lq_07jR2ip4JTEMkkOuLMYCfgT1uHCypot2Z7JThw&oe=69FB55DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
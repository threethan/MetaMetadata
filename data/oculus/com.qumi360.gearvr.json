EqAy3JC-kShooxykZHFucO9et137s9dleUyXH4z3lZOmM_OOznTA_FTNsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEOFE-9cuwpn_K3I89L6Bi01sPMyeCID99_n3miytFCA&oe=69BBF04A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2l-uhCShGoQ7kNvwH-swgQ&_nc_oc=AdmmTdp3iD3tUeemYCO_nSxh8fFclDWAPDvZ12mCoARf1otnl7e4nmGX3QUtGoGWCVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3NcrLIP09bGHxCgzcRrYEAd1OAWj4-Q7M0kfCJIMVtA&oe=69BBDAAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbKrPazQn4MQ7kNvwGlr-_O&_nc_oc=AdmQKCc8jmE1vXss5_slpgLz21rkrjygtlRBGQJjDRafjz0RD5Gqg11cU0cYC1DqqaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGBr40u-Y0WS-MnJpTwXMd2kIEqEruDjRFaLoJkzIEhQ&oe=69BBE1DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFEB3NEPGjcQ7kNvwGcJ5mw&_nc_oc=Adl1On-Wz6vDLL76JPluyMX-P-IuNabQmy3SjL-6swGG_CIrFpx-6ew19XbeBSqTkSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcIPugHp98-Tq_GtsM54re1FNlsNVHbJcEsLBBdS7WPQ&oe=69BBF60A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN53I0zqze8Q7kNvwFR-yf7&_nc_oc=AdmNSzIFk1wqgdfqwWMKSDxD7q-jMV-bgVMAM7WPjpcZYj0P3VS32-V4sh2jeXDXuQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGdet1YQBbBLqcoKU6uI4pOM5faq6L7jSBmcM1CC6FrQ&oe=69BC0DDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v
DooQ7kNvwGCvkwJ&_nc_oc=AdqnjTRetE20kCxfvk2yVoN83trqV3YExBZqQ_EmNy8diSYnThJP4_mYM7A_FLMSJXE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dMSgQd26Z5qE85jLatk7RKIxevODtFGFibg2P_Q9Ojg&oe=6A3AB88A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDzAZ5nyyr8Q7kNvwF8QydS&_nc_oc=AdqxhfteNcb6n3Wu6XIyDBe-1oY6BrCb9g6aIm3-iKVRsE1aC7Y_D5PWE_svobR0MLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M1QZ6JpG3BUMX0FDlTjTYXS0kxG7kDEvakXriDOVHPQ&oe=6A3AA2EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ecdz90nU1EQ7kNvwEOFdxx&_nc_oc=AdqvMzcRPjlctKBkD-oAzKAhOASB7jtbVxTctmMnfmt4IDFEmVjBhM6VYVxajXcNOkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WOcxixrXeFLrYp9x67yNhQ_1Alu_4-caDu7ULUEHhGw&oe=6A3AAA1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zctm_FczHEgQ7kNvwEkwExB&_nc_oc=Adrt-ZWRJZLkkosDKuMhfweLlD6P-kvON46eGtlWNRgG0Pvj_WDadBytBrYj064jRLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gAoKf8PkdOovvLGZdPz-yZMxzdXx8RF_logSB7txiSQ&oe=6A3A860A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4F25UwTx-MQ7kNvwHkhrCL&_nc_oc=AdqrqdczGtQHfGXJvQjX89E0b6VSpd8ah73MjXfbx5OcRPvlRnUsFTeA6W0FZJfWEKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e6_wVamH0EUYBE9VyNTSuT3SXrdfwqOFBQEESva_r8Q&oe=6A3A9DDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
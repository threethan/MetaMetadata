_ygQ7kNvwET-Vjx&_nc_oc=AdrYdZbwykZw4hZkLbTtdkGWCd6v5iJhORMlouKGKImgGJ4ZDvkwtYOJQS71r7dhS6o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vAyaHFuATayO964HNaFcbtX1IMwOLdvlJknYqfrurfw&oe=69E22BCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYee_rv_M1YQ7kNvwFR_fLq&_nc_oc=AdqDwO92c3yMfkiKTcLbX5X3Hvju5gX2zXcoZyFW5nok1KtKESevGePKHZwHmZVWB60&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hmjn1puGhGPS4PTtM1ptWF71wtt3Nb1sjMEQ_5AYwYw&oe=69E24E6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjsg6lolkJEQ7kNvwHF6gmd&_nc_oc=AdoYBFNfu7DbPiCscbDrlvJRZPieC6huc8tMbNWmrAkvHgLUmDGjl3wWh8b-Nrk6Geg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cLTJAjIqchEmIa67F_auXvj3cV1BVVJUf7vL80FlFtg&oe=69E21D5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGQiKwybCegQ7kNvwHjrFrd&_nc_oc=Adrbfjsd5NAWJW0q8h9uNQ-0dEHze-2cC6q1owLmpA7GSKMGDHvGj8oXupnn-Z1tI5U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wRXoYYgUJhL5B6ofaFii-iYaJG1zyE5Ph81zTscwPow&oe=69E2318A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz5GioBUkiIQ7kNvwHrl1Uk&_nc_oc=AdpN-sM4opDas5SNslze619SN89zPGBwJy2RQ2WEAKHPkHS3uqKwq3fZw5eMTcBUJac&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qv2WFcwsv0WVWJiENcwPQ0LMjS8iyIMmReoLo9LWG1A&oe=69E2495C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
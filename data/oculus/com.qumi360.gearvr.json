G0UQ7kNvwGG3Mpd&_nc_oc=AdqkqjLcr6dnV2w0IiK7CBmeD5nZFbcUPdVHqf4a8e3DzduWOdxkN5Y1ekpmhOhsbJU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pmlQM4HiqNw2dzbb2Jhd-DMdlLAICWbQOjZcJUnoG5Q&oe=69DF88CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1igiYHG5KjMQ7kNvwHQemUy&_nc_oc=AdpYAG4AcyslwyWfdZEHi4QwWRC0OnmctIbJULw0ED9EEPTXSNxeGf33LQyX56eY4ZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iDmMjqtKcjIEhtFsj6xjb2BpPdg4UZwihAr-YhCB1gQ&oe=69DF732F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsOSsdosIvgQ7kNvwFL62rz&_nc_oc=Adpt2bglavwCrNpqjc7epJuYj-BzuA7yTdW-asbv2quqDKtW5cuhTJ6O6XFv0MY2wQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q3KtGpbp_vgW1Ih8Whdzn_EQM4JBHv9OJLbBbhb3cQA&oe=69DF7A5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGQiKwybCegQ7kNvwGzT5Lc&_nc_oc=AdpIgxkpjQK1e4r2uAXKw_vrKsUDYiO0PKDpQe-GSIaE7Viu9NswDad8q_jWz3F1j0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BOq5Bfx3OpRfl-yKEFAHj0YwU-V7aknZmxBT0Eog5Cg&oe=69DF8E8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtj6fVCAnLMQ7kNvwETIAPj&_nc_oc=Adqp7MXwm41n_ocEbhxAWu3deGxZMiOfZmfd6LrOCO2sxr9BZmt9lOBAQrRMnu6HqYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ByM17aH5bjy_balA9q_ADH0WX4lPdcPr-1tfY8qKkqQ&oe=69DF6E1C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
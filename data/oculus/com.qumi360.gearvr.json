w_QQ7kNvwGQWvKL&_nc_oc=Ado3fhvbfiuJE69qzYD5SVKAmTQg2lQevSmcT9xNoyoJ32azaG5XptHn_CCKfnneaWE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAaDW4Nx9sf8GUyG6B7zsJ5JQQ22yfr0EQf-BSF2dvJw&oe=6A8848CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12NwkH82J_EQ7kNvwGtJtpN&_nc_oc=AdryZsfjIlKo_L5L_62edv9rro5rPTroYBZf2s2_8RbMeZX86blxXX7yx52_w4Y4m5U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtJopj2jfzMxj1w4HBL-VsgnjYvT0gu-jL4ScM-31hLQ&oe=6A88332F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBgpynVqSacQ7kNvwGWTYsB&_nc_oc=AdqxF_XDdYboShPMfzNReOFK4gAXksHhuBY6FgZaTwj7BPL_dBdot8p5riNv5d9LsHY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF40QcUkFgU4p4gz7ztD8V9HZrFAPPbbctrGqVSPEeE8A&oe=6A883A5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRtY-7-bEsAQ7kNvwH0btdk&_nc_oc=AdrCqSziz3l4QJy6JqxaSqQ3hjFdCelwhCXQUk60CgnUaod-fjUVeFCQiDHG9v8p93A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjj-jNTZ89x7kcZuXpbFp96i7MrpD62KQ1AOFlEKC9TA&oe=6A884E8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3PVXuQIlsIQ7kNvwF4p9d_&_nc_oc=AdovltvNw0EDnhKQvZbn9TIMJK7dAhmiyh4Ybphy3VjqohBmaXjJRGK8Hs4TWhETwBE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1AyegTWodZDoO4B2Jt1IeT_vPu0LVd-CMVhdgNEuVcQ&oe=6A882E1C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
kQoQ7kNvwH3ez45&_nc_oc=Ado9KLuCSSTLDArlIcuLv0uD_quthm-2K2qO7oraWim2uPpoeOcvPEkgW_4tBPsQViM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7JKakGjvXjBNGBpjpjrpo_iA5Rm96APZy8FWzaxzHAw&oe=6A9C0F4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quZFVHDpXP4Q7kNvwEz59NU&_nc_oc=AdqoDfMYL9NhpG7hUJWy2e5O-s559iJIDyxBMFTY0F5Bt6knm_Z4tm-iLcV3hAKfL6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ2-gapPCy1j-DPDcNzze8hL66lkW7GjZ-1tm_F6VLXw&oe=6A9C31EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8XlOotfO8gQ7kNvwFL2QeH&_nc_oc=Adp9DV5fu9BvpaPRUAaaViHZbm7LCrsnHSDAHnhXLNzaBPpy6QFqClkRHXDzUYYRfjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItg4c6NvCQES-lkghwjiun6iYg9tVgxJxD737dLjzBmQ&oe=6A9C391F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS1jg88xU7wQ7kNvwE1Vswg&_nc_oc=Adpzc8K7FGNrZYR7_7u34WBOJifpOO8hKcYYrY0DNl6IjOteBqx3i1bbyDEKRyK9K_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdzgpTTMZL50XXXvHYxSjpyyoAYbRaVFsD4Y_0iOkMaQ&oe=6A9C150A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQGoBd7fF3YQ7kNvwGOYnrH&_nc_oc=AdrtbxPmAbjaSoh_w4Ap3ROrKQasrz6jxmAAh-hfJ4iNtPcVYQmGlR63lNRtRExvhnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjZJi4IjgcAv53Hdknz_2RMB0PmybDX_hlF0shvmdWZg&oe=6A9C2CDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
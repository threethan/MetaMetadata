vI0Q7kNvwHYBIas&_nc_oc=AdqcwJxQsDt814UHOGozq6QikTfr9NnNEq4pSPb4GuZTggyUrBQTpf6T6fpcVdDnuUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmNXJfwwATGM-7W9_jPPIj0UgKmL1GSg7WEJGvzAg5jA&oe=6AE491CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0c96rCS1c4Q7kNvwEuHGK6&_nc_oc=AdqQIEmeexE-Og5U-EsPlqhuE6t76Ywc0Kg5rkJevZ32Y9lDkF9lsjh0jUhzfG8fAnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-uUvjOyw0hMIAQoVRrP1oKQMD834EurjVqRAePZ0O8Q&oe=6AE4B46F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss6QnmitzkIQ7kNvwEQOxI4&_nc_oc=AdoXqhOTzv_AxuCubnMMbrVqeIC_3UAq1GbwkvI4YKBZT6Hyj7umdIHSahcgEqI21VY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7YlTocWbjVrdEVN-g6AswVkVD3bXRi8X43S_pc1KORQ&oe=6AE4BB9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw37yLCxeqkQ7kNvwH1sow_&_nc_oc=Adptkr0P2awQQZ4hzf4kVgDFQIJWwO4HXezc5gWki-ung7nXmpBYdbpNW0rAe0QCVno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbFuBedL-Y92THw2Bv755GSMKwFm1nuW6VBfj_cHB8jA&oe=6AE4978A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEZKPAU_lzoQ7kNvwEW1i05&_nc_oc=AdqbjgOi0pg0k31dzGifsSrZ0C7d49M6oExW9AgY7R4Ol0k02hOEpMo4LWc5mbP-w00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo_qTbHhEgve4Sh6d9bfN2WWNbdaUGq09bD02FkG_Iew&oe=6AE4AF5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
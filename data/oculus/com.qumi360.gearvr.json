wUUQ7kNvwFK6h59&_nc_oc=AdrRvoqKNCX_pLlkN_di4XIEk_uNkGhqfUVxpgH8opHtYsYxgQWvQw31b7esoPviJBw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ28ZeutineGD5ZOXRpyUJ12BvBC8V8aVnflpM-bg1neg&oe=6AB66D4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb4SLTgBpZkQ7kNvwG185BW&_nc_oc=AdrtH8wnxv2YVm_P5iXTu-wTjDUToKdEhUQHEOBty-otEGqZ4IIeLECyE1zMQPK5HKk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrmgQwHFImO_6mf_Gy2hQ7LnYa4EGynp64N29qeKI3NQ&oe=6AB68FEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJuOTWHI6DEQ7kNvwEHM3QX&_nc_oc=AdrSSpdVCRAEKjOEbez-gl8lsUmTPqELVXucUGFoFlLneRQ_dokBKpAMe7N35TypHFA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF0ouTeD848pl6z96uGjAjss8dG7NPlleo-3t5fQnw6A&oe=6AB6971F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lN5WYR2c6eAQ7kNvwG6H926&_nc_oc=AdpIPEAeJe3PnU_LkpSVgYctQUyPJflXeS1j8GNXo6aSHKi5t-w10DX-n_N8BHBOvXU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK99CTs7XXvjaKcrwoOfduUwLbdjrZU-TGk6aDOCAXiOA&oe=6AB6730A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=logazJMxHZsQ7kNvwH59KZ8&_nc_oc=AdrUpfqcjUOUiS9fG_cLmttEcDNCVJ5m_j_4MawxIlLwe_ZPNFnSUjMgHdfzzaqoZCw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE8r2ol10eAEU7GQewXepMjUx2fEWCgPZLst_FMNgOAw&oe=6AB68ADC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
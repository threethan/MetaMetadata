Q1oQ7kNvwHxAMrT&_nc_oc=AdoKqtAIzfMnAaDLmAGgW9Mm73gvxj1gIJFsK9Ap0wbYjsDjaBnmIEFgN0bT2yC2xZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1I2JWflwfNXiikB7RnrRcpQJkxFsSAv7awfiv4X1QqA&oe=6AF1F90A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTOO7sOsuAwQ7kNvwFKhZC1&_nc_oc=Adr96ktDPH4ikUXdN1fKrwCMQluBcCxCSJCs_GVuo0l6o7Bx9k6Qo8W7ShgK-NiBMbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSewRON_h2KXYRqA0eZ30d7LazPK5fGgVpeMdKz-ESrVg&oe=6AF1E36F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D74EFmXm_2YQ7kNvwGBWLXz&_nc_oc=AdrDT0ROCAmYc5Ya9s3_qrqeu77egpe6eD7_QjlQKSdADoyzQ9-LRORvTA0wUTwvAC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMfovyPoPCmbiffn6w9ZZC_BuxhYFDhRELn02wB54OMw&oe=6AF1EA9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i07VQHGjGYoQ7kNvwG58e8M&_nc_oc=AdrVXY8kIOrOOlGTGzhFYNaaA1WHnQQhM-8SODog1D2aOApxpNRPXUhfsta5FumDBwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcVVkGii5X66OMiETn0LjiL8C4aSv8yxzNAgTP7h93Aw&oe=6AF1FECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjDEOhIBuq4Q7kNvwF8NyWf&_nc_oc=Adq706AEs9Bog_WLZi87VZ8F1nyJT9JWAnnIm9YdhznM81zSW0KAJr9FlbbeRamk3V0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnD2xWDtPtpOtWvZtifaMzS8Uh-q0-N9AFlgE31BIguA&oe=6AF1DE5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
ZQ9hUggR4Q7kNvwEzE6-V&_nc_oc=Ado79ygU3zEgvOjs5j6rCuPwXVPed9TgCfFoec6uaYp5zEagnlZ3jh9g0yH4Xc992MM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9UD-gxSqUMBaWvbHhZ_orNdSySyT2oiXWxspAuHvFhw&oe=6AAE844A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSNxYUeTNDIQ7kNvwEwyRIq&_nc_oc=AdqTG-0GKGxrWhpDpDaRHrmw8eojdw1X9XVxRtPTa2J4zv6WWcDEzgY1Y5W2xiBriWI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8JGReooxmfBuMAIy_SFC6YsvB0_50SWxZScfz7mvP9A&oe=6AAEA6EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsB5CmsubQYQ7kNvwGV22ap&_nc_oc=AdqAVQMdyPkNnOr6E5bOq8nLagjbIQMMv13DH8fSLWrXz3U_fAM1A_F5a7FB_0MdnIU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTOGSe5W1gHgRiVRJ1-4Bc2TjLc_WCUz4Kl3rUZVLVgQ&oe=6AAEAE1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ay9GW0w5GqEQ7kNvwFw_4Ii&_nc_oc=Adp0OwAuDRuHsBTz9n4IemeHu01y1gD7o7LPXYCMWUoszY1Tn3ukFpcNyRMw8EL7Ueg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ6bN0Jgz5jQaG4yn2nfBUxkPZ-iCGWF5piD3rNG0j2g&oe=6AAE8A0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5poQ0ySBvw8Q7kNvwHwX9__&_nc_oc=AdoFhYkA9hCh1Qm06lgVOWO14GKdSdtAuE6dRRrGzjMQV0cnKLjBiRpPzsyAnk5JBlE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlLXPpXhpIjbN-Udu1O7YZG53-Fh87YTIlDin8SrRfww&oe=6AAEA1DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover
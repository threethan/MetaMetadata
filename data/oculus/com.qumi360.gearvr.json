AkAQ7kNvwEmJZnW&_nc_oc=AdqpuFE9GxNA7JX0w2i0Db_pdEbSIQkb7WGaT01zKg8dlAp74OVYe9oeF3IT-DbIIRQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uFgSEO9nO5VyafWA_5iZLn3k4UULLDg6pGqns_CU9uw&oe=69E8C34A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t1TblA7BqsQ7kNvwF-xIsv&_nc_oc=AdqVhe9tEUFPjNzkvRNMqlNBQE8LTVl2WTctXytLuGPBVc1crK3vaVE9ztqdvpCKF7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af052MqxYustWNyjUKVELdrco2SmDFssXwmV8LjrX7bUKQ&oe=69E8ADAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6ctbF2mU20Q7kNvwEXcy3J&_nc_oc=AdramP0XxzynR1RT836O7IAkA_ad9oYVwUPwh_qRPk-E_pva6eUjFQ3w_zeeFcgC-Mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PthqvQWKcyJ4aqMsqFsJW39FbJ95UQ26ujkd2dYPnKA&oe=69E8B4DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRwmDVFCdtEQ7kNvwEhhhLc&_nc_oc=Adolajl5rTMnE0TlVhAv53-O0yRL0ZcPEXYExDAyDilmJZI1bgxq-wZpySdU1fcmkcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CWNTaUaeOE0sqnkpPaHF6fAz-JhdMczGcPF6vAQVDKQ&oe=69E8C90A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAQddndVJYsQ7kNvwFT_gtK&_nc_oc=Adop43DCsqlVlf9kvn49fX3lg_4HaeDFuq0AbGJtjyV8kJ88Pbum9wNOv8T8W3ghDjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-O5nvasCai4-6tF10VzaPS3KMWQ9VJZSY0qu3YdcaBA&oe=69E8E0DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
UnsQ7kNvwF7ADnP&_nc_oc=AdqSaJw4G1U_f0Ybnk9gLPrBTfmKnejc1MHMFMPW2unlXOTql8EOpeGYnSOqv4rmSrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxXcZ67kwoTtPL4vbtorqWeGmXpoqjuKgDn1wzLeTzQg&oe=6A4F984A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfFo18S4deAQ7kNvwFOxmu2&_nc_oc=AdrCuUpDinQ4iSLtRX5OgKz5G4b9vSz7dvLG8ylOp-B6u3PdevCQqTbNFHhqtFKoAuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjZrHI5OTUqvKQ7U9yofS8j05uQd2PWa5MpHX5nT4Xqg&oe=6A4FBAEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3Wu3ktl7-IQ7kNvwEn7iLM&_nc_oc=AdopyVhhjWfuppQlbV5Y9IMzjfr7Gd6nRh347YstKbzIvAtzdAnVP-7RPesP1LfDN4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDtrOk6JHL7sLXBcXw02TLU8SwA_E5tAN1Yl4c1RIRXA&oe=6A4FC21F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYdKGkGA6T0Q7kNvwEqhAcZ&_nc_oc=AdrGtLWnK3P7LPX4BnP9G2_Ny3ufb_sXMeMAyZlNTxHrqqhe64TAAbYo99TxaLSySOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV7YQFxDy9yITjd0UB3o47WGJ1BUf4c8Nlgg5nF9BEeA&oe=6A4F9E0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIJfbPYFrNYQ7kNvwE6r08M&_nc_oc=Adrgdz8iUDsy5N2Y4AbCgKLMNepYbMF5gcvFGppxPGIj-0jy-SAY3kUf1yRrvtGTgBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJq7f3WzL3pyqQscHUe0NQLKxm_a7n3Qk6Fxvlq9JHfg&oe=6A4FB5DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
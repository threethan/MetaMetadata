ZBwQ7kNvwGNc9Xx&_nc_oc=AdpyRw41eN1LgfQLXZSvpJ8yJa16dJwq8fiJdUpmAYJ-RilBA8FdrfkA87jA2FuyqC0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NVmEw5KtcFnW0Ce8M_ZWaISkfi30xrJyZVOJdgnX47w&oe=6A4117CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQXNaicIl-cQ7kNvwGOHjR2&_nc_oc=Adpx4-jxFch62l9cjspes9XkpOB5FG0aby0fQnrfU5mxN4-h19pzOpODaRT5KAjwDrg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sgDzWuS6it9lNMbQg4IjO1I2z9qgoc9o-ym2-J0skNA&oe=6A413A6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpXAXp3PJN4Q7kNvwF8xxcl&_nc_oc=AdqFPDwtvK1ZPcg7Tad7TkmkoFBMacuKJq8z1C8LT-VxrF0Oq3VMW-DiDxdKwCF-8Yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jN8Fn1vT1T7p-CW0XJiPAXACSDJRVgrsje7CXM0NcSA&oe=6A41419F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XxsbjQEvcEQ7kNvwE8TG5C&_nc_oc=Adpmv1lIZZrQxxe7djA1yYkaSHFe6PDXkna_341d1UqSOhkIY6PPXHEm9zln3SQu8UY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96EIP8z2DTldEGq3Xk1IZWjZOcJXToSn3yeylj0GSrTg&oe=6A411D8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XoLvLH_iuUQ7kNvwFvU3qv&_nc_oc=AdqHc3FA61__eKn8GE5lutE96ynuI9KDMglXiddgmUQLZCGsMlhnciirxc-gB7tOBco&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fIehS7TOrbyh-tdexxee672rz1A6h3YP9OnI7xTU7Xw&oe=6A41355C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
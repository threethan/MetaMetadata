gYAQ7kNvwHaRdAE&_nc_oc=Adq4YskQVFVyxaUYG13kzH0hiGY3Ol8N5ykwae0jJw86WE1IJw36gAysE0Beo-le3NM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ODNxc96iMqw98jVxgpYQx7PdaPdBA3_Npkrzk_KiClQ&oe=69F34F4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXnTDrqtYacQ7kNvwEEHLfQ&_nc_oc=AdrxcPel1hDkoQrch_njirLHY6fBewEnKzipljTSltl1PxHaCZ6HaKhrY24IlbPZDqQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32QP9PCdIJNr7_UbG6f4NLU65BL5xrGRCZh1UP5SRrOA&oe=69F371EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu5ZZ7MdD94Q7kNvwHfSWuZ&_nc_oc=AdoD1KvlJ0Jtggr4cPwCchIE2oPIUJj0qCdHE1wkNhpPPQoRxPdsHRV5Yq3iCtLxc5w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WRVcN82qfJfnRqMAhRb0I6dgCdYoHk7ZCic3PrDYT4g&oe=69F340DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ5cKQdyzdAQ7kNvwFXRG6G&_nc_oc=AdoRZdm81oPZJwntx6ZyKPF72KUSxfnNS9uEF7-WQjU3uuGzn0Cb8is1r7J1oQAJ9T4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yyYpdKai2kjazs7Ntks0Mpoid0NNeMCmiYzYH5_Yk4A&oe=69F3550A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QelKctYMOAQ7kNvwFptFzY&_nc_oc=AdpXCt3emQq6bVdmjsylmonNpPfp0Chk2jhrh7ZxgKlsRVYY7F0n0m3IuQ4BOSmVIxQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3afDGOs-XM8O_EOG2Kpzefz5yLpc9mSiigB1TrgYDM6Q&oe=69F36CDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
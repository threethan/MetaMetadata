LaEQ7kNvwF6xqvE&_nc_oc=Adr-KrvHZVwv7u-3jSrQV5Mki1AJbq_mfaG6wJnIN3lWDwDyYF5NjDEEfBpQB-MBTyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAik0mYcOZFjJ7l1npjl5SDH3rnlhWlByykM93jxkw53A&oe=6A4A524A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewzCY078iEIQ7kNvwF9UtQx&_nc_oc=AdqMW0MbefDF_eGuBxyUWQzogD8CB_K2ugA_Bv0VvJYf8wGBEW0AnEUYA9ftDuiNFOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD15LGDT72xnEUxkXF325O7fxepngB9Vikab8b8lfNv4A&oe=6A4A74EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIs8NeqwqLMQ7kNvwE84pZ3&_nc_oc=Adq51VE2JgGj4R_54opEkqUkWFzG9P377ve_WRT1COkAV0Pt6MGKqJoFAd54zgXs7w4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmQDqYgzf2LxcqPIeY-KjS_svqi9uK5HnWfmoxEhWMtw&oe=6A4A7C1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFwqhktk9XUQ7kNvwGZgQ25&_nc_oc=AdrpTIkAXzUfJ5TU7Rcr2oefsC6T4fDrlTyQOpeL9zo1voOOc-raiddQxvj7dMmbfUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-IYzJpPO6vm6X_VD-m_cRD1KSpj6NEZWWbsdbK5bTPA&oe=6A4A580A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd4osG4jV9sQ7kNvwFbl3qr&_nc_oc=AdpOyUdYCCEnwoAQecJATAoD3hC6z1mv7GxDKBjjSrJQU_Xa2W3ueh_LnqIO9mGvjHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMICe-uSo6ztrv6dE8fYz3prPV_xHiJPEpXaoyHAVpPA&oe=6A4A6FDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
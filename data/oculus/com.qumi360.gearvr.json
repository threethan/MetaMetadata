cNEQ7kNvwE8nUFz&_nc_oc=AdrifuO8nb35aBxqhj5vz7yqwTJ6TUrc_2hf9nsXv_Lxroar2Lg4mcvxTt8sx_Pp4fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0wRMIGI1YmIhAlVth43UPkKzktH8NyP8OwfePF8x0Ww&oe=6AEB618A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1pMVRj4CrgQ7kNvwFBjALP&_nc_oc=AdqMg68ETsktYzmB3tcvlY5tGgy1AFE6TMGaV4BOqSwVZDcv5ZQA4kmW_slo4PWJRDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNMSmeSIoGA4s7wSBjJCDUBLa7rAgHlJ-YxsZVDloP3g&oe=6AEB4BEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZg3xtlDW0AQ7kNvwFEtp07&_nc_oc=AdqsN9ewGLPxpuiJOAlIHYG34hQAyLQIEHZToTwZBunp9mkaBzDxS1UTPX3a6oAVCos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXV2-eT5GFsRlqR6ghY-ISTczwChr9wSwLoJQV5D-9jw&oe=6AEB531F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8xojFGSD3AQ7kNvwGbbDl4&_nc_oc=AdqQbbdZds7EmyaCq4eWDYtp7sZtFPbZz1U2T7pHK8OqJUMkz1OhnNZRssT8FIc8tRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpYvfGIeHWJJ1_OhrPSN_-KPe8_3FEQJpKMhWV6lk_Pw&oe=6AEB2F0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDYPecyfWEwQ7kNvwFebpWo&_nc_oc=AdrqK-UkB1J5YUhEColtPq5-E2_DhOO1hHrqLope9_FhWSl3Gvs5Pl_hXib7Eh89bJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc_c2LENNkLxILYHuUJ5bmyxNNd-HiccJqqBf7FjpoSQ&oe=6AEB46DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
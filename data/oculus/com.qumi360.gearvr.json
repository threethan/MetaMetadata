HhIQ7kNvwFiNKgv&_nc_oc=AdrxbeTzh5bcB5XlGkWymIDkksFNIPeWzGivjogNIpCliFmKCuSWwfYA8_b1ga8UUG4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UWAAuCeVtshrGiJI-rzxXya6WuWd2q9JCZgflY7q2OQ&oe=6A2173CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1IZhF0dfyoQ7kNvwF2lPnF&_nc_oc=AdoAqPmtjIoUdkQKWYlVz5h__j3EUl7oQcMNflSeQMD_2lqL6lm0DYhO4VYOSqbMSYM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oPbfVt8bgbeGte4qLXrdKgDBST4aAlxGHoLhLGv1zYA&oe=6A21966F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etI4Kv9cWlIQ7kNvwHjmvyj&_nc_oc=AdojgOJrOW503PKF7bFIBvlARvJVawEXWPjzZRgRACIgWqAnZ_bh11QDmdpb0G20U2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t7iC5rfiYAg6xYvUNuJBn873byGRSJMjkgfP1utsevA&oe=6A219D9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnon3XtELikQ7kNvwHA1J9k&_nc_oc=Ado6glWvt4ekhcm44OmxQNvtJwIqzQkDKqdat-u-9_MjAmpgE7Nf_zj3KRywmV4HwgY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_Mkm0yM0R-vHr84Xdt7YT987u8Cm5yOWrPhA1aSiNmw&oe=6A21798A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdWEnrlt3AAQ7kNvwF-270D&_nc_oc=AdoDmNtbr5wff1vMZ4Zhn1Jl6Znai1ty5tRl3c81OZodtvvZsCVZ2Dkrmg4ozcsTIPE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KIvJMI8CyAtjY0_aTaQ9oQSBe3qCqY73hQibdLSt6Mg&oe=6A21915C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
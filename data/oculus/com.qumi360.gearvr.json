Q_cQ7kNvwGxtLxb&_nc_oc=Adpw4XthtvBhC_k_ls3lJJ_zpP0kLlbQC0jntoqcXzzLmC-2JV_VrdauHTSBf3ttWkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Od2e7D556GgnUInbTb1bSeM5bTjyonpXUbLeu0Wx2hg&oe=69FC89CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWpsYA9XYxMQ7kNvwEq70wM&_nc_oc=AdpHqnAMXneMseBFM2I7-zKcFE1xrKagvSOjv9w9iuaEp4S23uOq2S97JVFKL2HOloA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yLQzDeq010vRkm0Ctn-wa99GUF9LbRIjz55qzWLjjOw&oe=69FCAC6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jbXZZhFUxwQ7kNvwHz-SNy&_nc_oc=AdqBnZfe6hkJHrYUGshX7oND-ASRKj2GKtckQ8GnOG1-YnzlxLPIPjDPmk7eO_pBljo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h-AVXItkvSBfea14HKge_2waOnJ8LfMebHe2gOr92pQ&oe=69FCB39F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAVDohyTdekQ7kNvwFV_BTO&_nc_oc=AdoEpcQnbQdmS3fH0I_o5EPksPrIVtHS2LzjU5SgKy1Qnh3g7SIlhLqHiAMSlaDxLts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Iz0pIyH0tzkIE3CnicVjMkp3_R0yRUWmJuLdzvInsmQ&oe=69FC8F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiueBsWPlOEQ7kNvwGdeih_&_nc_oc=Ado-QLzKHfWs38eD6mplYFG7qmKUiz0mb6XQKo8jE6iNS9ezQjMW5cbw0RgtXRsirOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L8K7oo6gXXEFw3dQr0pAQc7mGVsNKmkSPwZ4hHip1RA&oe=69FCA75C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
Q1oQ7kNvwEiBsNE&_nc_oc=Ado51X25iaWfoacZJJwqdiFB6u9NobS49i_T72Q1MHjSqgGbEyp8KHlDkJW5H89IAB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYedPKW0euPh90M-5T3IY_d-q4YoykdQIS9OsCHzl6Ag&oe=6AF0A78A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTOO7sOsuAwQ7kNvwFEHRgU&_nc_oc=AdpXFSTWhsLfVgljYq4mREvBwBSyddGX5wiTpxkqH32gy06ouVV0NEZCR_4d3G0Hi8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgnGg8nDd2nm0ZuRs8sWfIGF48IS9Ze2SsVGMenba8_w&oe=6AF091EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D74EFmXm_2YQ7kNvwFedawu&_nc_oc=AdrNigqPj8JoUBxCnOVLxgTvwh1qvr2fqzxx6Ql4wLwZOfMJ4jljLQnkBJE741g2mH8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqGbxQ5a1SIAj6murvLkzyrLKUH5wsXyhxn6a_mBHckA&oe=6AF0991F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i07VQHGjGYoQ7kNvwFou61Q&_nc_oc=AdotXWBJh5vug7JT5vT-HYkZ1zPVRmSbaRDpf9zRc3XWPnVnZT18XXZTkaey7BwLhAM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQFRGUA7eRIgK603KrDuPjCu22-qdQMWpvESMkRJzfdQ&oe=6AF0AD4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjDEOhIBuq4Q7kNvwE11yF3&_nc_oc=AdrEa52tS7emUG1yr868ufkrUsd4NbzdEBrrrCkjgPKO0f-PB7mMPGHdplZ7CsLM0HM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2wY1ZwTcBmE1NlAyNRdbQzbKR9ZgrwErnzpSYM_bcCA&oe=6AF08CDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
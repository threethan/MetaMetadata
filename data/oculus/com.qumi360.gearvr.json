bC4Q7kNvwE6dQvP&_nc_oc=AdqHOQ2-wyJNcbSR3Rslmm8uIKoEeRfTCG6jv4jHoz960_6WoMPK9rS8RJdWMnq2TCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLjAVeGtCUkmfI7V6it7FSGmj6yJPm7mZESJG8MNgYVQ&oe=69CD13CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjcfKuKOdxUQ7kNvwHb6EIW&_nc_oc=AdoupC6CCg4YO6zX5x1w0hTaKz0GQsJcdDe1G5SXNVDkt11NcXT6ROGsGRuO4uLnXug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzps7___-puW-Zrl5zX_O9Cf6j4oGGB8k27S8FBoznwxA&oe=69CCFE2F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J65SJpHr4lEQ7kNvwGz66Oe&_nc_oc=Adot2mAfCX7sEwniJEdVuQlKTWu1RBfuPvjA4HyYByDlyN66RTWp6xalg58SMcqP63s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_FzzLjakZczto6CnueJjcwY94t4JVX-n4W--0mI5VHQ&oe=69CD055F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlq9nVCI4ycQ7kNvwGLt2Ag&_nc_oc=AdqAqrYCI6Xaqf4vC2_9v_BstJi9FJUL2sxpGvcNo2rhIKs_8HtBaHKT_jg_0CnuC24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOz_LdX6OzxLDpXjEeZNesZjIIPPF6EoJ8h9gmU8tkgQ&oe=69CD198A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjyABNAhc5YQ7kNvwFuemNs&_nc_oc=Adox6J88qJT2GXIa4OLy0L7faHpQKiByPJ65-9r8dgDpRDE148IK7ot5Q6u30zB0IBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyR2n7I4jlyaz8H_iAiJGFnwpr2G1KltdI6t5wSHo2hrw&oe=69CCF91C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
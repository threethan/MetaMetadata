P20Q7kNvwEX1bmy&_nc_oc=AdpYDT6famDBfgbvodCcJIgc9Ld136iFcW3YXoNaymBpHcVHEkacAPNvQ8V4jifmJw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQhxzjzWzKHfBWyBUHgEKsb3jjuXLovn1WN0m6TRCmUA&oe=6A7876CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdlK1ticdQsQ7kNvwGtns0i&_nc_oc=AdpT_F_qBhyq_5ZIO1-4h4AZKgaOKVVsDtC_YMFiJSfGq5M6w-kQY9yN9luZMxIEEOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-L0jxnU0nzV0DEStHOTRU0EoiUUkPYQfxmLxRDm-arg&oe=6A78612F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OgnhuF4McwQ7kNvwHxhY2I&_nc_oc=AdpaWHYIwfbeT1KGeli4LXsfugeVBD0EuRM8-UiQRMDRxlqNXy1L3izI8pZ0aKeODsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpzvzvJktlN1U4ZY3mr6x0ssHLIaecxrbciPnMb7M1yg&oe=6A78685F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTy0lx8rZ4kQ7kNvwE0kPlO&_nc_oc=AdoHQ5BrK1W3AuNLlHAmmOeukpfY_keoTFYpBSuScLHoUZ48-MqSKhhy3J_EvqbIwAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAIS8KsX1cRDVq7EbgELrbEy_bAX9utt5D-cUxUFnBEg&oe=6A787C8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjoeFnLT1QQQ7kNvwHnND58&_nc_oc=AdovjYT18xzI2vA1iU73733BGrw08ytbr6e29ZpNV431zu6Rit9lxHe6PiWKL3ePwwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp3RTnXw1qsSLUbwJJPsg-4FciQ52mkew9OzOKPk2CNg&oe=6A78945C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
rm4Q7kNvwGKW5cC&_nc_oc=AdqPVwgN2Tu2RNUtMBmbOwFLSkK5G-ASDjiqTij2bCrWE3A0jeyYOLyFtYhB1-6qSfM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1llCiMlMbt0_3PhA_Dtqu04YfoLIK7unJFdLni9lplpQ&oe=69D3AB4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spL8DTK3G20Q7kNvwHkHK9v&_nc_oc=AdqvKBED-deBV1KajyVhZ5Xm-csysrG7OAfKQ_9eumf4BHiq3__5I_WldhTxapB5V5w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CxPmvmkiyD10JiVbwh2m-Hstzse1RjnUmpvgHgzhCrg&oe=69D395AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjyWs37243MQ7kNvwEvq8tk&_nc_oc=AdrhJJpJeucpC_zwl5H-x2HfgB2j2v8gCJpKaBDpN2OoOMBHCALVI9fjB7vhCibWNFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ccdq1YOX8RHd7XoA1q3o26F4YICVqaSg72G_qByRA_A&oe=69D39CDF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCgk-xahIHwQ7kNvwGx0DE9&_nc_oc=Adp4KVHn6oG8KpUnIVkbRYUwNFrhvr04jK2AvbZHBQ5MvVVmx6eacKoBPbgTW_e8Zxs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rWO57iFLko1JK02ef0yTY7kLKiDWG6yL8t-Jum5oDdg&oe=69D3B10A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE-zndQGEcYQ7kNvwFOeiZv&_nc_oc=Adp4Y5T8jqSeLgv3tQxfcMuc4wpnInDbrtJCamJq2kuhmLLOBS2E2mAhyqZDs9izhRk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AOO10lKYQ7KLdksbDsxwIyTXiWOu_UXVt_i49UjWVwg&oe=69D3909C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
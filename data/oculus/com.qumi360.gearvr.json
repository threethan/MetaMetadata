ZBwQ7kNvwHUiznX&_nc_oc=AdqqS94k1724nYVTYrRGE1zuFD5jBK6ULAGkuP6YhjXQIluFsxy0WQoBIT09X98vgvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uckxPGlcBjVxmuc9bVC0TyxNiuCnkfY-5mTs2v7m_cQ&oe=6A3FC64A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o-ldNuaMIsQ7kNvwHbK_9O&_nc_oc=Adr7WPAzUnZvocGftj8PKQf5PA3NEcDeCxY8nUmh0ZEWo6zPW7gDx2im71AMCPKkBYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AoJQyOp9WXF2mOkmOg5HiY4I1DGzhFXcGLNyYQfEuRw&oe=6A3FE8EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye0yvZTTsYEQ7kNvwFjOKag&_nc_oc=Adob58R_euZekqhDluVx8_D7QCKWx6OG2ZYH-rmbYMmmejlpEPGb8YY0WiVIRzPizws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B6iItoOAxln4UuRZqRQjssgv_kFDDoCDIuoS7GUZ4fg&oe=6A3FF01F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XxsbjQEvcEQ7kNvwHcIsIK&_nc_oc=Adr18xJB9GsZOsI2svc8TTffWS94c3Edb1-x1PFVMglCK-gztEwybUzm1C5OPc6G6_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ChZCrHGCrvcs918CmNtQkK9jvwJvRlRnnd1dpJR5xTA&oe=6A3FCC0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KIEn9CoKBUQ7kNvwEwELBW&_nc_oc=AdrHeLT89JkBVz5taGuQY_DtQ-iJnFs3ZRJEjxT83rlk1Ob5EZQjIyoKKAv7Khk_JqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JMODGCEIMTyuMZ5OW0Bl6NogUw7v7xPAXyz0l2hXziQ&oe=6A3FE3DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
aSEQ7kNvwHThOiD&_nc_oc=Ado4XiWxkyDKjZYOviMNUSuVfmycNXofaKPZ5g88x7lhmFEg9OmuETJ3uZprTaMxZjs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa4rDivd1QAJDcOXsiN71EJqMhfkgQXV7m3T3t4GW6-A&oe=6A71DF4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BHD_Ccd1uIQ7kNvwHdtfa4&_nc_oc=AdqGeW_C35bAwbCbwUC4aDvi56ShTpLZoPeY9iY30uvbi1KVf2EEQUGmcVLUR_x7pTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ4lL7IQa8m97KJfCMUJjrJFeRAHQknOCC1_zNPRNIJg&oe=6A7201EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmeK5DkbfMQQ7kNvwHJoNFQ&_nc_oc=AdoToDzBTs0gdfNZ_8IwT0Rcg73ABahd3bP4cPKggc-X8Rcy6jlJmCy-1oTC-wK3MpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERHZJm-8BIlNZUKXHSoOP0tXtguEZZD7oNAAt_8xGFXA&oe=6A71D0DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRFGvOmJYjsQ7kNvwFGcMjt&_nc_oc=AdrG_ymEwvHphQ3sKzR5sUJ-L53Vd-2Lv-xHAX0D5HWNaA3pFH0JnbvwSty4wEwpX5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMnk8L6bBXr9fP_NiyO-F5wYGUvW0EOxRREFKz0oFj5w&oe=6A71E50A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGm_UEtmELUQ7kNvwEi19Ad&_nc_oc=AdrOzQqXT6G-3c0ItywbaunxT8iyVyUil91jUj2s4ro7yUIGOui75ezAFtKKsV42M18&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErr9HY1hG4kkLLcYOssGMlScihww7FkSiPumQ-2Q2gFw&oe=6A71FCDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
wvUQ7kNvwHSewSC&_nc_oc=AdoAEjKPI9TO9yszzUzdCeL2I4ly5YbctnxdddRSQ6SMlMvkyiMLZ3CnBAwruUlIHBw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgwq8Rxc0Nb8pc2XtnqbeAZdSfTb9EQG0Hg9ZrMm95-w&oe=6A92D4CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KeTR20IGW0Q7kNvwF_noJ_&_nc_oc=Adr4QFaeroYpWEKaqVWrnudsJaDEPG8B7jWHzReh6Yl16tboFBEmsNHR2d2lTbWPizU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgOoeZt24Nhc_glbP-ycdXcHt2c57Cyq0iS7_ciXT1ow&oe=6A92BF2F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgIA1lYovL4Q7kNvwFRiQ2h&_nc_oc=AdpTuzajRKBcrIoJmEGNst91SXjF7i7_1K7e1Zj71cqtRwYbE9bVhWN_Q8KaZ3f8d70&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDDL0ah0ol6-qzsak2uVMVFMwosCxlsIRiWnj07uf9ug&oe=6A92C65F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA1QCf4jA5AQ7kNvwHNdzi-&_nc_oc=AdqZXQBMIqVwIjb5u9_oGHvUaKklFehB8QHCE8abrOr7eunbYQR57tfQQkTwOwX4R7c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbj6ExXBQ-wSPDqhlUPkHeIHd5j16-i62jLsz8BozgmA&oe=6A92DA8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ2VhwIFSHQQ7kNvwGEO5L9&_nc_oc=AdpES7JfcLyy3ufWEO-xNVqXOBD2x1IK0PmD7Iyt0TJzJQoIMGoGARpOttnmmyn5gJw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqwA3u92s2G2J0e_oNRKjqRL5tr1sgu_KxfGBoZef-DA&oe=6A92BA1C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
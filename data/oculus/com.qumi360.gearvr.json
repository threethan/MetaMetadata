G6gQ7kNvwHr46fl&_nc_oc=AdpbKSNXLW7pxB9AYUfnSBiFXUnUeN-5TdxQVvHSHM1VuweJ5noDiUWVCDbzrEhnQto&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43hgHEy2EwraooN9dnBmvoQsUgRd9DXrW5qICozJHHiQ&oe=6A12F34A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUSjiEWyKm4Q7kNvwEn2_C8&_nc_oc=AdoPF5yrJvWpilRo9vvf0bsTIbyWMT-oQa8thiaz2DXfuzAwzPlHvzH_pouOKh8JPsQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gxuK0Xx0RFwz5yXM8b0b9UdFK7uqnc02zUvhzIGZAhQ&oe=6A1315EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mjbp9QZehAQ7kNvwEavkD9&_nc_oc=AdoLYPaB9LTw3nQrLenwZRtGXooUQ8YQXRcyI9Nqiufp4-5HrZ5vvsJzDAK303P_4Vo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wcKeqhQRbGA9Tq6fylCiD1Y0rq4YRERvaZbH85nHJKA&oe=6A131D1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3y3vSJ2YaYQ7kNvwG7eKBc&_nc_oc=Adp7rGJZPzeT3F7wFIloPf9l0fp6mbUE6nTT5fse7rlGgy0YJ8Gvau8KyGU_jcigjP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EBqZPkKLqxnnpem9LI0cmbVpoFKSCMGgWAZTutZ0_mQ&oe=6A12F90A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuW3UsC5S88Q7kNvwFf3HWc&_nc_oc=AdpYK4sbQCDp9MhE02oC7KDSeO50x5QyshHKHhnJRG5mt1CsT_UowdcCDWELYCbDGxk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mh8n21aHXenuMCiIRtAs6VHNMK5YRpHOK5el5mnAdNA&oe=6A1310DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
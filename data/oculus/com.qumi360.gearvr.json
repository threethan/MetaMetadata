aSEQ7kNvwGep5K5&_nc_oc=Adr-wqTccGCx6IoX4yoQ9ShjZUM3R8DAIIYHEk3Eul2qQYk27pSQq6w22-DL1JTUXSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh3CCn-BAGo812-4HzPNexQXE9-pbw0Gw5NvvwfqSH_g&oe=6A7330CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BHD_Ccd1uIQ7kNvwFJ1Xt6&_nc_oc=AdoSTByU05VJNrL_Wz4knB4Ee2vWu-Gh1R7IBeefPRf00gxGmnDwFnaPgX9thUHKqC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7qZCjMOKhOq5CoViAwSpNu_L4P8hq4xQJ8aUBLVIa9Q&oe=6A73536F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmeK5DkbfMQQ7kNvwFk0cj6&_nc_oc=Adq55pekhAtMRg372kkR3-UroYRXaYNjhk4efN61DCnORgP3COPPyAhXRoALc_ly0Wg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE66RyGTfo5LPSLUzAaN_Y_fMoUmRz_nrKyIfKAh1FJQQ&oe=6A73225F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRFGvOmJYjsQ7kNvwElyeCS&_nc_oc=AdrmbBbICIAepmlJXwsgUdVxCLslDPFGK84QP9_IHWX2E5yvmm9wRW_8mlYgQ-Dieis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg1vwIBgos3yxbiCwEkTTyJGWQJOOtw65lXdu-Yyp3og&oe=6A73368A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGm_UEtmELUQ7kNvwFHGLZz&_nc_oc=AdpfwIeI55MzpHgWFZDq2EtGaMuk_LU8UK35-A686TqesunceTVedtK1nhCXeM4oFsk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNupoQSR4s7vtFSYJjfKzGHWxpdlgmHLQTn1cRSIVEJg&oe=6A734E5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
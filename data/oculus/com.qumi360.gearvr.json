OYMQ7kNvwGgaAGS&_nc_oc=AdqlredEtyK6y47EbrdOrdBuBVQxQn0hgvF-eIbijPD2C1w_Hc9cLL2N-LFPrW1eU9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lYxBqSUofE-vBCegmyia4OgHQ7I6Ah-hxQW2qAbdnSA&oe=6A198ACA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOezTi17u1wQ7kNvwFQdlns&_nc_oc=AdoJXTrQ8Amjpv9oRmAMzSu1CyqsJMljtIVDnS_c66tTSadcaQUMBuvrszWFenbH13g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70XjFU5eWhq67F42M5Hdh0SXkCgBB-vnuZi5PJ6zENJg&oe=6A19AD6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCsR0GDnzWIQ7kNvwHqC1sa&_nc_oc=AdpiKriHbW7e4Fl6PPQ0Qu47GikNofatA5_vu8ET0HLO_7-Bi54exXFnjPmOlU1ugmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gWTIuzpwwCxZof4McHr_-uo1bMSXwqEgoMLyfdNBJrw&oe=6A19B49F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGkgDABM1DEQ7kNvwFt6bY3&_nc_oc=AdqQx7l80nj4xNShXvDULYE86Aydih6z6G1F0gkemI7ROqH8YtPEEUvkdnOE84WRaz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61qyV5ZqrEY40y8I7sdh_WpGMfWSQKmB0mDFWazk2Xvg&oe=6A19908A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO9ZiKVywccQ7kNvwHcdy63&_nc_oc=Adp7JXLTqJ1pmPZH-TVRR_WlcU7JEHOpHX8KBZgX7iL1kFpm5aCHnOsCmcwrK_xWur0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nmJVHsuCTdYmuWhl_g0aVCioSMVlCou7o1rdwiX8Rzw&oe=6A19A85C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
JVIQ7kNvwEYYmIa&_nc_oc=AdpCgREiMmOQJKYriFDHn4oYNW3FR31XER7LGbDpP3qtA15GN18n-NO0f51pZnEzb8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREZxB3xStk_nI5GQO0Jcb3m1FTGosc9j6zIpFkjRVPKg&oe=6AF8908A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mMi85TB9NwQ7kNvwH2MyxY&_nc_oc=Adpg27hQ9apjlAaeOFaQaa9vDd-HJhYyLvpE2kz-3w4mqNmqc1mNOiFCg5QV-mEQe7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYlggG7BK7HnX5Ddsu4iUafne5gmnzkTiHhOyUVHctGg&oe=6AF87AEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUZgHcN0OXMQ7kNvwFngrpD&_nc_oc=AdqkxinHS-zfSDoucCEfYp6_Jhoj9M4DaXK9Y5DjTObujuvouLGWVUN4DaHULTFRDpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNlH8P32JghaM3_BzCeZLREGrYMDje86rnvTmFj7G5fw&oe=6AF8821F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdh2AQeQBvsQ7kNvwGvAPuw&_nc_oc=Adr39qtpu3Ne5Mq_7gbWRkLvgXKNqUIW5RWiDpLl3q88wylvH7iTBIvMTx3PLoHyKSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHHsrvak8PByymPTU1F9y_4Q07vByUpJOBP7Q-xuW1yw&oe=6AF8964A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU_5rYI9JIcQ7kNvwFeKWHG&_nc_oc=Adq2wBIX3uh-tjMthELdoO9au9ulrNx9FkQbga841qrxOBPK0s0MQFlma2emURGQ3FM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZN2V7QSRs3YkDWJEYkjjKA7HeTKFzl3-VSaA8P8Sv8w&oe=6AF8AE1C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
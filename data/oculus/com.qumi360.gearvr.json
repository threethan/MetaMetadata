k7EQ7kNvwHEOcsv&_nc_oc=AdrDIpbu3EVhoizDlhkCqdt7nW7JafbUih0mmIPknQwQiWwfdicJtzaNniLVUBYaxEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSJYw4eD6Kb7nQK0CBqGosxWBoZylMFzXyirXKy7Gs2g&oe=6AF5ED8A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkDDjMNiE6gQ7kNvwFqFqrT&_nc_oc=AdoMYV-gELqNQKFzgTSCefRz7A6SFpC3fYHKXVdeuhy_xiMGt1h4dsE7ltG2UibFz1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ97TrPMjl4Yfp1UNO1IJxse3y1UfJZ99lT7yHR5HNV5Q&oe=6AF5D7EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e5xwBFlICUQ7kNvwGwhzIq&_nc_oc=AdqygK5vPvlCHEzJP-7PF5vBFQIjApKul-uYgcNrkbic6xjyTOk6o0M2d4LV7OVXuz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIV6eRTzgtJ_8uMqVYmD2Fa_TGPSePkjldeELyyeYnjw&oe=6AF5DF1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytJWNJcEp-oQ7kNvwGh5__U&_nc_oc=AdrqUWriLfzvAqZ9sPVVqznRSpVvBQ4jbNbNCxBQNrRRpywMZnbazCuvZN_a35M8hWA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIJYtTUqTOmAqErLVInjuOGSBHFC5GSxBSYQwyy8Sh2Q&oe=6AF5F34A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qnGVfk2r6AQ7kNvwFL_g2i&_nc_oc=Adq8Tzxv7w-jyVLDr6DX19Lwiis0X00hWwRxWmu2A0CW8UFAQfOWi43UwEw4L6XITc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnrx88zyh6RbKvvHei859TYPKJi7eB0pYU8izbOX9Xxw&oe=6AF5D2DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
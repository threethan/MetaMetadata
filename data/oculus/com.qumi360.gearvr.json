issQ7kNvwFYLBxw&_nc_oc=Ado4Ej_fL69YdfCz3dQOyqKKqr5LELL4ukG1Fv4P4WTPtH6WO1v0DawybNsmsZ3xaBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPMviFJhf4dmXFd2fUG6oGk8vbQZoSejD_USCq5KQ8gA&oe=6A5E18CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQW8lkpcLc8Q7kNvwGXiVnh&_nc_oc=Ado-iQwGe4p2oBTzp0yMRjogjvAb5sNSSZ7Gw1GWm8EPUmOuaU6nKAd0EiTHNiutGgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmf9MmqccOASRg8KHYvLiR5dBIrJqEbli11iKR_PT9Kg&oe=6A5E032F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBfblKY0DI0Q7kNvwFHubIi&_nc_oc=Adr53NyQyYggzE-8AtmXKnZ8WG8FBC4DjpIe1IK6BV-A_pfOww_cUViauNeTeHDIu7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8_GXnR-kQ7RHS9thIWJ5D0kzfGvSBzMpC4w3qNtt_rg&oe=6A5E0A5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLJexbAJ308Q7kNvwGlVgIY&_nc_oc=AdrWCseYWKaStEG7T2sRmqpSQdQdNsavJIMYrll_upO17CxS1bksoXdjK-9mkYu8fT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4k2WippfLLUrsLFv_OzQ3r-A0fNUUu9zN_WwU9SAhAw&oe=6A5E1E8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl2L8jvoyFMQ7kNvwHNE1aa&_nc_oc=AdrW8UqxhWUh3lD6UOto5aH_VNv9IQ15earJxqWSrUJWJN-SeGaXoMnILklN2p9XnHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzUewBwJFdIdw-EW5y46LVdJFgIZTZkYucJJwqBUMTdg&oe=6A5E365C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
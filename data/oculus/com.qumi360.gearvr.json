G0UQ7kNvwGH31c5&_nc_oc=AdoWFQK1X6GXsummgk2Xvbewu-cE1a7ksGFvEhJVLjvFsClzO8JXQvalL0xhsH62FfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xHvuTvAGaNtPRNyiefYwnfHjJasH5mr_5SPYY5hkxnA&oe=69DCE5CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI9YNvCpr3UQ7kNvwFAGiq_&_nc_oc=AdoHP_2RbjjM9UMCSlTv0eUABrnygg-B0K_wiWV47wFxZw_ZeE3Ktse0WWGHhXUsLs8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3APuicM8GVopUg_MDYCWZEWzTQ8l8YpT9z3P2F5hO0RQ&oe=69DCD02F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbMIoT_Fa0QQ7kNvwEp9bnk&_nc_oc=Adokr86J9CvinBFYefBG5h4r5xgHRMVDmBRA1CHODZmT7rrfS3Ab3vNbQ_xrNafGkn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VVwJAiTYOeuN-Oj9QrxrttKYy97-96ZEkEnqKbGjcSA&oe=69DCD75F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-lNZVShWx8Q7kNvwH7yCGZ&_nc_oc=Adq6j6fSpvkcEPt5G2woq53cOGMH3KyiE14fBRJgc8JoOKIGq7hbcecXVcjIHuISTSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-ZewAz00ivu7zWlamVU4WgmoSwHE8OmeD90ANeZF7Mw&oe=69DCEB8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mU2tv7J5PEQ7kNvwHf6ISF&_nc_oc=AdobHrSZIPN9RShEN1zsheMyNhiSzouhg0M8XxPPyYIM7-LpqfrQcbonnXW-AGAydYQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SANTE4emnYao3s6oV5kriCeu6ljV02J-dsYmbtkgU3Q&oe=69DD035C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
cNEQ7kNvwEGV7Wp&_nc_oc=Adq0LrkYGJ0sfT9M7BU_3A2-EILBQA_4-KHHqEuW2BnXOuJgdMKbolggmM2P40V0P6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4kT2eD7bx5XmAXR1MoytvffLdIrmAzZxQZVRDJqESaQ&oe=6AEA100A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4p5J5o7GibsQ7kNvwGIukFv&_nc_oc=AdqPy06Gl7nP__BgJLqEWYsIVbMneKCrHeh-lfszfpY0J8S7u0SLSA7bqFsZ01PKMR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn5LZSCqyWOdbhRtf2Kh4Y2ZZanXzYaUrnySuBGymLbQ&oe=6AE9FA6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNPrjpXN54oQ7kNvwH5WHW-&_nc_oc=Adp7sHFtyOgetP69nO1NZ1m3m4z1GZBvCFCSBpp2llcYg_q7hQYR6zY9zcTwfS3_XAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu9XPObN3GMWVwF3OTCUL7rlvdNbFrf3Z4QxP9b-wpXQ&oe=6AEA019F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8xojFGSD3AQ7kNvwHgGJBX&_nc_oc=Ado87Cnk1Fo5iPnMQKwCz9-sztHn60fJE_BfUlGLiWVhGHYvJdedKxnb814kY0v_uc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7u3Zb_azVNoHF6nY6wAYbwmuwZbSTnGr0AJy1WwMVyg&oe=6AEA15CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDLqnQn7XZEQ7kNvwFxowyn&_nc_oc=AdpCUJK96F9Ml71f9S1zHMmMES-3Q1gCVVmZSfKuMjuftaZ9dkJeQ_A7imYJpbQV4Lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp450oVQCL0L0o7rqG_fKnqCmKKF7rDZe0qdyVjiwJOw&oe=6AE9F55C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
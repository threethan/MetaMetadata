jSwQ7kNvwEwo4bB&_nc_oc=AdoBRk9UPQ67RPnAiYeUD-Qpz3UHzLxZXU6ng7gux_c8Dzz34eDCyGUhdIkksNXgRVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCD4bE6jLU73khYN2Sh2rHiKq1Grs2_RcPYIHYa4qxDg&oe=6ACA6C0A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptYv2Bb9s_EQ7kNvwHFqQIe&_nc_oc=Ado3tC4JRY3hqqJFTo5WXOHKK8zncCd1iXXYzyOUjCjhf51kGKdfhIjtImxDQB4MvBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6VHsOIrRx_DOEFnHJvzzmX_S03m1QSSQX_dxZO3rWJQ&oe=6ACA566F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgIEm_FlylQQ7kNvwEn4fbP&_nc_oc=Adp6o7o8ugOTHmIfQRYPbFGfFqlxHygkZxiEz3JVqMIa_lg27-G1OG0Wqby8Jl4-WH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5Gr4OJMYGzNmGDK9i98vtU4vkjdjLPnoF2fX0hlsEwA&oe=6ACA5D9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi5ZUrcuG2MQ7kNvwFUKX2C&_nc_oc=AdrRgdd8ljol6-Dr_BLSwAE95u_ZRLlKLUZos0o9MKvQE7yolNykl5P3Qe0nLgoYSiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpbSMiAnvTjpcYOlNeWaRBzvQy6enEPQqEZ4H-IxjtrA&oe=6ACA71CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfh1nBteI5sQ7kNvwFtdafA&_nc_oc=AdpvxuEbxAydc8iwZexVptkQRjOwuRM5wPuW54vsU-gZgQekcfZQXTUHvVjY4h8ekdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSBA9QWkuqJF2BkTi2-9ljZKGjFA_34lqnv3UaO-KoqQ&oe=6ACA515C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
7yEQ7kNvwFa8GBa&_nc_oc=Adq5in_gb2uxHj4KqZ6lwWPuCG-9pij6Ghf6_cgyudNNVsVhe9qotG4650MvGUCYBdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpCYDDpQpQOBlcxR3iwFg2j84UWBOZN9GDXBI-pI1IFw&oe=6ACE608A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ng7-O2Ps9wQ7kNvwHRkekm&_nc_oc=AdpxNKAXP27quYO2C6mfGsT-bYRpxaphio9SOPc4YQeoP49FF8YwD91EH6-ksgOuc_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKEmMWT92JoklUxaNfq2Fr4BqIi3uqE0NpB-_KWLFUvA&oe=6ACE4AEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF93zMx2e20Q7kNvwGViN1R&_nc_oc=AdovW2K9AYEr-cxIcn9nNEV7p7key9nRv_ZFSw-ZhEWPodcc2usUIpTUiQySx8TO0ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiQ6h_48tFxsv2URFeQLdkFDcOB1FeIuD2QcRYRG6lrg&oe=6ACE521F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xzoOpGmCicQ7kNvwFyqpXG&_nc_oc=Adqi55P8G-FDF-bTirb01_dqiTjIGTIv0J7if9ULhnLu5wU5vAOaQJGrEB0CpqAhd6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAJd2qWUKmS7uvgt4UI_n9IJQYW48gIWRg936R46AC1A&oe=6ACE664A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91MLWqtlM8oQ7kNvwF3rHfF&_nc_oc=AdqtyK3ggqFUEAgqcXxj7cjz6p9ffeVK1DyURwoLSI2lnxHtAsUiCqNbsYmc-ERgr8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY8azKO4z_zYBTq0zYDUjahmuKD-wVONSjjmh5NjMttQ&oe=6ACE45DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
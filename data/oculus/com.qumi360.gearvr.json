XIwQ7kNvwFGY8L-&_nc_oc=Adpahhqs519R_ZYOTkeYGz8D4mmgnDef8lUSP7x9ZHVdcrlARQ9IDNZwiCNWs0cdYVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y8oVp1I7X2S67SkwG3UkKjvtKXX-e6Xcob2-Vvp1Ytg&oe=6A007E4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmOu_hMoJLsQ7kNvwHEF206&_nc_oc=AdoedEomODtyZ-EFsIskBtpaZ-hwAJVeeZhHgFgwYsyDL70DcVi7vaz6-5MQYniZstA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IS1sIDZMSwhmys3ZqfwOyTBjLraLxnMxs26-nBWDy4g&oe=6A00A0EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5rtioKmOVkQ7kNvwGcDg2b&_nc_oc=AdpR1B-M7SFdNz5G0ucnV8yanAlMvAl_sikzVewtzL0WWTBqL-nxOThbZQoo1DNL78w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c__9GwP2fJ9nCITRBIZ73FD_kOhcYoaVruUuTKCc6OQ&oe=6A006FDF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9Az-pP04eQQ7kNvwEiFPwz&_nc_oc=Ado7WM6m8oPOOQldUcS8xJ734jnskVxtEFKSpDELgYzITRm4lWYNvIVQRtlfbWYFOak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z3PXCtAMVe3MV2tIaMEn6Tcfsg_BLTdoD_yXQ06kqAA&oe=6A00840A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZmpB0YmA0YQ7kNvwHlrRJJ&_nc_oc=AdpkDjTeak94WmXSc79zcDBIDzeBA-G7jPuDCiRQZhbuV_6JE_8_N6DcbmMuD_TxunY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EfsjEk_yWztK182w2sbSSFIFfmJaDanZWKpdkCL4qCQ&oe=6A009BDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
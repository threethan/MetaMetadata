u_iOzH_1mRHxXQ6vfYbH1181oqI4K-v9dDIvIDku0bHIIf0LPPZP2JnXb0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqZqmbUbTdhSuGrotEeRdyuOT4I6qR5X4z2cyWtohrIg&oe=69B2B5CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgPhbeETF40Q7kNvwG_V2tM&_nc_oc=Adn_Dxy1FQQ38BSG3U8hkHJxSms4u_68COL4txdvzUl3Wlv3y4SStj8fo1H64Ew2Y2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCYMbMJ2V5cGsQ8JM2GigOtF2npG5wztQQ_qR3e5U0ZQ&oe=69B2A02F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5aLPLxVSMUQ7kNvwG9cI7e&_nc_oc=Adk1AyeUpsZe9ttS8RRtiyjMe4MY86CKfLPnQzOuDvvEUW4X_Uyic7yAebed6RfNsOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-IEE6oKbWCjIBDoXjyNZk_t2PpJCgXAnj1Kbq4brPNg&oe=69B2A75F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8S9ZInBlAMQ7kNvwF0hdLq&_nc_oc=AdkZR_y9GQJ4dVUwzmEcmWaW4md2EgSjRCzOBa_L1qN_Nlhtb68BXhO3AXN1t2Xzemo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGCZChFg9nQdYZwtG5l5rgKbdly3Cq-OTxXwEhdBX14g&oe=69B2BB8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XStVGU2ZKgEQ7kNvwFgcn2x&_nc_oc=AdmnFQiOCJF6jk9G-IUsVTUcvOvYAXqf8ndXLb7m85DQ1u-GttDLaSN4BfjtsKNeN4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQKdAierwtAGPRIEUWSO6IuHv_qyS9cSTu3JF1WXxsWA&oe=69B29B1C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v
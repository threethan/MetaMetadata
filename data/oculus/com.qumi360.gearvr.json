R6gQ7kNvwEV_jtp&_nc_oc=AdoiUuBbCNrbKcX0u55iU3rF4PKVzEYppzOSuzQWaf_Hx5CqUQD_y_uVYCQKmlL_5XE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OULe-fEe_N1Luy7X9_vD0Wg-iNRwaog2hTFNi47vDjw&oe=69D79FCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iai2qSAEHlcQ7kNvwFyCZrv&_nc_oc=Ado_mPsGlafUtAqQMWJfcrERllYSBT79YvNeKXTqIjQJnnt38r0rdjHa4T2j5bdKoOo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GbYsUSbg9w-snwqhu4NxVkni_3oMfE192ojQiWGMEFw&oe=69D78A2F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXVT4CAfRikQ7kNvwFUDQ6R&_nc_oc=AdpcP0DoVhvrHvGjoLVkxzKkxro5TXwgQ7j1QkZN6JIBtEQsu-6eRkz4pxcGcNjINms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u-pW4gF8hjNop8V6QN8_SpVBRagYw9vbkj9WBKDVCIw&oe=69D7915F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me_4wG8YDr4Q7kNvwHYKFRW&_nc_oc=AdraVDh0UqzAFhSVWRbjtsBaCtO2ZPCKh1BAlorY6pBfvSyHIwfXTDvwG3C55Se1WF4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bn7SczOrDk4w5B6VafnBvnnRMnbnR8RvU4o2fKk5FSw&oe=69D7A58A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDdX3V2_T88Q7kNvwGoU7tN&_nc_oc=Adp-pMyWBxb0DalzvBgfTPZbDxyU431BPcJWmepdBK7CD-Kq9keIa5EaJg6kVuuFHew&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sxOLvUHx9OTeHoBVHG_B-4vViOlWGER-WpVGhXBBjlw&oe=69D7BD5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
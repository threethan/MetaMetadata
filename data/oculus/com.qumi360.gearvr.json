GtMQ7kNvwHVoQQu&_nc_oc=AdoW3ZQ1bHb2R-z-e0Ft4sXPS-Or_xChcDDocbsdXKtGckTm1i9co4tdYViRiHXJTNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3u-PbsAxniV4ptb7R5guqprZnj1Stopqd3Dm5un5dwhQ&oe=69F8954A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBHW67tgQAkQ7kNvwFNKm0I&_nc_oc=AdqJYFagY6tM2x5gjuHzUD8y1aERhJAOOIsCqIxbJamX1duP0KCnhMiwwQGboZnKw9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2U08B4aakN08qMn5U6KnC0jshfGd75CLcZZjHC6-9MZw&oe=69F8B7EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKWl3lA04qAQ7kNvwEx12Zy&_nc_oc=AdoaqRXc2iwJxJwfkFG2akObZAn7WGQurhqt2EAd3moKl3jc6GiR2NYPbw3xd7hRo7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0S8E9NS9ig_HFSc6pGMXBiv0eBM8hX3SM1l9gsnqmNXA&oe=69F8BF1F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsVUofKrA4AQ7kNvwHXX07T&_nc_oc=Adqk1Li9ci2ZuoMpOwikYTuPqgzYGRBpXfvlzIQ9xg0l2tIfH38M701cPS6BEkeWqAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BFHYbogzyK7obU7Z6TT_CzLTykImvnzzKM8wvmtgQUg&oe=69F89B0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk66jxVzBbYQ7kNvwFIlINj&_nc_oc=AdrNDwH-FHGS4VwdhI5o2BTvbgZlMDRq2odeHj-s-HghZoH_P_FgGassseaBr2dxawk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1C8fwnVfar0zQKMX8jddiCIEIJ5WVB9D6K_S9iwRJkDA&oe=69F8B2DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
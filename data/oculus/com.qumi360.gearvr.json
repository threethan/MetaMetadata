5P4Q7kNvwFrAgxR&_nc_oc=Ado3yphw-7iTIiFMfS2dULVoSDsOEUzQgCbNyAMNJvAq66xjbpTrlVfV-qwSe6HbiSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZF3PCgZXloGEdtsfycCLEFkw3UzPbIOgMJTK-Y1WlQw&oe=6AE1EECA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_nUZxP-pJwQ7kNvwEAEPuL&_nc_oc=AdplxOd5c7JtvC2zsrLZoBVPz1py4hy7Uc8JnRjXPtxb1xZSntHMgkxEaTGX8AmAOcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHo4jyMqBozVUhIMbSytft2zrDz3avf6V9vjNBC0UIsA&oe=6AE2116F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv9cseZ4g5UQ7kNvwHzp5sz&_nc_oc=AdrVRp0nj3N0LFjnZegx6lNhiFM-0TK57Glv5KLjSgavpYMXlSgLo3IS8FxQutZ5x7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjqDOrto7fOO5xrcCihxzHPz1CKNmPVq1LE4tiCOu4Gg&oe=6AE2189F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQIk6w_UT8QQ7kNvwFyQIeb&_nc_oc=AdrBCr3FptMiOzBLvOA3V6qSutxiLVQIfsu3lBk51UF_wz4z7QVupHA_OcB4eGXCYT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3Pt-n5h5Dgyb-R3etIBNZcfPQEAu-PczQjMLHAd_S5g&oe=6AE1F48A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMPNbnNeUekQ7kNvwH79Hlv&_nc_oc=Adr3l5zTIanNoZuUZj8HhODEuRqH6a77On17QbdyS3TUzdlEL0YQ2buthUM2mAiekxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeFLH4Q48qyDmXCrQF1rXPFBsbXlHhbEJKS9cz8IL1vg&oe=6AE20C5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
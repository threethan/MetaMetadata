VosQ7kNvwGYKtSq&_nc_oc=Adp6hAHxD6cQye2nmcA336lchFYfO_ZbbTWMEGE4MYteGkpXRwZ0HeY_L2AoJmNtlBg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0uxJEJsDpZVYnFuCzzvBQSRIIrwJg_2Y6b_Y2GX8-DQ&oe=6A26B9CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZj6A7MROTMQ7kNvwHI6mqM&_nc_oc=AdrXAAxNrOty7c4nYp_EEBQyrY4wiz5xeokX6sVAlrOclDBQ_c_dPol4Tr5n7VyJdX8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C63b17y23I9fgiW9UtLe2oRycG6mrbKk0WZnJTqAQ4A&oe=6A26DC6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tpR2pHAuKsQ7kNvwFEssSj&_nc_oc=Ado_5uVBJRXBabgRM6RyiqlhKIc8DqnLrkFguJrROEe9Ho68KN9SITPFbA0v_1Wc8lU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SyQTIWfq175f09lQ0UEMDlhcfeBgKwJda_3qeIxEQxw&oe=6A26E39F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRdCthv0Gu8Q7kNvwEecJUa&_nc_oc=AdpRGWEEei8BvUOFzOGs-3yyQJUt4QvVHPmYjZV11qmD1MXvBmPdqtBMlLpbTaPY4t0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BLJY8YMX2CV9ro4MobzzH9Y5c5KT7MsrTvNGbwPNVNg&oe=6A26BF8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-3ZRfuKnlEQ7kNvwEt3mgY&_nc_oc=AdqMRcpEBQJ4OXgB6rhToRW90SPyMGtCGALepTebbwsZ78gX1lQhTjm93uQWFGkQM4E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sMxtjIbgtYBei_IB7xWs7K_V0RjU4Nd-iwEw423Tt4Q&oe=6A26D75C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
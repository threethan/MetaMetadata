2VMQ7kNvwHOPF3j&_nc_oc=Adr3XapwxuRNhe8pq62U5Tbh3FYgspl60YnJF7KO_TmkYkZOBIwDIfkLgcOxbMO0A7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1mHhZcRKouXlecOe05iMb7DGb88r7-4347oTB2wqnWA&oe=6AA69B4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ri4Oic5ZLEQ7kNvwELNBa5&_nc_oc=AdpdrzE_cstH9EF83iCoz6b-ajGk6i9HoAwYKeM3FiJuMHezuO646rV0vUGgI1IEHSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy_m-WocuPPQVBIj38DGkTKBFqro3DDMU2PSP18ukanA&oe=6AA6BDEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn2VrCseVqwQ7kNvwHTkORX&_nc_oc=AdoPZzlkQJnrm-oM7ZlrBPtvhzschrkLbtRkIN4TQ-_mAyOBWhpEW9-19hraFGzWmkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK70vQ-kBpTRoCAmkLSjENXqr6BRMryWosa6UY7T53gmA&oe=6AA6C51F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyJthJN-Hi0Q7kNvwG7C9J6&_nc_oc=AdpCXU5NyXfDp90JIJf5u9fbJ8z-vZgaSeexpnnqkVx5yYAs82JOQHmAWr16TY_F39M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFrGRlor15AQdKoWDwkVt5IsM_SqZ1_um9oik3CaEQWQ&oe=6AA6A10A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TZ34rXinxwQ7kNvwES4uwc&_nc_oc=AdreMZ6712GheYRoAIpdHZJV8FfcoLHUBwnh-4sJziLlUwxzEDwKJjC8-yDIC7eJvh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj-C-woLxvOla4hGuEkauwJjnQ-qE_DwUcd4wTHCHFDQ&oe=6AA6B8DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
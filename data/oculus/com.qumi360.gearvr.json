VBkQ7kNvwFulwnr&_nc_oc=AdqzSTZCArm4swkbiBIkltrSSYQMLqxwbMdV1XVdYMoZtsQTBeaCklcwM_kT7pF9k80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn4U-E5T_YwByZfjjkXp-fPl53at9I02AzvPoa6ZRG_Q&oe=6A4900CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewzCY078iEIQ7kNvwHNqv-i&_nc_oc=AdoFsIxylQNBcblM5jXsR8m1EW2XIzxCMM-9AJL_-08HHT2MgSY_LSXlLrUJgaVGkak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB49XYJCc1IMBkVXZb8IAnk5_5DdBoKZ1Be8kahlqcEGQ&oe=6A49236F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIs8NeqwqLMQ7kNvwFRzGGd&_nc_oc=Ado_D2rhWmzIHwnv6HJ8iJ6nna7y4IJvKF_FA83fUMj5VYX4BXbmeVz2qJcKc_TmiAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv75jzSltT4f-RYWGU8Cx3hElmsoTsVy7W2LRpUvPXmg&oe=6A492A9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrqsA9as1jsQ7kNvwFhhAH6&_nc_oc=Adr1tpIsBDBoKyhdUulYA6wE1NcAiO_ENOXQW9OK7k7vpKzcZYRB9aOGYwdSmuDxM0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjCLbQMklWnjxdWcaPaOARV3QPV9vT2HuVWqOA32Wnrg&oe=6A49068A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd4osG4jV9sQ7kNvwHHjiwo&_nc_oc=AdrvAP3EHZJn9bEf91mrObPlWi6mB5vxWMj51umwoDws8HqQZOjpl7KvNEhrvID3jLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvg8faz956QDB0J0FUQeOp_-6jGc_-N_rJJShHC4PmiQ&oe=6A491E5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
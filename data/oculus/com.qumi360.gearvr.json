xH8Q7kNvwFNM9wg&_nc_oc=AdqFOpqT14l56NdFJfrpj1Z_47gXFgaSRuUCpJwH2TVFvNtJRdeZS-nB8aSXaWkhZx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIkDeRetu3iAtgxo6tLeIGiLkxfoSzn7JdvFTPolF80g&oe=6A7C6B4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJTlKRvjxSYQ7kNvwHCnMKi&_nc_oc=AdoQl9cvGvQmaLdsDUSxHmfKRS-WLQ1rMotkHzPkC-RMhZWeumEbADEKfaZ455UEF24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq4yo3yPo2zRU5d0t48Wq1VV75bWQUEwTBKMtxqBJbKQ&oe=6A7C55AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK-9CKw8AmsQ7kNvwHj3lGc&_nc_oc=Adqiu3TGLzCO2kX8ulGLnI-qwO23_qdSeJHFSo90GIcWRrkUOK2KwRQHKpAHP8nd5fU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxsIZvqLc8aNue0saPtkaYjtvMFUCeYFKWsh9U2jnzag&oe=6A7C5CDF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai88arjZzQwQ7kNvwFwlXQu&_nc_oc=AdoHKeJOAGfiqfQkwowN_6E5AA3M2Y8ZsGlmPsoafF2gpdtMTN_wqVMF1IZeo13DUWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKI55Rxmht3M-oSM4tDoRo-426uy-4Glw8rOOs-n5ZDw&oe=6A7C710A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctkyI5dBThcQ7kNvwGSJaU8&_nc_oc=Adr84hy4ZdTfQjthZuuGw3AcW0j5auLZ_TsW1b38fytXHJ5G_f6jQa-r802YjbACpRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjNOjV01cmziD825ZSIIz3JOms2lxvCZYEss76eIa4yg&oe=6A7C509C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
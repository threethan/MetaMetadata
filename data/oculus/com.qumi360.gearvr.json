gw4Q7kNvwHl-a7D&_nc_oc=AdqHuIwjgcJb2eevMNIWLeD4DnJ3tpl_addw_3GjOY8qEkaET9Qq6DGYgc7D2YGt8aQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xKR_8KGEODD7zmTkIQLrBkt-DRgY9PdT8PtfFnlN_4A&oe=6A1ADC4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOezTi17u1wQ7kNvwEyKKgc&_nc_oc=AdpLapuIKxv73G5w0KVoxP0zBoRbd52rpJK_2V3Vi_AQWW-fF4rjz_tcHpSgr7laJHo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40k35-GQ_0Sp48f7CG7Pk3xAy9-KqoPG7JBPo0c3aumw&oe=6A1AFEEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCsR0GDnzWIQ7kNvwEh_MJP&_nc_oc=AdqCgM5O242DiDeoXAHIb7cBHAI6MPa6eQGHZ7ES0Eops9cr9o8saE4xMf_jYtXvgM8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qLQ3R3IeFhLuBR96KxdS3t4YlGuXMp9Y4xbA7oWhy9g&oe=6A1B061F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA1DKxz0D-sQ7kNvwGcJx_z&_nc_oc=Adq8sgXSNDnWM6Fd8lTBOInFiVEyR2KJfen_YxjxCXfA8_R2T2tujEJkdakmvP5H_8c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DMx4Lzyn3BpqLRVPXusnUIU24nJ9vOHCBfEXm-5SXjQ&oe=6A1AE20A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO9ZiKVywccQ7kNvwFpbiO-&_nc_oc=AdrOfUb5b9mIsvLqI-5A_FwfF9qbxlmo3jFzb1tS-Ab1OCWAmreGKBpBrEi994ZnbhQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i-ysmgwIe3Zwo8zsuIy0nLbQ1p9I6GyvoVciUl3gELQ&oe=6A1AF9DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
issQ7kNvwGgAPjQ&_nc_oc=AdrSUdNWo-nLhUrb3yNi0fkQmryh4OcYEEyFOhO1lKyLLA_SJG4MXHWaJMVDRB8P4-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHpWENanIjKyO-3n8OqDawglxCuumcaZ1vxMmE4Nqfuw&oe=6A60BBCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LAbZxN2NMwQ7kNvwFJBkhs&_nc_oc=Adqa_IZokkMX8fCvRB1_ry0iCLfK-CqiOQXfa5273qFbZILEZHc3gAc-4ZzcRkM0Nwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBln8T0AXI6Oi0v4hwzMgGv4YfdmZpo_SefCJjlt3fbvg&oe=6A60A62F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFl2AwUKCuAQ7kNvwHidGSs&_nc_oc=AdodlJKP_B16v8rWS6w53SB3KoTmA26H0-khcSPd77fWWzI2AXM-VC37z-K5YPccXpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm-gPm7KgGKyBDDyK2YB3knF98Vxh8JiETZsLCjH-43A&oe=6A60AD5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLJexbAJ308Q7kNvwGz8pdG&_nc_oc=AdqdX4zd25343Zk6t45gCiN8F-D7Km5dbL18H3CTKGhJp12LmiAMjrO5cPOPi_gaECo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArLeMjczLV5a9wzwJIqcwsMVk95g0N5qke0Whsdb4YVw&oe=6A60C18A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAF_EHiYeTYQ7kNvwE525-B&_nc_oc=Adq4GG7VosZvlPvRu61PFpAUuqzCDyeCyxhqqAc2FFBT9SEi7QU87UXL9b15id882y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSOc4_-jh8uOhGiRgZGUJf0hSFmHjkiPudfwpGejmETg&oe=6A60D95C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
HksQ7kNvwFjMeV0&_nc_oc=AdoMylGcnfUInXPxlcSJ_rt91ef8ktXdxL_LFjSOKSOtoi3iQpTod1KUmR0uhiQeO4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcoCLiEUcGj4gbxBYUlQSaYTr70x-1-Z44rTt0MIzDgg&oe=6AD3A68A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV0D-v5mcCoQ7kNvwEQ9ubX&_nc_oc=AdpcFK3lpjdsa28w9q3me2Bgge52YRD_Al6UAhA4r1zxCYkJJivs3BZqTazO-ehljQs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7Ar6Y17iIkh-G1xX-Y9uKCuKwdtwDpiVz-X3ndvu8mA&oe=6AD390EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCOxnsWeduwQ7kNvwHbhn9u&_nc_oc=Adp4Pg3rPheOol_s6Lk89w2HNMaHHwb6mLeRKeINMWigq72wQFnA8PRNXJDRrqnRnME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeSAWgXhxT6Mxrjgi_aDAS7deKDWrkAqL0lFj2zLnRJA&oe=6AD3981F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLc-MMQBjb4Q7kNvwEoMMAv&_nc_oc=AdrfnnHMnjiqLzQ6LULtVjx6Vji-ALNvE1W96WHHGnnZIaa5_43g7kp08FHr41gJIzo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlrx3mIlrOEL_pntbrlqCJD1F8MAlMWGlDR5SD98Vnyg&oe=6AD3AC4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNn2OzJFMJwQ7kNvwFWW848&_nc_oc=AdrdItJG_E6HBPEsHjLSpYPJIVSbNnrlRkbIBqaiaxTQorlo4OE19HFEgdVuxnOpYtg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwnkAiVYEVWLyIRKSFu0yx9nMEKwd5sBAYNePofkbFNg&oe=6AD38BDC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
Zl4Q7kNvwEB6HgM&_nc_oc=AdraKh5EL-DfqQ_-FC4Z4k-dtLRqSQIQ1Tqep_K6ik6nQhnj2xf2hQ5lYDnvVADfZjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwhLLUyQtH8KswFDTv62cmkMz3YuBC4aGZfCDtXBMZjQ&oe=6AC3D48A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Tg8QR2VI_AQ7kNvwGHEC-Z&_nc_oc=AdpKOJNkWKBNYMsAp_4B2lTL0B05my1YLVzQQ-swgMFGPzbLzJ2_TKbq-8oT1J7jSF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYNJMkZ9fNoXjQtfXn2Ws35fwDMU5YK1bZk20lwWsg3w&oe=6AC3BEEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfHsWIm88JMQ7kNvwHWUclE&_nc_oc=AdpDdJX1_uz4U9eqOaMspNvCwI-wJgpq3UGeMJ8JrZmcBaT70Et7tFmjgC4UuE7uuwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8a6wwtmyF_o0ANOXOxZKNeHkwpra25NUYe84e2LaBxA&oe=6AC3C61F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2X2GmqTVJYkQ7kNvwFBHTUe&_nc_oc=AdoLlorsh6FpZglCakbItvnz3L4TXhUHEeplBup3TDUDCcexjsQuh9HSlLcE1XZ7FUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwbbKiJ2lvGXITEJUR5bQFIZHiJweRMNGzEEPkYwGDxg&oe=6AC3A20A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XbvdZAZEZoQ7kNvwHkJrwz&_nc_oc=Adr5QGV8U6QoVTYDag38y_8pOzCJ7o0BIdexoJHllw43wZgXgkYVmJdlZGVRfaL2kMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMF_FSCeTJ2WeiKHSjr3GgKGM0hx6AZDZEa2XOd6V1nw&oe=6AC3B9DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
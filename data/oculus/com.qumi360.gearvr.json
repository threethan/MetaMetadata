sNEQ7kNvwHOjCDt&_nc_oc=Adq3VfOawAFR19Gq10VNOjZcKyiDewbk-O34hKiGEzlFytHQ7gGRs035gStQG4hEYac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t8JXP_Q0cVUSbU85p61jcKZUmPq7Vuxq2HUfn-D8c-g&oe=6A2EA2CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzk4mxA85loQ7kNvwG4tug3&_nc_oc=AdocHxgh_fCJ4YZRQnij5fNTuAkmRAzJiWCp9Thm5dG8K-mOnCx6uw4Lp8OJ11HX6QM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zQMaDYXGWofleOkoodJAbGV1xdxir4nUPL6ohUB9-mQ&oe=6A2EC56F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONcv0Cyqk5cQ7kNvwHrbpUA&_nc_oc=AdqGCCZa2J1mDYLH2Uhp-iL0QWw8e9mmkcc3McFVhs8ELNg6N4KnUgg1G6TotNvuOTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TH5qF7ATF8Tr8poDpmQi0jGlYgVBpiAhUwkui2FN_4g&oe=6A2ECC9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibcDirlLMw4Q7kNvwEZIydz&_nc_oc=AdreEusSrCuJADI1sNx9i5HIV4Z9UkQtvpq-imnGDWTXqDqNXE1G6UyNA-Vq-RW0noQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NauSLx_ZJnlFl5FCZlv5Af4Vnkgh2EWLPWvicdFGvRA&oe=6A2EA88A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eESB1aQbWIEQ7kNvwFex97k&_nc_oc=Adqygz0tmMUfXTjEz5bHrCKMuQSzEXICe4jrdJrnfRyWixcYIN-v36Qpuuv8QomiBRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Ul7bpHozxAL1ISp5iVT4nwXm5f74bwt8bfi6RBPQfw&oe=6A2EC05C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
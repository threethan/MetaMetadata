DEoQ7kNvwFuv4_K&_nc_oc=AdpYRAx6hZiaQ3di1JjKhCEF_QQsGeXcNBrYBpOrGzciqIJXj_fnaWzDf4UtMWQhYmM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS8JTK8y3CRQWAgKm-6qYYdAMx6LoXPfrSQKuGJCvYRw&oe=6ABE564A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xioC_WuAiikQ7kNvwEJovK4&_nc_oc=Adr9cXh1zhtLxvC1P_2MQ-QvPojpVg03lzZf__emDZ90Nrrw4s-Y59inFTmPdMaTnKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_N5exjFdF9vu4z2izJ12-44c7-rdYxZZsNbfEDnZnAA&oe=6ABE78EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI1wZE4OsiIQ7kNvwG46a5S&_nc_oc=AdpzzStLLXxuKNqiTwxi756k8KExNTNi1lcZeomjAK_nRZF3eFebonLTHeFtaotv320&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkizhL3L7bJ6qnC-oPrt-ufnxp1nm2xkq-2cKHSWN3oA&oe=6ABE801F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fdvPE-p0RoQ7kNvwExPMbV&_nc_oc=AdqugldaV5c5UEdwDNPRkT1pumDQ2D1Yh728NCMgwqi8uVh6nYUwT9xtD0vRj0PbNJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ089Ic2DkxdDS8Yn7ZQu9aZ6XhOxo1HXvOnayudClYRg&oe=6ABE5C0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV5SwVdmUUsQ7kNvwE6yx67&_nc_oc=AdpaSEPVrs5Ns_UkxVHafNng5XtaeGVCmka2NVYzPS7vRJuTfkFjCTAm8TgUfRWkvow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-PhYOwlTqLPjB3DfZz1DTO4R6M9fUvDXLHbw_inD0Ug&oe=6ABE73DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
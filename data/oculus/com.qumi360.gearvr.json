Z9IQ7kNvwGGRi-w&_nc_oc=AdpzODXiXpISqvFwwvQzAY7yZ-jxkLlNUPJGbjEhE2EuOVcoN2IUczaTBHviEIEJBao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXZXlaeNGE5Sf0aEKa44a2yqtGxFqz35S9p_FhOY_1XQ&oe=6AAA8FCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qUEJi_qlrcQ7kNvwEKRU-T&_nc_oc=Adp4PTrOIuNftJivY3NAXjXRvYDG1JL-z0-BNJ0UThcVefA_t1sWFHsPwfuS7cfcfJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKPl6eVh8gWHQmYD3PFiRrDzSO-avYGgt_M2rseq7hAg&oe=6AAAB26F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IlDne6iTzgQ7kNvwGndIxN&_nc_oc=AdpDl6rb0_2NWRw3s4DwTHFq6BtVt6H4wWRTlCwHzwPK4WycL_yLZ8NeExvgEGWEEsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpuHQtP3rgct7C67mCupRL8LuMLJi47_j1OHhlZ7onqw&oe=6AAAB99F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-cFsH38wyYQ7kNvwE3ven9&_nc_oc=AdqQ2hQYYMWaNknTOOGnGiJ6ygT71slWHuF3YcxMCsZUXnU3tPXl7-FDBEjrCxzgNzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSrIJxbsB8HEksAC5J35crezARXUXu3t86HPNMERbOIg&oe=6AAA958A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN_avwkbHEIQ7kNvwHTAv2W&_nc_oc=Adqq4w9Bvq52beCjqxLWlAdWhBdwOxMi6q-vNlwdkrx13X1IG29H-f-0NS-cNxug-0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1k3WWH8Ytd_z1zGteQ9njoLqcLBEDw5-TlzTkhh7LtA&oe=6AAAAD5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
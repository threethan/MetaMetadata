go8Q7kNvwFEQsa9&_nc_oc=AdoFl2L_TRiufzUsG1FxLLAPef2RUcJ-S8aQ3xLZaduEfDiGtwVPGxpolf5naoUXRIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09Uo2rM0zmTW07KnnYUDJY-oRtz37Pg5wkDeCsNI8XHA&oe=69ECB7CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lihzFUzygsQ7kNvwEdjcCi&_nc_oc=Adq_6FZ5ItgROW2ck5xQA-EMD_IPWCLtvjt7LTxJpG1oFjVP7t_Q-xnsYQe300zywME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G1v4-VmVr40CQVue3U-PkUO8ISLBBgdR1jKAW_QrH1g&oe=69ECA22F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNpQbuTuDW0Q7kNvwHDn5LD&_nc_oc=AdoI-u8yDhfAP-bJTZto2htPxyZpzSgaXmbWOjRJ94ChVHcT12FC8moykg0hkV-V_Ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06tLMRj5teKdJW93opLQ5NRvXteSlfcf2Zwv7OZI0h2Q&oe=69ECA95F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g3iFFfTJDwQ7kNvwFtozj0&_nc_oc=AdrD-6LLa8Dlo0kzJD8wnVuU9cA5OyglMrsoN4jfJ4hOiPsxkhZJpjtLtqpxl-ua3UQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CQXhE57LpV7QdMudACap-FCIOOP0Q1CVsUQRZ_Jqq6w&oe=69ECBD8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QtQ85H3teQQ7kNvwGYS8V7&_nc_oc=AdpDHTYDwh293s7Kf_TxDbgHhK0i_sK7YGKtLk_mm577ri9HqFkk6GfrFUHz9iDOMqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Oa8q6fa_mSwInHYOpXJNKSn2IaoYZ90R-VhGIkRtlbg&oe=69ECD55C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
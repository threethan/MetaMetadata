9TUQ7kNvwHYdQEI&_nc_oc=AdoPK8ARh0hQ6OwXcej9AlFDyp9Du1MAobsWcH2U3Z_3NmDT3_m1jLvGrVjtdoGoAGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48GpaOYNxn2EEXGHMPOrLi-HYhCgV9Y5a1au8vF2TAaA&oe=6A08674A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9JJNX1bOHYQ7kNvwH4LH-c&_nc_oc=AdqJk-YWWm1NVbmbvrSZ27grOJJ3IIXaapP1uWCyDomJlChyYnPlrJwN8sb1-FfyAu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RmCFiX0cj7vLPUiDQ0uFDb51qcf0uudI9n0Q9ZfZ2ew&oe=6A0889EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAK1rNZSc2wQ7kNvwGB78ha&_nc_oc=AdpTV0tjbymlbQR3T1_jOUiVw44W1xsLNCshVdFY0nGLK8SXpZxy6ZlR65jymscc-Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LRgFPDpQoB-HxmcXthaIdD4Flg0GFhaBIOK-3jJ2PbA&oe=6A08911F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9cxPSfJQA0Q7kNvwFVW3CS&_nc_oc=AdpEwE0mqk5VhMNQtEkuiaB5Vv_HAej2yj1Rlp-VlNqRj8FQVpNz5m5FKfa3tptu1kI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MaFsoaWTKJo3wtU83fsFrRnM3UIdSpqZClGL-rrYPtg&oe=6A086D0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6E9_sPSTkEQ7kNvwHhwWBn&_nc_oc=AdrmII0ypYxYVtPUzJf3JpwYfIMu1020NqpP5ld-rnre4V4yQC5TENx337BscfZhZMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tIj7fwkdG9S_8VoC0b-ZskYuVuoLQKy4C0CLPrkVg6g&oe=6A0884DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
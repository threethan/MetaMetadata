_ygQ7kNvwFcokXy&_nc_oc=AdoEoP25warhHfxHNb1GwzvtjRjhWnuXzAIoKl_9qt5RHgx2grKOS_Ki2BdgNqFNUl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t2nQJ9S9cAEOFudMa6f7JWxjwR0lX3J72VypdLt1rIA&oe=69E37D4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYee_rv_M1YQ7kNvwHfqRiL&_nc_oc=AdohZdi08dhoRhFOH3dOjWX8LayboEicsCGPWvxfGttTEhxvWc_wg5kc2iF8BAzdEd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w_WbIpjBOSlX8Bw8GP704FflrmKcSysyFP98BIJ2yyA&oe=69E367AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjsg6lolkJEQ7kNvwFf1KD6&_nc_oc=AdrvvyNmfwBge9fJmwQMbEOvG-wvX_DnNuW0-ehUJD2Zad1PnTX58zAaOzACEhp1qmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HsjTCVXBJPUYHwUKHuhXseKkrksQKHd4oqwQvPckf8A&oe=69E36EDF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJUKo7Zv9w8Q7kNvwGXqkTr&_nc_oc=AdqTM3uNA455hNB5m5v44Tsg6N3nntoDtQdUcMlnm5leQ1IBn7zi3oAX6rkWSfGUQXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jv6JTILIJNL9xGcRPSXCARRf3exf-rEeW4aWDOQBMew&oe=69E3830A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz5GioBUkiIQ7kNvwG9_8BH&_nc_oc=Adr-c9Tim2G7cK6oI4iayRu5zwBMeVGHFKymz99GA6vcPBdP566HM84-w3_-r693zwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QgJ0E03aJJJ4cSJ4B0fT7XnAnmTU-lXYb9zFCz3RF7w&oe=69E39ADC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
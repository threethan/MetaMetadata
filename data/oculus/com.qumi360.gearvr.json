kQoQ7kNvwG_yGJ5&_nc_oc=Adp_qP-YOVy33EJolib5HoeMLDmaBQcXgv35zGGs0c-mGLuGfMrQhGyt0aDMWk7TqYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3yYass0AvsxDgnMFP0rDVjHwP5sFCWaVD4Zx-xL6DKg&oe=6A9AF60A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt7_aeo3H9AQ7kNvwGkxb35&_nc_oc=AdrjgBgWvBUSnSY88Y3yWMyerLQW_fPvezj-lZqQXfMVMTXqexEw8eu8sZ8_agqEK-U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTG6pBFkSAzezl54oB6Y_ZrnXNTl4wU8QnvI95AVv_SQ&oe=6A9AE06F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fHvAOQldYYQ7kNvwFLjswn&_nc_oc=Adr8webE6_R9EWAs2cREbXoh3HN269PPWYpTA1aS9mwlJBfVQ5u2JlzNiSUQSDwQLw8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlia-MEhgfQkexzFmcyO10mI_I1FG-e0G8PGnfYdR8pg&oe=6A9AE79F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS1jg88xU7wQ7kNvwGPuJGS&_nc_oc=Adoc10apypm-aza-idHqTPHjbL8sFiIf4N69i4c7VTt7ExNzedBVNWNKcfPU_Ktdc-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqLjnD-KgRZlcyQsG-7pE_4m4NaECXo_Brm9jYygkejQ&oe=6A9AC38A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwcvCEMk_3sQ7kNvwH47eq2&_nc_oc=Adp0CIeWe4SFZ-4DkMM2Bp4UHtZqbr46oSXaqxJsgg2AzRoFkh2r-QrKsWTzojlpc1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs_9gbXelAieDcCa0MXWdaXfVl68Wze2oWjGeb2vNVEQ&oe=6A9ADB5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
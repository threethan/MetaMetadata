yJhGcGxH8Q7kNvwEYLHlt&_nc_oc=AdpJtEc8RZ1TBIQeRCkeQQ3hek7xH7EPZoEN0xYMfo2Aka88pYr9am75jh4C7YQ1sRw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEusRvK92oo-dg_-qA9UDy7OTj2I_FTxNN126H4DlO-mA&oe=6A7DBCCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJTlKRvjxSYQ7kNvwGAu5_T&_nc_oc=AdoNXTr7c5SDg77Y9MLCteB-UyE5KL2Eno9zMkcbE-8_A1u7us3NubbMNpkONCThgaY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtpFcBPd7sQJYAshjMQbocJPQvVysOBgTCMLL7UwuoHQ&oe=6A7DA72F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK-9CKw8AmsQ7kNvwFZP5pr&_nc_oc=AdrV50-IciVrJ_yWfzuIXiPvuZLFSKTsJaNxCS1PkWhod9KzHz5Gt755aMw-Sp-oqhs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGgstrmTs1sQdEPi93j7KqSVIC2tWL6x95hcNZlo_eLA&oe=6A7DAE5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4QLSFTqPbsQ7kNvwGea7Rw&_nc_oc=AdoFztLKbt5TxHt1KKAhz9Y13-7nNo5yyjqgq6og6sFl3ZjxHQT5u2-CzkXlB7d5-mM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSeqR_CxRhPloBHbGA4Bq6O0-0emRP0KrE7ujpUxV6GA&oe=6A7DC28A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctkyI5dBThcQ7kNvwEaA1Ei&_nc_oc=AdoOIgxhh6POIiGWTHPNvKI-3kpG5BKGC_d88nzLsxuMdCdhJmlRnD_1fJnzdTsvqAw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdqtmIczofUmJP86YGoluHaZ5tjOSaUjp89rmykezWXw&oe=6A7DA21C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover
JVIQ7kNvwGmmF1_&_nc_oc=AdpAfqDJvNhF702tuRLfMRWlZEPQ1E15nqSKlmHOtGlEOcoOmZ2MW6_PHc0kylaru4g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNKpXeXlq-wid3N3D14MQSFl4L802rmu4JoayYRF2vWQ&oe=6AF9E20A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mMi85TB9NwQ7kNvwEj7i6U&_nc_oc=AdrCr4ktfvp1YZtCPlxJQ1v3vBE4fPQyiE6bt1uFujg9MxMQxzBbcWHq7JMzJ6KEHUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIWKtFfSRbyzxio6CDkB6H1D2NEfZl8QnCcbx0y1CLfg&oe=6AF9CC6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUZgHcN0OXMQ7kNvwHd7nzY&_nc_oc=AdpIvVrgHi64mIH9lmYRABmTEMaQzz8Id9zxC1u1pIZ80eMQio0ZftgvWth2wDX7fLI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYsBDBtQ9qiKfFMwJIkdDbeBCSi08iLn6j-UydkK9tCw&oe=6AF9D39F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdh2AQeQBvsQ7kNvwG4lpmR&_nc_oc=AdqbePOzWCA0wQEOAe17tMHx5pq2xXw2hlQIkxhRrArawHT_ZO0WHNSkieHaSGGIWJg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc96m3mOH4w1x7iv6PAO91DUUCxkNazRzE3H-TfHv6Og&oe=6AF9E7CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU_5rYI9JIcQ7kNvwG31kMH&_nc_oc=AdrZakE0JSfZAavFHpWp_Zq3NOnWFtU7cl4gWaLM8vbyxZktWfKiGYLggsTJHXVZ_uo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIFFQFCD7Chrret3bVISrAKgy-bW3fZ07V_A6zNFdVwA&oe=6AF9C75C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
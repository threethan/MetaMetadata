9TUQ7kNvwFPL_4m&_nc_oc=AdomyueZaEMsvfoRYsgww2SivCZ8kFSV6o1R4bK2dACHr-7RwCLvHg_U-BvEHWlcrZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UyMEg1VbsNyaafTM9G5swLDNCMY14enZA7GCF66oz5w&oe=6A0715CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9JJNX1bOHYQ7kNvwERfi66&_nc_oc=Adq0rkyUkixXnGSrgFFoO8-6xCN17C-9zkXhqKNvzw1pfqOwBzRaDYGNcUG-y6uGzbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n2rFJnFIY1nMjHEbLpP5SEFzF1Q1bZFVVUUiaS0FFCw&oe=6A07386F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAK1rNZSc2wQ7kNvwHKRAYM&_nc_oc=AdrOlu5iFKf8DZg4bPGJA5437sPgdwl8cEeO1KnDypo_6UfRtHWBLR9m6y8vWf5MnCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qw6GOcjqIOr4bQK1TTwpplXTYIcTMy-5Fd9VaMfrzMA&oe=6A073F9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9cxPSfJQA0Q7kNvwHWHX7k&_nc_oc=AdoUM4hqGkZiJeLVPEvQ08Zd-3jz3I64ttaj_ISpmpUVkg2Oo6N7vV9R5z3Jv5ufwNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hz2WTmtYuqqQfnmu6ogfP-EgBUL-aG_JcWoFrlv5DIQ&oe=6A071B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6E9_sPSTkEQ7kNvwEMkyOW&_nc_oc=AdpV3vO3ThtJVeBdYPID2fkIwAfM3Pbi2ZoILa_z_zb9kHqW846NKRKhdaw0ott_Rb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5owRVfRPPQkKgU8jPjqzsZCwGPv20aMOAxOwZ83UAciA&oe=6A07335C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
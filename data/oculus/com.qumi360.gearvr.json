HksQ7kNvwErKel6&_nc_oc=Adp8jRYuDgP0dwXR2yOSFyha4VIdByF4mLoeoRDAacn5K7VoLrU7QYudd1bi9M0VKZI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyg1gx3ySwbA7zxJqC4_1x5f43Wrv_f2eKG8mRmjriCw&oe=6AD1038A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2vFQbHd-dAQ7kNvwGlMXVH&_nc_oc=Adoczo7CmaltqrFjbPs-BzK6Zn8UsSd1eEvnxZWhlaHOcXaFiRYwnceuRyE7FTrfoL8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt86Agm7-uRJdvvy2wCAhHfl85IOFk6B8_8tGvq3sklA&oe=6AD0EDEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nKcav6fhccQ7kNvwE0QCKK&_nc_oc=AdqGSazyRTQM_1GVJtNXWgucvhFbCoTejm1GS95ubdGGLjd1iQNqbt7fpdhe6sfEhlQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy-wkO5f5hTSmErY-VTHjRxB5B9KWG432QgDbiQSX1HQ&oe=6AD0F51F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLc-MMQBjb4Q7kNvwFD3Hqe&_nc_oc=Adq2Wy6u4DXZXMJahzOTyemoda64gOANSVtq93MsPgbZgmfl1I3m5FRUpphbFp2EvgI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPzYD-5smd2EiE4hG50WZYgdNo_BPUELVV0x_BKqvr0w&oe=6AD0D10A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUIsYmn9BdsQ7kNvwF8ssbR&_nc_oc=AdryxpHK_ng1Sx7BSdtsGO00_zB11XSQwgIw8ydF9Rfm8T-PBLP9DY0TUM9_Fl1QG0o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHWxBGj2vbFP_bwxlCwHgOY0E-VAkYOygzAkW4sw5sDg&oe=6AD0E8DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
xJQQ7kNvwELPkms&_nc_oc=Adr_ZNY11KhvrwFIRRSCpXd4sk0D_0uDWpBoSqCLZYpp8KUjv9ZLHEE6ZBnhwDDGxOA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnhn3Fh7YIo88ym0L4xXJj4tZxwSgxVSY-c4jqw0ONIw&oe=6A9739CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqmfcFH9tikQ7kNvwF3VWgG&_nc_oc=AdpsS9Ovsyqj51ojxY_9oQkNCYChf_MhQp_PPtDf4Mu0bLBV5-oXw2Z_KOr513fK3jk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvHdYFIdikRKaPc8uZTMGuphQA4-Y0ZnEMl9MnPh-WMA&oe=6A97242F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggrM2nwXkQcQ7kNvwHsCKpq&_nc_oc=AdpHPf_BsMXVxlcLxeEi_IZieFrr5OJUlUY0yUOVs23ym92CFyaKBUF1YZpE9Nl5edk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP_F-X_18p4mKQzvg8NLD1oqHOiQIJajF5OAQ9oImHoQ&oe=6A972B5F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHQigcqcX54Q7kNvwEvO8g4&_nc_oc=Ado1HIoZqRY7xFs6sS2pqyHyBgIoBeCvWC77QL6rpsvcN3SLj539D0yXRnpFmB6uC3E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP7r1DotPZ9ag4djE_oG3u3myBkiFB9rZvxW_CKwiUSA&oe=6A973F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwcvCEMk_3sQ7kNvwEPoPGy&_nc_oc=AdpaSLYMEdAQA8ISVnG8lfsqVMRr8tmIf9USZ7K3GKrlLKDi9E2rggBWXX3wWz_s5EU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGALagyYWdFqRw49VjhWiVgEQi2e6tHKZT1PRfRx_kbJg&oe=6A971F1C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
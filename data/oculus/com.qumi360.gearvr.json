XIwQ7kNvwHfBzmt&_nc_oc=Adr_gP0n48tNWOZoD3QW8IbPUJx2SZ2pHjhx9_6Gl2S7AB92oAK4CgCf3gnjIjs4w38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dkJ0T3axySPY9RTNdjcf2XppSXbUVeWqYW9jzGUdevw&oe=6A01CFCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS5BQ2vdXFgQ7kNvwG6-mwu&_nc_oc=AdqP_onqPyg18oSnD1ZyYl0Os_YUN5hj6WzmaLlZn9_Q-du7YeojcE7vIk3Gn5QLIFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43qPTQrBCAnsvcXXZymOLjDM6srm87dOI7qfYgGbumvA&oe=6A01F26F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8ROH-DDsHwQ7kNvwEoM-eO&_nc_oc=AdrLQB2NmFgSviC8jV61IVYa5hKTUyFvHwTgZr1lEL4A0h188hXZ0iOK_-p4GFeTlhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45ksAfvCo22bM0EdwXbEX_Cx3oepb7oHUYxZgJtbWNhQ&oe=6A01F99F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9Az-pP04eQQ7kNvwHvBFzQ&_nc_oc=AdojwP1mKE_XsNO3WchaXPTN47H30srlllD3vVPzmN9wSOMJNGlkvsS_0WKJcloSxgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I2VXOYJiwPcx51kPA1sSbPFO51vpDnCv235mAEwClAw&oe=6A01D58A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfzZV0OFkoQ7kNvwEo2uRh&_nc_oc=AdqCn4GitAItEapIaLEuVV2eYYPWjqeQsMakBQauGljuRQaFSwDNlijSF5weHr83qTU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LfU0wMb4oDtLPqQiMEHpWLAGB5jT8eQKgXWULnbQGug&oe=6A01ED5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
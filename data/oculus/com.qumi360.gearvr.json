G0UQ7kNvwEInk1H&_nc_oc=Ado14eSlK8ad96oCTagaPXFUgoS4LIE_cPsemG9uLNE4E_dL79YGy_qGCXUrpGmiphU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R43OsQOdDu21TUzRUj6X9zp3FhVWsbhGCYj567mjeHA&oe=69DE374A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1igiYHG5KjMQ7kNvwH5-Cbu&_nc_oc=AdrI5ksRjqEF8YHMKkH33bQtiQhOrRAQkS3HlsxSrJP3PoCnZNn0qg7qYD2Uo8Jfb5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fqImXTNHlRZ8XV8qiDUsl5NATf3x7sSXF0nUL4MRAaw&oe=69DE21AF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsOSsdosIvgQ7kNvwGHdxEg&_nc_oc=Adp1Hhntsef3z8o3vCERrQ5rkIX1TnXPoaL7hIOY6U8FCdLFIMf3-DJUWFDkvApZRWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vaKslUDcpaZ0FyZdc8G2d-CGSmtPExk0JcusUF8qedw&oe=69DE28DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-lNZVShWx8Q7kNvwEQBItn&_nc_oc=AdrIqYd846_hZz_t2fJ0hnSJyoQvaJo_uHk0HZxc7gESNT46R2J-4Q6ot-sw5FCqHxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hwJw5fkQaRujZFUowWP0Ya0-t7AZmNTb6V_zuwLlWAw&oe=69DE3D0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtj6fVCAnLMQ7kNvwHBjD69&_nc_oc=Adp5f0fXWzoXRDaZfX2aeHbXlXdomPcrNm9jc3sn3X34s6D8YbAF-lV08bB1aFhw1xg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yMCf_ytfEh0E-4mdpSHZBDaK4DlpyUeqBwbpmTVc6EQ&oe=69DE54DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
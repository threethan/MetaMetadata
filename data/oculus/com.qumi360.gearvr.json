Zl4Q7kNvwEmjCYo&_nc_oc=AdomgIjSDqFqn0Xgzhl2wwmkypy6pP-yC5CrSAjJOF8yVrmFo8k6K8Bcm_ziek4YsV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO35bWZiZC5NfFqCudPXPYk4ceiHDcvfJhmXWES5FZf-w&oe=6AC1318A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53PREDL019QQ7kNvwE6XC5t&_nc_oc=AdqoroziGLgi0TdobsQpOJwfiN5_vR67Ilr5dv-cSClqNMftTRdpQ78Gw6_Ga3rX5z4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVTZpZ0uQrUtdMip8jHp3cJGqlDAJ51rggVDP19sOEyA&oe=6AC11BEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43J0GCqyLFcQ7kNvwGIcmVQ&_nc_oc=Adq1tFX-expm3p2K8RBO5RgOphX-IrYaccu3siHVkzIUh71KHqYo0SXDym9AW52z85k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0lVvxfoPW8EbNiTiB7ySyjYjFkuJCQtWyHmdyUF7bpw&oe=6AC1231F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2X2GmqTVJYkQ7kNvwE9z2Qd&_nc_oc=AdpYQ3haG98VUBA1eZpNRS7EAIEb1YUhc-gv5sAaqIG7t0RnNIKx5QMdD5LPYGiJt6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIwr5vTBS4CPpNVAi9WP2idm8iPqH-i-YBof0FrNTqOA&oe=6AC1374A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmHMPFAqHsUQ7kNvwHgFG4W&_nc_oc=Adqc8e4M2NMsoZHSCkcBEvS-OcXYjGGQ8SMyzQZ3hFDv73hYnjqRelSbJLtM43g3i6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk7En4pjze68ycu7dpSxi0a5Dp-zOqvz0V5BXoncvOjA&oe=6AC116DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
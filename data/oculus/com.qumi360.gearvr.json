9TUQ7kNvwGTHA6H&_nc_oc=Adop7NZnJhRo3MQrKoqMFad6mV1L2hAonb8AC6Qpf25nxBMslJqAR3_PEoItOw-8cbM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bosLqzydMScFM3CQ0RBdHWs2gIjr58Kmxapld5LPxaw&oe=6A09B8CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKzWzmlJnb8Q7kNvwFZiZCu&_nc_oc=AdrhfgO1ahVa7X6WeUpa1uyf9E-eAKhAPfhHNWPxSA7Q10QK5LGDZd72lltL984cRK8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ezAjMnrB9a_6ftE8n4CRraIoKW76MVpGRWKyCkMQjmQ&oe=6A09DB6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmJ2bmciLzwQ7kNvwGOyF_O&_nc_oc=AdobOTj-lfJml4D8qM2eX1l5fA8OEkWrWeLd35IxtkynCwkIHzvmo9nrgnQPx-qEOOo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JqIzAqczA3VTbudky3P8syS8TbR5kg0DFVs3YYWcU1A&oe=6A09E29F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9cxPSfJQA0Q7kNvwEhDLhO&_nc_oc=AdoBVzgT7NKbYMmz_mNjR9PcHxsXHhx5VvQpPm_IwL7Xw_V-_O_9TFGJ9MQu0tineCI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af612QgMTOs3SrVuHQDLmKAZhlak-biLQaSTNKcLWImGqA&oe=6A09BE8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rut4xfITy2kQ7kNvwGTqK29&_nc_oc=AdrUcK8aroHZ3mbjupdYl8eUkF45IxNzaSUlc2983vywHqd3ZdXwEb6RkUgZhyt-5ag&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RPDN6fr5LIov0reN9JhlExI3C1Ur_bIrsoG_wMAGONw&oe=6A09D65C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
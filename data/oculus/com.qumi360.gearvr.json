GGcQ7kNvwH8-g-C&_nc_oc=Adou1mrmY_56_k1CxqfZ7D4b1B1zwqxkGoHWrKlqmA2pUYpyve3JCXOh1c8IA1i9hKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UQ0JuuL_HaWRxkBUOZ7SC9gzY03ZEB_3x8CDLhoUckQ&oe=6A0472CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS5BQ2vdXFgQ7kNvwE-eh6K&_nc_oc=AdoTJL_c-pxbeihw1bw7VhtWFNcV0FgoMMhVU2uctwi-NTN9jp0cj1Tc2FOATZxj-o0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PyysHRzcnbt-THaabTG-5vEzlTm853W-j8tt1lxrj2Q&oe=6A04956F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8ROH-DDsHwQ7kNvwFCC4jm&_nc_oc=Adokrr4i-eZswYQ148CbqgDdPEe-ErTZUITmNi2Se-3oBRrFtbhi64eAgjd35mYEZAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N9ki7CVnPm_9Dv-tV-cczvwsC8kmaIuqmEzP4tvOlXg&oe=6A04645F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0eyxsOCJ_8Q7kNvwEXB29d&_nc_oc=AdoGQuI_036JzO3xL3pbOgF8dZKpdlNH6XM19BQY_W7BEByTiGpGfbF2bsB9nNvJDVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K7qAw9ibaywRXeVjpKzCUx5VoGfpDrP193_gnCl5KLA&oe=6A04788A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfzZV0OFkoQ7kNvwH_ZxYW&_nc_oc=Adpt-CeKq0FO98Yfusd8D-g2cISHpuCZGvCcQmgH9fbbISInVWQddlEBSlbWNkC6qPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LdRO8SgynhsQ5DkGX7Tlc_u_rKoH1FiSk_tFLKsZ2cA&oe=6A04905C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
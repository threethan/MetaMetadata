Iw4Q7kNvwH_8QQz&_nc_oc=AdqJ6_MoKnG1VqDx_SUGEdgQpYOY87-_q3YOa-ceqRid_MqpZpukWh6ehEf8nDP0v0w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8qayOi4W1_GcB3WDDyyoLAIYmviR13H6p0il0wBx4ig&oe=6A91834A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KeTR20IGW0Q7kNvwGm6yip&_nc_oc=AdrxQ7YC8pL-lVCjEIoRjVpWvZkz3JH8ZspQ3SnERo9csgLuS22xEeuxeiioM3XGFvI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2bRvbxeZI5Kq3U_RlcFJqm3F7xP9OWQCmVbxVlB7XcA&oe=6A916DAF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgIA1lYovL4Q7kNvwHz-n7Q&_nc_oc=AdrDv1V4pKKty3OAD5iLGXqxQ_szpuP5yq0JeNYthHmlsjBCDqmzst7vxEAg9cgW-Is&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8cOceqf-vX7HarxTdsnmLwZ9PQSrZdGVbNjxkPqHXkQ&oe=6A9174DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA1QCf4jA5AQ7kNvwF6_WJq&_nc_oc=AdrTPHTHw2h3tA6ZaCO8_hbN0bFujkEzml2CApFlRZB86giyLVxJOjr6rtKKcxzLeFw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjH2tdNburgFBJQVPc770wBeyJ3CObMLjvjUlOaNKWnA&oe=6A91890A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ2VhwIFSHQQ7kNvwGwgHcA&_nc_oc=AdqQWWBFNaQ3xVfWsdtyfbh7XRSiHmT-8pAtnbhFf75kgYaR83AI4kaz46Xd84ijRE8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsFhoZhdrsn-GUEFlo2uSS7QnrbRrE3qWXxeeO_vuI9A&oe=6A91689C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
2toQ7kNvwGq-XoU&_nc_oc=AdprG7ee_UQSoBAgreeNHjDwSba28jnlRY481tcKQ_NwOp9Zhdv8n8IvM_P5EelF3zM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeYto8EFT_9J_EDmFmDU_g7mw55TfNJ2GifUEWNiYxtQ&oe=6A562FCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d7yoUa0OJIQ7kNvwE9NCWF&_nc_oc=Adqt1rSEbP-QkfAiz5ZbgJh5GOF6xQUOo9ovziseENSL--z1j3kx2DWwfJxJ0NqBMi0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2YSBITrEyipQ9GiOttLeg5n6aulWDGKtC3HBpX3k-TQ&oe=6A56526F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th0fF1XvOCcQ7kNvwH8TD8Q&_nc_oc=AdqmqEU-YgfXkp6omaP_5NSFajrq-9U1T0g0JKPBy1kXsCVXAwFdKvI0xit1xd5Olnk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMD7J12C9RS7cazjzyM8G7Ws9DXKU3WoeAj-cOmoKXpw&oe=6A56599F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlkwObiVwQAQ7kNvwGJgWNL&_nc_oc=AdoLRd88-cQpeZnyKKGlYzqKTBmrMF9Xvvdi7SsLs5058bSn8jhZHuEdtJ8n0Wiu_1w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjFtadC6aCnEZ-7LWSHFWJxqXQlPcCjJJ4yrmBN8nPOw&oe=6A56358A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ccJoz_MhWIQ7kNvwHNOfc3&_nc_oc=AdpWzxkvmDunb31bG8BKQokOc4suoqOzcUWQGuoLwHiQUYB2XND32niwoK3C1PEcYyo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGdFn2tIjn1L5OcusLhVs73KcZXCO84WheZ1ffHPslow&oe=6A564D5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
gT0Q7kNvwF9BRnz&_nc_oc=Adq8TnfuNH-VhPuyUlNQ4odUxDw1TmA8xhO2_RlE8K3r0IqvlDs28GCXEA8jVCDpOS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxMfP2d4DkQp1EysipbHapaVaY3r76tezmG1rvRobckw&oe=6A67534A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC5yo1Ng_W0Q7kNvwGppVea&_nc_oc=Adoj3-sqdMH7REhZTwxnrcqWxXzbrn3Iu2GiN27NlGfAsUG_rMIUSU42GLDZ0uiLOjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNqK2zcvjZCcTs6m-j0Dkq6irNmFB1WMJjRU0Cq6kmeQ&oe=6A6775EF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6AOZd-M9lwQ7kNvwGgA4Ft&_nc_oc=AdplzjSc1sNoZ1sBc-yCcoloHRgH8hpUd2r4D2gd4ptoOcouCQs57uHCiCVcTTXxQ98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1R71VkdQn6Y-Tcma_aDjqfVYxuGnDe6KKfs70q0rU9w&oe=6A6744DF"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Xi5c_cQvZUQ7kNvwGPkLX4&_nc_oc=AdqfumQLkiQYOYRnogO1pMFoSxo97YdCeQTnfsdA4htzQqCWKcW36cllHZjdgbvQorA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg7UMys3TCX98scAzg-LQExNSSTiRTDW9NYuJD-mTV6Q&oe=6A67590A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFvTbdHWB-MQ7kNvwGEd8pr&_nc_oc=AdrdklV2RJvt6uLIWLqXEbYOSWIlGuRHZ95Og783iARt4lD7YBXVMui9uf0KG44ccfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaDQgfh2ffYfGq2PzyE1OsNOPFWQnRX1aa8-ehyjjQag&oe=6A6770DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
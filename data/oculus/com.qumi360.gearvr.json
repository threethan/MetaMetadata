k7EQ7kNvwHeHrxR&_nc_oc=AdofM2rQtSzfULrRBDPpoVJMdu39yMRN-3VlgX_3TKmK-U9HHSyli6IVKRG9MzEEUCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu4VjBOJvzIbQ66dYM95Py-iMgDNCLyjk1vD1MPqniDQ&oe=6AF49C0A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkDDjMNiE6gQ7kNvwHa18Zc&_nc_oc=AdqCv1VNSaOH8bit2pNAf1JjuMJBqJF6YgZI9pFidATz1SKDsiXW-s-nk7wYXWojpMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnJgxj6zLbInKo8povz5K-0CF11haHYg3j9RRoEKm2KQ&oe=6AF4866F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e5xwBFlICUQ7kNvwHK3AoM&_nc_oc=AdqC8NFCpU7GS2lzkkSltjy8kXc0adl5UTR5pC1y5WqxoDDrDvezEZpM_QPgDoTVKss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZmXaRrIhFSEvh9Jld1ix7MvB_kZm1a-Hp5mqjrwn-yA&oe=6AF48D9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytJWNJcEp-oQ7kNvwFwTXPN&_nc_oc=Adpl7vQ71ouP-nmbImtJbfcmJYNv5wlpP43VWXcSp-cjLBd6J9n8P3NABQxChFckRYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0byChOsyOVEZqqVmXbi16ZYUKjdu3PZnmN-GWo9Pzng&oe=6AF4A1CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qnGVfk2r6AQ7kNvwFzygi3&_nc_oc=AdqLXtSTgrUFpV322OMGjRvzqy6dIXQOZhoRYtQBKlykaKBH2WoFY-sxc_OT0tuskSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTOPMBTh1oqNjSDRP6tb6cSNhuwFcfZ7hAJlPbR6SUEA&oe=6AF4815C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
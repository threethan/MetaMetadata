Zl4Q7kNvwFhruM2&_nc_oc=Adq9l0OW8RymPhwW4ktfx1EdZoB0Mipi7mNocDTIlsmNJqE1U7WyWNasIA2ziUcRvDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmtaucnVaR32Kv1LEGWpFoqWPV4cTj3pw-g5r2F9u2hQ&oe=6AC2830A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53PREDL019QQ7kNvwHCJLAO&_nc_oc=Adq-iPRbUJ9kvJB8hLtDaxkQXlqhp6Htaz_hjh5imgewFKEU9nxOzTq93kmrJNInfKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZTvlB0_MVFziDWIZgy4QWe7hvrwn5HNi-auRb3Um-rg&oe=6AC26D6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43J0GCqyLFcQ7kNvwGXONx_&_nc_oc=Adol-PECzlCOqpM1sK2zbZSIDgZGqHGm_1YG98fcfUePSKh_RKANG5V7uLcDzOdzfY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0fdychJBYWFeWXs0F1I98OCEhBDMqwhX6QEJa0K0TZw&oe=6AC2749F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2X2GmqTVJYkQ7kNvwHN759U&_nc_oc=Adr5L4ACn7rh_zf4X26kjSUIlAuR7U1JlDgdL9o9wkJ0letrRP4tEYx1E4P2UxMexw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3Tdpfx6xga0yn-Bw749b0-T9ZXrIl0dmc5WIc9OVmqg&oe=6AC2508A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmHMPFAqHsUQ7kNvwEevg8d&_nc_oc=AdoBCazV19YF2hJI46DKpu1crcMf-qsX8j2qE1JBImVYooZkcqL4NOgXJ0IgR_8wQes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHJxkKazIX0-QVvkB8_dfp8Pfux_g_A0hF8Qt-QmbG9Q&oe=6AC2685C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
hc8Q7kNvwEQxcZb&_nc_oc=AdpVu8SHNQ3EelUsvtkLzPsdUanwPbaalBvzhPS75IiKjtd59gQ-_uGRNZzWMPuwtTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN43a0flB7lUDejvspbkwcBJeRGSdus2NCd7WmcO851LQ&oe=6ADDFA4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-_LBc4bhKkQ7kNvwGpTPbK&_nc_oc=AdpuTFXTQEdE8OWXXWDNyu5qjqfHs6Wy2DoPHpWGECU7R6yMGEVJuc8JRK7fQg2XFQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS1SG3JO9o-kzI50qPjP_ZWj6Eua6lsKiWQaTY3qby5g&oe=6ADE1CEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLfD3A2IPsIQ7kNvwFhX6or&_nc_oc=AdrGAXbEjm70RjpYY1YB_5N_OIY5RkpXFsPYjZkz5EeOGBzhxzgoDwXKbxraOedz_1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEogqYeFUnU0cTGG5J9UKYE2fNk12MtHNX1efhKcdLcA&oe=6ADE241F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZb_VAOLOCgQ7kNvwEzwQ1f&_nc_oc=AdrXxRP-Oyi4nPsIMzeVGYiB6kajNL5zgJWPXGVfSpqxDpIdXlYoXCICGOFcLeXpqlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRMZI7Nf4rA9DtWmMCKvyytgaLcwKoVAmsxi-kGI7q1w&oe=6ADE000A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N58vofhHUvsQ7kNvwFD6NTQ&_nc_oc=AdogfR_9MUhyLZhUm7UsgjoTs8kmIv5CyMOJKfLCxO_oiVfQoflh67pGVtDKQv6moZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFLPG0Q6lERMGGqF-fIGgP9MI2hyfPtNwT3zJ56Iw7MQ&oe=6ADE17DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
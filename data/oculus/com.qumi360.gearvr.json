ffYQ7kNvwG2f6bc&_nc_oc=AdqS9_KNAjouBzcjlWS7G2AOUV1CxD_U_F1kLGE91H_bop1SWFlb3clRSgiA6lFkMEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8magNVLyygI3zqH35ltY4juxNwswGrxJ7AYA8BYCToqQ&oe=6A35728A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfYBtgCKDnIQ7kNvwH7PlQb&_nc_oc=AdopTUf7yqIfHFgl36ARzJg41WuqcDXVPe_MvnfXKjbBZTmc5M_EE0LrHzCcwUrbBHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95OSRYZpSb3w3k42DBXDTfLaFGIleJ5UsbAvWvcPNOCA&oe=6A355CEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w33K6eTv0z4Q7kNvwFFjRva&_nc_oc=AdomLROTZFhNj1dh01AqqXhUlhaNi_QLzMKls1HwdwvpvVxvm10TkroFCHMUo03GYTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SYSRsU4Ob0jz7w5_O6y1itqGdddZUxSeR07jRUfpuBw&oe=6A35641F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoAzPQfOKgAQ7kNvwHo4S1i&_nc_oc=AdqjUj5L8xPJAcdoK9ov3-X55V9ZBSCcim0QK_vF0B3owmRtzzRUHZiZfdxUGxkL71A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-utw7kpBiB9_2TJhLsYlrOsU7XCpTEQfAc9_CXb2HFxQ&oe=6A35400A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7PTcnlQZ_YQ7kNvwHZZMrx&_nc_oc=AdqRPp-1fxVcBdtDtEWYhv0wpTGzwLvnGeEB7eF_oijdRIOvzIgEWZoZxkNqRP4weRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mPu7mNl8drcIF5S6peL0uhroxQhS9MA3X7po01qndiw&oe=6A3557DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
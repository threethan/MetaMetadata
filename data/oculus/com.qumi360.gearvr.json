Iag6zFjt4Q7kNvwFJ4SDf&_nc_oc=AdqT0CJSbXnDcyGsL3unTCQnzqRSxAJ-n23xHtfwyOU8uZAwb6YYthKmhnsZUC4g1qQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OahULud3ef2G1YZqnc9tb0JjPHoHqO0VlIAU65zexBg&oe=6A392ECA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDzAZ5nyyr8Q7kNvwHFhlVS&_nc_oc=AdpEnJYd8NVv5RkXZtcm22Dmf2U1eFL3dkYmR-TXABnXaePBAbF8yC4Rw4YCmhoneHw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WBtlaNJQe_CsZYVZgaQNXW9CQnu1rzVVv-cbHi8zbyw&oe=6A39516F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ecdz90nU1EQ7kNvwFaMHAv&_nc_oc=AdpmSOnrcn2T7xZ6apVx8B9pYPQ1khsyc_krtvykBPr34MuJEjVy7Byrqa8NF--vJVs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JCaQ3Ld8osyf-EunVQF_aArZajT_lJZwNf0pssesZlQ&oe=6A39589F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUDCBvhV2fQQ7kNvwHxSS1c&_nc_oc=AdoCuO165GRwmx-IRkb53ryhskoDL9VWw-_xpmm5liNrnJ5rjMYJ8YkZ-m_Vhhxte6o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jp6ieKqS16N6ii3UgfXe5ozWS4knzS38lVCPxvOh8JA&oe=6A39348A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4F25UwTx-MQ7kNvwEGRvQW&_nc_oc=AdrYy7adP_WBpM0DHbPz65b1QfKKQy7smY3rGUHnRGKutNMnyLv4VbzeHBX5hWlBUvk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KxTI8zg5SXjN2HI6zWVbolI45_Ye7oSmpGgjYTAdAqg&oe=6A394C5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover
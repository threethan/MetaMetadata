9y8Q7kNvwG5_BnT&_nc_oc=AdoAvFBwbVOq1jRBk94pxtWO_Je73PGJNBmvUZG0OFt3xfpEOLqmuECX9WBayd0ll8Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-ju0U9W0pw_3X5YCjLItsHcHMyT_RYQ38aJeOQoaLrw&oe=6AA003CA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzEnxvSXjNkQ7kNvwEruyrj&_nc_oc=AdpXNr4AU017YG-rqgmWwJY4Y6qFwfpyIQResHHvWy7b2FQ8ZY2ylRsnxg9AkT-ZF5E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbRWOn2Z1AuxnfLB3OPY0x6R-TgfH6Z8E1mRjUvTpVhw&oe=6AA0266F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19Kbrcyk1E4Q7kNvwHGkR3d&_nc_oc=AdoNrzg0WbP9rX-VPV6GU3JbLnqcUEy_Kf6DgtyF43CeJioK2eueI_gXOij4DJDXVMQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICujj2UtGt_4m5s4fs15epe4QdJ3bgWaV0B4Jxr3_HUg&oe=6AA02D9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsra-A6NWiUQ7kNvwHmzlmC&_nc_oc=AdoM0MmxrFrOAHSt4hmxNT_1yvg9gxdy72hp-_84QhwG9RuP38QLjPArPF3c7YNY0Tk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKitt0ruh-nO5JAT_Y5rhcLO5Z7448G5S9S0pGq57X-xA&oe=6AA0098A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QerFb6xvdSUQ7kNvwHOGSWe&_nc_oc=AdrQqvj0rxvjGziixdYfUG8se-L7Fbp1fZRUdfxWtj_GflsL2tDraOWx9EJXmsGxQFE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyE3jg8TSupkr1wlgy0Pfqx6nvcGLgVcO99x8nBwfx9g&oe=6AA0215C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
vI0Q7kNvwHtt8kY&_nc_oc=Adq6Wryq-7HxkL4PyWeuSADn5073zt7EjgAppUlOv5kxL-L_CUmMn_zdra0y8fCFP7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlNGq9-azX5P2w91VDhbDZfO3dGfoYae_E4uXzpMABXg&oe=6AE76D0A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4p5J5o7GibsQ7kNvwGcDo7_&_nc_oc=AdrvH9d-IDe_6kWulQXSV19wgkb0LCVz-NHZb77iKwixitwiweX4VPyJVlacBvAlL8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ5m1RXiY8AXXyN8iPhWgzv8YSkOluFWsm-V-NaXiVdA&oe=6AE7576F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNPrjpXN54oQ7kNvwERnlkH&_nc_oc=Adp6PZtof-7qQCJWa4SdbEjuqXBKpFHTAQG1oUirDucYh9r7JMeoZzhIuzINNviFslk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSom4F7R9B8O-2FApPHmHbYTZwDf1ze2dUHU1a7H93KOA&oe=6AE75E9F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw37yLCxeqkQ7kNvwG3EK-m&_nc_oc=Ado0ef9ifXvh8Vf1MTcqWW6g1nLiY6pW7h6UnDyXa6oNoHx5VUrS6ssRWo5fKftzGa4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSngqlLBTOxsZa1Pv3CQSChRcL-cdGbJjPhb2WQQ9GPog&oe=6AE73A8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDLqnQn7XZEQ7kNvwGqmOnH&_nc_oc=AdpMI8XjQ0ssPiFQzUCFNLGV6e2gg5CqOhW2pRFIraqRHc8Iv6XWZybUJrc4APDhPhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTwYEwNpeIiKxMSVDInPsAvDv8Zb2HTC6JVsuBoPa8zw&oe=6AE7525C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
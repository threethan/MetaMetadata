g_IQ7kNvwElGY9W&_nc_oc=AdqWvNFgizz2ut45RWi3ojm1LSl_xaenc_7YSBnkh8vMDBKQmYFkTgvn19eSRPQ9gvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuaKpNjz5AuXwS57rojWwhP4IHp8l_h3vFlpmnwzgODg&oe=6A523B4A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c7ttV3hv6oQ7kNvwGboE6m&_nc_oc=AdoVlWGrFKN71u_-EOin9cDzxzrErQP5rCxqa8xRF2EKUiWh5gU5FdSToqM86eDWRSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd7_7OhfaccX0cd0PY6p8E16YXLlnuIAx5EV7anwFsFw&oe=6A525DEF"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWeKkfziUmkQ7kNvwEmevhZ&_nc_oc=AdrwzyQOtH_FegldINxFATG-Ti5NhfC1YL97QeeDO2A7mNG9Dq6pdaGSzdAsLSOBuyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUZi_84u9wkNQe83Za4WZzSfxA5KESU3n5TlOkWdzKBA&oe=6A52651F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U31mzJKyeDEQ7kNvwGdWj7I&_nc_oc=AdqhA3eLk6xqvVdC52caIwG0-ANxqPCWT2oRhFvneCWNGoe6z_xXHjNFIS5gcQ_ypzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD69Fl5GiSJsTHWd6ugRZRhn2MkiGv7ifI3SLHrxjHs_g&oe=6A52410A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bAR3WtUVLYQ7kNvwFCQOCQ&_nc_oc=AdqYbaOVTJr2-J3WTU8Qil7LbyDZ4xUK_RGzY1IaHEWeWaG-4FX4C5s-fdC17VKJaw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnJF-YQFwP5b_IEE3MPmPCYRTx4ZhWzBX0TwPWS85omw&oe=6A5258DC"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
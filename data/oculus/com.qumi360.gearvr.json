7yEQ7kNvwERVqbJ&_nc_oc=AdoVVZFNRO8734fE5N2ug1u3xYlt-kHIJwHLczCo1rhJKxAVYcvSkFiLyZcv72zR4w4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUH88v3KZLGMDOO3dBDZi9J0cuMioJSiZZlz3afkJMyA&oe=6ACFB20A"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2vFQbHd-dAQ7kNvwEURCb1&_nc_oc=Ado0kf_4DW5e6T98W-6QoS3zYli5HAfUetVDbjqOhtTSPO66DGSDvZP3LvFq5PZnCcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0JzaqUSk_GRl67IHhT3jzOhIfaQ4EotT0-AdiDePDZA&oe=6ACF9C6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nKcav6fhccQ7kNvwFmpwRg&_nc_oc=AdoedvvEFUJSOcmd40eLPoQGjBD6xI2H6lPiM430jG0qMkNsaZmBAiPTxbGSmIcbQys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSFucdo8DdOMe_8jiBZeVBK2cpEsgLj9t_bxhSmlktQw&oe=6ACFA39F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xzoOpGmCicQ7kNvwGIl3t_&_nc_oc=Adq3ycyH21Ytahzca0ESkNPTWdRB2Fc66gMjlyIRdKFgfzisE61pY146YDrJJ6ji-bY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe55LDmFJF2Lk-VMzDiVDOrpzT_jWeFv5tiPceOLlQmQ&oe=6ACFB7CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUIsYmn9BdsQ7kNvwF7nhtj&_nc_oc=Adq6JBWPbKzX1e6iSnSjBA1XvaVolbgQ9qlirsWtNHV4Z-GA2tsbDsxWj4EprrsFv7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxTmbgoCflC1CcefJkgzWMLB2pyXZV5-fX_J8W3KX29w&oe=6ACF975C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
2VMQ7kNvwFKEx7r&_nc_oc=AdpSrLpi5XueAfow2wNJu2LjjVg_knK3FeISbkIk39gxzRFu-ttBec2fsbTpkZHsEnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKffhcm7FqdpXjOMwCQuBqs-_dGhxkrrhhHrsPP8Ho0hw&oe=6AA7ECCA"}, {"file_name": "migrated_image.png", "id": "198509431441637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_511977779166716_381785213514022912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qUEJi_qlrcQ7kNvwG0M0V6&_nc_oc=AdpMZQabU4NZf_SHVRoFIro9DgV7mkljH5hOpaSdOxM3fN2Gxk3Kp1uwBMkfyOjR0zw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInSB3_4GlfoKwQ02KgXqaEtSy8xJvBzBS1K1lOC2Fwdg&oe=6AA80F6F"}, {"file_name": "migrated_image.png", "id": "197013614925419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_376221542826903_1706117591593910272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IlDne6iTzgQ7kNvwFhIDwC&_nc_oc=Adrtcba7vmKix_XyfjZ-CIlUr3hhKnAnZxe4OB_FoH5DpGnYxLeqrf6n9bLMfhZXOhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB6BFa514br-xj5Iv59W6yrUh49I371qXxDqWhV5KpkQ&oe=6AA8169F"}, {"file_name": "migrated_image.png", "id": "223747865675996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_388763141555285_5751901476469342208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyJthJN-Hi0Q7kNvwGVkA-m&_nc_oc=Adoe2C8uaa52M89GBaMGptktq2GeHdaejee-T0ZPQxF7RwidXl8QG99F6gFBde0ccgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK19WfJMHnF-MxVlmMXNl38sZKHVwfrHK9Ai8G3TKxqGA&oe=6AA7F28A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "187950721757858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_187950725091191_6031670350436106240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN_avwkbHEIQ7kNvwH4JERo&_nc_oc=AdpTh0UzUSOjCtQ6xdWsfNd1v6yFtB4gw93zv3wXn6LJYZgIwBALGE7Jnxr5dw6LKCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJELhUZHBpwvXhm8VlAO9NvxULoGgqPM5hyn5j6Gy41yw&oe=6AA80A5C"}, "display_name": "Qumi Qumi", "keywords": ["qumiqumi", "qumi"], "long_description": "Let\u2019s say you have a great video content and people love it. After they watched your film, animation or TV series, they probably gone forever.\n\nWe invent the whole new way to engage with the audience again and again with our Seriogal\u2122 technology.\n\nUsing our VR video platform, you can add various scenario developmemts, Easter Eggs, loops and make seamless shifts from one scenario branch to another.\n\nIn our demo you can see how Qumi Qumi heroes make their choice where to go: one goes to one portal and the second one to another. Where your character will go? It totally depends on where the user, the consumer of the VR video is watching. Using our VR video editor you can create your own multi-scenario videos with different types of the choice. And moreover, you automatically get the app for it! Later you can add new scenarios and developments and your audience will get back to the content again and again!", "short_description": "Qumi-Qumi Animation"}]}, "developer_name": null, "developer_privacy_policy_url": "http://qumiqumi.com/", "developer_terms_of_service_url": "https://toonbox.studio/", "publisher_name": "Toonbox (Cyprus) Ltd.", "support_website_url": null, "website_url": "http://qumiqumi.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336664160133253"}, "review_messages": []}]}, "cover_square_imag
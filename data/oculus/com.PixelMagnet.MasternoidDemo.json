08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ2kjtDt5G4Q7kNvwFtVB0M&_nc_oc=Adljn_Vaa3dQnM-sSXUi4a6I6imkXMbsC9s8k1yG8k84b_kFqiMxRihpI-BwOTJHuwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvvfPo-uBhR0WEp_kOGo8ElSUbW5eq9KV6t-ZIkblSasQ&oe=6999B788"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXnqwgg3YEIQ7kNvwEVwuB7&_nc_oc=AdmCQbdzmvcWHmHtJnbUIn4IXS_g1p-vDlKHGEqVsHTNvq2CUfG9ckblBa7rE541NAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvocbjh5O3LhSUlz-axvHHlOLL_bQ9laG643x9p4KaGKg&oe=6999C1B9"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWj9oK9nhgYQ7kNvwHKjzgI&_nc_oc=Admx8KVQPhrFkRcXbL8NRMHWwnFIBNipxXCLsEgLNjYhWqQr-6zLbWctzZXTHQ0sM5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvc2rTA-D6SgEJkyqB3OBtlFyZL7v4tKiqyF9CfGyBOtA&oe=6999BD74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPr_8QqsoOEQ7kNvwHEyG2M&_nc_oc=AdlG4zB3aNtBbOg1ulnAc92Z_UKuZjGsAtWdE91tjVKHdGY0oDKYc0PxrccoXzlWnzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNQg5KPKH1eKWR19xPH6TTS2mup3NZqsbPSLIW4NH0GQ&oe=6999C48D"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYtSNPGv8DgQ7kNvwGawTyD&_nc_oc=Adka27Paq7cJeRVQl-zabak7TIBOife7gyLug8svP8TR25DsApIR90_J7SLAQj6ji_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugrPVsrtZvshhqeIyaL8b2dFj3Xt5Pnfkdwqi8EMd7hw&oe=6999BCD5"}, "is_concept": false, "is_test
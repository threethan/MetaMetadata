08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wwgZ0OiY5sQ7kNvwE-gP0F&_nc_oc=AdqxQNLbZkygyW-odEn9Hp6WuTb2YHkLM89zCFtorVZ4s3hCrBdKHCryvQltJqz1pRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0lOt3RqYnluyrwh2ERqrcpwTnJetvwbpIGI5G4GIDzFw&oe=69F0BA88"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUhzinOhDo0Q7kNvwEHzVVL&_nc_oc=AdosCQVNwollNMuEjHF9ifm5jrZtdMu3T_IbG9m3ZTRlr9MjYay1k5-hJTzZHvQxnV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0TijGBrYoY8oOFFDxv07NVIYN3PnpJbI8iJb0I58h8HA&oe=69F0C4B9"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYYuc6Qd0LsQ7kNvwGsqHzb&_nc_oc=Adogiqvcmu40KkL6YCEUDbAZ7v45qlN2SiFfhQmXXjk1RvYMsOg76G3uJQdkiejiptw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1YCYT8vOEtCgDx6N8Zkyks81Pu0flPwzFRdGV0ztPx9Q&oe=69F0C074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFB896w68-8Q7kNvwF61emg&_nc_oc=AdoGtDQo7vS1Wu8Tb6ddZ1cH7i5rve5KX3P2Yv7Akau97R4iZL7AttjqYb8waqYsHAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1rls0CRUMJpEj2InOiwu5G36Qd5PzONdEqeU8xdBIM3Q&oe=69F0C78D"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4PFaAMEHI4Q7kNvwHFKE48&_nc_oc=AdqhD6OSL2-0g6uNCOhgka0yElUEMn4j6cgKu9c-eaMCDNixhUCvFJ_2d_sXiay_wvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0W3zwVDoEwZts0UlTVXt_BYzaUlbxd0oC6Iw5fldeOBg&oe=69F0BFD5"}, "is_concept": false, "is_test
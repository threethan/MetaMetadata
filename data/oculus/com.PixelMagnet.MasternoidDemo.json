08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb5vMXJt9DkQ7kNvwGFcJ-h&_nc_oc=AdkQl3EbdqMqkbQeQJGsZ3k_bl1rJpQAHX1e1aUc1GQhlVupWbK59snxwW2MQTKY9-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftoMKrNEywc-ujNc8Ah4c1zGHgmLX-RxAsUjkR0HqiKZA&oe=69986608"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXnqwgg3YEIQ7kNvwFNl6if&_nc_oc=AdmyB-dgpBUjZWzHrvIOn4UyTGXAxmrZ_CebZ0exqjyo2NyreMWYJYFKXOP5RnRc8Mw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvGYxW14bYwQCg-eWbm-8rj9U0SAfqMGxBFf_Hce8eDPA&oe=69987039"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao8-AdEf-YUQ7kNvwHs6n1T&_nc_oc=AdlbuSaqW2fVfitF1sz0ZtFbrr0-55Ts5AcXRkUyok9CFROSBgDYkHNLETD2uPZEtgw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsRh8irMBemQ78vxU9SsLQtpFr5DcXFUgV9fFheOz5GJA&oe=69986BF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPr_8QqsoOEQ7kNvwFS9FRm&_nc_oc=AdmKWm3pKsWX42NHgg4kD-m8MQZZMI-eGoQjcmhjgtiDMxNfETTfX1hnjE8tUWJI11s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftYuoYClJp0IdaRG80cojPQGZfMHTeOHpnX-RDeGsw3ZA&oe=69983ACD"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuPIRK30pGsQ7kNvwFOdeTQ&_nc_oc=AdlYFU5E-5ZK5oiPBRFZFTshLRaD_LPZsFxAYSChv73AapzBgcnzG6XmFhlG_U15ZWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft0Y8ScB9Eoy09TncSuXFmtl-sg_Z5YFUgAhlT7ggjNFg&oe=69986B55"}, "is_concept": false, "is_test
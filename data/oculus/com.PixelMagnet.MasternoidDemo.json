08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SULIIyHbx6kQ7kNvwHZwfar&_nc_oc=AdmjztvALxOsfiRwMVDD8V9vOstClwQmW19wxvJV1RRFrKwrgW9pENg82IbUBv9BFIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvwhZTkP_gwFIw3Yx7cyzSl9-eTvRe0sVzc2verXUmsJg&oe=699EFD88"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODLhyfH7xWIQ7kNvwFjXSC4&_nc_oc=Adm-teEmfPsTGxeSnTist-qUcRrIYdxytKLS1lgmgE7aAAiPnH2liIxYVAj3z6xrW08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs93kMXs25dvW9PCvYi9EMXK8LLjeLPIs79JSgKn9AgdQ&oe=699ECF79"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSR0xWV1f7IQ7kNvwGySBqE&_nc_oc=AdnItg09kDXCFn9QOZyLDEcfPWZaL_q_aIgAIke8uKZ95qKofkKkYJ3hc2MUo5TOJ2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvEJhvMkKjcM-Z5d2z7zfxxxdYDyJl0bJ21jJmJn6e8PA&oe=699F0374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlKZvp6KMYsQ7kNvwEDC4PI&_nc_oc=AdnfK-9ETFnS-RUYfaOVVen98ChseP_qW7XDd4QtV8YvGmTD5sYMJtDa7lulJqk4G3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvkTQgHg1nVAVADpWom_zTHK4Wi9wYIUuCYmiVSOe9uCw&oe=699ED24D"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g39wjh_tv3IQ7kNvwFILNho&_nc_oc=AdnBDdS5mjkL3HDWYPmOe3V1rqp0LF0Sv0hzBzn-N7Vr1naZGe0cmqnMQkWDX6oGZ90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftyp24tbtFVyVN_TWv_xvxC5j7BwRpBQC1zfRqdZLRC7w&oe=699F02D5"}, "is_concept": false, "is_test
08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SULIIyHbx6kQ7kNvwGS5tVu&_nc_oc=AdkfjfT3TCxqivWPXP0t_BK1P95AYXvq5QX8tYDphh6txCzq85l5Lmz5RgSBowyFOhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuORXQriZlgNkgCYq-adRAY57WvfDvakpj3e_QD0uifLw&oe=699DAC08"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODLhyfH7xWIQ7kNvwFtq6rC&_nc_oc=AdlzWb3gecIPH6-MH_ENDxxsvKNmzGjAIyoH91YVTqYSNOw9uPVliDrnULtew0PeEPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvbkb9i9a7IGm6R4S_ufiuH41eRaLaLxh99SuBvrMI43Q&oe=699DB639"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSR0xWV1f7IQ7kNvwFld7Up&_nc_oc=Adnws_ET7rfAwQuERM8Ta6bskcQrDOFInKtsSW1QXY01OIpfR1FvHxpJU_r_9_0RyFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft8ukJNrIpAVljKXR7DrwGL3Bbt-yxj_r_rN_QhX0zGCg&oe=699DB1F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAiNVoo0EgcQ7kNvwEy_d6b&_nc_oc=Adn-fnjkzuH88xGlBAB0u4Ua8FodIoIBKzrgtBRZ_JTDR3rDk1u6l24K4TbUVAxvuhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afva2BXoxVyydlGWsQtOczcPtjGv6Dw9dPSbZflQRJjv-w&oe=699D80CD"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g39wjh_tv3IQ7kNvwH6UhTX&_nc_oc=AdlCSZrZ9PBzpL1myL6xFaAYm8c_NYS7pKaVCeqrBR_d0qrQi5qPI3jJZ9uflgXMIyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzqAORjtIyFJDcCGD-qJ8oVSNFsi8wR643goOiPdCR9Q&oe=699DB155"}, "is_concept": false, "is_test
08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kShxmWO-AisQ7kNvwGvbk8k&_nc_oc=Adn6FPYSPzjSt3UQY4ML_4Zf9LGChi14iJYEf6DemOPdzTRuoukUrzY75j8OQ5WpuYo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuUrhvUKNg2GunWSVfCICp-LOdaq9HVawsOuBwe6KgGfg&oe=69A1A088"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHTsi3UXD0wQ7kNvwF7lXcq&_nc_oc=AdlBQtGvQ1aylHB6fmf5PgVN2uywD3ICafKRWcIABRJstP5QiROt0t2KR2XXlV2AOa4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfupzqCLtw1k1xrSPcHqOc3mGAF2ch_MWC1x4WGkd7wH2w&oe=69A1AAB9"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrInL8KHE7wQ7kNvwE_JF3-&_nc_oc=Adn-IWjSCQvzwr6TOsFwKcbc7RrMe6HWZCb1u76PsUZiIFco1781Tq4VXSqzptSrRKM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftnLTDz_cRCcQAHIByaQqhRf_e4ZkL27xJeVr_V4-3DSw&oe=69A1A674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlKZvp6KMYsQ7kNvwG_z5uu&_nc_oc=AdlnRl3mQvF1WiLyu8iPRksMNq9xRbJY5ocRLTr1mHLaCBVrckdBL8L24Zf3K6zMEBo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuQ1bfueSc_oJeUQI8dPnPdib1ex9_PJQyM1VsnWqj9Jw&oe=69A1754D"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zHyarvCXWsQ7kNvwElqUPs&_nc_oc=AdnVfnZPvah-M4I7SaBQgylKy1O5o8ATQXA9fmymRnHBvKaAtcapsPmTjk4nXo-BUQ0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvcIBinLDjbBYQc3ZBvMkz9p7IPySUSUd_fVdB6brHbQg&oe=69A1A5D5"}, "is_concept": false, "is_test
08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ2kjtDt5G4Q7kNvwFXAbFT&_nc_oc=AdnGDaaFncvF1ZkPiEehud_cnm8DORQDXAVTmbLH_EWZ1lteIxZ90Ov_CUrTsRayAjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1hYVu0w-rfRK3J527OgvdyzyqXq_G834eltlGEybrEg&oe=699C5A88"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODLhyfH7xWIQ7kNvwEb30H0&_nc_oc=AdkdehduCHGrylbByki8KPMkaavWiRUQ25MLiB_fFhY0lTyNjPhBdHEmAZ_mR3zC3yI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftwjft0F128wGlzaGsGGDayyQoDmJZ-M9OexUCxdjMvnQ&oe=699C64B9"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWj9oK9nhgYQ7kNvwEVOSLF&_nc_oc=AdkANn1HsDyCvBDrRAmWM3jW9--YJXCaT-WX_i8pTYk4kI7cv9MHi0hh3OSyulT-7Ks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvDAKD_FKm3W2z5gpkKeP9pybghhz3Y5LTEutcYLOEYBA&oe=699C6074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAiNVoo0EgcQ7kNvwELoOR3&_nc_oc=AdlsxHcyGtK4Z-YN3L-UHnS5YjSH3m9WIHSLiBevh2soytwseI0hwGjf0Nxd_qyN_cI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsAtIOmQxm5wkBeWSi91oVddW6omkJ3uLalNszRdub7sg&oe=699C678D"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYtSNPGv8DgQ7kNvwF53C9e&_nc_oc=Adlzdps91M2gdfUVwGvt70kaLEWekgPakBApn2iUExYjM9_2SyAP9jWeg41_RPPhwDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvzXkktjnsVa0dbiERm8j8S5RJdvOfWeCApTOQJV47Ksw&oe=699C5FD5"}, "is_concept": false, "is_test
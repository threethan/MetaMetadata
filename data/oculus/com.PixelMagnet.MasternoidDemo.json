08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xadOVexpj6oQ7kNvwEjwfkZ&_nc_oc=Adk0SYgN98DaPNRe33RS1MTLL8mC2meR_ygaEHcDztMcMQ2eMcAk4dxPiEpOUhlqGCQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv_JoVjeFqVKQtA-rSSvR3qWn4IvSY7xAhZPdY3RWfgaQ&oe=69A59508"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTpEEEsG1HkQ7kNvwFl6d8x&_nc_oc=AdlDx47Z0qHKNpN7J3Kp7piTRwUL8VkBi4S2Rtlic4itoolpBjibfqM0qjx69NSxNsA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft-L3iHRIdp2UhnaoKDUhzyCH-klAMcRDaB11X4oHpz_g&oe=69A59F39"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf30xNLre3UQ7kNvwGrcRTk&_nc_oc=AdnRJVikAqMCHncfXF--8N1qLD7uplamafuPCH08yqeY-Bof-9YOayuGdjfu0smzqzA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuCa5g1Zs7BIRqEGOzAJG3RrrNaVawt3S3kmk9Q0ijMig&oe=69A59AF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-q_fYvXXLgQ7kNvwFLnNaK&_nc_oc=AdlnQN17xIEBXWRIXQedd4G7q3Vj1nUtwQr3gLn-NcD9r5FuKUTySF9iiUTp0Qdea88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuD0KN4jogv7yWpSlgAQ7HNyuEC2XLvVIxK4OMhqpMlAQ&oe=69A569CD"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZKYBbU6ZdgQ7kNvwG4o8jb&_nc_oc=AdlHM7EJSkWFrL0Kymk6VhJV1Wk-wK3DfSTOBFYCC3F1NrLo0uzzhixCr2MHAUFdEfg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvOvuRnoKrh3XiHSRJKTCvUeVAJNr8mvvPGmi6of97nug&oe=69A59A55"}, "is_concept": false, "is_test
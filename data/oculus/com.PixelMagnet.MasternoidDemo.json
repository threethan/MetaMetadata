08_1222571455111027_1087776380802594283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kShxmWO-AisQ7kNvwEAVvMg&_nc_oc=AdnrC6AEuxIJqezHiG5lBphoMvXWLeYU5aIHUZ8zNq9FXo2Ic1mjiGccYCEdmHmFgKE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvc64bO1Kg1yDzU46irC1NR5m9XKJHv98SleX8MfPG8HQ&oe=69A44388"}, {"file_name": "04_1440.png", "id": "273942281855966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982502_273942285189299_4577256015039875222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTpEEEsG1HkQ7kNvwGwWpnW&_nc_oc=Adkd1WEiBPmO4AmVM9gu07DgqdglCBc-anqom66dSm_iIiSuoDYM15r8Yl9vYRY0l_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1sz-sQxdz8vySyamZJcJ4IzFwNsIrWygcR8dEGseD8g&oe=69A44DB9"}, {"file_name": "05_1440.png", "id": "833679878360141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_833679881693474_7615879381589095529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrInL8KHE7wQ7kNvwE_gXTj&_nc_oc=AdnVP0pig8O9PJu0I_dOQUTLRbXUJct0VBkoBzVPQFI1Fi9jGlCCp2aw10GNYjW7z_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWlrpnBINXSjBuMpkGkduDag2JWqmKQRHM0epfnVDL3Q&oe=69A44974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_v2_1440.png", "id": "984399802982158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974700_984399806315491_2965942372643824576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-q_fYvXXLgQ7kNvwEhJ7kw&_nc_oc=AdnmPnqh8Sx09kgv7oYIgMKbo2yLD6-e3Su2A-3ojauCLdpFYdcG9zEG0T-e5TYx7K0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu6wOSBOEGuAZJU_cWK8QI0RDqZ-uBILPAJk2QEA5fOIg&oe=69A4508D"}, "display_name": "Masternoid Demo", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nThe full game features 50 levels of voxel goodness and an original soundtrack that adapts to the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "590961773178223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003242_851651646019696_8626183440180356022_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zHyarvCXWsQ7kNvwHrngRM&_nc_oc=AdnWhis2kJFXHoCy-tJNbbSDXXZogzh2iU0BoFDwyefHAcfpQb7bwoAjbP3kYYkopxY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsk90BIgKqVvGm2RwGBe_Loo8rHuGZz0iZB-KYJA3Spew&oe=69A448D5"}, "is_concept": false, "is_test
h=00_AQLnGOkfK7HBOlmzR26zpxUB0monrKX9u_oEAhaVVL2SmQ&oe=6AAFD715"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeUQvu2qmfAQ7kNvwEmirs8&_nc_oc=AdqBd7Oy6gWIqNG0ui8KHlaaeMWzA6DaMMgZl09UIsaHIf1ArajseK7unipBubv4uhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH_oZk7vGxkvT3bgGREKUrF8kY7O3mJgkyW6G50LMQ6Q&oe=6AAFE936"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24N6S2SgGQQ7kNvwGSiYM1&_nc_oc=AdryNcq_CMoMVt8iiLtaLAzucDv-Cxk4s72P2k_0wxQPVeBY1Ep06MJjsAQv5OLISiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISWotNN1JVbO3Ey7LtU9NZQTWJQTXlk0wVfdWrgscY2g&oe=6AAFD97C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-xv5t34omYQ7kNvwGfRSYm&_nc_oc=Adq_1xzrGLNkXkmYOm3374BBiALzvUjz3_eKV-P3HYmRHFjcDiqg6FBWN6LkRl8p18I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBrXGEq38kg086Q5bXvVMCqqCJnQjTaYvK4NNwSHN2Sg&oe=6AAFEA19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWwNBRNH2gYQ7kNvwEMWfr4&_nc_oc=AdpAb2xPTD3mtSN5_6rr6Hl5hgnsDS56xwfAbchjW64hd7Uqn9YrEkXlV24JLkaR8Tg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw2UEqUWj7KJkpOc8q36Gtcvf19M6WCfgnIws5jrR6bg&oe=6AAFF392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Z1dZno0ZgQ7kNvwHxc2wv&_nc_oc=AdoDY9AWsHomqF3K7O-R6QrGShW8rc1CuMtWZ2U5M32zQ6wOulMXR6zoSCLA0nw8mkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBePx3rIAyM-5Lb3MxSgaOBR6aaW4yNhmXBlPCah4MpQ&oe=6AAFE793"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
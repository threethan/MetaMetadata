h=00_AQPKf9w2OWICDlCjhaWBIDecPgfbwemknZizDp90w2shzQ&oe=6AE34195"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hieh8_DL80IQ7kNvwEfw9bj&_nc_oc=AdpR6pRpdsSGDqa6Y49NGi7hcCjYdCoe9zZOkPKcaY-aa13MbryzoRU4YMSW37nfOCc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3oYxjBrQzrqUuetzdcI91wNNRAC2gVfu99gYyA0lfQw&oe=6AE353B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yEsX7NvX8gQ7kNvwH3zQhw&_nc_oc=Adoor2XsPwD3_i84WGpBLQZEdGIOfa7xXir9GRFgyUers0pAuyswAKGXqnavdws0dig&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhTRaAE18MERKIWDVKWe5x-EHjp-OgQ7D4RAbWyo2-Xw&oe=6AE343FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbS_0nG6OeQQ7kNvwGIbXb2&_nc_oc=AdrhuNpNrBIEcPPEC5By9TizfYdK3MSPTl_8BQ1HobK2x88xXz0aQ87Y4g_s1vchCr8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHc97ccjFYo-kMRG9g4Xo5kNebllkJM11Rz-fMuXnxDA&oe=6AE35499"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldcYkWQSzqEQ7kNvwGcqGCi&_nc_oc=Adp7FqQmWIDX0l2XBx6UgSk3UYXHF94cfFaStLB8jQTGBJqobXapaKxWj8xFGScd4Lg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-4pZPqu4c_yIOcwFjQLc7kjLkpTJdBgEBfu10qFKf5A&oe=6AE35E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHwsJSn65Y4Q7kNvwH8Nm9P&_nc_oc=Ado0lfapJFQEM9yq3SzUot0KmBS4bBQnRTz0SbRlTkk716lZQXtymK9IJzlUpgADJRE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2udmkkoBOk4eVXPVIhuHyTDQifKKEGRLJUKMYqX3d1w&oe=6AE35213"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
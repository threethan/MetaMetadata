9ZuSszsPe1eGccX1_dmFwIIBfk_EHqx4FzQDljsjNrbjiRFMbYxaKCFEnV-pLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EeG0onVDtVRTIQ1Na8hHKQ3UmWOKNhuvH85DMDJq1ww&oe=6A297036"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLLi1Sp0IiwQ7kNvwH0vK_o&_nc_oc=AdqQfVPbsnF-lL4ORNq5RmM8cIS5jPyiHA8frD2WEQjJ5NRNLXW3qwxC_I5sNfI5ZAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81TuUjFUwHged6Pw0KWv26MqSkvQ48LUvvC2cu26GlUQ&oe=6A29607C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IeT01WuC58Q7kNvwE4isVC&_nc_oc=Adq7qxwjUGh9RhT8KjBkunXO2fAVX3J8CYq5-NuqktHpFc7GISwPPqAVSFlMm-BCGgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4VgcnB72SFjxQjdnOjLdD7VQLFLQ1SRxG_NjT9T2H7A&oe=6A297119"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj_Zpl4ffwAQ7kNvwEQIMia&_nc_oc=Adq4v5lkM1EiPJHOz3X5Pjb7WRjPWMijo_nBjPJPl74rEMp32n3pwOfk190pSYRy_nY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_jjks7Fz6kjrSniadiA_B5cEX1-EmzO0p9Bht7L9RHw&oe=6A297A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At5eyHPsVIIQ7kNvwG6ifqW&_nc_oc=AdrjmqDlKX9iVb6lLRoTZFatikWZeZZMQh19U95_RNuqsIyAIQ9yasu4rDDkt2sPZqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--j0qlCzy-9Om600gO9qmlTEiGh7T0rdHkti6KSl_uNQ&oe=6A296E93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_
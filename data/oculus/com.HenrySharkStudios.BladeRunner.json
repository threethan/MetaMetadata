"https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT6-WAxieGgQ7kNvwGubszU&_nc_oc=AdqpDXm7nrTIxeGN-xk_NHDvPevTBEgPxDebEZ7kqmHEUI_3Rk9-2bOIPqy4XFEwlzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_qhRj01aRF4zvL9-7U7da_4zoUiO3I7Xo5ZOZxt1PJQ&oe=6A7C4676"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ObM4GCH_fUQ7kNvwGMWpHL&_nc_oc=AdrnMheHeYNSYjx0UX5I2eP1WGnYdjesM8dyth122rlH0SVtEtUD1O_pyMeFE33R7-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh_wHI1xHOoyAagIJ0Qtm1H-he1FsimLwl0CX8aYEj4g&oe=6A7C6EFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ2vFhoEf-EQ7kNvwGHaEDl&_nc_oc=Adr3lftto5YXOD7iSnfyLaJLXjvGOzccTgJtj42Em6bY-xhMvo4QbMZD3mZu_6u0SCU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuxRZbzfQZVrSGQMrJvr9tQ_kz_nEJ6DRRcQ6he1j6iA&oe=6A7C4759"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYqFnsPMhz0Q7kNvwGhCROu&_nc_oc=AdpVsp-b2P4GQHI8b1XI8aFRY9uf3-QvNSQK17y2bhXGw6lSZ7IqN9tRWfS-OeXo308&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXytKGn1oInQbAQjvaKnFTNqq6Z5k5Oo7ImxqUFlx5UA&oe=6A7C50D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A8zcaK521EQ7kNvwGjYSGn&_nc_oc=AdqASn9LFejYGAw847sgXO0rWJCobAJEQKRHR50Fdi1t787fPmkQO8BLKF7DvovwdNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVS1OTBAWfFTnMi5mPt6zs5Kpbi8I7w2WAO968GeyM5w&oe=6A7C7D13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2Wiv4NJ6XwQ7kNvwEktRV0&_nc_oc=AdqELjdZ3B7vdbZDXZaAMwAUWDZl6-6t0GzqvbAyiXuhkVTKJSkZmIqXBe_fWEZ6bcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CERQGfdG2xReQYNkiaOql-LGq1XhiWBq4khOb-pw1BA&oe=6A257BB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shwlwvcdeQ8Q7kNvwFbBMHs&_nc_oc=Adqn3SEcYopI8RwHgS_IOsNNYH53lIzsKcgLhf-oiKgSrcCffeJnKZ1i8Gf8sakPLC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CXmEN0fDXEUrqw-vSjBiV4cgUBBZ1gRksA3GAjO57ww&oe=6A25A43C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc_YnOlm6eMQ7kNvwHBRDxw&_nc_oc=AdpeRC-AyCnkHLowwwuyl0rxxQPC3Jakz2IIj2XTAqw2bEp7k9RTd3ZOBDp1zvle12E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99MQLENlakoLPltuV4cq7XGLpstvtfnjd_yLsBv3BA1Q&oe=6A257C99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDdmVAY9DAwQ7kNvwG_9VjC&_nc_oc=AdrubnoGDGkdlWHMh-WFJY29kGQsqngjMO3m4q5ne53LiIK9C6lAgVW2Z6_6hUa_TkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4PSgfBV57TVpJJJPs6atXbYnnhGjMhN_yfPmdf9Nzeg&oe=6A258612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPjG1YMnwUgQ7kNvwHbL1lH&_nc_oc=Ado35bpNwb8LF5sXf-EJ6wpU24qgblGteEzJB77JSaMRosJipK1d_nQm6H09G0EMgpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OTdC8uIBQABC7g1WAYJo_ZRmFsSl-_e3y8l912xcPEA&oe=6A257A13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSRfvbMUaOEQ7kNvwE6JaZp&_nc_oc=Adoz9IhS7-yCR2h-sD6Nw-wXPVQolzl5VChgRhFLvltbAOfDZ66ccRRHMZVrcrwHjEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hc9OPtd7Y8XiqgEj-9jw8NudJ_lpVf7yEC9A4kXh41g&oe=6A184CB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnhRTIfob0MQ7kNvwGmzs-l&_nc_oc=Ado7ON0xZMCWyvnIrf0InzDkN00CWqB0T-3VTMpY5QxyhZFEpiRe35k4DBoq8CXFQR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t3DJZNnf0JaZjoP_Vc8yiEyIPDiCu6qvRAo9wfpvquQ&oe=6A183CFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lak1ZMoptkQ7kNvwHhxeD1&_nc_oc=AdqsI2jQHp49_BUjwZohr8mGdwxLAQmDm_6WAHCAHZARLos_r4p40xJHJ7gfZ9mpANE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dtOJQn_uhIYeTSnf6K2BQCU2cIzxnyMY_FBvTLJrdiQ&oe=6A184D99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3S2YGcAwBEQ7kNvwG1we14&_nc_oc=Adqhv7JYJI2O9ErFSCuvuU3Ifb1J8o0aVA9iiGUItoYONrqGTf5Zwt05edvT3DWIsX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TKTf4RvKg0m2hh6iveRfsDy1MKbJF5kfZMAIWAOItRg&oe=6A185712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RcVX7aNUNwQ7kNvwEusiDD&_nc_oc=AdpZVrz8oGBKhPQWOM1pZAR8xzFS5OLbw2PPE7kVjgNPYziK4upWs_GA0S_-D0v3zL0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BDv9Jb8pmLPpVJ9Q0-hrbgmNRpoQK511m8Dm5MdHeeg&oe=6A184B13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
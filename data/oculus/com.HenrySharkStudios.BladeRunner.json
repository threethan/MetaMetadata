05&_nc_oc=AdqeyFF9AKuFSI4koAa9Ig3SmB3-X75_hM9ly6a6182XshH2JFJbjK-twMtmvRlDPIg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U8vFewiqP6nawQzWEA0qCc9RLwGXPxEfbGbA3HwBNYQ&oe=6A369F36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM7gqs9a9BYQ7kNvwH06CQo&_nc_oc=AdogBnDWgKGX3YrCXaQygax0EdGxbuVwGJAFc9QppgGawFkynX93vnQcJs9r1ptZ0OI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MXoAez57IA78gmlCzmcguG2b6L0hIebMCLDDtqGhtzw&oe=6A368F7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNyz1vm8Y9YQ7kNvwHli1PY&_nc_oc=Adoz_iuyGfgBbj14f8FObTtufi6b5hSTjnSyRqTo_nYvo4ydrrn8UKuzt9s9vxT6P2A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iGNvNGufiYcdZg2dMyJf_B9lyvJbTtf9YnE0VS55llA&oe=6A36A019"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXkUuzbgH98Q7kNvwEdferz&_nc_oc=Adol1EUoFmihtUy7CsmDBGolZESZl2DH7WdWHNX1otVXDYZcFfGQvsPGz_DJMC44bsM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CghXImAIr1gALKIs8fJ9_RjH6I9ChC-ZXoaG_IAGwaQ&oe=6A36A992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBAVKood9YMQ7kNvwEmH229&_nc_oc=Adql5jJh48hlUre_OUNBbCFO9ryQ1pSzp9VFdw5yanTqe85kS3geYzEGdxMFJQrxBus&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6RnoicQxeqP11Z0CEMHIgQYOgeTnNL3GNPClCpEg9mA&oe=6A369D93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "inte
h=00_AQLm26H2SUlRGcYLTGSN8_0gWMgSXNB8rhyGycil7kZTzg&oe=6AB27A15"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeUQvu2qmfAQ7kNvwEu5Ki5&_nc_oc=AdpYiDBcGwDWxIcQxnsfKbeZQdxKJmGbcAEsyjgJNi_yCSbKgzQ54dCQKffWbpn_4-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgYJKNp3eGvlwhGZUNYfQpWoxB5Q3_en1zifBsNS11fw&oe=6AB28C36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24N6S2SgGQQ7kNvwHNQ_yu&_nc_oc=AdohE7nwvPlb1N2ofT2hVD4ivg1-E4b426XDG1Eff8M9YOGHWc8kgBAVo_keHmdjn7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmRDexbNGs4_17PcgqP-wvrnxuj6zKpVCeHTvmZ-DSLg&oe=6AB27C7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kVLp31FnQQQ7kNvwFCDFtW&_nc_oc=AdpNXbHfh9tojoFblQRnyvdz08OW22boZepDPe-eLaMkmpC9PfFO9n6Xrz0GrQW2bj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiF5Ja9EnLX8L-KKtoRKac6HSweVCGI1qTqiRLYJcprw&oe=6AB28D19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTIpgnp2MIoQ7kNvwH1J0Xx&_nc_oc=AdqzvkCVygngBKT6h1FrrXBrl02m55OX21H8lcetKH-06k-i2unmvJVAKYx46mrsbZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9W3iaDv0hFIRYInvXEyjl-grTmCmQo4vyFs-Caz1zxQ&oe=6AB29692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsjc7h9PdOQQ7kNvwFgn0xG&_nc_oc=AdpJ56D9XcqpBs2tF3PzELokV0soYxWyA2mONETLf523057Y4fdw3CwY9LVYD_SAADI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvGeV3haWjt1H4pIz1spBF1Nzyj1DmkOnwkHqvPItwzA&oe=6AB28A93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
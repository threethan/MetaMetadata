https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWJ0TAarloQQ7kNvwHE6IG6&_nc_oc=AdqD6eVMoDzqa8iu8-SMPFKHrHpKu7dtNYBA7OfVMOUG2v_-A8xAOSEBZNHixiHitIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz16i4TP-WmCcuMCRG8Lw4ksx_nU6tgiKDOLRhPshVbsw&oe=69C932B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WzcVJNWP_4Q7kNvwGpproN&_nc_oc=AdqxeCuQSWRIg8Z2yqhOrzW8PR_Py-EmyZZbCiywBtTi0D0P8_WrX7Y405y1q_-GijA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVe8vo6O2BDFRL0rAhKAsNEjRSZB09B7p7VwzCEdHeiA&oe=69C922FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfJVyM_-eHwQ7kNvwEGUzhC&_nc_oc=Adr5IFJeXWu4TGToF5zTcoOyP2ehN2Xxezx77s8hDfSkOchG5xzeuis2yBeHLW_pI8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyW1BE9gHw3qf6hLuqLyIK5HJDkEIIEdX7P3SqZRuR1dA&oe=69C93399"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9JeLkwEZr4Q7kNvwHJd4kp&_nc_oc=AdrNL3dxOjthbRE5FVhnjqQ4itXjSG-kQEveMaI4ApMrnDVc-nU67U8dPbS_m4DGjH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoEEzLWbfsZVjlGnEJn3E4_vFd6jAHXVSRqffxeUNlwg&oe=69C904D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHIAUWPfYjEQ7kNvwGqIl9Q&_nc_oc=Adq2HYPxiJLvbeWFOcpk1YOGjnHhmtBfBudURXKfIIROLNjrYNHANU8zIDWHeomn5J4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmiqZuFNjNmwZmOLUyrkZL6MX3eg94t8ByOIDBylPx-Q&oe=69C93113"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H49EbuzmIaYQ7kNvwHHOdc7&_nc_oc=AdoYTWu2Vb86X4jAuszLSMrj7J9_cfMPDR5RcUtAuutZCLVontbCSEPcVu5s3Ru1j4s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qGY45O7B8moxqyoJeg_mEhcEhqRdHqPEkZD1krJsQ7Q&oe=69F605B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqDNDWRdaisQ7kNvwFYAb1-&_nc_oc=AdqJxeCZGYCzh51Jb3q_KqWXP_Md2Onk_JHQmlUF1R5f14NxddWi27l5bV4dlsXk-qI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Ox60SZObtayMpdLU_rLtP915Rc3_4SARzurtnistT_g&oe=69F5F5FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIFD5FSuW4YQ7kNvwHYAiad&_nc_oc=AdrofTsvDjeP1J9aM9MuDdjou1XKcyFNfi-vIoWBMIvw9FVMs-hhE-X7E9QXHGcnD6o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28afcjE9zOp4K3EBUoCI_G68Y9XBW58u07x5iGLECreQ&oe=69F60699"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVivuWnQsxMQ7kNvwF7GFkR&_nc_oc=AdqLTMPAR-YoYuGeGVoS7D--C1c9FWrEZ_i3G1-FQTQB4nYk_APeYJGTf4J0iTxMgxE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JtyMEojXF1NZUnIPy3XcI0I_UGfQinew_ftLRNtrhWw&oe=69F61012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptlk_kT31e8Q7kNvwE2Ypni&_nc_oc=Adrn0No4JGgqV4lPXqy9NT_c-VQU0NhuDmoA6tT1d5D2J-ukVKptVK2IWoXyl3iiR6w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08Ms1bHTCGqIxTKdwgUzSBQkL-LSy6fYf9-HGZQDeEDw&oe=69F60413"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
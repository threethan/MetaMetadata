h=00_AQI8J6_4RejQBMuiKIj0tKGV77ggnw8lk5nOArWkcV4zRg&oe=6ABE5795"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWymNvdQI9cQ7kNvwEd_MTt&_nc_oc=AdrDleX1zI4TaiSopQgDlLYLwVAz-oecaXIBxpGEmvCG9OYhdqAfS1RrBQgo2mYkFkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm0DDUojKmVfPzn3yuIa2fKnbyMlVexKe9M5kXbpudKw&oe=6ABE69B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcB3x_0OYi4Q7kNvwFzAnBT&_nc_oc=Adr831cSMigSesSIvz5Ul56vOTu_WNXe9QL6vFXGsxryNd4yt3uATDzT3M-BHENIhn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaaWLoY-WTlPksywSuAE6XNUFsGdOYNSNhYOLker4sUw&oe=6ABE59FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoW_fwvI_zoQ7kNvwHvOoHN&_nc_oc=AdrBWxNV_BOn-7kHc60Rv69utsl-gUXtrlkkepbdXHnAv8HnXtOGDPM_LqLw6UOuFVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI--cmGdUMBLJDJolz9LolugLG6ktx_QPSevNi7ok6j0Q&oe=6ABE6A99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa9ATuyBt3cQ7kNvwHOvfkO&_nc_oc=AdrTKpi3bAbQkYECiAp1Q-kots0-SuOXUPevNog_yYtDjhRsRx-RL6h38DFFBZ8Y_8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIftSacTMNkO0hIkKnNEnEntoK7C6Wch_uT9cAJ4nymOA&oe=6ABE7412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfxM2zb2xqgQ7kNvwGLB75n&_nc_oc=AdrzGad9LT1Wisj02IiFBwWAyWUzx7quCAhCMBPpVqflpWtTgkMh8hR_Ztg5gIuMoUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCAIA5ChLDtr9U9OFQ8auhy7lHFFLVYLzHDvUaH2lIUQ&oe=6ABE6813"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
h=00_AQJfbCt6iRA6p8Z-_G0lZyCPCD-b20Oq8an32JVefasrrw&oe=6A996D95"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2fHMTbG6C0Q7kNvwGVousf&_nc_oc=AdowlBeAGxr8QKBLk8qJReA3mFPE_jlikg2k05qEr13L5as0wuq5zIdSPxH68b_0Avg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMHzZDr38VK9e9sDI10a9V2tJ6QGbePyKJeIu98rPhgg&oe=6A997FB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5zIwSE3EvUQ7kNvwFXoJ8U&_nc_oc=AdqfHfJmdYTpDoyLAM1iWY19ogGcKH8e_FWuazzruFVoHpOrxqAmipJjx7GqdXZ23PU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUyxXwT9nzEYzAQGcglRXSKzTH1So2zP0xigurhqJEAQ&oe=6A996FFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1EsE3_vqtgQ7kNvwEvSQC9&_nc_oc=AdoEbZaw5VjadBwOLwZW7lrvU8Zhvi2lwCGAQi7cv3mQmLZNle8cs0Q3D1zGXYKSYPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZzw1jyYQjGKSDD8rBuNNkoaNvP9SvpJZrn6ZlMmVRGQ&oe=6A998099"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkgc2r0jnuAQ7kNvwG11U_E&_nc_oc=AdpvFY3jbhnQC5j871J1q95l-XcTopjNzclCeVHP3yJHSNEzOrCgPKXQhL6TIjvtZI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK673flYO-_rbOjgXP4u0ISUCykkI7KRITk5M-asNv91Q&oe=6A998A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIWAE7CChFwQ7kNvwGDjjhB&_nc_oc=AdqwUa4n2rnWqN0CyHwodPofkbV0ftqBc9S2CzwygzDYI4hmByT2yfQ-17sn0Y5dSAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWN314Ybo0rIKhn15Y9yUHb9ONUPXG2trlDBiZDsgr6w&oe=6A997E13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
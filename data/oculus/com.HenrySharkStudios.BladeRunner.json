ontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqUpnYG9jj3m4yUetJ4262Bg5wEbv9kp_d1G_t61WAjA&oe=6AFB1912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjw1Esse7m8Q7kNvwF2Z_No&_nc_oc=AdqiB-zCZcwkgWwMV2JZDAPfENBnip6__xwkQ74eD3ICe4TVDqSqjIAvEab5061M7xQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJZ6e_NDPkWC8XNK5UmCY_2DAD1qiTtTbeVCOp_XKk9Q&oe=6AFB4553"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_ur
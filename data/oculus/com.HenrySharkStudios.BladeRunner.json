h=00_AQR7z7I6T9J3H0Zmn5DkAqWjKb814zyCSlJovYC9mziVuw&oe=6AECB455"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmaWe3mgvo0Q7kNvwFhqJwf&_nc_oc=AdpvyYLPKNrpWtKDaAN8FXOTkHaNaAc-6e1Hrq9EkRCH7VJovoPd7xm6vbyNNs5Jcbs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPs4HVHtKDW00SHLTQD_ugjgwgD5zX1G1lmSC2y56-Qg&oe=6AEC8E36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1CtEBEfLZcQ7kNvwG3Rdhv&_nc_oc=AdrdVrGbFrATor-QG_Xe_tsmksJgtd571FbxpbjbYBWznAPHUcgGsjERZTkaK-e2Zsg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdQ0-9teHvxA2shdGAMLn0qhhTOow1FL9PbZiJpnS93A&oe=6AECB6BC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTy8ZNsIHogQ7kNvwHmnfyD&_nc_oc=AdodwBLH-knmKa7rEONt9zAtveCD8d76Wx0o0GkPZRbQn4_ET6769lmbeiFoLRLB5q4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjg67Eucq5goZMWzwaFfezX18QZYhPixN-nYiLVTLqrg&oe=6AEC8F19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z46n08TcdoQ7kNvwFVXgBx&_nc_oc=AdpUZXeKqCM1y06_UCSOXZA2smmg_wN5CvNyDeLQxsigStHFiqaqOKkEdcNrQjEo8q4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjvZ24nzQt5i--uMzij8j-NHEsC9ikiWh_8Ttm1eJ5wQ&oe=6AEC9892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbhvTsVrq7YQ7kNvwGEHxDR&_nc_oc=AdrDqHY5E1a_K3vzZJLOQbsSMHLguyf9aBi6pxFbP2IopIVcpmGE1YTKvDVebDk7lhE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlS_CBo5fw_OYbbeB85EiEzedOhXNml1Vkg-gswKK-Ow&oe=6AEC8C93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk6xf72HHxwQ7kNvwHjg7Uu&_nc_oc=AdrGD-eXV5C5NGCJ_SpBn7otA8hvQ-K-FVUl21PCbslcrjTgra4Ux1jocAql64N-Z5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jWh1Bt4Lu68nH6AnCCcFZ4mDjhJu-jwc_uZHdCh3axg&oe=69ECCB36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbGEsTA8sucQ7kNvwH8uEt4&_nc_oc=AdrEyLZ2byPXeU-BJGDAhenhOvFoscvQ9zjXXrDlnap4Nx1wgWsoW9MOr3iUzld4zZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rnj8BxpkQLIE6-wDTTDfdw7Lsob10Xm5MijezTIGfUw&oe=69ECBB7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYuS-76oDCsQ7kNvwEP6T-3&_nc_oc=Adr8cOPThqqeoOK0Wcj4Mc5dSWWXKsmw-pQRghB8mmDbyBJ86DkZXZmO_ZvKVzBDUmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OMr4UHmmys6gXv1I54ia3wHAQnEPvjqOtPsL1kMKCDQ&oe=69ECCC19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggUaO8jK5AoQ7kNvwEMulHr&_nc_oc=AdqU7f-tUPgnxd2YgN4FSqyIgENvPQw3DD9IDq2E9UDsSwl05lEcV0QVRb5uCnBVITE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NGsyLvQnX8IZ35K5JulhRvkrvLIBV_gdMsFi1-tKFcA&oe=69ECD592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26OZN3uer_8Q7kNvwE01Br_&_nc_oc=AdpdLbxg5sVGVG9QbJPfsEK39vXfFv5YfpaV90DEN8LPiYIWqbpyHu0JEbCEF5-WVgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z2fZttfb8zBJJKy1zHO8yIuuLCsHwL1s-kDi77v3eXw&oe=69ECC993"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
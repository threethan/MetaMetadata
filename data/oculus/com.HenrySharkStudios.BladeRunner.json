E-0f9vTZTcQ7kNvwEIaEe4&_nc_oc=AdrbZCoQK_d6YzTB0dxq7AHOE0a3i6ATwRf8kqE-HY0RDpge5axFEMKjaQgJNdAPYzg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFYxTysigEo5LwDgQSB0C30ZjnqQV0IIt40439n15wNg&oe=6A8580F6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toEF20y1VQkQ7kNvwGnYSL9&_nc_oc=AdqIKWq7mXQ32qHQVbGGPHp19WUdhsR0BYfcolK4bVthelzOY82zd64z1ixC8fn4ej4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECwXCmNYlLlRA1Vx8lJbp7gTmLqPeMKO-H51rxLKgbvg&oe=6A85A97C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1FYmumkRPwQ7kNvwGvtxHF&_nc_oc=AdrxXH83Tj5nQ86_9aYk5gUe1GIi3QxI_zsmRI5Uhhm2dOaRKdOTxfS6p4rQd7mSgkY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHli6_5Swb2czHpBhw0TydhC_5l56jN-Uw6qL7XH-giXw&oe=6A8581D9"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rou4DF-ZeGsQ7kNvwHdI0Aj&_nc_oc=Adpy0-IenGejuL-i87qusK9beIjUfZbBf8yTbN6vjNNbYfBzgAO8RTkUS71ebHc90OA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQBAyXZc9JGWjabl5wsWLLEno4O0pzrAv0d9hekcbTow&oe=6A858B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmNFdhIGULoQ7kNvwH1ZRsz&_nc_oc=AdoAxZpsmjCOfVRDoSmQ8O7Cm0BRyrQqRyUrfTnQW8NUyj98alyn97IE6dUGDtUiJQc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC1GFzbZP4VvRrRWZ97HrOGJhSJkhLc5k0ZuxX_jeS1Q&oe=6A857F53"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_a
https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wlkj8NdPLgQ7kNvwEC85lS&_nc_oc=Adqrye5FXiP2xHHdnhO4SZ8FjkCFa9FOzIy8BiYCT5frOzYQJOYPYmCLPeZ5JqocUSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73kuF75RL1zkC0MlH3ygwkDT0PepGbJBzX-aPTZrHnmA&oe=6A05D7B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plmtmwIKlz0Q7kNvwG4I4c8&_nc_oc=AdqnRUbhvmHE5yXC0OeSz-Un2IO8xT1dTOsiZfqGSgBbUc-cTtw8PEumSFa24sIiUfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g-5bymP3Vqw5RZR8QL0AYGNmx2SSVK1yOeF5XjqgJjQ&oe=6A05C7FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgqjWZq3evoQ7kNvwEoOXNs&_nc_oc=AdpSk5U4Aasvt55EpcMOAMW878JgugeiNULPBhELkRK9wBJ54mHHYQfrCYUdgCRo4uQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wc922uGMQiS08DyL2oiC4TBoRt8dYf7soQKU1fvKZpg&oe=6A05D899"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUATdS9BzBoQ7kNvwFc9wh9&_nc_oc=Adql1ce-Y_nW2ZgitH0Sk_1X9xmkYI8SYQ9OwqdTIUEvBjGUkCdJgNyLIU2leBbCluc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a9Z-E8vNPaxzD2RPuwITsS1XAAv_lV7iUm_379-4LQQ&oe=6A05E212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZraUDvw2cwQ7kNvwHLMZES&_nc_oc=AdqB6DH56SkregbTy0P2JRqk9jLPO2egoKc-qGCUE9B2B8qFOZh95ogBsxC0s-rSOXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y5E6OzFIr340n7LFRAtiuPS6QLegKDb1y9yIDCSL4MA&oe=6A05D613"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
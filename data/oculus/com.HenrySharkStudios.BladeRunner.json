https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPIDylHv3SEQ7kNvwE7Z8o3&_nc_oc=Adpm4SfF5wdiLKptPAGtcOpyeqWEpNokbnP8lHqbS44-LhBLqfCw2YJO3hp3_U1VtsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zihqq2J8bBBEJvo56eNbU0BOZHbmyw7TQvqr2II3_RA&oe=6A0B1DB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aStYV0VLtYMQ7kNvwHc4c6N&_nc_oc=AdrQ56Zutyovg9o5WJYD8vOgCxY3Koc33ia9SwgHxatKN5Gje5tutuhAV_givJglKyE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SXABWepFi3lenuD7A8-FdgqWtlDzr6hilh0pBj5U3UQ&oe=6A0B0DFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh3HiCgzlCkQ7kNvwEQLRWg&_nc_oc=AdqS_h_enR8vHhHPcbOX1hEqTwDA3jjSzQfDPyaaY-L3slQycg5JzRv4Y9AXb5k_HbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wOFXAODcwyPjpqqT1xBR2UqAxiwPK1ojnF8gg3vlyOw&oe=6A0B1E99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2NYtal0BVwQ7kNvwHatr7i&_nc_oc=AdoN-01II9WH29nV_cb4MBRX2uzp5ZeV-HkbalC-KhlDexnQGrU2y6rDrr-pBkX_2GQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o0atGxigRNkQrF5OjwLM_YTExqbjy8F48eakub4JmEA&oe=6A0B2812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6H22yQgpzQQ7kNvwH4gcQp&_nc_oc=AdomlQA6V2kNuoL6P5eDUqs47MGm1EYUplUSODXRxqVJBJF9n9bmS4_8GoJw2aBTDUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oEmsmJNpxNJaZtKws8Lg40NVldJ-p-qMjx-3C0NilAQ&oe=6A0B1C13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngwHGhUhw6QQ7kNvwEk2bD6&_nc_oc=Ado00509rPYmXEJg1s8b-_BbuOMWdZcIz0VWFZ2jFu_A0geMiiHYmpx0Mjnx1kWPAtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l7NgRvujWKwGM9t9znIQM6Rql01r-WY8DQe8xHCuNAA&oe=69DA5636"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpuESGlW2LgQ7kNvwHW9vlb&_nc_oc=AdrDaXtqnJl9Fx9S4TIPrF0xGPjSXjvmtzd9Ob4Lpe1W39GAwxjMsch27mNXcGW3Zbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lo9mdQcEJXy8GIS-5KJFfUiuGTz6NtoWL64p8zCFESQ&oe=69DA467C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QlkzbbPJjEQ7kNvwEbnxfV&_nc_oc=AdrvPcPh-rIRMePlO5HN2JV28uv0o-wSYmNfxCwYdWii6RVSTFYg57dJgYyFNjRsd24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18m9KtrJmGCcBDMN8S3vTrsnccARjd5AI5MTgqjCWVBQ&oe=69DA5719"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxD5lR4BziIQ7kNvwFAGOM7&_nc_oc=AdqJueRgc-1PzVmJ73ZbLsMNehh2UuC1Rl4BXwHE2rLy0HOeVdRZaGoqv9PH1eYDowc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QmKOGYXI0QUPwrf9ei7ZHJV31teiU5UJ1DbVdzRXIzQ&oe=69DA6092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piPAKu6SK3oQ7kNvwEmUVX2&_nc_oc=AdruD5J9ANNlRL8wU2mI9VUFA764N5t90na_W4KsV7azhqZVYC8OimID9-3GXoVhZyY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r25PZOxqGISito88w_nryeKrjfJvuGY-bkcmFqJU7xQ&oe=69DA5493"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
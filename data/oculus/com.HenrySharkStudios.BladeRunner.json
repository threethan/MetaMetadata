n.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAX8OPhITwQQ7kNvwH4BuV3&_nc_oc=AdmQtKSnobZfqLCjeC5s8vzS9javMO9Gn327zuF0I6bFAANEseFF5-ODtZx5co_rDAE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkCLm-kU7jeH8gRMdlr1kqUCUiBM7U1GeI4JJrs5E53w&oe=69B177B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0868V5Hm-QQ7kNvwE499x4&_nc_oc=AdlDOFmHiSTCEAon97KZIR04a3q20-DQummuFLm98XObapT5oNfcgH0VIomqIIcTVeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfztSoahmGKFd7R8X0unvo1BP25Hnj1XMjqojSDyzS5Xlw&oe=69B167FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w7EBEav10cQ7kNvwHmYF--&_nc_oc=AdnU9MLy0gvWMxbmGpj1dInvnDGtcapCi9mLtrIyUAlQ-vby16Cahl5-aVi79JcCvDg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz06pJg03CEpoD-eqoqFNm16tgLAOo4kvMjV2glqEnF_A&oe=69B17899"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEukURtOW0cQ7kNvwFf1d2O&_nc_oc=AdnzlEQzAo6cVf-2cPfDxBnSLj15aKGsRU7LI7FgMvTDHbxgdDsBKVfoUPNvXvlAszo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPL-f-Ful3mr8Nb6-rWKB9f1gcQiuSFLng-tLXPUeu_g&oe=69B149D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzP5ueoIlrcQ7kNvwGG-WZ0&_nc_oc=AdnD73hzywjfgg54Kc-_wv5o9aY8XRU2A1DglayLpjVJls8rkRzVwePYW5zJb0QpAzU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx420gwryFE-9hGvmrw5SJ2BL04cUG64JH1MBfnOrKs3g&oe=69B17613"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subs
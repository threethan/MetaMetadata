1670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCsBOJl1xzcQ7kNvwEn-EjV&_nc_oc=AdoDvFBXhGKetajjUj7TapM7vkutvBxYPP01COkDo_cQk_rh_DA2wY_Z4Tqyy3_vpDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO2hHFmSOyy6V1hSDYf_G4A_ZR3JubnZAZRic9-SJKMg&oe=6AB923B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SOYAWEoKRoQ7kNvwFUcBIQ&_nc_oc=AdrJTcAq1AWa6L78UJfGrmLl-isjmSf8IBkqEs-vuVwnlAPTiZQm9iseQIj_QDpv8lU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzezr-l8_WdNmVSV_E66Va_W45nyhGmdGk4-_ngtc5FQ&oe=6AB913FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NrVW1RtDzsQ7kNvwG43TJ9&_nc_oc=AdrAlDoKnNhssnbKhLgpWOwxT2hu_uuhuZnd-o9A44EPQlpbNvO9k5b6SOdUBP1Wqek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx2_6_dWu3woHfQm5-ZVc5ICDIRmVRdkmHtsIULxss4w&oe=6AB92499"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtwXPMs-Yc8Q7kNvwGlKHeL&_nc_oc=AdprnNLwEwdGzq8vnhHPbWns7PTAKggV50EKcuzxqUzdtLgO1fpbD7yBKO5tDQcVc3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1mCma04Hrox_hqRYAUnMxLgEYY-f4jFttR1w5zKDFUg&oe=6AB92E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BjOzNxtCzEQ7kNvwGoIIFM&_nc_oc=AdqqLx9P0pAFJP17Qx7T3-5ZGxUx8N1b_S4jK-iE9gR-F25XaCUo3RkhhwTZmG0BZ-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmuOxGzVsuu8MuqKHZUjxLtqN6X_ySVKFjLx9BP6uHLA&oe=6AB92213"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscrip
h=00_AQLt8SvEnpYk8gHU4XSptnnJKiEMEV9dcp1CExmUAkY_YQ&oe=6AA7EE15"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db95dOsqc1gQ7kNvwH_wYJ0&_nc_oc=AdrJmTWSLh8B7ELFoKTFjL-h7cYaP8RIFqFDT-jUiaC5L3nGUEdEt3hMoqyw_EHY9Sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMF-YX87c69lSTqCIKPPJNIxWqT8tEyha7zl45i7umbA&oe=6AA80036"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j4zzfU5J_IQ7kNvwFk09qU&_nc_oc=AdpZlCTXQrbU0_0nAtvorSbJIyJv4IIAKegKdbt5eNYugekyqPlzZR1nWoWMrBfigJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA6o5xKiwmtHytkhf87qGpNGZ38yOz4Mhx53FpCDoMxA&oe=6AA7F07C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mftEHPddVhMQ7kNvwGiMzR2&_nc_oc=AdpU5PYKn5I2MPT-nSuUKMDlE2up8-z0R19dK54EEl4Q3Vv7_UrE3BsaUiPDoyB1W7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqr4k88EmQEcXec2BVS-_YsnpXf1mYZSAghy2LHfRCDw&oe=6AA80119"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXU9znynYXkQ7kNvwERLCJE&_nc_oc=Ado7Pe-3WaLcnupTHLGdskiKrD5_VlNFFujDyT5edzSNt0IkEH3WnCnpLgPdNNpySrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvuNOCPafhUS75eU1P3BNuJpFRZH1w-WtLb0EPs95MFA&oe=6AA80A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYDDCSNfwIMQ7kNvwE7wTne&_nc_oc=Adrd6UVH5y-IPaORMx20lRV15r667OvV6EaGgzcC0X0qnMqFKr7KtchRg-OnAVAzwf8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwTQDVgpCLlDD1EGDFKwaWPAIWWzfbCdJ2eVlTSopkFA&oe=6AA7FE93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
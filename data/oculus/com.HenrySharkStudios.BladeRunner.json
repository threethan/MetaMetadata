https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9Rst6LlZAIQ7kNvwH8OShK&_nc_oc=Adp-fLMXWbV2WFdo5KZc6GdgOI58AvNuf75dVJW3VGhx1RUJgNl4XozkaETvxvl34_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2KnQmxp9FLqDXL5nonyqXJ5FAzBd92JtYK-INmdgl0Q&oe=69C29B36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0e0VQQi8YYQ7kNvwFIq63T&_nc_oc=AdqywaafrF5TJVmVhf6ISEm-2V0PAvSn1w2ccKIkPubVEJavkRyQ-1Zag7Ysi8kg0Dk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZr9cBSSvU7keUiIlLjsEWEyKGjiO8KYSKN3hJv67bhw&oe=69C28B7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G81qGIIwRSsQ7kNvwFj230n&_nc_oc=AdoQyN8QnY-6vBd_WT5RL8uDTi9W1FhAvmo1Usx7JP0RGJQpdFW4Fr2ExwEGgFM3BJU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOBWtvM6Wjc_3Ns5UBatlzDTnS0JplGD6avuKWn49VTg&oe=69C29C19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg_EnACVt14Q7kNvwFPV4iN&_nc_oc=Adr9qiUiuXiK_v7NP9baF5RSaVFt_TF9L1ZWSWJfDeI8ddNo9heR0Iu4fUSWXpI7f8A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvblGntgNnoOYYzqC2OixLtNM-RlqUaVOqJwcb_aSZzg&oe=69C26D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jMfl3CX6i0Q7kNvwFm_7WY&_nc_oc=Adqsd4MNdoXBCcaKhLjXqZGLEUx19Q3O770VpXxOQd66nIVms36uOyo1FRITZ4_EUHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzqp83nXwO4ka4o3gCWAl4wLCw9SI7AR1_FJUNoKRHHbQ&oe=69C29993"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
jifWEwj9rShoKYrZITc_RKnncFoX3ZC-2Xh72XszkDPMIC0kApcOrckBi4Jap0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEuC2P61-lvRncfZ3pgdCPTgkJtf4jHd7ROAIpZ6iJQg&oe=6A5B8936"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0b3hkNXP8Q7kNvwGWj-_D&_nc_oc=AdqLssIk0xe3ipoV60bZKhoeVMGvixMP_mSE5ojNfcgei2CPaA45jQuPM3RVvecU9JI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrFm9d21E27HgTPRiivSGqvPi1KOkTiBTUpUFxyYPqlg&oe=6A5B797C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5Y7CLgrvrcQ7kNvwHOL-JZ&_nc_oc=Ados2Lgl9CnZikt5hdYqafj9vsmjBP2LyrTsyr-Hh_f6l3KhSeuarw-qeInRfZdMh9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMhFAbJLJIXWzyx42u6SGIqq7M8q3a30rMfRinazGahg&oe=6A5B8A19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxjxYzMUnokQ7kNvwGFXV0U&_nc_oc=Adqh4mAdzMEBWMjlqx4XWGwqndCxDhW4kwn_-bFM6BTBUyAR9_h_7WC5S5Ca_nL0w50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX_dAGQhoJ1I53-n2TgDT5tC8P0ijJRRtKhPqd1YHWTg&oe=6A5B9392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR-LnzngDh8Q7kNvwE7hbLD&_nc_oc=Ado_EpMkMVHcKXqhyo1NGbVEKcgLE2In3ZFzR1CmR8F4KT0Dx9SFjLoqLwzJ6Be9FvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCll96A68V9X5LmMo-pZoz9ydrmGkg2SDfR6SzP5XRdgQ&oe=6A5B8793"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT
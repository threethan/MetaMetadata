1670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJIV2LFa6DYQ7kNvwFR3VlI&_nc_oc=AdpFWaBZjjyuefaVKT0EdwKU4-DtzwgZhO0D1wThJ2bCnfR0sewDFClTa2OzZrn5oIo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFjFdliJh523rJEHiF5n8AFpLl1ie0W7TqHO2UZ7wCBg&oe=6AF9BD36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LrTYZiyi8oQ7kNvwFG2HaR&_nc_oc=Ado3v3b-b3Fo-bKLOZQsZMXSo-fJ7fMSjjZpF2VL3Ip5r9N-jkTM1xDjhb6u5qsBtOU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAKru61BJyURs4FQH1UDOjoWw2CE-zQ9KbSP8946wTBA&oe=6AF9E5BC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vhrLvElFgMQ7kNvwE8Ur-r&_nc_oc=Adod51K-oiI7o5C_y6ZoDuY4Adun65gm_FTWjyx4EmqnZB80U0R_hqL6-4i5RQaRRPU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw4zfWvnvpzgQoKTlLYMYrVpuQ1nW3K9BRAQIDHZJrcw&oe=6AF9BE19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APK165OUpREQ7kNvwF_HCxz&_nc_oc=AdrKWBlHvmD5Yc8hAuDN36gvCy7I_YvteeoKIrlvgF4OMRpq7lUepN5wH3HMgdIiyjs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD255TXk_i4hqYB8gW1EUpweIci-tMxdHNyhDAgXVYhg&oe=6AF9C792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjw1Esse7m8Q7kNvwHulAms&_nc_oc=AdonX2gGDlkZcgrUMp0fNidnbRs8sYFdDWoZxj8b2P4u2STRTEl_I5zR2kS50nuuTdY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvSCpOWIDGlvC3eHLQ3kqnXNo3ydZHRNRp0YbRID-kGA&oe=6AF9BB93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscrip
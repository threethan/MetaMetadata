https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8ZtfaLIYoIQ7kNvwFmilfH&_nc_oc=Adqbbu_R_6KJDMULvUAya0n8VOo2p3cbwXQveLHlKcJMlb-mC3urfQf9kI1ofcqIME8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DpjlCy_HuaHAB5z8FuLrmHQxo0qNsQNH8-V3qWS1Lyw&oe=69FC9D36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woSOoWvt-5kQ7kNvwFJ6hRO&_nc_oc=Adpkypgie_zc_lY1yDPZUPBNYPmTvxREhO_GgQRQUUWjHrWU2a6JCm9X5WVh6xf3LvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JtTm8uq2yPPykvlS0ZIwsciMrj2fyJ7OVyneYZNw5Tg&oe=69FC8D7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFmDIa9nWxQQ7kNvwEEIChJ&_nc_oc=AdopqTiE-_x_Nr6d8haG8KdV0Od5ENQUp9kTlQpJvJMv4676u3oQJbieochENm45xbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AbNabW6bHI2PDWKEYZhoEafE5x5-BInmmBY9ymB8Ang&oe=69FC9E19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaQkHjkn6e8Q7kNvwEEG-i2&_nc_oc=Adq0RxaeLDo57-1R11BfsF34e8sVFuzi6EfO6iRSug8NAq6cteTw0uWJOcJ4USrZhlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ya4WyxjxXv_SXW9tAbWKYuDikZd4Cy_pLVhNMTjuauA&oe=69FCA792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZN2Fh8pFUYQ7kNvwFx20Dz&_nc_oc=AdpvX6NoQ-j92Lc117G4cbg_3biLhQ8F-kucgJxULXPpAyRSO80o_F_9Of0cBUGsZKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eE_AWV1NW9-vhDuqmp4iLwh9rI7f_SwXNbP6AdADmEQ&oe=69FC9B93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
h=00_AQSTbZQ3EEnhVVoHP3WKP8Mm007mxA7E80xu-JXV-sFv2Q&oe=6AEF5755"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_tRpapilv4Q7kNvwHnwmil&_nc_oc=Adrubj8FHBkFuzJYblfXMd0EN9Xf1cddNcDAsH7xx7147aZF0RygKH6szg79fAzvGuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL9NBoyB7tWAFgqcNO0RHOrxUc1ZVm13po8xYKDe8Ozg&oe=6AEF3136"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to77FkLE_T4Q7kNvwHF4Nq3&_nc_oc=AdpYzSNAYU0ectexykU-1NmEylrLV_YVOmQfh8u0lBT2hVNqfTuSiK6Pk0wegXj56Xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFxpJNE9Nfp5JIQDlVN4bMMjdNfXe-vul2b0IGVwu_JQ&oe=6AEF59BC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYRvMfIBET8Q7kNvwEY-YsY&_nc_oc=Ador-HA1lnhX6cKeYhx8Q3JweVLZAuzedjZvbmoXuqQ3BtkAFjlgfiV1LMRVyKCi16o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD3PKNmM5iQalcELx5x1P7JT3--npJ9t-Bb9Zlof9bLw&oe=6AEF3219"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_oFiTn5wbYQ7kNvwEXZWT4&_nc_oc=AdpaiybPOibLcosk23hZyzJlltSWQeApOq7wcPQqILIOlYJJlyxOptmIZ_OCTyYkQY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdH9iCxZ7DHFTInw_UyyefPBfGtjf_po_roipjlJUEYg&oe=6AEF3B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbhvTsVrq7YQ7kNvwElWh2E&_nc_oc=AdrwBf39Gtg1mv5S2DKIGhktVrOXyPxkwmZSNVOiv6BEnEzwIUa8L_sGkgB8avT_-60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBa8l6cgeT8KtQ25OJWK1LrMPp3QR-veahOczZV4z4gg&oe=6AEF2F93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
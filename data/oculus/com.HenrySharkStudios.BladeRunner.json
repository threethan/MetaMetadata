n.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVbc5RPYUD4Q7kNvwHVIA0l&_nc_oc=AdmCGF-ud5XC7aPnnmbwXyjbWj55r8COp1dAdpEK3PG7jd4qP0w7oscfBUg3_Vg1da8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6RxtqxitQ39nCcVNMzk4oXjbbLePDVynUrQXcg7R32A&oe=69B960B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujE8yEpkCdUQ7kNvwFzd8iA&_nc_oc=Adl5XM5S3HrINq5wM2a8X9DHKFppiTjEmiHL_rAsghH0KQfW0Q0UzvkzO-u2ncksj9E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwAeeULmPTOhwYZee28L5JRF_7Ikq_MIoPnBZn1WKVPKw&oe=69B950FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55gn7O4-JoQQ7kNvwEIpvNP&_nc_oc=AdmZUYZYwsdJiECNe7RBLRcqmDx0RQkecbD9lVQ-ryiaTNR2z_S2_JnAzG0xY5YKxcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwTrzFgxli967jORdBiRO8kIxUOH4cb9pvzieNbSdfUg&oe=69B96199"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gyiI6c1LqEQ7kNvwH3ljdF&_nc_oc=AdkZjmmYt5QzQvrQstCOBY-XA7zgUXdf2Vdm9p7OmT6OwwQRAjpEbCtM3Hv4KvyI-oA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-8O0xfW7oi5nCzy_GUY74LV4c_Ra5yBK7PL9a3aCtng&oe=69B932D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SXJonkFUegQ7kNvwFLSC6Y&_nc_oc=Adly5mCl7TcB6j5S1xxk-KvXWBIWwiMyf55wYZNc9R8BkZiSZ1m1JAttC85XIJulvwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzt2CJXxgjjNZ5MSNHz_XVZWX0DXVMnDa2_qAif1VEXKQ&oe=69B95F13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subs
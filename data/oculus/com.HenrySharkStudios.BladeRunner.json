h=00_AQRe_v6L_cGfJmzXx7v2-lsjqoiZVMuRX5TiffOt7wM3ug&oe=6AEE05D5"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmaWe3mgvo0Q7kNvwGwYBke&_nc_oc=AdqeTgQm_P8uhNoS9Q8FVVja1gMQgG5142fIBPOXAMgbJRmSEul-aA_b0elp6QkT150&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkalc27HcA6JPmbkmbnljM5Gc84_JxtIQ0r2OnDvfX1w&oe=6AEDDFB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1CtEBEfLZcQ7kNvwHImo0p&_nc_oc=AdohU5HPZgV4VpI7ZKknVQQjIK-Q9FJFv5Q03q8hdW1y_Q0dKnMWyZwhd1ioVeQEwn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcXwIsg5J1XD2R68c-bdr-nJWMf6mkEutIEamK9yLjzA&oe=6AEE083C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYRvMfIBET8Q7kNvwELUr2-&_nc_oc=Ado8Q67SLDtIWN6nZP2NzHSuCHI8H0jqTNtm7GrgGSbj77G4aL2lyaQUMKRRpp6GKKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCpTIxpsYDxRY6BCn02DUhWhun-a_-PztfbrQRhbZPUw&oe=6AEDE099"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_oFiTn5wbYQ7kNvwGKdY8-&_nc_oc=Adqo4NhaquMe8pVOEfbO23N-96DRLjNHFfv-h3P5H3_0jwo4EP-NNYKNLAzZl92g470&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvtlf-CnZs1CQL1XqIcR-_VsSpplBWbdyQ0RZtFiLu3A&oe=6AEDEA12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbhvTsVrq7YQ7kNvwGQC8oF&_nc_oc=AdqVF5LPl5aNgyY8jECSliMbevzQRiq2vWiII_55DHVjbe-MvyTdxnpCrDaf5bzDiXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQK6sz7EMo4hEzp6KZ_3RMKl3a8VCgxuI76gSTMgQdqA&oe=6AEDDE13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
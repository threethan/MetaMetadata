n.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFKIuikXzGsQ7kNvwHCT2WO&_nc_oc=AdnBnapgaGsH52zeaWaqbTv3klfr7ZNXfsoMF8MAVGvOOaRxGO9ws5J6r-F8tX8ggts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyw7LMgUEGlLwNbOidEAwOzLr6v6k3tvQEbmyID_JUUzw&oe=69BC03B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYEv3BsTK1UQ7kNvwHaV4pl&_nc_oc=AdnLBotHXJUCMkf57fGR1QdQHeGzXXyGHAQzrsroU9GU51xGa-zo7ecxCU8bV4G9QVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxspy2zKhgpwUCkebeSWO9BerTb1Sk6uN8MzwdxU9YLuA&oe=69BBF3FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55gn7O4-JoQQ7kNvwHiFq1C&_nc_oc=AdmfrtqXY9-Tq4ApX74CwENPv-FdOvSlqFdwlNZmlybcs02kyqvBokop9DubNas-tKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5IMEKrOf2c8PBnyr_vUpGY3_CY4GSj4DTNMb-7dNjZw&oe=69BC0499"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gyiI6c1LqEQ7kNvwFy3qKo&_nc_oc=AdkJwFwwMOJneULfQsA_tiGdk2uH8or2N3q331XV2SKyi8o4LwMTjkz9b-X96lqilp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-m4niH72B-jXRmD7YZpkD0-_rDwuTzarTWD9ij7bPdA&oe=69BC0E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SXJonkFUegQ7kNvwGmEYoo&_nc_oc=Adls7-NvuZH4l4tBHoP5iwdQoYhWW6QowC7KORnD7hZO00JoWE0ny_m5VGNWIBKyi9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfIwP2VsRu4DMLDOFqA3xb2CCqJMiHxyecxT8sFcL6Aw&oe=69BC0213"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subs
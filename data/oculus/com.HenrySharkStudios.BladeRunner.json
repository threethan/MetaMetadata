n.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a28KEmqO-hoQ7kNvwEoba1y&_nc_oc=Ado_kdZno0DRkqTxip2JO1G6gx_U9EJaNGZ7Ybzl36FHNQ2sbkdQZhu0ShnbhtximH4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afww2bIpdF8PE4RwXxn-prNlY1hlXMg2P-nB4t0IRFT2jA&oe=69C149B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP8aysn_rnUQ7kNvwHWPfCx&_nc_oc=Adr4HirizZ5mR2IoHKAQf-5EAvfECVmqJNxioO9mioRNfFRzYXbdN9IFTYbwVkgmC-0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0kPzR6BDyFkYRUm-FsrakWn0mnrAsHmN9Gel54JBd2A&oe=69C139FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G81qGIIwRSsQ7kNvwH2qJQG&_nc_oc=Adr4Pu2DPBM4peqZ5RE8GYYG8IBL7NPJ0pem2MAzZczslxqOD0T_5YubyD8vUGvmBt4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3wWNIpTUtIJvIZiayTZOP-1QuFqocYwRGbZuZWnEdjA&oe=69C14A99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg_EnACVt14Q7kNvwHB15Vw&_nc_oc=Adoddx-EHfeaxvM8r_Q9MUxZFUo040y6xnv5sfU50nq6ci_f7h7m-2pyYcC3Dy1oDLo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrKtXdp7JJ4RLhUzzjsq7tWfRr4ki8zwsWLnjpkkzoNw&oe=69C11BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jMfl3CX6i0Q7kNvwHp3Dv0&_nc_oc=Adrx5Dr-j6IK1_pdhiZEf91gfEf1gEUS2r3fJsflc6Y0I24AKDlR3_eALMeEyWx8UCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJmLq1bJTLKCtQx_Mj_KevIyyClJmu2kwQkPhHUO3cSQ&oe=69C14813"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subs
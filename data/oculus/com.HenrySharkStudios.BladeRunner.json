https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaiWABu0V_sQ7kNvwFA44QJ&_nc_oc=AdpwrO1KzP39iVyMJStVxkxTjU-0c839XVgDV0HweuISnFDv7LH9TgWhMWNRtgSNTqc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pZzek-74Qa5OCOu5LmcMjFf5EY2UnqH_0zcScpkVBPg&oe=69FDEEB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki7FJE_3di8Q7kNvwFcnJjn&_nc_oc=AdoonglwqHzvb1qpT4ncf1z6gf8MxNurhUJM2cJs8oQQuES_iRi6DF8JgjjQ7NYVWLI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QokGEDvXpMWfVELlDQop50Ffb-BJbi3TLmS3QmfzjAw&oe=69FDDEFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFmDIa9nWxQQ7kNvwEi9sXs&_nc_oc=Adpa4139CZisA211iclZphpomFBQaW62ZURX6yN8NU8OF4_4jA3AaseiaNL6AJEWDfM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58atHdH3OJPt2LSdTEYAG6sEvRMkcuZoE3R4RKOKuseQ&oe=69FDEF99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaQkHjkn6e8Q7kNvwGu0Bqg&_nc_oc=Adp9JKwMY8w0GEvEbw8mdB6Bbk1vKG2gffKy-c-i-V3NQ2OVZPRf6UK2QacXM6OeD-w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OCeoh6gKlsNPODBy8gS3Mv3VGBSJTxIEsEdZ2F8F1YQ&oe=69FDF912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZN2Fh8pFUYQ7kNvwH2HZNp&_nc_oc=Adof2eiaRlkKBHyXzy0zYN8PNE7t3AEX4ZNKBnBFUgZ80XrS-I6I-agrG29kjEN2g9c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77VD87nj1G9-gfWIAELXH_JyJUES0o-YVGTyAeWXqHjA&oe=69FDED13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
PTD_387NVi0fsaydnt1auAfTqM1A-qsZS4MGWCajgr1kTKqlL115Cb0kyIu99U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JAoS77pMqfw1Oa3s2euLMN180L5h0eioF1mWuvNcXAw&oe=6A1C4136"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xl70tc1BPAQ7kNvwHOjMEK&_nc_oc=AdrTUfohq2uKZtK7JKQBL_rehexICbiReyujYU_-CxQNyfbIEjHpaKeIx_LB9cUhkXI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4McJQhkUmJ0IvoK5G6eak0EbjWrgkBEcf2zZJRDHZ2kw&oe=6A1C317C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hRHIpyc6oMQ7kNvwEevO_B&_nc_oc=Adq7ij9CDiFcFp03aPim9SP6KDRDYt7NX_tFEIkhNHkzDZWfXdstxqyKZOKpNd9zQzw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GN749bi4XClwH3L7UYdzXKfyVCuL-EM7SeKb1lluP1A&oe=6A1C4219"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_zeEh1zeJIQ7kNvwGv4mmE&_nc_oc=AdoPzEr-WcePkzMgbfzm9CRuYJoyyGaiu2P0-VRt8D0_kQnp_uuSu5BP8R_7LLICVcY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AAR4dns-OUX1GXScOWLuKp-kLOq1ih1PVo9P6pq2gPw&oe=6A1C4B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYE-_xYXEMcQ7kNvwGeS7NO&_nc_oc=Adof5NOKgN-5tCoXy726gsD6Ou2G6oaqtu4Emcxfz4oDlJ5DTaGUN48CyMqMjVcztg0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IP-7QsXCIHAkAW4f0Rd_iF65Ynzejgz3vd4cCHd2RMw&oe=6A1C3F93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_
1670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2fHMTbG6C0Q7kNvwEFzQSA&_nc_oc=AdrpD5K4pbDVu-dWKlkacI2oaiK9GiV9AjQj_ZP2DQQmQeyzpB9fxgk1zFm7y2ins9M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIAMjH-MeaQlddzC4tPTKgHvXs9O6qlHcpllKeAeeB2g&oe=6A974D36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6ZV_8QHSGgQ7kNvwGEB_aW&_nc_oc=Adq7gC1orbK3XKiO3Wypikx3g-4H3Q7B2wnMRwv24Tvm9f-lRKb57zPwVqNynnGa5YU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELDJ2RFAMmJ24hPsO2NFHH33rlWsHrhtez-aTdhWQ7qw&oe=6A973D7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1EsE3_vqtgQ7kNvwFLdUJu&_nc_oc=AdouHJCSH8GMFKv2mGtjiJuEOSswnSdcX4Vl7Zt40NzVnw9B7DpdVEUUEPozEe4fFL8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPNHLMDEMhonYI1T31RWGf3jkBzJJSxuReXAg52Jzynw&oe=6A974E19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkgc2r0jnuAQ7kNvwHG1QlK&_nc_oc=Adqds0qBPI3drnfzhGhzyc3-QWrzysDuE4JaQ9PodJB58x8f66kPoIZHvrv8szEHBZY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP-YP3DiikKlRd-8Px6arfRXnrkJD6LjZxqj_0Rfn0HA&oe=6A971F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScVnKhAHDmgQ7kNvwH7csR6&_nc_oc=AdrkN94tRG4UtY7TrR7mcuk0oTwxxJKz8ZpPDJniNyC66T9x9negXcY-Q9sD-luiCys&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYPXAuHkwXIOTqlvqz4Z7FkDXK6AawNYW9lF7e8gGdNw&oe=6A974B93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscrip
n.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFKIuikXzGsQ7kNvwH7O-0j&_nc_oc=AdnWqq9xMVqpoE85UnnAR8huQAPytxO-svsvPeNBdaR29IZzN28vvnnOhna8iCbPBZY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYV9fubptfbNlfMECDwiLHn-0SLl9FxNC3NuBNT6QE3w&oe=69BD5536"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYEv3BsTK1UQ7kNvwF5x_Tn&_nc_oc=Adlz2TbCphe1m5vVvj9Bn3xreUTuSlhGS9Mr7kC2Se4wVXdYexCNg5f1FX-2hx6v_sA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2nOVqbQ6LmKRMgjxSTufD8T-Kl0euVyxgFUEDZkrskg&oe=69BD457C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AngFMw4Ds0gQ7kNvwGBDe01&_nc_oc=AdlxrN6IuHJWM3bLwkG4q-VWiw9nUgH5SV0AncqiJlbF2ByYO7m2hlozlbLD8vJ2ydM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj6OdPImVUFz_61oHoashtia_jTznNybQGj-o8d83q_A&oe=69BD5619"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI7s_5RYw7MQ7kNvwF0c4jj&_nc_oc=Adnu77uKgbf2wT4qyheYsVfAHHs41GBVA0WlO3OZ-Mm66Gt6WoX5Hnn-HcCzKAuglpY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeSJ_nOivIyFT9BpFWvjiyp6eGOYdSTia2RnnFD0wtXA&oe=69BD5F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc7ylDru4_EQ7kNvwFfl3zl&_nc_oc=Adm1Z3ZrU-ThkiTW6caKSj0A4om4eV-8tk91gEoebi5r69FkHkVCAGfdUqI0yuZ-qbc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgs8cgb_ChB838JZvlm8V3f65wtngsbmuJPev6nwLY8Q&oe=69BD5393"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subs
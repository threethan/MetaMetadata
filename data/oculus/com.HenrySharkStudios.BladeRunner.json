aiL4oOfDlW2ILm5qcs1M7KTVC-jr19fbQwC9SECXOdDI9SeeLizvCYLfoCmu0R4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr8uV2-xI13a2pCQ5YJdzj1HVsbaierkn8RbZT_SdIow&oe=6A86D276"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toEF20y1VQkQ7kNvwHxtwDy&_nc_oc=AdquBQG7bDInF6dWp2Axp3c3B5EOYIcTWZqUnBHbzIatLn6l2JBD8JdtR5i7M3Yhl2M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF2TJhtQAnoKm0y8BsLx9cx8a9IMW1VP_X2rEVXc4QYA&oe=6A86FAFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNnjdVm4cZoQ7kNvwHaRc1J&_nc_oc=AdrmEcMw3h7jJEx4tQhH1dK0cRWb1U0oe0eTc-5zZlH6xO8tGLcEJ_hwYuCHeWc5KT0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn6emYB04t9WtZ3o0ThGH5t0o5gTv_WOou1sEnpoj7bg&oe=6A86D359"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSJQ_bEYw3QQ7kNvwF3W9mI&_nc_oc=AdpU6me_HDRGISH2X-dDDN0dEPiFdHl0EXXDxcg6Blc3vhhYR3B6nXWbG5II9JlQdE4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKnUs6BAp5zsYWeWdkq3WTV5gnawZ4Bvi7mUWh9ZhnTw&oe=6A86DCD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mPi5SwY0r0Q7kNvwFg_YAD&_nc_oc=AdrG2Lc4G44jRUsNWviODUYI3vU99HSntkomAepQNxBTcyMjw2b8BIL4HgnCGZcqORM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhcuBHtwB5T7_206LniQyyDVIixccZ8ulmOREjqxHkvA&oe=6A86D0D3"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT
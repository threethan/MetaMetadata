https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrbBkmo_M4YQ7kNvwFIosgj&_nc_oc=AdquAmluN3osyp0hwRIOaDp0393Nlv5ZHn3JjkLj2lUmPcrCCBV7_D-WIGxJIfWRyp0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H8OY9UhqO6tepvJEzPYZsY4mYQAXmj_eoE2YDoUbLVw&oe=69E23F36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KbjwGmbjRMQ7kNvwEAJdzi&_nc_oc=AdpZHaNvbZ2rYocy-wmGBx8gqtg5j6xDW23-AR3cGyWu05U7iIa1xCGO6J-OfN1J1Jk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hjorzr5xKBR-M9VWKtLTvCKr3O_Eqvk1Ds4nlLZd73Q&oe=69E22F7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_EBq4mvDc8Q7kNvwFAGUdV&_nc_oc=AdquoBNgOYz4xXDWHCHYJ_z9YL4spXne8I03LFmM_Nl5Axwq0lPkWVklUPfEeWFJ_t4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cjKeCPHSIo_Z3XrcNsQ2TySd2hHI1VLDgchxWBme6wg&oe=69E24019"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXpdqMWfHEEQ7kNvwHuaRnm&_nc_oc=AdqqGFiQd7XCYDKiH2wZDScAqPTZG5DfN839PQ01pCZs203BT6wwFMpRvprYYkCzBPs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-LdGcrq7_B5B2xTND_pgSJ8YWZ1h7syuuUkjDb3kgdw&oe=69E24992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VGeiHXUtm4Q7kNvwFUTIVU&_nc_oc=Adr05Hce8PfZuafhDmNGHTUaCMUroUpDu92FXjzcM9ouNSvyQUOgvzVoz3XOM_BD-yQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ptwoxsN5Pz4yvclrehmA76DCxZv1IbO5Li2sgjdMepg&oe=69E23D93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
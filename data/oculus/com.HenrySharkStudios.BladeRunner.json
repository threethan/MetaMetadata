MP-Z4-grq5tX8LBOvWwhkr4lkigzPG4VveAu54_TbO7qA2sLRBPD44f3Wc-5uc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2T_mnaHX3ftzzz8OOuKtYRFQyc-FP4Dnm--cryrMY0w&oe=69CFCA36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBaq-yAIfocQ7kNvwGmux_n&_nc_oc=AdozqB4Znml-Ll0WA_drhcxa5wJo-RgcQqNFVI8d5D85pVer1GfdM29A39kPmBpaRqI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxu38L6Kc1-rOdfcaUblNUKv5q34_LMjX0axXptTVmvZg&oe=69CFBA7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwzQsTp_0dgQ7kNvwHgelde&_nc_oc=Adpxb4YEob5nRKU8qjdFShrFz0xW8P75mR_WZp65sNPHOcIdtIo3GR9m44XcvQBC6mU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXVzlrnN8olTeMB7NxwDFt1B_MpEpRtXwLEhVBAyg_ng&oe=69CFCB19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSLRdS7Vus4Q7kNvwHffDM9&_nc_oc=AdrOc-i8W6utCrrODOSta-zDJUoItI_ZBsYdPvI-dGaF90aNRqsJ_QDWAQR2tKcZZQI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjLzs2P2fyr8gShf6wCl0BjZdK7MD9pnL37dcf24L7zQ&oe=69CFD492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkgaKWfOwxEQ7kNvwHbTMRX&_nc_oc=AdqbF57wwJf94g7eUa30fzeGYi6TGH8AIxaAo1SpXvPJ-HwLT3FLLwVzWeZvka7s0gk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyECS11-a2cPMcy3CvBqKPG6i2IyoiXICBaB3sth-ej6g&oe=69CFC893"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_
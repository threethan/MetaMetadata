8cEBBbk6x0HqKnSJqkcYfPT9qkO8o9DHbO_BBzBlMNLuKDJWF2M4z2wxbuGWYM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YwZ3X6ZVC-vl4jcZtUdINSPdtcmmNp_ILC3KBDSfhpg&oe=69E633B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHWFdrGsvMMQ7kNvwHLjrNC&_nc_oc=AdoSQo7ZByf0TB7VVUV_3fLcoJxS2ZZYBCWNTsLr_aw3-R4zoF5hd9HmPDzLqJAFV0A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af122YZtJvEiu4ajtL_LAiahUADCPSOElXuAOvrKNLjmzQ&oe=69E623FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMCbE9_QeUkQ7kNvwEGEqF_&_nc_oc=AdqJEnTe2LzppVQPF_T4APwd8DuTvKvdpQE2rRrC-7lTCqNOphy-6AXUIiFDbX5UDYo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X6RxLJcKFKe0fHnCgmkX6g12vnqipt8W4MWKDGr5ULg&oe=69E63499"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DBrhyMwEgoQ7kNvwGS72S3&_nc_oc=AdrJpfjNKhEkW2GXOBdhx4mZQijGO-a-90EvKRJxd8MAEvi_8qvQBtGH-C6_YljpE0Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QqZzgxMdQZlHzYAF_2cZybxgGVB2ZfuPuqXO5sOCX2w&oe=69E63E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=curATheoOYgQ7kNvwF3Ya2w&_nc_oc=AdpXsuvXnL6wZd78kq5Vc_Y34ZKuziYrGChWuo1coBgXExMIWkGrdy7mEHzGMp_Dx6s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xx-DCE0pD5fsC4x6FdgItpX7hqjQrv1xnOKqUBnyZNA&oe=69E63213"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_
h=00_AQMqQx0MzJiJRLzk1RkZt4nRJ5etz6LRU16ubgs-sSCs2w&oe=6ADCAA15"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxz9XKY2twcQ7kNvwHXs3Vq&_nc_oc=Adp_jiAXZ06Rr8EdWJN48PLp4qnvCdWcHgHReUoqAbVjmPV4eWEwDQkrdXdysvdJmLk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHT_Fjs0gQKzP6BOqcBaGWFNvxl1UUrsSyPnVbiQ-kVA&oe=6ADCBC36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmq5AX4jAZQQ7kNvwFoRg6Z&_nc_oc=AdrCp_g9DyOiWK3qGjVI_QDWUlyY8cb59zQNJTKPB-ySc-TZ_muOcFZdSGswAkwtdVI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzNcPaum8_REXx0_EBHCgDbfkXxPzH6WjnSJYzJmtFXg&oe=6ADCAC7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRYsmiwJxpsQ7kNvwE6olAa&_nc_oc=AdpwrziUxUkZ-Xm6wvewOhLwXwpWJ9LDUBynw07fl2c_LJviU5ll7Wc6h8mcT76XxWA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLZNGQjwm8AisbWc-SOSkJHn2bkryv2H6RLiJrmHaHDQ&oe=6ADCBD19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMVuCaVNAZoQ7kNvwGfCfZV&_nc_oc=AdpGSWQjSjw_oH4WcCDsApoi28sJaIPcpTtpLdDODEeturUXSF8C4DloqoYVLOKhW-o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRisgso7LVoVmCIgN36a3WKmFrLGnL-UokI8u-yuyVVg&oe=6ADCC692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9niXNjLNx5YQ7kNvwEX82A0&_nc_oc=Adrz8fCzSS8HA1nj_88YXv9pQQZVBlPg8Q5O16IcdU3OC0FrlkcS7PcPxxnRU1We66Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH6e9lF3SDUN4thF4bhVQw15Xb0rzO-YRHOkbDL1w8Lg&oe=6ADCBA93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
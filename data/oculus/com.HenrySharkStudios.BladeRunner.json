atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMAt6Asvs7BIuv6mJbOxr_3OkRFpj2pKxwHZQGCVa3vw&oe=69BAB236"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYEv3BsTK1UQ7kNvwGw8lQm&_nc_oc=Adk6VARc2arpXE85VY58tbSXttzVB4V_WjwJSTSzBX8kVS4yuYWWTCLW21U_2aO_J0U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTIk2VhN-niaGhYMV5PJiYUEwmOBixXwfg8gXGlNmadw&oe=69BAA27C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55gn7O4-JoQQ7kNvwHTOdZE&_nc_oc=AdkGPuUCwAYtlWkxBcf1kEeq390nev1NTinRKX3zV_JashcwVAjzLRJQJmAZg4UfXJc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1fawrXg93uS068kzTBtSivHbA6QVKRinLmHQ_dJl2SQ&oe=69BAB319"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gyiI6c1LqEQ7kNvwE-rHpf&_nc_oc=Adk1GA25B8o7jw7DNbNYB25VfCmYcMNwnNMpPg_oCY180U-3_9yzP34P5IRFbi7a9tc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzd9sA8XVfY2h0ikWlsHMSOz-dLnJL3zkZ-u1OQlJtGeQ&oe=69BA8452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SXJonkFUegQ7kNvwH_pQrq&_nc_oc=AdkCbXiwJ8QvtWCVKOikufay_6IXzHUq0B_THpJA3jg04v1Db-Hx4LUmmNVXIZtFUnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyrujThNGXRvjsXasMYkgzaauuDU5IW9N5tYnx2EnLsA&oe=69BAB093"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
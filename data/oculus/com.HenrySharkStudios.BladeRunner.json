h=00_AQJO2v-HuR-S4YbpUWn6LoWl09dDyAB_XyC2BUjn9FwVcg&oe=6ABD0615"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWymNvdQI9cQ7kNvwGyWuQQ&_nc_oc=AdpBMGU0N4QruR6g20n5pCB_hmZkkrzwSYniihr8F-vDpltAo9n0H0RlmzBvswd5y8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOQg6L9xVHJGUCMsCXV45PpJd3FgBvuSuXDhJk-0nicA&oe=6ABD1836"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcB3x_0OYi4Q7kNvwFX-TH-&_nc_oc=Adpb6O7u5Nr9RTqiKJZyB08D8Ofr4LcjPp3kpdGRPjZz0FSJucOhSwBlTWKGRT5BJY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeIWm4AG7LdOPnkx9zUfdGNS2ok5kX0hwD7q5e2xGdog&oe=6ABD087C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIlhzxyf_JAQ7kNvwF4_geB&_nc_oc=AdpZbw6HLYhTaWIl_vWnk9qV_RRHUHu4agwFKYYAV6BQCR_nFP7IZaELjTEa-LKQnj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK02tVq-y5cM4THb-aUMCS0FlCJkp7cWPLFnDAmhhdE4Q&oe=6ABD1919"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctO3X1GWxLIQ7kNvwEXbL4j&_nc_oc=AdpOfH9S8xm0R0nOSxIP9uIpuA-Dx7xyfUD9DFY5Iu2ZcgPcWkQnzjk9ofqy1z958OQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6nC6_wq_UDnm4MS1aMsJCFv-Laz0el6i5QTjDi9VvEQ&oe=6ABD2292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGzXTyPs1awQ7kNvwGvhF3T&_nc_oc=AdpGMj2bOx-9sXAMdC8cJAAu6KZzb6veHzV4yYyto6phlfAZcluBpjBz6-63ppGEIyY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpDkoDegi6QltLCRJ7oNbodraIS8cDnzaRK9S-mN90SQ&oe=6ABD1693"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
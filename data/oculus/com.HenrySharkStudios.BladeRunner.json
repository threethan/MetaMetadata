"https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrQ4Cicw0QMQ7kNvwEPxbe_&_nc_oc=Adr8juIgu3n7q6BH7dfsOjyuhQ37nHpPc3n6iTlTPJdtDAXn4HJ5bbSt11ZZKpmyoGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdhaLNtB4jw15keU7u14iIBEpy5wbamz0APzBh4Yspvw&oe=6A6220B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yTfiaaerYQQ7kNvwG0o3bU&_nc_oc=AdoAomfP1e0XCniJGqUwFzxa8y3jaNKU5593dMclW-o1znMxTpZwv6oEPPbpSuUND2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6TKfeV5sK4ThbDYgmJizHDDLS_l_Sv4K2WLuePHavgA&oe=6A6210FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwLa6T9e5GEQ7kNvwH1p1jI&_nc_oc=AdoVvZuGQ7-_PzmqNtAC2PJ_KnWXhJ_J-sAz4meZd5Uw8qt1Cp9LMB2PK7LsJ4KdfyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDug27S5MWHW1u_NuORHs6ys9iU7O3JlMtfqK_IHz2SeA&oe=6A622199"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mR_rA7-RlMQ7kNvwG_APjy&_nc_oc=AdqzsyG13ZUSYiEsk7-4--Kwz-1Dv2xBjkTfD-h0Y33gBn0NI93hodLbnMGZ65Zu58g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ2q2rYDQtxsecJOTNHeEUWe0CespMrXjQj8E-0cxDZg&oe=6A622B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMSKqhfnackQ7kNvwHRX2iT&_nc_oc=Adpu8L9TTG7ScaGv3IH-sl2_O_ghTaQ4lpaRJPNjG58-_3tvjZHnfaeCskmcTS4bJ9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjS20vlYSeadxL0EN9iL7DUD2XDxJjzMZwtG7BukElAg&oe=6A621F13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
1670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1b2tR56DV0Q7kNvwFNBU0a&_nc_oc=Adogm5WJpzAPDgZSK_DUL9NJBgc9n9gRN9Gy4502MY0KQaDKvk_x7JYwWVOEMjAAUZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxB2x2XXBMSOFCIcJ0M6VM9eG-Y_9pQUFAcSrdwriUQg&oe=6AE9EB36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lMQTO3hFHgQ7kNvwHbevFk&_nc_oc=AdqfeeZv76b0VekyL2mesSgY-x2fYC8NEig-dsYOR9lp7Hm0oX-UsxrmGQpKdTfX-EE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVJqb2FtvoG2m9q92Q1Bi9hmKaWE_EChtg2e1noqhYsw&oe=6AEA13BC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTy8ZNsIHogQ7kNvwEX18XO&_nc_oc=AdpuhRzaTan69kKs8JpOrKshvbEKtUEZdhlG-XB4aMjOCyneKSfCgSeEur25MuFiSeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlGcFLQaUSV5nsdYLXxCC3d2k7L0K-SSk8j9gg5zOlYQ&oe=6AE9EC19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z46n08TcdoQ7kNvwHN1r_d&_nc_oc=AdqABVF2PyJlLecRNmkmjDHtEutZ1J4GmPX2_UAVbhqFT_EjULoLRymf9NF4zQH59l4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1541tPZLy29Tc_YkWQ5liTkKv4RZgI_yDRZXux-FzDw&oe=6AE9F592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqnB0juKuNUQ7kNvwF06CDQ&_nc_oc=AdriTAZLgLE1UgJXySrHbaraLZNb1YlLCw4uyGYREfgDp6dugd9Kqo9PoS1gZqPowq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7DZn14x8UT1U8wtL8MK6ozVQh96si45zb8kEO56M1wQ&oe=6AE9E993"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscrip
8pyaHyTjh_DC1ZTphOgRAeXIYf97ZEojW-j4iBUU3W9AxFYCzJYGKGQuASlrepw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBhgZnXBLcgJ7iWTPhKxgxzmnGuFE4ahc08nZxTbYOoA&oe=6A7738B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXmKWboozhMQ7kNvwGuEL0p&_nc_oc=AdpboeiizqnIaShBsDPWYXVcCldZPUc9kgb8tcY_Mcz9WTeULAEk5huzYWY2S6Azf1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcyos9SMPjvho-HaV2sKpC4vYccbKmjO_y_CQa6LKy_Q&oe=6A7728FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlvP65D_oEgQ7kNvwHsXrBr&_nc_oc=Adq8-YQ35dTO4hX4RrPp0ysyi_gDc7bkedr6P0KuXTEKJmpNfVnEGVjgLXoqYmTAgoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJVrbt59LsdMClApjcYy1eSkMVMW8C5ytIwi8b5qMC5Q&oe=6A773999"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eaw1FGtUy_sQ7kNvwGgwMGI&_nc_oc=AdpgD4IVERAaqAYg2o9-InKGFjsqiG91Py-sgB_CKzWrxEj_39w1RPlRgBR9X_EBlfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuYGNDlt30WWMxDwDsVbmYbn2qFCxI4bMcIScq7bN-QA&oe=6A774312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE1U4pJS9lUQ7kNvwGA7zZf&_nc_oc=AdrQNq6yhobHssTfYzUERf71R523UNos6Op9pFUm_-waYLiVku01oTXCv3cPmy8vIgo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4ETahDTGpuyE213t6wHoYJq1HDEwyiifPL4c_ak-7VQ&oe=6A773713"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT
h=00_AQMA7_aTBGoevDGdfwOSCnb6q3xcuxTvS89qwo_aeVYRSg&oe=6AC7CA55"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxR4NrzJc9kQ7kNvwG8DWuI&_nc_oc=AdoNEX2xo7o1hlMRA9UmYZpiiEns252UQWOQfouD1f2vDdm8fzBT7u7r5eWwv2b92ik&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1oKOzYPADReBEthq7-bRyzURF_wNDN-3F_JLGo3wfWA&oe=6AC7A436"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA6R_kSkA8cQ7kNvwG5Lcmi&_nc_oc=Adozsfcvqg75yqY5SytBBSYaD44q5eUauf9-FXCJ1TOuMhLQVsXwBPZTBp2tcI6E_LA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7bRcX2IP4CNWOIuji5r8VzI9tDqjOiLglVQb5xlCqDg&oe=6AC7CCBC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvQc8gOq4SYQ7kNvwEZCkV6&_nc_oc=AdoAMglVXmafP4FKU9GiY5scP5UyxQjZBHC9nFskrPmrtOUqxmPaAVScomxmadZvkAo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7eKNqtLhHNGwAwOfa2vUgVij076iqTwesWNLOvGbDNA&oe=6AC7A519"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTDiil9xxb4Q7kNvwF0xddO&_nc_oc=AdoNZvRvJvIgfQog98rl8zVSB9z6pGddzB1gkX1n_HKtik7DJk9v8y_4B-4KZV1PTFw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfgHCZQW8CecSoGrlyJUOKcz8_KRG22SdAhwaOY8JeEg&oe=6AC7AE92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np3d9ewgGbAQ7kNvwE3JIul&_nc_oc=AdpPxI6WKsBn_Po8bd3uCfeSXudR39plUaWy1tzBdNMDZ4hwolGQHEPGtMZfCeVWglc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyTLOkGkjo-BqqXSt8O_Qy8NyPE4fOk6byDQef27Yi2w&oe=6AC7A293"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
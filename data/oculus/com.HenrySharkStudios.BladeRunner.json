https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zATGqM5f_foQ7kNvwELYjPy&_nc_oc=AdqNadMKxVKYV4Ql87xcjG--ahT9xBCc7Y12vgi3mkEk_gFg9o2gIBsuQvweYcgQUwo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ws7EBVOqfadvOcSVpMdv-s47KD1jTolk5ufpJQIfokA&oe=6A2C1336"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLLi1Sp0IiwQ7kNvwHe-Vm7&_nc_oc=AdreRdT92NQh9UuQU3kvdVZMabNS8sIzGvfai-1YPl5p-dDCef0db2iWhk8iUmYAztQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w7hgCtm2mddjBDv3A7wA7YS-BsOO7WJ52XvczplNzvA&oe=6A2C037C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9oOWaTPLLIQ7kNvwFO2IGK&_nc_oc=AdpCVN4GeiQOMocikMnFkLEnO_gn9ffV6ast_uvmEZklyoESS5zZchyzMh4Qwq4GHkI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uOvd5zTmQzCYFs1STEzishtU_vG8pb4WPLYd7wucYYA&oe=6A2C1419"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HsPu-4FoiEQ7kNvwFT0Z1E&_nc_oc=AdoVCptQzVHqRFXpBwwDU130Ap5Yxdhx2CaSGxgCxNvZs3rfmMkpqntPWl7Z5w0dwg8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PeF4zwO-W6AduaxHTRJW84_X2dpwB32-xuQjHwCm_FA&oe=6A2C1D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9sneKQYV1AQ7kNvwEVVJup&_nc_oc=AdqaktGWzcgarzU-c5DG0vrnaMpyGNeV6KWlWwsM4D6hUEofZtT7uZQJy8b24ZuGkH0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u8gEcFG8UMZHGtNGSN7WBMYwqTEbfdFXeZwxlHvmdIQ&oe=6A2C1193"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
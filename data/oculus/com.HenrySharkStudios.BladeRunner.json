h=00_AQNGgMGymtSBbEWeltDwZXBwJCKZM6rrw6C6qMRvSbNxpA&oe=6AC3D5D5"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0uigFPxNWsQ7kNvwFmor7I&_nc_oc=Ado64VzvwAVWr8OtKpp1ggYkM9laNcfJqyKNRg-J-ryRMV7uXS75Ltuf5UbJP56vxmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHG6sNsfGQkVgXOuPtliLnRWXK7M_ZaRK1cCsmNsWzZQ&oe=6AC3AFB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1FqZ5_BxNgQ7kNvwF6nW3x&_nc_oc=Adrd8sBvrfG668rCCci2bogRpy9mpUlXkv2cWoDUJcI4RAFb2INi1oCPm0NyC6EcNfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1ooTRq-TcV061pA8aDKej8YU36Zqns89iIe3MQT0vDg&oe=6AC3D83C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYKtCOxN_nQQ7kNvwG1F8MR&_nc_oc=Adr8nU1cVzJ9KGUB01dr7PnB-Pj0d6aEzUU3J3TsmZ9Qp0OrQCJI6hyTimqn3_1NWF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5m1No-jCyfR5gPRtaAnEqoQ51GxKjS3i2wszxK154JQ&oe=6AC3B099"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa3EW9hjYqIQ7kNvwFvhyjx&_nc_oc=AdoSaNZD6Z7fsmkhwqkeYW-c5Z3RISl4Kp2b0H8SYn18Zy1e0E-4UZA8KTPhMCBUkuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS5HU-qfyAsyKnA7MIV1-v_LFf-jkct_cFAahwHAk3zA&oe=6AC3BA12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odIDB4rufzMQ7kNvwGFfQ_E&_nc_oc=Adrmyeo4EtdhshUlprMkDHR84ZfyWfKj1lGWzBs2Z7EAu9m0bHKFLDjlNKfrL9URIxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTT_zaGa9rIf7ac3FiC4OMJZ0R-yqoL5dVFN-oUzbJNg&oe=6AC3AE13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
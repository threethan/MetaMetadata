https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H49EbuzmIaYQ7kNvwEQl42g&_nc_oc=AdqxyXKKuZqQE5J7tWkuE3RsjHo0nMKI_8bPZuJ844dX7nUGXU--dFlLTIOFfFOpum4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uOjREO-bwuIb5h9lXE_v5WClP3q0p0nsLFmnTFoxNCg&oe=69F8A8B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqDNDWRdaisQ7kNvwFUs-vv&_nc_oc=AdrkR0rP6N4S-cLBNcxQMHAQLy-mlwmol9qhR3BxCcnZoChswKXTI_KkkL8FM3wNaQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iOHl2i3CiEVU9bhX7hGgyW2nwYi4CeY6AV804iTqLng&oe=69F898FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9blV4AYcl8sQ7kNvwH9fvua&_nc_oc=AdrFSVCmXoqco-jH943v40CoQevHfHvyfXTZaviwlhEMP57fCKZq5bSKlCW4ZI1RseU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pRT3fYPKx3DvpRXDj27zHyeOgBWErqpMIWP5GGm7xWQ&oe=69F8A999"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHHS_e_fOfoQ7kNvwESf_NG&_nc_oc=AdoQyaeNdrdwEn6n0V55j2MDa3c5mYh-djQvrF0hH4jrZrrdX0K7RZ5rCNKJAFVVl90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qtZ7ux6iPwXIqPvEjUNX0D9oh8O8_-Xj2Fw_0Ci_3Jw&oe=69F8B312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbqamXOEGmYQ7kNvwEoXzez&_nc_oc=AdohiuzE77mmKBLNfqZNHJGrPXF2rokd69aQavye_2yd8YuhqHwePQwT0ZrAxwY6uqQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2g-m5NmbkYZtPw5SFS8MAQhAG_rnKD40w1JSF_qtjqQQ&oe=69F8A713"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngwHGhUhw6QQ7kNvwGYcrcD&_nc_oc=AdqdPKGtDcbUFOxfbm3VdeLXoB4Bq34AUXOwwlP1m_IswFK9XLP03YlPk-hPLi9dMWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JGvQEWrrnq8g-Oz1c753bHjJj-1zJO0ppSd3LwLabLQ&oe=69DCF936"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpuESGlW2LgQ7kNvwH0umX7&_nc_oc=AdoIefawXtN1slAYLqDbFF5nkdtV-AYHnbStjwRZeqsKDqqqohkkSKPJiNL2-bxo7UA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lb49L4qRPIoNHkI5lsuuioMxo3vPr4a8IUJSKLPgmWQ&oe=69DCE97C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9igpUL-wkfgQ7kNvwGssaZJ&_nc_oc=AdpScAvASgXvORSgOfVy4cPVW9APquMFoXV7x_iHuy2-zoL1im7q6WXJ7zjaNHWPHBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sXQevI4RusdVrdDfIHlOg1PYVkHe45xAYLaU4HT_O7g&oe=69DCFA19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiM70SxfuuUQ7kNvwGx2xj-&_nc_oc=AdpIsw36DZr2u8mpsxPcRP_jni7DznT87g2oqZ_LQyi8Vy8MCjZSWhBT-vjBfhfaiYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zJFPVSteqaAsu2o5eJ6-rMpP5QP2ZGgmYSVr-S3l2-w&oe=69DCCB52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gVH0EAUCScQ7kNvwGxM8q3&_nc_oc=AdrV4UHpxiJY6BRbxMSVIoUK8nQ4TEkNbVHJXWrX_8WDaUOfkNEjJ1NXc3Wtvpr80y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZoS4QELfcH4pcnfZ2WONsy0Ffvas70X8N7oy5CzfcaA&oe=69DCF793"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk3HHOlNBvIQ7kNvwFWXiFO&_nc_oc=AdqcDCy4b-GhWMrRXviORHIoy-s2sk5bRKXKDTrhOdjeKk203AahShkLxfBFTgAoL-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87iBGWj63ddNjkQnN1Fk9E4y9zQYB0Sp4URldcVt5FEQ&oe=6A33FC36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3obwZWTv8TUQ7kNvwGlH3sF&_nc_oc=AdphJcbS-KDCYk3UXw69Ej0Am4o8diY6_6rhtXqKNM4ILA6fGyEWvCE3wNbf0OUFTN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5BLdLivUs9BB_g7opqAXC7wfBGsjKTJextbYE1G4C0w&oe=6A33EC7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNyz1vm8Y9YQ7kNvwF4f7Po&_nc_oc=AdphrghQZBpt0a5l1PCBJCE7GeOEUjjZCtZCz6-B6-3nrauYZnJdVryxaAijLfeQ9fk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n57WoEgGPNq_TjI8B0FCW5bqC8GSHnozjwb-RWothFQ&oe=6A33FD19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXkUuzbgH98Q7kNvwG3A4Uq&_nc_oc=Adpuuz-PzgKYWycSYh0PvveX4-CzK6Oei8FOehC7NaIh2UdiY71YJsmUVLBRM_BUwHU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eWGxiwzZlbC-5AFH5gu2RVEjhNJAeaK2zhz89-6jCfQ&oe=6A340692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_FUU6Td-68Q7kNvwF-nAo3&_nc_oc=Adq6Te8g3cayFcDuoPgFDmfeuUlfJr2H8pRlFzF9wFJriDrWyRcvRdpTkFtRkjAFjO8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lCDYflPvydTlFI7FfU3gFp2nDShlHTu3269gf__pYEw&oe=6A33FA93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
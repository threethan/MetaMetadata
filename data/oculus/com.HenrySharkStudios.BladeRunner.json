X-KY39uOe3xB4Oe-zhISbDr5XyHeC3A_c0AGv7qCR4RB14IiGyMkSh94si-Plfc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLa_2rpAeRXJsCmYj48-HDJ0DkuPHQzBu2OnvfNz3zUA&oe=6A68B836"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7x9f4PsWFUQ7kNvwF47Nxz&_nc_oc=Adox7YB-huerOsXtYK0tnzRtq_nHbKKXVyLgtqcB_ecviowb-aDyax1ie-cbj8Y1nZc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDaa5yUMkLEUxWD8xKSEYgfymURhBuvwp3BtBenTVFEA&oe=6A68A87C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHmMCgU6gUQQ7kNvwGTuRJR&_nc_oc=AdqHzOlcEmS9UU8oZo-wgtmxibnaPUavL-JuUoGbFz6HC18T954mgylXkC9mHPfRsZk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1P13Fd-GVau0UljuGqzfvK7HJOe_W1I0zLEYro4yDlw&oe=6A68B919"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DS7I5F0b2MoQ7kNvwGC2A0_&_nc_oc=AdouQ5xPZPOEgWRduVVEj7__XMeYy_ffpEfhten5ThRhjNutc25CBtBFdZZ_PWRfzCo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADr6nRw4fT7lnXSrjL0aNNdA2PaBUrkrmE1_bWx1g4Ng&oe=6A68C292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl-RcuIXRK0Q7kNvwG-CqXe&_nc_oc=AdpHaMdqfxQXDjUDrnzHdGPGReR8UDEeywrRUB9x5ZtbweTqGSd8onPUXwSUPYImMUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX9h3XQ_Y8AcEobYTuu2LZer47_0trh02dwfpxHhziTw&oe=6A68B693"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT
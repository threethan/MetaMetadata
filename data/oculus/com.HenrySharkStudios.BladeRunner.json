"https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZrWdaedBUwQ7kNvwELNeMF&_nc_oc=AdqsFZILBbwKD7XcOC5V4lnCzVeXjEu-wdeq1XVJYvcamrLS5BT_kHKqXzKEyH7ZWZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr6fI0v-69v_0H54UqYBHmh6-EFHXkJIsAsS9VkAVtZA&oe=6A6DFE36"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukRcsUpL6m4Q7kNvwGwvC9a&_nc_oc=AdpV8fXDosp_Yl1Q9gQaoede2YwhS8xILFJ6zkHtuBJlCU8jbuwn1FmTmaAPDbsKBW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDedll7aKqzX12-q5lFJlzq2vtvd1G2VomX7x-44dI2Vw&oe=6A6DEE7C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgh7G_SxQ9wQ7kNvwH2ZG99&_nc_oc=Adr3Mmea2MefM2r2Tmy50dtus4TtFN-5qdIFJPntHlgBvnclk45Dn_hYfJlMoHyYLJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHVlygJqFmbg6zQCo_Tkw0R9prvC49mTYTbh2Ej0_uFg&oe=6A6DFF19"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW7TSveDuLEQ7kNvwG_kJ58&_nc_oc=AdopcFzaIWFEQTbjoTogmRM6t8tiVi8OzJ7R3r9OJjuX-V-o7cWjGt2gJUNeWK1j86Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB-lIuTVLmJqyDk_Y1DN6u7kPaH-odSjBREZnQH9dYoQ&oe=6A6E0892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwWgWlQA6xIQ7kNvwGtOO4r&_nc_oc=AdojdEChq81Z5thDlJGHfa1EZBzeA_wV_CvCQqs5UVqKxshJQpbw1bY13fjSLlaaPcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvZO2ZyxH_HSV2vbkql2x2_zGIl58bQBGtYQWMPK8PVg&oe=6A6DFC93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Q1feV5LW8QQ7kNvwETpC84&_nc_oc=AdrOIBir-5kd2MTUyfK6YXN0KvUEkrbw8N_JpXm6BaKN-OKmxD3vEkTtCrnptd0mKhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lJ6fxYgGPKkXZgbRimDW8949gbQuV8ye8ecvzMu_o1Q&oe=69E0EDB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wKREFfLJksQ7kNvwEQg6ys&_nc_oc=Adoro2h3hzC6vDUBfsWlGmLGjR_xP_l35sdeLAl1NThdX09wvdr5Jj12PJ1NvYCHNcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ll4-OrYjYumxbjIMnLx7-YJ7kELKFrEp3Z07HU0aMXA&oe=69E0DDFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_EBq4mvDc8Q7kNvwE-jfzL&_nc_oc=AdprfvyDpcIQ4hPZxhr__hANOw82fyjsGcSH0roBR124Rg_fTH7pjCt8zAOXYG8l3fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rRLs5AEaWCBEoNQ8QEeUD868nLoj2J9XOd9brPWlsKQ&oe=69E0EE99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXpdqMWfHEEQ7kNvwG-8W59&_nc_oc=AdokcePHFS0JxKn6mdMPV8C1fEQvKg0Y1pslsSCpfwDlIBW_7wToH5MsAjS0ZmSNGps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14va0dl6pkhfmYNDWorKVPc7XU1m0pmusHfSy0I2op2w&oe=69E0F812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VGeiHXUtm4Q7kNvwFrXtc-&_nc_oc=Adr3sqPcNgLl3Tc40mv2EDTbZhQdg-k4mE3lhz1XV6Vkv0njiYxWI9scHnPJs-GV-cM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p9ALSuXTAgGahKUeIVPLGv_w2xgV_VUzI8fdA9LMBvg&oe=69E0EC13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
9EnFqFrkF15JA6Qba7aZm3t5beyGqY_z4dsmbplHApjNBcrOfj8U3eggc_sDvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-IIQh6o0tx4alX8NXzT3nXKWeFDZcHyRreZXf-OxQcA&oe=69D904B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XthFWC_z8BYQ7kNvwEoPHDa&_nc_oc=Adq_B9Eg-BNQSrZGvfkw9gfKTXbiqtOOCk0M0W2APYHhlC2DKBHW_BL31F171Hr21WE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p0KAL5BNO3wowAfokRU0ZYQjJSNJozGUcbacSnR5L6w&oe=69D8F4FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QlkzbbPJjEQ7kNvwFpyPl0&_nc_oc=AdqGSug9LKeHTdvQw3GGfbRlYmi-BVUoOzW3GEo6N9zH2uUJ87Fz8328LYmmayuhibc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38wEkP3fGBDoxvHzL_u5nrcFFHTGhHKdMm1t3telpowA&oe=69D90599"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxD5lR4BziIQ7kNvwFKHRJo&_nc_oc=Adr6t6MB8eUWyZPe7pNDD70d9mpuIadWaTDTME3ooRyki4i3SB6t2y298Dvw1r3uVo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uBwcN_HUal9MazyOxV8zGTMheX9F-efYRgzrSSH_NRg&oe=69D90F12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piPAKu6SK3oQ7kNvwEgt7AP&_nc_oc=AdoWihQRZ-4efQf1FoRyoYsFwg0qkGi52El6ItabRGuYk9Vg3eh3L81rQMRRm67N1wU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S8X-ml9FcvBPVG7JaozQpjuU65sYyfLoEUspB7NJkoQ&oe=69D90313"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_
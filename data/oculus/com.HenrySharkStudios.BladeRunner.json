https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHbtPwtaCoAQ7kNvwGoZIjh&_nc_oc=Adp-3ZKS5hl9xKcbuTExwjhVuLTYnSlrPsUgBgSnISb2mbf-8ny0BVsGM5aKCT9QTO0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pdQVqZybxbxAlQl3gdnOEsvw-uARqWM2sj9kHfUuTeA&oe=6A1AEFB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xl70tc1BPAQ7kNvwElcQiz&_nc_oc=Adq6YxAoyzusFb833kdiTGXIhkNn910uIwTrddVDCNK74tD3ohoV74LCrobsyyibzwE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H37NNvdYxp3I9IwXvx7b6zK4areNHGgd87pWZhiIzRw&oe=6A1ADFFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lak1ZMoptkQ7kNvwHxBZCM&_nc_oc=AdoS0ByBYxcSNtze1M45e2jbkVnrF6UsELbrp8eoK6N-cNQNZ-lnujLZjfj_QZacz-s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HU1IAtgxuBfDg_TS2erLnEY3Wg_MWXPHhzCyDMflVpQ&oe=6A1AF099"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3S2YGcAwBEQ7kNvwGqSeLx&_nc_oc=Ado7sB8DvtSGDdbbeAzkIkTzV3p8Uf2KwN63U5FKeqCsMboBsig9FDzKgy9gbS9eTUQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g_sFN0Wlvv-snd7NZXWwJKq3wpdIZxXI6UL41235LRQ&oe=6A1AFA12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RcVX7aNUNwQ7kNvwG2mOY6&_nc_oc=AdoXd7bFEp63AEuLYk3pO4K_N0urQf5Fd-7iqNUSiehd1ItbCJrs8IB8WqYIKRn2edc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sS89OjzQ5__X4S66AYoQ6gd6YKllr5S_dtUl73IItPQ&oe=6A1AEE13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
"https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAYVm0sU4CMQ7kNvwGTTYIH&_nc_oc=AdpdWBVqVwtt16f0FhTSv3IBU3GqipeZ6NDfj2riBmtFivwepwtD2-MlPspOHuhnukY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hdLaiElEUeBafGhF3kVi0aY8q_-TuhP55DuDIJT4FxQ&oe=6A37F0B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM7gqs9a9BYQ7kNvwHJu0ea&_nc_oc=Adr-xQB7YynlU-nLBylEVZCC18YpmEYKlF-Ehy386MLWIFcPMQWfNOy92V-ERPuSlrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93kD4IodLNHnEe74mS_u26EmJQIAivcoXCHpD97uhyHA&oe=6A37E0FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3PCDU0EgV4Q7kNvwHeKdh-&_nc_oc=AdqiS_JGmZNr1_BFOOGU67c6KBL2eavjfaQHEyIWFnoD8YEf9PVMk1w-Os6V5SNPNQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jZI6kP-KO8kQJ4z2Wnwy2SWMpsqLgHZKiv5e22Yi0ng&oe=6A37F199"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z3FVDaeekIQ7kNvwE1YdQu&_nc_oc=AdoqWManDR6m7NpqaRxDZVaMpH1ijc899iPtSUcy72YcnViMS5yPzsGnAAPKZazB108&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-juSSi28F71i6Xq33iKgiwQdtHuMdefGmzrlG26neDbw&oe=6A37FB12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBAVKood9YMQ7kNvwGi0liB&_nc_oc=Adp7WTR5VK6Y2dqOpxOeHR0R2BFY5uhwFYbbDlNb0-86Z7O1RBlaxsL8hP8q0U0kSdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xJpjnB0ujkB5pZI_vW6iFYEMIzAHKYJ9weJemac-1Qg&oe=6A37EF13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
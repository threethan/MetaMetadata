h=00_AQK93Ci5cYwlsmIseoTKeDmqpsxXYFGpxcYstNocVdG1fQ&oe=6A9EB395"}, {"file_name": "cave.png", "id": "760251385228844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmF3DBj38_UQ7kNvwE5k8tz&_nc_oc=AdoNSuuQwrA6YpNcW3FqzQg0NsZo1HlMWU8MuJ7f-JDJ1YyrRX0IkHgScg6jk1uXpi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr8Kh5bloSd9aP3nxRzcY82qkuPIle_GqeH2MKx1Itsg&oe=6A9EC5B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHQjwKmZ5QMQ7kNvwHtyfF9&_nc_oc=AdrDTsjsFBVmTVFIgZsQisu4PcoCk1KNv6T866XHVNHQDps5clCz7YYndSmbHDo5UaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUS8X-0GOl3fx1qZg51_IUjHZ4LSWGBInooJOKB_ofdg&oe=6A9EB5FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYWnxkiz-mIQ7kNvwFjkxei&_nc_oc=AdqyXsRcxZH0do7Y5ppNGTgFvOOMEKGiGAkILdO033IHPPwMrLvHXxx0yseu7dwxbQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpBZKFr77b934E0al0so3l0_YSFv0D7WDx_Zxvkwr4BQ&oe=6A9EC699"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5s2EkkON3cQ7kNvwGS7N05&_nc_oc=AdrszFiKnLTQGoYa8Thksy1LYf6aOPXbgRH-2aa4qLmxDUdZZhdhSTrsla49o1S7_sQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_cAqCJ9H4UlBXG2Xp2cHeRZ80_OPbLHxtUYdwed4GjA&oe=6A9ED012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbS7QEKszfkQ7kNvwEvEmgL&_nc_oc=AdrkfweDpnVAMpNqIvDS7B5ZarCekLTZXMpD-xsGDwZSryy36vybzL0qil8JacpQrw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_6gU4fXxAUHJGE3sRZbAa_uakxeMKTrs-tOjwYFxy1A&oe=6A9EC413"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_ra
n.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7KDI8Yl0_IQ7kNvwER3izs&_nc_oc=AdlyyKnIxFv6m6OVqPfwWzhYX-Iozkt6R2dqWQ_P2uXvebBqCTE-5p_PCY1mer0rYuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfspFReQ86tUG9VFtuQwB1Rv3VN6WlGCDRXQFcIahLP2NQ&oe=69A98EB6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD8C1YdqNZQQ7kNvwF6PEik&_nc_oc=AdlrRMW5X189JSkIoGNGk9EawI45kKFnG10xNb24KEqVeVv5F4XekkerJ6bK4x60wKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvEkzJBDSsektCbzhWI6hoP37tYgPDHnZKeZeS1rCimTA&oe=69A97EFC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oki9UffXbFAQ7kNvwFyhVTM&_nc_oc=AdnXZKdKPvZ-4D4SmBQGTCgfFtOShRA-vEnoTvcfOs_8fDLaF6OSfYQ042iKjiQKBS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsSW92u0hNYBrdI_nI2Zrt7A9p337x42P22J8wBXhxHmA&oe=69A98F99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOkOdgZGXXcQ7kNvwFe7XTw&_nc_oc=AdkHO7HqgxSmequ0JMW9jQhStiFJCCcCaA2xlB1UbD-DTu74Zw6Lf96nqo2EwhOmVhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsOh5xAmzhDulssv8Jq3KPW5t38m_sKY99kMeXoEf1IoQ&oe=69A960D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL19Q_cmcS8Q7kNvwG9VtBE&_nc_oc=AdkKTq6OAphlNFhr3cY721ou5aUnfjCXwrkPbyxVSs2qU7_otdzVmQlpfQW7PAIyt90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvO-cMfzCt_HwZHlV0PU4Htj-nQiYWF9m464e2-_ZMbiQ&oe=69A98D13"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subs
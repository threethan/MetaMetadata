https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngwHGhUhw6QQ7kNvwHxWbX2&_nc_oc=AdqCF1bwl6cBD86bPpyidsVoUYijxaCvsn3_FpZBV4sOq_R38N8VW0JIm1oOm8NUWRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s0hvX0xtzQKmPjnKeonljdIPvuMp03ec6WTI4saQfZA&oe=69DBA7B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpuESGlW2LgQ7kNvwHQH1Qr&_nc_oc=AdrJegkgsNhjbrQTkB-Nj1eWhb_QOgk5WXpTZBEQphlQYZd3uCZLNw631uKEWQ0_GcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10GP8ek4XRPAyMJsXKv5lluuEX3UXoTcppR59ZeUhksA&oe=69DB97FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QlkzbbPJjEQ7kNvwG6o4vJ&_nc_oc=Ado9D8g2iUcV9gazHNwY9MwVpJXwI5MAr0AS-IRDkiUSfAM4bbKw78na2Kzdvmi_FdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08OM4VK2oxrc5rBaty2OGbWp_qyXH9BveM5FD1OJc4Gw&oe=69DBA899"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxD5lR4BziIQ7kNvwGdf7MW&_nc_oc=Adp53Slot3lwaMQehderwvC76NCH4hGQM4heQObqUAarqBEyedxO-URClnprL60uTWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QnUrAZ337Q0xIv7EwpkjeKFUy1EUwN52QCHcqPvasBg&oe=69DB79D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piPAKu6SK3oQ7kNvwFeZBkI&_nc_oc=AdoMVshCQ0-mgh2tPmsp5ChT86XBdkTU0Q9P4WcGYp9awOcSh18hNn0mwiAM-HUt5Vs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WTyC1wj7pEJXWjLkIqWv_5sxalCoFc8LybGZpRzCJzA&oe=69DBA613"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
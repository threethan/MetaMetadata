n.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a28KEmqO-hoQ7kNvwHZPNvb&_nc_oc=Adn2zpycJG87-q6X5Wzpp7noR7ct7bgmBgnxdk_le6bplfotMyvfESSMlYmElAuh8Zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfLH2gx2uuOvTmZk9Gyw_e_fiv4PtOXPF07rNfpCMuMQ&oe=69BFF836"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP8aysn_rnUQ7kNvwGOq_L1&_nc_oc=Adlz_xWofsqM-V8Qs3dvkCH7MpXBg7pJBOw-zxvtq5zrATM2o7dKWyS_fHAVbD6gteI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0ckbm6H23HwQsS1Juk_fw-_MLfIqc4bJq92vljPkVPQ&oe=69BFE87C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AngFMw4Ds0gQ7kNvwE27YnK&_nc_oc=Adn7dT4eIgdCN_XfgvUt8njzbFZ7AfdgTaD3ieau2mDD0A-lPWr-IhCy1TLReVftMFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOyUVeKOdwpOn19B4a5WY8fH_AOGP7lFdwTIx8u82Rhw&oe=69BFF919"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI7s_5RYw7MQ7kNvwG7sXVQ&_nc_oc=AdlkFzqHZvtgIWFGqiAWA8rsiHeRcJMViBSecxMvC1OsF1EEcyo7LABqUyn9_ANCpdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxwsNykbbipVX91dgMO3HkEF6mrgAowl8EhzhFKYa51w&oe=69BFCA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc7ylDru4_EQ7kNvwHGXVf-&_nc_oc=AdlL9k-PwVMaIdeHWxVnCkAcWb5cbwimqHMB3s4mSDPxmlRuMsVqWPUND2R_uzkuK0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHbpQkWzUA12cJbsOuioyBWJdvw536U1GgCWW3b3tBbQ&oe=69BFF693"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subs
Gf-ZVlPcdHxA1AdBlIU7FyLImZg5HdRaRdu2aY_wFBreciwsap6n_0b-zCh65v4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mY417Sj2w2YXzwlOOfwIEq5HP-ESQhG58LOGOcZd00A&oe=6A3FD9B6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQCagP5sux8Q7kNvwFVfzih&_nc_oc=AdqXOwkv_joamT5_XiAggWlE_C9N2HlWhXYhynwDzqZY9xBmYfudJZKscmr9ZDus1yU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86XAglfKjmfEoWr5NucbiPFw7neuWStkOsAO4hKKsG1A&oe=6A3FC9FC"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoNr-OCqWj0Q7kNvwFNSPIw&_nc_oc=Adqu3cNFMc1HzS0H7eeYeHZ0cuNOncxZdWOXLhpYHmTkhGGEbN3ZhpQw-LG5G1gcDWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CaBKr-rq45pbqm0RCPLqdKcOlxlKMatr8oGxf08VJIg&oe=6A3FDA99"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENZg9GjVjpcQ7kNvwGJgR59&_nc_oc=AdpLzlGxDNppX7HYlvAOuN5uRKlCswnkKFtENBPSXkBPdHxUHGzTpAWFEUJe77LIRIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YQlXqblyH7E2Ji9Lkt8e3m8qLMRzFJx_csC-1a6LagQ&oe=6A3FE412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyrdhQiSbU8Q7kNvwF_hhRD&_nc_oc=AdqwbeJaAH8S15wmy_m4nsBuk27eZVLsIBYgyepOSqlsega_nVI3x7aAfsET0-R9hQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yeIghWblnVgmFeWTscRzMDG0QPCEYOFSdPVtU1kRZdQ&oe=6A3FD813"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT
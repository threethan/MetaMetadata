: "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT6-WAxieGgQ7kNvwF-H9x4&_nc_oc=Adq6WCoTGbZxbGguvS5RdJVajctRtg78jyPmMzq_h3ZQgQMJHyfVN-RRK7I_k18aaGk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH04P3Q3_bLSFtm7nJirS3g6C0APAfgv5O4Bbvdb8uCSA&oe=6A7DD036"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ObM4GCH_fUQ7kNvwEyC8PF&_nc_oc=AdrEjCzYKoSoIOkPO5EhhYl5eiDUIfGo1EW27FotgWdDYJ1b2Nr3SWZMF6XK0tqHl34&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjV2HcBbw6lyKdrYSwwHbFPMfVj_IjOaahxE1arHeywA&oe=6A7DC07C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ2vFhoEf-EQ7kNvwF2lS3b&_nc_oc=Adr76dludxndFnDUtT3lQ05N95Zjiti6l5utilqsKX6tp3tYswjkD-GHqUe_xBQAhQ4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjjdYoUbKXTDcA_r8Fb_s0kvCkq7snd_plZdHDh_PHpA&oe=6A7DD119"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYqFnsPMhz0Q7kNvwEwjQEr&_nc_oc=Adr8YBwEVNoy9SPzJvWnXRaCUOsNZjaMvjUq8jPDdHgwzNib-GDZ_onIJTmTE51R-z8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0Hu3McQDCzNDUpRpr-O8tvsYJ7Bq6fllkzB2_KQcQCw&oe=6A7DA252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A8zcaK521EQ7kNvwHEPK2f&_nc_oc=Adr8uMyj1Q07tYmkGl90KlMv3mtzILWiLtnqr4-7paqJCg_o-tIcC6uVZUP-Lj7t31o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdAit0QuQsezcS13b7SyjQ0548HrCOcuAQLTreKLKTwA&oe=6A7DCE93"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_760251388562177_3336391765112991763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trCtrW2faI0Q7kNvwFOyWaD&_nc_oc=AdqWTe-sHSqAmV3Yn-JrF4uKklfE0YcKlAKt5ib5sj93g13imCl4yUeH4bhJWzKtawU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43I1D36CwoQ3C0aC7iPr1JLq1D3BiZgB-mQtSkNiEfqA&oe=6A01E336"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FuEQVnR9DIQ7kNvwHduPNL&_nc_oc=Adq41fvj4V4E8pzVHySDKOc-vW-e9GdeveS37Ikng-6R_vw8YMPOb4Qoka5GzumFdWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lk67HwPWdDRn8Yieem_s7IdnFliNee3Pf8GLxYn7SPQ&oe=6A01D37C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kuFpUGI4pAQ7kNvwEAEIZT&_nc_oc=Ado5XsMopwNKcIwv0VkJFIfb-ZEenTrykO5fM_-ZoB3b5BXvOdeTsVKsl0Fds_F02N0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ryw3H2D7CUxB7KlMBUGZmbKSXtjptBrJaHgh32hWDiQ&oe=6A01E419"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qAU21yLRGkQ7kNvwEEXR3u&_nc_oc=Adq5-MLvdkmYYv2-wur3GvEwfrOOPsztnYPvkzaY6l9N8OTi2K2MofeCMpZoyw-uYJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TblTrlmzat8DrSpW6GlrOTwQ9AL41DhHEfIHbRAlQJA&oe=6A01ED92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SucsHEUwBssQ7kNvwFH3m_b&_nc_oc=Adq8HhbyfwdfC_FrbzjPuMlHX5aCcYVg4h_ugNnevWjCi4mgvfNCH67CZFTGAPJChZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59wYHoutnrJDKiLisosfRFd9vgh4KhfNpQA4jinf6TJg&oe=6A01E193"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
MUxqlvIrHfmkR86282s7qrQEnMHilJH1d7ZG4fEBaAYTmQrTEh3VAV0uvZTzXOk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfBUjYwNkMPovKzg2UNztwZmN7Dc2T18IculNUbh7Oiw&oe=6A803AF6"}, {"file_name": "maps.png", "id": "608372290666468", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974854_608372293999801_5788358523878028635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9WDbbwmUOEQ7kNvwGCISpZ&_nc_oc=AdpHLOG5nbvj3gl9Jmet3gjstsDBty4Ok0ppggWGjxEzwcsq-4O1DnBDPB-0jF3xUkc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5srIYQBz_Tb1hGGaIWZsvGcPR2Dt3WXjc9ZBDKvNH6g&oe=6A80637C"}, {"file_name": "streets.png", "id": "1033894697292790", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75302225_1033894700626123_4667890290268657523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPralXcyA-AQ7kNvwHXvMoP&_nc_oc=AdqMCG73hp6m7YcP1dMMEEXrHm9kWNNyrHQFHaJPm6lBb-81bK47jWkUxnxQ0RA_aAI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdO-87dvUFZoAMaXQ-xAX_6XFFW5OsqeF0bsq_nt6Pmw&oe=6A803BD9"}, {"file_name": "sword.png", "id": "591042276014016", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974472_591042279347349_7213716853574671090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqc23j2eJGYQ7kNvwEXKAni&_nc_oc=Ado9TUMHvzjEZXrkFK2mqkAtKtFQk5FKZZjvdhwrAr2T2J8a5Zi7nxWf1c5gHHTVdH0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4mldn_6x7xK_IqRYWFcNaLAuF7ASmQyTNCyYPhj30TQ&oe=6A804552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer image.png", "id": "402794342036751", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568668_402794345370084_4685415045536699680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5PIRa1qjZIQ7kNvwE54ul2&_nc_oc=AdpBZa7jxm_RDRz_dqW7huydZFs-yFXgToi1Q1pKE7ZslJPZe85NmZqhp8QK_Z-FFfY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfNv-UPLgMk06G7R5LchU7viANDy1EDAzchu_ZOZuCNw&oe=6A807193"}, "display_name": "Blade Runner", "keywords": [], "long_description": "Welcome to Blade Runner!\nThe world is infested with yippee creatures. Emerging from your cave, you\u2019re surrounded. Slide your red necklace on, and retaliate against those tiny bugs. Smoothly retrieve your katana and battle to the death with those little fiends. \n\nFeatures:\nFight endless waves of enemies in different environments, painstakingly surviving every horde. Combat the king of yippee\u2019s Bob, trying to overcome his strengths compared to your weaknesses.\n\nYour cavern has been invaded, destroy and evade it to enter the jungle. Bounce across tree\u2019s and rocks to reach the streets, all the war cries silenced from the rain. Enter Bob\u2019s void and defeat him, no more no less.\n\nEnding:\n\nA short and simple VR game which is time consuming and addictive, with just enough replay ability to keep you coming back. Enjoy your time in this small little yippee game!", "short_description": "Emerging from your cave, you\u2019re surrounded by yippee creatures. Slice and dice the yippee creatures with skill and precision. Fight the waves of enemies and overcome the little fiends. Fight through maps that increase in difficulty depending on what map you choose. Enjoy the fast paced gameplay and skill this game beholds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/henryshark-studios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HenryShark Studios", "support_website_url": "https://sites.google.com/view/henryshark-studios/discord", "website_url": "https://sites.google.com/view/henryshark-studios/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT
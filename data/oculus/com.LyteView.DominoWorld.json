3-1.oculuscdn.com/v/t64.5771-25/473397287_2105297716567307_3323363346181883746_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaW3O_1pdY0Q7kNvwGiCp7P&_nc_oc=AdrSW-gGop2XiLwY28-BBZdg7RBFKNfzPvzfAYBYJ0elH0FQ5yNhOJANcsoFDBTT3wg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KShsoSnaNAsGnjgaeuOmM2uFfvSuR5SSzt6f5aaalmg&oe=69F21AE2"}, {"file_name": "Screenshot 5.png", "id": "610577148343951", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392122_610577151677284_6549756346433320285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZcmh7AIkJoQ7kNvwGLvHrb&_nc_oc=AdrniSRkpAr3BH55XZc1IBVzx24VIYkWOfp_-MW7rIaE4nfOnXhxDYGar4lpvb5K27A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2vswjwS59AEuIHmvaezf8L6HnScF6vSieq4B0iO_G98Q&oe=69F1FC2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art (Landscape) ALT.png", "id": "1940320389917099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299891_1940320393250432_1714067191207581016_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooDjacnvYH4Q7kNvwH0mrkE&_nc_oc=AdoBMMdc4zdgQELqoe7BGt0bXfULEhTVgc4Hp6_INLia-7ykimLVZ6WOk5aw9XoGt0I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xSmxR5XB4XSogxBGbrvewVi2wPWF_RD7iEWSHyym6xg&oe=69F200C2"}, "display_name": "DOMINO+", "keywords": ["domino", "sandbox", "mixedreality", "simulation"], "long_description": "**Using only your hands**, create complex, colorful, **domino topples** in this sandbox mixed-reality experience. Place, curve, and build amazing domino creations while channeling your inner domino artist\u2728\n\nDiscord \ud83d\ude19: https://discord.gg/gq6YQW9mSM\n\n# \u2728 Magic Touch \u2728 Update\nWe're introducing a whole new feature called Magic Touch! \n\n{553246637410691}\n\n# Key Features\n- Place, curve, and build domino reactions\n- Your creations are saved over multiple sessions\n- Choose from vibrant domino colors\n\n# Tips\nPinch with your hands facing down to create dominos, and turn your palm up to access your reset button and in-game menu! \n\n# You're Amazing\nWe are so thankful for our early access supporters! Don't forget to join our discord here to be a part of the Topple community: https://discord.com/invite/xAX9hJZSzM", "short_description": "Use your hands to create complex, colorful domino topple reactions in this sandbox mixed-reality experience. Place, curve, and build amazing domino creations while channeling your inner domino artist \u2728"}]}, "developer_name": "LYTEVIEW", "developer_privacy_policy_url": "https://lyteview.com/privacy-policy/", "developer_terms_of_service_url": "https://lyteview.com/tos", "publisher_name": "LYTEVIEW", "support_website_url": null, "website_url": "https://lyteview.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25393490203676660"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499292329_2120094235408455_8642540801824508180_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKfRsVsc5YsQ7kNvwF_Tg69&_nc_oc=Adq9njYfyWhPewfEYNN4-yaAEu_gzjAzdQrYnQQmd0qDFLqV1hJK4zHHd0Q3Dha5kVw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af29BdBa1w4oZV_jSTewcTUGklqzwR9G70KKwvblFJfOlA&oe=69F1F037"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DOMINO+", "platform
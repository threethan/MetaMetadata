hot 4.png", "id": "2105297713233974", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473397287_2105297716567307_3323363346181883746_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOVTbctBmzQQ7kNvwFDeoxO&_nc_oc=AdoXuQe91_m4reSdyCO1rDjNkc7nTTwZ1G7oQN98wylzWc8m9fDzhd2uZTahGKPtUdI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgCh2clOqnLfaQ4NDuT2icSG49UpDdq1OHzYZ9zJRTiw&oe=6A8EC522"}, {"file_name": "Screenshot 5.png", "id": "610577148343951", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392122_610577151677284_6549756346433320285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYHNoQkZyPUQ7kNvwFIVbRV&_nc_oc=Adqd8Xhbte5bXYOn8EXg3LDxJ4NHzpFvlhf0XC7rx5ppi0BXX1dBDatQGtgqmdY1LNI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMyVxbIKn9G-QL4HTJvYwTVikqURVc1VY4rVUTP6xlwQ&oe=6A8EDEAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art (Landscape) ALT.png", "id": "1940320389917099", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499299891_1940320393250432_1714067191207581016_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfL6SvTloPQQ7kNvwFVNCjV&_nc_oc=AdoOYlBzgXyxlAdTAOvqScc9-R-bBogr-9GU5XLsLHP0U684aA_VUhTU9-WxefGehWA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEh5bR2DFgrA9Sh7AKOVV6ivFxqg6GJIwrGqRn2_ZvpA&oe=6A8EE342"}, "display_name": "DOMINO+", "keywords": ["domino", "sandbox", "mixedreality", "simulation"], "long_description": "**Using only your hands**, create complex, colorful, **domino topples** in this sandbox mixed-reality experience. Place, curve, and build amazing domino creations while channeling your inner domino artist\u2728\n\nDiscord \ud83d\ude19: https://discord.gg/gq6YQW9mSM\n\n# \u2728 Magic Touch \u2728 Update\nWe're introducing a whole new feature called Magic Touch! \n\n{553246637410691}\n\n# Key Features\n- Place, curve, and build domino reactions\n- Your creations are saved over multiple sessions\n- Choose from vibrant domino colors\n\n# Tips\nPinch with your hands facing down to create dominos, and turn your palm up to access your reset button and in-game menu! \n\n# You're Amazing\nWe are so thankful for our early access supporters! Don't forget to join our discord here to be a part of the Topple community: https://discord.com/invite/xAX9hJZSzM", "short_description": "Use your hands to create complex, colorful domino topple reactions in this sandbox mixed-reality experience. Place, curve, and build amazing domino creations while channeling your inner domino artist \u2728"}]}, "developer_name": "LYTEVIEW", "developer_privacy_policy_url": "https://lyteview.com/policies/privacy-policy.html", "developer_terms_of_service_url": "https://lyteview.com/policies/terms-of-service.html", "publisher_name": "LYTEVIEW", "support_website_url": null, "website_url": "https://lyteview.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27653983780960613"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499292329_2120094235408455_8642540801824508180_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl8q2A8SC_oQ7kNvwFCZEMq&_nc_oc=Adp7n1fNTE9WV1Znq0xuiott9AVL2i8mfQfDlYtlUc1juD7GsFkM3vG-qzpd1NUjOeI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdfNGb40pfYQQUzA7voiISpiooWpcD
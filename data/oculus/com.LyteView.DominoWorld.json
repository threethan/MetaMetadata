3346181883746_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v_bObI_QNkQ7kNvwGGtyof&_nc_oc=AdmuXsXS1DmZixvZ5l6L4vSMqdfQaTn4ar3pACWNQgEp4iZdQoPuKYALL2kP99GCmtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft6aZuaQiK7W7JDCCw3hi-FiO3vlTqYymZFFJlVrGvzHg&oe=69A025A2"}, {"file_name": "Screenshot 5.png", "id": "610577148343951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392122_610577151677284_6549756346433320285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr4W_UN80wUQ7kNvwGYwo9i&_nc_oc=Adn_49YUygK04c2Yzmin75akBTLiy1dMV9KCAFjo_PIwBdG-L6iDDs7BqC2R1TzGG2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHqahkz0lpjmOdmkTOJ-bdcBiF_WcfTRHN9jFEneW1jw&oe=69A03F2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art (Landscape) ALT.png", "id": "1940320389917099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299891_1940320393250432_1714067191207581016_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7ihVQbgLXQQ7kNvwHsMnIc&_nc_oc=Adn63VZcNuiN5AILT7FSiwJQfrR9cy3TSIwnE3MZ2YBgQCq1oTnZWrhoCWMkr6jbWxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftpqZmnefD5D-fQ0zFOdI-lbmoB7ZPXcM0av-YrgF8aRw&oe=69A043C2"}, "display_name": "DOMINO+", "keywords": ["domino", "sandbox", "mixedreality", "simulation"], "long_description": "**Using only your hands**, create complex, colorful, **domino topples** in this sandbox mixed-reality experience. Place, curve, and build amazing domino creations while channeling your inner domino artist\u2728\n\nDiscord \ud83d\ude19: https://discord.gg/gq6YQW9mSM\n\n# \u2728 Magic Touch \u2728 Update\nWe're introducing a whole new feature called Magic Touch! \n\n{553246637410691}\n\n# Key Features\n- Place, curve, and build domino reactions\n- Your creations are saved over multiple sessions\n- Choose from vibrant domino colors\n\n# Tips\nPinch with your hands facing down to create dominos, and turn your palm up to access your reset button and in-game menu! \n\n# You're Amazing\nWe are so thankful for our early access supporters! Don't forget to join our discord here to be a part of the Topple community: https://discord.com/invite/xAX9hJZSzM", "short_description": "Use your hands to create complex, colorful domino topple reactions in this sandbox mixed-reality experience. Place, curve, and build amazing domino creations while channeling your inner domino artist \u2728"}]}, "developer_name": "LYTEVIEW", "developer_privacy_policy_url": "https://lyteview.com/privacy-policy/", "developer_terms_of_service_url": "https://lyteview.com/tos", "publisher_name": "LYTEVIEW", "support_website_url": null, "website_url": "https://lyteview.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25393490203676660"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292329_2120094235408455_8642540801824508180_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjPkh2zwkksQ7kNvwFATIqR&_nc_oc=AdmMyC_owVtxdQYIXiH03ybN5e9x6WC3U0bkgSzN35LIoIfBpMjKbcqpuQBgR9BKGr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfffIc6O8Psl1W-8MRanRVHK2vkxhwj7HhQullYIPy8Q&oe=69A03337"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DOMINO+", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592553
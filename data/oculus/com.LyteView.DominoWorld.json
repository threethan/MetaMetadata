ud83d\ude19: https://discord.gg/gq6YQW9mSM\n\n# \u2728 Magic Touch \u2728 Update\nWe're introducing a whole new feature called Magic Touch! \n\n{553246637410691}\n\n# Key Features\n- Place, curve, and build domino reactions\n- Your creations are saved over multiple sessions\n- Choose from vibrant domino colors\n\n# Tips\nPinch with your hands facing down to create dominos, and turn your palm up to access your reset button and in-game menu! \n\n# You're Amazing\nWe are so thankful for our early access supporters! Don't forget to join our discord here to be a part of the Topple community: https://discord.com/invite/xAX9hJZSzM", "short_description": "Use your hands to create complex, colorful domino topple reactions in this sandbox mixed-reality experience. Place, curve, and build amazing domino creations while channeling your inner domino artist \u2728"}]}, "developer_name": "LYTEVIEW", "developer_privacy_policy_url": "https://lyteview.com/policies/privacy-policy.html", "developer_terms_of_service_url": "https://lyteview.com/policies/terms-of-service.html", "publisher_name": "LYTEVIEW", "support_website_url": null, "website_url": "https://lyteview.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27653983780960613"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499292329_212009423
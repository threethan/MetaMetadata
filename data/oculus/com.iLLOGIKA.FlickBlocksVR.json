Flickblocks", "keywords": [], "long_description": "FlickBlocks mixes classic gameplay with VR to create an experimental game that's high intensity action and strategy. \nThe game is currently in a prototype stage, let us know what you think in the comments!\n\nGAMEPLAY :\n- Grab pieces by pulling and holding the trigger. Start stacking them.\n- Complete a layer with blocks to score points.\n- You will lose if more than three pieces are left on the ground at same time.\n\nComments, feedbacks? Reach out to us!\n", "short_description": "FlickBlocks mixes classic gameplay with VR to create an experimental game that's high intensity action and strategy. \nThe game is currently in a prototype stage, let us know what you think in the comments!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flickblocks.illogika.com/en/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "iLLOGIKA Studios", "support_website_url": null, "website_url": "https://www.illogika.com/en/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "518334799928870"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001726_656916192281531_2919887928020206642_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5o2r4RNj8sQ7kNvwFT8WUP&_nc_oc=Adn1PsPb14a4-I07cNhQd54P
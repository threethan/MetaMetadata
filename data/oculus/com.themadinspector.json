.5771-25/491830904_1122528957311391_3088068852478778711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hezH83cH88AQ7kNvwGPsMf2&_nc_oc=AdpT6Wz5wpX0dSSekrG7af-e0Oel8CxsNJzt6EVY44f8sBn2mrEBnZUcXPV6CI5LNSA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5NfbtX_jTdWVT6cVSI4Lf08lyx06C5Zq2mHgP0zs5DA&oe=6B0328ED"}, {"file_name": "5.png", "id": "4603221036606560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830576_4603221039939893_2234678918517109917_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sn-V9ZgwiagQ7kNvwH1ZEB3&_nc_oc=Adqdayygb-rjeBuygH5xXPKZj4wzNX2LCvjB4QzWW-woL_OMxl45kXw9YZsYItuGML0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlrXCp6ZrgWNC-lPC6P1AcLDPKiqo2VwGpOYWnzqZlfg&oe=6B030B3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER MAD INSPECTOR.png", "id": "1072796288967590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824671_1072796292300923_8763419037287287166_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70KlVnCZKl4Q7kNvwGYmcj0&_nc_oc=AdqG64o_Kqv4UcYJT61eJ5VOOPc2H1UH146agSs7JrDPLDkUs9Tm6b1tUTcu38tKUGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIct2xhHbZ8IhZTlJbHpHhqFcgIJ9hMoZbF0qBThfT0Q&oe=6B033956"}, "display_name": "The Mad Inspector", "keywords": ["TheMadInspector", "Mad", "Inspector", "The", "Simulator"], "long_description": "Welcome to The Mad Inspector, a chaotic VR inspection game where every person could be hiding something unexpected!\n- Inspect suspicious characters and search them for hidden items.\n- Decide who gets approved and who gets rejected.\n- Confiscate illegal, valuable, strange, and hilarious objects.\n- Sell seized items and build up your cash.\n- Upgrade your headquarters with new equipment and areas.\n- Unlock weapons and prepare yourself for dangerous situations.\n- Hire bodyguards to protect you when things get out of control.\n- Customize your character with different clothes and styles.\n- Unlock new locations and expand your operation as you progress.\n- Watch your risk level rise as your actions attract more police attention.\n- Survive intense police raids, helicopters, armed units, and complete chaos.\n- Experience unpredictable characters, funny reactions, and ridiculous situations made for VR.\nSearch. Decide. Upgrade. Survive.\nHow long can you stay in control?", "short_description": "Step into the shoes of a street inspector in VR! Search suspicious characters, confiscate strange and illegal items, make tough decisions, earn money, upgrade your hideout, hire bodyguards, unlock weapons, and survive escalating police raids in a chaotic and hilarious world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mkdl715.github.io/kaboom-game-developers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "KABOOM", "support_website_url": null, "website_url": "https://mkdl715.github.io/kaboom-game-developers/index.html#game", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1421554407698484"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/756589809_2013484966706095_8587504146567977196_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_buck
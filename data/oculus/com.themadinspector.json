.5771-25/491830904_1122528957311391_3088068852478778711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiGbbRnWpgwQ7kNvwEEjKbO&_nc_oc=AdqkGzFA54PrWeF7kY452JRrG1QvjMh1htjHzqEEEHiiIKVNWkw9yEHNH1a3vqisiCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGh261aszMEKRtm0Jo0Q_Nl4AAQ0dU_FNJwZ8Rkgj7XA&oe=6B0DB4ED"}, {"file_name": "5.png", "id": "4603221036606560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_4603221039939893_2234678918517109917_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_V48wdFxPUQ7kNvwEYdad3&_nc_oc=AdqVdA2O2GH_kEIGHkzjyuLVuRUujXoRsmAaL3AXpm3YUWxuQ05CstSHKdqaWzKYYPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcSj9-QTMbqhR4wuSM814BxPmJfHU9yOdPFuJ68R7Rog&oe=6B0DCF7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER MAD INSPECTOR.png", "id": "1072796288967590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_1072796292300923_8763419037287287166_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXhdJ9c1pggQ7kNvwHoekDg&_nc_oc=AdpU_V8jypVhkwZkiet2i_wUbf78fmzd3jpR5_bXsWWS6Rtf7K-fEK00JaO8bEh1bB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBfPbOt61KO_GFHEAZWVJC0kCEqv7Etxi7xgVDviQ1jA&oe=6B0DC556"}, "display_name": "The Mad Inspector", "keywords": ["TheMadInspector", "Mad", "Inspector", "The", "Simulator"], "long_description": "Welcome to The Mad Inspector, a chaotic VR inspection game where every person could be hiding something unexpected!\n- Inspect suspicious characters and search them for hidden items.\n- Decide who gets approved and who gets rejected.\n- Confiscate illegal, valuable, strange, and hilarious objects.\n- Sell seized items and build up your cash.\n- Upgrade your headquarters with new equipment and areas.\n- Unlock weapons and prepare yourself for dangerous situations.\n- Hire bodyguards to protect you when things get out of control.\n- Customize your character with different clothes and styles.\n- Unlock new locations and expand your operation as you progress.\n- Watch your risk level rise as your actions attract more police attention.\n- Survive intense police raids, helicopters, armed units, and complete chaos.\n- Experience unpredictable characters, funny reactions, and ridiculous situations made for VR.\nSearch. Decide. Upgrade. Survive.\nHow long can you stay in control?", "short_description": "Step into the shoes of a street inspector in VR! Search suspicious characters, confiscate strange and illegal items, make tough decisions, earn money, upgrade your hideout, hire bodyguards, unlock weapons, and survive escalating police raids in a chaotic and hilarious world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mkdl715.github.io/kaboom-game-developers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "KABOOM", "support_website_url": null, "website_url": "https://mkdl715.github.io/kaboom-game-developers/index.html#game", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1421554407698484"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/756589809_2013484966706095_8587504146567977196_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_buck
0xwG30&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sbSTCTtMO8K0VUSIuZU1qJpuWXZ3L3xXu_a8AKGfN3w&oe=69F61C11"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiamjyOKyDwQ7kNvwEm1Ttj&_nc_oc=Adq7EKbtmvyxVYO1uvmQC5_MPRJNI2JKrOvmP1upsFJE-prr_ys0mtRrD6ixTsW57T4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mnbYt6LtMnxU5Br_QTW5yo1TtLQar5zADQ3HNjWA2mg&oe=69F5FD8F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lJ9ROm8fNUQ7kNvwH_0sGk&_nc_oc=AdrNITE0-GHnLelgW9h914MQPqMsFzszr5IQAEUn-snQxqAMiIZk5CMuFfLtLXKX2Tc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3v06gPBYjJNpt1yCn_rnmBvDTTBGCSNkaw8aeyISoBmg&oe=69F5E947"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGwDc9SE9LIQ7kNvwHMKe1Q&_nc_oc=Adqbcl126WKbDaNpbdcx0q8kej7sunZr38aEeVdZzw6gtz1Wn603AM_qA3mfGQICtwk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JPgykLTlfRPD89waNpOKhJCQ3EjDxO08s0syfENQ8RQ&oe=69F5F4CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3bhetX563AQ7kNvwHz-oCb&_nc_oc=AdogkoeXPgN5jnKLyLZvXt-92IuZT-ia76uE2Nf510_LBP-p3UQmpn-juL6raWfYYLE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WBA1h0_9xgd4sT8XQj-afGWYWHzbCEQPVO9UeH4073Q&oe=69F5E8FB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
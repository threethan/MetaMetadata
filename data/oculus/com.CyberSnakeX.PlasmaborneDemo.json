0fvd1F5D8n5f1YhMgQ96RSvII4gwhq6fWWE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRgmSrQLZkgNuqnstPdvGBl5Kzl6RnEFUyFAIjkpAd2A&oe=6A8D8051"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkxed9z3JqwQ7kNvwFML6kQ&_nc_oc=AdrQ_OOA9my8VB7X-pK0w1wGyK1lbXFIr97LTgJAlq1MSxuiU0Z8BC4tSKq0SY81-k4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwBPUq8u_JWEfMXaA8A-6iw7Ldyd1-uZ433GGbU9U6jw&oe=6A8D9A0F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI6e7m1a1R4Q7kNvwG-t2Dn&_nc_oc=AdpB-OlJ0DTSh5_TclAnIkanZ__oGnnvh1RkcuoWFP00dpM7c4hG_SSI1zfD_J2KSck&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUXDp2RWi6zR7USCqVpcQ3hNWppXj70gDNAoHkVzGLRA&oe=6A8D85C7"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eHu00crST8Q7kNvwE31AOn&_nc_oc=AdqYulDYl1ZQVLQWQD6rat-MtRKiTlzh0nemH-VeyxKMyieYmUjcc1cjlxLtE7oqNQk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWR9fZAJbvjovO_JFN9KY4hC4jfBEPcj2Kr5YCaXeTHQ&oe=6A8D914E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUH-3gFRs0YQ7kNvwFdeciu&_nc_oc=AdqN67shUMUfNLIwks1Pifa8Inrx6nwX3aliblQZOsS72tCoSrb_oAXrjiLfCTJN514&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy3fRvNIq2mo1rnTwVm8t-seTHmnoj46e6ur2VCHjHlQ&oe=6A8D857B"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_
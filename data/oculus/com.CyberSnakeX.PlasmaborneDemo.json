NPeoAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQNwWArQJ0TkqYX0DereIEtI0bQ3OA9NVjaTsmQkS3Mg&oe=6A6C8AD1"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvmaRBFbfkYQ7kNvwGQbPFI&_nc_oc=AdoX5GTDgsF3Okj6f35EyfH9uMfa9rA03fQaC1mawBxlt0Az-0Oej93omdO7s_TzHNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA48Bj-bUiYm-9JnvvHyN9FC896UrImklvDeW8cIkjXcw&oe=6A6CA48F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IcuBtVXnZUQ7kNvwEyQa6G&_nc_oc=AdpprSqlcng1sq608fbDYC7iwUyv-zqVc-DFgTwwlbe8q9NWyRKzDVayltOkX15e8LA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbfRbgA1HWrKmbvXFt84VxTT2xqghgVlbzxOG3sHjP0w&oe=6A6C9047"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsCDjYIcjaIQ7kNvwGq6NGM&_nc_oc=Adorf-sTDiYF5wEDr_RVQSn_StCMaNqkCnyxHz-kb-2aRvhfbqij58AlpKB_PEkYsWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo2TFH6HEfQ2zkf8nhaJrRWc6W2mLsfQG8ra93crJyYg&oe=6A6C9BCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeAcyi1N-tcQ7kNvwGl0_MA&_nc_oc=AdoPd143VC8TnZyrzGX2PBkrbx_kM6nNFwapjoiTBkLY-enmxIBrBdHaUzEKKE9iu_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbk5mZuuf2UJ6YFgR9KJqfsoKaZ4vuFc3w_oMGAnbbVg&oe=6A6C8FFB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
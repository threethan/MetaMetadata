gabIg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x2rhd7_ASGqLHx82CqVZyaOEEDvRzEm2T1JdlY-yOCg&oe=6A19B491"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neMTCG4XJ0QQ7kNvwEBjZFZ&_nc_oc=AdqI91IvrjQsmvgXoywFcsSbYYHQ8hq6sR9Gnv-emJ8wU92ssd3wQ65n9USa9cOrt3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W0Jsldbf6d_LYkrKLccBpQsb3hEY9YmpQeaSdPCBJvw&oe=6A19960F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZRU7UKe9acQ7kNvwGJRp1K&_nc_oc=AdoozvJFNK2vZcP9crxr74sdMtEbMnJvnuaDwGHGKnmSz8QKgl0lETRVyqR8ZEVNczI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XVLCQMfvQxERH7K37LlkZTkA8Vqt_T5gM1tYzKCNI1Q&oe=6A19BA07"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu3ogL5aDp0Q7kNvwHbQRGb&_nc_oc=Adp3NFXKsfIcAYero88iHyOCrAb0qiWRiBu19aMBgzDlqYKL8sZlGAzN1oF4nACutqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I_O3lbXhkCr9r1wXWL3YyDWYGSmM26QYknJumL2cnBQ&oe=6A198D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=528Bpe7-0n8Q7kNvwFF2CD0&_nc_oc=AdrN9Z6aQoF9MeOM7xLnOSkWV7VraHTVdEqJAPDNLAZ7d7KTpmSS1Q3DjBWg4SePuaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KyoYwlel7Zx7HdUNph7qDsBM89iNDuJPyZDhnVB2QKA&oe=6A19B9BB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
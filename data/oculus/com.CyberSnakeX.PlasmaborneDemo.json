6821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-BEHef9ELcQ7kNvwEqf9TI&_nc_oc=AdmP2yTjYQl82JXRamtofsbD7yRsmWv20ZaLDBNHcG_enS1yCs-L3XptrNIirSLr2Po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDBIYBbbmoxoutG6DAT6ASMfyegI62xMbA4nm70umeNQ&oe=69A6E38F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk6sBbkWk_8Q7kNvwGPtdqJ&_nc_oc=AdnCKW1ShVtd6_R90n4rLzcnyTI5X1LQhpWvkHfhrUP3uLn15kcoynIiqmsH3HgkhsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftq7WO1Rz1CX7Txj7DSgm2F2XBzFUAVvdGYlBxrTm9VVw&oe=69A6CF47"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxn8ptd4lq8Q7kNvwGA4d-N&_nc_oc=AdmL1leSgVCzPYY3xOvEuSxELlRyYCeGRQID0mzzYH23pt4D4VpyW2VlbH94LIeMrb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsfy-y82Uakmhcwt8fYtLACk7Z7wl7m1lWRoC9zkH83_A&oe=69A6DACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reYB9NYvZZQQ7kNvwFtMhT_&_nc_oc=AdlNDnoIFupHw2MkUGgKEs_baT0AzHaODngeYkCw9rxs1QhqN1Jq3G_UejqiStIE4ZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afscp20MElpISC_sifkA4DUHDKSTGjOfoor5CQad-3HJfw&oe=69A6CEFB"}, "display_name": "Plasmaborne Demo", "keywords": ["Rougelike", "Boom", "pla", "UG", "Rougelite"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
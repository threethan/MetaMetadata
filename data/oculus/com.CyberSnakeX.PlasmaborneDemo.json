7EwRIA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MWLIOzIKk4f-K1waeOHTm28OWc6UZN8v1VoYYrT22oQ&oe=6A244091"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmydDpiah0oQ7kNvwGuRWef&_nc_oc=AdqiJB4dxBTL_AqIfndxtojlgDlying7iG5PL_FwW0vf7_4pJzgny-A5GN6qbrO6FWg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3ZFiwaFrT3YhlXwV7H5nKwTZHTTNLWsYyrnmWMuk7TA&oe=6A24220F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9sGCMaZe2AQ7kNvwHVVKPo&_nc_oc=AdqFP_py1o909GWHeTp5b9rv_BWrDNxIM6k7eICjgRbOzTbrpua67NWBR52572MceV4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wNkGdc6WdTsuV-2jkKsiyXHtLSqCtQtWRlnryIPNsjw&oe=6A244607"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGXDJlqR91IQ7kNvwFLXbZ-&_nc_oc=Adpz3mrgvRHm3ZybQmDFBXZ4386Wn920zRx1H73zhblAfLzpoOJWJR6EFz8tjJ7czc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ukkR_hIHBdJWUEfx4xeJg_PU4F5id8PEk_072B1MYSw&oe=6A24194E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qQotNXG6F4Q7kNvwFcd1v7&_nc_oc=Adoc6bM_4NWgjGRz99oFLPuSeuPomyHUG5JQJWeyk-A8WJSqh7Q61f2MZ59ioJZ1Rkc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HrF1v5pf_VPRaSahMO2fQ2CP0Aq-D4wVjKe6NLYoErg&oe=6A2445BB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
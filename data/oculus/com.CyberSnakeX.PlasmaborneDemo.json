tisvIM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15cE4WC3i4DjVutz4uqjIT-128k8DPbYZKvulAsZDmbQ&oe=69E21D51"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjkqNsQXAFwQ7kNvwF07XJX&_nc_oc=AdpTS6dv552xHmpMIGjDxTEaiLiw9x8oWUbZJKt20p5tXb4KwSfPkBNFN-FKu_mJuVc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12X4bTpgXC7xbO6fJMaSEmCvcxzoUoHmVVSZhftQs0lg&oe=69E2370F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geBxwHaqRU0Q7kNvwGqjoHj&_nc_oc=Adp2P97imRnDqNX6FB6i2TIQt6KeGpARLRgVjlJpsitPzHF6kNIy8dq5DHEWNSXkrrk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UYLHXaFgwAAt4iHbAhxFNXgDB5fvSfFp1fS0eri_8Jg&oe=69E222C7"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO9WVGUXgNIQ7kNvwGf83wZ&_nc_oc=AdpryvFAvOPpIzoHGjHzSTPgC-ZmGPQay-RfV-PIMRqs15XoxxKrrg8AhILeCt_mI-o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hwk5_7VlBdxoHxUarwFc_u2ts1Pr-VJHqxjNIYwjNlA&oe=69E22E4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_geAyfgFCcQ7kNvwFtRJi2&_nc_oc=AdorVvh-UKMB8xlrb3bpKpa56e7Ow5qf10cEaJFHy6eV1gsYSJfPmjsGIvxu1cZBwGE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26_rx1aWr3IhKXDd5-h3fAM4YekqGITrAf5kEtrvL4Xg&oe=69E2227B"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
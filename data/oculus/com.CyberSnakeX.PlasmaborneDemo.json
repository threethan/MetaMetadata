3RwMjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMHVUxS7Q9P8V0oo7Ih3kNYeqtKUux_zX2rPy1vlomhw&oe=6A4CE6D1"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvVzOHGqpGEQ7kNvwESc9B0&_nc_oc=AdoRKZnYfnacBITDufwofrgS9TsVzrMr5Inz4v-HEA6JVc_hF5Y8SfzLMundI0QX2DM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCERPUnpk1LbfWXqm90O6bQlEBDyirfXEGeWLZ3iQVUtQ&oe=6A4D008F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezp9rHF167EQ7kNvwEGJNsj&_nc_oc=AdoG84dMSK75VRngkn1-9d9XCTQIIzTDeOMGS2evCn6GYz0MzuFkieZK12Zpwqdw0P8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEMT8viUZtOmzJGDpyX9JuR5pgbKhZCAShI6xwivM6OQ&oe=6A4CEC47"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCHceisr3cAQ7kNvwFtqdg8&_nc_oc=Adopq33G6ty1KQCoSq1ErZ4mZPVbbVy2PrcmjNOTBH75ZvaTj-pHUSMvZffiomyk1bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADpAYf6nCSeRd5ufIyUoIaX4E052UaQCSpF-IMeZtBXw&oe=6A4CF7CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJiBq11ocBsQ7kNvwFSq203&_nc_oc=Ado3wIhjDMJI2D-2PfVIGhCIBX6FGciPKYHRWj-xlEF0fal_HqUxCrihCDr7cF4YkJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy4I7MH7apMc4SWEuHEDjWUFIh-pzXOfUXvewP3T4sXQ&oe=6A4CEBFB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
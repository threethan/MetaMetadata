7kNvwHNNIlj&_nc_oc=AdrOdriaAiOgBu7nfLesga6GrjDSN0phdtxmDC4I0rWtdgW3SEQGzIEdVKojhuvsXk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd1ACVwmmSO_3dUQHIzsH4v2RlMm09imXa5fCKPn0icA&oe=6B01BC91"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kobKDG1YrocQ7kNvwH0wsrn&_nc_oc=AdqmpCMccl165fmXtnwTfGzegu7KG0EhL4pb_Y_GqdzEUq7MDj-7bg0-WsOyHvGbm-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnvhOYURaczp94BMdhSArcbsFZ6ODUAvHjidjhOAMkwA&oe=6B01D64F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhLTnzdp8zkQ7kNvwH-rESX&_nc_oc=Adp9-qbLDN-ENhqECm35sRS9xIlqrvKH5oq6mEtfzE_EnJt5ZJMrRh_yi5PnECEgv14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9TtwZeHuURbUSqBaSioES4SunNXTwjh7llHkIiqw3Fw&oe=6B01C207"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uppgjiJYZUAQ7kNvwF8EV7C&_nc_oc=Ado8MUKjZ9aSp5nGYwCaIlEFnGWrdSFSYNxouSLz-q-VSpp8xg_xseoN3V1YTfYyViQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgeLqp7Uggxb1EOOO3fMWukvDwOaTzO0ZsEOYRTbIiNg&oe=6B01CD8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-kP1FORluoQ7kNvwGeK5qc&_nc_oc=AdpfGepYnZNZqJ3DWnF8XeaCTv6EknZQmnlrrHll0F6rb10pVDJEMJ4c3XbCNJ_3a1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfsjzQ5wFgqfSfyKQb_gvm5deV78Ze8N0YkJVuLKBnqA&oe=6B01C1BB"}, "display_name": "Plasmaborne Demo", "keywords": ["Rougelite", "Hell", "Demon", "FPS", "shooter"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26127664900235753"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_1608836930102450_5769176773139479377_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0ejsl66Im8Q7kNvwGaUQPS&_nc_oc=AdrfP5rPVIJooWLVfBLpibgY1nA4oVjOZi1KOwk8VINAQMLT1HpC5U5iTX7BEF0tjp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBWi0LTgvYAInG9-wjO18Xvjp0bz17rIcFbxTqBxoaWA&oe=6B01DAC9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plasmaborne Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1765994700, "lastRevision": {"nodes": [{"id": "25164829349852651", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25164829303185989", "is_first_party": false, "enables_
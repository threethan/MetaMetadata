7kNvwGLvM-K&_nc_oc=AdpK09zIUOivmX_M-CPq8sVkm-kjcoaH39LZEraymNxf-GfaKGBWdnR8OinM_ZduxLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPKz5liOP4osMZTj0OSkoBaa2OG6saVcdoCUhryHbJOg&oe=6AFF1991"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSfRsN2OjkkQ7kNvwGpxp4z&_nc_oc=AdpPL7OTxdhrYSH1bDfktMLXamkkf6kA4s896PvdJcO1T371xninEcHSZygNLN8r5LA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3OOI_kBYUDYt3TS63F1o9SIBCeEiE2sgSxUL5FiseOw&oe=6AFF334F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fCgo2QIIlYQ7kNvwEYAYJo&_nc_oc=AdrYzejDBCmPJZhhBiDqNf7nGA9AC7AFG23pPZDpqCifu5BLOljMSdnNpDNTJb8s1O4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl4HVwQ_t2vQ5T5O7nn-SWCpUCk3diOxWpPZtuwlusxg&oe=6AFF1F07"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uppgjiJYZUAQ7kNvwF4xQg_&_nc_oc=AdphY_h1rB4oB6RYdvRi285Vyoe5SKQbVWn1pNa749plECrF_X90vNh1wMmYeoBvVLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8RuPzPPv3Ow_ZFUD0RlfW9xv71n2T0WPacLQMHXYapg&oe=6AFF2A8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuNstTMCPgQQ7kNvwEg9IPR&_nc_oc=Adrc4X69mvg1PCeuoB0RGenpDuUmhslvdwXHNhzBDya7wr1MbHj3oAxo4BmlJJCFJf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ-DA9RcsY6KbpEmRKPnnxf0OmwZAR91LdxsCqo3X8sQ&oe=6AFF1EBB"}, "display_name": "Plasmaborne Demo", "keywords": ["Rougelite", "Hell", "Demon", "FPS", "shooter"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26127664900235753"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827611_1608836930102450_5769176773139479377_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0ejsl66Im8Q7kNvwFlbhab&_nc_oc=AdqSqWRJ9culi-ywkAKnevA_W6yNttmTg1djP7wIHCofqwzpYLkBcGNheQBmjyvX4os&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQksT3PFzmBI0uOpOohG-boTu3prvhM7LQDEM_NTVhS-g&oe=6AFF37C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plasmaborne Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1765994700, "lastRevision": {"nodes": [{"id": "25164829349852651", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25164829303185989", "is_first_party": false, "enables_
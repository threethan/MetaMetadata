0oCvxQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyQil8t2Odzi7xI3Bwn_j9-4ww8br5sGAt2LurXBxkqA&oe=6AA02D91"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6BPMWfSvp4Q7kNvwEkedrt&_nc_oc=AdpUOrkwWGbA2k_trs2ex3QNNgfrbjwl2h_bDZgD6WOEcNcnfCGKpK5HEcehoHTR9FE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl97KaQ_OOAXikZ7EyCsVR5_nnXhMMIjZzxqjrWDplTQ&oe=6AA00F0F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlN42Kk5eoAQ7kNvwFJ1k6I&_nc_oc=AdrlblvF_SA7eF9uoODE_83KMc7ApHXJCM9AzM2Ep1hIJkAbEuu8uDksf1HXTcobQhM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdKODYO8nb4wxwbUICsYk2sdGuOHlO3ueCn1TZ6hvo7Q&oe=6A9FFAC7"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsalLxEYZp4Q7kNvwHeJENj&_nc_oc=Adou0K_sdXygV66Lqi16qSI1tjprl5v1HS2Gsx8_4mMz8y0H6vUZt_gDd2G5vofYaTE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaOtmgDESjm6hRrdx8iJSFaW1MiAewkXMg9d9G-Z-Asw&oe=6AA0064E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V0ldvelQckQ7kNvwGoyaif&_nc_oc=Adq18ugy1P4vcofccZqQh5Eo36J1aUrfWG5mkBUfIThCIPN9JuEedlleEO9LLiaLovo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWmwIBpW--QE9ll1lDA5Z4EkK7ytWg8SiM3QO7b3yAqQ&oe=6A9FFA7B"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
7kNvwEvp7Uq&_nc_oc=AdqWw3XjDs4s-KCxvECB8mkXREJqD-dv6DJSyJVzt6Vlfyb5NZqudWVrQhqnUiJm_Yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhCw7iQCy3ltDx-YNBmhu0sbvywoNAPhysWnGslbwSUA&oe=6B0DD251"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rJb3-HJP68Q7kNvwFKSZpF&_nc_oc=AdokpxsOR2vHNvGs1zLH_jMX8oogWK6u_fgtB4EaYZL2v3zae-LkK969b1hSg99LaxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_i7gXolySavxy4zRAQGOxxtGf0NPWFPITJroA7DeKUg&oe=6B0DB3CF"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHIuPedwNVcQ7kNvwGv4Yzp&_nc_oc=Adr241Isuv1CWFmBojqiRwENP9Oj3qO9lq_11n8ZLUC3BZ7waV3E8VcYIUy7aIFHVOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQb416do02jMk8TC_2Z9Z1nJ7E2IvDRPIULUs5vchwyPg&oe=6B0D9F87"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4UT9OaEp3oQ7kNvwHwuUdU&_nc_oc=Adrg2FTEN4tKbI3lOPkcWLWGKobY0xp0V_Rf_l18MlsSH_Y1x6DVufpuaHZrHhr5e_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSOnR8aZqTplxAlyW7YzaDw78WvVr1wDUGRCLrCKhz1g&oe=6B0DAB0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XP4PjVd76m4Q7kNvwHHaaJM&_nc_oc=AdoHjTYbvV1AqC--nf4V5ZgJV_-TrRjye84ubke-51h6rzNM5cqVEcMb1GwWNTZrrsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhe_PtkMb-qUPuJ7EZY04C14YH-rE0xmrXjgLtjNyQeA&oe=6B0D9F3B"}, "display_name": "Plasmaborne Demo", "keywords": ["Rougelite", "Hell", "Demon", "FPS", "shooter"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26127664900235753"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_1608836930102450_5769176773139479377_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wORHFamh9FoQ7kNvwFU_L4y&_nc_oc=Adp1HbaicRW-abVX05WcyMJlRf89uQ87whLIxUiRA8W31xg059vm1J0BP0RXv2HAak4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBDxK0IOYrSUkZHZOSrjMAfQFe77_kl90I-SC1Tww-SA&oe=6B0DB849"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plasmaborne Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1765994700, "lastRevision": {"nodes": [{"id": "25164829349852651", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25164829303185989", "is_first_party": false, "enables_
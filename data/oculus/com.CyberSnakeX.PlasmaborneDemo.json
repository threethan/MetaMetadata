6821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-BEHef9ELcQ7kNvwFBxSRx&_nc_oc=AdkgQyxAKGW49x0HSP_KW6eLUjPwXVuve16E5oBV3zXGBcNscsjJ1HDHtHxTYfdskLU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvvlls-h2IAyULFAratsA4va1GpuKMliYmEvQGLKSqFnA&oe=69A5920F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk6sBbkWk_8Q7kNvwH8Ehlg&_nc_oc=AdnpuwNXYa5ftpbpSBeKkD8EskePHkOC832mcsbuwdqAPho8s2eEGET0lQAMXjmxTjY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuIrHlFtRgM7HGVkJAkKhGDPDzKJFRsyKGdOWbovXaS9A&oe=69A57DC7"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0ZvBnHiAAAQ7kNvwE3RFBA&_nc_oc=Adkgt2OGQSdYUOFrTujF7k8fLia2zZe8PVOvxswo8m3lSyr5BXXaZVY0nwzL7cEF3y8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvrGzompFkOxJU0fYEDMilt5KfadaJ83li5vN7qgLChCQ&oe=69A5894E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reYB9NYvZZQQ7kNvwH_NhbN&_nc_oc=AdnrTzmBcu_vxlbbupllX7zksJf9ZBYTqBsHtKBnpcvWhbNe7dWBlQ5t3EHlCmByH0Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv8fFzQfUv6GdrlFY5Hi2fr13Z2c5RU7dmeXdgLrgGDsg&oe=69A57D7B"}, "display_name": "Plasmaborne Demo", "keywords": ["Rougelike", "Boom", "pla", "UG", "Rougelite"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
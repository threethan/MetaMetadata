l8TY2y0eeDyI0XLR9HMw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GJfFWFgaWYH-a43QsyUF_iWGW58ngGdBF5HD3Uy2xXQ&oe=6A11CB91"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEcTEzUXFAQQ7kNvwGln0N8&_nc_oc=AdrXE74_rBQq_yPH0AbQqXFy3Pc8LunsVeAw-vmYwYKSAhI3XNB97WjcmE27770t8Sc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Li9JwYloUZfeCxec_W8k_5X8qSzODWPSyscrxO8bsuQ&oe=6A11AD0F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-AJXXdb4awQ7kNvwGHee_w&_nc_oc=AdpzJT5lRw8HYliy3mre82udfySPOudPstR2nxsyCzf5xLgaIzgwex7mrHZjN14pR0s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KeTLbNdo2sArAhRxcSQBLTdPMLmHGop5ozZQ6BwYYaA&oe=6A11D107"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwlYBocCYT8Q7kNvwH007al&_nc_oc=AdrD9d45N9eQs7wibJRs1EuZiOppsxnlfVPhXiFSenJ9fRYfwjE2oiTgdDkafD_G_ec&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W8QBdytzouoou799_CKuIv8YxsLX8nLZmbmR_UtboAg&oe=6A11A44E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mUjHnhskNUQ7kNvwEJERwh&_nc_oc=Adr1_37nhSTIpQOcZWbDAx9qDP6mmzQzBTPkKzyojWdN095HVwbbf5OnD1T8pjDzNHQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ITlyIknIuv8txBhBHgWaYRNwaXSoOMK40jpKBShvExA&oe=6A11D0BB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330179063317678"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25085534587784314"}]}, "baseline_offer": {"id": "25085534587784314"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765994700, "status": "PUBLISHED", "id": "25085534587784314"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25269504092718509", "version": "1.0.1"}, "id": "1581402739876414", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25164829303185989", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25269504092718509"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1581402739876414"}]}, "change_log": null, "created_date": 1765233618, "id": "25269504092718509", "version": "1.0.1", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "And
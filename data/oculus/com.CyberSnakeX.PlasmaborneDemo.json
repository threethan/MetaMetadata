- World.png", "id": "3396821733804461", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLE--60DqrcQ7kNvwGcUXZt&_nc_oc=AdozjPhQlDIQsXZo1hOAKd4fXfJgRnNTfs1IgXU7jZuOc9CTRndoI8VfHyXo70X7jDw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-1cEP-CQzwkBaEfkNbMgkvj51LuwvbN21wxD-lu_8_A&oe=69C3E48F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-HBqX1K8XwQ7kNvwEXhqwL&_nc_oc=Adr67x_Ys3maiKPJx_K8jLoe0pBNLoT9T-CT6absEXjz1qxFvESIUVewGvdiNfsoP_E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxh2zQAbfG056MowWBwFa8ok3yxlExezmIY-WqbwXAIzQ&oe=69C3D047"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apa5yEsYyWgQ7kNvwEvRQ9k&_nc_oc=AdrrhfdgEgZSxFzLhC0wQhsKF4VcK9uPG9R4vpuLi6E67JGgjP7Plo-gk7bYtoXN-g8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtOdtgFNUxpHR9A9cC37XLiolnpdlVyQhIHWc6Vd5Bbw&oe=69C3DBCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TJksR2DJmMQ7kNvwFkWQ9i&_nc_oc=Adqxvn0_dlHuNlJO15KTAgsjxH5VQa2u9Fud8gN5iK3laflKDoWclNH9rR8DTxpG3LI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBU27y7QG4KS-0jk0eeUWgRgbFGc2lfa9_wFtJH2RzuA&oe=69C3CFFB"}, "display_name": "Plasmaborne Demo", "keywords": ["Rougelite", "Hell", "Demon", "FPS", "shooter"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": 
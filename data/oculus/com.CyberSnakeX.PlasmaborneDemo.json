ou_ZLE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t_0zzE-EWJE7XXNCNOja5e5lJrtrr-xIel5ylRLb46A&oe=69D8E2D1"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftt4MVeIO7gQ7kNvwFb4eqQ&_nc_oc=AdoUoL1RZMKfKtF7BaiRE0zQ2ymRljH9p-lVSc7SuJBvkIA5JcRJ03fI8q62aGK5gSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wv-Te5PcXxf0EMGAuXEnwDhTOy7kiCwm7ps3wt-bkUQ&oe=69D8FC8F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLKyYMsF_xsQ7kNvwG6pLQ0&_nc_oc=Adoc3UexYbF_wB2CQZ81ZBr9dVA3_oIcmipZ_oIcoBuXxWwjSUWA3AVdZPBKRdRC0Mw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nsjKCukFfwA8CsG0QTv4XRTvFOlPiMFjiKpgQdAcWYA&oe=69D8E847"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaSfm1iVDBIQ7kNvwHxBDvP&_nc_oc=AdrrCryhmvIoxuI9HYZAyuI0dRjShlhWgZFNjH6q19i1y99NAOAk2YnQyQKa7Ljegr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01zLBUB0X92C5n9pqdekY2B6N8HZ4xx2NRhO20wCm4Fg&oe=69D8F3CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klN999Isl_oQ7kNvwHixAm4&_nc_oc=AdoJmTWIFMQNGyQTy0dV0lHfn3PVCkMhOpLtnXAFXS8YZv6VCQ-Udewm4PKDWsLfRQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_jWo72CnHYm40xxSARAnIBK7Tvepc9W8fXNQgoKtJqw&oe=69D8E7FB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
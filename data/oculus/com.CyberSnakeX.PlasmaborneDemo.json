RHruzY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o55apKF2XmV_Z9xpQ3sBOccBzZ-uVvcPq0UwYQe93BQ&oe=69E64A11"}, {"file_name": "1 SC - World.png", "id": "3396821733804461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHgxFxrZSjEQ7kNvwGLUDu2&_nc_oc=AdpPHgIfHMQzO3m1i_w1fj1D_5IDxxppUWy0lc5iJCbIZ7mNKhuJ8GAzmtxcKrlfRC0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MdHb6iQ-CzO6wjQchcR-xfEHZ0hAMp9784lpyRC3Y5w&oe=69E62B8F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oKM2juvN8gQ7kNvwExMlT6&_nc_oc=AdqLKDlGPjcC128ND9AfWNn7Trv55NMXLzadBkyCyPeex4_T-WrP8iXQuJw8xqO9szQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KXKC-fhPTtovkWZZFgOe1NH5c-s8jUrw2OJzj9xnn0w&oe=69E61747"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT2ZOdM381sQ7kNvwHvA4Fi&_nc_oc=AdoirwMsJt4_S_6MaQ08VDQm4TzmlCvWo7FCkD5wqhk8jpIWDMT6LfyO_UWKsm8-Tzo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lIL9Vu5QursbZrpooGhu2bObkefkINXB0v8xyq7y6Kg&oe=69E622CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbabR2544lUQ7kNvwG2yySj&_nc_oc=AdqVkRusnKcvh9LHnkAAWta6VmFKPL4CK02bSl7ou_GUsP4HWMc9L_2pg8nO1ebpyP4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q-b3rafBgw90qPVjikxFTzgehLZtmytOXw2I8xUkp3w&oe=69E616FB"}, "display_name": "Plasmaborne Demo", "keywords": ["Shooter", "Rougelike", "Boom", "Hell"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "
- World.png", "id": "3396821733804461", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_3396821737137794_340421123404825388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHUkYko5lPIQ7kNvwG3ttiN&_nc_oc=Adr_LsuovuvhkddrXSCdvmrVvg65w6aqIeTPZhhMdzJVuJKNedZ8va4elsQEE7Eqjv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d_IWeJyZECmqapBqQLeWXdaRgA22HRp6i_vrQgSyQnA&oe=6A37E88F"}, {"file_name": "4 SC - Rougelike.png", "id": "820505160792330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_820505164125663_7924103931815905257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffETTJJ-orMQ7kNvwHodxs_&_nc_oc=AdrAcOSd30m_EEsbu98E7wI8gh0cBZuiAbMyp3xxOkcGsSTPPKy4CHEYVnRgubwyKVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PeRhyQgp9lU3J8wRtrlFfqdFA4Ti9O_JNaQZDgBF3Ww&oe=6A380C87"}, {"file_name": "5 SC - Evolve.png", "id": "2249413632247626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2249413635580959_4401107030297838154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2zXCmI7rf8Q7kNvwFvMSpt&_nc_oc=Adq0Fjp4IkRWe6hD1qc1IFwcoKcFvFQ5pGD2_PPsP-0sWM61-WRacaGKSdKVwQJT5W0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sfoMmgzV_0rBVfkrA6th5CFleEJzRSY9edOgTVE3fOA&oe=6A37DFCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "832008162928160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_832008166261493_2325861839012386275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_Y6ve9OMFQQ7kNvwHalftH&_nc_oc=AdrxFl56VkD3Dzng05l1XRGPPXzj0lCoeB4JlFgYgdq9OS06tb_n1RfceSdWJ7wpGDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1ot_1vLoG2rpNdyMXE5onQ5E0f9ObA4J8-TV9S36X6w&oe=6A380C3B"}, "display_name": "Plasmaborne Demo", "keywords": ["Rougelite", "Hell", "Demon", "FPS", "shooter"], "long_description": "# In this demo version, you have a limited amount of weapons and abilities.\n\n# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{1551667349501830}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{1177653031011467}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1534745057571181}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1113144070708568}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://discord.gg/9TX8fvD62e", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": 
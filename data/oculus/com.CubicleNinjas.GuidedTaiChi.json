": "236895817482953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4utC0DNjVwQ7kNvwFugaK_&_nc_oc=Adm8ADehX0JQDntM_FNy5qH8nSQN4zszIEfK70ofu4zxddY0bdtkAvzi4HRnu6dlSC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsETnL-3hYJuxdyHBDdkH3RmsJP8ZrE52vACxYqOidjkg&oe=6999AE29"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHUVRgGl3z0Q7kNvwFkoPqp&_nc_oc=AdmzCBfJCJrGk1bGu13ZdBeCEr7LPc1mIb4HbRwtGgEM3SrBhop4XGWo1ul45Or2BiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4-ecbhqV5ilP6rVejj3pmsPgis_N1eLA7hgQEwSD2Kg&oe=6999AEEC"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLV0YcurNZIQ7kNvwGUSHza&_nc_oc=AdnGsgqlGP4wahjf3aA52mpalkHyv-XRmmpxXFpKMqUByzjfU5lvSC5pZz24y0IBliM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGV4J0uGSqn3Dc_ew_5d0YGsRqOTtqm0jSxH1nS0FQug&oe=6999A7F4"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swCY9Us4PgIQ7kNvwGdwtJ0&_nc_oc=AdmQewQFs-DvQ_U6z1FLjE7o5LTfv-n9Buxz6E3BzMVO6QFzCA4sU4wmQxCuWZuwfXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBREj0p7Smafg5NnVAeTUXQzc7jByfjqvHI81WhrtEDw&oe=69998E38"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNofPlHfQ8oQ7kNvwHG4Hdx&_nc_oc=AdkyJXzDUaePoA2zJe7vw_t6gjUKdImsCDL2BQ0tug_CMEHIOvNPtmH6MwB4ZdYu8Vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBHGw871an7p0ot0Dt1MTPUF5ms6yesb4OnviuStBhtQ&oe=6999BB3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmQb6b0fN64Q7kNvwHMkKJC&_nc_oc=AdlumzAURIKR5GkThrBFTu_vVXnmhIOLaMTVrRjxvXUQQSmUrgT6qFZ-tyNlbul-Ou0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLlmDePECVrWObgskZTArJ-XYbRvBJ2LkUudeUxUofRg&oe=6999A6E3"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU1CBx3TDPQQ7kNvwHVCgsj&_nc_oc=AdmBOeDmTDKtZ3gZoFR6KBkmP3aMVWVMd4dmNxGCgGw3JIgWBjyjXIjjFUwzbTdeRvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afso8bepnXSyQNC71NUvOXfQahUB6ZR_tYY4uGA_qOiPTQ&oe=6999901C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
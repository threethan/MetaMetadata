": "236895817482953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1JHlJSfs4sQ7kNvwFbSrHu&_nc_oc=Adl6t5A4zkVutCRDN1beFilVVKKBroGbid7qa0E8IB67q5oPGv_fDX3pUyl_OvwA1kQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXkGoAGu2eVIvfG1bInI7QI6I8oFJ1z6P3Fw0KBj5RqQ&oe=699DA2A9"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj8mr_YUzsoQ7kNvwFb2cEo&_nc_oc=Admoiw555avIMOh6PW1t6a5IMeNV9NVQ_H_3EuXhCMW7Ep9YcKAua07N0J0hb3CwUuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvjIum_yu_IKcEbTo4I6nMks87Adp0TwJIoSrOWo7CENQ&oe=699DA36C"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2epq1qRIC8Q7kNvwFU3uW8&_nc_oc=AdnDTxCkFNpYV0Amo0DhjL85V0-mdkYn-yEEKqgSxXa5AnVEMVHkv9eIMY61u1EB8qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsRjYk34jt5UXENTAXkeYW4sLR5_dszuBz43-6B2O_pug&oe=699D9C74"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOh6IdAEB_UQ7kNvwFcO0VB&_nc_oc=AdmuNpVHHi9060uXSLDBK9sXyFKbrcg3kBzLKOJdP9m3_kUAHdXlL4EFydoHG2VQgGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1QNqEYvVIjVvi9QCTNZW1zmO8ss0dBw5NN4cp3MZN4Q&oe=699D82B8"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXnsuseQz3YQ7kNvwE9EYZ9&_nc_oc=AdnYXgUym91S9nib9hrVQ15rqXTnldiSlB-nml_qD5UXdB6FZsrmb_cJWm-7lxAUFYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsV1W-kHQSsHUCPbWE8kQke8LwUjZQ0nkhW_60V7uPsNw&oe=699DAFBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QKHonYRyVgQ7kNvwFXKxao&_nc_oc=AdkhwCkhRedmRfeihaE-yamRO1foOl9anyNw5hTscTAY3XQD0TRlr09J4d22vP6FfgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnCabVXiTNSr7El3OZ_erVVQhyvGfs7H_KPO9WzkGFjw&oe=699D9B63"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23Yxv_CfuNIQ7kNvwG96Dhc&_nc_oc=AdldVczBZQEmOmqgk2QUk9J61XCvKIsKWbvFCGwW22Qtf8NVhkasHd9E2joHfJZg3Vg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs22BPHpaVb2Uu-wtOg60x7k0jmTfAJN-DePhkU7cvlkw&oe=699D849C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
": "236895817482953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XehWZ8-EbmMQ7kNvwGZ3sdM&_nc_oc=AdmD2A1ujkPb5S0-J9-YBtlYD6ofqHeKOICm1ZMrk2Sy0u0Au39babgPtjjlhMfwqvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmjUXe03vp-fK3bs1Jb5YPhe5ihRwcquGkiS71ehn-gQ&oe=69A6DD29"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn2l0Z_BIR8Q7kNvwGRyTN6&_nc_oc=AdlRV0_YoyEXg0VRT3hQg2J1pFAAdso4sD8n3fW-MQXMkAmuccZPhvV2Eups_CeD1yE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4XW_tFCRU15uXKsK8hpkCT6FzYDNHoKYDJDlAX25X-w&oe=69A6DDEC"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLJK09Z-4gsQ7kNvwFj5V5T&_nc_oc=AdnhAqtDyH2-ZApsKgDlNOoRU6UIfG9QYRVcR8lThhw0U-NB7TZvO95x-QTIYHF0g2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRN6fpbBXPyOy3bM296RmLbFKAl4R32iy_LU_GzbNFNg&oe=69A6D6F4"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p0R-nkSCA4Q7kNvwG5I9pz&_nc_oc=AdnsoxlObkzIpoq7WkvXF4TIeizfZRSv3GdVWvAj6XoHa8wbBwEbxwGJByIDGZAH7I0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvvQBObjeWP_l2Hyv-esu6O5fGXEuEHzAgtilG719-1Ug&oe=69A6BD38"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDQCosI4ZC4Q7kNvwF5Uqkh&_nc_oc=Adnk9UwNSsI9wUy6bDBBjK7Uyav7XA2E4oeWiuTl4b3T9CQS6YzZvsGByVtrhIear6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvsi2R50QCCy1Tf7SpuUD7pibU-JDMlYkvlCcLcXO4Wdw&oe=69A6EA3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGLblKXp-p0Q7kNvwGrjEZG&_nc_oc=AdnhWCEomARWsSZyPbccoedNVywqK6uXf1_Ule-FqoutQu51Spn2yv1Fu538bDoNbes&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRYPZymaWQjl3K5dZ7eEvTj9Mq94ayPXEjaIYjIH322g&oe=69A6D5E3"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuT9Q5787oYQ7kNvwHkDub_&_nc_oc=AdmuGSMpiK2uAWHXJzOvJej6qyEPj8DDfhrDYye5GV7xn4Gfh1faMhvAdTDtcZ5scMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1ytnWL6YVo6WApPG346axvwr8xSrMkWTo7pIa4Sti_A&oe=69A6BF1C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
": "236895817482953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XehWZ8-EbmMQ7kNvwGF6Sf2&_nc_oc=AdkO1u67EL9lZANUyDmGOEhOy7746tzT1UaN6W-qTtcEO4xRTQdCCmIihGZRQg-_u1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu3nNRrB4O7IzjnA7vU2YDiRw6nILOL8kkVBvQ6etfVpw&oe=69A43A29"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVynCHox7_MQ7kNvwH79wRY&_nc_oc=AdlTMlKRbbS6v2DFcyQj7JaWwuvav2cz71OUmuaLG9mFN5KxsSO47KGE5B9ehy0DOzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft9eQSsam5vGFzooIQ9FsoK_SEG2ehSnsC8A4-sY3ewbQ&oe=69A43AEC"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV-xdL1nWCcQ7kNvwH8jA4y&_nc_oc=AdlwDBDR1zVjfElBD_LzXrJMj7W_PL8aOP3El6Od6kNkUx2QCSbI-w5HPb2jJgF4ef4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsx7u1zWb_3fC-ez-KIyv5hsWVpHuT-e821hGqOVyIvjg&oe=69A433F4"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viIFV1UboIwQ7kNvwESOc4d&_nc_oc=AdmjxNhspFUMGQSmerK6Cef8Q8J5lR6VvESLA0oyZdufj6RpXpH3dxlG7swI5jJ8rUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuO91yr_TsQoNPkiK7rQrDtQx-l6MoBIGXrRerFtzRCyw&oe=69A41A38"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tAagBw9yY4Q7kNvwHiUXaS&_nc_oc=Adm26FhjcZX-DpBfgqQkCfc2UBRavsrse4dXYkeBHO1_-8znw-4Dsp-3r7Q_xNyJyMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftjIALv3pQLgebq33w0YFejZNZS4SrnsI6c_1nB9_GCeA&oe=69A4473B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87qPLym8ikMQ7kNvwGqknrW&_nc_oc=AdmJCBBWu_Ekceuz90mDfdRN7eTdtSj0M5uFDnc0VDF2vRlC3v_TWWQa7u5ewszAAF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsOUNVANxlcR8A8MROG0lj7hz0uNuoRt4KCAck45p2qWQ&oe=69A432E3"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPkl_wg1TacQ7kNvwHfQT1T&_nc_oc=Adm21-AmcthNtAY7GMnvks24H7uncttd_EN4TrJ8c9G74S6FmRZKo-cp7vdRYNyUB8Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afulir9T7GX2OGyjhjhgbRhEFPqwXjikl0TLGnE31zZCLQ&oe=69A41C1C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
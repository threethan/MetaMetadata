c_ss=7a30f&oh=00_AfxTdxYvI5OPijxOCl6HgomqsWleiEWx6wAMWguJK4GDOQ&oe=69CFB013"}, {"file_name": "migrated_image.png", "id": "1116274965383593", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982574_2249496035262963_8342485858036744192_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9x9_HiNoWoQ7kNvwH2muhb&_nc_oc=Adqyv1DaVvZ7jZZcugnKME87gT9ChEqPeT0MY7EpsJLOlxv4ItvFR19BSmVegxj2qbE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQdVf73YZsuC1qRjpuSMbjVP-nWjbt_kk4KjFTvxhRsw&oe=69CFC7EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/dodaJH", "id": "432161154034770", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031496_432161157368103_8346455610409091072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6WSTumWp4YQ7kNvwHmxQLr&_nc_oc=AdodMXWHbcBOOfU2wDgZ02voD7XmI7h6xHgLP-wWbtpbxM5SxrFScaLVuRpxEf0LvlQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOjw8lYaVcUfgDeMbIB20322c1jQn3tNmAQ8Qequ5iVw&oe=69CFA818"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Music", "Beat", "Box", "Dance"], "long_description": "Experience a modern reimagining of an ancient practice.\n\nStimulate your mind, body, and spirit. Enjoy flowing exercises, combining elements of several Tai Chi styles. \n\nDelight no matter your current fitness level.\n\n\u2013 EASY TO FOLLOW \u2013 \nNothing to learn or memorize. Simply follow along.\n\n\u2013 FIND YOUR FLOW \u2013\nLet go of tension and stress across 20 sessions. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed and energized. \n\n\u2013 COMPETE GLOBALLY \u2013\nShowcase your skill across 20 arcade sessions. Win points for perfect form, as you climb the leaderboards to become \"King of the Chill\".  Strengthen and tone your body, while relaxing your mind.\n\n\u2013 REFRESH IN NATURE \u2013\nEmbrace the wilds of nature, in the comfort of your own home. Select your ideal environment from beautiful, exotic destinations.\n\nFind your happy place.\u2122", "short_description": "Experience a modern reimagining of an ancient practice.\n\nStimulate your mind, body, and spirit. Enjoy flowing exercises, combining elements of several Tai Chi styles. \n\nDelight no matter your current fitness level."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361729819114950"}}]}, "scheduled_offers": {"count": 36, "nodes": [{"status": "PUBLISHED", "id": "937170582155188"}, {"status": "PUBLISHED", "id": "1510839880247517"}, {"status": "PUBLISHED", "id": "532647159779586"}, {"status": "PUBLISHED", "id": "1668224510782367"}, {"status": "PUBLISHED", "id": "928799306119111"}, {"status": "PUBLISHED", "id": "532557819745587"}, {"status": "PUBLISHED", "id": "1606135326908882"}, {"status": "PUBLISHED", "id": "612373616778000"}, {"status": "PUBLISHED", "id": "568152705365094"}, {"status": "PENDING", "id": "684423386884563"}, {"status": "PUBLISHED", "id": "332112291453306"}, {"status": "PENDING", "id": "1654275011740258"}, {"status": "PUBLISHED", "id": "8
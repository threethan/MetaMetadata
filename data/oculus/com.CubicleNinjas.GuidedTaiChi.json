": "236895817482953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr7SP9N7hbsQ7kNvwH38qut&_nc_oc=Ado3F8D9DZCd9xDr7N8RvwwPJ1A0eoE9dZFLkfTKP6h3cHcYvbtg2Bh9TFb1CIDKHHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af077oSE-os4hCkWaad6AYZ4-3HZmY0zAjUjdKmsENEOww&oe=69F0B129"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeJDmwDHgXkQ7kNvwGeXWNS&_nc_oc=AdqTlVLRECoehcW9kKsdRrJd3xmJDVVyuIzs6_kupTX_y0Zh9Scb_mT2Ut53W-3ChRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2GeHqiLa_50FmJekOO5ZziUUmep1B6MdqDT6PEp1KNmA&oe=69F0B1EC"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCHPduVvmBoQ7kNvwFaZbri&_nc_oc=AdrwzyRAcv8DguosamhKi2Rcnp6Yktm_JGST-jhqiLNDVXSDwZVXlm-Xha01WUDnsEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0LjWKqTEoaOwNkvzHwxn5D1fRIjlZsXe5HsqreP_LzeQ&oe=69F0AAF4"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt0iMRmRjaMQ7kNvwHK7XWz&_nc_oc=AdqVwnIl5IdrUw8YaVOmcd4HsyOBUrbe5-HjEcDs2835-95N0CJaFcRBDOWpYhHNPPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2zuRawEi8dbQwZhQfvCW1zAYG7Oos52_9djyFMcHMb7A&oe=69F0C978"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtoENlCI8IgQ7kNvwEtQCK8&_nc_oc=Adrw3oNqojslCbfrvQGNYl6ZqruRuV0i1JIlwi89D1Bn-Xg0ihrIGM3Gr4XEZL2DhTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1NJeXT5ZpDUSiHURx9Tf5lyUAShBDfQi7d-B-SXrrZCw&oe=69F0BE3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9JiREm05OMQ7kNvwHvocl8&_nc_oc=AdpE5Q2w1JzyRLW1vUR4LAImL6OYnTyofZOP3KsyL8RxkOuJHEL1nYfbZn4nlrBpiHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0R_WImz-H0u8NocrO7BOuPczseW-HOn1pwM0C614uEAw&oe=69F0A9E3"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVJb_Gw9u2gQ7kNvwFZ2q9l&_nc_oc=AdrcZlXy-GKw15peJ1ToXe-wrHtPw41hg6yySrd_xU9wucr6Ys3SMLYJ95QiF6Vh_88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2UTjkep_il6En1AIhydAb59qZBltFhbG4tRhfMdZ16Dg&oe=69F0CB5C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
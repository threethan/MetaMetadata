 "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "236895817482953", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr7SP9N7hbsQ7kNvwEQPSeV&_nc_oc=AdqvXgs7C_kLpi3MfIGqyq0wvAUongHfhEJTIQWQmJzYzdG_wxfFUy-LMulxYDyClS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3iw5pO9Tq0jOueOPYvzgcdoJJ9eYsXmJj-azhDHS21mA&oe=69F202A9"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDkwtjbnGwYQ7kNvwEheuQa&_nc_oc=AdpGmQhr-iXo7c83tQ9Q647j8N4z1piRq-vEhgVbiJHnR3y2jQoD4eDXNrVShIxjsXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af237saEXdtX2aQcc20DhyzpIzF-wWOcpo_QKngNsfRa2A&oe=69F2036C"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCHPduVvmBoQ7kNvwG5sDjT&_nc_oc=AdqbccJwi6DF_rReJITv8DcwQnxCBEXrcmarMy5-S564m5YP91Cv_1JD4qqYI9Pql3k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af08E_enhfrdxRiXDC5BzrWAAQNr8JoiI0dyzuuEBm7a-w&oe=69F1FC74"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt0iMRmRjaMQ7kNvwHr0Khe&_nc_oc=Ado-eFpNmsjmQFmWNeBAHtN4UCF-6pd2qSel2fzA3ObxC1hj7RaPeVEj_3qTkB6UjSs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2Jmc9gG8mo5QSuArn-yH3HDBKVwXPf5aGykJRB4bAOig&oe=69F21AF8"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXxvrj_I93wQ7kNvwHRqZpp&_nc_oc=AdrYBKwvkePs9VIxfJhdY-x53Fu6niZUU5Z-Y-8gYt-JNM2C8uKr07-O3wTADxgXw-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af11nMLh39FSAkHfkjNrj0Rj0maeGLEixeTigjl4jW3o7A&oe=69F20FBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oiCavgGoMsQ7kNvwGRDOL6&_nc_oc=AdrQGfAyKlljr8c8WXSm96chfJE_RiNkqkXEG5EwGsnBGiv3JBdGCKW9OQcQBYrGkhc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3LjYProRpB9p0pvxWsrQ12YPvkTy5IHwlppzLczHW8BA&oe=69F1FB63"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVJb_Gw9u2gQ7kNvwGv7XzB&_nc_oc=AdqlVe1m1iJ_vJVs4lkUN6YFLhRTIVkk6E5671RQIpKbAIfFu-2gU78_Vg7RXDMmzds&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2QXN5RsMG-QkgzdqRm3zcdkmw3PHVBlrOGrGFl1xPCHA&oe=69F1E49C"}, "is_conce
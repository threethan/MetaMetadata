35661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfzIFIGacF4Q7kNvwFB4wQQ&_nc_oc=Adr0U727_9KrCefVxeJAX0316Wej-vzfkuB8cNii0oq7xMMv7bdwM5BJzrwGYlI6YPU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CvDyOVPKsdFu5e37oxn6ZDU5OIz0Gi0pHpSRFC610zA&oe=69F6043B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6RBGBGJduYQ7kNvwF4HTvB&_nc_oc=AdorBR7G0SHlkVw_PF5hXPdEPFr0Pof63aIyvljKsoof8prsRfIUP0vq9KbjKvKfLxE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SdMgyEhFegFS2tgzvASR4cEG9jOMcOM8A-YZiVcPU4A&oe=69F5EFE3"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW96vj5REu0Q7kNvwGC2AuR&_nc_oc=AdrmdMqqQSKSgWhS0dyfX7N2HJcbieVarXYnoOMrxLafOJru
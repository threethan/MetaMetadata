n.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7kP0-F5VQ0Q7kNvwFvRrdV&_nc_oc=AdpsKUE1S6g1ttTfBXCtzDJHjPGp_pSdfnCJD2uLQFdN_Ka8_xPlnXVb_2SJQ4SuJL8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbg35z3tFD6Qo1YMwYfttU4rx0nBUMAzm3RIjMGh4a4g&oe=6AFF0CF8"}, {"file_name": "migrated_image.png", "id": "228176491665924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974764_337992383584475_1974009575317176320_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYx6vKUFXMgQ7kNvwGdr1bJ&_nc_oc=Adp-30cd5gcsE5gmuB-6Tlub8U0UXVqsIhsmIVwrhqbJURkEi0b6HZUGdjIHqsJgXLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR87po4ILkwGjrrEPElvrkfE7Fqg_MVWAHBZ5VgFDYG8g&oe=6AFF2153"}, {"file_name": "migrated_image.png", "id": "1116274965383593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982574_2249496035262963_8342485858036744192_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSP40qk2Wk0Q7kNvwGYHUN7&_nc_oc=Adprct73KpIW8Sp7OBgT_dXKhH8P6piWJzkbJBjtKjdagsWJ5NSLVCkTechpxJsx3qk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUGaGWyVA6RDCmpaWcNtPQKXlDVNyILxjQmBlxd8weGQ&oe=6AFF00EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/dodaJH", "id": "432161154034770", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031496_432161157368103_8346455610409091072_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ_c9IcqZ1MQ7kNvwFx55sq&_nc_oc=AdrU5DcpmZ8ZEIpXqrhj1BHd8nCzI3KjXEaxk29BdWByBsBNcPJgOq_xPDow56gztFo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbfjUhHFRV0CPUT4P2-IVtbyUZHSNndrVMUS3U5KI0EA&oe=6AFF1958"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Music", "Beat", "Box", "Dance"], "long_description": "Experience a modern reimagining of an ancient practice.\n\nStimulate your mind, body, and spirit. Enjoy flowing exercises, combining elements of several Tai Chi styles. \n\nDelight no matter your current fitness level.\n\n\u2013 EASY TO FOLLOW \u2013 \nNothing to learn or memorize. Simply follow along.\n\n\u2013 FIND YOUR FLOW \u2013\nLet go of tension and stress across 20 sessions. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed and energized. \n\n\u2013 COMPETE GLOBALLY \u2013\nShowcase your skill across 20 arcade sessions. Win points for perfect form, as you climb the leaderboards to become \"King of the Chill\".  Strengthen and tone your body, while relaxing your mind.\n\n\u2013 REFRESH IN NATURE \u2013\nEmbrace the wilds of nature, in the comfort of your own home. Select your ideal environment from beautiful, exotic destinations.\n\nFind your happy place.\u2122", "short_description": "Experience a modern reimagining of an ancient practice.\n\nStimulate your mind, body, and spirit. Enjoy flowing exercises, combining elements of several Tai Chi styles. \n\nDelight no matter your current fitness level."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
n.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKPNJdBQjVMQ7kNvwGTbnn1&_nc_oc=AdrI989ELlyYnqL3NMk6q1cVUM7d_99GGPvu4PVUFWWjWQcgqueJv9EKT23hm03ne4o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTFd9aWzTVXzOVt34wpcbhR8bfaBHs16trmyv95Lp_Mg&oe=6B0B22B8"}, {"file_name": "migrated_image.png", "id": "228176491665924", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974764_337992383584475_1974009575317176320_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oM5Qb6JzPR4Q7kNvwF3ucio&_nc_oc=Adr6K16yg9OiARfoHpjvNsvZ_fdiFwN5sz09EM-0aKG0N-3QVH2Th08I4-tcDo9EiTo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3eti1VYT_G2_NDaon54FhsFOLUcEmq5-apRS2qABA5w&oe=6B0B3713"}, {"file_name": "migrated_image.png", "id": "1116274965383593", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982574_2249496035262963_8342485858036744192_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOmkUjj-FlcQ7kNvwGzFmJX&_nc_oc=AdrB7WjRyOXF6jMjUreW5mvRtXHO7euYRpKpgUAvn0u4B_01syCQjXkqAl78yhKVN5M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5OtkBDiqfD2xxpu-4xqmaUdo8usroIjW6kA6lHKlPcg&oe=6B0B16AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/dodaJH", "id": "432161154034770", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031496_432161157368103_8346455610409091072_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r32vr-ptSgMQ7kNvwFRVuee&_nc_oc=AdoCvQZkrasJh-smddO289cAniWlHoiN8xEtrSGlcqIIqb3t0VKaovslkWsmdY9lKJo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFrWkUjz_VRgk15CFYe4xkF5Nhf8ob6NUWKRcCnFITtg&oe=6B0B2F18"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Music", "Beat", "Box", "Dance"], "long_description": "Experience a modern reimagining of an ancient practice.\n\nStimulate your mind, body, and spirit. Enjoy flowing exercises, combining elements of several Tai Chi styles. \n\nDelight no matter your current fitness level.\n\n\u2013 EASY TO FOLLOW \u2013 \nNothing to learn or memorize. Simply follow along.\n\n\u2013 FIND YOUR FLOW \u2013\nLet go of tension and stress across 20 sessions. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed and energized. \n\n\u2013 COMPETE GLOBALLY \u2013\nShowcase your skill across 20 arcade sessions. Win points for perfect form, as you climb the leaderboards to become \"King of the Chill\".  Strengthen and tone your body, while relaxing your mind.\n\n\u2013 REFRESH IN NATURE \u2013\nEmbrace the wilds of nature, in the comfort of your own home. Select your ideal environment from beautiful, exotic destinations.\n\nFind your happy place.\u2122", "short_description": "Experience a modern reimagining of an ancient practice.\n\nStimulate your mind, body, and spirit. Enjoy flowing exercises, combining elements of several Tai Chi styles. \n\nDelight no matter your current fitness level."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
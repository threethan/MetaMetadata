": "236895817482953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4utC0DNjVwQ7kNvwH9-0ui&_nc_oc=Adnn2jKBNjZlNp1MwVdgnMUY_G8rtzPd8O00V8jcu-e3Fh1lN0bmnz8tz3ItyAWNjmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvPG8u6e9Qobqy6tdl3pV5Z54h0l4uod_J1OA-DvIYydw&oe=69985CA9"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHUVRgGl3z0Q7kNvwGeR-ak&_nc_oc=AdkoGKFBQifQqrjO0fOSfZ1nUx6AxjLPrvR_7kf_9ctpqGnEuEK0Guun4KHdOpJsqbA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsOajXF-AkpJYSFBoHrhADhARAAtkm7ypCRg9Y1vDOg5A&oe=69985D6C"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOCOOEF_smQQ7kNvwHfO8Wu&_nc_oc=AdlrfVkVoxVThM_wxE6Xlacvga5l634B_LRuvJ1-9SP2S2ObVaaClr6CJUVdPKhN7XE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftCEAA4JYhVmkiiXWpdffhGP6qL03beBZxB_7CD6KWMEw&oe=69985674"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fTVS_k1RmMQ7kNvwFy55bl&_nc_oc=Adkkh6_6pwnTgVi6qp1cVifeL0zFyQjBZH5jfoszMG9rKCtdw-3t_LFi7EtE6h3nMcI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvr5-CQAMlulgZ5eiEhyKoT3z0MPGv6v7GWkSiu1i4Zqw&oe=69983CB8"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNofPlHfQ8oQ7kNvwFNJaAr&_nc_oc=AdlEKH2shwAEITjrd2VEu_ntibhFB67O1fJ0bEHHL-tgvBauZSsTPukXqQMB78PK-EU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu3hLZx6czv8eaULjIFySkXQI8oE0q3uwl5ErmXATtGrQ&oe=699869BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmQb6b0fN64Q7kNvwHe9mzd&_nc_oc=AdnlxMVw-E0mqWnn0rBEfazqO5YV2nG3lo0L8UxZcIYSl0ZP5n1qvWC_QxwhhdGY_KY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvza5-FpBVHepyDCXOAIJQKE67QQe3CGsED3HRR6bM7zw&oe=69985563"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgKhyco_MWYQ7kNvwEYe8yK&_nc_oc=AdmEi0RsS-B4JBNYMxQ0gH3ivdKjxab_eYpSnFU0Bv65x4YO31eFdBBmUOHAZxgBpHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftu24xNYlZdEr3ycCD_VsAd0F6QP4bNMDD5gEoeCsQ5Kg&oe=69983E9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
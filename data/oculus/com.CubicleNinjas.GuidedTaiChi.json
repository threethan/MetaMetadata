": "236895817482953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4utC0DNjVwQ7kNvwHS5TsG&_nc_oc=AdkSvnS-xU-6wylhGESDPZT4iG1gpaUIc364phh18U5MzfjrPFuER81Y-t-X2fllJx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvMn4evF4g-2I7JmvcKVqid3ckBLYIbs8hW9TZv1QxgiA&oe=699AFFA9"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj8mr_YUzsoQ7kNvwH2X7bS&_nc_oc=AdnQT6hYh1VhQNzDuqy57nlESt1paCICtLRCARjP75wffCZUXYeOEmUkEnsCLnn-D8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuY4dRmEfhe37KCSZlBeSc_tEJS2KScz1uUZrFQkUabNQ&oe=699B006C"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLV0YcurNZIQ7kNvwFAe4Nk&_nc_oc=AdkeFP7T5am5XRPVzau4w51L0olbxIgX61ro0Z9GX0B1tdvUwVeR7siumsjZ0s6I7ak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQHYucJuNwbNPDcmfb_TEF6LZrhbmvj_ot0vbzi_Lfnw&oe=699AF974"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swCY9Us4PgIQ7kNvwHceMm0&_nc_oc=Adn8kMjMhGBKdQmD2hjecRHAxTb5QHbLoyaRrbrMQi0JdCxdBO0hnxp51XPzN0GzXFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvQ2Jjcmza0S5Q23Oxw6nYOd-9TKma5I9RkP9hwHAiRqA&oe=699ADFB8"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXnsuseQz3YQ7kNvwHj2RPG&_nc_oc=Adm8Pgo_sQo3yE9O5G5S5KYDFodTzHK6nrS8NBMw-HjVTVVl7UgbpLGHn4GiANWzQis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfujXJCjCk9psgfpBkSDJGeK704dirAUMMl4Vqe7S-i_GQ&oe=699B0CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QKHonYRyVgQ7kNvwHmaFas&_nc_oc=AdnHDuLU-yTLwqsNyHurbbmPt4csNzqMAVfMi9KCFLryWGPDIKJKzaigYuRT4vKSnGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvvUh8736kl6OXpTjOnMrA-OTqsAtNCvytuhEBdhZTXeA&oe=699AF863"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU1CBx3TDPQQ7kNvwGQ-RvX&_nc_oc=AdlGSu8S4dllIcMemnVM3GO42zymHNgP5P-uFm6HiWNNkomPMDV1c6xhRtwOZ76S5X8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsNcz_DEsp3SSI0K53eBI3x4ZhplNIFd1W8Y7wFrfyK4A&oe=699AE19C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
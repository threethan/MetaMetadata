": "236895817482953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974604_650815918713515_4747787562033086464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1JHlJSfs4sQ7kNvwEMnGUL&_nc_oc=Adkcm7o6ZWl7ghhKOCPTMxyG4z_0LlI9kq-cJXBOfC2hxu43y6zTwe5SdWSjFEnFUJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsc5g0DtrUTzSqQ3lrWgS7-sDohdHx7aX2Ksj5lF5ceKQ&oe=699EF429"}, {"file_name": "migrated_image.png", "id": "207631153804216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001708_320588665300148_2755073941012742144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-kD5y6w4I0Q7kNvwFiEpuF&_nc_oc=AdkEVlu3EnZJZb76fOMQxP7KBNkrfOOg1S1q3wMtTVxmyqe3gQpkBAhQ04TZaKEFwCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvxAEtY_H1qtXkAca9VQe0fNw-8pqtCVG_uHrjHsAVTzw&oe=699EF4EC"}, {"file_name": "migrated_image.png", "id": "678952969510990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982598_555799771491968_7250800188955033600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2epq1qRIC8Q7kNvwHzkRJ2&_nc_oc=AdmhvWJj4LPeqU6s76xOnYRm7vJeBw7l1Myfr8CnLVqiMaCPPHsoIKhlBVHtGKIbBfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAcdmxPp5Cl4Qx7u7ogkh1CkfFIf1kvxyYfJLX9Il9FQ&oe=699EEDF4"}, {"file_name": "migrated_image.png", "id": "3080701558648594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_329045047783680_4621363911185137664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOh6IdAEB_UQ7kNvwHugMdb&_nc_oc=AdmbM1yvkmb1k07jf-d9KM3KBa4iQB3WP-yBu8cM-TV69y3D-COx6ZoC9HLX_LAaaDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuzNc1nWQiq8HcynAxckrU4uuRb7XEAvQTjvpXYNklLqQ&oe=699ED438"}, {"file_name": "migrated_image.png", "id": "633071960586503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_335661294031414_3969392226454208512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m2OLIs16OkQ7kNvwHrlNbX&_nc_oc=Adl1cbAzlQ2yzzdviVI6qun7_vSqfhIQzg_JEe1Xk1C4LUVpT53OzWkhjqQDh9FICm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvF3TmjBl5T2BntLPvaTGKP0LSt95_AmQ7nj9Emk8GB1w&oe=699F013B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "R9_CN_GuidedTaiChi_StoreArt_Landscape.png", "id": "6912460408877843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312296_6912460412211176_4329566381264264877_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlEBN4jrzyIQ7kNvwEVpC45&_nc_oc=AdkuJlZznad_HyyftscvsT1egLwTcTKUCKz5AOawbJ-999Tfy478Z2h-T3r50yjh2eE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuamji8b1-PJDG4rvvizW12P1lMwktWvBuUJ88uay7p2Q&oe=699EECE3"}, "display_name": "Guided Tai Chi", "keywords": ["Nature", "Fitness", "Meditation", "Relax"], "long_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts.\n\n**30+** environments. **200+** sessions.  **100+** relaxing audio tracks. **ZERO** subscriptions.\n\n# \u2013 MIXED REALITY or VIRTUAL REALITY \u2013\n\nExperience a modern reimagining of an ancient practice in the comfort of your home in **Mixed Reality** or **Virtual Reality**. Train in your living room or deep in the wilds of nature.\n\n# \u2013 HANDS or CONTROLLERS \u2013\n\nSeamlessly use hand tracking or controllers in Mixed Reality or Virtual Reality. Embrace fitness however works best for you!\n\n# \u2013 BEGINNER to EXPERT \u2013\n\nEngage in practice across **3-minute** to **60-minute** sessions, in one of **30+ custom environments**.\n\n# \u2013 MEDITATE IN FLOW MODE \u2013\n\nLet go of tension and stress across 100 meditative sessions in FLOW MODE. A perfect gateway to the concepts of Tai Chi for beginners. Find yourself in the flow, refreshed, and energized. No fail states, just gentle guidance.\n\n# \u2013 COMPETE IN ARCADE or WORLD TOUR \u2013\n\nWin points for perfect form across 100 sessions in ARCADE MODE. Or challenge yourself with the randomized WORLD TOUR MODE, a 15, 30, or 60-minute Tai Chi endurance marathon.\n\n# \u2013 CUSTOMIZE YOUR SESSION \u2013\n\nMake your practice perfect for you through highly adjustable settings. Optional foot, teacher, audio, and vibration refinement to fit your unique needs.\n\nStrengthen and tone your body, while relaxing your mind, in **Guided Tai Chi**.", "short_description": "# Refresh your mind, body, and spirit with 200+ Tai Chi inspired workouts in Mixed Reality or Virtual Reality\n\nExperience a modern reimagining of an ancient practice."}]}, "developer_name": "Cubicle Ninjas", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/97894149", "developer_terms_of_service_url": "https://guidedmeditationvr.com/eula/", "publisher_name": "Cubicle Ninjas", "support_website_url": null, "website_url": "http://guidedtaichi.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8549144421874291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974755_1321364545680266_5360027727921371724_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23Yxv_CfuNIQ7kNvwFpcx6V&_nc_oc=AdklBpOhBV-hFVIn4X-nEDD99Play4Zc5NKxaiBdDZxb8KAhFaBQn6Sni7Leh1mlmh8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsaVWonCVgMYzDVqUzS63UR946f1y_69Dkf-T9KhZKLxg&oe=699ED61C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
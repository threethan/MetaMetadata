_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3gdU4EMOKQQ7kNvwGmXU_w&_nc_oc=Adp8EuDqEhhv5RL2LouyCfcDkzLlE3QYEHRogxkDewGR4JkJVs3v1o0KiaTdGuN3afQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ9JjRTtusqxP4qt6LN0EYHGFtcE2nVo4ePXNKixqc_Q&oe=6ACE44E6"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUYYK0u2TBEQ7kNvwGwafeh&_nc_oc=AdpVT6_jRmQEStM76DnjwJS7AJqjkv80JE-5-uyC9NrFCgdSDUL4SGkWpAPOj5qFv2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXdj4dCZwSF2UVfxZoldU2iN5O61Fo_IR6GctG9yHcHg&oe=6ACE3992"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIwNM2z76DwQ7kNvwHyaAIU&_nc_oc=AdoWiIsfEihBSTypmbV-cZnlrMaYOJGPv5s13upIrTYMrQQMGoPd60BFPklWM5GAZ7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmn3WK8HCErKVTt-2_vdTpy_viZkHFpjfT52_F5eok-g&oe=6ACE6759"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwb5F1M38aIQ7kNvwG9Gtez&_nc_oc=AdpTRomMONDRFffmYMvxUQjJi_12D-RmdymnJ8c7qQPkG0ARqzAAY1sqn89RezqOmzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFRYzBPaWm9w-ahcGWEwfr2QNoNK_H4KedEJfMM0pX_w&oe=6ACE627A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISIjAL7xBmwQ7kNvwEhTEUi&_nc_oc=AdpRgl3Zk4MZ0Lrph1zptPx_OUM3MHFhmNwkHne8Yd3LSZ74xFWZc5uoIyVXF4T4zfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6-uVamY1f8bvSOA4_IdIIrm2ycGhuPHKMD-b6_jZWXA&oe=6ACE5344"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
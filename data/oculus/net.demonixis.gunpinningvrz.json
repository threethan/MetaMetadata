09_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sexF9LaA344Q7kNvwHePAZf&_nc_oc=Adpg8693nMOW-Q5_j2JVNgwE5Gc0DFZip0taDqbJuy2X_tMR1G_Tn4nFA_yGBrb_6XY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKviaVeKwz-Kt6ww4NOFwMWEhvYAl_FFrOA9cEiTdxjUw&oe=6AA414E6"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I4y_2cyvKIQ7kNvwHU0AOQ&_nc_oc=Adr2nFwDHjFQ3ofXvs58exNY15h0YfXONNqqmwHqaY0SqdccKrGlZcjlwmobuNo6cfE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg07knWsoTRGNJlvQarDhC1n8ZUXy9Hv94lfX8fTq-mg&oe=6AA40992"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkhcXxbHf4UQ7kNvwEG0Vew&_nc_oc=Adpe0UcB4HGS6UIbHSt1fr3P2x3kIATikEof_rW-kr-tZRLEti7MqN528hzq6Jn-NuM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhJSaK3w80so8ZCQRkaLfR_QX338JPBXOzr0X2VUFhJA&oe=6AA3FF19"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDQnwSR8fpAQ7kNvwG1mzjr&_nc_oc=AdpIpdc8MqRkRbIyUuqBPJw2EzBSgSfeePpVUa8dy0w48IhB1cG8viCXTgtprE0YDUQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-a56JqjCr126PujO8eSq4Wugd50dADDIN0nbJBsC04w&oe=6AA3FA3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JB0Cg1yA-kQ7kNvwGx6yau&_nc_oc=Adp4D3JV2U3QZO-y1BqgiD0HnBZ4aA_AgKpHIvvjf3iS9ID7108Orp1jgveg140OkLQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfPXKUu96fO_yg0gYRmxAjykD3ai9fwvL16uhGhQYXhg&oe=6AA42344"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id
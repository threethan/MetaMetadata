_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VHizYbOTWIQ7kNvwFOJeQC&_nc_oc=Adomi6b5UhYKqulIuDmT-hp3EzEoyTyhPtW5w_BBATs3ZQD60S0SAyd25JT_fTc34ww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLvvLfvY09wY4v25dvrqTWyCE9pFjIQ1WPvo7QOWi8AA&oe=6ABA7E66"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0AMmogy6ncQ7kNvwFjl4jw&_nc_oc=AdozwzRQcSx8e-tGL45W4JcWh_56xZZ_AGk4fsplSjrK2O90dqO3Mw2Fg8hp40prmZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq_l5Cxv2vMAvPyOg_H-7p1BP2vBLWi1hirxGhCqypYA&oe=6ABA7312"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obSJjdydA4gQ7kNvwFe7seT&_nc_oc=AdovOBLC_Jhbzbzk6S3unyK4eio2OshZRR5gPPPMUK5L2v2g7uwyIQ0Tt2F_8OdOA00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfZT58d7ol6zqqDphqkX_Dqt1v2wh2-u2uKm4WzC02kg&oe=6ABA6899"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCQZEVBNmU4Q7kNvwHRa9cF&_nc_oc=AdrOCJjjXQceLwkDtGzGJZbdZuuXoAhdpZdcjxeTLslLIlhlGIsw5aNu45HjjlbmRkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-h10gqEuoDIxCHCdkIN6C1SkAd7gzX20T0gz8rtJnnA&oe=6ABA63BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtWSKRgaWDoQ7kNvwHAKE-m&_nc_oc=AdpohSDgyKoIISbgFXUgat6F_MZaELyrmDrF1i3_OasYQkz9ybMm1rJQIg0yNt5_eHA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0YbtWXHM9hQCQWgew7hMtZkG3_Onfmz-uxDlA3T6F7A&oe=6ABA8CC4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
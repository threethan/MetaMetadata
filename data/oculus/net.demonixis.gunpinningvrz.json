09_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zugL6T11BccQ7kNvwHJq7-N&_nc_oc=Adpe4BJwEh1b1M6u7d0ZsyTpcyIrHNaRDK_21H2qcrSMc0DYLjPLLye2jPUFkzMkRCw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dPN0kNwHWBPi_M_-sauITZSa1yG9OjXRXjlUmBIqQuw&oe=6A11BE66"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IzqsNi9-QEQ7kNvwGc9Jzq&_nc_oc=AdqU6EsOK3nBJEn_8OVjPIXu_Yo9FCmZJ3fXpN4bdix7dvzogMHr7ywBBwSqRL1h9gk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gl4mh5VzLWuYva9B4-n9MkGidBtJuwbVwfgrgxrnGbg&oe=6A11B312"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QS4udhOtFMQ7kNvwH0s7Rg&_nc_oc=AdpftR4yX2muQHxjcLbM0HzDPXHGVh-O-slcXUbn8lyTmHhlF7CV84Gpu9IwZYFf4f0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G0QByiM9YsJGEM40uiUnY9FXPT9_w5T2qV4W2V1YMBA&oe=6A11A899"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2RBNKS2RMUQ7kNvwHK_sz_&_nc_oc=AdozpPb9VILKe3-6_kmp-WpgcoFnSGntHuQws22qcVwJGa5Akp802HEvOePv7TAXKKE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tuHb6Ia6nB-G4O79FLjsk67em58eek-y2GEXcodl3sg&oe=6A11A3BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGbbMq_rxJEQ7kNvwHBF7VU&_nc_oc=AdoE2n8zPoV-PbzCLgjVLXcAdFlPp24pjIxwj4c3M7Wv9OUK4SSoxOVibRmfiluL8jM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jvNIUv7nGbvm0qJuOlrUdL-AF1fqmLkOiwG3LDPouxw&oe=6A11CCC4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id
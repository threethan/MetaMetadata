_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhoOn8T2WpYQ7kNvwFiLC8k&_nc_oc=AdrDi2VC-PiqFVes_wNV9LyYFAatKa4WbE-2zO1r29TX7kd6P9IBGLia7JpDpCOxMB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhHksAV-krDoTMYoLu3BrTVQJimH3UoCPi3g8dJ9hsig&oe=69CA8D66"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HotIbhD7-kQ7kNvwEiz2Ii&_nc_oc=AdqSLFz9XH05QC9yW8MFcpkcmnALZ-I7RMy-zYIMGFUlWQBBQmw0ixjc0Fj46cy3JaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAFEBoQrUSQEQ_73eGqWNnzZadEsPjsYiz5IXvo6kLnQ&oe=69CA8212"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmEUQWAJYp8Q7kNvwEx4OHW&_nc_oc=AdrJlMBSkRpF_v1E_N-nznAw4YVoAm5vbzPEiijNN14kokJg5cbUznZjYhCRnA38iY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnEKkWz0hl6uvw2zBrbAa0oAHcw_adhVchlOeDDy18vg&oe=69CA7799"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKt2oaEcetEQ7kNvwFK53T5&_nc_oc=AdohTAhsulPo_Ye5TrfyNxoMH0HJcf3z8n0jZ_q7eI8ju8FSUEXNo_MAky4SshzLxx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxPPYFgvsflsHsRZG-3nML8QBr-uvAE7zipGvzvWa_gw&oe=69CA72BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j66V1ZB15pQQ7kNvwG8f2Qv&_nc_oc=AdoUFIloLLHgfoNo-BMts37a7mpMb3IcweCx7yoVQlgK5k5vKKeXeWrJztKcFCuaeXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygfWpLl_hyZlaNPZmLVYB3HgcVjImapOr21CcwKEOpDw&oe=69CA6384"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
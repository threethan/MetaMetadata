_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_-H0-nwx9sQ7kNvwHB5se9&_nc_oc=Adpri59zH4IOHh-aJI2mfy786BfgjQW4stK5moq8alHaelLpbYSwtKTHLUpy4HBz9mg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fJKGkGlBeUcOEhBNlK3cnko4nxE-zrdAY3FM1kLdCGQ&oe=69F8B1E6"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_8VgURbcGwQ7kNvwFm9_9B&_nc_oc=AdoLhozpSORoup41pmWU2QFIkkjaHSTs6xpM5YAkXxWstZ5y9SSottwyiI9s_WXJd3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39nyZunGTQoAGKoZeUF1IVBgchet8_mbyBRJ6odmMavw&oe=69F8A692"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz1PS4xVuCsQ7kNvwEufY_3&_nc_oc=AdrmDZTR6Hc4ta0Q5Fhht4bQkDar1FLGD45r2QJfr0h8_lw2pn-mNydjlGfX2q8j-a4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3reqWpRR4LzAS3L0D3oDXHBUyESokIWehPOCAf_3dukw&oe=69F89C19"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3FnOMIcVHkQ7kNvwGveGhz&_nc_oc=Adq9VhDdbDDfxzChmiMP16BUmrNyocBOjOcU_7u5gS7oomTY7GDi3NAez154GOW_EPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oFe9g9vQ8WT9YXLl4S8BtVFgO21BkgXw2NJDU2xPDiA&oe=69F8973A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwScufdVYH4Q7kNvwEogGt0&_nc_oc=AdpmP5oZX5YG2Qs6qCCrXFbug7TpcDfOz5Hjf546CofQOV1VdL3dcX-nJs8xTiRivq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZxW-ReLPflUtrd_v5ou2kJ-OOKa7k9bpGQVE9ZP7Kzw&oe=69F8C044"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
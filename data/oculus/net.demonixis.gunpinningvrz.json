09_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ylpGUhhxhIQ7kNvwHA0Ajf&_nc_oc=AdqEJwlqP1Gq-XUZBhobDYFwFu5w9f7Z9xCL9KH4xhPVFmFFTjKG0Jk_WB6Zh9YkPVk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_yxPTwsK4eyFcKONN3PewMr0HvELCnAV9LoHrgODiTg&oe=6A36A866"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IhUADBKmDoQ7kNvwF8ibzY&_nc_oc=AdqVlyvu_L8T_cTYV0q0_4iESNiGDndk1ACMzwi-n8AEW2rlGLPQLQNzc6dPcAX5qE4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FoVTJ11wwVfRZKdnVsyt4qBT1fdVzTm7FznmFC6fIhA&oe=6A369D12"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Orh3ieWdHYQ7kNvwH0ooGa&_nc_oc=AdqtizJkU8U6bFkZjUQSnNocsx64waVql6VRmSoaCFrz3sjmrD9wVoGeMg5f0trFgyk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v8UyxhupUv_aHUcZn3ygcqciraeQjRWHz6-MDV1TYMA&oe=6A369299"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heAPGnIyKB8Q7kNvwEbRSlS&_nc_oc=AdoMm_NEd2R-N8gGdnfU51HW9kSLg4rOYU917WJUWJJSxBa6x6zqDBcGo73ln5pOTrI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o3hN6A01qPlL7n7fOqJslHSheCMWOA0H_5lRqx03-HA&oe=6A36C5FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POLYx1Lg-V0Q7kNvwH-ZKn4&_nc_oc=Adolt16K0q85HsXLu-6puwKe8NjSd4tJDRGe0FgQNwRX9TXGoZJW_R-aee3TxqUx6k0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K1m5-wl36DrB7H9Jv4D8xwv34uw_9kjXgUknv_i2_6g&oe=6A36B6C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id
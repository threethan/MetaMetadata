_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TarYsudkBykQ7kNvwFxEvNd&_nc_oc=AdrSSgvJBXGKqmDpO28nMhE7AttqEgUdIfyhbjsf06SoJHx0k_5up1jll_ARVNuXs_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ok1iPczty60Hia0NuqfxotZJ-1pTbLxjoJMvZl4IeYA&oe=69DE53E6"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sGHpagm0fAQ7kNvwHwmOUz&_nc_oc=Adr17NuVt2LxItYVUfCSacPC2njU8lkb0BQxLQSQ6zVL0Tvsn4SwyxkzH15sCpBkRCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af377fPTk8MIrfa-rc-qEvyEo5D5peEJI5Ag2YVHy0P0lw&oe=69DE4892"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwFTL2Rqu-MQ7kNvwGQxGGE&_nc_oc=Adoa8d56hvyCkUQZdc87ZS-l_WuuZACm57pBhvOAMasjrkKOXDTdcmmyi6aIFEqmB24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-FkrFbMTNS0wlta_ENAyVSdo_alzlc8q_cO-wCcvujQ&oe=69DE3E19"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRsbVPj1KM4Q7kNvwEJ7Cbt&_nc_oc=AdoXqe0i4RsCThMojbXu1pP2UeZJ8rifGPl01I9cY5YfV4zwSxmwbQrpA8i3yoj1LnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QaAIOxKpHWbfyFBg8-U6vUefwFY2U27URf6yQXIBAlg&oe=69DE393A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuW5poLmIDwQ7kNvwG7C5Ct&_nc_oc=AdqaMghH4e36SlHVCTpMARu4G5aWBjbCy2ZcGt5_bEpQZ_hwmn-tXM7woBndsls-bJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aFIxizHLW4hjhOaG1M82PMz4TtqskTPnml2OaFMfF2g&oe=69DE2A04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjOZDRikEU8Q7kNvwEVHw9d&_nc_oc=Ado8tQ7CfJr1EoJZffGIcgAKyko6i0PQFpwvnMSgJKtoS76atzHfE-rTJsaI_IYAvlo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3ERvfHKJzLfE_rRyCm1pIFyqRFveujAI7vYuae0Zg6pg&oe=69F1F084"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date
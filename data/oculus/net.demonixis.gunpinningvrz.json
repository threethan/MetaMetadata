_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2VudfHJONsQ7kNvwHmQh_g&_nc_oc=Adq-qix5C280pB-4KtiOJDlweiOq0Wvy5D9k9Y8KBBMlmqY8ArN9I7vFmIPsaffglmc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7APiSPPw8e10XyW2tkMspPalM-j6ZfN7SgK4bubf1ng&oe=6A68C166"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7l8W6lnLbUYQ7kNvwHswkey&_nc_oc=AdryTOId-FlE1HhP93h4itDqVBqlZqAsUve6fTbsxIJ76dNxlGOcVjuLLwMs3yb4eo8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ9nhF089_HXxNs1fWTvaQnBXlzNGdwgEPywxyI-1CwA&oe=6A68B612"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reE1ix_h1ukQ7kNvwHlOc5N&_nc_oc=AdomORm2OD3EG2yzWJlw-osj01qJB1p00QZPVQRs7cBHO0suRDEgzHpRbpy_Gnlx5ps&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGJyLvSfFxV1crhAOG3h0nh-MRktGyYIz3POxBa3zYfw&oe=6A68AB99"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmQn1O2dnJsQ7kNvwGfdppZ&_nc_oc=AdrFJIa99FsqRPgCqKlSZjlfW-LJsZaFDwS4BO1MT2jn9fBFpLDmFJuOnDqAnOhKDF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBdwrDuEVjYdsFv_T4NEoeOws232qPVfXbDIzTTZsmPQ&oe=6A68A6BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hnvR-jN0SgQ7kNvwHOYSfo&_nc_oc=AdrXh8QvNZKdx3fiewsPhr18Qk0mTdVJHGT5U6nDxome3QQp3byOmWP-DDMfO-h2VTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCRSkh2mxRwxu-lI8YEGEGM2u_MBdLsmHnjK73p2GIlg&oe=6A689784"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
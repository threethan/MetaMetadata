_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57xFrtmN3qcQ7kNvwFrT7gv&_nc_oc=Ado5bmlmvNwkNT_h_a61J4oPdauk4GzFrPYFStNJeRv16imSE37MSfcrYDhuUl17VmY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ENL8aC3HJ-zMr3LqEDmFW2dFbkvktabcLvOpPv9LNtA&oe=6A073266"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTr64hfZTeAQ7kNvwEB1d1Y&_nc_oc=AdqXIl9sYfAxVuQfAUui8NAJwIoziWf4MB2nbKiad3llIWwiZAFn_yJ-JRc7JSv5lY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fNft0ubWb5LowBXafhJE8qgYvs90cIjNFJ2f1F7aarg&oe=6A072712"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjXZaRv5sFEQ7kNvwHh2zqe&_nc_oc=AdoQ0eyY5jWLdVHUnLqHrV_x8Lcv0NRvOwBD3V18ROb5rTUyrXbbJ6vV5XZRElHt6dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52ErZHeQuvJu7cmUNHnRNGkRvuePsQKCVVqHolSpRXNA&oe=6A071C99"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGZPHk0UfNsQ7kNvwGKI8ba&_nc_oc=Adq2fNwtOkg0es1sL9EQ9DypOHjhXfgV-f8kiNGDhmEE8s4xNMRAQnbhG3oXWzk8SYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51G-jcuQ1nuCJYcyAzANvlRtLS4NYn5mB_tNvApgthcg&oe=6A0717BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqKpfkBaGi8Q7kNvwHxc-Gi&_nc_oc=Adr87MfXWpwpqELKp98yMFckOseks9OdpH7N6H_8E1-JomBn7jYFsUoxC40R0eClacA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cb-Bs0ur32fF6veAJWfjfR8LbxYAw1DPbzgx-6QwvVQ&oe=6A0740C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TarYsudkBykQ7kNvwGyVzeV&_nc_oc=AdrcNkwlgkHgPMCWHAi7G66VVFTLTGYgIEy59Py29BCfMsGlRVjNSrPeuJbNhs466ic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w4vZIrh2sBaNOjOUWtmqunldYz1BqkzFs01QV7y6OGQ&oe=69DD0266"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sGHpagm0fAQ7kNvwGnZ5PN&_nc_oc=AdrwB2MxQTCmOr57lnvBptsMhNrvyQmOzjdeuXwZu74CCOcqGb1PpuKMU5_zMcVNKYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w01XmfwbEM_s9JhVaCulpMpKQEzvguiOyOrpxpYONiQ&oe=69DCF712"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwFTL2Rqu-MQ7kNvwHJg2FI&_nc_oc=AdrW980XvqAWPZGe6Z7G3IBR8fF_ehs_pQn0a5SOj48H_Y6n91P9v9phmw6KCvcM0Ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dF0xR7Omcl7fq7n9eENbCG7GYivdFgK5dezZ6epyetA&oe=69DCEC99"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRsbVPj1KM4Q7kNvwFb4osi&_nc_oc=AdrylDeV2e2uFtKf6X7p5ONTThEPe6F2CMWzot-4MnIXvd9iZtY0DAmYK3LtIwETmls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2554UcciRli526SAmsU7zQRW46G1zD2mde-1RfrQ4Opw&oe=69DCE7BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tm6pu101oEQ7kNvwHkKugq&_nc_oc=Adrd7AdD-2QrWb0ASytP96GTEu32wnWdz8gMjC-aamPd2x50gZgTxP9ah7ZbVHMxlOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fXj6J6niKYKQM47KMCJoGqpZnEXLTn1vFu58f9XiVqg&oe=69DCD884"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
_5190339344893981110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe4C8AU1Hk8Q7kNvwFZ_XlW&_nc_oc=AdqtxAjVRUDGWfVmp30CZ9cMm88v9__RegCFfp5_PyIdiUgVwUcOu2ZStHproiOmImo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52g2f0pZuFAYE8UHHEOhJSnw1vM45YOVGlFA7NyOCCGg&oe=6A048F66"}, {"file_name": "3.png", "id": "659803678458063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_659803681791396_862883438020201007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTr64hfZTeAQ7kNvwHhJxiW&_nc_oc=AdquZWFawJNklT4RsvWlTSS8uPh4i9Prfck-UH_0z3Mc41Gol_AJh2CAEzeD7OsIadI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F6JSncRFZ6B-JQ7-KlOlWtTZjg8C3W85H0D4H_GzbBg&oe=6A048412"}, {"file_name": "4.png", "id": "686098865867599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_686098869200932_1903108384804015389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK9ODVAg-QAQ7kNvwEeQ_5O&_nc_oc=AdoB8hd8Nu54cmMVyNDnZkNfGJj71pz9UvbdglsSeG_N93Z3PMluFLQYuXBuNbYlvgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S8jVUpXX8Lohog3qNqrTroX966GxlFGnI5ZBWKpo2pw&oe=6A047999"}, {"file_name": "5.png", "id": "949970555661748", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207238_949970558995081_1645532340712546560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9el0YP2eZPAQ7kNvwFh00H1&_nc_oc=AdrD8a4y-XNn2_XgJd0cfX9UvJ59yKAO4p0SCbaJY4Am0Idwm9p8BmGTDLmEzLW0Df0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eyyfXjjT7WuuSKL_GYtQ3nhjTjWFHnTGs5rHYkvi4Hg&oe=6A0474BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GunSpinning VR", "keywords": [], "long_description": "GunSpinning VR is a rail shooter that takes place in a small city in the wild west. The city is invested by zombies and aliens and you have to clean it up to find the source of the infection.\n\n- Learn the game basics in the ranch by shooting bottles\n- Play and complete the game in story mode\n- Try  and challenge your best score\n- 1 level in this trial version (8 in full game)\n- Sweet Country musics", "short_description": "There are weird things in town, people have changed, they look different.. they look dead, but they are alive! I don\u2019t know why but this giant flying disc is probably responsible. It flew over my ranch, and left for the city. I\u2019ve to follow it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Demonixis Games", "support_website_url": null, "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "371769241493294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1121103892043399_59971339972579791_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro-u-ganZ1IQ7kNvwGG_Jdc&_nc_oc=AdpNd8BRg3crEtTZf8z8vJjXI4AGBgvcFeW_q_t__qCPquYZkHPKqC3EpRNAFWy2m0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tcbjzvFaHAwgVRXjtzdXeqFqWk3l70GzaX-BJv1PSbw&oe=6A046584"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GunSpinning VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRki0t6PNJMQ7kNvwG6T6Hx&_nc_oc=AdpnCP-KvAXlSzy8B3X2Ver45_8avfODImG_KdFYt1mtVjD74t8xb059NAQrA9uiuRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLj9gnn7pGDakNkTFaN6kcMyO1q9FqUezN-EHWwFoqHg&oe=6AEE0371"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqo30YIL6RsQ7kNvwGfzgg-&_nc_oc=Ado_TAKSyLaTnHf3emSs76O-ZQ3YVyItqVkZ7qUxJ-zfRb5UWzfK3zkQo-N4q-4piTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh3vyTlryfKFLa8jvHJESlzZniaSVCdYheg_oZtZa6Xg&oe=6AEDE8F9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zCy_qp4ViEQ7kNvwEtgKAo&_nc_oc=Adop8ci7iRuc1mY_UGwEBVKBwzl10G4wEYvwzRTnM2dhkKN4WhviToL7GNSei8BZtJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJBiP5yVBDGfjUTGOATNxXCBLwMd6pcgwHQJ_0JT_hwA&oe=6AEDFFA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
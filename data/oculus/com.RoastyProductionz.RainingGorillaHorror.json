9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbx4L7QtXisQ7kNvwHxqwb1&_nc_oc=Adp1E7Q6_UWtKrWG5gtwaXa8YYgIQ1X_WgP2Rq0KIK-ukJYWpGX3NbQYurz5yAG3F_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTbrVrAOArQ9GHbMh2OWhfJ6Q8V67MSoCk622HqrP92g&oe=6AF73DF1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNW70jY1jBsQ7kNvwGkBf70&_nc_oc=AdossQ1iIy8feUDVs5NODkcqhj6AwivooQT2wIGZ2qG1XbZVGpuwDZ5P1BjsfWOiUpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9TST-gbcC5QTgxNt0k-uPWhz-aifAa7Eke2f1YEU0Pg&oe=6AF72379"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-ze7MYmiBUQ7kNvwE3DjZy&_nc_oc=Adr83NB7Fz8ovcY9CY63EEoMgfABJaw0GWZkESX0ADrLPGV6vkTXzhIeVfF8tZfisCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9DKQKqB8ihuDj--0jC4gJwKwDeiK1Eyo1FUxyA_HzoA&oe=6AF73A29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
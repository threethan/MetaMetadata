9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ausi28P0ZZIQ7kNvwGSLye8&_nc_oc=Adp1jiaFqk2fE4DBi6Ow3BP0f7lua9hXNlGOQqFDIGAy3XXZq8O_YHjf9k8bOJDn0C0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfnirf3WeRoqKyiodk3UAIeFeUHjKPLrajsqACLA5N3A&oe=6AC13071"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwJcxdmnnBwQ7kNvwHNqFOx&_nc_oc=Adpt4Xau0F0cdxGOMsmWBoZrYE11psTfew0KEenzjgwhhBiXMspQ_w4aAnweP1VJv1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS8z5kWqoJ39rpGQoBDkBEIgplyxt5A_mYSxyLZNfp3w&oe=6AC115F9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrLb82ML8O8Q7kNvwH9bkMw&_nc_oc=AdrPrr4V7vlfvbgFCD5KBFVLMw3ZStKF-v5KstTrnYr6FT-XiYCcuelpTesui83FZx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2vOMvhYdJuqlHG12qv6Dl_xWCT0fb9MnLHfU9wdYrLQ&oe=6AC12CA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
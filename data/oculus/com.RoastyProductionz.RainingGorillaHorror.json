9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxPs-fCmY-MQ7kNvwGjh6Ab&_nc_oc=AdpPgP-EUvseiq6DBYcclecG3LX1quVpjq7KO1Sd1D1MFNVc2O86iXyeNV79XbiBvnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxADywmwARKYlBpDPKl6-dseoZAZuI0v_CJj8srybdDg&oe=6ACFB0F1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2bp3Nje-6kQ7kNvwF_DwOa&_nc_oc=Adr9RxnyoN49vRv-rI7t_ccNRIAK2Py3XEk_ei6zqD8YoRwZhBIJ-iojeMaaLpkzMak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOROAiZUjQWgsO4Gx4dkqsOnd6Sr66CQozlbOcck-Z-tA&oe=6ACF9679"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5oVHLfrrcsQ7kNvwFjwVHi&_nc_oc=AdqFgX9bw7dky9NSaKavrYDl57xwPy7gfVuUyU4H-SmC7unbLSn4zmOJAx4qgOR2iCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1ZpFVS7WapsWoK8loUl3aINqRUhhqx4npesAFlgwBbg&oe=6ACFAD29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
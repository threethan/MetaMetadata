9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-0yTrE4x9MQ7kNvwFBS2U1&_nc_oc=AdoAf22C3T5Wxpr_szsYXtOSUQSvxStLsvHS7oeDStXtz3EGKsxGDipdeqr6TzvdpHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1oi6nqmRWPEdVJpO-itiAb8mP70biKx4_NC01SlF8Aw&oe=6AA69A31"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUfDqOroRYQQ7kNvwGSWYMQ&_nc_oc=AdocoFOnvF2lOt-XsImOkvfKcl8lSySCifgOJjdrMDQ1Xr-2nmO79YntNE2QOAf4JyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJhx3LjlR4s5TtW_NDnTYspYtjju6ICAXNW8N_7KEXjw&oe=6AA6B7F9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz_FOxPrk18Q7kNvwGW4Auc&_nc_oc=Ado-ebczGu6vy0RsTTtLw_9HF6QGOoo5nq2bHThNObAuNyi-CKt10aq78KjPhPHvoso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmZTKyaLPWJfMsJ4r99_XA4-8V3oNu3UWt1JmFHYIOsA&oe=6AA69669"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkghrzeOCOcQ7kNvwEK_81N&_nc_oc=AdoVrCMS0sAFZOuVd4Epp1wCClWUD8az-RGUY-N0Hzw2TilbA57X6oI0V6hgLjouFD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV35eFNhiiUNFkLY0M--y5fUj3zq0fINxv94-xcP4POA&oe=6A9D5FB1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2ONu-_AKoMQ7kNvwEghn5K&_nc_oc=AdoMLNRDp0WJKbChGmJl9-5z5t0mJCtoBXwJz3L1PThz9mw_3wjmNcTDQtrC27Zt_8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJxrCfWfCkdQUZ19fPWlxDuJXcXkQ7R8v1cuCgJVpIAw&oe=6A9D7D79"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gJ3OJ5mV9EQ7kNvwE6IsQn&_nc_oc=AdoyDIW-xK-LNwPFWGZWy5j9kO8CpDI5fiP3T3tdydPNpNhml-fqikGpu5EcHqN3zys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEGMR_zG-l88_Yn5psK7QzQ4ZWAcmmBLdzAw2Qvq16BQ&oe=6A9D5BE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
Bisp9M7XqHA9LnPK3Ks5NyP2TP46zXfDFOD5Zt4FZM4q3oWA1FXtn4qpATeUw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PPbnG8P332NhM5SQOxu2lP9McfslFi2aR3zmiDrHRjQ&oe=69EF59B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q1TYMyqM5MQ7kNvwFzucth&_nc_oc=Adpr0DWQzIsaA4ykc8-dxbzfaMCyr_cNIhv13_S8cX-U_5TaPsBnHhjek7Q83DDt7Xg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-qZt4qClOSwqM2IHRnC7cOvViQ1heqrIycj6wXznr8g&oe=69EF7779"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLzZm1W5HQwQ7kNvwFAsT0d&_nc_oc=Adp1JH0PaO6Ghrf1D7cHsW7eYBtTkCuN0JZ_1r0mCDb7hVOA0jLCjIwZg3Fa2vPLlOk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0W_DxZ7YFhsGBSG2FkX4pUzCFBf719UMOvZWwdZ34lmA&oe=69EF55E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game with Gorilla Tag-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastyProductionz", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-raining-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-raining-horror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30485294704403056"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30949128074686381", "version": "1.1.15"}, "id": "616500438068027", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "30450153904583803", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30949128074686381"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "616500438068027"}]}, "change_log": null, "cr
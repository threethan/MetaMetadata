_AfxfzwwlcoH3S1pFHCqHqRIx3cbVJlRkKjxUFRaw0dVAwg&oe=69C7CCB1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Klo0qJoIH9UQ7kNvwH27uov&_nc_oc=Adq3lr4xwU7rc4YdPPWLxoGBYa5k-LtNagfcpjXdjaOU05e1YnpjwC95YKthSLhmvj0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybcfcZGTCyHKTSyiOTZxwskgD7Vcto6ZQSu9iuiaKUew&oe=69C7B239"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFtFTwT06CwQ7kNvwFuuJvV&_nc_oc=AdonaVbE9NF8mS7ulIuffJJXbmQMuSc_rJ7a6koCwSQ4ll8PWC8qP4kzEmuZhqEv2V4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvN7O7ocDPufCDZhF-rW-kY9V9FtBS9aF0qmSOY1WcJw&oe=69C7C8E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game with Gorilla Tag-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive th
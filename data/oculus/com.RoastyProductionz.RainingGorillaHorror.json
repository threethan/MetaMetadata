9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3IWWi-JpVYQ7kNvwEUIqrm&_nc_oc=AdqIcD1ScxlTH_qgU-cH3gQ8nsueeV_ngGyiP0NPmxRq657t0xb3_o64ccNbkBu47u4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs24nM79gSWcTtDaAdfiQ8B4Ox2BMfz_wTHyQ4fUQpUw&oe=6ABFDEF1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vYsOON7768Q7kNvwFmbjCG&_nc_oc=AdoxbZM0BXaPMUoPLP4w5f_pB-yleBIR2jYB6o9NcTdZtkVrkRXvRNVVFzr_pqRay-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF29wyrC_R8Wjja8FPwTFr3ye8-VtF7k8vle9D-9iCiA&oe=6ABFC479"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE1FllBxPAMQ7kNvwEd75N0&_nc_oc=Adq3hj3f_U13wNUMzseTAMtL4uPg9QjDhvTGrFX9ve2rmECTDx2N4Cz1YmsOsw5A9vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc95RRMXkosRyI9wwhY_pZrUXcrwERkrVI3rS5oWBFNw&oe=6ABFDB29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1wR5cjBF4IQ7kNvwGhHZfl&_nc_oc=AdrN5d_9wKIp8_xP6T0iLPciwuv-6KmSjT0C2ur6KcbqUH2oD31xdGOsarJ8UoGBEMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHol0JflihP0ba73f4629OztBFE-m3ySOlYw8JdxVUtCA&oe=6A8C3C31"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z-xECPgrRIQ7kNvwGiiRbA&_nc_oc=AdotbA3jPTgt9XIAJxNINHRV2IYwQskbiaMdtlhswip5Aow8NcW43y58_ITGwnUjIlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwLaOJnKCKW9cq-93WmE9ZDadujQJqG-uBmiGzL2IvAg&oe=6A8C21B9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k39Ln966iD4Q7kNvwGlMOMx&_nc_oc=AdoePgzLUL8Znc2RgYrCD4iSzH9r4CiwAa1sjNPxz1ybbDGwJRJCX5p9kIzDIRAhbTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcST94Vb8PzHhjYC73B6OuKTTYGgcwSTOlbBVTmfp-oA&oe=6A8C3869"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUk0w-wE-usQ7kNvwGUwvXG&_nc_oc=AdrtZ52haf86a4CxkI9FBKjuIi_fhX7CZCk8L-G4ffs5yYJnJ-bQ8axE4xtO0kYAVW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5JBIOkruzMsQDVQ8aUTzJCaXsjN5aQBwCsJjlGJMfnQ&oe=6AAFD4B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcBOfeaFKBoQ7kNvwF9MUQY&_nc_oc=AdpVxrLAYCZpT3UmDgDfLht5IaQtNkC_g2KB4rY7nlCMFfN14H2GUFjE1NFW3pxIqow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPVanbovRubx32tqN-GSyIOrxSVAqR3UbwGeQ6KLlWAQ&oe=6AAFF279"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtKM9vuU-_kQ7kNvwEBZ4fP&_nc_oc=AdqnQ4CxlhRMB42U63vIc-8k_WcA5LQ91fNW2wRiRny-Jw_p_T0OCT646s7EpDdHXmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpQlkGGdKYypT-Z64_HWmVG0IFnV6JwKQbFMczMUUZOQ&oe=6AAFD0E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
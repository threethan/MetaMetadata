f38__qe5lLSWZr61FnlcxNJKjt4hd66wvRuFucSOHbmB5GObSKDpogaWKY5H4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YyMpFAmZVPJOmEgcwz7dhLEZfjpCE3rQZb7HHLAP6YA&oe=6A007D31"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITlADqtq3AsQ7kNvwEMchmj&_nc_oc=AdokfP_YWFlp9d5F51BoAq_XCezguFr3blh3SCTr8aD38USJG2YZ8uGt_OusLjZesFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TfHtJhw7a0KcnSxUX9UxR1bQhAsHf3F8YC4Cf0n22Nw&oe=6A009AF9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvA95Im8FqMQ7kNvwHOHA6w&_nc_oc=AdricLxxHmBwAhtMDK4hSnaEiuc0y0Ei8qHC31RprKf2XKaEVOi0d9pqGfNO_V46Rbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DgL4qM_DLtlrNnwODwB2PIaDYUBDYMqk_xsorKyjYOA&oe=6A007969"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game wi
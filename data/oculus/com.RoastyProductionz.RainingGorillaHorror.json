9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1wR5cjBF4IQ7kNvwHxTXWc&_nc_oc=Ado-ozJc35En9GV06WOpacsxWeTC_0m5j9WEAlnTrzGBsVZpthc07mKaFkHWjZXTPSA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt9HyD-f4qG-SfR_1i61-9baOwxgfO4RG-qKuiGIg23g&oe=6A8AEAB1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z-xECPgrRIQ7kNvwGqHBrO&_nc_oc=AdpxCPHBrnNChrIi5plzedqG7o7AGSk2bT2Mcl9FSxig-IeMWmSffBCvU96CIBf8xe8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfbRIzhrMozF8Pe_z6RhvnBE_3q2aEhOBhRm93L5FEVg&oe=6A8AD039"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k39Ln966iD4Q7kNvwFegBcu&_nc_oc=AdroiRVyB8See3dB1ujaD7bghRo8oPz03foRfSQrM2Hukg6Ty4I6FStux0aUNgCd1Qs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGk64VoiNCzmo12-88VpvfYaDKTfVHpiNX2LBgipm9Eg&oe=6A8AE6E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
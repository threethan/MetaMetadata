9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMSdJV9ACNUQ7kNvwFfVFuF&_nc_oc=AdogjNTeBvi63UdZA49OKDAoqZHWk5j6rBXm8bqSA7P_VaXDcqstjWQ2A4F3PtUOOvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvm8q2kxOdkoNp5xx7UsMgZmrMChFNqgh3P3bG4l316Q&oe=6A99A371"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH6p4tZ2ZGQQ7kNvwHGlIgx&_nc_oc=AdpR-Vdx39uVRi9v5cup7nzQ0aQPHEdu4iwm1NaAHDxrG-3ZBdtT13wzc4Qoe5CyhqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoIohBTe_wV7WKe0AN4fCbl9bC0i_weWsmMvSdvHUtPw&oe=6A9988F9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hM2GMgjaccUQ7kNvwHdW8Rv&_nc_oc=AdoRezXb3sIWxcDUVgMOwV06SF-nh7hmkftLcAEHKjF98BIjaUM_ICqxeR9u4sI_oHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVJxseiT2n6A6RX_uywyr7t1Pn3DkqfkcpYOn3ra0PCw&oe=6A999FA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
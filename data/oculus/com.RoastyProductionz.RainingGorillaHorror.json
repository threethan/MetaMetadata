9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Gz-VhAptS8Q7kNvwGYMP-D&_nc_oc=AdrC-qYweunRCCOgIZTLd2m_gd3Q7w7-hroRuJcCmjd4QIxFkTMXhtEyrQ8dgzMj7gQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2jaq5rT8fe_qk_xNxYAQ1P8-w23l7HwcNx9pBuAKNrA&oe=6A845331"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVdUDmivpgAQ7kNvwHWfmtj&_nc_oc=AdqBJ-vWzMAIK461WpSS7IKzcr3nmXqzD2JjDQunAV1Kt5Gmqd0vrOHB-5b4KLXJIM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLNOpZGW2lCxmU2KO8ISkWRMKm4KEKdpqHrIk4-6XXIA&oe=6A8438B9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCB6e7BZ_y4Q7kNvwE39AcK&_nc_oc=Adr7anrqVA7t4HovZ__SNIvDkzBWeDxYFXvgCH9eQF9CjLpzV4Ihi8zfwQOMFNfrYZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIg_8lLCjLCB_4cDVqtp-EqxgeI1lytd0HtxYmMO2Eug&oe=6A844F69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
c_ohc=_t_nzOMopIkQ7kNvwE6eU-j&_nc_oc=Adk2qT9nXd54aH_LctKUKM4TfZE1_K3b4wlvliuVtcJYPpMWou4SH5Q8BNfyJ_vMma8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6lIkFK1pBaOCbCjKO_8aVZqCduuxP8HbPLMrvdDQg2w&oe=69BD317B"}, {"file_name": "Main_Custom..._03.05.2025_23-54-50.png", "id": "1210049523450612", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393909_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLQDs4DmhWMQ7kNvwFqL1hH&_nc_oc=AdkX6SiwXtKuY1tny75BdLsfQKKUyIfoUWtU1ETdi2TPbAG_FBIQ0UcsHX088u0GqgI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwS1Wu3Vu8BdUPZ6EESNT17YAozSbp3Da8yMnCJFp7G8w&oe=69BD40B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOrQjqrMC6oQ7kNvwG72k00&_nc_oc=AdkabKZGQ0lQQnTsiwCO0HF1AykAvltPw3_J8vEx7c_xlgofI4XcPXG9US9GEmz2Mic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2x2vmpQGoOBok9dWUlUaUqGN-dnwBEewT36c_oPXCVg&oe=69BD5E79"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIRN1MoMH9EQ7kNvwGd1fgg&_nc_oc=Adka7wGeWH8SMOumpv0JTmZEk59UzZcOZWY-fLbpqVJIYyXMnjJW3GPyQbJW-2FRFSM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZWdhT5OJfHhobk4Zdvlv9vaMmc4hEV4CXBcNROxO-hw&oe=69BD3CE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game with Gorilla Tag-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastyProductionz", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-raining-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-raining-horror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30485294704403056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392147_2067748017365377_4054686588648881760_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVUmuYFhukkQ7kNvwHS2xVw&_nc_oc=Admw-S2xKMwBc-j7rxraljySSqyQSrYb8H8K5BxHTU3J79hJHvEstkf6pbWNlDV
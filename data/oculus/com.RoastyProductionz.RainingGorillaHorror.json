9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qhsDbtkMpwQ7kNvwGoDbPY&_nc_oc=AdrHe3f9xdgu1niCDOnyaVNTzfYRxSHl6UB6p8BCeBkCY_6lw9mU2ox4JMy-itEWKiI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-B1cmBvuCynfW6QUCmdS1pW0e7Mq5ePo323rqWPFmSQ&oe=6AF0A671"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZk9PRs_E5QQ7kNvwF3Jg_9&_nc_oc=AdpygLROtGdEVjmNp_lD0uDlpeKR28kmFAcppZTgCU07FvE28RqIIvhinDLYUrmA2jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1NSuECcDTyKOMXmCRiJ-DOHwaxLexxpYDPMqLctOtxw&oe=6AF08BF9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqe27SucgeAQ7kNvwEu4UUb&_nc_oc=Adrnt7MA9YHEsScnyArDzHfqLfibKhZXIyz2U_gqBXemVJSi5SRiuvb_BTUA_cDtubc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf7FXVL7dErtHRYaARrN6fVUzskQwEiRlPzUvrJsKBhw&oe=6AF0A2A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
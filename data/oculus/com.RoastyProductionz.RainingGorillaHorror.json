c=jnScqouUPMkQ7kNvwGECo9_&_nc_oc=Adl8en2wIjGMTjSe3ooPe65Glutq-XB8VlqPtiVlUBnaVTBqY4WiJjBq1ZBUj6bfC_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afui1sdcj6RDgEJB9M2_NdwNPoyliX3BBLhq57yZJ8vcWA&oe=69A2C839"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4ZvW0jCi8AQ7kNvwH-ILyr&_nc_oc=AdlpEO2aF7MEibXQ2rNSGecRyO3dpKoah2Musz2bWQ1v4Igt3ZpPnfmbxeSlMuqQc_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqQ1pPiLU97hZst1lo3UHRHMcaaaY_LpS6Vd7CcISYzw&oe=69A2DEE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game with Gorilla Tag-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastyProductionz", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-raining-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-raini
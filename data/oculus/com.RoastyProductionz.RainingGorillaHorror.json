vUNuJ2itlaArX9hXDHkrptBci672btStWTFmOHq7WKx3ZLtRqKZia0iv2SBAw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61TQ968Xe1G_ujGKl6ZlEfDfGZS-b30oi6-uvKhNBHAw&oe=6A1443B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfV71PyiMB4Q7kNvwGLBO70&_nc_oc=AdqYIqXQWgfVPDeNpXr43cZoO53B1WqfUgO01J2CvORYij9ZU-8iGTnzbpkiEa931Cg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af488v4lq1MBIi8CR1xf2kp8IBlxJFa7a0lII5z4a4kbhA&oe=6A146179"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT-hmGWzGZkQ7kNvwFn9qVp&_nc_oc=AdrRVFEURfNd0p3dBXh8v6cXNn538pP_dq_sI0yLltCq1vlxfM6uMNHUfBZGbREBazM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MoeFwOOADY_M66vi4Kf-DbrDe8sPEwy1ONVXJxeQhmw&oe=6A143FE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game wi
9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku6KxjmaiYQQ7kNvwHYAcnx&_nc_oc=Ado5O0kT0EiySp_gk4vi7IG4brQ_9vwTzVAmr8Tk-jTfb0NxkUZ-EOwwLc5GLlf21ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2eXcsWHi5VDNFWoADiJYZNn9UseZiqRzqEJgQl43vSA&oe=6AABE031"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P07i_-pQZGgQ7kNvwGe2fl9&_nc_oc=AdppT91KPv39oP1JjnQDiRxjbLS7WW9afIrRRPQMsQkhV7vTtl3MHv5mm17vZ8Gqd4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhPNbDubqzBwCrn9JcaEaO0Qj_yPEvVTH5JFe2vO-XVg&oe=6AABFDF9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z26RxoLzySsQ7kNvwGKY32z&_nc_oc=Adqo8711dlJcCY2n-xBAeDZZSOJ9Ec8rbCl802FWZWzbCTnPGsxjYB84d02H4prGr1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmQ1mzGz3UT9jq44t95TJRlHu6gA2VlMGRaRwdnsnx_A&oe=6AABDC69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
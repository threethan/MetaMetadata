9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkLtIxqyexUQ7kNvwG_vTdN&_nc_oc=AdqiBOxPq9kbVIt93Zlnqn61k1cpnL3Fpm7TbcoCBQDmanLk-R5ng5JPnNQSbpK3LOI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQV-ECGjbQRcFb93oUkbKIJANHrXQDqYInqoh2WU-UZQ&oe=6A9738B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOwgjNVvCJAQ7kNvwHTDOLU&_nc_oc=Adr2LcdyYAe06S5kSc-7OqJMetu9VTI6JrsesolPRvXgNTiUvufVPxlQnznqnFldtaE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1cuZKI1CuPOx6_RJy-DQIkYce6zbroceULpLqchKeew&oe=6A971E39"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVy1dCykJlYQ7kNvwFreaqg&_nc_oc=Ado6y1ZUv-D6Iqq-mJEXhQ9HFC9J_P_h1RpzlrMPA0oF_Jka0QSb6lVlHQy3l7oHDl8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-GQ5vmJLuyz7ZWMrySsw4WV2ocRxuUGGSp2eqBTwozQ&oe=6A9734E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
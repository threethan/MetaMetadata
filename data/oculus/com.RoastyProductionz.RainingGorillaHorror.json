_AfzsbSpceDLFnePYYYco_y1YK8Io4FM9_RNTSe1OksEPFA&oe=69CBC131"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uR_5b9eOhoQ7kNvwEhCHaD&_nc_oc=AdoAgxwZ1S_2r2XtcEL9nhP81iRJCjhOtIKNpNhPJ-89Zz9cNUWXkPdsiwfpjqu9qj8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzadAjFzawsnWupGv90w4g_lc5i4u9jRAxKfhD7-ipkw&oe=69CBDEF9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zjmtv4I_ZmMQ7kNvwGXzHev&_nc_oc=Adp4oFiwjpZ0mW5ZjS2JhZLf6Wqf15z1gdb-iWgronL-uWORE0gOYtDHAu1PN4d7wCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1Pg96a9v87RNGUcDHfyQZj4HDYfDQhohFm7O1s2xTZg&oe=69CBBD69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game with Gorilla Tag-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive th
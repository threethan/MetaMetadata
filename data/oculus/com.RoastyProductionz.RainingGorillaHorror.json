9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMSdJV9ACNUQ7kNvwECrqbq&_nc_oc=AdrKGLoRC4VogNcBTQqYkcErLltencb7xU6uN4cYg3aqPDlVgFN1IhIB1Dso9RIza4I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnIukckjMMy4iNxtsyWfWRdkYae8ERdSdTTu75hJdrDA&oe=6A9AF4F1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH6p4tZ2ZGQQ7kNvwHqjk90&_nc_oc=Adqd8KALTD3i8f3P1Eh9cn0QbHJJ0ztoWeB1wKiasKpE3okFmIxoC-n2EVbrJRuKllU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJskYfpxZKJ6YTKi_Kg8rDaFmyvfC_qzGc9FPictT_nPQ&oe=6A9ADA79"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hM2GMgjaccUQ7kNvwG60lzH&_nc_oc=Adp0qqnmqLKS2xPUuCpxYSHWvcXGbMfqmeBtpnAi1pPX9iw9kAGFej--p2SjktNOwz8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgrEidbg4pmAb9lDc1mclbCW_Tx6tr9TOfm5_XcA9csQ&oe=6A9AF129"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
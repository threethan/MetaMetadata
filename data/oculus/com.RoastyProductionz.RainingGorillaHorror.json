uOfLU_nlvxJ3dEv1f7dkMzytSq3EDfmdkcSeRvS-pXQlETnAANy3h7Ijg1c4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60MmrxoEi_DZrrCsUlV7ZGN-TRutLBv0PCkLYm__xFZg&oe=6A202131"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIk9Ue9z2lcQ7kNvwHQ9KaJ&_nc_oc=AdpxZAm1K8g02IMwYJCkWDBGD7wQvpvG0vVJdnHyh2QbxllZAa-vM63SerUMedKTPOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55K0Mc1MkdWjZpoFPzuKv_NrV-5JeyUBcnvLfsid0BRg&oe=6A203EF9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QAQ2M452HkQ7kNvwFT1feu&_nc_oc=Adqeiqvkhr4174FUCkcq2YKfPDsDl7xyNvU5gRtQNV_Re1a-ypZJQkZ7cbsC2kY6g58&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56o0Xs_JJpkWOvszqU62ejynI8JmOkEGceoDLjSYO_6g&oe=6A201D69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game wi
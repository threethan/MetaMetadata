9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkLtIxqyexUQ7kNvwEANaNV&_nc_oc=AdqYEyYtcpRxPLLfIBebwG8bltm4Z_gP5YClgdZEeKukgw0qYlePXzW9_vFpwKYaYsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJXsO9xKacpPC5k2P6-vjjgzBOPBA8Ec4p2VMt34UlxA&oe=6A95AEF1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOwgjNVvCJAQ7kNvwGiQmUg&_nc_oc=Adr4l6HeI4L3bJH4RlkhtmAbXPw9yU_Wt3txWutkwupabGH4U0ntlx47GIBHW1g2jC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJg_mF3NQFcb1-n7nNrwUb3fEMcXIpcQb3xl4RQ0E0gA&oe=6A95CCB9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVy1dCykJlYQ7kNvwGLuKv1&_nc_oc=Adr2-kEejywuJYlgbhGu8MDdR_VWkdDVERzoCfvN8bxjeiAwiJTKNsGPmRFoqPZhTJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJzS5Yd9sQENmhZYXWh8YbW2iDYB_rGd6cntrX-5_nNA&oe=6A95E369"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
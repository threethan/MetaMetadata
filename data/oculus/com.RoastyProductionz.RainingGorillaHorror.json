_Afyn-GxAAQYD3HkrfgFlDqOaTrJ0evGXTtS_PfpOf-gWWw&oe=69C529B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwB_9omGPSAQ7kNvwF2AJBL&_nc_oc=AdpgrBeb3Ryeerozj5NG4Xj1AnNmtAG2eC_TgwAAlfExglyOir2-0TQpBCAZqkettms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGSDlYPNeyZ0NXJQcqFqNib9D719QlMwwMeR0iEY7V6w&oe=69C50F39"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoHNn-LqbvIQ7kNvwHI4gm9&_nc_oc=AdocSVr0dvyjvZiR_uzxUtncnBLztbw7IPupGZvSIIlIiSTGIhKAIvvu0wVxk9T5GnY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxkw_fDd0Nh0T9Q25267vPkMXNRpuXszk3UtEU7YCAnWA&oe=69C525E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game with Gorilla Tag-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive th
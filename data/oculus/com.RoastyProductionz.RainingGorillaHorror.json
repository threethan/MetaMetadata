9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBWXXy3ibsAQ7kNvwGz3Bw8&_nc_oc=AdrFaFO2LbCp6RqnW8KKXL-2e6Mv72-uSUZ0oly3TIemN1l9ykmbObGrAEV0zm3Nv34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMAhNk289fW7b_vDCwRLcn16UmwsRrJ9gPRx0zQZK1UA&oe=6ABA60B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1p7uSZgPh4Q7kNvwEmvFsh&_nc_oc=AdqIKyYO9pFS79h31ubvgAfK9F-kxzq2kDzGQhWY6iFnYAW2frLqaAjnPRY0j8h6Ons&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf8uyhSwOH4nXw2c8uEOqzpfUDsNVGEsqULONpHpzAsg&oe=6ABA7E79"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn_zQlCB70gQ7kNvwGNa9iy&_nc_oc=AdrVQuO_-F6x0gV5Vj6SCqLSvpVeTPLS-E_fTOVSikWjL_NyMJd6R1DTB7uJ8WWJXDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlcDGs956waQ64WFJM74Sd36V7I5BSjKp5NAHhIwsyYg&oe=6ABA5CE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4kLY0MnDNwQ7kNvwE8lXu2&_nc_oc=AdrnKrA3gqTIr3ma0OG9cPv3sNnyBWTownlzn4IVb2iDoLo-f_EMWF2XcIdJRzx03CE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6zGRnePgId3lLBwkbv_XbQ_AZNRgm1Qq4VuZ2LyDScQ&oe=6AD253F1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOylHWxoGg4Q7kNvwHTkJuR&_nc_oc=AdrZyIiqJP5GKMI2Zf4SSn5VQkr_CJ7aF0TK0vHy1lZn5uF7e73mouY0mVZjjmV4xyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeUbx186L2QMFT4VtB_xfQHIjQc_BMxp9GAI2VFgAa2w&oe=6AD23979"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gFRn94dIEAQ7kNvwGKua6V&_nc_oc=AdriXPNtJ_qIUcqG0IhQgLfB8thS4BdcfP4MUm5kCaYHPjcCr6lnXbyRY-p4Aau5pFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd1CAY7j_Q_VfCEFOXTguQQIJPtuBvEXZiv4IhNjnG2w&oe=6AD25029"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU4l-P7KatcQ7kNvwFfBU2S&_nc_oc=Adov65u4qXezFTdJLSR68YJuAyYzvHMX42xCWsStC33jcIjQMRupsN4VElC6bNxfCMg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcuGe2ReolDv9nI-fOIwXMaNeAlCzmis_4x1Dhyce_Gg&oe=6AA15431"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7fulTvU2W8Q7kNvwGQdrj5&_nc_oc=Ado1uYjh-B42NW367iIrARVMW0U3UKLdN4wz9Wdg7Rumx3fCNVxCNRQXxYzZPgBanVM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeQm1FAG0noR7CypgH43KI6DP2qRML9AOkpHnOYSgO9Q&oe=6AA171F9"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tJXoR7pNL4Q7kNvwGvCMKd&_nc_oc=AdrZhk5dXGYWSRa_qJlaCoDZ5FG9gEGQECJ4IqiowtGFD6RDHcF7wnH4PqgDopxBz0g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyhkt9IkFz2VWsza3YpKxC7HYBG8l_mGVOkmy1oOzbew&oe=6AA15069"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
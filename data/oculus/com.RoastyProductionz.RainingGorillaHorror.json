nGu7IcZP8tOI7X6sJxemsU154vPwipgA5XW_jSSgv3MfWyPD2is-IbbQ-xL-c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92b9mViQAeuW_KUf7FbHjJolu10JEtXGAB87E5HkyAeg&oe=6A26B8B1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aso3s5Bep7sQ7kNvwHyy4Bq&_nc_oc=AdquZ_MauoIr_b8009WlIvGqr_EA3emxKgWBSnSqT3sgHQokSFels4Hd9oM-h1e-_Zk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GBfxmi3v7bbLTIC-DnJssgvkttJC_FmL_Qx6XBqfrMw&oe=6A26D679"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4jb7iPu92AQ7kNvwHFCyy_&_nc_oc=Adph4nDIERCT5NT-y1iQqIA66YssVbYDiYPmUoGkgAsr_5CaarBt9WG7zq266cOse6c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dRNtPBRhFObHk7SrGNJL--5AyXZk4OtktxlWCfayQ5g&oe=6A26ED29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Gorilla Raining Horror is a multiplayer VR horror game wi
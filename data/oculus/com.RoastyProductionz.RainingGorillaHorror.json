9_1210049530117278_4602878234898401178_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxPs-fCmY-MQ7kNvwGZjqPm&_nc_oc=AdoCNbRyT0pRRE6PhSUTgK2mBIjbiV4r-DmA1TSvvH5zEAf74L0H4wza9yT3sswxKhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPas4S_RwAtvWNVghvv-OI8AK6dIS-xgcYk6W5ULm7Byg&oe=6ACD0DF1"}, {"file_name": "Main_Custom..._03.05.2025_23-54-30.png", "id": "1367441231199602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821197_1367441237866268_1069555356158091528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2bp3Nje-6kQ7kNvwEFMrS8&_nc_oc=AdrWeqclTlFwNExXwp4PThRe4fQC5sU7XjJi1OM-LZC9RSlbV_R4OejdHKSQT2KcUew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLEO8ZFejsDajOf1bc8InpCI3fyHSz4-XQnkKZ4_JfmA&oe=6ACCF379"}, {"file_name": "Main_Custom..._03.05.2025_23-54-40.png", "id": "2345315989178072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_2345315992511405_5919491116247947052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5oVHLfrrcsQ7kNvwHTBasE&_nc_oc=Adq185N33dOxv9P9_Cy6q_ZaYe4KN3dmXOYW3W40i3-szZJkLNK4hIKjdo5mGsVMBKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMI_brv9aWPMKUA4lIDrt1OSZAvL0xBt4vJXg1ro7jGg&oe=6ACD0A29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Raining Horror", "keywords": ["Horror", "GorillaHorror", "GTH", "GorillaTagHorror", "GtagHorror"], "long_description": "Gorilla Raining Horror is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always 
cdn.com&_nc_ss=7f30f&oh=00_AQW0Cyy7fCUEXVjYRhUDvPUtYCEMwRSNPfoztYm4Phvg4Q&oe=6B103591"}, {"file_name": "4.png", "id": "2372238583579411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_2372238586912744_6509821356857866211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB8rutypxPIQ7kNvwFko8FY&_nc_oc=AdrVLbllzP_yRAfR_iSKBNlyRLeci8iA-ISAUDH1rvUu1LG1ad-_41iiTyXXzrHEis4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5UOu1aviafdhrIa3qOx3Vq0n0bupwES81lSYOTRq9Hw&oe=6B105C79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Jeans1.png", "id": "2579556662537305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771268_2579556665870638_7674500649322158748_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YylQN5bY8bUQ7kNvwFz26Oo&_nc_oc=AdrftgtgUFyTgR-zwhk8O6uiPo9QuK2VuGMGbvduX0EiJVIf4NHahPMF1kFejrLsxSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU-T9EhTzgw_BAwaUl9tH6b7pECnGCCe4s_SzU6n477_w&oe=6B1047BF"}, "display_name": "Guitar Traveler", "keywords": ["Guitar", "Music", "Instuments"], "long_description": "Guitar Traveler is a creative guitar studio in VR. Write your own songs, then play them yourself, one strum at a time. You don't need any music experience.\n\nHOW IT WORKS\n\u2022 Write on tab: poke the strings you want on each beat, right on the tab in front of your guitar.\n\u2022 Add chords: drop chords onto the beat and shape them in a simple chord diagram, or pick one from the chord library.\n\u2022 Strum to play: the song waits for you. Strum with your pick and play it at your own pace.\n\nFEATURES\n\u2022 Real acoustic sound: every string and fret is a recorded sample, with up and down strums.\n\u2022 Multiple tracks: layer guitar and bongo parts that play together.\n\u2022 Effects rack: shape each instrument's tone with its own set of knobs.\n\u2022 Any meter: set the time signature for each section of your song.\n\u2022 Built-in songs: start with classic public-domain pieces like Asturias, L\u00e1grima and others.\n\u2022 Import and export: bring in .gp tab files, or export your songs to keep or share.\n\u2022 Play anywhere: stay in your own room with mixed-reality passthrough, or travel to a quiet studio or a seaside coast.\n\u2022 Save everything: every song you make stays in your library.\n\nMade for Meta Quest Touch controllers.\n\nUsing FMOD Studio by Firelight Technologies", "short_description": "Your guitar, anywhere. Write songs by poking notes onto tab and dropping in chords, then strum them to life at your own pace. Shape your sound with an effects rack, add a bongo track, and play in your own room with passthrough or somewhere scenic. Start with built-in classics and save every song you make."}]}, "developer_name": "Triangle World", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Q4DCLUjOJojVMkOuVZ6h2sIvkp95adOAUuX8Jh9wm_U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Triangle World", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Q4DCLUjOJojVMkOuVZ6h2sIvkp95adOAUuX8Jh9wm_U/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29620310030926951"}, "review_messages": []}]}, "cover_square_image": {"u
uluscdn.com/v/t64.5771-25/499292426_1070254022132825_6925249406354909544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqMciuPAPcgQ7kNvwFSrlDM&_nc_oc=AdqtOqAgQKjR7Wg1mSrhDHP3DlZyllpNH-Etngc97bULBNOdsccuJPXWYScNwppvbR0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5Pny_KR9HwK0ZPXMWF9OAzwAGc-vhmWVKCZYKYAkSIA&oe=6AC7994B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440_updated.png", "id": "907238148717500", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/646409637_907238152050833_5574158185426982023_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Relo4mNjCOIQ7kNvwF9IBJi&_nc_oc=AdqXixALTdgOkmxtgVOBc16iDpcolddSNzUYp7MyZqKsvTJ3vlwg5vdtiDfJHGIlvtk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6HJ2lcnOyrEdXwk8sdfH0QK2-au-YFH0qBgpYkhrSwg&oe=6AC798C1"}, "display_name": "Hydrates", "keywords": [], "long_description": "This app was developed to educate students from middle school through graduate school on gas hydrates, which is loosely referred to as \"ice that burns\". Two ice-like blocks are placed on a laboratory bench in the virtual environment. One is ordinary ice. In contrast, the other looks like dirty snow, but it is one of the strangest substances on earth. It is a methane hydrate, which looks like ice, but contains natural gas trapped in cages.\n\nThe teacher brings a burner to both of them.  The ice simply melts, whereas the hydrate catches and keeps burning while melting. The hydrate burns because the methane coming out of the cages continues to sustain the fire.\n\nSURPRISING FACT\nBoth ice-like blocks leave behind about the same amount of water of melting. One cubic meter of hydrate yields roughly 0.8 cubic meters of water, but also about 164 cubic meters of methane gas. The water is roughly the same size as the block, but the gas inside it is 164 times larger.\n\nWHAT YOU WILL LEARN\n- What is a gas hydrate? \n- How does a gas hydrate cage look at the scale of atoms?\n- Why hydrates need both cold temperatures and high pressures to stay stable?\n- Why hydrates burn but ice does not?\n- Where hydrates occur in real life?\n- Why hydrates matter?\n\nHOW APP WORKS\n- A 7-minute demonstration in 22 short modules\n- Users can jump to any module, pause anywhere,  and replay anytime\n- Can pick up the molecular cage model, rotate & resize it\n- Live readouts of volume of water and methane released", "short_description": "This app takes you into a virtual university lab, where a robotic teacher shows what happens when two similar-looking ice-like blocks are set on fire. One of these frozen blocks is just ice, whereas the other is called gas hydrates (or clathrates). The ice melts when a flame is brought near it. In contrast, the gas hydrate catches fire because natural gas (or methane) is trapped within cages in its structure. The teacher shows this cage and explains why hydrates are important ."}]}, "developer_name": null, "developer_privacy_policy_url": "https://merslab.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "MersLab", "support_website_url": null, "website_url": "https://www.merslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1518580046623563"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2550608088714955"}]
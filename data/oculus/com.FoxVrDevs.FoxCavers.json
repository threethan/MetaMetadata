f20f&oh=00_Af90jVxrIKfj7M6bExtvZ-Q8TM649a2UfnCvGEmnguz3Aw&oe=6A2FF6C4"}, {"file_name": "Main_Custom..._18.12.2025_19-16-43.png", "id": "852469184072878", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308961_852469187406211_5944172059653979180_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwIF06tKdXQQ7kNvwGYejcG&_nc_oc=AdrHPGssnR3jMx7aECf-LOCp_Kp-JNfMGgp7Qd9_djI3dLAdzbCKKNZEKs4XcW9QUuM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rHZs9ls93RvWT4t3zJro-uPNSOPA1N7SF9wxK12OesQ&oe=6A2FFB05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fox Cavers", "keywords": [], "long_description": "Jump into a lively VR world where you are the fox. Sprint, climb, leap, and launch yourself through colorful environments using fast, physics-based movement that feels smooth, chaotic, and insanely fun. Every session turns into a new adventure, whether you\u2019re exploring solo or hanging out with friends.\n\nFox Cavers is all about freedom and fun. Run around huge maps, discover hidden areas, and take on quests that keep the world exciting and give you something new to do every time you play. Team up with other foxes to complete challenges, or ignore the objectives entirely and just vibe, chat, and cause harmless chaos together.\n\nThis is a social-first VR experience where friendships are made naturally. Meet players from all over, joke around in lobbies, show off your movement skills, and create unforgettable moments just by playing. One minute you\u2019re racing across the map, the next you\u2019re laughing with friends after accidentally launching yourself off a cliff.\n\nWith multiple areas to explore, interactive spaces to hang out in, and quests that reward curiosity and teamwork, Fox Cavers keeps things fresh and replayable. Whether you want action, exploration, or just a place to chill and talk, there\u2019s always something happening.\n\nWhat you can expect:\n\nFast, physics-based VR movement that feels amazing\n\nPlay as a fox and explore fun, immersive worlds\n\nQuests and challenges for solo or group play\n\nSocial lobbies made for chatting and hanging out\n\nA growing community full of energy and ", "short_description": "Fox Cavers is a fast-paced social VR adventure where you become a fox and explore fun, interactive worlds with other players. Run, climb, and move freely as you discover new areas, complete quests, and hang out with friends in real time.\n\nWhether you\u2019re racing across maps, teaming up to finish challenges, or just chilling and chatting, Fox Cavers is all about movement, freedom, and community. Jump into different environments, meet new foxes, and make your own adventures every time you play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/d/1pIWqs18XAs9aAFIvtUeq-jSZdwNZAARr/p/1BnpOfMHqx0mNkjkKMuhdQl3KPmD2Xfhm/edit", "developer_terms_of_service_url": null, "publisher_name": "FoxVr Devs", "support_website_url": null, "website_url": "https://sites.google.com/d/1pIWqs18XAs9aAFIvtUeq-jSZdwNZAARr/p/1BnpOfMHqx0mNkjkKMuhdQl3KPmD2Xfhm/edit", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26320760877525522"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1869215257032283"}]}, "baseline_
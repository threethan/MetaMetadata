Z1PM9KWiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlTXP24xNLH7N-A6ACB2YyDdSSovvH1YGYMTM00h8DQw&oe=6A4D0180"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4CWgv9qoE4Q7kNvwEKk16P&_nc_oc=AdoE1h1ef4SHb8CAk3FdRY6JP0Dydm7Yyg9ff9i_I8-QwoQacu5OQY5iVl9daOW-qGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsnUEFngcnppJpmnTzkMXE4aRgjm7Qm0e6pi9N4i_c2g&oe=6A4D1ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2IZA1fFxxoQ7kNvwFq39o4&_nc_oc=AdrdT3H2uwTMDqajCX7jqciO0BqNiDS41EWhaFH1CczUum0UOV2MxkjUq4l8PPW0JUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ur6kk5GXW-JTcFpwME1lMPfVW3MHF9M-OOP802ag0A&oe=6A4D1695"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
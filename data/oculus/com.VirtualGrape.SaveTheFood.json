uluscdn.com&_nc_ss=8&oh=00_Afy-Oe7VHKsSXpJLPpSIv-efUozbZcDB8pkS84TC9vb2Hg&oe=69B2C200"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrHtyNXIdn4Q7kNvwH6mSqd&_nc_oc=AdlwWsNzWy6dcP8I83OzT8qfgkZAJ-vd9-XlyvgO7nGOVvf3XutTY9dBM57vDGybGl4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwGWyoSJExMw-LoxnYWs3NDYG225q37VPbIiBl9_ZXvUg&oe=69B2A31E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww3Cf9fxSYQQ7kNvwGYmBNU&_nc_oc=AdmEDkWQQ-7Cl0iDwZ7JGBe6xrusfzHJs3fLWIagZc-gsNQCWaUIWbA0fF1Xrc-HzJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZD4NXXw0r7dlXRUG04viGuCz3Qs452gOtXXK6qwaccw&oe=69B29ED5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
8FOxi4cdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nk2HdwswQclssZQDFJ_TYKEN2I6mEVMn10yDWDGylXQ&oe=69DA4F00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6tsdeC1bX8Q7kNvwGEevmR&_nc_oc=AdobWw7n9SBWzlpRdyV5Sd5eJrWIswTsEpxgjoI5rQOUl76EqSynmiOFpwFUM7tOPLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08PP7JLVqOI38v1Y3S1htbVosAwe77XwrE9ctKdtNFBw&oe=69DA301E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq8PLY30xn0Q7kNvwFDybu8&_nc_oc=AdqRSs382rCwu02or9JGSN6UYem7U1e-HQbDGejVWIg3xHeN_RP0PKH4rqXrOgZuj3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hwOuK8QIgHHKM4HC9VcitD5uWM2Y2dm5RSjGgG3QpxA&oe=69DA2BD5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
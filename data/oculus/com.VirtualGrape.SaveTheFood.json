8RPOAeQ_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-kE6JgFtkZDB6rFivE4vwishI3leZr17nN79yEu_hQg&oe=6ACB9180"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27BF99Y__N4Q7kNvwHkQISA&_nc_oc=AdoLlvV6jPmt5H6u1oGF6gZ9W0uFc-C6cWC7K4ePDtfsXICaO0M2EHfs6jbAGx-vnX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqRGBwQA8QMS3HVM1haIyBuhnkuOYRNJgrjOKFD6-BNw&oe=6ACBAADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYSlqOmQj-UQ7kNvwE-_t7G&_nc_oc=AdqWvBur5pw3CT44ED6Gp-OxbuZHzeNjjsbKLWv8I5HGU3x43OlHk5_lUEdSgiSJE0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_vm5ZTq1Rzl8Vfxew4e9Hpf7uUTlL1HCH8VtMA9GM2A&oe=6ACBA695"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
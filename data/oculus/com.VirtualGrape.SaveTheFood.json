ZyI3ip5gs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHiJ4FnQVhhpVFHIrysTacCmOBoPFnSC7r1bC0pSUd4A&oe=6AF47000"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgz6o2lBKeAQ7kNvwGED7kw&_nc_oc=AdqoAAd8v1GDWhmpjcr5LWTKff8n70sBsXC4vYDqz2liO5cV-65sAzFGCRWlR8pv-HU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp4YPGB7kNjhe-9pRdbCcsMbGEjmqkK5ltA-IFbwOUJg&oe=6AF4895E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DI41NDg9DQQ7kNvwEK-bEX&_nc_oc=AdpQHxqh2k8oqiG3nhu_5BIi0i9BmugnOcmTepeMVaTsU5Wm1SMdy-epJZ1FIY-X-4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Gxn469ftyaYVa8MozqlfeUk_ryr2jeeSrGYOH9B3oA&oe=6AF48515"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
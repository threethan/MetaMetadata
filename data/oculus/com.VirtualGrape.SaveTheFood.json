r2mD7-kZ7GI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFbvix3_KNj64s2gWTmPu1yJxhBxGZ-BJTyOish6kHzA&oe=6AA40480"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvp5BADknuMQ7kNvwGkLsOq&_nc_oc=AdqHD06hAKy0wUPcrj_cHXajv5TPYGhAGlpK3MM-SHcpl64ooaQJ8WrlloURSOI0dnA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb0r4UgBqQabwrYgifb0tz1X9SqSQ_NIuM67MidTX6nw&oe=6AA41DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8FXk4OshT8Q7kNvwH6ExY2&_nc_oc=AdoVGvUctWtrKei6A1eRAyCdQmZbVO6Q-PzJvzK_q4sanO-a1kmGLt3buYKpV8YOj_8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHkAZrmrN7W8QIAeDy1qE6jHib8dkLEUvJVGCe9jEqNw&oe=6AA41995"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shoo
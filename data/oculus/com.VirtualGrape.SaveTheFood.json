uluscdn.com&_nc_ss=8&oh=00_Afy94roRRfQjoTMP2jZsUesFwC29WWW03U53j6u6W3f0hA&oe=69B80800"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuJZOBH2ogcQ7kNvwGHqcX-&_nc_oc=AdlAzQrxzaTcOAP2_uLpygc1s_goqzu5b30lBwFyUe3GUOtDOcT7dW6wcze04zinUM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpGiho2KAtbWThxJTFbUxksjDB9xQnm2EbkYxhV6UpFQ&oe=69B7E91E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHEXg1FjmeEQ7kNvwF2zEIK&_nc_oc=AdlP4ZD9rlMZZDrTEE6SAYkkc02NqMVqgb0gTVn3gDH56TM947navfwdwDeNg-8ItQY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxc01rJ06XL-kER5MrzIOt0BlUn0zorI6Gkx0VWjitMow&oe=69B7E4D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
uluscdn.com&_nc_ss=8&oh=00_Afx5OveA_gOKtii1jakLeXFtnfLC6GJaAwVvlm6JTyI3Hg&oe=69AC2A80"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXhqHCuf9ogQ7kNvwGBR_Un&_nc_oc=AdkspQaZ8s51hBpoOgkoanS5T0IvVbLWHqe2EZN94QqZ8HlnvP2_uS8cVlLcjnkV0zQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTcAcDoM1Jrr2mzfS4646tzMhdG6mCWczAarFbHQD5PQ&oe=69AC0B9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7xZzWPeUboQ7kNvwGXrssO&_nc_oc=AdmdGBug3DmB0dWv9V2477miBddOi6LnXZyNHhYfnMpb-TIvp59zGF4mpRv6EX9O22g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxEoeT7jqIlb9iHfKP_L1yTiBGK-r2EVj_fgxZSJcYR8A&oe=69AC0755"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
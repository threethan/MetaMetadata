NLJu88qgE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8I_193aEKqS7-eYXxUHZy4oaXI2uj7g230SV2l2qiKw&oe=6A660E00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fvXNGLB488Q7kNvwGLHvKY&_nc_oc=AdpKnpRjxMp5H-C9V0Ldq2XR7w56Apc_gIegug_aRcS6q-_gOx4hAUCnE1u7SfbtqsY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5JdXAvq9nlsnNeyH1gK7Q3HAiDy89LASL7gL2rzTayQ&oe=6A66275E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzkxkLFJnVkQ7kNvwH0nYbz&_nc_oc=Adps925E0tGIl_XztBIxvgeVdcsKSJdt89DWgsStFoOkS1BH5xNUkMHA5fVtifeO9hk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnn-6eeJf3sAxYYruEjshmxJh2rLTFNzyhN14H0D6KxA&oe=6A662315"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
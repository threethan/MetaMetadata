uluscdn.com&_nc_ss=8&oh=00_AfzMiRcYKhOIaD-LNFfhlYBv_S8IunOUn5ZwVv03yQFuDQ&oe=69BE9F80"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgiJOse50GUQ7kNvwE6ERyE&_nc_oc=Adl1WSYIqm7l7syuaJIfxs1v6AH9FiYEXuYxdn6ItPkgGHHZ0a944dOqZxLhrxIkZ38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1dxPiJuxvrKBsjXIj_x9X9h3Qsrim1KwaCJU_5JeMIw&oe=69BE809E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM4wm0g6qHUQ7kNvwFMXcEr&_nc_oc=AdkZ-UsnBf5o0bhazm0aZHQ4IoUjlP5HMKh-_ugGMCLUZMknqHqKkPkcMcbN5J6DmMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQwSpQ0Gd2vqYQv2tHGeSMgaNLI4M-Dh72rvdg0ogbRQ&oe=69BE7C55"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
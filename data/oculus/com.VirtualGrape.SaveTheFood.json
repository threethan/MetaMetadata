GFLgTck2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B01z_JcozFzquE5Hek2QRHyLpzX9tRXy__jxMKrY_tQ&oe=6A0B1680"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkQ-DRQJlMgQ7kNvwFtsiHI&_nc_oc=AdptFh3PR4-ETrXrk7RBS-1wxd5eKYbf4OAZEASkFH7zr1ASSKRStI5N0PhgHStZNDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GaZELC-za5-kvHKJfg2dMkol3NbJNb0MxYap4HiCEeA&oe=6A0B2FDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E8vsgevo20Q7kNvwE0wHoH&_nc_oc=AdpmZV9xIc3LbuUYq4bQ7Iq9SWQppPsRz4TDB8aHCKt4WOgZ7oiZS63k6pmO-DNM94w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4igPyrur2bhEyadefGK-2s48A1BCY9tTxdQcZTPj7phA&oe=6A0B2B95"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
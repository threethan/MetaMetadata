6hz8msQ9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xjEhKTeTLBMfCMsuAF-gA7k8uUoyX_oUKqxoo_rgmXA&oe=69DE4380"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJGg4YtsYCcQ7kNvwFU5dA8&_nc_oc=Adr9qGDjdgjs6eZvLIlH2usb_NOlxh5BXlVi9qJ9NXaw2C2VIONidKcs0Fa42MsA23Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gXifxYTvzZUxM5jQES_t7ztWojZ3KvrfV5sXMfhpFlg&oe=69DE249E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyamw8L01GcQ7kNvwG5I9K6&_nc_oc=Ado-HSetJ89MLsNfCLk1dmyjbz9ufzpsd18pbzoD91LOtepArLdaYmcwcveqa48stsw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ax05-zKwX831hk0bcDEv-jZdsdfYtd-aEJ9U6im7mxg&oe=69DE2055"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
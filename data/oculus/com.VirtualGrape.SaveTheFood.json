uluscdn.com&_nc_ss=8&oh=00_Afw0xica-xGPsnAu36Qv93jySeOKMLDlypPGna1SlJpU-w&oe=69AD7C00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjaD_iPSxboQ7kNvwFHaHWv&_nc_oc=AdnwQHMBJu75L2QAo4MpPuqe3Rq_FmGSo6TTqNzky0UY3IH1oFhFrnkE1zTmuNPZtFA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6G3_0wjkt1aPiwYZQfcFHM0XFj9Z3zfle9BWO7-MXBg&oe=69AD5D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjX07-aOBN0Q7kNvwG8Nco1&_nc_oc=AdlvdNWgyjonUInjzLozWGDw-r4T8_fXOsyx0hnz82lmGasllzaO9eskhrG2lah7nlg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe8qCGR3Fl0BhKE8lU2c6X-V9MpSH8f4GelC_0vJbvvg&oe=69AD58D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
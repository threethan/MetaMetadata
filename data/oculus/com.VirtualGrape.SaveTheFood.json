jjWg0ZQEc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmr2AMw-l8uvRAev-puMicAJN5xlKqq5x-0Plr4X9S0g&oe=6A974600"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66WYzydEVeEQ7kNvwGllp5e&_nc_oc=AdriqZd6bx_8CX-rf26RtwMqeimUStsZqtuYHThXLbNT3bmeO6w8cfqEtSkJv_v5HRE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAGVrlt2DsX01dwfDJMEiEGl7Upk9jm0JiANcyt3ZHrQ&oe=6A97271E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvGY8LG1jtIQ7kNvwEWnT_8&_nc_oc=AdqcGIMJO5aAllVUaHTSb_iCUjZ8nBYoDk3gaxDDrykl52lFOvRgDY66Uag2p6elQYQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4JURAplVLxdD2KyDzcCB9rzoob0Pn6jzOQiHuSb5bKQ&oe=6A9722D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
z_HcAooKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q1_8GF_XCEoPZ0HCXlUM5ThgTw_93eTseCeCu32Bmsw&oe=6A2ABA80"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D_PODq1sXMQ7kNvwGj6aa-&_nc_oc=Adr18ir8h_xmFdBfB4shrmD7H2tdUCAtmK4S_LqD-iIG3bM39qq0Gm3mfentj-IIhIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mVcLW-AOtFQp6p7w47a1p1xiPxVahP0qwtYftPXPV2Q&oe=6A2AD3DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJp04ooNyaYQ7kNvwGYp22-&_nc_oc=Adp_aqsEoumCt1Jj0ZuOrIrZ7LV-1vrb5bT57SNqArx4oeZVOWzCCFIwZ9INs9mW84o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-bTv4vCeAXFPhWAAa93TEqsJQnDZawaCvGNvVTk7TLQ&oe=6A2ACF95"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
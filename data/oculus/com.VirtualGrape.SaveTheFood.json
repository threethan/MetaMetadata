xzfmb9iwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75dieUEWEAOEHdxBqlKFGcnwggUolIHXvNN7LNRzcxhw&oe=6A0DB980"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4kPNoTocj0Q7kNvwG-zMJ0&_nc_oc=AdrAxwUks9Hus8B7_SbwX6tnfIjcWfPXQyeZ7o7M-XhvLubisAozo5J_Hi3FXmAPjoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AYrR0z39ImcpDDMggdlCwz02eMPoCU-peP-mAwCKXxQ&oe=6A0DD2DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E8vsgevo20Q7kNvwEyr70X&_nc_oc=AdrpVy4KJFRdO-Ma8ATzBlHaB25EsICMacM_-ikKxdZj_D_9LW7VVAINVxKPpBQiTN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54meajq8viMAM_704R9WI4nUh8BDDRD0M5hcRp670tvQ&oe=6A0DCE95"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
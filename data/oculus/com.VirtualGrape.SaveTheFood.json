lgwLWYCrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyERB1_sSyDgQJAu66pLetcr6GEkmjeeXmZD1frQZ4MA&oe=6AE74100"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snFbBBYimuwQ7kNvwGU3ONT&_nc_oc=AdoGd5hQEL_mk4CVo1ZqSSwe3her_hZ5BRE54Nh6ExfCoEtawYNYgS-5LF6kD9Deo2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Ith6rNwC_EWgNnlMXN1U4iCgjB8VbV0MBiR2reJFTQ&oe=6AE75A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ6l-4wrNR4Q7kNvwFXbhQK&_nc_oc=AdoEE5pRRkNZYDPEnlX6WAvHyqnuWN3SRZQPL_IltulL51Tb4jFGRjaVHOBvO66lFos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdvz7owWR0-zjUES1WJVb1Q2d5DAqIzfiDg6k55gfLMw&oe=6AE75615"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
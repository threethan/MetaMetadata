qfy4Qp3tw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK47XAi2tDRbA_BJwJLLS0KzRKoqbfEkgEJoPrsvyiyeA&oe=6AA2B300"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvp5BADknuMQ7kNvwH-gPtA&_nc_oc=AdoBrAMOKqi6cH5HeL1iU9Zwye60kBIK87XvmUDN9p8ujqzPc435kfG0Cg9dDcjJK4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5ejav1wYTeO1gMVQ4452mCPhSittvsU8SnuxmNerDyw&oe=6AA2CC5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8FXk4OshT8Q7kNvwHXE1uA&_nc_oc=AdoETJavtd0Jr9RM4m_fPMEq_E4iHIOorD5LIx7b432aFVE9Y0kbAJGEn4RSNuwD-v4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhFT1EVcfqQ7ZqY4NQuw6uT7TxqaTJEWCn9kkH0Xc_xQ&oe=6AA2C815"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
ZGxRBcf1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAGrfwxagdeUnfIHtD_04Q_8hL9-hPtKc4v_LDx7samg&oe=6A709A00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4xDpQJCCbcQ7kNvwErXQhr&_nc_oc=AdrHK0c4Gv-WxeAk03fkFG8DieDrdKykzfUgbYfb2YSJj4LEe9MNTC92hBneML2JyKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPki_D45Q5toOAnYu-6g11OE7KfyCf0ZlY_Sg9J4VVFQ&oe=6A707B1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUDU0wGQjmUQ7kNvwFfy7ty&_nc_oc=AdpmBTz1IeB1kl0aQ3L8YlV39BbDAQ7VNy7dS-l0SDFDtkw48EAjXaTdEsF5qbEuYo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtHOHz_kmyVd_cVYhyUFJkCoYPcqSN0tXJF-vp7GIrIg&oe=6A7076D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
0fyhoBKeA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfbdXTUESszVtNCKyY6kHpWI6udH4epEF35CC3d9txfw&oe=69C7DA00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP_YiNqd5IoQ7kNvwFBTqVb&_nc_oc=Adpgyt3pL5u13Cb9crsVjI3nKp9fYDlTb9sgg839_dS75rSajdRbyjQK2mOJmsb-Un4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5djW5QPx3EwM5ZjdfXIP1QFQC10gZdpBPP9pLpeAkAg&oe=69C7BB1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzIS-5nIMaYQ7kNvwGAPQhx&_nc_oc=AdrHtQ8EAXhiDILZnCSfVb0MAcjBZTKUBi098wI7xZ9yQHtfkvei50gmVZL0vbLtVKo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIsjcsJDoFb99_z356pz6On5AQ0Oz5wTTf8Slx0bcSMw&oe=69C7B6D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
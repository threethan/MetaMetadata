Yn-HeIwEo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAKfO4V37AYyI-dA8Or5rledVgUwP9evp85h7p5wFYuA&oe=69C3E580"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt9NBw1cYFMQ7kNvwG3NNtb&_nc_oc=Adq7J-_Lm7DNqz1OJNIg5jr92glXugUx9I8Xy0wvbKBn6QBQQKwvh0JMnZBYN-VjTL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHMqcP0C8LNw6Xw6jszoHcM9St2_H6xWzpIDSbQcLDKg&oe=69C3C69E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51qiDEwLLJ4Q7kNvwEwcCOg&_nc_oc=AdryLRnhUQKT-HVohnnPdkaE80dngXRH_hHiMnE2TyBIB0TSqZaKDClwjAsgnD-hnAI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMaMJ_835eqiGeISiFHcPSGnptVVxn4ILNp3YtMSsSHw&oe=69C3C255"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
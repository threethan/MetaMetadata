0GkHZuPPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ4Cor6i_ibozUJb_j5di1MqTlJTHL2m5jyN8obbBimg&oe=6A4BB000"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4CWgv9qoE4Q7kNvwFcyVsQ&_nc_oc=AdpTkH0cu_l_HIg1zHvm1gG2FyE7vOM6MAVDyxnG6OjTVYFeW5KU8bx2lXyDoZrW7uE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNCjiGRmL1wqAeW7cNW-IQb_KDHXU3Dr8J-X5j0DkdOQ&oe=6A4BC95E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2IZA1fFxxoQ7kNvwGb3blQ&_nc_oc=AdqMvGOg-uZqSxXR6WOMTzOlGRPlP1xFiJTPP5zWKTlqsSEbospWKzbDNBm7ZGUynT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcpW4x_9kF57gPk2WKGCU9By-DK0IaOt3lWi9ZdiXUEA&oe=6A4BC515"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
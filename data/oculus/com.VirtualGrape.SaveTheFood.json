4s-WY9-D8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iRCEvx9awEBijsmlgODtpQhDtRxTEf3oLwzVku_rYxA&oe=6A05D080"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLw8pc-6eLYQ7kNvwEeJOD4&_nc_oc=Adq063QdJCXQbZL37tpJMmAStYxjGvU6nA77h6tAlqBq_gLubX3MltwRE2K65j6xhqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44shBQyPX4v1OWDjsilRKXvbWx_MqJ1RenGlPMeF2kQA&oe=6A05E9DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_omBEwKUcoQ7kNvwHLTKGO&_nc_oc=AdrLtTlwpAgqevmyljyaA6EE2loIT0GvNVnZYxXMAfAfD-sG4_H0BA8eaEWP4wgeCM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qkNMxIPny0sPgyNacXK7BrBd4qvBj-Q1Osd_cXWkO-Q&oe=6A05E595"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
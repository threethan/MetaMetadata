m1fbfNKbg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UecnFzE6K37EMl9mgAjfnVjZS9Abo1th3RCM2vUuvYQ&oe=69EF6700"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNUuLPTnR8wQ7kNvwF8lr0Y&_nc_oc=AdrVS0FxlE_KiT1uVQPXF12nLlaFdO3LY3mdLGkFqvvSisJ6Nt4hd2qWg8w_bZuW5BI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2i3d05ELrpfm1iwCATsA01w8QPAiGYag8PRBvLh1GUeA&oe=69EF805E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGP-iSbQa1gQ7kNvwEw-TW7&_nc_oc=Adot4M_j8cmPqt1oEfDpa_Sh3nAEOr4miAens8N7DBebIwozniWSuvGTcIKPfMWOqw4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1sCv0mDOimcJkZEL1lJ4cvliSJPMmc_oL5lr0KyvlVkQ&oe=69EF7C15"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
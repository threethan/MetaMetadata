4kU7bGR1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMykVnnVI9XIx93c8XMYjDVf5nw_V4yMg5yTQB9befzUg&oe=6AE1FB00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRDjRy_MDXIQ7kNvwEZ9_8N&_nc_oc=AdqRqR5267XM33-p5woocNHn1jJqKlaWn8X-sbP2ONxMztTt6B4tZoJ4malDMF7YM48&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkEODZ5HtVvts1sDLZ8Fxf8Sad0INYyc51Fx2X4yP2_A&oe=6AE2145E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whp_XuLnR04Q7kNvwFKYp2X&_nc_oc=Ado_lTdHXxARN-0Lb-z0nBUXTtLXPIgqV69y-2EjjkO73wsjJzhjzVT4EHdoO9vDfN4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpVAb0W2Vf60c8JNsJpy9xFOP52RBEV95YntiE-ajoCA&oe=6AE21015"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
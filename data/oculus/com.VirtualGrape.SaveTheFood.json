uluscdn.com&_nc_ss=8&oh=00_AfzC-3Gm7EbHYCiNNONr33n0mxETdgVQgFbcEaAHRxFvLg&oe=69BD4E00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgiJOse50GUQ7kNvwGuj1UD&_nc_oc=AdnzOF_oqbQskavDVjuBfQ0RdZ0_IgzV-SH4NFbMHvPvC65GHQGGE9ewmo3X1vptYJA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxvx6asTKBBZ_iNlbzpxrRmei6E6-xBF84tBYcIuMdI2A&oe=69BD2F1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM4wm0g6qHUQ7kNvwGzi-3t&_nc_oc=AdlDU95_t-1L2QPp8RdsvdBINIIcbf8zJTp9-5CC1AbZjFm9EmGhr6I9Q-cmhWZTufM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwae2USCWX1QbNti37Gef6LsSMO5DjcUcNv-WFxEjq92A&oe=69BD2AD5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
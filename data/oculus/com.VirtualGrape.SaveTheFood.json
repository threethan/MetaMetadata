0WDlJzEFc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz2a4MIBfk0C9sTkoiOPOewzcZe6G_iJCDwoPGlwHGpw&oe=6AEC8700"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2byno86otsQ7kNvwHFfLOG&_nc_oc=Adq0kZcEOGIirIi5_2W3E8UQmHYnHlmXkXMz6ZEr8MGvfV3GI75lHB7wW3mxtgtXGIg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSOnIiJFt23e8BuhZQVG6ZHiDPhvbQhgrQaAZmuPDmcw&oe=6AECA05E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QruTdXhywTgQ7kNvwHUokwX&_nc_oc=AdpLQGfXJs6xuI2mQId_kq02LUvd1dNvbv1M0GITd4GwBVLvgeE5iDudR6K8G9UUbHg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1OT7zVJJMe52pNVKgEuM3VH-ba_hK0njA57jNTM7pMg&oe=6AEC9C15"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
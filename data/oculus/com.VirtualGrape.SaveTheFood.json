7XDa-DXKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHX5jagf2NQkAR_oZXO6qKTTcMY-3UBENdO-ZYzzX00w&oe=6A9D6D00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyxTZz68TuwQ7kNvwEUFfaS&_nc_oc=AdoUMp0pTtayBm_OLOBb7zX0pnG0K_-43U62j-WMzoEEgXsVdjD0ialrVKnD6_qp9tM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVD6r1NqLevtgaFTvxIdb_lOqr61C8WyYXpamp3qc08g&oe=6A9D865E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3KPhJrZcjoQ7kNvwFoHqvZ&_nc_oc=AdqgDsQWv-sWPd_9KSNOixD8IRpUBvBeNuoHPLBAB6YN3-P0bmNLePhBFPXBMJSRCXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITgA43bl-K8eiHCj7EP3Y5_uMRdkz5ATP2BBT_f4EAkw&oe=6A9D8215"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
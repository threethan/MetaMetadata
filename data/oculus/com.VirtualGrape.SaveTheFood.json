7h0k8nRJg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOLtqOja7qIzWmyBPtsV3J55Q4ienyUEPM_tHZMVF9Og&oe=6A918F80"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NwOPYAk2b4Q7kNvwHM6RYz&_nc_oc=Adr_-h0X_z9F2sIJaflkVpE0gMWV5judSMk7EkjxCYEVjQHsa02KyrHbnJcpVSPILbo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0He4mm4NtFdtQJyrxxiX3SuRum89-aOiWQHIlYeLZ2g&oe=6A91709E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgUR1XZ1V0sQ7kNvwHyzktj&_nc_oc=AdpmFEkMfXALki5EB_rfxey4ZygJVUmsOXLLKhiEHkZxHwN6TscaFI0zeQtyxP3Xrls&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4vU4eVU8gH_jyei7JwxhQbO7Xok-1T4G1SjUmdftfbQ&oe=6A916C55"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
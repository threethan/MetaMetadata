ZzSk5gB30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWcjsGesEqdUruLRyN0gdt_pdJupHis5F1_fT1TCCkxg&oe=6AC3A880"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIKDk3nFtgUQ7kNvwH__8Hf&_nc_oc=AdpoQqAjnSBgiVC8oOknPJyFzVfIvCBb3XI3nxa14icD-xmGEEQsLzDevXYBLTeQGSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYchAAZNN50a-AeddNIv79GQhxw4WA5qff_9oJdUuZIA&oe=6AC3C1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXcQ3cw7PCoQ7kNvwFCDFwM&_nc_oc=AdolASSJu5xOaIA5qEAQosB79HrFDs68lZZw5OO7oejNZjzGwwWjwRIolf6UGLMaoc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNMxpTnaZ3p7OFGE8i-IKx5i7fyMCf3QIKLfDWFCdXxw&oe=6AC3BD95"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
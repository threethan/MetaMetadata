iLFVXXJPw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGUsjtF-TnCvA29vzGOLtKPusXKYudg-RZaGYZ9FJGJA&oe=6AC4FA00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIKDk3nFtgUQ7kNvwGH9j3-&_nc_oc=AdrlOJzV0Yijm7eCEAUkS7rj5kFyByWaVcKproqyhoDVhHFQ0DCuwVhlP94cz5rR_kY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvN8UNlsxChVyyug1xvky3t843boCWA70kCF-c6kKNhg&oe=6AC5135E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfR1ci_cYl8Q7kNvwEJj9tv&_nc_oc=AdrjdCpqbYukTNlqfm7XzAKLX86Eir_m0sniCP6vgODtVeewjzjddc42lDOqyvFBSrc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODk7X67HsvmojQImBinYBSBX1XHDfFS-ns5zqUVA5tlw&oe=6AC50F15"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
hUXw0VN6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT7tRs7AUskjFQWYm8V3rMCthm-sFkXRYPotTh9ry-cg&oe=6AB7CB00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBTofA4kgSQQ7kNvwEOLQfV&_nc_oc=AdotFAQU5B2PIDv5e4lR9clBYDOj0ipv3yQ7_1uOKX_mlTlfHvSdjBULdya-c882Q38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCC3da22oX1l3H6gzEoVTda0JcwA7yZgY-5LZFonfwug&oe=6AB7E45E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX_KmlKV6toQ7kNvwHp_GZQ&_nc_oc=Adop3TafSV8PfRB8L9w7UHj2apSSDC2sWrRsJ0niOEJqW08lFNVetVr-iyNcF1fn5KE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7iE89hY2w7kj6kKcg_ADL-oJe_lPhYJ9tHtMcVKzW-w&oe=6AB7E015"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
SmzGkF1CCdTaSWJecnaSc3rOD_tp1A&oe=69F20A00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Du-Gk_e-eDsQ7kNvwHbdTkW&_nc_oc=AdotGb4ahN_Ux-9GLZHC-zmuFGf0TkEHCB1_Uj6neYHcI-w7vPHZOnSHoQAj4L-zfHQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2--YaM60fvZrdWL0C4lYHvjo1XVc4VbrDfLwaJxbVz_w&oe=69F1EB1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGP-iSbQa1gQ7kNvwHtM2-i&_nc_oc=AdoQB8DqLUBpK4iTfE_W1jlEoZ-jZPnsuxhso9M34eQm5QqGzuwKD7mlwSUhyIKD0as&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1qpOR7yQmQfPoKZ_sXgTZyCJVNA1PJVf-4AaBqmGfdgA&oe=69F1E6D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https:
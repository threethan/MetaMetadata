2o3mWFOgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YqnjOzsFFnjZhl4EyQ0eEKrUJ8Dno_p3_7ukuEY9drg&oe=6A33F500"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X52UPtSQAu0Q7kNvwEmr_dF&_nc_oc=Adptqruzrrgy6DHN1wXvHJT6YTmB_NvU3ZJoN634FKnoDOCQOvEa5V8E9kzQZhJu2d8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T2w_amnSIxgbR3n4YIrxZSFc_sdd_zZnD6mjydpMucw&oe=6A340E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgHmnfn0H4EQ7kNvwGCubmk&_nc_oc=AdohxHZznRKCcbbuLGeJjUobq1YUbDiaZ6oQJ8fImq98eu8uQ9mwDv_JnYnHALd9q1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DVwS7vrzOFqg3jPx6nkG_JqTvAc2xaK39p-T752d1vg&oe=6A340A15"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
uluscdn.com&_nc_ss=8&oh=00_AfvNq4GFO73BBA7qYH6z4nqahV3NcKjxNFW_KtwDm77x9g&oe=69A98780"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXhqHCuf9ogQ7kNvwG2l-kr&_nc_oc=AdkhO2PsjZVI1UZu5iAnBrruQGbcPyhUWwQVdzgmPQFfZAU9KB37bmo336RFu-qseS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvUIpNIuNHOkXkFWfFXYfhDXq8x0YqSXBgNh1y2K1ZGcg&oe=69A9689E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7xZzWPeUboQ7kNvwFK4fI3&_nc_oc=AdnPykJf1dqw3xLCPX8p9yrskQd8XCb4NZksTvoppHnw0OrTudGRkJJa18xwmGNQ4Q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvTW-bY9w6otyLp7DJvMzYp8h4Lt8DvSmNYU7yD8F4IrQ&oe=69A96455"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
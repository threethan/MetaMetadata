BDVDJ7kdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXtWI3QFzYweBk9kf25m56oz2OCmxWLTxx8fOdZ7f3tA&oe=6AA6A780"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyjiHFe0nu8Q7kNvwFwPP1i&_nc_oc=AdqjDxChbZJRIJcFwlNM03uwJ9Ud-dbV8klAjbhmJddN5bi9xmgWKEA5HRy1Sj-A3m8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5si59vvjh1xSgf3bqw_iO9a9yOQqc_jHZELpon60Y-g&oe=6AA6C0DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_ES84vmMjIQ7kNvwEfvcq_&_nc_oc=Adrmkx5_zLu3D41rux0nh8NkbNdGZsRbWix3Ac-bVqAfakBvo4LvnOwPzz0OOzJUxUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgkYmHbsgI0oG3IiD5ns5MZD4edpTkMQ0TRC-Fz2KmTQ&oe=6AA6BC95"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
uluscdn.com&_nc_ss=8&oh=00_AfzZiMsJKw4M1xTTY4e5ddEKstKigqV0klSlDzrfS69qNg&oe=69B6B680"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuJZOBH2ogcQ7kNvwG14l7P&_nc_oc=AdnhCNo0FEcBywreKJn0DuD0H5KV5Bmu6P_GB79HL2TzSH0dXcCMCaNJTU8DZ4cp2T0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlEyCTForlgVPYt5-E86ix0j1V6AV2IGEJEHWXVDIILw&oe=69B6979E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHEXg1FjmeEQ7kNvwF8A21B&_nc_oc=AdkrjFd9DXUSg2UyuwvkS3YTmCCOQn_7FuED6ED1Jy5yGkplqYTu_J9p7a6A6Er2wTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUzcxIkq_ZRDr6HEmmHbLE7YiDsBuENhG3kQyx3Vh41A&oe=69B69355"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
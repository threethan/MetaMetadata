OIZNcqAro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo8umj4YWi0rJzUzisAYOY1bH2Gk4ipl1pGsl4EBfT7g&oe=6ACE3480"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC-K9IZ8EVIQ7kNvwF6fBS2&_nc_oc=Adq2O1jKT8Fd7Jnz-vnPajD-vssKCEj2mbQzpWQc4xeyO6pSCyJRxepqIII79HVja8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO58SwghHaRAbUv148brbN8hCrX0ZSoq5bgx5OzXKb9Xg&oe=6ACE4DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rteDPGctmgEQ7kNvwEEz4f-&_nc_oc=AdqAinFkPG2cc6cJB029ApUCaBAZNiBmI3iWEKYJ3GH2JlmvY5j8bDbtiLMVnrMaEPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSB5Z07fNwPEIpaIj26OTkbVkTYZsFz9Yw6WMVcCWD6g&oe=6ACE4995"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
enshot 2.png", "id": "1198585585115862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391798_1198585588449195_3668716788384268910_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W53YQZdyMOUQ7kNvwGFpRdA&_nc_oc=AdpT5vMaCd-Oeqw6WJ-oQ40egQNlb_07dCnnUvxsZNgEyzOVVOgWVvwiKmHs4hSaw1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzTL1uc4WujFs4WCKK3wG9Euh-WiYENA3ClaX6L0Xbfw&oe=6B01D740"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C506twizTfIQ7kNvwFFOEHj&_nc_oc=AdpqhaZBH-EYJj-vaqW1gEQfbJwHVt8mvN7hENK3ugjPMLv0ehp7BGdm7xvBUjQI8Ps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwxpKXIqrBGhrDA0_Te8C3rNb-6mecJuxDkcobx5fHTw&oe=6B01B85E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS0b92GkJrwQ7kNvwHJ3LLL&_nc_oc=AdrFuY1rLqOMLzRKzSzSKggsxMSqhaySE8PdwHMhidpLxBUoMZ3r9UR9FUgvSnzy1aI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRodpqPN-QKTY9zKKElZIhfPsaPgZjFPLnHSqa6sGRHlA&oe=6B01EC55"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rajavelusrivishwanath.blogspot.com/2025/03/privacy-policy-for-save-food.html", "developer_terms_of_service_url": null, "publisher_name": "VIrtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29082530068027276"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1451364545833651"}, {"status": "PUBLISHED", "id": "1057806086159068"}, {"status": "PUBLISHED", "id": "1968150864043522"}, {"status": "PUBLISHED", "id": "819287753911353"}, {"status": "PUBLISHED", "id": "1698310050843947"}, {"status": "PUBLISHED", "id": "663594323011652"}, {"status": "PUBLISHED", "id": "4213810158902531"}, {"status": "PUBLISHED", "id": "4108637382754424"}, {"status": "PUBLISHED", "id": "1359578535350538"}, {"status": "PUBLISHED", "id": "1514642753315208"}, {"st
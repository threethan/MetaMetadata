uluscdn.com&_nc_ss=8&oh=00_AfsbMQc4quTu3pfSuNI3CxBpWjCB75xTBViZY8HVAV2gHw&oe=69A83600"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sO5vLcCl1wQQ7kNvwGyeiW6&_nc_oc=AdnBrHrPA1E2QRhZWBa0pCKSm2ql1kjmsYgSIQZ2eZ2Vk8tJJXy4CsknIaVx9yGJTgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJloQ3HwrOvPQi-_Wv3oYbJMRgM5CzpIyR-oaCV6lr9A&oe=69A8171E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly3Wqbk7e3QQ7kNvwFyL2uO&_nc_oc=AdkPo3lmj-GyYkPomdSqX1NgMZ4sn3QJF8jB40-Kj2rrvrJtBViI297Py-8Lyhoc1O0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsCAm6Vl7dyEVaKgX8uSWy7IXd-Jga9-V9r-gekZYOWiQ&oe=69A812D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
g_iVJOxdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hgtMs5XxqpZAPM3QH7mwtmPrAlLoEFFb-PWpQQidIIg&oe=69E38980"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8O9piAoUapMQ7kNvwH6ducW&_nc_oc=AdpDwJIz-mVW0YuVfufEzIk7l_ZtYBumQKhVFUjflK-JdWIL5YhO8OOnIkJ1xa73StU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2obQXJPRw45gRU8k5mTeEth3sCs2vbO4krWQGYh1YE3Q&oe=69E36A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z-IbGQWJXkQ7kNvwFpuWmI&_nc_oc=AdrZKR-B8coWAI8a5fhKUigYtm_KUOlxf_Qppv4cx6RTFFxHyOj4i_oDcN3AE9Cp_rc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kzrY7psENYouIMZyjNjhROiUD7WYvBYgIWzgH08vfLw&oe=69E36655"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
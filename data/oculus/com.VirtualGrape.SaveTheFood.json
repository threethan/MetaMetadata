FwOUSOOCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNH2yMtqclNwdNcKl1F_K_yvI-CS9XyNyNXIwgFBJRwA&oe=6A733D00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn8IwbJzGl0Q7kNvwGvllwj&_nc_oc=Adoj1aMCdkric9iwSFcn4khF3B2pkqqja_ToKEC3pTGyA9DStzn1BUjpxWz6dSwVBHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwsDnW0yWxWqrOyIIrblkCHerg7ou7NEFTEfHV_mIfgA&oe=6A73565E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZqtsBrhcb0Q7kNvwE370dc&_nc_oc=AdpKFVGOGhrznJbLssuKnYbgqe0u42GXZ68z-nqwhPu-h2QJEwKaNL8OhKrGDQZpStk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeD9his6vszlR3k-IcWXDFCm20lvARRpaB_2Lb4KEcew&oe=6A735215"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
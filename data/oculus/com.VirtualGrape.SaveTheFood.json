cLN8FBmd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQGK9d-0DAPHyxecKCHJOlsBS0xnMxuRn8jwojKX4XmQ&oe=6AE0A980"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QX1XkGdeGgQ7kNvwFx46jO&_nc_oc=AdqEXXDhnbOaprjT6KrwHNKi3Ha_51e60rZtDb7MOoEcmINlYNRsiKimEaDGhhNdSV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZPlVUtHDZ6bgUb8SA-bfLZjFADx-QE_vjwGUJFY3ijw&oe=6AE0C2DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whp_XuLnR04Q7kNvwGFhmJy&_nc_oc=Ado9Syxuikokio76d27QgI3K5-fVAfx4G38hMtPaBpdP60garmSl9fPqSQyvn1xC8F4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpQhJHwIm6qdUlMCnNPZZuYrefZjP5Dk1nnEQF-HP0Aw&oe=6AE0BE95"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
enshot 2.png", "id": "1198585585115862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391798_1198585588449195_3668716788384268910_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxjgI-evyIYQ7kNvwFZPB2I&_nc_oc=AdqmDiybf-RLBc9pOYZWdP1hfo5u3WtS-V2NKy1iiibmMrqHhFZAw74vDdhfMCOIMo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnbyNulPpZjz-98w4_GosTilJDAX3aJN1kxeeW32Lkug&oe=6B047A40"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C506twizTfIQ7kNvwGoi3ya&_nc_oc=Adpaj_M1Ufa_GFU5JXYfwxbrCQ7Tztqcvh1Lw5CFlw3V2wiymxg1Nw0X5T0p-cLnwm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn0nih5woMo2GS5LIpW6Jw5YglsBWO19NYNnHuNhnQKw&oe=6B045B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlnx_OI1VBEQ7kNvwFbkvLp&_nc_oc=AdqA6r7-PhFAcQviTsmVTpOVr069NIEJZSSpiRC33dMVGBwNLll55AF1JKFIThANuDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNn8Hkfy1J_ttKq1H3qePs78dugnRpcGfmquysVdoO_w&oe=6B045715"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rajavelusrivishwanath.blogspot.com/2025/03/privacy-policy-for-save-food.html", "developer_terms_of_service_url": null, "publisher_name": "VIrtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29082530068027276"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1451364545833651"}, {"status": "PUBLISHED", "id": "1057806086159068"}, {"status": "PUBLISHED", "id": "1968150864043522"}, {"status": "PUBLISHED", "id": "819287753911353"}, {"status": "PUBLISHED", "id": "1698310050843947"}, {"status": "PUBLISHED", "id": "663594323011652"}, {"status": "PUBLISHED", "id": "4213810158902531"}, {"status": "PUBLISHED", "id": "4108637382754424"}, {"status": "PUBLISHED", "id": "1359578535350538"}, {"status": "PUBLISHED", "id": "1514642753315208"}, {"st
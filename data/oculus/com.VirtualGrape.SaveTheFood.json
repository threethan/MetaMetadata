uluscdn.com&_nc_ss=8&oh=00_AfyOrdANOBCHppUwiwdey3XQIIw1MEG-rpzTW45ivpw4Lg&oe=69BAAB00"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjItZgB2Z0oQ7kNvwFhtEb0&_nc_oc=Adk5oipEMVwaH0tGbJLtDvdsMLW_IT0Gdwi8eeVcuGRaiGYaWhFNpPWhxKehO9ys6Y4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfycliAF4d54DOZe5rVFcjuRsZXm5ZsPsrlLeQBCp-LG3w&oe=69BA8C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwWgmwkGPwQQ7kNvwFAgRWv&_nc_oc=AdlLmTyBOP6PW3OhJiT3iHPt8mwIG-aMykJU80SXvqo_qT6nVM2ut4D6XkJaKgcglMM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzPB8-C-YeTCuBV7jkUR2b62KcDZKRcMIgukJCQCbSOw&oe=69BA87D5"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter. Can you survive the dino invasion?"}]}, "developer_name
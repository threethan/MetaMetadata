i7L0arPRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzMk0KvoKoMUu9F-GLdwOXXISS2S2xjv5aXTNId3Ur-A&oe=6AC10580"}, {"file_name": "Screenshot 1.png", "id": "1154281889726041", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391840_1154281893059374_6913785642175800091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNOpLJyqgOgQ7kNvwF_4Ec0&_nc_oc=Adoc7OhxxSljC_IQ06NONngtReHklZM04VBk-eQoNEWTmIke5FXQO8cN62Y4QrvAmuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1idYHoF21QiYU2fRnr3heM6AH6VWU3aVJrVn7RQIkxA&oe=6AC11EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1161317871830411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1161317878497077_2527866527447708246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXcQ3cw7PCoQ7kNvwGVWfTX&_nc_oc=AdowO15Gf3vHPl-f2Hm328uKj9uLyQFR9Mu5Etj7h2B6iRHHCYCDGU7dGlxAyKBA3dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjHIwJ-Ch2dQOV7KC2atlywnffE9f9gV53Jh9O6793PQ&oe=6AC11A95"}, "display_name": "Save the Food", "keywords": [], "long_description": "In Save the Food, you are thrown into an action-packed, adrenaline-fueled shooter where the fate of your food supply rests in your hands as waves of ravenous, prehistoric dinosaurs emerge with one singular purpose\u2014to feast on every morsel of your carefully guarded provisions; armed with an arsenal of powerful, a sharp strategic mind, you must navigate through a series of increasingly challenge that test both your aim and your reflexes. presenting its own unique obstacles and surprises. As the intensity escalates and the dinosaur hordes grow larger and more aggressive, every shot counts, every decision could mean the difference between victory and a catastrophic loss, and your ultimate mission is to save the food.", "short_description": "Defend your food from hungry dinosaurs! Aim, shoot, and protect your feast in this action-packed shooter.
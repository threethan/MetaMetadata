pP_4DSgW68cmVkw&oe=6AC3AE82"}, {"file_name": "5png_\u526f\u672c.png", "id": "1304870860703994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035314_1304870864037327_3696751271082015529_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4BFl-fCKYAQ7kNvwF44kKV&_nc_oc=AdplYMXbOWXKKfBmLeunYwZkIh4gLqrDryNw0sLISdqQmJotXX48qkFzmWUYFyvbFfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk8oYFMSuNIO7cZOs2W017-OQ-yqJhISszYaNYD_d19A&oe=6AC3AA3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "453409641129662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392023_453409644462995_6509468407265714187_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDiFyTZIS7QQ7kNvwGIgP0h&_nc_oc=Adr6gt5ht8rZAtq0lFt3lmRhlx2Orn-eJRwpSwQoDOA0asVvajVPlcHdGSiZxx43tfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL3_fnVNHCfDYoSfLmJFNPS97uGLMygnkQWCouhsz1dg&oe=6AC3D362"}, "display_name": "Rift Hero: Mixed Reality Horde Survival", "keywords": ["horde", "survival", "roguelike", "zombie", "shooter"], "long_description": "Rift Hero is an electrifying roguelike horde survival shooter crafted for the immersive world of mixed reality. It combines the pulse-pounding excitement of mixed-reality home defense combat with the engaging gameplay style inspired by Vampire Survivor. As a part of the RIFTER organization, you'll encounter:\n\n- True Survival Horde designed for Mixed Reality: Experience frantic home invasions via spatial portals (RIFT) straight into your living room or backyard. Arm yourself with the teleported mech arm and construct in-home fortifications for protection.\n\n{1149580040281121}\n\n- Hordes of Enemies from Diverse Apocalypses: Confront a vast assortment of zombies and monsters congregating for intense rogue-like battles. Navigate through a sequence of realistic battlefields laden with unique challenges.\n\n{1336410470724213}\n\n- Addictive Vampire Survivor-Inspired Gameplay: Swiftly collect EXP gems to obtain randomized power-ups. Customize, unlock, and enhance your mech build with tens of categories of intricately designed weapons and machinery systems.\n\n{1135388438269604}\n", "short_description": "Rift Hero is an exhilarating roguelike horde survival shooter designed for mixed reality, featuring a captivating blend of the heart-pounding mixed-reality home defense battle and the addictive gameplay mechanics like Vampire Survivor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FS8x5FSTlzzehIqNSESRjB7LBqhj-GkuHriRpBUXprM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/rift-hero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25701471156112478"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391935_1070781921582534_520621263412538304_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGrV86XHHF4Q7kNvwEa4Z6j&_nc_oc=Adori97-1ieQH66Lg0AJje5vYiW0Q4E0Uk-b9KImbzimTvhg4N4111Id1f7Y2EjmIP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNx_wbrGnqCD72NxdMQRUo8p5-afT
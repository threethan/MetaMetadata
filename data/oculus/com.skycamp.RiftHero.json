HOwc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4aEcFwjI5Jb0LM9LIXf6IhC1y5ayKMzSex9pjZEFzTA&oe=6AF32482"}, {"file_name": "5png_\u526f\u672c.png", "id": "1304870860703994", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035314_1304870864037327_3696751271082015529_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVujXH9cbMwQ7kNvwE4YjbL&_nc_oc=Adpe_H9P3-T-w9cPsYlwy4CrZngfGl9HNwf3kocGeaA3Qvwj2ZIupY4q88GcUqUoKJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSifTVUu4yPGNxroltxqil0D1vrUCVLri4SMxQunqkGw&oe=6AF3587E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440(1).png", "id": "560322360128914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468721991_560322363462247_5060012018039034237_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03nGAZOtFEEQ7kNvwG3skO1&_nc_oc=AdrIonpfDtOh1oDKxpKsVqqvcpXlrEH6xnwWhL-QEtK9vaSZ-PxU1LqGptEYmrVZcE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSCCkBepjtTYijT1e4SjXi-CUsHAB_0zHHSXTJrOzlyg&oe=6AF327BC"}, "display_name": "Rift Hero", "keywords": ["horde", "survival", "roguelike", "zombie", "shooter"], "long_description": "Rift Hero is an electrifying roguelike horde survival shooter crafted for the immersive world of mixed reality. It combines the pulse-pounding excitement of mixed-reality home defense combat with the engaging gameplay style inspired by Vampire Survivor. As a part of the RIFTERs, you'll encounter:\n\n- True Survival Horde for Mixed Reality: Experience frantic home invasions via spatial portals (RIFT) straight into your living room. Arm yourself with the teleported mech arm and construct in-home fortifications for protection.\n\n- Hordes of Enemies from Diverse Apocalypses: Confront a vast assortment of zombies and monsters congregating for intense rogue-like battles. Navigate through a sequence of realistic battlefields laden with unique challenges.\n\n- Addictive Vampire Survivor-Inspired Gameplay: Swiftly collect EXP gems to obtain randomized power-ups. Customize, unlock, and enhance your mech build, consisting of 12 intricately designed weapons and machinery systems.\n", "short_description": "Rift Hero is an exhilarating roguelike horde survival shooter designed for mixed reality, featuring a captivating blend of the heart-pounding mixed-reality home defense battle and the addictive gameplay mechanics like Vampire Survivor."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/rift-hero-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/rift/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9375745225778330"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25563161856610076", "version": "2.2"}, "id": "2938135559671649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
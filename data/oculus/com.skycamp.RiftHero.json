_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfnIrSjGggIQ7kNvwF5si62&_nc_oc=AdmoWjalRbe3I006MW7tDBT_GktLtvllvmkDIrRiNT_v7IbI77p_nZ1d-QEU3e1pMEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstbSSitb0UKw8k0B_FHBltmqM7O-lLKzdaGvSRhDjkhg&oe=699DABBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440(1).png", "id": "560322360128914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/468721991_560322363462247_5060012018039034237_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5AlbOh0F5wQ7kNvwHExN4V&_nc_oc=AdniKnexlQQiD5muBNMnxBfUqTT4x9DAdlm7bvQ6rSuyMSf8UxhhMaHI_oZ6v2pgq7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSCh5mIq3Mi1ycW2PR3jcy96fn9bSAR2qx2CEv_d7BlQ&oe=699DB33C"}, "display_name": "Rift Hero", "keywords": ["horde", "survival", "roguelike", "zombie", "shooter"], "long_description": "Rift Hero is an electrifying roguelike horde survival shooter crafted for the immersive world of mixed reality. It combines the pulse-pounding excitement of mixed-reality home defense combat with the engaging gameplay style inspired by Vampire Survivor. As a part of the RIFTERs, you'll encounter:\n\n- True Survival Horde for Mixed Reality: Experience frantic home invasions via spatial portals (RIFT) straight into your living room. Arm yourself with the teleported mech arm and construct in-home fortifications for protection.\n\n- Hordes of Enemies from Diverse Apocalypses: Confront a vast assortment of zombies and monsters congregating for intense rogue-like battles. Navigate through a sequence of realistic battlefields laden with unique challenges.\n\n- Addictive Vampire Survivor-Inspired Gameplay: Swiftly collect EXP gems to obtain randomized power-ups. Customize, unlock, and enhance your mech build, consisting of 12 intricately designed weapons and machinery systems.\n", "short_description": "Rift Hero is an exhilarating roguelike horde survival shooter designed for mixed reality, featuring a captivating blend of the heart-pounding mixed-reality home defense battle and the addictive gameplay mechanics like Vampire Survivor."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/rift-hero-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/rift/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9375745225778330"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "703253209499010"}, {"status": "PUBLISHED", "id": "1182878486755205"}, {"status": "PUBLISHED", "id": "1273668557037432"}, {"status": "PUBLISHED", "id": "8714251078669954"}]}, "baseline_offer": {"id": "703253209499010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764420720, "status": "PUBLISHED", "id": "703253209499010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25563161856610076", "version": "2.2"}, "id": "2938135559671649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "921521912516
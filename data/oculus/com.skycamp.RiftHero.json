3KYFLoeYOynkNDGyE3IOL7wIzs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHihU_z6W0RmaP3dkj5ZDjp5eFjn2fgitIn9bJmUEAM9A&oe=6A8EF282"}, {"file_name": "5png_\u526f\u672c.png", "id": "1304870860703994", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035314_1304870864037327_3696751271082015529_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGFUjoa3XXEQ7kNvwEZjANe&_nc_oc=AdpBSmIrzTlqupvDNKSyKTUJl8Uln_vpmWXG5gheeCYpxilujAxpSQFFonlq3ThImsY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP15ZpblEn5rNK4cQJFuGNB5Q3AnNXwZWb3YbuPQFgqQ&oe=6A8EEE3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440(1).png", "id": "560322360128914", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/468721991_560322363462247_5060012018039034237_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxPqz9hNp2QQ7kNvwESo7rc&_nc_oc=AdqE5v0ZCSpjBOTCBcqPPDGIxJUJlFQsSZq4zSBCCMdDGbP2dJj609j6VtsrxNVxLJo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG95P-EccpAh4MaR1N72mR43NX4xVvEsWGKwpYJ_WrlMg&oe=6A8EF5BC"}, "display_name": "Rift Hero", "keywords": ["horde", "survival", "roguelike", "zombie", "shooter"], "long_description": "Rift Hero is an electrifying roguelike horde survival shooter crafted for the immersive world of mixed reality. It combines the pulse-pounding excitement of mixed-reality home defense combat with the engaging gameplay style inspired by Vampire Survivor. As a part of the RIFTERs, you'll encounter:\n\n- True Survival Horde for Mixed Reality: Experience frantic home invasions via spatial portals (RIFT) straight into your living room. Arm yourself with the teleported mech arm and construct in-home fortifications for protection.\n\n- Hordes of Enemies from Diverse Apocalypses: Confront a vast assortment of zombies and monsters congregating for intense rogue-like battles. Navigate through a sequence of realistic battlefields laden with unique challenges.\n\n- Addictive Vampire Survivor-Inspired Gameplay: Swiftly collect EXP gems to obtain randomized power-ups. Customize, unlock, and enhance your mech build, consisting of 12 intricately designed weapons and machinery systems.\n", "short_description": "Rift Hero is an exhilarating roguelike horde survival shooter designed for mixed reality, featuring a captivating blend of the heart-pounding mixed-reality home defense battle and the addictive gameplay mechanics like Vampire Survivor."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/rift-hero-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/rift/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9375745225778330"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "703253209499010"}, {"status": "PUBLISHED", "id": "1182878486755205"}, {"status": "PUBLISHED", "id": "1273668557037432"}, {"status": "PUBLISHED", "id": "8714251078669954"}]}, "baseline_offer": {"id": "703253209499010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764420720, "status": "PUBLISHED", "id": "703253209499010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
d=6e7a0a&_nc_ohc=1AgLMnJIMkoQ7kNvwGTbO7l&_nc_oc=Adrj-I9uSx7wBmFB4MRBbk48Yz1Q56d4gBoqc3SRPUNJA0Gf89f74QKN83-jlYMW0Nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11AKwtE0lQg1JHsJETW-KpNYJL103gY5vQoMTUN0Ky2A&oe=69D263AE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ez0x4oY5PIQ7kNvwGhtKYz&_nc_oc=AdqGJDIgQoA140ZT44fKxPs8eha5BooZZXfLEFk1S1akNXt96XVhuqJw5ZxNKcqBXmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x2nop65XSt2AEu0WNF-ONDE2QbBdZFVPTVcXdrZzuzw&oe=69D2508B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3KvvpwOumIQ7kNvwH-MVlD&_nc_oc=Adrzm77Wqzx2vhEVwqQVK5qcPJUsalQ71XRWIZt9Et95aZ-hwBdkzjk7xveZhZKZKf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gY3uPf3wzlAhJqjNSOVEpcQPiUp1cpKyfcU4LX4QJ1A&oe=69D27421"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W29_U-0SQpkQ7kNvwEyG1Xk&_nc_oc=AdqOyznIT51GxyXDv-pPJJErBfBPLb9Ozn7c9CKsYZaxfsA4ZvlXF9CoDL0FTf1bk3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WyzEB2z2qXsb6_AexNs5m7fxeg4RZ0katR8jEO_8Dng&oe=69D249F6"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1BT_nDdDaYQ7kNvwE08Fyx&_nc_oc=AdoDAEz_HympT9AASe5Z_V2nfCRZaszizdcPiEOi6t2sJ_h_yZnBZu1I_D-oI57IIQk&_nc_zt=3&_nc_ht=scon
d=6e7a0a&_nc_ohc=1IKvrxnplwgQ7kNvwFmoIDv&_nc_oc=AdpsISEq--vFvHQgNcKqVhW5YfsdKLF4Vjg4ZuuiuBKizGFJt5kPh-CdXqdBioDPKGo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UolceLrL9vnWN7NISuQ8yV6L-l6jo2JGs3Z9BQ9-CCw&oe=6A45162E"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZv1qlP-45wQ7kNvwERoWO2&_nc_oc=AdpI4algXT2YtwbD5esG5UNqehKzmgYfVLHflDttnkbtNX5xc5rqGM0GL_I2fBvsmbI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zGcIBUvrMMZVW9Mwng-HL-gfq9XwBX33U7jB7yl0k-g&oe=6A45030B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgbVhdpdkuoQ7kNvwFohB6x&_nc_oc=AdovGyziH2cq2d5tVrJQ7mWzGvFZ1C4rvRCpPw2TJCwfhtO_jV5ys17DuzqOCkjD8Ws&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aJg-g3NmY0jqX3BVpSRfrjYlNtVPP0uKCX0YtbxUnUQ&oe=6A4526A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXl6XdYs6UYQ7kNvwFzIxj0&_nc_oc=AdrCJe8L1kIOWFrM9K5q8UBtJOarm7Xr8yM-xuIMjR7Q1fOPAqSaZ0gi9o7_271OphE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b-43im4jpOVMdHHZP8M8BMCtSvIqyrwpWgE3J7a3MYw&oe=6A4534B6"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wFE7Qojp_4Q7kNvwGIapc5&_nc_oc=Adpm5Zk3Ltwrxm0IYbLoLi0abiZyuflO_xfFxG-zm2L5ReT3rNu-y8hLbZ93qMpha3s&_nc_zt=3&_nc_ht=scon
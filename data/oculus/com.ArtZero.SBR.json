d=6e7a0a&_nc_ohc=ku3P5bqG_xoQ7kNvwGQ09bH&_nc_oc=AdobbECVKGbqWaknex4uz5GxaJ-wl7BMehWhuPnGZ9bU410QPDX53FVy5QWoJOw9NJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlbPg1uirIAok82AiYw6ZQXPbe8kZDl2YBLaVvEyChQA&oe=6A4A5C2E"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jhdMPZTiGoQ7kNvwGam6yI&_nc_oc=AdpJTkdnRs3NQgrICw0kwB5aGGPUq_0Vj3Jvyy9TJgM9_7sY01w5pHPYXMTfsugqn0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzwFCt70AqN1i5TCJ88gvMORebCUIMVPcTYaN7dQV2bA&oe=6A4A814B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDNuYKwkFHsQ7kNvwHcFY7o&_nc_oc=AdpOA2zN-782OyesdB8biRzutarkFx_lgA6aKu6ZQEWcO_Z3s3WgOt7YL6IXZ19EEVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjf17s7GeOHeZrGibHXuycAJRY8668KzHDn3vNBiGtWw&oe=6A4A6CA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OROZ2Q-bs1wQ7kNvwFQgM5I&_nc_oc=AdpCXt_NDv_m3Zpkmai9t2ToVx23wODvYdchulhK0TOgtEAyifaU86MNaCqWawDOADE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKU3OUEKXIKcEHuJhhR69OBPrMk1JdOU6pP85Uq-nZ3w&oe=6A4A7AB6"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F7Izlw-lg0Q7kNvwHHECHQ&_nc_oc=AdrrkzpaIMTMKeITMp3iYikCcMi3GMKB4cTSkMBKV27BSKCYLqTUybVeLg_u7R904lE&_nc_zt=3&_nc_ht=scon
HepFV1ASO5O2HtXFlwlCI_Z6u6wTb0xA&oe=6B0C557E"}, {"file_name": "03.png", "id": "518092482527090", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_518092485860423_6190203085056132411_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gJW4ec29sQQ7kNvwE7cnaB&_nc_oc=Adr9PJvO8xEVKGhNx2zd3zTbiECx2BaOMJhK62c88AY_ZJaCq60JxlRg3TGcKbVIVLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0nKkS6v5522Dnb8k4aGh24haN9FQ0C5uXUD44y6j8Qg&oe=6B0C60EE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dbpK4doXr8Q7kNvwGS6eqU&_nc_oc=Adr3cp_M07Pr2xxUY3TlqTl2gHv1W5DMxzwFYMIBCf1rhZ2yhF3xw_kTVDvDH4Mt3aU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQW32SIO00h3CyaE3hJo4OU1eKpmXQiyo0VpEJz6nBhXg&oe=6B0C4DCB"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVR2Sy5qUaIQ7kNvwHc06cT&_nc_oc=AdpLTOU8323MB3Tmn50xjS3kYpQMtUM6bIYm_Hfpg6Jrj0DSAa2tcoTMzR0H-2CK6ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ85ah9sFn8ctof9QOJMSv_GSUhVcQ4a1cbJH6vT_aGDQ&oe=6B0C7161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6zCrDcVkq0Q7kNvwEgYDs0&_nc_oc=AdrVPE6DJG2KJpBzYLZS4rkCKda-CRQd1saxECRSCXad3f-7W3xVR4bqzxw0l8eiTpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVjagr_3nm6xjneqBHKBNQeJ4-lXNN8LKyRMsIMtFN3g&oe=6B0C7F76"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "revi
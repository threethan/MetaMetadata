d=6e7a0a&_nc_ohc=mQpN9dHOXPEQ7kNvwHpSOX8&_nc_oc=AdpT8blyDmDB7ctKM6EV7xc01rPv6wmyO6jQpj4VsAL4mksnnKP7FUXr29Atxp6Gjeg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEqrF3Gr79Ohtb9PKzRha1EZGYZ1G5SOGVE3IXBXKaYQ&oe=6A830CAE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ht5X7D4a2kQ7kNvwHyQRbq&_nc_oc=AdpGA0i8V_55rAKQMvuhoElAv33SbqRE9BVzWndxSyMIp2tArSW99sTFe6tDheaYfWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCJEBEGLnVhfMlhefleW61mXBiZun0c09BxzdE7q3u9w&oe=6A82F98B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlGu_-1jytEQ7kNvwENliqn&_nc_oc=AdrqN6sYHCsrOjgQ6_QvrryPwiWu6cF0agxkw4-B0lJaJz90H4_GZS8cr6Lalxj6oTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDWbLE3aIb95Ug3rkfQRFsqqJympb_Co1PIRSRCtePdg&oe=6A82E4E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhF8ImCWVNwQ7kNvwEksgLC&_nc_oc=AdpzpB0NXIcl2G2pTW3Y9XOStEn3KRO6Gd8hSAcD75joQxn3krLGccAbJ7x1AcZflQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTWRLyDNHBehBg3t2mDPmTD51Q3UO7kZV1nv6s8oj5HA&oe=6A82F2F6"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE9dKqSKvssQ7kNvwERRqGC&_nc_oc=AdqCqUHzZJBzqGbOCKzixVE1mQ_501Y3eiqebjlLzHJMQBDFKb5-XrQ0OfemjVbBR5k&_nc_zt=3&_nc_ht=scon
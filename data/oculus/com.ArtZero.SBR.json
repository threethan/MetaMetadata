7&_nc_sid=6e7a0a&_nc_ohc=2tNsAtHZhggQ7kNvwH8prm8&_nc_oc=AdoAdRjFwVc0586BAMvgES9T06mIA0FU1u_9LBThQt9kt--X5sfPBVJh1cbN5jE2z30&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i3B3Gw3K8tTsn17I5y1y5yqZ32Wv4k2XEgdOZ03oWMg&oe=6A3938AE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNvqg1zOjoYQ7kNvwE_szIh&_nc_oc=AdpJI47tEUAIY-0UNgyleryo0F9VgX5jQTeWtTZnKxPFn1Bv3XXOnw-Y062wIAMV0cs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sQ5VTCRVrRF9fcQXaEKawtKkolFEZvsOyy2WxoHxS6w&oe=6A395DCB"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF38z-DbbIEQ7kNvwGuo82V&_nc_oc=Adr1YVuPxhBCPSsAA7qiyEIWRsuPGLMGqmvIRWHNTDxvr4T8mvak-cxjnkFDs9c9yGs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-av6LGRkBO3xwDSLCtT0PBUpM7apelIPLZZBFHlsXvbA&oe=6A394921"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0RxYE8qY3oQ7kNvwG41Di7&_nc_oc=AdpnGo5ZPPjt8Agch3YWy9MosEsqe1YJ7u61GtV2-PVpO458NWxAZrU9lqxtfFrMEEc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LbZ_hmdJjulkIgcPa-AQ-2jy476mUlOUEC2EdjruqIg&oe=6A395736"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TlT0v76SXoQ7kNvwEa5PpB&_nc_oc=Adoz2F7Wxhl1KQWPPgabekh2piTaoBxvNDgQ3bP9Fi0ZthgaulSTlDPXBjWVi14ZvOo&_nc_z
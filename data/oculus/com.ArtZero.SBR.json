gkSQX2g1TuO-SQUTR0JP2H0Pq2ddK0UA&oe=6B09B27E"}, {"file_name": "03.png", "id": "518092482527090", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_518092485860423_6190203085056132411_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gJW4ec29sQQ7kNvwE1aJbN&_nc_oc=Adr7M5_GE3BSTpDsCen-uB7V2A_KraH9m7JUXUgTgM61NKonKY-DYse412ncO8X_6WI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeAaXGpwsXHyTLsv4jmEweYggwjHZc4-Z4Wrq6c14COw&oe=6B09BDEE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_kgUtKeOZIQ7kNvwFTLD5C&_nc_oc=Adrq8ocdgnXVmdkiqEl1OMFG4pXH0aopBbFpES8Xjle7Knun54L9pQIVNStiWvh3lSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkjQld1NEnD2j_5cZubnd99PxpjbaN3rbmc-Oig1hbOg&oe=6B09AACB"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVR2Sy5qUaIQ7kNvwHkOirf&_nc_oc=AdrKwwcgvjI_hGZHAB2dmwcGziAZIp_tvarlVCVs9XPFvgiQSA57ddNIpgwMYQ1RJSc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPOusAWXayt3APxfuQuZu2tMyDil9-1Q9tGjoBuU7HkQ&oe=6B09CE61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6zCrDcVkq0Q7kNvwGRceI_&_nc_oc=AdrxViiNG5tUm3SxB3y8hFzzI3HsSZTdErW1cn3mubSpdiufTNkUjTq7qfDA7YxBTOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdnra8pRgRg0oomIP0sDKMzAMx8DJ6sIWZYF_K3tFrXA&oe=6B09A436"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "revi
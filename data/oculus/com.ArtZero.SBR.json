d=6e7a0a&_nc_ohc=zXCxlzzinucQ7kNvwFvJu7t&_nc_oc=Adr_Oyqv4c3P8iVogECJU4zc-Kerxx-vtBQf-yqZiUxg0DfouYD8PW-ngpLee6ZrSsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XyORj2t0KzKAPLeZr2GPWiHeHqAwSce1qxNQ8xnjA3g&oe=6A314FAE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0-2MnQUueIQ7kNvwE1pgij&_nc_oc=AdruEfDppWB6kRmOhATDDvf9_fpXg-YIle8kd5R_N4z4oRyqjX9hF9vhyXr7Bwy_fiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3tTbfdfKY4hPKDUn_iF54vImL2Jka2mB8MuAWnb8N4g&oe=6A3174CB"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42MO1LClkp8Q7kNvwFaCsn8&_nc_oc=AdqNpKn-qvDlwVPe-lPTWvXMfcZ1R3uBT4FNqd7b1caDH7CQwwpuNG6HhL5-GjGwRus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nl03RL3oI9e6tGkjWPZ-dAcDiuqWWEGjxomdBnQ3Cpg&oe=6A316021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WioQTe5Uu3IQ7kNvwH_8Y5Q&_nc_oc=AdotVefqdylUTBTnG4uIdy49u7pW48xWKqHDg8a4nN86ivQFByWQVS1og4NkCOglrR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DygtWN-TQfzZH5xF_f4pXqI3YM6ILPD-aR8is4ol_Gg&oe=6A316E36"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opmzpzrXBEQQ7kNvwHNlA1-&_nc_oc=AdpctSfHcoGmkkHuh763SEZSFtzC3FqcmnnpTvpPYgmuuS5ZUUOK7ldmkqS24Wbwy6Q&_nc_zt=3&_nc_ht=scon
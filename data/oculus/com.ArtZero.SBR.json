d=6e7a0a&_nc_ohc=dkX_HbC9NAwQ7kNvwG8XPSw&_nc_oc=AdrM8d4omrSY9yb6ripH79uymK2pA6Kf4VaTvgEi-Te7UAOXjkatWnITbs1rwmfECoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uti_t225EixHQRDsUaSSjS3pBz_DiQsFD_juKMwbLMw&oe=69FC93AE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdJ0zRl39E8Q7kNvwGuslGm&_nc_oc=Adq5a9shj8e4-DlhkwyQblxjjjkNS5wFwPtgl6AcGHfoRiL6CEG1E8l-LZX1StvIRmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X9cPj7DnmcDaNl-yIjwtaShPwjKJBdCLJ32EhsZh_xA&oe=69FC808B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2urVu6DpMSIQ7kNvwEaHLsb&_nc_oc=AdoUu6nrF4AQT7WeH53paSev9vvxw-rI54-j0jPBKv0bI_A0ZbOmhjGPwSWvnzzgm5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GSn4f2nBLHoImHiDo0x0Hha-eFtm-aHss9m-CFLGxxA&oe=69FCA421"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mpprtk9Vik4Q7kNvwHFieWm&_nc_oc=AdofllD8w1Ufjyo8jzRMHhAe0YDDIM8e5ss_Y4Z9-3z9x_gmczKYbZybWqsHF-WNGlg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50_zB5iCAl1SPiRRWeZnj6fDgvov660TZMfIk7wO2_nQ&oe=69FCB236"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29Kvhkz4s0oQ7kNvwF8OQ6O&_nc_oc=AdqbDu9mNrDvFmHpzrxQTTUW6kIhrX1w_hcEsDbWFXzKaiyGtmPs23mdJR7UHf_SMbU&_nc_zt=3&_nc_ht=scon
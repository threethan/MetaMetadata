pBzh&_nc_oc=AdrSrwLTIGL_0I91qEux6roUslSNj2OWYACsOEZMuTImIBGSA3IZ2Z4-FFW8BUgTJMA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMtVrSvbYO46MSwbR_OC3inLmQCklNi-RhuBZTfhEZQA&oe=69C1402E"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBp2ZUHJP-kQ7kNvwE8dxu-&_nc_oc=Ado_xRVX7Rmj4C9iYvspu9-IDVaD0V6AsCUtn_WFPv3D4yo5kfWDgtQVvKV-2Hb_RC0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyH94FbeuuiJfvnRtALLl5wFwsRuWjScIpzF2bOJ5W9xg&oe=69C12D0B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b5PUb71OKkQ7kNvwH6-xxb&_nc_oc=AdqizMOVQRIvaFKzGm162oZVjaeZ2hNxVmYggMh0NB1s-ybjL8s7e74X-1US8jIAxKU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8jnFFF5iYqj6N5Ig6IXIqlzT_Y8eWhOb98KksP0DSSg&oe=69C150A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qmAr0RE4iwQ7kNvwHX6qDI&_nc_oc=AdoQz8l2tfKsXgp5vDS3PU7vbM1DuzGrQ-e8uxJb72uPpNl73u62A9dtxOMsOYs4v18&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFZVP2p-oC7nRLWyh7fT3qhaJaEBDznTHiVIcXdXx_kA&oe=69C12676"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JegWkwszuDQQ7kNvwHXGijh&_nc_oc=AdrjRrUbEd8aB5ZUN2kysSuUayKH4hRgjNiw6w5eyP7arZdiHiqJNXJI4EuV27FQMXc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYb9bKv7v
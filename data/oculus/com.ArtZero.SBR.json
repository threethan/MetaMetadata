nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvsu5Oj00vVbhdDx0ZN15Nd3hhsKsTdh4PqhKhWFzB9sQ&oe=699C562E"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C60QT6Ue8JQQ7kNvwH6py3t&_nc_oc=AdnVnfZktdTF7kWK94LW3ufwaGZyNA77F_MlRI-eNF_bF0RzNAkgHFk5twWPxJcT2BU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft0QANGIkcjxIBOPwqHKqOJw-1rzlp8meFypFHix-cavA&oe=699C430B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hSnco4tay4Q7kNvwHliAYn&_nc_oc=Admni3YFGsazYceYhXhbvW7wwms3YeMZ1rnNqL3UxEVE9JTU50M4n8Obd0yn0B1hgCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsNpDr2PPJNz-qhUImMCdLZ6GhpgToQ52-itqhwk7S9hA&oe=699C66A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RwPFQwrIZ4Q7kNvwFg_meA&_nc_oc=Adn5zYQUJZk7zoAZs6xZzTTt03OphSM5OvO_eksN_mIvks8VmUxE_SW2yVnn0QwDv4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv57CFaqx_F-YJfvc9HdARixc2AtlFmfr_KBL-qiAxMKA&oe=699C3C76"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDZllDhX9aUQ7kNvwG0Oiq5&_nc_oc=Adkb5LeDxH5p0NVJkR6fr2LDQqa6M9m8LwkVp2QJP4XKhzm93RZV7lq3mKr0rwDrwWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfufMIud2-wBJh9ZGC4zx6Mthgp02jsiasXq8eFrf0QPRw&oe=699C38FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
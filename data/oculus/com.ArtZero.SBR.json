nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuIobUjj3ZqVZ7u6HAelojYoLs6EC90ASj74e9B_PtJiw&oe=69A2EDAE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSoGnjgJ0rsQ7kNvwE0crHS&_nc_oc=AdlAinOrkUltjC1d0f4xFcEpQ6iupBJX8IJ2f-Rdghh2-9SM2prLeB-idPoS9rFyiGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuoTXv8VhCrb99IjNz7rBbkEHi70HfMw65A1aChscFswA&oe=69A2DA8B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIytQYlxN8cQ7kNvwGLfBBW&_nc_oc=AdmqfcSCO3XuXrGtbqvJvypUWYj9GKQp8b6Mbgj4bgHIlvuqfNk-aKtDM2gLseHWxTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUHZ23zI86h5kOcrZzHyiYF48ny8Y7TLTy8TitW3n9ww&oe=69A2FE21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZAsfGzSjU4Q7kNvwHP8sr_&_nc_oc=AdlFkb2AzylXXR_FkvNK7py7aFFKgkuLiHfnXqiTGiFelboPznUIAd5b7lEjXdm1dyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnGPuZ0FgEWQu_CVKCKg-QK4aoS68U_WB1dqN98ccAQA&oe=69A2D3F6"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n92oYbkFDPsQ7kNvwFD1r0s&_nc_oc=AdmJZsY8d9WssKaoa6EVcGyWTgOMBLqN4k4f2tl3L3M53ZJJQGEMpX5iD2T8HTvM-r8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv5lD0vf479-XZcEy-LL-_RjpH8jQNqQc2QKTwantYh9A&oe=69A2D07F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
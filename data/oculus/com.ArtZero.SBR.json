d=6e7a0a&_nc_ohc=3S7ETP8kHH8Q7kNvwGMhvzo&_nc_oc=AdoeCPSRG47-S6Z5DuDUQxdSJRqeAQ5p6DcsIo3GgtRwua2mdA-MCzrSMJdAxkpzRSg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7znlY13gkqVJgYPlAae1w4hS9vPVyxyq9JI8MrMRUZyQ&oe=6A16F1AE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNFUmUEVrGIQ7kNvwGGJl0j&_nc_oc=AdpsaSsK_bJL88D5jEMMcZHFVCxwr0w71ty2WzEqAqzYBEIhuPf0J5ylKOiR2f36pVE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WNkYttRIBvvQvYIRBSclNqISbV7G18lxTzLnF0bjcXA&oe=6A1716CB"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYxJxvReabcQ7kNvwF73wqX&_nc_oc=AdpEIBrDsJAyi-6xxgPzIAYV1251ZLdh9ttHRipEj2neyrlJ_KDaq4s6Y52PzVs4ros&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ka1neBNqsAjW-DOMkJdsiz0s3dqFG7HZPkMJ71ee2AA&oe=6A170221"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0XyxzdPqD8Q7kNvwGQUskC&_nc_oc=AdrlFtWDBGVTDxa9aoskZan9K6UbQDw87J9j5qkisI-DY1aW5MKqRToiTj-yYNuErRc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HXMUTX1Kzv09RVzCZn4mKrgNvMwPYP65aZHrG_H3ESQ&oe=6A171036"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQS5LBSJ0_YQ7kNvwHAdo3O&_nc_oc=AdpllEOU-t2JvCllByZGvy1fC-chqSEXsJReydG8S0q6qBdHhb1wOY5fcEBKC0gQ8rw&_nc_zt=3&_nc_ht=scon
d=6e7a0a&_nc_ohc=2tNsAtHZhggQ7kNvwE8AcFZ&_nc_oc=AdrtVFEW1GFe7gVlztZH9hquUQRVVZ27RZ324RvelWDWGoQS6WSzQfKSaifOH4t-gPk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tUEdIEnX7qgVAtms6Kpj2-CoHC7rmUq-HlG4TS36g3w&oe=6A3A8A2E"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln46P18flVgQ7kNvwGQaO02&_nc_oc=Ado6KLw6o0os3CD-7yDekdRCGP5osLZ_Mm-ABF5lX6oALxhEC5YnSfbY7Z0BOk4rDHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XJgaJfiXagc9YMD0YfJ-VLACAx2JbqpT1SDr7GfS5AA&oe=6A3AAF4B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF38z-DbbIEQ7kNvwEVzbq_&_nc_oc=Ado-Fj-SzwB9jeC29HaKjPg5G1lTNVoLbtFKdQef0MJ-utUL1GTqpPpp34Jbm8ZTdvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ouG7tNDoYtR-G6vfKsomOwI8TN4x_-3Gdg5Wl4HGj6w&oe=6A3A9AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0RxYE8qY3oQ7kNvwFogZc0&_nc_oc=Adp6OL2DCvuoRkOMKXm-wdOCw73Yf61n_6meGDd_suOddHwMpBsVAbUpG_6R-yoqqbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EpICkcTXSPIDE9-7H3ugi1aGnn2X_TShmMfjC8xE2Bg&oe=6A3AA8B6"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fOWymozIBwQ7kNvwGM4Gju&_nc_oc=AdqXlHoIWHwtR2kg0Q23oBGQexq2dEjsYcJhqh1BY3N0C3Fks8eSL-b73QjZvI_CYUQ&_nc_zt=3&_nc_ht=scon
d=6e7a0a&_nc_ohc=BWGVLo2YT40Q7kNvwGSw_yj&_nc_oc=AdqrB5cHOyiRkHq5GeDfStaaxDUYCwIdmG5qKveXZ-KicwRMFfvj57MCdRSsfKyN1Js&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Fl1pw8YIQkOCAQkukibYWN5znIjMgUaov_A9hQWv1MQ&oe=69DA4CAE"}, {"file_name": "04.png", "id": "1357365744707689", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1357365748041022_6548302830011100187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiMfzySmbmUQ7kNvwFRn4ff&_nc_oc=Adppx4XEb4AT1PrJfsQTfIr7F7VohExxwE2oBDxRTx1nz-ZxNuy3uT42CgyJlTqjlUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RTkhNZQlPwt3lUvS58KAXt2B8dh1-z9j1tE613iW6lg&oe=69DA398B"}, {"file_name": "05.png", "id": "942860463334605", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375764_942860466667938_5631723637489656101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tZkUBKfniQQ7kNvwFXrfJL&_nc_oc=AdooGpiwVI-ALOgbLjDnVKnfKo0JQs-169498IXCUy1vMwal6xnTUqjODxoOGZyM5Qk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z0Qeb3xhJt1Ro38BLPPRfQWqT5X5RfE0gukV4JpRByQ&oe=69DA5D21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 2 2560x1440.png", "id": "486342316427095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_486342319760428_1016828465003319807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyTfIjuFokIQ7kNvwHYzGLS&_nc_oc=AdqmZWm2_XOzwd5s_NgkLRejH9GVj3fq5uG8eN3-7ImQfnEyK49aSYvETtCbpFZGuHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E7DySHAAlJ1eVkvIMn_CqtbSrTHbB1A_qjjLKSi6v4g&oe=69DA32F6"}, "display_name": "Sin Breaker Rig", "keywords": [], "long_description": "Sin Breaker Rig (SBR) is a VR first-person bullet-hell shooter. Player becomes Kanon, an ace pilot in the SBR rescue team, ready to explore this machine-dominated world.\n\nPerform badass, anime-inspired moves to obliterate your foes. We utilize the latest hand-tracking technology, therefore all actions are done without the need of a controller. One can simply push the arm forward to release a fireball, or snap the fingers to trigger an arcanic flame that seeks nearby enemies.\n\nWe also introduce a new way to move across vast terrain. By using one's own body to induce movement, the player feels more immersed and less prone to VR sickness. You can now easily strafe to dodge incoming missiles, while firing with both hands at different directions.\n\n", "short_description": "Experience fast-paced action in VR without a controller! Dodge bullet, dodge bullet in mid-air, shoot fireballs or facepalm an robot. Immerse yourself in an anime world and obliterate your foes in the most intuitive way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://madturtle84.github.io/sbr.static/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Zero", "support_website_url": null, "website_url": "https://www.facebook.com/SBRxVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9093550014029796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974582_575544448303930_9134053264264701844_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPYWfVeyVs4Q7kNvwE1JsTD&_nc_oc=AdrEBYyHc0s4USjqmvyT95E_mu1GbwKTpajbT1DRtY_5QFi27DndupqWOF9Cais2RMw&_nc_zt=3&_nc_ht=scon
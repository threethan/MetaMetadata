853_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynLQRobJv1wQ7kNvwEeogKr&_nc_oc=Adr1dJWU5KTDIR-UX1LHoWGoZ3eWUbTcgrkLVIC9QbCamP1cV4vo1kLLxoIVmnIAAzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKoEXyrYOaWYSObLJzVpzWDJjR7ItO4-uYGJgKtrMppA&oe=6B030E0D"}, {"file_name": "Parkour.png", "id": "2472367323264690", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_2472367326598023_6909110891661971755_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5Jh2q_ku0cQ7kNvwHqTEmj&_nc_oc=AdrY9QzFQKLBFEQtbYBbMnb-v6uu4HWlb0gFvIvXC8Itdh3_3VCSJLpZESuDvb_x5ng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9W6709NryJGvR_DVyaOD3i2VPoMn7dQRyethm1ThS0Q&oe=6B030320"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Robotic INC", "keywords": ["Robots", "Horror", "Monsters", "Scary", "Run"], "long_description": "\\ **The sequel to Robotic Mayhem is finally here!** /\n\nWelcome to a world of Robots!\n\nHere you play as a cute little robot trying to survive from the monsters, that are trying to hunt you down, but You can also just goofy around with your friends, & just laugh for their screams.\n\n(What in the game!)\nYou explore some creepy little locations, Running from Monsters, like an a Giant Eyeball, or The first prototype of your kind. Just never trust what could be lurking around the corner, but at the same time like One second later, You might laughing, & goofing around with your friends, then the next you\u2019re being chased down, & screaming.\n\nWill you survive from these monsters\u2026 or be violently ripped apart by them?", "short_description": "You play as a cute little chubby robot, in a giant world just filled with Monsters, Unsettling Locations, & Creepy surprises\u2026, but also Fun, Silly, & Dumb Games!\n\nEscape from terrifying monsters with your friends, Enjoy play some fun Game-modes with your friends, or just lounge about with them!\n\nWhatever you\u2019re doing, surviving the horror, playing fun modes, or just goofing around, there\u2019s always so much to do in this game!"}]}, "developer_name": "Roboi Games", "developer_privacy_policy_url": "https://sites.google.com/view/roboticmayhemofficial/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TechyDavidStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/roboticmayhemofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27342409342053379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_28483263874595067_2586262614489699495_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMAX2of8pQEQ7kNvwHik4Ig&_nc_oc=AdoDyHP7gzpxB8P5hShsSqcTqQHEukPO5Y46G9HNGTYTVKEDhBmFtOmhDVj5ttQNkcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl4f2LysIwvW2WljuI9kbXVYYXEPZ_uKlBSbStI8cghQ&oe=6B032AB5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Robotic INC", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354
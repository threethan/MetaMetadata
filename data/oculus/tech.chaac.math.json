kNvwFDTMz8&_nc_oc=AdpQHrr5GaVycVvP6E2lZ4WDBSJ1kAE3og8spUir7qlvw68MtAp6DQOXF6tY_hHCfNI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI-bLuosKqvBWPU2xvTmGWUNObl5DCBYo_2IYQE7QaQQ&oe=6A92DBC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyOFhm_SmvIQ7kNvwGzF7pu&_nc_oc=Adpmy_3-ySvHtqhToKca4EONAuzD_aw3EPM_TY2mrojoMaTHCymqx50Rv_TItZK3mIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnkcyfuj8ulAwFezaX9biYdb6MZoHQNfNnwXCPTg3Vxw&oe=6A92CA92"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szaPKe-9n80Q7kNvwGRbAHL&_nc_oc=AdqUCFQMohWvw-W9UaOiazDKiY3OdlgLPz1thZ8-ibsw8U8ovnbhSHH5Lynu5CsnwLk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYlY8u9mGuKj-L2lSCNty92_zFZpT_wUfK-NtEFrp9Tw&oe=6A92D8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1HI19sJ0KUQ7kNvwEbcfy9&_nc_oc=AdpKq0S8D-MaaH-3nenks1OOhHDQJPeWCT1USym0CcwD9V2RteWQZtlB7EuanvJPp3I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuESM3CevM079_fn5lb-ncKb4SXhDvl27jl0tqH8Npxw&oe=6A92C1BD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmioNb6wQMYQ7kNvwFRn8fc&_nc_oc=Adoww3ecoq0yMTpZL_amPJYDp8QxCgjMf8FTpogRujuYgjFRxTmEPU_a_Z0Zmn3txzs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCfqQJd3en9hfPsAbmxuN4Wa2r6dpEl7QOJee6ihorxg&oe=6A92CC6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
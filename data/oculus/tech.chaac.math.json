kNvwF5j0hB&_nc_oc=AdqlohSddlTlQuqe9Zyte79_WQOPiw-sVJBsYU9iQMfPMhnvmqWDco32F9E2XmGTZIo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtkI33OpgYM6hzs-o_Yl2uzj8fh6Hf6cA0ht08DQNV6Q&oe=6AB67444"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a6Z4qlilK8Q7kNvwHw6ZBT&_nc_oc=Adq5zM4pqush8PNBFPyFqrN9Wd-Pb2YCLv9fzvWgjYE2bkzMfcQ1PRKY4zesxbbvS70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9Oo-Ib5vmOOArl_iKSCx36Aj5ZE_ulegmR8iqdIpSAw&oe=6AB69B52"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZf-bkUrJaEQ7kNvwHsciFa&_nc_oc=AdolCIgDYB8j7Vmc_HpORvxMaBvkSPdOW6mGVfLDM3rBf4csb1M66l0bcfigs_SEEFA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHJSsuFy_y9iJsI4UsLXG5jLBRmEW7fhIBtqSpa05Iew&oe=6AB67176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QauRa6oX0poQ7kNvwH-CyAj&_nc_oc=AdqbqBVRDKBEPFZjUi9FHNqG9XrKU0CxxaA7kdIFP3f7YNS3Q0V7z5h25_I-OEFTWb0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCyb0vdVOZJNcTY1KYAzF8oaVvFjvngChtJDjrGRLBNw&oe=6AB6927D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neDqTdo3AyEQ7kNvwERHgqf&_nc_oc=AdqiIihPESHhEDljxcaOfXgjkg3edf4p3bU2Kemf8Exe4wjWi6gwBB7cqhOT4a0Cehg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4EUiaEuckV8ElQscjFJU_7PWa-DP-6dqB3K10Kzmoxg&oe=6AB69D2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
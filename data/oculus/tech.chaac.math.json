kNvwFOopZI&_nc_oc=AdpaYtTKGJQ51ZtZob86Jz2dnpYl7p8_tD8wg_0U207eFQCc4qDyV5iRHcjjSPj9JQI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OKp8eWdH8FaKP1XwPl9h_nq694s3x4nR5wSIddyEW6Q&oe=6A09BFC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LW-scs3s5sQ7kNvwE9Qs2x&_nc_oc=AdprU6qbJES75wrF6myuAkD0X9V8S117D_YoyZ878msl5Qu9voYHXaxynTARrfuix3M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48M65DH_7vyGJgXsde5ggplzbmArelOZ1mNhRWIGzNeg&oe=6A09AE92"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLKUnL0m2mYQ7kNvwGZ4tS1&_nc_oc=AdpsDitWo3uj54Ij2FDoaACeQ0QGZlcbJKmCgVGekuX5nYV_AkS7dMC6PyUCjqeD6pI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xBkUIeVLzJWumwrgvNLUk--2XqSvOpx3dUOPoFkg2ZA&oe=6A09BCF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjKOjS-PqNgQ7kNvwG6vxSo&_nc_oc=AdqCo2C_4rHBHAwdUc_8ViWgBwvQ7DThvIB26mvc7Mb1yZz0lJ_LU7BRy7fWYD9cves&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af415ktzt0zTogXMN1TmN8We1ZHArHxgAU5MCYnjT9xwaw&oe=6A09DDFD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxOzGLDAWBMQ7kNvwGLZPtW&_nc_oc=Adrt7bX1ys9zLnV-zV8-59-omuhJPgr0r3qec90QCFgbkm3L5Z3YImenUzTULYvy6pk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MsRT7knTDWUjm2ut_Ko1pczl4Xhm9s-d_asBdhhFqTg&oe=6A09B06D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
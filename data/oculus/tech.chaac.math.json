kNvwHo0Ndb&_nc_oc=AdpHk1eI1Uq0z1o_xhlx9gHJzOcCsJkRpiJHmJVtQ_GAeYW4BWp4IkEnSK4tEKMHUWI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYmAOfJKiQn1W3PvWf3rt6OM5fuPtGPd2cvO92h5xBLQ&oe=6A8AF2C4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3McIPNaAx7cQ7kNvwFr8NhZ&_nc_oc=AdrK7fz9yzIlQoABlu3mmCmW0wPAv_BhE_Uy5Hn4ptXkEgTlSPth1ch9Ac88lmAfaSo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA-Idb-2xS_H17ciwyg1uFxkntoXLh4s2sRylIa1rDyQ&oe=6A8AE192"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYmB6hztFX4Q7kNvwH7E63K&_nc_oc=AdqzGQzQ40ozkvPjXGeyCZd3dhV03rlaGzdXUuKvFsa73QjCaxCaQG3J9_LCTz3jyCc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3tgQmLwBNnEctHzKQZDIHGvqBokfHQy58j91bTMDGtg&oe=6A8AEFF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVeG9bzc0OwQ7kNvwFc-bGF&_nc_oc=Ado6q_BJMql9k5eMT7QPV_H23kGgxdNIXterxjA3Vujl51MYqqueK6a1389nqKnEJ1s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgKPm3SuNonqEveofJjKxbsQsHf2Whl0CvaZ-JxUk3YQ&oe=6A8AD8BD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwrkmlaiwRkQ7kNvwH7yoOA&_nc_oc=Adqp-zOl82WcnNhE1g_P2XrssCvyP3DrbTY6823PQhtXveeIcGD0haMEst7oWzxPitM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRmZLlETKlqO7-gWfuey6j7m8qoTTCGWHkWpj0Ytod5w&oe=6A8AE36D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
-S2BMQ7kNvwEnvJsx&_nc_oc=AdqbA68LwUZ8J824pQUa2fBuu8SJJNLTFE8SCUiFe2m_NzfKP7u4qIbGLa18s6gC704&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HW-jeozgUPGl8Qz2ui_DUFXZADkI-0gi_FdxjDyjzvw&oe=6A3935C4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU4X5GS4I1sQ7kNvwFup1gd&_nc_oc=AdpWgdFoqMrHhNm7bh28gZlgx_Y7HyWAOLjWhUlAkk9-XdqmfT7a9HlnXDyarQyz3JU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rLnfL1j5il3BMV93buUCfq-YsQ1L8bs_by7AfVX4IBA&oe=6A395CD2"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7C7m5Qs4O0Q7kNvwGUmcTD&_nc_oc=Adp42sHGjamETGpAAYOt02R03GcxEcZX9Wmk69VtAPDqtnBiBj9iGP5Vitnpcb6q_C4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W-bcYVBqfS7bCkPIYgzTPtnSgddycEC8BLeUTKjylsA&oe=6A3932F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obCXzUuhTvAQ7kNvwFErsuS&_nc_oc=AdqpM2GKHHzLCcVzIA7akIU-auJ1DfviVxfdWeR-iATcePAhhatd5p2tbHS0Z5R-Tk8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-wcduBgnzJOc29H9p-039NXA9scNwYCmmLrjHcKlM_A&oe=6A3953FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGqEl2Trw9AQ7kNvwHng6vG&_nc_oc=Adr3Rk3-wwHUul3XqhtcyvtTdHr_vYNu0GU_47aYiKZsZqg2Ze1N86PcwuwmqloSeNc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B31obsg33HFzA9KdibjUOtUd6Oc23W9qxR_cqZVODiw&oe=6A395EAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
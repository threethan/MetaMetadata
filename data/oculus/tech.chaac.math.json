kNvwG1AtRZ&_nc_oc=AdoiMIshIHJ8-54bt7llvKawnBp8LgJyBfnV6kCOANxzT_m2gOpRhA5po-R84AGrNnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWsYP6lGHWf2AWrabiKrd-xDfh5IMnHQT_02vap7GXGQ&oe=6ABBBA44"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSQyA2tBbZIQ7kNvwGa8F7J&_nc_oc=Adpom2Rr02niZdbeQTr51A_fEAzbfTWZC-0pzIaT4m5yviaaCBOvo21pSFkUHIVlccQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLClXr9glQ4aLpbCLbvTIa7PRKjzhsw8unIPsMuDTkjcA&oe=6ABBE152"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCG6QOWA9jMQ7kNvwEZhEIn&_nc_oc=AdojSZuu0yX9F0Uuo3LUJvcO6iYZTUl5njVdppHdAExQ3kgrZl19y5JfguFKNlZplh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID6lc9PRynVgZQr2L8rpnDeKuHTBPg5CcxxTibWAHVrg&oe=6ABBB776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B89wSnFDa6MQ7kNvwFsBhZs&_nc_oc=AdoF1LRQ0BF0oIdRHpvSMiqqdeLagSR0U0XvE32iOgd57swmE2roGMPIwytZO-EHnx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAtFYcGxZo-fAQBZ-ENzdK4aapdy8H4tx3xbStJYkLVw&oe=6ABBD87D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3v5oDCLBOkQ7kNvwEkFGFC&_nc_oc=AdqIqUIc_Jo8wAt381377G2TWAjU_-r4SVKOjH8QqzVFXyveD-sgR7dR1xieL4Mg278&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEFrO5wNX_VfcHtFad2H6_VHvPdKKPPSwmJqeIO4wBcw&oe=6ABBE32D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
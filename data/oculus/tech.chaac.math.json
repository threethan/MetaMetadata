hrT4QIsju3-T5RhbkHjgz4a26UjkRSlm3g2UAN2vDz45ULOKah8Qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvlXSqnX7L7FidoQI19t-mmlYfrT8H1Ghv6kcgY_zD6qA&oe=69A98244"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL9PG_NzdUcQ7kNvwEexhg2&_nc_oc=AdmLsK1jZuuG3nonzLq_h5vxro_yS2iExOQ_ypgTwF88efvusuJtwfadNUxq6g0996U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftggTze5Flb3sUddjEeaGTkzsZu2pk8mAxpMoeVQwBGag&oe=69A97112"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFVa3B_wqYwQ7kNvwGF757r&_nc_oc=Adk92xd8yZnu7I36ru72TYXwzS6gOf4-ekTfkCRWtm74PwKjlaepsYysIBNQP3MbM0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu4zoXJpuyTIJsDJSJkWNu2VgaW6sC3doyzrB8uUDNW_Q&oe=69A97F76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyRwaB6CTYgQ7kNvwH9q_09&_nc_oc=AdmCvFa3-9LZX20kypNnYHk17DpXuPWJwMu8zWtw7Czk7l23pb33Jj6NtD6nYRl_y6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftYJlfInJM-aBhPRRSERsfFYaSVw1BGBgvpMmO_v1_Xqg&oe=69A9683D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rFjamMgBZkQ7kNvwG8PLmL&_nc_oc=Adk0XaUPMlFxiKntJAyz3NU5if_Mq5o3h1EVkQphMqU_5LvZwUXWfeDNv1f0ITDukc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvyW4a7sZ6aHb-_ygf8y2jpnRv-4KH4dhTu2OXvgbO9WA&oe=69A972ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MATH-A-MOLE", "platform": "ANDROID_6DOF", "conte
kNvwGU4PZU&_nc_oc=AdqSRW6Kc3U8lGLjtdbdvdj-XM-DTFvX7hRiwSwancPfpDoHAgEdcK8c2SnE_zLAy3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA13--2km1Ghs0Rhfo9Jpm70xF7f8On4zHVueCcSkwRkw&oe=6A5CCE44"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_4DkcY9pB4Q7kNvwGSxHoO&_nc_oc=AdqlN_iT7CDhiqJdzPPNooXoCHzqqO9jKbHHKD5wmw8zpj9dIeWtYFLdMmra1IaNthI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVjvEx4dH-66Og8OyxK-V2OyuczvScAwRmA73RO4ANqg&oe=6A5CBD12"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7SsORdSrWIQ7kNvwFv1lD-&_nc_oc=AdpvpZrj2dhlXXYndTG0B5nILoynR24XdQfMDvIpM9jTWVRdners047RwumYseOkALo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6GKLkoVHAwSuhpnw1WHhL9NIB_yIeg-UMnNNJoRV7YQ&oe=6A5CCB76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzM7oR0RkM4Q7kNvwHNF0I1&_nc_oc=AdpfvSX66Myq9WXXfkD2IEVXV1ywd_mYO2mYjuRFGFgSCw4xo8qETdFQmfixP6Jr1QY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3fE0PmTlAVf18y0EYLja-RSAjjIKakVqsWWIy4OWlbw&oe=6A5CB43D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-Yth_kS2yMQ7kNvwGZZJ33&_nc_oc=AdoGvB_0IVsYIPemojYu8ylie42IYshH1Bp9oXb25BI8A4u-k6JzUmPHPhbF9no2Sd4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBb7h_1L5WS5u8ahtJFSHGEMEFDGmpL6Io-OawKPFODA&oe=6A5CBEED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
kNvwH3Nn3L&_nc_oc=AdpqPteoIm56FHsrOMWgq-2WfvpfIREl4MjH6l_vpzbZNtR-Cv_D9x0pa2cOcE2lbOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBDckxoDjj5R3G1TNKyogPNVnu1AAfqHiDMXjlZtpcNw&oe=6AB522C4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_MTaX3fgdAQ7kNvwEO04Tt&_nc_oc=AdpGlETQfIFoNs_azWQ3Sde-Omy2nTuC0X9CqIDLegk7YX9U9voZ0dtKUMUOVQ_e1Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFqJFr1SifqV3TEJT6SzOPXoZNX1Bp8tISu3hv6raKZA&oe=6AB549D2"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZf-bkUrJaEQ7kNvwHwXJyT&_nc_oc=AdpDHN68tjpaROnNrI7zjoiniXQAxORhJxpILOBC3n7MRHn1-4DjPD5l88IR7acLx7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfo91X-LiD3E9THa645KyDvChiHwx9JmOovOTaDkrJPg&oe=6AB51FF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QauRa6oX0poQ7kNvwGnH_A7&_nc_oc=Adr2umUf5JifMr6tCceu4EFDmSEpHsnxkiaDLmpmRMfGv8GOtqwe9x86J1YtGryVeKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKbRgacOlReipC4V6Kt9_71yGpRM4-tsLZpULvpHUrQw&oe=6AB540FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neDqTdo3AyEQ7kNvwGO0Ewv&_nc_oc=AdpqIIYPny6Qx-1-aLi8tISs25IA-oP7pj1ghGCa01_2PWNCCwyMtqoAJR1J1Edl05U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKcuBgyqcfAUgvUSSz53Zaadom6jTlsJQaJ9Z8uNd4Xw&oe=6AB54BAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
ontent-iad3-1.oculuscdn.com&oh=00_AftiAr13vEFpE6lC4T7ir3L3x6DxKqTTUG2DvjuH5W16_w&oe=69A2EAC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX_3T9Pj0L4Q7kNvwFR3lk6&_nc_oc=AdkLjqraJ9ZIoHQMWJBukNXPd_8KFLXO-SFVpNH6wNsHeKjT48Wgp99zsjqj4_8bNRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR0u3Xm5afVF3j_sIXwnnaLBBWsS4_3fuKYgCUepKdtA&oe=69A2D992"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pGW5443yyUQ7kNvwGEWJ3U&_nc_oc=Adn79QKpyJr6LQIDY78GJB9KgG2Zmy6eWGf5tP9jZjppIAXijlnuowm-zoS-hr6i15M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8be-bPglScJAd2QdGwh-h6bXmuQHRGu-LnJ6RxQOxyw&oe=69A2E7F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rym0Ccc6aVcQ7kNvwEn5qvc&_nc_oc=AdmZRyrJi0dnOq4cSEzlx8elj76dhJNFpU15a03q4csLAhsIEI9LPrLcEGUyrXyko9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvUW4I6Llp6-bV007Nw9pAMQ4KfLNj2O-N0ix62a3VaOg&oe=69A2D0BD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py52FdeRNroQ7kNvwGWIbCo&_nc_oc=Adm8ac02_FkSguckQ9Is1IJYGb5Ngb5HuQW2b-A9cwyKkeW59qUBtAfWOLcO0fcQCsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuwz5uFold09ynRMYQ0LpTALGp69b2ReBeKUKheY6DWAw&oe=69A2DB6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MATH-A-MOLE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", 
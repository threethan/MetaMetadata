-S2BMQ7kNvwFTT65c&_nc_oc=AdogQEfHuq1heMfbsWHEt_ovogsKwvEh9gKsSRboXf46_nThMIcLtUFKrVIWHfiQLWE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MxL8Jp9ytprDYgWuGsXx56lR-IjHsgFCDgYG-4ITmyw&oe=6A3692C4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smAGG-uZvxMQ7kNvwG_f8Vb&_nc_oc=AdoN2p8bBu2Fn85HbY6qMzqSOY4WtuNTlgcIzsUqmhlQtL9tkS5B8kkI5qC3xuzH0Ks&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aHsU89EHD2R2nxBOethcu2Fu3a0UmLcg9SkZb6b7BjA&oe=6A36B9D2"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7C7m5Qs4O0Q7kNvwEBPujp&_nc_oc=AdqYz8JljuegkZV9CXTYwuUiTBOMcN84XChzStnlB69mL9fSQ8YV8bjxgMUEx7yPqRs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YB5OlmXIoBMPi_OrW-w1G0BqD14dcaJgw2uF57OPTYA&oe=6A368FF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWmISgERV98Q7kNvwEcnnHt&_nc_oc=Adp-mIYWK-HeGk7bK7ZoeV8qkNvm5KEP7LKocIxFq7WlsZYVbuPVzmjh3xI3seCwuyA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95mEWHQRd4M_ttNUtqrN02Ojy5qPwgQMwDqwyam8UKIg&oe=6A36B0FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEXwWSn1XW0Q7kNvwHhdMvz&_nc_oc=AdoAHIVc1oIjAHUCc6DVXWMMIl_lzhAUsZsKJsJi-yx85ZzlB0lnTlGoG10iLYfq9nw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eUgH8YpBEMJVKBZIkdxElCSmFvb53mC_jjf3Dt2Vqew&oe=6A36BBAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
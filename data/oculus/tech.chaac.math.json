6RmSS5nIHB9KAy-gvKoEbbdRS1cTDaLmnhqWTt6arwndSnm-WaHlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCKapYLsZY38bELfg365TXDieL9Re49z2XOlnfuXYHRg&oe=69B6B144"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-PSYHWeW8wQ7kNvwEjE_sp&_nc_oc=AdmBiLLRe1yQ6AG3ciCGlw8zHZSwdnMb12QpcZRWSl1aBt2M-AyaOAIJCgunByeLDpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhVJAYRi4w-D3tWkQuRlbeEqSJLQJ5VxmvoYTmkJuFYQ&oe=69B6A012"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sBPt5QLcd4Q7kNvwF4hxLv&_nc_oc=AdkDWTuHSjK-Zh5mQYuPb1VvN24ub92GO72AOSCm9HhVPiqpjr3AII7Hm2qwXYBT10o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOWOlbJ6vQthKRFOqH1myl_bIBu6r7DmHH6zQTDOtEUA&oe=69B6AE76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0T3FGDmmaQQ7kNvwGNGlMV&_nc_oc=AdkRbxEaBZQB562Emr3KB7-CPXJM2UBfoy8EZYTpButRRWFh3RvBRgynLAeWg4vSwbc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOjs7cHSi9paDRqnNQdMl6cKwUFrB50Asa4BgOysbD9w&oe=69B6973D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4r25W-j889AQ7kNvwHQSFkj&_nc_oc=AdnPYqAdJ8EdgZ1FJBNgbEuWCzi1jzMeSpNeJIaYR8bChqQmLt6jqoJ2gLP2FGlPT7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0c0Ybf3curL7SFqbVU6m7P2I35yEUPcX9uNB4BpLAdg&oe=69B6A1ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MATH-A-MOLE", "platform": "ANDROID_6DOF", "conte
kNvwHToIL4&_nc_oc=AdofJ0yIQGY4Hzv6grnzXJRu_lD5slJmkLq8E-Aq7T5IK_XG6LdA7i8lwlbkcsQgwYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjNUEZ7l0Nn4JPZhHOpLv5r6bt_Gh_oSoy9-jsG0teGQ&oe=6AF4A304"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPYKDe9bBjIQ7kNvwGtz08c&_nc_oc=Adp6b88XdiI5oBwaE-L-ZhnCpcOjFpC_psfE8Dx0-yN1BDo4dreH2YbLDr5WjMg3_vY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtJtzSwjV4iMDFq57T36dMRsjH_5dngY-ZEvp11zJj3Q&oe=6AF491D2"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I51H04Q2DWwQ7kNvwHbRZxI&_nc_oc=AdqALrab0J--5oheBJYO-lpgC3oyt65yak-VSdWIVJb3QJlBQlpv_3Tin-cuAh1tuPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV2GxsBWWNxj4yg3BXX_ALBp3gPDdoEqu08q9cgCfz_g&oe=6AF4A036"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIOYiE3zXqgQ7kNvwH8WyKx&_nc_oc=Adq0kYnfgPbXlomVkY4SOgN6DQCZCD_MYVlpehU-Dn3LLXgzRgP2Nlp9iHnzR9YOl0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt26DYEb7kQvxud_OCDITrjwadPHd_WIyGl_0BCLKenQ&oe=6AF488FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmwlMvoMsIUQ7kNvwGradBb&_nc_oc=Adows8OIW8BDiyWjo5wNhVmdIuyDdRZUK0nmeBWLwuyNNQSJLGk6RStqEs7ecxCGuwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4-8zDFJRLGPzeVICAJEZns56OOL1AvcR5g0RqO9oXKg&oe=6AF493AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
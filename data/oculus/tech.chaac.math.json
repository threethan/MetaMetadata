kNvwGyPoIm&_nc_oc=AdprEytQDZcat5uksLzdId6MpdEpnpNt6B7CkMsHqy0eHuwYY_bsRPXBZGs2S6tuJ0Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zbs1sxMuPorsxQov8LgIdiaU9wrST88dmBaiL8fQ0EA&oe=69D8F844"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqn0sS69tBAQ7kNvwHMMbtc&_nc_oc=AdoaHg-xZyGNxRpdiRSvMXCtFX_8050G_GRjUsJgbPaYqTU36VTysAFhYNCcTFEqhNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BpdncfLf-vRT3u0UElQP0TJRuxYfnT56x-v6-xx5MZA&oe=69D8E712"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Q6ZfSOARgQ7kNvwG0TFn8&_nc_oc=Adr_1147mnPIn5rAU05k5LtKXJklynR0t6QJcrjxHlGM0q0xF_u4ViicbZDZMcYAh2s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gfO-6ols8fFfsm7691kKWPwrmBcEfesHhSFYSBb0RAQ&oe=69D8F576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqEpIXlVwMsQ7kNvwFZ1VUq&_nc_oc=AdpywqSd1TBOR8FA2Hz7JUdQuCoIIOPTn0lCEtPYUt9SoHuO-TTlt1R9XjVwLqrK-VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AnCKsMncfEntxIXZ1EF6BNNlAfgz22I9fO0GpBs8blg&oe=69D8DE3D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMCAHMsBE9YQ7kNvwG007qo&_nc_oc=AdoI8VUejtjuyF_scuXPTfsCbstk3dERwdFFP-PmlO7vgYhHTYRRN5rJ3cnzM-DdbcU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NGdzQzI1YoMorvT2e3BHupS6mgADywu4XzGazYr6f7Q&oe=69D8E8ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
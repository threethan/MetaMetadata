kNvwHZPyyx&_nc_oc=Adq2Bu2J2oOGZjnrHrqOJh58A5Pw78UZMz6JUnDybQXu_AjwARZ4xEtl_qpF0iXfiZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ7tHpN4aO0b5Hp0PMQBYm1gS1e_FxgYMXWu89PAaBJA&oe=6AA2ADC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb8N5OQwv0cQ7kNvwHUCVoa&_nc_oc=AdoXqB1-VKfMEtAqEiBoEgOnFemmyeb5zBsiBL5s4X0rzrBUrqIlU43Xyckw9O2Mu44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlZjIwmGq34k-izad8CrlxaZ9rD7PvMux-0FX69bZmZg&oe=6AA29C92"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vwFdAJqIPoQ7kNvwGCIpBp&_nc_oc=Adq785-wC-_tqNGc2coM4JaZmpp69faqZLHKAQZXvLIwKg0nzh8g4_VaTBKBVRR0lmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD9i5hgeyh4QzaVSwJVLWc-E7inL1_IUDewTXX-xQoJg&oe=6AA2AAF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06KS3AXny7UQ7kNvwHVq51z&_nc_oc=AdpIR1ibW3rFtxPkVylxspKAXapHTSZAPD05GLtJPXPWw1kWcaGROMDPSr9nj4223vg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcsouRq1Jz93eodJkG-VzBoFA4S_8iKeeqhwR1oEQC-w&oe=6AA2CBFD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdcAzBPxx0kQ7kNvwFBxSMx&_nc_oc=AdrQlWL0Q8GwzLRAyx6FY7cINMf8PS0PIvfgaV-HHm89BRRUTLF3OpHYRk2rzRrZ3GQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp3ZotvHkAp5_TWOW3oBpOtKF3tOC8EU0cwfO8hreEfg&oe=6AA29E6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
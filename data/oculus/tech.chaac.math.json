kNvwEtXvdf&_nc_oc=AdrBgmQDxRH48kYbcg-MDAiwjhuK6mdq2lSZ5LkdN-6ByGkMZqMo4uyEbHwL062RW7E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq4BrZfez5zuo_ZnQp7QfcuzdoyKSkFLpzzoVmuuuTjg&oe=6A68ABC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evt9wyDggkcQ7kNvwH9shb1&_nc_oc=AdqlccCtAZ6rIhh6Y7B04C83BjkKPotZUNRNIUPNrF6nKvyDvclGTa58Js7xNvrebBg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnJiQlkvhEBBL4vl6QbT09uY64q3JPGFeKkgNAvCaxWw&oe=6A689A92"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii0xAHq65aEQ7kNvwHU3jIL&_nc_oc=Adp9Kla-txHwgKZxNmQbZDl4R5RW_kQJ_FsKMGP5G1KdyCWBnp41TydYlaHMXYBCda4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbKBgkdi90bRLG2l2_gVOKWFORoypRLZ1txaACxLXpYQ&oe=6A68A8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEMBQ3K6O8EQ7kNvwEjS21J&_nc_oc=AdoWqR2WOP8gAkvNfJyl_FZInJ1vELpe5nQngqCPQbQhhXxh8me3mGm2Rj2woz4hDo0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMeC6L6MmENiTO4IkLL6KVk5wt2YPsO3Lku-YTOvdN9g&oe=6A6891BD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB4gnSBLjL4Q7kNvwF01D77&_nc_oc=AdpgplZEZ50lgSdK2Lqdxz1IEzwhzsrBQJFwuYh4AVMdwy5v8K5csORi9w4EnMC0omI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgaMed5ohUPK28gQqaRZjKVBvySho18RV6EhD5mjcO-w&oe=6A689C6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
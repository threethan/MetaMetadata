kNvwH99-7n&_nc_oc=AdqavDWCIYYqJIlcdzqxVKfBqs_MVG22GXeo3Cqk1bpypg4nD59OV06hAdxeWumi6Fc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jFiroiTCGTbpAXFMHxxHK3ruOGWvjunlvusDPmZEdjw&oe=6A47B644"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-58g4l1Or0Q7kNvwEO2CKA&_nc_oc=AdoZdgdDeUYehGB2d9BDE9SyP0jNeo0e7yuo_39zkStcQ9RtzPfMh5AWN26KxAHfyNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1iFzrFnxosYmeRYejQqvhIKNE5vBnV-xOdOsquTaFsA&oe=6A47DD52"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2P-IN1SMfkQ7kNvwHmnGko&_nc_oc=AdpyBp9rs0hstY36xDDywRqv0_C3Pqx48YN70NUyLG5GK0Lb2SDHRD7uaxWxyS_5p-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kVpEFLw7LuhI15LeEC6gt5nnGyWcG98WI7CFDiTVnbA&oe=6A47B376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGRyaj3pjWsQ7kNvwEsdOUV&_nc_oc=AdofswBPr5mR58oxgGWdE9YnnhFKvdwsO3wfs4ZxSvAwsB7WNxelxZQ_v_epzfE2D6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eF99tub3jqToDw3m3AD7-KhdTo-h3h-cj6IpegajfUw&oe=6A47D47D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7kWQGOv4o4Q7kNvwEkh6jZ&_nc_oc=Adr74Ew7HsCeLNvjLI-BufkUsf-Qd1RMjRPPFnjYByJVcVofcxFznEkd36ETg6wqDR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_bG-rCFm4WMbkVAp35VucUEAPd-ciy9DLS7TxuHJZBQ&oe=6A47DF2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
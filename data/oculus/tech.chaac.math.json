kNvwFevRpT&_nc_oc=Adpq1Y4ioEu6NGlhxmeK_pgMD47h2S7tFK6gspsupiT3VXGYjf0fiqHfiGMtEHxV-9c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UpvNnHY3EjHLf1O6IueP7qcoyKRNJHkdLR9gm8gIiwQ&oe=69F5F944"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPzjMDjHxYwQ7kNvwGbGRWb&_nc_oc=Adruhb08kL60einDuL4bCirrLbDtUJZPc-6uLLFVoj-_tafKx8U5W8frC4wUK93gsQg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3AFd33A9zZ2WvJjcB1ypCtbU0emst93IadK6OFbKm2GA&oe=69F5E812"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJpH-2WRK9gQ7kNvwH5rwAw&_nc_oc=Adq5hWF5X6-pIOzmLS03Ije5l7HB_xr_qSBBwShOarOTUQswU8iebJsNrkFzzx8Jtno&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pRnpapiOMU0Jgi1YLiqPCmHbkVBSt31IAia8d_W-IUg&oe=69F5F676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34UKiHzyJaYQ7kNvwFhELKr&_nc_oc=AdrZForxYYrDUbqtfGC4ENr5jNxN2tRg4AuuFpyqd25uV9Kvd82i8Sfam5b9mxjZ620&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xp0lXIVxJKRI24XbOBx4QGgip-0Vr3TY--5r-NZesjQ&oe=69F6177D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCL_Ffv56_AQ7kNvwHSBlfj&_nc_oc=Adq1n94CijymjdgPTyrqgP3OnIqSI5kh7rTdUuo95arUBYIK3q4myR5_oTNJmlp7Wvo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rGFNH1oAxCvFexWNJ0SHpmqEN7-deOVY3YH9ezDmx4w&oe=69F5E9ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
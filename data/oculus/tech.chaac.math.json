kNvwG8obps&_nc_oc=AdoIkNI2R0FNTcwhMKk8atp4ZmiOb13-MzvpwZXirCyyEw9lr2_sxv4naI0WW8KKqv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8GS_PoxbNrAWOctkJQ0jEl090F2XjsYqf_E3VXo8e2Q&oe=6AF35184"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPYKDe9bBjIQ7kNvwExlyeQ&_nc_oc=AdpDxJEMoG6Z8_xFCO1rjKbEZLHiXZ36yMrSMk67t_nktl3WMnrry36X2R8Ax7BhLsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm55oa8GFTQF1mKU9C1JZ_wOVUS4glNGDca6v40jdu8A&oe=6AF34052"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1OivVnWPWEQ7kNvwGRSJ6E&_nc_oc=AdqMyEY0Q5Ywpqg2Hb1oDt8jNYLMXIksEBgGqRviilQsuHJ9xkSVMF8jTIXKKtDBo_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT98nyb9n1n1tcIjL4psNGPP8iTAgHNgnsTgdY_rbGHVw&oe=6AF34EB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIOYiE3zXqgQ7kNvwEHimWt&_nc_oc=AdpZQSKgaVYsRwFN775gOtf5INS56AOSg1dmjqyIYI4MC7s-GqojL5g9aUoxdLdLB9E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Zi8otqEzuQd2VAtjcnLmKxNwrNI9lFYUOsxyBK8RTg&oe=6AF3377D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmwlMvoMsIUQ7kNvwFCqUHP&_nc_oc=AdqXdeU7QVYuAa8a2Cx-U8B-JsYQb-KN2SFlQAJEoB2P5GUmDDiqQVmREY5OYrPT26o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmc55RvD-pQ3tHFCaH9zBdx78CeTDu4DN0BhdxMWvUHA&oe=6AF3422D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
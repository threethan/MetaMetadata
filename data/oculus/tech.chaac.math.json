kNvwG0xzYB&_nc_oc=AdpXCCDPiDY0Tydh2tXJPfy3BjST-AjMZa6uSQGVM0pwo2Whem3lEneFRTGHN9-vAc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv92QbabCI3J92RZDxdtf_ZgrVgcBe9Z1mR0RuBbTrdw&oe=6A524244"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_0wbdX9WTkQ7kNvwFQMIjL&_nc_oc=AdpKbyEmlz3EWm00Qwa-XdaDafOflojyCX7_bnh_0qG8Ascl1KyzGcXkIEWsv1T90UI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDl4hFvg9M0b1yPGZ7P-oyhSvH3KPaEI7BNOq-vVC7og&oe=6A523112"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftq6BGD1kxEQ7kNvwEUQSw5&_nc_oc=Adp7xeYKlggME1DUTEkN1LtbhcuFDeHnWc0jR2aU5fP-RPxMITV4fE3BUeXMIrfPQDc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEAzTPXP2bMZ0X6o8lRJA08LzuXQ0SWg4IGpkUyT2FDw&oe=6A523F76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruIBtUj80YEQ7kNvwF6uuAv&_nc_oc=Adq3TRStvj5Fr1lA8edO4klI3713KGVwJtACyEj--wK84brFmtbJrCKopNJeiIuVaHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC5Glc8ryBT9IKbHB9RogBh_7wk4juEGQQYE-iM4QaVA&oe=6A52607D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8TWLMKoYCwQ7kNvwEFh0f5&_nc_oc=AdphjKWtO27Y7XFGxDwCK6do6B2ku0esdyn7Lf_-66uw__Tqr5WfHOi-_qQxROqMW98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-U5fuYfZPYnilqsBFgOdkd4Ap5BU2Mh8xdMvn8Pmx-A&oe=6A5232ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
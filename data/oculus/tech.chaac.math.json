kNvwG6-ZxR&_nc_oc=Adrp53s5kel4EMSUhNnffDpzdIGeGyEZoxBkVssCCXvh__wwAS2oMiaM_gRlidG8d8U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFirEwp5OWKdVJG5IrplYNs23QP_AcR_OKSNzZMSaOR7Q&oe=6A942D44"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyOFhm_SmvIQ7kNvwEe2ATX&_nc_oc=AdpIel1COBzWcS7e2otWPP9QSd0hBxKA77Th_-LzyRRX7-ACZS-Bc88LHMBJLQ2PdKM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZb8yjaioKQcjpyV1sGrlR9pgLF-zKnW9z0-VDGzC0sA&oe=6A941C12"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szaPKe-9n80Q7kNvwHaF76h&_nc_oc=AdpxukfR7JTm0elx8VwcL18zTNOZI7x4YkqsN5gttJ0TVAZsLXHwld1A31_PBarNbkc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeE8eL5-8CVc4yxNxWO1r9Np7TfsfGOnIgB0I2qONkEA&oe=6A942A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_bTI5xUr-YQ7kNvwGwgaPz&_nc_oc=AdoDkPxDQ4TkQ3dr6iEV6e82pynBPhZiGcl0u52zjGTYekzmLdoP_w5itkCIJ9DGbYk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt7s9nMD241xp4yFJFP4vhQMLd_GruLyC5eBO3FrSE_w&oe=6A94133D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3d6BxlB_9EQ7kNvwHafXrY&_nc_oc=AdqAb2VJHkybZYNvIAX6HWxixo9GiFqJarvcyx9Do38b1-5d33CDQ8S6Y_QaOQcAxQ8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9DcgvyNVah5IwkjqT-PXNpcrqgQhGfF90d-DH2b3YTA&oe=6A941DED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
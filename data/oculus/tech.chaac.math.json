kNvwHFbbtl&_nc_oc=Adple1BmTwZJD6-DAAmaJWJpM9ee9adLFv6ul1IPNYYsVVEstdCUd1zCEQANLcJ5KAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDibDx6xeYQS6AIb19nwSJnT64bpwX7JpP5QHtii8jTA&oe=6ACA7304"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98eM7Im6M_oQ7kNvwEFQ4gt&_nc_oc=AdrRvf2EL68rkZkbb8ULTHaAYSKByTX4Fu-WUCBOqQx4lsRMTOegyP7bh1MBHAXsk0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw2uRm3yl4oFB8lipYAnyXCgwcOOjeQmItmiEBLRF0ZA&oe=6ACA61D2"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocAo4yz-_VMQ7kNvwGArJsu&_nc_oc=AdpiF_e0AofVJNaugh-9HhZwz-qPO_yMFoJyYYW8Mj6p-7LWSPq2zj_lmsTg_-YZ5EU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4nIdlPm1-lYWQz8rLjSDOm-TQocGDIjpm8Iu-Bk-L-w&oe=6ACA7036"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiMGvDZvKFMQ7kNvwEQ5lxJ&_nc_oc=AdpxrQ59_OAXpZuvFFODDCggiy9q2Xa8TmXjE-Fgv9G6sFDmkOtCB-H3Ukalbz2VW9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKRcwOa1fqTRZgXib-e43c23c5oorWkaTttzoJWRRKww&oe=6ACA58FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQWxYG2xmy0Q7kNvwEdr3Pr&_nc_oc=AdqycC3M4tw_jOGjbXhddKK4_-XEZUT72VM6U0rGLIyGjNj4UWdlMp3iK-VpAqemIc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7p8IQ6fplDSAYW2-lo7tGC-Iu6XbIIUliOda88zmQfw&oe=6ACA63AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
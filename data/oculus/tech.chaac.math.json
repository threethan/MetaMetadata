kNvwEHJrb4&_nc_oc=Adq4oZqRuhU9_xgSUnuZR-rUofy2bV3DF858KV12iQcPH1mSLB8GfqB0dn2Kj_82YPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6CEGXWMe2Wm8tDoUPUyuhWmO0UHWiNU3RmrdWJTfMpw&oe=6AB7C5C4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a6Z4qlilK8Q7kNvwHlOq3A&_nc_oc=AdqlY4s_4ENCBGjHFfWuZz95YkaK-7nuKOur4stgRouUuHt3vFuSfy76np9bGRtZyfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG9W6Ng0UBcRAf3sfPD7t0ODN9OEz1JIpGP8qZT3xbyA&oe=6AB7ECD2"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZf-bkUrJaEQ7kNvwGqb_i0&_nc_oc=AdpjizFsQR9w0HmDB3MgPxxzEcIqLXTpe5REx2XMmoZ5jtEqMWMi7WwNxJCGVuL4hyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzT_NrFEQg7p5yKaqfaIP2v08fL8ty8HFElzySY9tfAQ&oe=6AB7C2F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzPmQ3MQEzQQ7kNvwHli28R&_nc_oc=Adq6n5JBYbALYYJmznwdZcou6X41e3rQeJIdZqri0aqKmcfMoA31FTHWtsMOLcyNXYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdys0R55ypV31NTKFPgWljhfgT7SBnZVm42aohizwB5w&oe=6AB7E3FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBwgAn20L1sQ7kNvwE91WxU&_nc_oc=AdoFx2XZlh2m8_rO6Ec3PVeGXequlG8wwdXfHuleLtBKz_hZOOEcTc0pryWdeI9weO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ6Ltd9UnBMtsHKNui7ddZicCNrCsD2LgxVyzL4ec94A&oe=6AB7EEAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
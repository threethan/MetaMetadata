kNvwE6W_fy&_nc_oc=AdpGePLNg42JJjNCVPs_vvg6rOlQgLpgT75moWhbEBOxxzv7B8VIoWX3-CaM1ZuJ8d0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3jE1sYUd0E3BWDUpdZfgKi-fY6WFiZXaNTK2U8Ch7vA&oe=6A58D9C4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rJbgJ4d2bsQ7kNvwEjpnKv&_nc_oc=AdrXM2xGQnky1ji_AHO42QSGOmzm1U7QSInsH5rgzETBwdxYzfLyrlo3z3-jFn2FC7c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASp7N1g1RdmGONrEIS3rfPMITbdP3vIXkGdlTtg70slg&oe=6A58C892"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7PJkWA5P3UQ7kNvwG-97m-&_nc_oc=Adr_xfAV5yRmeONj5ilg2AsSaSIExHKnY5Aq6jN-lThVV5Jin4F1p41tGfu1HCExiVE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAinAzZ1LdsueczLii5su0eAT8sI3lFJOQMTMNWabkHdA&oe=6A58D6F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCh8EAIBjocQ7kNvwFhgEFQ&_nc_oc=AdpE3U1PYbs1J6Mgi_4YRbEUgd0xX9LwowrqykBTgCh_Y4ygA9T7Rjo0agWbh0YUkI4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjfIVEQNt7iN1Ndnt5kQXbBbDGOIlb9Nx5ji12EvtqSg&oe=6A58F7FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlNtgBWu3OoQ7kNvwHegOcy&_nc_oc=Adov71r8K5gYPeNmw-I0PRruAiDq19812jb2ttPFsWObQxp_fmVo_Zq-a6kSsoun_IU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf2dddqJ_2GV6AwPFVa634WvL-miO-YWWW27XrWmkSRQ&oe=6A58CA6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
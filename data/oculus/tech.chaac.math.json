kNvwFm9nwE&_nc_oc=AdrnPLe09RLh5r_waiFw3R8GsQdaQY6UJj8fX2Btapq5xZExJgwP4OV_lhLungjAv18&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaEAEerioYwiPaRvJo3LqAB9CUtyNs7uj7HO8rtb2X8A&oe=69CBC944"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKvl1lw0aWwQ7kNvwEkxJaj&_nc_oc=Adp-KpMd-PiGVmwkXubd4W1WiIjD6c26g6YGUr2pfRo231okfb_CxEVdguwzm4bxkT4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxT6u3UgRuhiYLTFJSu-dINR0rqVE2N98g1-dBmXWUx2Q&oe=69CBB812"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D9fXLxs0RwQ7kNvwEZn2EH&_nc_oc=Adow0go64Rv_cP-37VQGSngPc0F8BIQVEWMXiuTwfNapEjFhKxtrW-a_l_XoP4uBMuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3yLZSxROROgcVWw3iUsiq9e-hmlebQcM0RFbf4HX6SA&oe=69CBC676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvBLOmPds3EQ7kNvwG8JZo5&_nc_oc=AdrRAmF2sjP_2VrRJ0LvnMRVfCjTqDdWL-0zCp_eFmNmDnwwmtbFQcTdy-VHqxStN1w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwc2mmaT1duvI3cO7Os0ifGY9XIeuv3RacGlH8sDOdvTw&oe=69CBAF3D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ld_4DUQVwUQ7kNvwHjloxw&_nc_oc=Adrt4bizO3VMFhdKU-6D4Yn__faHGirDrxwG-MvJVa9John9Cq3COewTn_YJD6pFECc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpKkj-4rtqsVTJoJN8v2mCT-7n-Sud1xr6mHWB4ZUEzg&oe=69CBB9ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
kNvwFP-UL1&_nc_oc=AdoKNufhcJUDjJ-qIQskxAXMa7qpRo8Nc17SNJGUagHDeR3226siLhjqfWCGsuhCk7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl6sCfgGGkuVDZofjb0iFP_QeryMoCn5KFT30DrCfabw&oe=6ACE6784"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgd2V7sqorQQ7kNvwE8LhNL&_nc_oc=AdrUfUew6QIy5eXc6yY_HVZJtNmtmGrPuv-d8UfdYVehcmsusESwJfZ7T0cCb-7gezo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvRHP1qz33PVWR-ZsFFJ43q3rrxAmj10DsufklddaEdQ&oe=6ACE5652"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWrqApgFowQ7kNvwEGvgo7&_nc_oc=AdriTzf-5kitPDgzGO_tXYFIqWOan_SE30mxuAb0XtBFYNS968NuriVVD-kloH5cJ_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbXLcCkpPw4kXTluKpmO_gA25ogU3jpHsDveqMo4lgRA&oe=6ACE64B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-86K3m97RBQQ7kNvwFeDDk3&_nc_oc=AdrHisJEGDqf5YABlRaGdbrlsSp7OUD2N4hViU0KeoDiEfOTSQWPgOF872QbpHaUUz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl3vm3zoY2dqIVIG6SHOtsriYoOKKwi-1rVDEFHEl8OQ&oe=6ACE4D7D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO7oKuABNNgQ7kNvwHBaTdN&_nc_oc=AdqGg4Fv4GOWT-drvGHx4Kh3xhzkrKkUl8N9WVct61fR_StYRGaPVfOGWWySTJZjsW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8lG05xqhfccHqsTCguz-gNhpGgiTteEFwjyUqL81ULw&oe=6ACE582D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
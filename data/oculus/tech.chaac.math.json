wQVYo0kAE0IecgxooAYhtzCzViPUPlTLKpmtdczzkjwhzzsd-2D9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz32pSg8VCAoaqZgpAdRxv5-Zhxr_HGOyXQJNSTLCYTFA&oe=69B55FC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-PSYHWeW8wQ7kNvwFhMtew&_nc_oc=AdlYjtTwVDmPOjBvuGcALheQ-uZ6_nFmi14R6a3FhM0d_Ez3_CNcEZLR9CZ2_uLmP4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuT9thlcp1nylMkz9-MoM6e82CQ5AONIk9BQue0i7t8A&oe=69B54E92"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sBPt5QLcd4Q7kNvwHVU2GI&_nc_oc=Admm28_YIO-MEjNDSKzzsgP-4v0Re_RB5-cMCjcnJSvZxP9E_ywwSLL0Kldfl72D1Yk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-bh2ilpzWNql0ANLWfgn6iUSLRkFy_1ldC9_ielTFzw&oe=69B55CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCoIze3nB2IQ7kNvwELt6Lk&_nc_oc=AdmhN33xuoJHttyE7CH7YMOMipQ5cCAIbZoDaQ5OqCgY1UHHgz6AHx7daJGgfnhTfJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5-Z4463oofuk2l9nsRiX4AVQklGsUiWQp0bjkz5XyHA&oe=69B545BD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beqLYUA9p88Q7kNvwGSnxRq&_nc_oc=AdmklCM06LwQ-YiqrT8q2PO2iUfa3vASvGilRDRDtqvz9_cH_dP-Z7fVBk6nkHlvlTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0siXTZq2ekF4-rBxEaGMJEUAT4US30NMqBYZo6Fedqw&oe=69B5506D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MATH-A-MOLE", "platform": "ANDROID_6DOF", "conte
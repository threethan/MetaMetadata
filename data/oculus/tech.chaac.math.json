kNvwHArlVg&_nc_oc=Ado6KRpe_k0eLJyuiHN4-QUwDfmJdIBCfOXQBul8JHmfYaJ8GKnrz4XeD9wr3pVyWCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH74kpHbKu4EREqNkkDlFByDzQJHEloyb3InUJypK_s1A&oe=6A75DAC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-PcatcQR6YQ7kNvwE_q9dW&_nc_oc=Adqx03lKkx2Pap_VgpbfZA6g2La2Pk2scUc5JlC_1EJ6sXO457Q8lkts-F__3Mqv1is&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC_7pQD6UHH9HYqpQaD1Vud4S4go1Mn2uWeYEIUozx0A&oe=6A75C992"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlC4TFkmb5YQ7kNvwE4SPTt&_nc_oc=AdrjujRSAHgRe0bcO9Vck00_Wn5FACF8Z0HsgewniN3vjQDu_Ha3vIgPu7g_mRPBtx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvsZ7W1aI0i6zeyP7_yamQwGh43AC9Os3Qb9nJ6Jy6ag&oe=6A75D7F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKPmw1RlIBUQ7kNvwEPxXEu&_nc_oc=AdrdlQxJkskiXfhH11JrG0UF927pciiRN2jDfDbWeqrokSqNy4qJ_D6WFVih6zyqW4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4mirefteK7ANy7FztqU7yFYXr5EWCNgRTBmvXLSAXqQ&oe=6A75F8FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H9GgOpIanAQ7kNvwH5GRoH&_nc_oc=Adp2lpETV-tXHSnJrhuavFPR96lXlQRZK3Lpv9y8eMlWI2ZaAN2O4iy7Y0ikG-aLUuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPKDVfkxKlYurPHN7TRdd0-wADcFaeQ2Bh1USS3G9qrw&oe=6A75CB6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
kNvwEEP6CG&_nc_oc=AdqWBuwQdM7Ej6QclEXC9Rmi083FQCiUhM7uzziUghsRBcZDVUvDuAKbnwBfJo2Aodk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D7KxHxCsjMS0qiK3o-mygq7qZGPIZYaRbd6dExzpBTw&oe=69DF8FC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dQrjmpN04MQ7kNvwGh_Dlj&_nc_oc=AdobbU4PolwBaPi_I5XfBbMvAVj1ASht15snI7o4Cnn8vTCPahc0oCGGQXAMa9g_7-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JHn6d6j90U0duQWjKSCeFaNGnwvxTvPdSfa6SfpQsAQ&oe=69DF7E92"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aRCgno7EFMQ7kNvwGs9SfR&_nc_oc=AdodRPxMBBLcMWyBGMUbjJl_VsTV0WrAnFA_2VtW_UQwr3WhfZQ8Q0XlLOKUeZ94rhI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p84SbUxZin4m2lRSm8ftwDUCP8zw2WCakXEawahEOcg&oe=69DF8CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6DXNQtplAMQ7kNvwHzk7mW&_nc_oc=AdoZxKkLdOWCIcUAEntFpX4FEF_ZHBMSDiiSiMEkWjhWaLu4gZqGARUUKh070Mm0Jy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qTQP_gyWFbeQUm30CFEyTSPsjUtiflyiOTbjRzuU5Tw&oe=69DF75BD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd7D58P0kbAQ7kNvwF3IBVN&_nc_oc=AdoH1ba6VMb_CXmJ0mtKwD9pFlm5R8LXIspNEaukEFNT5K5CkfCpZeGGMaDQe2w2H0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PNlTRlvRH6xacfTdy4BUFhfdYawqnNT-ccQFTf-URrg&oe=69DF806D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
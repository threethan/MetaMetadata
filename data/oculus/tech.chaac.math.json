kNvwEPS56F&_nc_oc=AdoqeTM6wNYxU-VeaWJ1X2qtXhI8kES0OJtHxYRVNvvYLTtbMzhnwI5YtnNNwdlAdOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWVVc2pCB87YsYSnHf4HOGTe4NFL7b1Rw0I3xPbLDe_w&oe=6AE498C4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4mYjcGfBCAQ7kNvwGYgpNj&_nc_oc=Adq4NmJLpUkjwomy6tp4-UmGGcyJfqrcIlmLRa-fdNAqlg5l8xWlV1VsOQM7W_1wthY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTyKOayEv7eLwzDa8_Msrw00Lhhhu72Qtx2Ni9unBhKA&oe=6AE4BFD2"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET53zhWjkTkQ7kNvwEgbX5P&_nc_oc=AdoKf64_6jQdtdHLp0s_7Absh8jAV6cwJuO_SsNOeqxjqdaEblTpBabM8DtbsGDaD8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsswyAuZE_7-7uHRk3Ghx2S3IsDt0MxCyg6qn11n0TyA&oe=6AE495F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWhCdLIeJ7cQ7kNvwGbJ_yW&_nc_oc=AdpuVyYdRuSRMBH1CFN_7lwcyCYZIjGHmADKR3YoX_SOgE-cY4oAupKRWUtiTqEKl-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2Nt0SrrTBX0Jfc3YHV3iy6sYX4KwsaBWZpOaSoCs_Xg&oe=6AE4B6FD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lU_sQ6Bye8EQ7kNvwEtG1Q2&_nc_oc=AdqYwAppOxe_s0La7TqrR2akHWv34OHZqMrw5vMQVCiXnJSrp6LaX4tlLZCKvuWBY18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN86kF0VMUvIMsbD1oPIyYfu_7CTlVZmkjVLdKJN8TSQA&oe=6AE4896D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
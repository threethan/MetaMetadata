kNvwHApzDx&_nc_oc=AdrF7_zlPs6CiB3XGpi7MKZmvTXitv0ipREwU2ZZG74sjfCivq2rk8sJMsnDk1WOUlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JUI6l0lBfyhfNF4VjwyoKbTMgn5zbrObbsVUPbnboxw&oe=6A071CC4"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqKR2Or9A_YQ7kNvwH6-M12&_nc_oc=Adq6cU11cpmSfbx7nl409jRX6dZrN7wjJvhiJBAgAgZc13Zecp2UZ3AR0_SutLRuWw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43pGSqrgGOYzdcwQWdznihAwmWQLmD6EJQn28dCUgudQ&oe=6A070B92"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLKUnL0m2mYQ7kNvwEDUI61&_nc_oc=Ado53ggTLS_ZbTk36ZlFhbpQS3dia1V6KrheDRYVwuXmPKeiOHMtAdyqeGge-Ag_Dyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SsOgFemZEBU0s8ImzpOAyOO50uhQlBzlvEVgVMDQ-1w&oe=6A0719F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njVX3wweGL8Q7kNvwFPJYTq&_nc_oc=AdoBDAFSQ-YV-1fbYrwmrapXghn7qaJ6MdhaFZq7pxuF6uUpgeXTRUdhapnPx-6TvNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65mmmqT3HHUwwCpHmCbnbPsdAh2cAb_iJNmpptTU_mcA&oe=6A073AFD"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoSzW4LZblkQ7kNvwHJnWli&_nc_oc=AdonJ-zd1KeJhPGEyZrSO6s4JfGuJRu-M5sWV21nPh_eRHyOrwC62jShxLkxpAbbU4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vAm9AYZ5WomqpVpr8YOMALKDwFeDwsQ9K1VeHAafg6A&oe=6A070D6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
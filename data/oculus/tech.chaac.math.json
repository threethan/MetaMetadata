bS83IQ7kNvwH4lOwY&_nc_oc=AdrAc697msZ6EioNXd3SWjG_ygcvjWGAFVVu6v-gMrQ99SA1bLZtkEX893oiodsvhP0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoc0CiJHozh2m_03SBR21lEvGGw9CAfJ5ipc9s1ZLESw&oe=6AAE8B44"}, {"file_name": "error.png", "id": "1220945182693696", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491822855_1220945186027029_3134509840548540682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9P5ZEEMejYQ7kNvwH8KkOs&_nc_oc=AdrNG9mQGw6vQr0Q0VmrhE0oNKxIINljgg2MO4_WQ1bMa1e_GKDl_2O0O_Yj8GxJqvk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpPoMt_0NJnMxZaU_JbQfcxnMSwW3wc1qUDy2zUNxeNg&oe=6AAEB252"}, {"file_name": "points.png", "id": "1232311671870639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820523_1232311675203972_5305435556231081087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYfYgLsL7-sQ7kNvwFMy3j5&_nc_oc=AdpbOzoC0xPRBlQPWieWG__rzdZvoAyJLCEKookB0N3Lx5OwVoVD935o5zFJgMqE7gw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHzFcNS3eTvbhM0iWf8SOPq2VHghyPXoCzlXc6aRUJ7A&oe=6AAE8876"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491824711_3121170774703660_5309438630905965778_n.png", "id": "746833127759947", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312470_746833131093280_3531113835455490555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQj973r9UjMQ7kNvwHW29VY&_nc_oc=Adolz3On-XVvya7epl92hYgxHzuI0JDfT-j9W9x1PRE8lNquqvgJp26tR-YxYV31iso&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI53AYodAN-xq1nwjawF3sLAH1gAjAAvs6aZHCxXfB1fg&oe=6AAEA97D"}, "display_name": "MATH-A-MOLE", "keywords": [], "long_description": "MATH-A-MOLE is a fast-paced and fun educational game where you solve math problems by whacking the correct mole! Equipped with a virtual hammer, you'll enter a colourful arena filled with popping moles, each holding a possible answer. Quick thinking and accurate math skills are your keys to racking up points and beating the clock. Perfect for kids and learners of all ages, MATH-A-MOLE combines arcade action with brain training to make learning math exciting and interactive!", "short_description": "Sharpen your math skills in a fast-paced, arcade-style challenge! In MATH-A-MOLE, you use a virtual hammer to whack the mole with the correct answer to each math problem. It's a fun and energetic way to practice addition, subtraction, and more, perfect for learners of all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24246571431620119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821568_1446995679633631_5695035274869763734_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUJWFsAWjTwQ7kNvwFkDm2d&_nc_oc=Adoa4sGf-TnkkGaI1DiVqogGc9fJLij2wFfemx6tc1spT6o9tiY1u6TB_W6ui7P4wnE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID2W1jdbYvZ9XF72FQuVLbyeTWiVBxDVX5Mk-Cj_dATA&oe=6AAEB42D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
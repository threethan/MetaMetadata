iler": null, "video_trailer_thumbnail": null, "display_name": "Tenabris", "keywords": [], "long_description": "Eclipse plunges players into a harrowing VR horror experience where darkness conceals unimaginable terrors. As they embody a gorilla caught in a sinister game of survival, players must navigate the labyrinthine corridors of an abandoned research complex, evading the relentless pursuit of nightmarish monstrosities. The creatures, once products of a classified experiment gone awry, stalk the shadows with heightened senses, driven by an insatiable hunger for prey.", "short_description": "Eclipse is a VR horror game, about running from escaped monsters from a lab, and trying to escape the darkness"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tenebriss/privacy", "developer_terms_of_service_url": null, "publisher_name": "VR Channel", "support_website_url": null, "website_url": "https://sites.google.com/view/tenebriss/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7459094010767917"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974577_716467900587013_7327459053793278272_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxpIHQJW0zsQ7kNvwHb4soV&_nc_oc=AdrWI9W526VL2oAtnok-sW15MT5pKkNmWv6mMMmvjkAL85ykCDgdOsEwB0juM1f2N6U&_nc_zt=3&
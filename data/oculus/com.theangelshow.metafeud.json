E5JrdX&_nc_oc=AdrKZugyUlMTmxrwn2ZXh_KF8eDUhJkTp-bX90nQdiTX_RFQfyZC6DecAuM6ejTkeUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYcAXpHzPrAJLEHxJkDoSntfi7PEll4BpLWFq2y9LXWA&oe=6ABBBD8F"}, {"file_name": "5.png", "id": "3578271725658921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313107_3578271732325587_1495604642644711843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTsyNQM4_WQQ7kNvwHS_my6&_nc_oc=AdoGDvPK_ePMY1hDduRHLn9trqiPzIPhUby3U6Dd8fAPilHcqBdlK8eOgI4v_Kv6z18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMR2qvNSeflIuawINkGaa8hNMiv3nDSPv2LOE0-LjBTw&oe=6ABBBC30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Crowd Said Game Show", "keywords": ["party", "trivia", "multiplayer", "social", "gameshow"], "long_description": "THE CROWD SAID is a live VR game show where your friends are the contestants, the host, and the audience.\n\nTwo teams face off to guess the crowd's most popular answers. Buzz in first, choose PLAY or PASS, chain correct answers as a team, and steal the round when the other side strikes out. The pot doubles in the final round \u2014 winners take the glory and the leaderboard spot.\n\nBE THE HOST \u2014 Grab the host card and the show is yours: reveal answers, hand out strikes, run the timer, and command the stage with an extended host voice.\n\nBE THE SHOW \u2014 Real Meta Avatars with walking legs, hand tracking, claps and gesture emotes. Light shows react to the game, confetti flies, and the applause meter feeds on the crowd's energy.\n\nBUILT FOR PARTIES \u2014 Drop-in multiplayer voice with whisper zones, a meme soundboard booth, video screens, sit spots, and a backstage area for the show's staff. Lifetime stats follow your Meta account: visits, playtime, wins, monthly champions, and the Hall of Fame.\n\nEARLY ACCESS \u2014 The show grows every week: new rounds, bigger question banks, and fresh features are on the way. Step up to the podium!", "short_description": "Step on stage in The Crowd Said \u2014 a live multiplayer VR game show! We asked the crowd... now you and your friends guess the top answers. Buzz in for Red or Blue team, grab the host card to run the show yourself, or cheer from the audience with claps, emotes, and a meme soundboard. Real Meta Avatars, live voice, leaderboards, and a stage built for parties. Every session is a show \u2014 and you're the star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.seemebro.com/the-crowd-said-policy/", "developer_terms_of_service_url": null, "publisher_name": "seemebro", "support_website_url": null, "website_url": "https://www.seemebro.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1182456281621953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_1552246923015264_7730824005778391554_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeVzIi6YiBcQ7kNvwHTEAyg&_nc_oc=AdrqC7kZCmvW4cWtzNoPUslLwQkmxQXMwU-O3_BxaKXKSr_jpA-ZiMrnFN1wJnUgdy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE5BM61gwm48jtS668zwEyBgVBnaW6xvVc1Nemb3Ylhw&oe=6ABBBF5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Crowd Said Game Show", "platform": "ANDROID_6DOF
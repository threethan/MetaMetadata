7kNvwHvYQYx&_nc_oc=AdoYWO9Smo1FT35Ult0Uk_18FDuYLELDqgWfvQUIoADiYEgdSbYqve8edqQIiuP_ikI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2_wYNfZRZjDPoAF6EoNYAM8OZm7eh3Ae0G-qeg1xJdcg&oe=69F0B0D1"}, {"file_name": "hnsscreen3.png", "id": "794438099336830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75493236_794438102670163_7433929580475462076_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LXodqgByrEQ7kNvwFJcSit&_nc_oc=Adp2pOPr7DQnVonxUQvZ2aVUc62SOS0A8QLfYussYudIheV0dBCaV3hJJCktjpN7jTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3RZtgNnQ5knfS56l5HS5LOYEWtveJc1z2K532vUsGJmQ&oe=69F0BE1D"}, {"file_name": "hnsscreen5.png", "id": "799915842242611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031418_799915845575944_9043712205913483037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl-CBTONXnQQ7kNvwFBvBgr&_nc_oc=AdoqvS4LxF-BzZtlXxpTnAm-qQdwmh4Bch2d1fVlFjmPHYhskT0St6VOKQf_BLgqkK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1K-xieVcMjek_29fFNgmzLLamK0fz1eNuxjb4hm3CzjA&oe=69F09D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hns cover main 1400.png", "id": "342422902024198", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/43931327_342422905357531_5260086719006314498_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOw8d9txTS4Q7kNvwEM00l9&_nc_oc=AdpcYJfUhYMzUHhUgPlSD8vdIT9I86n-P9ZLim8gpb6N6x6EFqeO8EUrCYBJjH_Er50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3fDNbS-LwR934r3wdEppKBe3ybjrodDI6AVmPedBvrrQ&oe=69F0B420"}, "display_name": "Haunt n Seek: Silent Siren", "keywords": ["Horror", "adventure", "scary", "storyline", "action"], "long_description": "Pre-orders & Finishing Story mode.\nThis is the last public update until the game is done & shipped\n\nComing October 8th\nSilent Siren - Immerse yourself in the life of Dex. A troubled character with a murky past and a mysterious radio as their only guide. Unravel puzzles, confront ghastly entities, and fight through a series of mind bending challenges within The Silent Sirens eerie universe. Uncovering Dex's sins of his past, he must face his own guilt and over come echoes of his actions. This horror game blends psychological intrigue with the supernatural, questioning the boundaries between guilt, reality, and redemption.\n\nEscape Rooms - Explore huge open worlds or find the keys to find the exit button to the \"Safe House\". You can find some fun games that take advantage of the XR/VR experience like a life size shooting range with a dart board & bow and arrow, chess, pool, foose-ball and more. Play by yourself or hop online and race to escape these skin crawling & under-worldly maps. PVP, puzzle, or timed modes, team up or betray your friends to escape.\n", "short_description": "Pre-release to support the developer\n\nSingle player - Maze mode - Find the buttons to reach the next level.\n\nEscape rooms - Find the keys to the exit...\n\nEscape rooms online, and full single player coming October 8th\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hauntnseek.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nathan Pacheco", "support_website_url": null, "website_url": "http://www.hauntnseek.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8098298906932572"}}]}, "scheduled_offer
sin2-1.oculuscdn.com/v/t64.5771-25/39003224_1231497581551969_6608302278278743556_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4Rfp0OFM5wQ7kNvwFVgYb0&_nc_oc=AdoEMcDgTW0roS-WNROpFla7fs5y44dRpyPy5Bfn_T8ocuVeXFEaBmmeYfIIzQCa48A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kaCqUhFxnuVyQJTRpuVb0kfJbVdYP6YOedPAwgRXRmA&oe=6A11A651"}, {"file_name": "hnsscreen3.png", "id": "794438099336830", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75493236_794438102670163_7433929580475462076_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqGf5ceeuWMQ7kNvwEyP5h6&_nc_oc=Adokas7zIqZh9t2z7iUKk_93AyFIF3gXRDS_efaI3SWAFo8T5Z4wjijD_FhR2dW7puI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68twZgmrqKO6NZR93Jge1qHLw2xDyVuAHmI5-G47k_Gg&oe=6A11B39D"}, {"file_name": "hnsscreen5.png", "id": "799915842242611", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031418_799915845575944_9043712205913483037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjwZDcLSg8kQ7kNvwHA6Aoh&_nc_oc=AdphtjQjakmmmrSx55ouRrZob16a2RVFhGf-HkxB7ZHBHuLCtxNUeGnRA6KKVSpoX-U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DlwiVJcsvWCpd-e2GcXa3ZBj0HIH8mwQEYenjMJMN6Q&oe=6A11CB38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hns cover main 1400.png", "id": "342422902024198", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/43931327_342422905357531_5260086719006314498_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AlGD4xY-7sQ7kNvwHsFxY6&_nc_oc=AdpRAdkdWBMOb8xwfSGIsScNGXptT1erazjI8yuQWwWMHg90fZyfHlId34_9-bsXLwA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g0qk2NpufIt0rliKSqOH-McDDZVadBvLk9VcAyXhM2w&oe=6A11A9A0"}, "display_name": "Haunt n Seek: Silent Siren", "keywords": ["Horror", "adventure", "scary", "storyline", "action"], "long_description": "Pre-orders & Finishing Story mode.\nThis is the last public update until the game is done & shipped\n\nComing October 8th\nSilent Siren - Immerse yourself in the life of Dex. A troubled character with a murky past and a mysterious radio as their only guide. Unravel puzzles, confront ghastly entities, and fight through a series of mind bending challenges within The Silent Sirens eerie universe. Uncovering Dex's sins of his past, he must face his own guilt and over come echoes of his actions. This horror game blends psychological intrigue with the supernatural, questioning the boundaries between guilt, reality, and redemption.\n\nEscape Rooms - Explore huge open worlds or find the keys to find the exit button to the \"Safe House\". You can find some fun games that take advantage of the XR/VR experience like a life size shooting range with a dart board & bow and arrow, chess, pool, foose-ball and more. Play by yourself or hop online and race to escape these skin crawling & under-worldly maps. PVP, puzzle, or timed modes, team up or betray your friends to escape.\n", "short_description": "Pre-release to support the developer\n\nSingle player - Maze mode - Find the buttons to reach the next level.\n\nEscape rooms - Find the keys to the exit...\n\nEscape rooms online, and full single player coming October 8th\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hauntnseek.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nathan Pacheco", "support_website_url": null, "website_url": "http://www.hauntnseek.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
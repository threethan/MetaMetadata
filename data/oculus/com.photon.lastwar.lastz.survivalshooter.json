oyG9mPa26EJB0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNeyVu33kX-jk4agfbsOtQDO5M_-LUP65sD10RFFlcxQ&oe=6AE1F69F"}, {"file_name": "5.png", "id": "1472896547775644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618254_1472896551108977_3767405035103428404_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo_ie74HLZ8Q7kNvwH_Z0_p&_nc_oc=AdryYh3BmSelj3cQ6xJHgKK73QhwM1pV98pWkbYsiovj6_lBd82u8UmFJLM30wX0cgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv67sNxLI1K9o-3I8yIMj3ObqEDqFBs4AK44XBueCroQ&oe=6AE21C3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last War VR", "keywords": ["last", "war", "survive", "run"], "long_description": "Step into the chaos of a world on the brink of collapse in Last War VR. As one of the last survivors, your mission is to fight enemies, complete objectives, and stay alive in a dangerous and unpredictable environment.\n\nEngage in intense VR combat with realistic weapons, smooth controls, and immersive gameplay. Face hostile threats, plan your moves carefully, and use your shooting skills to overcome every challenge that stands in your way.\n\nExperience survival-driven action where every mission pushes your limits. Stay alert, manage your resources, and fight strategically to survive longer in a war-torn setting filled with danger.\n\n**Features:**\n- Intense war combat\n- Realistic gun mechanics\n- Immersive VR gameplay\n- Survival-based missions\n- Smooth shooting controls\n- Challenging enemies\n\nWhether you're a survival fan or action shooter player, Last War VR delivers a gripping and adrenaline-filled experience. Fight smart, survive longer, and become the last one standing! \ud83d\udd25\ud83d\udd2b", "short_description": "Survive the final battlefield in Last War VR! Fight enemies, complete missions, and stay alive in intense VR combat. Experience realistic shooting, immersive gameplay, and nonstop action in a war-torn world inspired by survival and last war scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/photonhorizons/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Photon Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/photonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26340380325616818"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26364453636542820", "version": "1.0.1"}, "id": "922673594014590", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26340380312283486", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26364453636542820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "922673594014590"}]}, "change_log": null, "created_date": 1791951942, "id": "28714232544898239", "version": "2.0", "version_code": 2, "release_status": "PENDING", "sta
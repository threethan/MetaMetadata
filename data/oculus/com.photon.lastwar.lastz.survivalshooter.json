e": "3.png", "id": "2821492534900085", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491820548_2821492538233418_159225728378605651_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLutT_vcXH0Q7kNvwHOHhQt&_nc_oc=AdoksNYCFtcZ9LnlA8efOTcBH49kQUBUaAusLbDQLxSa_DYevLhX3h-ddDz4R-iAdCk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56hwU2i1uze41sUybBOJEdjre5pRnFto4DqvWsrpl1zg&oe=6A09D8C0"}, {"file_name": "4.png", "id": "960483176393803", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618440_960483179727136_5201921845405583397_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37QUxNSG2y8Q7kNvwGDGocs&_nc_oc=AdpIKqruUQHU2xxw6o0t_102xYmPY9SWQjQrtMpa3JG-pK6XmtarIvSo_ZMinFM1yss&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aTduoivK1OygDNS4OrySmlB237fysbQT8W1MlPswupQ&oe=6A09BD95"}, {"file_name": "2.png", "id": "1404819021416379", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619450_1404819024749712_446333655698074614_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fudyrlN3UzAQ7kNvwHRcuU_&_nc_oc=AdpOteZL46PKrG7X4Fj2zBjoVS0uIId8DsTjUqSNMbGVxShb5MiN5hqIObD5dEOiXt4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79gMpqh0ri5nMcHYXm0nuRbkfrjCaqv7aWczx7XsWGdg&oe=6A09C09F"}, {"file_name": "5.png", "id": "1472896547775644", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618254_1472896551108977_3767405035103428404_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhOY2vexP0oQ7kNvwGqLoWT&_nc_oc=Adpdxtv349-MUvxFTEOhXl-hFM_MIj9dIjqXT2PImOHzs02GHc-hxm6WMSblCzhpQNQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67SlWI3yt5nzRjsF5PDa-T1aEeS5lS16cYnbNFrfxW0Q&oe=6A09ADFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last War VR", "keywords": ["last", "war", "survive", "run"], "long_description": "Step into the chaos of a world on the brink of collapse in Last War VR. As one of the last survivors, your mission is to fight enemies, complete objectives, and stay alive in a dangerous and unpredictable environment.\n\nEngage in intense VR combat with realistic weapons, smooth controls, and immersive gameplay. Face hostile threats, plan your moves carefully, and use your shooting skills to overcome every challenge that stands in your way.\n\nExperience survival-driven action where every mission pushes your limits. Stay alert, manage your resources, and fight strategically to survive longer in a war-torn setting filled with danger.\n\n**Features:**\n- Intense war combat\n- Realistic gun mechanics\n- Immersive VR gameplay\n- Survival-based missions\n- Smooth shooting controls\n- Challenging enemies\n\nWhether you're a survival fan or action shooter player, Last War VR delivers a gripping and adrenaline-filled experience. Fight smart, survive longer, and become the last one standing! \ud83d\udd25\ud83d\udd2b", "short_description": "Survive the final battlefield in Last War VR! Fight enemies, complete missions, and stay alive in intense VR combat. Experience realistic shooting, immersive gameplay, and nonstop action in a war-torn world inspired by survival and last war scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/photonhorizons/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Photon Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/photonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
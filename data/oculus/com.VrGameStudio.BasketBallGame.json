uscdn.com&_nc_ss=8&oh=00_AftsxQhZ5I-8IN-dy34wCmcMK5ZBCDrtzts8ipzY4I7SVA&oe=69A98391"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIEg4pHn8yQQ7kNvwE7YpA6&_nc_oc=AdlCm456adl1y3qOmr5xbO4K5nQylJyjQ7T9KN6Tzmzr9EBxVuCnFTVWpOVbbxl1XUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvkgP1Wtq4nCR-1lNKFnVJGdtP_2FQ_f8D-jhfKSwfnRQ&oe=69A960E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r42K0Hlg9AwQ7kNvwGXaCl8&_nc_oc=Adn2fIo6oY7IKu9AM8x825YP_SwXi7g21DtlF2UeGIjFifm8kmdDQOCqHaVC01ZMciI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuLdKhUgH72D86CdhVF5hDG7X9KvsChWEGDPm4cUMMN8g&oe=69A97CF7"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_
H-Nn2a8YVwDbYp3rI7w&oe=6A9EA86A"}, {"file_name": "4.png", "id": "410417030884029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031421_410417034217362_7853533547198832184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdraAnJEvfoQ7kNvwH4jdB_&_nc_oc=Adr-JeGMkRVxuG5ibEJoT8TCqcviLQUdaW_nX53_7XfNdeuoS8qkLDi4qxxb9hNhm18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISdfsfIm1ofdHmtYayaNoP792mbfamOyGznwSatMT14Q&oe=6A9ECF62"}, {"file_name": "2.png", "id": "2830791357220970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2830791360554303_6840073495807871444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLxnPFXrjesQ7kNvwGUMN6V&_nc_oc=AdpUL_dx2mIwk5ITBLIjd-oZo4BwV_44WjVUCHOYsnnm0iaRR-XQ3ta27CY7PSPPE4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZkApabSNXdyBZG5q6-R4uRcpwM-lLZgOY7FjJs5G1yQ&oe=6A9EBA91"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EkIvWOiIbEQ7kNvwFD31lJ&_nc_oc=AdrFskEhRFiuDr72BzrMy8dprJUVr7j0_A_71pqYKSiA3tZh1dVq2npCfWDnlIDP80Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx7SOhjWdNQjxQTqBmGvSykiji4VF6v1okG0o5Kkw65A&oe=6A9ED026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPB-BgRxRXEQ7kNvwHPnpjQ&_nc_oc=AdpKefnxXD2sfC7q_q3gURe-gXW4AClt4zn7tx0OtoM1LV-3YSQU2OTZm3QafPQY--0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnN-42xIp9cPR00JodatNGFGYjhrjL67v42Avp5JayoA&oe=6A9EB3F7"}, "display_name": "BasketBall VR Game", "keywords": ["basketball", "nba", "sport"], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://basketballvrquest.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "https://mugiwaradeveloppervr2.blogspot.com/2024/05/welcome-to-mugiwara-studio.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286927824708234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43931334_479515953565257_3247058776959712942_n.png
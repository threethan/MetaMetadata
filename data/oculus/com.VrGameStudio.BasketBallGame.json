ULIOgXQ8EySOc3X6rwg&oe=6A75C9EA"}, {"file_name": "4.png", "id": "410417030884029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031421_410417034217362_7853533547198832184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6cHXimiB8cQ7kNvwGDyOXh&_nc_oc=AdrfOeCXZA7bWglCPsvxPvmMOSrv6F9zEY6JoU7ilgNOsvpfPne7zZm-equGUCiaVDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6rLHRCcirWhdwvLgyk7nBiK4ZrPHnY7uLQUCoDmBfsw&oe=6A75F0E2"}, {"file_name": "2.png", "id": "2830791357220970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2830791360554303_6840073495807871444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrhP6miOhWMQ7kNvwHv3UZ0&_nc_oc=AdpCUw2iUb5YKOruEsV4UA9wFppHL4UP6vyp4tXFkuuu7MOlXBggdglT3krS5tT7SO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzx8xht2TH3qt9eLOrxxjOMZ6NepkYQ46GGGAil1kELQ&oe=6A75DC11"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xVjGkbaUxQQ7kNvwF7OadT&_nc_oc=AdqY-aBtweopp7BgLVSoEVTYfCPeIV5qOWnfg5fkQC-Dgsf19gjneTl43_UgTFzceso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgbwCufSZ3g1WfeFakXdCtKE56cynb7p_ZGaYOXFIO1A&oe=6A75F1A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DluR8VwrXzkQ7kNvwFdJ2dC&_nc_oc=AdrZa0EZuC1gylF3cFBGZ0b5wfaEujnfJ3mBqPJ3coto_BZvi14Zxfo3S55zy0snLak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFckUAfPV0HEsyYomn8F0qAunHBYpTq6zAn0eyms-eEHw&oe=6A75D577"}, "display_name": "BasketBall VR Game", "keywords": ["basketball", "nba", "sport"], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://basketballvrquest.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "https://mugiwaradeveloppervr2.blogspot.com/2024/05/welcome-to-mugiwara-studio.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286927824708234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43931334_479515953565257_3247058776959712942_n.png
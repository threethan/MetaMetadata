0239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Mw0nLyvHYQ7kNvwFxgXNg&_nc_oc=AdkVQDQVlvckmGzMI5TR1w94283l3ad9J4ZOPUkxiEvz8DlZQX3DmQ2ar7Q6Qr_A_08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv9f8VJMDjwO4U5BhYaTjl6VeUmKYeXW2HTTRdFI3SGFg&oe=69A41AE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1mvjcR6P0MQ7kNvwE9tJmN&_nc_oc=AdksuNW1NIoPytUAPefFskwt99T1_GbB7BOC50_b3a7a6kC9pPVGTBHt6fjePWrAZOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvk3AEmQ8i4Z3QUol6F5C6-h7Hy9hPhPXM_39bMh8hDng&oe=69A436F7"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/basketballvrgame/home", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "http://www.mugiwaradev.com/", "category": "GAMES", "comfort_
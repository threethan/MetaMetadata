uluscdn.com/v/t64.5771-25/39031421_410417034217362_7853533547198832184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhynthza19AQ7kNvwGVBhj4&_nc_oc=AdlUT0pCXwbnRJsQNIJJ7Usz0yY_X4ZIfdpyYM6WDJhWa3fypiNe-ibXf2IjNhnC6lU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuVxA09yYinto-p6oZ-Epn444gGzVjIw625RCUheQ7bEw&oe=69A41A22"}, {"file_name": "2.png", "id": "2830791357220970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2830791360554303_6840073495807871444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z2qZJLobUUQ7kNvwFUxHCt&_nc_oc=AdmWuJVlkEWdADE5yp4Scncg6ru7xlIwITNW1qRGU-GrKuYhAW79gCf3l47P3h1w9BU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuDz-stQp1xa4I6rfv9WOH1EQJ6mkSpAy_UJa20txX-PA&oe=69A43D91"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Mw0nLyvHYQ7kNvwFxgXNg&_nc_oc=AdkVQDQVlvckmGzMI5TR1w94283l3ad9J4ZOPUkxiEvz8DlZQX3DmQ2ar7Q6Qr_A_08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv9f8VJMDjwO4U5BhYaTjl6VeUmKYeXW2HTTRdFI3SGFg&oe=69A41AE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1mvjcR6P0MQ7kNvwE9tJmN&_nc_oc=AdksuNW1NIoPytUAPefFskwt99T1_GbB7BOC50_b3a7a6kC9pPVGTBHt6fjePWrAZOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvk3AEmQ8i4Z3QUol6F5C6-h7Hy9hPhPXM_39bMh8hDng&oe=69A436F7"}, "display_name": "BasketBall VR Game", "keywords": ["basketball", "nba", "sport"], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://basketballvrquest.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "https://mugiwaradeveloppervr2.blogspot.com/2024/05/welcome-to-mugiwara-studio.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286927824708234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43931334_479515953565257_3247058776959712942_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHf4rLK8srgQ7kNvwH6_qau&_nc_oc=AdnNw_F1SvVWIl6MncqKF3CjtafIdjAi6Z2Z8INgZbH5rs_FjOofVzckQKjfHU-6iDQ&_nc_z
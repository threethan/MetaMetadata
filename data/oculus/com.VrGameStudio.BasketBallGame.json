uscdn.com&_nc_ss=8&oh=00_Afye8DEqDeSOQ6MNGE11kUkQnBlDgl3rxEnQ31Gy8MXUog&oe=69B40F91"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBNs6DqhPZcQ7kNvwEaMEH7&_nc_oc=Adkw_EtV-EaRB_-b2E5TEUuHmJaUn2G625yzos2m82rri9SHJvIi00Ejs85u1OiL_3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afysad6fCWK0n7mq4OUUhAdatO99WXFYM8IGHFDPgQgZxA&oe=69B3ECE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqZweM5J_84Q7kNvwGph2CM&_nc_oc=Adny0brgU8gUxf_jnoEiLEmS_jYGJQd0FenaLYc7az0YgyY5MoR5FhLBKIuOMA_isTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5flGgXlD6Ry1Qs9B6k0FNMXnv4HkBXyWmwHSQ41NyZA&oe=69B408F7"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_
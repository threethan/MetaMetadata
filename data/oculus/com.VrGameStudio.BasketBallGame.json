0239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-bZHrqXXGYQ7kNvwGICvOh&_nc_oc=AdmJ51YB9ACfKbMlV-1StEXH4bPZ7SCN7hOdjuHhtH7Ip0e-1nYkR9An5AG4ok5HrEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfswqD52cXcyukFv-Wq_tX2B1MHBVXMKnrgdfKHq9mL3wQ&oe=69983D66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUpgj5dWmeEQ7kNvwFKzNG6&_nc_oc=Admv4btMm3m-RKqlVuOa3xjRkCHdB7PxbCLJu6cyls3nNeg_2aLQvU_lb7SJTZu8BsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvpUpgx9tscbhsYtt3KMIPCm6z5n3LhQNOhI6KUMZSe4Q&oe=69985977"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/basketballvrgame/home", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "http://www.mugiwaradev.com/", "category": "GAMES", "comfort_
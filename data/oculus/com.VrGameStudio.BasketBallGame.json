uscdn.com&_nc_ss=8&oh=00_AfyH9zF_DX4jdpIHFYJERcHlLX-dbymNUKe1xOi2l_ixRQ&oe=69B56111"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBNs6DqhPZcQ7kNvwHQpg4g&_nc_oc=Adllwx560Gol3kVqH8sEPe2vE6bRYztz1uaIyeCfztWHjWTo4iZYv7jXyzg9SHsADM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnJYpnLD5daGuncrINFbRWR-tV-D4NBC_DIYk066KfaQ&oe=69B53E66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqZweM5J_84Q7kNvwHYNJMZ&_nc_oc=AdmAbxncs-g7B8bZvQq2tp65OUQNYZCMd6MMh0MRE9wNJ3w776S4PO2nbfIHSq9bido&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5ShRhXQI6b7agq3bvjIizgCVAmjrKtl_7uO7UXROJPA&oe=69B55A77"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_
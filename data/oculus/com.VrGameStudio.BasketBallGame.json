0239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0G-jexxPRcQ7kNvwGK6zHw&_nc_oc=AdoPBv3Fy8yJ65EwBm1AUS8OVJ1gvYnvf--z-lVweFYlktKdJVrSgtl4Z02-ar6a5ZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0VmlI02F0HBKuk408Bgg-rbRM7F05dNXrP9fqKQ5hPMg&oe=69F0CA26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r9AXMIKEuMQ7kNvwHZDyeb&_nc_oc=AdqWrWxgdEsuFOoHol_qpFfW5HvzTD0gSdJmGHZw8Ji1rbFXETO0y6tJ7rExouOISUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af31vUkwcZp0XG3Yh0n0PYhm_PLWvbM75D8DiSYtVUbJXg&oe=69F0ADF7"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/basketballvrgame/home", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "http://www.mugiwaradev.com/", "category": "GAMES", "comfort_
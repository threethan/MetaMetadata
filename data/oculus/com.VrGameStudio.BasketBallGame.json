uluscdn.com/v/t64.5771-25/39031421_410417034217362_7853533547198832184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPsOSGoweE0Q7kNvwHmJ4IO&_nc_oc=Adn7KYlACuxC6cYXZMB3x2FGZny1Ey_YumGWz1bn1W8Rh1cC-wrFjj01ddz2UWMs3R8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEAgCb9E8aW6v-vKOqRa4__Nv77H1a7TIbm4Z8KjuskA&oe=69A025A2"}, {"file_name": "2.png", "id": "2830791357220970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2830791360554303_6840073495807871444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aypwvqiPd0Q7kNvwEWpIC5&_nc_oc=AdmaK8VGRtZRf6ZEm9uQqRFsNYyhidDhXIV7cNRg2nvOL_A6lo4GWy-KAws9lbjW638&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssWQS22WfzdYoR2OrOroqkxRT5p5P0FGHxohbeKUqmTw&oe=69A04911"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBJPMUBjthUQ7kNvwHxmPVv&_nc_oc=AdkRRwlfM9xOIobZkRYjO3TPYFkyDQBBgiC90uU-5S_hVlZflm-6siKDmAYVFivyWAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsU6H5qLADM93vSdV5RkGqxfIa2bbyYmLrZuE3Pu_AuGQ&oe=69A02666"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cOGBTMl84AQ7kNvwFHOyEX&_nc_oc=AdnDgeEnYGV2AaJT13nLkcFgrPyYXsdOaM5W6mBfOQyy01Q8qWGDsyK7Ivt-kW99GS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLVVl4dM-rsNdWOoZelhfHtWEu4V_rjuwoKayVndoUJA&oe=69A04277"}, "display_name": "BasketBall VR Game", "keywords": ["basketball", "nba", "sport"], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://basketballvrquest.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "https://mugiwaradeveloppervr2.blogspot.com/2024/05/welcome-to-mugiwara-studio.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286927824708234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43931334_479515953565257_3247058776959712942_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE2xLubKXf0Q7kNvwFRwlGq&_nc_oc=AdnnQ_2YvQZ4LZSMg6YDlaswRF-TdGQMi4Ah8uIiMCP4DxVCk_LkqR60C18U0LSe8dY&_nc_z
V4HCTxwaZj_EC-4GW1A&oe=6ACD052A"}, {"file_name": "4.png", "id": "410417030884029", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031421_410417034217362_7853533547198832184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCtAcYadjtsQ7kNvwEePOGr&_nc_oc=AdpKJcwD-ltGoNzvxeBabcnP2Q15mp_UjmisqTc2PYrQ9_SFtPf6s0cQjuHuWZiEZa8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFkXWuhaBo-cU_iJjcCzm4cn5ivWi9IJQJKWjtJMZM6g&oe=6ACCF3E2"}, {"file_name": "2.png", "id": "2830791357220970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2830791360554303_6840073495807871444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxbnGAvJzMAQ7kNvwGJwGNX&_nc_oc=AdpXPAKBktOSG4dQTdPtD0I_5h6GpmPOdpmzseHnvMf7jWt0Sw2k5K7ftE7MMIwUC0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2oivKmpYjHYqo8i1zPhznaDxoPkKlQijIGUYwdkpfng&oe=6ACD1751"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzWyJ2JSvtIQ7kNvwEODB-U&_nc_oc=AdqZW_hKFTQqXjLo62yVWe3eqQoCuGFiRFRKnx8JxgeTsAE3Tl2HiRn2ll7ruLRcWdo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJcjlj6QETBBvLOzzPuaV65I2V_aAMLUCej6QZ5NANDQ&oe=6ACCF4A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c7tbancGrUQ7kNvwET7cCh&_nc_oc=AdqxPyfOg_sTeaLKnr48eXIXlYXJfDs1MYxPIm46GRqFCtcW4Q4IfV1jBdAuGHSi13A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsvOE0HnS9L0z0uMV_DHRBbXURDB2l_AUcBvxfsF7R-A&oe=6ACD10B7"}, "display_name": "BasketBall VR Game", "keywords": ["basketball", "nba", "sport"], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://basketballvrquest.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "https://mugiwaradeveloppervr2.blogspot.com/2024/05/welcome-to-mugiwara-studio.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286927824708234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43931334_479515953565257_3247058776959712942_n.png
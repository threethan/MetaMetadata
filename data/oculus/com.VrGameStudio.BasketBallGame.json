uscdn.com&_nc_ss=8&oh=00_AfwNpuDfQnTL2r8kT7GgxHDXfVPF-45Po6NnMDCGqUmrzw&oe=69BAA711"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SFafUXRWQMQ7kNvwFLBTbP&_nc_oc=AdlNqEZr4ZWGkwd13go53ftjz4R0xZeoxKK_XYe7k9TP4o4HH5tjD7U2LW05-yP6Xho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSnjdZoieTYxwZwWBjMi24tTvaMn9a-tLYU8tKYVU9gg&oe=69BA8466"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpElrBSkdE0Q7kNvwE75z72&_nc_oc=AdkMqQLZbcIgCNvdK5r494u5hzhvzTOReFBKaJh9jpDI1N8mygxZWYWpvalMWnA_ecQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzc3U5z09PKy6gp2Him8jEgX-rpF7pdPwucTW4F2hskGQ&oe=69BAA077"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_
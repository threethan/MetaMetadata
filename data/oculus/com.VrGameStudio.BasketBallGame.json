uscdn.com&_nc_ss=8&oh=00_AfzmQwodRNk6wUJ77cmxhjvm97JasOXntRE9aydZvvAWWQ&oe=69B16C91"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWdST28m45QQ7kNvwEvhTpS&_nc_oc=AdmWXzZsooIiPFPl90BEANRyO32vyqHkGH2YxCowmlXGNn4_pKHizKN6Ksk7g9FovsA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7wT-BRTotWP5nX6oJJGx7mEtD8OMGnEQKE9wGKUWvGw&oe=69B149E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN7tsX5BNnIQ7kNvwFe8OPA&_nc_oc=Adke6ABaBQz4deuJX-lbse8AFKTjyYrIaIwti04X-b2W28YZUayxtsFZaMrvT1ijA80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzy-Z1j5oG_oJ11fVlGucRJfkdugzcqGo5bEf4ytNyJvw&oe=69B165F7"}, "display_name": "BasketBall VR Game", "keywords": [], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_
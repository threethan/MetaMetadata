k_HoGnFOsoClYS5xLtl5a8hAA&oe=6A468C2A"}, {"file_name": "4.png", "id": "410417030884029", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031421_410417034217362_7853533547198832184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAVW75WGLk8Q7kNvwFPb3VE&_nc_oc=AdoBHhfGEPo63rqPxhGj1dKDrsXVQIENYe8bfUlNWKHV3B5_Jrrh4hPjt_frt5IPpuo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jfgAtk1tdVrLioCyPX4wOjWHyiCDYo3wJC-pSQRPDOA&oe=6A467AE2"}, {"file_name": "2.png", "id": "2830791357220970", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974671_2830791360554303_6840073495807871444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVBjJi3wKaYQ7kNvwGkkGtn&_nc_oc=Adpa7Fsxid0KN9OKAgBvj03nOvQSUvJ8mVSKJHnrWq7BrNr8ZKoJbjXtd-WvwhRNc0c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I1vkCE9h8nm0FthsWE4lIAcofb4jla6IAKs0wHC9s-Q&oe=6A466611"}, {"file_name": "3.png", "id": "1409556646125385", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974711_1409556649458718_8500239576750137685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UsP-Q7sENMQ7kNvwFu4-bf&_nc_oc=Adp9PHCcZw6eTaItDtMzotNZ8O2sB9Y3RoZS-JCWYJEqQwXLGwdLruB4I_DtYp3TQ6U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GlFv_GVKImot6wumPxxPmuhOyYMBNV_pkcqcMcsvGGg&oe=6A467BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAP.png", "id": "1077889199442521", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031326_1077889202775854_7431149712462829596_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quXO_tnpUikQ7kNvwGL4GrF&_nc_oc=Adqp_9C1vqn7mhnEKkBbWHKPeCbMhuv5riqas5JK_C2IK0aWoa1Zwca1XiQ9aSa5pAk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98-5jtu3G7EtiWarGDfVDIHiscVtGy7hGv87U3CMuQuA&oe=6A465F77"}, "display_name": "BasketBall VR Game", "keywords": ["basketball", "nba", "sport"], "long_description": "The realistic controls allow you to feel like you're on the basketball court. The more points you get and make, the better your ranking. Every day, you get to enjoy playing basketball whenever you want! \nBasketball is one of the world's most popular sports, and now, it's even more fun with VR Basketball! Don't miss out on this game! \nCompete against the clock to get as many points as you can and try to beat the high score! and the high distance\n\nVR Basketball  utilizes unique technology in allowing for a never-before-experienced simulation of basketball featuring:\n\nRealistic controls that involve dribbling, shooting, brings you the feel of a true basketball game\n\nplay in various game modes : Free mode or Contre Time\n", "short_description": "VR Basketball brings you a realistic basketball experience where you can play against the clock or in free mode "}]}, "developer_name": null, "developer_privacy_policy_url": "https://basketballvrquest.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "mugiwara studio", "support_website_url": null, "website_url": "https://mugiwaradeveloppervr2.blogspot.com/2024/05/welcome-to-mugiwara-studio.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286927824708234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/43931334_479515953565257_32470587769597
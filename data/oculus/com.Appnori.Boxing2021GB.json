v/t64.5771-25/39036607_1050071728968862_7605932992435113397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNJkpp169a8Q7kNvwGONSj1&_nc_oc=AdoFAgtrF_9GVAZb3vGX23Cr_wCyG-C6Ywd8f68JPTrPUbnP3UzsRuR8sLpHJvEPqpA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKdtU2f5scMYyfFeNiQ6Aqv2fVftihXLvwyidIVQOkuw&oe=6A5A4896"}, {"file_name": "06.png", "id": "409847347823364", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974469_409847351156697_6731537708086063699_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D0VYJwy7mgQ7kNvwHWOcK3&_nc_oc=AdrNs6oJ1qUb_romqqc6HniuY13ES9Iwg89sWXVYZvplaMpW3m5iyRHz5STMjWxs4BU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmDbke-zioj3CyQecMCuTPhbL6xZhILrp9buK7wig9sA&oe=6A5A17F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "875545037171554", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982698_875545040504887_419767593173582640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoQgyGWp2zIQ7kNvwFxxGiu&_nc_oc=AdqPIKV9xz9mfb8twW-MovlNkEwDcxO04TcqQJTQsNK99ChPIDOwDuHKIR6IMycvV2Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_sn17rzpOmJemfE9pzNm8pxi6MSsPBBLcifHltOHyZg&oe=6A5A1DB2"}, "display_name": "Manny Boxing VR", "keywords": [], "long_description": "Manny Boxing VR is aimed at realistic Boxing games using virtual reality systems.\nIf you want to enjoy Boxing through VR, Manny Boxing VR will be a choice without regret!\n\nfeatures\n\u25cfBoxing play with Manny Pacquiao\n\u25cfVarious boxing training modes\n- Mitt training ( with Manny )\n- Dummy hitting practice\n- Punching speed ball\n- Heavy Bag Training\n\n\u25cf Advanced AI divided by 5 difficulty levels\n\u25cf Multiplayer boxing in real-time\n\nhow to Play\nBoxing is a Dynamic sport played using gloves to hit opponent in the Boxing ring.\nAvoiding the opponent's attack, Attack your opponent in various ways.\n\nChallenge the best boxers!", "short_description": "Manny Pacquiao is the only eight-division world champion in the history of boxing and has won twelve major world titles. Enjoy boxing with world-renowned boxing star, Manny Pacquiao! Realistic physics, immersive sound, and fluid animation make you feel like you\u2019re really in the Boxing ring."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.appnori.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Appnori Inc.", "support_website_url": null, "website_url": "https://www.appnori.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "860418018440834"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1003790862498815"}, {"status": "PUBLISHED", "id": "853818240790284"}, {"status": "PUBLISHED", "id": "1583781772653182"}, {"status": "PUBLISHED", "id": "740698912416522"}, {"status": "PUBLISHED", "id": "656584046774096"}, {"status": "PUBLISHED", "id": "706311821851856"}, {"status": "PUBLISHED", "id": "3910564132492190"}, {"status": "PUBLISHED", "id": "1167545651611159"}, {"status": "PUBLISHED", "id": "597923676531391"}, {"status": "PUBLISHED", "id": "1193225231738242"}, {"status": "PUBLISHED", "id": "1534674087126610"}, {"status": "PUBLISHED", "id": "766500751336713"}]}, "baseline_offer": {"id": "597923676531391"}, "is_a
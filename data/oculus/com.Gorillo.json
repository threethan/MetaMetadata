uluscdn.com/v/t64.5771-25/491822410_1364474394662270_1841504602384990568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IE4BSH3YNIQ7kNvwFGfxI4&_nc_oc=AdqQWRLl8biMvaNBAWXvMKvVMqAZLKnVljIAdVMZ9BDYzJZoZ59JkjNZEzT2QnG4Pic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqFwXyTJr-CycHsorQsdoVhzNoF4fBP-SCZEq8iYipow&oe=6B00555E"}, {"file_name": "Gorillo_Custom..._22.06.2025_13-07-54.png", "id": "720932720875836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_720932724209169_3199899396323910691_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gXOR2jUP2cQ7kNvwEGn8rz&_nc_oc=Adp0V-99tYVbLaQTZR70Rtiny7H1VWBUqIoDZZzGOsv_j96QWNMr3Tal0YxhZxmaJFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4gtp2-KrH3vimdTtqc7dC5-DEhlGF6eryGPrNmj0l5g&oe=6B005827"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillos", "keywords": [], "long_description": "Unleash your inner primate in Gorillos \u2014 a fast-paced multiplayer VR experience built for thrill-seekers and competitive climbers!\nSwing, climb, and parkour through vibrant maps using only your arms and momentum. Compete in various game modes like Tag, Infection, and Custom Challenges with players around the world. With responsive locomotion, social hangouts, and constant updates, Gorillos brings freedom of movement and community-driven gameplay to life in virtual reality. Whether you're chasing or being chased, every round is a wild ride.\n\nNo buttons. No joysticks. Just you, your reflexes, and your gorilla arms.\n\n", "short_description": "\"Gorillos is a fast-paced multiplayer VR game where players swing, climb, and tag each other in immersive jungle environments. Master your movement, compete in exciting game modes, and experience the thrill of primal VR parkour!\"\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/36f333cc-b191-4b46-
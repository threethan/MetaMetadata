lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTc2FC_1eNxc7HCJAkF1GQlX5dwBw0EMmY3_QqcNFrtw&oe=6A8EBC1E"}, {"file_name": "Gorillo_Custom..._22.06.2025_13-07-54.png", "id": "720932720875836", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617850_720932724209169_3199899396323910691_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C8DrN1BKgMQ7kNvwFSvDz4&_nc_oc=AdpRN36MfHCYB7ZOss-rt1d97dZVJJkxo4WMYsmSZaNzdFZ4CnrYhwVCN40F5cK9aK4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4UyYy0_wrwiZBmJKhJpvo6S81PFOZpzWTcw88eMMbPA&oe=6A8EBEE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillos", "keywords": [], "long_description": "Unleash your inner primate in Gorillos \u2014 a fast-paced multiplayer VR experience built for thrill-seekers and competitive climbers!\nSwing, climb, and parkour through vibrant maps using only your arms and momentum. Compete in various game modes like Tag, Infection, and Custom Challenges with players around the world. With responsive locomotion, social hangouts, and constant updates, Gorillos brings freedom of movement and community-driven gameplay to life in virtual reality. Whether you're chasing or being chased, every round is a wild ride.\n\nNo buttons. No joysticks. Just you, your reflexes, and your gorilla arms.\n\n", "short_description": "\"Gorillos is a fast-paced multiplayer VR game where players swing, climb, and tag each other in immersive jungle environments. Master your movement, compete in exciting game modes, and experience the thrill of primal VR parkour!\"\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/36f333cc-b191-4b46-9e0c-ca581d4f47d1", "developer_terms_of_service_url": null, "publisher_name": "Savior", "support_website_url": null, "website_url": "https://sites.google.com/view/web-for-gorillos", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332
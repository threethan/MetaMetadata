uluscdn.com/v/t64.5771-25/491822410_1364474394662270_1841504602384990568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dVi3V6et9YQ7kNvwGIiob3&_nc_oc=AdofKlbcW_uKhoYRzOXPx9X6b51-3tKB50QclwnH2_PQBQb68elaoFk2NwzqHq1ZMng&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_gMJrXjz51J9my9hlgSkpVRm4Q9rHITq1g0UJAxPt_Q&oe=6AFB479E"}, {"file_name": "Gorillo_Custom..._22.06.2025_13-07-54.png", "id": "720932720875836", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617850_720932724209169_3199899396323910691_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve3C0ksqYbYQ7kNvwGF-eCV&_nc_oc=Adrd9cz-e2zoeMP8wu08R4t9IIPD1u_b74fhm1Ib6nsBsqjSgzsrDnHyEFskuy9N4ko&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrWaCE2hAB668kkT6r6HVSd8Fi-vZk2Kj25ENPVlQ2Ww&oe=6AFB4A67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillos", "keywords": [], "long_description": "Unleash your inner primate in Gorillos \u2014 a fast-paced multiplayer VR experience built for thrill-seekers and competitive climbers!\nSwing, climb, and parkour through vibrant maps using only your arms and momentum. Compete in various game modes like Tag, Infection, and Custom Challenges with players around the world. With responsive locomotion, social hangouts, and constant updates, Gorillos brings freedom of movement and community-driven gameplay to life in virtual reality. Whether you're chasing or being chased, every round is a wild ride.\n\nNo buttons. No joysticks. Just you, your reflexes, and your gorilla arms.\n\n", "short_description": "\"Gorillos is a fast-paced multiplayer VR game where players swing, climb, and tag each other in immersive jungle environments. Master your movement, compete in exciting game modes, and experience the thrill of primal VR parkour!\"\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/36f333cc-b191-4b46-
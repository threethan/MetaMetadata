uluscdn.com/v/t64.5771-25/491822410_1364474394662270_1841504602384990568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcxkO5RpVAoQ7kNvwEsbAPk&_nc_oc=AdolP7dl5I6Enf97JEHMoFQ8dhlO_kFZ6kARaX8amOoAzqtaIrD2N-fymXfdyp08NIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXqwzFthSHB69KM2p-sz1h1R9VE2NzpiR26bPnkD35gg&oe=6B105F9E"}, {"file_name": "Gorillo_Custom..._22.06.2025_13-07-54.png", "id": "720932720875836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_720932724209169_3199899396323910691_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lYP7BefxhgQ7kNvwEzEAa9&_nc_oc=AdqI3QzLkZqjWyKlh-YhFBgjqMqp8twsAbD3VGEO4j8uQWeVpXS2rD1FF5ZoVh5HfT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-R0awVkUUIt-d12vex91PW7cy8jGiEcjAtzQjL95dVg&oe=6B106267"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillos", "keywords": [], "long_description": "Unleash your inner primate in Gorillos \u2014 a fast-paced multiplayer VR experience built for thrill-seekers and competitive climbers!\nSwing, climb, and parkour through vibrant maps using only your arms and momentum. Compete in various game modes like Tag, Infection, and Custom Challenges with players around the world. With responsive locomotion, social hangouts, and constant updates, Gorillos brings freedom of movement and community-driven gameplay to life in virtual reality. Whether you're chasing or being chased, every round is a wild ride.\n\nNo buttons. No joysticks. Just you, your reflexes, and your gorilla arms.\n\n", "short_description": "\"Gorillos is a fast-paced multiplayer VR game where players swing, climb, and tag each other in immersive jungle environments. Master your movement, compete in exciting game modes, and experience the thrill of primal VR parkour!\"\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/36f333cc-b191-4b46-
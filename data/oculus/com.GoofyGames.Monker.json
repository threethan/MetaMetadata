IQ7kNvwGcEPMQ&_nc_oc=AdrFdpDcZUmLR4-XpwJg6oH_BBBOfem2dDbjYyTF6sr73-bnxEL-GUHVjDOR4Dhvr9E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGY4owsR2jZ9xtL9yov1yPo3_K1HmBnubUyZSmCELmTQ&oe=6B0B4770"}, {"file_name": "Screenshot 2025-07-29 152130.png", "id": "1454287802271566", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618367_1454287805604899_8303128808485379791_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYW4VIlRH38Q7kNvwG3f4bs&_nc_oc=AdqpmmaLmN7-F6qbgDVV37UWBYQGlFhUYXAp0gVI23_kMF_6I9Dje6mEdEwi616_cPA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvQzTCsuD0GNIBByOJgVdkWaKpeWFfqfUxz0_9Pq1wEA&oe=6B0B1318"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hollow Apes", "keywords": [], "long_description": "Dive into a terrifying VR horror adventure inspired by Gorilla Tag mechanics. You're trapped in a crumbling elevator that plunges deep into an eerie underground cave. Once the doors open, you're free to explore\u2014but not alone. Something monstrous lurks in the shadows. With no weapons and only your agility to rely on, climb, leap, and flee through the darkness in a tense game of survival. Will your reflexes be enough to escape the depths alive?\n\n", "short_description": "A fast-paced VR horror experience where you descend into a dark cave via elevator\u2014run, climb, and escape the lurking monster before it's too late.\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9644f1a5-8e19-4f66-ba44-c287cd59caa8", "developer_terms_of_service_url": "https://github.com/GoofyMonkeGT/Hollow-Apes", "publisher_name": "GoofyMonkeGT", "support_website_url": null, "website_url": "https://goofymonkegt.github.io/Hollow-Apes-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
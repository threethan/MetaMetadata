566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618367_1454287805604899_8303128808485379791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqvS6C6HWDgQ7kNvwF-rCHN&_nc_oc=AdrngrwsOCvFoCkJQIDL02jJh2WhMmEgxcKSB8CNWu4xZjPq3B3EX7x0MYrOk7phyJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21mQd6PmnxHhtWzVLqmd_QI58w3NUn5zgCbfaywhNwqw&oe=69EA2258"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hollow Apes", "keywords": [], "long_description": "Dive into a terrifying VR horror adventure inspired by Gorilla Tag mechanics. You're trapped in a crumbling elevator that plunges deep into an eerie underground cave. Once the doors open, you're free to explore\u2014but not alone. Something monstrous lurks in the shadows. With no weapons and only your agility to rely on, climb, leap, and flee through the darkness in a tense game of survival. Will your reflexes be enough to escape the depths alive?\n\n", "short_description": "A fast-paced VR horror experience where you descend into a dark cave via elevator\u2014run, climb, and escape the lurking monster before it's too late.\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9644f1a5-8e19-4f66-ba44-c287cd59caa8", "developer_terms_of_service_url": "https://github.com/GoofyMonkeGT/Hollow-Apes", "publisher_name": "GoofyMonkeGT", "support_website_url": null, "website_url": "https://goofymonkegt.github.io/Hollow-Apes-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
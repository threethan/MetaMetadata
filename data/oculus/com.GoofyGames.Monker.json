sid=6e7a0a&_nc_ohc=fKi0yi17ivQQ7kNvwHn3cxJ&_nc_oc=Adms1c3HxjMiKj0Tcliqklq5G1JcK8K6n4x8gEPYpEI0wsQzWDfd66OIMVhb6NpZ6F8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuh-ieURagiUYrzBNBEEvCxESftLbvFY4MwWd0yJ9weKw&oe=69A2F158"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hollow Apes", "keywords": [], "long_description": "Dive into a terrifying VR horror adventure inspired by Gorilla Tag mechanics. You're trapped in a crumbling elevator that plunges deep into an eerie underground cave. Once the doors open, you're free to explore\u2014but not alone. Something monstrous lurks in the shadows. With no weapons and only your agility to rely on, climb, leap, and flee through the darkness in a tense game of survival. Will your reflexes be enough to escape the depths alive?\n\n", "short_description": "A fast-paced VR horror experience where you descend into a dark cave via elevator\u2014run, climb, and escape the lurking monster before it's too late.\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9644f1a5-8e19-4f66-ba44-c287cd59caa8", "developer_terms_of_service_url": "https://github.com/GoofyMonkeGT/Hollow-Apes", "publisher_name": "GoofyMonkeGT", "support_website_url": null, "website_url": "https://goofymonkegt.github.io/Hollow-Apes-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_trac
cQ7kNvwGHn3Jb&_nc_oc=AdoBjbY83GE5MaQ7cIBaepy_no_G1nGulBp6baQshFcE0b28hiTcD9-KK_Pd9RjQR2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnXbDhgRpePqK4-CUgxYuoK7fCenQoc5UED1bqemL_Mg&oe=6AFC8EB0"}, {"file_name": "Screenshot 2025-07-29 152130.png", "id": "1454287802271566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618367_1454287805604899_8303128808485379791_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_i4IlH-HbcQ7kNvwGyv9-r&_nc_oc=AdoGQmKUU2SufMGwfkyib7hHCmSy4fu-3VXEE4knPRcmwqIgDozh-hUToi8mhCZc1co&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT68Izc6x6xLKHeiLOlgKw74EiQ1IrgwFTc6iGkBtu1mA&oe=6AFC9298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hollow Apes", "keywords": [], "long_description": "Dive into a terrifying VR horror adventure inspired by Gorilla Tag mechanics. You're trapped in a crumbling elevator that plunges deep into an eerie underground cave. Once the doors open, you're free to explore\u2014but not alone. Something monstrous lurks in the shadows. With no weapons and only your agility to rely on, climb, leap, and flee through the darkness in a tense game of survival. Will your reflexes be enough to escape the depths alive?\n\n", "short_description": "A fast-paced VR horror experience where you descend into a dark cave via elevator\u2014run, climb, and escape the lurking monster before it's too late.\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9644f1a5-8e19-4f66-ba44-c287cd59caa8", "developer_terms_of_service_url": "https://github.com/GoofyMonkeGT/Hollow-Apes", "publisher_name": "GoofyMonkeGT", "support_website_url": null, "website_url": "https://goofymonkegt.github.io/Hollow-Apes-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
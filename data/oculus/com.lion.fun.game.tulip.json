: "1986698011951876", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622919_1986698015285209_3508551902384181637_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GicE-3hAG8UQ7kNvwFaqBg1&_nc_oc=AdqWvZMQpzJ8HFxsuycJ9XPg0WAi5hSkCAB6dAPL2hV-Yx3J0rwkRPZnKa_3rh7FQx4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwRHqBlY1hs8KbPBntbjc9JPFprKUM7oeMAri9Eerx3Q&oe=6A92BD91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be A Lion - Animal Fun Game", "keywords": ["AnimalGame", "ZooGame", "FunGame", "LionGame", "Sandboox"], "long_description": "Step into the paws of a mighty lion in Be A Lion, a fun and immersive VR animal simulator inspired by chaotic and interactive pet-style gameplay!\n\nExplore exciting environments, interact with objects, complete fun activities, and unleash your wild instincts as you live life as a lion. Run, jump, roar, hunt, and create hilarious chaos while discovering a world filled with surprises and interactive gameplay.\n\nWhether you want to explore freely, play around with the environment, or simply enjoy being a powerful lion in virtual reality, Be A Loin - Animal Fun Game delivers a fun and entertaining VR adventure for players of all ages.\n\nFeatures:\n\n\ud83e\udd81 Become a Lion in VR\nExperience life as a wild lion in immersive virtual reality.\n\n\ud83c\udf0d Explore Interactive Environments\nRoam around detailed areas filled with objects and surprises.\n\n\ud83c\udfae Fun & Chaotic Gameplay\nCreate mischief, interact with the world, and enjoy playful animal action.\n\n\ud83c\udfc3 Run, Jump & Roar\nUse realistic movements and controls designed for VR gameplay.\n\n\ud83c\udf56 Animal Simulator Adventure\nComplete activities, explore freely, and enjoy endless fun.\n\n\ud83d\ude02 Funny & Relaxing Experience\nPerfect for casual VR players who enjoy lighthearted simulation games.\n\nIf you love animal simulator games, fun VR adventures, or interactive experiences similar to pet simulator-style games, then Be A Lion - Animal Fun Game is the perfect VR adventure for you.", "short_description": "Live the wild life of a lion in VR! Explore, hunt, play, and cause chaos in a fun animal adventure simulator."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27166424123011420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312454_970922265810291_1958996044027125404_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJfVtSPI-Y4Q7kNvwGV-0nb&_nc_oc=AdrZ2mg7VN_4XSRc5l6o8reOyXIuAkodG5keQ4A6cLtbCPUwvnENwO3klzaW5_naFWg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqV2w0zihxSRqd-Ly9kMo9Ul-PZWnTeeMibuXk3AstkQ&oe=6A92D1AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be A Lion - Animal Fun Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}]
ilFx8klhfS2iGWikPq7x63ARjAqGVWyPPAUyggo7_dcVDosL6qtNdQo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIiQj9-Gc2k56eMYqZJleWNsGR65LkoInLCsuw68EJ1w&oe=6B0C5CB7"}, {"file_name": "06_VR_Momiji_Watering_AutumnColors.png", "id": "1843987623549199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1843987626882532_2875947990602255934_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwrEVEnCTUUQ7kNvwGOMxAc&_nc_oc=Adqai5Ez-KhKNytLKIY4hTzoKHpyIJMNR7yLCrLg7w6stM8veW6URqIJK_BeoiBYod4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSd4xTyZ-R0W6P4RS7QepgqZTk0poUI8RvspB3MFHeJQA&oe=6B0C8251"}, {"file_name": "03_VR_Sakura_PruningShears_Caterpillar.png", "id": "1606217704144040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825546_1606217707477373_5264367367695526996_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0rtRmETkg0Q7kNvwE-HYfh&_nc_oc=AdrsB9VYLTdDh085Ya7ADhvpoh1z4vfa6jAQVZQEzAfWX8lsmvZ-hUeKVWFBI1s9Bco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvn99eskMeu8cN4uSS-LqGxpkNFfNXbkkAh7ZAUkI92A&oe=6B0C6ED7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Bonsai VR", "keywords": ["bonsai", "meditation", "handtracking", "zen", "mixedreality"], "long_description": "Welcome to Zen Bonsai VR, an authentic Mixed Reality sanctuary crafted for Meta Quest. Transform your room into a tranquil Japanese garden using color passthrough, physical table alignment (MRUK), and controller-free natural hand tracking.\n\nInteract directly with living bonsai specimens through centuries-old cultivation rituals:\n\n\ud83c\udf3f Traditional Japanese Tools:\n\u2022 Hasami (\u92cf): Traditional shears to prune withered shoots and balance canopy harmony.\n\u2022 Hishaku (\u67c4\u6753): Bamboo ladle for gentle water pouring and living moss hydration.\n\u2022 Harigane (\u91dd\u91d1): Copper wire spool to bend and sculpt branches freely in 3D space with hand pinch gestures.\n\u2022 Shuro H\u014dki (\u68d5\u6ada\u7b92): Natural palm broom to sweep organic pests off realistic bark.\n\n\ud83c\udfef Three Living 360\u00b0 Sanctuaries:\n\u2022 Mount Fuji Veranda: Sunlit engawa overlooking stone waterfalls, Torii gate, and free-roaming Koi.\n\u2022 Kyoto Mirror Lake: Five-story Pagoda, Moon Bridge, flowing waters, and swimming Koi.\n\u2022 Arashiyama Zen Temple: Raked sand Karesansui rock gardens and evening sunset breeze.\n\n\ud83c\udf8b Living Botanical Species:\nNurture Sakura Moyogi (Cherry Blossom), Matsu Kuromatsu (Black Pine), and Yama-Momiji (Red Maple) to reach 100% Harmony and Full Bloom.\n\n\u2b50 Master Rank & Lore:\nAdvance from Novice to Grand Master (Meijin) with persistent stats in your Keeper's Journal. Includes binaural spatial audio (Koto harp & chimes) and instant trilingual localization (EN / ES / JA).", "short_description": "Step into your personal Japanese sanctuary. Cultivate authentic living bonsai trees in your own room using controller-free natural hand tracking. Prune, water, sweep, and bend branches with traditional tools across living 360\u00b0 cultural environments with flowing waters, free-roaming Koi, and soothing binaural soundscapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Rodrynet82/ZenBonsai-Mixed-Reality-Oasis/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Rodrynet", "support_website_url": "https://github.com/Rodrynet82/ZenBonsai-Mixed-Reality-Oasis/issues", "website_url": "https://github.com/Rodrynet82/ZenBonsai-Mixed-Reality-Oasis", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
oc=AdoBEt_jAcG45r8uPgh7poRevS13lGzVgrXsHL7Ycby-6ZtOoNwZdYFEF9hkAuywrSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRl_mIL8D8hOV8EbPUZ_tMfvHl9ucqSfSGLkAOH0LpIRQ&oe=6B0C6E1E"}, {"file_name": "4_Arashiyama_Bamboo_Zen_Temple.png", "id": "1887274879363870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1887274882697203_1938508362664006770_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_njMKF-AH_8Q7kNvwHhYVoh&_nc_oc=Adp4cjZwbLTspfQDA4ANDmrqPJrEIqoM93gD_D9njuU1L8IYMMm3GAuH_GYHydFClcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsnLLiqDHoNfSjBcFj_27TCHK7KoviXKKJsLOvTLc4mw&oe=6B0C7AA7"}, {"file_name": "5_Zen_Caterpillar_Friend.png", "id": "1180760841178689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1180760844512022_474271014438727254_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXgz2AaEGz8Q7kNvwFe0Afz&_nc_oc=AdruVphsbrGd4ZQ2okrwv6MiKeSO_cYG54L5CC6ZiJZzDH9C2_JAVGeIVGM5X1vgI7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTx6IMXdsS-Pwq3L1MEX8IQPWTd8WPylGH47I1F76_QoA&oe=6B0C6DC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Bonsai VR", "keywords": ["bonsai", "meditation", "handtracking", "zen", "mixedreality"], "long_description": "Welcome to **Zen Bonsai VR**, an authentic Mixed Reality arboriculture and mindfulness sanctuary crafted for Meta Quest.\n\nTransform your physical living space into a tranquil Japanese garden. Using controller-free natural hand tracking, interact directly with living bonsai specimens through centuries-old rituals:\n\n\ud83c\udf3f **Traditional Gardening Tools**\n\u2022 **Hasami (\u92cf):** Forged steel shears for mindful shoot pruning.\n\u2022 **Hishaku (\u67c4\u6753):** Bamboo ladle for soothing water pouring and moss hydration.\n\u2022 **Shuro H\u014dki (\u68d5\u6ada\u7b92):** Natural palm broom to sweep away organic pests.\n\n\ud83c\udfef **Three Immersive 360\u00b0 Sanctuaries**\n\u2022 **Mount Fuji Veranda:** Sunlit engawa overlooking bamboo groves, koi pond, and drifting cherry petals.\n\u2022 **Kyoto Mirror Lake:** Five-story illuminated Pagoda, Torii gate, and Moon Bridge.\n\u2022 **Arashiyama Zen Temple:** Raked sand Karesansui rock gardens and evening sunset breeze.\n\n\ud83c\udf8b **Three Authentic Botanical Species**\nNurture the **Sakura Moyogi** (Cherry Blossom), **Matsu Kuromatsu** (Black Pine), and **Yama-Momiji** (Red Maple) to reach 100% Harmony and Full Bloom.\n\nFeatures tactile parchment lore scrolls, binaural spatial audio (Koto harp & F\u016brin chimes), and instant trilingual localization (EN / ES / JA).\n{1116572750758413}", "short_description": "Step into your personal Japanese sanctuary. Cultivate authentic living bonsai trees in your own room using controller-free natural hand tracking, traditional tools, and breathtaking 360\u00b0 cultural environments with soothing binaural soundscapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Rodrynet82/ZenBonsai-Mixed-Reality-Oasis/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Rodrynet", "support_website_url": "https://github.com/Rodrynet82/ZenBonsai-Mixed-Reality-Oasis/issues", "website_url": "https://github.com/Rodrynet82/ZenBonsai-Mixed-Reality-Oasis", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "
0drT6F2fLYoO5-yusUg&oe=6A564151"}, {"file_name": "migrated_image.png", "id": "210477983535995", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162711_625590874306485_3189814658177433600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9ZUU51MKIoQ7kNvwFcAo_M&_nc_oc=Adohjp4aTyasiWJqxRieu6xZmbxibIfNSLzOXX8MBd-ZT9Wc2tNHFID2L5aEFVAvVhs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl2JE3wipKOsj_jc7pmyhWnelYU4S_YAlAGapKN4c4gA&oe=6A56309F"}, {"file_name": "migrated_image.png", "id": "197089915047001", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162699_239821599833846_1986970841723699200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkYONXw6hfUQ7kNvwHphoBA&_nc_oc=Adp12KLJ4GQTRd0HB3WxGWVlBDlXAdLRPkmlrdgJXbCouawQqwFP5FHPIJELeHfhn2g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMlb8CIdGX8kRRPxrd8tKis7nBBs9pmHCvSoaVmzz0DQ&oe=6A562BDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easter Rising: Voice of a Rebel", "keywords": [], "long_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising.\n \nEach scene in this 13 minute story has a fixed point of view, the viewer can look around a full 360-degree environment and see the action while listening to recollections of the events in various locations.\n \nEaster Rising: Voice of a Rebel was created by BBC iWonder, Crossover Labs and VRTOV. The story revolves around a tape recording of Willie McNeive from the1970s. In these recordings, Willie talks about his involvement in the Easter Rising 60 years before.\n \nWhen you're playing The Easter Rising: Voice of a Rebel VR experience, please be sure to follow any safety info from the manufacturer and/or supplier of the device you're using.", "short_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bbc.co.uk/privacy", "developer_terms_of_service_url": "http://www.bbc.co.uk/usingthebbc/terms-of-use", "publisher_name": "BBC Media Applications Technologies Ltd", "support_website_url": null, "website_url": "http://www.bbc.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "en_CA", "en_ZA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "358987965732378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162699_667151173475582_6877448766496964608_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HTT4aIN-tMQ7kNvwEgdfOc&_nc_oc=AdrSq_e0c5ZsGHdRWVdMlAk6cC4npMSl16X-fXLqm_UAAL8UyvHZpL0a-Sch-P9Xh1Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqs7JB0yNP0-h9hLOz3wUWDZif1uZyvoQ-ts47PbHnJA&oe=6A564326"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Easter Rising: Voice of a Rebel", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1499291378, "lastRevision": {"nodes": [{"id": "223983778044906", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "10
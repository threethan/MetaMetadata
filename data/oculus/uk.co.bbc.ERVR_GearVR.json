_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVWw2uKWSv8Q7kNvwFw1qE_&_nc_oc=Adoj3jE6HFwLwuTDpw54gZM-_DBsZrX7yZvfzhTFRkg05TN5e2iXFcL0DqKf-aHgy24&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbv_E5X5DXr1NS_RaaG-KsSsCFc7qqa7PrpPWpkdyLhA&oe=6B087411"}, {"file_name": "migrated_image.png", "id": "210477983535995", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162711_625590874306485_3189814658177433600_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcidGTUVAj4Q7kNvwGPoe7l&_nc_oc=AdrT6gaQGA3vIWBfYp--GjPZ4DJ5lCXfx2ahOyHpyM78FrNz3tdQQxgY3eNuj91GGRU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9QdiyVmwblOvQ28gkcwHf_MebnlhCYdz4cW7h-nI6xg&oe=6B08635F"}, {"file_name": "migrated_image.png", "id": "197089915047001", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162699_239821599833846_1986970841723699200_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0xOchdVe7UQ7kNvwFSZCr6&_nc_oc=AdrcNm3cTeU-ZV_jnGAtDtHKQBZVpjMwI0pjpq-o-GshftvssHb0V2S044wdrVS4bJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRij5S8XG-H5XIUzuEYlbzua3aD6Uuv3AuSd6uMp9XmA&oe=6B085E9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easter Rising: Voice of a Rebel", "keywords": [], "long_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising.\n \nEach scene in this 13 minute story has a fixed point of view, the viewer can look around a full 360-degree environment and see the action while listening to recollections of the events in various locations.\n \nEaster Rising: Voice of a Rebel was created by BBC iWonder, Crossover Labs and VRTOV. The story revolves around a tape recording of Willie McNeive from the1970s. In these recordings, Willie talks about his involvement in the Easter Rising 60 years before.\n \nWhen you're playing The Easter Rising: Voice of a Rebel VR experience, please be sure to follow any safety info from the manufacturer and/or supplier of the device you're using.", "short_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bbc.co.uk/privacy", "developer_terms_of_service_url": "http://www.bbc.co.uk/usingthebbc/terms-of-use", "publisher_name": "BBC Media Applications Technologies Ltd", "support_website_url": null, "website_url": "http://www.bbc.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "en_CA", "en_ZA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "358987965732378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162699_667151173475582_6877448766496964608_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mpf9uVYt0QQ7kNvwFq63uD&_nc_oc=AdqCxqVQhOKsUuTvrvVITxwF8RJwX60womQPu6bFH3h1ANrKFOoGJE95D1hvUZDMd7Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC5t1mXL6eDi_1nasKfFAJi1doNkUwsJk00CnBt7f80g&oe=6B083DA6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
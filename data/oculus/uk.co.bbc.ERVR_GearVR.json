95", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162711_625590874306485_3189814658177433600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-LRIdRV1E0Q7kNvwEhbkUk&_nc_oc=Adoo4ck5m3lt1XZgB7vDozEU8NNOaiZZhugYOLZ_mIcWbcyOXbj9r9kGWLoNtPp2UBw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af21Qkupc0_8Kzdlc1IAScKXIeYRLv1YJMm9O_CLCtddgw&oe=69F1FE9F"}, {"file_name": "migrated_image.png", "id": "197089915047001", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162699_239821599833846_1986970841723699200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2UOlD9kgT4Q7kNvwFU6exI&_nc_oc=Adpo_R8trhdnOVsAapqu2Bs4yevzHzUZkdZxYdb_vGWFrkilbYE8bea1Zu-A936J2o8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2AbDQfZ0eqYUHhUzR26E-YycWvSXzLz3RNHlJIsAX4dg&oe=69F1F9DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easter Rising: Voice of a Rebel", "keywords": [], "long_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising.\n \nEach scene in this 13 minute story has a fixed point of view, the viewer can look around a full 360-degree environment and see the action while listening to recollections of the events in various locations.\n \nEaster Rising: Voice of a Rebel was created by BBC iWonder, Crossover Labs and VRTOV. The story revolves around a tape recording of Willie McNeive from the1970s. In these recordings, Willie talks about his involvement in the Easter Rising 60 years before.\n \nWhen you're playing The Easter Rising: Voice of a Rebel VR experience, please be sure to follow any safety info from the manufacturer and/or supplier of the device you're using.", "short_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bbc.co.uk/privacy", "developer_terms_of_service_url": "http://www.bbc.co.uk/usingthebbc/terms-of-use", "publisher_name": "BBC Media Applications Technologies Ltd", "support_website_url": null, "website_url": "http://www.bbc.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "en_CA", "en_ZA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "358987965732378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162699_667151173475582_6877448766496964608_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NI4MOI1Q9kQ7kNvwGEeeM7&_nc_oc=Adq-QMKPp79ZvvKUL_e-LA-JfndWc6uN1bimsv5SSsLR1aIGUPkl4Q5IwXbJ8r47PKg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0GloxQTMX2ZvHd0HTrQx-uUHXygKmGKaYq4noipMx9Ng&oe=69F21126"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Easter Rising: Voice of a Rebel", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1499291378, "lastRevision": {"nodes": [{"id": "223983778044906", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1045447662230249", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {
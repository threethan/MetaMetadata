3kC7g7Ghl73kt-UEm4A&oe=6A26CB51"}, {"file_name": "migrated_image.png", "id": "210477983535995", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162711_625590874306485_3189814658177433600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdglbcUwMIgQ7kNvwFj0-Zu&_nc_oc=AdpD3Wd0XhbCo036xfL38vCAJOk0zmVBqcMc3e5Anr6HN_ZhtLM8PIReETXhsJQrT4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PtupcXvRpEFXFkLOLCqlcFt9scOAt1cYHKrme2rfG4w&oe=6A26BA9F"}, {"file_name": "migrated_image.png", "id": "197089915047001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162699_239821599833846_1986970841723699200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqGLvS0yeg8Q7kNvwEwkU62&_nc_oc=Adqe_kKzUQvB-5qI5YpsNvGMNpTv8-aDzXMnqj7fIxnNWAYLhySKoU1AMK-HuJPZw3A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OKXAMJgbliGUZxPEd-RZOfcp64AS60OSJlJTbK2I2ZA&oe=6A26EE1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easter Rising: Voice of a Rebel", "keywords": [], "long_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising.\n \nEach scene in this 13 minute story has a fixed point of view, the viewer can look around a full 360-degree environment and see the action while listening to recollections of the events in various locations.\n \nEaster Rising: Voice of a Rebel was created by BBC iWonder, Crossover Labs and VRTOV. The story revolves around a tape recording of Willie McNeive from the1970s. In these recordings, Willie talks about his involvement in the Easter Rising 60 years before.\n \nWhen you're playing The Easter Rising: Voice of a Rebel VR experience, please be sure to follow any safety info from the manufacturer and/or supplier of the device you're using.", "short_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bbc.co.uk/privacy", "developer_terms_of_service_url": "http://www.bbc.co.uk/usingthebbc/terms-of-use", "publisher_name": "BBC Media Applications Technologies Ltd", "support_website_url": null, "website_url": "http://www.bbc.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "en_CA", "en_ZA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "358987965732378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162699_667151173475582_6877448766496964608_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0uDn-Z0pdsQ7kNvwFq9WSY&_nc_oc=AdqI2y3ropJM5fFmoyr7icg5iWWl61PYfIyhvsG2OeKGJEEYQ15Nbm4777YxKsjNxRY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xq9By2rEfmfunohnVYHkTNOz5l7848shY5MGLUMECDQ&oe=6A26CD26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Easter Rising: Voice of a Rebel", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1499291378, "lastRevision": {"nodes": [{"id": "223983778044906", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "10
_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVWw2uKWSv8Q7kNvwGISnhx&_nc_oc=AdoRjT6f9fOBdw5V5g67FsK8MdrWukOM8WwR7h-UyJloD8Q-xxbH56nXv5-0E96bukU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHZlU6FiQHu0cLWkFZLiF2sVjbof4F-wMjW6ivEZS2Pg&oe=6B09C591"}, {"file_name": "migrated_image.png", "id": "210477983535995", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162711_625590874306485_3189814658177433600_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3-cD51L-RoQ7kNvwF8x8dJ&_nc_oc=AdpGVfo9jdYHrkPfWFzXPdck7INWTEpC8TbIT-WplfS0gXeR_0csGwCawmHf2utA9Zg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROfQhVnindd--b41Z2eWV4af1tZ0G36CvMBVRKNXdy8w&oe=6B09B4DF"}, {"file_name": "migrated_image.png", "id": "197089915047001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162699_239821599833846_1986970841723699200_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVmNZ3K52HAQ7kNvwHQ6l12&_nc_oc=Ado5wcGzhH-ITvfM0ySC_xKoAharmfeXAsWXJgxD-ZIuceY44Jbjhe0TAD-IGJXIzyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI621o9kciYb-Z2NRPbPfAj6GOdPJQIM2gOTYr8f489g&oe=6B09B01B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easter Rising: Voice of a Rebel", "keywords": [], "long_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising.\n \nEach scene in this 13 minute story has a fixed point of view, the viewer can look around a full 360-degree environment and see the action while listening to recollections of the events in various locations.\n \nEaster Rising: Voice of a Rebel was created by BBC iWonder, Crossover Labs and VRTOV. The story revolves around a tape recording of Willie McNeive from the1970s. In these recordings, Willie talks about his involvement in the Easter Rising 60 years before.\n \nWhen you're playing The Easter Rising: Voice of a Rebel VR experience, please be sure to follow any safety info from the manufacturer and/or supplier of the device you're using.", "short_description": "A new historical VR experience that\u2019s part documentary, part virtual theatre. Step into one man\u2019s memories and journey back to a moment that changed Irish History forever: the 1916 Easter Rising."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bbc.co.uk/privacy", "developer_terms_of_service_url": "http://www.bbc.co.uk/usingthebbc/terms-of-use", "publisher_name": "BBC Media Applications Technologies Ltd", "support_website_url": null, "website_url": "http://www.bbc.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "en_CA", "en_ZA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "358987965732378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162699_667151173475582_6877448766496964608_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6WQMyAJPcAQ7kNvwGSFrzl&_nc_oc=AdqXBI_yP7WhPi2bAtGqHai3Fwf1t4dslohKbG4adtmNM7OydwCnwR0VBoR_peas8EE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC8Dl0mDk1_5dxqEKBSqyR1rKW572X8PwdAGvMo6QdVg&oe=6B09C766"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
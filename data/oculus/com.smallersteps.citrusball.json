.com/v/t64.5771-25/75608435_365527989595014_5774173203706167909_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Yu-WKT3Iq0Q7kNvwEgGKUh&_nc_oc=AdrpiDVHUwjVE7Xrs-hIPxtB3w0QG8FgaGM920GsC57vY9qs2z5Fmlt1A80qP4jOJSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw0I8AuiFXeMt_DoXnq0eFybObpHz9ZY7T0ZAxdbBfxA&oe=6B05A996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1763608794160777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982639_1763608797494110_9146144758691653845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iZidOPvim4Q7kNvwF_t8N6&_nc_oc=AdpK5fvBTqt0sUOGzmmDZYYS1rJx0cf-wvwMeiXo_d2IZilHjBYfZE8uYaKSbTmlwig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTawEh71vviy7FByGFEXuBUobK1a78IwXZgaQiuidjHvg&oe=6B05A93A"}, "display_name": "CitrusBall", "keywords": [], "long_description": "From one backyard court to world-wide phenomenon, CitrusBall is the new sport everyone's talking about. Now the game\u2019s greatest are joining an exclusive tournament on a billionaire\u2019s mysterious private island. Who will be crowned as champion?\n\nIn CitrusBall, you select a powerful character with unique abilities to face off in a designed-for-VR sport inspired by tennis and pickleball.\n\nEarly access features:\n3 playable characters, each with a unique talent, special move, and \"game changer\"\n2 island locations to play single matches against a computer-controlled opponent\nTutorial covering basic gameplay and ability usage\n\nFuture roadmap:\n3 additional playable characters\nStory mode with new locations culminating in a boss battle\nMultiplayer", "short_description": "From one backyard court to world-wide phenomenon, CitrusBall is the new sport everyone's talking about. Now the game\u2019s greatest are joining an exclusive tournament on a billionaire\u2019s mysterious private island. Who will be crowned as champion?\n\nIn
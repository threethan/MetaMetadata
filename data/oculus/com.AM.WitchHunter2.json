3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81HE9p3cwO-TYL2EfZKbgUsvx9CJb-ccH1n3TWZ58dlw&oe=6A32A6FA"}, {"file_name": "meta 6.png", "id": "401303039707880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391807_401303043041213_1140784540489669390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9oRaXWVpEoQ7kNvwE1VY7x&_nc_oc=AdoDiOSYbCo5_N3DY3nSlNor_y86EvF2BA2TZUSCPx6etOfe_U1MPy9TENNrCV8b7Kk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8--423ltTCr3g_7rkv3Ss7U5f_3pLOqRMQ5Lb71qycuQ&oe=6A329B7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Witch Hunter 2. Legacy of the Lost", "keywords": [], "long_description": "Immerse yourself in an exciting combat simulator where every battle is a test of agility, strategy and adaptability. Armed with a diverse arsenal of swords, axes and firearms, you will face a variety of enemies \u2014 from ferocious monsters to formidable female knights. Each encounter is unpredictable, with opponents appearing randomly to keep you on your toes.\n\nMaster different weapons, adapt to the ever-changing combat scenarios and unleash your combat potential. Regardless of whether you prefer close combat with sharp blades or long-range marksmanship, this game will give endless pleasure to every warrior deep down.\n\nAre you ready to plunge into the chaos and prove that you are a true champion?", "short_description": "Test your strength in a dynamic battle simulator! Use swords, axes and firearms to defeat the monsters.,"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/3d2916e9-0cfa-455f-ac22-48654b190807", "developer_terms_of_service_url": null, "publisher_name": "Andris Mikijanskis", "support_website_url": null, "website_url": "https://bloodhunterage.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
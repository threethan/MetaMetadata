uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvA8VhzVxlIQ7kNvwFy6k97&_nc_oc=AdrfZcAgvLwC8GxLPEiWLophtBV2KvbfsHaA3slHaSilQTBE93pF6v86N8XvI-dmTX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FcTtwxgx8NGhTyhyhuN98cfKLb6M8v6uiymz9oLOfYg&oe=69FB2B2F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMshbw1j9XcQ7kNvwFhRlog&_nc_oc=AdqObSYzrpqx5g9QsTVc1I81y1yPSjJVYoeOdex85s4OWqgLaYJkiqaQ1_rKUZXZedQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ydDUzRP-MTNYFW2iis5wmnqr72KSyPtVivX5e3xz6A&oe=69FB48EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCyLiJaDMB4Q7kNvwFxHC9C&_nc_oc=AdqiBfhENz8ymM67fve8I_4UrwvSeRZgL-XXUgHjheA4ADC1uCXPrfP5Yt4iIJnh9uI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rXhSZIjqxEv--PRuQAhIY_PvhZ0Xy14X_HGSrJ4LuSQ&oe=69FB4B98"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
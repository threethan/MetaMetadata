7&_nc_sid=6e7a0a&_nc_ohc=uNNndihR8RkQ7kNvwHW2HJF&_nc_oc=AdlEQ4zNMGSF0OVdpmEMtGE5gnzE8y1OwCqJeB2GhYmDubtoMmWVHEAHFGJ9zSNzTqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftqf7hibAHXmREFVPpV178OPCnsL2D5HxI3krsMBCHfYg&oe=69A81CAF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBX43J_ptAMQ7kNvwHiUadJ&_nc_oc=Admy4786IiH793HBggc1wSkrah3cYC8evvlyJye0k9h-_l6gP3H90gRf8Tr1dZvEWmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu6c11OHqHJzCIvL8e_S-dIiJGgMSKKRQ5NBaiwxxGt4w&oe=69A83A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8O0og6ngzQ0Q7kNvwFwXjgq&_nc_oc=AdnmL0udBnjOTFOwqkaEITNT0-RwJBdIk3msFJfvTlza53SHBvcx3lmaTQzlBAjqy8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftj6edEZgheKYlHpHmeUvWgIBacbPLiNIN2m2ax76xD3Q&oe=69A83D18"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way t
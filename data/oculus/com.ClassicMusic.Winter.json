7&_nc_sid=6e7a0a&_nc_ohc=KVOcW9wiTzoQ7kNvwFrkEmN&_nc_oc=Adkw0uBy7qFtO-XVG6U0eyyOGIbZRa82MWBNCNP6ztRnELUI6fh8H61i5jACJ7lbIKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaDrQyYRWvsIqHssBFOmu3J6aB2fZegblX3sFoFhE7_w&oe=69AD62AF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po5GycoBKGUQ7kNvwG1832r&_nc_oc=Adm9vDQsz67qfdLXbpaavMYrqRdeFiH8R_nN-tFo1lKfzABISpmeV9giVbYrpzXJY6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRqA1G-XEG0-exnB-O6obGgz-BjslcMTKAndm9vvk1rw&oe=69AD806A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxEDJgbw82MQ7kNvwFfuXGb&_nc_oc=AdmUNb61W3zsuMkk5QlSYOUIjsxpjSl8Y3HYkCimP0TaevnWII1KvHEVfTS2T2cVrPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3CSbCbQ_CDO85Kgdd-ZTblqMf3K5KLL4wKZOMjzGrKQ&oe=69AD8318"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name": "VR-Learning srls", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "Unreal Engigne 4.26", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25737615962520113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1519904951951754"}, {"status": "PUBLISHED", "id": "894123506082613"}]}, "baseline_offer": {"id": "1519904951951754"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723627591, "status": "PUBLISHED", "id": "1519904951951754"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25839968522284856", "version": "1.0"}, "id": "422159270730436", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25561858356762542", "is_concept": false, "latest_
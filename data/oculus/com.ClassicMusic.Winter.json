PLcCTg&oe=69A579AF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1OSVIyVrCUQ7kNvwFkV3_d&_nc_oc=Adlb4ixQbuDm05lYcMGwXYyQ06gY9bXdbifvSZYsJKkkmcHeT8Zp6Mw4psxkz8Ssg2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuPWRT-JupBfIQDIG8mb--ERnBY_4lNvq6TbjHdAgfBkg&oe=69A5976A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8O0og6ngzQ0Q7kNvwGVWjvq&_nc_oc=Adlkhh5Z97SSQ0iUaE72sMh3Cbw3wD9wY3KAKRpkQEw1q7yPVzu4boL4nYAz__etyOM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftRvApBXW7ixIv-ExZkLMUEm4Wy_VaFMPC8I-x3ZbnslA&oe=69A59A18"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name
uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYXLY1-l1qgQ7kNvwH3g_kG&_nc_oc=Adp5ApJO1PbLYxZAz6IWhQGct-STGGeLaE9fBjyyEtueWiiJwY7opnfieXHUw2OiZXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eQc3a81XuNFDwpamFmnb7OPG5IIOnNqTyuEMipMJKSw&oe=69EB592F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iry0Hhc3b5UQ7kNvwHxF-Gv&_nc_oc=Adozk34Dx5vjl9t2cGHBZmeqfZBlWCfa-lKDKJ5iDH699jJsh4rzNxJinkCfKCBTjS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mmg0gchYORjDbACqxZXj8luuvLwZDpwXb11aDE6D4MA&oe=69EB76EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwvADKj801oQ7kNvwHmStkY&_nc_oc=Adra6nakf0rQ2oa6i3fbLVd7hgO1rwgKXHINc3pln_DG5t0e1ME1r62aY7au4uEyFKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-uVzWNcHmcWcc_ugnJJNAxqfqcLjHPrdDowO6momJBg&oe=69EB7998"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
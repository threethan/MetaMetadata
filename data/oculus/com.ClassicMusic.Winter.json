9qp6bw&oe=69A1852F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzGNY-fvFocQ7kNvwHkvm4H&_nc_oc=AdlQEF71S-e5OAoLkdSRacL_Rm_vrtbb4uqiWJGTIPp7Aoreyqo7LxMPKi8mGaPs-gg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuOxTeh7t1a10UII8IL2bAgagqq2cPinZ38wVO3xZHA3g&oe=69A1A2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2NfG2aS-DcQ7kNvwHIofVx&_nc_oc=Admyh5x-uDbVlrNNO_HoMCGG3YLvhMc2uCkcbTx4UsMzPLISOoUxcUx_gTfILTaFN6g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftZF6fIciisy4mZUdiA7HWctjrrwGiQjDpMP0c5SUeo_A&oe=69A1A598"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name
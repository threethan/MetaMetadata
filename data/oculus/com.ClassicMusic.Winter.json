dn.com&_nc_ss=7f20f&oh=00_AQK-goF-_DKW0JYJB7eM_LHTd5L6J_VIOQVKE9tcZjC5Jg&oe=6AA95D84"}, {"file_name": "2.png", "id": "1408292569877943", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036669_1408292573211276_3255839898720405594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO6M5tAAWYsQ7kNvwFlWRBI&_nc_oc=AdoyG6aDiG4GRSkfdHSLl8pmC0v3y-BQnxFCrdIL77v76vgcp7tvDT3k80Go_ubqlNM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyfBrxvnVaq5vT6M2iaQg7GotT6w78JWXq-f0exBjZEg&oe=6AA966A7"}, {"file_name": "3.png", "id": "1149556342979727", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1VN88glq28Q7kNvwGJpraV&_nc_oc=Adox7Nm0nTz5nmgQ-F46dHdh2SL1b2Oy8yxm2VQEC43HGeWIijby1KPUvMM8ekDtBwo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJis3lz2DkkmIYXDVydg5rxXcY4btYbDo4YA8oMn-Su_Q&oe=6AA9696F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5delda5jkUQ7kNvwFv9-zE&_nc_oc=AdphmfrA9NFp-gKIIXL_ZbM3xaDLq1_Js0lYT45xhe3wkupYcYJ-JAFV7pd-jZ7nrDM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4jBSpmdHK6c1kBexDbOnAN4wraudS7MpBTArDvjcQDQ&oe=6AA94EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6F-QjdKWR4Q7kNvwHNDons&_nc_oc=AdqdzaoYx8fswsFCediiIg_M3jtjk1HHpu54ChcCzbqBh8tURqrKFF7CaWXilov3KI4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL08Da4DwVx6HRVK-IiBF1rTeQ9hdNhcXK1u9qwDZEDGQ&oe=6AA95198"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name": "VR-Learning srls", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "Unreal Engigne 4.26", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28738968275718185"}, "review_messages": []}]}, "cover_square_image": {"ur
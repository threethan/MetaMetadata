04519633154263_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYXCbbD6sn8Q7kNvwFuHyIN&_nc_oc=AdorIxcOgUtb-lIlEMbgZrJLilXbH3ioElio8ybtmW4GQXUgekwZSecH-H-XCIGH5XY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmnV7dNdybpHldj6D_T2ywhGERJfUbF4uW-kKgZj9unw&oe=6B0DC7C4"}, {"file_name": "2.png", "id": "1408292569877943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036669_1408292573211276_3255839898720405594_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-iWW3r-Z00Q7kNvwHOlPbL&_nc_oc=AdoG4WP8EUFQxsXKMmRLWbzeyYcDkU4jxURbZD2NgYBwyoxFvWSqhcXm6voSYAijAJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3LdZgGqxV5lLXCNwfNvp3B6lQa3auTCz_v5YFeUnjYQ&oe=6B0DD0E7"}, {"file_name": "3.png", "id": "1149556342979727", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O6et79mgHkQ7kNvwETxeMh&_nc_oc=Adqxv9oeTBu3xCPfbvPNkpGw7UQKHy_8zQ_RfsYGkt4SJdHNu4ZFdlhb0-Q3iueHcOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtEv0CfZwp7qEpXd81yq0OGzlJqXawcE127CyoL_GE1A&oe=6B0D9B6F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIvb5vbTJ1MQ7kNvwHsWG5F&_nc_oc=AdqTdjtRPpSf0Er4yfSz2tSv4gWj_sEznvQ_ZaZ_cd2nhR7DKjkMA6qOkE6KIxRhBMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS19WgjEmRwjLtlhzM40oqb8CXUzo7jQTMaBhyayohqQ&oe=6B0DB92A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65WNyrF-Fj0Q7kNvwHuYM2D&_nc_oc=AdqQXHwGeJaSgRjIJERNoJyPR4l3DXKPJnuYVnh1jkcU3-49ihgLPQ21jLYP1aWmsXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjiXxmqvzbbEWkwrBxsYZ4aLszWWU-m4tDiC0417H3fg&oe=6B0DBBD8"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name": "VR-Learning srls", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "Unreal Engigne 4.26", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
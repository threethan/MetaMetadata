RUgNhg&oe=69A6CB2F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBX43J_ptAMQ7kNvwExKMzc&_nc_oc=AdlqpoVTtPGvT70OX97cg8CPkj9mHOGjIlNera2NPWxCvnfEABEYcsoNFELaxv71Tvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvaUTw7wQrXQxwfpydX4y2UNUShHNYTA1XQtjtNXgRMLg&oe=69A6E8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8O0og6ngzQ0Q7kNvwGXecb4&_nc_oc=Adl_yvF2ZQbY7g_cSWQ1b1AkoMcXBch2Eh7AD-loPvuA0rkvAWvn7xF5pQH8iB7okQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYB-tPfoJP3wXQ6ZT-OfmEF03ukykzJV_0RGIlEvkvVw&oe=69A6EB98"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name
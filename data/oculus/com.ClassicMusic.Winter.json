uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1VN88glq28Q7kNvwEPzhxI&_nc_oc=AdpiY8RSFeHIfL34YJtcZ016mfKlVGEbrPfhkH9mwQwIOUgc-trtX2gq407fwjCZuFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNzy-KMaijcSlqySCJbGI_0ZDhqo1OV-UkG2D34222Qg&oe=6AAC0C6F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITJ7fnRU3DEQ7kNvwFu24Fs&_nc_oc=AdpQoaMOUKY3F26XZH7scvJDYazNC2FoMq-OR1wzhjRpLA3UbhTTlxcNedzMABB1-0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFFe54daWP6GAHA63j-sckJ1BQRvOXzg1ZcsVO2q98Sw&oe=6AABF1EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVzS3cZCCuMQ7kNvwFmpyYa&_nc_oc=AdpBjrQTMvJ8KLdeiWfCxLSqLicYDu5AcrNiVGCkrYyub2p1IVH8B5hEr1NYWFf207o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjTi1w_tgOInhDrRcOlgLOAL8dhZ_yFToH53Yr0fJ83w&oe=6AABF498"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
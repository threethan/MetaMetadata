uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YloWh4OF1bMQ7kNvwF7MO8S&_nc_oc=AdqyC2qbQGu3HJdgdXNcHnSrgniqgmR-UXyzzJ_mvTkcjq_s5Evc9TzR5lofwSthCYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHwVqmDAFdSlwhiLeh2TkHQ7-mCwpwHTMFI8TKfh2YFA&oe=6AB000EF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVAvoBdQWjoQ7kNvwHsnQly&_nc_oc=AdqzrlfoZwVyrqkNUkU0ZE0sYsLcZ9Uadq26bgXH__QOezrbKcewll0njLwZITjHIhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJObcFpjLPj5r684KCXin7gl25Noi9Ax4B6Iwutc0A6Hg&oe=6AAFE66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG0zgGYTkaAQ7kNvwGPRoyZ&_nc_oc=AdqRaEM_A_p7watRcjfWVPrHTWyFz2SkqgztD1aADaLHZr9VE8CnP41h-bgkq0ZW_gQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ6RmIxfKkt-tCaOCJUAiXRNA-6G9LLONbmtauG7tIzg&oe=6AAFE918"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
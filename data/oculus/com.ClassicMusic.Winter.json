uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNL6uTRJVeMQ7kNvwFbsqcK&_nc_oc=AdqnxKP8FtNIiBuavuglkGCb_7-CQcbi5hG2z5Mo8MBiOPoxgwJ-fhUtFxbVsIMFyKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52F65r7lK1biC18ddztHQaa4dep-jPqSRlzIc6W5oiIA&oe=6A146FEF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n20Q7G_6AIQ7kNvwHUCAcF&_nc_oc=Adps8wyGn6JSeY_OT3V5rMQ6DjcjiiOZD0esqMG3KKOMXRYGOylX0bmpd9G64qR8R-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45kzpAJVqKEDpbdTK_chpOU6Z3LJ8QxPAj2QXlgVPxKw&oe=6A14556A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvew8sURc8sQ7kNvwHfR0-W&_nc_oc=AdqWwGGxTp9xbmfXV_qtdi2jxJtA93turi48L2JbOQDbrbREWmgeDmsJ3Jh8--jxl4c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49fJ30I1Ty4-BK-2TgqDM_VGg0qAs-8TU9AxNIkM9L5w&oe=6A145818"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
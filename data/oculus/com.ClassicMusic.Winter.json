92569877943", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39036669_1408292573211276_3255839898720405594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AramqQUgeBgQ7kNvwFfnyOC&_nc_oc=AdlqYNq8knRurkyFafdzxg4zxpiKp_qRk5IpcvGRaujyjJBWTeQY-xc1oXK6ZNK_-Iw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsZtz6bXkcrinACELLGv5dETathdAzwHx7rl66stIt8Uw&oe=69A18267"}, {"file_name": "3.png", "id": "1149556342979727", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Gp80p4ROkwQ7kNvwFK9w-e&_nc_oc=Adn7Hdik3dfV0ozWLuGnrsn090DcwIbF1vnr4zbj73YsusJL7msffNSAcr5OI2O26N0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsy1X2xX1tlfFmk13U42MN45sFQgPVhF3gSb0ky9qp6bw&oe=69A1852F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzGNY-fvFocQ7kNvwHkvm4H&_nc_oc=AdlQEF71S-e5OAoLkdSRacL_Rm_vrtbb4uqiWJGTIPp7Aoreyqo7LxMPKi8mGaPs-gg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuOxTeh7t1a10UII8IL2bAgagqq2cPinZ38wVO3xZHA3g&oe=69A1A2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2NfG2aS-DcQ7kNvwHIofVx&_nc_oc=Admyh5x-uDbVlrNNO_HoMCGG3YLvhMc2uCkcbTx4UsMzPLISOoUxcUx_gTfILTaFN6g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftZF6fIciisy4mZUdiA7HWctjrrwGiQjDpMP0c5SUeo_A&oe=69A1A598"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name": "VR-Learning srls", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "Unreal Engigne 4.26", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28738968275718185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75363517_1553838381831302_4259059289324575305_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1Zm
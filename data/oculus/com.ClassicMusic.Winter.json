7&_nc_sid=6e7a0a&_nc_ohc=QzDk3BooXGAQ7kNvwGAxZj3&_nc_oc=AdnheNumxX8Dy7FeVxVdmGLcIyveqf8S9fgSo-hx1T9gG18ZeG0z8DC86lOXq3lUoyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxqo9p4ABGZYaCOH3VkQKo5sAuGfeJpWrhT5wIvXCAeSQ&oe=69B2A8AF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4J-lIBrTrUQ7kNvwGMPxj3&_nc_oc=AdmuIpJYUcvpzgP_YfEmBJVTw052SBiTB-yko_IWotb_3JBYrBKgBG1Pe-X3hEn1ixk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwmj9M1uWGeJY0YBJR2IxdgkuFkyMuq9rsp4Hkj8bgruA&oe=69B2C66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mijf4SpzQE0Q7kNvwFJ6049&_nc_oc=AdnspZZj1rdyIqZbSsBQs_Y1wDwtCsJtreTxF9E-P8NnjMQWc7ebudl2vKk6QDIaOZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9wk9pGjldrNH7fqMUqge_fqGMvJ6g1uor_Zb3Guhrlg&oe=69B2C918"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way t
uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jzdvVeSXAoQ7kNvwGUrFZs&_nc_oc=AdoanKKnurMPXzIiEbciF5EH8lSdyFazlVWE1tJy8innL7MJa6q9YMgv-L0Lkd--MgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSdfC7jMJbY3f51i-8PlrxZVuPOBvKnKddi756KaVMDQ&oe=6AB7E9EF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkfyj5Xf4-IQ7kNvwE19hsS&_nc_oc=AdrSfBezSO5ihSDX8ml-PIoNTet0fVmElkGcO2AJ9SMVBMGa0GYDcz4doJShAz_k6Dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHsNM9VjuxaYiOHx0Mft8kWGCr2dVuGn3n2br2_9snSA&oe=6AB7CF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wJ4q9hVUpkQ7kNvwGo2h7g&_nc_oc=AdoKPQNwSJ7G_sRK-6HUzXlK4UmQ5WCLr0bXbmi33_9PJFd5stFONbB9KjGwt7UC4sc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-PtbBV0B6bpaY3CIuflScsv9cz11Ibrk6A5A3cEwq-g&oe=6AB7D218"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
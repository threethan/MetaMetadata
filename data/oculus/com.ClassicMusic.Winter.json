dn.com&_nc_ss=7f20f&oh=00_AQJ0eHggI30AhS5T2nEY0gOoXbRsUiV7a7cAwex_n0QAsA&oe=6AA41784"}, {"file_name": "2.png", "id": "1408292569877943", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036669_1408292573211276_3255839898720405594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSJzYnjPZsQQ7kNvwEjZy1T&_nc_oc=AdqK0pcp0nvw4KTqipcBnbKwKdX64DORKi2t1XZNVa4PLkMn0RpWEf1p3IEqA-55-0I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKomgWhC6MXLNlqnYFjtmHKfzmersmqxCRjhMHmbawLSw&oe=6AA420A7"}, {"file_name": "3.png", "id": "1149556342979727", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8XY7RQ2kIcQ7kNvwFzQ-36&_nc_oc=Adqk5R7pj0k4bXAjiP_j6zlrbLC7AajDVMkgYedluZccc4HGbeqoFpT7KIvxXu5GQUA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId3Bsdh-o1F5WwHvT84dfSjTS4HGwt_kDYo0pho-XfMQ&oe=6AA4236F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAntwxwZhBoQ7kNvwHnCDop&_nc_oc=AdrfzIvkwEs8uP_bdojVK5USAJJDfqnYIXr9UVHO-WAj8tMXxN1Ka3-Iih3uyQE34Fg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEemFXOE5XDB6pnVmEeh2Cq4qqRyyS1qVY5YcGGhK6tA&oe=6AA408EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YguJK2c2-BIQ7kNvwFuTZnd&_nc_oc=Ado0qbdFtcP413q5Z3NvlIuc053VjlmIupakULBr8bjSoBxsmytl4UqY6UncA0AKlf8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFLV82oauxgrwTqwubQ7LGyS0APoMVhkAWhpz6VHBB3g&oe=6AA40B98"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name": "VR-Learning srls", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "Unreal Engigne 4.26", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28738968275718185"}, "review_messages": []}]}, "cover_square_image": {"ur
uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=henAgAuibKMQ7kNvwGCHnSo&_nc_oc=AdqIO8NWOe_U1tb8hjOzL1dzVJDJXYnTJY7tpD7Wdzm4ckeINrAn0aH8Vo5QRMdfvTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtneXQC7AEUhOCNN-3dSHXTkWagH6wvJb9skxp719dTg&oe=6A492BEF"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAiPi0NirnUQ7kNvwE7Z11n&_nc_oc=AdoNh4zDmb7NdyOqNeKKE7w5r71yDLj5r66l14Hcz0HvHqKPG3IHrLalkHxSqu4XAkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8Rw8tXFuipUXqcwezyxHjx-6UpXcmutcXAQN15toYcw&oe=6A49116A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgOzTITdBLQQ7kNvwHF5Goa&_nc_oc=AdpdlTf8TGLzRDdpeUkyRqDmL7Aha7k3IUkiIkCkmS278dbfT8TIDsrTpTEHbCVkuaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClbu__72Ogiw5Phrf0yHgyUcrFKUpXwcQaTaKkavrG2w&oe=6A491418"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
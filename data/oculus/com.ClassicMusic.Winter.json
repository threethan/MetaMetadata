7&_nc_sid=6e7a0a&_nc_ohc=lcHOS8bMD7kQ7kNvwFclb7x&_nc_oc=AdmXnBLYzdmdlDJZwRiwkyzT-OT15N_HxFYf6DleJdDW4RjPEiqlnMPxtardUYMNgx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8QK9vGV3sbVpH4MRzJwCkhRvjCifX7jCQOzvYg4pYfA&oe=69B69D2F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMda3bjXGvgQ7kNvwH9OIZ3&_nc_oc=Adnq5A0pC5xH_meu4Jijtc79oA-v9sTXkCjlxrbTXX8WfR_MckH_37s7ry3VR_1U7iU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyosWK7HkL-My3wsnBVxVJlOU0cn6NZLTMJiQZ_0DRPfw&oe=69B6BAEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwdEkhmu81oQ7kNvwHY4aSf&_nc_oc=AdkZHLV-m0SNWs9Yw3_zrDpmjMQU2u2GOzjCU5hy3vPyRTSd16EFK-EIcxmcW1oVk1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzo8tenIu-Z5j4ZR_92s_7YfhwiQRmTd6LESJxASkFRgg&oe=69B6BD98"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way t
04519633154263_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg9bRpymqEYQ7kNvwH_4_60&_nc_oc=AdqtQ4v-crOPWMbmSYzg4ik1uCUeuGo5CrZwCNx0CFIL6dfCafJM5DpnJ8e2dQoGO8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6zD94RFpIQMvvxyJrHoWhHIzo23HtfkUEr43LwjUjJg&oe=6B106AC4"}, {"file_name": "2.png", "id": "1408292569877943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036669_1408292573211276_3255839898720405594_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1hUE0WAjRwQ7kNvwFOubZy&_nc_oc=Adq3WW9aFFlZqcbkQKYucemceiMVxP5OLgbnRusRW7csOjCJcfKOt-W4a_U3hIHcd1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWjR_0eGqF7yeYjCkLz1mTPANQOa63OrXTgoZBK_bMKg&oe=6B103BA7"}, {"file_name": "3.png", "id": "1149556342979727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNE6Ejk6PG4Q7kNvwEbMDqr&_nc_oc=AdrB9gZaUqIiG7vt_xtgXj88H4jJ_lh4QaQ5PPJMGMFQJVuAA3XZpCyb3lTvjaQsb0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSAOQGq6rC6Ye4Rr7JQafBMYKcXbNL9MstlpavBTPB4w&oe=6B103E6F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeALprE4_bsQ7kNvwEiJeIS&_nc_oc=AdpKDxEO7VZO9qGvZglpg05Df6eyWWJCT5TDPUHpDSZPhD57fDKky4sK1a0AkYLJnWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKoo1EuLZc-124KFN_iZ1YAWiZlRpa3Uhey8g7Rc4vPw&oe=6B105C2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knXoQ27kgf8Q7kNvwH5MNCN&_nc_oc=AdpO8Cw6s03GqxwdNzcVaUfE7mbZvKl1pp_d8F0R1tbKRSCmt4yNSrHyuStoihbbOU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPXHYN0jvp8rbTaOo6Bzx1KZ70PYpDKo_NdBnaqSdRjg&oe=6B105ED8"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name": "VR-Learning srls", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "Unreal Engigne 4.26", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
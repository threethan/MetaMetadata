xPRdAA&oe=69F09F2F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEXNafiB2EQQ7kNvwHNr3AL&_nc_oc=Adrpv9Y_VK6UQFnMkdA3HVMouCb1ceKOD0xt4Qff2hW7bjESyrNGFG9dXjEpKonDYDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3MgMiv4mmBd3Ij01NYULVBMnuO4iHLHBVDbjjXs3PUgA&oe=69F0BCEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYG_LVMQeEcQ7kNvwEFgNiz&_nc_oc=AdpPQSeyq0QA_-K2BXCxrzzhEUYCNnWN4uviL82KTz1p_TM4HYbzlQ7SbCIcyjm41oA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3i9G6cOkg4fzr5GgO4j2Ror8-UXWXD5ciWQ4c09Y0NRw&oe=69F0BF98"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name
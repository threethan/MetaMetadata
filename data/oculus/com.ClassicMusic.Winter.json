dn.com&_nc_ss=7f20f&oh=00_AQLNq0HgLkymSeO-0lUVOEdqqro0H1g4A7NJvfvdv-T0DQ&oe=6AAEA384"}, {"file_name": "2.png", "id": "1408292569877943", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036669_1408292573211276_3255839898720405594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eILHYLiUWogQ7kNvwFwF5js&_nc_oc=AdqjPHrjGO-a3WErfNV2c9il09YcIb6hVak13PpPPxTgeyL5T5aBaaAnf7H_Ciptyis&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu9CXN4bKmBVPaRoWUuo11Y2yuF77wRbBdCw5XsNHuZw&oe=6AAEACA7"}, {"file_name": "3.png", "id": "1149556342979727", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YloWh4OF1bMQ7kNvwH5KJM0&_nc_oc=AdplStK0_QQuB1P6Ra_Bt1_CL6kkOlKRQlo9shns6GzlsiL1chu5o6DFNSzg3jMBdCE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIzdkvFaEMXEfOEEToECaaNEEVIjzUiD2UdwlWBUSv6w&oe=6AAEAF6F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITJ7fnRU3DEQ7kNvwG30hym&_nc_oc=Adr5ja8Z30NuJoUHtpvy_KI2QNupHEtmf143NtgdMbiNydJXw_iHNqU1QKpEA3Ih2Dk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz_dYc_c72fMjOzsNKJYgehSlnDR0-v2EsQsQDSrZjAQ&oe=6AAE94EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG0zgGYTkaAQ7kNvwHAaPCV&_nc_oc=AdqjMi0-wRdU61jegDwo-94_6ehikT0o_mrea6r1OOOntx1ygv9D2JqBFdYuC-5Df6g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqInfHpZxTnvNExp1EePXhdiCfrt9qyyZoCY5rVJr1AA&oe=6AAE9798"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical music in VR and embark on an unforgettable musical journey!\n\n", "short_description": "There is a new way to listen, a new way to live Classical Music! Today, we will take a journey through his composition 'Winter,' in which Antonio Vivaldi managed to capture the essence of winter and turn it into an engaging musical experience"}]}, "developer_name": "VR-Learning srls", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "Unreal Engigne 4.26", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28738968275718185"}, "review_messages": []}]}, "cover_square_image": {"ur
uluscdn.com/v/t64.5771-25/39036613_1149556346313060_1538299774149696427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jzdvVeSXAoQ7kNvwEnLc23&_nc_oc=AdrW17lM39371oH57xWpMsZea03WnDEj7XpNKNWZSyWleW6L0AuZ6UWabJI75eEFU6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK80NB2M4z8i1CtIuJFS2A6-BL1QYOQiovrrkA_ZBTdNw&oe=6AB6986F"}, {"file_name": "5.png", "id": "1209840896675943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031326_1209840900009276_5266600235134752213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SuwlzMmS7wQ7kNvwEfBISG&_nc_oc=AdpXAZ-pUSKX5yyQRc86O45akiT_K0L3yVMluOevN1giUNo20tIaaThmJXxtOCAXgiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJUvkQNT28QLtl3jiSl8_f5vAvryLcGu0O1eDeinWxfw&oe=6AB67DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Winter2560x1440.png", "id": "983170023345228", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569445_983170026678561_1189495338873688012_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wJ4q9hVUpkQ7kNvwFi06bp&_nc_oc=Adri6jqQNuc0hY8x-J2vLqbnW_MB0Senfy3NcBXO_PiaTnneWJKra55U4kYH_yavFWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX7zmUWAXqan1fe5ld3pCPEMh8YowTPyFCehOlw6l1Ww&oe=6AB68098"}, "display_name": "Classic Music VR - Winter", "keywords": [], "long_description": "From a passion for classical music and the VR world comes 'Classic Music VR'. We transform music videos of the greatest composers into immersive and interactive experiences. Each song becomes a magical journey!\n\nFeatures: Experience Vivaldi's \"Winter\" like never before in a fully immersive VR environment.\nHigh-quality visuals and audio to enhance the classical music experience.\n\n\n\nRights and Ownership: All music and visual content used in 'Classic Music VR' is fully licensed and used with permission from the respective copyright holders. Song is Pubblic domain version via commons.wikimedia.org.\n\nExperience the magic of classical 
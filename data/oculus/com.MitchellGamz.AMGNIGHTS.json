scdn.com&_nc_ss=7f20f&oh=00_Af0C3M2ycA2W38fS0UsieJlciSiY0CNA0sXm5y110RqjGQ&oe=69F1F280"}, {"file_name": "1000011182.png", "id": "649656627908061", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821230_649656631241394_9164054444794096129_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-gOEYQDF88Q7kNvwEy5Qoe&_nc_oc=Adrs0Qu7PbImFALvORQeXkuaicfDzc4oBV75jSQQ7GSySww-zW8zMG4BYBrUWH5pWJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EUIY7mOJ49HI2OrH7gyCJpfvuNOYTN37-va4nqjf_rw&oe=69F20449"}, {"file_name": "1000011184.png", "id": "1934320690645661", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393411_1934320693978994_3086183331720923400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBjO8z_MOrgQ7kNvwGXGaZQ&_nc_oc=Adrr2NjnRUM_mSdEpLgZPdTuimmIxumg1FVIpDCv4_bIJNfhOB62f1kjq-Z5_ZsoVUM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0FniBozp2Xl9q1M7xSf6HEBhqZmkldW3cbXTX6YT8jOw&oe=69F2167F"}, {"file_name": "1000011186.png", "id": "1088550833298591", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819367_1088550836631924_5856907613369185560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoWZrwO-12UQ7kNvwGIy6ba&_nc_oc=AdpwJuA098wXk6QQXKIwFZ6WAre2AWWOLR6mpngN3g-JF6XB67E38cE2o8y0qeSWjMM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1VS-bF5TUhfMgLOZMXWckmkFltVgXIZSy70gRzAOczyQ&oe=69F21AD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The NightGuard - Demo", "keywords": [], "long_description": "The NightGuard is a brutal, story-driven horror experience that puts you on the night shift at a long-abandoned entertainment facility. Once filled with joy and noise, it's now silent, rotting, and hiding something far worse than decay.\n\nWhat begins as routine surveillance unravels into a waking nightmare. With each shift, reality distorts, your sanity slips, and the building reveals its grotesque, blood-soaked secrets. You're not alone-and whatever's lurking in the dark is getting closer.\n\nThe deeper you go, the harder it becomes to escape. This isn't just about surviving the night. It's about surviving what's waiting when the lights go out.", "short_description": "The NightGuard is a brutal, story-driven horror game that puts you on the night shift at a decaying, long-abandoned entertainment facility. What starts as routine surveillance quickly unravels into a nightmare, as each shift reveals grotesque secrets and reality begins to slip. Something lurks in the dark-and it's getting closer."}]}, "developer_name": "MitchellGamz ", "developer_privacy_policy_url": "https://sites.google.com/view/thenightguard/home", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/thenightguard/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9701738513206581"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1673231796640835"}]}, "baseline_offer": {"id": "1673231796640835"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747778400, "status": "PUBLISHED", "id": "1673231796640835"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9711454852234947", "version": "0.46"}, "id": "2007496583405825", "ch
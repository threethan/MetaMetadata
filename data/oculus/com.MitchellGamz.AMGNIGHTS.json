2z-NWhCoQ7kNvwGkBkKL&_nc_oc=AdoPukkdvrmZQccGFPVp6GpMo11suLOIxqyMx-Kw3ZDBvlps_WJ0KCVpy4AN_0GXieg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOb8UlgZ-lqiZokN7YKTadmL9dl1RGQu14UMhL6sy7Nw&oe=6A90123F"}, {"file_name": "1000011186.png", "id": "1088550833298591", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819367_1088550836631924_5856907613369185560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu7XYnDoEyEQ7kNvwFQBbEt&_nc_oc=AdrfFrH0HkyuuA8TZxsyHmpiVn0hd85PQkGfA8OgcPfqBvgk3fRR2zi7gw1GxidoOtk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7eLjD6vBlWa_iOU_qYgmIPctmGd1tJovlzpAfnOodsw&oe=6A901698"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The NightGuard - Demo", "keywords": [], "long_description": "The NightGuard is a brutal, story-driven horror experience that puts you on the night shift at a long-abandoned entertainment facility. Once filled with joy and noise, it's now silent, rotting, and hiding something far worse than decay.\n\nWhat begins as routine surveillance unravels into a waking nightmare. With each shift, reality distorts, your sanity slips, and the building reveals its grotesque, blood-soaked secrets. You're not alone-and whatever's lurking in the dark is getting closer.\n\nThe deeper you go, the harder it becomes to escape. This isn't just about surviving the night. It's about surviving what's waiting when the lights go out.", "short_description": "The NightGuard is a brutal, story-driven horror game that puts you on the night shift at a decaying, long-abandoned entertainment facility. What starts as routine surveillance quickly unravels into a nightmare, as each shift reveals grotesque secrets and reality begins to slip. Something lurks in the dark-and it's getting closer."}]}, "developer_name": "MitchellGamz ", "developer_privacy_policy_url": "https://sites.google.com/view/thenightguard/home", "developer_terms_of_service_url": null, "publisher_name": "Mitchell
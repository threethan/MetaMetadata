ttps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821230_649656631241394_9164054444794096129_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-gOEYQDF88Q7kNvwFm0keK&_nc_oc=AdoGrI-qOvmIeeU8ffrBZPL8z_wiPrqpIB5i7qbc0Hs2dl_CBO2YUq9toh_yU7ClcyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2rhuQ9I-enB6S08VY6hUfgJVslRj77H7EmcTMLFWt4ig&oe=69F0B2C9"}, {"file_name": "1000011184.png", "id": "1934320690645661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393411_1934320693978994_3086183331720923400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XDoqKGqaVIQ7kNvwF8LdT8&_nc_oc=AdoHceb6NKgXy-J2xpBMET_1pSj7busXBrIn6dHXsJU3yVHT9qElLa7axBDUyU9ml3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1UFPdKb1QLooiIrLi1kQgtt4AQ0fVSLdGNbMLwUtaClg&oe=69F0C4FF"}, {"file_name": "1000011186.png", "id": "1088550833298591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819367_1088550836631924_5856907613369185560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoWZrwO-12UQ7kNvwFTeVjg&_nc_oc=AdoCFAraBUwSz46Y4le3xgviFRwkT0TB8owaMIHsZt8y0E8FQlHNNgb1vHYj4IojuEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1PKJvSQV81LW1Ha4hHSfyNkq4ftMyHc9w6bNBwy5hHQg&oe=69F0C958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The NightGuard - Demo", "keywords": [], "long_description": "The NightGuard is a brutal, story-driven horror experience that puts you on the night shift at a long-abandoned entertainment facility. Once filled with joy and noise, it's now silent, rotting, and hiding something far worse than decay.\n\nWhat begins as routine surveillance unravels into a waking nightmare. With each shift, reality distorts, your sanity slips, and the building reveals its grotesque, blood-soaked secrets. You're not alone-and whatever's lurking in the dark is getting closer.\n\nThe deeper you go, the harder it becomes to escape. This isn't just about surviving the night. It's about surviving what's waiting when the lights go out.", "short_description": "The NightGuard is a brutal, story-driven horror game that puts you on the night shift at a decaying, long-abandoned entertainment facility. What starts as routine surveillance quickly unravels into a nightmare, as each shift reveals grotesque secrets and reality begins to slip. Something lurks in the dark-and it's getting closer."}]}, "developer_name": "MitchellGamz ", "developer_privacy_policy_url": "https://sites.google.com/view/thenightguard/home", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/thenightguard/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9701738513206581"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1673231796640835"}]}, "baseline_offer": {"id": "1673231796640835"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747778400, "status": "PUBLISHED", "id": "1673231796640835"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9711454852234947", "version": "0.46"}, "id": "2007496583405825", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
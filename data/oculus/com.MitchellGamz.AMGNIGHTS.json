lights go out.", "short_description": "The NightGuard is a brutal, story-driven horror game that puts you on the night shift at a decaying, long-abandoned entertainment facility. What starts as routine surveillance quickly unravels into a nightmare, as each shift reveals grotesque secrets and reality begins to slip. Something lurks in the dark-and it's getting closer."}]}, "developer_name": "MitchellGamz ", "developer_privacy_policy_url": "https://sites.google.com/view/thenightguard/home", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/thenightguard/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9701738513206581"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296179_1013323727534221_4244056174128104115_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVrdlhtLyzsQ7kNvwHlot7h&_nc_oc=AdpJPdTMCvO6hiWubqPFmtlJaStDLpeEaTGjJDWAnauPvLC5nzsGEHfJsVjGXQ2l-AQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW4Qd9mJaZYMA7TGhaL8IyiwR33ZVRdkEYd3egNOaakg&oe=6B09BB3D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The NightGuard - Demo", "platform": "ANDROID_6DOF", "context_
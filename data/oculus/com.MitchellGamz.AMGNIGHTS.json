3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vic4RzsDOXyyJebIzfd4JCVk6kjvj7qL8Buoc5gTCeg&oe=69D3C3FF"}, {"file_name": "1000011186.png", "id": "1088550833298591", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819367_1088550836631924_5856907613369185560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWGDhuFQuQoQ7kNvwGyb15U&_nc_oc=Ado0d0VIz1nfqHCovZe4_vTxa0g7_ZaCcIhWApeoXxGNOZoZBTdmS_ItgrnMyh_oRgo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39irjhthQYXLxDmIeg1y7Tfb7jTffka-Mn0sZgBaLpAA&oe=69D39018"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The NightGuard - Demo", "keywords": [], "long_description": "The NightGuard is a brutal, story-driven horror experience that puts you on the night shift at a long-abandoned entertainment facility. Once filled with joy and noise, it's now silent, rotting, and hiding something far worse than decay.\n\nWhat begins as routine surveillance unravels into a waking nightmare. With each shift, reality distorts, your sanity slips, and the building reveals its grotesque, blood-soaked secrets. You're not alone-and whatever's lurking in the dark is getting closer.\n\nThe deeper you go, the harder it becomes to escape. This isn't just about surviving the night. It's about surviving what's waiting when the lights go out.", "short_description": "The NightGuard is a brutal, story-driven horror game that puts you on the night shift at a decaying, long-abandoned entertainment facility. What starts as routine surveillance quickly unravels into a nightmare, as each shift reveals grotesque secrets and reality begins to slip. Something lurks in the dark-and it's getting closer."}]}, "developer_name": "MitchellGamz ", "developer_privacy_policy_url": "https://sites.google.com/view/thenightguard/home", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/thenightguard/home", "category": null, "comf
uluscdn.com/v/t64.5771-25/473393411_1934320693978994_3086183331720923400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spRGLzabQAUQ7kNvwF0UfD-&_nc_oc=AdrdyHcrRiYLyMgtC8TCIA3o54pNr30IU2oJ_6xyLuyJ5uuWJhqtV1sgy1VE5M0yqhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGRCcuc5vhkwM-czv_wwKiw7x777vSZOhfqBDd9A0Deg&oe=6ACA4C7F"}, {"file_name": "1000011186.png", "id": "1088550833298591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819367_1088550836631924_5856907613369185560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZjJP1uyTVwQ7kNvwHFd28E&_nc_oc=AdocSXWC9vYm0rzlqLa4NXSOD45EdwQxf00UFd8Z2AvLyEF68znXb0wZsxFYOvllfy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1pv98FAw5mV1iAJ65DLsOJx92s4e4hzoQmdFMJEylpg&oe=6ACA50D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The NightGuard - Demo", "keywords": [], "long_description": "The NightGuard is a brutal, story-driven horror experience that puts you on the night shift at a long-abandoned entertainment facility. Once filled with joy and noise, it's now silent, rotting, and hiding something far worse than decay.\n\nWhat begins as routine surveillance unravels into a waking nightmare. With each shift, reality distorts, your sanity slips, and the building reveals its grotesque, blood-soaked secrets. You're not alone-and whatever's lurking in the dark is getting closer.\n\nThe deeper you go, the harder it becomes to escape. This isn't just about surviving the night. It's about surviving what's waiting when the lights go out.", "short_description": "The NightGuard is a brutal, story-driven horror game that puts you on the night shift at a decaying, long-abandoned entertainment facility. What starts as routine surveillance quickly unravels into a nightmare, as each shift reveals grotesque secrets and reality begins to slip. Something lurks in the dark-and it's getting closer."}]}, "developer_name": "MitchellGamz ", "developer_privacy_policy_
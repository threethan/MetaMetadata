-1.oculuscdn.com/v/t64.5771-25/491823483_9818483854928123_9070892798373757159_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdfpQ_qjnKMQ7kNvwFAnmf9&_nc_oc=AdoQt2h4Crx0lUaLsX-9Q1L7Fes03maxRNTB1WsAt0QK7QmJBzFsb7R6Ez2S5_-q1SM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-If5S6COYGZscNhxNyv3fmi1wYJ_LeoJOK3-y-al5Iew&oe=6A468AC0"}, {"file_name": "1000011182.png", "id": "649656627908061", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821230_649656631241394_9164054444794096129_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQZWLEoXVTsQ7kNvwHpAAsb&_nc_oc=Adr44l-iQ_jrhkl9Dew84cGsEnIj38Ta70oJ_Ev1f_hXL14OMHXYpIc4Gj7eRDTT_NY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nk5k_nR7GaKZx0NzVasl2TclHoBNYV_5g5r5tXdnEdg&oe=6A466449"}, {"file_name": "1000011184.png", "id": "1934320690645661", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393411_1934320693978994_3086183331720923400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDrSYTPf6a4Q7kNvwHWnS-K&_nc_oc=Adq6sDdXfte50J0IvWaX7QJQOu2Oh68NLlDx002RVsO1jDkHyd33gbyc1IlH-pJA_CU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XeDYTgsNSzxdT5D9s7r6skMD60nQDN_7Lp2lMdqYF2w&oe=6A46767F"}, {"file_name": "1000011186.png", "id": "1088550833298591", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819367_1088550836631924_5856907613369185560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbI2LzcxRYQQ7kNvwF-a8vt&_nc_oc=Adpk--N49ctlLFb_6XNOHvGt_fgI8yEA95BZ-H_p3kZuBigKQ93YtyQ3FE2FL84ZxEE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2STS-kSXfOtxjB3lIWxJ_477wlqZqb1e3lj65VABzYA&oe=6A467AD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The NightGuard - Demo", "keywords": [], "long_description": "The NightGuard is a brutal, story-driven horror experience that puts you on the night shift at a long-abandoned entertainment facility. Once filled with joy and noise, it's now silent, rotting, and hiding something far worse than decay.\n\nWhat begins as routine surveillance unravels into a waking nightmare. With each shift, reality distorts, your sanity slips, and the building reveals its grotesque, blood-soaked secrets. You're not alone-and whatever's lurking in the dark is getting closer.\n\nThe deeper you go, the harder it becomes to escape. This isn't just about surviving the night. It's about surviving what's waiting when the lights go out.", "short_description": "The NightGuard is a brutal, story-driven horror game that puts you on the night shift at a decaying, long-abandoned entertainment facility. What starts as routine surveillance quickly unravels into a nightmare, as each shift reveals grotesque secrets and reality begins to slip. Something lurks in the dark-and it's getting closer."}]}, "developer_name": "MitchellGamz ", "developer_privacy_policy_url": "https://sites.google.com/view/thenightguard/home", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/thenightguard/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9701738513206581"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1673231796640835"}]}, "baseline_offer": {"id": "1673231796640835"}, "is_approved": true, "firstOffer":
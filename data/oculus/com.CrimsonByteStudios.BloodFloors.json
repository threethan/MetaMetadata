.oculuscdn.com/v/t64.5771-25/593790560_3951994071618421_3548073860644636676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRena5_NdQAQ7kNvwEunMgk&_nc_oc=Adq8LJtCwJHIgheGnJaPoqpt53IopfL4BU-vPfEDBQbqS7ujYGx8FlMJz4l86rNYpc8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-lksMGSHe5dTUysu7fP3O3kTvtqSim3lsY487sgD9Xw&oe=6A66031A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blood Floors Trailer 2 Thumbnail.png", "id": "2067459707176430", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307309_2067459710509763_8740944629384944857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEtLhTrwMKQQ7kNvwHoO7N7&_nc_oc=AdpLHRF2rFsGUhStpY7R6qVfPZf2u2oa33RKqyzDa_OfLg-2_5y4PkntxwKsuq7LVqA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkPhJctjA9PeO8-1J9GGQNqP-6fSmkPDMnIL3l2jzxHA&oe=6A65FA46"}, "display_name": "Blood Floors", "keywords": ["horror", "Survival", "scary", "jumpscare", "Creepy"], "long_description": "Step into the abandoned office where every shadow hides a threat. You\u2019ll navigate dark hallways, flickering lights, and eerie green-tinted rooms. Survive the unknown, uncover hidden secrets, and feel your heart race as the office itself seems alive\u2026 and hungry. Can you escape, or will the floors run red before you make it out?", "short_description": "Step into the abandoned office\u2026 shadows move, lights flicker, and something hunts you. Only your flashlight stands between survival and the unknown. Can you escape Blood Floors before it\u2019s too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1TT6y3XBHCThRCcfFNHPICUtNiBKNx5G9CjnBGIG3ooI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Crimson Byte Studios", "support_website_url": null, "website_url": "https://bluecatplayz.github.io/blood-floors-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id
5771-25/654949474_2352771545548886_8957466712607792619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOLRwoWJs6wQ7kNvwFRelFQ&_nc_oc=AdqxVa8pMatu-hntT8MfJ-99B2OsUeLxeCe2SwF89w5VepiyTAA1i87CHMWxh-_XlvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7pyKIY41zs_IbDwHicxUWv_PFl7dKEn6aqXcFcP9p3A&oe=6AEA0719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blood Floors Trailer 2 Thumbnail.png", "id": "2067459707176430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_2067459710509763_8740944629384944857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCKqZysXSG8Q7kNvwF2vrPT&_nc_oc=AdqDZNFVpOQdzDPtB7RMfqT5LLdcGBdRGuvcpGYdWxtui65p1vGTHA4VjJ0dlucqfkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBel0lA1Qa65ZIelmonTp_LGivTx491kwx_s2EHWY3Qw&oe=6AEA0886"}, "display_name": "Blood Floors", "keywords": ["horror", "Survival", "scary", "jumpscare", "Creepy"], "long_description": "Step into the abandoned office where every shadow hides a threat. You\u2019ll navigate dark hallways, flickering lights, and eerie green-tinted rooms. Survive the unknown, uncover hidden secrets, and feel your heart race as the office itself seems alive\u2026 and hungry. Can you escape, or will the floors run red before you make it out?", "short_description": "Step into the abandoned office\u2026 shadows move, lights flicker, and something hunts you. Only your flashlight stands between survival and the unknown. Can you escape Blood Floors before it\u2019s too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluecatplayz.github.io/OfficialBloodFloors/privacy.html", "developer_terms_of_service_url": "https://bluecatplayz.github.io/OfficialBloodFloors/terms.html", "publisher_name": "Crimson Byte Studios", "support_website_url": null, "website_url": "https://bluecatplayz.github.io/OfficialBloodFloors/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category
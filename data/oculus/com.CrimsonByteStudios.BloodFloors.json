5771-25/654949474_2352771545548886_8957466712607792619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIAsnosYGeMQ7kNvwGachn3&_nc_oc=Adqvz17k3k46t3TpX-BidJBEIQMMDTC86irXb5PYNaubkBuyBHzj0qilzIMy1tpbtwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtoI4ID38jdlepqdbl0OS2SJISr08Fe9iaC0-FCE6J2w&oe=6AF49319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blood Floors Trailer 2 Thumbnail.png", "id": "2067459707176430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_2067459710509763_8740944629384944857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJnrfXhiW3sQ7kNvwEtoCA_&_nc_oc=AdoxjNqguUzqq-6hh6w_ucZE4xeZrXgHMenvSdO8ltb2rCJy-hCmLCae6GXTvyOHhcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTunmWdOVbILGno_DaL1qsDUxc0-DqCUv6dU4cfqmgsrQ&oe=6AF49486"}, "display_name": "Blood Floors", "keywords": ["horror", "Survival", "scary", "jumpscare", "Creepy"], "long_description": "Step into the abandoned office where every shadow hides a threat. You\u2019ll navigate dark hallways, flickering lights, and eerie green-tinted rooms. Survive the unknown, uncover hidden secrets, and feel your heart race as the office itself seems alive\u2026 and hungry. Can you escape, or will the floors run red before you make it out?", "short_description": "Step into the abandoned office\u2026 shadows move, lights flicker, and something hunts you. Only your flashlight stands between survival and the unknown. Can you escape Blood Floors before it\u2019s too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluecatplayz.github.io/OfficialBloodFloors/privacy.html", "developer_terms_of_service_url": "https://bluecatplayz.github.io/OfficialBloodFloors/terms.html", "publisher_name": "Crimson Byte Studios", "support_website_url": null, "website_url": "https://bluecatplayz.github.io/OfficialBloodFloors/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category
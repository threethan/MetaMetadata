": "Screen2.png", "id": "1393765178088687", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982487_1393765181422020_904898888534026119_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhwbGV9h1PkQ7kNvwG-DnNH&_nc_oc=Adr-wZGKI0bWRdkT0qRl87A-2S02Td1Udm5xXSq5TB9HZuuyB7LzdqMM3X424bewIM4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I4WYbVC9Z23GjWzqgpk7U4ubYjY88-hB8EQvhxi4S8g&oe=6A3696AF"}, {"file_name": "Screen3.png", "id": "650641000287440", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_650641003620773_4050198127781062684_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OggUbon8Vb8Q7kNvwHVMH0q&_nc_oc=AdqfJyttVVkzsVnimL0lXaTT1XQYQp9g0L0eGUbtbVcP8wrB5Y_85QGIyLgbz9YOsvA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oqv4RQHCcVR-EOCvNi5_WGQopKj9CYI5Rt-jXeCMKJg&oe=6A36AAD2"}, {"file_name": "Screen4.png", "id": "811408290654109", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974666_811408293987442_2451169491929564350_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bsKJIp9TsoQ7kNvwETKABn&_nc_oc=Adq6x_njg0e2YR6cFBmA0VBdMiMErDuaZVhG5g1UoVzjtOTKtla0_X6rZES3pxTxWA4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dgpTnxyZOOW2jlp0DdrXmx6g152e5kE7RUFBhGFLEWQ&oe=6A369C7E"}, {"file_name": "Screen5.png", "id": "1073432280711064", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036603_1073432284044397_4349381634251184472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgVGIRTJkBwQ7kNvwEPM9tV&_nc_oc=Adr96d-l_EfYsJQypDnttBYkameIGiqmHzaOcAshtANdvVRJOxue-6xjnyqLAj2OwK0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xeXievU49T44Oq8FppuFaduJm_5aj9zby2AQ0mNN6JQ&oe=6A369449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "194778380180485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974448_194778383513818_6309020332712014704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfeJmMa_DpkQ7kNvwHefcoB&_nc_oc=AdpzSj8pOrV6OkDgExxCzKt74KAPwkiASy845lDy52oxFyUP-GgtnEeMPte3hK3m6Z0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m1ErpvVjZUXTv-OIHu04m2VpWHHMdiKkHahJT3qMCtA&oe=6A36BB97"}, "display_name": "The Ragmans", "keywords": [], "long_description": "Any way is good to win a battle - attack enemies with swords, axes, shields, hammers, bare hands and firearms. They may be poor warriors, but thanks to their numerical superiority they can surprise. As you gain battle experience, you'll get access to more weapons, such as a large sword, bow, crossbow, revolver, shotgun, machine gun or large-caliber sniper rifle. In addition to the adventure mode, the game also features a custom map editor where you can create your own dream battle scenario.", "short_description": "Join the age-old conflict between the Reds and the Blues. Choose any weapon and crush the enemy army. Choose from over 30 different weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/theragmans/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Seba", "support_website_url": null, "website_url": "https://szlufik.pl/theragmans", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8032267916812442"}, "review_messages": []}]}, "co
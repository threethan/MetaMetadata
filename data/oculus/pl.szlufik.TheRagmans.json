LjPQp2LC12LnKQFhlA&oe=69A6CFD7"}, "display_name": "The Ragmans", "keywords": [], "long_description": "Any way is good to win a battle - attack enemies with swords, axes, shields, hammers, bare hands and firearms. They may be poor warriors, but thanks to their numerical superiority they can surprise. As you gain battle experience, you'll get access to more weapons, such as a large sword, bow, crossbow, revolver, shotgun, machine gun or large-caliber sniper rifle. In addition to the adventure mode, the game also features a custom map editor where you can create your own dream battle scenario.", "short_description": "Join the age-old conflict between the Reds and the Blues. Choose any weapon and crush the enemy army. Choose from over 30 different weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/theragmans/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Seba", "support_website_url": null, "website_url": "https://szlufik.pl/theragmans", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8032267916812442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035394_586044053626445_5621258331599059940_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&
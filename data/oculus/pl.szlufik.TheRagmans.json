_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNXoonSGLZcQ7kNvwHo5BdH&_nc_oc=AdkncWSsuqCdN6AuSGSDzmiUN73rpcjslg6AW7jIOWS6mDFEFsh2OpW01Gg5vFNSFFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv9Ccmznuxu3eE_UdhL9JCh1Tn9suQGGCttb15Quk_sgw&oe=69A83A7E"}, {"file_name": "Screen5.png", "id": "1073432280711064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036603_1073432284044397_4349381634251184472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZVIBDCj08YQ7kNvwG49qJy&_nc_oc=AdmrfO_NlANg_nnAnPNh-SOq3cgs_1TvksHUn4uZUHeSXlyve1msAPQ_INB6uO31qAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuntU4GkCdfShr7fqx2I_wvlmZd7edZfB2kAxLcjvojkw&oe=69A83249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "194778380180485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_194778383513818_6309020332712014704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBsuULAPPMQQ7kNvwGgBold&_nc_oc=AdmpQsQJ9ASNkNw85xwebOatFMRe_6B4Q_3l9mrOuko0Flbc_kXfuAarXEoDBwNEbug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfugWBoUcI8_GTonQ4HIBo9zp7MBgeAM-S6_1E_kbcB5xQ&oe=69A82157"}, "display_name": "The Ragmans", "keywords": [], "long_description": "Any way is good to win a battle - attack enemies with swords, axes, shields, hammers, bare hands and firearms. They may be poor warriors, but thanks to their numerical superiority they can surprise. As you gain battle experience, you'll get access to more weapons, such as a large sword, bow, crossbow, revolver, shotgun, machine gun or large-caliber sniper rifle. In addition to the adventure mode, the game also features a custom map editor where you can create your own dream battle scenario.", "short_description": "Join the age-old conflict between the Reds and the Blues. Choose any weapon and crush the enemy army. Choose from over 30 different weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_pr
fferent weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/theragmans/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Seba", "support_website_url": null, "website_url": "https://szlufik.pl/theragmans", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "776342124191959"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1337317876818818"}, {"status": "PUBLISHED", "id": "2637581349756938"}, {"status": "PUBLISHED", "id": "1096400854888229"}]}, "baseline_offer": {"id": "1096400854888229"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1685725893, "status": "PUBLISHED", "id": "1337317876818818"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6404192659619984", "version": "0.9"}, "id": "260680633179710", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6305464276159490", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6404192659619984"}, "release_status": "RELEASED"}, "binary_release_c
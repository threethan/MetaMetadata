_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzVUPq9NzhcQ7kNvwEFG4tW&_nc_oc=AdlGEXz4e51bfYrOrYV_paca0rlfWjA_eQxOo-29Q8LPO4OvvlhaW8Bn_3xva7sgGvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoXRQXFRY9SnTe0e8J_Ye0-_wqRHdKUaxrAcFJNm6HTw&oe=69AED1FE"}, {"file_name": "Screen5.png", "id": "1073432280711064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036603_1073432284044397_4349381634251184472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flMPTSUBIlgQ7kNvwFoEdhF&_nc_oc=Adl5IO4KzfrplZR-0xXufTmU0e_9pyhgw68yhrNjAVF2BS3_pmF7oOlDmAldkYztOB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQ9npqhrnNvRjCY5Z_kETaYO21Eudyjyp937UumAHfxQ&oe=69AEC9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "194778380180485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_194778383513818_6309020332712014704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFtg2GN_MmgQ7kNvwHxLnX_&_nc_oc=AdlJuR9-2F6Uvcx1_OW69pq9021DEOQrkA7eXhQerAZWAHBlADpFaZoT-Ua70ezTPtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuTF67d4YcMAY6Vp7x93LZ4D7S8KIuelUExjUatoKu1Q&oe=69AEB8D7"}, "display_name": "The Ragmans", "keywords": [], "long_description": "Any way is good to win a battle - attack enemies with swords, axes, shields, hammers, bare hands and firearms. They may be poor warriors, but thanks to their numerical superiority they can surprise. As you gain battle experience, you'll get access to more weapons, such as a large sword, bow, crossbow, revolver, shotgun, machine gun or large-caliber sniper rifle. In addition to the adventure mode, the game also features a custom map editor where you can create your own dream battle scenario.", "short_description": "Join the age-old conflict between the Reds and the Blues. Choose any weapon and crush the enemy army. Choose from over 30 different weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_pr
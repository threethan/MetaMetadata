": "Screen2.png", "id": "1393765178088687", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982487_1393765181422020_904898888534026119_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92eAIDb7PoUQ7kNvwFPr56v&_nc_oc=Adrj1zSrkygHk5spvQUzk9GfzAZpJEoZXWLcNzdXAhd6W_2HwVQU-lFS-r_yC3fCefQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ3k2lZGRc3Mn3-RyhbHg_Gg0j3aE--jOnfsPLdR2rnQ&oe=6AA4032F"}, {"file_name": "Screen3.png", "id": "650641000287440", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_650641003620773_4050198127781062684_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMZC2LFviOgQ7kNvwFZrAKd&_nc_oc=AdpN6hz95Kc_dg7vkIQ0o_wElUr-U0AMek7LJZwSt9xNSJOmYLWSBXfNe9_q8jHOoR8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI_YmCDzHVP-940AdvdIkf2BoiN8XBrunTadNsRbBa9A&oe=6AA41752"}, {"file_name": "Screen4.png", "id": "811408290654109", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974666_811408293987442_2451169491929564350_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ScFcATsIQQ7kNvwFnRgWG&_nc_oc=AdrVZ_IBTBA_pf4MSevi4u35linNX7LMmJ1zGl3exgdXkB126p-7WZY1ZY5rQLLGBTE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBEQxIlKX9Omgt3icbJCq-CCcmhTHRn_SimGw125a_kQ&oe=6AA408FE"}, {"file_name": "Screen5.png", "id": "1073432280711064", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036603_1073432284044397_4349381634251184472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToFqhbJhpugQ7kNvwH-KfgF&_nc_oc=Ado_cC6nczcYx0yzDZMmCJPuDujaeXqXWA-Q5xD7mKKx7XtJkTxTFN6dRml5AmO5zlY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYyBCO66cOEFZFLyoo2Mbg3A2dwM4y6U_AtAlwHCRWjw&oe=6AA400C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "194778380180485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974448_194778383513818_6309020332712014704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbx8-B-_D4cQ7kNvwEIeByw&_nc_oc=AdqzkfhX4MwU8NpmgH0tINL_LZur8yt5ilkxisTax85dca4MD0_ce9IYF-dIgJb7rgo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5tP4yT-nkzJBi1r475pDmGiBy-_5REXHt8tpwah_Xfw&oe=6AA3EFD7"}, "display_name": "The Ragmans", "keywords": [], "long_description": "Any way is good to win a battle - attack enemies with swords, axes, shields, hammers, bare hands and firearms. They may be poor warriors, but thanks to their numerical superiority they can surprise. As you gain battle experience, you'll get access to more weapons, such as a large sword, bow, crossbow, revolver, shotgun, machine gun or large-caliber sniper rifle. In addition to the adventure mode, the game also features a custom map editor where you can create your own dream battle scenario.", "short_description": "Join the age-old conflict between the Reds and the Blues. Choose any weapon and crush the enemy army. Choose from over 30 different weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/theragmans/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Seba", "support_website_url": null, "website_url": "https://szlufik.pl/theragmans", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8032267916812442"}, "review_messages": []}]}, "co
_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzVUPq9NzhcQ7kNvwFhS45J&_nc_oc=AdkJpKpPE2YLaJUmZ1GfcFpq2HWKC_zY0J9DmRmJXj5w1n3vrf3bi-d9hNet_DFha-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDP3DtJIj5uGAuHP1P2ENTfDHc9QC-CuXKrIZwo6XO6w&oe=69B0237E"}, {"file_name": "Screen5.png", "id": "1073432280711064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036603_1073432284044397_4349381634251184472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flMPTSUBIlgQ7kNvwGH1M-J&_nc_oc=Adk9QqGtbC7otDAg3lz352pMH_08uXqltmn80eI6w1woRiY2sB3mKESK5JM9uhamlGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwllstdZ9pvZqYMsYevDRQDPpoEg1ebyZNaX1W_GHBICA&oe=69B01B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "194778380180485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_194778383513818_6309020332712014704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3J1kNL9y9EQ7kNvwFCCIEA&_nc_oc=AdmDOguzHcqB88Lv6UMdhIgbl7rrNlZHYpUU1O8lVkZVTNcic67YqTbipUUwAs59C1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2MmqweVaZr-H6YVaqwhX0MM5KtGEvy6nKcCD9hYz9CQ&oe=69B00A57"}, "display_name": "The Ragmans", "keywords": [], "long_description": "Any way is good to win a battle - attack enemies with swords, axes, shields, hammers, bare hands and firearms. They may be poor warriors, but thanks to their numerical superiority they can surprise. As you gain battle experience, you'll get access to more weapons, such as a large sword, bow, crossbow, revolver, shotgun, machine gun or large-caliber sniper rifle. In addition to the adventure mode, the game also features a custom map editor where you can create your own dream battle scenario.", "short_description": "Join the age-old conflict between the Reds and the Blues. Choose any weapon and crush the enemy army. Choose from over 30 different weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_pr
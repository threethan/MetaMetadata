_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1vLjai4cK8Q7kNvwFM0qdS&_nc_oc=Adm0ylYq4xD65pRF6OElxeRMOoRl_2wkw32nlJ_jmNfJInf5182LKHeCVy5pl7SucDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5RU6O6n5m7KvHIlp-Yjm20vB3oLrfe6X5mF8h5jZbBA&oe=69AC2EFE"}, {"file_name": "Screen5.png", "id": "1073432280711064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036603_1073432284044397_4349381634251184472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezqbYvWJCjgQ7kNvwGB4G4d&_nc_oc=Adla53abtB1qFRzwxSXsVD8wZykiTE7d9wfnPC4P9YkKR3lXlfh0Y_c5M0pQyDar4rU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMKksYjHDo3eorPNkZQLVPX5UPbba1vmBFuIzUbbx3lg&oe=69AC26C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "194778380180485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974448_194778383513818_6309020332712014704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFtg2GN_MmgQ7kNvwGAOMFK&_nc_oc=Adk75xZXf3tdReYwvVWSDA1fpYJ7UzL0fBBqAvzMEXjGhtuYeHB2GZf9isfYF3mO-4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxpg7-uM36YlJwgEcvileLfjjJ23f2LUKPOgW03DoLqMg&oe=69AC15D7"}, "display_name": "The Ragmans", "keywords": [], "long_description": "Any way is good to win a battle - attack enemies with swords, axes, shields, hammers, bare hands and firearms. They may be poor warriors, but thanks to their numerical superiority they can surprise. As you gain battle experience, you'll get access to more weapons, such as a large sword, bow, crossbow, revolver, shotgun, machine gun or large-caliber sniper rifle. In addition to the adventure mode, the game also features a custom map editor where you can create your own dream battle scenario.", "short_description": "Join the age-old conflict between the Reds and the Blues. Choose any weapon and crush the enemy army. Choose from over 30 different weapons, 13 pre-made battle maps and a custom map editor!"}]}, "developer_name": null, "developer_pr
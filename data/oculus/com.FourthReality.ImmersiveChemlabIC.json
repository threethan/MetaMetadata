0f&oh=00_Af-VFiuSDR0kdpmt3OLTAu1rmGNC_POvlKjRHGf2EW5VyQ&oe=6A453085"}, {"file_name": "DCU ICS Visuals (6).png", "id": "709832541647774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830146_709832544981107_3914509931864030465_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roKQ7tbFnKAQ7kNvwH9uMQL&_nc_oc=AdpgVGMJgOKzAdnHdM2_qYUjkQCzqKxzRUxBjW7vMG9tQEyFXUIZ_QD322-UskBzVgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bxrzOBOdP__s0iReSopB0eB93jvd_9j5R-sMMOejI7Q&oe=6A452EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DCU IC External Cover Art Landscape.png", "id": "945229821393752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_945229824727085_1412324190580075514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR564wEN1N4Q7kNvwEhv_0Y&_nc_oc=AdoA3ayfvbHfopWPxFo2wa4hAVcZsRiljqTAU-UUvSYiy4RbuWdp0Xk1Pyt8zhlpdnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__F8zOH2FCXNPbloKBfqH78Cr1v4tP3m-5fFH79qbaYg&oe=6A45396D"}, "display_name": "Immersive ChemLab - Ion Chromatography", "keywords": ["ChemLab", "chemistry", "science", "Chromatography", "Ion"], "long_description": "Step inside a fully immersive analytical chemistry laboratory and learn to operate real ion chromatography instrumentation \u2014 hands-on, without ever setting foot in a lab.\n\nDesigned for third-level undergraduate chemistry students, this VR experience guides learners through the complete analytical workflow: exploring instrumentation and its components, initialising the system and software, performing sample injection, and generating and interpreting chromatographic data.\n\nWhether you're a student preparing for lab work, an educator looking for an engaging teaching tool, or simply curious about analytical science, Immersive ChemLab offers an accessible and realistic training environment. Its intuitive design also makes it a compelling introduction to analytical chemistry for anyone who is interested.\n\nImmersive ChemLab is an active development project. We welcome your feedback, suggestions \u2014 and compliments! Get in touch at aoife.morrin@dcu.ie\n\nAlso available: Immersive ChemLab \u2013 Atomic Absorption Spectrometry.\n", "short_description": "Step inside a fully immersive analytical chemistry laboratory and learn to operate real ion chromatography instrumentation \u2014 hands-on, without ever setting foot in a lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fourthreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fourth Reality", "support_website_url": null, "website_url": "https://www.fourthreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24261211173474120"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1193080942755578"}]}, "baseline_offer": {"id": "1193080942755578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775550960, "status": "PUBLISHED", "id": "1193080942755578"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26673323942262819", "version": "1.0.20"}, "id": "716416604319290", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andro
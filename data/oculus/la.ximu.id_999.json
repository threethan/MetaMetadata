-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2pXfhinH57kMKwcdvYd3cq2Mijb-9ioc80OjAxaJFQw&oe=6AAEAB87"}, {"file_name": "1440p_1.png", "id": "1008614081385996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823837_1008614084719329_8466700049754449236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MMKzNsZfncQ7kNvwGwv63S&_nc_oc=AdoCu_6X_nDM7a4l1LfIejXcXzN7oo3yCOP0ZAilOzMj9d-i1Kg06j8aYkXU_0ZkR9U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO7JPN4AYEHZ-a8r0ogToPi-Lac-2qcMd8Ajoad310ew&oe=6AAE931F"}, {"file_name": "1440p_6.png", "id": "1136843491826085", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820891_1136843495159418_7185705532619363070_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjAUiG4jlVoQ7kNvwFi6tEv&_nc_oc=Adrs2V14fwLYiqCCCvcjnIVg6prfunIUDZSaxyqeGUDnnCWMpUhFCEzcEJcCFMYuLGA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi1NwXRkdvBVxqGZ1f3-9lnZtRxWcbsDdae9lPbRd-6w&oe=6AAE7F5D"}, {"file_name": "1440p_5.png", "id": "649095658092016", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819327_649095661425349_1288233874382096618_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaUAJKw3-bYQ7kNvwFykTIw&_nc_oc=AdqbTCjow3x-PCPdoS1HEGlUEkjVZhBA6MO7fz_Z22dq29_XLbjcUN0oBrU5Qp6iShs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkmp2LxpPt_rIkgtsgrNq-SPsa3PswUdEhRqnPJEsOqQ&oe=6AAE7DE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ID.999", "keywords": [], "long_description": "Short claustrophobic experience inspired by The Exit 8, the Severance series and ICC Berlin \"Starship\".\n\nStarted as a test to explore Godot's capabilities in the field of VR, it evolved into a Proof Of Concept for an interactive experience.\n\n## Credits :\n\n### Models, Design, Code, Animation, SFX:\n\ne.perinelli for Titanic Enterprises\n\n### Additional resources:\n\n* Monster Eat - https://skfb.ly/oAurA by LostBoy2078 on Sketchfab\n* Horror Corpse - https://skfb.ly/oMJ8W by Nomeda Repsaite on Sketchfab\n* Door Metal - https://skfb.ly/oPMxB by Mehdi Shahsavan on Sketchfab\n* Office Chair - https://skfb.ly/6VLRV by kreems on Sketchfab\n* Secretary - https://skfb.ly/orSJE by Tiago Lopes on Sketchfab\n\n### Music\n\n*   Universfield - https://pixabay.com/users/universfield-28281460/ from Pixabay\n", "short_description": "A psychological horror  game in hauntingly empty spaces where reality bends and you're never quite alone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e01e5f90-335b-4b60-a687-99e395218c39", "developer_terms_of_service_url": null, "publisher_name": "Ximula", "support_website_url": null, "website_url": "https://ximu.la/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10051244661625288"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2046062535885856"}]}, "baseline_offer": {"id": "2046062535885856"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750083780, "status": "PUBLISHED", "id": "2046062535885856"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10051318781617876", "version": "ID.999"}, "id": "588176330554391", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries":
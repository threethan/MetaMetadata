ontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491819327_649095661425349_1288233874382096618_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0fh5gly7cIQ7kNvwGwS2RW&_nc_oc=AdqgI48eeWELYkJ9eKhStOmJWUx56KhLka_bw6Hkna8Yap5WCkT7H4DNdN6OcrlX9-c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzgnzIM3_CsrN4spMzzMVTy3XhYsDpcDEBN_UdpprpVQ&oe=6B085C23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ID.999", "keywords": [], "long_description": "Short claustrophobic experience inspired by The Exit 8, the Severance series and ICC Berlin \"Starship\".\n\nStarted as a test to explore Godot's capabilities in the field of VR, it evolved into a Proof Of Concept for an interactive experience.\n\n## Credits :\n\n### Models, Design, Code, Animation, SFX:\n\ne.perinelli for Titanic Enterprises\n\n### Additional resources:\n\n* Monster Eat - https://skfb.ly/oAurA by LostBoy2078 on Sketchfab\n* Horror Corpse - https://skfb.ly/oMJ8W by Nomeda Repsaite on Sketchfab\n* Door Metal - https://skfb.ly/oPMxB by Mehdi Shahsavan on Sketchfab\n* Office Chair - https://skfb.ly/6VLRV by kreems on Sketchfab\n* Secretary - https://skfb.ly/orSJE by Tiago Lopes on Sketchfab\n\n### Music\n\n*   Universfield - https://pixabay.com/users/universfield-28281460/ from Pixabay\n", "short_description": "A psychological horror  game in hauntingly empty spaces where reality bends and you're never quite alone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e01e5f90-335b-4b60-a687-99e395218c39", "developer_terms_of_service_url": null, "publisher_name": "Ximula", "support_website_url": null, "website_url": "https://ximu.la/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
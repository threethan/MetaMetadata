7f20f&oh=00_AQQ40bUeWrdd3Ymql7dC3OrGauN7Y70DAO5VHi-T1_QtMA&oe=6B0317A6"}, {"file_name": "Environemt.png", "id": "7291679210947063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974568_7291679214280396_5314686185602698795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YkHXe6x2oAQ7kNvwH0Qn8w&_nc_oc=AdqEP6s-18p0MrQcQPqkBQsnTSTCiQCztVJLcIR5AAEHCJSHRK8oKx9IQLEj2b_eW_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9texibhRgXyZvyEFQkS5HwJu5wNA_Yr2lww0K1rkMcQ&oe=6B032ADC"}, {"file_name": "Skillveri MR 1 (1).png", "id": "1405106287045876", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974662_1405106290379209_8227832584324635084_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bov4dsDBAZMQ7kNvwHXw_C_&_nc_oc=Adq_XqdNSvDYaScA8ZrGEydjW06x2Lg6K6ayui0Gjry6I8xBaG2n62ukbNkxZBruTl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5pMj2FRkzUcwalMRHrtQRoOgKnZ6vLqIx9zIuIBu1hQ&oe=6B032445"}, {"file_name": "Scorecard.png", "id": "1170678537282361", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86661275_1170678540615694_5909688375189014404_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEEesqxnsZYQ7kNvwEtzZ15&_nc_oc=AdrAqbFxxhFswD8MAbD_SyzviI9h3BceRYEJYijy6Pfc5T5NUo9N2Tn8C8qdYPulNv0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaL9-IXP2wlu0zWerwxo2U4GGhV3Vanm4wWkdy-KedKw&oe=6B0301E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Final.png", "id": "727743049389286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982563_727743052722619_5644352723781924565_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkUlX__Iq9wQ7kNvwHBJdHj&_nc_oc=AdphQW2-r0mu8vNd1KfVsuW6PkaD3S3iz4CMhZj28rCF0RpD0_VHQYhdBsXWU_j6ejI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4xYNlrvU17JPcistdu5aGHw-1ee-FoNN_yiv3e99Lcg&oe=6B03316E"}, "display_name": "Skillveri Aura MR Welding Simulator", "keywords": [], "long_description": "Weld on real world objects, see it inside your virtual world !\nSkillveri AURA MR welding simulator now blends the best of both worlds in mixed reality mode. \n\nSkillveri Welding simulator now brings the best in class VR experience blended into the actual real world environment of the user. \nReal welding guns sold separately by Skillveri can be used with this version of the software. Our VR welding simulators offer \n4 types of welding (GMAW, GTAW, SMAW, FCAW)\nChoice of different metal types & thickness\nAll welding positions\nLevel based lesson sequence from easy to difficult - unlock as your progress !\nLive feedback \nDetailed scorecard after each lesson\nProgress tracking and reports \n\nTrusted by Industry leaders across the world, and used by 50+ schools & community colleges across North America for their CTE programs. Learn more at www.skillveri.com\n\nExperience the Skillveri difference with a free trial licence.  \nNote : Request a trial license by filling the form at https://skillveri.com/skillveri-metaverse-workshop-trial-request-form/\n", "short_description": "Skillveri Welding simulator now brings the best in class VR experience blended into the actual real world environment of the user. \nReal welding guns sold separately by Skillveri can be used with this version of the software. Our VR welding simulators offer \n4 types of welding (GMAW, GTAW, SMAW, FCAW)\nChoice of different metal types & thickness\nAll welding positions\nLevel based lesson sequence from easy to difficult\nLive feedback \nDetailed scorecard after each lesson\nProgress tracking and report"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/skillveri-aura-mr-welding-simulator-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": nul
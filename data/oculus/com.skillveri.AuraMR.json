7f30f&oh=00_AQQJmUF4j3VUsp58e9elTu5E2wMuUmBoOtjsSeqhkh2icg&oe=6B0C5226"}, {"file_name": "Environemt.png", "id": "7291679210947063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974568_7291679214280396_5314686185602698795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84efDOj1SegQ7kNvwFsgALh&_nc_oc=AdpbLEEw_8w1HvzTsHL2HC-iYuBjSr_5uAYgZ11Cx_f3qDmg5ttDI3n8ljwzlM6D3l0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUXNt4xETj1ZgD6OqM1dLfGCndNid41WjXPMnAyKClvg&oe=6B0C655C"}, {"file_name": "Skillveri MR 1 (1).png", "id": "1405106287045876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974662_1405106290379209_8227832584324635084_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r217DYikXvoQ7kNvwH0qLC9&_nc_oc=AdoaePKyhFaTjX7iYwPGOusGa6lwYQsHASnNWp4DXE0g5ZtnQQ36XHcNV1Ir5l_Ookg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSA8sar4fcH9sMy6zasjZ-1d_QOCpeLJK-CzQNbHk8R2w&oe=6B0C5EC5"}, {"file_name": "Scorecard.png", "id": "1170678537282361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86661275_1170678540615694_5909688375189014404_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN-tPc7rDicQ7kNvwG8Mt4c&_nc_oc=AdpJ0KXzFvUSDWp0336VUKJWNHL8VAooIJ7_5AydrlITIo34QWGZ-ftAw4yxas9MlzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQeSqguSMwldUZhhdpwoLr3NSa7cYs68rCW60AVLcV0Vg&oe=6B0C74A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Final.png", "id": "727743049389286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_727743052722619_5644352723781924565_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCBVUb_vO_MQ7kNvwHklCmF&_nc_oc=AdqxNCvQ3qY2kYuWGE19RWKy-gMJ1wIaIBLHwVij9T11WWIvYiNtWYm_71QnIzJlL9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZuWMLKz_w_LETtj3Wgfdf2iCfdeTIaYPhYV_1j0_otg&oe=6B0C6BEE"}, "display_name": "Skillveri Aura MR Welding Simulator", "keywords": [], "long_description": "Weld on real world objects, see it inside your virtual world !\nSkillveri AURA MR welding simulator now blends the best of both worlds in mixed reality mode. \n\nSkillveri Welding simulator now brings the best in class VR experience blended into the actual real world environment of the user. \nReal welding guns sold separately by Skillveri can be used with this version of the software. Our VR welding simulators offer \n4 types of welding (GMAW, GTAW, SMAW, FCAW)\nChoice of different metal types & thickness\nAll welding positions\nLevel based lesson sequence from easy to difficult - unlock as your progress !\nLive feedback \nDetailed scorecard after each lesson\nProgress tracking and reports \n\nTrusted by Industry leaders across the world, and used by 50+ schools & community colleges across North America for their CTE programs. Learn more at www.skillveri.com\n\nExperience the Skillveri difference with a free trial licence.  \nNote : Request a trial license by filling the form at https://skillveri.com/skillveri-metaverse-workshop-trial-request-form/\n", "short_description": "Skillveri Welding simulator now brings the best in class VR experience blended into the actual real world environment of the user. \nReal welding guns sold separately by Skillveri can be used with this version of the software. Our VR welding simulators offer \n4 types of welding (GMAW, GTAW, SMAW, FCAW)\nChoice of different metal types & thickness\nAll welding positions\nLevel based lesson sequence from easy to difficult\nLive feedback \nDetailed scorecard after each lesson\nProgress tracking and report"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/skillveri-aura-mr-welding-simulator-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": nul
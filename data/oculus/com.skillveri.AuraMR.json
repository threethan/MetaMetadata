scdn.com/v/t64.5771-25/499626172_1663809834691043_5835278210124772979_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43pr2RI9JPUQ7kNvwGBAQoN&_nc_oc=AdoFNJ7QGupXr_Sjp3tM9HwtgwZStos5pxzfTbRnGdqakQyRtr48nyGcaloEIGHTD7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRYXA2nXn_QR8ZPd9purIuwVfWxv7qKOVGsDgQhuC8MQ&oe=6A7B2FD4"}, {"file_name": "ent 4.png", "id": "1055683923601513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623345_1055683926934846_6664541917511322861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UrOfOqRYrwQ7kNvwEY6YOm&_nc_oc=Ado-aJNGYKATcty3EQXFCukXgvs7r1kAPAuBiCaBSVATpV73sRAMmsUc7dUI6VOh9og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfu4YZJB9fHeNib79Z9lT73NVbPX_a9jdWx0i7JjN4Mg&oe=6A7B1219"}, {"file_name": "smaw_pipe.png", "id": "1058995749953061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1058995753286394_1195948947870819153_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQl5UxdwQPYQ7kNvwFLeyax&_nc_oc=AdoOvU5cuL-BGLq2EiTSK7SDlisDiCUPr6O6DP-cmvyXBmclizPjEqcB_bWnprLtDTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn5SzDpf64r0zUHn6EfhvDc0pKXcZNz3fz5o22qrXyug&oe=6A7B0A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding enterprise thumbnail.png", "id": "1627234628829589", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1627234635496255_8900354780081886889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjfGheKw-6MQ7kNvwF2BZvI&_nc_oc=AdoJv0d_IKaU1sacWZLix8t2wRcy2BHYRPRy1_Ghp8Q2CWA9xcnF9ZYwT_a4QMVeZqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxQ5j6ppHjIy5CSqZD3z0skZg4vCnNS1YB9dPa2O4K5g&oe=6A7B25A1"}, "display_name": "Skillveri Welding Simulator-Enterprise", "keywords": ["Simulator", "Welding", "CTE", "VR", "Skillveri"], "long_description": "Make your welding training step into the future with the Skillveri Welding Simulator Enterprise edition.\n\nA fully immersive training experience in advanced Mixed Reality which seamlessly blends virtual workpieces with your real surroundings. Enable your learners to weld safely and practice repeatedly without any risks or wastage of metal, gas, wire and electrodes. \n\nThe welding simulator most preferred by trainers, Skillveri Enterprise edition includes:\n- 4 types of welding - GMAW, SMAW, GTAW & FCAW with each welding machine exactly replicated inside simulation\n- Real torch integration for each type of welding\n- Real retracting electrode to simulate consumption in SMAW\n- Different metal types and thickness. Multi pass mode for high thickness coupons\n- Multiple joint types and welding positions\n- Choose gas selections, wire spool thickness, and shield glass darkness as in the real world\n- 3D cut section views for checking depth of penetration\n- Exact real life welding sounds\n- Easy to understand on screen visuals and clear numerical scores\n- Casting app to monitor and guide multiple learners\n- Detailed reporting dashboard\n\nTo enable our welding simulator for your institution\u2019s CTE or workforce training, write to us at usa@skillveri.com. Skillveri simulators are used by global industries and across 100+ schools and colleges across the USA in their CTE programs. Check out www.skillveri.com for more details. \n\nFor personal usage, check out Skillveri Welding Simulator-Personal Use", "short_description": "Make your welding training step into the future, with the Skillveri Welding Simulator Enterprise edition.\n\nExperience a fully immersive VR training environment where your learners can weld safely without wasting metal,gas, and wire. \nThis Enterprise edition comes with 4 types of welding, real torch integration, different metal types & thickness, all welding positions, and reporting dashboard.\n\nTo enable our welding simulator for your institution\u2019s CTE training, write to us at usa@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/skillveri-aura-mr-welding-simulator-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28573382102254237"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604282317_1362080412002480_8255939853092312110_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxfR7HAfzTcQ7kNvwEEVEwx&_nc_oc=Adp8TmD01w9nKUSQXjHPqsS2SI7v5VMS81jIHmTQtDv1iXRhvYSsA0nVH_Uhsjx8Qss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyaayDtBx7evgrPavWXVki2Hgm93t4S_-rQhFT17rs_w&oe=6A7B3A12"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skillveri Welding Simulator-Enterprise", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1718773487, "lastRevision": {"nodes": [{"id": "7964981956854220", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7964981933520889", "is_fi
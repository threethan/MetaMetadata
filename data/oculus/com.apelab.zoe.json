a&_nc_ohc=Qhmh651aaeoQ7kNvwFR2Qex&_nc_oc=Adp_SHi529fT3oafiehuNfhL-pTyHRBC4yK8CS8Gwb_ZStvHKAntSjGI2KNwn9VP2Dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQzsaAiemitfmZfmYEDn5p-vocWXpuqzxdzpnLtGiQKA&oe=6B0D9EF2"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqdSOgl548QQ7kNvwEk6hEM&_nc_oc=AdpcjomxmKXKIfAvv9bvi9wYHkIPA7sK5_NmmYc8BHNMk3kya0YnpLCnnMROlQDJUsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQz9jfVUHa1W12lx7uSb1isfyj3Tz2mMO0pA2maP2RZjQ&oe=6B0DD173"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THPDuLLTA84Q7kNvwFs06lN&_nc_oc=AdpYH0o3PLr9H-Nsw4Tvu2wNBmfuYt_QeMOkF7eAzlOlS9PQs9YdoIzodMQOUT5Fyo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTwvYfJuslVuCG5phG9jrNtzL3RM4zet0U6UvYXq7hugw&oe=6B0DCD9E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye-IbTSJG-sQ7kNvwGMeocQ&_nc_oc=AdqaH7Q1qeMqWrwDV04vFiEkinNTxdaAZa7ktBygP7_o0OsUuklp56Sh876O9sjbByU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCvisbIsRyQ8vvVZC7gCMuuBgn2JDOKTgPkLxrqHkLZg&oe=6B0DCDBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwHynLpgrw8Q7kNvwGD5i_R&_nc_oc=AdrpXJWu3NLY-Ayo6qkKTy6WNdvyWlgvCY-plzMVISMoI25ERSB0Q8JxGM1Pa8dVUJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQF0KqUkPJxNhqP7gr6ekBQ1Nr5_76OysyGCqBfQP9fMg&oe=6B0DBD67"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
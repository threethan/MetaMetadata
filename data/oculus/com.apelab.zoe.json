g", "id": "148906336866223", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iS8AyMwAgcQ7kNvwE7cmQI&_nc_oc=AdmAWt4pcCV19nf0Ve77jLpVybcy1Fc-dNe-qavGm2I51omtbTnxyzituLjR7-k4oC0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfypyAZT6vOBHzpbrWZvHRj5OEBj2tbPc2Mua3r3FFWfOA&oe=69BD3273"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQtd3xOxpzsQ7kNvwH_x0Y0&_nc_oc=AdnofOvNARUlcivxNw1hTfNjZfgGQOxAt4uUIGrSeClDcmQT2BDBW2noDR0rwN0rYxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxw04AjIfk1vWBw3sg6AuUrb4Fp13S7nd5ybOy1ymLDIA&oe=69BD2E9E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMVyqZbycE4Q7kNvwEyQKTR&_nc_oc=Adk0zo63lBXm2DVOXZXVyXxGjejgaB_V4UInA7-o4N_yXpTX02GG0VI0WUb_rMT2R6k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7JD6bfkit45eE3dKtpWEj33Nm5PshsjtW7ax4_EqnHw&oe=69BD2EBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXH3eoS2LQYQ7kNvwEhLBWC&_nc_oc=AdmXd5KB2n5KApqPFA82ca06EP72kd9YLgiLFIR7UXlls8q6gv-BFiqz6-VHkENPVJY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxk7CYAEZN9gOvL4ptUN0do-vufSiDStj6ONo104LTb0Q&oe=69BD56A7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3232656200288864"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscd
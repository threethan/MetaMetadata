a&_nc_ohc=ltanktDoP4AQ7kNvwHpA9F1&_nc_oc=AdomNJ3MPz_an1OCGF2eaLwesi54FCS7mPf_kkXpjR2krwGmGHpyWq1PoXTAWVnpJYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbFX8q5LKxMlQGLwlGzfSo5IIPaE5Rv2JkznaJqjkr5w&oe=6B01C172"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVv0DEq0KtQQ7kNvwEy7hXw&_nc_oc=Adpu1MhJDusHcqP2GRuhRChtbOKYemVxdDI6Tua8OWne-gc1X6cWJ1drd04m0f2zPV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRnJRUQ6XfZxy6yjxPEsrj74hFOzBvg2Z-1ecK73l9vQ&oe=6B01BBB3"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yG9SryuYI-wQ7kNvwEHM75n&_nc_oc=AdqhleSeogE1Oyc055sgo71cnghSqbRDzUMBEZctHFjj7dh647W4lJ8z1qBUILn6Jfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD6BuH7TPQto5NrqfPaucDtohOxSXny_ZfhRXM3t0wtg&oe=6B01F01E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUsFmD4aX3AQ7kNvwFP3uFm&_nc_oc=AdrE_Ea1zdGPH3Ca9ga2ngQD1WOIHgFOe0Je6hcsjWmhPX7U3usNDrISVh5WosM2_C0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS4PVtbBLQq0xl-Vk3tKq_oKpH7E-n8SKW_43MZZtyhQ&oe=6B01F03A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fH7TyIQ8GmUQ7kNvwEU5TW7&_nc_oc=AdpfoCJRn4yvtOiGK-ER0JKjd7MVjIy5bs7IBB2tb7qCzZnlf9Wqsg42VQe_WUx_098&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAlkVUZaR2Zrz2lHIL3X24GF8uM509IC3n44pAOjkjmA&oe=6B01DFE7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
a&_nc_ohc=fCCUwHh4W6IQ7kNvwFxlab7&_nc_oc=AdpBKGaRGVNtwVfF-cl6yBq3VCSAq8JariLY3HC2FFj9JueRXC53c7YKgbiv9HeMMus&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiTSU7bcj2drShR-Yf5wsaLmI9Qu_i1M9thdwZEFVcog&oe=6AFB29F2"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n7gBOgxakQQ7kNvwHZ_QMY&_nc_oc=Adr2xF1_nLtT0lvmD-NQNkWtPk1hEpEBie__p638DZB6IBcPgmxp617bNnCIiJCsfG0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1ubzhI1v9e_lqg3LnfLreAsRq52KLE3bG-TzkXADsSg&oe=6AFB2433"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIRityQrERQQ7kNvwHI8iC4&_nc_oc=Adqoo6v_drfIlPAj-mX7MRT8CiT7cn-MErX9qlxKI2dzo9aX7EVutujC90NX0T7BHq0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTFws2M93kHWs3HUSIvt7_DBoauDNkX7JZE2rOKu-WbA&oe=6AFB205E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWexazcMOo8Q7kNvwGvbpmZ&_nc_oc=AdqJgqAXmaQz0ffm0IJUIi5BlGl8LivE7eYX37aqN8Unec1xESR1ZTxd7HAgkNZ6Yxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgnVcbjdHpMbnnOb20s1Gi4o74EEOP1gd_KyXRLVFM0g&oe=6AFB207A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve_V2D0gKBMQ7kNvwEkBqWR&_nc_oc=AdojzALPhs2otqjjGlmPQdeA77giF5lRsUbnCb7nm23UYWhGQVtAgggthKa8BPFOwpI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4LjdIAJDIKGE34XSbmGs5x6dFkK1Wxy9o1rYTMycomg&oe=6AFB4867"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
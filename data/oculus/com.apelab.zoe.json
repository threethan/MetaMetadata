, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3oldxgUE6AQ7kNvwEb-Z2a&_nc_oc=AdrAKqb_6Bh9O05k9UTF_ky2GhuHh17yvKmWCjaFD3zTcAnel1NU2YKqHiPag1tgJhE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOs1O8i6oc8VMl_wggNw6VrhlfxSUa_ed41rsZyo2qVQ&oe=6A4A7B33"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAjmRgSMxyEQ7kNvwGu04xB&_nc_oc=AdoSfF_tec4bSeMk0R9abOophe_OZHQeDtqK_nb2RRSvkPRt1b6ms_F3b1BK0csEX3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNniYSs1mrbyeKlA43b05ZNsYZOlTtSiq3moM4agmt6g&oe=6A4A775E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbgm6pNipEkQ7kNvwF_2TAm&_nc_oc=AdrNaNZJJVghx9Ga9qB8JTlz23myMdsLexVzdPu5eD-bP-qE3joCIqqN-M5AUVHoeIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8chbMKMNeLmqNybO0nWukqUEe2rX6zS43wqV8BDNfRg&oe=6A4A777A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wseMJ0zlW2kQ7kNvwFmDXIZ&_nc_oc=AdoTa-JXTpf9rIE_9_KxYMpXC--reS9sIotUEq7OsKVLBFwsX7-4yQFFaEwHh4yI54U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB21Lt_4u2KCPJFURPDFv9-AG7ywdOk9qMIrP32KpMMOw&oe=6A4A6727"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3232656200288864"}, "review_messages": []}]}, "cover_squa
, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5rbNxDNhDsQ7kNvwGZ2rvN&_nc_oc=AdoOyj_aUiwTIsZGksfPliFnYgawEB4asAl7FacY0iinuN6QgFAMFeydGtJMN4lLF0M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTBTa8CUJl9C3V-5Bcd50H9ZfNEleHhAd5RS6VQdLtJA&oe=6A972A73"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNLtOBWU2YcQ7kNvwHTvfPW&_nc_oc=AdooRr-05XyiVHvwBTVF_KaMose97x7iZS9J8tpU5vJEN4rdFKvh7XdGlRGV_j2y1Zw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5MgsVsAaqLeIs9WUnp7P6uOjCf8cCjeI_dNYoZv-H7g&oe=6A97269E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kp_4Vw7FN20Q7kNvwEQlJnh&_nc_oc=Adpv43ZMtG52v0RP4zb8YxOaFzpwlXHmfCGKo-PDZHDSMfG-IBi1TXKVDs344I4xtZg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYMOChFzmWHTqkCadRu5wR-DNmSBmPLW3UABwWHoruAA&oe=6A9726BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2tV5OG78uwQ7kNvwE8Xcal&_nc_oc=Adoh8trjibyN89aefYqyMri7UrrndC1MwnYfoe-E6y-UqgWeG7lguMxlVeciN2ru63M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbN8yf-yX51MXpcWmGB2ixSIlNy7ClBU9wW7YLx93wEw&oe=6A974EA7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3232656200288864"}, "review_messages": []}]}, "cover_squa
a&_nc_ohc=tI2HLNk5jiwQ7kNvwHR8Hjk&_nc_oc=Adrh4viXWWBQvLS0BEreDFwkuTI5KbgkAdP0j-MADF1vbxp88Lys5-kiBK5oPhi4ltQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9fYMMplpUgfYlHLLRyw7sPXMueHpu2Eh7lStW3LJfmg&oe=6AFDCCF2"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1UVEVmJZj4Q7kNvwFX5tlU&_nc_oc=AdrZfk7Gx2CA9fX70cS9_PJcLOVgUIUWfpDo8a_KPULBo2ExvTl_Et80YmXVhW844TQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM9TJcX8PDjZZSDp8vN9yI8O0lDvOtyhjo8I_MintZFw&oe=6AFDC733"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIRityQrERQQ7kNvwElwdYS&_nc_oc=AdpMEOj-HKf9VrhNvAheUFMdpQT8q-x_Twcx828Jq0R4OYr_3pNEN6TUZA0TNpMtqu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHbqewDWpOnZCTCvKYoojeBAFh7FlWqDkxVK2824s9Tg&oe=6AFDC35E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNpZAMxisrYQ7kNvwEeAou0&_nc_oc=AdpqlNh-K9hQIy_msEimpOTUIsLp87o16WSFjeaGc76-dS4kbgX-y-1vbBNBPC3-ZNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-MElvLGKLkKqde0W_ClyfnJO_px1H84g3F06ojUHngg&oe=6AFDC37A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcL1xYKw3r4Q7kNvwF6LtCX&_nc_oc=AdrxdS5wxcYv_3iSZKV7-dQso42ynS920pi14A4TIOEzRn5LcePjDLP0QE_BDFd9NKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1l80xvPVkh8suNLsjvgybBL1GZqoL1qvN2YhNsUi3HA&oe=6AFDB327"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
a&_nc_ohc=tI2HLNk5jiwQ7kNvwH4FCTv&_nc_oc=AdogckOO13IcSWhOgi0qSF8wABCs1NlLGiNf4hfsrQGDMLdQ8pk3fR_VUTQwT0Cj4MY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS84PlRhZOmE16wb_G-bs4aUP41oe04upOOC2yC2AdehQ&oe=6AFF1E72"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1UVEVmJZj4Q7kNvwEKkUf7&_nc_oc=AdoGLukOjlTE-kv1q2yDY4ho23d-kg5FLgyIughoHkoiswXwhu2rBuz-6vZW8UUJDC8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2eMu3CKwH3kWskIXH0pKCbVHuHE48rAzJ6eASfkNV7w&oe=6AFF18B3"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yG9SryuYI-wQ7kNvwFMlzDD&_nc_oc=AdqQUMw2X9iEq8yRoK4A03kW8sd6sa0RwM5UcbFykzmnI0BMwjtU7li-uwokLeIWMUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9BOxXDzbvekoOjMQiOKOb-CnzUX6gEk97Led-eKFPaQ&oe=6AFF14DE"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNpZAMxisrYQ7kNvwFQOYtN&_nc_oc=Adofev5XfQYOJp7MS8uvQ7L9wYAqJ-z6EDUy5mjcT0fMgAiMIfTcj2mmSRP436TsQTQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAr60odgONuwi2eCI8EWzBJGDUxMOnpaog5n9CvE5i0Q&oe=6AFF14FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcL1xYKw3r4Q7kNvwHucIR-&_nc_oc=AdrStiBaHCd1mpzbthopMYAVEtWW1lbb8MwTU9VBVeFUB9YT0r1ofwp5VMtTcgbQ4RY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaHUq0atb3cRs6K9w8lqE1QObSd_BBVyH8XKI-QTFs4w&oe=6AFF04A7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
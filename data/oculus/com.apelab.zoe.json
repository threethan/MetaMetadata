a&_nc_ohc=tI2HLNk5jiwQ7kNvwGHGTny&_nc_oc=AdqyBykM5kCWGbWHnKiilIAsBw4M9Lt-5yenfxF9Ny4TFnTVgXg0QeHSGoUWdq8mYTw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwFwlh0MY34TUYSAgfkyDlvtQeki5wvKxRh0fIfXo6Kg&oe=6AFC7B72"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n7gBOgxakQQ7kNvwE4s3me&_nc_oc=Ado4l-2_vl2a21HOaTSsFrR-lznaSMDvwbGfpbhk0SiZap46hmae0vDOT6gB4CNuaIo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3mKDfFO2s-exzJP8sE6liDabGFTpflVn7CSZcEAn88g&oe=6AFC75B3"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIRityQrERQQ7kNvwFAxv57&_nc_oc=Adp7YptJvSIn71B7nQRZQEybcqWyKtciFK70C16cVkUma5Jbbgc1_J0a7YphQQtnMWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9_M6q569irObfjpj_1XcMZxv29e4D16DGEzI9Rm8ecw&oe=6AFC71DE"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWexazcMOo8Q7kNvwGMUuBx&_nc_oc=Adryo583xw1WAf0-YJA6Q3XVXBCBEli7VBKD0_Kyf_LtA81PuarhXQ3u5YvMv15k-Jc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyD0w5XUBtWqhxcpMqFcst5dHchxcUG5HClbPEsKKzQA&oe=6AFC71FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcL1xYKw3r4Q7kNvwFfow_b&_nc_oc=AdqUDMGLim60iV5z4Qw8xuJhlAXDyWRe8dqDHhsvwGXfBAYwlPlrt9bNNpPDFu8kPl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6RsCdUrjUm6s8DZgQEa6pXN2rzSPvFTB5-1fV_dxzow&oe=6AFC61A7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
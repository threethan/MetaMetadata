a&_nc_ohc=ODnwVESenvMQ7kNvwFtKi9M&_nc_oc=AdoQGs0gmDYK94YV5ilNkvc97cKeHWlQhKSKUNQmQtbkLgjYL6oznpWO5iWSPsIGhE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNaDETK1m3TVt1qTedNE5iSwKI7yDmnpDC-L9G9XMmqQ&oe=6B046472"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVv0DEq0KtQQ7kNvwE2sz9v&_nc_oc=AdoOjVm1yF50b_-wYTvx3kcLINJxUqaB4NVQ3k4JUQ2DL-e0kPluT0vfxcihCP6IO4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRldHTWx_qQ5DHQTTTV3HfALoAmJwbMl8d4OYjyzXYoFQ&oe=6B045EB3"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S43B-YyzOz4Q7kNvwHL1JcF&_nc_oc=AdrzxQ0ulhM9MNjjLC9FD0276aW8vMgVqZ3F7gU0hXcMjQDsKBxsJpjdY8TkEl5k4P0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdeRnFhcq6zOCuGjg6_0AZ6S8dx_ynmm6hjUqbhvLxtg&oe=6B045ADE"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUsFmD4aX3AQ7kNvwGspp1Z&_nc_oc=AdpW53pJoZ0gP5VuGil_zM7WzKyT93xlOGfDeyCROnINelP7M2TOqiMHcWJ6P8UP7Wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSOFGYEX3YuS0n4qmbjp2ZSaZNPJlHuyEaDral88CdBA&oe=6B045AFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2nriCaOgTkQ7kNvwFNWk8_&_nc_oc=AdpYZ_TetpTz7Hxj9jRFwDhXZX5aVEW1aYGkKUuV3BaLL1zefKhOopg2vBzVKbZFKWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV7A1NBUb0SIH_wGKsWZ6qiLx_XdAAYg6OnQUcEYVeJA&oe=6B0482E7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9qKmnq8UZwQ7kNvwGMHV6i&_nc_oc=AdoEME6J2icNdLmX95Xib50VCbTQyU1_WlmAdFzmDXZsiQZJ-PgXqzcWDDt9_I90o9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNZYVEgcRLdk3WEjbTY7td2eKyvwKlzTRIu9RS8LXpmg&oe=69CFA39E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z251QU1y-6UQ7kNvwGchCD4&_nc_oc=AdqHA-fFWsCpxQ8Ja1BL-u9RSQ9Z5WL6Yx2hnPSarBN1FPhokTcf6T7aT1_6ZPCOvt4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzN6JXyfU-1il6iPUYHXrWgqWrHd9GBFSmhSJLeSrueuQ&oe=69CFA3BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wA8IcxNK7YQ7kNvwF0iexi&_nc_oc=AdrKyXDoRBxeQt3Ji6qtattb_R1YO_f9UJL3t9lfT25SFwmzCb6ytcgtsm1yFox7iEw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzzl4fonqDSpfKiV_Ygk4yq41XBMDmbxrvzVU91Oikydg&oe=69CFCBA7"}, "display_name": "Zoe", "keywords": [], "long_description": "Zoe for Oculus lets you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have fun creating unique interactive experiences!", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe lets you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1016225925918015"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5384290991581567", "version": "0.6.3"}, "id": "400765734541221", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3942334819110532", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5384290991581567"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": []}, 
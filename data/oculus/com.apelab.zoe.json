a&_nc_ohc=ODnwVESenvMQ7kNvwF2UkqJ&_nc_oc=AdqDCCW3Itz_kyWWnCU2tQyXYNfg5RIPRCFzzquDuWBBQ34S_zKdknl_dw9ZFqGB9Lo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbcmxte3AO6uc6pNYNwN7irMPojQUaKzCfraZb7D5Nyw&oe=6B070772"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txI4IEKeNKAQ7kNvwEfllnU&_nc_oc=AdpiQZOzySeUI_Oxw_OzUH5BUf8wbeEXlJ9IBNUQ29HaMaisgF05kSCyM4vJAsz9Vus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXtgxoJuzz2ACjgqTu9DTHt2rC_4cYoym6_yKM2Ud0-Q&oe=6B0701B3"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrkX8iWZQdwQ7kNvwGiM3YY&_nc_oc=AdoJzBxCPDUWwdr3gEFZjHbNqvb9knATtwBdKg1l-yTwlU2Q663iQh6W0Ocy1iuw6mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzReCgKVCQf2Z2DmSMj6yVX3rCwR1J-xPfm4Va3MKA-w&oe=6B06FDDE"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te7fX-aQUB0Q7kNvwF86mWw&_nc_oc=AdoOEzHHs9PVfICfcPWdWezx6PAO58M6LwQP0gZpk9WwdBtyRZQZI4YomyHWyYdZ5BY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF93LlnmXSHuSIuZ8E0poW2WiJk8IwNTbqEwJ7nEMBbw&oe=6B06FDFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2nriCaOgTkQ7kNvwHVlLv0&_nc_oc=Adpgr14A4zD02aUsOpuV33DQHCwVy5xjtlVgOsOSvJslCYrJBDYmw2QwsXk-PbMnHG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx2vUEI1utFFJcxlp9sopB4SN5qFWv2IzoMC3KsQzChw&oe=6B0725E7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
a&_nc_ohc=mYTw56KcRjQQ7kNvwGaxO1Q&_nc_oc=AdrPaSCOFwTuX9fVt0u4B2bZ7JQj24b9FHg0R6bqaqpoRYw3Py1Q0cjOARR0ebMVn60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5QSAdA-pFfCoOC25KwJDs5ZCTE8kqDDa1Y-Fp2wjjFQ&oe=6B1041F2"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqdSOgl548QQ7kNvwHAQTYZ&_nc_oc=AdqNKLmLM0CAMBCn7eczLahAQmQc92tlXNooFTTLgbJI0chu36HblJparb8r9VXePiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUsfKX8Xt9yi7hkNCj7a9Nb3rFtVtXdSZcb4M4Dquvrpw&oe=6B103C33"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j91Rt4py3AAQ7kNvwEKVNWC&_nc_oc=Adrc02D2J9cIV8mjf2TBhXJu_H1oXcxi0tDle2nXkAjcHf2ntlQUKpSaNOgToXff5j4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWY8jTbNU3P385Znc7I2pzQTezB3fbMU8DLbY3UYEblA&oe=6B10385E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye-IbTSJG-sQ7kNvwGj0ycu&_nc_oc=AdoA21Zt5i_Vd3sBZLzhRZJJ8KuUumB2Dgwhoslxv9b4SNP6pN_zum5nU32XXktqSgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3XaxxGM0Yb6t_bCU4wO-NF5jUP2UU32s4JSQzQDINwA&oe=6B10387A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeORAC4dsjsQ7kNvwE8Cu3f&_nc_oc=Ado4c_JehYx1shYLx2qzFDbfK6Mxlh1ydK4JnKeWVms2-QSxahqgyYUBSy8mb4uWgdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSJ9esUmGFvPylwqRIfGuHQwiyrAoI-7jkiwLoSFJLpA&oe=6B106067"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
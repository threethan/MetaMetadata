a&_nc_ohc=Qhmh651aaeoQ7kNvwGY1Ocw&_nc_oc=Ado1mD90XgaoJuHezxZgt_hSk1IGRS5gAp4k7ib81tmu6QOARA4rCOPZakm1erzFTvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUElkDTcvk71TDjk-_Q1hMSgJSmm1BjagmODlEHUd9BmQ&oe=6B0EF072"}, {"file_name": "zoe_screenshot-3.png", "id": "148906336866223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_148906340199556_3165788232647768629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqdSOgl548QQ7kNvwFlLJdw&_nc_oc=AdpGxJkVEBZ1XTEhHYd14ipYv3xkxzFv1QxvK9IHOL4GxvC7dlVXAyYLae-jok5D7iM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrPeQa4wisauoiWu1XSiN4z1cI90SfGkr3JVz44__wvg&oe=6B0EEAB3"}, {"file_name": "zoe_screenshot-4.png", "id": "869225737168298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_869225740501631_5756582629702653090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j91Rt4py3AAQ7kNvwFvDdrz&_nc_oc=AdoiVDkaKkoxr9VroNp1sySsJExvOqwH9Vp0BJgx-rnhZoB9tP9nR4rGrFeJrkzKjFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwTQ3fgS4XzVKIoQGQwVtQSNZ20iNHuDGJJLRb8fpT-g&oe=6B0F1F1E"}, {"file_name": "zoe_screenshot-5.png", "id": "125837079365120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974805_125837082698453_2384884750883875618_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye-IbTSJG-sQ7kNvwFtyI5D&_nc_oc=AdropywUAdnpVxxNAbwk1lf4KPGMQwJ44n1YjXWXdsYK93e0YPad03erhv1PJfT88Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqWL9koQdOVocDexOdqzkymNDIXX4JdNgOV9ozvaza9Q&oe=6B0F1F3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image.png", "id": "230716065185448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974789_230716068518781_6784362322810571611_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwHynLpgrw8Q7kNvwGAW36e&_nc_oc=AdrpZ1tsYGdxM6A3NMRjwnoa5MgkW4QhdwgAwOIlU2KG4erCZTl2YjqPlsSXUXPgwEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSJ6lop_w6wcppQbCYVNURv_jqrsrXKyNatCF46QiEMQ&oe=6B0F0EE7"}, "display_name": "Zoe Beta", "keywords": [], "long_description": "Zoe for Oculus Quest is a learning platform letting you design, visually program, and play your own interactive experiences all within your headset. Setting up your environment is easy: you can select from a variety of backgrounds, then drag and drop the models you want from the included 3D library. You can resize, rotate and place each model in your scene, and decide whether they are static or can be grabbed, are influenced by gravity...\nOnce you are set you can bring your environment to live using Zoe's interactive system. Program a full experience using an intuitive set of customizable conditions and actions. And of course, you can play it at any time. Have learning about how to create unique interactive experiences !", "short_description": "Now it's your turn to create your own immersive stories & games! Zoe is a learning platform letting you design, program, and play powerful interactive experiences all within a VR headset. Set up your environment, drag and drop 3D models and set up their behaviors, type instructions or information on labels, record your own voice, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zoe.com/privacy-policy/", "developer_terms_of_service_url": "https://www.zoe.com/terms-of-service/", "publisher_name": "apelab, Inc.", "support_website_url": "https://www.zoe.com/kb-app/welcome/", "website_url": "https://www.zoe.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
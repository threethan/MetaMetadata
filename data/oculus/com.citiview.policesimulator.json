b3FEQ7kNvwFmh7DV&_nc_oc=Adruj425HV087Q6vTj7bOtx0iXw6gWiMOtsB5h6Y4gPM-vnEdmBFZ5NXcGu21k03XH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiwjFQJ47k9yylZbke7HmyVwzNt4hTan36guSiFoe1Pw&oe=6AFDE0D7"}, {"file_name": "screenshot_4.png", "id": "2655686721531765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596149727_2655686724865098_6996128332035436073_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9N1XV1zr_YQ7kNvwFtlKyD&_nc_oc=Ado3twG12eTSTGHZhFn14uF_URW4IacFYZrEdvE85M9byHZCclLX4PjQyPyD9snVJ7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Of2Ny_aZWj3adG2WQ6JODQXlsVEzq_2d-f080ZmVAw&oe=6AFDBF46"}, {"file_name": "screenshot_5.png", "id": "1407386937616649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596168449_1407386940949982_3836257882968189740_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA29FVseVXMQ7kNvwG7IqS-&_nc_oc=AdoGXxIy-098e12E_sC_hlaJx3bD1aVAUO8oQbwowdcfjiuDspNYloNVGdnt5WugRTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFbUk99hxmRxBGuA9GYd5dsQ9tRJo_cKG_h9Bw6puHeA&oe=6AFDBAF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3629033720605269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_3629033723938602_2352044902525554524_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4ZxsJd4-BAQ7kNvwHl7s40&_nc_oc=Adq-5C8FyzmvOyoboZP1m2DlH6G1kUXjUGsZDE7LP7lfxmJ-bhyZ4L76xZg9XCCpPzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFZAR_nDpiTol-TvtTA7RSZEy9eQYkvWkuTcfixh_Baw&oe=6AFDB48B"}, "display_name": "Police Simulator", "keywords": ["police", "cop", "officer", "simulator", "shooter"], "long_description": "Your shift starts now.\n\nCHOOSE YOUR OFFICER\nEight officers, from a patrol veteran and a shift sergeant to SWAT, a detective and a riot-unit negotiator. Pick one and look down: that is your uniform.\n\nTHE 14TH PRECINCT\nSign out your kit at the armoury wall, take a call off the dispatch board, then head down to the underground motor pool where your Crown Vic waits with its light bar running.\n\n15 CALLS\nShots fired behind a bar. A burglary in a blacked-out cold store. An armed robbery in a grand hotel. A man with a gun on a subway platform. Hostages on the 14th floor. A siege at the old playhouse. A drug raid, fugitives in a barn, a carjacking in a road tunnel, a gang deal at a paper mill and smugglers in a ship's engine room.\n\nREAL POLICE WORK\nHold your sights on a suspect and your officer calls it: \"Police, drop the weapon!\" Some comply, some hesitate, some fight. Suspects who give up kneel with their hands up. Walk up and cuff them.\n\nYOUR KIT\nGlock 19, a full-auto pistol, a pump shotgun, a non-lethal taser and a tactical flashlight. Press B or Y for the weapon wheel.\n\nSTARS AND RANK\nEvery call ends with a report card. Earn up to three stars per call and climb from probationary officer to commander.", "short_description": "Pick your officer, sign out your kit and answer 15 calls across the city in VR. Challenge armed suspects, talk them down or take them down, cuff arrests, protect bystanders and earn your stars and rank, from probationary officer to commander."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/policesimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/policesimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
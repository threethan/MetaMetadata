a&_nc_ohc=0W9S3StH0oUQ7kNvwFcdIxB&_nc_oc=AdrGU-QW6youTqFo35VTYk_XdWuIeM0uymMGSz66KS3LIiV1qN5Ol2ehj_I1Wnm2nZ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wthmyNl3s2dsndEmChBkXCltiJDi1RajTqJIrVGtThA&oe=6A341E3A"}, {"file_name": "JackedUp_20250513_181711.png", "id": "720647357572008", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824511_720647360905341_3823266666833784202_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhTt2gozZqUQ7kNvwHE1yLJ&_nc_oc=AdpLpRP_5-U1zzTMGzBc228J0aqVXXxgy5fNpjm-ve-_tCMV_8hHww4G1vSxfFx-K-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OgAnVdTTLbd9E_z_4Rmh3lr8RNg3TEEtkYl8hvOvZTw&oe=6A341D85"}, {"file_name": "JackedUp_20250513_181658.png", "id": "1161743835726553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819407_1161743839059886_5392943337239903514_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tkk2JJU158UQ7kNvwH0y9lX&_nc_oc=AdoguAbayBmYpX8raI6hd40BL5o8g1eyThOZsOh8IwKDB47h_roqb-qPfkaSDKuPrVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DVXss3Zyetyr88cfOLCzcAPRS_aeXxty-iwYU-ov9UQ&oe=6A341A6E"}, {"file_name": "2.png", "id": "2611270892565892", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825050_2611270895899225_4588291758968959665_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_yv_m1zkM8Q7kNvwGW6071&_nc_oc=AdqxbHYq4fH83_47nv5zyYCybhgxJK3IoUia_3QA3wSCMDtPOK5k9zNETEULMkx8y0s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9odLIkQ1_qjNjaw4rirzI1nJGHIFZsnuEpjQ5TgFyeEA&oe=6A33F7B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "920940793641928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619588_920940796975261_439691258731673726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSz7-6mBFcsQ7kNvwEXSlZM&_nc_oc=Adp4JrarVSS2Z5G0VA2Cn3Z8SIAQj_Pb1m0v5GQMPNBFHgyXqIcnGRHR-Bru_1OEsE0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bUoSwzx2Qs9iRYliY8-KSidO562TUNmFY2GbNw8GSgA&oe=6A33ED02"}, "display_name": "Jacked Up", "keywords": ["Platformer", "Comedy"], "long_description": "                                                                                                                                                                                                        \n{1936317393815725}\n# Think you can bounce your way through a tower of shredded animals and protein-fueled chaos?\n\n---\n\nYou're a jacked rabbit on a mission to reach the top \u2014 and you're doing it live. Bounce through a brutal tower of platforms, spinning obstacles, and shredded animal gyms while juggling optional Bro Labs\u2122 experiments that crank up the difficulty... and your viewer count. Keep one eye on your phone as comments, distractions, and hype flood in \u2014 this run is being watched.\n\n# -\n# FIGHTS WITH BROS\n{1099961415042126}\nShredded animal gyms: Meet ripped frogs, dogs, chickens and more at checkpoint gyms every few hundred meters.\n# -\n# ABSURD TASKS\n{1585105415801121}\nTasks, Challenges & Bro Buffs: Accept dares like carrying a motivational poster in your face, wearing ankle weights, or drinking experimental protein shakes.\n# -\n# CUSTOMIZATION\n{808836478335650}\n- Upgrades: Level up your air control, jump distance, bounce streaks and more!\n\n- Built-in selfie camera: Use your in-game mobile phone to capture your reactions as your flexing rabbit alter ego.\n\n- Viewers & Live Reactions: Build your viewer count as you play!\n# -\n**MESSAGE FROM OUR SPONSORS:**\n\n- \u201cBro Labs\u2122 reminds you: Flex responsibly. Gains irresponsibly.\u201d  \n- \u201cFailure is temporary. Leg day is forever.\u201d", "short_description": "# Think you can bounce your way through a tower of shredded animals and protein-fueled chaos?\n\nYou're a jacked rabbit on a mission to reach the top \u2014 and you're doing it live. Bounce through a brutal tower of platforms, spinning obstacles, and shredded
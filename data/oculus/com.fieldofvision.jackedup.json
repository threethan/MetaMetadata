uscdn.com/v/t64.5771-25/491818937_1592818998772861_5111415756695992036_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WG5Wm1d5wKcQ7kNvwFsgKSz&_nc_oc=AdoMndHeem_Sil70aPtvsw3OAbibCUP_rLVve-3w9Jda-5gVcctGxK_4mJrv8p_qtmQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GneRVNvXdzMsz7rJi_x9ukh5KApgeB8NmC7swSA2RCw&oe=6A341765"}, {"file_name": "JackedUp_20250513_181711.png", "id": "720647357572008", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824511_720647360905341_3823266666833784202_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhTt2gozZqUQ7kNvwHE1yLJ&_nc_oc=AdpLpRP_5-U1zzTMGzBc228J0aqVXXxgy5fNpjm-ve-_tCMV_8hHww4G1vSxfFx-K-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OgAnVdTTLbd9E_z_4Rmh3lr8RNg3TEEtkYl8hvOvZTw&oe=6A341D85"}, {"file_name": "JackedUp_20250513_181658.png", "id": "1161743835726553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819407_1161743839059886_5392943337239903514_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tkk2JJU158UQ7kNvwH0y9lX&_nc_oc=AdoguAbayBmYpX8raI6hd40BL5o8g1eyThOZsOh8IwKDB47h_roqb-qPfkaSDKuPrVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DVXss3Zyetyr88cfOLCzcAPRS_aeXxty-iwYU-ov9UQ&oe=6A341A6E"}, {"file_name": "screen1.png", "id": "1284094696463810", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302483_1284094703130476_6134306875531265426_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfDJ2SUgcdEQ7kNvwGjpopp&_nc_oc=AdqACu0aKKp5DgYKaGSOU1PkAXr4IpBd84ySeU5yNTz6eZXPLzZTUa5sC1AOHyXYzWM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G5GW-jaSm5MwDR0Wbp4BS5UItEmsbm61xay_vn63jlw&oe=6A3403FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jacked Up", "keywords": [], "long_description": "# Think you can bounce your way through a tower of shredded animals and protein-fueled chaos?\n\n---\n\nYou're a jacked rabbit on a mission to reach the top \u2014 and you're doing it live. Bounce through a brutal tower of platforms, spinning obstacles, and shredded animal gyms while juggling optional Bro Labs\u2122 experiments that crank up the difficulty... and your viewer count. Keep one eye on your phone as comments, distractions, and hype flood in \u2014 this run is being watched.\n\n---\n\n**FEATURES:**\n\n- **Bounce-based locomotion:** Fast, simple, and surprisingly addictive.  \n- **Built-in selfie camera:** Use your in-game mobile phone to record runs and capture your reactions as your flexing rabbit alter ego.  \n- **Shredded animal gyms:** Meet ripped frogs, dogs, chickens and more at checkpoint gyms every few hundred meters.  \n- **Tasks, Challenges & Bro Buffs:** Accept optional dares like carrying a motivational poster in your face, wearing ankle weights, or drinking experimental protein shakes.  \n- **Permanent Upgrades:** Level up your air control, jump distance, bounce streaks, and more over time.  \n- **Viewers & Live Reactions:** Build your viewer count as you play, with chat messages and bonus points for staying entertaining.  \n- **No menus. No nonsense. Just bounce.**\n\n---\n\n**MESSAGE FROM OUR SPONSORS:**\n\n- \u201cBro Labs\u2122 reminds you: Flex responsibly. Gains irresponsibly.\u201d  \n- \u201cFailure is temporary. Leg day is forever.\u201d\n", "short_description": "# Think you can bounce your way through a tower of shredded animals and protein-fueled chaos?\n\nYou're a jacked rabbit on a mission to reach the top \u2014 and you're doing it live. Bounce through a brutal tower of platforms, spinning obstacles, and shredded animal gyms while juggling optional Bro Labs\u2122 experiments that crank up the difficulty... and your viewer count. Keep one eye on your phone as comments, distractions, and hype flood in \u2014 this run is being watched."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Visio
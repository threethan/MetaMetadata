elease_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "9219161834873560"}]}, "change_log": "Thanks for playing so far Bros!\n\nI've been watching you do your reps and I've noticed the reward vs difficulty was not really well balanced. So I've added a new upgraded to the first 2 gyms: BRO LIVES.\n\nWith this upgrade you won't fall as long as you have lives, you'll simply bounce back up. Works against enemies too, you'll smash through them instead!\n\nNow back to the gym!", "created_date": 1757233136, "id": "24610882151931618", "version": "0.1.17", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9440539029392511", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25948299524856534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "9219161834873560"}]}, "change_log": "Thanks for playing so far Bros!\n\nI've been watching you do your reps and I've noticed the reward vs difficulty was not really well balanced. So I've added a new upgraded to the first 2 gyms: BRO LIVES.\n\nWith this upgrade you won't fall as long as you have lives, you'll simply bounce back up. Works against enemies too, you'll smash through them instead!\n\nNow back to the gym!", "created_date": 1757051770, "id": "24592774413742392", "version": "0.1.16", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
ap=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkFwOWZpBmAQ7kNvwG1UFiE&_nc_oc=AdrGlSzpq60Kuymbdc-C5JkGDeu4rxF52fVJGu_vVJFZJY9HDALEMJgr2XY7XHK58iw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkhxV1L7ArPb-HTTeS7KKohG4HsdNhLkrUyeQQ-sCc1A&oe=6AFC672D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1167682141747027", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499294643_1167682145080360_2543075048495261262_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGH9d4fTRMgQ7kNvwFDtRlj&_nc_oc=Adq6UnnYTqeG4Jx4etM0D65zIFHeqzxfYjmGOJDdnWHeO3TYACFFgQ9J5L7Yo8JAMF8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbWLpJGQJ-7JjN9HPDRyhnJE6PXRpnpsys6XSkjndAWg&oe=6AFC6630"}, "display_name": "Seagull Simulator", "keywords": ["bird", "beach", "casual", "seagull", "simulator"], "long_description": "# Welcome to Seagull Simulator, where the beach is your playground and chaos is your superpower.\n\nThis fast, funny VR sandbox throws you straight into outrageous missions packed with unpredictable moments.\n{1806714260006199}\n**Soar around the island and discover its secrets**\n{850433324714902}\n**Create your own seaside mayhem**\n\nCause a scene, complete missions your way, or ignore the rules entirely.\n{1920300625253948}\n**Turn small pranks into full-blown beach disasters**\n\nArm yourself with absurd weapons and experiment with physics-driven interactions. \n{1254649560141516}\n\n\n\n**Spread your wings. Start the chaos. Do what Birds do best. Poop.**\n\n\n\n{1606896797172804}", "short_description": "Rule the beach in Seagull Simulator, a chaotic VR sandbox adventure. Fly, explore a coastal town, complete wild challenges, and unleash hilarious mayhem. Steal snacks, squawk at unsuspecting tourists, and cause nonstop comedy chaos. Play now and cause problems on purpose!"}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": "http://vrmonkey.c
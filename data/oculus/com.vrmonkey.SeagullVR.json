&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X_1ThTvp6Rxgfu6iHImva-MXX4rf5mnGxnAZBDzlfJw&oe=69EA1CC8"}, {"file_name": "HighresScreenshot00008.png", "id": "1237956011698353", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499302770_1237956015031686_5360821474415015519_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4cLY0xHXacQ7kNvwEHh4o_&_nc_oc=AdpcvBalaRxSEiAggdNMy_0l8pSE7qi456ODKqHf0PqVcyuYy37ZdhUtWPnSbVsdJxE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29XK0Plt5lI_CRtmCJGKeZKakXft2L3OAO-QVJ2d-qgw&oe=69EA1ADD"}, {"file_name": "HighresScreenshot00006.png", "id": "1802144740440085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303864_1802144743773418_6179378450494592309_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYF4WcsMAXMQ7kNvwFl10eT&_nc_oc=AdpT9hH3Ka-1C3dvufs0zQPQUQntKcbEEQvhYFebn-gC8avJwOsrrepyub1KMSDFTcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LpaiZY-7ae8XpeseqS-X1fStLRVrJaK1-tOUKBHveaA&oe=69EA2F2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1167682141747027", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294643_1167682145080360_2543075048495261262_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg5nzr0ilpUQ7kNvwHRvtV-&_nc_oc=AdoCGS5JfBUwhfbA6Xd-DciQcSOCrQRZ_Zu5D5zFNtJj-MmTKt8V_XlShTGaIEEUN60&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vgKFccECLAsuc6J9JbZ7O8ZOv93eNOiYtG9rvwo8r9Q&oe=69EA2E30"}, "display_name": "Seagull Simulator", "keywords": [], "long_description": "Seagull Simulator is a hilarious, free-form sandbox adventure where you step into the wings of the world\u2019s most chaotic coastal creature. Glide above bustling beaches, boardwalks, and seaside towns as you hunt for food, tease humans, and turn everyday moments into pure feathered mayhem.\n\nSteal fries from unsuspecting tourists, dive-bomb beachgoers, snatch shiny treasures, and unleash prankish missions that reward creativity and mischief. Build your flock, upgrade your seagull with silly abilities, and discover secret challenges hidden throughout colorful open-air maps.\n\nWith simple controls, dynamic physics, and a playful tone inspired by classic animal-chaos games, Seagull Simulator turns the daily life of a beach bird into a comedy-filled playground. Whether you\u2019re messing with fishermen, racing other birds, or engineering the perfect poop-drop ambush, every moment is crafted for laughs, discovery, and pure silly fun.\n\nSpread your wings, rule the coast, and embrace the beautiful stupidity of being a seagull.", "short_description": "Seagull Simulator is a chaotic, comedic sandbox where you become the most mischievous bird on the beach. Steal fries, dive-bomb tourists, build your seagull flock, and unleash feathered mayhem across vibrant coastal maps. Simple controls, addictive challenges, and endless opportunities for trouble - spread your wings and cause chaos!"}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": "http://vrmonkey.com.br/tos.html", "developer_terms_of_service_url": null, "publisher_name": "Roo Owl Games", "support_website_url": null, "website_url": "http://vrmonkey.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25828444693414667"}}]}, "scheduled_off
sic or with it \u2013 just choose the melody and beat the drum when it is indicated.  Try different difficulty modes to get your skills on a whole new level!\n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want full body motion version of the game. Or you can play it like any other cardboard game in any virtual reality headset you like.\n\nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "The Drum Smith is a first person VR drum simulator."}]}, "developer_name": "3DiVi Company", "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "236495205318947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162753_1497432326999002_5236504589200523264_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=row61__J-DQQ7kNvwE-Ed0K&_nc_oc=AdkHmozQ9LJxa2edcZ4rZcEDHtiAv5QH1lcvi6XIaUfHuhGgmgw8PH51ao1b0ksNwzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs5nBS6vQhvOZNM56hKxqdKqIF_ocApADfkRuCAiSvh-w&oe=69A44C24"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drum Smith", "platform": "
, "video_trailer_thumbnail": null, "display_name": "Drum Smith", "keywords": ["Drum", "Music", "Drummer", "Beat", "Drumsticks"], "long_description": "The Drum Smith is a first person VR drum simulator.\nHave you ever wanted to feel what it is like to be a drummer? Now you have a chance to be one!\nYou can play the drums without music or with it \u2013 just choose the melody and beat the drum when it is indicated.  Try different difficulty modes to get your skills on a whole new level!\n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want full body motion version of the game. Or you can play it like any other cardboard game in any virtual reality headset you like.\n\nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "The Drum Smith is a first person VR drum simulator."}]}, "developer_name": "3DiVi Company", "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "236495205318947"}}]}, "scheduled_offers": {"count": 53, "nodes": [{"status": "PUBLISHED", "id": "408879460314043"}, {"status": "PUBLISHED", "id": "171861363737286"}, {"status": "PUBLISHED", "id": "352630352132697"}, {"status": "PUBLISHED"
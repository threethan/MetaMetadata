_4p1fHg4nSZOMY5f90tkKSKdtjarsqvD5B5aa1qYax42TkqlJutTMeubyYzmDwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWyWz7fJs76L0nP5Mt9Vj8bXBp28ev1x_jA8XMFbks9A&oe=69B00608"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyucSpyDmMUQ7kNvwFF4EXj&_nc_oc=Adklh5y52z_iNw7dJRcaKjV5oIlbN7XPEbj3XO9d3559dzWoeZcmio-0uQdZb3jGfyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrBC4UGhFC1juMGejAQ7boSdpB2X928GDa85HwE3nvFQ&oe=69B00251"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQ1c-oco_iYQ7kNvwEguvZS&_nc_oc=AdlpFo-klySrTvQH4CSRKFZRqlvCAtewYlSpNXtolIKH4KtF385U6JWjxlt81myf8Y8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCgzAOjFHnAmrRABhKjW91uo7P_qiVKHFSaCxE61xSxQ&oe=69B0168E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNAv5V0jQ_IQ7kNvwFYdgWz&_nc_oc=AdkFUX2SU4vhd1NCcB11PMbmFVUTltGJQ6kydzUpEUHNwks1WCTcPwXvUff2DO71VM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKfBrJNKFYiP5t1d5oU6Rofu7eK11PqTIYerNn8jP7Gw&oe=69B01221"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxtbk--kH1oQ7kNvwEzw9a7&_nc_oc=AdltgFSZmUtKiSe7IQ9k9YvcaKVOU6utgsWNQqgAjYV7Ye-E8NoC37dTy1pzAB1lEho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-RlNCHENfy4HnsxxK8RXkG
_LGxL_MUQ7kNvwFLSG7o&_nc_oc=AdqcrbjPU2K4_U-uG1Sfk13SCrDjPDvHIhSpStTOMinAYHw6-LirssPj1s_whvw4iQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB6BZgsTtac9_NJjAW9EhcV2FfKmyKA1Du1YBxkda9xg&oe=6AEA0348"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MUaPVXE1BAQ7kNvwHlCUPT&_nc_oc=AdpEzW3FUUW49S2Qi2FEzMvk09orJzSRwgitTi5wEBl-e8nEOh74XUVVFLk6vFRIPKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe7dWLqyDr7Rt0W9lA2aozCWs975vCRokxV-tjhfvyzw&oe=6AE9FF91"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D4fR0BIv_YQ7kNvwFrfxoW&_nc_oc=Adq6hU5YSGmPAJ1R1uOExB-80C93xBK_K4xItBlHTsVDEinPM6ObuJVYi8h9Pr1nBas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvyW9tF5BZkcqQDF_T_dWf-UM3FzBezOB4-OKhn9T1pw&oe=6AEA13CE"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHXE6KfXprAQ7kNvwH3JRzQ&_nc_oc=Adp8yJa99dm0Typp8Pwe4Q4Qx6d6mfEzn3rcFykuJY5L_sygsd-H4G6iY8D_FhVWkJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO4b7ZLyDjU7Aip8uaetz8Gnw2DUFNCX51z_GIoVPsXQ&oe=6AEA0F61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc_tc2iGDwcQ7kNvwFOOysx&_nc_oc=Adr1JeTo1-PudYr3HG9Gotj5LEzRx2MmPsj1MesJsidG8R4vfh0xrMpjyNO4H2qbIm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculus
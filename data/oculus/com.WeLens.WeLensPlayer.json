HCkD7eX6vXN80gSZisIVw3APv5vLi3vx_2aEZOo9Zo2VAdQugWellrNSjGxQsos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwX5pNqdH-GB84-AaKHl8uX3hzmGI24Fth5XVtUk9V6gw&oe=69AD6308"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyucSpyDmMUQ7kNvwGE-EzP&_nc_oc=AdlJophdNd6ck9UA6u4sMa4mE7lfQzzy3FZBMxuYDRUifaUAVDHI0gX90hXJOz6OC9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRk1dg8XQ7OFrLrzhhHwr8CHq95E4M3vkNqRTcU04_dg&oe=69AD5F51"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMJP4OijITAQ7kNvwG2mvPa&_nc_oc=Admg_IC65KV5Lig4LViYbNphcj0FZnn0cABT8bkT3y0yb-i0K1bVeyclU3oKA6Hpnck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-I__2bDazZ7qf8li6TazKWsRUky6ZCTs3KYX-ZZuA1Q&oe=69AD738E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNAv5V0jQ_IQ7kNvwGPE7qh&_nc_oc=AdnaowjHlch53uSd_qTcyGbyIzc-CFwbQJSIX3Xi4QanAjdG7tRbTkpBIZe2CLAS2J0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNu-WCAtPN7Spf68eqacUqKq_ZRhIREEA6lT_iEQHffA&oe=69AD6F21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxtbk--kH1oQ7kNvwERAg_d&_nc_oc=AdmX3EWqtnI_4vw_-KLnh5hjerVCqpzHjlFR33a7wcziQVrabFumnMxKn317qFXC250&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyznqDuL1tuPv-OQcQpewBoh
_LGxL_MUQ7kNvwH2k4vP&_nc_oc=AdrxYxuOJZiLv56BZse4NYKdKpekhwzzExNe6w4WISdblqD2nO-mbPO8ucofKuq-EtM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKbSVWrsCy0lWbHRPPUoV1eBTeqEDveLxdDezCkmcOKQ&oe=6AE8B1C8"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qYQw9X1EKIQ7kNvwGCzuuL&_nc_oc=AdrKcz6mTQ20IU9a8FGyp-OFVm14PZErPM4r-metIvio_sfVIMljLPL1zg3gIN9WDGM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfC5AoPa1n-RAxk7POUTqmlTtygHtg5Dxgim1NDw0vvQ&oe=6AE8AE11"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D4fR0BIv_YQ7kNvwF4jmK0&_nc_oc=AdrUcXV_TNwKNoMVgrdLxsWpaZcWKgNyRUfQ-brNT0fmbh2sVKM7XXOJCG4NDUeb8uw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeqD8beOvFyZHAsjxFakUkUAiXlOhb1oqNG_vITmfBrg&oe=6AE8C24E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL9LnNDm7r4Q7kNvwFHu3wB&_nc_oc=AdrLdmHSN3cCfUUZaMXSg5UtdB_Ox8OAGoKoQJF_3aFfbKS5l8CJEtfuCKqI8OjX96A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlIU1o9MUxuMvcAZAZmgAeSINTRi_smvryjUfYyeoKYg&oe=6AE8BDE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-m2Ol1GmqkQ7kNvwFXYXL-&_nc_oc=AdoHs_QcWg58bebdz6GBWA4BUVfYfRSHKZvBXcs6lqiKSwV4fj8VZkC9Hr3CoO0yD1I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculus
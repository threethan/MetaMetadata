=6e7a0a&_nc_ohc=I0tAdXak0b4Q7kNvwEehEsz&_nc_oc=AdnsJ7RLZ6UfErjgkQ8cMsazlbU-4BqPNx45nqTjGSQxhhvgBmH5fBKdYXZaHNXaVuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHxeTCnnhRC_-pqJgnb1_THtja2l-qUqIpFmu_8IbAUw&oe=69BBEFA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "173254806638033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482378_173254809971366_288475322431569920_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQk4g71mIUsQ7kNvwFrPlds&_nc_oc=Adlrr1Rzn09hfCu8Iy4s4nS6sSB4KJ_13sfqnQzJm33xNVZvuguFp8cExspT5xM71BI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6i3KOi_J4Dlso5oQyNF1v_GZmJ1fnNF5irnmc0C8ChA&oe=69BC0959"}, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publi
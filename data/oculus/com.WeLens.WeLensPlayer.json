&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv2diXJKkKLCuD1NDcITwL3F1P-VPkUNgaSo69HZQY1tQ&oe=69A18588"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yed4O3SKuUQ7kNvwGhLt7M&_nc_oc=AdmYvbOPxl3mOPsQ_51WLPPaZk4H90UduiU88KFlaKQwVuwzmX_WbVIenGz5p5TCRoc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftstsR5GGZBCCBCfRb2ScTrTvrBbZF3QU22FbNmDrWF8g&oe=69A181D1"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=995LMQePYtEQ7kNvwEs4Rt8&_nc_oc=AdkVWJHJOHG4Glst5jH_xZwVYfxVX9T3zllLZRlhWGjrjvzEM8Aunnt0Q3GRIf7WYjc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft0dol0l0DFV_7xz0l_aiilioGHu8Cv-juLkjOJIMj1aA&oe=69A1960E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_N5QPK5fScQ7kNvwEdGNm1&_nc_oc=AdnM7sbgUZ77S8kDSeP-uNQkxZ6o88aCnFGhDGIY4dQxV6Qu7b0NA-f_agIrOBFO4ig&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvR2Ug9pGmWpZypqjGSWmakMuB5SJv6xKWVQMGHH4t3Ug&oe=69A191A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5CNcUNEbikQ7kNvwGHhNiz&_nc_oc=Adn1xJY4NRO_1fQXj0IlZjaTm9YdU99ROxkd5xnCUTab-5jkurRgpDdn-2t7LQEzHKY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvSpl11yBoV9mrQQkOQ51kPdIgqA-p93MyHgGr5cXgYmA&oe=69A17BD4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
bfiykaLrbpj0weGDFt1_ZC6PiTkVNUDBdmIeQLlEVX7rIVdrgqcDSr1dqAC3cMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysbWqCaHb1a8lURVvre0mPMHA6Ceif-NdJez1yi7cZ8Q&oe=69BE8688"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrIOdiJJ4ZcQ7kNvwFk35-R&_nc_oc=AdlQ1mtrF_kQdxp1UcOssFpuG0ZxLRDUOEyV7Psx7DavEj10778IFbBgBdpm-uz47cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOk41gygd7-TNZqFZUiA9OiwCtaGRO2vyVMM7SyQWc1A&oe=69BE82D1"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGQxqBi5EaAQ7kNvwFVHGUX&_nc_oc=Adkbi0ZlKOASm2w6wq-2lwMSi_9dL270X4bglBsf-Ls5Ru-VvrCg6szctg8eCyMHZJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz81ojf-GQMHe4W87e-35Q8wa-mBmEx909AJ8oOo326ZA&oe=69BE970E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tXWrC8n8aAQ7kNvwHFzrsM&_nc_oc=AdlMgUZBZbG_1m0EwzK5f0KB9d3vVmHPFSuuG3k0vCCUOc9yDyCNGQWf9ZtH_jwZ9qQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5HYY5AXUVo44a6E1WOjf5wX-uqHqI-YCoh2o4YNGBKA&oe=69BE92A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WffQCUpZOHEQ7kNvwFhk5DA&_nc_oc=AdnBhNyzslYJnaYScUGCEMRaQwFdtVEj8e2QBZHKj_02uC5Vf25l2pUswhvGdp7aFjQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyWTyARTnJ7UTEx3UEPZ94W
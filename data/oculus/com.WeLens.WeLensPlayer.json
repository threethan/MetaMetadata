=6e7a0a&_nc_ohc=pifZD9EqePAQ7kNvwHi95hw&_nc_oc=AdnaN-6z4bDEVVo4gXL83-nrS44gr1P23VrI1ycftR-u-a2a41tvp63S1LRVKfSk3tU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft4aynwV0NwsLF8lBkBwRv2vhis17ltTqNzkIVYOz-3AQ&oe=69A97AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "173254806638033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482378_173254809971366_288475322431569920_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1oP7Q6aMTwQ7kNvwGq23di&_nc_oc=AdmMvEX3UDzOcuD2wIoEJ_RQzhRqYNrW3FYqUaAFzUWVa7eh8VHKPQUDBqKVH_FgYoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvmJY_5kYtEuCD-jIYeMbBG267QV-ooFW9wr4eWHWB4eQ&oe=69A99459"}, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publi
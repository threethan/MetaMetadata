com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKF5i6uHOHUQ7kNvwEh_oK-&_nc_oc=AdohcOsSMpELczVFdHcKVN4IENBOvjrVFC5MVRFZkl2lufMeCrVast0Ze8_9kMrb7Tk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1U9BRjuIaGcJ8BLUuepcLwB-U_WPa3LNP7PzSPoDCCTQ&oe=69F5F1A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "173254806638033", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12482378_173254809971366_288475322431569920_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAaOGVkYXgcQ7kNvwG_Esxo&_nc_oc=AdrT3MqoiEhar3GuRcNmqSiV0Fp_hSDYurC6iapsG703c8X2V-BpYul_va4TX_ummDY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25Q9INx0_Tz33ZL91X5mXo8VbISH55Rt0eloGgvhyezw&oe=69F60B59"}, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": 
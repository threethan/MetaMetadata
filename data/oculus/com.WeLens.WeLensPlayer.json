&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1cSK39vQxX7Hh4KdocjW8zTh6hSn-sODu2nKNnzSej0Q&oe=69F09F88"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzDoZYYMW3sQ7kNvwGFG5bJ&_nc_oc=AdpnSEPbttEEjbdfBC90xLNLXONjsW-DXBF3z789w8Tv-AvK4OIF1RUAs6O7khS6vNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1WEzPwgEXK6HS8tdBz9SX7F11M4Bflz2aoqCFYfnVbiw&oe=69F09BD1"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLR-2qVMHJQQ7kNvwHYugMD&_nc_oc=Adr8yTwVFz0lvpoKYn8UZSjY4EiEpCrpmwKRIiP6zWFr-2Bq4cjRUPp7mzc3NRNrj64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2VvIn60nmFCaFn-zJjQ032PsWGdy3L-jWkMgYZWbzJMQ&oe=69F0B00E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dplxy5ypQC4Q7kNvwEppM8e&_nc_oc=AdpzODLnlGjJHnhcTUp2b-k0EJY_B7v0AxksqX-m636poOtO_-EUor6-QrDpbEefr3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1KTdKUuPMZYc4bAg3hTqLDI7BE5IyngxgPjkC1zHXFMg&oe=69F0ABA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKZRoPUrGtMQ7kNvwG8tgMP&_nc_oc=AdoAC8t2qDssYwpGqe1QGIa7EptCnbTgf176Q3u9YUn2WJkpfO3nyDuCCRdxLrvRWbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0KxPgzHFTn6IeEBRnyP69lRFZFd1BLvvbaDKub0WObyg&oe=69F0CE14"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
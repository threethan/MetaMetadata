e": "migrated_image.png", "id": "2685855598317060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410280_956152624550139_598722950778060800_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKyh13xZrskQ7kNvwHx4q9O&_nc_oc=AdoFmD2uZ6gy5QHHON4RsvQtC0OIWE8gKRt44K2zep87Y8G95h61us1izyyWlsKiggY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVubhTmr94-ALUpFtrKbwotFdH9x945vUYeq1Dc4s-BA&oe=6B0C4A48"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wSJ_haHopIQ7kNvwFxSeXv&_nc_oc=Adq7zjh_BGtXRQgx_DTXsm7M7tVKVV-qpp0QC8wJsztW2SjHUvcOQeJx0TsWgPRarOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHPawtySYorr79lejXrDvy0TyjtCM5sRi5JzbpTywo4g&oe=6B0C7ED1"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhSfRmdQ7VEQ7kNvwFujw9L&_nc_oc=AdpKoupfg2gc3MPpDOF4uEguOPxS3lwJcIFcmeQRW85hXBkNCTzUFrbXShlIetiE4Fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0IBEHzwrn-Lj5JVWhQbo_5JqK2Is99AuXA8CjZYyGAQ&oe=6B0C5ACE"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHAOQG4biWoQ7kNvwEXU9kt&_nc_oc=AdqRWdb-nq0qmWnvfYPhw22lfia9C8H7K9P1KA5eAqk1mcAndPaV7EK9CmU0BABLh2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUbYLm4A18mnRYIs_KeTC-ohrUK5kZti5YcDo1b7JCgg&oe=6B0C5661"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"
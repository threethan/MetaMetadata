8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pifZD9EqePAQ7kNvwGwdWAJ&_nc_oc=AdmYANgf1_6xLMFwBfLZNrF0wWEz7LIrJwEjZ1HQmx-qTsHzphVFqgNNNAGmTtf48A8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxapZfNwW5whLSsriwJNzGkzb0NW4ZAsiQfltN6ojd7xQ&oe=69AACC21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "173254806638033", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12482378_173254809971366_288475322431569920_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rD2ES6d_sYQ7kNvwFhnCtD&_nc_oc=Adl7i3pP2cXBpDpP74p2wLSQAa9lIwNFcE-blCTDnU_eXPn1lUaDRHsd1xQvOs0Q6c0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxqjPourxBX3H3MOX4WDjVKu_ZBGFKLJbFn56qTuBPdw&oe=69AAE5D9"}, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.
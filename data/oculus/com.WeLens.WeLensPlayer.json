com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_gvELTAe0cQ7kNvwG3N-eS&_nc_oc=AdrK9CpsZ8i5z7mvr0cOKg4-PenZquaYK6wkZG3ZIdBb_XyXvmxDCbWUsvWlCMG7Z0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qu-Vh8X2tou49UKB_vJT7C4shvyiZ7n2reXF2YHkINw&oe=6A314521"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "173254806638033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482378_173254809971366_288475322431569920_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FevHKR4WZj0Q7kNvwHvBVru&_nc_oc=Adqrer2AzEQ1E8gzFgSaq-GGu1Ulu9fF72pr4ywNMDXtXxJI9fjuyI2P2dgiho1K3mk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rK61cM3ULAY2Q4qgJlh9M30RDhOSm3RaDyCD_ZsylBg&oe=6A315ED9"}, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": 
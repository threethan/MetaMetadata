TvT4cSO2NipvovvIcIw9eRUIzzV4ffc37yl1zSeGQQMgp1yYuP1ZhYsVbEHKCb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy1LExI9CxEe46jwdn0v34syxpIkgqDzbthRoHICxWPbw&oe=69AC1188"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFlVMr47ifAQ7kNvwHsOTqu&_nc_oc=AdnCfVkxNKJcRNYTL6F1uIqqx56NtzamgNLtnnh6dPYaZEd-3asyS3iH0aM58bBMOdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjDjsVcP6qacemcvsHKKEarA4_AL9uwtyfTf-JjtqRkw&oe=69AC0DD1"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMJP4OijITAQ7kNvwGvVJrt&_nc_oc=AdlfIYIcm14GgrWbCfmvOuSgAJrNrrgMK2uAJikOpeNeQBkfAr11g5Sl-P_9ERb1FCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxP4jqgi3B8trnuqNwcWEM1fxiileQfGJ0WP98AcqwhaA&oe=69AC220E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pifZD9EqePAQ7kNvwHRqqYL&_nc_oc=Adm2DHP3Cv3bbod6Szr_DHDf9yHXOb9Jv2PtbBquaQp2wyJETxbOgbKCW8IT4t4FLu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvjWip02ZdjtFt9de022N9_IxuP-OrvqAMjxU__r2P6w&oe=69AC1DA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V0ZyR-pBE4Q7kNvwFbHwv-&_nc_oc=Adn97pc4pCMLwwbFYyvI3jVYXGEZ3BHmaR_ccad6RqYOnF9LTMfq-t2tMrthAX3BOmo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzONqmnBHBpmzzBhE2HCTAVq
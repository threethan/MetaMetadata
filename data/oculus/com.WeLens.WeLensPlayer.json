e": "migrated_image.png", "id": "2685855598317060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_956152624550139_598722950778060800_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdZtbjeQkq4Q7kNvwG7ZwgO&_nc_oc=AdomfQ2oEMnTbXhJX7jlVz5J4mMhaZMgCxZ-wAjr1fCzQU5cM1LLtnmL-z48B7FCAwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWdtQanz19XBhQF4Yj7iEULFNM2V_6sOwdmfl5XmE5uw&oe=6AFDC9C8"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVUChENKJOMQ7kNvwHKGKop&_nc_oc=AdqwxgImA9H_Aabv3UcYaZz6h-eAxmU77fI3RfOdBbuqMTVHQF7hTrOsWyu9iiGE3EM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5C5pVAmFPwvyfSJeeTRuiDTz62_ckN-ju_wnu_8gS-Q&oe=6AFDC611"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96n92cRf8c4Q7kNvwGvOHk2&_nc_oc=AdpxLHriGqPqUYdePoSgFYvkiOkHuxCyFPvKO2UwT2nNUebq-6DqMTo55mmdDhf0cTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Ko_i_85IMEkdGJ1zgJyRdCFgfV6reQvt3EITCj9hAw&oe=6AFDDA4E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aUpyYzzcHgQ7kNvwGUV_9c&_nc_oc=AdqbGWV2uTwD-a24SMmP41Qkm_X-6brvHgB6bqwrlm_p2H66omc7RNaSr24BWlEzwPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJie1Jo1a6R523mQQ8sHlaRA_tT8Ya5HQROcCsc3-u3A&oe=6AFDD5E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"
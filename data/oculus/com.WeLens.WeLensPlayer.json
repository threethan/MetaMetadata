0T6Nci0Ep7R_BGYg4QdmbXvhfbSGjhMk2nUcI5ebL8sn3QV04bSmkESwnfs050c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy69Eiw2NVYzMcwoGhQhsRWE1TiKKiav45VnBD0gA47Hw&oe=69B3FA88"}, {"file_name": "migrated_image.png", "id": "590680628202392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12534016_139432116867180_1642843678122704896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYKLYNLIaRoQ7kNvwGDiY8d&_nc_oc=AdnML_cUWTzvUrDwVNcgVTyM6xTOJT-y7MkF5M1oL7by7wV1bfVR2K3IfByC9JWWRN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHLs4D0iRCldg3vg0XJNf9jWeD9kZIIPm_hKyzxdjFlQ&oe=69B3F6D1"}, {"file_name": "migrated_image.png", "id": "342473686708504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139031_148169215899155_5024626920411627520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJOeK58jOPoQ7kNvwGdL8rN&_nc_oc=Admrk_WkdCHlxRCocfu9NjoB5KhBqoVqAsWZpDgZg1GIAHAFrPbkVgjvfGS8B7or9C4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNIpZOPNLUYNg0zOaZzJYZSO4I3lwwwwHfl-BBs-0NEQ&oe=69B40B0E"}, {"file_name": "migrated_image.png", "id": "327628094868336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsCevHYozcUQ7kNvwFNhlTg&_nc_oc=Admmpi1OH9KJOSKuA8RJ_HwXy3ZFHHl1DQc5R2a5Fmp8JicK7H_AO3UZUlxHi8UiP1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXSbPBcYEgshoIIltMGEi0lntwcSq3GV1UbJ68zI50Sg&oe=69B406A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": "http://www.welens.com/privacy", "developer_terms_of_service_url": "http://www.welens.com/terms", "publisher_name": "WeLens, Inc.", "support_website_url": null, "website_url": "http://www.welens.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es", "fr_CA", "fr", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "646708609904846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222940_2615054845438439_5862910043015348224_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOr6dti_ecUQ7kNvwGY4ryE&_nc_oc=AdmV9K7vv2Y1MmhJPrtpRLuHJDkiatrOjJ75W7GOrrw3QRTrvWvhOM7T3Ys7ryh-cl4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzaka0cKyHe-iptIWwQSXpth
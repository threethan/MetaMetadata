com/v/t64.5771-25/12482255_319330811907499_8106333089925431296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-rQ1t7ZTVcQ7kNvwHBSiDI&_nc_oc=Adopybla_tBhatlDMWJgQVmU8maB7MkuF_qITROzS2v_NW52yun6PRhBNIcbSOLEYBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlr5ey16AqNFcnwFXSZ3HO1ENubrPWCKB-80Ha4fBOnw&oe=6A903121"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "173254806638033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482378_173254809971366_288475322431569920_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ijWL2yn0bIQ7kNvwGKXzvV&_nc_oc=AdqYbL9yJsDOkq__k8SvjoDqhMMquz7_7e8g_F-Bh83qOcsDHtTTvSDxjcaBuWMtxl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOqAx_gB0XTJqR9VpNmWorTOY2mpiTkYYLHUHcODSROg&oe=6A901299"}, "display_name": "LensPass", "keywords": ["WeLens", "LensPass", "Video", "Cinema", "Sync"], "long_description": "Use LensPass to watch and share 360-degree videos, with support for 3D formats and spatial audio. Pair LensPass with the accompanying LensPass Android app for more capabilities including: \n\n* Monitor and control VR viewings on any number of headsets over WiFi. Sync headsets and get real-time device battery and temperature levels.\n\n* Use Theater Mode for streamlined viewings where all viewer controls are disabled.  You can customize your screening setup with a short countdown sequence and other options to fit the needs of your VR screening.\n\n* Add your own logo and message through the LensPass Screening Dashboard.\n\n* After your VR screenings, view auto-generated analytics reports that show include the viewing completion rates and other information", "short_description": "Use LensPass to watch and share 360-degree videos, and pair it with the accompanying LensPass Android app for more customization and control features that are designed to help share VR experiences."}]}, "developer_name": "WeLens, Inc.", "developer_privacy_policy_url": 
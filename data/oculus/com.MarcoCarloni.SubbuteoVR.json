vY2&_nc_oc=AdqX8o68glfBe9wZXZTF1sjaCZp62pJobkyC-ZQ0USCcVMETDopengtddJrzfQ_9RAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qq6ggU7J3rT8EqQQHzr6mha1Gt7sBH-hhR-WdBITFaw&oe=69E0F30F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVgt7lxDBQgQ7kNvwEktaHW&_nc_oc=Adq0AJ0_6rjmf1tb8-4tkqxTWZ9TmsgxBT-CvJxNEgqZ2xjISYvse6q37DSCYzQehPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YaVy4xwfNiO5BDshj28cyMr08pB595ILWaOLgxNKKGQ&oe=69E0DB74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5Em3KppdSAQ7kNvwGTAZy9&_nc_oc=AdpmMkRn46XjBYErc3CTtPqsP-Y3IkGbQRbgeg2bjLoKj5jAnvxMl6tC5jwvwMlSouY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33GgJttCqkYvq_X-C_wBd8NsQfUS9dD8o_mPMyERBdpg&oe=69E0FB9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E3zRVONC8MQ7kNvwHn_qmb&_nc_oc=AdqtB73H43ixS9nCxGPrmLhmMwbd_PYmuGXmtpKlh4U7tEF0bseRgSyq2Ig48pY1L24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vb76UtYESkLLV7x1diH1pMKQmCTs3t76qy3TAP3Zp1A&oe=69E0CE3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g30wmpMP-5gQ7kNvwG2Chg4&_nc_oc=AdoDMiYkIJgZ4MNXBFE7_72DPsUw02VgJIONeWRJ5FAoQOuOB591dJ2lSKWQTEtmWqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lRqX0n08rcBERhUX615qaObC4p2cN8uMWeY5rc6y97g&oe=69E0ED01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
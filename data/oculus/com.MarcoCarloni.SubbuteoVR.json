5r_&_nc_oc=AdqEtftO-UOppQEzUAyUFJqiDR4uYbj_05Kohee7Diu78Z6C3TMexm9l_hcFwqP2Pms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO03WH5tde49knmn0j8lC_pBcA_EQzArAZQjyZvRjObUg&oe=6AE5FC0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXF7ptNXeesQ7kNvwHcfC-h&_nc_oc=Ado3V3rKVL4nl836Ra3i1pPxwc8Y2gZFUcNCpAuVeXcNmeJvCrX9UINhMPXZfvtKgIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvoPH9FQLd6xL6ulMm_u3b5ynMSd0sLK1UX9MRul4FcA&oe=6AE5E474"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALrGxJlYRR4Q7kNvwGIrwRC&_nc_oc=Adpp7Udpo7o-_soCbv93g8c3zgw_F0zotncGn6SkktwTHjQkNc9ZxG5Qfupjak3yYVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsI0YnDNGpHPPFdp1dm857ktZrB9TyT7df5XNVswJGmw&oe=6AE6049B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VeuSz3KbAQQ7kNvwF2Awly&_nc_oc=AdoNCYa1XjM9THeydpQ8Fn9A9imCQCr8zEP_DWdHMivuHUHrkPFAGs3SiQjr7Qv08ng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxVgYdDExEU6cJw_hueqQves4i1dZo0DvylUwwocnP3Q&oe=6AE60F7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocglUvRiKBYQ7kNvwFunQHF&_nc_oc=AdqByUJFhLmaqd6dDId_FPCq5orOMYC2zs8o6SZoFIoVbPiuLmBSO84oGBlv5zhsO94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvSBmQSg52MWbIfdFWaz3-1zfIm8YbxXZQit82f7T9Ig&oe=6AE5F601"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
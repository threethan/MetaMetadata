B0d&_nc_oc=AdpO-valXyiXvyRtZNaWN0oz2Jl0aRTQ6GHz3lETGEzegVRvrQMyvSNV0l-7Axf2rIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pi7BeSOgZ-3V-n1muLnAS7sFgQ4BdUXUzSpSNhWhOsQ&oe=6A41308F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0q3ZQR9oRUQ7kNvwFC7_bL&_nc_oc=AdolQPrenG6t2sQed2rxCUk-_Et7Zfoj8d2OYJkgrdb2XpkDgwAbqZFURZwe9zFJzSo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82kxNMVzk18ZtdTtt8CxpVKGE7rZF1RFqGnXbWPsRXUQ&oe=6A4118F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeUoAYHmSIIQ7kNvwEYS6La&_nc_oc=AdoMY6mBWC-AA58IuB-E_TnynO6-24vt9dE4fDA2Uma2MpR9IwkknrV60N9Li2Za5oo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K6LZ8yelYxq0E3hfFwhgnXBR_iNZWc2H3ANqRlryqIA&oe=6A41391B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JKJ4i3LQ08Q7kNvwGHkhSS&_nc_oc=Adpu5vur0tui8Z5OluX6OiR1GH-qaxGi0tbjLjcMqzBAqdLo0DzoYZC8Rdi4I-yMzAM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jXNgp6_NxO14SKmXPNEt1H2A6P9wko-hpXLPXeQH3Nw&oe=6A4143FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFx1KnR2V7AQ7kNvwE6RFH2&_nc_oc=AdofXwNocLuuJ3n3Hn4qsEVcbUvX5JpKPQn_IY_CXydK91bWrSpm46Tc7X6ZO9UCqyY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RA2fEfouD3aF_EbL4eYL3FSKl_5wHmrMJdVRxNgi0BQ&oe=6A412A81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
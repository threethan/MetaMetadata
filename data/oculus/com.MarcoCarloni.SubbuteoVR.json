6I1&_nc_oc=AdpL9_xBbw6JFEDdIXNKDQHEmNneP34fApPVSxMCypvEkksRzE-n-iFHqKIDh0NRqS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR6ymcrylSVLQHiD3FJa9AXUHkHoYepAnT3VIt03A_BA&oe=69D1210F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3OE06we9l0Q7kNvwGmKafJ&_nc_oc=AdqwRqdJXTQ2ePTkw1x1Qc8eJVQqh6ePdsBGXdWXnAU5srWxKacmgxyL6ou3cd1V9pA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwatF1uywYY8mJ1At58ef6jSxOWBcTAoE_W5JPCavO1QA&oe=69D10974"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCu_VR02KtUQ7kNvwErCNjU&_nc_oc=Adp_eX3aZFuP-P1614uTDt9CIPQ6hIwkDOdY_qU4rMaFl4zW-FuI9cKfTGIDuJ_xN6Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtXDXn3f5pbMWbtm1cDmewUHIGv-du4lujiazt_lf8AA&oe=69D0F15B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFcg0zhi6WAQ7kNvwGeHKsM&_nc_oc=Adp8Mnq72TTVUkw8xmp_xFcGif_utSxxut1EZrU-stKnsG8b8eM83KhpAPKJB0niSus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ8Rw03nY9RHqfEgmPJGdbj_gN28QDnCE--udot6PteA&oe=69D0FC3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWTanu_rC2sQ7kNvwGoUG60&_nc_oc=AdpHfBDfkVKlLCqoKlbQxTNAQ_Ta3FLimMbCa_ft30DcBhPFx8HsbvZ9kopLgiygnyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFowAaQ2HLPJNK2UCO0sJp6sY5mFM8r6RKeID4M0LAig&oe=69D11B01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
gIG&_nc_oc=AdqVcMCJ-TvSm4LOjQI_-_tKiXtor49oVYjp-ZNfXvK2WUUG1dYkPDUFWFn0ZsZ6bww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-33AaYc6yzHM-DvzkVd-5YYnj7rHGE38EOXqNdwEzfsA&oe=6A34018F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyJr0SfogUcQ7kNvwGuPXJ7&_nc_oc=AdpjGfCgdVAF7i6RZPjWeQA_vuQ1p-ew6DHV4p5NA5EbFx7rrkK1ZkI2Hz-VNAtllsE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af981P_u8RR_Oc7jPRKA4oVAImzRNTTmKEYS08X-2hRkMg&oe=6A342234"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggViFEfrJBMQ7kNvwGhojQR&_nc_oc=AdpjkysOI-K-k2PMaXb9S_YkyAy_u7Lxrj7OlL_jQTE3InUzCvcs-2i7VM0Q68wWucU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XgUF-BFnUr45MEBWZMNPF9F6TQT4B1ssckPxIWtt-bQ&oe=6A340A1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFCbH9qjddgQ7kNvwFAuX7u&_nc_oc=Adow_cYLv7A_6cD5x-pnm1PGhdWULVRKkusHVjgwj4tT_tonIwfetx1lvU0G0CWXqy0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_avoO3OPLcYYk0mrRJd8EMExF0d4GjjbDOAf3YPG_FA&oe=6A3414FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jau432WHte0Q7kNvwGV68g_&_nc_oc=Ado3drjt3TZ4W0ekTHgZxqDrW7cwG9qzJ3cCXqUdVQ2b2DE9HTnmRr91oQMjM5BqJZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PEa3WQuMc_k4BNcpsIIOYEe8isQzKcqLvZbm-vrDDOw&oe=6A33FB81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
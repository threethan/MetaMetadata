9hh&_nc_oc=Adp9LX58I7eMG7XHJYpsiA_kmkpIKuatwBN9uS9sWwqVyZUBLRoORlKXrD32JAOjAp4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeFiJd3qiqNs1IquYkvUAt7i88_dULb60WBnKmQpyLoA&oe=6A9163CF"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJBVcIb4yoAQ7kNvwHEOOSk&_nc_oc=AdoavWb-MSBFRezacGR71D1VgUompVAlbyolrSq2tvw7a_1e6Oq5ROhdetRQZxaUVhI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzvmOD8r-Q9yYJI9CnPc_kwO9fJKHoJObgu9PHaDfctw&oe=6A918474"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRUH6MXI_pwQ7kNvwFyODNo&_nc_oc=Adqrzhi8kKZbDVeJtaAOWXArp_QtiknuwEJJGqo6UILR4GrFdnyzX9vs5vijQY9Kxnk&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2moU9j1qnktzhPsUMbf5G0dUtWLwEtMcPddYdeu7vBw&oe=6A916C5B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWYr2tPEXaMQ7kNvwEeDTuX&_nc_oc=AdqG6TONKA-QkvcF9rOtCBRcOvt8ecWBXa_-AXQ-LzjX1wE-LeZekvKQNotFa--_ras&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLjcI01gToxp_ihAYiqBqWIJL3-HSKK8MpPQ8f9BRtiQ&oe=6A91773B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xI_Ee0m9mgQ7kNvwF3w-AY&_nc_oc=AdrwqKE6SKtCiRNXFHDabiz6f-jidgXZEXXkyE_Lk8O6QFv59UOEKMlJCmzS-fIKf2c&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYa7eO_9jWHK8LOF2Tu9-MubNNlPbCiUbGJjCBJYrzvQ&oe=6A915DC1"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
yl3&_nc_oc=AdpM2uxAyl5Ua5DtouceT7ljCN7qLFVaMkaEYBZkK8EEFYD9510c1nlArhfrmjMvImU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_td3KuOXpDPjySx4Z3FbB8h7bROtiPR0RayfAxcVgCFg&oe=6A3A990F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ru0GgcNa1YQ7kNvwGvnIBJ&_nc_oc=AdpchPqv0J5F9sBPxe9M9DZpZfoBGbM6CzsrPgSVq2GwpoDtzs3OgzcB0g5idBJ36fo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K26mK8L68V-bpa_nLL9p0ux4lWVMFqF3UYAu60C81KQ&oe=6A3AB9B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QVsC9_8mEgQ7kNvwEMlEm2&_nc_oc=Adrm11aZE_isWXrSSGkBUU4whil_oDL38YS_d8YQ7PD1fa5Su6hNyuxf4w_tOw6zSmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jtMz6EHuX-_SeI5UfBfpCGfnc2ScjBG32E1XM3KJecw&oe=6A3AA19B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApOc5-_9bxMQ7kNvwEt8ObL&_nc_oc=AdrW7VhWPrrNXeEtZGZwt8zllR-RisjtpWS0VSRH8abuf7qzEheRBdQo0-zrFqFRGgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2784iQqJf8Hn0o2UiCjEcMs8hl_s9eLRsA6q2P5T15A&oe=6A3AAC7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jusSoxDBkqwQ7kNvwGpRpPr&_nc_oc=AdquyJEm-d_-Vs5qIndjemwr7i1JARenezFbYwmNRg7CCvxtDoQOKoLNGHAra1nw-gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IQLctQuLSExCTmMZziVRuzyQjQ4utkhXgfjB_sp0-PQ&oe=6A3A9301"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
ixv&_nc_oc=Adqkst7BB53JY7uOQuHiFf4ywNkZVYtGf_Xtrd0-D4I249iB7PtLDyHMOaTXpKF4nws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZVHDtsaGbA_7rqNlJDR6-wmQ2AGlgv62VqKFWVcuNdA&oe=6A6E038F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMGJOhuL6RUQ7kNvwEu84Qp&_nc_oc=Adrfe7m2UsbfAKc_pV0Gbb44_5zxbpRGbesy9p9lwGTxKnEpxhytdANy45oepF3lS2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBmGTKZ8SY9fiOkX2mNe3hXikg-cYzsrwKHEfRNYER0Q&oe=6A6DEBF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEKlzmNyFmYQ7kNvwGrQ8Sc&_nc_oc=Adp45s8zMF8md_4MArIJTss0nnYtVQW5ilkEk8DKc3edM10c5H9Pu-69DVY_EnWZSzI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA0TCS4cNR6cZp-nCGg9rt-m8XXK1DmdW4Kaovm8aAmw&oe=6A6DD3DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7Rk1Os9K9MQ7kNvwHBGLP9&_nc_oc=AdowtTXdxNGpCPpOjkAvtUvS9j-Nt9AjcOkRP3dlonhrkdlyYCLKfP9NZRul2Rm5VwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeXrEcEsJwpS_izDFzBzmdGu5fHih6Jcz2aNuPdkyvBQ&oe=6A6DDEBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-SUOxZyYpwQ7kNvwFjD1kp&_nc_oc=AdrmzvhdveXaFDszZgINhQ371D9SFPQpWFjZN15P6t6cy55AUP3EGisIBs_abk2ns9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAltDcAZCjhZRlca_OU4SPR7g2cy_vtm2U1uXkom_gC_g&oe=6A6DFD81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
-ry&_nc_oc=AdoT7yDNuWYNp6t4TLC_bfDxaeSBFA9Sg8UClMmpVE-Z86CIKVe5MBBnhsk2IfqgypE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKVwMk8hINAQ7tRJzqXnJ_13a1HRRYQrEb4t7nRlfs-g&oe=69C9380F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xKWhJ38myUQ7kNvwH6Sdok&_nc_oc=AdqYj6233k8Xc4K5Ri-YQg2yiGsRvBVNXOI7T49xNxhMC5aOWlvf3vNZpr4935VOAss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg2LoVX4VTLjB8PJD83gKHa_W7pdqdM-kmSbFG521ibg&oe=69C92074"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4-dBTo1_F8Q7kNvwEYyjIR&_nc_oc=Adr4K7ThrQhbJhfHJQH1Ftx1YcvWedmELnwdCgnFyzhJkLtYi0AFOoxdcBew6hs722A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxuuz9vqYgIVw3FJT2vcbgwMcMVLPULx-aJpyz1z9SetA&oe=69C9085B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSvOiQR4iY4Q7kNvwESe6C2&_nc_oc=AdoasnrPFN2LrKO0W2uBq4kAG370BaZNme3nXtzaQLt6_XuMVMv7Yz3BuB2fnG4x52A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx39pWwBNwn64NZUh-YiqPYqco76MlbRIyGpsoUGxG78w&oe=69C9133B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIDZUKLUbdkQ7kNvwERMLNz&_nc_oc=AdppdoB4IldjuazMMYGvqBu85D5cDc8K8_HQk7Km3VAkcDZw-bELl--6E-bdsSHZrbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVbVYjA2wuS2BP15CGzxUGc6nJrpk2ZOHaS-r79E-t5A&oe=69C93201"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
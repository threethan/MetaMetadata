FQZ&_nc_oc=Adpx6saSX64pc-rq5ixwaz6OVFiA2GqnRnUSwt6uJwQomUINhj0X6-sI1tDA02Ti05g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHV2_F8d_aSYDXIwKD2z_alWP19AHESsGHIoUBImLuhg&oe=6A73498F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itr16t1RojsQ7kNvwEGaP8C&_nc_oc=AdrkghqOMgt-KrdWYUiHK6Z2FDmeJudHN4mf6FCTwc_9gPHMnNCdzapvrXBmafDO5dU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPX6fJMWasUJ2_Bi4-ijhR0_joeoj8QS_brHp6NXbEyA&oe=6A7331F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvzep1MX_8IQ7kNvwHsXIoq&_nc_oc=AdrzuVMxeV5_su3pq_SIMXbkkIv6v4YmKbuJu7YQRVZLCzywsQvjiXNCckmVljCLwfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmsN16B388FHgnz5O4xx4YRmqOwbeVdoU1a2Dq6SPiwA&oe=6A73521B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKZ0UA6eLTAQ7kNvwFP2OI9&_nc_oc=AdowxMN6PyiuSU6JS23s52qV6i9erp7mnLMua_whFtH_LDWSeeO_IMrHcUVVcT3tnkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFGBo01jTh0MH4KJBINADKxKXQ-QWlY9knajRDdkO1bw&oe=6A7324BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDNa3KCKkdUQ7kNvwGG8qoL&_nc_oc=Adqkkir62YvHJaA1IP3bP0Ibsblz0MMBnT--DHtvm21gKesHaPh2byLccS1OxOYsocs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSH9TjdyJEMPo9RuaZBxJ6R93fTNjTwsCHahz8xNNCzg&oe=6A734381"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
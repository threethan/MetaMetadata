01S&_nc_oc=Adrq6sebxbmxB-D7lyAM61ICWf-7yXk6MKmXCgFdIcKRD8WNyUiOM6Uvjew8qm7UNK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LP98EB9Y1DgO_5ZLk4GpVfRuG9SJwKta7YFih-01Zgg&oe=69DCFE8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjVIxCSLiYUQ7kNvwGndlhQ&_nc_oc=AdpLJnrEcUKrPeEJlCxVtlqfyLzaaIX0pRChUrpVQoCI7JbPK2uV_OgJEBkeNS7FjWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Uw9Yybj5YbVX2889L5TdWzLLf5D4p7f6FL717mLVjwQ&oe=69DCE6F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhI-l-cCfHUQ7kNvwGLPwng&_nc_oc=Adr4erThDAw1h1FsNzmUL6v9cpHEMrd_t18fSYsLGK3F2AJWRQOBJuC5gjEZXGlq1XI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01B8K_e-7FiTbfHOS-p_WlT76HDGHER_AbW8so1osyNA&oe=69DCCEDB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a38SfloWoEEQ7kNvwFnKvBh&_nc_oc=AdqFWIn4jEVrSs7QlyRsOzVoH2DYBtFGFLo4eedbFM4A8njs60on-QHu6BRPA2_j1X0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zZyF3K5xBdrJRMyXVgUsKwPxFrxVvXQbn7Lqtf4clCg&oe=69DCD9BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcEQivrdGFEQ7kNvwHC9_nF&_nc_oc=AdpHf7U3P5NXFecwCOfkpLJSl3rXCSG8iOJmj2oynrq6ziuEbw_iCK743WiHPDStBxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TT5c88YHnyNAhANetiq0JEUVyYiPsDsEfZqTXOOPuhQ&oe=69DCF881"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
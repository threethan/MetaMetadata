CjQ&_nc_oc=AdqqoBAq4CFqEO2jH4tob2rGS-iAYqShx-O_vT0FmealAjV94Qw881oZOtKWHTeZe-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CrAFkhNdJ3iawqcSxuCkRxazH-nCxZIXscwA_uSGQ4Q&oe=69ECD08F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sD0bdbIKUHYQ7kNvwEAgbf3&_nc_oc=AdotLCCzQ41Ij1ulx3pXQpobeM_lcuykVlMr_nO42OgsnKvhSP563cPU3VGf5ZQ_Y98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nTmdF8prOGPig7MqMeRusUfEa83hjrry3LV-FxFtkbw&oe=69ECB8F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5Auj1lTReIQ7kNvwF1BRQa&_nc_oc=Adp5vwhBa0xiIuXmb-sH2bSc_jiFj8--gNMSE1pkhHiRWXSV8iX-6Vtgvftnn3fD0Jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zYd_f1MX3GWn9rdHkN4IdZYuuQHo3TA0NHSUrhqDJ2w&oe=69ECA0DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Adm4aBEtHW8Q7kNvwG5HGUK&_nc_oc=Ado0q6Os0DP0K7avWppMx7MXqDw5ji7-cnmxTdvDjhRwEaKJz7Hp_ERsUgOV8oRwWoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Mr4yOBKgYAJQumXvo25P5k6bp4J4gv4QUcBPv1r4mJg&oe=69ECABBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aSgTpQKWlkQ7kNvwEv4K4z&_nc_oc=Ado107v1bryCEiGWpwsT3gI_oFV3yb5VoXBQNCCga_GomM1sKP5nY3kuA2xkMuT49m4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r-oLu8SRnhlRA6LKa17BzUZgKyEEz9UIe8_1-DxQGWg&oe=69ECCA81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
Xj4&_nc_oc=AdoVaer2YifXm-jG42Zy3ArUjZ36tJoWep1XMzJTlPFciayyY0zFWA_it0qXzGyZwng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZbFPCXSGCGhzahTzzfv_BmbARYXG7oI929zFbyMO-aA&oe=69CE7E0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2IrgMFKTjwQ7kNvwGWderg&_nc_oc=AdpdAQCIEivMmEN1o1kyPR2LWDe7tkQvjL-NepTGnFOqz9OQwHmdAtmBgXgHtUbih8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdl4nD0Rp6byBpaTEi4j_keq1bg7HaXQt21X52E2Aaqg&oe=69CE6674"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skfmiMU-9PkQ7kNvwHo0eDg&_nc_oc=AdrPro-sTgTUNSzENwFjZTVgabU8iS5Uzn44UjIIzi8_V_5-Wdoh-4VyCpmJ8hqqPzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEKKRDWq_NAtN_Ia1i2Nzip651HNCJZVYsJKH1mpNJpA&oe=69CE4E5B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFcg0zhi6WAQ7kNvwEeQ2gm&_nc_oc=AdryzjiiQV-OioHXac-lZio-C8Iq6-E2bysLcfPk1Ts-Z66be19N1Xs39Sc_lkswz8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGPS4JDsFb8zPqB7lUQFCRTjHtfML0VKuFPTAoSdyKlQ&oe=69CE593B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfGncm8wxTQQ7kNvwEvEQ-G&_nc_oc=Adrww0c14vzWOF35hmG0cEYSnR0k3RKlKTM0qjNdDmlQ7fxPo7iKcvKOWkJZ5PBnBKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqCieJkQakLyk2RXEfarEWZEmCwc85-EbbKyTZ273_rg&oe=69CE7801"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
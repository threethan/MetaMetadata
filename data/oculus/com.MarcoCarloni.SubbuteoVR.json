aI1&_nc_oc=Adptf8H92U18YxvYgcK6gpdD_6Zq-m43ux9AcP7Qxj4R11ePDL31UOUrUgqlIoTd0EI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPF9JSA7xb3psTTkYGe7TYJgxU1Qxm2-v9WJReqS497w&oe=6AAAA88F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LEQYuw0FckQ7kNvwG5M6uy&_nc_oc=AdoclRCJ25Z3r-BKtM1JdxvOpjLFyjpTx5VidG0k3FMy323STf9xuHl4-9SGlr5VZ1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgHqTvDe8_hSlBribcfq5A4Y2fFjpMzbhx-ISBLn6HrQ&oe=6AAA90F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzNNeU4ElVoQ7kNvwFa15dP&_nc_oc=AdqRXFWsKHv2pmDvrh00LCA-sxfbM6UwVZ04iJZvTV4LZPS-_Hqxk4YOXP-jzzNJFlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJC3HfiX5gvPt_EXIWq1oPxqFE3mRvkaIsW9n2_AXN_g&oe=6AAAB11B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwTuwpHFVeMQ7kNvwFa_stn&_nc_oc=AdpLdBHSU508pHUVfLeFnMUvi0Mk5c8Yx4aLZtkAoVYstmS3OHNZFd5pDnwNkkZ8m4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-1TOS5PJ-WZ7WECgVCF_XgHCDKDj7Nl7U3svqeUx9Ow&oe=6AAABBFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9g7h3UOepkQ7kNvwFPWpJh&_nc_oc=AdryVxusP5ND9ZIyZgdR6zTk0y-6Q-RlZcoupWNKQuJ0SZHL9PmhXY99Ewp4tEF3CkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_tfyQNvJY08HruCnelJu1b8v5k21X_P3g5BYtkcXr9A&oe=6AAAA281"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
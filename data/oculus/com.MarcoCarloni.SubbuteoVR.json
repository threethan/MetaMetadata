RMv&_nc_oc=AdoLewEfS4wF4wzjvpaIJOGYGA_Zw8-YTZ202mAr3g8O0GbKrOYRbhHkRxVv1AMGZKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JU--FVuHVAh8VL69Y_fw7WmjD0Nf8qANsQytEH7xAJw&oe=6A130C0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6yycllzQLIQ7kNvwEkATpy&_nc_oc=AdoXGKG_mzpTl4cdAftlPKPpexFwnEJpixqOR4Ri5ctlSGDKsYmv2xfjBDdj48qhfd4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7afYRfW6l0pAzRb2CW18dpf8dcDllsbEP48My2cOiQ9A&oe=6A12F474"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbdj7-PpPk4Q7kNvwFROOee&_nc_oc=AdpDsUcj3DYEMPl8CRlhZw3wOzly24z0t7VWYWcHACw76MuZ7Rj6HQJc43TKhPSRR0Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7utyhrQokmdQIi6OCjDm7h3N0KCjSLwLCcHdKoQoietw&oe=6A13149B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oMRJmkM3wcQ7kNvwF4M9BT&_nc_oc=AdoiaicKtAaotkGijf0uGHKp-3WaLY1OEjB7JQn5s4jl655iEkCXtPhrRkAKZhdR8wA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EHBplTDoVTqqR9WAKoycbV7XCNXcn7Cmxcyatk6qeOw&oe=6A131F7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4ftCNiQ8m8Q7kNvwHAXdI6&_nc_oc=Adq_3CK2zL-C2JBF8FD8PsF5S6UYgr3DKT7AV2Pync3oThBXHGPFin5QM3irS0REmpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hw_JBLuSHZY6cV0TQCO6nJXTg8Oq_0WSGFWcucR7VOw&oe=6A130601"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
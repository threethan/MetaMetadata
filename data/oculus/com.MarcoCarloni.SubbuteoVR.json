3FZ&_nc_oc=Adp4KP7dxNefRwy_4pdtaKZHQCjkX14iY3CFLZau-YAKbIFHSI-qciWZ1zNy5rw5gZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0um6875eX4nb7HZjKPbQkuR4G27b3jGscMEq0fhrEsrg&oe=69DE500F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjVIxCSLiYUQ7kNvwGthpbS&_nc_oc=AdqKTgHmvp3VJehTVk0a8G40ArZJ5H3y0_JFYmCjojhn4xBvycxy4coNuyuAv1JewaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ppzPBpmVRSJo-MGa0dizt8CkacbiV5GtsUkDJLGsvxw&oe=69DE3874"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhI-l-cCfHUQ7kNvwGMR_Cu&_nc_oc=Adqc1cGiNwElSDGMnlogsK3YM4dk1O7sdyuor0Jdby2puqeik3rrkhl7ed4V_MCg3CE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QfgLY_wev1fJ0N117pWRtIvr6g-OFQOrdTBGXW_AKrQ&oe=69DE205B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E3zRVONC8MQ7kNvwGjo7eP&_nc_oc=Adq8SrbhsvIls0Lcse0QwOXjPDqLBGReVkv77ccNbiN3JZGdSmc2JXOm1zRAObb3o6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cxWSunv5TomFDksAUAEVpaKD92boo5dwtkwuEJo0rkA&oe=69DE2B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcEQivrdGFEQ7kNvwHpFjUE&_nc_oc=Adqh3yGRRQisCXhaaZDsCYcZEM-zdk77LdfP21_fNO9U7zGT28Dz2xx0lbFMaj_lO4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_xO9ubXOC5RJHGHDmhOmLYnlHOMpDTb60IVpL6IT9WA&oe=69DE4A01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
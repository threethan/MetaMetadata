ds3&_nc_oc=AdqGo7B970LIyzb0CvW3-w2BaVAOlEToUhbslRKAZXoNv09jPB7YUAeMGpkW3-q1OjQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmF6jhXlrDdYmnK6j1Dxm_hl_OqDY97YqsojRkUUvvfA&oe=6AA01C8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ktinB54n5EQ7kNvwGA7IyC&_nc_oc=AdqUtfH5gC8CpTEYh85hvykao-HnHHTVLfX9firF0VbKJbtoIwExluPKmzt26-PwYjQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJXvCdufL0Y1hEKkIXJHiiP6BBh97PfxbjA56ehopJ1A&oe=6AA004F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhWHjFHiAQ0Q7kNvwFWLUVp&_nc_oc=AdrWInF9NleN7t-3F9yW0FK5pATKKMfRG2qpwVXwNtitRuC1GEvitSslIvKAnYR4RPw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx-Q5o66y0xy4nd-iGsiJ4ZlKJcVNwAn8ArSN8o39U4w&oe=6AA0251B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77pE4_cZMTIQ7kNvwGDzSOh&_nc_oc=AdrQQqGadkaKsEaubsyg9QJz-YerH7zELj5yXRPe_BqLSDt5FxZwPcEqhOKdseakfjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_LzLhvCOeOx42NulMxN3l0ZG23EdiFLNHB-hpphporA&oe=6AA02FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bns0p0PqUEsQ7kNvwG6NMDa&_nc_oc=AdpRlGa35mO42iMrH9exFTTERUXFxXoWl0y_TeDvB1hoKDl0B0aMTZXuXa7IrDZXQL0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFETCSdN3To0E9xQKZlWvOs0ORTWmiuACHQDelotNBdA&oe=6AA01681"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
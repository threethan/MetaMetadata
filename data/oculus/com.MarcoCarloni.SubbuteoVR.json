k6r&_nc_oc=Adp9GiH2CvJDoG618nEcC9dZTbGwdGmN-46fgaGAgXMlio3nbeDsUOSH-jZjOK0rSRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBA6-Bv87mV6CN6DW101iiinwrGrB-1bdoBDSRZ2B2zQ&oe=6A51028F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VtQtaAhrqcQ7kNvwFevwYb&_nc_oc=AdpXDlmsyNRJmOt_E-mSh9zKyHwrXgDy644HjYeM7YJVURgpsA8REzJLHLEzJumCQdc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsEc72_rqbt13PU8yqVk3hZMq6MVTJQd2FwFEq6WsGOA&oe=6A50EAF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSqgmKEsGigQ7kNvwFSkPta&_nc_oc=AdoLWYxxGj-wvB5YDkI1rdTLQD7lVqi0rgKX4vlOBX-uZtPl2BghjmluZ6cJ_x9HFmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4QiXBIPRbZRsGAtbzRuQvWzLH9nA5lEffckE7kgik5w&oe=6A510B1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvCxwFMgWTEQ7kNvwGTOo1p&_nc_oc=Adot6KVEUtyQxSl_xIJpomO7LmCxFO7lPhYo0zbnpK201gSRMKHzc7w-ptBHg5I4p3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzErg1tv3s0BFMavh0sDdb2KO_22YDTVjbpSwNVczhGg&oe=6A5115FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2h4u4Q3-SgQ7kNvwHt6iFd&_nc_oc=AdqmcTLtCKJclIhN9yFTY6zUrWfTQWPe0GkKkRvxTP8OLWdPb8bWqICBW1JGMViVH50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb1WuqZjOQKhNjdvYZWbaylT6wVU99pKHzPNoeX7Qbyg&oe=6A50FC81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
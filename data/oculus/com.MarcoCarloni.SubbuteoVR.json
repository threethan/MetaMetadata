vN1&_nc_oc=AdrXm49Nq_YTYzZu5mXdLgjWW_ojNmbGwtun35fU5SG_LO-odkdRiwRYsWTYL1uBezw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6bIES_X114OEJkqXF1IdXMess9HlkmijP3MST9guFrQ&oe=6AAD4B8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IjoTtAS5G4Q7kNvwGD8zXC&_nc_oc=AdqBx_goYaVXvHqKZyh1IiZJcE0f-xVVj8AGZxwpwTm5SF7QdHc1b74lpDBWbPAAXGo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKO2k8UIlc8hbXCsUGF8xv7znd8wEP130nl3NG9q3iJw&oe=6AAD33F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzNNeU4ElVoQ7kNvwHhnSxc&_nc_oc=AdrB1gA8WjDN-U29KM-D8IR9PrpW3zHsU47GbttTKwxzdUHmb-4rzVrIqnI-wgu6arY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1yfKsRYzMWbs5nsj4EV_UcrrOIl3xn4SWTceAE0b9Xw&oe=6AAD541B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4DnLpy_ME0Q7kNvwFeN7O4&_nc_oc=AdrJNBw009p48rrsHyr1cUFr6X9lYfCG9m_Gn1DevLARD1AfCNZxBuG_sQ5sq9pmmUk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3X9e8oWTdFNaUpg3HTsUc0ltC1KVMbZdFZnCrdFA_Eg&oe=6AAD5EFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTEt1O8-V4UQ7kNvwFuuyZ0&_nc_oc=AdrwQLbDCfgeSvuc-Dz8GM3faxlMhvpj8fxyMmaWmI46pmpD555BwoL6cculYvT788I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvNivOhgEmxEho9Z_DrejNJjpRqrvYsQJPoSa2zDwvPw&oe=6AAD4581"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
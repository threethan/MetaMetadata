_I6&_nc_oc=Adq6p9jOIB7fs_qq1TPCx8Rq0Xo924ReSx5k810_XJW1FIJbbouJ9sLCdiJLv94Yxj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zbiCVhi_rYsa5DZXFvbZJA_IkL6pTv1YwzrpSNS5u5g&oe=6A28240F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roEXSpVtS0AQ7kNvwFYbtks&_nc_oc=AdrorARgQvHD8X83kM0Tvpb3BNzLHZctaLi-4c86kdbjE_mKt76_XITcvqsA2dFDbbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tfGMaSdilHkisK2OTVizLFb6R64_Q_LC5KnvVvpnfVA&oe=6A280C74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blApB4q-F3cQ7kNvwFEc0By&_nc_oc=Ado1dYNcpSNxN7EF_J0jq87S7EXTxWYlhZimm_38hg3MGfKD46Y_Rs2GMGITVpbXpTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uivMtm1vRkvxonkljkYGDe5VPTslNxOcb1F6_Hqf8ZQ&oe=6A282C9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHyGdagqlMgQ7kNvwF6XQe3&_nc_oc=AdqQFtGtgn0ibtZ9-j-YujAaviOCMUEsxTz1LQCqXtk5uXX9PpzKDazrGvir2fOxcT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T6WTyAfKNEULulAdS5-37NB5m1MIoPQOqXONEcXntiQ&oe=6A28377B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eSZKUOnb08Q7kNvwGFUQBZ&_nc_oc=AdqcNpoE1comQ-5Ld8rSD1r0vc59UFg_eyDClNgRx4qTlmzHXx7uJl8kQ8FSw0cmMvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93d0in5JVFsrai6LgLbuYZrHssxLAowNx8AZgruoqiSw&oe=6A281E01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
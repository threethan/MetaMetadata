GJW&_nc_oc=AdqxQQTBjTyKP8ngr77cJ3oI7SJkA-0GNUTqQRRxdPnDacnDMQfoZ1kXZYXDPYB_dYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ6UXj6kRvnaWrlJPlXXqNwcLAKX5xnMSXpQNfVXDDmQ&oe=6AB6860F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8k-nwDp8fgQ7kNvwGwfHE_&_nc_oc=AdoZV8YgC2U-reMvV1Dkx9F3m4ADjjeoP535-WS2E-1kdMyletouVQxWDnzUDSLLOno&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGZkP5nbH6rY9O6pdw8Fhly-BP6PAxwsV8CqLxvxZ5IQ&oe=6AB66E74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RExa3Fgp3AwQ7kNvwHfihuS&_nc_oc=AdqMv1Y_N_LCsFn2ttPczDqavoL-gu1Klp9arZdZtrgDnxCc67Rck6-bwxegrEUf0a8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPWj7bgwwhN5SbpjodOlzKCls9VZufwHZMfgaiQA5wmg&oe=6AB68E9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI2v2CaGNsIQ7kNvwEZ4LDc&_nc_oc=Adr7jG1q216jaP0unQEkGx0_djBXMpSdfrZ2dILqgyb8aupAkh6kUKdJIWdHfV8sb80&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuCdcaCIKVSSkLKXzDtc_kRmHAWPqG-prvPh0JLR5DQw&oe=6AB6997B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndiCXsJkHM4Q7kNvwEkmb6p&_nc_oc=Adq3ATKMEFtiXsCfiRj4oFB---KmCsZ0bVyqzXdsmvRin4RP_mn9veVyDM6I0TowyLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPC2jBkyc5Y1xnrUXQCJOo84i41OIVnKXkJYhP0-qf4A&oe=6AB68001"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
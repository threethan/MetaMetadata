anO&_nc_oc=AdolT84UfMsOhuJ05P9gV0-rtrSCwemxa8GVLPY7yo3mLejI_dIG2vnr30UEVKtOhfQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa5nEunAhUA9qG2wNZ7H3D6Z8n2TfXcqftcE7Aa1DLjg&oe=6AC8FB0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nxupH0VJ8AQ7kNvwEbVdlP&_nc_oc=AdpAeoUAvHC5vsPtHz2yz9PBqSpT4T6dxE7e5LHDwtOkZJSh7M3R7jNc5ZkIl4cv9Lk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7C4wrA-RMQZ0A_6Cs3j_1xtRlmuYfoPXa3iQp3Yry1g&oe=6AC91BB4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU4K9ZplH8IQ7kNvwH4k5DW&_nc_oc=Adq6tZ6F-34G0tRUZD23_rtJPiAB6o4vLajEtNlW6aefNNMFUa4poFSaszemi9unghs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmY7-0xp9nXYmwWkBH8bMvgw2ExlhDeMEVKWQ9oRglAg&oe=6AC9039B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v64D69W-104Q7kNvwFzT5iD&_nc_oc=AdpphpAUgQwoKkk-hnjOXGMF5nXNAONMIPCsO0pKAlYdzdf1pIw4J6rpZSUjZGatwe8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxKbC4D_6URNnr902GsFT4Hntja452oOKloQMNhpjDzQ&oe=6AC90E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6bgjVlpva0Q7kNvwFiH_1R&_nc_oc=Adow1HnfX8vqnlgRH4gVKm6Z390U7iV0O6hOaMqMp5jyywGoLt1m7nnpZibGvrCSYKU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_RmCxo-jDep8vukcjouUYqPSLJbpPafNWb_mC31z7NA&oe=6AC8F501"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
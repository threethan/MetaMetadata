p98&_nc_oc=Adp1SxTulHJpSf7TqpUhGvBjOzbq8kVgJ8F1e042HSZKThmFl0-u2YP-asWGy5wgSnI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71ACMVvecInK-wy3mywZws-GLQ_DZHrYkHcIb_NnnrsQ&oe=6A09D18F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfE-bk1A3xEQ7kNvwEyiWGK&_nc_oc=AdrSEN_hRGbSKSRF-GmPUAAKkC7mtYdNQOyTk40CN32HlONy2wkXBOk74gBBS-J3be8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42lYCNlVSOaJECnq9bts5uaefCRsJBd1YfSJCmXmjHxw&oe=6A09B9F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTxGABTqCEsQ7kNvwH6Yhbn&_nc_oc=Adp6foJXf-G0b_thc6NUcM24YEdX2TCcyTI1jldotEL9ILDNhf4K9fdM127TAfaVsGQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UPD7HCJpZYvhh8psEDLLnRfYlCBicqDEbbZWA5CMNZw&oe=6A09DA1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I59uLGyZ0CEQ7kNvwFfvZZL&_nc_oc=AdqDK1l_j3PwIYyVamXkGjB5bUsaUglf4TQf-sy-DIb5G98Xu3rcYt6FVjKaimq095I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wVQo9NXs-RKz5eha9LzX951Ijcpc8dJ_2l3bjckUmYg&oe=6A09E4FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sNoUj0thKsQ7kNvwFcTeJq&_nc_oc=Adq-5WhjVT1E31x3Ko9Y_gkeJ-NjrcSiOfqqDZgNiQ-mOJVfnPiZtL1jElKcaCPauew&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QO2ImWW0cJ42GC00D03bgzUQN_3nIvTmD6jeTLsyjjw&oe=6A09CB81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
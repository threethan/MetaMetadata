Lgi&_nc_oc=AdrPqUeh0QbuBCbUZR4x0wVOGcmTVzwzgXKeAwbgGYXCr6ALYwAf17cbv8mwBCCdrRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG_XGRRwQHYf2EfAIW5ded6WKDkJdHM4M2-v9eyr5hzw&oe=6AEF368F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaLXXcFzB40Q7kNvwEzFxiK&_nc_oc=AdqtEpMg-EnIHWbwjUrpri6ahOz7JVxni5uiXiULCm9ZlOEYkgJcPv7xqIb6TqbEXaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl8e9kSOrt3JoFv67Bq6HAhTNVwEHC9nhqg_BXaLClcA&oe=6AEF5734"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jdr_Eqn-z44Q7kNvwGrnZ9Y&_nc_oc=AdrZyy45ozzUC7u7TuFLyzYd_evBC7h-WNy2NGu4nJIGDejgxhwR89UgKtbUH8f9VyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi-EoinMWHHsysm0aS1aS7tk_9Bh3Hm2DUnuU2tNngnA&oe=6AEF3F1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba4X874iKAsQ7kNvwEzmbLB&_nc_oc=Adqsq5KvteJ7T1P8Zc9rqzX0aNNP5BOc-P3-9BJWtV74ZFiDZqN6OEpXpOR8kltxmNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcRlYnEBhewwR2_J8CKPd2fVQHEDqzBd5YrFHwdM1TYg&oe=6AEF49FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sov_48EU-lAQ7kNvwFvCNq5&_nc_oc=Adre7utIJQCujkRCCqGyqs-i16Vnznaios8cn7PAcyinJdH7bKUNW2AIL8n8NKlLtvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyF4z13c90VUNLfc5_HlMdKqIpR3AX4jkJZERxEdQTYQ&oe=6AEF68C1"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
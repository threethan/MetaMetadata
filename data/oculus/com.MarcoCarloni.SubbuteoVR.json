00o&_nc_oc=AdpMs-IqiFL4_4UN7iaAQ9Sj9j3IQjnDYtqcLRu0QRei3VNtk6sz1ft_hpoont9Xf-Q&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jc1OjCiySERKL-4rwzyTDWl3iRilCfXi3y5WEANYJuQ&oe=6A10690F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83MyqzjoLIMQ7kNvwFznMtE&_nc_oc=AdpFVwESGR6i4Ow48Fs8Q0G0MwghHxRhRJSlL5-wZ8KgOZBeA6kgOqt-3lRmb27jVT0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cUslGhz2Exq20cY-TyiYfQYq-6yjM-YDGmUBWGk-_kg&oe=6A105174"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbdj7-PpPk4Q7kNvwFpz47e&_nc_oc=AdolYLQDjkSQnIetr_MfmOZa1EQuUW6LALNI3iqGevf5nzYe0u4O_yXDohN6FVMXWTs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71mTCB6P0jGuLBExEwNILjwiieKUNsVEGCd45Wa9bZNw&oe=6A10719B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJUU-UkmQFsQ7kNvwF6WqVJ&_nc_oc=AdokrHFn0FsKfbdG4TJd94CYPeT0TbuJxWJ4tKgIYWvOdI4tZ6xCvHQi4CP5waSS1N0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lNbdN3hBMy2wpFKJC4HIKmLf64jPvA-Isxvl6BkRMig&oe=6A107C7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBeZz2QXrxUQ7kNvwH18bRJ&_nc_oc=Adp0Kis1N4MFJcaMg2rQEs45ISAxJrm4wSUVJnefVA0dM-L8q2SB2fV0KZEgmI1EP8A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QvWwMV38nKhp2Pm5JqYSd-DLRKRixZOPAGOq1DTcrzg&oe=6A106301"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
lBR&_nc_oc=AdpYUEjUlatX1c2eUFKnyCkMixcZ29wOcVQGBroN0kWmfn6zneVnozpFP746Kc9oSVA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wkdDyktiuxTlF-hol1Uv3E8EAgAd1Srf8cvUd_nldFw&oe=6A0F178F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83MyqzjoLIMQ7kNvwHiO1Qy&_nc_oc=AdrdXKA2iMd2aBDuMzDcFr7vRANxuHmLIHaxs3aOu9GLDxg08rLQIoxF-nUaYAa0DX0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e1c6Atd1wFupIE7q5GzIdZbOFJovBfVoAluFBcOFcvg&oe=6A0EFFF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcRkBs8vW70Q7kNvwHa9kyQ&_nc_oc=AdpgUNHn980nx-UvAC6892FD4m8vZ82XynBQqXvABpmKvsNkK57kt3klfA-usC0tJRw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rvKgUOTZWPFep47fGsqlmKDHdRorDpzNu8hZwWpqN0A&oe=6A0F201B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJUU-UkmQFsQ7kNvwEAkz6v&_nc_oc=AdqfziXspuO4ElK6mOIpAwV3RfZC7XjBCmPr3L3ouNrPpGZFW47S9d5k_ZLUZuxzVMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kCLejOVsBZLBSpDYqCMZpqqWPzo4OvP1gNZACDp2UFg&oe=6A0F2AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBeZz2QXrxUQ7kNvwFPey_x&_nc_oc=AdoShmstIpDLstXFutzawrQ_2eQJgOV_D-hKDleMfaMPUf9w110VOR3ruLWlHypRI6A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gDCIp-YTvirwjGyESy_45oaUCN9mXf1-aocc9aW2DKg&oe=6A0F1181"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
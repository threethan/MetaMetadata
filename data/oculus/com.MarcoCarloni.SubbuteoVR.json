f6Iet187IIwE95UXggOYRBPPYDsBrG405_OSiOtwlX09Fc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsKem5RBqZOkkz3tOZgMUdOhYqUz0hnDtvt1Id9VvwUKA&oe=69A80A4F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrqQ-tiqP_IQ7kNvwGwiabK&_nc_oc=AdkiIUHBSbuNXP2x-COXmfq-UUjEEhPA2MFQIYJw3Vwytkk-QKwuVhv1JQjBtQYA1ec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfugEaI93ulaqfWefFVigJbfFsDPHWtTFBZvNn_y9fmjKQ&oe=69A82AF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QretSIc5MlkQ7kNvwGgRiRh&_nc_oc=Adlwpyqkj92JJOhFp07-ImoZ2-7ArVazMjvBgMuH8j15v0g4OQcvVkFBopT1g7bh0NQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfseVr_eDDyx4QcYBbXpf_SVxlmFru-ZwjDgNaphDwNfNw&oe=69A812DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtdfKBCOXKsQ7kNvwG8ziRY&_nc_oc=Adla7nM6_yOgKntTcRQ7jZNnRehxTZSkYJm5KGW4QQ8quGnZM2n7I_UpLypEO_k7wGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGT1sNPjw2ZS6YoAmBcdUyQKHF5qw8lZ6ec2JVzrBWow&oe=69A81DBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUmd8W3g4tYQ7kNvwGusYMb&_nc_oc=AdnuCffpMF663gEzQFlepu3BM_vwzQJDLNj3pmJ1Z5kswWJtx-P8Lx8pmXhcj1UIcYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsBfiHFikM4kCFMdbmA4G0YgjqQG5Jqeg5V0z6PW2e98Q&oe=69A83C81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
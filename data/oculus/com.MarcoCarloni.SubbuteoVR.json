N2oLXvS6FQrbwDwG7t9ZdTa0-oQ6gMs6hjiqQsxMYK5GuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6ZO9PHiLpj6kmEcDLPGKOOBRNy7lxpyOCEMnsDPo-mA&oe=69AEDA0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-EPddmeX9AQ7kNvwFD9wKS&_nc_oc=AdmE6t03__7A05y6-a3POTHf40tAeUiv48Mf9M44Ef7zEPyNY4Va_ucKfueVBJATvHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyY66SzBXixJf_muAUoYBQOb2iasz6eeY5yaQMVqKYuKA&oe=69AEC274"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIB_69y1bSgQ7kNvwGdGDGe&_nc_oc=AdlvEvK9gTeyA4Y92lOQapKLpjWXawXlhwB_7In3ONpPY9zKWh0q8qLr_uCshl6U2pM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFCaOj_xV_TLGyvVXV5WkmnGHavPNpot1cw_K1twngkg&oe=69AEAA5B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyJ8VOdzLccQ7kNvwE4hjDa&_nc_oc=Admqt0JOzQdKP1EGVF9fcVKLr7RAFuA7bRUqOinCsACvP4JjCsoV9U99TqhJdWEjbjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfydjpkNzdauz7QuEHTEMy4ARGcWQRnL3V1-OuBJZ3vk9A&oe=69AEB53B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVziGI5Z4VMQ7kNvwHEzQMe&_nc_oc=AdnpALwDzGVmW_FjmLmNUqPj_649S2ruueYNCBhrnPrpkongKKlefyYui71IG3h0rXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT0F0MfNlFWeN7BSgpyxB8jaAMsWyeD8eEFy2qXU-fCA&oe=69AED401"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
dUi&_nc_oc=Adqh7H5bvnVQJxxMQVWKCcwZrhJJwXk0xFMJQrdZDxi8sEc_jMkyb9e-kReFhSZ8Pwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PWvD7m42x3nklcN-cq9jr0g6MK1bKNt4tP6Rox5TEPw&oe=6A00970F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iRofO7QciAQ7kNvwG5tFup&_nc_oc=AdrzBCAeZKqUwXQS1Ke6lVGJJBlczWS_xBQ5m_hZE6_z4nLfcgiDJXfBA6rFXXXY44U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Oer4T8xQbBTktefFUjwTUixv_tiZPJty_0iA7dKv4FA&oe=6A007F74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOlgLr3jRCkQ7kNvwGsvlsl&_nc_oc=AdqlwuIQZS40t_78qInQIhDJ0XiZCRns3m22psvCLTDHf_gVKl1xSEN3CuZsIoHqqbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WDpic2hx73HOla33tBdSgqa3zy2UdRmGzmY9hTtO3VA&oe=6A009F9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL-JMYLIdQUQ7kNvwEdSzx2&_nc_oc=Adpo76FPufnKQAmVz3r8-gL4n0TGq9Pxx_ThhkCAJVsydU_XID0epvBMCEruT-fGU_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T4EjXfisU7oJcKV3S9e7qe9vkVt3wZjU8q9Pr81osTg&oe=6A00723B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMvjOAeYFcQ7kNvwGeBMzW&_nc_oc=AdrvX3cgte5TNoO48rQ43vwmDoCZspknOS9RTr7t_U1cfg8ytm8GkrodkW6Rkme2NSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WQZZYsIpmKkMCm1b7Q21F96op8-fhEBu6N9EDbNslkg&oe=6A009101"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
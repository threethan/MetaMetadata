_6s&_nc_oc=AdrmxWABWixRFAJUcHUcRRryoQvY5lOcNN5OfwJBFWywk_lw1nzdHXLr-yR3G6uveJs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmpQxsNzILpxNNtePcZcBOfyguLP7O6cYo5HuAywyBDA&oe=6A56488F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M1AC8vuRoYQ7kNvwEZr783&_nc_oc=AdoEVDdZkwuiy99_Hh5NNvApPNirN5emNmpAd4c0nrGGYKYlLQaUbLfHxbYjaSLqKrk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgolKxCa0lEKRxY7q6jP0BS0iNTJbJCwp2C52vQHB4sg&oe=6A5630F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqdoe4NpveoQ7kNvwEi1UJ7&_nc_oc=Adp4M5Ik8J9tMqL9G0IgAg3EAA23Miejan--FIaToIigK4gKSTwK0DIvbEWGxCXtaXE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwF7kHG6bhlFxwg4gytOQ_xeHYz9dWJZazLRStWkBhKQ&oe=6A56511B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFCz8MdI5_cQ7kNvwEEv_Sg&_nc_oc=AdqSKPla3EO9EiGP8Krh4dbA-hASJ3zZ0k87L3iJKnzlpST6NaYpFt-NYJp7oKIeUFU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZlRoE3vvJdwjO3OpqceCkPcdtrSLcmIqfxd5K_os30Q&oe=6A565BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fquPWW9L8s0Q7kNvwGJketZ&_nc_oc=Adqktu-cAjOKxVQmuw_9ZDpVCRlsKTRUeXd_QbtJc377uyvdWxDMuwoU6zqYP7OQw3M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNmlHaNlgj45XYzEZrMLebPaaEAg9-gwwf4Rmcs_gERA&oe=6A564281"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
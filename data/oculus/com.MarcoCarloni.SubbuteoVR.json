940978552574", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75534974_1088940981885907_7002076785228410774_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HXGR5PmYwIQ7kNvwGyEMBv&_nc_oc=AdoSjYgdA9RvkEmSbmyeWXurgTtGjl4FBfnsQrJWVuMtGm5l7Azv1CCYOantvB9sYnw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf23wHfof2gY6eReciMW7L2Azb3cB1z4EMZ_puXkVZUA&oe=6AA40A80"}, "display_name": "VR Finger Soccer", "keywords": [], "long_description": "Funny turn-based soccer game inspired by an old  board game, play with your hands!\n\nChoose your teams, choose one of the tactics available and start playing the game!\nScore more goals than your opponent with the players to be the winner.\n\nHit the player with your hands to put the ball in the net, but be careful it is not an easy task!\n\nFinger Soccer, also called, button, penny, coin, or table football, is a button game played upon a tabletop. There are other terms to represent this game around the world like gombfoci, szektorlabda, soccer caps, sectorball and many others.", "short_description": "Turn-based Soccer game inspired by an old  board game, play with your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
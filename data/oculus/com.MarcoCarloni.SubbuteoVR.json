lwM&_nc_oc=AdpM3rZXhn5dVoBtwTX7vBe7kh6DYkpjQSGJy_LClDJ5E6bh1v6O1rvb8tK1j7_-hco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElojh-xKn0Qct63is02aNe4zZFrTxFeupt5C1ArA08ZQ&oe=6A7B328F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMgFiGVmqNkQ7kNvwE7vscD&_nc_oc=Adro7sBQV3plX2rVG2HqeOybOktZ9YCQtdTmv_cM9PWX3B9ceFe4nnEBuoaG1DMwWus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH56eRidzRe_-aD28i5d7HksfmSDL-fBiuzGk1LtuQ0rQ&oe=6A7B1AF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW0koLjEB2cQ7kNvwGYuu16&_nc_oc=Adrj4-1SLCeuvoQ9AwA4w6-9pm4cAX84YVp-eNynvAQyhOVVSloyJBLGT9TtrLNF-IQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM-BGbVreo4dfSdXWqyW5Z3yah3eqecU8JuP20BjchEw&oe=6A7B02DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YsXsdLon8cQ7kNvwHWC97j&_nc_oc=Adrd4p2R-1f4ZKIrlz2IttfXVpsv4m_hXLAfACMqrQi3pRux8OlS0U3XcScqmSinmro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ_BLwO7vNkGt0O1N0_CvYSwmTY1RKXZEN_YCNHdpjWg&oe=6A7B0DBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5X8l86RC8hgQ7kNvwGme6Iw&_nc_oc=Adp16q1K39IFkZ2lQP3m1Mi40MLcV8Z7Jm_R__1rngV9rrhy2wOBa3mKCDzha3uROgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVwF3rgJOsdURUAV_v0P1uTkwmFU08LwxO1zh_gUaztw&oe=6A7B2C81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
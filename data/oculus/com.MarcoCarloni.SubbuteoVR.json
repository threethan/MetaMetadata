NP9&_nc_oc=AdoGqKVuapZW_l-8GWJq9gNRB7NOaap5Wrh-jhnTc-J3rXCJK8yBRZQHqqITSa3nLPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnrODa8EHQV2UUvrYbjArUeHmzgIdWC8KbYM9XXuICeg&oe=6AE74D8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXF7ptNXeesQ7kNvwFsZuH9&_nc_oc=Ado8-JhNYzEgLnj0jCyRADKloTrzSnafVqdhmqdTEGXd_SQz0QUVJ-2o8m-gWSvgKPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwRIcdZ8CkGnag0khLlChQRNz4y1l5B5XaYW748yBg8Q&oe=6AE76E34"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALrGxJlYRR4Q7kNvwF7hsj2&_nc_oc=AdobcUB1gACIUcvJOsY6bpkWiqUuKhc1vmfXVFQhWscwTcNx5V1v8SardH1j0zwQGZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Mf0y-e38GCpLg0ZlLo0mou3M2mCS8KvS1Ufjv0a-Pw&oe=6AE7561B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQkVnnyJWacQ7kNvwEuKNCi&_nc_oc=Adq5GW0P7GbsjIUCm131k2ySmq2opC98PwfxPxFHN2o1L2iwckC-euhs5K95Hf7kgvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9uUkkwjgHaJ5ePWEInVRJ998xWx4FMPOTzRyVEvMU1g&oe=6AE760FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocglUvRiKBYQ7kNvwFV0-Ow&_nc_oc=Adp6TXiM3JPH2ITyeAyLDBeqHMYZpx5h_JlyI_SOK8CDGj_bcE1_GMXuO5KqYUI4eLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJEzlVwtP5TxvF_h3TwD0-0q9asKCqeUM-JHgEoHnzTA&oe=6AE74781"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
Ozr&_nc_oc=Adq4-M4ci6zjYxPMNejmMhGFgjkXBF2pyF69Lcx-RfzSN8SVIAyLLFiePVakLm_n5PQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuSBx9V_L7k0crE9PN-9npmbdccL9198k04GwXrU4NJA&oe=6AF47C8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvHjbkcH9tcQ7kNvwGEou3e&_nc_oc=AdpMW-7dAW400_1zR-wg4hKRA-rh45XfIMdU9MShrblAZf0AOVBhBUKRInLsDGF0n7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcWqhyimy2A937pvg4cqqZyyHI9pfzXGmHJoySmFXysw&oe=6AF49D34"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4JV_WttMAUQ7kNvwEQdyhD&_nc_oc=Ado5OLLY33wfgml7qqXHAT7dr8WM5__heR0ImTwXssI0QT27JE7DqhXnSy8sLT2IeHM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAVraXoiwDbiOO_0DqelRSRmZ7bhVPixL6kLnXdxeC_w&oe=6AF4851B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_Jeij_u4BoQ7kNvwGaUYtV&_nc_oc=Adr9qDbZIWdU_EKBNMwo6qfRkBfs1Vel6UewZbwX7Ta5Vngk8oVtm-yy1fCkXPy-To0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc75UR7nybyqSMzg7-O4u6uv4KlkXavuvmbX-Nrm7NTQ&oe=6AF48FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb5eAROpRWYQ7kNvwHUiTZD&_nc_oc=Adqt8mnWZfc6g-WLxHuA_tAlFq1Mpmfo5z9GpKaSksp5r5LAsr78rEcJQAAXmiR0YLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPsYpIlOu4J61z1Hip3O5oRPhGU_AqxVZNqtOUD8zEXQ&oe=6AF47681"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
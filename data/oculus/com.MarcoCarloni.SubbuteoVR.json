qwx&_nc_oc=Adoevshb-7vmh9QYAZSIWK2Xlb4YuAoe3uhqzS25-rFz8rEe0wbaNG09AiYhv-Bzrh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYCOmIW_jU85pe2_26-QTkkudYGvbvJ3r1G5FbkbVggg&oe=6A788F8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGmiW8JPaDQQ7kNvwEc3g5Y&_nc_oc=AdoGkaFxarA1pkpHQOYQVuN56LU6UOCqPzLfdhpq7fjs2uzaHYwl7CpvXqMAUQtQCes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYGFVpfzc0uxOGAtK5QXXtHmfCyzz1kb3-irlImWLbeQ&oe=6A7877F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AowI3tBowgQ7kNvwFpL-y-&_nc_oc=AdpZuvaN_Ds7EErUtjSgzp6CHAIsmvjiC4G9kuRBzBGf1ILQqmoH3H_a2C8DZAfQ0_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhkGPFEfwT2R3hM9tfTFIm9M7ICSw_3OLhI4EQvnhw3w&oe=6A78981B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YsXsdLon8cQ7kNvwHJ0dZ0&_nc_oc=Adop_GR4JdkwvNijIcbb7ivSZwMz5nPv8Y89_g2mVuTLcrhgwnVhEkxAjzk7RgneXhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExjn_6xsnQmNaNEQxb9KLUUCXaj7utYfA0oZyFzfge8w&oe=6A786ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1A5EXTHflCkQ7kNvwF8Ft1L&_nc_oc=AdoPQExUCpbgAjTXIiV6jeA_vSWh-wCPQEiY2AhmqYMbUy6R9wXDtdhgBoWHikYw2dQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX5f2Awy8OTpb8OKn-gphwMHEij4wlpNDX5ud5_jrInQ&oe=6A788981"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
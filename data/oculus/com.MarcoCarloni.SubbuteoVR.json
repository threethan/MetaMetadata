JLK&_nc_oc=AdrClF-468rQM2La-d30PgClLIjZw4hcbuz-flYATA7xzOns-iuuThWehjTGWRS6PEE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rrV_F7akc3pwmILhfscLcLn1RRC5ONQyDHK_g6gG8Tg&oe=69D7B88F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVBkeuUkJEEQ7kNvwGObWfR&_nc_oc=AdoNtAlEvJWOcdqpoFerZBmC-telFQXuce0nUCGH_iSx7Er7ZphsVYLIQ7fPopxqOvw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zRSOFPCzB5wNlPyH3Rr_r0O_t92IRhrt2_PfR0IVYqg&oe=69D7A0F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGv1X_NdOj4Q7kNvwGUhxLT&_nc_oc=Ado3lVzcBxFR2QFHfezQmdA4at9iD0qTXEHabNRPTaD4I3CdzJnBDR-W8K1UWNCCRjI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VvIHW2TBEGTqJarmVHDzRGeo9YmMrQt-a0lLOn-E9TQ&oe=69D788DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEb6MW8ba98Q7kNvwG9AaHZ&_nc_oc=AdpfqzW1rlklez9Jk18tqFSuFTjWZLyF8PAaRFQbzDwTSpXQwCQB8XRSimOk7b8XJXY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rzoNK07w53anlqzer05hYZm_SJU7chc3uP4hL6BOdJg&oe=69D793BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4nhJHuYb18Q7kNvwHyuQ6V&_nc_oc=Adp99QXliuyvvi1jJFy6jQdu0wyPD_uxLAn62pykuc3MAcpSxmejCP8bSveD7jiwABM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24_OowPptgp42jH1vtJmMSPWXzkDrcHTxm3PFYv6LgtA&oe=69D7B281"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
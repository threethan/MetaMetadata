JBk&_nc_oc=Adp61MAjgCftnH8bLSiKy61hevbhUHaVBGcQhRy--uRMGMEVqDzgmi4czHZ4C0xoGpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LpYd2F2qReAcnSmwfyGMyXfv17w8_uhIx74nwYFu7PQ&oe=6A05DD0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fupQvC3LIQwQ7kNvwHxHq9R&_nc_oc=AdoHsCd1xHc8s75E4F3tkzLAW4ie9oCYrA9ThmUwTjR5V3J0oB7sD1Zh9h2Jrx6aEPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bYc1q1HQRpqpKilqlDEgXkPR8otNjsGubFhBYwvHMbQ&oe=6A05C574"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krotrZ8zv10Q7kNvwGzIggd&_nc_oc=Adqxy4pfXKEA-gWoMYMv9HyTXE7i9u1MboNgcQm8hJotWfjjuaYa4-TmvdY6uC7bsyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zeefYjQ2LlBZZjEBXU5R8ehjvJgz0ypzgFQ51IFokFA&oe=6A05E59B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTZ2RTObyr8Q7kNvwG5QZAt&_nc_oc=Ado64aVFpCAf5uYLGXzYS6rrQSfJPkgzk26PHOZY8VMteiOU1Fjg0G9YeRhDvDm0GIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h4MpzrGWy13qHY3MlzCUtlJR31wW6bHJvH2tcfZOAGg&oe=6A05B83B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OtkEYB-T1UQ7kNvwEDQSxW&_nc_oc=AdpmH8f4bon5pN_HWz_R_tnPzUtJRC5O6e4ou8i0k0bp_9eXcE2SUlcHV8QN11A9Tg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XK0ybZN3-YQ_pjWClR8ddUYFid-PqxmeOyy0NKcH11w&oe=6A05D701"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
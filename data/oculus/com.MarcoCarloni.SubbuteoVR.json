kWa&_nc_oc=AdoKdtjWnOVtMk0Xl1kqMDMlW5VEG6pQVFce6XXIUVKL4mLbC_AoVGtMmTvD6NnLnz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrVwIj2tDdmenGwRmSlTkvtxxp4in0CsjWxccvl3fgNQ&oe=6A773E0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGmiW8JPaDQQ7kNvwEA6H2A&_nc_oc=Adoa7nnEAU7dZXnL7favjlVRuz7cx4u0I0hhhprZQLl-ct4XwTixku6kclalZ1SZ-dY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1ML-MO-ldwxxwaFhZ3qA0Cspya6olcywfhYeKLyNofA&oe=6A772674"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AowI3tBowgQ7kNvwHcsd12&_nc_oc=Adop6Y8zXZMcBd6ZdZc_4QpwlYwtGr0lKDsw1UhubaX7H4GTEix-fvNauYxJfFrPy9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrmuCFnqtcG7MlliDvMO_ivgonJgRBN4Mcr_A9_klsrw&oe=6A770E5B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PSzI5XO_a4Q7kNvwGctT9m&_nc_oc=Adr267hA5Kuv6QSulA-5lVtRs0mu6Q75qcBO1c2h3VeBy1y_ylBNnY32aHW5Xq6nyvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYldON0Wtg50GnuC8MlJFmSu7fUuJsdbsynDqigA_gSA&oe=6A77193B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1A5EXTHflCkQ7kNvwGpX20f&_nc_oc=AdqjeY5tNxrsoy5Mr4JTsYTjgQ-7VdW8xjySEl7E82_o8-VuR37DnVuHKmjSXDS62D8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA6KsH23yBGQshVO3QMkJL5TeUisxycLajlCZoI0gpsw&oe=6A773801"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
dXE&_nc_oc=Ado9LAIFT1hRvJeZl_4RoqPZtkPxXdmRir1FKEUj5Oq0dyEsqBJYsPjKWUXjQ9Ar8us&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Ch8OUAZ0l-3BAB7KLQXOHBI07UZoBUNTdEZLB0RPQA&oe=6A15AF0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6yycllzQLIQ7kNvwFLJdcV&_nc_oc=Adqfz6c9OjpaHzbWAZopq4qQQb6btV_M4-ciaPNdS7F9dxlXrged1jJbKN-xP_4jtXk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tcFeG9xI_MxJdcpr6RwB8Bff69z19whs8wZvKYwY0Pg&oe=6A159774"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t30maNWp7_gQ7kNvwHd-weC&_nc_oc=AdqNawDpgqiaeXv0viZR-6-wHQ5RJzGhOO82oRhnwPrhzxuxfffOAMHpmVY7qrzeo6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f4X8_8HfMGZnx7JYSQeKNsvi5ERmXo2ckIlbpLpQQYw&oe=6A15B79B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_Nv7mACS7AQ7kNvwHLsp8C&_nc_oc=AdrQwanDCFzbCkNcQEbVlNDghqZiZLXX1i3K8FWcxCF1W2zmUHCPXCOHcOYeOeh5CWM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zQus6lfpBgcLmV2PkF3wBfxRGOGGdc9XMM_Q1We4iKQ&oe=6A15C27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4ftCNiQ8m8Q7kNvwHgP-28&_nc_oc=AdoC6fVgypJdVdCWN6pTXPWaZf6M4OjWR1k52iE6hZ-9o1REs0qSz2Ur8OAbVvAJ0SE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UDFjRpg31h-14wfmA7N8sXREAsaxbuSFJoM2Y8m47Aw&oe=6A15A901"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
W7U&_nc_oc=AdrA6GH6NUDQVvqQz-GTpFC2sSXsu0plCYoZ50XEMAlFdaEKFt99Tex6bNAl35-dwx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgTdhh3hituD9xeah2dvmhO5oq7yJ4-gzd2nkdH4Ejig&oe=6A64C90F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE-Mdlq7m0gQ7kNvwFfV7Xc&_nc_oc=AdoXEjpYEf1DKdqlvWIWHMRDgGDf5F0yNOwzroSh0OrhRFNEeVCppQZkUR0S-eeNvjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo7AewDV7rMX7zgtRg59sG_RSi6GNBKwt1upYMW0skvg&oe=6A64B174"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6AeA_beVFcQ7kNvwHGHMbv&_nc_oc=AdqKj9eAWpuNYOXHgh5mA3El5LN7aMaD-XY7Nzm-qZ0_bPkJ-ZB_NiKuK9-unQqvsVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD14JecBOCgLVZU1IAp2L1XSniYU9OSEO9FvwfTK4m55Q&oe=6A64D19B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoSyigqcjWIQ7kNvwG6NxJN&_nc_oc=AdrGvoba9BWtQSRKSsWf53IccGSMF3Jy--Puj44VKxMXp0SB-zlPuSnpTZyu_rI-hJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8OCOm2CKT1S71SVay981H_We3-6XxtzONxnyEH13lLw&oe=6A64A43B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D24uDJB_-8wQ7kNvwEUMlnd&_nc_oc=Adpfi1yZLnrb5HZyZTIAu8BcLrSnC3pEpuKkyaDoLldF0nexiEmwDip0qcj8erKxaWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnRMC8N3g-Q2qhvDZAfCwSg0uch5o7RpQaLXcjgdMOZQ&oe=6A64C301"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
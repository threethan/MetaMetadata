OPT&_nc_oc=AdrjucjPTeUMJeiGcPfH415Mt88-KheHsqoyLz9aNLoEIpf-e9EcADTW5AGDybI_bRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIFBnHApSOESHW4AugmBsKuTK5sNFIKdqZI2tidUfO0Q&oe=6ADF648F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkBYWtxJWRkQ7kNvwEHVPMx&_nc_oc=AdoUlPGKNsh7rBqxY6xAl_eIN8mDQekAJYvrU9GPZViC-2_rq-1NZHBY988c1P0sITk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMh3aQEPuR_gcTgvhpDrcBbfEx9inqS9laICtAjxruZg&oe=6ADF4CF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOxbnW__A-YQ7kNvwEW3lWK&_nc_oc=Adqg3OfFgec7OeK6DphRASq2fudtRg8hKEw3M1SByciPDSud017NLRbybSvuctpGseo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwYNhtP8LEEL_xCSAoyrK5Ae-_qZdSj9Ic0EhOLdBaZw&oe=6ADF6D1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2Nwy4n6NFsQ7kNvwGDKG0y&_nc_oc=AdqxIS5Kmrcce9wJjAG8cSJP1d49P5DDa9NR9A98uDY3U5DS4kBMlVjYxre_rdKmAgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjsOeJ0FPaezq1sQEuo08C_LHqBOZKDn35UPZnnwgLWQ&oe=6ADF77FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XOn6Th5L00Q7kNvwGBcCpY&_nc_oc=AdpCCXAdfpzYOQO8o9apkoRBT9KJJZsEuZ5sqmM954-oflOCuR_CqhXjo953qPdI4qQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE6sI2K0cWTlJtgRHOFLxsxZmV7qNPy46Y-X2kE81wWg&oe=6ADF5E81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
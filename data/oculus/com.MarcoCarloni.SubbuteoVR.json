NOr&_nc_oc=AdrpkycT0uv16DBANWbOhZjDiDP1l1NTJUhyjV98cf-AfEwM_KhIykd0RQYEFO2rSbM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JLVNLtgL2XEisq5dnPWidWL8f4iYgR9ejMI6wqCVwmg&oe=6A300D0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO8ncjdADt0Q7kNvwEF37dW&_nc_oc=AdrKifBKOEvbMTOE4_TAWimpKyXY9p1BAnsrBQECwxOAd58obNr7nEG3bZX0cviYZd4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_912KIMGR6V7utMh3sczCuwmTKcj8GYTeNTWO9S8tIA&oe=6A2FF574"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChdH3dWTbooQ7kNvwGsmBTB&_nc_oc=AdoH0Gnhc229PIptsguxa5mAIkyO_kYuIC7Od6Zz9niEIOtIMc7666qT26ryYoMzAK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95OvJY-cGXYTYWFvilhwvXE4Sdrsqo5CzTiIS-9yCbow&oe=6A30159B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUp4kDnweFsQ7kNvwEOxC6e&_nc_oc=AdqCUHoCsHSQ6ParIGYN6hT5yaqbvaGrGGTogvhgO8k31W8IOnV1phC1Y6vMmUYpQbs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p4P3Mq_SuugPgjea5bd-9BNkDiijlEtPD_rpm6bBFdw&oe=6A30207B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4qgXcNOqEQ7kNvwFvrnb-&_nc_oc=AdpJM7M2uRzcfzVaost37S8GL1Q9WLzyZU_lPXbKQgcxSMjsN6jaXvO62zFG1L8yJQ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SGTq1pLRv0yl456YD7LJz3e74Bkul6wc-v45LDSQ0aA&oe=6A300701"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
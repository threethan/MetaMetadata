NZw&_nc_oc=AdpU6nRreH-vXbaRa54t5vhW43SLyt_Sau2pUG9aMHt1vgoazTiClH708SBlZeevGww&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-CWbCW_v9N2m0FTHcVylAnJpbB4U7nK0m4v0HzLNu7g&oe=6A88294F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao9unpS74NgQ7kNvwGTRnRp&_nc_oc=AdpLljDcubW2og3sAC3uwCVU_IMTwqbrcihl2NWysM2c2N626QInWIJqE4NVpRFWfpc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX-ax8OZl3Iy2_luaw4REfX5vcubVz7H2neg2DebonNA&oe=6A8849F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFxGTQdhX3kQ7kNvwF-CVed&_nc_oc=AdotrmQpz5zcGS7KgDuQkXsMfuck25qvkabDFnxXR5hMWSMnp5H0bbDAVxm7KC2_X-g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfIFo6n0K2DNw_ebz3iDs2M97d9rT3dBQchTZGoIwKuQ&oe=6A8831DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlYq3-pOVpcQ7kNvwE1eD3r&_nc_oc=Adq50x15nSx7q2oDattHaSB36qxLPb4CBOykEy-rdLHhhwFHGNxAQN1RsE7aERPEvcc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEadYgHgCovdSJwYcnTEIM_hhuiKuPYXGckG5ImKSDzbg&oe=6A883CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qME-oG7Ypx0Q7kNvwEM4pdJ&_nc_oc=AdpdmXGDtmqTLOhs9EtlfQs-Wuca7oUGuom-7BHkd4ERuYFB_rOC1kftQeLb9DvR3Zg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb2eDpfFf0lOsny8SIlhFpJ1fmYQDmMpS2BNu68WOJZQ&oe=6A882341"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
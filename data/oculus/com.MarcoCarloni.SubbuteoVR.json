CTb&_nc_oc=Adoz81J0CXjehZ1CnFVQy9eDOQAYbyt2Kq0p_uQxDBYbLQTYJBfYNANlEdlg0uD6_6I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2oVbrHkgRx-QkRc_f1O8vPCLs0yJj_jIP0tNKFLE1aw&oe=6AD3870F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nugWEvhG9foQ7kNvwHDbLt1&_nc_oc=Adrn-u4Qi-lJKHgnqiQcP3Up8NTVuDr6QusL3XJ59Dt6Q3_V6FBtirPf56yIDzWnqYY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFqgS0kXOc0sMGQ-ixWJXTI9LJMOPwyGlkyNPIKjUSTQ&oe=6AD3A7B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tgmbgd5ACYMQ7kNvwHg8R6z&_nc_oc=AdrKbxfM-rhWCqUN1GhKoAzMIqbDpjlsTHJtKL-B91iCwLQE9-2V1H4DRrDLF0DRbBE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcUP27aOmk3gW1XVwJ1ielBtxA6TnTrnHCu8OMgaHk6Q&oe=6AD38F9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=909ELRc14u4Q7kNvwGqqk8k&_nc_oc=AdpTqZFYgZ7CwSK3p1TBRPyc605kpsadodhd8jnKkmjAqgs3v81g9I7gWGSQB3NG3iE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB5JlxgwbydzRaqcMmH_KqWfti_o2g0nweWOm544nVxw&oe=6AD39A7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D95sfuxIcFgQ7kNvwGOPald&_nc_oc=AdqXdJY6WYs3Nl4lTBn0srrz4n-V6W4cGp_mix4LYAsbhd4CvN3he-3eoKABMl-Qjpo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMzG6N7j0KIaD6_742yLPoGHLzRec2TdUXhg1KASFSzQ&oe=6AD3B941"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
jXc&_nc_oc=Adoa6Fx9Uh8rP6Sg--ELAyj91JePzn0BNzK36gLNUKgB4EYQU05nXkAfNf7JVDUUA7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmzXJz4NaDCli7WpwpgbbZDSlgF_nEgJxIAlumtSF8cQ&oe=6A95C8CF"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7fE8lnHt0EQ7kNvwESGESU&_nc_oc=Adqgr4pGbCwl44W0v6iW08xn-nYNGU-pYolQzASTf9qOC1R4op6HvrLOFlJqxBbTT00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvYYzaEJxxFa9hlRXu5IezYFsBc-D8MHCPdyFZ_Socyw&oe=6A95B134"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jlvN1FT7eUQ7kNvwGATtAB&_nc_oc=AdqtKG2ZVziRIb_Wh74qeQQwtNwTn-Y63zLP1Uwg1pvq5T56NIHIFv9cM055kUdY47k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1v8PJomzn2C9ivNUCLUVDAE71HzLfS5M3tb79W31LmA&oe=6A95D15B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=353qa8ITYx4Q7kNvwEgILp4&_nc_oc=AdoIlMGCA2DXdySUev0piFFRIacXseyfrz-caBq4FdknsW8p_Io2S1KF6y2Dgqg5BGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSakW9nWvTOwi4bv-P3IGaBAl22J7JLpHApRfp9G0c-A&oe=6A95DC3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJGPVvhxWgoQ7kNvwH2Yq88&_nc_oc=AdrIrG9zYcZQQf5fQH2XsLPnLgBkyx4vUdwQoeWX7dNhwmRzYXES8Md93yUNBYF2M0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOTkoqO_nD3JSV_oEpqh_lS0mXte3pzP1exinc709LKw&oe=6A95C2C1"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
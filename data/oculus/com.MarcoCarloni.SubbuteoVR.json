p8X&_nc_oc=AdoczwyIhiW0JUH8FJpOj4XXH5yhCHjwQpfgrNDLOet4uxCWZypqYkgmFhMVWR2h6yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKejJCL91iNG1-Pl-1oql_FxjUIMhRRZNCpoab-7kDGEA&oe=6AB9290F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4H_zxlSygREQ7kNvwGVyNbK&_nc_oc=Adoj9QtwE3m65nltLGF1Gjj6p2Ze-EDCoX5NVFkFItHRS_rxW_INRCezS8ADJVrOfUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_3BlC83QoTPzSyATCfj8HpyombbAYyaZgp-JjodkicA&oe=6AB91174"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RExa3Fgp3AwQ7kNvwHEfW2g&_nc_oc=AdrJNup-6I4LEL0VcleTPdFjIkSPCQj-JjwBBD7yIHOIIOTFCyooD7T0zKzEC3fyrqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU1ZXtktWnJPdAf88tdy5AM9Engm55X85tl_YbkOYLZQ&oe=6AB9319B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwAjVVTG9coQ7kNvwFv2QgD&_nc_oc=AdohlVHtFLuCLs7X3ZkCEZDclzu1dP2ay84ZE84BV4kzd4115tVzqLKokLWE1crFcug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeo0D_Evdlp7rEjIonim3bTUOHwZH_SMaeWPCSusa1ZA&oe=6AB93C7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxH2xmp_0AYQ7kNvwHIasih&_nc_oc=AdpwqhXnbIu7CwQwKPjq_K6Pt3K1HbJhAc0mgelsjxNmCqdkl9heVEGY5aflQ2eGUOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeWRJc01qm5Wh_R9zqsqhqASanjoh1tJtWApszBA7TPQ&oe=6AB92301"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
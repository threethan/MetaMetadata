5eh&_nc_oc=AdqFs8M8si--m-Vxs2E343Tv5WAtB1TmVa_5JdBtBZaTuMa3LnTbUHEHi6Q0g4WqIQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUTnKr_73oxmet6WEZmJdo0VAxGOrrOF_jRbWcz3OhwQ&oe=6ABD1D8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNPvHbYwuAAQ7kNvwEMmH_2&_nc_oc=Adq44udvQwu7c_bPYZrMi4nUmiINQj2m5hYwFI89KVxICpBGD3DneZf5xuiKa16ufbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPrR1khMwewM_PSN4JckHVq_bL3Uy2IRKJBTNoJNPwCw&oe=6ABD05F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJQ60B_qvegQ7kNvwHTcjOe&_nc_oc=AdorQB5gOMJpMtl_35O3cBaFXCo57S_h6D7_4Ei2FvYQdtMx5wtq0Zl034WKXxYRf7s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiW21cxgAn-IAVCniNMBbmW4NIKBjW0q7Kpn5Ieot2JA&oe=6ABD261B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6H4AjJiYogQ7kNvwFBVJgM&_nc_oc=AdrXyDlqSzjW1dMqotPYmfyiLced8qEklbcbvHnAPSYj952cU9a7_6WHI5G5cWeImzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXsVXM-a7ZISwpZEeFXgCndJRkE61C1KwwwQPASmCmow&oe=6ABD30FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNOeQBsiTKwQ7kNvwFAFmkZ&_nc_oc=AdpygbrZ5kmqSuEBopFR8KDjcxqdcYiZScldLuiuhurvpHPY_raV36Vy5eRnLPKOd68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcom4bByhBdeUMOR7XfYbg7x4a22gE9-Q8XDzOOYJYYg&oe=6ABD1781"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
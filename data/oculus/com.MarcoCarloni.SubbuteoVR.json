RMP&_nc_oc=AdqY81A9Nr022mRiHlKLMpTyiCJVEcxqviE04uErPwVjNy1htyf1uah5wbdeSSf0q4A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEneNBEIxeZuSz9EXw2F4xI66at6FuvHA-yFPn_TjhPOw&oe=6A86D7CF"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao9unpS74NgQ7kNvwGk9LJ6&_nc_oc=AdoX6dl5uPFJvHTYVKUdSapuJp8ByBQG4afKrRvoSSeVCgZ25cmvjrasBtqI2G22b3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1kXX_2f84d6MNsQYkkvgmMhtHEtH_slhiNmkW7pdsjQ&oe=6A86F874"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFxGTQdhX3kQ7kNvwECc0Bm&_nc_oc=AdrhwhvCNUCw3GwVdHCJ8c-XXqg0ccOggZ3qav_RDhwdqM2QuX9hAVf0tyZNs77Oxuk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVzjRwlRxHowsbvWhn5Iv0YnIgPqsRYfsSK7T4pYLzWw&oe=6A86E05B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XmRLTJ0yE4Q7kNvwHGU4sw&_nc_oc=Adqvh6O_U5-bAFwRgA8T2-vj7fCPYLPQkeyF5s6dveAy2OwRxW-UHlSyTuKLOy7TlhI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwgioUIGIP35O0XWscYE6b8bVLUhzQRzCp_2nlhAdLBg&oe=6A86EB3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qME-oG7Ypx0Q7kNvwHYPJHH&_nc_oc=Adrao32FZX4HxxfsKjiR6GF2CF7mEQN5ChOQckn2ti7eLO-P0jC_M9gde1lk18KxbCI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf5qkqJ9wMU-I7tuHKCcosUgJPdojhF9BbjrMVJp9i2w&oe=6A86D1C1"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
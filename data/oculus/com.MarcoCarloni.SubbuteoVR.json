doh&_nc_oc=AdqhRCeVtnK7Jz2vD-lwPc_wFXFO_FOhtaxSV65AjmdDnQv47AF0izf2RzsuVLWEyUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kmV_mvPEwUpgBUEclHvHQGLZpA1A8EPTYuAgqnFYbpA&oe=69FCA28F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJOH4sYUzssQ7kNvwGj9rwS&_nc_oc=AdoUgRG9ZatoMBxbW_xcu4PYpxsl73w517D7kJEVUXPqQ2xgD7O5iUywC0gG4kLokKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GRfqd36NTEhEid0LHoZYXmx3Ubvu0a9PFkr9GXq8k-w&oe=69FC8AF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyCgMrxDygAQ7kNvwHbz8YA&_nc_oc=Adoo3XqLt6vA0CKcEYFSelT66ERSw8yvpSctueK8Hqzcb1bRGZx3MQYLDh6Em8ImNUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fAT4TalMpTyTkr2PcMd_Own0UnKxZBL4S84MfdwK2qA&oe=69FCAB1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub6Hs2_DckgQ7kNvwH4jklg&_nc_oc=AdoqyV5X9BRk9QN_xiVBJa63subvCyr-T7AHEfDuvCOUE8qsJ4dN_gYIFzkQlg4TTMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77cF3gNmvBBBZv3yWoMQPCsnr5FrITp4cW3j9cb0hmpg&oe=69FC7DBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq8X81VGmPsQ7kNvwGmZnon&_nc_oc=AdqKP5AFJ50aeSPV5HCLRsG_t-A-qPmcSRVSi26eTgpxfAREvEG7uPy7oW4MkmT4Qy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HQAciqxLoLLEv3ui3zqHH_u0uUAgFLxI2se4MOSHRcQ&oe=69FC9C81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
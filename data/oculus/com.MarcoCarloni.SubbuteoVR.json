j54&_nc_oc=AdqUuHBV8HvI9WPM5LGIZECBTkMds-5E_X8SMhy9EDSsT4Ua3l92mair3GvJc6UivZ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR79szFBXl2JpiWELAqAeNDzmPbOeAY7f1HpVZyAYALQ&oe=6A90124F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJBVcIb4yoAQ7kNvwEOLQV3&_nc_oc=Ado2RbqXaZP54vf-jvdayZPQZ1_7GJrEjCPmka_5IhjkjCtgHd8kac8_rbELGEQImg8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwJVJiN6hKiar7adxZjaD2VTfJS7nRBknPzQlKV0CwEg&oe=6A9032F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRUH6MXI_pwQ7kNvwGEE__1&_nc_oc=AdrogJt9tniv-ud7QOdnFf9fE74nE08GdEcnw7jDcKbV4lZ90C6Eyg6wLchY6pHk26w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqT535SRzR3L8fRH7hoTv6Xq2661P3KV6csnzNOoWJjw&oe=6A901ADB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWYr2tPEXaMQ7kNvwHgKILc&_nc_oc=Adr3ffkfVqqauYvnXV9DrVb1wJ57kJHHHOL4aJa_YoL6Gabt4w599QtvOMy0Pb7f8MY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcEfQg1lendwmqwqOUiEc-3SKA9P6zunllNg-UdrB0xA&oe=6A9025BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNSfaUQHrOwQ7kNvwHBbO4v&_nc_oc=Adq6hfzBtX_I3Gvdu2f7w-GWarsTpGZ5R6jzcGISbPK8Hn2zS4K9_9uWvPzFqP74Xzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBNQSypW-uVrj9E-fP9jIy-z_DWsyH2D4EPvQiTL2Txw&oe=6A900C41"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
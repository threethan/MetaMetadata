K_a&_nc_oc=AdqFGvFeSFyqOaIcoO8Z3IcIdUNKb7oaPIM7iEvpKHwU7wUtyiqRMuiJJiqT6A6Wfv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c6EzyqOhLVYUBIB_IYY4fR6RXrfVl3XbovtuhB631cA&oe=69FB510F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wfh1aIVPEh0Q7kNvwELU-ms&_nc_oc=AdoqKlgH7UB2QU9xuBq2_--RjzoFgGZcy4tz0z1p1CNagosEFENB1oQtDZGeAMDuXPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fi4CFPqg0OL_vol-uYoPYg53ykOtg2cOe5mtEr2yq1w&oe=69FB3974"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hySexQvUPAsQ7kNvwFoSTb4&_nc_oc=AdqhgCDN9wCyrDdFl1n_mBJ15EPVC8usCnU_tz_1AIscfz89-9JxNePnR60j2H7uElM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E2P_AVZpzUHwD66pz3AeurMDf6J3RobdDDJW-vv0Rdg&oe=69FB599B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub6Hs2_DckgQ7kNvwEnhbIk&_nc_oc=AdquD6m5Ut5AHkDFqO2ESBkn_4GrtahSuiWAx_cg539kpDb80fJ01Hjd7jG1w3AAA1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73f2RatCt35IRGvYbBw5I7hQows2jkUYsNROXSOGHLLg&oe=69FB2C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq8X81VGmPsQ7kNvwEt7bUD&_nc_oc=AdpoqPGT-kJe0nATzjWcSfJi7mb6yvaotvQqtIRtYEB9YO_q1ktQWRS2SkoIsA3aDEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ow1RoXCPnu2aAxzOXAVCFJlaSJlMIty9UMO_HzLqb6A&oe=69FB4B01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
FwF&_nc_oc=Adp_ifBqnvQ4ueFsuLH71wxdxsvgjoZBhpcVnLXlOy-nQDLXiB_AwGKiJXv03x21YPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjAqHsSOOa4oeQZcQS3CcfjqexWCFeqilu7MKOXYU-aQ&oe=6AB2918F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th2FjFXuAPkQ7kNvwH83cge&_nc_oc=Adp8drZZEFFQMFO_C82gcVT4IbkP84hptgSSejwMideUwjKlwsZ9fDb9oR42fI0fkCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAAh2ClXlHSAIGQEEKKrxQHPGoR0cGPrHO8MvSmurmkQ&oe=6AB279F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zC6hkb5uIoQ7kNvwFVPV9T&_nc_oc=AdomMaUBm6E_afmuprS6C_ySLg1E6qXG4PKLCCnKXRtbM46Gr0fG67L_GKyVqt6kTuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFmHGxTrA6_TA0FopHA108VR0ooHtLIhuIb9arUL73bQ&oe=6AB29A1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgDtVU8jKT4Q7kNvwGPdjID&_nc_oc=AdqXiA8Zj6Wsrn7pfgjivjB4Bkfwlyr7ayunlItZp7IZFTVd4ZxHIs8ULB1mxB20D6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFAfdHjTdcNp03aCu7a6ZeHPTi8SQMHLPT6C7oQr3MYA&oe=6AB2A4FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bla-uBM3EawQ7kNvwG9Z5Xd&_nc_oc=Ado9iTWoTgNUD7c8pGcklBB6CiQOCXG2KfJo-ITDUjAmpU-rmM1Alu5Ab1-0jBjxdKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo9HGNkDMkAWeiyDDkSk0BSr5_Yrp2cWRGmFk8JYnXPw&oe=6AB28B81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
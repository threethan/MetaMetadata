318&_nc_oc=Adr1PAZzs6lZ7cex318sw1yFDgGw6jgd3W76Us3ZJCbgWfgU8FvUBpPNJSuDpR6yE4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LL1W9Ub9WTAc4YCHAKnXAiuZQ5de3Em4uzq4eH7ZmLA&oe=6A315E8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO8ncjdADt0Q7kNvwG6rHIO&_nc_oc=AdqOQ4rU6DujeYTp951SrCfRcR0vDFs22jaeepd6yL4KQCYaP6kWhsiCd1UQ9CbXrmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6SCSEJLkvrO5g8yOFmd_-mxSzaV8TzlOfL1kcdO7hlQ&oe=6A3146F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChdH3dWTbooQ7kNvwHVF3c7&_nc_oc=Adpd3uXIhs-5vJTEkCnE_PV1wmWUhwIEMNwy5slqz5p0U_xrQh-SAxgD5rmFMugjsjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vlmd2IcPoXCVfYxFPFN_64nV1NA1DwJlf7zBkPu70Sw&oe=6A31671B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFCbH9qjddgQ7kNvwF-__Tg&_nc_oc=Adq7Wgj8pqiYS2kf8DeIR01r-z3tdeTyGCmBGjRatjILj0TPEMADWY14OB0mPSNbjeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i6rUQbmZl7k2M06zgh97IDKUqCusYVt1Zm1f3ddUi7g&oe=6A3171FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4qgXcNOqEQ7kNvwE_4PB7&_nc_oc=AdqG36FSykn_t-kMSwZWOhd9_ZrqWMOWfJWvbhCO5w7ihJ7I6_r0hwQsC5gOmcc2oUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ovp2tatORvocbnwugD-PDrwFzP7WVrP6IMtmRCOiuRw&oe=6A315881"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
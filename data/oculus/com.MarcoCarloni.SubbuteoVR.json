wEoJ3dT&_nc_oc=Adp6JAaLLGBxzgjfMKzYjNqU1bZYOGQoeQ5iRZ5WM0wY1Je_7-opm0gQfoRTE1A3RAc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsyw6pq2bedZD4WGKTyzvA0XPdWpTcsCZxJmEcsx0c1g&oe=6AA9570F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LEQYuw0FckQ7kNvwEE5d8_&_nc_oc=AdpprQQfeOLGK-h5yKtiGjNut4eVLq0QwPwyBbdEb8BZkKUl3-dIwyr-7LtReI28HA8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvsVGSdDVTd6rjWMvPmTKUobqqOhQWE-rUW8xtA-N6Bg&oe=6AA93F74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_sq4sIUquIQ7kNvwFBzVbS&_nc_oc=AdpcCLlTY5Iwmd-mP5fA_AAFZ9MNQgHi0RO3TK7J_xLTHlCOFORFGNt-R7uw9hUAFIg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX1T_rt8UK-pyNyAQDe-s-5ITtBBvlttCr0KdPUKgJxg&oe=6AA95F9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwTuwpHFVeMQ7kNvwHwoV-E&_nc_oc=Adpnx43frG14OyUwDj2uDM-eCzxCvFFDfKcskA1CIzR_CR-_TbuxK9DDH-u_gd-3Vrk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLAtJX8HozWgiQ4BxhwAnTJUc0DJhN_JfwHtpLi7DMeA&oe=6AA96A7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9g7h3UOepkQ7kNvwGZxmiO&_nc_oc=Adr2WR7y3bs_yG9CD8fWHjyoktRWG79jfCu4AHGVEAhPjiMmHISzXOIMI9TFSBLLCvQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuSG-TGurrvTxuPrPaZk0bO19SMS_jIBpM7IU33iw0_g&oe=6AA95101"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "
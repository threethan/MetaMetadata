djY&_nc_oc=AdpLYzzmZjW_74vgIq-TX8tFEO0mY4vnXSXMfy70oInTXJ99pbzMvEFGhH1p-Yvsr4E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eMwfEAh4lUCm1epQBI7hjvKWuFsYQtz_RMNL9fR4AJQ&oe=6A2C188F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3eWzxWoOAoQ7kNvwGRQk8B&_nc_oc=Adr3AWpj9k8k70CSuiw-P2a11xljPAKpvTnZkBGDOuUJ1NDQDDzQDZmsqYDSgz5u7DE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5zMY-8wJDrR366j6_A3hbqFdgWK3bA5do3jweOZopuA&oe=6A2C00F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAYTpXBwvfkQ7kNvwHfRZ66&_nc_oc=AdogYkExKpB_qpHltm_TytdiA2yIA9H9Ut9EYOlmeOfdQOWDI0h6I6Hi_4oJaFJyvWU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pVqY-tT69Sxb8iAxR4l1P7DhJ5UmdDccfo8LPIE4JuA&oe=6A2C211B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvnOLc_MKmoQ7kNvwF7Klt7&_nc_oc=AdrFehlnSjZhEzNzCP0ad-IP0sYduiLg1ObrawRUF2JW7hJipaYAx9JmMvxngZXf2b4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lAnigt4K6JODfG37hff-M60NzTl3XeGwjd7SmxEcVUw&oe=6A2C2BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LNOjbBxi7YQ7kNvwHP1Plu&_nc_oc=Adqa6huAWqtkhgQvRygDTslh4KTlb65TtCNvlnE8MZcLshSoejHRsNxWJFkwJczP83Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96t5BoM4K5Ql7goMYJ-6A6yq2rsj8SZOzsse3V7OAEcg&oe=6A2C1281"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
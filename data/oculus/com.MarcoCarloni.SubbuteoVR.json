yd3&_nc_oc=AdrTzr3CdX0aImC0_QynqcV_iw66G1BSFgjXCnznrbkwNtLoLDYonj9Xm3o8At9YXq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiFXjXdqJRlIImLrA6nHPzI_hjCv_B0nT5_yKiexfhNw&oe=6A4D0E0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5bhw5No3_0Q7kNvwGqrS4v&_nc_oc=Adr1wiHEW7IJnamZqexeo0fH_7pqTkzpsDX0HOAgYmBu89LQpv8plZxda67IK1t_mQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8EyItO2kMK9jT-lBlMhCacKyDlq3FNB848dvb3gPfqA&oe=6A4CF674"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_i7NOZsPGwQ7kNvwGRWsPh&_nc_oc=AdpiMP1SZH_RHiq4F2FKgBOrcTe4D3_cmibtLsd2sjiMvEyRZOVyrnigT1E1r-_8iH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr1NeUipsliCrOwaPklqLCxi29XFokadohRoRnyjsaNg&oe=6A4D169B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdcvGHnkKQkQ7kNvwG_K4lO&_nc_oc=AdqGFIMlezZglAgyc0_5VrQT3kpDNvF9uf5D5iXq-EyY4ZM4SmOoUa1EtI7bW3FJ-Wo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlCqTSh7-xtPRa22nhACCqj8W5lm5apUnKyl4EjUyEcA&oe=6A4CE93B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80eklqqf564Q7kNvwFbhejq&_nc_oc=AdqIdqHSJzS6bgzdDF2nrRvTdPuyGTNPR_7AeLyz1fs90Oq2y-O2-Dx5ygIisiLm3mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrwhCT8Gq2jyO3poqOEa9Z5dN8ABB7BpThvWhPfaBnJw&oe=6A4D0801"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
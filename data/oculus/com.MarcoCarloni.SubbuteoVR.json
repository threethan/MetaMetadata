ZS5&_nc_oc=AdrL4sVyLB64inu0431HXVn23Ono197SjfQA183hLiZr14Ci5G6AHdO5UK7vI4J-GFw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpkIwgGItoe2mFAKz8zjuz0TeNbuX-I6AMpoYGTFTdoQ&oe=6AC7A98F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOHYTvKtNiIQ7kNvwFSFUVy&_nc_oc=AdoN2L16H10qhUK2lYkdWcotQrLSlMQQzsaU66c2YggqseN7kWviRKPazMDLUCB3iBM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXj-zBoTrohcgUgOmORfMYx3I81lFCWo251iv7kQso1Q&oe=6AC7CA34"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU4K9ZplH8IQ7kNvwGWcCjG&_nc_oc=Adq20-8VxewMFGOL5h6tLaVwXWzlppsa0Xutfch-f6B_beE0LYq2bfE5PHOSCKTVN3s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm7UpBEsvkmsselCIPAQ8rYlSs1uLDg5JnSDvUR4OPOw&oe=6AC7B21B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v64D69W-104Q7kNvwHSASYd&_nc_oc=AdpqoCKFePSdRABt2D28R93Gzhbh_PEjMrlDJ8X5d_i-JeMxTaqOWuGDAd_uDroqa_s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNes62IIUCSBWfUA4rJpERsN_FnsAieqNhXRnk-Rl95Qg&oe=6AC7BCFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SZWz4dYUg4Q7kNvwEwkE7p&_nc_oc=Adq4_EY-6bk3LTcDGle04KeJLzpTr3K77Xbrm8zZSm9Xv_UpESUkxyZXEzJmgDPpaAw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP0nKhxOxDRm7huJ53TeJQHdb9MCZmk18w9JlA3ABnsQ&oe=6AC7A381"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
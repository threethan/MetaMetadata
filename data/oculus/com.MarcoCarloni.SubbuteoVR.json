yQQ&_nc_oc=AdoqZ4B0aaxqhSOXP1Dvadik9oP7pFYF-S9ytFOEFaivVUbmKymjzZxGE4VqPURlw24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTkEV_a3Ybbk6Tkd83SEVrf1BrPNkd0Al5j87G9V88_w&oe=6AEDE50F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaLXXcFzB40Q7kNvwGu0YLr&_nc_oc=AdrX49jKqWw3BzIFC32T-AKcvf1pgLMCyYFZGjMrERHOv18aO-R_AX-RaFh3Jofd030&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ20cpbg8-LLQga07S-0poxdp3CiRcRC034zvlOLmq5AQ&oe=6AEE05B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jdr_Eqn-z44Q7kNvwGDhwV4&_nc_oc=Adoa2s4qx5y3UXR_6tVTdwpmpvGpwU18pJk3GH8XxvSqah4yMBHAFMFFhrCSugiJfic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6jwJUtDXhugWzpz8hqMXCDS0JTqIhlrFpqe1Zi1egxw&oe=6AEDED9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IzOzVhR0i0Q7kNvwGI2m8a&_nc_oc=Adp4Yzehze3R-Y6OGtlm_3GlDYIo86UhYiiJPQWz9R1Cfn_W_0qDd-dLFE-0CaKVCEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScUQmMPci6zMQcIW-P3pxDOMilyR1K1yGkx3FZUo54AA&oe=6AEDF87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sov_48EU-lAQ7kNvwGJekCY&_nc_oc=AdopG5IfAKMzz1TwqATUhlw7rLpa0woO927lxi6XILYeENLxL3erk0oaA1lyf9P_ciw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDexJ_eMucebG_Qpa2m4Olqf_9B2s_sKS35w1wjniZVg&oe=6AEDDF01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
p9w&_nc_oc=Adok_zbd4H-HI7WrZLdaR7q_u42W2l4a8Ws8HujlhJOKykgnq4iWwkVjcYW4JrhpSIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0SrPfjPGn6CrQIdiMRSkTN03k91Ibv4XkMnNx2tkFiQ&oe=6A35530F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyJr0SfogUcQ7kNvwFB3j3W&_nc_oc=AdpMix2JTDfufPFDWkYzaVSnbbcNzhfCf3bHwkOu0G5OuIZZnAhMqK09FxheddpksJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__8aaVMMPCPztHxS5MYIOz0qxpoqxWucXp_xWBkMCKxA&oe=6A3573B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggViFEfrJBMQ7kNvwFR8TZ3&_nc_oc=AdobS8kdsjfEEsrfi3Qyma-4XZaFvHTi8HLfAgnPeE-7kcd2jB1_dYios-qg7bnxpSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GYZ5MXh0iU1blczY76NIyJ6DSovSGSAdfcfbDOJosEA&oe=6A355B9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1qzyY6ZQuUQ7kNvwHvI07w&_nc_oc=AdowryUxMG7Pc665afquFCKcJ9RKQsxALEi2duq8Fwm0nLsno6qqkQ5K-HYwgAJrN-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x-XRAZaT0zGd9Y0usZroOnp2vXGUL3iJGfLrAtXwbQg&oe=6A35667B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jau432WHte0Q7kNvwGWK3pa&_nc_oc=Adrnzl6p36hjJ-VNE_6Iy_KPoaLWNamJOZrvZ_RM3dNV3ENjZlVmFMolbVGNg3CYp_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83LHIKT96XYk1bVY65O9VKJhcxpT8dBq0DJJ2ApgjKww&oe=6A354D01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
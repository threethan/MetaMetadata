avT&_nc_oc=AdoddXuEke3UDSdBKtAy5bAJdwK2iZfwbh_Eyj3DbaxtFpFMu0EJatms4mACwavWpK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPHIwhNhZWEVC2GhyChFQhCEdm-_uYGJHWkhiM4QF2oQ&oe=6ADE130F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkBYWtxJWRkQ7kNvwHm4d1s&_nc_oc=AdqNYXzCyGmaMkbTR9objon8N_D0uJBv9nv_2bx6j9fRvcTMBrG7jn12pKUppmMdWtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvzdqnwkhI2AOvFYv2jENalpOSsBGXBGTMcZTD_mD8Hw&oe=6ADDFB74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOxbnW__A-YQ7kNvwHVYZKH&_nc_oc=AdpD_ww5qWm0SO_vJew_uPHP_TY5wwJoHr3eDf7canAGmlMRbWwoUhL7wPU6XPpu7nA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzESrXLrZeBA0KR9V-CbjiQwH8PsOkciCk3NDC5n5v3A&oe=6ADE1B9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvUM34B_O20Q7kNvwHId7Fr&_nc_oc=AdpKOeqF6EhrxY0HE6udFNvxqeRU-qxWdU2JiYG5owTIH_KStCLtNt20odgS0PFMtVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVKhYYBVr5XtWW0APXR1KVmWxTYEpr5FmChcHx_080-g&oe=6ADE267B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XOn6Th5L00Q7kNvwHOXRy7&_nc_oc=AdpSPTciAtCmPpzhHarOmii56JxJI7Mop6pz_btBJxfMVE88J5RQQShBRwC_s9LpDgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcaow3UqmHBanUN6XT6ecsuarVvyI0U2pUxq1aNrG92w&oe=6ADE0D01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
l2_&_nc_oc=Adog5ABww5V_s2vydpKsW7RBb6I7VkUuoCzs4YcAglWojwkXama0nHE_ToVRRyN4RKc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9zyn89JmQHusHGT-olqXnp_phkXvCMPkOzc-bNnwPPw&oe=6A8ACC4F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-M5mpC8WpEQ7kNvwEXbZox&_nc_oc=AdpZnrQtEyBb0hhbZV1zdCNvBe2ktyTFV6uBsW77mx_wFho3eR4Q05b_pBX88cNNot0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9nWr4oOHhNcLYRYpPd8AfYTm67JZ6XuJm9ZvzCRXLag&oe=6A8AECF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrG-bj_xMW4Q7kNvwGSOaUc&_nc_oc=AdpjpRHfSiIMDUayflG5xaE2CZvqPy-iEUrqOPpJx5i1fr4PMMke5aC6nx4MiYBz0LM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbkxo7KIARH-8A9VRVRDur04xCmSCpO-Vyk9WfEfh8fQ&oe=6A8AD4DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlYq3-pOVpcQ7kNvwGCKcvO&_nc_oc=AdpZWIHpdmlH9WdTbTCaJdjxSu1uzN5NEKQubfxqYQelVlk-N6eV6THXxLZE280GFow&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhnLfQgdCMvqcjajhQ3Z94AOUHw41D7OT_JlRqvFhmfg&oe=6A8ADFBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VuNSizLPOkQ7kNvwEZqM8W&_nc_oc=AdrmbYgRCoweNy7WhQ84KVLHFc9it7naYyA_9ktuj5bm934KmDi36kunmmpaXk4hg_0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqDZX2kqCYl41BlhrKx3Kr2cU5_iTFhFCSJcuY9a7EGg&oe=6A8AC641"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
kNvwHUqQAP&_nc_oc=Adq9GaKhLnOBI_ONo3usCphkn44L8804FpCtMmxu4-xaXpbR6bJ4GqIrtNqJltna4RI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhNnu8CXnFhRBja6Kbvp1hdn4iQNwx_6i2TmrSVKuHmA&oe=6A8EC0CF"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJBVcIb4yoAQ7kNvwFkSAju&_nc_oc=Adqahb8S5oTm_rQAiRHYvLJqowY0ZKevTg79F8W0rGuMnoX7tzNSFMYEhcE2tdbeaKU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdcMUnG2QhHucq9fRUA1yDA7nuQ06W962I74LrcOeh7Q&oe=6A8EE174"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRUH6MXI_pwQ7kNvwHZa8kX&_nc_oc=Adri8epZh1jG8KiiJBPWP5DvGrs0OoG2w-8ThHuM35y1upjhzXFudoTaiDQZT4qpHDk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2OJdxfqP-QKTQseeYFq_SDz5rLD3v04uk0bONJFFgrw&oe=6A8EC95B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDNv-6kWucgQ7kNvwHk2Ar2&_nc_oc=Adqkt-Bb5-zdU6AbWM77eEnFjhBo2b0pWReAC3xFfIpTURnPCVPqC7EAwLAba_LsKM0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5NFm5MOVHIwG9LbxA7iHNMTvC4uaeoiMLv6yzDSMAxA&oe=6A8ED43B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNSfaUQHrOwQ7kNvwEBgeq_&_nc_oc=AdoNF9bs6_6C5sre5TJx4Vq4g5Kic-WUxqE3VT1MPxVFPTi6gzbAbRn9sRDugLsnXig&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSsVW0yUhAT4-yiEusAa-gPlLtGyJ1kv-g7A2Eg_iZ7w&oe=6A8EF301"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/
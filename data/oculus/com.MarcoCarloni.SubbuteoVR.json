LzR&_nc_oc=AdrXsl5Z4Itwns4dujA5JaDRHqvbZifjKvzYo59cBYPlemI4J2MIBWWCR5In6vd-BOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54iy29NBxfY5ZNXrPzH3J-jEDYpsWRmYpPiHHwFjyhgg&oe=6A01E88F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iRofO7QciAQ7kNvwH6HX4J&_nc_oc=Ado_DjsLfLvF-_Bg_HZEwssu2_CtHvGimP0X2pSG5TJdUvYbv15bnMS-9Bo6LlJQx7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ylJ0TXXJPOT3zhv9nAQNyvegUubpL_-cFPXBMHQYNLw&oe=6A01D0F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOlgLr3jRCkQ7kNvwHNUChy&_nc_oc=Adq4nkW2uqX6G7u_JT1yFVbI7-Vjo_l4TMVtuXdOJ4EmfXy_sEH4CNNE3BezQ_OrYc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60hM3S4ICqaJ0XOvw3GcxlhCByE8COq4OZtwt2W0ANpA&oe=6A01F11B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwM9SwCBEI8Q7kNvwHG-8Ef&_nc_oc=AdrwTdigAeyd92F1ot2zM2hv7CT_wlV0_ozvLP1nDpB75lU8XEJ5zhsdDyINsNCxGpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EIVAPC03uQ5fsYBQ3ChWhErZQegblQKUnrQBh85wvJg&oe=6A01C3BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMvjOAeYFcQ7kNvwEtQOia&_nc_oc=AdoGNIW3Qk_713XdHTzvJSBCQPAMrUTl2WGpzuEJ-ZfJn8arwz1FdcHidWMIUtseMYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49eOhLDeusUydMbhhd-TvrFiiMqfz1A2eXDBKs3-yA8w&oe=6A01E281"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
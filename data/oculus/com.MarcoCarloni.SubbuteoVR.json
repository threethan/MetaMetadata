1dq&_nc_oc=AdrT-ba5TjV5TSdah0AuAFJidkdQ4iU2oThCJL7G96V0Shd71U4btyQKQH4YX41aN44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mZlAYBXSLWOeTjitoa5ebh80jJN4nUsmk4PwKRLeRfA&oe=6A1D980F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia6atJNRCuwQ7kNvwG6dR2p&_nc_oc=Adph1gjAF3KIxZcD6BDhDIVjH45wSeGP4aNL4hXKaemx0ch9ehIN86zLkjAiYxr2FNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4USwaxqEcxOJ4PtB09ADTAkQTLecn6a44vbp0fYwvIwg&oe=6A1D8074"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl6wyXVIJ5YQ7kNvwENYeWh&_nc_oc=Adp73dPbocmfHZro0nL2lPDmr1hMSWzRlxTm_d2clhWN28dN4h8-MoDG31b2dKrkhfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gkiuzlifGsf4fQ6cI20QO_EjweNrKQ9n7NCcD5N1aDA&oe=6A1DA09B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWmzZkS2vEoQ7kNvwGHwNcy&_nc_oc=AdojrSdkzjB448YmsRX_dU1TAiY37r_UP8AMs7eZ-6GzZxZo744Yvo83qGh4VN8SNck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75E7-Njw1MSSko_6B0T1eFZXtbSLtMHYJzK7HH-MnkOA&oe=6A1DAB7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_eKb-FrDwsQ7kNvwG0t7aT&_nc_oc=Ado5HfQcy9gCbQ0YlojCdaIqdDd4k79G625pKRwGSkpHOIkv7lngVAghJwJxee0A_ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zvYl6-u7UcCyd6PA0s9FLrodTACALIWwzYlRiDw2PdA&oe=6A1D9201"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
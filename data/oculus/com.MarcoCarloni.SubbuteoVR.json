wFlK2WK&_nc_oc=AdrKpMNd-Cqx-TfFxlNonje_IZS8gKOOJb7jBz1DFWCwJg7-ZW_oQyXTYpnyJZBFjYo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--7ZswHyUuijRoU6-C0ZHhYuf7leRYTOtXflOlrgL-GQ&oe=6A46768F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIxSedrvLTIQ7kNvwHYx7QU&_nc_oc=AdoPHTCZefdWYCxC1TwyLpG8DII5pwHp5xlqABGPvgHae7JNPbGbmtLMrn15bprBvko&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-AeFRNMAyw1h6lKdjplDQZUQzERIv-ctzGqJBA7-65w&oe=6A465EF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qllVt3iBFZ0Q7kNvwGwy3G9&_nc_oc=Adqh4MVUj1vfxsQ1eCfzPQ9AR53jRh42YCIHM6oQBh6I59W9oSitYmxCcfdtxKElIBA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nY4tH4k7wH-EbwfEXZFzUhS1Y2s7-7sD-68Bg6QBZTA&oe=6A467F1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9n25VPRIgQQ7kNvwHQiypn&_nc_oc=Adrir0qYQdyBu6HD2XYtv26-lLG_EnOpXiV9A9Jz0x9kqWTcpCQoc-ObkOCAPyoj6Jo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a6bGmvw7uQaH7zjveFYE5wiTRjOqvnaD8PtO6ktPUDQ&oe=6A4689FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5MeTyPXt-cQ7kNvwH34V7y&_nc_oc=AdrNcVxJtiS2BA8mVtRFIjNj3d8UxmkEGjS_FiC218Cca0WPfta_huhJeZ5SlrX10nc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VEsfUg-5PpJkEaLJZhL6Up3Tt6k3gIPtfgKCjkpH-gA&oe=6A467081"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "
SyQTdhRi7vscE2g2ucMBwapmgmPCZqX2r8XsvBgrHQDmjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfynSEi5u41VYchvRDiO5sLJPPa-KarxErGzEIsy8MMamg&oe=69BFFD8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwWEiMAiN7AQ7kNvwGDzcHz&_nc_oc=Adkj4sMzOVeQEG43F01LBPYeF7s3ucdtO6GYPk9BtYLrRnwKRzVIPCZ59qNupz1K-zM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylkwpzufvhLNa1UhiMf-5WghXUl9HMw5WeW3KUrt2Y4g&oe=69BFE5F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e26It7EyAmQQ7kNvwEi1lAM&_nc_oc=AdkAYfJq1VIaYDLFQxOvJzI2BIfmK5UuAfzS9O6OiSy2kV0aZuF1pe3zyLbp5ltvWbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKWGpnp7J4LEyJt96f3dmz1gNL5fGpBPm-rHNfHcQuzA&oe=69BFCDDB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYhCIgPndqgQ7kNvwEroOID&_nc_oc=AdmNHd17Jti1dCnUv9x6VIzvR6xumlPVlyT6nJFttC0mMojiVSyf2ypVI0nN-NPL1Vc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGtO53U6IX6GvxvsXoJ4wlcKsIoy4G57030YjVWc91vw&oe=69BFD8BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSkL7vNl8eUQ7kNvwEFUn8A&_nc_oc=Adl2LaTidIYaLhTLPoihNuvFSv4twPX_DvIuHjPzU0zs4nR4-I0-Z2dvHm-ruQ8piCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylnA1mTIn2SMd_ufj84e0soEWn3oS_nmjikJxa1Nvi-Q&oe=69BFF781"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
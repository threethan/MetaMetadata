ywE&_nc_oc=AdrTJmxZVKkZtTD2xkGbw0AwwSu_z4lCdbuwhQWS4UzF9nAsWsMMl8M-FjucYI1mYxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP0r75DDpcfwfZLXSzvjRuVXneQO-ml4ZOSKzJCasf4A&oe=6AE0B60F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o92PFnM5x3oQ7kNvwEbEGUy&_nc_oc=AdodK2cIPyTvt7Nlm6L0khJvwPAJqG521KiKwbUHXgWT_wsZ_I_GfGu46MVEWaLdxkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAaxuf89u3vsL5TSv3q_065yuyIjmRK0W7L7af4KQfPQ&oe=6AE09E74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOxbnW__A-YQ7kNvwHIGKcm&_nc_oc=AdolByVaRztiBYIQoRwXnTIH62p0OvzmBk1D5aQRbj57kF5wHb3-_8CDFkYIy0eiwHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXVMsBu-qY7dOfaqriPFpnBNQaVvSaqvJ9ACXrrCOB6w&oe=6AE0BE9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2Nwy4n6NFsQ7kNvwEDOTi_&_nc_oc=AdopM9Vhmt5YGaSNmDGqPy9b2kQ-etbwHi8BfAYwItcdUe1I-KNPqt7Ca0e12mbzB94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMamS1dVnrt-XC3qvse0mCFvIFsEBeNrlOdRKYNIhNhXg&oe=6AE0C97B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NoQq_L8_48Q7kNvwGzMguQ&_nc_oc=AdruOYg1fHbQRZ5XB234_DS_kgPEGFPfaUpcrXJaOrAuw2w61-nOh9wmoYcAKkcINY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo5qCY4rA4W7H3e1CY9g3CR8R6v86uzdCMAjjhX5eEvA&oe=6AE0B001"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
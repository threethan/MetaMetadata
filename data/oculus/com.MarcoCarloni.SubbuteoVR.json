nYh&_nc_oc=AdrwpA8jIa5oGkucpZpT182kTVMc5brGXlyMmJsHqM30Fs7AtgHZheZ407whufBryMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NvYJRRvI3TbuhepKgdcf3L4j_Am5kW-LhwziIlOw1mw&oe=6A29758F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roEXSpVtS0AQ7kNvwF3wTjY&_nc_oc=AdokdMAprWvhU6J7z9QrdYiql_d4jH2Py3hMWXxNDm-523uM3Mv9Aqpe51VHe2lChsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Nnnf5PSdKgJVPHxvTW5z0rr_rp9QlNuGzb3IMJoJfQ&oe=6A295DF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blApB4q-F3cQ7kNvwGaiGCc&_nc_oc=AdpASNKzHNqr9lYVBmxDF37c85p0ARBH98J42hWlWqHt8JGzubJeC20jvrRt4E7aEno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QmNNGfDuVz-mAWL7GQfVW4yHTNewcS_GFzMbmInMsWQ&oe=6A297E1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvnOLc_MKmoQ7kNvwFuvwfx&_nc_oc=Adprxvkaxt2UaB7A9m7WiSqH1Tnyuq1KlKQVztH2rN_OjBJJ-05N0SP5pvzQfifb0OU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-YVNYRzP-Cnx82L-GNNSzKgFtMUMWnatG47K6iJwDmA&oe=6A2988FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eSZKUOnb08Q7kNvwG7CgVD&_nc_oc=AdpJPc-OZtH9G4cV-OBaWFbXHw1O0bL5VRx81nCb732Ph_ZNqPXhMYy_SuDpkbck1ic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4bgcwPps9OpZtZZfVQTNNSjGF_-3Qlkt9r_IjAM6SIQ&oe=6A296F81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
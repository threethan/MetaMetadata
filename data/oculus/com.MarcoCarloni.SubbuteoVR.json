nB1&_nc_oc=Adr-fDZ4tvmXapgUG1Qjf6lDJV6L-w3xoZRhHozdwxg7aIvZrf1hNkdpDiX5yMGXR4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRQsV3lyExP7UCMYRyGNpHvl6RpsrEQzgGsOgp5u1CCw&oe=6AF9C28F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCimeEsNtR4Q7kNvwF1DGUg&_nc_oc=Ado3rGxmOF02aGnuC77kZOl17V-QuocONlcnl57aimRWZTLKB0kn5cqf72m5nUnlr6Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFct7dwhb-qXKlQuR78wXgpLAsg1v6bmORhkg8CfiTCA&oe=6AF9E334"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WF2Abqbk7_4Q7kNvwEK_UrF&_nc_oc=AdqJl8XNhkfVN-LgXrE7SqQ2NUtE5O2kjUVfhWQdbintISO7LrhzUnpmF0m9NXj_ZoA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlhzQ_jV39y4ghu0pgmtYk-Tu7c6Axm3jM0V1FS9wCZA&oe=6AF9CB1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzMJeuCPEWkQ7kNvwHT_bs4&_nc_oc=Adq7pKvr5iWNvt8DJmNHVG-Xckxh7OLHpi7OyYy0e8AjLoRlVIBDhdWZAGM4fF19FkA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyE_AvkM5ERQfw7XNRFw1azU8L-JBRPW_0Q_hxGa5yag&oe=6AF9D5FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIoo-k_se24Q7kNvwHybkyk&_nc_oc=AdqSbXEVmhvibyrQYIkpkEg0HZWYZ0wPZS6LPFZObreJif5g22_JZMUDqnC6yj_PNnE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrDn3zRi7whFrqfj0BKZSUjGr2uRwfQRv26RLmVpNNaA&oe=6AF9BC81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
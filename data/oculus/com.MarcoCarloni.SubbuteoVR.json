DID&_nc_oc=AdroWgTiixMlRHj4OWl_FyhBQ2ZHfHsy1mvGHqe44ElNE-colxgqOAY3zXkrsc2JLWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLAUkodtj1amEll3_R0pVac6lfxnFDF9ggy7viP0GQKw&oe=69CA898F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xKWhJ38myUQ7kNvwEUsZZ8&_nc_oc=AdoqotNztY8Ofe44XRGCHHYfdO-CiO2AX-gK2ljwY8pX8Dthv0NLQBPVzWVCvj_N3-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuG0JD94TOj1jYr71oSi0WblMuI2gjpbDhDrkK0eb-zQ&oe=69CA71F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4-dBTo1_F8Q7kNvwHhOCeH&_nc_oc=AdrhqWW9qYM9ATX8y_bT77qluqqRFk9i-XIZSX1BzITpiZ2_gU2kySef-20kj8U7bog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNf1uWV_NwKi8oZndZJ4Gmr3F9mNpXmxW7tZqDxbfQWw&oe=69CA59DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KezvtFffM9EQ7kNvwEZ5lOR&_nc_oc=AdoPcgAienQO2mgGwbHYCh5uZ-WhNuOGFMOcRzzyFdAVH2hgqvfxlAK4mBWYwpGEokI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxbDK1IcGBIjk0E7P6lg2Xr_YQ0RnMXJxcO7zhlv9EdA&oe=69CA64BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIDZUKLUbdkQ7kNvwEB7pj_&_nc_oc=AdpV4ouTyl7mc4_5OmmI2DM5pa56fjIdIxprHF7JesGAGk4Ej8OSOp0gA8mGjUVPKlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbBeoyNeRFOySAodyTAWCZILJkAt90keroQ83594v4pA&oe=69CA8381"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
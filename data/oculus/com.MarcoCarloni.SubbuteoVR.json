P7h&_nc_oc=AdoCg7QTrLUm6xOyBfGhqRkZP8zU-wrId0BWf4E04Uj1b6rn5Kd3S_0HNW9rcIzDojY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8LtTRNLP1OlUs8LpIJu-GmKj_31k_G4nv1gQucVxMHg&oe=6AF8A94F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCimeEsNtR4Q7kNvwGND8I0&_nc_oc=AdoOTxHB-9Z4Cw345HATX8V08f9bKxRavdjaWUN85_AvSt_VHYkxtzICj4SqN-P7YbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1dXDdnyUMhHYV4zzhzloS-I_lapoQ0DTd2pQ6eHB5bw&oe=6AF891B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlyZsFBPzkIQ7kNvwGgcZIQ&_nc_oc=AdoIgekufUZFZHh9iAgiFsByoyG5PgjctkcL6kpDzfzihnZ8KYHCqi_WdnS_wtjtv3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnihdeSmd6riDJ_4U93HKmvjEyDaR6E6QIGrznJqkKeg&oe=6AF8799B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzMJeuCPEWkQ7kNvwHUdkSa&_nc_oc=AdobtdPPLTYnsHAGkfkWxMUlBKgZ63NIvhQ6SKekxTQVXQ7bv_DBrjT6ldUIoRahrL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTHQAvpx53stMQsODz1buLfpLEjAqGe9icjG9LHlBO8A&oe=6AF8847B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIoo-k_se24Q7kNvwFrzgpr&_nc_oc=AdqkAIAJD4VAIriXwblDSHD5cMMAlLk9ldIWRn2cVpIew9hSQCaPZ-A_m6UrMIIN_kw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpq8JgabCTRbvKlRl1XRPHZTJy9Hf7JcJwUfmeeKG70w&oe=6AF8A341"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
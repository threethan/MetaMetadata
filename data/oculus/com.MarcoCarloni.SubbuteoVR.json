kVx&_nc_oc=Adr8ygnOrs27td69Kc6T0IaqT6GA59A77fOqPRSk2MZ1CCA7E8d_IrzPMQEFLSzxFTg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E6bxbABTXjGAgTfTMdNwQyLIJDGZujPxgaTvRn1eB8A&oe=69FDF40F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJOH4sYUzssQ7kNvwF0ojsH&_nc_oc=Ado0WCKeX9QcB0G_zHuanuynPB9haMylp1IgQcaeCe5aR_6aLUDqsSNJZX_s5qdalIc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eWqmKPLCLB61AwkujcP2ouDSTJ3Tf1VAzes_FXaFKqA&oe=69FDDC74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyCgMrxDygAQ7kNvwHn2bO0&_nc_oc=Adr-QiVZvig1fyOaA-ArUY7791gBq-Iwynsd8XePo9Q8PHrvo0VYlgDpDNn0aFMbfEc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mDdyCaE_7w7b6GESQoFsF_uYJQdLg45uaYvGDgvfZvw&oe=69FDFC9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL-JMYLIdQUQ7kNvwGXB9wt&_nc_oc=AdoWZbz2Z0mnWzsPhIP19m62UG_RrZEHQMGSbKmkAH2fKqbtp1UUbHXBs6Mj0xecVGo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CxYXN8Kla2Gxk3nkn8xu1a71A6VDtcn06SisWRylcVg&oe=69FDCF3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq8X81VGmPsQ7kNvwEM3AhV&_nc_oc=AdoXYIJ9yblxzVDZbxe93Jzovc8La-kAugKocZPOF8v_CdcHsod4WMDCg2HMT8v-_io&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RNOXzxq0t6tj60EFtc9SwYKuZFp8nEr5OXSSYYGEYzw&oe=69FDEE01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
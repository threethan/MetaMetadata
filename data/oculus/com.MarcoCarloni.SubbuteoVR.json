7rW&_nc_oc=Adr8j6u5aHsNOCjCmiL1GlVsEuQCaJWV63JsAanSmA1x1wChIM831t09ome_TME3fX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSZnOaUm7kzxRE7YlbZ6_xElUpxOelUbU3yTSi0Kn_yw&oe=6A71F80F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Blvw1isRWHkQ7kNvwHEJlPQ&_nc_oc=Ado68G10uSyYwR_QHK7bAvmt9nQf3SsZpS0hBJ-mQcAnT09VoTNiUV7ntLwQv-jqREE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUqs58I-FTbx3KgEWs9r5_DwijISEy7GvDiV7UX_uolw&oe=6A71E074"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0AedxbACJwQ7kNvwGmC4mV&_nc_oc=Adqwe98OUEGyL5iv11YWpAxJ2KSmHEQtM7JuKZKBIUQ4Uq8wTH9XoPRKliwqyvOeSzg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETv2zPj59KxS1IbW6_I5n9mlGAjYJ6EcmNZvR4nURgVQ&oe=6A72009B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKZ0UA6eLTAQ7kNvwFG6WEQ&_nc_oc=AdpN2NAeL_G7l74PH02MCTgD9j0yncKz7U27YBpCFix5fx7BqyUP4Eoqg-TH3ph2Jt0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYG_TEhG3ylM9IAU_oiJnuYlVHbhLd0nVZRExQ9RnRHg&oe=6A71D33B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDNa3KCKkdUQ7kNvwFth-xx&_nc_oc=AdrdlJvr3uRg26UkLoupJLf_hTR4L1jpWm4llLFj-9ZicuGj7FiVyiER8-4AEkIu5gI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmTobH2_pb3MuPXhEAzZsR3eVXcKNJ0MnmYbLoTApImQ&oe=6A71F201"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
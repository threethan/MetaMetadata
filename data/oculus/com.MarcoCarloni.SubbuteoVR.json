390&_nc_oc=Adq2l_lXz6kubeR9zsp8bgLT2f03Z6NhZXP4smXYD1JFxAWkZ0UHCYwgdeO7xRG-9Co&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQDJ3YnfWEH6zXpSAfW0eRCADDvGeMqHuTXe9w6Sb_uw&oe=6AF32B0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44geLfFcoRAQ7kNvwEZcvbu&_nc_oc=Adq0cb7O8Jx7INsIOcxX8WqaC2Fx_9pMTaPXoag86nZA8J05OGqCPJA_0gwvl4vNS8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlnOijUZYSQfedJ_mgH8HyQsVIs0rWMB9j3GpR4S4m3g&oe=6AF34BB4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4JV_WttMAUQ7kNvwGCZMpm&_nc_oc=AdowFquTMz0YwWU494kN-N8FIa_cR0Dah-dBCWmyDTZoAlQ2mb_gw3h6si_BxfVVGe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRpYAuIR0-imeC4b3nJL6ShaVFZ9oxYFOnfTuj-WKyyw&oe=6AF3339B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_Jeij_u4BoQ7kNvwHZ85tQ&_nc_oc=AdprwQZX3_XmrkXoiM_kgF2naGidmlGgbg9OWLnnHgT13wtO98y_jJort1HdzCNEY4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcMccvKKpSK2UycbdFCc5isIcK3nDVS3YC0IWJmvdp9Q&oe=6AF33E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5W2nH8hUqxgQ7kNvwEq3aWb&_nc_oc=AdpYmeWvMyXWdfDaok1N3c73-D1VsbCH0iZhn5cSRo5CmtNG4qAnQ5Eddz3m9W0sX6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx8ZxLGhUwROW6yiktUT-CjvCPY84cOnCw36ZwhPlCog&oe=6AF32501"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
n_-&_nc_oc=AdpUcydnC_lP-SljkVGPVjDVMj7SFh-v5ASmgEkOghAdMaX3UbSdflplKSzMfvs94nQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNZyyLBt0X1YIc3h4efkw8A_AKJMBT126lcprsCecsTQ&oe=6ACE410F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBj8bHzFGJIQ7kNvwHNtwp0&_nc_oc=Adrhi_Doapn_OqKiovDE8f4zGgj-k0RI1kZZdDZhmQAPtv0NSXk9MY9UEx5ZCIoYpas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLPhPfs2SY15FPbelhGcRiNQIPjPGVHtKEm9GxlDh-_g&oe=6ACE61B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVj74c4qq3IQ7kNvwGzCCJW&_nc_oc=AdpdSIrnNC4C9Pp6FiQw-Q_eaeIvWAxI06lcjAPGaHIoTrpMPmEO0DO1sfiV5SfRGgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0gWkPvwY8yGW4TI_2FKsDoD0h_dnUN5L8oNFkJV-ErQ&oe=6ACE499B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5cgecHEYkQQ7kNvwGN7TQf&_nc_oc=Ado2Sngfu5rVK5_3aqXKxZAhE_fSL0y5SZ4G1c8ep0BAvq64_m8mcFyqVhhXyXQz1L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuqBiph_6EzBY7yr3__u1Scyfiz3OIIfkO1qFNsZHOQg&oe=6ACE547B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLnLop1bEIcQ7kNvwFOTJHB&_nc_oc=AdodNZCtbUz8qn6rlf5k5hP_X2zgN-_WztYKxbpnaAA-A50SxJ4ODpmmuRdrWh_afq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuL4pLbUosWlzLhT5CbUp8bk2ckMFRqWiRkqs5jodtsw&oe=6ACE3B01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
beA&_nc_oc=AdpKDm7wa3kWwvADnzVEqWPs_gG9-8CVSVGSYN9weGFImRI56SYm5lexfduWt9iD7xU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D49-AU10--TIjxKdfuRty1J1ktkW5EGpI8dKQDmjOqA&oe=6A1C468F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia6atJNRCuwQ7kNvwFztzJc&_nc_oc=Ado8eJ5UTMWJoxgRHJYMK000Ub_W1yDrejtlF4rDsTjc9Sp3DfmHaNFuvhlqSXvxPPs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TyowU-XomfGDYT905U_47xKKDXZkrIY4Z_dd9Jbfp0w&oe=6A1C2EF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl6wyXVIJ5YQ7kNvwH7wSvP&_nc_oc=AdrpB2gxHhsB1G1OrTmW7b6XBw9yYi82mpKMc4ZAr3wvJR2TAHQ5ugFY6RfgvnK4Ks8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lq2WMv3vcpioG_jy3LqfA9v3_7-QgFQQeQyBYu6tgww&oe=6A1C4F1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI9yVFNqRlIQ7kNvwGlKeZp&_nc_oc=AdopWDu626XlPJ622zaq5XZg-cYs4d6ROamZwmaQhhTsLMpZssP5u-HCr-sLQf01QcY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DigX0DACX33vV4VpOCoHQhQmQAwkoXW-jMemS3AH45A&oe=6A1C59FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_eKb-FrDwsQ7kNvwEpd1E0&_nc_oc=AdpUSYD48Vh-XVvLDUB4J1DWw8yqqspwFkGdEcRHPV9dJCEw8RT5E-9JT4JZ3tsiPhM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kpk5aOvuy_E7sCqHKG2nt5htvoxKbcH1cU82NIF6X8w&oe=6A1C4081"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
gP4&_nc_oc=AdojJjevgYI-wNLFM7Cy7U4xTUCLNHIPSS3wjQ0bEqQxAenoT68c0aqecs54c6USiF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96IupvGut6o2YPjwazfw8V0Yx_qijs0VSrgGv4N-r19Q&oe=6A3FDF0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0q3ZQR9oRUQ7kNvwGzQ9JP&_nc_oc=Adp0sX1qLQOwhwJEfg6EmYp4EshsF0CxxFtBHa44P6ycbKmZ_HoRxrOmtnn-6Hloy-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kC2wEnC1Vyt7bBvhIxg1XbrgeNKAAHPXAFWof9QRN4A&oe=6A3FC774"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeUoAYHmSIIQ7kNvwFe7xcF&_nc_oc=Adr1iOeAt8l47d9QLUeyZv_3f167l0dc73QjTk0JCwbgHGaI7C_8L-wbNTLfBllvRjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NCU2RuPnKEZkrgD3B7oDL3TR04M9UrjTQ0qq_zfhgBg&oe=6A3FE79B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPZJ9rGcn4IQ7kNvwFiuMif&_nc_oc=Adp12fvNYGd-hJLF6uI4zDPT6RpRhMtyMpapZr3fa1XOncXSIyR55h5Vy9X0z4Fkt2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-snES97fxzAqzi7AY6rMxEcuiZT7__ioXl7lwH5JSjRw&oe=6A3FF27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFx1KnR2V7AQ7kNvwEjBHgy&_nc_oc=AdoK0U2SJ6CSER1zoYAY98kj2sDiTk7GhjMB7FcbEA0UWPLr2E2W3CPS5In8GH-c8qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CoXjs5qJh0lTBWIxxwaPosX6NrHhZTW_iwlFg0P2LVQ&oe=6A3FD901"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
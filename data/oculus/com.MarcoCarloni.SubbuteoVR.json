wGiM_u_&_nc_oc=Adrxg0ZT00tFLEuqRhKFLLDIZoB_sjZEM0WAS3zO7fYGvHXuSZwfti7zdFrAQwFjRBU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tLeWER0Pe28tkRroQ3CVZ9EKx7O-O_BmwJQL3fXNyHA&oe=6A11BA8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83MyqzjoLIMQ7kNvwEbG86N&_nc_oc=AdrSr_a77jGRDgyv4FGiu2vrEe0KAJz0rr4VO2I4LdmAIE1LdxEKJjnkiVr0w2pwpFg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vt8vydqWCJEt6wxBtDGjn6S26yVIAQa6UjRw2hs6Yiw&oe=6A11A2F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbdj7-PpPk4Q7kNvwEhHB4R&_nc_oc=AdqP4snyhQoJ6EdHrue-SiUrPk1TMWuRJTpw2tUSMtGm2pIdvd9Nnz6-e-sodSykfew&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aYziO39XBHUVSnow427c8kRzR81feHRieTAEFO98e9g&oe=6A11C31B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oMRJmkM3wcQ7kNvwHwfuBv&_nc_oc=AdreRxXxrJYHNkH3dCk839cM7xwJ19ejV8n5eYSUqNiLpJj0PvFs_t8l_egsGf5FIHk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Iob_1wwuww7tVJyshjW7p-yOGtMSvalp9Ovy4dEF0Yg&oe=6A11CDFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBeZz2QXrxUQ7kNvwFTC3IB&_nc_oc=Adp0Sw4sexZE-G5SQtislVZliWmW4SauyuYMil1slk1e7B52IzuRzE4nK6Cnbyngemk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v3mCVLRuel88zjSV7Cl4Kb7p9pK6NswZnB3vLcKx-Vw&oe=6A11B481"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "
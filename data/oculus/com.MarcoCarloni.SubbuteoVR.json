Bv3&_nc_oc=Adqjl3ERTYcnW-Bt--3XNRDxt1pvxwHORDQb9GhzLE_mpnKFvDiyT25MMIHH0L6DPMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04_7XhYx4TszQdgmgPzgW4ruACRb7ctIzGU5mB6TFcgQ&oe=69D2728F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3OE06we9l0Q7kNvwGSZAe4&_nc_oc=AdrYTGSq1slUr1eapSlk7InY_EmnW8A5Wygggyn0jrjzPqIdsfrJvfHUMhU6cqE5sg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37VWrIEBP9tUnCsBvQpka2kH7Dz5TlwNL6FRzWcNZO7Q&oe=69D25AF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCu_VR02KtUQ7kNvwE2HgCP&_nc_oc=AdobGtqZQIj26sQCa4rZR0h6iTb7_IyCjJtmISdsJpLr5sahfY4pzkJ6pVwQLDZCDs4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36JKr3jdZlp81D8ybdWqq_C0fPOf5ygL6M7OCzsrdhAw&oe=69D27B1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GJcH3aM8ksQ7kNvwFpXkD9&_nc_oc=AdoU35e1ROQtwUPZrx3xUruBpoWU2z2gXNDnhKUXDqJDzD8HybRHfoyNo7J8Qh-efNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FH4jg-zkY5yag32l8f525-h7DQWdtoe_Na3f2l_wW4A&oe=69D24DBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWTanu_rC2sQ7kNvwEU7Ik5&_nc_oc=AdpiGy3m232jmfpOGXYZ6seCmKirVKD3HyK_bFeOAkPeKQpVQgrImtmvNgPcxirhEQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G_oXAwiFAYK5X3gyJeiWuUB2BEcvuA8OroCZ6AwaDlQ&oe=69D26C81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
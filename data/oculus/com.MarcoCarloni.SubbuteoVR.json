WkS&_nc_oc=Adq-wgdj7QYusExd9FzQ-vCBBDSIMxRKhFy6UETmzUS7WmaEaA6AdB1taM-OUz0hVWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAqvE4Bh2IJwW_KuYz2mtiNHJRVP7gEyAY_rCLGpNbgw&oe=6AB7D78F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8k-nwDp8fgQ7kNvwGLBqO1&_nc_oc=Adraq3Fy0ufOduKVJhvVze_wKG5fe6OTLF7YPax5savYJqaOracsafp5VLfriBCbTiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIefEiEqO_0lrf15t7c_9uQMs_u731oARZoPgBRGNE38A&oe=6AB7BFF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RExa3Fgp3AwQ7kNvwGqObiY&_nc_oc=AdoOLURrYc7DjNcqzLwvxIO4SAkArwYe7tfcEwKhywUw0kcMJM-7jvBIGprRtz5pQ5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL38B6Dqc0BfzDelPGxYdIlTYe7PxsjDwJHv6ZaQPDOg&oe=6AB7E01B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwAjVVTG9coQ7kNvwFPgIW_&_nc_oc=AdqP9ihUL_6b8iFplCs2hnNmkGnxHEt5IVYnBmbZM0KtXR_oDGqpks0p1S9Z4hQey5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_MFSylDuBrdd9xG4I-s32Kr7K53A6KxiIjIfjabLBrg&oe=6AB7EAFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndiCXsJkHM4Q7kNvwGk_4Cx&_nc_oc=AdptnHugHCV4WsLkafUEcM0_E-Cq6HPgDubFfg3_SaQ2SCBi6tQj5G9aNzaR8cc_Y_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhjS1_aUd3pOkmgYXCjhYyRFLQSdIjIJ7YdoRMc-kSJw&oe=6AB7D181"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
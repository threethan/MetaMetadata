8wp&_nc_oc=Adq1roSId4frDkm9HQIaLwE82sqsczkR4Mm5K338SpvUBDkjkNosztl7z_EM_wHysYQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uzKJsUcRIDxGl5bJ3YobO96LSI7KKKEV1N10pjaE-IA&oe=6A1AF50F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia6atJNRCuwQ7kNvwGH9DJz&_nc_oc=AdpDgbIJ08ZLtP1BWguIZTpzwYiAJXMuIZ4ySYnKU3ZTNH2eOjsREzGJdY_QHNQeiSY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VxXiVPJYz6lPV2N-EH1dAN2HLVXiymSKPw4ncfOOUGQ&oe=6A1ADD74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBlN2irpaicQ7kNvwEZm4Hn&_nc_oc=Adq7DjkICLd0YqAGfD1kP0bN-vSVJEXok-7NABmjb4eJKKrtGxqShW603ypILOjXEC8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZFeZjoHMZsFwx03RNTpyrbuse19hHu-yIr3uQjIi6Jg&oe=6A1AFD9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI9yVFNqRlIQ7kNvwEO84za&_nc_oc=AdpkwHGd8t4T5tZteMeAkEmnIwU-vCEdzNGcZlq139LOfnrmcEIEBzNtSWBVycZR6Ys&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DXTOCItVJJng4PSYll7gIs5cV7e5A_lvPOecbuUxZbg&oe=6A1B087B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_eKb-FrDwsQ7kNvwFXVClq&_nc_oc=AdrXLpuJ7Dj2gElD7Bn6N7yZC6PsgR0kL-rYqaQdxlM0ZCL4tzKgPgHvIG53nCuf85Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ALPURrmuQqLxc8i5m5HswihkcipxPygoMUtn869b2qQ&oe=6A1AEF01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
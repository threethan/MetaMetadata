wFWS734&_nc_oc=AdpW5IBTZiWT0sjsCzH7dBR_P3LApZuAHL7qWp9AY88QexL8ccKNA-a9fH0XQgYa5PA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO_m1fevbNiXnPUR7As1np3s8N_sEI8PEsGmXaAaHB_A&oe=6AAE9D0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IjoTtAS5G4Q7kNvwFZoXUg&_nc_oc=AdpjupvxNsq4OE_dqmD7g3zxuVnNHmtnqJUSCz9ZrWfNwN7hT_ZAFNgamS1VNh7sVD8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiOKyBvOAL5O4ynpR7vkLgVg1fPAAXzW-DxJV8Mkh19g&oe=6AAE8574"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZozcP71dZkQ7kNvwGsGbVh&_nc_oc=AdoHygMQSr2cqTRtEd21ZlTh1QtNgA5uU_wDvvVokfnUmNb0XUqA02TqReCRAcCZENM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHuH00wLcK2ECIOBs_q41fFSwgI4NKE9slgfnT1cWhCA&oe=6AAEA59B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4DnLpy_ME0Q7kNvwEzQraY&_nc_oc=AdrmqbF0JMOLPM-AX1PaAhisZH7O9Q5z96SxzZAA52v7VYoeB4z-xmRqeNyIdFTj2Fk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnNTXZmUJ4GgkAYDyQmMSmzxyH2CXuoQIPGAFsMO0a9g&oe=6AAEB07B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTEt1O8-V4UQ7kNvwHmOq7_&_nc_oc=Adp1lXforuIiZu3VBYsmeKR55bMjKss1GXTZDcwx9eIMiFbmBPVj13Msa-z40zlo_uU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI35bchHqY8Kzfj-Neysv4Rk5OsaQ5z4UXrSdFGVRN32A&oe=6AAE9701"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "
giE&_nc_oc=AdrN_xatZSh_--1zeaC9alpHPvSLK9W_hGf2_b_NS-ecxzUyE6fpG_R8tqZYeJaRaWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g1V9TcOZLgROF18t5VTGyOviAXi6hYqMGWonnHU6NoQ&oe=6A033A0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iRofO7QciAQ7kNvwGntE4A&_nc_oc=AdqLBkISVmQD9J7v855D-JmcUownJCxWEk87d8QvzecOel-ehuIvklzYtWLLud_XIvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MB3Fvc5OqZQoVhwY09ZOOBB83rdt_ilENxFSP4oUChw&oe=6A032274"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOlgLr3jRCkQ7kNvwH8vIGU&_nc_oc=AdqGCoizsLU_ECWwC6_T9utF14eyUDwO_49IHAr0ReHX7lKSaCjW8xGUYEQJMudZOHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uhG_0FEqyVOoCO3XPhiqx6pXZr9TaofTLIaJOXmOHtg&oe=6A03429B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwM9SwCBEI8Q7kNvwFNVQnO&_nc_oc=AdpU5SK1x43iJJP5Y-RMqNpMpMlm9aH1cBkPSOWxmq6Ic8IKtJ0axFLRAYbU8e3X83I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58iBfpsI_5JSL-7dUMVJHePgngAPHqMw2oqXcVxq4frw&oe=6A03153B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OtkEYB-T1UQ7kNvwEYsWzv&_nc_oc=AdpYl-JaUq3a4y2T5NYJzFV5sjSKr2sF4rVHaVQzq9sF1bu0NZmNstWB3f7S-SFkis8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tH-KbGw7_U1yCyPxLWAM1BEya1Mb6HaYw-8oqhGEW1w&oe=6A033401"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
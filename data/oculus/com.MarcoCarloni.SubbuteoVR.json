ord5-3.oculuscdn.com&oh=00_Afud69OJD6mh8LyW9sI_4QOpbpCo-7LBVDBlcvBHi3pQMg&oe=69A44E0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQNqASKUiTEQ7kNvwHkhGZk&_nc_oc=AdncKC4xYnNhkM5xAi6IpzLeSOClcI3us41sw57gZ364HoPZ9yIyw63sYWPfRwYTACg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftDD3o6_6creyQ_tceZfLHAOdUct1O8WYs3OE2cfUhlHA&oe=69A43674"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfbSfvGoW3QQ7kNvwGbMvqx&_nc_oc=AdldNIr5jHtwF-xOldlMfRCp8VbnTbRBUIGIazGmAQPMVHKjmH3EFZ2yUWjkSThkIuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftoDU3VVBaO4l1pm9RJUvdGL4W2J9Wgvn-LgLUVU0xjMg&oe=69A41E5B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf-_aMGa6-EQ7kNvwGWOuzs&_nc_oc=AdlHCKN-WTBZ_MiAm2H7NI3jghRHxvqt62HLOPBfYTi7eUrnrIYctqjo3j6GDiCQlok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfskNbe61vDKF7g_-SsYYiAc63tmjVfChw0H44v716uYJQ&oe=69A4293B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2tePVkabQwQ7kNvwFP94Rk&_nc_oc=AdmJme7PprHL_A3VsId61DeRulMm2x2VE5RmQ8fAXQbgX2zxoxntVA4iNPiXrYWlyCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsqtT18yujAZvX_RyJAlU9b8MBYNsz0sPCKT3Ct83gl1w&oe=69A44801"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27
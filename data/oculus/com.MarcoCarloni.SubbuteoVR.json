GxS&_nc_oc=Adr8ps6If6QJnzj8M__1cSzyRFhxeisvQscsRnW6-o33d501wDW78YnYmoy_-GAh_mI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9khbbMmlgFpCvk40FJtDWw9qcX4WzF13KmPhMWtpzTew&oe=6A42820F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPhZbSGebJQQ7kNvwENGxfJ&_nc_oc=AdqxUoNFkGOCVjbU4BO-V_By3TwLNdJuQnDKh5DQAuVIJ7BbAlhtf9k3e6ueUR3o5Tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ixkDte4k5rU9LmjeXSgMN-nuIrHAk7yU7ICeOefk7Ug&oe=6A426A74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeUoAYHmSIIQ7kNvwEGuLG9&_nc_oc=AdoAIvebrKrS95ELjcPwdRX5x7ebqT6eAcpvai6VI-nEDdQzkQr9uDbugOJuVyZi0jE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aDY38l2IdCJ-8yKG_mVqUBiQJ-v76w8ntiqqrIRV4eA&oe=6A428A9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JKJ4i3LQ08Q7kNvwH7hQR2&_nc_oc=Adq-6CENmr6Y1vtcOw2iKUhl95vz-bB5ph2lBZ1e7Iq6e2zCmQF_pHfp65CGf9a9AnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af945ORukeaamO7O1GsKfdzbt77zTesSTk3OR0BgONT5Xg&oe=6A42957B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2l3gqtRCIAQ7kNvwGbvo_v&_nc_oc=Adp_KJIxABu7E0jU1UhWoj_TRDL4lULxgb-so5_olxyDAFvJ7qK28R0B8cwEEHGdO3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V3_mRerUzPvk_T_iHSHNjyKvXQds1p3IKWaFWtIrUcw&oe=6A427C01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
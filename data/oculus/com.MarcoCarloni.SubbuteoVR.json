Mq8&_nc_oc=AdoGlS4TVSi71gUYLH-UkFauvS5kxs7ir7Xdvc7YT4ZhaBl0sz5zJb72kItmctnH4tE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wWxqcSHvRG-8A-gx_ugCFXbG9idbbj_97_dMK0TJ4jg&oe=69F3680F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCZ1YhUVr_8Q7kNvwGryX2v&_nc_oc=AdoJNzrN3BiYnslGKO8z83uOlfBr9xb0uwXf6KA2RkGF-Em1769dqRJALR1r_5hMLtQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CapzPw7_QMjA01TvPjlJKOWVSgAqY8pwonL80yEY-1A&oe=69F35074"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xE16obgn1QQ7kNvwGr9xbA&_nc_oc=AdrvIHUkTKhUBOEjLV4UNap_1CDJLfDtqH3za6QnRBXBOGn-It0oivk9JOn-AutISIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af115ISbpG78uePj64evmkkhNcjSU_H36XY21KiJKu7HLw&oe=69F3709B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W74wYsdOGc4Q7kNvwHg2ITE&_nc_oc=AdqUnzYBmyrm6Wz1h7A-_Mru6oGdK3supSNrRJvRA_6iYDO-IFYPdwZgyZwfQ3rsYyE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2plHik0mFNU7AsekBxrTg4R_B2AD8Xo1CmsTm83TvIiA&oe=69F3433B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU8ADztIGJEQ7kNvwG1kzEf&_nc_oc=Adot44oyO3W7l_WbBA2uTI8ysUGTc1pD3cNLzTHo1xJjxyRx4CPTmjOHVGHo7tjTeQs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32Ieloj7vN6FnUB3d0OcfmOTp6mSlzd1V8_v_D4g5Ekg&oe=69F36201"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
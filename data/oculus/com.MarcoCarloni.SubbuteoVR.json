IKq&_nc_oc=AdrNSwCJ0scOKmIpM3tadtRqHp8GBoL2Vt0KwJFbkwk2n_78EIYV__FTVWr87qWQlLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6zWCK8j9EEhLq_D1S-SQtCJ4zvsa0OQCnfKTRR1s9cA&oe=6A579A0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M1AC8vuRoYQ7kNvwGC4tDK&_nc_oc=Adp9XhJlqnYyPOHsMvmhxXBj_KmcOJF7fUcm_V58uD6EJtf6PZI_qn-8MUz--QXIYcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3DXnHyOOSDmthmckL_d-CChCUnHSjdGJA_pLz7Kux7w&oe=6A578274"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rYvL6jCOx4Q7kNvwG-4fpK&_nc_oc=AdojQ01dAGUyjR9gDG2VHzjn2ZYJSg_WRYpWntRJswH56r2F-3v4_8f-WeYUmucmT5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-YghEUyQsazcWMsgSw9qeyFK4gdEToC4DTOTcfW_3rQ&oe=6A57A29B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFCz8MdI5_cQ7kNvwFsIwPO&_nc_oc=Adr30gx3esHVd4NH2_wCukodcOcnrxVhN9DNUnb_b2u13D1fTH-IibpS6pGQAsJ6K1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK9kGCaTcEiHanLaqA7QCLbW7oJJ6eAOduOFrhr1RLaQ&oe=6A57753B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fquPWW9L8s0Q7kNvwGwkmmk&_nc_oc=Adp6VjSt2PEF5gmrX-PCA86osLhsnpevyR0do82dlQdFKe1NfNYE_j0Hfb0Hjx6VJBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLPs9AsiIVaJrpHDq7-7OXPG4Q-Wso3C6SbMS8lBYKYw&oe=6A579401"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
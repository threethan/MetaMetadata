v24&_nc_oc=AdrItpVIMpKaJSNkOCCknYKMTJ3VuNCj1IM9mYy1J1cDEX-eOuwKv0zMbOJkAGGGHNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcoG4_TT7R9SBkCzVBnQCaYQEg7ot9wqgNwCsN9m_Txw&oe=6A897ACF"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao9unpS74NgQ7kNvwFaFK4J&_nc_oc=Adr5nl_sdq9n3iIU58dc23phkwgcImVZHEq5SFhX1MCLxjt4nU8HYjYs-LlWnWkv7UQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVILIdZQ8_sEznTr0RF40srDeEwJxp0f94drj1e47QcQ&oe=6A899B74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFxGTQdhX3kQ7kNvwGraOpX&_nc_oc=Adr5zr_G8C_Xymp2LTuJ9qT69l-iOV5_vGGwMTGyyBME6uRUrllgDHbnBY-oTQZCeLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuciT0UuaON6Af7zvcDmmnM2p6GgO4y-LIEga5Jr64Gw&oe=6A89835B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlYq3-pOVpcQ7kNvwFHbH0F&_nc_oc=Adp9yyU8bYtP-eOIlR3ptycZoNH4ampXO_O5lCWPnkJdCglqj0uTQENbgNDC9BkO_Jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuHfrzCRl8EKHOAg30HtQPY2-0XSy7J-eYQYGQnvlYuA&oe=6A898E3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VuNSizLPOkQ7kNvwEllfA_&_nc_oc=AdrbiVid42esQ0rwpgnT6wZSTD3zWN1tZwnSjkYZFvm7D4q-fttVcmrAdmkxpljHZag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZJQMYA_HHkT6LpWnOkdVEWuH6LIHa3IvhJpY_MfwsrA&oe=6A8974C1"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
W5u&_nc_oc=AdrNjIX-zi4V0hoIFvfjcEEHWW_gUCPbR8HqSuwTYit6TgwzMeCcNEeHTCvJmH_BKWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDYePSNGn06KpzuvoVMjDaY8_OBDpWFcmyVz0hvXWauw&oe=6A5B8E8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPRpWJcqeIYQ7kNvwF44dNP&_nc_oc=AdoGBzTLDZIcoKhLRCmWSZh7UZMwRiKW_M8LwYIinS41o6VefzVA5xK3w4BVqdXPmCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG17U4fkYmLqGlY8IFQieTJL3zBcOVf5csc8m1PeOfCQ&oe=6A5B76F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26r8MtMwBP8Q7kNvwEc3hUq&_nc_oc=AdpSW4gUmRJL7UYfNJyMzrOz3ryJu9FyI5fuvQRsQCK5syRvzK1IEYK_zKhH3jTe5ZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnIMEL1PXixQN8Y6EcVcJaKhCPOkReU4BS2IZGWU2k7A&oe=6A5B5EDB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXTztdoqqXsQ7kNvwEj6ovh&_nc_oc=AdrjS9DbVbWybuC5-o5KSqm-hc1ZrMLwCuDetFsaknTe9M3WLqasapJJbAYACA6s73A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiwI8x6Go10carM-0gIr99qh3PX785muYSKhotJvkhsA&oe=6A5B69BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkkXC0JrryQQ7kNvwFpgvjA&_nc_oc=Adq_Gvh_Ik-vMSbX9sIZDlB8teR-O3RafTXhDV8LcQnYiIudp-aTkDnjao3OuGhxfnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzK4Qf0OKSojfDVYxSkWNGFpp1YIL0hwf8ByDApmIVEw&oe=6A5B8881"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
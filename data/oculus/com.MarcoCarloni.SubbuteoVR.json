v1S&_nc_oc=Adq7wmQN9UEL1IO7Vk-INe_hxPhv7_NYeLCk7cNTxr3ZVxvGKhCP_nVWb8cLvib4ufA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtfaDN-F4k4v98uii0WDMEzii1eLMrMdjSKVSj18V6rw&oe=69CFCF8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2IrgMFKTjwQ7kNvwGkHuRa&_nc_oc=Adq2E5v3ruoxQOIccn-t41itzF11RE6wvLC4L0tThs1pSTNpHGy1BZeSJICfbH9x0ag&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwdm-lzIAtFiwIYybC66FNHJJPZScPTnVhzvGTHYBqHRA&oe=69CFB7F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skfmiMU-9PkQ7kNvwHaxbut&_nc_oc=AdoRB9uLnaM0ZLsCnGQkpXh6wnQwdqWKZ7iDZ2K5BT25IGjRnUI5zulUtnmpipfYaU0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNtCnLLWaTC7ReKSlH4WcjGiFhFgAJ5AQmvLMaiDi1Jw&oe=69CF9FDB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFcg0zhi6WAQ7kNvwHN_5kK&_nc_oc=AdqOWpzWyLj4ZaNWEUZ_pOlZBsrXIQjTjW_MOQOfzbshioQbujT2i5sH6fZR-AsDbTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPjJLoIoa2i6Vg8U4BpGto7f96_PJiKenWflSS4JCSbw&oe=69CFAABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWTanu_rC2sQ7kNvwEh42v1&_nc_oc=AdoAHqL5BTETlJRFSovH3xh6UTg93NGQBLSDVdsb509Xakmi9OMY6CXRnRKfL7aP6s0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3VLjAFcaB1eyfAspsGjVGWl_wVmnWoh_ydt8BwYJ_gA&oe=69CFC981"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
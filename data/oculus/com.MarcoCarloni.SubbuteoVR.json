bDE&_nc_oc=AdoghMlRb4Edjrps55SXnthRP4JYbj2bKw60E6fMg7q--oeU7U2jFSIZvjzBVOmHvvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54PiaT9rg_WWTyP-cIBOXa262fuwmSI637iXUQwryyeQ&oe=6A145D8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6yycllzQLIQ7kNvwGi1DOS&_nc_oc=AdoPBKNTobLEj8Wz0XQKhe_Tu7k8f8LDdntoE4fa2_whDTsXC_j1_rQJT7bCOz1dSZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50vONftyr630hCamm0qadrizlT6xOCm5ccq2xWY14KYQ&oe=6A1445F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t30maNWp7_gQ7kNvwHudLmm&_nc_oc=AdrlnbGvjj2MR6iiloq2EkOZ4x2JrW7oIyrQqB8F8w32fGbUmVGHF9fVNfTQIuAp66I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42Q3s3-lCyyaT94V5VCnYVlNPa3ehVTtTw-enmBP3IVQ&oe=6A14661B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oMRJmkM3wcQ7kNvwGlnAlC&_nc_oc=Adp_yGzTPoLbhrCw1sSFrfHT2LWcagjDZchygDOK5u5Bidv1twcLMrDerkEtPOkQ6w8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ul_LRFBp2O2tKKF1vweH_8NgsODxFz0_yNvL38COSbw&oe=6A1470FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4ftCNiQ8m8Q7kNvwG9EiB-&_nc_oc=AdrFHbQterR53fjBo23TzaQ6yLvrzcC4jp2j6RQk0ISvbZAf_jqcntlh4ETmPjrZhbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cPcn0unNmIDSEP7TroOu3kuK8bNCPv_xRvo1bHShDPA&oe=6A145781"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
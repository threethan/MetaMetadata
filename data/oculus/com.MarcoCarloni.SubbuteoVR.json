_qL&_nc_oc=AdpOf-GenQsjNFJm9Hl4nO8WeKY1H7WJPigNIP0M9z6OnLdKahZoxR64Hk1vPpWzaB0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQTG84M3jxw12J49Nio7y5OoDtjLEFL3iTT23J1iDyYQ&oe=6AA16E0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ktinB54n5EQ7kNvwFJM5LN&_nc_oc=AdpjrwtBikunOuQ4bnH3-YTcffNy4qvSoRUXE1Dx9ZD_shZnsxHKeNlIk-IbSDtkaYY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw6IZFwDOkajLETP9uwMecfQy4OSmQYMCH_gbv1OGPnA&oe=6AA15674"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhWHjFHiAQ0Q7kNvwGbnKnG&_nc_oc=Adpg6Ccpt0l4lHKoB-YqO_S2n6XhGUP_SfF_kOjc_iX5r9YcoJfkl6CiwyO-ouM4zoU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4eRrAMtbJp3mZw3tVbHxBphBj60ULRJdtE40WfrX9Yw&oe=6AA1769B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77pE4_cZMTIQ7kNvwFO9h60&_nc_oc=AdosSos6mscRVfStv0UGDB5mXZgGJOXwJ5GkwYbz2pNyzkZbOm4160aasIjBkXO3iEw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCf5wQuxDh5Da1GzmEiXdnMvFmQaQ06QlUL82ell30bg&oe=6AA1493B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRScDhmYLs0Q7kNvwFUX3w9&_nc_oc=Adpn5Bem_70Pz2SeqpLkauZ35jTTub1nBoaXOH217Zk01FInsygAn_qVqAevLdQFL68&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQZ7vHfnlUn47j4tcY70rCQZTtCGCi88myytNaAJVHpw&oe=6AA16801"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
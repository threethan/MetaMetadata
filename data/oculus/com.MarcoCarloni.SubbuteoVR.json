gCe&_nc_oc=AdrglxZLVjaKjGQSNFbpo0ZTln3gCK2FfxrC0yHTn8suysYuMn8-DQMKI4HhIEFfQV0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bvVnVHmGGjxTYyc7s-ZP3zsx96zyBbb0s6SAgbL_Q1Q&oe=6A19A38F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO2DJFz1oq8Q7kNvwEhB-0-&_nc_oc=AdrhXV8M9vLrN20ti8ZUxFCoWQaVpmuZklOGBz2Tr8zuAtCUIJuW3VR9mQtrmvrhhGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B41R47q2Gd6U6AXQRErBEGSvxtgr60xC3Dl-REcaA-w&oe=6A198BF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBlN2irpaicQ7kNvwEE1s6S&_nc_oc=AdpU9BcBh_Uol_roK-oX8dZTcwl25MXb1bwGxt5nl9xi8fvgI6BaoHZlwdX9vs5qCt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tDxkyMHOCmxf8qJ7vk8eKmN6KmKyhmLLK6EPFPbg8AA&oe=6A19AC1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI9yVFNqRlIQ7kNvwHMgxlo&_nc_oc=AdrPS1qXvKVTJet_4__YttlbFCher_DyrOq4quwnIX56KxutKMR8uGHMrIoeSYoippU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fd1KGGGi-G4l0cs6qOOxdlG_8FRKgOSyNAG_e8xjlDQ&oe=6A19B6FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqsbnuS2EHYQ7kNvwEpmvX4&_nc_oc=Adp7CLH4rjfUCYhWrRmvaIl5OF9b2w0aaNhz4x0W51rQzgYRNmhcHoVqcRHKsZYZtIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tLGJST_ezPXERn61IWc9b8IIIfNTBqQ1uQZrGztBkcA&oe=6A199D81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
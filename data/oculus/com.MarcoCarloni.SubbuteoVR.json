MPx&_nc_oc=Ado2zxYVjB1DLX19em9kSKAJpVJSw2F5W3OULupv0djXZG-9F0FK0B0H8rkrS7T7hNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRW3fPdwUtXFQGz24pyIeTqa4oNMV1853KvD27VLFyNQ&oe=6AB1400F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th2FjFXuAPkQ7kNvwHfzANB&_nc_oc=AdqPZMR8FmNWj6wakXUOgYWUdR1Hba2U3SfjmpXLghpm_MFTcTuf86CzfcGLZEolfQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGaDdSsv2iUpoXPZL9EncFc1BhSZGmsWmXwIHbwEQaoA&oe=6AB12874"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZozcP71dZkQ7kNvwGKGQg_&_nc_oc=AdpVbTGcfxnRvcswWoS4G4orVPpf5tfw8rXW0MKGczXTIoPtV47-rfNMX_yxQ0MgTqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqicHzrSUkhucEHd3ZdoN2e1YOOt8Bcxj_XVqaRmEzxQ&oe=6AB1489B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgDtVU8jKT4Q7kNvwHgTdOq&_nc_oc=Adpj7EUFNe_i4HQw5BTVT5HXScdI9m2KhyXItiyDdRttA_8xehoFZ8RsRvfUnutExsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlP3Dn7dz968cLsEX2J-eBzPcObvIB5kgE3KLcztFGjA&oe=6AB1537B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bla-uBM3EawQ7kNvwE6ee0j&_nc_oc=AdrVpa5DBJULrbZqdE1kqoC0ZjxF4F7krrjsH_Gk7rnLDw-FIbmVMhqlTT4pH4dP2EE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI62q2UM7qESgmv5Jsw6eh90niop4jhUAOP0o_Z02xO-g&oe=6AB13A01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
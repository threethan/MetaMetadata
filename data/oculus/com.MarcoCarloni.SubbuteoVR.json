DiY&_nc_oc=AdoLtVJ__76yZ4WkyNl8hLRX4-1sgtojB1irJzVNFbIlsyDvIylovkCSv-VGPy-Ovyk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lVSUYGeu_kAK2nB2K5tjQY7h542oIcMYA-z8k3a_0RQ&oe=6A218C8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kr7pNmGch6gQ7kNvwHtOggs&_nc_oc=AdqD1biT68bAtXlPn4IQ14gZ4aAzpUkP_Std9Z1eRI6ioevg7POb87q7LmAO8sK9gc4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nfNE95fAVWS_zgS64L_dUoLvwd0IVv-OzB8w_1CNDnQ&oe=6A2174F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq4AytPZiacQ7kNvwFudg7m&_nc_oc=AdoDNTZkZr5gQ9FSdj41UGixEsJ92L2Lk6mgvITXZrUq9t-qHqbWoUhW75kkdWe2oVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-xt9sFbtc_4uccnjBEoQ5SpDiAYEKBr1_RQttvCtvEg&oe=6A21951B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGXLLJ0uHdQQ7kNvwEgBOeH&_nc_oc=Adrh8vTpYuSc3smSe8nyw7tL4t4XHZg1jfv-ykcyl0cGHp5Yw9q18WbqiDMZdngzMEE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af864Iv0p-JJmxjOu2pmNngRcMx0VZK7jsQ8PD_2E4lX1w&oe=6A219FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UdHqoI6aakQ7kNvwGRKkIN&_nc_oc=Adr3ePkSJIfwa2S2cKqk6VX1ocrEpmcJVXMRTC8TRvXltzJeQUb_uTHcH-GNCyHz1-U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EwWwy9BaIEU2mmNLCU_ZodpOPLDRR9sG-aIuRoQYi2g&oe=6A218681"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
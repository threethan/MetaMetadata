Bnp&_nc_oc=AdpncWWW-hw9aIsGqiuSVsojC4-kWWlrDxvo_YawS8CG5lP793VPWyOGN0Lvpbf16Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg3L8GWw1O6RQAjRz5zJITSc9U6_4QlOMurGUTiIlscA&oe=6AC3B50F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp65FlSYxJsQ7kNvwFtRZkX&_nc_oc=AdpFd5H9EITNBp5EcNHQk61d5QCHQkXveLPz8dizoZ0VMYO4PIVb_EBFwz2KTh7sbMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf0z6XY1_ydA2cflDixgRqCt8nYmm89P3r-REx-KE0-w&oe=6AC3D5B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oesjHjjR6K8Q7kNvwEUjTgd&_nc_oc=AdqLwpSdrJ7Mpeyhx1VLZNjfC9yl8gT61nHWdb5p7YN3SWCNEienJbTOjvkyRd_nMbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_4wOBk7vHCJ6z0hWczrdpqQ8jmbgwEWbB6dnfW6fLRg&oe=6AC3BD9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGaz2ShlzXMQ7kNvwE6Z8dR&_nc_oc=Adpn7F5ihz9MLMYS2DTdiWu2lIT4hITI349ARGQDfIuLJ_t09EGY7RedLlDj4mBtbhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd-g03C3VaWJOgH9QwS3Gaj4dyAz5fROols7ar6SB-_Q&oe=6AC3C87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5gkJDO5o_cQ7kNvwEGNnFf&_nc_oc=AdrtLoV9DcGMtjKDBRErWdt_mOqmqA53DDBlLv7BtErQ093bBmyKHskEWLT4jdwjqyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPeQYSCbXkWP6u1qmALKChfo5e7HMl0sbW24bBo8E6xg&oe=6AC3AF01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
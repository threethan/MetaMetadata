xa2&_nc_oc=AdqJBzVKSSrN66fPnXrTz9nXwVNteeyCvutq5xNBUyqI-GROFRX29p5SKWcEXL73AcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqVV75FkotPIYlXHtIyZfw4E-kL-a2XqUxF0G8SHlgTg&oe=6AA8058F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfojEK3OMAsQ7kNvwFDvw7I&_nc_oc=AdoxbK9V48VUOrMFR2tWEBJkEtQx_GfgF61imAWiQwizGxI4U3kO7zohrE1alDPUYrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH1wDODbp5NM_hziciAttVH75ja_izMksq3L_kbpYsIg&oe=6AA7EDF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_sq4sIUquIQ7kNvwEC5QTS&_nc_oc=Adqr6QbBU1SoMBzr1sqre76sNB_VYWSBqVo9Kz0YRnCGuiVT9NikGi4QOBo3ziPv3AU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITjVap8skr1HTUxwdPK-0EknQgL_-kZTEQM57uujQx5Q&oe=6AA80E1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwTuwpHFVeMQ7kNvwH4aNNk&_nc_oc=AdpB0lWyS9-F9hYBCbspWvrGl0xqpZOFwku_AgQ9HG45xk2jMYBK_xvATr4jYcNWwbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEnRdCqxkqQqneTpN42g53fv52k9KN1APcSEElpn62zQ&oe=6AA818FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C_L5H_R4x0Q7kNvwG_cSLc&_nc_oc=AdpSEROhpjeaOVD_VsjOYly8YJbzsGE4dySsB3HJ4jKDcYj8VXbxpXkL_HcsB8L2vDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxLPGNdE5a5Fx9DP4yejCFhWnK_KTo09VAYw8Xdvz0rw&oe=6AA7FF81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
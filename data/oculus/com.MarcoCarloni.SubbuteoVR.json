l8x&_nc_oc=AdoAbdUC4qiF00IMtXrO7rAJHHR_oRB6FHKnzDe_IrmXpqmO8MEFhDWDjIszsACYfzg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFqM-2AfhLoz6UDxTTE7DtaC7sbY5_HSpkXQP7EckYDQ&oe=69C2A08F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEiIZJotmxMQ7kNvwF1qDO6&_nc_oc=AdpBfNHD3k4xHF39LPKZKRSPpgq-YA9lU_SKXJDDrQ6i4kwudFRetoogGbGSBZSMpVc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwecaUkTq4Nv6bRRmiIVdSpk1pkJLDs_0KnAn0qoODeVQ&oe=69C288F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOP5tThWedAQ7kNvwE_FQpY&_nc_oc=AdrVG3CqaHrwofqwFUoDP2MBhE1RcIbuzHwp80_LZVbgd1G-8zNHLOtLpWiy7emHGSc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3TAxNRzNTw8IN4PRt8Ri6CNEftF4laaG4tynW1algtA&oe=69C270DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW_iYbdgkG8Q7kNvwFe47H7&_nc_oc=AdpH-IQvmiFRQzdIxZ56n2nfrp8NPy8DI6FxEO8IQ3E3_fhunZu4mdYyLv-DZKDFutw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDfA7nl2k76wPsb-SKiwZ_PxztNGBbuA0mI0Tm3bMfOg&oe=69C27BBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSkL7vNl8eUQ7kNvwEXlq_9&_nc_oc=Adr6x0c_KkO5-G0k6Y5O2jpRSuW4JoWfXRS5ZGbVDZvvuEMcRnlnPOLqeI8090dTKlc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkpO5qMlbX8Riwl84f0Lh8hZipHIh80jxgFn2iS5Efvw&oe=69C29A81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
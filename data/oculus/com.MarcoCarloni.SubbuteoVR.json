l4k1FxB9Q&oe=699B0D00"}, "display_name": "VR Finger Soccer", "keywords": [], "long_description": "Funny turn-based soccer game inspired by an old  board game, play with your hands!\n\nChoose your teams, choose one of the tactics available and start playing the game!\nScore more goals than your opponent with the players to be the winner.\n\nHit the player with your hands to put the ball in the net, but be careful it is not an easy task!\n\nFinger Soccer, also called, button, penny, coin, or table football, is a button game played upon a tabletop. There are other terms to represent this game around the world like gombfoci, szektorlabda, soccer caps, sectorball and many others.", "short_description": "Turn-based Soccer game inspired by an old  board game, play with your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "988668791853970"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "4313783292213573"}, {"status": "PUBLISHED", "id": "3670332083262527"}, {"status":
r2a&_nc_oc=AdopEUDUWF7hLVdpo7Y-kIGONswE5b2ZipeDG14nn3Bzz8DwcArhkFxhaQd63IdM6B4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KJYpz1gVPU2UA20wqzeGpRG3wdPkJNVTBnCN-Lwv04A&oe=6A25810F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJusmxemYPwQ7kNvwEUscpg&_nc_oc=Adp0U8gla-9_xEs05GN4x8N0iO-T2nal8utRhsecznSGB5jnrtVbvThzgIuvemQHWso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ae9B55WLYAyq3evFR417m0t-9SVd8VBmcUWPwqAu8zQ&oe=6A25A1B4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFf15PuVjgoQ7kNvwGuBO5b&_nc_oc=AdoTFMBhlyeVkrG2uw2IP-eNSjke8dw8Ic1GnuqTS0lHt5XOuPKnhsxkUxpn-e6VxGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bIQNAMtP7vM-PsGfQtVYxMwj_U5Ed66ZTpae2_67p5Q&oe=6A25899B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHyGdagqlMgQ7kNvwFvQpYB&_nc_oc=AdoVxecnEI6rnAKbA6eydv5hYWn9dXjuSIyXTnpUe5iMN6ggMGq1ojKI0ILSbvWEzzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8giCPKQE8-oYMX9DbrjqrZJ7qgDvolOQX2vXOUWOIbSA&oe=6A25947B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS_8AFL3UWMQ7kNvwGSm_bt&_nc_oc=AdpGlucnKT-APVnclFh3YncX550ao33-gdVB2Yek6IqZtHTbFWL2AfV6-eVHI-704ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90EF7Hj8UBnkte25bJdk0yHU9zuFCXxYZSmtT2Uw3KFA&oe=6A257B01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
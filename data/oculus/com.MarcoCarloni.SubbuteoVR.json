uEW&_nc_oc=Adp3Cv68fh116pmVu1LmFp6oDBkhfx92Q7Yj3oRuMTYGS_JwuY2YXZi8e6Ho4R80SJY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmfj2Q171eZeOJqNqXT6SIujndc_kiTLXq6HgIDeACgQ&oe=6AE3590F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o92PFnM5x3oQ7kNvwFU_IpC&_nc_oc=Ado4yko9fbRdt6C-y4SdEQI3zdikXWFnc3hcVqg8jmSaV60d7MOb0RMLWwOOBXcNfN4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwIpgPqEqXQ4pcAXFAjaIXqMehckdRzClh8xoKW936uA&oe=6AE34174"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oz2RMTCB_cgQ7kNvwFH4_jC&_nc_oc=AdqyPGCkQksf8f8WkVag_Y8eFTzDy2lLSkv6RI8tkAKSjnclceK28QScdX_KtBe_Ji4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSZNL6fg-bvVsNAsPZ2aOaObVCmfSjuRQA7QEIZl0voA&oe=6AE3619B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VeuSz3KbAQQ7kNvwFHO5BQ&_nc_oc=AdrZK9LeX8Q7TflzIyzo3-QVwI5VqhoWC-XIisLWRe9a1TBOYIkGpZeennbjZq8HxvM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0HDz7_WR4UYZb9Ceiae_MXqjOLR_jHDbNpa327V4gSQ&oe=6AE36C7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NoQq_L8_48Q7kNvwExB_DA&_nc_oc=Adr7bA43_X_0YmG3iX2gReZRUKz_A6H24cFqhCuW0jC5FRvyet4RybagCRcs4LCy1HE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7fBU6YQCahnx2qCvL3l7VK2smQp5Dv6WTbYOZP7X2zA&oe=6AE35301"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
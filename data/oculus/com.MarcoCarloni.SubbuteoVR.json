wHQ7G-a&_nc_oc=AdoodMPbfg8jJfzDyh3QST4OYLXVLz7MVe2aAhcSZ9OiqFPPf1N7lkwqC-gxu3KGuek&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJJB9B7OW0FGEvnXyxCM-Q6x3DQZ1pMbpWEp94OTLN6A&oe=6A7D9D4F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMgFiGVmqNkQ7kNvwEDekoE&_nc_oc=AdqMDerdVQBf78p9Qr5LxTZ9RSHBqr8PNoLSbRFl1kGYjBzdINOCqE-a9hik9SPbo9s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOVahUqu8W_kTFEbxH_sP3nZecQOlSRReYvVubmGLwhw&oe=6A7DBDF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW0koLjEB2cQ7kNvwHKXnuz&_nc_oc=AdrChxPsyh4AcRFwOOaH8iRL_GmVhrtNwHHEvzL-8k1fVxB38nXUk6QkWL6o_IPC-FQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuXTD2-WQOS6Fm1o86CwSiP8FTvhmyg8SvmCxbd35gjw&oe=6A7DA5DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p9x07iZ-xcQ7kNvwHpQNLQ&_nc_oc=Adq2uXzWtS0O5fE3n97j3Qv5C1nptsOiqEovP57WvNdR8ECMjRTCXbHycMbmBCdVanA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkIWlVOXcNlB6YIUHsij05IxXRskcrBmw1oyGF5IGobQ&oe=6A7DB0BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS2Jy0gzSqcQ7kNvwFtl0UH&_nc_oc=Adpk1BfUDhh4ZNvXHRklo84KA2sS7SdVGkmsFwR1Sbi_EoP5Ppuv7OpM0lwZhxmtOW0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP5OC5jIRUmDRxcFOs-CpDtKBTcu4BDQl6rKu2iCr7GA&oe=6A7DCF81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "
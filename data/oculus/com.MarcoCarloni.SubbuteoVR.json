vuu&_nc_oc=Adqh5XDOBddYtWX2CMVj1Y3uEpiIeAA7g2xCV2mWCf5y9x_1KZ_HTeZMBIJBKELiWYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEViFel-J07wftUxbe4F9ABf3TuBw5j6ZMD7bWfxyCi-g&oe=6A749B0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itr16t1RojsQ7kNvwE9WWlO&_nc_oc=AdosZon482mC3837MDvJNqCeD-1MrCqwflr4zWDqyDrOmt3f66IQJNRNXql_LEYjlco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN_NkdcTOqSZSbg2unt2vPCoDrGHhfElFsJ24UEDXJoA&oe=6A748374"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvzep1MX_8IQ7kNvwFzSsDw&_nc_oc=AdoE0PfsIBEcTrysP-1yECeAocuMZ3Tm91zsBb-PX4BjBFZpLgSGB0lL_I1VbN99SKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3qm_bUhOA84Mtw2aShC5tvDBdxwq35fJGpvvAJyIaNg&oe=6A74A39B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PSzI5XO_a4Q7kNvwE_BX_Z&_nc_oc=AdrA10ChtELoD9NzRcoKYx25ybKvsO0QoJz7m4q60aS-hWvfPyBia02cdgEzpRVKQOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE51OlN7xsKyP8i9j4lcRxW9nTcvat7J7DWXjHmUer2A&oe=6A74763B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDNa3KCKkdUQ7kNvwGEc3QO&_nc_oc=AdpygOXRTYuFt0Lnd3PEUtfrXLTyzZwgFkxZYVREgOXqp5jw0dYWXJSRGeVP3ts6rd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7cp8qAlp23X9BZlzqu5Mfa85lp_Af_AFRL4HoT7_KnQ&oe=6A749501"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
G5c&_nc_oc=AdrJBh915f1qhm69GKycGpe3TVPI7-OGaKtl4K7L2bmz6jIGaSQWDXMQo6UvQgU1fVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2_tIE51hSMd9N80vYU_VyvvKBd-MgrnbJAu-_fmKr_A&oe=6AAFEE8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IjoTtAS5G4Q7kNvwEPzkfC&_nc_oc=AdpU4DhhS6H_LsoDUAtwO86Lh-S6MQnzOf_8yJZNPYRk85Mi3FzOhWitcm7xgQL1DbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPKyGaJiyzjJtekuDWxBiuuY_Fn4780UKYhHf9dJhKGg&oe=6AAFD6F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZozcP71dZkQ7kNvwFjjFel&_nc_oc=Ado8nZ6e86R6xJTGOo3QgWkiXA_ihCnx8WQ5Qpne_hTv1j_qm5OdsbBUM3U69F0yBzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlp76aGhylNHgJBlv1qyH7245RvQ9QxJ6SnSz8YyvIPQ&oe=6AAFF71B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgDtVU8jKT4Q7kNvwEnPoRD&_nc_oc=AdqmLTcYHusouVk-k7hlxf7TnoVNrCZ139SD9mjsE3kaqZ9p1NamFU0rrIyunZ4_zm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvrqt54vjIuVAvqh0vhdHVMU9_nOE26x20RetZA_7SYQ&oe=6AB001FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTEt1O8-V4UQ7kNvwGz2QKK&_nc_oc=AdpVcRYR0Dnkgt9qoIqdoLkWm-DfibLb-YXhlTeUQ6EJScZjuz4x4W8G0Nw3x9JBr4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6vYazwKHhtKYJKROhLhOxEh4y2egWusjRqz4Lv7msIA&oe=6AAFE881"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
TDI&_nc_oc=AdpgC49HACJHBOVq2p2YjpFb8YqrRSYShFQHt8jkG1xfUlJKsNuJPMuW0GzrPSL_hYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16JAcZAqqJVRzC7nvV5nk98RXuNaWGYsl5SWa1t9VDBA&oe=69E3960F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVgt7lxDBQgQ7kNvwF2xSFG&_nc_oc=AdoDJc6fkC8OqqLj91yNLMeG_LLK1jA3Jnnw7Z2bvtFFnqp5UkMCZ1GDp8HWxXYDpLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3avyUJ-wdOUU8fa6QPfcbwgOpENPUTvDtDaon3BqOnag&oe=69E37E74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5Em3KppdSAQ7kNvwG0cPzC&_nc_oc=AdqL2p0ypi7xzdyf6ocOKsgTM_3ioqUhNwp9TjnqEmK3hh1D5SSfBM62CeCTLpzwHRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zh_jgKT7OWa9zeYQv00QQKv3W2iaBBlhDmkV-UEja8w&oe=69E3665B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEHAOH4bJYwQ7kNvwE__ruW&_nc_oc=AdqTj2_IC7JynnFPpQ_M4Bzv-UekMeYeDGTCFCtLmOD0dKu8726lTl5kTHGaISeJTC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RSqIxHJ1ac5sC-nIkd5NHYFSmX4QaEDIaUaKgmHl55Q&oe=69E3713B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XueC8MHOEcAQ7kNvwGyeKOj&_nc_oc=Adp_VD0DKJf9DOIl6bqnQW5nbCzbQAsXikYnB60f7VNKNqIMj0yHIKqQYDPs1sbIbig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vN_1Cy2Rqo0iFx-FyPqWyMkFwK5oCAbdYxCA8cKCSDQ&oe=69E39001"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
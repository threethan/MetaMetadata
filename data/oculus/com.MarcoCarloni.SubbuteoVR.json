bNP25xWVXBr0obaVElWz-G7slkN30g9aBX0YqNG3LeTEWU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl07kpfevA5hA9B1FjXmGooGpAxmYlH3Sd9IL7TwK0cw&oe=69AD888F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-EPddmeX9AQ7kNvwEjrblK&_nc_oc=Adm_5S-Obl-fot61rUFxso1aoxtVv603TzODe61Ixd73WsM0WfMOpzWaMHUxDTFwaDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7GFtyQVqztX5g-R1qaaah9IayAoylQuherTMnmGVYyw&oe=69AD70F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIB_69y1bSgQ7kNvwHjsTH5&_nc_oc=AdkigX68-q8G3br2DiBEbcgHloeHrJ8mP42RWweNBAisfs8sBBqqmW5dWrWAph_BDBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB0pwLj2mElmj606BmRaODi_vPs7YBAbZHFp_rQ7bNIA&oe=69AD58DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_-whFzOva8Q7kNvwEhtLqo&_nc_oc=AdkBQAnhSYpx0JSTmAj_TY3jgGscAR0klkBiaD15R8iCaX8lWz06lhud_GLqNTDhabg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU-wjFWK5LCfzg8CG1pfg-RfNy1ba5N989y02WfricXA&oe=69AD63BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVziGI5Z4VMQ7kNvwFS8GPv&_nc_oc=AdkKPfop0a8cTAWAUIK4TuPSrU0uYT3QP_-4f-ZDI6AhRWQ5p-iVONM39vGLkmaMnm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRUZChprCPej_CA1oxE-38FOmpM6nsNogQg-TViZzQBw&oe=69AD8281"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
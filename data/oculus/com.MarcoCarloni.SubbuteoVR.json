Q1W&_nc_oc=AdrksKdyIutH6r6Ie4x_-LkI5uRp9mj51xfRtslJ4fqPXN_MWF2zzCT9AInEleVmC8E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e0QGTUbKTPQX5f9NI049MQZWNSWR-T-Vqn-hTM8qRiA&oe=69E6390F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfkyBPQfk_4Q7kNvwHbve5i&_nc_oc=AdqtUQhWKEdjvZ4bD_BTNHY6ezEs472cKIqS23sFURQrO_jFA5FcMNf7ghzvsQQN7h8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XaxHiEXvGppZtpCZyDsKD88lhXYu5P2_fSNnNtOo1zg&oe=69E62174"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxG1OqGEKGQQ7kNvwFgMUvR&_nc_oc=AdpaHDFKAbeOeHzEJfGGbJYx5eK2A3zMh9mvthgljFHLtFqTB68qTD7sb51nivMk-r4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02mJ0pLMP0pLpvCnjif9ntR2kXgBTYqJRg4keqC1-Nwg&oe=69E6419B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrWDylih16YQ7kNvwGXHd1C&_nc_oc=AdpE7cispHzi_LTsH89n00-UYATik6g9c5gSQS2AwpN8aqk1DxRTFhQdBUzm38kv3f4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tsm1eyF_NqMqdz6r1obJkjSrHeg1MZkF_dUVkCPy1-w&oe=69E6143B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XueC8MHOEcAQ7kNvwEw4kKn&_nc_oc=AdoMTQIkgF_q3iX-ZJH67p-mktbbPaP9xsQPU_5mjs4ZlMKpw1HEWsg8qe2HBUgHERA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jQhG5A6jmgb8IevMhjT_TrwUpfDI5Ws7IBQNOjYQPzg&oe=69E63301"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
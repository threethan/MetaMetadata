Wji&_nc_oc=Adq3l2RP0TAKkseO5XyWH1jObLnAbpDSCDzjzD0mERJM_abHV4YO4uR4JgkoabPs57Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5KlWqsTiz53TUR824WfJBugpjXykpoFxz9PEoO3T6DQ&oe=6A9C280F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smlm4yhPqXUQ7kNvwFHAd9b&_nc_oc=AdrCeUOXGQtZdHeW5KmyLvHXbWALhRUnrbLMA3jdIu6utUF2FQnF6olSu6PMGqeUlkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDT2WdO9GOV-hH0YzUFoFwj4GaRpZ-MMyejTg9W2JASg&oe=6A9C1074"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_vM31qb3jwQ7kNvwEbAwku&_nc_oc=Adq__dLpMPcrW4sR7kTcM6kebcdtgfEcJyv7uC_qYpwcdT8kCH57B_5rJs8x8ppRRDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBiH7WYW3cH4QxcmBYCDV9C2yHMxc2p-sv1XoV-_f9fA&oe=6A9C309B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmyzhlDh-LkQ7kNvwH-qB-8&_nc_oc=Ado4-bVp3M7IAd9H0hBNRRXvhaykzaGJq5JecZsdq5z023rGYtEOQEusDTGLCHHSbDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHEsvWVkgLXELB7nh5hVeMF7SzoHJMTZHkBDU8_Fvffw&oe=6A9C3B7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpYTjQNRC-YQ7kNvwHZOj3v&_nc_oc=Adol-sD4ixoFvwrYcepE00SUKMDKVBej3dlQLWmJXUGo12IhJ9egSK4XFlq20jQj85g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsNf5nVKEOrtylaG8f0TFQfy4Czu1MgZbtt9Ip2uUktQ&oe=6A9C2201"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
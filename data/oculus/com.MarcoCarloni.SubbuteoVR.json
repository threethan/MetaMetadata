DLv&_nc_oc=AdoR82GRQ_xVoSvTOPkWNLpv6V6GvFr8f5_LeAENywIH8EYP7jPPc_FBfla0f8s4lTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB_lDoA-0VfwfoQ__6yMLMLOB6n7i7Achg8axZ_AN9WA&oe=6A60D48F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVc5VZ0OlccQ7kNvwGqmbrZ&_nc_oc=AdqpPYMm8_6VucuNlfHq9YSCGfZfeQ7csfkQiPkKXa9-W1KwReWjhSZ6TU5qATTOP1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO4iIZx6jXcZ6t-1UdjWq3vGkSaGTGyZ_fZSRhq8nWPg&oe=6A60BCF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao-nqC7rr1AQ7kNvwGcuojm&_nc_oc=Adpqn8m1HtUDHOUp94unIXR9TQMlKI838IWEcIcBjcMwaimXcng4sGLSsQxnPCa2Hdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtzH-crGMM4VdmU24yznohfH7KzQAE-4gUIYKLTqyJ8Q&oe=6A60A4DB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fewgJhV8GpMQ7kNvwEyiWUb&_nc_oc=Adogfs4fRypCHzPve9EYerxtbVYClFgy7L_TbiBMYNxFjvbNznSCMAwlH-Ul8tUlXJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCefRK_8DeSRZbgN_h1QKjy2JECi7JDOTqLek3VsCedjQ&oe=6A60AFBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfBdsDJfQxUQ7kNvwGXMhUp&_nc_oc=AdpDdoWYRmyVSvd50A6V8XBvYI0uCQVXfXKrCff167cpWTREkXvyvA497_QyjkSgNmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-DDUtAaEw3-5W76NXlVHTH2PxlZp5cOu_CFbBrjnX9g&oe=6A60CE81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
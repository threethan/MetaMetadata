d9l&_nc_oc=Adq62eHjApHitcmz5ktyyvl2m-94qhyDIpPycaUm_Dc09CpLNFvDWue82sDRnMOa4WM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81oRYmBJWjWbuS2_OocKnckdjcksu7XVxVhXlxj3slSg&oe=6A45250F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPhZbSGebJQQ7kNvwHYUd0A&_nc_oc=Adr6ZBNH74MeGEe9Ymh8uIBFYmzSMGosUazDrQW8JD3uvpyNicO4O4F893lLgK23Rb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K5qygr9py0Axrqo1JGsRgI_hdF-v85w6rB25nihUCzw&oe=6A450D74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qllVt3iBFZ0Q7kNvwHwv8iE&_nc_oc=AdqBVXG_S4DeUjQCLz1I4A7qShVv_vPyBWjjjY_EYQZEwTFRRR8ev2bm5AVuydhLfbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DsYtLUHSGWK9UK9zep1_XEQjR03q0g6AQz-oIDbD7rA&oe=6A452D9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9n25VPRIgQQ7kNvwEGvJZc&_nc_oc=AdoCtlICS-akILU3Si242rO1VNdx8Dmb6drFnksnsnu_TdO9U373xGn0RTzvxQajMZA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Z1oKEn_wdRlr4tr7k0nEsMF7WHlxd16pQ_gCEsRf7A&oe=6A45387B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2l3gqtRCIAQ7kNvwEbyH2Z&_nc_oc=AdpnpaE7oD2v-r0WZz_KMZHuZPUhdye4-hCto8W5exdPL1-N-Z3cB1v2edMEyRdwQiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VpA6AY0Vep-gz-sunoEn5vlptqjLeaySVlgJPiUKG6w&oe=6A451F01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
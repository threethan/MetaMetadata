k_S&_nc_oc=AdqV_12x2MEz9BmoKB7Cuz2z8X6Ywwi1AQ-O6CN-bc2_h6xxxCKgyx8gTJN-c9SWH4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfB6JWcOHi-rDgMxcnP_M4ugzkQ6DgaJ_z3T0RN1aCJQ&oe=6AA5628F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfojEK3OMAsQ7kNvwF_Kq1D&_nc_oc=Adozw5ywAnA3BiNp137f9-pmFYlfTjRhDBE-ayEzVNJPaBo-laOTvCTiQ3mq2KTrzsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWsUrRS3CizLw91xxInSdgXES4eQ4mVGSvAe8IS_DyZQ&oe=6AA54AF4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znxPI_I7ICAQ7kNvwE0h2Qn&_nc_oc=Adpc9P0DfF3sIv6uL6vq1V6Mi8Der0TqnWh-xKFalEhtLd_5hYYwB2PcCJux4OwHu5k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPJEFLg23REbuK43duBt_4Hnxt1kDQkzQxn3NdWe8PTw&oe=6AA56B1B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfkW9u1ZdEwQ7kNvwHwoRMP&_nc_oc=Adqkv-RJm1wKbVJgbq1sO4dtDCGrI0TMd6Z-VIOza_lPDXbwl6qvmTyLuBxmwNKyoSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8AXhHGCtGuMLxe6DRtmtDGKo1WNYMVgeRcP29zWazSw&oe=6AA575FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C_L5H_R4x0Q7kNvwEdATwP&_nc_oc=Adppotj3zNYGlLtRhjhv2c-n_r95uhFFufsW1b1buMKPUTkWcdbVvdVXBEPunq38-PQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGE6OI9vWlt5yD6yv8RVhvbAfTcgURMXJb6aggbwNKgg&oe=6AA55C81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
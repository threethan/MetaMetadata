KFW&_nc_oc=AdrlvwMHM24AKG5R0dkBOd53K40Ywyva83ht8oaF6R9-iREcbt66O5jCOhdzzui8KAo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdBUUENvFLjTgW5Vo-WOMkQFhAI9dp4HyToaGj8M1rrg&oe=6A52540F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a-SKeVgYmYQ7kNvwFg2jHH&_nc_oc=AdpkrIM3u9lEVuDeGiUUIb9XtcjrzfopdEedhpE36sgCMSci0WSVmXJREZjAhfpH6zk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_xbyu10KrTGw_FKDkt2qlc3eZGbkUPV21H9py2HOWNA&oe=6A523C74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSqgmKEsGigQ7kNvwGWGZg9&_nc_oc=AdruMoeU0S3SZNf3z3YmBSuuZaWKMmBDB58V-aQ5atNkqCzuaN6p7voMFPjsdwELz24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXV7U6KpJLje03xdEJhULR3SUtgqZGMdaY03H5dilY0Q&oe=6A525C9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvCxwFMgWTEQ7kNvwH8fLJG&_nc_oc=Adrc_8YxcwCm0ReTa9aVm9MyTdz703Cpp2u-oSFuATpbOTFT1l7sYAInOg7lzIlyeOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrMmZ4AC1TzvF6wM6bJfyqDdswg22MRk4ml8RvIHSOpQ&oe=6A52677B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2Tm6R1NQqwQ7kNvwEFBSta&_nc_oc=Adorbf-vfatfF5Ay3f0W1RRFK7EphrbcAJ_SqN5JvMQhUPs4Z06HctPUHd17LKrqkYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQy9JPTjH1pC-dhfqzcR6W1lU58DJ6izEFkLpSZkQmuA&oe=6A524E01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
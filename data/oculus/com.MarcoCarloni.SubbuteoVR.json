4dw&_nc_oc=AdoEsl_DsWkkxpnn7Mbb-mm8sS12VOOqg8q7c2nC9jE00wSCybsyP3B4QKPd96niDbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ilq29HrnypkcmUWeaCOju0ygewCZvU72QWhWxd0UK5Q&oe=6A2AC70F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3eWzxWoOAoQ7kNvwH803bm&_nc_oc=Ado4ovmMcAFDvYb-YcgFDc-434p6LhcFhKIL-QYLTGLEgMJJTjp4b7UYYv5nOuH4VVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hbdjmgqPJzMKBxf2H9LPaIplT6NvHNBzi1DA6nVfXIw&oe=6A2AAF74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blApB4q-F3cQ7kNvwGnx99C&_nc_oc=Adp2vjXUluqt8-oEiV3K9-NjpRTV-JjpyeDHRDUc-9cZxgUrePCshsnX7-wF5E4ExtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BhHmvSX3QrBtKfbfUg2-VPIADXC4aME56IQI7AXYXCg&oe=6A2ACF9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvnOLc_MKmoQ7kNvwFpNr8o&_nc_oc=AdqvGF4oA8518eze-tkTvz3wMIcIqpMseXkP7MUMOCYMGIdIbib6QTpgiNCquj_cRdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fFGepWrJh7_qb6wkZD72ydi7kNMMQAHyXxpCFKoI7og&oe=6A2ADA7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LNOjbBxi7YQ7kNvwECQDX_&_nc_oc=AdoC_lLYkvKitOMRTlFh8SLtiNE1aMrrT6m8stc_CPFJNT6EPQmuvr5rHGENw2D78EY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DkLwnx6-OFP0EHUIWTYDwE25M2O6oLqCCsyKXBkESEQ&oe=6A2AC101"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
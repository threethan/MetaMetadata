3ts&_nc_oc=Ado_4_my6cWOXpg4nT2h9XyoO8z2uwLPB2qX8m_9ABS46k4lOuK8Z98ON5jvN2XJex4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8L-CttGxOmSbgBkGyV2r6nT2iA6y5KVSeO6uzGPefxg&oe=6A9406CF"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdWjd5rsYXcQ7kNvwFOhc8s&_nc_oc=AdqfDLkDygEm0cJLpedZNAGEiQzsSd5h1J-cIxxvWwd2SlorvT2zWdbJmzoMUwaxaFU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk9P51SJCKJULgtQ0vJ2WkmxoIcXfR2vlivw-tNKtQsQ&oe=6A942774"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jlvN1FT7eUQ7kNvwF78IvP&_nc_oc=AdpBDb7PSXk9jpZUWekw6cF9ZgH0aNOeda1ub9JrKU2odnqjKQlT4Di7bdEneglWcw4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNKaYbLAkFc-hEhqlFTLkxEt5qY_iAorfFKvssx64z5g&oe=6A940F5B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=353qa8ITYx4Q7kNvwEBMCbX&_nc_oc=AdqVj90WOvMI30v8EndGKZGtXwKK6kXP8Ovm4aqvX5grSvYEGpUdE5FQ_BryQkX-gv8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8kMiCR2wmbqZXX2FB29zyIDeheOcWHvWFEDn_yfzuxA&oe=6A941A3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xI_Ee0m9mgQ7kNvwHdtBnG&_nc_oc=AdoQmLltONzE-j3DY_I59fbJLcYlf58LGLh7WVvI9jXeHlUWO70rV8_Wj2JG0TP6BQE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpjHAJ6MFOlAjfneuFwbBY2_PgOUy4MCw69bVpNwnrnA&oe=6A9400C1"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
Nmr&_nc_oc=Adpijja2BubEJANXBPI1E6SC46ni5tZdOaBhQuL3MrgHpsFapxchx73XjX4XG4NL3Yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dZIW6vm-MulydQzUtvs8iLB7AZl1ICp_ey462vUIBHA&oe=6A3BEA8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ru0GgcNa1YQ7kNvwGDTGue&_nc_oc=Adq9_zUmjMARI5HJ3b584Gk2KG8dzz-m-_UD0o7Iu8plvri8exTbhNtAFjffB2VxQ_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zePTD_N6ZcxReCO_xp1ocuLp7CV625igQnQsBIHJMIg&oe=6A3BD2F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjHHw5FBzGYQ7kNvwGsgoP-&_nc_oc=AdrpEbwwCGtToQe0QdgoZTXWdCJApbhrpXX9fLvT_4bvRNAPY3fmrCO2E2O2T9Ls0dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z_J4dgaX7yUT7sP5dqM7t-7esH240gsBTDSrVatPhig&oe=6A3BF31B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApOc5-_9bxMQ7kNvwGqXmwf&_nc_oc=AdqWunIv26w81Xv-ByYfFlOb3hyxVM5r8WUXID2iuSVPimbNh5zeUJO6ahAEA1A3gk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6BzfBj3rveoGDHDuy_dGLHeRu5dhUyj5aZLVwUvs75A&oe=6A3BFDFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jusSoxDBkqwQ7kNvwFmHOIU&_nc_oc=AdrTobNuBNGjPvfvVsP7_cum7NyKicYYeQddpCZYi6HZiB3csaok-Reh8UcUA9D0eqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H7o5rXjnyzmh1RKepXv0dWrfMX5wAObCPAEcQahVrjA&oe=6A3BE481"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
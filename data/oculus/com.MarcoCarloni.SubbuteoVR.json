n-C&_nc_oc=AdqbwetlgkipQouBr4wgaanggLhlVbqDmQ6rGK9cSqJdm8Yix2tXouk3S4r_JSTUA58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj5U6yNlHS3ynal-IpYJuTf0lFeAEz4QYmKNJfvd-B0g&oe=6A92B54F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdWjd5rsYXcQ7kNvwGGB4Za&_nc_oc=Ado6VVxtdyijqOR6nrHIbeQ-AbcHl8kOJuuIc0N9mbOOLzQjYbaOXcyLEBJ8ifYakbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5aAoIh3yxF4Hq7eit0QAXKdivJiTnDQb-y-Zcip5PGw&oe=6A92D5F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jlvN1FT7eUQ7kNvwE16RSg&_nc_oc=AdrXgY-LHymcQSXSLHVBRc0Kdw4W989WKXkVV-wQmVNnEcwfjBK5mTHQA8-YDhLtsJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyPXQua3O2qTPdCYp-FKz0ZjtilS6kfSw7GB1e6Zni5A&oe=6A92BDDB"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWYr2tPEXaMQ7kNvwFVAYL1&_nc_oc=AdrZ_cXfG6LXH3YUUiLCFxu9e9GizUZtoFuKU60j-wzoV3r7_QXJ-gC962kM2cNKSnM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENgo6-DGtqqZSFvuVAOyQkXAKJYPUp0wfYNoRUA7VWTQ&oe=6A92C8BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xI_Ee0m9mgQ7kNvwGWec5v&_nc_oc=AdpdXl2N8QEl8P37prW9M9dOvw_LiK8YlD1_zoBn6PGczuzghUyl_HQL31_oeZmW1IQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeDKu02RbNoTg6oZ1ZXBYK4jdgZRaAnxxBMIgP2cwnlw&oe=6A92AF41"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
MfW&_nc_oc=Adpu_RolrjzsXOZ_qAQo-oy5El2GCpYTsfuA-kJjXejFnJdzCNRac_MZxzaAJP6o9ls&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s0e6Ja5CuuO8rHPX6u3TLHNID4kznYbNBZAiBD9JrOQ&oe=6A242F8F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJusmxemYPwQ7kNvwGniq4l&_nc_oc=AdrWfMnhuMcjarLwFlTzOvlJda-gjgp8Ipimedo4urNbez5zFqgO9o2ql1kxJqacg4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k6UKh0PCtVfV1f3FJcvRjmzSvVeKkb2nsq05yFmRGYA&oe=6A2417F4"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFf15PuVjgoQ7kNvwHkN6pl&_nc_oc=Adr_ZSx-89JbkR2B36StQvFL_DVWCfL86VsC7TiZ9CTex6__FyQnKxJ38A6D56DM2oc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9asvbBqdP9rwqhjbvfldbHV8K_MMyJpG8qKM0KYtJStg&oe=6A24381B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGXLLJ0uHdQQ7kNvwEk2nw5&_nc_oc=AdrFZRGygDsXkuKuLb-W1Bi4aEmd4Pshy-IMZxSzIOlIOdk6hrcucRj9WgqIU8PjqxQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82l_fywK9SBTFUgP3tG3Km89oKXkWSVyMdof5VbYEZ4Q&oe=6A2442FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS_8AFL3UWMQ7kNvwGFCbgo&_nc_oc=AdqiLXXHWc7FOAUg9DXGuhVhVMOXnRgz5CcTbLiH_8fnFgKIQlf-AvY-p7W_4Sa79ZU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lmxY87iT6WDfE_u4D4Dwg4ye9gHS5zwDDJJlo13BKQQ&oe=6A242981"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
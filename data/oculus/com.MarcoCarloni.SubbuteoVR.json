Ydn&_nc_oc=AdrUWqiXHwG9slO4SPgPlJqcaB_8JWvkS_sEHOtOxGexvECRk5fdmU093mtIsMxkt_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w_NhoRsD7iR3i5lbP1aiczQcquQaNZVEnok3f-7blHA&oe=6A47C80F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIxSedrvLTIQ7kNvwFleWvS&_nc_oc=Ado7hn6dWfFRed44YZIgC65vLhuH8yaPv8A2xHTxtCMikhW2rvR-_rkXIA7vlTfhO00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tuZYpmqH0-XJP-wBpDnuTP9LncOHe1wqqV-brsgU1mw&oe=6A47B074"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5IJsmLmwjcQ7kNvwGGuhPr&_nc_oc=Adpqj9176RX8ZeLfW4b2NPdqip1zBThXhQPNOD3G6VymdFXXBzj9aIOgqLXtmZVwRIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eBt69xLPcOKlv1HJQ0gIMDYd_03eD0epm36dSgkc6WA&oe=6A47D09B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9n25VPRIgQQ7kNvwEvYaww&_nc_oc=AdqsShtdp1HYgqoHPi5nsUkKGduPRV2xNo2i0QrSHjnmeAKP2SvSpcKELgXpGJ6gV3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gEBA8LrvMr8nddcTwDK3C4WWDzgLbTYWE0JyjqCEDbw&oe=6A47DB7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5MeTyPXt-cQ7kNvwEkFmGm&_nc_oc=AdqQ6LvgQuKik77PJ_oWS_DkqnvDjjuXkbSX-EjWHsCPn0K3XN_DobM38pHYpQN_9L8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b45j8lktYoAnP5HoVMczdW7lH79IbCPs2NHIyEPqQGw&oe=6A47C201"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
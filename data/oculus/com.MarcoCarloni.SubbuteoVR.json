wHtrngm&_nc_oc=AdpB8Yf1wuDu8N8zJ2pdKMGG6miItCTRAdBNQu_9Z_XvRJbYKJ9EUxrCD_5ZzL20zAQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfgLtjyL0SFjJYzw-RBpJ0rEFDjeMVTyk4-dXt_MlabQ&oe=6AA4110F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKWNFdgatLQQ7kNvwFuFeYh&_nc_oc=Adr5irVurGBaVihtz8ZCCbFMU3otoTKMZ9_cPfWbynHwiJsBYc2gvc9M2yMj2iYM5JA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV4sFeU_MhqH3-72Zgxf464a04i2s0beUKfeUDXd8PJQ&oe=6AA3F974"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znxPI_I7ICAQ7kNvwFYkhoA&_nc_oc=Ado-lp9K3fH-hfHEMwT9w0t52c-8GztL2koDvf1e6CBGPkqXlbaiy3lcdbpuVjtjj7I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm_mX72fpqgsWhtESbIBIztks9viTCl8qSS_H0mMBH4A&oe=6AA4199B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfkW9u1ZdEwQ7kNvwH7lvLm&_nc_oc=AdrfxJJfBOjeAJNmAWoAgwVQPhxQhhSfpIfHVWvDs4d5-9EO3J3Ddcs-mhALlvOFpuk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH64kdYoTczWcemVq5w6ZzzqTC4JmN30aDedyd8C8rWw&oe=6AA4247B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRScDhmYLs0Q7kNvwGidPlt&_nc_oc=AdqRtOCl9h8jzKkIQRj8joK192xjtFNYtXldDC6A1878hhny9t05EivD9X_3I1ZRb4c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK71ERoTmaYutezsSUZUEVjdryuK1X_w9CKN4_E8LXfsQ&oe=6AA40B01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "
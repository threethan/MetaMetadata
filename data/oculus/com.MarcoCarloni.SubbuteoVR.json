9sQ&_nc_oc=Ado3Z1guxMXf0w85jDSDNtKgVzNBnXEtLKDqLrWDVIJfvhUCZOhXovtrZWBMZ3mnxOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H2u72ww7U5H7dXUiMeoZ_ws9wM5sMFOVmU8TqTywHsw&oe=6A18520F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO2DJFz1oq8Q7kNvwGG7ncl&_nc_oc=AdqMdFv_DrPqO3E4Hl4rnlPLLcMSqIOlIpiNd7F92mYx9cDBCh6GbpQyMFxZSsCGcbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dd36ZrGG-8_7wr1JC3avbvp_8P5nnMxkWYY9ni_dYhw&oe=6A183A74"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBlN2irpaicQ7kNvwFCz8gd&_nc_oc=Adq0BgHKpweqhmlgHdI3D4_boMBCiES__uOeun7jZ7jNcHA7wymHWN_Pf_5leB3Qu7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o0eg5f3ltHbRNo3acU2NxnsNyacSyz4_kZJu9LQ8TVw&oe=6A185A9B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_Nv7mACS7AQ7kNvwFjibLT&_nc_oc=Adqa0OuaFfCEzeQzm5jVDh5YdpJHaHIy0F-iF7SJRVTOvEPVn1pjxuCsgFcmRZxbPPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KmlTRp0JxmRBE7dDNVL8EVIQlW5NEUsPGsYwfpFQ3rQ&oe=6A18657B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqsbnuS2EHYQ7kNvwGrtRQL&_nc_oc=Ado54llrx7tCib8uHHFFSPLBtYN7PGLvagTbTJsl37AzEleficI_oRqMth_4koRDLgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BJLyvkgz0Tcyq8zqk7A-Av-p5K_GbUGl_eeLxysgd8g&oe=6A184C01"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
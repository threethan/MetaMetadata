4s6&_nc_oc=AdqxgBe4uUAv8lNOKMJ3-D50sVE1I_byAQgVYK4KIH5y-kFOzd8jHB2ORPBKDPZt4lE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNAsu-IGuh8moFZz2PgDfcekEy1abhs_6LyrZ9L8nZvA&oe=6AE9F08F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40GYJem46GwQ7kNvwGIWhBZ&_nc_oc=Adra9EoDhfzcUL-ksxO6U-hPJSyvCJmNryk6E5zXoJJe_yMdoF09e0rjISB02jc-Dh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlYy5yRmq7WQReL3wxU58E4vBoKpB1IM79FxAl19VBVQ&oe=6AEA1134"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ubyQpQb_c0Q7kNvwHKPNlJ&_nc_oc=AdoOQ1XX6xxImW559_W_2dvD9IqWIM0yjyThLgA89Jl65gCh0kjwGSnhgQCuoUdF0BA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcryeGOAAWoQaJWAjGy2qjO3kAQgLUxahrNcf5cNTeWg&oe=6AE9F91B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQkVnnyJWacQ7kNvwE27-Tt&_nc_oc=AdqONP2s18cnNFAcolS5aVF0ORdiSUT0WiIm80sDBrenPkqGdatQ5oc47q0cnOvAW5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcTm_-bRjMn5yeKP3RbspR4I1pNJEcW9mSXMqkiBzhJw&oe=6AEA03FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEyQk8U8ZE4Q7kNvwH9sRGl&_nc_oc=AdqTRk-JG3ZZSJDuVPjMm0CbQOhR7GPw9RSqsQvVMa-je4VfrRIN_g9hLNjH9CF5PhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQLaD78LJJekrAg9kANjWooo4P0vOLEztORVnpRsG7Pw&oe=6AE9EA81"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
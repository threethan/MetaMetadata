aN6&_nc_oc=AdrBd-4Snh3fzbDO_QDjfZc-EYbiqlfUqekfHEMYxLirnlAKhDEHzZ3uvlBllbaTXT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MKsyHKsmCwMQUIPRvgzdHPoeBezMMRGBijZPaOJhNlw&oe=69D90A0F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzUeyxd3bLYQ7kNvwGmqYb_&_nc_oc=AdrM8XdR-gCH7hA4qK8ONvaQMdWCW_iaGKJhMaqbbjpIGIHZYGmrRZ3FEavykdHHG6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Of36ieTg_RC17K_7n_QwA_2Mw2v5B-vUmX_E1Gjpw8Q&oe=69D8F274"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVOn9V0XrJIQ7kNvwHyicOq&_nc_oc=Adrct7uANlimWPdy1CQij4byKCPG9zwo1LV6i4dpO0Dws2vQT6cAB1ydbkDLILK52os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jvTe2nceKed2ZsbhKChXss9Y5rLnfUeBXOPdNGdH2xQ&oe=69D8DA5B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEb6MW8ba98Q7kNvwFbFlyw&_nc_oc=AdqLxVjLcuW3RmrY0RbrpnMXS0e399oifn2NUqXoCHMVPxSKA7KeIRPYeLS08jlAiVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_ZXrdEGxU9IjG8nxNP6KSnCUolnye5VNEGOXoVR1o0w&oe=69D8E53B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4nhJHuYb18Q7kNvwF7et-T&_nc_oc=Adqum448Z5xWcIH52RIH2VaYbbhqyBmGZGK3fhCFcZnSR43FVD6tSWDkqZhphfwLZrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cCt0iFfTuicsZzEUI_w582JP33ZAF6Y-mByhLmfWdmA&oe=69D90401"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
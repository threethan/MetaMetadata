leM&_nc_oc=Adq9lwEtUOyz87iDL1USK9xDEatenpLZ7W_AjgrBYgjxd5Dbq5q0KeMrDFVxoXavW-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcsLD40gaWdb4bjYqH_NjlJaY2HWy7g8IvfdAPLrbbgg&oe=6AF1D98F"}, {"file_name": "vlcsnap-2022-02-20-19h18m07s992.png", "id": "619769799118668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_619769802452001_2094890422274419360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44geLfFcoRAQ7kNvwFHcljC&_nc_oc=Adq2erg2_zMFamlnDs7bActsop3g7Pru7mZwcYAvkOTN1_9g2nMa-3osdJzntAY391w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfw62KpcoxgB21JGi6e69veP-Om8HPiKw3Gsqr4FvrEQ&oe=6AF1FA34"}, {"file_name": "vlcsnap-2022-02-20-19h23m03s509.png", "id": "1418043768631519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295892_1418043771964852_9176465051160710845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4JV_WttMAUQ7kNvwGjdshp&_nc_oc=Adq3T2XNYM7HTpwJS99bOBADdXO7keA2qHI3DM1YgrnIWuFPN1qv3CybRqMHNFjhrJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDM9vd_e154rziira7JshCHBTRVxcO0m0aaWkU8UZDMA&oe=6AF1E21B"}, {"file_name": "vlcsnap-2022-02-20-19h15m28s471.png", "id": "369786517987108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_369786521320441_3179288813000259038_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba4X874iKAsQ7kNvwEX29Cy&_nc_oc=AdqRFa26nhifyZw5J3NjXq7np6Csw_oU3MJ7vEvj9Ndu9l3xPb4DmzYlk8nHO5yFdsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL_MK_FGP3slKmAzDpQtpiOntOBeDRfY5zmeUUnpO1Gg&oe=6AF1ECFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Finger_Soccer_copy - Copy.png", "id": "1011446596918089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1011446600251422_713221081973221875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5W2nH8hUqxgQ7kNvwHYkaSa&_nc_oc=AdrXK5qCUL-B_Ez7KXWR-GUDo18YNRc6OMfXMB8Z37wbt3vqwGmbhMv6wWisJdSxnfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBhLfmjj2CPhbqaSXZvOxvoVk72922tYL_lX6U5_v6ow&oe=6AF1D381"}, "display_name": "Finger Soccer VR ", "keywords": [], "long_description": "Inspired by tabletop games, this game offers a unique blend of nostalgia and modern gameplay.\n\nTo get started, simply choose your teams, formations and options.\n\n You'll then be matched with another player online, and the game will begin. The goal is simple: outscore your opponent to be the ultimate winner.\n\nYou have the ability to tailor the gameplay to your liking by adjusting features like teams, formations, player size, game time, arena, ball properties which can affect the gameplay in various ways.\n\nAnd when it comes to controlling the action, you have options.\n You can play with your real hands using hand tracking technology, or you can use controllers for a more relaxed arcade experience. The choice is yours.\n\nJust be careful - hitting the ball into the net with your hands isn't as easy as it looks. You'll need to be precise and strategic in your movements to succeed.\n\nSo if you're ready to join the action, start playing now and experience the thrill of online soccer! ", "short_description": "Join the action with our turn-based soccer game inspired by tabletop games.\n\nChoose your teams, settings, and formations and start scoring goals to be the winner offline or in the online matchmaking. \n\nYou can even customize a variety of features like players size, time, arena, ball and a lot more!\n\nAnd the best part? You can play with your real hands or with controllers - the choice is yours! \n\nJust be careful, because hitting the ball into the net with your hands isn't as easy as it looks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/FingerSoccerVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/", "category
iYWl_IQ7kNvwHtqCYE&_nc_oc=AdqG6RyijTMS9ODNcgffItHzbiUDxOqc4aYvzofLzC_b2NJggo8nrUviZvjneTQhVI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29u7bg7ByY4YrMegz5iN-UEWQG1phQk3-jPaWwotZbsA&oe=69EE1D77"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIwjIiUkatIQ7kNvwGvT2mY&_nc_oc=AdoXYjEF8SROfcjQ_B-u5Anr-YyXlqfkWoHDn78sx0cb6rOwTxcq2THtaoOteuvRXvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UiW7QUWEoeFCfuMWQlBxTmkQxjVsnH7DssJ5aVIrvgg&oe=69EE28C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt88IWwRxH0Q7kNvwGGptiC&_nc_oc=AdodiZCVJ6xx3Aqp2S3rc9ANAJAKhJ8jQvezrWLYwTTKnGEREyzWU394TBh-E4y5X1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WoLQtRaHguLwDHUJc-WGFUYVaViaFC00Cw496USOhmQ&oe=69EE2419"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
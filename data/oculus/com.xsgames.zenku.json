NgHmWMQ7kNvwFfkUVb&_nc_oc=AdrNDJjkRdmSufl8EneZLGCGCSKRawA9BXq8--dqZYhZOxCneAUbW0VzOH9nMMbUw-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6da_dmvqO8cyAOXw2IT11g3xnbaqlLHE_yuy2mVP290A&oe=6A087B77"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTSCRi_vCh4Q7kNvwEiGcxy&_nc_oc=AdpQaEurkaZ6HUf8DXsReAaYmgvLVsWc8OnGbSEvZV-CEo1EM93oKaT7_HNHJNxqFC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64mj6t-OqoOZhZUJn73oHFobkosUAuBzrfwjXmGL13jQ&oe=6A0886C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4awTkJSih4wQ7kNvwHf1iWb&_nc_oc=Adq0UIx0fx6XYxEqC-6bMftkCoOnYUlvEIONGF9NNNAK6_NCsn9lBu1cXMgQvpwl44o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jmk1Sa_mAStItvPCltRRNkeeKd63zVuewvU3Ngdq99w&oe=6A088219"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
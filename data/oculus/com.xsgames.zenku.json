5_3OMwQ7kNvwF2rXCU&_nc_oc=Ado7P0-2csDfYjPDYLoAuL7Fuoi9i7QWYJuv64zbIy0zD0eu10adYKa8aHoUqL17Mdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmYDLHhhHRQgblmF29az0g8kKKOwmF8hlvMM8218uT1A&oe=6AEDE077"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXAXFhh3vEQQ7kNvwFiDe_4&_nc_oc=Adq0hbxFZHaiIZ11glQrwVqinh9C1km7CPrr50jewyAHRLAQi8aNb1SRGXTJrqmbjw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDAX76SqbI9UVlgFd4rwOs8HTA81d-qW9E8-XlKr0MXg&oe=6AEDEBC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVvhNyMuK8UQ7kNvwG2OkIR&_nc_oc=Adr7PfwANYfTkKopP8Vl7fvv9jIqJYIkF6ar5593huXmVykL77LJZ923WBErbNqjk6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQewqRtaGWyR2F0T1Jza2A5OL565nhsumQMixRYAuDKtw&oe=6AEDE719"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
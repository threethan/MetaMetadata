LnQTF71eBoJaZQ88LZcMCaZwpz6YiK5SBA&oe=6B0F22FB"}, {"file_name": "4.png", "id": "1646664782632199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393450_1646664785965532_3432233000533826163_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tHcZVHp75QQ7kNvwEtDGec&_nc_oc=AdphqZixusG4aoq8evL_fRuOao71e5nq1kloSSA11bEKoGx2syvOaKo8HSxE6wD8dMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYWrguhy5a6fSrKpbLjX1ECEovS9Ru1SMysdb4CaO8yw&oe=6B0F0E37"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-pSPGCFwV4Q7kNvwGZMRs8&_nc_oc=Adr5DHmtPsFMN8K5PGvTp98OayKvwMB84aaEN1o-bh-MFXKrk_apgFkJbTDiogvM_Kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCoAVCpCdfuIi_N8rLmm31lZCqg7gSSJJj9TORxheSjA&oe=6B0F1986"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YLi6VxlyV8Q7kNvwHucxTq&_nc_oc=Adqg1H5Ad_Hlk0oAiVqp_j9xm1G-cbbVbBcG3NZ-Awh9Q0ZfeNyCyPvEh_OHIMPKDNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGZwBZ_n3Px0gT7t_wvoL8SezMeYKA26HtRdunJ9fe7w&oe=6B0F14D9"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509212975824255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_538663635944352_1017750429346581635_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYHgRdMj-TEQ7kNvwHwTqPu&_nc_oc=Adqr3TllI7tiFK2NmemrOfaJ9CRmO-aE-KEJzP2VHI2DXnnIsGo40IBBN5s64HeWXpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyuUxTO6SdisSnhsoJu8TrD2llt7c8wqDeCv84gu_K3A&oe=6B0F2144"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "\u2022 zenku \u2022", "platform": "A
QdTWr8Q7kNvwGutcOX&_nc_oc=AdrutqgEn7LJFxnmXCcqf6kZzd_mGF3AAPGc6MmpONK5WlbzgMx1h08gXSS4U_GBMvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOjxGKst1IlQL8GYp4ryvU8CqMwuOYTP9sXCHB8nwa9A&oe=69D11C77"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a5KJ4-SYOcQ7kNvwFI7yFT&_nc_oc=AdpYpEjo0yTNmupb5Zi4mJFFP57reEY45aMtodFl3FqSt_EYcRJ35BuJl3OmoXyEOU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNvP0dDZ3Jm7s6TpgkCHhfVZa6ttxDrhhECikS0u_3Iw&oe=69D0EF86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hfuYY0WOZ4Q7kNvwHe73IH&_nc_oc=AdoN-5AV2KR_jCNZg3Td9X2TlY1TSrzJ2mSuU28ARp-cHqcfP32gWPcTnT2uUQT6aGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdZHk6G2OLo04HiotI1dg6z5xdNixMX99Rf-cVo0JM7w&oe=69D12319"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509212975824255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393450_538663635944352_1017750429346581635_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVtZ0ZmrHRIQ7kNvwGbU3mi&_nc_oc=AdrJJ9bxl65amzwBkLDiJDngXRs-OSb6IQjAplVwn4iqJEZiCzYcr-HJDbAqhWojdyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1nglcFn5XX51v6TLtZs5W2X58rnTGKn7X01VQku-7lg&oe=69D0F744"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "\u2022 zenku \u2022", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1744091940, "lastRevision": {"nodes": [{"id": "9506280662784153", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en
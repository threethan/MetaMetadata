uscdn.com&oh=00_Afv8j5WeUJ2zZ2a_UaXdIwUtgoxatArvoyO7t4LLdjo2iQ&oe=699F0377"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3ee-wFSupMQ7kNvwEEtMhG&_nc_oc=Adn1d-v6DMeYHbGk_EX49EBMvYvyunGtcHjUyllLdF_ilIKRlFA688Fzy5rvAm_XyKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsbHixAb0OsgF0d-vkXTjR2j-m-ZHdpRkLgP2OHEJRfZg&oe=699ED686"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLdIYA-_2IAQ7kNvwEfAeNP&_nc_oc=AdmoSGDi1HEw9lelDvtizpid6Qk6YfiyJxSERPIxo8jeLQD5hPin2VOQFwnhoB38eLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuNuEGRQzE6oJta_Ln9fnzmMyjrySBGqwZGapvhiJ0qpQ&oe=699ED1D9"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_pri
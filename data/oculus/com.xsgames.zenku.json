YwrK70Q7kNvwFnA1ih&_nc_oc=AdpVithLhhxexugJMVhIR4C2Ltu7PjtJx1K8MOiC8AXkh-ySi6c_5aox3e4Zq-ltKik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDQLbrlNTuTVz2DJrjFqAaLYVnwNCcRMV3MUr0xfdI-A&oe=6A5B89F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPywXHhn3YkQ7kNvwHjrMPn&_nc_oc=AdpdhFvGPVH4kmNE-HA_mgWsq7jrF-bAJg7onFsCdN8Az8FMA6T15GRdyln6TEiprMg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFB_6PCJKAAuDxh4qbq718CLVgB_U2H0II6uTplTgXjg&oe=6A5B9546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5zZosm4HhYQ7kNvwG7MWla&_nc_oc=AdpiYRAvkw6m5dunJhXz6B2m7SSPsm4yG-NIVU1M8KejuYYkMQ5aJ9-NoQClkGh9Fy8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6SgAuAuJjtNmSOOaYFYp7zNiHdyWUC-rFgcLpWBErEQ&oe=6A5B9099"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
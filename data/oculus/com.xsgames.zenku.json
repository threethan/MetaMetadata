y1BAScQ7kNvwH8aSHy&_nc_oc=Adrup7n0xXiLcm77OU6s0-GPqBrUwVLxY9UJckkvWC_aAWIashLD1DKOXkJfKeXRiAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dfIuyODCkG_jJao5_SWo7UVP-ODpsoODqubN1_wnfLg&oe=69FF40F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIEsIrAo2C0Q7kNvwFGrrNq&_nc_oc=Adoyj6GRkYmD7rrRdDkKj8_YBO-DFM3d43QqW1bw3ldeFqRztvtptx7uX8vbdF1GTCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PSno9omQcMR8l2i85FeBfwX2hRRDIVYx0PI-Xhq-EFw&oe=69FF4C46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkaZiwj5OCIQ7kNvwFgxmgK&_nc_oc=AdplWWkfZnSxindicehnoA3JPfFin_TfLgY_eoCz5tOmAhqHYNu5p7VtUf3CveDiHNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Prh9yO6hYe5iO7f7CsqkJeLwRiKtv7A_SWaXWcQxmjQ&oe=69FF4799"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
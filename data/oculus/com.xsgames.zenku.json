8wfKa4Q7kNvwF7-I4I&_nc_oc=Adq3nxhSLXi7TFbbVJ9SWfKOKB5YMx4tmGA9lYNBDMQP4sE2tLtp29t_F_0OgeKgoH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUM7vaMhY9IYkt9EzwDfnP0SFHoYXQOIhcgP0jtDjOsQ&oe=6A60CFF7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od56q5qjxU8Q7kNvwFq7DHY&_nc_oc=AdotjZPLDtOdrqWh361Zll94p4tmtL3FS5_A6CJpeUEPl8T8aq_6iHovJPeQylcL4dQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyS4UIULRT8P9h_upveRhE246R9J-DAYwMFI-iiQvynA&oe=6A60A306"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6hXDP_6TT0Q7kNvwFIeFdS&_nc_oc=AdosQC1ByEnCbfinRtKrD0MrPxRwtf_Jf7-i8v60yR4JTgR-L1-nZm_x1W9FL4BQvX0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5p4bS0tZoBIdYams7ugpXp3rkYQ2wFZJg6i65VugHqQ&oe=6A60D699"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
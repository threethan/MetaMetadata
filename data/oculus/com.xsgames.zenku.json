F4vtUxg8G9L_NcCsU4q_n0mINR6kTA-ENw&oe=6AFF18BB"}, {"file_name": "4.png", "id": "1646664782632199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393450_1646664785965532_3432233000533826163_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_TmFSEnUN0Q7kNvwGRkuKa&_nc_oc=AdqzlTDwhqJB28OWoxAZsg-2VEv2vtVOzEJqlb1yrEj75mGyQGWj2LYVIU3JgBrcKnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYny0eBIHjI-Y_w1HDrr3sd2AtWIyfhb7iy-_u-Jp3vA&oe=6AFF03F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RiTRr_3RjUQ7kNvwH7iW-Y&_nc_oc=AdpOQvTPGQTUw9In253CoKQJYmFV7PWEjEGDpVEV9fovtVZlHbJFIgaOTx2UD4m5KGM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9_HBFOrnN0ip5-P8ML5i_lsWqaqaYIyZDxwEMuYibfA&oe=6AFF0F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbbFvocf1UoQ7kNvwHBdM7V&_nc_oc=Adp_diOVS0z7M7TQ7oxdaIoA8mB7CE_V7EY1efteQHKW5t7O5LGoRjXbgQIyzBV6Z5k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5uKOBbh3tn6FskUEToxGucBAt1eOlsGZMQ-lfTDjt1w&oe=6AFF0A99"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509212975824255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393450_538663635944352_1017750429346581635_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwNrwaStG9wQ7kNvwEpeH3N&_nc_oc=AdrYZBIWKRQ14hQoIBCj-JxEHgrfE8jNh7eJOZLV9P4TsVf_iOzu2CIemDFMSU0vm_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjIUr6-knAngnu1MxyRSY-meJxK-9gIqS5DqRKJtE9PQ&oe=6AFF1704"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "\u2022 zenku \u2022", "platform": "A
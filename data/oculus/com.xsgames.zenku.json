iWB7w8Q7kNvwEAi2eN&_nc_oc=Adr1XxLLLeXXmomtJW_QaxmYj2P51vTujZanifFozg-ALQFmwNx6M3nuULIqpib6kOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LnchJiVvxcR-rg6cFFwL72TFRQjh9EVE4HNUSBUbv4A&oe=6A37F177"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KFGYohEwMUQ7kNvwHkmTrU&_nc_oc=AdqWWxvEdP_0crZNy4-J3X5jJlygYtArB1PbXbCXxPsrgASU5q0DF6k6larA8z89_5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QLGc7ZGtF1pfX5R4-oNTp-UK144Eo56uQi5bycTL-DA&oe=6A37FCC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMbKUidPzVYQ7kNvwENqCEU&_nc_oc=Adp4WiQUeBhu6YBssxc89IHy4vP534Gu-HOYqhF2l_44dIo1C0m_ll6vA4ISubsBIuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_isXgU5zzH1_gzk_v1MIEZnhVf6Bo1qhK5SxZGaL9xQ&oe=6A37F819"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
eHlkdcQ7kNvwF2N3YZ&_nc_oc=AdrW5Yh7qc5-6znmaH2S5PJSU32uPqMg69jHGVkO2YFVZnXeQ1W2Nxyo6hhlUBdbp00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPQu65XF1nxzt71AIAjMNfXegiTruwIaEw6OylE10FNg&oe=6A8316F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYekH5LgDS4Q7kNvwHy192-&_nc_oc=Adq-ptb7DtTyrlsN9NXyaoI6dC0Rco7KmJHwSecndeEMR7AmcPyq6ClNYz0Dyi-ot4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm1vOXqjYVR-VkKFzKaamOVp-I4ha8gup0kLb94OtA_g&oe=6A82EA06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R03NmHMZJvYQ7kNvwHw0X-T&_nc_oc=AdpSQYCHtaqgMNpiuJxmEXMdOE9pULA2q1W9CFFgDkuj3oKgIwoBeVh2O_aomNr-QT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7tbQFZKzG1zm_v1ekU2LLZKFFWVriT8_iu7zDJt54YQ&oe=6A82E559"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
NgHmWMQ7kNvwFI4G0E&_nc_oc=AdoEZajYN_SSLhV4vAuUPY4aYBER96wG4_5YdHbwLPyrfdur3X6TL7yhzDg-dGSjqQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hmVl5hAbJK9DalNlRUWMtTVITB3sVa3_6dWcqgvzP4A&oe=6A05D877"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9m_iGlf4t0Q7kNvwFYd2wp&_nc_oc=AdrbwR3kTj-uR3Jqs9oCa-JoXDw0aJx3rzUtZGMnFr9KIbt3Azyk3jUnp_qXxAS4p-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AyrvKZLj-1gNDaY651NfQZmOFhcZW_xwF1YKlRrByWg&oe=6A05E3C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Opa4tnKy4BgQ7kNvwGwhkqn&_nc_oc=AdpeoO2q1yHySUo8Mz8Bmg26JvwCvM8B7wX7QgX-dEZOc_P7A6ODscxq6KT8i1HoDhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w8SxVpBweM-DWffkpYIUax1SQTMoaFNhdSC-Pp3LwWw&oe=6A05DF19"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
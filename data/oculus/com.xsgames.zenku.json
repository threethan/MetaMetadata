CPM_70Q7kNvwE1PgDy&_nc_oc=AdpqGm0slK5PKZa9Nn020KnVGnqZTpcDO7LjxG0xIV5zQzyxZH4_meMzMRVlYvauW78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP45Qqd-pFUrQf0MTvDMFlpZQHEkurMs6qDqdITzI81w&oe=6A5E2CF7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPywXHhn3YkQ7kNvwFCgkyj&_nc_oc=AdrKfkL5tO2YTRdcn-W5zGgt27SR5UAB_KvEmUte9c8iQRN913MCXhwRKKsaYFoztcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5_S007sXJfAe8oQHUhfavPmzMGeRiHtr1rHsg3gadcw&oe=6A5E3846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6hXDP_6TT0Q7kNvwH9No27&_nc_oc=AdrFYMgRSq6jZmZdbaJ9JVp_JWsvZ8mwz6S3fLrl2JsSnwdLRgwNHRD0lsk3u6vq9uw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyX0gR29ZNDGAa49SPAocqiPzyA1G_8GBqXv-7TaeNCw&oe=6A5E3399"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
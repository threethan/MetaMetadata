4h0zqgQ7kNvwFCJBFA&_nc_oc=Adrz5pv5qa-KpVgfh6R1rePDBEjH4Lud7f8FUnWVPw9oi7Mf-nF9r77Uvea0wRcX27c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuA4YoUJhyTKMA_6FhbGna3WvmT64Cf52MWKgE2xrRig&oe=6AC7A4F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZXG0znTt_UQ7kNvwHfG9UN&_nc_oc=Adqz0-1O2FWmstUomDdpFTx5QtZP8NR5DgisgpGgg4XwSdStqgV43cssUHlDWMfgoBg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfDgj5eAqpe5vPaekR1XF91184g87SNSMTPUy84fCIhg&oe=6AC7B046"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgEsoHzViH0Q7kNvwFT5kb7&_nc_oc=Adqdwoo_gCkIpjEU-liRiB_Jh-UX1OKaUbMBclpD01pPkyM0wHB_DOvb2aAMDe4-9R8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjVswa63A_--VL1LQtYM-suKoRJiCMtyKP1jCh09cb1Q&oe=6AC7AB99"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
lqEjUcQ7kNvwHSbfJo&_nc_oc=Ado8lI7QAplGAYZH6eUhpvr_sqexSq4bppnPcT9V7E7rMF67qVc5Zy2P6Skq2ChxGEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af055jvI5fj9RS-kTgtwAhGk_qJEIcx-C9wvIP89zsmyLg&oe=69F757F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDlyiZ5FEWcQ7kNvwE6YMV1&_nc_oc=AdrgYu4ekRilwHRIrilXjJ1un0FxBYQqYISWszHtRXvSaCN85wAzj1YOxKRtyKTJBmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mNoLd4ELS_dOKNz6b0gEknYM_ETRHwvMnIG1Eoao0_A&oe=69F76346"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C0hTzE91KMQ7kNvwEKMwXN&_nc_oc=AdrCntvoh9Lt08qZQ6I99QDfjJOjnzTS7S16FQoLbGs3s-C8pYRRryDxVNGOHDhL8Ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1u4wvRWAOtn-EOhwaQLd_EY4jyL3fUV2wjQB5lmSLm8A&oe=69F75E99"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
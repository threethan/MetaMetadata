uscdn.com&oh=00_AftiSU7ckYRxxgUy7BsDHPRSpQJ7fxBsrUaNP6PG2RPR7g&oe=69A1A677"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IUubUpSIssQ7kNvwG-SBOJ&_nc_oc=Adk21i17LJG_3itFI7BoiQW2cj3HrQETGR9YGy6QTcEsm5IOat3y_f1_6TNFie6y-Gk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvVD2BetE37SrkLW6oSDvIxlZt20r6jpKSmfJFtjYYVoA&oe=69A17986"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON1SKNVa_1QQ7kNvwEChWy6&_nc_oc=AdmsOrF6TPaeB4eYNrZ1fcYpJn8him29lvAwPzgFXeM1RxuSEssWTcLMFZ0wRynt0rY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvHSPYhDhoqmwWUReVM34I7xCSXWe76LWpvUXgljDUUTg&oe=69A1AD19"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_pri
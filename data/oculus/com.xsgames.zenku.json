B5sVewQ7kNvwGVWpIR&_nc_oc=Adriv1etTjU1E5w-KBVc2cHJXLj2yxsjfZ8rSl1am4dLInmL0w-UfYwsIgorbe1Nz1s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hc0svBdPYTqnNjk3gUWOFHivPch22PCehihsTrWstDQ&oe=6A1C41F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqbrLVJHa5EQ7kNvwHqZ57v&_nc_oc=Adr5K5cTIfi2xrlFGaY29d4BHEkoFh8j1c6huR1Tby6mzW0LW0j4yDBWFyD_D2Y3bTI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EEXurJvRoCq16QbRD61h9hqWEfMqpnuJt08fWV0ngzQ&oe=6A1C4D46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcFO0Dy6p4AQ7kNvwFL7qHk&_nc_oc=AdqcGKDto7qDxYP6dZMNd3JYSiQtyEIwI-e9-VwK5TPVexsy8EdPh1D8gUIrZDMU3Zk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51VM1jmr2THMj9CPi89ZMLbM--v7uoDaevzuqeK_Rf8A&oe=6A1C4899"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
iWB7w8Q7kNvwHne8RQ&_nc_oc=AdpVzET1O4e0Zz6qolaMbCz4-d3RXyJq-oGiefpcRoPQXV_1ceDekx_8ij8-EbnTzkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hmqAxhta_XaEyu9y2DmTcXMYQBCQ0ZSAd4wWIuUG9Ww&oe=6A354E77"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v-N8VJOWKUQ7kNvwEhvk1S&_nc_oc=Adrms8gMfkS07u3gLcZcuR_oig840HXESN69BGAt7Bchzo2tLlgesFjcwIiIjpwQ2Vo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eWfTQSU09Am7RlQQiH4J0Y1TPFmB1yVv2qdO8DHb4Dg&oe=6A3559C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziJGPw7b2CAQ7kNvwH83mGl&_nc_oc=AdpcY8Blipbv97js5n_bkTxO09h8odQHZlNqcHHk-nGjgQmeujTGb8ouGljpaYaJsTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_th78HR_7cfwfj3Jd_oXgKlhRFPvgegcfPC4M88tCMA&oe=6A355519"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
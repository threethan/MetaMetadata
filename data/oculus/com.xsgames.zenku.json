iOwiXwQ7kNvwEwQO9k&_nc_oc=AdqelYWFvFB_vDOhTd3ksEiUK3OuFO-nsQMXyAgac2e7hZbUVEY4UEdbvne-8PeNYMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAquSWK5fLFzcd-PVkdqs0XGVBRsVbbK0b4UyK-RaWhQ&oe=6A4914F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN5IXDvm4c8Q7kNvwGpmBmR&_nc_oc=Adqq43FMPJfco6KNCeOMGdZHYoSNmHA27XaETj1l2NDm31_bUbHLHDSkDsRDBxcZ9pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG_KtgW7m8L9utP_ENqHg8iBLbotD3_cehDo7yqB7fcQ&oe=6A492046"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8OMbvn5r5wQ7kNvwE5eRIY&_nc_oc=AdpORe0qHJo0vwY1GEDdlFjqRnGUHbINrFsnEh9iWzSXp7VQwqRSwIKm366YxViUAEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfhMICAez3tbC9X-X9lZPRBk169FQxqI8MvMEo3hM7CQ&oe=6A491B99"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
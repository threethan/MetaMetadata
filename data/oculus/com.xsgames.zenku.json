uscdn.com&oh=00_AfuRWHMvu2SXHEMZPyt2nILCQd-Vd0Zt2Hsx_gM084gTEA&oe=69A44977"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IUubUpSIssQ7kNvwEiFcS1&_nc_oc=Adkv1tASYxnIrlNLGt5i9fOpuH0ixnIbelk0_o2B0OEOwqvnZeyiJfGcSf-56LfKiaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZyo-1aZ-PZsrfT4ixp7YJLEkkL7aMtoVCbLAT-uIduQ&oe=69A41C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIwKQ2ZHQscQ7kNvwGZeMZP&_nc_oc=AdnlI5wkbZNxJwOQiJrmfpXJwf9Sjr6cjW49qziNVunzJp6fP_Svy64iEuJTRHGhdzA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJGfy5cPcrNp0F9O-TgskS7SkAziwY2cTEhD2rNyPUQw&oe=69A417D9"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_pri
XqSJj0Q7kNvwF7PKB7&_nc_oc=AdpoCyUqB28TOCNXgyK4Rvgj7QPZHs4JhEEN3rbtzUKEZ6oCBs59T-lyrqUPUhEf1g0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5343YGNo2J4fyOFAKyVAJvgmK9IVIyH57KF89p8YP2Q&oe=6AD0DF77"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mkOhyOwzA4Q7kNvwFYQFRc&_nc_oc=AdoJp70uwz5FWTj5s-4BG8ehlpLwCERsRzsujbwPZX29VufMGok-KQDd6nnGueTYyJU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN2YpHHviA_uJ5rtiWBLRjKhcaHXKQYk1J0QYmFxruZg&oe=6AD0EAC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRFiUotik3YQ7kNvwH3S_sH&_nc_oc=AdqEaGcKVKvRvohXazOdVOr0Bx1Mmo4UBS_n_4RqMPQUGwIJM6sie66sqLLluQ5eajo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQRFzOOv1GneSkXgTlFknjtqLuWwuzGmH44OqM_j1zNA&oe=6AD0E619"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
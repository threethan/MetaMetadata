NdlYG8Q7kNvwGNUjii&_nc_oc=AdpqcZ-Q2_tEloLXQrm7_yoqdLKQ634ISYIcdAha0aRAGMWSP_5EDZ6P4IqK-hG-HVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUT4r5M3Oez7vd3NNMiYRgmKS5mU6gluD6_OxhZ5KUgQ&oe=6A788AF7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WzGWxBV4iMQ7kNvwHw2DUw&_nc_oc=AdoW1JeiKPlw2THZluCN3oVtn2OZ9jMr-CqCV7kBXKj8ip5FXH7BhiUIkUi7zUdjJMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVEgrqVVMVXWxL1QJ6MaVX-Uc49KJi_8-Rt_7YleCr5g&oe=6A785E06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ox8tplqFj8Q7kNvwG79br0&_nc_oc=Adqivm-_lsBbGzw6xJiYrlKFdMJRXJVzCL05eMvVaIGEyEzKsPZHiEwLYQZyDbVU4mg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ91ApvCw3uQTR3-27G_ffavG7cMAWPVUFTBTNsf_i5w&oe=6A789199"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
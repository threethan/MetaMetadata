Xtn7XAQ7kNvwEvk9Hf&_nc_oc=AdrAFG3ggo83tTNKsokhAUNtJN2_5mWJSoWqoZk2fYKLVU1KyBeg_kqpA2a1wbHefDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr_cal5vaMCccbnZE0-LXGF6b3t5TIi8XhqYp2xTWLng&oe=6A9D74F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2Yxh1UmrBoQ7kNvwEQahDP&_nc_oc=AdrgrtgExibleRJqZSK724931SbtjszEyKYB2P-p4Xo60vU2vk51FiPjcKWnJ_LiHoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4WPK-uwL65k6OGnTsEXXmdVWDSKaa7MfpktbJzoiTTg&oe=6A9D8046"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGx9JdJQTWEQ7kNvwFx26yM&_nc_oc=AdpgdWMXZec-YjyuDYWK6qQyeiU0xB26pFvoXKafa0ZWDvR8sJ7SmEGVB_UIXTmQtzc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8H1GAI5SoYO3eJv-Hct27FJl2QB6Z6BVyq92vRWmy0w&oe=6A9D7B99"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
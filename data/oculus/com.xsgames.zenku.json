uscdn.com&oh=00_Af3lSt_dAuBQCPFymYrBga8v63oH_FSuTp_vIYvQZZfcRw&oe=69F0C077"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8eIItfUbA4Q7kNvwGeuG-p&_nc_oc=Adr2RaTRGChzz1XI0dl9LJ4BOkkpeRrfGHPDPd7fMzunIQ4obADZmMWQvmefRrVsaHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3hv34xwBfT62T2CD41GJvld9UzeQ0QKXgqQD7KdJPoEg&oe=69F0CBC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dXyDqOoUm4Q7kNvwG_AWAe&_nc_oc=Adpb33aPBSwuSoN4kabTxdPF0MtACX4Nh9nvReKNW_4daLigVHUwO8JZRTxnRgpeZXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1_mrOvf-iFBjmp8L_gWFXYhsDte2zyMUz-_NN5dFwkhw&oe=69F0C719"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_pri
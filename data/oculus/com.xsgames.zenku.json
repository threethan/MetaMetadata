y6EJ0cQ7kNvwH3wpSs&_nc_oc=Adpc9QvcEJoVI5KvUDfinJigK6I48UIoKVt9RkbwAamQNlUa_Que6Y0Lv4BAHQ083dc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ86MWmJn1JNZaec8FJo0QIkJz49DKS6GQALi9to87wtQ&oe=6AAD46F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uqp1HFYdkC4Q7kNvwFKDpA2&_nc_oc=Adr-hiieFtpcftRAUhJAz7Qrc4VvolqiBA5LF_pey7LfgOI7ZSIk6p0HNjXmbluEPwQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5e0bmv63qYHliNgRD6zIC-3DHealO2Taem2cj-oWrtg&oe=6AAD5246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16rqWwrnragQ7kNvwFcooEd&_nc_oc=Adrg9ISUZ9kvvUve2EenkGaTaERDm3jddHnVktRKvgv7eKc5Xvkb9SANVavE9DW8HGU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFXX8wJwXaiQW1NHz9QSXNb9Bp0ub4--an0iXsgvZqqA&oe=6AAD4D99"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509212975824255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393450_538663635944352_1017750429346581635_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e4vOc_PxvgQ7kNvwGi5u0S&_nc_oc=AdpF932KlhUUSYTQyzWO4CCmUHmmOofBb9xlQaRap_o3hBUpH9XuPZ-I_lFjDNjPanU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL84O-PU4dXkXWPgcx6KTaDiEn-yAt9vhX6yLqnUWQuw&oe=6AAD5A04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "\u2022 zenku \u2022", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1744091940, "lastRevision": {"nodes": [{"id": "9506280662784153", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en
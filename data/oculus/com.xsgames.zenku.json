KUK1xMQ7kNvwH2MxZA&_nc_oc=AdqcrishjBEnGwQRDLNe2JqGN5OTWEqTHM5xQYFaqoIBoE793TC2Uv_n_w1whtozuls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6PWZAq3AnF4z6uh5NJTfMTTTYGvyZTNR9hZ4KbFDn6A&oe=6AAFE9F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDNzKyXpxxwQ7kNvwEI1T5n&_nc_oc=Adrh-Ij5SYBfN7FvwX7TuxeJF7HUpOmlDvX8hWzvuELEta9eS1o51HuZWA4eGB8N6B4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyNUtqFTL-bWdkl5HZYGYmaQ0XOEVrSatPIsjh5lA15w&oe=6AAFF546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16rqWwrnragQ7kNvwHhmdEh&_nc_oc=AdqywRgJblo38KbTfH6XCR8aNaCRJjh2sevjdiozPb5yIYiTTu7xUyMewbJLiQWTUp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-zKEKsT-VPlQwqJBJlRTS9ccbSAlM6i42BlGz9r4W1Q&oe=6AAFF099"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind out more at xsgames.co\nFollow @xsgames_ on both X and Instagram", "short_description": "Think about Sudoku, but reinvented!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509212975824255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393450_538663635944352_1017750429346581635_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXIeK9ym4SEQ7kNvwGnaj4e&_nc_oc=Adoq3s0Ozhip04F-UkBWYCTqZ9YsEKevZ6hYlm7sArpAO5iWH1IJD_AIU9RQdbX2Sz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIec9udXdt2nAd7T-GEcf8oFyS_K2eGvv3UwZ1ajImsRw&oe=6AAFFD04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "\u2022 zenku \u2022", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1744091940, "lastRevision": {"nodes": [{"id": "9506280662784153", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en
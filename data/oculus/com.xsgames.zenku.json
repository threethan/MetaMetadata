Y7gr-8Q7kNvwEe4rZG&_nc_oc=AdqVxfSB-KfNRiHWlInhG6vD9_qllDNI4BOkbc3ps24amTK2jOjtpYdHADbUlveoOX4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0B-yVXrAroZnz2iW5sU2ngU_AdEyfFEWTy4eeuzdmoqg&oe=69F36377"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8eIItfUbA4Q7kNvwGXxhdB&_nc_oc=AdpArIjht6y63HQTUtiYDuhAArwE_qIJRPGMmcYpehOMbA_a1f5ofcoLNwDpKeo9Fj8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af051S88_b4O-OXkfA9Y38iXRUKJjLZmfHKO4y2EeoljFA&oe=69F36EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVF8-RUEVdoQ7kNvwFnt9Bo&_nc_oc=AdrgJqc61nZEGtSb0St4TInAcZM10xgItcTeT4HYqwS5u7ELc_ddH3FtA-uH681ZmTc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2I3HXD0n_y6cPUHi9arh0mi-98Ifk02138qRprnX7E-w&oe=69F36A19"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
2f57goQ7kNvwHSkusw&_nc_oc=Adpwpb8B1mo9P0ziAHXoFi10SR2ld1jIjrB19NBzmdpu5O_phDqvGo_S_67QQqjRZJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_RdexKr_fI_Uhst_AUN-EnTMnD1rn063iSu8reYpNvg&oe=69DCF9F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc20n1SmuJcQ7kNvwGxkpom&_nc_oc=AdqdEath1qFWZUzFjmMQemZImy6Zf27dueIqYwUJZzmXm6Zv-GKaEqoviqISxsmEjHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DPmT1Uw3jXwow6Yz01FLmTp-OSbjQJrAPy3P11OJhpQ&oe=69DCCD06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkEhrDuKNBYQ7kNvwG60DIT&_nc_oc=AdqhOieEo98QpfevlTLIHyWI6xw8H4m_bgtvKlg63o2jsilwZ63JMvFj2l5DYjT5brI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LqEjWf9g8ipOCkl3PDc7ddvGS2cW5i-31y1Rsvihj8A&oe=69DD0099"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
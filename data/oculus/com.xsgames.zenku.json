KWjYV4Q7kNvwFNjo_U&_nc_oc=Adr66uoVKHKTP3YlAymIhGzVX7AvI9hZJzkdy0jku6TvjBMbAGr8vcoRM4Oqz9h_dyg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF0eE7gL64qQLsBY-oZOMR-pXMdG3-mLvbRf6oYr_Fkg&oe=6A974DF7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNecCg8klvIQ7kNvwF2ffhO&_nc_oc=Adrm1b14hA9AsjLDUDl7Yy8qJJ_1mcnMiWa5uRn2dWv1M6X5trr4gSA7HH9_GIFt9Mk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-zw_B7jSKRaMYVR4JQJOpjgIXuXfkAfwqlrofQnsYSQ&oe=6A972106"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la-W2Qg8pNwQ7kNvwFhKEBK&_nc_oc=AdpoHKh7QTTJXQrKMzCY-Giz5_9MlHfA8N8PlP8kucvoMVMRMpsCWz1581MDbeh_I0g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2dM7fhu83bqLlwH-x_sJn5oU69sHBcMELXxL_m8MmWg&oe=6A971C59"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
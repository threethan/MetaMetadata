YX7GZkQ7kNvwG-wzM8&_nc_oc=Ado1xXyYDQRLuzU3hm2lLOqceYwJffrhdHk6RTcOXk96aDuVk8h5MzYI4uXrxv92x6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W0-RipoGam9nzAhorW8Njv-hezEjVOr64VvcZEnGcrA&oe=6A2EB6F7"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCTu45imPXgQ7kNvwE9qEov&_nc_oc=Adp1AVAwbY6_moWj1YRvUrqvfo7YikuvRjUyJy_JTF-O715Q-8lbJwyOXO8_8WZo72U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oHqcqN9O2AI1ajtDWgKRMcarCo6Iw85VGKOhtuvbieA&oe=6A2EC246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2sQZkpSsTAQ7kNvwExBKVC&_nc_oc=Adr1C7CvU5oW4g0nPcb9y7F1fZzayay9-apJg7xHPAizFLi2VihietwGUoiuo-wVe9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SX-rH2_XO2xvfUAfOm8_xgvFZdZtSjaXv8lLH6jRcpw&oe=6A2EBD99"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
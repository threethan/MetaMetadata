twbyAAQ7kNvwHYX0O-&_nc_oc=AdorGcn1Uwd5Ragq2nIANXb44EpZILGhQ3djbo36rAEYF3dTA2zTfaP59uIBSab-ZGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B-RVtQDTUE25CP-EbzAsax3L8NZ5DvV-gazRlm_iyGQ&oe=6A1D9377"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqbrLVJHa5EQ7kNvwE9T07e&_nc_oc=AdrY6gqyWIYiJvz7ggN_f8fIjzQKR7qxUs6TCITVQJav4BqMCZZahi5FGuA2iITgJI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PFvrChRtEnfZYvuOr9Rk_aloaIuIj8dHfR3d7aA_w4w&oe=6A1D9EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcFO0Dy6p4AQ7kNvwFGx43K&_nc_oc=Adpm3sFwddK4tO_dW0WiODCjM1cIFzDYG2FvBnXYhdwrQhu4xnucr3Ti1lIrZbMT_ss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y9-9AMRyzlFROl1z1xO0RMGhBUjiQm0xZ2YtcU7Z0lQ&oe=6A1D9A19"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
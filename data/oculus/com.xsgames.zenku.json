YwrK70Q7kNvwHUQl3z&_nc_oc=AdoJAQEdtIp42w3MJAdmgWYF6mIXI2FtoK4P6ENPe-vW5foaMzVfbm5hPGp-2mUPK2Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi-SsR7tGMdsZbnMcc5l-XwlISxmKtzwvmdoKga0DJpA&oe=6A5A3877"}, {"file_name": "5.png", "id": "590166807376433", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391911_590166810709766_5629653025297182557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwPZ91b_UA0Q7kNvwFz2OjD&_nc_oc=AdpnpHGyvcXKztpVi7Ddqxm1_ObwY7N7aZzsQRDDBwAPx2i8HEaBk2KslZZj8yEz8og&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClG--_YQZQBGUf-jKjJwBtRhqXVnJwqin14isSMYQzpQ&oe=6A5A43C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1078415194326976", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393516_1078415197660309_3132482703711866866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5zZosm4HhYQ7kNvwHriE3P&_nc_oc=Adowf7YlO8Xw6wltu3HxMQyDU4VWp-NAuFLsXXY_CmmWN_3ElWJRbaRlS7dy6PpLLZo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUSiBJphapWYk-DpATmw2f5LodlBN3iMaAWGVitcR0fQ&oe=6A5A3F19"}, "display_name": "\u2022 zenku \u2022", "keywords": ["math", "sudoku", "puzzle", "test", "iq"], "long_description": "# Think about Sudoku, but reinvented!\n\nThis game has just a few simple rules:\n\nYou have to fill a 4x5 grid with numbers from 1 to 5, ensuring that each row and column won't have duplicates and that the sum of each row\u2019s numbers gives the result on their right side.\nAlso, you must insert all five numbers (1,2,3,4,5) into the two colored sections on the grid.\n\nEach puzzle has a unique solution. It's relaxing, but still pretty challenging.\n\nIf you want to spice up the challenge, play \u2022 zenku \u2022 in YinYang mode and complete the puzzles within 2 minutes!\n\n**Will you complete all 100 zenku puzzles?**\n\n=======================================\n\nFrank Eno (aka XSGames) is an indie game dev from Italy.\nFind
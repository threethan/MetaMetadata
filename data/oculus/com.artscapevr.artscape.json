873513363250_978793827920538583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzP8eBrJ98cQ7kNvwHxCcT2&_nc_oc=AdoOdU9TJvngm5Y_3NNY8qfl3dckX1NxE77cWx9cofo0spELIEpKf0bf6bNslZ9zxi0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkJYvUgH7mJnYc2rJK7hKkE2-3-zKoeYw3r6dj6OTRKQ&oe=6A8EE662"}, {"file_name": "vlcsnap-2023-06-29-17h35m30s541.png", "id": "787079609524793", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982441_787079612858126_1242194759276772029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxsP5kCXZsEQ7kNvwFuuws5&_nc_oc=AdroNbRjaUthZRvb5_bK0dxDMkAY3gUEF7aDaZSCSI2o3QkLjQ9nwIQFsL9jW8WKLAc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr2iyRt22cW-o1W1lFUjzV3moLbBCIv7QSaKlNb1lkyw&oe=6A8EDA8A"}, {"file_name": "vlcsnap-2023-06-29-17h35m48s582.png", "id": "1664042574111023", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57572917_1664042577444356_7819910253581057034_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2YN31DTyd8Q7kNvwGGLjRY&_nc_oc=Adp29p9G2ZDk0fuxCd_1AnXqze1HnSu3kKOw8WodjouVUhU7vDnovVwWjJYF3x3cjOk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG_RknGA_mb2H2JDOx1aKTH3B6V4oBUZZDj0s1U2osqw&oe=6A8EE04F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArtScape VR", "keywords": [], "long_description": "With ArtScape VR we are taking you on a mesmerizing journey through a 3D virtual showroom where the boundaries of imagination are continuously challenged and redefined by AI content produced by human prompts around the world, for example with Midjourney AI or Stable Diffusion!\n\nRoam our virtual showroom, admire works from surreal landscapes to abstract wonders, and witness the unfolding of a new era in creativity. With ArtScape VR, you don't just observe the future of art, you live it.\n\nEach day, our application brings to life a new collection of the finest AI-generated art pieces. Come back often to enjoy new art!", "short_description
izing journey through a 3D virtual showroom where the boundaries of imagination are continuously challenged and redefined by AI content produced by human prompts around the world, for example with Midjourney AI or Stable Diffusion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artscape-vr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Christian Salvaneschi", "support_website_url": null, "website_url": "https://artscape-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "286532017083024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982563_1244703009520724_3150251953872870262_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMmskB27kO4Q7kNvwEytonY&_nc_oc=AdkRGws9uyhyIX9gSQjKj5Jd85M4ovvS7Id4sOHVSMMZi6E7hep77BAqrgZPH_QFzz0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzglFv7R72cKbMr6PZ1bnwE-xQe1s3dHTBc9xpdrjwitg&oe=69AADDF9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ArtScape VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1687898424, "lastRevision": {"nodes": [{"id": "6201390023311046", "release_type": "SCHEDULED", 
63250_978793827920538583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm7MxqGOC3UQ7kNvwFhj7NF&_nc_oc=AdoVbJ5lHmBmB_hvRoJ3JTkRi11iwKkNWQJhDQcOTTDwKSURlCQHa4xIAoaNyP8jNCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DP5Fwpp366XZCNnNso6yjDFrVvg8-yrmh7JLXYjt9iw&oe=6A256E62"}, {"file_name": "vlcsnap-2023-06-29-17h35m30s541.png", "id": "787079609524793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982441_787079612858126_1242194759276772029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJexcS3CZNQQ7kNvwEgp7gP&_nc_oc=Adpmuu27VELJ5Rz_spMpkGeiP1gH23okuGgJZt1BHtvLzC3lmw1ORi13rEovO1UQ3pk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jr6u46o8mHLY5E4-UrL77-x4SMVl4k2pgpsDdZDs8nQ&oe=6A259ACA"}, {"file_name": "vlcsnap-2023-06-29-17h35m48s582.png", "id": "1664042574111023", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572917_1664042577444356_7819910253581057034_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt7pS_1UiPUQ7kNvwF7LZwG&_nc_oc=AdoBJHS2zP1CmMk2PXZggc83E110Ze941Q8MPRu8Fj9zvIEc1LobA25o4oiTYOfVjKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RkH6GAY5WP-wHvaf7DCGkAFARWLG3P0iW6KZWqjZrmw&oe=6A25A08F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArtScape VR", "keywords": [], "long_description": "With ArtScape VR we are taking you on a mesmerizing journey through a 3D virtual showroom where the boundaries of imagination are continuously challenged and redefined by AI content produced by human prompts around the world, for example with Midjourney AI or Stable Diffusion!\n\nRoam our virtual showroom, admire works from surreal landscapes to abstract wonders, and witness the unfolding of a new era in creativity. With ArtScape VR, you don't just observe the future of art, you live it.\n\nEach day, our application brings to life a new collection of the finest AI-generated art pieces. Come back often to enjoy new art!", "short_description": "With A
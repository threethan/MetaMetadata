JnVwQ&oe=69B56217"}, "display_name": "Wire Magneitc Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "physics", "magnetic", "science", "contentsda"], "long_description": "1. move the compass to the coil plate\n2. Connect the power supply to the coil plate.\n3. attach the coil where the hologram appears\n4. Observe the compass needle centered on the coil.\n<Result\nExperiment with the magnetic field around a straight, circular solenoid to understand the direction of the magnetic field as a function of the direction of the current.", "short_description": "Transform a simple wire into a magnet. Discover the principles of electromagnetism by creating a magnetic field through electric current, an exciting glimpse into magnetic phenomena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27410179508596753"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031482_1091344638549549_2439930595587432076_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&
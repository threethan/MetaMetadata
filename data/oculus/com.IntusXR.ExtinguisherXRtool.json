8d8Yj9yy7fIQ7kNvwF1NlFT&_nc_oc=Ado6v1q_TeYIvt87XxYQ8sNuOClK8n9HXoSp0qMo34NHfc2-OWqcoyczV73JtHihGaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDU-_Lemm7UsZsSxMvPeGGHpLUfdv7CtdBHGZ7POYoLA&oe=6A6367BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extinguisher XRtool", "keywords": ["Extinguisher", "fire", "training", "burning"], "long_description": "Extinguisher XRtool is an extended reality tool that lets you build your own custom fire control environment, choosing the ignition points you want, right inside your personal space and across any other rooms you've scanned with Meta Quest. But more than that, it serves as a complementary training solution for any organization or workplace looking to effectively prepare their employees for fire emergencies. With Extinguisher XRtool, workers don't just learn theory, they practice hands-on fire control, from locating potential hazards to properly using an extinguisher in real time, all within their actual physical environment. Whether it's an office, a warehouse, a school, or any other area, this tool transforms any scanned space into an immersive fire safety simulator, helping teams build confidence and muscle memory before an emergency ever happens.", "short_description": "Extinguisher XRtool is an extended reality tool where you build your own custom fire training environment, choosing the ignition points you want, right inside your personal space and across any other rooms you've scanned with Meta Quest. Learn to locate, control, and extinguish fires dynamically in your real-world surroundings"}]}, "developer_name": null, "developer_privacy_policy_url": "https://intusxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "IntusXR", "support_website_url": null, "website_url": "https://intusxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_categ
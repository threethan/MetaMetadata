yees for fire emergencies. With Extinguisher XRtool, workers don't just learn theory, they practice hands-on fire control, from locating potential hazards to properly using an extinguisher in real time, all within their actual physical environment. Whether it's an office, a warehouse, a school, or any other area, this tool transforms any scanned space into an immersive fire safety simulator, helping teams build confidence and muscle memory before an emergency ever happens.", "short_description": "Extinguisher XRtool is an extended reality tool where you build your own custom fire training environment, choosing the ignition points you want, right inside your personal space and across any other rooms you've scanned with Meta Quest. Learn to locate, control, and extinguish fires dynamically in your real-world surroundings"}]}, "developer_name": null, "developer_privacy_policy_url": "https://intusxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "IntusXR", "support_website_url": null, "website_url": "https://intusxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35008314452149557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_2013045266087662_1727112732860720425_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc
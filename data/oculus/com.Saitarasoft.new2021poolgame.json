23565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUNH0Pz04HIQ7kNvwGOBLXL&_nc_oc=AdluPt7ySPUrmTPixK-7bbhCzE0HNht6zFTpK5TnYU1IftdsZj72awdrKTfClxtgKII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvs5CW1ZYEhy_ZC6r9ClrgwnhF-CH49EER9XIkeGG6tpg&oe=699B08AB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At6qzqvYgRkQ7kNvwHrtvYZ&_nc_oc=AdmfLhdsHZivITDsEC-UJZqj8C9chMT6t5MGtZ-ONBPPnR35YNiLrerTdRNofM-qTd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftovTBTpoKtUMX78XaMeeXO5GkY2pwRpHcCerwbWT502w&oe=699AF0C3"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uEcxyTzeJkQ7kNvwGUvO7X&_nc_oc=AdmHCYL4CIDCmL9fV1z95HHqysAN98y3SePr4YLRDNMm4Rs_wO4wVfJFMEDAiSamtgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft8W1AMy3Ovj2vzfoOGyDl87Ef77ya3aPOBL4pyB5aJsw&oe=699AFBA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSMdHXlNuHQQ7kNvwHwcrEy&_nc_oc=AdlMauSkskwyQAGwy8xFNPOD5kkhY0qrNYOy9hkStr-dJkZTItHs5R6kbVKDkSyvOhM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft1SDiGd8X6sGyohBGHkvVs2DsMWaceMYeLoqdkNy3lKA&oe=699B0E15"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mod
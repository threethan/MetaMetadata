tps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj0ZbzRoJTsQ7kNvwHvbZu5&_nc_oc=AdqjeE2bcQd8ggeIPNOsnlB2syRiR0VOTycWV06cj-7Ka28MX0HAd660qNNKjqeK59w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBPHj2y310IW9THo7KMQDIriP5kINYojpQKJ-0RsmZhA&oe=6B105ED5"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool and snooker game, Cueist 2 gives a relaxing environment to play pool and snooker against your friends or AI opponents of increasing skill. A natural cueing action provides realistic spin, jump and swerve shots. 9 Ball, 8 Ball, UK 8 Ball, and Snooker games are included as well as a choice of cues and a customizable table. \n\nOnline play against your friends requires an internet connection.\nVoice chat between players requires permission to use the device's microphone.", "short_description": "The sequel to the popular Cueist pool and snooker game, Cueist 2 gives a relaxing environment to play pool and snooker against your friends or AI opponents of increasing skill. A natural cueing action provides realistic spin, jump and swerve shots. 9 Ball, 8 Ball, UK 8 Ball, and Snooker games are included as well as a choice of cues and a customizable table. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "303736565051100"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7422605814476487", "version": "1.17"}, "id": "684780659564038", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7050023918401347", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7422605814476487"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "684780659564038"}]}, "change_log": "- You can now choose between 8 types of table physics; some serious, some silly\n- Adjusted the CPU difficulty curve to help beginners\n- Various minor bugfixes", "created_date": 1649430801, "id": "7422605814476487", "version": "1.17", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7050023918401347", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7422605814476487"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1649424928, "id": "7422238051179930", "version": "1.15", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7050023918401347", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7422605814476487"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "684780659564038"}]}, "change_log": "The latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can now choose to hold the Y button on the left controller to enable Autoplay. Release the Y button to play the shot with the desired power (for those who are unable to use the standard cueing action effectively)\n - Now defaults to use the Novice Cue with minimal spin, to give beginners better shot accuracy.", "created_date": 1648679461, "id": "7383773305026405", "version": "1.09", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7050023918401347", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7422605814476487"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "684780659564038"}]}, "change_log": "The latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up and the laser pointer showing, you can now choose to hold the Y button on the left controller to enable Autoplay. Release the Y button to play the shot with the desired power (for those who are unable to use the standard cueing action effectively)\n - Now defaults to use the Novice Cue with minimal spin, to give beginners better shot accuracy.", "created_date": 1648602519, "id": "7379863325417403", "version": "1.08", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7050023918401347", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7422605814476487"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "684780659564038"}]}, "change_log": "- Enabled users to hit any ball at any time, not just when it's their turn. This will cause a foul of course, so be careful!\n- Automatically starts a new match with the same settings after a match is won.", "created_date": 1647348977, "id": "7316588028411600", "version": "1.02", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
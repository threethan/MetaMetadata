sGoQ7kNvwH7DUf-&_nc_oc=Adoonk05NANdUAhx05Skc4sW6dGXwg_9PuD9qaRZGe22OGObG7ioopSwCW0oLAnzEtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzSCgjcZguHtis3Gzwr2Shrse6U2Pzwn_k4sBih1rDDA&oe=6B105A88"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKNzOk5_n0IQ7kNvwFlaSXt&_nc_oc=AdpY8IeTzT0fjK0YQYP1x4ipFwe4yO8TiU590Gq2pad8l1UlA-8SpD7JGLsjr_RN9D4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtAdk8Kdr7p-kCEVIAvgmWVp5ptiy0lXSE7losSEaKwg&oe=6B10596B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEbLyg1SZ64Q7kNvwFoRVCa&_nc_oc=AdrxZVyOY7yvnkNMsrqidkaSZVuppPzRaAt7ZDaGJvDRS6kKs8g4knyndOdxVi2CMEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVvhmBigZlmpHmOfgnAAJfZ8422KdGmUinSzzzV3v5MZA&oe=6B104183"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj0EKr_pBdwQ7kNvwH3HsCm&_nc_oc=Adry6Ps-S4wUWWXsIyvSWIviJIwgDOHEnKktIw0jS-e40nLN0qWmp4lOK5J_yGD-qMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdm9UqRMl7dnjAsVHl1wM82q38RSVa4yaCurU6Hy1EUA&oe=6B104C63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj0ZbzRoJTsQ7kNvwHvbZu5&_nc_oc=AdqjeE2bcQd8ggeIPNOsnlB2syRiR0VOTycWV06cj-7Ka28MX0HAd660qNNKjqeK59w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBPHj2y310IW9THo7KMQDIriP5kINYojpQKJ-0RsmZhA&oe=6B105ED5"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
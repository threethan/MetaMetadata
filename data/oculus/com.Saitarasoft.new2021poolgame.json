23565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N60U90cBjz4Q7kNvwHBdbaf&_nc_oc=AdkICTuTBQvqV8AIgeEU6zSfxtnGhjv3ayozasDj87zYcXpfQrGI_vknHIC8ifZekEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswCG-HrH-yXPuUScHwT0nw3gy7P-AiGICG6jRR1F0gcg&oe=6999B72B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At6qzqvYgRkQ7kNvwGQ62a7&_nc_oc=AdmuCQryq9Fzoxb_3W1NIeDygJ9RTYd9XG9SOw79lKYv3xedumvBubjt9IHe3WIdSXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTZJpWTeWZmL0C8pnFoBB93B32OtoztCnVufAqgNrpyQ&oe=69999F43"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uEcxyTzeJkQ7kNvwFtcxaE&_nc_oc=AdlH5gniMEfSNvEnjceGMdtuUHP_5_tejSaXWqfKYc8KiH6XMtf3ecBypVOFBCD8blw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuxGmHdsqP7xI3X7wH49hkQB_cP7aPfSjAdvXNbJ3C1YA&oe=6999AA23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mixOJuk8nRoQ7kNvwEyHdnl&_nc_oc=Adk3RW-bibuV4mpbNdcpOuP8ENP10QwRhiidG6lxMjhFrE_4bPO7e4AwSa1Q9ZHELGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvsgWRhIg4IbSEaDMcbYNJQnfaGkAthzwPS6z9SLn5jbQ&oe=6999BC95"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mod
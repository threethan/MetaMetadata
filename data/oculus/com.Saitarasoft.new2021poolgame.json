kE8Q7kNvwEm1or7&_nc_oc=AdpHQQhsU4tiB9i8gVWV8O0w9TwmjuiJ6P9RIwi87KsBlZfAU-SFfGinWLTTnlAiapM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjGDT_JgGZSqFtoYCbS15uW_QrU3JeqZDYJqfBpAnWEQ&oe=6B01DA08"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDKQhQl9ZVwQ7kNvwFmwfNo&_nc_oc=Adq00ihPb16Ykrv8yY5blxzthrPtaE8YGDsmSH76RhuoS4jBhzYz80c3U54Rk5VGnmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRonpFS1u2SDhgoLtz4UqNPYpEOwsD_WiK-xah7oSulw&oe=6B01D8EB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_qj9jpk24UQ7kNvwGaQGzb&_nc_oc=AdpgE4aG5-XMjV2OihPoq7-_5nYF1Z4PiL5LbUaMvPEJ29mfujj_x5iCyIpDy-DeWzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWAS5lcjrZONa8vczPSR3UaVaNrCiOWazP-9LHSIneYg&oe=6B01C103"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrFJ9IXQCE4Q7kNvwEgChtj&_nc_oc=AdqpCpXIbvX6shJHtuu7J3kz6nyt4MDKSDZ2QbtQyKeFGbP81XgHiObsKdwXlR-i6lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVtO5CJnYOOlc6JH8B0s_HGCVo4bl1pxaO-VscYo6rpA&oe=6B01CBE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5V7q193XZcQ7kNvwFmlrD1&_nc_oc=AdoLPU7qUW_pLomn5N_rCg6dwXFh_pNFvCNxSfkdjgklCqLqOsPiuBTpbS0ou_Z9Fkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzMjAqwXI0kUmXpW5vZugNIG-2o1bh01lDc2-6wmXI3A&oe=6B01DE55"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
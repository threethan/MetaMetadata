9912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG8qwgDNkeUQ7kNvwFRi0nC&_nc_oc=Adl-CVXDlynqIoq0l-4MiZGElEscPdMKIWu2OWI1ks8JDNeiACJe4pSVY8_6bXizpxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft67WKAWoKjMuHQKsYZN6g4XOKW8mqbfzO8nDTLISbROQ&oe=69A9892B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpRNqWx49FEQ7kNvwHjLlkU&_nc_oc=AdkTGgx5li97qVGBFh1QgGw3X6K-LKakkf738doQ6rZtqjJVQStGV5mmO0tqHy4u6vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuH7PRY9IvGO80XyEjeclReXoiB5oHFfdCD4p0KRo-kbQ&oe=69A97143"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meEikHJN-W0Q7kNvwGTM2ku&_nc_oc=AdmtoSJPlgBD8AI4DUNtEqr4anYfgbHKCJzdNOA9FIxJ0iVxx3tb962TR49_ala215E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftGR2d8XH9URrDKJk0z45dgrizqsY84407KT-CB9wRYBg&oe=69A97C23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zIoc4QHtbsQ7kNvwHKXUXk&_nc_oc=AdlQzPYXWCi0Q2TzC9QlGZx7RaRltpPvtGdLAAnFG14qE_o-dFJN-xESfHEuQLRwThA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvXqT4ALriphAiw4gHFeTy9MRFGW-oAKGdYpfIEddJaDQ&oe=69A98E95"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
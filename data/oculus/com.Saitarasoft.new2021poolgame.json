9912", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkgzpxQcKIkQ7kNvwFsjRRw&_nc_oc=AdnVEg8__eBIPaeyGBZbRA8edLodGRHzoG5QN4IIDVyPmb2phAyueewd4UjviEfWfRk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzn3FC24X78KFj6i26PUirT6V1Q8tDsWlSdg0Jgf7hWFQ&oe=69B4152B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWWxFgBBlr0Q7kNvwE8quk1&_nc_oc=AdnN3vhXXB2symzsTNNocyUjaQ73QOlR73znDDAynubDZ09XrnZ8a3x09Azr3_tzPl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7S9YDQEmxETXwciBs-OsIu-XFpkbdpsPI9_S6veWp2w&oe=69B3FD43"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebyKO3t_bhQQ7kNvwFBPvJt&_nc_oc=AdklC2CvDpMO_d_j3HotYxH1tHag6djGNNErYkadcE94I-LUaPoh2PvCnTHepqPDfr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxm-YYD_PHT1vvAmVPNHFsCjvt9wr_S9q3hEYtNLzYt4g&oe=69B40823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16Pq83DmvJUQ7kNvwGc7TLZ&_nc_oc=AdnzBi3Cc2ano6NuyKd-XnVtgco1oMEfk6ZPYBt2tXr-tAGBohGKNP2N4MgTTcOTTe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeSWhNuX8_yNLhyUXeIJYIhF7jaf8wKFEvjIzN8XWXnw&oe=69B41A95"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiVEOVDuPd8Q7kNvwHinEup&_nc_oc=AdqJu4xupngzsE_aDX7lRloE0WKHJ-5bijWjh1O7C1Ph0AALkYqnTSrebrEWObcuMx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fGX8rAoZCkQWQ2lCnlfDpVPqkNB-8WxoEMGkGI_6Wbw&oe=6A37EB2B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnxriYQWT1oQ7kNvwHfhCdX&_nc_oc=AdorQw_pBBXE6Or2ssamLNy_D4MFpw-X_uxlwnGFuOUEXPEPV5q19SF-UUgJfso4ios&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WuoUsMKjsTxWJTVkAiNrVzzG1bOg4DMzkp7k5LuLx-A&oe=6A380B83"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdVHS1k0Ia8Q7kNvwEAKwwU&_nc_oc=AdqopwiQEM_wDKV1Ju4TNrI6sxsyPRILprU4izraCQ94R5Ls0Nsu1o78zezt2esOI_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tYTlnLn-VZnd-lsTeDV0R3oNx3QNI2ORPowmrjG0cKw&oe=6A37DE23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brKU3gD_VHUQ7kNvwGcl_en&_nc_oc=Ado55t_cExyHO3l2deoZ1Cdv3HHXdvwxtq8d_70n7TNLRkyot4Mb04NxjdBMP1QkkBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96d3QKKbejy1nC5XnJTFZiPzlsVMxGNA2N5I9WX8puIg&oe=6A37F095"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
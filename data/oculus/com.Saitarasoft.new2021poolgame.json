5tgQ7kNvwHVQvzT&_nc_oc=AdobDPZR5UsCcmznUSTMjhGF1mna0L4Ae-C36hhPKc5K0nkhw9hgy7BXZpSi34vB7Tw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScFEw8GrnBV5Wn2nfBQhi7cb4X4rKpZ4LCcPgEctZjsQ&oe=6AFB4288"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv5RaSZ4VjcQ7kNvwFn_gpJ&_nc_oc=AdoYsP9Bfng9_FNkrhbW023BiDOi4Kwr8PZPw7AX3Ew12PWfG0ZGMcszRWdDLEX3_d4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG4G7-jIebbQrRIYfKaJNUpfpBzXLr0g4WSpPDotrOmg&oe=6AFB416B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eeocl9hvZoQ7kNvwHXEIvL&_nc_oc=Adr4D4jIzZ9POcJPPK4i_xcFS_KSKA9LQnDTm23RDUwidRxzejQ1VX5KaiYD5YT4Hc0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE5uGuxrdD-IytlQPcO9ZLPdcT7fyilup3FHZk4Ftssw&oe=6AFB2983"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIlsGfcNzS0Q7kNvwG5VJhH&_nc_oc=AdryIatqCH0JVIag5xF10ZFz7rZthGtSFMVp7gHD8fn1wjW71JLlOuFXNLNWBJEgkRo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPzItMBoVockT9gfQheNWSMdQTJXNPnkGoezmhPxMMnQ&oe=6AFB3463"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5XJ3u2hz6cQ7kNvwFsoCUF&_nc_oc=Adq3EaIOAKDa0Q0JK4lfj1sOEgTSDuJiG_ac9P21QjfIzkQgn83es6SOcsU_ugRE6yk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTumrsHzIF_4RG2qrY4YZvQ1y3Tgwao-ejiEez3eVkqTQ&oe=6AFB46D5"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
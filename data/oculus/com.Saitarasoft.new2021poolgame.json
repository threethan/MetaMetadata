c1sQ7kNvwESpWgs&_nc_oc=AdoxeYpwhmgHYVhbmJmhyXtxt--vXG9g8-UZGfJkmLvLgXI42QaG47npkyp5FqAYGOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRfZ6Ndh5ZqIb54AqlhsiVnPtLkzE9gzX0oG9kRVZr7Q&oe=6B09C308"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYZA577PiIIQ7kNvwG1QhZ3&_nc_oc=Ado6C7xSPgo8kg6Cfy6w9TmIkV2oqIYf-H2eCl8-dsj-EUE7RRHNuageFh_RYRnW5H4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSIK2rZxyMsdn8CDcj4KtI145aZpSiMs7W59UCOeB5fw&oe=6B09C1EB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W1tZLPEROQQ7kNvwEFww67&_nc_oc=Ado5H9qisgy8nNOFaVT6_vYkHTiqJXrfDkm-41iCHc6xWGyhgBZU-Bx_WiXxNAvDV8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIE_FY_JZL-RiWPY22I17idtM8D_o0pdT7SQ6NRiyAgA&oe=6B09AA03"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecKq2cAIgEoQ7kNvwGmgT8x&_nc_oc=Ado437mWfy7V-VIRaq3KFg1USp_UWq0E3tipLplaDTS4Sg25n0ALMqUlbI9QC__ol9U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFZvZvDTekJ_VgL3M4zOYVxEPJulaOX4hKueT9AZvmCg&oe=6B09B4E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwiCM4jbrO4Q7kNvwFHPwnb&_nc_oc=AdqEFnXb9sTREwj9KwxhB5UupUcSPkm15wr0sbpGB8iy_70sdwXqcNfzbGaoMt6GykI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAnB-JNwduSV9RcqRmdeH1Ogy_fuK4Cppk82mEYQabLA&oe=6B09C755"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
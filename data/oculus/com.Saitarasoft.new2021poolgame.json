creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veuZc9HjryAQ7kNvwG0no44&_nc_oc=Adrx7WUUFfPefJ-U1ZLlTgmOqgaQ_irehzmOH-qDryARyqrgIThH_PV2r57zNlq1f2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCAHE34XMb2NKwvB8rZoE3zgdxcRnJ6r46SOnK2tMn-w&oe=6A539AAB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFAZnae13hsQ7kNvwHs5AWL&_nc_oc=AdoLLdRpXw8j8XfuX3I7T-RDLNY67jPqRQiqzlVuBZMOO5UBsu00pQB-U3nc_oInU18&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg4bTAU1hJ5wMN7oR_cNS-Tz84vAQRlF9kv3Q2kduepQ&oe=6A5382C3"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3yKK2CQDPkQ7kNvwGmFHd-&_nc_oc=AdrzCFVMddu0fR1ujLOFkv3jaZzPO6sctgP4kJsgo7SWuIJxkuW_fCag-1u7XqUjwrQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAf_wnt2BkQvnM004CTGIT9ZVoy_n7_tEocAOX3p6V1A&oe=6A538DA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoBg6eeDo5MQ7kNvwH-LdNn&_nc_oc=AdrJ4O449urOFQvUUU3ynWhCJaiiSm8dpLYW3aG4slmwad9VC9wH_ZIIrFilsODPF94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2JHdfI8jQlqNFL_ELhhN3x0cdo6wRDEaSwluU4xe7qw&oe=6A53A015"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
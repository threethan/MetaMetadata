kE8Q7kNvwFqd_NF&_nc_oc=AdoJXqhSk-5hj_T2TE-LM2HHXd3cRSO8btqMDXOXd_iDzD9dkZIKWiHw-Ci0_LSvIEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV8UmS_-YMHaOyid1ab7S7FJ2UNTPSBw5r-Ij67zEICg&oe=6B008888"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDKQhQl9ZVwQ7kNvwFpRNtg&_nc_oc=AdqUwPPFClEIaHukUvnFeTsS0VpVgGBfhUUrLa4DYOOYS72Hw_ple8jMqRqAbelm3lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf-gw76kZpLo6IGTOAJgjlSATR0dqWzz2XZHU3BpVSVw&oe=6B00876B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_qj9jpk24UQ7kNvwEEiK6g&_nc_oc=AdpYTHmYR1V065k_bbyZ8dg3FtB7tHo1hyIG1fbI0jo2iaMsrZcoWRCJm2rU3eyZ3cs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1LWQVxc8ljfosgqgmaZ4rjz3IVYsB3ZKqq9Vh3Hp10g&oe=6B006F83"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrFJ9IXQCE4Q7kNvwFYIX4G&_nc_oc=AdryO8AOqnsHae6QtLiCI4ZiPpk2XDONBEUSTd9dRJvaV5LCleRQkJTNRt0d-IT_n-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYOX-2477Q1XFUYM4vxksDn_ioSZ9j_TCeOpOlQp_j7g&oe=6B007A63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5V7q193XZcQ7kNvwFmeFwd&_nc_oc=AdoHav1kfq4-pywc-JKdcLuYpG498itgDedGZUTeKAgfrmPvRzEvy42PsvNXcKIvv6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGh40fHQnojQ4M2LZYJZm5XH5KRAwL20Jn-Kk831LJGQ&oe=6B005495"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
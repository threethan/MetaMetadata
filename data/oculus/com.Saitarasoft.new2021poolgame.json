pIoQ7kNvwF2JcrK&_nc_oc=Adq5ula9rjjE0KVDTwO7X3C4kCkFtnlZ07wGmhSDIPmw2r9hXBBbCTiJNadLhrNA3p4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSIcQRZgYeJXEXX6CEsOyMpGjNWeAStCsuNZZPKO2XEQ&oe=6B0DB788"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smN5tY4jTOoQ7kNvwF0N96x&_nc_oc=AdrW5XxXZP29pTkhylgEUu7w4ZhdtevBQ3fkbvlfnYh_Ly96mLs5nMU600exhDZ7ZKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTI0l0UvZYG7s8o0dBQ-srPqrOcl4azYZxzI9Ndh15INg&oe=6B0DB66B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr5Tomv9ED8Q7kNvwF_cpsU&_nc_oc=AdrWjJzmDYuJwqdboCHS_Q5vpApQayYGkE8ghle_XYZRNS8w_1A-QMuuYZAPPKAmop4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTN7lAJRqcGmBvuwqbfWSxmZ6bMctlijd3G4G8Mv4_BtA&oe=6B0D9E83"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9eJRfPTqTUQ7kNvwEnMR-Q&_nc_oc=AdoPoeSID7ebjTAFug_cSGwizyLracCSEUvQUEjbiJdyWeuIcWiwpg4b7H4P-sKK_KM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_GjR6FcLaqcdwE0DkR83mtHpj9VPKw5dVWsVMpisQvw&oe=6B0DA963"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwujTPfjR9IQ7kNvwHruqMl&_nc_oc=AdqyrnywuKf5TK91xQIxavFVTPOd_8bPo4_OSmXKaztXWRyycvW_qWB5jB7-oFRR1W8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToFt1nfmGZE8RMxARWJdskxM7KYGR_HqrrPRGlYEH6ng&oe=6B0DBBD5"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
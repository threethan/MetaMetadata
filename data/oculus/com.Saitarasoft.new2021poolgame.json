9912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG8qwgDNkeUQ7kNvwEO_1Y8&_nc_oc=Adneo7LlZ0ywvpNI6LANyhDsxuN_9SwQ0uIIi1xPPPQP6aV07eyACytHFtwBa5PKmP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afte0Xqud_8rct1E8lHeIrmREO0mbZpnfYixJP1RrcoQLQ&oe=69A837AB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpRNqWx49FEQ7kNvwHpMVCX&_nc_oc=Adl0KJv4R465dKUHhxGJvwtpHnB8Xyqdl13eNSIRq0W8aGPZNXxhX1iQv0suITZpNMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvgXjX6pei8FyO-pwr-_BOuk702fDpdRr8pQ_l0HVnX-w&oe=69A81FC3"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meEikHJN-W0Q7kNvwEDZwJX&_nc_oc=AdlUfkPz5hhlhVlUgPBdfnNoreKlozoh0y0pV06-5nNN56X52_X9AJ4fdT8Pt9k5hO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv38yABF7EeAe8A8jh2TmWKvk5kVQOnEJGAnyOhCHR1ow&oe=69A82AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zIoc4QHtbsQ7kNvwG9x-L6&_nc_oc=AdmWcmpmtN_4Q0ObFPuFhRyYzoAHbwyzxoSpc9f8fDOWdN2hREdAS65pM7fxrHd8OdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftcvzfyp2uzuLcqFXtY2fXulU4a7Uehsy_NdIQl1xg2Rw&oe=69A83D15"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
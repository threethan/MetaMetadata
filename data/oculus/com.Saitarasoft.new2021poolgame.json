oTcQ7kNvwEcDYuz&_nc_oc=AdpfKPUjIKE6zs-mmI_F7yRYyEhOz8Eu7ADfbW7aaGzum_y3iukhySDs4jslAMMNL0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuFeNR-nYOxiHy5inw7oN7J098FptsmcVuwMzKDlecVw&oe=6B032B88"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIxdapLNFFMQ7kNvwHqSNZo&_nc_oc=AdrJxIML8NSPu-tiqyim2SeQ-2y-M-s46V68blJn-3SdM3dxAkH0ETXUMUYXY6R7v-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmPSXIMWJ8NjvzzOK9MZS44LwD4IG_T93R-76JHsCHDQ&oe=6B032A6B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_qj9jpk24UQ7kNvwEIg99U&_nc_oc=Adp2uq-X_jTdw5HsaB0E3zxQ6zhiTFKuUYlW4B-ReK4SOBq6SgvUoYrh1cC0dahrH4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP0gGbNrEyYlxBGPGyESU7khQxlg3izlaB8FP0PeOTwg&oe=6B031283"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrFJ9IXQCE4Q7kNvwElysLK&_nc_oc=AdowacVqhXgwEsj_clcleoaAET3c4v168pjPrA9SoxZlDW3e3AqREy7cmm7F333PChc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAqCs3jvpTxC_bMgl9hg2-eZ0FNmy3kB2o7AbPHrs3Ow&oe=6B031D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ICygTDIYIUQ7kNvwEzxu1r&_nc_oc=AdotNnDt2qZ3L8GqfhOvhtQ27oA7XBvDq-qRmBu33VPxzXbHM5zOY7_85HiTyTzkguQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6g4dbh9KK3GIUNVGHAmXQPwM9-VTxTysN08LnjoPbbA&oe=6B032FD5"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
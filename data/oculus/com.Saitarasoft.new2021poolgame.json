creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFEuqnIjvoQQ7kNvwELnyvC&_nc_oc=Adr1jCuSLsKaOJovcBQsN6qAbFR8WOpDeyXaShjHe8gG1NR9p_SNe_DlPdKr_0QLCtI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xs7j1fokXcDkDKsQZ5eAGCKwMV0kfmAeu870ls1lbmQ&oe=6A3D312B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3ryxnJK1q8Q7kNvwFJ2GMU&_nc_oc=AdqxomrXI0I4zamuFZiMmBtF343BMn3bl_YI4auWR8PyeNzIFCqxrPQD1KsnQxP17wM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ygrhUJU0qPWxdFWh3kYyc9ftmMVo25yHjk8uAIOMrTg&oe=6A3D5183"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEuxT7ArHkIQ7kNvwHZqvOs&_nc_oc=Ado_Tt6Mq2aGIOaQy1JQi7MczZ650lJhuhNhX88klWkovBZFjy85213M0177Gnb6NLU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cdO8yefmnIgryZyGDLUXvihc9NWucrQ9Bk9sZYTp-oA&oe=6A3D5C63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgL1zvPQVIYQ7kNvwG10N3B&_nc_oc=AdqWwdNZeqVRs3xODrWJFfVCHzDQrIfwlQlM7xCaa4MCLg-DOoggMe0-8XY466fsd3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vDC_OeboHI9yRtV-RPNzA1puBbOmXfcQfszfc2KJIBA&oe=6A3D3695"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
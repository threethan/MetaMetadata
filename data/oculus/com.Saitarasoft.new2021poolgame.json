23565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbBUToV--x4Q7kNvwE2AHkC&_nc_oc=AdlrMq6KtIyeA9r7ixC_PQZyKmb2OIQ0wd9hTknHmtyZ8uc5uJOG15GeCDiP84eTpG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsC0PwgErDZ0vvVww5kPC4J1kujtKMMY60IELfAqqMeqQ&oe=69A2F1AB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ego1d_Tcbm8Q7kNvwFMOsuF&_nc_oc=AdlKMVUu_U0DxMu3EdhcIvNy3LNXmi6uq6Sjegc2JeiXXLpBH8Pu-J3T1-fFic416YI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs6eZNhbPw9TXJHZ71QbtwgTcbgcyCHk9oGtYEw5JLa0Q&oe=69A2D9C3"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOKs70FoCCQQ7kNvwGTJmFr&_nc_oc=AdkOFFqUcJdlvzPrIWHtqvIxuS5Zg6zc8ZKvDpVcsa8z40rz3Lt4NEr_7LFl8wz7J1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-K6AkzDUe2q8CgVFedvOpj8aIt5ymnTYZ-OrBkETL3g&oe=69A2E4A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLkgpX7gOKwQ7kNvwFmPxXN&_nc_oc=Admzu1JHke6EbN4r634xnpdPPeygT7817b0-q31lnDYvdZhVhCzr2leTHxb2bc8WSJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftXSW7HiPTQYYkDLAF0zOZN6dKZd7qJ5b1tTnXdVpC0UQ&oe=69A2F715"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mod
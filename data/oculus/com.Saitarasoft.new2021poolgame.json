c1sQ7kNvwGzP_cT&_nc_oc=AdomE8vzc1iR051gvnrjueP88In4iaHeIY3CqHv386jOIv0x9EVKbj353Rn5KixM3SA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbLf-DUPNuVUer15X8VCDqRBLIBEdpI7oFpGzhDm9VHg&oe=6B087188"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYZA577PiIIQ7kNvwGA_dGh&_nc_oc=AdpqP2XQ6LI47piRa2I-m2n-IFlirKabv3_11rdmgwMnNZNUFK0ht1URmaHwopZjLgo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuIm6GV3tiSKnI5w_2AJxb2rlAej4H9PHyHzYHPERJmQ&oe=6B08706B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W1tZLPEROQQ7kNvwFkCjld&_nc_oc=AdoAczW5w3nPpsoNCA9UdjhU37kltn8pVKNSILiuyXw27HKfinG_JTElTNqk673a4PI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb_wAIn8bJx4aZguss9tu9xX5a7VBWnl9qyCZ9B3EjvA&oe=6B085883"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecKq2cAIgEoQ7kNvwEZTahh&_nc_oc=Adr5PZcDLD9SWBY6y7rhO2bKbgnp7S_G_qMyIMct-ehTcY7tsUdPa9TWUhBuigzBfJQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH7Mr7ebEBaPirgZ0DJZ8VZ2KQTR3ifxPAJHhrz3Oqpg&oe=6B086363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwiCM4jbrO4Q7kNvwG84tBk&_nc_oc=Adqx2DwzJIRhMAu1fhGwT8g9JgjKX28PORgAEs50sWLHA08nhg6Ckt03bsxZ4oz4l-k&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrA3_0p5sO4L4-YNbQO7X_pkN4bn2MUT9v9JaR_8jB3Q&oe=6B083D95"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
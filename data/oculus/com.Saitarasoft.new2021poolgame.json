creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct5dq-hal-0Q7kNvwGsB5oU&_nc_oc=AdoHwvtY7FZDWoVuxYrn9EOdx94cSEDwYaggWxcKttNzlkuB21kzKzbtFeKcWW6Iuxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD7fA9eMjIEqUQMgM26E-iDWlSYJ4JPv-opRh9iITztA&oe=6A896FEB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1d-mGSQcO0Q7kNvwHiT8Gk&_nc_oc=AdoIcys-KPRQtnW-JNUZ7nuwG-L4-Ee7YAz9EdBqLOBHXvUgUJQLiYqbhkCmZKKkVS0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTwiuLU9BqNhM7Hgq1758WcL9tdLbpe_ETO9DEw-JFeA&oe=6A899043"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krxt6HE4ICAQ7kNvwEbOEyt&_nc_oc=AdpwcT8w_75UWAvB78Ebf18EiNFCdiDDzbitnMmXswhnCir05SoPNbbzZ2KdoyxNg2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg9izMpejRjK5Mnle90q0wFz34y-TeUdtub2ViHvwWQQ&oe=6A899B23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3P4bY8Q8r0Q7kNvwGMvOLE&_nc_oc=AdodCpCMV3FVgX1ifsxA7J0HsPKO3yKCXuYviGrjM7vJthdO7F3ul7U8EMq7FfO4FJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbzJlJd_7JaoGSgKco4jS8RmDpZIrSXcYvtKuG7BYQmw&oe=6A897555"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
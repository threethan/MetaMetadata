creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XP7FSe-ppvoQ7kNvwF9oT0S&_nc_oc=Adp7CMt9U0LcLvCIw0DOGUL_RiBBz4bbKQS2MuIobWsSiM8KDPcScQMwXGwYHF61v34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-jlbL3ZQC6bVQ09nh_NiNgyr5-X9UrFqDzVSgF0PDEg&oe=6AF3586B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB0gzWISBBoQ7kNvwHYXTgq&_nc_oc=AdrHLuLFBH1jhuJ12Uia9VVQdD3MryviHXpuRknIexo4cN6puDlU5DPpdpyMMFH0NG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMaaw0w5QycBBw4p2n1vMkMxWGbacxrLWQ0TEgVpcNFw&oe=6AF34083"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB7E9nJru3wQ7kNvwF7j9St&_nc_oc=AdpHNbxNXmtJiw6Fvga5f3M0QbOEDMz3fuBbZWffodd1muzulf0BkHrGamQM5mhd6K0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwWFiW1gLI4oCzWTkXp8qkYswqASYJX8MUILEqts8X2A&oe=6AF34B63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j14mgY3FGugQ7kNvwEcqPBJ&_nc_oc=Adp1QviTnUFbMKyq-M9yJisz8S66I4d5RWf8x-7uZ8lVvtwaIjrAexwSieql42l6B0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThq-m0sWVmGDfwT4Jn8iPnNFIENghdcKtGjencD7o3ug&oe=6AF32595"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
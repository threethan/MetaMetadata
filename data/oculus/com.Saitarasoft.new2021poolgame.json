5tgQ7kNvwEgSRqU&_nc_oc=AdoskrZUwOKE2ido1adQpK84mCT6iMefrkfB3H7xrXX_fdPEuOh0FLjAQHzyr82FPck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfMf816nhE4TajO5VO91QCk1QXEpwvEoFH02ZRoBc6GA&oe=6AFDAD48"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv5RaSZ4VjcQ7kNvwEcevN2&_nc_oc=AdodSYnAIfyXkqmn5QQqgfkIRMiJYrIBj2KS44EwD-Up1R_8qURxrYvtiQLCCvBxV5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi8zpm9yGatIK2frFWCOGhbw-bF_tQgZp-foQwdGuF1w&oe=6AFDE46B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-Tv22JfIj0Q7kNvwGpnibP&_nc_oc=AdowvUiB6fnRff8bcLR8AZfxcgK6b0FLfs_6mAK4F9rsJoOOSkumHVQpXrOmHkATves&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ03mIwMlEXePf1z5rU59kv4hmvOd-ge58cQVYQnhGWg&oe=6AFDCC83"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpW5uYy6q_cQ7kNvwH-KEpK&_nc_oc=AdojJzECHIt_xpoi3tC1E3TnwNVSGSRJCppB_vk4emHFpNt3__V_LQ0Az_S733fReb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAxp4S13S_x-8jIS72JcJRK1RHiYsluxRNHjxOhHTgdQ&oe=6AFDD763"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5XJ3u2hz6cQ7kNvwGXKxuX&_nc_oc=AdpVa2dniyOjzBTr1y1cCmc2jl6eq_bKq-IKS-pOfSItMYasEpPtj02F6j-sX6EFdJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmSvg0Grtc0P-474cox2TMeLHUcEYNzBmETZGw3o8zQA&oe=6AFDB195"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
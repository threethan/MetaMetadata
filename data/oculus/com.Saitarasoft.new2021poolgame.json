: "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOMe8ly_vV0Q7kNvwErrAiJ&_nc_oc=Adpw7RwISid1FI6nTBv1IjZmYWx6W61l9t7DY1Fcrmeue8rrMm1gen2MPVMlXC6ju6c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ah_Ydp4Q12z2DRyuXxFZOzsPA_a-DVMaqPlhpKE88Pg&oe=6A22D32B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXA0yZ4asqIQ7kNvwG3xCih&_nc_oc=AdrpPtLK_QykgY21srp4fOTNLFYYj8qx5aeId9CNyHt505oRZMlmUFpETLdUGYgxPeQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tu39M4BWc0FoxsLGnnCh9U_fWWBlfJQrTacRTHil8Sw&oe=6A22F383"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arNHzIH-8RQQ7kNvwF4rqto&_nc_oc=Adp5pDIHs8BO6tyiDGKODe51BgVUoOlsPjGh4dXvccuX_oxreTX9uU7w2-nDCzSN0NQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82QMMM2ApDo1SDZMiWSjhXQY2gvkqhjB6wY9lk0o9tnA&oe=6A22FE63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHfUuoVEwvMQ7kNvwFHBD0Y&_nc_oc=AdrFEj_--PiZxC-ENbroXB4hWGGUWdIBgexdyZP7tMsj4-CEqtXFMsP3u8PMV_LHbI4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_jx3u7aLmL9kqZq9VjPC00KgYCMUIc_0gheN5gl89Ng&oe=6A22D895"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics":
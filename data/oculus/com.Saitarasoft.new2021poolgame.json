creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P71kmd6iy2wQ7kNvwFs4uLl&_nc_oc=AdqB8rm0wpvig9HZA3Hl8-xmF0ts7-SIfDhGwzDM5BmDOmSO25POtvePqZo83L6FFmU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOnFAJDeT70Cn2xtpLj4vq5aBsbCX-CZ7rHQ6WAgcoNw&oe=6A93FBEB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TMqKVnKLf0Q7kNvwEvKzjG&_nc_oc=Adpso8KIIuq20hLIG88YT80kwo-mDJ17fb5lL-s8t0J7Oe0LBtN8g6k_h5SGLdbLneU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLiLE-9ixNOk1H4gubVnoJZugfzDASHIR0jgQoxpnNQw&oe=6A941C43"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKgzWB19wWoQ7kNvwGE499I&_nc_oc=AdqWQ-NpsajlTrd8Z9ye2rOytGhf_AzXzhmHWQr1C9QQPLZ175DMdx4IMbhLlcUOVTE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYGt_l8QxqAi8XVzXJp8oDricmIWVVcdjVDbmg3IPoqA&oe=6A942723"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCHlkyrKPIMQ7kNvwH-AMOG&_nc_oc=AdrY6bJGx89SAV-_1x0dlz-gAMPuHesZr-HrPKGt-0Eicz5ui8D0zxpdHufwSVSGY50&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqL-1PVGqCXDbogbDbi492knd3MyPG75Sfww13Q5_bUw&oe=6A940155"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
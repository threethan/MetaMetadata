sGoQ7kNvwHDECw_&_nc_oc=AdrO9jF0DvRoGGZQFfo-ZCJI2IXQbBUavnf1Ls-dvD_Sz8k5nIuyhq19F9OmcvGE00A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXkmGA8G9hSaeepR3QxyT7R_v-yibsE5qHqaWHnG_uVoQ&oe=6B0F0908"}, {"file_name": "screenshot5.png", "id": "4907123562659912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKNzOk5_n0IQ7kNvwEAiMfV&_nc_oc=AdoE41LQ-uNnQ2wZ5662vDx5kvurGU_TFZpXdGrWDT38OHOK804Y-BdKesXrcA9lvOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9eBGy0xQclLxVTy0QKZovGfXBtDf3dGSzH_NbDv1ZxQ&oe=6B0F07EB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr5Tomv9ED8Q7kNvwH2iGTu&_nc_oc=Adql-JAmTW6NjbxuLP1_KbyVlMsRKz2zj3G8n0zfEw6vMhIJtAFqbqOpzuCW_RHn1b4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjXduswWlEBzLYuyoSs_-ZyIMxXghx3a7P6bhOwsKDyQ&oe=6B0EF003"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9eJRfPTqTUQ7kNvwHh7hW_&_nc_oc=Adr1Hw2Bn-h5dm5bleebYCA39xv6VtAbZXvt3d1ZTEfhslRsh82zMRSKGtKonqHSH64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFUk35WUZz6gIEQCyLP2SA6Ev3YqWYhsORoEgENPWW2w&oe=6B0EFAE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj0ZbzRoJTsQ7kNvwFi5ySD&_nc_oc=AdrQFNPXSjbngtxxUAkw9xZzvv9xOgbaT-Er6Yd8_V8t9bY8gxy_oIHX8LpUsJ1Os8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVm0c7NHJrP_nWYDcrTnHZ9NUOaQDr_A_eFhvY7HAPJJA&oe=6B0F0D55"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [
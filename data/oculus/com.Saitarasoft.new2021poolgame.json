creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=267ZkjpHoZAQ7kNvwHrMPFK&_nc_oc=AdrooMDHHvPWZ_xkIpVLU8p3JNQrOP4rHMXuyHxIQeoTQvycR0B1tPw0OqmwmNRg484&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PqvhXrVvvBsPPgL4Syrg78ciW2Y-OGgN5mUcPPZKMvQ&oe=6A105E2B"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecLz34Gk4kAQ7kNvwHjy9kI&_nc_oc=Adqqbhr2AJXrHO2Q_G5vEWUla60zU51QX-OpZ1uR-Eowl5ez_yoCZDt3aattsLHE0Gc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rbrhsId1NWTHcp6QmINVeAVd4mxxqJh4Kti2BnWQAhg&oe=6A107E83"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KG9ztDeDBkQ7kNvwFaxo3v&_nc_oc=AdpsxrbY3q2xVO_xB4BYDShB8hnARIcpWZ5H5w6dSmjkIkU44Aj-9Vy3VPh_JZ12sG4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54cd0M4fcwJdAc3qrQtJc_i1W6j-VjIqxxW0_5YgcbMw&oe=6A105123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq1dyBgJ5bEQ7kNvwF9Mge9&_nc_oc=AdojuT2p1GlNUgN9B34JAo6gngOLBpqeU4SZyeky9oOQJzBiMnl0MZdMhSy-Z8B3t5I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46OqGAoxDwzUEzJMeLS4Dw-fb9mdYB7gfXt_ugNqjL_Q&oe=6A106395"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
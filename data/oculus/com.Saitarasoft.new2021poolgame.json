creenshot5.png", "id": "4907123562659912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035315_4907123565993245_3462149684479781488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVWQijw00SAQ7kNvwEGp4tN&_nc_oc=AdoUZJl_-VA5iGZI1DSRSqviFLXRnhtVkeWjw7YaB8lwAxBK9Gfd_Q6s-TBqhaSgu4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL-T39MiXSpJv_iovMLkJGaYiCER27rAFWX7zf-uOvbw&oe=69C295AB"}, {"file_name": "screenshot2.png", "id": "285562633664373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_285562636997706_4290177067957678845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viAYS3hVhQMQ7kNvwHk-uu2&_nc_oc=AdoNsr0aWf3EgRcHXbbtM-vuUIAjZDRpu15MjAPg69Is2EJ6KZncMWOEeiEX8rW7gt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1NtYhmgRcXU5qz-MslyVmiZnqnnJiTC__Yhx5FvHrDQ&oe=69C27DC3"}, {"file_name": "screenshot3.png", "id": "1098264914349891", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974854_1098264917683224_4454014628276889452_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1IVIJfZLrUQ7kNvwEH7pFM&_nc_oc=Adp_tJmTlkMjmMClYVqQU1uC65pBIFytuhMArGr_F-3H5c0ns4_FO2k6GSNlaiWlu0s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYMFFW3PqgWUN-zAJeD2Bw1FNz2neO8BI-d_BSi1pi7Q&oe=69C288A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1292854621212403", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1292854624545736_258234218258836525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o7uHzbEjKsQ7kNvwHoUqeV&_nc_oc=AdoT0u0CtzVpYok4mpsicuZSqzjYlqo0CT9BPNwB0xHJ6vS08AEzVrfwXGLHP8ws71g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyO6ar7LeI0fcBxOLXqJJsk2REa6viapEuf6lClm0mQlw&oe=69C29B15"}, "display_name": "Cueist 2", "keywords": [], "long_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy.\n - A choice of specialist cues enables various spin, swerve, masse, and jump shots.\n - Choose between 9 Ball, 8 Ball, UK 8 Ball, and Snooker.\n\nThe latest update adds:\n - Click the left thumbstick to switch between smooth movement and stepped movement (for those who might find smooth movement unsettling)\n - Click the right thumbstick to switch between smooth rotation and snap turns.\n - A new laser aim pointer to aid lining up shots\n - When the shot is lined up, you can nowhold the Y button on the left controller to enable Autoplay", "short_description": "The sequel to the popular Cueist pool/snooker game, Cueist 2 brings unparalelled realism to online VR cue sports. This is not a casual point and click type game, but a deeper simulation which will reward real skill.\n\n - Play online against your friends with voice chat and Meta Avatars or get some practice in versus the CPU players.\n - Use a natural cueing action using the Touch Controllers, or attach a real cue for the ultimate in feel and accuracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saitarasoft.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Saitara Software", "support_website_url": null, "website_url": "https://www.saitarasoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
: "780924441751623", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_780924445084956_9010127107918247518_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVXZG7NOlFwQ7kNvwEU8KTg&_nc_oc=Adp6fDjajew6zRBAMlJj60ETZomRU5kSRo6ylfjpC9MututULQj4eJqhphRG7RY4UEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIWE1uFIauweQHaKUj14cFtMKHz-dCDxWRLLzfTSszNQ&oe=6B10514E"}, {"file_name": "image.png", "id": "899885789708284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823968_899885793041617_8821606690284336304_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BWgw0ztOc0Q7kNvwFl0cIK&_nc_oc=AdpSUj6l_F8ov1FbI1BUZxC_eBANpAThXx-oFLwohtKIwo2xW-R_7RD3A5HqOeWSPZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU21foQ4g1R6hdMoAJezM41hjV8MKIK2pg2iSRNXxOMCw&oe=6B1066CC"}, {"file_name": "2.png", "id": "939319925302838", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_939319928636171_32029461402392237_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goud4vLVX-cQ7kNvwG4zp0H&_nc_oc=AdrzsMKNV3W8OU3X7tFF4dpSNhIbwSB72jUkFu3r5P3LmT2NaLVcHzvyE1VZU-JWwfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvf58QKidAff1dTgnt-S4A5Dxc6DRI3emHtVkf7uwRHg&oe=6B10695F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Ar-Ra'd", "keywords": [], "long_description": "Surah Ar-Ra'd \u2013 VR Experience\n\nExperience the recitation of Surah Ar-Ra'd, the thirteenth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free setting where you can listen to and reflect on the verses of Surah Ar-Ra'd. The carefully designed virtual environment and high-quality audio help create a focused atmosphere for spiritual reflection and connection with the Quran.\n\nSurah Ar-Ra'd emphasizes the power and greatness of Allah, highlighting the signs of creation and the importance of faith and patience. It encourages believers to reflect on the natural world and recognize the wisdom and authority of Allah in all things.", "short_description": "Surah Ar-Ra'd emphasizes the power and greatness of Allah, highlighting the signs of creation and the importance of faith and patience. It encourages believers to reflect on the natural world and recognize the wisdom and authority of Allah in all things."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27185756667691439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_1556071369855118_8154093798278457473_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgp5rf4TjiEQ7kNvwFmruiz&_nc_oc=AdpIJZ2MYAryJFzTAGrEI-AvK_ceYz1HCMNK3k1-zp0LxVs2p0cwTANMF30fK-MfY08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfVxtyb5p3tZJnx6jr0A8Znk3Uerb7zsLsOskJOAvHyw&oe=6B105429"}, "is_concept": false, "is_test": false, "is_tria
963549444745289100_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNw0RqoVwSwQ7kNvwG5kQC8&_nc_oc=Adog5WodXos0Wztco-5DRxMGYvi_2K44IFhbuG9W1enKUnu3ayYLCyVlHVMUtXD0qy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrS6lWlfSUDcKBq8GdFmSxKoEpz3z7n_Jns-T42hbFdQ&oe=6AFC7135"}, {"file_name": "screenshot_1.png", "id": "1754458072495757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1754458079162423_3540382452920839504_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8WlUmFIBLkQ7kNvwHKudF9&_nc_oc=AdpCFERUe7Ns4vwV37RzAyTTLhY_jrZPS2kJqFTGzNzIknqi1mZ4bNa_rschuGWkjgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsX5vBp1vcgRAPvmmsK_edQH4ZCzGRmW7VBIfDtNb3AA&oe=6AFC9186"}, {"file_name": "screenshot_4.png", "id": "4670205046602310", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824741_4670205049935643_5440556558075112830_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I6o77BvWHsQ7kNvwH0vklT&_nc_oc=AdrwmbEodvX8kIK9-q6wdrsetoVKF0wHvXJcisApYK8JNOEhJGmjBV1-MrtdVoPxld4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCR9vpUd2Gu7cYb5n8Y613FfqPck6aeo9IETKgSGB-vA&oe=6AFC832A"}, {"file_name": "screenshot_5.png", "id": "2109989269602052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_2109989272935385_8885869753866205276_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVGlpRHAyqEQ7kNvwETiKHT&_nc_oc=AdpETT5Ac7VT_LGbezdsa8v9vo-zUpoKB9WTU_5y2uU4P7UoR_kLfJOvFXtNmYvYi88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6-VNT5nMvTBFakAZkSGSzfS0_FQh_CscAHcF-HhBGKw&oe=6AFC679A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1820825169334894", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1820825172668227_3822862028712016848_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEJzPv7y__YQ7kNvwFZVKz8&_nc_oc=AdogEsz7gVkQUhCy-xnsdr1NugMHjbA1FnvheR5EXIzlHNjiDw-AAkdYSiCuVxfAQVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGORJZd8QqDk2LWi9_doUZuuTyGYEDVry14ZeUuF2pnQ&oe=6AFC8CA8"}, "display_name": "Titanic", "keywords": ["titanic", "submarine", "ocean", "exploration", "history"], "long_description": "The North Atlantic, 14 April 1912. From a lifeboat on a flat, starlit sea you watch the greatest ship in the world sail past, every porthole lit. Then the present day: you are in the pilot seat of a modern explorer submarine, and the dive begins.\n\nA NARRATED DESCENT\nSink from sunlit water into the midnight zone while the narrator tells the story of the ship. Dolphins, turtles, manta rays, sharks and whales pass the dome on the way down, then the glowing life of the deep.\n\nTHE WRECK AT TRUE SCALE\nThe bow rises out of the dark exactly as large as it is. Fly your submarine along the bow section, across the debris field and around the stern, each built to the real dimensions of the ship.\n\nAN 18-STOP GUIDED TOUR\nFollow the tour from the bow rail to the propellers: the anchors, the foremast, the bridge, the captain's bath, the Marconi room, the grand staircase, the boilers, the engines and more. Every stop is narrated. Fly it yourself or let the autopilot take you.\n\nTHE TIME LENS\nPress one button and the ship as she was built is drawn in light over what remains.\n\nLIGHT THE DEEP\nSweep the wreck with your floodlights, ping the sonar, and drop your own lights to hold a deck out of the darkness.\n\nWALK YOUR SUBMARINE\nStand up from the pilot seat and walk the bridge and the salon of your boat while it holds station over the wreck.\n\nA calm, respectful experience: nothing can hurt you and there is no timer. Play seated or standing. No account, no internet, no in-app purchases.", "short_description": "Dive 3,800 metres to the wreck of the Titanic in your own deep-sea submarine. Watch the ship pass on the night of 14 April 1912, ride a narrated descent through the ocean, then explore the bow, the debris field and the stern at true scale. Switch on the time lens to see her as she was built."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/titanic/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/titanic/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1231427850063188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823310_1365442325402919_4723485557705012660_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8agSUNzZcYQ7kNvwEvliqN&_nc_oc=AdorvoQPt5HZY9nxVNtQPspfRGhWsi8UJxWjiPs_LAYQT-V3AqVRdi-5lfjRipmkH70&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSQyaOVSqUdlaAkxwiNgrz-zWKpPp7x9u6vOPLxGa4ZA&oe=6AFC93C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Titanic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1791636720, "lastRevision": {"nodes": [{"id": "12314278567298
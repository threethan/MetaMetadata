ntent-sjc3-1.oculuscdn.com/v/t64.5771-25/585741071_2302444193859344_6270872200774148315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjj6M1ck8PsQ7kNvwGl3WwN&_nc_oc=AdrMZY323-GmWcU3S_9G0QFfQS06dj8MynS0h1bSHLF-tGNQWiZZHMNPpG4jVM-jd_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB1tiv9fVULHbJcu4PQdt9o96efjF4fTD9ZBRfm7gLAA&oe=6AB296E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Demining Academy", "keywords": ["simulator", "mines", "sim"], "long_description": "**Demining Academy** is an experimental educational sandbox created to explore VR interaction mechanics and raise basic mine awareness. Set in a safe virtual environment, the simulation allows users to learn about unexploded ordnance (UXO) identification and safety protocols without real-world risk.\n\n### \ud83c\udfae Gameplay Progression\n- Level 0 - The Lobby Level: A safe zone to inspect 1:1 scale models of landmines and practice in detecting mines.\n- Level 1 - Surface Threats: Practice spotting visible surface-level hazards and executing remote destruction protocols from cover.\n- Level 2 - Sub-Surface Search: Sweep areas for hidden dangers and use realistic digging mechanics to carefully clear soil.\n\n### \ud83d\udee0\ufe0f Key Features\n- Interactive Tool Belt: Utilize functional virtual tools tailored for spatial VR interactions.\n- Tactile Mechanics: Experience realistic digging physics and object manipulation.\n- Immersive Atmosphere: Spatial audio and full-body presence ground you in the environment.\n\n### \u26a0\ufe0f Important Disclaimer\nThis simulator is intended solely for educational, informational, and awareness purposes. The representations shown do not constitute certification, authorization, or official training for real-world explosive handling or hazardous device intervention.\nBy playing, you acknowledge that:\n- This experience is a simulation only.\n- You are not qualified to perform real demining operations.\n- Attempting to replicate these actions in the real world may result in serious injuries.", "short_description": "Demining Academy VR is an educational sandbox simulation that introduces players to basic mine awareness. Explore 1:1 scale models, learn standard safety protocols, and practice identifying virtual hazards in a safe, interactive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedeiw.github.io/TheDeiwGames/pages/DeminingAcademyPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "TheDeiw's Games", "support_website_url": null, "website_url": "https://thedeiw.github.io/TheDeiwGames/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1279536895238320"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823910_3527250187426761_7901352563857032535_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ4pSeodhB4Q7kNvwF52mSM&_nc_oc=AdrSd_UwkiURMCp3aQGHnr5JKvm82drCnXQ_Uk0SWfDq4uvuRhWqQ-FQr3x_py8iC80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHVnIEPx6WALyHr5QL5ApEavCanBzThKs4_uL2rw7F7Q&oe=6AB29909"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Demining Academy", "platform": "ANDROID_6DOF", "context_category": {"context_
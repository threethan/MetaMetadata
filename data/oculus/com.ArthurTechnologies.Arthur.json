_nc_oc=Adqd_McaDhlmroA3qGt1bKz8wImfvWxPejJHCbwYlwTdDHRePeN033dGYTTgKyMYHrA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLryJt0VUaexVlQ7tywO5ZAQMTuX_9MaqcbFNKvWWXGkg&oe=6AA95046"}, "display_name": "Arthur", "keywords": ["productivity", "utility", "meetings", "collaboration", "office"], "long_description": "Arthur is your virtual office space. It allows you and your team to meet, collaborate and manage your work. In Arthur, you feel like you\u2019re in the same location as your teammates, but you can still enjoy all the advantages of digital collaboration. By using Arthur, you empower yourself and your team to maximize levels of remote productivity and free yourself from geographic and physical constraints.\n\nThe version of Arthur available in this store offers a free and light Consumer space with unlimited session time and exciting productivity features for smaller teams that do not need as much room. In case your virtual office gets too crowded, you can simply upgrade to additional spaces.\n\nFor teams with needs of high scalability for team size and space, check out our fully-fledged virtual office in the Professional lobby or www.arthur.digital/product-portfolio to find out more.", "short_description": "Arthur is your virtual office space. It allows you and your team to meet, collaborate and manage your work. In Arthur, you feel like you\u2019re in the same location as your teammates, but you can still enjoy all the advantages of digital collaboration. By using Arthur, you empower yourself and your team to maximize levels of remote productivity and free yourself from geographic and physical constraints."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arthur.digital/privacy-policy.html", "developer_terms_of_service_url": "https://arthur.digital/license-agreement.html", "publisher_name": "Arthur Technologies Inc.", "support_website_url": "https://arthurtechnologies.zendesk.com/", "website_url": "https://arthur.digital/", 
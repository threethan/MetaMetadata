agUN93u_o6AAf1T9MIby49iWsRBWBcBxQRqivvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7ebq44-6w-kH1awApGN00k5L84r4Qbj2FkvuE0QsTMg&oe=69AEC925"}, {"file_name": "pro-2024-12-19--c.png", "id": "897942918994436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031491_897942925661102_2723296588880507164_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRvDUCMTFC4Q7kNvwFcz93s&_nc_oc=Adlgpfqbqq_AXIA98BaASZnlRVjQcJcZ1_yqg21ixLWP5b-W_TewGWsIxHeJbQu0qac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxwo-D6oqgEtPGnLYcXaw75LMP7xj3Tk46X5cwVRi6Jcw&oe=69AED18C"}, {"file_name": "pro-2024-12-19--d.png", "id": "580417817937936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982526_580417821271269_3533412520524723785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8f4VhrRMQjsQ7kNvwF2ybnV&_nc_oc=Adn4GeCsxHCj1jgdlewb0exuLyQdvrNpuuO9LPXM1zQtmVNlIDE8ULQIrV8fPCrkuO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTbhnEOsKN3AZYGCSn_f91zqrhM6ifnlbhOJP2K1q39w&oe=69AEA84A"}, {"file_name": "pro-2024-12-19--e.png", "id": "1108393194118933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003262_1108393197452266_2397173949570293948_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqGMhJ7di0gQ7kNvwFz4Bek&_nc_oc=AdnnaM-pDc4ZuiFuBIWi7rnsQdiKOEKGo5umMlL_KkKY70dgk5vqMHey3RtoURjoIQc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXxcDdSN7IB7N3rAQ6693ogy7MnSRxAJFBvcyvjCR6ZQ&oe=69AECB1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-poster-image.png", "id": "748235350296580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422369_748235353629913_5219602994002181557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSvIsFawW-gQ7kNvwGH9gZg&_nc_oc=AdmApxQBWJC72HOWcmauLk4ewzlGqBhSILvVHEw5Y8jAeAIxXpMHAfjrbJM7jNYXKz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlQP3YIafaIi0Ixh9xPDG3CcGzk1yKmPEjYBcdrpvPfg&oe=69AEA652"}, "display_name": "Arthur", "keywords": ["productivity", "utility", "meetings", "collaboration", "office"], "long_description": "Arthur is the space where humans and AI work together. Combining spatial collaboration with cutting-edge AI, Arthur empowers teams to work smarter, faster, and more effectively.\n\nLeverage AI in interactive 3D spaces and make it your own. Maximize your productivity and enjoy all of your favorite tools, such as pinboards, 3D flowcharts, presentations, MR Desks, and tracked keyboards.\n\n*Included:*\nTwo versions, a _Consumer_ and a _Professional Edition_. \nThe free and light Consumer Edition offers limited productivity features suited to smaller teams that do not need as much room. \n\nThe Professional Edition for enterprises and large organizations features vast spaces built for deep collaboration, the full, AI-enabled productivity toolkit, and end-to-end security. Visit [www.arthur.digital](https://www.arthur.digital/product) to learn more.", "short_description": "Arthur is the space where humans and AI work together. Combining spatial collaboration with cutting-edge AI, Arthur empowers teams to work smarter, faster, and more effectively. Trusted by leading organizations and Fortune 500 companies worldwide, Arthur continues to redefine the future of work and is a leader in immersive collaboration tools for global organizations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arthur.digital/privacy-policy/", "developer_terms_of_service_url": "https://arthur.digital/terms-of-service/", "publisher_name": "Arthur Technologies Inc.", "support_website_url": "https://arthurtechnologies.zendesk.com/", "website_url": "https://arthur.digital/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER", "MULTI_USER"], "id": "8755818707832607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974877_519751586637981_2418760789056866959_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_2YP_zbv7UQ7kNvwFN1QX2&_nc_oc=Adl9uWWN2Esvop1IT0cOIh5MIvIy1xWM-aj0CzV6RjKFPsiUEUgea_MeNOvEFiIAWNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0J7w00yCgNsgs0lCSu9LFmotTpUpj4VpQOCCYav3wjg&oe=69AED6D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Arthur", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1614880838, "lastRevision": {"nodes": [{"id": "427942537957562", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2108767382537806", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "140259097952018"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "oculus-store-asset__store-release--cover-art-square.png", "id": "3706097942806608", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_3706097959473273_768440039957559059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnSzzTwEdOcQ7kNvwEUZNtE&_nc_oc=AdkRHg8FS8uA1A03LK5ALIeqjddwrKb-sc_WsA
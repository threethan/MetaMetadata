", "keywords": ["productivity", "utility", "meetings", "collaboration", "office"], "long_description": "Arthur is the space where humans and AI work together. Combining spatial collaboration with cutting-edge AI, Arthur empowers teams to work smarter, faster, and more effectively.\n\nLeverage AI in interactive 3D spaces and make it your own. Maximize your productivity and enjoy all of your favorite tools, such as pinboards, 3D flowcharts, presentations, MR Desks, and tracked keyboards.\n\n*Included:*\nTwo versions, a _Consumer_ and a _Professional Edition_. \nThe free and light Consumer Edition offers limited productivity features suited to smaller teams that do not need as much room. \n\nThe Professional Edition for enterprises and large organizations features vast spaces built for deep collaboration, the full, AI-enabled productivity toolkit, and end-to-end security. Visit [www.arthur.digital](https://www.arthur.digital/product) to learn more.", "short_description": "Arthur is the space where humans and AI work together. Combining spatial collaboration with cutting-edge AI, Arthur empowers teams to work smarter, faster, and more effectively. Trusted by leading organizations and Fortune 500 companies worldwide, Arthur continues to redefine the future of work and is a leader in immersive collaboration tools for global organizations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arthur.digital/privacy-policy/", "developer_terms_of_service_url": "https://arthur.digital/terms-of-service/", "publisher_name": "Arthur Technologies Inc.", "support_website_url": "https://arthurtechnologies.zendesk.com/", "website_url": "https://arthur.digital/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER", "MULTI_USER"], "id": "8755818707832607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974877_519751586637981_2418760789056866959_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4fVEH-edMkQ7kNvwHnPENR&_nc_oc=AdlqAHF66nFZghszBjgIQampBogUXODrGfdUOwwy8n_u299gL-ba2akUPdfoivg6jmI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz33kkzsW0paXb_j8h4jM2iwxwwAg2F4JfUldUCVh_pjA&oe=69BD5758"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Arthur", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1614880838, "lastRevision": {"nodes": [{"id": "427942537957562", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2108767382537806", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "140259097952018"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "oculus-store-asset__store-release--cover-art-square.png", "id": "3706097942806608", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974504_3706097959473273_768440039957559059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adGomlQhX-YQ7kNvwFOWxoP&_nc_oc=Adl1jDvTowjKlPb1CG6CwBHErY9qS5kG60LLhR
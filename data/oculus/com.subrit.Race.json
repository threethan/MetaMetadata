-25/499621305_1275851130840808_8492558086160875005_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ykGoBDSOiEQ7kNvwESebll&_nc_oc=AdqTcRI-m6TenZ6uuw1BZdEDIkanatXPaxM2I0qRxgeSFo5n9UsMj3m-8bReIA2EsvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnaSbghfWHSDWbyW6xqrzxzsRsajbL6YP-sgodKmSFxA&oe=6B0484EF"}, {"file_name": "2.png", "id": "1068985077949607", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298543_1068985081282940_381501131625885851_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRwBAVSe6f4Q7kNvwGvFZ0g&_nc_oc=AdrBSzHYsSYwvgWLwFohrx6DK8KCqqGfYuvORnCJlYlUTaEunLI4FEolf3p12B3dBQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFJMb_2JQe71CICBQ-ucx62BGKnGuo70FP49k7My0xTQ&oe=6B045E45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1724885302246422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824213_1724885305579755_8978691832753912609_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxaJd6_PTpkQ7kNvwGKIbjn&_nc_oc=AdrW2_kmrFBeJgFVJqfH3pOFftpYSMFL3Zm6cLxBcDUZO9pqQhAfRpkdwLIgpGdxc2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDlvZ5hIqARU7-qKO18Yo5U0LCvLYjL3d76XSapJiOVg&oe=6B04805B"}, "display_name": "Race", "keywords": ["race", "car", "racing", "game", "vehicle"], "long_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\nChoose from a lineup of meticulously detailed cars, each with its own handling, performance and stats. Whether you favor sleek supercars, agile drift machines, or powerful muscle cars, RACE has a garage ready for your ambition.\nCompete across a variety of breathtaking tracks from around the globe, each crafted with stunning detail and designed to push your reflexes to the limit. Tear through neon-lit city streets, master high-speed mountain passes, conquer dynamic weather, and adapt to day-night cycles that change the feel of every lap. Every race is a new thrill\u2014no two runs feel the same.\n\nSimply enjoy the thrill of a solo night rides, RACE is your gateway to the future of virtual racing. Built for VR, powered by passion, and designed for speed, RACE is more than a game\u2014it's the ultimate test of focus, reflexes, and driving skill.\nAre you ready to grip the wheel, feel the rush, and prove you\u2019re the fastest?\nStart your engines. This is RACE.\n", "short_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subritrace/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Subrit Dikshit", "support_website_url": "https://sites.google.com/view/subritrace/home", "website_url": "https://sites.google.com/site/subrit/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWN
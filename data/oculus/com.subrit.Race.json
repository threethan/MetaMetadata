c_sid=6e7a0a&_nc_ohc=HWC_VITh7jAQ7kNvwFwd3e7&_nc_oc=AdrRWhOYWlx7-1M4aVjHBuv-hl_Aov2YbHAvLTUp6hJCDBtzE31uZNkHrGUAp6OUcgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6R2Ve2LgOd8Nw11Za6w2uQama0zEZIe8l_dQXAUKzsA&oe=6A9C219B"}, "display_name": "Race", "keywords": ["race", "car", "racing", "game", "vehicle"], "long_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\nChoose from a lineup of meticulously detailed cars, each with its own handling, performance and stats. Whether you favor sleek supercars, agile drift machines, or powerful muscle cars, RACE has a garage ready for your ambition.\nCompete across a variety of breathtaking tracks from around the globe, each crafted with stunning detail and designed to push your reflexes to the limit. Tear through neon-lit city streets, master high-speed mountain passes, conquer dynamic weather, and adapt to day-night cycles that change the feel of every lap. Every race is a new thrill\u2014no two runs feel the same.\n\nSimply enjoy the thrill of a solo night rides, RACE is your gateway to the future of virtual racing. Built for VR, powered by passion, and designed for speed, RACE is more than a game\u2014it's the ultimate test of focus, reflexes, and driving skill.\nAre you ready to grip the wheel, feel the rush, and prove you\u2019re the fastest?\nStart your engines. This is RACE.\n", "short_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subritrace/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Subrit Dikshit", "support_website_url": "https://sites.google.com/view/subritrace/home", "website_url": "https://sites.google.com/site/subrit/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9905018606263313"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1005478408518392"}, {"status": "PUBLISHED", "id": "790848403717792"}, {"status": "PUBLISHED", "id": "1444987086604362"}, {"status": "PUBLISHED", "id": "24502784906058086"}, {"status": "PUBLISHED", "id": "3608865189410049"}, {"status": "PUBLISHED", "id": "614838474978779"}]}, "baseline_offer": {"id": "614838474978779"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005478408518392"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23864190443252894", "versio
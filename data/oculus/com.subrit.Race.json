ozBtcSxBfTWL_0rRzXCONmxAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYD-N4xG9TIsLcdGkyuVwZXctKKk87chC4cto9aWyxYA&oe=6B106CEF"}, {"file_name": "2.png", "id": "962803442823574", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_962803446156907_5261197199171207845_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7pBsb5WTJ8Q7kNvwHktnz9&_nc_oc=Ado4nNRRwBi-ixhDFtIea-gQ3QGI6iu7Nle6KTFZ3EuWJpklenoXglYzweYgwuvpcLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUy7mP91VFsZ63MzBch6LpxXplp33HqCduY9ECV94hpYg&oe=6B106AD4"}, {"file_name": "2.png", "id": "1646533490499972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624577_1646533493833305_4659821911347381134_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ndif1UJ--kQ7kNvwF1k4bA&_nc_oc=AdozESGr2FD10qRTcV7Nt19Qqt8mWgd70vlZymYKCDDK545OORTPEFr8VePkWjHdt4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_ebA3QKv5TT6y-qyDzntRkLoY6mcTbozB3DTVTvEasQ&oe=6B104F98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "n1.png", "id": "1226306589242584", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618931_1226306592575917_200423814931806871_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZVxuWdeWksQ7kNvwHLx1PZ&_nc_oc=AdpyseRGsdB3gdUsKVUexliGsn7vPxL3A7t4Gs6CvdQZ4MSTsm9-a8hM8uGs1qNm714&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhSCfGvqLJLEQlyHYIkPOs0wdx1Yu1N3MXpqlX9YqZzg&oe=6B10677E"}, "display_name": "Race", "keywords": ["race", "car", "racing", "game", "vehicle"], "long_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\nChoose from a lineup of meticulously detailed cars, each with its own handling, performance and stats. Whether you favor sleek supercars, agile drift machines, or powerful muscle cars, RACE has a garage ready for your ambition.\nCompete across a variety of breathtaking tracks from around the globe, each crafted with stunning detail and designed to push your reflexes to the limit. Tear through neon-lit city streets, master high-speed mountain passes, conquer dynamic weather, and adapt to day-night cycles that change the feel of every lap. Every race is a new thrill\u2014no two runs feel the same.\n\nSimply enjoy the thrill of a solo night rides, RACE is your gateway to the future of virtual racing. Built for VR, powered by passion, and designed for speed, RACE is more than a game\u2014it's the ultimate test of focus, reflexes, and driving skill.\nAre you ready to grip the wheel, feel the rush, and prove you\u2019re the fastest?\nStart your engines. This is RACE.\n", "short_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subritrace/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Subrit Dikshit", "support_website_url": "https://sites.google.com/view/subritrace/home", "website_url": "https://sites.google.com/site/subrit/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "cont
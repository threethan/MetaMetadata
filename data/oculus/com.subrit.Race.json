a&_nc_ohc=lo8ttxjhNXUQ7kNvwHVymOv&_nc_oc=Adrd7O1ujjyk9WUI7YaFwyxlCKqlE6d7z2b4YxjE9hoWXmQhIIuK3z9jrFTCDVS_oUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_5bHFJfvE36YUpDlppOeNEhweLF9h56WAtaddAC9u3g&oe=6AF48C45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1724885302246422", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824213_1724885305579755_8978691832753912609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JJ8DiqJuEUQ7kNvwHe8_Ty&_nc_oc=Adr5D07H_mketjA_-Z4QQoPAQMflxQu0FVOFifW82pEtZSHYY4KLCzoogqA3Rj_V7ac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvltkTzbGCb-KJzlnr_KejmXehsV-kZSeAVjCgSj21Vw&oe=6AF4761B"}, "display_name": "Race", "keywords": ["race", "car", "racing", "game", "vehicle"], "long_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\nChoose from a lineup of meticulously detailed cars, each with its own handling, performance and stats. Whether you favor sleek supercars, agile drift machines, or powerful muscle cars, RACE has a garage ready for your ambition.\nCompete across a variety of breathtaking tracks from around the globe, each crafted with stunning detail and designed to push your reflexes to the limit. Tear through neon-lit city streets, master high-speed mountain passes, conquer dynamic weather, and adapt to day-night cycles that change the feel of every lap. Every race is a new thrill\u2014no two runs feel the same.\n\nSimply enjoy the thrill of a solo night rides, RACE is your gateway to the future of virtual racing. Built for VR, powered by passion, and designed for speed, RACE is more than a game\u2014it's the ultimate test of focus, reflexes, and driving skill.\nAre you ready to grip the wheel, feel the rush, and prove you\u2019re the fastest?\nStart your engines. This is RACE.\n", "short_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subritrace/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Subrit Dikshit", "support_website_url": "https://sites.google.com/view/subritrace/home", "website_url": "https://sites.google.com/site/subrit/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9905018606263313"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2290446691497572"}, {"status": "PUBLISHED", "id": "2866527803732009"}, {"status": "PUBLISHED", "id": "1005478408518392"}, {"status": 
"https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_962803446156907_5261197199171207845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye2HoyY3xRUQ7kNvwFFKO7u&_nc_oc=Adr2qjiXubdJHPxqW4znVzEtfljgNzamqXicMzcdzauB7kabowLq71o7ililbiYw8Yk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-csMAYcPb483YCxhIEQXVFX8tSUDitI3pMqoyjWVdWw&oe=6AF9C914"}, {"file_name": "2.png", "id": "1646533490499972", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624577_1646533493833305_4659821911347381134_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpcVkXc50-gQ7kNvwEUkdZl&_nc_oc=AdrpHokVDzOXCbP6F-Ek9YbrkQqSsHt3RW_4D9tOfMTOU6kcQlHYEaB9fr5QM1-PQcA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZNcCBSZ88QVmG6-2Z7o5R56-7tH3tbVOtlGrPQGbA4g&oe=6AF9E618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "n1.png", "id": "1226306589242584", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618931_1226306592575917_200423814931806871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=it8dwOyhdpMQ7kNvwHYDfli&_nc_oc=AdofbdauJErnXllGNUOIpNNcmbuzR98AFl9Y9q68G7hoBUHB1I5pMoIlVGgytM0UzmM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDRX1mm8Qv436613NwfmGpZONrxxZ3JAWOsHsp2Kl8OA&oe=6AF9C5BE"}, "display_name": "Race", "keywords": ["race", "car", "racing", "game", "vehicle"], "long_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\nChoose from a lineup of meticulously detailed cars, each with its own handling, performance and stats. Whether you favor sleek supercars, agile drift machines, or powerful muscle cars, RACE has a garage ready for your ambition.\nCompete across a variety of breathtaking tracks from around the globe, each crafted with stunning detail and designed to push your reflexes to the limit. Tear through neon-lit city streets, master high-speed mountain passes, conquer dynamic weather, and adapt to day-night cycles that change the feel of every lap. Every race is a new thrill\u2014no two runs feel the same.\n\nSimply enjoy the thrill of a solo night rides, RACE is your gateway to the future of virtual racing. Built for VR, powered by passion, and designed for speed, RACE is more than a game\u2014it's the ultimate test of focus, reflexes, and driving skill.\nAre you ready to grip the wheel, feel the rush, and prove you\u2019re the fastest?\nStart your engines. This is RACE.\n", "short_description": "RACE \u2013 The Ultimate VR Racing Experience\nStrap in, rev your engines, and enter the immersive world of RACE, the most adrenaline-pumping VR racing experience ever created. Built from the ground up for virtual reality, RACE delivers heart-thumping speed, realistic environments, and total immersion like never before. Whether you're a casual driver or a hardcore racing enthusiast, this game puts you right in the driver\u2019s seat\u2014literally.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subritrace/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Subrit Dikshit", "support_website_url": "https://sites.google.com/view/subritrace/home", "website_url": "https://sites.google.com/site/subrit/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
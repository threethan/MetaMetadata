duBnzuj87hz4VJdVnb9iga17HIEE-oIU0ZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNzxYIO5MXZ2dhThh_zk6T1JawlF9YQq6BLl1PZaoVVg&oe=6ABBE2CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMJd_Ha0pxMQ7kNvwHFjTus&_nc_oc=AdruH_BBVR0pQFOEoCB9vxAHQ0x-ta53henghNdvx1TzNLcLh-71ijy0zXkUjnnb4Fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOjpXkPjKLRhqoyZYAdCVcX_DIb2acOUsq382yKeEo-w&oe=6ABBE551"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OZYJFVEjCEQ7kNvwFI0JDd&_nc_oc=AdodH3yycQmcin82ug1-lN3ki1WtaX1WetqcfHT_4K8fRPf_oYuFSvzPGW5xjwn7_vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTuxzCzOTLMX9OoVlOeegVusqJmbPVDEf-xgrU8DNEhQ&oe=6ABBD8F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8EcQv4gWZcQ7kNvwE66J1z&_nc_oc=AdpG1gLJjxdkZStdF3qCKZwNt2aB9SDv71lARD2YuhKCps3gymfkxXPH_5ONzuNmJNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSgLg7fAcQRt1AjGHAvTU1Q1OuCPUKWB1oB5fCVhrksQ&oe=6ABBD93D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq2oL4W259UQ7kNvwEUV8I3&_nc_oc=Adp6MmpDccnkIzqln_72AFpilJ9okJLYuE9U-rzZVIWKkMhst2VdBgOb0NQZce9UxPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoWOppOI8YGLBEWSBPNwI89a0ae8u9CeGeuIHfoJZfPw&oe=6ABBB288"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "484449673286378"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "992147197811945"}, {"status": "PUBLISHED", "id": "2162523370674637"}, {"status": "PUBLISHED", "id": "305044299943498"}, {"status": "PUBLISHED", "id": "278164952653764"}, {"status": "PUBLISHED", "id": "1740775762741381"}, {"status": "PUBLISHED", "id": "765379243937831"}]}, "baseline_offer": {"id": "278164952653764"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "PUBLISHED", "id": "992147197811945"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1271516292962839", "version": "0.10.0"}, "id": "116241648846467", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1099387316842405", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271516292962839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "116241648846467"}]}, "change_log": "Good finals are now much more reachable", "created_date": 1491910717, "id": "1271516292962839", "version": "0.10.0", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1099387316842405", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
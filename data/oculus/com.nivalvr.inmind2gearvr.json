8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLy-kBQtQGsQ7kNvwHkxc4q&_nc_oc=Adry_KvewgGzysIn0z8sxulNddKccZQtkm3CXfuEuvJ1GYjp6JVKQQkuUF73DzgRDJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZmP5x7IrWV4Wbq7F0Z6om0MiTloISio2VXYwGC98rVQ&oe=6AB54B9B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6QxuK9PlgkQ7kNvwGfJ9mv&_nc_oc=Adr5e2_yqIaChY-pU8CEZXYWrLdidXrFd1hZwUMm3HCVfsFY5DDPsvAumMskyCuzrm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGEgXjfDPvAr52eUbwAw7husNpAWu7skMNZyQqC38xWA&oe=6AB54B4B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS72vb_xKqQQ7kNvwEZGinT&_nc_oc=AdpGrpNSrdJFnJGdqUoPX5Fe1WbUTiJlKyc1uXI7HRmpHFq6mtAnmfRgKo6FajVur3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKITAc_GPX0xyexi-WJs-fFmGrYoZw5M9_AJjpfzdqpDg&oe=6AB51591"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpf6o3ebvvEQ7kNvwE11ev6&_nc_oc=Adryrnu4KKwgTi1gHEvf3HHhHU04QGAIZTkpKrh59HwpJHk0irBIQ1DC0K2Vkb-cJR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqqzUWx5_0itMym3CjEmHE_wqi44Cz419N0uNoHG5t2g&oe=6AB54176"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLN2d_P_bwoQ7kNvwEFQQJx&_nc_oc=Adqbj6Y3YDTnxEC1CukHI7oVRhjLSSXTGAfTuzkpYDLW21_luflgQmBqgZoYchu1-sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfILnFeEk5PunpetusWRlqu3RoezBK3K-FhnAUxmrnSg&oe=6AB541BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r7w-nTFlA4Q7kNvwEeT2kj&_nc_oc=Adqz-VqlUPTSAwkRKQQ5hyoxcClVYtcOJ4BOy4AgsI5Tlv_g2vmDsTexNW6Ji4vpZ8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpL3eBinsxtiUQ8optN4Mj-YVXdClptzfc_VcMvwP0oA&oe=6AB51B08"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raF3JTvw-_kQ7kNvwF8EURT&_nc_oc=AdrNn7tSDf6yS1nif7ozeLQ4lPdkb1d_I9FoayVKppLzDEgi5CjhcEhoxzj-FkxXikk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK81IpIOlJNJb1ixoxm2psKIjPjtahJVMLQzlpkSdImmQ&oe=6ABE861B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTEk22-ZqYUQ7kNvwHUcccY&_nc_oc=Adqg1oxpbhEfXsuVs7i2vRuJLYTl24xG3Rxj4ksv_f9Khr2uePzZneoA3I3LxgQ92ag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaRtK8SGoCN5wWJucwloObwFYc3_KKCXZneD7x8wyXFw&oe=6ABE85CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MltmDoHk9q8Q7kNvwE9F_PX&_nc_oc=Adqg64QJE30FvazmJrTGxOI-SUVzSHCxgkAfieLCIOL7Kz3KWPdKyOyeCO-YqmSO3rE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpr7fy0FHN0d1THb2IBfKx0eu9CtksdIoaxob8Rz1W_Q&oe=6ABE8851"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWpc2_Aiu3AQ7kNvwH7t7Gy&_nc_oc=AdpknsuYQOLwOLGsc62Z6XSrHQDYaF_33lFiTrq0IHEMuvv_YkBhgOhQy8A_48jbEl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjRSjW88OZBy8fqaQtobwGNQFlTHwMw2B9wZQjhqGQvA&oe=6ABE7BF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8EcQv4gWZcQ7kNvwG1z20x&_nc_oc=AdqzRVYBjKJhREsPhVO903Ky7CjLwMlckevN7WcbN4S_W_WfzKJLWPouYzEoROdpFJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILujZ9t6F-G4GiG89pAug9-2b7YPrD8RawFUZayaTb4A&oe=6ABE7C3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq2oL4W259UQ7kNvwEw5d4b&_nc_oc=AdpdjYhqVcacXXWPFWY5D0nk2fQ5xncrLAI4FHPpD9IqLSxDF3W3rxCmzCjWJtQwCH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLulsOCGkehXaR8w4rrK37gFcv4e8WYOcg7Rp-gwrtEGA&oe=6ABE5588"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
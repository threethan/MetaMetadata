Zf_K1uacWuQWK8AdeHGDboNRHApudUDHvrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6V7yRWKvpcXQwF3XCf8_7Ce2P-FFTx4lCtnwAmlXq7g&oe=6AE0948B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgNQH-PZFX8Q7kNvwFf_X6i&_nc_oc=Adqt_iqjX76EwkVXRNQcLNW8zE18ElGuRQZvzSbrPNA31nx4Ddu45cZBCA9fGt26EpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh89dBVhlAJjQf-pbA5qBG6j-UHBJMpybXyHKW27WrmA&oe=6AE09711"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5ZDraNma-MQ7kNvwE_YE2S&_nc_oc=Adqsm3S1iQzyWGXdEE9AumaEo1cAsxl6mXEOu6DewFnsEc72Zzp02aIZML6sEXnVC9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd_jBNDBLgbMTIl7F_-tV8szOmynxQl8tYVLW43hpe7A&oe=6AE0C2F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCPFeDURz9wQ7kNvwFbq9A0&_nc_oc=AdrLSrhcqbfkaOXfZzYnk03n2-DKMvE3rZThtK6wvzyjPVkAMV_Lib7oZBo-Dqyf5zA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjBwjVRA-1Qk8MOQvKQT-1ef788rFsmPp7ozI_N4Ja7g&oe=6AE0C33D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7_9CtSaEqUQ7kNvwEDMn09&_nc_oc=Ado03bZ7C2Aw0V7gUABJGrFp-c4_8A2qeMoK5aKDKKVtZMlOXhDf4QKe3esFgyjUlZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ2dWHJYEOhk-_Q3-99EdPWOY7BNzw4lPvvCho9X5sww&oe=6AE09C88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommend
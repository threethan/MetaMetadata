noHK_pggEPaR_fg_n1GLf5yTBiyLVNFqivI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoPQA3e-kfbiNmdmar1U_C0-twPP-sh7_N1kOQYcsaAA&oe=6AB93FCB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TA23nQ7UI2cQ7kNvwGbrp6-&_nc_oc=AdoGeaEil0ss91zdUtiYM5tQhQs69180VTwEiQxJEPVbPvh1l4ulG2XCRVsHXrCpugM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnALMl26a-iPJJDeO0vf60wcR5s9GpHRBHcKn3G3a8gA&oe=6AB90A11"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcVawRddq4MQ7kNvwF5Yoi8&_nc_oc=AdqpwVjUdQ1qBk3AGKET63YQIc5d3ipWrfJcTqWvHRQNcvQmG8zEqiMWEq_z62aq6kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxCXhkSYAypQvXHvcKjCr52K7UTHWSxKpos_CKjtF58w&oe=6AB935F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok7xrSi1FVwQ7kNvwHbfxTy&_nc_oc=AdoNWd7PUAw2TFrNccuX6FlPdqi8XrOzNoM6S8tugx6Qo2s8uM--SOPZxFyKVnDla7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJglA1GrnEgiMDp7qpM6wViSh9CXAlZLHjtk-kwQ-jJ8g&oe=6AB9363D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-oDYfXc_ewQ7kNvwEpoEIG&_nc_oc=Adpk62toAB4lqab_RkVq2-xHpa_MX1dF7iCaQbtouFNSGx6QSvz9p3WlbF3yyV2DxeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwyHfA6nFBvHpmVjHuZwosgHQgSjKAZil4GAFmtY65xg&oe=6AB90F88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "484449673286378"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "992147197811945"}, {"status": "PUBLISHED", "id": "2162523370674637"}, {"status": "PUBLISHED", "id": "305044299943498"}, {"status": "PUBLISHED", "id": "278164952653764"}, {"status": "PUBLISHED", "id": "1740775762741381"}, {"status": "PUBLISHED", "id": "765379243937831"}]}, "baseline_offer": {"id": "278164952653764"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "PUBLISHED", "id": "992147197811945"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1271516292962839", "version": "0.10.0"}, "id": "116241648846467", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1099387316842405", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271516292962839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "116241648846467"}]}, "change_log": "Good finals are now much more reachable", "created_date": 1491910717, "id": "1271516292962839", "version": "0.10.0", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1099387316842405", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
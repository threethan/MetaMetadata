BDB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUNotNJcJdgQ7kNvwFG9JCu&_nc_oc=AdmCIrv8DnCvzXbH6LJ7VPedBjERyqh_OVbnuDnS_oVY0aQ4wEBkdhaQph5PEuXIg6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZI_qZ7wDGv8wlrcTdOWuYZRjSEL2Tx9TRJyi-BtfRjw&oe=69B15B8B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1610pOGnP6YQ7kNvwHXogzN&_nc_oc=AdkfCy1oig44G9CxUEs6BWYQ_8hbueecoh3BH1BcYSFVDiMmVMZKj7xVRtB3wo_nAlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw91VFO4bDoQBW5mKrjtqUhyEgMW6ML3vJtwqezAaXLnA&oe=69B15E11"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09h7Ur3izXYQ7kNvwGjYeit&_nc_oc=Adlj6xKuZukAv8SmfXFPpfc0oW1u85vp0_L0A2wSKNiOlCBPMkAeaXrBCj_5jKhuVb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkdXl-yKJFJhdG_xWEQP4xzK4ah57EncQaCQlGVqDVDw&oe=69B151B6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECR1jbB2Ep4Q7kNvwFK9bjm&_nc_oc=AdmLRnL97iF01OClNlNPLOYYKUQ2tLptPfg5qUT68faFeIRS95Xt3rf2xPAfe6vuaLg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7ZdMgP-ELH01CXWeXDFtWTzRSXE_xrRMsUgb-lTmrjw&oe=69B151FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Khp_u6yMNEQQ7kNvwGYmQgZ&_nc_oc=Adm4YSFrGWuMCMDVES_OOmNeeoAZHJ65O4AmRooyb3DmpYGTZqwEZfSGuL4gnmQyTXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHx54lBKP9COHv0p6h8iqrlu5RYKicLFmtJzp7lI1yxw&oe=69B16388"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [
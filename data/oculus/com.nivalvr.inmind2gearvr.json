&_nc_sid=6e7a0a&_nc_ohc=uSQ_jDAqjC8Q7kNvwHRVUK7&_nc_oc=Adry9tTUkLl1Gf5zFFmYuC4t84iU3_BGR9iMD5C_vz7ZaaxsMAcySH5uN-8WrGo3tKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3mUnethpieM-KCvWHOf-EslpIvdMcvwC6rQyDz2TWNfA&oe=69F0A38B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjfT4lNpUTYQ7kNvwHYV8ex&_nc_oc=AdoeI2yoJ6GGsZXCl8UOETd9KdjbD8GH3zJdjyTlrIE_EVWcqxmCSs5adZKCO4wRLZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0P_rLqEyX4bu8SZWIEGc0pGKcqX_fpCUkODpn0vAvN-g&oe=69F0A611"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFN6LddzP98Q7kNvwF4_hbE&_nc_oc=AdpUF1A1GqfUvheoyXIOSFnJBHnhslmPmDZhK15TuiK90E3so9zlNALKJTjVy_allIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1zZaHH15PFkKe2ytpbxyI9XecOhQZVL75B9_NUUY0Pfg&oe=69F0D1F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcScXwhSVNIQ7kNvwHQY71r&_nc_oc=Adqn5f1KX4EiFRipM8eU0n1Buq1ldmYWVp8YjylxIozT-bDCUeWNAeUMVA6Lnks1z2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2tgnadlVP3pQlm3WE_bObeWh5akvNCQSn1xlz7ae4HbQ&oe=69F0D23D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X10ig453fysQ7kNvwFR9f01&_nc_oc=Adrl9GtRnQ5-NuSg8Ke5435xnt1oUYPoo1sO9W0xj4aPeIUVp-0AAtsQ7WKks4sBMPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2nmvZHgIsKWLnLZNpD0g18gT5bz6Dy5_GbjSpNAc7gWw&oe=69F0AB88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
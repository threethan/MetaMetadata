8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5YBz6hppTgQ7kNvwGZiSP7&_nc_oc=Adqz9LQs1cYJ9Q-G7KN2iFIV7Kqbr6TCHuVWdqGRPAiZmU0nPIhc5FmiIYowppnG8aQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtFh6X-13VHdWwDIbiZr8aSEgLxJB_yPwnQ6HTaGKIYA&oe=6ACD069B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNN8LIe2ICoQ7kNvwHmiPdU&_nc_oc=AdpL-Z1QkDpPND0Ey4DDLBKmK4Bnlec65ZdnFxBVNbGYoFFDoiPvTAB9dontheFCuXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfZItWOTbEKL0oZmU6T332jJUe9UHkiqIOfdoFldayXA&oe=6ACD064B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cZ4ydkqjrcQ7kNvwHzBoN8&_nc_oc=AdqcntSRAGIKynpRojlkns6WEHy7YiPTo7g09iPDgL2SQnlm3DmTG5VvtFbX4AO6YRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-n1LOYP3gWDBkuuxJ5VmHCLBgISjq9tXIuw9L0q5HcA&oe=6ACD08D1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46EPinVtwecQ7kNvwEMcQvy&_nc_oc=Adp6Tw2k1JC0VaZ2VI6aGOoiVWJERLM5wk0KjG5kx5luNXF_LHH_Sn-fP05G_-K1yrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0OqG0KlP6cceoLlIue-ftjHq_01mT43cJSyYoCSmrcg&oe=6ACCFC76"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ScXwhuZ3f8Q7kNvwGA6y7w&_nc_oc=AdqsX2K5ORUSXvG6f0w7A0aeMUDe9INY8-1FLY6RmBbsi39JQm5lI9oOsi8UxD5EdwI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQhRF92I53M4meQXeuc0jLPTE3-K7hNJbHQ8Zp8V74BA&oe=6ACCFCBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXiDenJ-S_YQ7kNvwF7Gdlr&_nc_oc=AdobLAvHCGf-Nw4HUzmvn03KX-97Bzs5T3jSDA9hcZSgAucsQJlof-cPjzJvlCJJZC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUzY8B1wfEeoJNO7e-kxJlfbWkhKuVCyOB3ijuaqmxWA&oe=6ACD0E48"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLQzq5fGV2EQ7kNvwGBUsQx&_nc_oc=Adqi_wSnoTou-C3uSKYgGwHU25rJXIjWb71N_pF9a736tAeoahwpsnhdZfZCZ04oPBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGZmzqTuso_K4ElXG6N10juxer-RBIortAgAIDOyyByw&oe=6ABBE31B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTEk22-ZqYUQ7kNvwE9hAu_&_nc_oc=Adr3esI7wzGIaBXg_Cmx98rMvUI1GoCoduBnzuj87hz4VJdVnb9iga17HIEE-oIU0ZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNzxYIO5MXZ2dhThh_zk6T1JawlF9YQq6BLl1PZaoVVg&oe=6ABBE2CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMJd_Ha0pxMQ7kNvwHFjTus&_nc_oc=AdruH_BBVR0pQFOEoCB9vxAHQ0x-ta53henghNdvx1TzNLcLh-71ijy0zXkUjnnb4Fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOjpXkPjKLRhqoyZYAdCVcX_DIb2acOUsq382yKeEo-w&oe=6ABBE551"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OZYJFVEjCEQ7kNvwFI0JDd&_nc_oc=AdodH3yycQmcin82ug1-lN3ki1WtaX1WetqcfHT_4K8fRPf_oYuFSvzPGW5xjwn7_vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTuxzCzOTLMX9OoVlOeegVusqJmbPVDEf-xgrU8DNEhQ&oe=6ABBD8F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8EcQv4gWZcQ7kNvwE66J1z&_nc_oc=AdpG1gLJjxdkZStdF3qCKZwNt2aB9SDv71lARD2YuhKCps3gymfkxXPH_5ONzuNmJNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSgLg7fAcQRt1AjGHAvTU1Q1OuCPUKWB1oB5fCVhrksQ&oe=6ABBD93D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq2oL4W259UQ7kNvwEUV8I3&_nc_oc=Adp6MmpDccnkIzqln_72AFpilJ9okJLYuE9U-rzZVIWKkMhst2VdBgOb0NQZce9UxPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoWOppOI8YGLBEWSBPNwI89a0ae8u9CeGeuIHfoJZfPw&oe=6ABBB288"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
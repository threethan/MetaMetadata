8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfPxZoYr4NoQ7kNvwG9guYi&_nc_oc=AdrXlsGqbmuA6zXd7GSu5G4TyAJOTSOqQWxgJEtWqNh44sKWVeEkfaUxh1VC6mQ1dYg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjCSSJFLyLIdOo4Jau3RsnXMxxoxRPzlg_gY7g6-YSOg&oe=6A9FFB5B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTHLDJuz7DEQ7kNvwHPtNhx&_nc_oc=Adp3x5Svxn6r0iQCikZjeQyJBCRlDuCSznTikRj_bZ2NSQi1_Pm1X61Hh49Q45dYHcs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1aOGULvmJN0dNsJOUxojTJHXagrQxpBS3E8HVdWyL-Q&oe=6A9FFB0B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC5XFevg7OAQ7kNvwFxJAbc&_nc_oc=Adp5fOnkI9wyMohgXzZowc4gg2HejHH_bRSvq6BWMTgCkL2b2S0-SXp_Fj2ppFYupB0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMnuijKde5tbYr7MoV0ndJ-s7U2RUsQA2xwoQuTsI2Ww&oe=6A9FFD91"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0muKo2-JVIQ7kNvwGr4ICK&_nc_oc=Adou7aIJ-20heDmSCAHEEl4Qkyyb6PJDeUU7OAg_uoCDpQVvLC-TUZNP79p_zOuhuRk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEQhT-iFxRuX5nDqHklW14RRdlp33BaoRv9DwRY0yePA&oe=6AA02976"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlxBiyI6c_EQ7kNvwEfL0Pq&_nc_oc=Adql_pxX2ec40LoaLff_LDCuwLpR7abXGZncGpDnPzERuuhgnaWDt98PkTUzsQJ-KS0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPWErGP8_qVoegzhtRnFz6z_swuZ9htQx5uVLf1B0U1A&oe=6AA029BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Syjswk2fGYQ7kNvwHjdAL9&_nc_oc=AdpjqZOfuCzEWF4hLZZ-vSExi_3wfOZ3LpsO3L5-CvJzvpI6avxTM_iwBtTahITMsxM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpQE9CPds5924lEEZsyVu79fSvvHEHJTbDoWoqAR_pug&oe=6AA00308"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
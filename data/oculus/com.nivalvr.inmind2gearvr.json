&_nc_sid=6e7a0a&_nc_ohc=s0ml4aLDEoEQ7kNvwHfrBfW&_nc_oc=AdnlBPeFd_3fXVufc-1WGpLAhu8DtNeCSySHUYty9PjmBIqx6fwp-2mVgqsL29rEJFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6xYIyDZiU_mf-da3BII4nLrSyDm0CsclCQ3I0HXPyYA&oe=6999A08B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8d9iVqxrGoQ7kNvwFr8Mth&_nc_oc=Adn1yv_GPxs2l9RNG7UyBbVxzQoADVyvcNxRgqoJuLbwymkTyp8qVpnw0Kvu3YAf8zA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu__Qv6fXTA1fCk-qKK8UWSWWlC-73rD0tNBknfNV0auQ&oe=6999A311"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aaat2CGoRBoQ7kNvwGomoVx&_nc_oc=AdnaZlq6MQJDn9p1E0dxCPoko5hJ7MoHs16dfc0RWueQhOnB49HRpOr6s_cJIP7A0kE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZrAflNAgnFB2pX_-ENqMSPkLjpsYzrqPYN5XXRF9coA&oe=699996B6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4LJjMz6F_IQ7kNvwHJUXgi&_nc_oc=Adla5k3N10XtV71G-EMziS2Sc2nTYUYUfqd_9M0s3TEXYRrQt7HHwCfizgsDKcZlw_k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2skBtaKzeI1QC2bQZGDeaqqtHaXWc6wXzmExPFB7AbA&oe=699996FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQQ8rw3GfAYQ7kNvwGZRq6U&_nc_oc=AdlFufRb6hHGWX-Ch--HDA0gp9LBDBr0HVSaTYtHqJeYDm1apF3YXcok0Bgqj6SGmVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsutRcdMVJAzNdcIZDcr8SZQHVGp5SP2PTWBDq61O81gQ&oe=6999A888"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
bVtz2p-mie9zWmeCeWzmU6JJzCKybnu5j0M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOPs2qNmnCy4_caYX8vZv61EXh2WwQ6BtJF19-thGeTA&oe=6AA6928B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrj_zJ1bGcQQ7kNvwHODZxj&_nc_oc=AdqhLR5y7Uf2AN8GsaQDIJnvswDwQN5NMNl3seLnRlwKXe9zUMUNQK5oorHCNFNIVPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLse5ZB7jGyA9eG9VdBcKLdCCGknbqvBaf_BF09N6jUOg&oe=6AA69511"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTQo01dXnN8Q7kNvwEU0M3_&_nc_oc=AdozPEs2cYJRIPRcDo7vqF418DiBTR1y1esRewe1HR81rmhJvfmInmdEhotBb3fldqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvojm8Rghfa6uuYnpYneA4Dvztv0tOV4Ae9M_ODeBN8w&oe=6AA6C0F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lrhn1ykiYIgQ7kNvwH_2ojj&_nc_oc=Adpm6WgiwT1UlEXBQfccoglHFqFohk31gY2nmSIfxk14BUmp2PB_4kZwHZcvI3SZv_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV132rPyd54Xz3nNczTOD4yhHxsTh4kejt2xBdtLez6Q&oe=6AA6C13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE7DmOJ5rncQ7kNvwHWfo2h&_nc_oc=Adpoe5GiYf6MIlXfePm2WJujDXl3KeqMZJQLCJYaww3BMc0KxMySV_5aV1dRKoL815Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeUb5f5aiZduq_gSuwHWcGjdeCiKtDRxOXQOtZ0_08bg&oe=6AA69A88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "484449673286378"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "992147197811945"}, {"status": "PUBLISHED", "id": "2162523370674637"}, {"status": "PUBLISHED", "id": "305044299943498"}, {"status": "PUBLISHED", "id": "278164952653764"}, {"status": "PUBLISHED", "id": "1740775762741381"}, {"status": "PUBLISHED", "id": "765379243937831"}]}, "baseline_offer": {"id": "278164952653764"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "PUBLISHED", "id": "992147197811945"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1271516292962839", "version": "0.10.0"}, "id": "116241648846467", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1099387316842405", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1271516292962839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "116241648846467"}]}, "change_log": "Good finals are now much more reachable", "created_date": 1491910717, "id": "1271516292962839", "version": "0.10.0", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1099387316842405", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
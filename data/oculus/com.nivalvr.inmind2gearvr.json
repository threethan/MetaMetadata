8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLy-kBQtQGsQ7kNvwEA_IO9&_nc_oc=AdqOak-GvJfwKoscw-Wq_yuz6k6rEh_J0mQaPiCQei5DBioguM_VftS-v5Sjt-3lV9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImiNmlxEFPnweDnLU58WSLcJRRlEqCLYTwwQBXp9fJ3Q&oe=6AB3C1DB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6QxuK9PlgkQ7kNvwGnf17_&_nc_oc=Adp7bikJtiA1fu6O6nwg7-15rsOFgswOmzuHhfnZQMjIrIiQmQgDezF_GeOjvLGImaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImB6ExSKslwkP-FJDB4JKg7Lltah4QbHzH7jAqN03M4g&oe=6AB3C18B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS72vb_xKqQQ7kNvwGCCp73&_nc_oc=AdpTgdzrFhBtZak06qiAZCFAtBXWpAa_rwRW2ODhwEoQQnO-XcBEO2QdrYQF_g10HLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRDXGb2T1Sw2FyB_VuDKfF1cGiSF1W0V87V4TcYTG3kw&oe=6AB3C411"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpf6o3ebvvEQ7kNvwGD2dZR&_nc_oc=AdonhQWkiDHxBneDHRc9L_C3zBNav_M1tErOXBKsHIlxQl7w2oGAkCEOdAWManCPy4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsCLeci3wN9HfQIkUP76xw1XyOCKOq51SCh_X2cgkJbw&oe=6AB3EFF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLN2d_P_bwoQ7kNvwG2MstP&_nc_oc=Adq1yUJDNgOxOD6pUlJ4Vr9TUJ9YE-P00JJgC9LABnnx-vE0XH1KyrXy1tGojodaQlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbOvzpt2f0K5OMqXG256JSdeYqf8M6Kuh7cTleRPbZaA&oe=6AB3F03D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r7w-nTFlA4Q7kNvwEvG_R8&_nc_oc=AdopTby4HwTlUExvtHXLL2vFF5tKNpH9dN6kPEtKB8G0QMhHTq00sjDXvKuTZq7NxFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsmtWQjbJh3a97ScJFhV0fFZ55b3get5wiRFgGl_2jyA&oe=6AB3C988"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
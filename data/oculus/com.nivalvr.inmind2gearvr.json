8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O32o-EtN9tcQ7kNvwEqoTWC&_nc_oc=Adq-WlVJ3wfS4q7RR6bLALsWnCsStynq32K3O8xaUpkF9OhCPTLtaUZJxztgh1JvHZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtL-Gx-ifJBQLzQRrkDgnjv-AlVtl8_s4kredCfkQ4Kw&oe=6AF3421B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVLYBMqM9gsQ7kNvwEuIoF7&_nc_oc=AdoazitSNbypy1fVW5XpC9jPVUY8kJLrE8XG3TaReattWtI8IENJJGNN-gZYNYhb-e8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM4UQnKG51TbMkaI2_C5Aet4RhARbDC3p0beBPbBSRKw&oe=6AF341CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg3u0M70Mx8Q7kNvwGnKOPV&_nc_oc=AdoLYNz0AsTLfAjc3r-lWGvR7peCD75fTq_W1jdwDDRdjfHWB6YhM5qYk0W5_t8DzHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE4ZOIJcSAvbR-feoRIx3GTwahiGmFzheC0HAN-Wntfg&oe=6AF34451"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfhRKsrjOf8Q7kNvwFUpPAn&_nc_oc=Adpu7v7haq_THaW_tZ_7ACaK0A9xM-oTdAuchQEJ6NavPEqIyUhBMmcmUcbhXjIgYG0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgFcVZF_Q6TO85WvvD009uTHP3iqyC_fkIJxx5PuoJpA&oe=6AF337F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAMOfegdspMQ7kNvwFT8lv3&_nc_oc=AdpzyY9spYV9zUtuQQ_g69xiZt5Lw7wCcObgYKEBr82f2BecQhcf-6u-kg_FYE4Jnh0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDZsYgZDyzIHtoE_96dY66LWhRd7uGX9iL5Pr1-akH4w&oe=6AF3383D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so_c2xDc-O4Q7kNvwETZlYU&_nc_oc=AdotCtFNElheh4_TWhnUOAzqiwQzm5WG8NiSUjY5QQseZvdnHmK6qPnXDq6_RXS9ay8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcJqN1TsAGS2EfquCKtXLwK3v_sg65ETWCLcR9Hf093A&oe=6AF349C8"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
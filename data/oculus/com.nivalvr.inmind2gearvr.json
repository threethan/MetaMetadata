9817088000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm0xZ5U8iNAQ7kNvwFsWPj_&_nc_oc=AdpP7F42GpxH6qooe2tOr3ApfZLJfm2d7HW_SDs8JqhRRtYmiu5lOkq8YZ4nmdMkL4c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqSPBzeAhxOO0n8MvFAsLq-1RyXyTPBV-47P4bpF2lzQ&oe=6AA3EFDB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKM9zWCO438Q7kNvwFE4reN&_nc_oc=Adr_XmiaCjVSjH0juFvw34JhPyvul0KJgRdVS0chdgg_5I3BTBpj2hlTYIhNvvwvhTY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_7-bUmxB3KHYvk2Tgu7jbZ26NuCcMfv7ZAkhu84-R0A&oe=6AA3EF8B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn-lSKwANDoQ7kNvwGnAA2h&_nc_oc=AdruYEGiXGbVgT70DS8gDRZgqNMi7vfaA0EtSE5tihukyqqaN-mvfykalM7e26t0G2Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY9IfIQ25hEQv0Eqit4-BK2_MJhJWCwhpjeVwAmVtLCg&oe=6AA3F211"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZiF7QpJ7OIQ7kNvwHx-iJd&_nc_oc=AdoPCt2kpU5ujD9SxhdymgD7pPi13ZBPEsAQQT1BThVceq2KahDm6mXpyCT3bZt50DQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdZayyeI4cf0TJMxMl8LXT7yh5LZl8WsqCq1LHqFSBjQ&oe=6AA41DF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lrhn1ykiYIgQ7kNvwGuFg-W&_nc_oc=AdpaQlhKUWKC2Gdu6IwqD8lDyHiNWt4IIlxlXhfxyceHJxWGqIgYayt7E15wpDDjLLU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjVIvTqZGNjvT5HiV_3uTahLFH0RQwJ6aBGTBM0PY7nw&oe=6AA41E3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE7DmOJ5rncQ7kNvwFMpx0b&_nc_oc=AdpSxQhzrE8xu1APeeWLWkBXWbpddcAmwNU0ww32Q3tR4TCulIOg7X9brS-89OmqQnY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIje-84tNwE4aLO_TNtqTHsdhYjxCfpf4Ifo9xAwGdS8Q&oe=6AA3F788"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/
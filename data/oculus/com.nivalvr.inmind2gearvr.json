iWNQSz4wTzsCKS85r7VXV7cBmM1zNIVKqxQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtAj3ckCPGg0qQWia684B5_4pMemzGjAjtp0AO55L1yw&oe=6AAD624B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmCx54Z-yyYQ7kNvwFUrIKu&_nc_oc=Adq0S5xBAwa3Yr5UTPil3YZ_Zq_oXJi5hFFHnYFcHBG49LgFaG2sISR0P2fVvZ6NCN0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4RQfiKs3o_wtXYFHOV5qXuPiauyO5gE9SpCoBY7goHA&oe=6AAD2C91"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xr7G_yk2cKgQ7kNvwEqeJjg&_nc_oc=Adq5CSwMYcUQ1IS7QmCu9bhv87oa5bQAGuHKM4V2yV7VhbA4ZUZ6CKnTc6KqzvVF_NM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOsui0eSe9RNNqDeZyLbJ0VcTogG79xtGg7rR6sDjPpQ&oe=6AAD5876"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtjilefQemIQ7kNvwGiJl9W&_nc_oc=Ado80kOMevJsfnkOVyrNgx8HVg23V_51wrXDD_dukn-YsHYbXB2sFpd8S47VcGDNPx4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXYDTNpCaETNA8Ub3mHwtWMa89IP9m1_PhRGsZT8geZg&oe=6AAD58BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0eKbBuGH28Q7kNvwHajzg5&_nc_oc=AdpE6_UU-P667_4VAVeceYsZvYtfF44KlXMBZvde12H3uDtc6dmUI-yumCMjEhAJpS0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV7z_mGKdaxcUcbrFWO18H4I5EN7oBsJa7fAua_VY2kg&oe=6AAD3208"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommend
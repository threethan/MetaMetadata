&_nc_sid=6e7a0a&_nc_ohc=WDBXdtLrxAIQ7kNvwGX_Jim&_nc_oc=AdmZD-7cTkmrjmdmbr0laXUX-mPyzMk2-LryaRUULia3twf3oFyWRWN9MAaiChN19xk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvmMigYw9EmuxsKobng49UL6MBsa6jZR41ILBDfAsjpSA&oe=69A42C8B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMYDaJGSpqcQ7kNvwHrjod2&_nc_oc=Adk96BB7xzVmhyWTLmHh4_m1bpo7aPEPggSU4dWNay2IAmH5DmkecZRdkFNh5nIVy6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuS_HeSu_GmymfrbNBru8PB6OBP8dn1IwtZx2gGygJKhw&oe=69A42F11"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jQW64dRRzQQ7kNvwHp9Knf&_nc_oc=Admyx2V_n4e2SlGWpLde4qIRumw3FwGn997hj6FRpqtmYtJe6ZCLlUcXKDENp84udYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuOMr0J_8y3hkWnnzowvgDz69AglBRrUr0wBo9OpJbUCQ&oe=69A422B6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATjnn340xVwQ7kNvwFcwT6I&_nc_oc=AdkIAi6-hWxD33T_jnKOsltBARy8pV1RoSoRHmVO9rJypyHp5jG5R56WstgxGiER0W8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv2nQ6WONPCeodUsC82KhCvzCSxpVr3HqJT59OTXDUg3Q&oe=69A422FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4B0lzOvJ9wQ7kNvwHw_aJr&_nc_oc=AdmEtB4Rrz0vaCqt3XUtfDcLonVRCGCYkM7733XnM50lnG-ISNNBv29joqLUrGWuV0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftxxPP4sVZSjOe_JaujMEVB4ohczvhbVrahQw4ndfiqdg&oe=69A43488"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
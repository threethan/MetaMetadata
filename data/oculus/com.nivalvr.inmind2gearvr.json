8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raF3JTvw-_kQ7kNvwFFwj8N&_nc_oc=AdqA1qNEdxxF9B19XdkEcXe-wPxYH_J2FdB7smb41nkCO8uf5GfiL1yGgIqpte61ojA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFTBO-JYE9ln8m9yHVlQVBgCHzZ5QQ5y9z3aDm3O5cxg&oe=6AC1291B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQDjUE1vN9wQ7kNvwEA_waG&_nc_oc=Adqom-g0c9QT1az8WpNWvg36gnNJ25Rm_uj3t1Cei8Zn3c5t3iH8IP3tBhiwx3cYof0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTCUJGbs5ZMdiVlEmQNi4kipDUrOhwdKx_N58zcgZZTw&oe=6AC128CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MltmDoHk9q8Q7kNvwGlj598&_nc_oc=AdrGDKs6_ifHOlOY-XU1NSpramW8BAewVN2tZKbvuhkuar3EYBtjch4jazFJiMrcQms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF7ctTHAJw-aR-tCo0aHumR6Yjjx6s2Hf2NrvwOWAnWQ&oe=6AC12B51"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWpc2_Aiu3AQ7kNvwE0JoWs&_nc_oc=AdrKXRkXHa0_woKiGo1csRvDgIKxlRtNqyPkXMtpcNezu8ocqIrviD0o7X46Tw0W73k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlFO_1-w5rg5yXFeSex869HUEmgL-oggBUgNwoZ42gYg&oe=6AC11EF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZNEFdM0f5cQ7kNvwHo5jYk&_nc_oc=Adrz0o_x2LPESXPAnKyQIO9JOklSQ-e2CLZkNoAstriqAnuEriVbzDrQDbfkXaqaa4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA_tFT8Y2c4Mnht4jndhn7DCGSn522C635cyUqY_DmUg&oe=6AC11F3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNWgx03QM44Q7kNvwHbG4CK&_nc_oc=AdraCXQqJmUClaIsV-XEAMUlW-cCxkH4DeBPG6WvYhS_yxQdjhm9fEitJvoj9FJWhaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfmupFHRXxU_LqONdT0iDL4ndx_UmFkrSzykj3OJBiwg&oe=6AC130C8"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
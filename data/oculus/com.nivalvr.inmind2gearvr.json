853qJN9U3l_gtODDIVr2ESbzrk-vnfeXf_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIE1Oh6Z9ooYT_LckA2WeWx8xGmrrdeqScYqcs7sNjnw&oe=6AB69CCB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TA23nQ7UI2cQ7kNvwHGbyoe&_nc_oc=AdrkuSFyKrCgqXHZo1-P-QLR4it1UaXnG2tMt44BXIi96Z2aAGWFfzRklEYtvfmVmXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4YAK29nWNT4wHSd-RzEWrAM7HNbaQp2_4OTSrBfhRmg&oe=6AB66711"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcVawRddq4MQ7kNvwHzdKvc&_nc_oc=AdqxlAe5IeYcTcREgSB07GNJKkgcYjbPN4bszPPEX9dhRWnIiWcfs3Ar9hcEzqRT2Kc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy1LggPYF7cxVQMo1a_poIkyFyIgozBBG1-q-5UZs95A&oe=6AB692F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLN2d_P_bwoQ7kNvwEtY6sE&_nc_oc=AdrcoAFPP6bSu8Gi9VBnv1y7sI_4traQ1XR3863yUWQCRwlo93MPfMiTXlDm6-sEIYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgivdvwCpUIOf3eqgk6jrOZClUyHI0QVtF0HuK5wM4iw&oe=6AB6933D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r7w-nTFlA4Q7kNvwEk7xnt&_nc_oc=AdqOV41nMF4lSPTVk94KIDKIXT2mPrjtG-D01nCKa8lIHnHG9He_SABWLw92UmKtK1U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpsx0wJtLaJuxL8ODeapQQkT2sbsPk0F5O6YveEo6SQw&oe=6AB66C88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommend
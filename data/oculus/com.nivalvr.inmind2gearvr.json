8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8tkhoiySsgQ7kNvwHScnRG&_nc_oc=Adre82D_ee5Au5TmvuKXBy227GVPMsqxt4n0OyvKToJyh40PJ8MGwgD68fofzxrycfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ51-v2ZyyHRhdx7oq7WEYvA0uEvYtcVS9D_HGGVrkP6Q&oe=6AEF4D9B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGD_pMw0cnsQ7kNvwHKhLA9&_nc_oc=AdoXDAloCpT2IAO8P_H_ycfM84QHrOYJXMng1QtvMQn9pywBiXgivA7Gp6CSq4MLdFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlxVSIzPch3nBS3r-nUe6-5565IOKMC93W8agOcrwH-A&oe=6AEF4D4B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5vR_5eSEW0Q7kNvwG_vRCz&_nc_oc=AdrIzQDuMamjY-Qc1ADqmq3V4eUpkDornAZ0M5tnpEVfv_npPKOhIr_-yr5YBwUDtyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRClRhgJO2G6Rmdd4chtRFlSH7-TLN0W3jr73dgcCza2A&oe=6AEF4FD1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHqg-cduwEoQ7kNvwEWbbIv&_nc_oc=AdqLB4GnzvZ6vArMbI5xq2ys-CMYguR6qpc2VAbfhImjME16b9ROdXocAufwHI4wYgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzIYWS_D8joqTl_Wk6ocgqouyb_NZyMw_DpkmbQtgDJA&oe=6AEF4376"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8eY3ssypC4Q7kNvwFL7nu8&_nc_oc=AdqYXGTc-jYQoG52MUHLtnb0gvXHzcylzMlMtyzusQaBUvDGrHR9a7uNC54YK95zfdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlM8lE1FAQ6bqcT6NaHnz09UrfNc8JFEbMhNTvSZU3fA&oe=6AEF43BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne8MmvP3ZnAQ7kNvwENEIwQ&_nc_oc=AdpCtzZ6dR6C11ORO0K1jbz8CnhHg_p3VbTrq36-07enPX1k8jbuNfBAUJhvFpNlISE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGKFIqa_dlcLEYBFssNYc6YNsY_5TxSH8y5X-SsZdA2w&oe=6AEF5548"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkV8aC1B0p4Q7kNvwGaL5un&_nc_oc=AdqszEqQI7WPZU2xemNZ2RRoZ4psVxB1NSuWAldecgzP9VC-pvDk5O64JFMgBWKv4XM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdwU7WoVgTlLk6hH6fy6HbOAk2w-2UBTgfZJL3xMYOCg&oe=6AF7369B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCuqof_7e3QQ7kNvwFryjgN&_nc_oc=Ado1SfkOmkDYffDx1a-VVP5QAaP-Rp8Zm-hpAxHoK3Pfi-CUvsp15yD6UalwMJbZlnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSorxg3_cJ0vhJWNWxGyzxY709OndeEfLfK5QjOFb1xlw&oe=6AF7364B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqmZxou_pYEQ7kNvwG6E_jO&_nc_oc=AdoOx4zMpSswZkDHNNvQhJsqqfDilT86ddeIkNChZHqabNOUQOK6luwdwQXO1IVKTRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRIHWH59vlA03RXEz4TxGCrflkBd12D59RouK5JRhWsw&oe=6AF738D1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9ZQRv52mSEQ7kNvwHlQ3AD&_nc_oc=Adq8pO05QAeUwYeQDhvV_kpo1VA6FlH1bAVLC9nBvGKvVcuaTz09aG-mJ5wF2S5o3JQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg19PYZTJ-VKCZdodcyWCecapuEdjc4dbnhqZbmc5tfA&oe=6AF72C76"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG3s2K78qOoQ7kNvwH_0wAi&_nc_oc=AdogvzSQal4yYOB3XsdA0CEhKs6af0eVJwBd6134OnjriES5Uuh06wXzEEv5P3csfD0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOiqvyRyzBXEQ539n9zAEe7ySOO_1AMumo8v9sXfhczA&oe=6AF72CBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIlK72e2ircQ7kNvwG004Rc&_nc_oc=AdoLLhHm3jOn1eamz4TUiQxUliiNn2blUksw9H00OVOEgp_AeKDnPfKQojWxr162Acc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGgSQwEXIB4qnzVJlR8Y-rFiRSIfQlLTCob3SH1v0IBQ&oe=6AF73E48"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
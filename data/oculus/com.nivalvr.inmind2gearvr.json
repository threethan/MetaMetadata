8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGgkOtNpiN8Q7kNvwEuYjWl&_nc_oc=AdoUXKbP38LHXz8fvRiLWc0-wAOPKM6rSCwRRqDs5hSEniA28BSnUVL5ZpenVR4Mgg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF3QUX9ft7LxTyL5h9nTmKD9q5ez31x807FCDYP0st5A&oe=6A9C3F1B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc-5CCrKGqgQ7kNvwFOHJPb&_nc_oc=AdqaMtHDPLoFjSqjQx43n8sxkQLn86XGlce983oYUjvvYPdadR0GM1qHofNb_4T_Fyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFpqAJXIIIB8pM6WY87p3eWx9Oiyx8HegJCoKOe2Ytiw&oe=6A9C3ECB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3zLZlXQv3UQ7kNvwHBtgzp&_nc_oc=Adp2rNPVqLXz4qp-d31E9dEMyo1cRTUIb7B3TwMEIOv7UkIDbBGMYtYCDHlXX071v2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU3ZrXE_WoQp7nh3yMV7JXGCF0SIpYoAArur9neWmJ5w&oe=6A9C4151"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vl-dT9iY5AQ7kNvwGcy9ut&_nc_oc=Adp2upOuvSinZ1p1fTgVL8vETedOFgdTcX5xu6n8OW4vh0HSJnaZDfyXKjq4htZBPWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjClECQrYJeB85yjUKTaiF7g1KaszO7xnpNdzK57aZYw&oe=6A9C34F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_szmuL2pPAQ7kNvwGtDcWQ&_nc_oc=Adonq0hcjzImmpIO_r31gyb4lmTlewbgIBx3UXgiJN3Qu6QyLIxHZGeP_z9FcPl4-SQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjGw1moRNleoHqDHVErTsqM577S8M_RO233wTcHtNDvw&oe=6A9C353D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfiaX4X7O9sQ7kNvwETzP2g&_nc_oc=AdoQxX2yWjAfxd1VoDw0Xx81Tl8Zi5dpxRINOEYcVtZ8vZKZdwBqtGUhePLSiNf3M0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2cEMsXrSeoboesTJXzIamA7oyqqmeQyb5PdDGFN5uIQ&oe=6A9C0E88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
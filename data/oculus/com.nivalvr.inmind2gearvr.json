8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKrf9SRuVMwQ7kNvwHppbaI&_nc_oc=AdqmqGB-Gg4dTXzg30bb1Qa3-ZODGO9TkQO5hpahMMFLrhS6yhAVmsJmGoMWRzRuwpA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrNoURccRZUvzE9MP6kHqgU-iF7bQud-J5nPM9DbcAJg&oe=6AC7C09B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUz87THmaxYQ7kNvwFtI4Rq&_nc_oc=AdqC6z3gD_4uq2h6_vVG3k9pYOYHAubyvHsQxHtDLt2YutjrtdCXJX3vuFAjl46sPxE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOsQTWDCwFuRY43I3be7pRJkAmGa3lA-iPW0BfiIjnEg&oe=6AC7C04B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzv05pWRxfYQ7kNvwGDkX7h&_nc_oc=AdqSkZEca5hhNBeeCAm_QMw3nuVC3qnZ6IXqqlm2D66Wja3mbQ7Qv4GsqM_uKVLAp30&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsdvOs4FV-sH8OR_e-DFTQGdTLIlV_syauGgL3ar45fw&oe=6AC7C2D1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9XWKWwfylAQ7kNvwGapQZs&_nc_oc=AdqIqXLfYlfNyNpIGUCbK689ujS9gwnhPKKWoJh8RRtJ1yLBQvxHT0g0kX5exTubYv0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNZ1pRfdHSfaZUz8STzr5OoanOYgmJGWUwbg1wlZvNug&oe=6AC7B676"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug5hlKjEq-oQ7kNvwGitETS&_nc_oc=AdpZirsJO_UYNgrIiDjnUqvjC_N2XteAjivPvh4mmGqO9-9TbbIJ3ZnxpPdTbe1K5cM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa4922LrDAIgCTACs5PvMQi__DDzpYvh_14gg7CuXnaQ&oe=6AC7B6BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mccCQzm20DQQ7kNvwGfe5Rs&_nc_oc=AdotvWGMRvEpCTaQvAK7B0mrQ_PZ_zz-jtMJ7dD60lQles9uizBEeNqB_cnJFf6mulk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-erfyt9yD4V8vqigN8xE9BnmHsag36P2uSZtSt4QUHA&oe=6AC7C848"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
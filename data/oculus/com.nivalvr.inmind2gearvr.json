8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdNOj1Cd_tcQ7kNvwH-uy3B&_nc_oc=AdqnboUD4ieOn-M9YuM5RdDdUQh5iEFGHKvA-nlhit4jSpi8frjYyan18K138czYo7g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwC5ugFP8-1NX_meZDLZNL5xh6SmftYCD-mawoudVzxA&oe=6AF9D99B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCuqof_7e3QQ7kNvwFQhhx_&_nc_oc=Adp5W4-U7x1Y1i5o_CupAuQ9F3kor8BpLAfS-VI3PaYecy2lp7XGJqurQLMLKv6Fik8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7WH0tUOIOlhxG6rQqZGfXtrmS-BeIOOaSv9Z32skcTQ&oe=6AF9D94B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgxvCVZtFeIQ7kNvwGRpr52&_nc_oc=AdpR3PAFUF0AMFZ0cZzPpap0OJPK1ivKHMw8IZdyiZqGBJKWJ5cBisRfzrLho2yIAq4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSZnFQhGqjt5ndqL8RaEijM5Es4kYlEG47k2fKHnWZwQ&oe=6AF9DBD1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3W29nxqFVYQ7kNvwEHgsUR&_nc_oc=AdrErWb8Kyeks1BhsMRABV3nCLIOi12VYZyuFCjy41dPmMdSaIqFtcusnnoHHc_WVXc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6v3SRmUGHqg11JqtrmQLv2NMnIx_blm7Rq0C_tdx39g&oe=6AF9CF76"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG3s2K78qOoQ7kNvwHVlm5L&_nc_oc=AdrvD-LbVKsKwCWrnbGnoqCNyHlNKg11CHT6rmb4vkyw23Dek8XedEBxr3Wrh2EQS9E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmsULJC3iKbmJruAPAcDmEupVdfORkXDDyTy958tbLMA&oe=6AF9CFBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIlK72e2ircQ7kNvwE6h1vw&_nc_oc=AdpAOD2_77CYOYs2krhFYyKXkRgAcqBc9eLPq3IjFs2ABIj-bjncfUXlFjHoLgvoj7A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSBgtChuam462IwsZli4-QyDerPZT069TUoHCll-FKIg&oe=6AF9E148"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
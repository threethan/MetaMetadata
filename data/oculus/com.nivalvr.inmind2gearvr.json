&_nc_sid=6e7a0a&_nc_ohc=MqTlFYlGGUAQ7kNvwFXVELa&_nc_oc=Adm-rGx_rq_ELTGJvykyTgeqjWU6ezyh7VD5T_f_gYPRy3ij0_RzWh--VtniHPGZjs4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsoGrfcNDtOsk2ij9qEAU8fPjvfrwpZOYVdHsMzlzpETQ&oe=69A1898B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhYeWEiImq4Q7kNvwGQzoyB&_nc_oc=Adl_0foqOMfWkXo6kB-wO0ut6CWORsmMy4ZkQwtk3Rzp9rTfZdXwXbOb_bMp-TwFLoM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvV9hQxYFz_mJreDsdeXmK1P54Fghx3Trzk9SlfK65Zcw&oe=69A18C11"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jQW64dRRzQQ7kNvwHW-28M&_nc_oc=AdmtznRThWaRgjuax88xqPIrZLO4NqQPhITM6HwJWOmbKkKoh6_VGCkukf0-hVL3L5s&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs5-epAAgutcG-zkdY7JqOhSRyhUp4yCw7qsljiNaxN8A&oe=69A17FB6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URKkC-xhA_AQ7kNvwFCTNOk&_nc_oc=Adn7j16sfZnziHubVTklqQkFsasI_4XVKDnXbFsX4myv_wFymGX-KGNyZiI6S8JXOQw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afujpd8sr3NNdyjxJtSpgdqzK69o49ljVqV3Q7l-iuGRvw&oe=69A17FFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rgAkhUcuMcQ7kNvwHf7nhQ&_nc_oc=AdlGKgTKgFtY5xdHkKOp0JMVzKT8t02EJTN0jyIc14vvjSe9hqiGfVn2JukrqIF_b8U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afskr5T1b8hGL_A7m12iSSXETE3722RRYbzM4kijoxovJQ&oe=69A19188"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
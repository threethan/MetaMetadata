3tfGkKr99xhAhQ2epezb6w1STTBmZ4tZIMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK0O1et9AeRwHr77Qg_fJhQlVMdTEJsEAv2KX2-Azj3w&oe=6AF1F04B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg3u0M70Mx8Q7kNvwHiyVpx&_nc_oc=AdoGtpMuwkShaM8-eiJxuEQWufj926NhyDhSeVd7lh2f_bAD8Ulv_3sxnxm15BZ--jI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUwCtASvBMkYfP4FrEGyfdkelm2qY2Gvg-CwANme1dEA&oe=6AF1F2D1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfhRKsrjOf8Q7kNvwFpj4kK&_nc_oc=Adrc966UHZlWEijmiKttuZA1eLZYnYEnFec5HhfztTJ5RYS8qkZG97O7TLtNbpsL3u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSre5lIV079W2lP83zdfpRaPj5Buj3dAtk6prYk29JX_g&oe=6AF1E676"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8eY3ssypC4Q7kNvwHX8qRa&_nc_oc=AdoiEmA81xV4klWhD1vyv4x-dwDA94dM3nDgJnOmL6oeIuJT3qz68BwYq56xFNKrPO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB_mkcj5AMfKpp6cfyYNJZUTTWIYNOV5WdSF3dkfBn-w&oe=6AF1E6BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne8MmvP3ZnAQ7kNvwExEqZv&_nc_oc=Adq0nv255BMXNWGvQ5K__lo0k4WGuMWBepr2PXCxHglaVA5u4gVoex1e_XgDTZ3U_0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8LdTI-xRqqBfHRIp6gTl9qbYau4mQC82l4C-pQLgGkQ&oe=6AF1F848"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommend
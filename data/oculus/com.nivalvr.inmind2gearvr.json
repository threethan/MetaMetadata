8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHiYYU_ZokQQ7kNvwGZGYvs&_nc_oc=AdqtwyEneazhDmL2EIga37Ygm_HIik2nkPkDQ94FHLA5kXmrU-Ei-hBX1cWP0eaZCVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlYJRdGcQJ3_CATNWe8A1BoDFjhvSRESIYDgrqUzeyCA&oe=6ACFA99B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T1bTazEzEEQ7kNvwEKaX5C&_nc_oc=AdoYBnmCmSbgVa_Oits7AtXJJSr4Ch0P-LBQwOxn6rHxFeeWy4QTzjCTnd2Ibwr2M0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNJ-tgVNBSQR1cnCw0OkH4DfRlwKD1BmmKTLpxK-Cf_A&oe=6ACFA94B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChZQyVJQ3joQ7kNvwES4TTo&_nc_oc=AdpCNMWNGdK9c2wWY0VeXqwv1LuUWQrmDP9KFD9mVuO96F0duCioEx1OcQhOsUnlHno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvvB7XP7r7ANxwsF4w9sFWymsrNdnAU3t-cjgvbrF6wQ&oe=6ACFABD1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsLdEoWJmVMQ7kNvwFRk_wN&_nc_oc=AdqlnYh2uQgHamls2BvyalQHuYDH-D5kRTabgCUjHakqZhPks1hYj9UPPCfStoeH0EY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyy550eh1FCSkG51zB8WnIuPdyUDWC1A45FGmVYaJm6w&oe=6ACF9F76"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4SyBLvnkqMQ7kNvwGbVdJ4&_nc_oc=Adowy4QeSKsyN5Kzmwb6E52TNxUYZ0zPvw1YeKqk69wIr2IflSfPWUrqJVpmixwjQPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx25wnBW33AnhfFVmEzdcwhMQsSGmLq6lqxxp_YM0a5A&oe=6ACF9FBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9ZVkSH-SnsQ7kNvwFuQnqB&_nc_oc=AdrSJSGjY6JZnhbiZsZsapIDd8ec6RUUX94nTJHuW6RSBtOk_vlKsh6nKACR9X6vDCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl_RMBkdg7RRMv3Xk-5I7VWJ8VgKbko8mcdPHDPaDV4w&oe=6ACFB148"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
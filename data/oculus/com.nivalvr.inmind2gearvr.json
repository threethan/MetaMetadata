8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEpENhRx5asQ7kNvwH1rjF3&_nc_oc=AdqUCDnbearzvnl8x-DcCijnTX7y9VHoDFDgzK1eypWalyjseeOuOsGKHgdQRKItbyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhY5jbYNW9qMiwZeA3CK-_bk6tcsMC9x_CJpCYFZh4nw&oe=6ADDF1DB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHIyfqbmgFsQ7kNvwHJpNhb&_nc_oc=AdoPOswX2dN3eA6M8Lw0dVrP6-F02TIYxWy_HuCCWOv-lUIQx6PPr59YlQwEfDHWt44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw_fL6bIhAvMocuVmmCTwF1TAJONXfZQ8-vx2WZn2bMg&oe=6ADDF18B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgNQH-PZFX8Q7kNvwGEi1uz&_nc_oc=AdoBuji5rJlpz3-A63xffR3lTyVPHgcDv9H6Ru5P7mX0cX--NaY0gZ2Nu2A5o6NDrxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLFOPCr2ILymsGDwJTf_Na0C5XJB0TZvJqA8pEQCQZ2A&oe=6ADDF411"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5ZDraNma-MQ7kNvwFDSYeg&_nc_oc=AdrDd_o_F2CPStPb1sxaxlLIp9McRsB_6g44u2h6YEJpzRXaosiftnEXZaJdb65KVJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLDxYmaYZ8XdkEfnQY36gNE24_g0YBMtHqEIiZpupFiw&oe=6ADE1FF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Xf9EFPEGNYQ7kNvwFcxlu8&_nc_oc=AdpKjKO1DbX-M2F5Zqo1EWdzDdBjdJWkWowydo2nbPGE2n1qiaCX0lJF3wlwxSICmaw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKuN8EY-r-prpbhJ9faMqdSz7KbSALDHrLWg4mC0m8hg&oe=6ADE203D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xavaELy27hsQ7kNvwEh4xkN&_nc_oc=Adrw39OK9-HdxViHtI_BbVeB18GZdZDbt6o3DSUkWzvn4WCgRsmmIWWAJAArCPvWQVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3EG9P4YTLP2oCL_7Hpl1J4sfeiRkVpNL87dkAGhLeWw&oe=6ADDF988"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLy-kBQtQGsQ7kNvwE-gZ00&_nc_oc=AdpQMg-RNz1RsDvPddMLSvAA5IBxouB5RjqvUYh4OexJZLbuHCm-vU2vaTUyEnKN6xg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrtMRHrH0DQxM0_TWg9LcptvjYo8212ukwRp-vvN7-Vg&oe=6AB2705B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DADmnH0z7Z0Q7kNvwGBVB-m&_nc_oc=AdqfoIxKoshEE46M0rM57bAOWp7831dEIuwLRTAOGj4MKe7cOJdYX2deFwKnanLIpn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv6CruQYlNt5qhYwDJ8j3fyJGy7W_1iYSvj4gWh4xEjA&oe=6AB2700B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS72vb_xKqQQ7kNvwGWUOc5&_nc_oc=AdqRt73WbVuWJmSfcT1R7yUVt1dveWezzagQ3IvuPpycb98lXwR8BL2wSkb2cekUT9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIfqQOD23UV24LOuvT7gbZSZdMuro6ptWjFerdaE34Gg&oe=6AB27291"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpf6o3ebvvEQ7kNvwHnAkJ_&_nc_oc=AdqfqnS90FTImMMZqssd2eyaktcYWnWSY_aOubRxdzVGZ27laIKjr3VQtOvhOHt7x5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbgbKDbwUCZA89B16J4abNlhvWCo5Zj1ZtNpYcebON5w&oe=6AB29E76"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsw43yu4knAQ7kNvwEjxoa0&_nc_oc=AdpwYM4YdwRjfXRtMs3yk9pTtqFX9nkhM5lLmoj1DTQOHHkyGWkeTlFZf50I1RK-qAE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD-jhG0Q04Um0z7utPNP0qgyHmPCInW3WqBodSNyAxTQ&oe=6AB29EBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUzr7LPfgLwQ7kNvwF9AQvT&_nc_oc=Adqpt1m5kM70iX0kAWFQPohm34GH4-cc9fxoMqf0_lHzwblJDEKW5HGunEQ0cLIZD30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV_wfx97xfPNT4eyMbjqR6dST_RVuwKfpARw93AEykmg&oe=6AB27808"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
&_nc_sid=6e7a0a&_nc_ohc=cTgi8YTdCxIQ7kNvwHoU9aJ&_nc_oc=AdmDTiw8-uWSpAeomldSwmkW7rjR9rG_q57T2NQJQxqHLdhCU98M6a9x3CSX5JczZxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsDgmdgRI4cdG3L2t8A4hBi_a4w8pY8qIbUX92A7y-d7w&oe=699C438B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqm86mwGnBoQ7kNvwHXwlPT&_nc_oc=AdlguhC4GB5wvhjrEdZrhBq_J7H3WxrlwkSKWywx3tPRBcXGT1RYgbAyQ_9_uYAqDvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftpRrJFiHtBpVUsrWo_JYHwyFdmhLDgLwWwYnVtJYEloA&oe=699C4611"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aaat2CGoRBoQ7kNvwHlGVb3&_nc_oc=AdmC6QrCRhG5ccYevxLK4eqYGwmfxQaJNT9EWXLYz-qt_hP5d1k51e1OWzaKnA650lo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftNyTFTGNzrS-2JMfFpORXT7Y_Uk9O7lsowsP4QnrZaWw&oe=699C39B6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0v9jaA3JuwcQ7kNvwES3KBw&_nc_oc=Adn2mil5STfpqdWlE23oFvPJti4uz1NSzAPuv41LH2wsH7Cg0nxQt7BGYoFaFVPH1ZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvMFxwrUvsGU6RIfQeF9Bj35gZAkjVgjFXGK_9lCNaDLA&oe=699C39FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi9WoneqztcQ7kNvwFDppDc&_nc_oc=Adm1VbGSin4gVkenGqAjWOXYIlFgvtd3Vs3AANYMR4iYx4kjMYDUUWZXXhEr8h_nhiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsStWvBPoOgu47bq-hnMLiQOYt3ylW_cNI2IqGq3vgvHQ&oe=699C4B88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
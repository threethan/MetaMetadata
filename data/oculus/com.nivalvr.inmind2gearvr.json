15B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wd78n559oUQ7kNvwF50Py2&_nc_oc=Adk6VyvKx6UWWsTayjWzTBSHI6OwIZGqbMC7sHVden4qtxE8iyyz-jtCW4EGWe3z4bg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv04dtcnR2DEHrtvCd1RsSiQ8rhQZUtUxiAqFlLipNMVg&oe=69A8210B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T8PxZxXo18Q7kNvwHIUw1J&_nc_oc=AdkLD6fuT_XZ9kmMv9wQuaVMMjR5W13tNewmqdwFn4kaf_kGt4oRy0ePtNCeB7HV144&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvXot_Mf-6d8lWQDlVADNfMFnT_iSZa9AgZcjbQvrcEhg&oe=69A82391"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDbPiTv5GBMQ7kNvwGUSVym&_nc_oc=AdlsQen3Ju7kz6gvh-sfs33ZT9lt5OBTWRa9Ha1_tLYn1_1Qm0uSppqIAjZO130W7ps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfthJCZqS2KBccH3qPWszzl-Mfd4L6RKRY6bYv3N4QOsaQ&oe=69A81736"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjzVPLsgboQQ7kNvwFHlMFM&_nc_oc=AdlLNL_8mDyOCcDtLyHBN8s8pJUr1EM3T0JFRSczOZPJ5S8qeaLdDyRBJYvajldVPJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuIVcDjCTyVafUdquRieQcvSMShFKTBbe6Z2lcSWh_7wg&oe=69A8177D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHKACWmwwo4Q7kNvwExLwo2&_nc_oc=AdnZ0zdVPiMbexoTRtvssw9Pw--i9_yx0AB7v5hgHCkCpoP2yKSbSG9167zcSPUUrSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsThGnVOZdGPQHq5nkyBBVsWNpIuumIAPBdAbu4-j4esA&oe=69A82908"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [
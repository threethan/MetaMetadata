&_nc_sid=6e7a0a&_nc_ohc=WDBXdtLrxAIQ7kNvwGpayRc&_nc_oc=Adl-QGyq21_336YT9zAfRil6oMHtN_ZHm9XpkYeFETJaz6GlvcqSQ_C0U_l2iznkkcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6wU8wMnmYX86JTVO1EYnX9VY6PIaJDr-Y712-YBUhgw&oe=69A2DB0B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMYDaJGSpqcQ7kNvwGMeboY&_nc_oc=Adnq-yeepZJrBkewrOyNatti02rbMBuYdysbu08zJDzrW2Ig2kFbx2qYXm_0UcWsV24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5Vp9icupQO-EFHtKeGhAVYvxXjN75MoGhu-cDS8PHUA&oe=69A2DD91"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jQW64dRRzQQ7kNvwFV0ww4&_nc_oc=Admzkh-KBXIbZsCweEspLKm4sQyHvMIlQ0mdPpnYUFPGWFn9W9j3XXpJW0GAkTgNrMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvP3l0oMANLXjXTXM0Kqwj5BCg9j8f0vRnlA8CJ9aSW2A&oe=69A2D136"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATjnn340xVwQ7kNvwEBxfm8&_nc_oc=AdnEuzPMdDirevVBNmTdSBXRUBlKcnokbECpECoprkv7lt_JQXgMu0v6FRQ4opMydqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDsCZzsx5X4QRD8zEusao3oFiK9qhxc3a-DhTt4l6JmQ&oe=69A2D17D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4B0lzOvJ9wQ7kNvwECjAz5&_nc_oc=AdmVLhphm1F4Lo9g8W1g6mLXYWxVhLZmavX-AgzZVb2yDDw_-4IjUOq8_RofeyBL5GY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft62OwkQKviVvtvLn_TS14fKFu7Rsequ8opsJiA20SRiA&oe=69A2E308"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzg2CpAKfKYQ7kNvwEMlBV4&_nc_oc=AdpTAax7GeNZZuk_dpPiZUS7x-YkzO0tU7wTeHsrZc1wfDKz4YHzBeVFGNpb89IWmxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx8vvli5NpuBzIPoHR3GK2_PMmtI0mXu2l0rScwiMvSA&oe=6AE7649B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4b1CglxEpIQ7kNvwH8KBO7&_nc_oc=AdoAIvMJCG7c4xX-HaObirpMBYO8mfGeUd84GNNuuL7sGFfssY_yGiIa-0uwwzL_iG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSIBCE1l5SuUWR6YImsXCwOCtWUcG3D_PZlzkRXiXInA&oe=6AE7644B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q21FxZTbThoQ7kNvwGlwWpu&_nc_oc=AdqyDvKiOPJp1mR9t7l5Ql91rznjsKLSD1MEBJsF8LzLlDb1lU_6lp8lWbj3_H2UgVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg0TlqeZ00GfFO_t_j6zVaZ6qzqipWf8datZGJoTwQ9A&oe=6AE766D1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMAcHPV9nUMQ7kNvwEaaY6Y&_nc_oc=Adp40NELl1gOIkegPLS_-ayxKWHHBu9w53Mnr29u65B_idNs28rFfEKNK8SlqYfVSew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmu3ZMGvxYbUBcjs_Cim4Qok2pvjcrdS5JHA7ktXI0gQ&oe=6AE75A76"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MGx5X0zsaQQ7kNvwFYRdPb&_nc_oc=Adoi3Wa8Tmmg1lrqZvQ641ulX3hf5-6CY2af0diCNBpNOb2AwIMrbzAtx3EWpYvHqzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3W3WmKdm5b7CNtedZjAhV977KP2JMCcXtZKX3NzrXeg&oe=6AE75ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmJD8OOwrh8Q7kNvwGIanUm&_nc_oc=AdqrDUOegMiMERm8MsIV11PMXwy_-ZaYDiyrAGjXlbe1TFksFqj3aGBvc2W8-T-8bLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToW1G6YmB9amLf_86qQ2xXfeCUTKBaASpaeS-lNnoC5Q&oe=6AE76C48"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
SGbAd97PB6XYAhbesIh_rEzd6-iwaPqsr_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDBByjtKUWl25xJXC7zebgLLKCSC04uq7AcObaXbNV3A&oe=6AE4890B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es1OJ81t8PEQ7kNvwFTxOxb&_nc_oc=Adpl-QbnFM2VpvVNoYFx7aKJKOPQIYjBqMI5W3SH5RxK3HL_B2iOJAoNstr-WUf-qVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj6OOIhDy4lQ0oAKXlOkTMelbjA36H0VVs-mbDz0v-5A&oe=6AE48B91"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThAjKJqvqp0Q7kNvwESQ3Fh&_nc_oc=AdoFkmdVyTcBmulxtG4GLdi3xkkBOO3gh2F8h659Gf9PkOMldbPGYvW_gUXZkw0OGKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB0u8b2cozL5SGrsQIlLQW29lrCzrmLDuklXubaCAXNw&oe=6AE4B776"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhddSqQUz_8Q7kNvwHrSFKi&_nc_oc=Adp4nNlkvRUYM3JY_gyrtHluXa9tcyzRbpaiHc5mm_gd8qwpuMjFZpQH1W0G0J0xnNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxI8jASf2pVblO0Gqe0MSn6CZKLvGT_eLzPW2lQKToIg&oe=6AE4B7BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WVv1_iloZwQ7kNvwEnxioa&_nc_oc=Adoj8mKzDCC-dsj2AilepG-OibLCwtLlM1FkTPjKutWTOt1kiP4Xzgyv87Lzz1nmUrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI2tcR9gbBdGBcd_idI8VKQ_b1Zl4B7u-lcEkg9LwIbg&oe=6AE49108"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommend
8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZn_aC41gxcQ7kNvwEuc-vY&_nc_oc=Adq1u1avL3F0Dx39mEL2No2UE2PWg119EjtHQrrrKrPAI6yI0MERaTj9qOI-R-lfjaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRLn8x4RykuOm0YdrpEpWWdGRArpEoYUgAMoPXY3qOZA&oe=6AA692DB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKM9zWCO438Q7kNvwEQV4mY&_nc_oc=AdoWJpgFTKQ34rQSbibcP2gSajvcf3bgbVtz2p-mie9zWmeCeWzmU6JJzCKybnu5j0M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOPs2qNmnCy4_caYX8vZv61EXh2WwQ6BtJF19-thGeTA&oe=6AA6928B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrj_zJ1bGcQQ7kNvwHODZxj&_nc_oc=AdqhLR5y7Uf2AN8GsaQDIJnvswDwQN5NMNl3seLnRlwKXe9zUMUNQK5oorHCNFNIVPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLse5ZB7jGyA9eG9VdBcKLdCCGknbqvBaf_BF09N6jUOg&oe=6AA69511"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTQo01dXnN8Q7kNvwEU0M3_&_nc_oc=AdozPEs2cYJRIPRcDo7vqF418DiBTR1y1esRewe1HR81rmhJvfmInmdEhotBb3fldqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvojm8Rghfa6uuYnpYneA4Dvztv0tOV4Ae9M_ODeBN8w&oe=6AA6C0F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lrhn1ykiYIgQ7kNvwH_2ojj&_nc_oc=Adpm6WgiwT1UlEXBQfccoglHFqFohk31gY2nmSIfxk14BUmp2PB_4kZwHZcvI3SZv_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV132rPyd54Xz3nNczTOD4yhHxsTh4kejt2xBdtLez6Q&oe=6AA6C13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE7DmOJ5rncQ7kNvwHWfo2h&_nc_oc=Adpoe5GiYf6MIlXfePm2WJujDXl3KeqMZJQLCJYaww3BMc0KxMySV_5aV1dRKoL815Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeUb5f5aiZduq_gSuwHWcGjdeCiKtDRxOXQOtZ0_08bg&oe=6AA69A88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
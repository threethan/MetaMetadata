8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqqi3Xa98N8Q7kNvwGN0v6t&_nc_oc=AdpJbG4qRYnl3rkpPVdEDvmO0JceeSTvMokuUNnlPKsmQ_Ram09RswkyIIF-x7R3whE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGHUq2JTdhkQzxw5-LvqIgpzzN12KAdi4Jwq8MsIwcRQ&oe=6AABD8DB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mh0RfAE0GcQ7kNvwHpeUZ2&_nc_oc=AdoHtfM7JWD432OqqaA9kmDAWSuxG_0AVMoUr8Gh2VqLY41g-EH0JdsMPv3L9mjKEsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH6bFLkxdEe-3kD3l-SLf0VbSSdpuLv9GHnbwtN1UcnQ&oe=6AABD88B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmCx54Z-yyYQ7kNvwElqu2N&_nc_oc=Adrcb4kw2U7NCsQfXKJ_TYa5emJsPe-mpIihQP82-20EYE3ADCBTJw6X0TLpMgqGc2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXjhARH31LOYr4fANGHxSyr-9GuZC-Um1S0nL3Kyy8cw&oe=6AABDB11"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xr7G_yk2cKgQ7kNvwFXd_aI&_nc_oc=AdqlaU-8aj9R1dsTBlRKeJmZWs92RPb8dd8OtEhmZ5GJe7-E0QVoHSuaMOx0nls3hek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL49v8mJstdw0w4JKQ6cHDxBca4EmS_e63BM-JqQLr6KQ&oe=6AAC06F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtjilefQemIQ7kNvwG00ePi&_nc_oc=AdonqxHGJvGlm-6p8QD86_uI-oXOXA1879h4IkGZxhVxVm4lrtwzX74SsohGjYu-H88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY7JzoD3HM6m2oFkMmZ97d8JtWD_5MOQS0bkeDXYHMpg&oe=6AAC073D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0eKbBuGH28Q7kNvwGBSeu9&_nc_oc=Adp3qu0yxOVljV3MAwqOei-nK6SfqrvIsB_Khrh6XhBiTNgodJiVNh-zcT-7CrBLHJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuSNMIsKj1_0K0sYagGcLUEr0a_A2Z8LP5z1QSyakiZA&oe=6AABE088"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
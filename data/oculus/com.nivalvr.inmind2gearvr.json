2DB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wd78n559oUQ7kNvwHdwOB8&_nc_oc=AdkOZoMDRM54XPVAQzQDIafTVhPAWzTE61hMrPArTLT03SSEW2LA0zGzu4-zIylWPa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsH4QdGL03dZQI5ODpX-SfBEju9cD_aqX1iLDia8X-w2w&oe=69A9728B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T8PxZxXo18Q7kNvwE03CyL&_nc_oc=Adl7iakBt4xRxTOwrVpyzCQEVoepy4jfNJ-64MZYloDfBUOUGFrOO3teV2lSy4RhIOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftx44JN0EdcMwfIoyiZ9Y3bKrKGCzpPHUjM2VjRGsGnTw&oe=69A97511"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ddb78W4UMsQ7kNvwG5oHF9&_nc_oc=AdljLDdEBylrnMDKQr57j-I_gHFNpzezACa3Yd2UB90OcbghBGIkOi4-tc6_QXFCWIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKUZHhKe6tiAQjp85IvaLF3L_PdDm1ch8l5DRFudU84g&oe=69A968B6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjzVPLsgboQQ7kNvwHAFN5G&_nc_oc=AdnW355j5rCQGFPMeawjj3voB4tt_oDv4wYkun7DwT09YzWEnQuXPu--PxKCGCXl7Dw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuryfiw6YZ3ch9Pw0e2tzJ3e9uB8X9YKktD8CPSChZU-w&oe=69A968FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHKACWmwwo4Q7kNvwHaj-5I&_nc_oc=AdkNqMJ-AqHp3QyPHTBhewQe3CD3-rGPQda4jvpwieiTqEhpPJupeCPQmDecTDQA2IE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFXVla_8jyyttv57LUMsyILiSotQUJiQ00qGXMXs6OKg&oe=69A97A88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [
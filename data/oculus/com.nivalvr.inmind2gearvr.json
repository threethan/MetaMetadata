8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxNDC_Kun0sQ7kNvwHZ3hYf&_nc_oc=AdrhpN3whhmNLn4ebf-qAoiUYdWArEU6iJNgr_vsG6Z7k-48Kmm_aEAySFw5bkcCoBw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZeSgjhiVDnaJdCjFGcW2mq5z3ZFO4TVsphZzb_88rYw&oe=6A97315B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFN0Dxp-RHcQ7kNvwGcR6nO&_nc_oc=AdrQ2pb6eTCuwrPE8uU_mBiZnlDrmO8SER6nShu7PqlFNegikuj6ceSrPelVZpfrbhs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAOkl0lY6JtbF1zLbs89x4I08latAD0yQmrmBZ5L5zGQ&oe=6A97310B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSYzuCGCBboQ7kNvwFcvfKT&_nc_oc=AdpUXRU9Jzfh_jY7SgElsAqAY2BpA3SaDhapg9uoW66BdLn3gJZyy-LT10R1fjrz1ug&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJkubt3aiDiDow1DepNhvlPNVyVvaxyajKWRki7qfUoA&oe=6A973391"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9pmN4h4PE8Q7kNvwEN5iIS&_nc_oc=Ado27E-skLc68U89Xznv7kDPNrKA36Shue9qSKB0t-F5Ock5uMUaLXwaJRv7UCKU4Ns&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpXtIEfAN1ry-PNTslDaK296jY_baluI2gyqECI3m_Xg&oe=6A972736"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXhPc7t1kNcQ7kNvwEFtE94&_nc_oc=AdrqnpibaRpYogth3n7JGoviqUubMSQX0Da1p19bqj41JkHGmhv4M-_hSIo-ze5Mik4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs-r_rYQX7P1j8DPox26JQvNhzN9mIqbi3eWixYqR7Bg&oe=6A97277D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw5CoxlglW8Q7kNvwGBHtil&_nc_oc=AdoEZZPzik2PBR12ZAAnFLyqz9h4ToSDon8tVVUE_CbCDPNB8Tp_HD6f70XUhwZ_ouM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwUxt8GmJbi_9xBmiH7_U4DeKhrWP-5BbVLKCTVdNJqw&oe=6A973908"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
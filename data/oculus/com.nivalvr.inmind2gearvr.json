8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxNDC_Kun0sQ7kNvwFmhkER&_nc_oc=AdpQpijMG4d5lP4DuKOEGL_UOWwdGomxtXPfMZxoCMas01SAS2KWw6zcWM26v83VFKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImpC_2hdTQOvvVABH2VYg8WpqvbCA60CWi6tG_Z01Uuw&oe=6A999C1B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFN0Dxp-RHcQ7kNvwHyv-qB&_nc_oc=AdqXM65t78-EGyupntOkrdjVaRjU_w5YQgYCskpdv2CgrO3GpSvVVRVkgstWTkZv8PU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCbgvZdlOVHL5lHB7XsGmYBCSE6PnfWnbZlPaZCMZq-w&oe=6A999BCB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSYzuCGCBboQ7kNvwFvo7Go&_nc_oc=AdpyIwtbm3cmyf7i4gPQn2dmi0PW55F2fUzaHrtdc3nGAnqaZSy3n1FIfXH7DHFTsPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn3l6jR5xs935GQ3C9NNBbHFS7AWsS0-K6GSUuRd_ycA&oe=6A999E51"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9pmN4h4PE8Q7kNvwGDav2V&_nc_oc=AdrByeQXPmFY4nnJY1xZBn1R-tFFA6ZcB06VDDJo82t0yTEGh-w96dHMSWG8Kk-BuuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_GD76dkB1OWOk9LOPiRF8AiibaA-OgZS5h_8lLEWzIg&oe=6A9991F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHEfUiOv8bUQ7kNvwHt57eM&_nc_oc=AdovAEt5EdOhwEL4dnijjA1ziqagNukdZLEXIcDQn2GtNY4PxZ6rGdj7QMNotLklnyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlGj8fUDsRSKYKi_TA1dhoDcXp4q1i77sEtz4WnU3d-Q&oe=6A99923D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykXmg8CQf8sQ7kNvwH_w5Eg&_nc_oc=AdqwWv1HUrhawaEC-TWc3SO7jh5HXeSUDHC007U1Hgp4mcelMehgbd344cJ3LoE7wZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg3wv9Queo8JlsCDYE5VlMTsnSLcumLI4vmeQ4u1UB8A&oe=6A99A3C8"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
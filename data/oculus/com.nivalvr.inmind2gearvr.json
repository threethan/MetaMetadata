8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39wZSyy1r-IQ7kNvwGMPK3S&_nc_oc=Adq8dfqmZ2n0kuVcMmdjBzo8MctS-mk56uxHWNf51x9ci-fNkgJnrx2PoWdVeaV4Isg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE6ciy9uErmiKfja8jT0ZqLm0L5cSDG49f5OQDwB_tOQ&oe=6AB0059B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DADmnH0z7Z0Q7kNvwEct6v1&_nc_oc=Adr3aNbs-NyMZTnCf_Ia33l5blbdvFrGB70GGbbqa_MS1EvwOr6K66dLoBxNbUNLjQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2LvQYPAhObQv_Ye7kCvHTi36xlhhBehGP0KRytIvvMA&oe=6AB0054B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6vznnqOjnEQ7kNvwE5InC2&_nc_oc=AdqCL0ipboBRLfxe5b72nIXHstKQoFcTrXOWasRU5m8loHeCVKyPZxBEGlu2BUatdsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBJGMN9tGcp-FEvHGw5_SP28h6T-w_z014e-t1cDoM7Q&oe=6AAFCF91"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tpR_d_z8VcQ7kNvwH757ZF&_nc_oc=AdrMztqkJF4opTTVMREUW9us3xmNy-_ouwtsL-REed8kc9Z83gTClSWSbERiXk7Dc_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpWS4Gv1nJaQwSd2gwAEeLHn1kr82r5J8kxZl2rMSwxQ&oe=6AAFFB76"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsw43yu4knAQ7kNvwGqoaHC&_nc_oc=AdovBfBdP-JYzEZfOvWVzYxzB-zIRyb9MrsIBblLw-xhF-NtvTkqgXG8HGVK1LsCs3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2RQ0r6PNEURD7mogvZq2uCxp-UmOQyZY172qgqmHOUA&oe=6AAFFBBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUzr7LPfgLwQ7kNvwFQCtrs&_nc_oc=AdpP2MyVzZxi2FI-GtUw4jzXiHUUgDj9FhjNcvQdbL-LGYv6rAtjqSiOfTtSUa3Dbuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS1n5TJ9R3N-oJIVmMZmq_zQOhWm1AFlBEL7A-B5NS-g&oe=6AAFD508"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
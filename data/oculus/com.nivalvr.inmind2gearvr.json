05B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fs5F0OiZq1cQ7kNvwHigONE&_nc_oc=Adlcb-eoxPR9KzM7i2byBMCJPpj_EP5kx-tCBMMABnBJ1OUEKxcQPLa0fCyFG7jKlaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeHMVeO8NNKrTpAniNnEh9Io5Z3Or2P34scS2DxTxm6Q&oe=69B5500B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAqr8SiWLlIQ7kNvwHgPTAi&_nc_oc=AdkCYbWd6GZziGYmQZyzMbSS2itTvOai8X1sTT695YkSKGtMT6pZVLk9xKeMpIPHqjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi73WhIekkHNUeerChT031VyRa6SU5Zs3MmsDreKnl3w&oe=69B55291"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAdtlioL6xMQ7kNvwFujgyo&_nc_oc=AdndISZvC7kQDw4MydPjBcGNwFFjZktR80b_Y7maAlpDiXuWTNbxujUg-ExCWfXBQ24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymZD39xokSY5BokWZudEZSHrhvfCptY-l-JzfwJsLfFQ&oe=69B54636"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VUDRjP9nCcQ7kNvwGKG0I3&_nc_oc=AdmHu42n4qpvfrDCIufTs_IeU2BhrRmQ6C7U5AYzXerb92vLcxy8cklMoKl2l6ETZic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywRIVU8Htlzi8AYmQE8Gb1Tz4jdoqweewfXz0ha2xfIw&oe=69B5467D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuN_5EcrlbsQ7kNvwF5DQ5M&_nc_oc=AdnG3uxzHNmVaHHrjsmRu4u2b-T8j__TtVQ-ka3vnMEm6Pr9yeSJc1iVhVl8xrneBSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybkllPRmzFZPO-L8nsIYf0Nymn1haWBeXC0x6kLVAy1A&oe=69B55808"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [
Jk07D92fVHnNxRA_DVvq-BPjJc8jkRoBfJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAyo2-eTZkNOeEAWtY_CF4CXrVsrZC9LuXvdJn7opWPA&oe=6ACBB4CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cZ4ydkqjrcQ7kNvwEc0Zm-&_nc_oc=AdqOTFcI6q_iW8ursgTmb52tH3_hChite_25pjLwrBCVB1lej7DWdJafcQtxAq8lEiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIIja9G2KmXVsp4WQVQQ_LIK55T2o-KsgTQ3PR5jFGFA&oe=6ACBB751"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46EPinVtwecQ7kNvwGlKObt&_nc_oc=AdrYN2pquDligrjYyowmAWa2v0-VNsSr_Vu7a7yGwg67QsNfKXr4FE4Wk3ye-Mi2Wyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1PBw9fGY_y7OJ6AoZv4ezsQeHO33NK6Fuu3k653-akg&oe=6ACBAAF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ScXwhuZ3f8Q7kNvwHMXavJ&_nc_oc=AdqkHkXKYM0yXS3RKlzJ1xink5JIVZiQsqfZ9l7X9QIyJb46IAhnvlCFUDp142LLhDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbRulsvAHV4xG9RuhgWtGJTW9erddZw0BMj2pa2hBJ9A&oe=6ACBAB3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXiDenJ-S_YQ7kNvwGHEgM1&_nc_oc=AdqsHDSOg6o_0hA4ASpD2ZPnq6yNv1bdmPZW1KUjDBndDjphEVqgML5ZB5Db-mQWujE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuQU0uwrlftgGvkrx9-mHCi7YPAJXf0uiTDA6Bt9jQMw&oe=6ACBBCC8"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommend
8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUUoz9eSuTsQ7kNvwH3Dbj6&_nc_oc=AdrsivL1QHMxE2fISO9ZLAVFJVM6DBAF8yk9fSEKCon-qrpOBhbfuQvWrJZouNKy9AA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSjmOxKxQSEuAs6XvvgKm05Bct3IT8LeF7r5-5k-JCVQ&oe=6AE21E9B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKUqaMieY_gQ7kNvwHLV24b&_nc_oc=AdqinV1H6D7rOZETY-CN0ycn7Q367Z8cCKgX6omswyUpFiLrLmhj33S0BXSNbz5CmBM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV2kdxy2fZykW9p8ZajW8hC8o1MIoDMs2knzFfGju3yw&oe=6AE21E4B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es1OJ81t8PEQ7kNvwG4ee9i&_nc_oc=AdqFnMt3Nuwtox_FbYjruCKENb9pTv-oxafmr4YF6BeR7C2evPO380J_gk7tMyXTvZo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf-f8s9Gnf5r_R44R1irr1dBmJ7Lnn7U61_AhfB2UCdQ&oe=6AE1E891"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThAjKJqvqp0Q7kNvwEa5voQ&_nc_oc=AdqsIYOrLw0vqw5KETNk6C123YaZ_xcoUQTHF31IOU3PGUCkaz5U-q4tDDxe45EpDbc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZm_rIYzeL3ChCLhN5CyR58cPxJ7xbrFvqQnVMWpESOg&oe=6AE21476"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCPFeDURz9wQ7kNvwGJpe0Y&_nc_oc=AdqQATltRZjreT53BHAVQJt-_vXC_7b54BweGooU9Jf8deNVNPOkNok5HQ2QLggEW7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8Sf98EkU0k2Np_6u8S5nyV4cwKx7vqSMMHiHem5n1pw&oe=6AE214BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7_9CtSaEqUQ7kNvwFgw8D8&_nc_oc=Adqezq1AeYJn7wmizOdi53eWNJB5xrU9IVFQMFTIUdKizJKR0OHpr9H_noCemGaQ87U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsfD8MyV9UWJovBjvY8NX1lIVI5VITK-zsKlSw8JGdIA&oe=6AE1EE08"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
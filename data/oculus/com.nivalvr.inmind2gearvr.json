8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9KsMI4psCIQ7kNvwFu7a1G&_nc_oc=Adr9ptiw0CxUSDZrT8n32BCqFjd7x4N0TgmPu67aI_oGLgf2BvmRMKdZKhTf0JIvSyY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJFJ4kDCqHsjspyqxmSZb3znR90Y7Fb2940WCDjUvIrg&oe=6AECAA9B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBpAkW0kxboQ7kNvwFRgbZ4&_nc_oc=Adp2zL2dlmSqPuPF774EcrIdaDU2qgt0uIS0SG-m77nZwUO9krVBnbK6IeugTsSeir0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7-XjUWr3pwgjEIKGOzjic7YSuIXFB9RBsJaLohpmUVQ&oe=6AECAA4B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMjF5u5SQRUQ7kNvwGu2xYV&_nc_oc=AdqnnimBRyYy-6-kchLm9R2LvZIdKgM2lrGTii0GGteSXdUj4aMPc1vtazWWqJWxB00&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2qe9NRXv9jPnHRVYuJzbAjsjXMr2HRXeq6JdHY0T39w&oe=6AECACD1"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm6Bd5NDYz4Q7kNvwEybKYu&_nc_oc=Adq-pLp9uT7AsSR9YMmvUBqPx3_-YxDLOW_llxoq9zAI-EOp-wa-oGt3GNBDAF0cOrI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhT4X_gMhhremesTs_XsCr9SttQZJ7YFCcOejZMF-w9A&oe=6AECA076"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R5xuPV23hkQ7kNvwEO3Lni&_nc_oc=Adr3jgmuKqWu2-QlOS1vJ-50WVEcvavggZ9iW69MWIzTH1bad2tbsRJZQ8ofNbPE6WI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOt2jhpciS3B7-TylTWkx-Coa6qJbeqanbtZRmP2x2iw&oe=6AECA0BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81JlG4aq8cYQ7kNvwHtJ-r0&_nc_oc=AdrqyZi3YKWDzJBRd3wpfIDTTzI6vF3vatdzBXjDisjYnTIw5KyVINAwmoy8phu5H1o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZpEg3fWECF3QZPo4wUusCuuBQ1cjDMWafuemC-_YVJA&oe=6AECB248"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
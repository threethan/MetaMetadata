tO12VPMR51Tnvcjoqq26h6MgAQox7qzRfh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe8bSa-bbr5wYkttjS7_iwcUtgoP-aKfYBJZk-ghPuUw&oe=6AB156CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6vznnqOjnEQ7kNvwGoxszD&_nc_oc=AdrEAk6w5NgJRj28UNVzN3fQZ2WW5aGa2Kb8hk1cN0zegtrfy49nfwdOlQWTyPslRoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV6eDMzqYmJpq8PwVwprogpDqZ2y9siNcAPkVUokfTUg&oe=6AB15951"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tpR_d_z8VcQ7kNvwGkLcVL&_nc_oc=Adp5p2o8fANyx-22G8tmi9dqH62UIozceMsvcU1Y59-ql0J_gBYT5mF1eKNFwLiOw4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8-YEHfjGyHKK8HUtfuerTvZ2sWMCIASvf6yRQY5Dshg&oe=6AB14CF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsw43yu4knAQ7kNvwFo59_3&_nc_oc=AdpKCZtU_AF3UaFVokPUsLQ9RIAKwjMYhB563mAs3g1pKgsDAWGysv0osxQCpxM7CVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJae8NRk6qruOvj5YxswM94OU5BB3d3z6Td8ujmQjRlQ&oe=6AB14D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUzr7LPfgLwQ7kNvwG6Lmhj&_nc_oc=AdqsJt494725e9O25ju-9Y2MCbNK7OzEsR9Pso1VUSPFssUrhN5Dv_csPjnkpjNoac4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZqLFHurBhPUfxlpZEMEacM0EIqjKDDQWvs_BtqRKWZg&oe=6AB12688"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommend
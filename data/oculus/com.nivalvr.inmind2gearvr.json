.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATjnn340xVwQ7kNvwFcwT6I&_nc_oc=AdkIAi6-hWxD33T_jnKOsltBARy8pV1RoSoRHmVO9rJypyHp5jG5R56WstgxGiER0W8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv2nQ6WONPCeodUsC82KhCvzCSxpVr3HqJT59OTXDUg3Q&oe=69A422FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4B0lzOvJ9wQ7kNvwHw_aJr&_nc_oc=AdmEtB4Rrz0vaCqt3XUtfDcLonVRCGCYkM7733XnM50lnG-ISNNBv29joqLUrGWuV0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftxxPP4sVZSjOe_JaujMEVB4ohczvhbVrahQw4ndfiqdg&oe=69A43488"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "484449673286378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12448837_407504026272409_4326372380336193536_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEd7WV-dWggQ7kNvwFSWp-B&_nc_oc=Adnh-0I_hC0nxJORW3reice-8Y7CGSZvjQkPIflE2ko-ezHIBE1DOjy_W67thJaGQ3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvZagUnVo_ekVcP-lLKiJj0qcTAsCZLOAin0_Ym1GwgDQ&oe=69A43F98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "InMind 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1495004400, "lastRevision": {"nodes": [{"id": "1218712264818806", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1099387316842405", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1336103616475936"}, "iarc_email": null, "msrp": 
bNpfIcGSnAsEM_EJq0hYMjqEeIUEyCzncKpWFyKlEOw5oGE3o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI15_1Eqqa-87-jXahKWfLLEt0EQt5-B6wsp3CH7GyKAw&oe=6AAEB3CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6vznnqOjnEQ7kNvwE8lMnT&_nc_oc=AdoMSa0N2y_W2MsMdqBDVPkGriteHI63zWv5gBi6iIhfNKYtkJEGzJ3klCAa9n4ly60&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrdPq3_idxL04z24TQbaQ3DMs_Uz5dz2xTMQQSD_MXlA&oe=6AAE7E11"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tpR_d_z8VcQ7kNvwFQyrYf&_nc_oc=AdpyOXx6siZYrceKff386jEU8XE59Ku-hTTHPX0KiuR7TvfDXy2y86F3CibUvzoKvCI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjIbreQ-9Sf05BVXXTJ3TIlwKH7kwcuDGsjApeXfAJGA&oe=6AAEA9F6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtjilefQemIQ7kNvwENkM57&_nc_oc=AdqNBXP7_nlE8wYRi3D9Y0StG9qb9FxWJBfVKf-dDYmPtSLNxWbcUrut5Y-MMKOnUz4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGXXbdijotGg-npsQDl-Ho3Pe5UjHpekCdNV6oDrErhw&oe=6AAEAA3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0eKbBuGH28Q7kNvwHKT0R1&_nc_oc=Adqxf_TRY42-RkPptyPLvMT94wWNDJhyCh_k5Mi4qOqI6B_Swm8CQPCTW59P7KBGSSM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdKeNpU2yg2wwZZ-p-gb-2rOuqfq3qnux-GTP5q5b0aQ&oe=6AAE8388"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "NARRATIVE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": nu
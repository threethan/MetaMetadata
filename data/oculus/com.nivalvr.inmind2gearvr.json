4DB"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQsFclZaatgQ7kNvwHaRCj4&_nc_oc=AdkVRx5flsJ4niE9QXXLuA6oKN7xTTOECF7X1wIveeOgv1AWyMFYPH0NR_K60RK1-LM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9enjCVzKAacmOa5rl3FpE-ToDfwzs21xI6S762e33Aw&oe=69B9448B"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FO_M1mSK4O4Q7kNvwFsUtjO&_nc_oc=AdnRmgJYc6t1oY8SKQ6SAMFvnaPETyW5bwbP2Gozh08a5E-8U-1_RCDarg6IQEHIxuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMdYDNhPozhsHr8ftzjlYkDtxjfEfDANrJaqnz1rQF7w&oe=69B94711"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2_Bwpp1QqwQ7kNvwEpb8iU&_nc_oc=AdnwO4LsRpE2wgR0UTZcdsEl-IMwNxrJCFUA5Dbi_DQGbyUq3jsyn1EPuUfzU5ABHpQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxQhpelzC9HBH-lPDR7OGELeNRxkcjENpktfW2lANX_Hw&oe=69B93AB6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnEtH0lDG-wQ7kNvwFcoxgA&_nc_oc=AdngvuhQ9ssx7OmvgS8UFk_qeYOcuxirHVX2XpHSu4px5w5UlZhAasymKU2Yx2Ku9bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1xOOgHCtodi-2yoz27ydWSRWoztx_lf6bA5xTMxbXwA&oe=69B93AFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPMiwyHOABIQ7kNvwGsHbWp&_nc_oc=Adk2DliwU8MhJmTbw_59Z1x0B3rYF4iwWlARlEuy1QFgJen36_1-Y5Bc-TUPGGca7OQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzHBIxju-ELC4AQKvJg5_bH0bvhdCnfCm3hghxNetHFg&oe=69B94C88"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://luden.io/inmind2/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [
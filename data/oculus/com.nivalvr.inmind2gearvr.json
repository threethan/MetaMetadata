8000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzg2CpAKfKYQ7kNvwHXW8Tn&_nc_oc=AdrGICBH05r5BJAHvREL6MyVdWtQI8ccTHruKxxgUkrmerr8I7usSZDRURUsHUen8J0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUB8i4bxs_ZDUgviIf6IfxnN14vsnKJqi5f8XfqEx3nA&oe=6AE8B61B"}, {"file_name": "migrated_image.png", "id": "691209241417964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448871_256442731419597_5035508284480552960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4b1CglxEpIQ7kNvwHzU2q6&_nc_oc=AdotuWef9pkmorWPbf-ya9nrMiZ6SndWzoBF5szPvrCxV0JNWaVZQHn1LLLLjuG0cOk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_A2cKZxNbrJKR68ie3A07hioMruPCebnvI7u_EOkLQg&oe=6AE8B5CB"}, {"file_name": "migrated_image.png", "id": "520744718850460", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139349_648419058653059_7965778472687632384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q21FxZTbThoQ7kNvwE0ji3q&_nc_oc=AdoIT4kC-wSc2TntskOGlF1BPITMnhCz40EkVFBqp1tmJxxb950Ki-IcdROURQZBYwg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYeLaXuxTK7er3LQ4jfBUn1Wmb2YMHc43jdmCDNtCHBw&oe=6AE8B851"}, {"file_name": "migrated_image.png", "id": "213182859899715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12427587_268150660248057_5883347962720944128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMAcHPV9nUMQ7kNvwHb-XP4&_nc_oc=AdodZfNKKt7T3g3Rq_S2BiUioN6-Y9wGxn3bdITvBM0iFfIJredg0hEfvUy6zG95Tpo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkqZqnf58fer8b1B-yeAYn4jJpPXqtmPm_YE4CD29f9g&oe=6AE8ABF6"}, {"file_name": "migrated_image.png", "id": "207392097225042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139236_310699905982033_1066032572452044800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MGx5X0zsaQQ7kNvwH1klGV&_nc_oc=AdrlxSD8KzdNhtlFq972MQj3N-8eN1WU31SwELJ3TT4HRadbnJdZ3m3cArzaoo9O1BQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYFj6Ajh_5MY--b0uvdvyAK0QmHKXGPNVh2QZdWbyudw&oe=6AE8AC3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1112206722182020", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12504645_1112206728848686_2613790171472068608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmJD8OOwrh8Q7kNvwH2txVg&_nc_oc=AdrCFk1hrlyAMufw1UIGNw9Zk4-BUgj3jLbvYGICgkkminMlAaUjIyeXrKduYiVkYhA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT143U3c4wHaiYsfd5hRr-SgzFBcQvn4imEOG-g5TCCDg&oe=6AE8BDC8"}, "display_name": "InMind 2", "keywords": ["casual", "science", "education", "rollercoaster", "narrative"], "long_description": "Even one small molecule can change a person's destiny!\n\nThe game places emphasis on the chemistry behind human emotion, greatly inspired by the Pixar/Disney movie \"Inside Out\" and (more scientifically) L\u00f6vheim\u2019s theory of emotions. On the gameplay side, we take the best from our experiences developing the games InMind and InCell, to create an innovative and eye-catching VR experience.\n\nIt is well known by scientists that emotions are nothing other than hormones affecting the human body -- and especially the brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. During this crucial time, John will face several key moments, and his reaction to these moments may lead to forming new interests and relations. Help John on his way towards his destiny... His future is in your hands!", "short_description": "An adventure game about a scientific journey inside the emotions chemistry of human brain. You'll take part in the process of one teenager named John becoming an adult, and help shape John's future self, while experiencing an exciting journey inside the human brain. His future is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privac
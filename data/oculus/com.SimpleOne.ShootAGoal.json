-MoR1_d-oJ-b93sNrS4g7uSvy4ImwfiG6LvX9iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4SA1qNl_m_ck-KXXJSESq_U7whxHwEmAjRm_CtP_K0g&oe=6B045B01"}, {"file_name": "Shoot_A_Goal_SS2.png", "id": "365020682228479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031569_365020685561812_7549119371157951569_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjOgzkVLG24Q7kNvwEn1Ciz&_nc_oc=AdpjUcdEA_QKE3wOeH1EVDjrimLBrgcvmTZmi-2oItchnvLi-6xjQCklOsYMm_5oIL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCOeg3GSL_CrZVG_beMXT5D2evMSx-35gadyaURmHf8w&oe=6B0451DB"}, {"file_name": "Shoot_A_Goal_SS3.png", "id": "724497408718125", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974826_724497412051458_5567733157785994202_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToH1v7g9t_UQ7kNvwEoQP2f&_nc_oc=AdoEPzZH05FXPbTaAn5epA5lLgLLsPE_Rg9S-ibM_8krEV9r4qs8sJRUOQ26rCgBD8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBXdw4AFYLryGeyon90Nm_1wEY-m3s7e38DTmnt6zl2A&oe=6B046255"}, {"file_name": "Shoot_A_Goal_SS4.png", "id": "5162931373766450", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974645_5162931377099783_6655422942171392247_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MhKxArREl0Q7kNvwHjRp_i&_nc_oc=Adrh3rQFefQ-N9ww-thY9hWwhSV9TX5HouKHbJMo9rgG_bdgyeLTtvXXllOQl-_w1D0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6jkvV1_1onX6Dslvri7zW0EX5Ri98nuNes-byx-icIQ&oe=6B046E2D"}, {"file_name": "Shoot_A_Goal_SS5.png", "id": "1619859358406781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974670_1619859361740114_2820161117577168771_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9ZaYxMJCm8Q7kNvwE7Jo5K&_nc_oc=AdoLx3RzGZEDnFXhN-PVDkYpfrXx64Cp1coTMPSIJH12AdhYh5iT9YQwu_TSl_XJL50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsi3zMmCvQP6R83HRzQ9Kh52Y7mZ5EpuYvdA1tRb4vWw&oe=6B045B91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shoot A Goal", "keywords": [], "long_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!\n\n- Clear the game by putting all the shots on goal within a certain number of shots and within a certain amount of time.\n- Clear the game if you can shoot the ball into the goal of different sizes by the time limit. \n- If you can shoot at the goal with a number that matches the formula displayed in front of you, you will clear the game.\n- Find the goal hidden in the panel and shoot to complete the game.\n- The game is cleared when the balls hit the cans and all of them drop to the ground.\nOr, after hitting the ball to the cans, if all the cans are put into the goal, the game is cleared.\n- Match the panels with the letters of the goal, and clear the game if all panels are erased.", "short_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!"}]}, "developer_name": "SimpleOne", "developer_privacy_policy_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "SimpleOne", "support_website_url": null, "website_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
": "365020682228479", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_365020685561812_7549119371157951569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSovnsGhRQEQ7kNvwEfp14J&_nc_oc=AdpD9Vd3lPUdRWw_uqqDU25W2_B8N3mbNS0MCwL4tO1lXUyXyw1bfZvwozfOoJ7r2AU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JHdxA891z5jFmjjCydiYZ1S_0C4fiHBpYkay71xKjRA&oe=69FA02DB"}, {"file_name": "Shoot_A_Goal_SS3.png", "id": "724497408718125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974826_724497412051458_5567733157785994202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWKh6J2C57oQ7kNvwGJWvEK&_nc_oc=AdrRmJEB4HvgQV9S7Xw-bn8gBkzmrxfL2gaSKei_O0dWdjIcWnAiatGmXOhBrL_uFt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64uNlR0YgMCB29sFpc_wFu0CPiMC6zPa7omletYU240w&oe=69FA1355"}, {"file_name": "Shoot_A_Goal_SS4.png", "id": "5162931373766450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974645_5162931377099783_6655422942171392247_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J8VxVU6HrwQ7kNvwEyDq9C&_nc_oc=AdrEh3wRP1UwS0hrQ8wy9VRtX_sepsgDVi5ifB9bP4iYTpmZck9NWkjRWve-VTZVem4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gdupph_pue1AUTpnMarXFB3f6PjCFule5HUexydlh0g&oe=69F9E6ED"}, {"file_name": "Shoot_A_Goal_SS5.png", "id": "1619859358406781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_1619859361740114_2820161117577168771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7IMfOnCvOAQ7kNvwHzOIR-&_nc_oc=AdpFwOXQec9Ic8IwXg-yYACd8kyZfw7SnVV0XtB5shggQmTugFv1fvUHyfdfw6VeaJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50Oy9pJHKtEDXkjQY-gKLrt4gB_YL2uP1B8Y5kNw8HbQ&oe=69FA0C91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shoot A Goal", "keywords": [], "long_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!\n\n- Clear the game by putting all the shots on goal within a certain number of shots and within a certain amount of time.\n- Clear the game if you can shoot the ball into the goal of different sizes by the time limit. \n- If you can shoot at the goal with a number that matches the formula displayed in front of you, you will clear the game.\n- Find the goal hidden in the panel and shoot to complete the game.\n- The game is cleared when the balls hit the cans and all of them drop to the ground.\nOr, after hitting the ball to the cans, if all the cans are put into the goal, the game is cleared.\n- Match the panels with the letters of the goal, and clear the game if all panels are erased.", "short_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!"}]}, "developer_name": "SimpleOne", "developer_privacy_policy_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "SimpleOne", "support_website_url": null, "website_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1063161134548771
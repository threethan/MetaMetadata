T4a8FUQL1pazUCGF9ZKMDA1eB6CmUSKoTnq9hu2Y2_eLMkg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3ZMtHcPxf9ecYRtlTXz4UPiJ5yJeARcfO5AMwA9HYcQ&oe=69A040ED"}, {"file_name": "Shoot_A_Goal_SS5.png", "id": "1619859358406781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974670_1619859361740114_2820161117577168771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MO6QXf9BD8Q7kNvwEe-DN7&_nc_oc=Adm18lSDIujeUHPcgtebo4yeyLAMAFA_JlvStU5E4BYwiB9vPbYfRXXO6OVrkfskAa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsszJEdJhxi5izZTl56NGyydAZA3nq3Io-AVIR_Ykku9g&oe=69A02E51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shoot A Goal", "keywords": [], "long_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!\n\n- Clear the game by putting all the shots on goal within a certain number of shots and within a certain amount of time.\n- Clear the game if you can shoot the ball into the goal of different sizes by the time limit. \n- If you can shoot at the goal with a number that matches the formula displayed in front of you, you will clear the game.\n- Find the goal hidden in the panel and shoot to complete the game.\n- The game is cleared when the balls hit the cans and all of them drop to the ground.\nOr, after hitting the ball to the cans, if all the cans are put into the goal, the game is cleared.\n- Match the panels with the letters of the goal, and clear the game if all panels are erased.", "short_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!"}]}, "developer_name": "SimpleOne", "developer_privacy_policy_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name"
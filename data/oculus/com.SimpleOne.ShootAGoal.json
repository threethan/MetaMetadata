12_7549119371157951569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VswGmU8uARMQ7kNvwHtRGhB&_nc_oc=AdkGDxD_KhvvmvKesyKDPDRmtZN2JSG_ie81yKluQqEA9MVBFQ4NMJKnGcT9ZID1_mc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftqjXDpv9Oo8oe8CiAgqReEt1ucu_MLv1IfW75vCJgCIQ&oe=69A56A9B"}, {"file_name": "Shoot_A_Goal_SS3.png", "id": "724497408718125", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974826_724497412051458_5567733157785994202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrokBqCVirQQ7kNvwE-nAVN&_nc_oc=Adl99vOJpmrAi5oXEWFZxr9hIzufew5tuzydF9BDQdPqoM2XOamOgpR8RaMuMZQQ_fQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuryAOSxMgULjdGktk4IFKE289HF2f9Kp3hyq7oK6S2CA&oe=69A57B15"}, {"file_name": "Shoot_A_Goal_SS4.png", "id": "5162931373766450", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974645_5162931377099783_6655422942171392247_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8vUWJ3bebEQ7kNvwE5bqP7&_nc_oc=AdkQHtNWEQb-kJgYbklk35OOZJnRHZAnGmvXa8g1Wg7Mi33KumO0S-rRU-pt4Hex68w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftjcrnwttyzXefaSu_ySw2cFrJnaBuDTomdcEihq9Oc3A&oe=69A586ED"}, {"file_name": "Shoot_A_Goal_SS5.png", "id": "1619859358406781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974670_1619859361740114_2820161117577168771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GeJKQ8iFjoQ7kNvwEpa4d_&_nc_oc=AdlBsz0ESGHBqCHJq_144tXbFsQS8ipzlGPRnsRkxohYwy5ZskQz3sUwaCStAf3XRX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftxBrzLjYe2EpccCZKe18S6iKOqBOvw__punBR2qot67g&oe=69A57451"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shoot A Goal", "keywords": [], "long_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!\n\n- Clear the game by putting all the shots on goal within a certain number of shots and within a certain amount of time.\n- Clear the game if you can shoot the ball into the goal of different sizes by the time limit. \n- If you can shoot at the goal with a number that matches the formula displayed in front of you, you will clear the game.\n- Find the goal hidden in the panel and shoot to complete the game.\n- The game is cleared when the balls hit the cans and all of them drop to the ground.\nOr, after hitting the ball to the cans, if all the cans are put into the goal, the game is cleared.\n- Match the panels with the letters of the goal, and clear the game if all panels are erased.", "short_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!"}]}, "developer_name": "SimpleOne", "developer_privacy_policy_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "SimpleOne", "support_website_url": null, "website_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1063161134548771"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_1311479339681072_79235645568697292
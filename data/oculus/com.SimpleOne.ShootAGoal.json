12_7549119371157951569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c3E4vPS8w8Q7kNvwEgjDDC&_nc_oc=AdoElYRhrMRUz61pGpgB9tVHwMgBGwdmZTLkbZ6WWhU69LryRLb0Y41cxNf4pGOvUvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2ew6tGJsLgMHDnXj_W9TwwzU77gdPE6jMWOqyPbu8ooA&oe=69F0C85B"}, {"file_name": "Shoot_A_Goal_SS3.png", "id": "724497408718125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974826_724497412051458_5567733157785994202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VIzTlHgouMQ7kNvwEgHqDH&_nc_oc=Adp91kdtDA1RjEFOVfqt5HoIfbgUsE2h-B8apqQeYmNKp-AcpKB8TloJAJD1DMIcwvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2v5Fkmmjqb_vWgUdGvhVWzLmQHcaJa_aWe6QK_Hp_GtA&oe=69F0A095"}, {"file_name": "Shoot_A_Goal_SS4.png", "id": "5162931373766450", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_5162931377099783_6655422942171392247_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsdiseG-gM8Q7kNvwFQKPsx&_nc_oc=AdqDJhmCQBQJMLfdz2w5F5Cm4JUJ6cOezWL9SAUb_sjNgC1AjCHlt_fiqc7D43qPk30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3WRnD3w-ilXegOLotEU5NudivYH8XAB2UyOFauHdB59g&oe=69F0AC6D"}, {"file_name": "Shoot_A_Goal_SS5.png", "id": "1619859358406781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974670_1619859361740114_2820161117577168771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=189ulDVLQYcQ7kNvwHDS54x&_nc_oc=AdpBBuCfyekOPbMmgYU-CsLrydUPfBlLnG0sLseTdVvr0mbaNAddtJuvgy81NBWzwi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0qD5KEpJminUe2mII3YIPYBR6YGZul3boL5T6cl-zxXw&oe=69F0D211"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shoot A Goal", "keywords": [], "long_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!\n\n- Clear the game by putting all the shots on goal within a certain number of shots and within a certain amount of time.\n- Clear the game if you can shoot the ball into the goal of different sizes by the time limit. \n- If you can shoot at the goal with a number that matches the formula displayed in front of you, you will clear the game.\n- Find the goal hidden in the panel and shoot to complete the game.\n- The game is cleared when the balls hit the cans and all of them drop to the ground.\nOr, after hitting the ball to the cans, if all the cans are put into the goal, the game is cleared.\n- Match the panels with the letters of the goal, and clear the game if all panels are erased.", "short_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!"}]}, "developer_name": "SimpleOne", "developer_privacy_policy_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "SimpleOne", "support_website_url": null, "website_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1063161134548771"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_1311479339681072_79235645568697292
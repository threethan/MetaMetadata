ANUBFLsCtdDkqA&oe=69CA6515"}, {"file_name": "Shoot_A_Goal_SS4.png", "id": "5162931373766450", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_5162931377099783_6655422942171392247_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lOw7CQ6N_AQ7kNvwEjqkXQ&_nc_oc=Adqtg1IYribdAyiUVlkgSTc5o3jj9DfDTUzMPpjzeUn5coy3EHFmjSPl0G40g45T-rc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrPLanJ7B3A3v3hYEGuniyW4s1rW7XLWdnsX2CIZZhBA&oe=69CA70ED"}, {"file_name": "Shoot_A_Goal_SS5.png", "id": "1619859358406781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974670_1619859361740114_2820161117577168771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoBE5q84Ez4Q7kNvwF9kA9y&_nc_oc=AdpjdW58npt-_Aj-eOI7OhHEfm7W-0gaPjUErjbnIrq2j4FGGOqRROlsC4qi7nYB8Ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcfdQyp9uFj0m5omRSEdpMuRJpNOudVTXS9vX_TVGodg&oe=69CA5E51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shoot A Goal", "keywords": [], "long_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!\n\n- Clear the game by putting all the shots on goal within a certain number of shots and within a certain amount of time.\n- Clear the game if you can shoot the ball into the goal of different sizes by the time limit. \n- If you can shoot at the goal with a number that matches the formula displayed in front of you, you will clear the game.\n- Find the goal hidden in the panel and shoot to complete the game.\n- The game is cleared when the balls hit the cans and all of them drop to the ground.\nOr, after hitting the ball to the cans, if all the cans are put into the goal, the game is cleared.\n- Match the panels with the letters of the goal, and clear the game if all panels are erased.", "short_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!"}]}, "developer_name": "SimpleOne", "developer_privacy_policy_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "SimpleOne", "support_website_url": null, "website_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1063161134548771"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4972042632875774", "version": "1.0"}, "id": "5144903862262650", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4969022013177836", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4972042632875774"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "5144903862262650"}]}, "change_log": null, "create
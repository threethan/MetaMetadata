k35OOZJnRHZAnGmvXa8g1Wg7Mi33KumO0S-rRU-pt4Hex68w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftjcrnwttyzXefaSu_ySw2cFrJnaBuDTomdcEihq9Oc3A&oe=69A586ED"}, {"file_name": "Shoot_A_Goal_SS5.png", "id": "1619859358406781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974670_1619859361740114_2820161117577168771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GeJKQ8iFjoQ7kNvwEpa4d_&_nc_oc=AdlBsz0ESGHBqCHJq_144tXbFsQS8ipzlGPRnsRkxohYwy5ZskQz3sUwaCStAf3XRX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftxBrzLjYe2EpccCZKe18S6iKOqBOvw__punBR2qot67g&oe=69A57451"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shoot A Goal", "keywords": [], "long_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!\n\n- Clear the game by putting all the shots on goal within a certain number of shots and within a certain amount of time.\n- Clear the game if you can shoot the ball into the goal of different sizes by the time limit. \n- If you can shoot at the goal with a number that matches the formula displayed in front of you, you will clear the game.\n- Find the goal hidden in the panel and shoot to complete the game.\n- The game is cleared when the balls hit the cans and all of them drop to the ground.\nOr, after hitting the ball to the cans, if all the cans are put into the goal, the game is cleared.\n- Match the panels with the letters of the goal, and clear the game if all panels are erased.", "short_description": "Shoot at the goal with a basketball!\nThere are six different challenges and multiple difficulty levels, and once you complete a certain number you can change the effects on the ball!"}]}, "developer_name": "SimpleOne", "developer_privacy_policy_url": "https://github.com/simpleone-vr/Shoot_A_Goal/wiki/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name"
K-0VrD_w_m_IIWJi7l0dlsaXLdnHl_vHP7Q-H6Q-R8gA&oe=6AAAA19A"}, {"file_name": "ScreenShot4.png", "id": "1349155860748508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_1349155864081841_4497716898819323830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7__rea6bdQgQ7kNvwErsPf9&_nc_oc=Adq1OMGh8Oj4BvrrP1Edb5JWZxAnhSrnl_AH1FPUEmbw7LwxAh1a4pQY_487u3azbNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSf58x-FzXaoR493GkBgxl9ZoG70BtORQdY05yY_w92Q&oe=6AAAB07D"}, {"file_name": "ScreenShot5.png", "id": "984243407973399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312338_984243411306732_400133234360882969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Pq1Qen-QH8Q7kNvwH7aq2N&_nc_oc=AdpDktbEvAQUIw8W5q4QWupOrD96q_dynY77QoKzfvVd2TQa1yjBiE8TRF0jy1LI1uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcyX5dGWFd4-cmh2kAvOTxB-tf7ji6dzr2UtFXjeG1Bg&oe=6AAA97F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeTitle.png", "id": "2892877131062309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_2892877134395642_793117922446388286_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4j33q2WczsQ7kNvwG4xVkr&_nc_oc=AdoQAeO5FeNfD2rGfvB0t6TCD386vAajmRSq-inIFxmeA5crIkOB3L9z9Rgm0_Kma7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ63b4foTBkCOtd7xAaRLxUTftg_JWauxHpWGzwTFGwsw&oe=6AAAA7D1"}, "display_name": "The Salem Witch Trials", "keywords": ["Witch", "Magic", "Wolf", "Mummy", "Monster"], "long_description": "Fight through a cursed world where the victims of the Salem witch trials remain trapped between life and death.\n\nBattle monsters, mummies, skeletons, vampires, reptilian warriors, wolves, snakes, and powerful bosses. These creatures are the corrupted souls of the people who condemned innocent women during the witch trials.\n\nExplore nine action-packed levels, unlocking a new melee weapon after each one. Every weapon has its own hidden supernatural power. Defeat enough enemies to earn five charges of a random special ability, including freezing, lightning, fire, and more.\n\nAt the end of each level, rescue one of The Forgotten Nine\u2014nine women executed during the Salem witch trials. Learn who they were, why they were accused, and the tragic fate they suffered. Restore their stories and uncover the truth behind one of history's darkest chapters.\n\nFeatures\n\n9 immersive levels\nEpic boss fight in every level\n8 unlockable melee weapons\nHidden elemental weapon powers\nFast-paced VR melee combat\nRescue The Forgotten Nine and discover their real stories", "short_description": "Fight through a cursed world where the victims of the Salem witch trials await salvation. Battle monstrous executioners, unlock powerful melee weapons with hidden magical powers, defeat epic bosses, and rescue The Forgotten Nine. Discover the true stories of nine innocent women while surviving intense VR action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=The+Salem+Witch+Trials", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
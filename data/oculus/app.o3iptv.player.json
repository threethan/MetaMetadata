keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27821341417531104"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "New\r\n- The home sports rail is now Top 10 Sports Events, ranked for the day.\r\n- Home rails show one card per title instead of one per language or quality.\r\n\r\nImproved\r\n- The home banner cross-dissolves between titles and no longer stutters when it loops.\r\n- The Guide opens on the category your provider lists first, and remembers the one you used last.\r\n- Channel previews in the Guide fade in instead of flashing black.\r\n- Top TV Channels shows proper channel logos.\r\n- Episode names and descriptions follow the app language.\r\n- Darker theme: black content area with a lighter sidebar.\r\n\r\nFixed\r\n- Continue Watching no longer shows a barely-watched title as finished.\r\n- Fixed a crash in Sports Hub when the posts carousel appeared.", "created_date": 1787618659, "id": "27821341417531104", "version": "3.1.29", "version_code": 4045, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27821341417531104"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "Fixed the app closing during playback on large playlists.\r\nFixed resuming a series from Continue Watching, which showed the episode as unavailable instead of playing it.\r\nFixed searching the Guide on large playlists.\r\nFixed the keyboard reopening by itself after resizing the app panel.\r\nContinue Watching and Top TV Channels now load faster.", "created_date": 1787173121, "id": "27759388910393022", "version": "3.1.28", "version_code": 4044, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27821341417531104"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- Series specials now appear. A show's one-offs and extras show as a \"Specials\" block after the regular seasons, with their own titles, art and synopses.\r\n- One card per episode. Episodes a provider lists more than once no longer appear as duplicates, and series that already piled up duplicates clean themselves up.\r\n- Clearer version picking. Versions with no playable file for the episode you chose are labeled \"Not available\", and picking a version never switches you to a different episode.\r\n- Better playback errors. When a file is broken at the provider the player says so instead of blaming a connection limit, and offers \"Try Another Version\" right in the player, now for series as well as movies.\r\n- Subtitle downloads work again when signed out, and each download tells you how many you have left today.\r\n- Continue Watching rows synced from another device no longer grey out as unavailable.", "created_date": 1787101049, "id": "27748942178104362", "version": "3.1.27", "version_code": 4041, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27821341417531104"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "-Improved expired playlists, which are now named in Settings, badged on Continue Watching and Favorites, and warn you before playback instead of failing silently.\r\n-Improved the version picker, which now shows each quality's own file size.\r\n-Improved Home with Top TV Channels and Recently Added Channels rails.\r\n-Improved background playlist updates, with one settings card and result notifications that name each playlist.\r\n-Improved reliability for series episodes, providers that block the account check, and sports fixture details.", "created_date": 1786691726, "id": "27690521037279810", "version": "3.1.26", "version_code": 4040, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27821341417531104"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- Improved Favorites and Continue Watching, which now cover every playlist you have and stay in sync across your devices.\r\n- Improved reliability for removals and artwork, so removed items stay removed and posters and logos no longer go missing.\r\n- Improved series playback so continuing to the next episode is no longer refused.\r\n- Improved cross-playlist playback so a title stored in another playlist opens instead of failing.\r\n- Improved search with multi-word title matching, merged duplicates across playlists, and clearer source labels.\r\n- Improved kids profile safety so titles that cannot be verified never show their name or poster.\r\n- Improved Home with Popular rails based on what is being watched now, and editorial rails that keep their place.\r\n- Improved performance on repeat Home visits, plus resumable playlist updates on iOS.", "created_date": 1786047622, "id": "27598512109814037", "version": "3.1.25", "version_code": 4039, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
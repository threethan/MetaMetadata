y": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "de", "es_AR", "fr", "nl", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26465441303121129"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1753682809398673"}]}, "baseline_offer": {"id": "1753682809398673"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780936680, "status": "PUBLISHED", "id": "1753682809398673"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28342832718715302", "version": "3.3.5"}, "id": "994646723277799", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28342832718715302"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "-Videos now keep playing when you use another app or panel next to o3IPTV, so you can watch while you play or browse.", "created_date": 1791056295, "id": "28342832718715302", "version": "3.3.5", "version_code": 4156, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28342832718715302"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- Watch in XR 3D now plays 180 and 360 degree VR videos, in 3D or mono, detected from the title or set with Projection in the player.\r\n- VR 180 and VR 360 titles show a VR chip on their details page and open in XR on every Quest, picking the VR version when a movie has several.\r\n- In 180 and 360 videos, the controls appear where you look and the display follows the film's frame rate.\r\n- Your 180 or 360 pick is remembered for each title.\r\n- Switch movie versions without leaving XR 3D, and Continue Watching keeps one row for the movie.\r\n- The headset battery shows on the XR control bar, with low battery notices at 15% and 5%.\r\n- Controller ray: menus and buttons light up when you point at them.\r\n- Lists in every sheet now scroll with the controller ray, and the player and language pickers show a scrollbar.\r\n- Single-connection playlists no longer get cut off by background checks.\r\n- When all connections are in use, the message now suggests another playlist if you have one.\r\n- Sports match pages open with their channels in place.", "created_date": 1790924318, "id": "28323084267356814", "version": "3.3.5", "version_code": 4155, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28342832718715302"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- Fixed a crash when closing the app while a video was playing.\r\n- Browse by Genre on Home: new, popular and top rated titles from your playlist, with grid, list and sorting.\r\n- New Favorites row on Home: your channels, movies, series and teams.\r\n- Exclude new categories automatically, per playlist, synced across your devices.\r\n- Fixed endless loading on some providers that then said all connections were in use.\r\n- New-category notices now show only on the main profile.", "created_date": 1790447418, "id": "28257836330548275", "version": "3.3.4", "version_code": 4136, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28342832718715302"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- XR 3D: a press on a side panel slider grabs the knob where it is, so one sweep sets the value you meant, and the picture and its panels glide together while it resizes.\r\n- XR 3D: a film's own letterbox settles in about half a second again, and a dark shot can no longer squeeze the picture toward a square.\r\n- XR 3D: the Passthrough tile carries a clean icon that matches Void beside it.\r\n- The XR 3D settings block is gone from Settings. The in-headset panels are the place for those controls, and your saved values are unchanged.\r\n- Signing out returns to the Welcome screen instead of a stale code step.\r\n- A running download no longer follows the headset to the next account, and an account switch or a cold start can no longer cost you your sign-in.\r\n- Browse in a list or a grid, and sort by name, release year or recently added.\r\n- Sports: choose your favorite leagues, then open My leagues for today's games and what is coming up.\r\n- On a game, o3IPTV finds the channels carrying it from your own guide and from channel names.\r\n- Live and upcoming games on Home stay current instead of lingering after they end.\r\n- Devices in your account now show their real names, Device Management says how many of your slots are in use, and signing in at the limit lets you pick a device to sign out and then finishes by itself.\r\n- A headset that was signed out now says why it happened and how to get back in.\r\n- Approving a new device explains a failed code in plain words.\r\n- You can sign in to OpenSubtitles again when a subtitle session expires, with a clear message when it fails.\r\n- VPN: Renew connection keeps the server you were on, shows its progress and confirms in place.\r\n- Portuguese wording is consistent across the app.", "created_date": 1790012192, "id": "28188299177501991", "version": "3.3.3", "version_code": 4134, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28342832718715302"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- New: Watch in XR 3D. Any movie or episode on a virtual cinema screen with real depth, converted on the headset as it plays (Quest 3 and 3S), and real side-by-side 3D films on every headset.\r\n- Comfort, Standard and Strong depth presets. Move and resize the screen, download subtitles in the headset, and continue in XR 3D from Continue Watching.\r\n- Pick your surroundings: Void, Passthrough or a scene from the environment gallery. Scenes download once, work offline, and new ones arrive without an app update.\r\n- A light controller tick when the pointer lands on a control.\r\n- The 3D badge checks the video itself, so flat titles with 3D in the name are no longer marked 3D.\r\n- Channels now sort in natural order: ESPN 2 comes before ESPN 11.\r\n- New provider categories are marked \"New\" on Home, in the category pickers and in Manage categories.\r\n- Lock any profile with a PIN, asked on every switch to it. \"Forgot PIN\" emails a reset code.\r\n- Your OpenSubtitles login follows your account to every device. Sign out on one device or everywhere.\r\n- Hidden categories stay in sync across your devices, and showing one again sticks everywhere.\r\n- Recently used categories appear first in the category pickers for Live TV, Guide, Catch Up, Movies and Series.\r\n- Home is ready sooner after launch on large playlists.\r\n- Signing in a new device at your device limit now goes straight to removing one.\r\n- Deleting an expired source clears its expired notice.", "created_date": 1789368968, "id": "28087351400930103", "version": "3.3.2", "version_code": 4128, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
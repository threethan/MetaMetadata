keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27598512109814037"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- Improved Favorites and Continue Watching, which now cover every playlist you have and stay in sync across your devices.\r\n- Improved reliability for removals and artwork, so removed items stay removed and posters and logos no longer go missing.\r\n- Improved series playback so continuing to the next episode is no longer refused.\r\n- Improved cross-playlist playback so a title stored in another playlist opens instead of failing.\r\n- Improved search with multi-word title matching, merged duplicates across playlists, and clearer source labels.\r\n- Improved kids profile safety so titles that cannot be verified never show their name or poster.\r\n- Improved Home with Popular rails based on what is being watched now, and editorial rails that keep their place.\r\n- Improved performance on repeat Home visits, plus resumable playlist updates on iOS.", "created_date": 1786047622, "id": "27598512109814037", "version": "3.1.25", "version_code": 4039, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27598512109814037"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "\u2022 New Home rails: award-winning movies and series, complete series to binge, complete movie sagas, and what's popular on major streaming services, all matched to your own catalog and rotating daily\r\n\u2022 Online subtitles: sign in, search in your language, and reuse downloads offline\r\n\u2022 Preferred audio and subtitle languages, applied automatically during playback\r\n\u2022 New aspect ratio picker: Fit, Fill, or Stretch\r\n\u2022 Switch stream versions from inside the player, ranked by quality\r\n\u2022 Tap any cast member to see their films and shows from your library\r\n\u2022 More Like This and Recommendations on series details\r\n\u2022 The whole app is now available in all seven supported languages\r\n\u2022 Fixed an issue that could unexpectedly sign you out\r\n\u2022 Overnight automatic playlist updates now run reliably\r\n\u2022 Sharper Continue Watching artwork", "created_date": 1785825547, "id": "27565585943106654", "version": "3.1.24", "version_code": 4038, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27598512109814037"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "New on Home: Because You Watched and Smart Discover shelves, plus award and seasonal rails. \r\nMovie details now show franchise collections and mark the next part you have not watched.\r\nFaster: catalog imports are over 2x quicker and the TV guide loads in a quarter of the time.", "created_date": 1785288471, "id": "27494532956878620", "version": "3.1.22", "version_code": 4037, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27598512109814037"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "\u2022 Subscribe to Premium directly in the headset: monthly, 6-month, and yearly plans, with restore purchases support\r\n\u2022 New Top 10 Movies and Top 10 TV Shows rows on Home\r\n\u2022 Grouped titles show language badges, and downloads let you pick the version you want\r\n\u2022 Downloads are more reliable: the queue survives app restarts and failed items can be retried\r\n\u2022 Sharper channel logos and a cleaner TV guide\r\n\u2022 Performance improvements and bug fixes", "created_date": 1785118649, "id": "27471617399170176", "version": "3.1.20", "version_code": 4036, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27598512109814037"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "Live TV & Guide\r\n- TV guide imports no longer fail on slow providers: big guide files keep downloading as long as data is flowing, instead of hitting a hard 60-second cap.\r\n- Catch Up now lists only channels that actually have archive guide data, and its time window is fixed.\r\n- Guide preview playback stops when you leave the guide tab.\r\n\r\nSources & updates\r\n- Sources with auto-update now refresh while the app stays open (desktop included), not just at launch.\r\n- Updates keep your favorites and continue-watching intact, and pick up provider-side edits (renamed titles, new posters, catch-up flags) without a full refresh.\r\n- Multiple sources update one at a time, so busy providers stop returning empty catalogs.\r\n- If one part of an update fails (say series), it catches up and retries on its own, and the source card in Settings shows exactly what failed with a Retry button.\r\n\r\nCloud & devices\r\n- Setting up a new device is faster: sources from different providers restore in parallel.\r\n- Dead cloud sources no longer re-import in a loop; they show under \"Sources that need attention\" in Settings with Retry and Remove.\r\n\r\nSeries & navigation\r\n- Tapping an episode thumbnail now offers the version picker so you can choose the best copy.\r\n- Main tabs stay loaded when you switch, so moving around the app is instant.\r\n\r\nDesktop & Windows\r\n- True window fullscreen on Windows (F11, Esc, or the title-bar button).\r\n- Smooth mouse-wheel scrolling across the main screens.\r\n- Fixed white specks on the guide's active cell and a stray rounded corner in fullscreen.\r\n\r\nSports\r\n- Group-stage standings now split into their proper groups.\r\n\r\nOther\r\n- The subscription screen now shows Terms and Privacy links and clear billing lengths.", "created_date": 1784017329, "id": "27329770953354822", "version": "3.1.19", "version_code": 4035, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
ded_processor": null, "supported_in_app_languages": ["en", "ar", "de", "es_AR", "fr", "nl", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26465441303121129"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1753682809398673"}]}, "baseline_offer": {"id": "1753682809398673"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780936680, "status": "PUBLISHED", "id": "1753682809398673"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28188299177501991", "version": "3.3.3"}, "id": "994646723277799", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28188299177501991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- XR 3D: a press on a side panel slider grabs the knob where it is, so one sweep sets the value you meant, and the picture and its panels glide together while it resizes.\r\n- XR 3D: a film's own letterbox settles in about half a second again, and a dark shot can no longer squeeze the picture toward a square.\r\n- XR 3D: the Passthrough tile carries a clean icon that matches Void beside it.\r\n- The XR 3D settings block is gone from Settings. The in-headset panels are the place for those controls, and your saved values are unchanged.\r\n- Signing out returns to the Welcome screen instead of a stale code step.\r\n- A running download no longer follows the headset to the next account, and an account switch or a cold start can no longer cost you your sign-in.\r\n- Browse in a list or a grid, and sort by name, release year or recently added.\r\n- Sports: choose your favorite leagues, then open My leagues for today's games and what is coming up.\r\n- On a game, o3IPTV finds the channels carrying it from your own guide and from channel names.\r\n- Live and upcoming games on Home stay current instead of lingering after they end.\r\n- Devices in your account now show their real names, Device Management says how many of your slots are in use, and signing in at the limit lets you pick a device to sign out and then finishes by itself.\r\n- A headset that was signed out now says why it happened and how to get back in.\r\n- Approving a new device explains a failed code in plain words.\r\n- You can sign in to OpenSubtitles again when a subtitle session expires, with a clear message when it fails.\r\n- VPN: Renew connection keeps the server you were on, shows its progress and confirms in place.\r\n- Portuguese wording is consistent across the app.", "created_date": 1790012192, "id": "28188299177501991", "version": "3.3.3", "version_code": 4134, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28188299177501991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- New: Watch in XR 3D. Any movie or episode on a virtual cinema screen with real depth, converted on the headset as it plays (Quest 3 and 3S), and real side-by-side 3D films on every headset.\r\n- Comfort, Standard and Strong depth presets. Move and resize the screen, download subtitles in the headset, and continue in XR 3D from Continue Watching.\r\n- Pick your surroundings: Void, Passthrough or a scene from the environment gallery. Scenes download once, work offline, and new ones arrive without an app update.\r\n- A light controller tick when the pointer lands on a control.\r\n- The 3D badge checks the video itself, so flat titles with 3D in the name are no longer marked 3D.\r\n- Channels now sort in natural order: ESPN 2 comes before ESPN 11.\r\n- New provider categories are marked \"New\" on Home, in the category pickers and in Manage categories.\r\n- Lock any profile with a PIN, asked on every switch to it. \"Forgot PIN\" emails a reset code.\r\n- Your OpenSubtitles login follows your account to every device. Sign out on one device or everywhere.\r\n- Hidden categories stay in sync across your devices, and showing one again sticks everywhere.\r\n- Recently used categories appear first in the category pickers for Live TV, Guide, Catch Up, Movies and Series.\r\n- Home is ready sooner after launch on large playlists.\r\n- Signing in a new device at your device limit now goes straight to removing one.\r\n- Deleting an expired source clears its expired notice.", "created_date": 1789368968, "id": "28087351400930103", "version": "3.3.2", "version_code": 4128, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28188299177501991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- Watch in XR 3D: play any movie or episode on a virtual cinema screen with real depth, converted on the headset as it plays (Quest 3 and Quest 3S), or play real 3D films (side by side) natively on every headset.\r\n- Pick Comfort, Standard or Strong depth, and choose where you watch: Void, Passthrough or the Moonlit Field. Move and resize the screen; the 3D settings sit beside it while the film plays.\r\n- Download subtitles inside the headset, pick the one you want, and it turns on right away.\r\n- \"Continue in XR 3D\" from Continue Watching, on movies and episodes. Watch in 2D any time and the film carries on where you left it on the flat panel.\r\n- Sources you have put behind a VPN stream through it in the headset too.\r\n- New provider categories are flagged \"New\" instead of appearing silently: on Home, in the browse pickers and in Manage categories.\r\n- Lock any profile with a PIN, asked on every switch to that profile. \"Forgot PIN\" emails you a reset code.\r\n- Your OpenSubtitles login follows your account to every device. Sign out on one device or everywhere.", "created_date": 1789098250, "id": "28044848135180430", "version": "3.3.0", "version_code": 4114, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28188299177501991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "- Watch in XR 3D: play any movie or episode on a virtual cinema screen with real depth, converted on the headset as it plays (Quest 3 and Quest 3S), or play real 3D films (side by side) natively on every headset.\r\n- Pick Comfort, Standard or Strong depth, and choose where you watch: Void, Passthrough or the Moonlit Field. Move and resize the screen; the 3D settings sit beside it while the film plays.\r\n- Download subtitles inside the headset, pick the one you want, and it turns on right away.\r\n- \"Continue in XR 3D\" from Continue Watching, on movies and episodes. Watch in 2D any time and the film carries on where you left it on the flat panel.\r\n- Sources you have put behind a VPN stream through it in the headset too.\r\n- New provider categories are flagged \"New\" instead of appearing silently: on Home, in the browse pickers and in Manage categories.\r\n- Lock any profile with a PIN, asked on every switch to that profile. \"Forgot PIN\" emails you a reset code.\r\n- Your OpenSubtitles login follows your account to every device. Sign out on one device or everywhere.", "created_date": 1789089010, "id": "28043331721998738", "version": "3.3.0", "version_code": 4109, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28188299177501991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "Fixed a crash when closing the app while a video was playing.\r\nFixed a crash when searching or filtering Movies and Series on very large playlists.\r\nFixed a video engine issue that could freeze playback after 10 to 20 minutes of continuous viewing.\r\nLive channels start faster, switching is quicker, and a stalled stream recovers on its own.\r\nFixed a rare crash when switching channels. Playback no longer stops over a single decode glitch.\r\nThe progress bar slides smoothly, with a time bubble while you scrub.\r\nChannel logos fall back to our own logo service when your provider's are missing.\r\nHome loads faster, with Continue Watching first.\r\nA title removed from Continue Watching on one device no longer comes back from another.", "created_date": 1788499472, "id": "27954057797592798", "version": "3.2.2", "version_code": 4050, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
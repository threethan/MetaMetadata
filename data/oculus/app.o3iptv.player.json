andard and Strong depth presets\n- Move and resize the screen, watch in Void, Passthrough or a downloadable scene\n- Download subtitles inside the headset\n- Continue in XR 3D from Continue Watching, or switch back to 2D and keep your place\n\nPlayer only. o3IPTV does not provide content.\nTRY IT FREE FOR 14 DAYS. THEN KEEP IT FOR JUST $1.49/MONTH OR $12.99/YEAR.", "short_description": "ONE PLAYER. ACROSS YOUR DEVICES. ALWAYS IN SYNC.\nNEW: WATCH IN XR 3D OR REAL 3D.\nTRY IT FREE FOR 14 DAYS. THEN KEEP IT FOR JUST $1.49/MONTH OR $12.99/YEAR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://o3iptv.app/privacy-policy/", "developer_terms_of_service_url": "https://o3iptv.app/terms-of-use/", "publisher_name": "o3IPTV LLC", "support_website_url": "https://discord.gg/dpyrGgp835", "website_url": "https://o3iptv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "de", "es_AR", "fr", "nl", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28270238599308048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311582_961899330008491_1349055035110773010_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXaPuLWZGAgQ7kNvwEHK_mP&_nc_oc=AdpvYUNFIP5MNXsAPPfHLQr81-ynvW8tzrG0Om1jFgTnyLXBiIaSQJIGzwbvIugDcXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoHOekHkMAXgq3icHJjdYZn-tEeJmRzU3Pfj6dKWW_Kw&oe=6AE0C
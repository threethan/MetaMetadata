keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27329770953354822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "Live TV & Guide\r\n- TV guide imports no longer fail on slow providers: big guide files keep downloading as long as data is flowing, instead of hitting a hard 60-second cap.\r\n- Catch Up now lists only channels that actually have archive guide data, and its time window is fixed.\r\n- Guide preview playback stops when you leave the guide tab.\r\n\r\nSources & updates\r\n- Sources with auto-update now refresh while the app stays open (desktop included), not just at launch.\r\n- Updates keep your favorites and continue-watching intact, and pick up provider-side edits (renamed titles, new posters, catch-up flags) without a full refresh.\r\n- Multiple sources update one at a time, so busy providers stop returning empty catalogs.\r\n- If one part of an update fails (say series), it catches up and retries on its own, and the source card in Settings shows exactly what failed with a Retry button.\r\n\r\nCloud & devices\r\n- Setting up a new device is faster: sources from different providers restore in parallel.\r\n- Dead cloud sources no longer re-import in a loop; they show under \"Sources that need attention\" in Settings with Retry and Remove.\r\n\r\nSeries & navigation\r\n- Tapping an episode thumbnail now offers the version picker so you can choose the best copy.\r\n- Main tabs stay loaded when you switch, so moving around the app is instant.\r\n\r\nDesktop & Windows\r\n- True window fullscreen on Windows (F11, Esc, or the title-bar button).\r\n- Smooth mouse-wheel scrolling across the main screens.\r\n- Fixed white specks on the guide's active cell and a stray rounded corner in fullscreen.\r\n\r\nSports\r\n- Group-stage standings now split into their proper groups.\r\n\r\nOther\r\n- The subscription screen now shows Terms and Privacy links and clear billing lengths.", "created_date": 1784017329, "id": "27329770953354822", "version": "3.1.19", "version_code": 4035, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27329770953354822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "What's new in 3.1.18:\r\n\r\n  Live TV\r\n  - Fixed live channels that wouldn't play on some providers (now connects via your portal host and follows the provider's redirect to a working server).\r\n  - Blocked or offline channels fail fast with a clear message instead of spinning. \r\n  - Faster start on single-connection providers, plus a new Low / Balanced / High buffer setting.\r\n  - New per-channel deinterlacing toggle.\r\n  - Channels with no logo show the o3 brand mark instead of a blank tile.\r\n\r\n  Library & artwork\r\n  - Series detail now shows its title logo, like movies.\r\n  - Channel logos in Favorites, Continue Watching, and More From are no longer zoomed or cropped.\r\n  - Cleaner grouping of duplicate titles that use language prefixes. \r\n\r\n  Favorites & errors\r\n  - Deleting a playlist now clears its favorites (no more orphans with no source).\r\n  - Cloud-restore/database errors show a clear dialog instead of an inline banner.\r\n\r\n  Subscriptions\r\n  - Free trial is no longer re-granted to former subscribers; Google Play billing fixes.", "created_date": 1782428498, "id": "27129750906690162", "version": "3.1.18", "version_code": 4034, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27329770953354822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "Improved Watch Now browsing with cleaner title grouping, version selection, availability hints, and richer hero metadata.\r\n\r\nImproved guide matching for providers that use display names or rewritten EPG IDs, so more channels keep their schedule data.\r\n\r\nImproved playback reliability for live streams, guide previews, Next Episode playback, cached artwork, and stream startup.\r\n\r\nImproved library/import stability with reduced database lock contention, clearer import progress, and more resilient cloud restore behavior.\r\n\r\n  Improved sports browsing feedback, preview handoff, and broadcaster status displays.\r\n\r\n  Updated the Quest Store build path for sign-in-only Premium access: no in-app purchase flow, with Premium still enforced through account sign-in.", "created_date": 1781467019, "id": "26997658083232779", "version": "3.1.17", "version_code": 4033, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27329770953354822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "Sports Hub\r\n  - Added World Cup YouTube highlights\r\n  - Smoother competition highlights rail with fewer loading jumps\r\n  - Fixtures stay visible even when catalog details are still catching up\r\n\r\n  Guide & Playback\r\n  - Restored guide preview playback\r\n  - Filled missing guide gaps more reliably\r\n  - Improved mobile live playback stability, especially on cellular\r\n  - Removed duplicate focus-player actions\r\n\r\n  Library & Navigation\r\n  - Faster recent library loading\r\n  - Catch-up detail now returns to Home more cleanly\r\n  - Watch Now logos load more reliably\r\n\r\n  Polish & Reliability\r\n  - Hid noisy Today TV load failures\r\n  - Smoother content route transitions\r\n  - Additional stability fixes across playback, guide, and Sports Hub", "created_date": 1781046977, "id": "26935230852808836", "version": "3.1.14", "version_code": 4032, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26465441283121131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27329770953354822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994646723277799"}]}, "change_log": "o3IPTV initial release", "created_date": 1780447301, "id": "26849251128073476", "version": "3.1.8", "version_code": 4031, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__
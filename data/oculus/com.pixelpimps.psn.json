138531_8566456234880794624_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G6KLeiR8z8Q7kNvwHcrYCA&_nc_oc=AdqZxS9J1s7uaypjU5hvONAPRPemikS43MxPm0mde1sj6SqhjtKzUDcH4GHKu87uHNU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gALzRkT9X4pJxNy-9Vatx9zv17lnhP8gwtGKisaU3VQ&oe=6A22F45D"}, {"file_name": "migrated_image.png", "id": "762200544304229", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974491_1041754996187366_4398665123833577472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMnOMoIX_T0Q7kNvwFzk4Py&_nc_oc=AdpRXhvx-66N4v1Qa7rVIQmPpiL60EqWpNJqMjDPlRyKxbdy9XUOqUHLLbYvDJkdR9A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G7LYPIjs0KfCFZwd5ME0D0L5SCT2e1cLkoIOvWBM6kw&oe=6A22EA4D"}, {"file_name": "migrated_image.png", "id": "642817906294017", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974591_507078186513992_6929025263523069952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzKHM1Mae-UQ7kNvwHgVmgw&_nc_oc=AdpCLSJeBaW6obCiC91GWinAeGIsF5e23kz2zVjvMQGLkcVQGFPI--liPW1WS88PWfc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9StTaJb_QPagzIElBZozUcudyDMuMDWijx1T8axyGo6Q&oe=6A22EBED"}, {"file_name": "migrated_image.png", "id": "3089594414384514", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982502_869110003543323_3406698867264061440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv1_pzvtJjIQ7kNvwEozwut&_nc_oc=AdpepSZjFjI7dA85UmhgfnhkWCJhHPm4IgtMb4sEJyupNCX1KNU71sJ2CdOHhrHmryA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jBJiAiXLf1TKD13y1E9WpzylNpZdubQQuI1D9vQekqA&oe=6A22E50C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Umvt9q", "id": "786762798399126", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57572923_786762801732459_3092996182541074432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veUeSbd_TdcQ7kNvwF7qiTX&_nc_oc=AdoHKuERiM0hzoKqO8OyufaUD50hl1yafWafnOf3_aaeA7cQksjYKIDgol7mzo6LCtM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__LovIFUlQ7d6RmzrsVmrwCfX0TsLU8qPS1kJkcHDyjQ&oe=6A22E050"}, "display_name": "Crazy World VR", "keywords": ["Casual", "Sports", "Arcade", "Social", "Multiplayer"], "long_description": "Come & wonder around this beautifully landscaped Nexon theme park, interact with total stranger, and make new friends online. Crazy arcade VR offers various mini games you can play with others online, together with social & customization features. \nDuring the early access; i)Tennis: An arcade style tennis you can go solo or play with others online. ii)Crossbow: A challenging crossbow game to compete with others. iii)Shooting: Unleash your shooting instinct and go crazy to set new record iV)Bowling: Let\u2019s see who\u2019s got the skill. We are looking for serial strikers. v)My room: For you to manage and customize your characters and inventory. \n**Please note that the game is an online game that requires internet connection. And only accessible from a few selected regions with limited amount of game contents for beta testing. We are going to gradually release new game and new contents over the time.**", "short_description": "**Now on Early Access**\nCrazy World VR is a multiplayer social VR game developed by PIXELITY Games(formerly known as PIXELPIMPS) in association with SKTelecom utilizing Nexon\u2019s casual IP. \nThe game offers various mini games you can play with others online, together with social features, and various customization features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelitygames.com/privacy-policy/", "developer_terms_of_service_url": "https://pixelitygames.com/terms-of-service", "publisher_name": "PIXELITY Games Inc.", "support_website_url": null, "website_url": "https://pixelitygames.com/?lang=en", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQ
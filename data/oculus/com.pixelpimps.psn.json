{"data": {"node": {"__typename": "Application", "id": "3849002888453838", "organization": {"id": "258911537850924", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "5891847114211691"}]}, "id": "480746514016792"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "3849002888453838"}]}, "id": "898935747568514"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "2365251143563517"}]}, "id": "408091349910797"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "2090322207665366"}]}, "id": "1992157387744249"}]}}, "firstRevision": {"nodes": [{"application": {"id": "3849002888453838", "release_date": 1623279625, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 0}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4448736698480451"}, "id": "1057061124799470"}]}}, "binary": null, "live_binary": null, "created_date": 1686726450, "id": "6475520599135374", "is_initial_release": false, "name_with_fallback": "v5", "pdp_metadata_with_fallback": {"version": 5, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "217541127857094"}, "release_status": "SCHEDULED", "id": "3849002888453838"}, "id": "217541127857094", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3849002888453838", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "573459894865424"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1223203278367041", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ud06c\ub808\uc774\uc9c0\uc6d4\ub4dc VR", "keywords": [], "long_description": "- VR \uc628\ub77c\uc778 \uc138\uc0c1\uc5d0\uc11c \uce5c\uad6c\ub4e4\uc744 \ub9cc\ub098\uc790!\n\ud06c\ub808\uc774\uc9c0\uc6d4\ub4dc VR\uc740 \ub2e4\uc624, \ubc30\ucc0c \ub4f1 \ub125\uc2a8\uc758 \uac8c\uc784 \uce90\ub9ad\ud130\ub4e4\uc774 \ub4f1\uc7a5\ud558\ub294 \uc2e4\uc2dc\uac04 \uc628\ub77c\uc778 \ub2e4\uc911\uc811\uc18d VR \uac8c\uc784\uc785\ub2c8\ub2e4. VR \uc138\uc0c1\uc5d0\uc11c \uc5ec\ub7ec \uce5c\uad6c\ub4e4\uc744 \ub9cc\ub098 \ud568\uaed8 \uac8c\uc784\ud558\uace0 \uce90\ub9ad\ud130\ub97c \uafb8\ubbf8\uba70 \uac00\uc0c1 \ud604\uc2e4 \uc138\uacc4\ub97c \ub2e4\uac19\uc774 \ud0d0\ud5d8\ud574 \ubcf4\uc138\uc694.\n\n- VR \uc6d4\ub4dc\uc5d0\uc11c \uc790\uc2e0\uc744 \uafb8\uba70\ubcf4\uc790!\n\ud06c\ub808\uc774\uc9c0\uc6d4\ub4dc VR\uc758 \uc138\uc0c1\uc5d0\uc11c\ub294 \ub2e4\uc591\ud55c \uce90\ub9ad\ud130\uc640 \uce58\uc7a5\uc131 \uc544\uc774\ud15c\uc73c\ub85c \uc790\uc2e0\ub9cc\uc758 \uce90\ub9ad\ud130\ub97c \uafb8\ubc00 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ubfd0 \uc544\ub2c8\ub77c \uc790\uae30\uc758 \uc9d1\uc744 \uafb8\ubbf8\uace0 \ub2e4\ub978 \uce5c\uad6c\uc758 \uc9d1\uc5d0\ub3c4 \ubc29\ubb38\ud560 \uc218 \uc788\uc73c\uba70 \uc5f4\uc2ec\ud788 \uac8c\uc784\uc744 \ud558\uba74 \ub098\uc911\uc5d0\ub294 \uc9d1\uc744 \ud655\uc7a5\ud558\uace0 \uc810\uc810 \ub354 \uace0\uae09\uc2a4\ub7fd\uac8c \uafb8\ubc00 \uc218\ub3c4 \uc788\uc5b4\uc694!\n\n- \uc804\uc138\uacc4\uc758 \uce5c\uad6c\ub4e4\uacfc \ub2e4\uc591\ud55c \uac8c\uc784\uc744 \ud568\uaed8 \uc990\uae30\uc790!\n\ud06c\ub808\uc774\uc9c0\uc6d4\ub4dc VR\uc740 \ub300\ud55c\ubbfc\uad6d\uc744 \uc2dc\uc791\uc73c\ub85c \uc804\uc138\uacc4\uc758 \uc0ac\uc6a9\uc790\ub4e4\uc774 \ud568\uaed8 \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uac8c \ub9cc\ub4e4\uc5b4\uc84c\uc5b4\uc694. \uc591\uad81, \ubcfc\ub9c1, \uc288\ud305, \ud14c\ub2c8\uc2a4 \ub4f1\uc73c\ub85c \ub8e8\ucc0c\ub97c \ubaa8\uc73c\uace0 \uc2e0\uae30\ub85d\uc744 \uac31\uc2e0\ud574\ubcf4\uc138\uc694. \ubb3c\ub860 \uce5c\uad6c\uc640 \ud568\uaed8 \uc811\uc18d\ud574\uc11c \uac19\uc774 \ud50c\ub808\uc774\ub3c4 \ud560 \uc218 \uc788\uc9c0\uc694. \uc27d\uace0 \uac04\ud3b8\ud55c \uc870\uc791\uc73c\ub85c \ub0a8\ub140\ub178\uc18c \ub204\uad6c\ub098 \uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc73c\uba70 \ub192\uc740 \uae30\ub85d\uc740 \ub9c8\uc744\uc5d0 \uae30\ub85d\ub418\uc5b4 \uc804\uc138\uacc4 \uc0ac\ub78c\ub4e4\uc774 \ubcfc \uc218 \uc788\ub2f5\ub2c8\ub2e4.\n\n* \ubcf8 \uac8c\uc784\uc740 \uc628\ub77c\uc778 \uac8c\uc784\uc73c\ub85c \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud544\uc218\ub85c \uc694\uad6c\ud569\ub2c8\ub2e4.", "short_description": "\uc990\uac70\uc6b4 VR \uc6d4\ub4dc\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \ub2e4\uc624, \ubc30\ucc0c \ub4f1 \ub125\uc2a8\uc758 \uac8c\uc784 \uce90\ub9ad\ud130\ub4e4\uc774 \ub4f1\uc7a5\ud558\ub294 \uc2e4\uc2dc\uac04 \uc628\ub77c\uc778 \ub2e4\uc911\uc811\uc18d VR \uac8c\uc784\uc785\ub2c8\ub2e4. \uc775\uc219\ud55c \uce90\ub9ad\ud130\ub4e4\uacfc \ud568\uaed8 VR\uc5d0\uc11c \ub2e4\uc591\ud55c \ubbf8\ub2c8 \uac8c\uc784\ub4e4, \uce90\ub9ad\ud130 \uafb8\ubbf8\uae30, \uc18c\uc15c \uae30\ub2a5 \ub4f1\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. VR \uc6d4\ub4dc\uc5d0\uc11c \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 \uc990\uac70\uc6b4 \uacbd\ud5d8\uc744 \ud574\ubcf4\uc138\uc694!"}, {"images": {"nodes": [{"file_name": "2560x1440_03.png", "id": "4094666597218615", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035313_4094666600551948_227043978261132322_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYc54o46b4EQ7kNvwEBgEz_&_nc_oc=AdrnxE7l8VG2PEmEVeQT_YOhEvqhzKmnHfCfLz2tl-kwk4LUm1GSL-iZDfck9qNuRqQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-3Z5rZZcgwSXNGiS3WHL8e4SkD5bBQqs0DOuCGnFfyA&oe=6AFB3B69"}, {"file_name": "512x512_v2.png", "id": "3729118427178426"
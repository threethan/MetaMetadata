&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10T0aDgg5jsQ7kNvwEZ0Efe&_nc_oc=Ado51M7YIxLABEQ2ycFstU2rgjB713h5XuQIPmuc1wm5ECGdwo_MWuAnqyWGxtw8C2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwAMvhpWuIEmW_gGxY3tC3wYel2AsF2jq5-wOAzhpSlw&oe=6AFDBE0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Umvt9q", "id": "786762798399126", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572923_786762801732459_3092996182541074432_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElQH_Fp35pAQ7kNvwG8AVia&_nc_oc=AdrIXTbFCuh8C67rqMOCZCLABZ10MK9FXYvGizGGelPRpNT7fQYllLpswO3WeaLCutY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzckd9D_dAZNuN4yCYsdOHKC9Zq4NZYohHn2beVLV4Mw&oe=6AFDB950"}, "display_name": "Crazy World VR", "keywords": ["Casual", "Sports", "Arcade", "Social", "Multiplayer"], "long_description": "Come & wonder around this beautifully landscaped Nexon theme park, interact with total stranger, and make new friends online. Crazy arcade VR offers various mini games you can play with others online, together with social & customization features. \nDuring the early access; i)Tennis: An arcade style tennis you can go solo or play with others online. ii)Crossbow: A challenging crossbow game to compete with others. iii)Shooting: Unleash your shooting instinct and go crazy to set new record iV)Bowling: Let\u2019s see who\u2019s got the skill. We are looking for serial strikers. v)My room: For you to manage and customize your characters and inventory. \n**Please note that the game is an online game that requires internet connection. And only accessible from a few selected regions with limited amount of game contents for beta testing. We are going to gradually release new game and new contents over the time.**", "short_description": "**Now on Early Access**\nCrazy World VR is a multiplayer social VR game developed by PIXELITY Games(formerly known as PIXELPIMPS) in association with SKTelecom utilizing Nexon\u2019s casual IP. \nThe game offers various mini games you can play with others online, together with social features, and various customization features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelitygames.com/privacy-policy/", "developer_terms_of_service_url": "https://pixelitygames.com/terms-of-service", "publisher_name": "PIXELITY Games Inc.", "support_website_url": null, "website_url": "https://pixelitygames.com/?lang=en", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "785727332384385"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196228_791101448042740_3462893897242378240_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjfBJ8r9C9QQ7kNvwGrnxe5&_nc_oc=AdoKh9uH4bwSffQG5Eyn_tXpAKOGkCbi5Pru7TyYIrOl2PnLbmwWAr5u0qSqGKEjmUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHqGymIQilCal9qESi5Y_UAJ3OvA-APyMbPvOI85Al6w&oe=6AFDE119"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crazy World VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1581555636, "lastRevision": {"nodes": [{"id": "625633307845410", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2365251143563517", "is_first_party": f
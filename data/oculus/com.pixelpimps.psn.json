&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hm5VjiQlchQtg2-JyK3GQh_iYrlivsGoo5NWflcfvBw&oe=6A1065EA"}, {"file_name": "udVXCO.png", "id": "1323185951402800", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035425_1323185954736133_3256374788565762048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c55z2fha3DwQ7kNvwFRVxbr&_nc_oc=AdpyfK0AJrWjV4MC9CANDy4KQ_eFt4Bs1GYH3OKRseG2jLhg8M4HQeybyIgnPQP2dLk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HwtGCXkJWt0MH27Qq-unhGvhygH2kGFdf5Lj_VhTLzQ&oe=6A1079BB"}, {"file_name": "6cgtdj.png", "id": "282952762729358", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75371506_282952766062691_4335445219576119296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qw48umU4B1AQ7kNvwHoaZiT&_nc_oc=AdoasDfWBcDw8qLGS8x9q7gnhr0vwTeMe_mmi82MsOfyvo-1ji-fNmPDnIyQC4mT3DQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ir7Wz9hRuY7V_yZToYImg3z-cQrFhja2DSLQcUHR3HQ&oe=6A106114"}, {"file_name": "P3kIib.png", "id": "267732127961684", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974442_267732131295017_1741552321621393408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVmQHBGryQ0Q7kNvwE_BspF&_nc_oc=AdpvQ7vIHSmTxjo8NDYKvS5-re7Bwy-jca3n3IV5i7pQNx_F_iIga3wKwhGZWY-l-Dk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LuKXbKBbgF7bdymUKmNEEQHtPz4jVhXv5A2czcKFcXg&oe=6A105F7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/eMnkFK", "id": "786761185065954", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031393_786761188399287_2798424652249038848_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r37c85eDqyYQ7kNvwFnAYkr&_nc_oc=Adq27koKy5b7yCOsPL7HNP2lVEJEbEpmUIZvrXQCAIZFS2-0zqANZe9Hzhakuxaztkw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IZYuTFPfPlUnw3_FvsSNa727j6S3Q8Ncl95JuqhtFzQ&oe=6A104892"}, "display_name": "\ud06c\ub808\uc774\uc9c0 \uc6d4\ub4dc VR", "keywords": ["Casual", "Sports", "Arcade", "Social", "Multiplayer"], "long_description": "- NEXON \uce90\uc8fc\uc5bc \uac8c\uc784 IP\ub97c VR \uc138\uc0c1\uc5d0\uc11c \ub9cc\ub098\uc790!\n\ud06c\ub808\uc774\uc9c0 \uc6d4\ub4dc VR\uc740 NEXON\uc758 \uc720\uba85 \uce90\uc8fc\uc5bc \uac8c\uc784\uc778 \uce74\ud2b8\ub77c\uc774\ub354, \ud06c\ub808\uc774\uc9c0\uc544\ucf00\uc774\ub4dc, \ubc84\ube14\ud30c\uc774\ud130\uc758 IP\ub97c \ud65c\uc6a9\ud55c \ub2e4\uc911 \uc811\uc18d VR \uac8c\uc784\uc785\ub2c8\ub2e4. \uc775\uc219\ud55c \uce90\ub9ad\ud130\ub4e4\uacfc \ud568\uaed8 VR \uc138\uacc4\ub97c \ud0d0\ud5d8\ud574 \ubcf4\uc138\uc694.\n\n- \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 VR \uc6d4\ub4dc\ub97c \uc990\uae30\uc790!\n\ud06c\ub808\uc774\uc9c0 \uc6d4\ub4dc VR\uc740 \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 \uc990\uae38 \uc218 \uc788\ub294 \uba40\ud2f0\ud50c\ub808\uc774 \uac8c\uc784\uc785\ub2c8\ub2e4. \uc5ec\ub7ec \uc720\uc800\ub4e4\uc774 \ub3d9\uc2dc \uc811\uc18d \uac00\ub2a5\ud55c \ub9c8\uc744\uc5d0\uc11c \uc720\uc800 \uac04 \ub2e4\uc591\ud55c \uc0c1\ud638\uc791\uc6a9\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uce90\ub9ad\ud130 \ucee4\uc2a4\ud130\ub9c8\uc774\uc9d5, \ub9c8\uc774 \ub8f8 \uafb8\ubbf8\uae30 \ub4f1 \ub2e4\uc591\ud55c \uc990\uac70\uc6c0\ub3c4 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n- \ub2e4\uc591\ud55c \ubbf8\ub2c8 \uac8c\uc784\n\ud06c\ub808\uc774\uc9c0 \uc6d4\ub4dc VR\uc740 \uc27d\uace0 \uac04\ud3b8\ud55c \uc870\uc791\uc73c\ub85c \ub204\uad6c\ub098 \uc990\uae38 \uc218 \uc788\ub294 VR \uac8c\uc784\uc785\ub2c8\ub2e4. \ub9c8\uc744 \uacf3\uacf3\uc5d0\uc11c \uc0dd\uc131\ub418\ub294 \ub8e8\ucc0c\ub97c \ud68d\ub4dd\ud558\uc5ec \uac8c\uc784\uc744 \ub9c8\uc74c\uaecf \uc990\uaca8\ubcf4\uc138\uc694. \ud604 \ubca0\ud0c0 \uc11c\ube44\uc2a4 \uae30\uac04 \uc911\uc5d0\ub294 \ud14c\ub2c8\uc2a4, \uc591\uad81, \ubcfc\ub9c1, \uc0ac\uaca9 4\uc885\uc758 \ubbf8\ub2c8 \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \ubbf8\ub2c8 \uac8c\uc784\ub4e4\uc740 \uba40\ud2f0\ud50c\ub808\uc774 \uae30\ub2a5\uc744 \uc81c\uacf5\ud558\uba70, \ud604\uc7ac \uba40\ud2f0\ud50c\ub808\uc774\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\ub294 \uac8c\uc784\ub4e4\ub3c4 \ud5a5\ud6c4 \ucd94\uac00\ub420 \uc608\uc815\uc785\ub2c8\ub2e4. \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 \uae30\ub85d\uc744 \uacbd\uc7c1\ud574 \ubcf4\uc138\uc694!\n\n- \uc55e\uc11c \ud574\ubcf4\ub294 \uac8c\uc784\n\ud06c\ub808\uc774\uc9c0 \uc6d4\ub4dc VR\uc740 \uc544\uc9c1 \uc644\uc131\ub41c \uac8c\uc784\uc774 \uc544\ub2c8\uba70 \ub2e4\uc591\ud55c \ucd94\uac00 \uae30\ub2a5\ub4e4\uc744 \uac1c\ubc1c\ud558\uace0 \uc788\ub294 \uc5bc\ub9ac\uc5b5\uc138\uc2a4 \uac8c\uc784\uc785\ub2c8\ub2e4. \uac8c\uc784\uc744 \ub354 \uc88b\uac8c \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc720\uc800 \ubd84\ub4e4\uc758 \uc758\uacac\uc744 \uc5b8\uc81c\ub098 \ud658\uc601\ud569\ub2c8\ub2e4. \uc55e\uc73c\ub85c \ucd94\uac00\ub420 \ubbf8\ub2c8 \uac8c\uc784\ub4e4\uacfc \ubd80\uac00 \uae30\ub2a5\ub4e4\uc744 \uae30\ub300\ud574 \uc8fc\uc138\uc694!\n\n* \ubcf8 \uac8c\uc784\uc740 \uc628\ub77c\uc778 \uac8c\uc784\uc73c\ub85c \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud544\uc218\ub85c \uc694\uad6c\ud569\ub2c8\ub2e4.", "short_description": "\uc990\uac70\uc6b4 VR \uc6d4\ub4dc\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \ud06c\ub808\uc774\uc9c0 \uc6d4\ub4dc VR\uc740 NEXON\uc758 \uc720\uba85 \uce90\uc8fc\uc5bc \uac8c\uc784\uc778 \uce74\ud2b8\ub77c\uc774\ub354, \ud06c\ub808\uc774\uc9c0\uc544\ucf00\uc774\ub4dc, \ubc84\ube14\ud30c\uc774\ud130\uc758 IP\ub97c \ud65c\uc6a9\ud55c \uba40\ud2f0\ud50c\ub808\uc774 VR \uac8c\uc784\uc785\ub2c8\ub2e4. \uc775\uc219\ud55c \uce90\ub9ad\ud130\ub4e4\uacfc \ud568\uaed8 VR\uc5d0\uc11c \ub2e4\uc591\ud55c \ubbf8\ub2c8 \uac8c\uc784\ub4e4, \uce90\ub9ad\ud130 \uafb8\ubbf8\uae30, \uc18c\uc15c \uae30\ub2a5 \ub4f1\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. VR \uc6d4\ub4dc\uc5d0\uc11c \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 \uc990\uac70\uc6b4 \uacbd\ud5d8\uc744 \ud574\ubcf4\uc138\uc694!"}, {"images": {"nodes": [{"file_name": "mi
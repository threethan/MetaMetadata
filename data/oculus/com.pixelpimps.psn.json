138531_8566456234880794624_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbeODgxQp8kQ7kNvwHC07DS&_nc_oc=AdrXZ0oPDWIGgIM1gUuwVYHKEWVEkLXCW21qs_SmDMmmS2GGu83qYaHmRf2NODHO59Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d1vEMqqm_5pcR84x7uCX8C1Jry7DQByzxQoi5GiJvIQ&oe=6A36BADD"}, {"file_name": "migrated_image.png", "id": "762200544304229", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974491_1041754996187366_4398665123833577472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HeMqw_IBJoQ7kNvwHnw12d&_nc_oc=AdodzzJARWdrn5_C_EU07NfjgvTghiBIEkzd06wywcZbbjJkQhvGXXnkM6rItwlfvYc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wODdEUtQtWvh2aVKQfux7MP1DZM1Ihev5j-ZHVYswEQ&oe=6A36B0CD"}, {"file_name": "migrated_image.png", "id": "642817906294017", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974591_507078186513992_6929025263523069952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9RbPHyz3OoQ7kNvwFItnGK&_nc_oc=Ado5vEhzUJ6Wy4ZL6_OgdfSij6Eu4lLrDt-V2EiOi0dpjBfCwyHO57DPOMkIUHHjqWE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_r44SdeC9JSA34UoNF1pYOzPlz7BaItVcDTmZMuenYA&oe=6A36B26D"}, {"file_name": "migrated_image.png", "id": "3089594414384514", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982502_869110003543323_3406698867264061440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7ZFFRb94bwQ7kNvwEJTXDQ&_nc_oc=AdqMugrmYlWkZC2vchAbW8shTkSc7LKv3w0m2uCNl4Q4YR9K54t5zf12_INXzxm8TCc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N6NhmDUOzXyQoEboCSTIiRQEoBRHA7p7wA-4kaLzPMQ&oe=6A36AB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Umvt9q", "id": "786762798399126", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57572923_786762801732459_3092996182541074432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPf-RbR7e4AQ7kNvwEfcQLX&_nc_oc=Adr8Fgrh9yCofICAeUAout6C5Q553SSseQUafbdmMUzfwyNFu46DcE1RlG9quOQ7mP0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WiJFR0YdHk7Km52iAJTwrIP4bAInPj1bBW4MLxFMuIw&oe=6A36A6D0"}, "display_name": "Crazy World VR", "keywords": ["Casual", "Sports", "Arcade", "Social", "Multiplayer"], "long_description": "Come & wonder around this beautifully landscaped Nexon theme park, interact with total stranger, and make new friends online. Crazy arcade VR offers various mini games you can play with others online, together with social & customization features. \nDuring the early access; i)Tennis: An arcade style tennis you can go solo or play with others online. ii)Crossbow: A challenging crossbow game to compete with others. iii)Shooting: Unleash your shooting instinct and go crazy to set new record iV)Bowling: Let\u2019s see who\u2019s got the skill. We are looking for serial strikers. v)My room: For you to manage and customize your characters and inventory. \n**Please note that the game is an online game that requires internet connection. And only accessible from a few selected regions with limited amount of game contents for beta testing. We are going to gradually release new game and new contents over the time.**", "short_description": "**Now on Early Access**\nCrazy World VR is a multiplayer social VR game developed by PIXELITY Games(formerly known as PIXELPIMPS) in association with SKTelecom utilizing Nexon\u2019s casual IP. \nThe game offers various mini games you can play with others online, together with social features, and various customization features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelitygames.com/privacy-policy/", "developer_terms_of_service_url": "https://pixelitygames.com/terms-of-service", "publisher_name": "PIXELITY Games Inc.", "support_website_url": null, "website_url": "https://pixelitygames.com/?lang=en", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQ
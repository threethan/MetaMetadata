138531_8566456234880794624_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fP2A06TghAQ7kNvwFqEDfA&_nc_oc=AdpY0NM8NMnN8pGdppuym8YaUXCWtc1fisU0WOQ8Ymz2CxHUwspxgr1esijWFTBqvjo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAsYLrpWmMid_1UHQKQ2vFZbHr98ifRA_Oi8F3ZhS4zw&oe=6AAEB35D"}, {"file_name": "migrated_image.png", "id": "762200544304229", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974491_1041754996187366_4398665123833577472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaxDWzmD3ogQ7kNvwGFnjJs&_nc_oc=AdqVdz_NNCUBSOcpMJnZVWTypEK7eOfv-zM7ioGeOMkes-4ijBvy_N-YGNhxF1qHtpA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLanqBx0gJsEIByfptfCv7mnjsT1X_M_PuQOgCY3WzNcw&oe=6AAEA94D"}, {"file_name": "migrated_image.png", "id": "642817906294017", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974591_507078186513992_6929025263523069952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6r0hS0TDfQAQ7kNvwE2wE6k&_nc_oc=Adp8Oar4f-0mj9RyPoVLCofHyHIXHx3eblySDaDjFalFayPfj3E_ehm_Fd5BFKNqmM8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaFiSigMmtJLeHavbIJOvGVI1qZP7FwxNoMRyZyv2mTA&oe=6AAEAAED"}, {"file_name": "migrated_image.png", "id": "3089594414384514", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982502_869110003543323_3406698867264061440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RARsoRcOhOsQ7kNvwF40g1N&_nc_oc=AdrIDUQBfhItbuvYrqvfZUY42puzjV7W3ZiIbUM72PHhz_HGZrFIizHF2kUh7TzeTzA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH4tJVxphx28eWG5QjfztuvhClSD_LJkMlQd78rC5g8w&oe=6AAEA40C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Umvt9q", "id": "786762798399126", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57572923_786762801732459_3092996182541074432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBtIrxj0-wkQ7kNvwFZOIwv&_nc_oc=AdpsiPdjrepCIuxdOi8GWKbBfRtN1qJXW9u2MrJ9xI9EEn64iI0oe077Et0V1_MEg78&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpdK5xW4krV5PBrYlNJ-ox3ZXfdqX4r4_qZ0EXPRk9PQ&oe=6AAE9F50"}, "display_name": "Crazy World VR", "keywords": ["Casual", "Sports", "Arcade", "Social", "Multiplayer"], "long_description": "Come & wonder around this beautifully landscaped Nexon theme park, interact with total stranger, and make new friends online. Crazy arcade VR offers various mini games you can play with others online, together with social & customization features. \nDuring the early access; i)Tennis: An arcade style tennis you can go solo or play with others online. ii)Crossbow: A challenging crossbow game to compete with others. iii)Shooting: Unleash your shooting instinct and go crazy to set new record iV)Bowling: Let\u2019s see who\u2019s got the skill. We are looking for serial strikers. v)My room: For you to manage and customize your characters and inventory. \n**Please note that the game is an online game that requires internet connection. And only accessible from a few selected regions with limited amount of game contents for beta testing. We are going to gradually release new game and new contents over the time.**", "short_description": "**Now on Early Access**\nCrazy World VR is a multiplayer social VR game developed by PIXELITY Games(formerly known as PIXELPIMPS) in association with SKTelecom utilizing Nexon\u2019s casual IP. \nThe game offers various mini games you can play with others online, together with social features, and various customization features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelitygames.com/privacy-policy/", "developer_terms_of_service_url": "https://pixelitygames.com/terms-of-service", "publisher_name": "PIXELITY Games Inc.", "support_website_url": null, "website_url": "https://pixelitygames.com/?lang=en", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQ
8072_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XoRfHxDhTcQ7kNvwFefiRr&_nc_oc=AdqsTHwcmEAElDTo6Pd-ECEA6Cq3r2wbSiOt43ggnFS-lPS_IShKDCbUxQttgrKxO0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe9JgebfSuhZjQRniQHauJdeMxT8Szse9rdgqDwrBcAw&oe=6B01E366"}, "display_name": "Catapult", "keywords": ["Collaboration", "NoCode", "Sharing", "Publishing", "Spatial"], "long_description": "Catapult and makeSEA.com let you share and collaborate live using your own content. Mix 3D content and traditional media from multiple sources at any scale, and save every collaboration layout for instant recall whenever you need it. makeSEA+Catapult are ideal for rapid creation of exhibits, product demos, training experiences, location tours and much more!\n\nCheck out the inline Demo experience and guided instructions available from the main menu of this application to learn more.\n\nSharing and collaborating is as easy as:\n1.  Self-register and create a Project at makeSEA.com\n2.  Save or export any 3D content from your favorite 3D creative tool in GLB format to your Project's Assets collection.  You can also use MP4 (video) in standard and 360-surround format, PDFs, JPGs, and GIFs.\n3.  Add Team Members if you like,  and set your preferred sharing mode: Private, Public, etc. (!IMPORTANT Team members cannot see assets in Draft mode; Guests can only join Example and Public Projects).\n4.  Launch Catapult (this application), login with your makeSEA credentials, and choose a Project to join the Project\u2019s collaboration space. Note that only Team Members can join Projects marked as Private.\n\n{1071565551477159}\n{2110055846128642}\n{4014189068860024}\n{1725029698103645}\n{662615679809329}\n{2762780703894348}\n{682458014256361}\n{1367706707903889}\n{649363001222625}\n{677271125257883}", "short_description": "Catapult for makeSEA is the fastest and easiest way to publish your content to Quest for collaboration and sharing using both mixed reality and fully immersive experiences. Use your own content to create powerful AR/VR applications tailored to your audience\u2014no coding required. Join our Community today and use Catapult+makeSEA for FREE!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://community.makesea.com/privacy-policy", "developer_terms_of_service_url": "https://community.makesea.com/terms-of-service", "publisher_name": "makeSEA", "support_website_url": "https://www.makesea.com/contact", "website_url": "https://www.makeSEA.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "PRODUCTIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "9674509435968979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974809_1361066044268248_1219416147832049158_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i4VCs9Cj5wQ7kNvwEn_hb9&_nc_oc=AdqGQQvtwD6UkZbxKbTqXyHaMgjqlD9uCWSpugTLtQc0aXcTCVArkbpiA9a7H-9WFx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqZqmrkaVYeJTfVg2CRH652La4q5q2bau3Na7o-pdNAw&oe=6B01D984"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Catapult", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": 
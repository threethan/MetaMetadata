luscdn.com&_nc_ss=7f20f&oh=00_AQQlc4p8IM7GTxbmowzRq7RDYwtBTSQKt1CnGIw_dJ15eA&oe=6AFDE0D8"}, {"file_name": "tradeshow booth.png", "id": "137217785112882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_137217788446215_6671207251560931562_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9YHh80T2xQQ7kNvwHfscEx&_nc_oc=AdpyxOEOagyLTmDLwdpSLSC0gfzQBYAtlJi8O5IjVXY3rsi4-RBaQ5wXF4WLR27s7eM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX0ycwhig6AiiHPgPGcn5taqBM-vFNoNXbfIY_v3mUmw&oe=6AFDC19A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_20191125_15.33.08 copy.png", "id": "286585226479712", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245822_286585229813045_1229947654193876712_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcjJ8TpUqE0Q7kNvwGH6EYn&_nc_oc=AdoNMN7M9zD9kgkze8bDn_x7RrFphLRwN8HGvrc44qlB4xc08EVtl4YMaZZKcseLbNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi7EfYw-o4YABFwj4du94UujiiFKIlVMgkMCJrVibYcw&oe=6AFDC126"}, "display_name": "Catapult", "keywords": [], "long_description": "Catapult and makeSEA.com allow you to share and collaborate live using content you produce. You can mix many sources, at any scale, and save every collaboration space layout for future recall. \n\nSharing and collaborating is as easy as:\n1.  Create a Project at makeSEA.com\n2.  Save any 3D content from your favorite 3D creative tool in GLB, STL, OBJ, or FBX or MP4 (video), or other compatible format to your Project's Assets collection\n3.  Add Team Members if you like,  and set your preferred sharing mode: Private, Public, etc. (!IMPORTANT Team members cannot see assets in Draft mode).\n4.  Launch Catapult (this application), login with your makeSEA credentials, and choose a Project to join the Project\u2019s collaboration space. Note that only Team Members can join Projects marked Private.\n\nFor detailed instructions and release notes please see http://www.makesea.com/how-to", "short_description": "makeSEA + Catapult is the easiest way to get your content on to Oculus for cross-device collaboration and sharing using your own content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.makesea.com/privacy-policy", "developer_terms_of_service_url": "https://community.makesea.com/terms-of-service", "publisher_name": "makeSEA", "support_website_url": "https://www.makesea.com/contact-us", "website_url": "https://www.makeSEA.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SOCIAL", "PRODUCTIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "684871539349370"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3966533663454306"}]}, "baseline_offer": {"id": "3966533663454306"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1621878180, "status": "PUBLISHED", "id": "3966533663454306"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9649610785125511", "version": "6.1a-catapult-publicdist-clownfish"}, "id": "4020119558007422", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_ap
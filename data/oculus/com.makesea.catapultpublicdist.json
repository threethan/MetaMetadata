0-12-09 at 2.32.49 PM copy.png", "id": "203576824518838", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974879_203576827852171_715720443479762446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boxVzG4jgqQQ7kNvwE2MJW7&_nc_oc=AdmS0UsY4besYdq50oyGiaNA1-UqkHSgo9UyHGmTTtYFbmfLVKZCxHwepHLsvAuf5kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs625CNr57U-tj4YYjA9v0hVNuT2YiTxYyDdW7IvSuenQ&oe=699998E7"}, {"file_name": "ML_20191125_15.25.00 copy.png", "id": "284483446609333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982635_284483449942666_7323885278695279044_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfjSSXZQ90IQ7kNvwEBO6Ku&_nc_oc=Adnk_R-g2DuFQKWnBY7bpfJwY0uzKSHwz8Qd4rqclA7502mxCjpe0kuq56d52xRC4LU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afskeao7iXJ_YevNftC72_1JWVIu3p6lNIMXSlHpXeNcOg&oe=6999B782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-02-04 at 12.21.19 AM -2.png", "id": "8245078282283766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818927_8245078285617099_7177040411538158072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylLKvJ6PUSIQ7kNvwEJ_mOW&_nc_oc=AdnxBbdtlhvxDF2RgOXzPidL7PhWINynOkfJYg5iDZ5ixovew-wo-cAX4K2TR-MHpmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvv8X8T1nXCRJ0bMhUF4H6WMeq8r6c1YabpuJHFzssaZQ&oe=6999C1A6"}, "display_name": "Catapult", "keywords": ["Collaboration", "NoCode", "Sharing", "Publishing", "Spatial"], "long_description": "Catapult and makeSEA.com let you share and collaborate live using your own content. Mix 3D content and traditional media from multiple sources at any scale, and save every collaboration layout for instant recall whenever you need it. makeSEA+Catapult are ideal for rapid creation of exhibits, product demos, training experiences, location tours and much more!\n\nCheck out the inline Demo experience and guided instructions available from the main menu of this application to learn more.\n\nSharing and collaborating is as easy as:\n1.  Self-register and create a Project at makeSEA.com\n2.  Save or export any 3D content from your favorite 3D creative tool in GLB format to your Project's Assets collection.  You can also use MP4 (video) in standard and 360-surround format, PDFs, JPGs, and GIFs.\n3.  Add Team Members if you like,  and set your preferred sharing mode: Private, Public, etc. (!IMPORTANT Team members cannot see assets in Draft mode; Guests can only join Example and Public Projects).\n4.  Launch Catapult (this application), login with your makeSEA credentials, and choose a Project to join the Project\u2019s collaboration space. Note that only Team Members can join Projects marked as Private.\n\n{1071565551477159}\n{2110055846128642}\n{4014189068860024}\n{1725029698103645}\n{662615679809329}\n{2762780703894348}\n{682458014256361}\n{1367706707903889}\n{649363001222625}\n{677271125257883}", "short_description": "Catapult for makeSEA is the fastest and easiest way to publish your content to Quest for collaboration and sharing using both mixed reality and fully immersive experiences. Use your own content to create powerful AR/VR applications tailored to your audience\u2014no coding required. Join our Community today and use Catapult+makeSEA for FREE!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://community.makesea.com/privacy-policy", "developer_terms_of_service_url": "https://community.makesea.com/terms-of-service", "publisher_name": "makeSEA", "support_website_url": "https://www.makesea.com/contact", "website_url": "https://www.makeSEA.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "PRODUCTIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_F
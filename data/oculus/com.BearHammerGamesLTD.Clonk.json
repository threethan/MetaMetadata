AZQJDafrMpAQCDc6_7vHcL1z6Wz1b6RP2B9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LHCPFRHTyODRKZtNo4dlex2yNNRzOPezNAimGilesFg&oe=69FC8F97"}, {"file_name": "SC_3.png", "id": "1711533440150359", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828104_1711533443483692_8656372464886454449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC-Uk5UjIEUQ7kNvwFXm3FY&_nc_oc=AdoutvlOb8b_ejwNjEp_GppiviTH1uGiOTqEtYA6cJqxM58IbuMkKURhB6QLNTDemgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IbEkrP6tusEEaD3kUbivrXgBtyT4wSASeY9ogx0-WZA&oe=69FC8034"}, {"file_name": "SC_5.png", "id": "942732514836741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_942732518170074_7923319707246778547_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1czTlq_fiwQ7kNvwE9qW9u&_nc_oc=AdoyAjwl_9W4znta4Sp-Z9AnLcX2qMwdPfX6qwgMQmDDB4fTJL9-_Jz9lw_AvVO18NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ag_dS2HQglvZU6s5JHf5ge_RiCtYSrWDkSb_Havf3_g&oe=69FC7F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clonk Key Art.png", "id": "2072590033165395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825034_2072590039832061_2045682752211280299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtI4gB7MPj4Q7kNvwH9mGO_&_nc_oc=Adp0JBIvGijfcZpTbRyKOGU1RvThAymqET7J1aP1h_PnGRlExlgFmxN8YAkns1vFyEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HjTOgAFdokVLkQnpzPrycNzFdQUGr0-x0t9Pi9mLCFw&oe=69FC91C0"}, "display_name": "Clonk", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "                                                                                                                                                                                                      \n\n# NEW UPDATE: Trouble in Clonksville!\n\nThe mayor has been Clonked! Track down the Evil Clonks before they strike again in our new social deduction murder mystery game mode! Explore a giant new map, full of traps and secret passageways! And remember - Trust no one!\n\n{1627716721472570}\n\n\n# Move Different. Play Different.\n\nSwing your arms to run. Triple jump in mid air. Climb any yellow clay. Fire oversized projectiles from your hand cannon and cause pure chaos in races, arenas, and social modes. Earn Clay to unlock new gadgets and cosmetics.\n\n{1638761550598742}\n\n\n# Early Access Rewards + Clonk OG Hoodie\n\nPlay during Early Access and unlock the exclusive Clonk OG Hoodie before it\u2019s gone forever. Join now, shape the game, and jump into the Discord for events, secrets, and rewards! (https://discord.gg/7PWqcxdZ9Q)\n\n{1456752379526779}\n\n# Prepare to get Clonked!\n\n\n{824791767332742}\n", "short_description": "A chaotic free to play VR party game with wild movement, gadgets, and social game modes.\nJump into Early Access, help us test new updates, and earn exclusive rewards!"}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "3
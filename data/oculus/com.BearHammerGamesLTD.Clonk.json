e0uyYx1N5AUMnfImXL-FPMmNOO5sSKLSZuss&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wRfQ_jgsGnB2kcxvF2ZriHQzMGzNp5ShzJYtzGyko0A&oe=69F5F817"}, {"file_name": "SC_3.png", "id": "1711533440150359", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491828104_1711533443483692_8656372464886454449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qHc4hTws-QQ7kNvwF2Z_ia&_nc_oc=AdoNlG55BkENW4MbzBHlPNSL2nNbBqTcOPljIaSAPM1_Ex-81qygydW9xp4bLBspgmk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LyqJbAAhU0h1UnMcev5y3ilVAa7p8rOXR7Vi038slcw&oe=69F5E8B4"}, {"file_name": "SC_5.png", "id": "942732514836741", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823812_942732518170074_7923319707246778547_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRck823DMFYQ7kNvwEWQqkm&_nc_oc=AdqBZJDtPnQpAJucoHn-_ldWDudiWmRcCY-6CMQx7KlWxjxIUBLdQ0sNKZfRQr_WYA0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Fzmmbx9ChgLokDlm8UOgx099OJ13gSvTSDIl-VZGc2g&oe=69F5E7D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clonk Key Art.png", "id": "2072590033165395", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825034_2072590039832061_2045682752211280299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6CpHPMEnH8Q7kNvwH1i3QZ&_nc_oc=AdoAdzvHGUn8drj_Sp20TnMfm3aXma-wceLpzHpbu--LXaCuGVOi0lbNBGnv1xx3aro&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30YpzPGgEx_QEq4_-mOKAQpN9NH0MBvqaAgVrmHtvYTQ&oe=69F5FA40"}, "display_name": "Clonk", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "                                                                                                                                                                                                      \n\n# NEW UPDATE: Trouble in Clonksville!\n\nThe mayor has been Clonked! Track down the Evil Clonks before they strike again in our new social deduction murder mystery game mode! Explore a giant new map, full of traps and secret passageways! And remember - Trust no one!\n\n{1627716721472570}\n\n\n# Move Different. Play Different.\n\nSwing your arms to run. Triple jump in mid air. Climb any yellow clay. Fire oversized projectiles from your hand cannon and cause pure chaos in races, arenas, and social modes. Earn Clay to unlock new gadgets and cosmetics.\n\n{1638761550598742}\n\n\n# Early Access Rewards + Clonk OG Hoodie\n\nPlay during Early Access and unlock the exclusive Clonk OG Hoodie before it\u2019s gone forever. Join now, shape the game, and jump into the Discord for events, secrets, and rewards! (https://discord.gg/7PWqcxdZ9Q)\n\n{1456752379526779}\n\n# Prepare to get Clonked!\n\n\n{824791767332742}\n", "short_description": "A chaotic free to play VR party game with wild movement, gadgets, and social game modes.\nJump into Early Access, help us test new updates, and earn exclusive rewards!"}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "3
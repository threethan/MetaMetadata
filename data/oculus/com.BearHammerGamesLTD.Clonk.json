_oc=AdrmpIaD8UxEcWZHazdFKZAfEYjCVsTXSvKcqVxXEqqGkIVTlhy0QbAYxiLYa4jFdUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREE3xfl0OZ76lBvEmmdcCEzV7YBmpSI73ZQMF3wlkPPQ&oe=6B01C174"}, {"file_name": "SC_5.png", "id": "942732514836741", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_942732518170074_7923319707246778547_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkwpsXzVlXoQ7kNvwHrTxwK&_nc_oc=AdoNynTh0nJRTwkpyP_CQ1C-NVX5Aw1eYSMTKq9JhbtCwhW0D2FEHFcs8Nx-txhRMqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKWiFs5UqJQnco0fTWMTo8bysKWH4JhXFNeowpQ1--0Q&oe=6B01C090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clonk Key Art.png", "id": "2072590033165395", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825034_2072590039832061_2045682752211280299_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rtK3avduxIQ7kNvwGM1PKS&_nc_oc=Adp960WAcKqB-9U4gIlnGjsnUc4xhY8yhEXqPAaK0HdxqwcyCf3nlKQgMggVMcKsdVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsdKN-qQxMq4DkpTS3cFtmRXJoVDn7-W900ABfqJOJVw&oe=6B01D300"}, "display_name": "Clonk", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "# NEW UPDATE: CLONKBALL \u26bd\ud83d\udd2b\n**Shoot the ball. Bend the shot. Score the goal.**\n\nClonkBall is chaotic team gameplay where your weapons control the ball\u2014angle your shots, add spin, and pull off ridiculous plays. Earn currency each round and grab new weapons mid-match to turn things in your favor. Fast, competitive, and a little bit unhinged.\n\n{1936839123641608}\n\n**Move Different. Play Different.**\nSwing your arms to run. Triple jump through the air. Climb anything made of yellow clay. Fire oversized weapons and cause absolute chaos.\n\n{1638761550598742}\n\n**More Ways to Clonk**\n\ud83c\udfc1 Race modes with high-speed parkour\n\ud83d\udca5 Arena fights where anything goes\n\ud83c\udf00 Social hubs to hang out, explore, and mess around with friends\n\nJoin the Community\nJump into the Discord for events, updates, and everything else.\n\n**Prepare to get Clonked.**\n\n{824791767332742}\n\n", "short_description": "A chaotic free to play VR party game with wild movement, gadgets, and social game modes.\nPlay with friends and explore a crazy clay world with many different maps and modes to try.  "}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "39609966658594198"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820550_4482700541956828_4324503470924994193_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlMMJd0zG-sQ7kNvwG8EuuQ&_nc_oc=AdqQdPbXFEPTdwOKy1xDXU1bbUKw2rt21s0YVvtB4EnxJNTYYRyj26IqwO5xsV9nTZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlqkud7ZRX8gwFj1CxMd6D6viz3kjA4SU9kOQAzXK4mQ&oe=6B01C52E"}, "is_concept": false, "i
_oc=AdrgAeAJN8Imrng4cMbCon5VxwYO-AlKvhZsjBD3FI-DacRkWgCU7yZgdTJziSJjk98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNpDrNxOp7scN9rBqmAF-U0n6lwszKxj4QJkPzI793QQ&oe=6B0312F4"}, {"file_name": "SC_5.png", "id": "942732514836741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_942732518170074_7923319707246778547_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aXE9Jg2OjMQ7kNvwFk-M-l&_nc_oc=AdqkYTZnmjDZL2zy0wIv8neQJqmORO2bynWM8wE6oqscoO7srkBRAdddThaEz8iBKJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG-dGSLSPkkRmK2-ksQu9DgiwgOS_70hgOjk10XxPZVg&oe=6B031210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clonk Key Art.png", "id": "2072590033165395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825034_2072590039832061_2045682752211280299_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rtK3avduxIQ7kNvwGlmA0S&_nc_oc=AdoB3fuSoej4UzVH0PnL4992CM4Wd6IT4mlC6aM7nZe-Eo6BLcR6EnhlgR30GkLyw6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPW0VQGkmx6W57n0fVJr1CkEMPNzsWfZcLl5aXu4_ILQ&oe=6B032480"}, "display_name": "Clonk", "keywords": ["Racing", "Hangout", "Platformer", "Shooter", "Action"], "long_description": "# NEW UPDATE: CLONKBALL \u26bd\ud83d\udd2b\n**Shoot the ball. Bend the shot. Score the goal.**\n\nClonkBall is chaotic team gameplay where your weapons control the ball\u2014angle your shots, add spin, and pull off ridiculous plays. Earn currency each round and grab new weapons mid-match to turn things in your favor. Fast, competitive, and a little bit unhinged.\n\n{1936839123641608}\n\n**Move Different. Play Different.**\nSwing your arms to run. Triple jump through the air. Climb anything made of yellow clay. Fire oversized weapons and cause absolute chaos.\n\n{1638761550598742}\n\n**More Ways to Clonk**\n\ud83c\udfc1 Race modes with high-speed parkour\n\ud83d\udca5 Arena fights where anything goes\n\ud83c\udf00 Social hubs to hang out, explore, and mess around with friends\n\nJoin the Community\nJump into the Discord for events, updates, and everything else.\n\n**Prepare to get Clonked.**\n\n{824791767332742}\n\n", "short_description": "A chaotic free to play VR party game with wild movement, gadgets, and social game modes.\nPlay with friends and explore a crazy clay world with many different maps and modes to try.  "}]}, "developer_name": " Bearhammer Games LTD", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.playclonk.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "39609966658594198"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820550_4482700541956828_4324503470924994193_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlMMJd0zG-sQ7kNvwEmeaMC&_nc_oc=Adq29QdnBobxuLBJoXVR6EjAGZrWYjinivK9oigqwG_QoA5QPls-mzf8RA2sz9RIdR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIhzS8kICpfcWt1dgl9bAwwqu1Rc-XaioYWfQakQuLIQ&oe=6B0316AE"}, "is_concept": false, "i
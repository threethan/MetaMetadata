05993022046208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxQjG29Z5-gQ7kNvwHzdsoJ&_nc_oc=Adqo8nQkgNEqSSMgw-Kh0snvMbHwZn25tVirRbvE5X69VGY3qSFRGm8qK4dbEiy2_Do&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErOEdP2jwbh8EPm9v-X77Kff1E6N2FlPsK5R_YMES3Uw&oe=6A8EF091"}, "display_name": "Water Ride Extreme", "keywords": ["roller", "water", "theme", "park", "rollercoaster"], "long_description": "Welcome to the exteme edition of the the most incredibly realistic Water Rollecoaster of the world, that will brind you to the next level of andrenaline into virtual reality. Strong emotions and immersive feelings, just find yourself into a turbo speed boat riding incredible water waves around mountains and wonderful landscapes, feeling the thrill of the acceleration into a free fall cascade.\n\nExtreme edition features three different water coasters in a totally different environment and landscapes, featuring high speed mountain ride and motor ride into an ancient city submerged into water.\n\nNOTE: This app is rated HIGH MOTION, so it is not recommended to people suffering motion sickness.", "short_description": "Welcome to the to the exteme edition of the most incredibly realistic Water Rollercoaster of the world, that will brind you to the next level of andrenaline into virtual reality.\n\n\nWelcome to the exteme edition of the world most amazing Water Roller Coaster reproduction of the main water ride of theme parks"}]}, "developer_name": "Tecworks", "developer_privacy_policy_url": "http://jined.great-site.net/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tecworks/Polyraw", "support_website_url": null, "website_url": "http://jined.great-site.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "RACING", "ROLLER_COASTER"], "has_in_app_ads": null, "
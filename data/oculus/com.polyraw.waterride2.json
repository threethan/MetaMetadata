.5771-25/38974557_597186437397362_6436835935685443584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU5WW5tdh4YQ7kNvwHz-f88&_nc_oc=AdmHo-n1Ccx-RYFsj8I2tOjAz6sN9gQG7RlMv3PjnEzG6u4bfBGEFum_dm6HOk46y_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvF-9HqHZzsOymJ1FwPCubEZNT3PJAky9ZjlGrQiIoHXg&oe=69A04961"}, {"file_name": "migrated_image.png", "id": "2539988156316027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974527_369746486915834_5667817669059936256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJzlXXzDnscQ7kNvwFORIEu&_nc_oc=Adk31TNEOLmQudqvkOKf30tEVjkSMaSSs9d5iqp76O9_3WMXYE5fhHmm2yO3YJr2EhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfveLJrjhIlAUeQT7RfgA08N7OX9a-02v918jZcVLhNSAg&oe=69A03FF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ohUCVk", "id": "207666713404636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974537_207666716737969_7877905993022046208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVO8nFm1X3UQ7kNvwGd8j5l&_nc_oc=AdmrQpWAn-q9YVkxXsH03A0hJ5oZu3PJNZJtEXbrUHa7aHNF9oZvV5WltcBRe7rMwO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8qrDXBkuj8F01gENkadJ6CJTDgwp4IKqDEdRRJlCwqg&oe=69A05111"}, "display_name": "Water Ride Extreme", "keywords": ["roller", "water", "theme", "park", "rollercoaster"], "long_description": "Welcome to the exteme edition of the the most incredibly realistic Water Rollecoaster of the world, that will brind you to the next level of andrenaline into virtual reality. Strong emotions and immersive feelings, just find yourself into a turbo speed boat riding incredible water waves around mountains and wonderful landscapes, feeling the thrill of the acceleration into a free fall cascade.\n\nExtreme edition features three different water coasters in a totally different environment and landscapes, featuring high speed mountain ride and motor ride into an ancient city submerged into water.\n\nNOTE: This app is rated HIGH MOTION, so it is not recommended to people suffering motion sickness.", "short_description": "Welcome to the to the exteme edition of the most incredibly realistic Water Rollercoaster of the world, that will brind you to the next level of andrenaline into virtual reality.\n\n\nWelcome to the exteme edition of the world most amazing Water Roller Coaster reproduction of the main water ride of theme parks"}]}, "developer_name": "Tecworks", "developer_privacy_policy_url": "https://jined.great-site.net/privacypolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "Tecworks/Polyraw", "support_website_url": null, "website_url": "http://www.jined.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "RACING", "ROLLER_COASTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1525311401187779"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "549286172236277"}, {"status": "PUBLISHED", "id": "612277607622196"}]}, "baseline_offer": {"id": "612277607622196"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1548180000, "status": "PUBLISHED", "id": "549286172236277"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2807755129270085", "version": "4.5"}, "id": "2183847101636442", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
 thrill of realistic two-hand wheel control. Suggest new features and be part of the ride. Early Access now on Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddytroupe.github.io/games-github.io/tspp4", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9873566675996654"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2082185499031426"}, {"status": "PUBLISHED", "id": "1546162626660986"}, {"status": "PUBLISHED", "id": "1474292600457228"}, {"status": "PUBLISHED", "id": "1533803347788287"}, {"status": "PUBLISHED", "id": "1468360207512943"}, {"status": "PUBLISHED", "id": "1234249725024265"}, {"status": "PUBLISHED", "id": "3038214846334565"}, {"status": "PUBLISHED", "id": "1949638005847051"}]}, "baseline_offer": {"id": "3038214846334565"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "2082185499031426"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25914778208115578", "version": "25"}, "id": "978043211059200", "channel_name": "LIVE"}]}, "is_for_
ng and drifting thrill with blazing-fast cars and razor-sharp control. Feel every drift with precision two-hand steering that gives you absolute command over your vehicle. Every turn, slide, and burnout responds to your movement \u2014 no assists, just pure skill. Choose from multiple cars, each tuned for unique handling and drift potential. Your feedback matters \u2014 suggest features, modes, and car models to shape the future. Early Access now on Meta Quest", "short_description": "Drive, drift, and race your dream cars in Drift Day \u2014 the ultimate VR drifting experience! Master precision steering, burn rubber on intense tracks, and feel the thrill of realistic two-hand wheel control. Suggest new features and be part of the ride. Early Access now on Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddytroupe.github.io/games-github.io/tspp4", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9873566675996654"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2591489084660009"}, {"status": "PUBLISHED", "id": "2627572404367817"}, {"status": "PUBLISHED", "id": "2082185499031426"}, {
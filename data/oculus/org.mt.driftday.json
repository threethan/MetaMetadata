JiV-c0jAvnm_LUwLyejM0PP7PXKbonte00PscIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiHgV3JAZPMahzYHrCD6ZYF4UHROkch7vH0nd3ZoBYKA&oe=6AFDB640"}, "display_name": "Drift Day", "keywords": ["racing", "drifting", "rally", "driving", "realistic"], "long_description": "Drift Day delivers the ultimate VR racing and drifting thrill with blazing-fast cars and razor-sharp control. Feel every drift with precision two-hand steering that gives you absolute command over your vehicle. Every turn, slide, and burnout responds to your movement \u2014 no assists, just pure skill. Choose from multiple cars, each tuned for unique handling and drift potential. Your feedback matters \u2014 suggest features, modes, and car models to shape the future. Early Access now on Meta Quest", "short_description": "Drive, drift, and race your dream cars in Drift Day \u2014 the ultimate VR drifting experience! Master precision steering, burn rubber on intense tracks, and feel the thrill of realistic two-hand wheel control. Suggest new features and be part of the ride. Early Access now on Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddytroupe.github.io/games-github.io/tspp4", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
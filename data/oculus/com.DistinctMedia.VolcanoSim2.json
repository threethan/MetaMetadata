cHWwduWddg9fXv7_Dn0g&oe=6AFDAE7B"}, "display_name": "Mega Volcano", "keywords": [], "long_description": "Enjoy the Earth Shattering power of a VR Mega Volcano as lava erupts to the surface of this isolated volcanic island in this one of a kind simulation! \n\nWatch as huge fountains of magma, rock and lava light up the night and spew from the volcanic crater as toxic smoke and hot gas fill the sky! You control the power and force of this deadly miracle and wonder of nature! \n\nHuge fireballs and chunks of earth rain down as hot fast pyroclastic flows run down the mountain side!", "short_description": "Enjoy the Earth Shattering power of a VR Mega Volcano as lava erupts to the surface of this isolated volcanic island in this one of a kind simulation! \n\nEXPLORE  CONTROL  EXPERIENCE\n"}]}, "developer_name": "DM GAMES", "developer_privacy_policy_url": "https://dmgames.org/PrivacyVR.html", "developer_terms_of_service_url": null, "publisher_name": "DM GAMES", "support_website_url": null, "website_url": "https://dmgames.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9469061089876409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393826_909887617882833_2527014376940940270_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kU7e3YrPuUQ7kN
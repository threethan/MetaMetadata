771-25/604347072_1476360530904679_5399358606548040127_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMT4gvSm3TUQ7kNvwGF9s9M&_nc_oc=AdoUezu0DiWk9RKIdMQoPlGY4fRqVvyXSUNcjSt3a1WRhGUL34hw1l66q1xeoLb9o44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7neKqm2PqoU7-QsaLDlkU8GUL5hQdrCjyvIQa-OiUXg&oe=6AE0B9ED"}, {"file_name": "img5.png", "id": "1662512458301334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303174_1662512461634667_8124630964410160419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqoQiZz4FuMQ7kNvwG-2zyQ&_nc_oc=AdppZlgEeUQElvuyQtDaGsZQ4ZFl-f__z9CpE_VeYslGLnTM9AOa8ClB7pxzrdhp4Vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCeQE_z2ILsB8HWIzo25yLPf1k-ycz7BlFdib-PqljZw&oe=6AE0A402"}, {"file_name": "Adobe Express - file (1).png", "id": "1384341933512451", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303790_1384341936845784_3555965496612665995_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ofkr9V2q4IQ7kNvwH8qqhS&_nc_oc=AdpzS-IG1Pf9FfVFeF9ujGUlc6EmGDLpYeJYuDASJEdeYHIB_15IqMZnZCZi_PgcpkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGLRUbWu52qHzQMjnU5CrlyhVwr0DV-Xif0bDyDkGLlQ&oe=6AE0A00A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Hex", "keywords": [], "long_description": "PROJECT HEX V3 - UNCOVER THE TRUTH BENEATH\nDeep beneath the surface lies a secret that was meant to stay buried forever. Project Hex V3 is an immersive VR exploration experience that puts you inside a mysterious abandoned underground facility where classified research came to an abrupt and unexplained end.\nEXPLORE A FORGOTTEN FACILITY\nNavigate through miles of concrete corridors, each one telling a silent story of abandonment. Discover storage rooms with rows of blue lockers, investigate areas sealed off with hazard tape, and examine scattered yellow collectibles that hint at the facility's true purpose. From sealed loading bay doors to eerie locker rooms lined with wooden shelves, every space holds clues to what happened here.\nIMMERSIVE VR EXPERIENCE\nBuilt specifically for Meta Quest, Project Hex V3 features realistic industrial textures, atmospheric lighting systems, and spatial audio that brings the underground complex to life. Interact naturally with your environment - open doors, pick up objects, search through containers, and examine items up close using intuitive VR controls.\nENVIRONMENTAL STORYTELLING\nNo journal entries or audio logs - the facility itself tells the story. Observe room layouts, discover personal belongings left behind, and notice the small details that reveal the bigger picture. Why are vending machines still glowing in empty hallways? What were the researchers working on? Where did everyone go?\nATMOSPHERIC TENSION\nFlickering fluorescent lights cast", "short_description": "PROJECT HEX\nDescend into a secret underground facility and uncover its dark secrets. Explore abandoned concrete corridors, search through locked storage rooms, and investigate mysterious areas marked with hazard tape.\nNavigate realistic industrial environments with atmospheric lighting optimized for Meta Quest. Discover scattered collectibles, interact with objects, and piece together what happened in this forsaken complex.\nWhat was Project Hex? The truth awaits deep underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/projecthexxx/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Monkevr", "support_website_url": null, "website_url": "https://sites.google.com/view/projecthexxx?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
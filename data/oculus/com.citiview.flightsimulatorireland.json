t=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi9GMdkTpWwQ7kNvwHjoOzD&_nc_oc=AdpmmwkBhvKF68Oy41RzKW1AOsjINGmOBfjgVQpQrymb1LnJ1tyMzcO47rTd4_X30jE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7nip0S03T5EnwR-pLUaL1jIivkGGd4fHhfXd9UEri9g&oe=6AFDB0CB"}, {"file_name": "screenshot_4.png", "id": "1611828237071538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1611828243738204_8693101777386958675_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE406Y6aCA4Q7kNvwEFtwLb&_nc_oc=AdqCm7jVDdxNwtBtqnsU8tG4ODZmAM1WHAqJoBGNIElHazJKtppOu0gu09Bey2H8dwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-EpEc02PnWS8Ol4GaG7XCt948Hmt_48Y_b6SwS6_pDw&oe=6AFDE3ED"}, {"file_name": "screenshot_2.png", "id": "1119140857170087", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1119140860503420_3301231492578451324_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycWrygL5-k0Q7kNvwF8_T5S&_nc_oc=Adq91BA_HFdgAyRZg2V4h1d4M_zxHlsxY9zlYNP3nWdWYpf1nUBSX4UOAVZ0e2JqyNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOiJtoIXhyL-B7h26ATOAs_Bc7MeWSkThdCE2-QIHfNA&oe=6AFDD924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1755453832234505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1755453835567838_2989502562948617794_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGfpg_qcxekQ7kNvwHoVdAe&_nc_oc=AdoNyoIUX6Rs6jKqFyRQm9z0cp6BfXCAhRA9COCpmIY9vCR-KbI6StmudwM8bthdTL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHvRU3w3EwJ1I8sDyUZqC9Rc78CeWCCl02N2bRVAmr5A&oe=6AFDB339"}, "display_name": "Flight Simulator Ireland", "keywords": ["flight", "simulator", "ireland", "dublin", "jet"], "long_description": "Flight Simulator Ireland puts you in the captain's seat over the real Dublin, Dublin Bay and the Wicklow Mountains.\n\nTHE REAL DUBLIN\nThe Spire, the red and white Poolbeg chimneys, the Custom House, the GPO, the Four Courts, Trinity, Christ Church and St Patrick's, the Guinness Storehouse.\n\nTHE LIFFEY AND THE BAY\nFly low down the Liffey past its bridges - the Ha'penny and the Samuel Beckett harp - out past the lighthouses to Howth Head, Ireland's Eye and Dun Laoghaire.\n\nA LIVING CITY\nThe DART round the bay, trains on their real tracks, traffic on the real roads, boats in the bay. At night the city and its bridges light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar in the Phoenix Park, the Wellington Monument through the doors. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nThe city and Dublin Bay approaches, the Liffey Run, around the Poolbeg chimneys, the Howth coast, a Casement scramble, Dublin by night, a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Dublin: the Spire, the Poolbeg chimneys, the Custom House, Croke Park and the Aviva, the Liffey and its bridges, Dublin Bay, Howth Head and the Wicklow Mountains. Start in your own glass hangar in the Phoenix Park, fly down the Liffey, talk to air traffic control and land at Dublin Airport."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorireland/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorireland/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscript
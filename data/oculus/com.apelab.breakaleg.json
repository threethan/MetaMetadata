l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd3ihXLy8skQ7kNvwG71BAW&_nc_oc=AdoajMXGkqw_RzFx9UPxr2_RqitNOuAkOt-BkQE-dRUvmq-QV7bdAxdpJOaGPI46ftg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxGWzaRz-m_D_GEtBOlLbeq4qWiVoIZ-0OQN2ovrKEdg&oe=6A9ADE8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HevwP0KPpRsQ7kNvwG2KBSO&_nc_oc=AdqeNxinHo57_Gmdyk6GXO0J9sX3xE0jol1J6bZxG66eVhbgZsS_PFcyzHx1E27EhcA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu5xKBNAgBibDYZTfEakqvakPqT-zBv2CI6Cf5Xjc86A&oe=6A9AC4D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZam387d4h8Q7kNvwF3cN3p&_nc_oc=AdoUlu12tATEKLCufaXJ6OjxSaiyn7_Cu8O0k3kOt_4NwBlkyUwddxrt_d8hIM4KT38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5r_SH2siKvyQXgzpDtWxqqwUWE50_bfyJ4sv97XXoLw&oe=6A9AF4F4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu-LXdX1uKkQ7kNvwE96q4M&_nc_oc=AdrVA9bDyvgXD4tt-N5VghxFf2eUgRxzIXLpsk8w2twRltDgzpOC7OOSnp-Pxx2sDos&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5OzGkKk8tsPWIwJ8CbA4N_zC0N9NV9wm_0J80PPhMWQ&oe=6A9AE441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YLdIOW09hYQ7kNvwFNRFvx&_nc_oc=AdqEQAxRYwJLLOXaXQQX1Il0f_kQSFE7TDwMyavNdMx3lrAtGd7v3fUMdIgyfwDB9Bs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVuMt7-VPejPqtXnDEl1NZbwmFYHm3qOjyLj21lmvtpQ&oe=6A9AE8A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
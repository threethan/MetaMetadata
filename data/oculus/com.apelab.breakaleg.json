w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BG3OdWpeTcQ7kNvwEyJtnX&_nc_oc=AdoNH_YkIPzO5XnF2UtjepNecf1nChilZjtwtdN-6sAKLcNc-H-9T3OvlI-qTSGN3xU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OzvvEmlaj93BzcZf-VUYBgfC4h7T3LR159aq7zzdgbA&oe=69F3700B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQcO-HjOuFEQ7kNvwEW04Oh&_nc_oc=AdqJGbuxOCHvI0P_gRXedQOg2k5cVLrB7S5jJQLMdD1_IK0sJBXmAxC1n645IK_RcDg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3i7ozW3a9I9Ycd9GcgX0ecZ_ApZucZMZPoboQSVahUTg&oe=69F35655"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfb1VRLbQS8Q7kNvwEydOwK&_nc_oc=AdqHj-JQfViboXxLZnq1a24o6VaNBMLEmyOXgM8jLp3zrH0FX4OH7QvliEG_abLKBLY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gOhJs_3laEv1OPVYfWYMSpTchF_t9hnJwr1zTpu6yDA&oe=69F34E34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4OFlynij_EQ7kNvwGhp45w&_nc_oc=AdqO83bV5frEnnFUeOX18hKy_mxv8cReeFr0vvskdr-XYp8KWbw9CNUPgPKs3vtbrVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KR0_6hrynETFSPmX-KClELRXHCJL9hRXRC2YSTmjfCQ&oe=69F375C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5jUoBxhOTsQ7kNvwF0hdV2&_nc_oc=AdrG1eXXFDHdhUbroO0ZV2ApJzBCJ0dBBv4VGh87pRbM_RRalnb9AIcOpnmTc3pLqrU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AWHBVcGrZ5Oy9CYJTrtECe2E8oGU_WAyV5Fsx3nPMWQ&oe=69F341E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
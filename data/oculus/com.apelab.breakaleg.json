w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzw8WLYbaSEQ7kNvwFfIUT9&_nc_oc=AdoDoCxYuzkDc5LBx9YZw_n3us8OyYSnMbl1f6MvWt5j6D8oPsWdMchCj9-g3_69ZgI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50rsaLnge-yCzQE-2dmmjkYwjW0OQDySjo1bTrFwJKrA&oe=69FDFC0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mJYKSHrFBIQ7kNvwGjvDmL&_nc_oc=AdpPjX3bh8MzHrz2LNXGt8T9Ad12PoaovX79-BcixK8gvoH9w7x1z78yeWExu7hC44s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rvjNlSM97lDNlrDY5Ho8Se8QwAfrMETE_ahCRtn-8kQ&oe=69FDE255"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvHmQR9YYM0Q7kNvwFHYh6h&_nc_oc=AdppyQ6dehUDV1baarIOD_QJ3P2_GGkyLg1oucPLli8dd2g4WCLV3SJ6n92PgAukzs8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZQflXM6Y5wZzC6Dz2oR52IeqACckrMoUFpiUY70Yx0A&oe=69FDDA34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbVM-OSTavUQ7kNvwFVJUC9&_nc_oc=Adq19BNT71p9F1T2vCYzFHZjw0OtyJnQxd-NbVrSE_Qyjfb0s2tQnytZrt6FRlioOII&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f7YrbawHzOSqrOUMMLDvNpil6VNJOIm5XeZO5nUm74A&oe=69FE01C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyk1PoYrTsYQ7kNvwHXojln&_nc_oc=Adq-qzWztDw5XhIPflXHTl9Aq0xCxHA4LCeNnLPQv3Cwxw8NNaILdRakNGlD7wGvwMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I5B3Ng7GtuIEIzdFdC0xP1pRSTo3E6d5hU42gn_qp2Q&oe=69FDCDE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
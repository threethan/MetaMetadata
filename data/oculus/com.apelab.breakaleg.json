c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB3gbEKGWFQQ7kNvwHlCSSJ&_nc_oc=AdrNxRKATHsbAMit5QiOGM9yGDihXUvDTI8-7v7Ugr2KS7jdA6sNh-G4Qvs2jTMcjLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3-3wYCzqm5HdJBL3CWkwlYtlceBxi67lKWrd1e07X2w&oe=6ABA828B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JddZ0eslNgIQ7kNvwGxcu6m&_nc_oc=AdqIG657SYSrSdG_tYqjqacVx5KqTRwOumfnqIm645hNIV2aY_R67PfrG5AgAUcSlrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR7FU4InHN9uj3oEbSMCnpzckWu_ycnu7h4eH9NbV_4Q&oe=6ABA68D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyUxZQJajZ0Q7kNvwEEYQ-R&_nc_oc=AdqroZX7R3PVMAMx_GUwn1Kyf7azLekLmlwRKRrJEdHf31zV3rQJDjXakqiBy4z7S4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIND2GoIUTJd-jkw89Qvry0jDiz_duYnXzDCcCtdFqdvg&oe=6ABA60B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op27K-IR_iMQ7kNvwFnrlKL&_nc_oc=AdrL06iEjT2aB5aA-VGY1uKC1OvcMMp1pcAl_fmvMcNZ4AthD8LtuNcaKfMF1DR7-_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3pk4U0VmySZAJEOEpY3MG3kgH9GIFtXfbRqQS6ACfwg&oe=6ABA8841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pegjpKZM2DUQ7kNvwFPMVlx&_nc_oc=Adp_7jJxo3Cbw3F6xc1FFlKCiTwxR3tZ11aUq8Q5n0iGGZBvrw4CkpTkyBE0TKNQAUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnmKy5Dhs3lnlxWRbqu5ExV8RaslfpQYV4TpAsryOv-Q&oe=6ABA8CA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
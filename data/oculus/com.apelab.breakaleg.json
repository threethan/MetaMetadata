d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkBnTdkxWH0Q7kNvwEBde7C&_nc_oc=AdpYY9kC0Kh0DtmTlGLsCa78HtvJjIeJ0J8cSxygnKJsIB3IRZrbnNDmBHCAANzpHR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6knfhj_RS9EUqBo3PRl5MPr1Bu7nb1659o5eOxqbZPgw&oe=6A01F08B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axzeGDl5b6YQ7kNvwGvPoc9&_nc_oc=AdqHzRmWdNANIxh62d3ZIBeB1x9Rw56An6pKmFvVRAbs8jP5rIO-beMTd7mjZuHFCCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vzC-2pOeIFV83EUEiu2NBSAa0-joMmBZcasuRSI7Xaw&oe=6A01D6D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItKHcFlVSAYQ7kNvwGVpogA&_nc_oc=AdrVgi1DmoFhxJAIMMlK9O47Rk3heMSgKgtzmPQLqpHFCwRREm6fk2srMrTzcY5FTqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UZZbsUcEbEONsZU-DKnGiY_foYoA2NdSSLi4BFueKug&oe=6A01CEB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4zoOu6V1t4Q7kNvwGbKVQ1&_nc_oc=AdoJPmstV1nr8Bz2QmlLaa6v3v_2Z-cGkYVD3KVSB8yK4c9izhCxARDi5dLKM-YsvIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pKoO4rWlsq_Gr-y6caPDjKhiHglrA1N2sYkG-9XYxLA&oe=6A01F641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RE7xkEshB4Q7kNvwHABiFJ&_nc_oc=Adqdq6mNHneEUuRnZ5Mj0BT-oTByBhWZoUYri5ZVgDlXBz9G1T9AN7IFBJsSXkNTeNk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p1o1Ar_friO0mHWh-VajCMSLBq1QOt2szuKRqV_VJXg&oe=6A01C263"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj79niNFNJIQ7kNvwGFsE7n&_nc_oc=AdrBgZWQq_PmUfl5-Kf8qcwPIWw4hdu6BvcuCtqkeQCqTnzt7cF0qj0MOgaPfeHSKH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNelQMR8DbHNiumMHepcCu-nFD6KuFCnCJfv_WXYCJueQ&oe=6AE0BE0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obyliECep9QQ7kNvwGxtDni&_nc_oc=Adq2ms_gtfcFXf-rsA41VQap-zJTACarekZ8Zkor4ujyNtfTLkGXs0W2IrkDEdsYnIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuS27G-QRnYcHkRYk79-qb1Hh8JG2xgMAqSC6OnchZyg&oe=6AE0A455"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBbnBFXIdvwQ7kNvwH5MCoS&_nc_oc=AdqMWvJjJ1AGMxFXV4utzgMqO-ode8GgTKV5aUqJClhim0NKpg1adNj6xfkdhBHGm9M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3p8YsugrPJKe1EBQwKxDVNbngkZUUHKR4Qa_rfnlMsQ&oe=6AE09C34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wxh2H4Vla0Q7kNvwEhfYA4&_nc_oc=Adq6sAz2caMmELtH_Fcqu7N6ER3KagomKdBIrgDYxVZPJ-FurI-ttF-EBnMUvPV-4rY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXZJv1l0rveDEFKb-qUFM8xIq3zNF3Ts9IqkeFmuWXqA&oe=6AE0C3C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1TzDMBgkkUQ7kNvwE6XgjJ&_nc_oc=Adqftyy7pf9ldfOJxRTDpd3cCj4E634MGxfXyOqvatj_8qiYc6ckJAozC9kvHpKOyiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtcWJwjBLAy7Ra-MPNuVHPBDjGw2dB8OE7Y8rFkDEzbw&oe=6AE0C823"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SDPuU_6QNQQ7kNvwFiAcZb&_nc_oc=Ado50L1N4ZDRAeLpSjtPOiZG-HuuBbcxnfLOyy76GsWA9rxniLMvOLjR1nVeWSTtEjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4welFc9Kx820FPd5pCKqBfWtEIGN-Cjd1uf5wahy91jQ&oe=6A03420B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axzeGDl5b6YQ7kNvwEO6s1w&_nc_oc=AdoDJv6qmDM4eHGSrQejosAp35LYbdDsISN_D1bZHmVHjP3Y-wAbPPSCwX1zR9cjwtU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7knyhjLwn-fqeQQLqSdHCjSBipkG5ro0eiIU3rko5IMg&oe=6A032855"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfF9X06jFU0Q7kNvwG2SOfC&_nc_oc=AdpjPM4ey9tTjD1YFRYXZgWvWrc9G_3ORpbizQlj6QQezS3Xzb_CPCHU7x8z4P5693U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79KmOcBjHE0J09QaE6JuhTKc7rbc-FzTHlAX0u6I9b7w&oe=6A032034"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8vr7xywdh0Q7kNvwFFpDFn&_nc_oc=AdosdVUddG4CwxoqQWozsaAnDchxRaRuyNJvGMEbxQQ3gdZ3GhzZ6byVw1DWjoUAYK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Rvss7xeeaIR3w4mhnNTKR4YG5cr4u8-gDza6YVO2FwQ&oe=6A0347C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RE7xkEshB4Q7kNvwF--AU2&_nc_oc=Adr3iG9E-uIdsX4l7NrAfMXIVfPN37DUiqBeNleb1O5WiuSwfwkuURtpO1eF_nZmmEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78omxhYsM0n3vPT3q8gUZdmDVUvPAuI4bAcW_nQ0RtLA&oe=6A034C23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvO7uckilO8Q7kNvwFwXIcP&_nc_oc=Admi1OOp4fdDqVDoZi7nM8juWNjQCb5JnA4UVxny6T-YPhDXhi9G58axUHDIz4zlhhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6MKXao7NlPLhf8io_R67oY_BCLN-GWiCILed_3dNjug&oe=69AFFB4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IS_UFL5avkQ7kNvwGexUnU&_nc_oc=AdkdR7ov5CvFmFUX3CyTMLJd-mcElbxP4mKK8G_1pxyKVztoIwHewcwexA74hMlhr0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxzy_Sei0hckMNi84xaKcFxpcAHzo_Cx4UkKP30LOZN4Q&oe=69B019D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoq8LgCRc6UQ7kNvwFPohhy&_nc_oc=Adkh0mYa07DRsrHpeaO-hTHnBYg6diOYMY_tMbzttsJ2SKg4Rdciir-iRjuM6J-MtwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-KMO3bxWW4qyQ7gnktyKo8wKryGRUHw1vKHFwhzjlQA&oe=69B011B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhWn1DNbFXUQ7kNvwFXmMIg&_nc_oc=AdmYvuanJdKrQgomso5DTojgiT46f1yWxpZt1YUcViIBzdd0ePmikZun2rhodtVcyjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyee1kqw3kLDJkZsMNit3YUaBSokIKZPlB2nPRI-nNxlw&oe=69B00101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGCdW8eDcnYQ7kNvwGdw4vj&_nc_oc=Adl5kKyD8wK-fsiq4ltB_f0A8Lqw8YKqrwcSTOJRHWXdFx3CPGyalurZPOx2kCrKMSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy59Or3eSuU0QnVS0U0vhGAyxFaXq1cngLl3vqAUwJ4kg&oe=69B00563"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
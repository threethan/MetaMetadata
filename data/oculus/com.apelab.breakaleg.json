d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvvvr5d4g2AQ7kNvwHfneQ_&_nc_oc=Adq5EUWYNLNt_2z85l3n267KIwb8zByOFEKakYeUzD3mNNQ7SUi_tNLzQC89hippdYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PDC5XL0hb1YOTk3iVYtBoI9QfLxoCN6FPCjSAGvnsZg&oe=69D393CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw0xZK0g7TYQ7kNvwF5chk4&_nc_oc=AdrR55mL30aKqxfAlcb11kd4YJ10S8XDev1Iz18J5LXyJKkaFd2Apk0V5IRAYwjo6lY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uU0GK6RL5BXVL27s6Gi69IvsB8vLY8JzrwL6Po6awwQ&oe=69D3B255"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q-9kFCrMmIQ7kNvwFRcGGE&_nc_oc=AdrJm2i4fOoY7ZJeWwk-2AOMNTrRb-p2KGaNVMCJUZkGINsR88YfYZ5iJzmlrgwbgaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VwlAJhnTIvtKqscUWEZ5JgjpzgjZrqesGjwxlc9Mp1g&oe=69D3AA34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEKdCK56Gt8Q7kNvwEc8YKp&_nc_oc=AdoR-OXPKhmhFPF0hVB0VZ8F3GkCi55GSgfqfliC_en0HJvrhRV0MQCcxbCaTSr-4ng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XeUUWuqXpaZfEVH3dFbzxOFJrnjXuk9TzJNyGGbBBDQ&oe=69D39981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eq76dIJxXX4Q7kNvwFCcJJq&_nc_oc=AdrYyQhMsQTwiJih9q5rns0_ieSb0neyWhe-lk9cm7V5wg6LoEj4dotmE0O2mmgHKaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XTGtF7NqPF0u2mh6Wm7TXQ-KwShSFjnj1XKsX_kY6XQ&oe=69D39DE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
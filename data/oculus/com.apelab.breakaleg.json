d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTVa3RWKvAwQ7kNvwFXdsbi&_nc_oc=AdpSX-7GpsQsowvYw5AQ0t4QUgdlt_qwsJJyb32gb9rokyPGwfXXLD-Ua3Fp9JLq4hY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXvMq7DdEukXbxbaXZHZ7XKDPS3-0GFJIG_n0Q0jQGYA&oe=6AAFF68B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNr0XbgzWqsQ7kNvwH_h5EV&_nc_oc=AdpW6mS7M0pVYYm-j9eCCDgXg68sr7eRTlbODB1loAciJYFhd11J95WeOKkq4penOJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRovD8VRErlas0KXkpgPW8V5X5_PvclbSLt0V2i-759Q&oe=6AAFDCD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGgMSfSJ4i0Q7kNvwEMDB33&_nc_oc=AdpykxEhHlpwDfGFlAc4CNLADZSO2fsmHu1pM_4pq1P-1kxqi5lektUfjgPB-Sq12Xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLj1y64cjgJuNJnyEFXe7EOJ7dgwKZaiq1JH0WzuO0eg&oe=6AAFD4B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_mAx_28UAMQ7kNvwH7St3U&_nc_oc=AdrlogiiT0Jqv0STLd2hRyuYSwu8Tl_PQXmqxWyissXM_S3Js6GOtuHW9zHQHnHMWKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtNPn7W0_UQ18s0rXpj6hkDMU-INhPH1_4qf3UmVFWvg&oe=6AAFFC41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnBTOUXR8fQQ7kNvwGeAXla&_nc_oc=AdpxK0nyFAEunqrHty8LKr8ECGufRTeHptOa86pVE0Qsq_IVcXm4YBZwae1_BiZpxdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRALAnii7gUvdPl_WNnaurOw5fZouVKEwc1kJP_u-28w&oe=6AB000A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
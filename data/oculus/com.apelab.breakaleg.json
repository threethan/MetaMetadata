l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JvKxYx4PtgQ7kNvwHGZZPx&_nc_oc=AdqBf4ZgBrHiPyU2OlQPKeMfTqCojnWztLFoBrStS_a5XrjxHYrrILaof6bC4DQHPmc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYcJGZumGX1oRSxkDTHjc08ii3oQxfPYwd9O2xCZQtrA&oe=6A86DFCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ie6U4wB8-IQ7kNvwGJXlJg&_nc_oc=AdpiLslK9kLE2KFHh3PeuRN9CXj4I8383IcoWgM01bEG3nYt1MQbd3BkVK9P9e2cAkY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhg6zK9P8wRTCmBjIrPBvtoow7b5nFqmr4L9yfmWpktQ&oe=6A86FE55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w8OFeF-1Z0Q7kNvwFl1srN&_nc_oc=Adr4O6LGONK8DYxLMkXUQHKBuOpF2824GqNDT2pwTSu5qGglB7WM5zFhHGl4vRhk1EQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6Y1ZlVU2FntlfO3wpN7B8Mur8rIYmS0lzHzeaUrIcvw&oe=6A86F634"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YTqvAcnSmIQ7kNvwEz4UCN&_nc_oc=AdqSZge_T9d0nqFYGjhNhWgQ_JGX4xVM1QN7mG08Q8pSgNVhyawiBLZ4uT96iDNvRaw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkpAwY9c75PGkOwim0l39mWzUICEz7_LWwZsaygwSNxw&oe=6A86E581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ7gQdD--5sQ7kNvwHnVKMB&_nc_oc=AdqNifizbC6L9YWQw4-XuNtOcUNPRIKriuQG9qYiQGefWYLqMnWzJMlhJb8wbzMqCvQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPZH0MIGKw5wO6VzWzVYfKOq8X0tkdwyK_1hl1MiPivQ&oe=6A86E9E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
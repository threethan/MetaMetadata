ntent-sin2-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu0NNM-MYJYQ7kNvwFfnUOA&_nc_oc=AdoB-hiYadBnKeJY4jlQtsxjn4sjrt1b23o74i-ZRVeW-XpPaDHIu0c-t-rpV4TbofA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_9ddu-o9Cl2sMUpal86jUAEUVUyIb83msQFXHHRDWpw&oe=6A394F8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKmxY2C6tKsQ7kNvwFSDzxq&_nc_oc=AdrNbrnAA4uXBp4HrNXnj7xgZCxUpdSzP_GjE95j0Jkyg8XJVNE4_Ds5CnHANp9B1S4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mToDaa5-IkpKi548hzjyubBGFcFwWPg-EljDPOQtb3w&oe=6A3935D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii4pMkzFMmMQ7kNvwFtadG2&_nc_oc=AdqhiwkeiCxede5A4MAqDnJGkrwod8wh8rHG49tSyvFgrVEWcPZKAp3fYXHALNLCcb0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8fajmNZ_jQbjIGfaqID2bVdmJDPgb9L2MClWrGqOFUw&oe=6A392DB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHAB3dDXnAYQ7kNvwFUI23K&_nc_oc=AdplYnKyk1ATVWiDMd6ySSEk5G040y7mX_cUQnrHJV6Or_wDRlRzpZv5nRkwYMSDwFc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6W_Usjj3e4aCbhoEj0H32NdmaJRC1KgeIb63w7Cq7tA&oe=6A395541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9rZVzkd7-oQ7kNvwEl7o-9&_nc_oc=AdpwWybH-0BppvQSl598BWufszeKGY2MQvn-6MeRoUGxFmCXsOMLBbbfFm6AElSqtCw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H24anDkbj6asV1PUfuDXneDDUq7bubvfIOb7WqwwP4A&oe=6A3959A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
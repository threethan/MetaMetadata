l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVMPDAzD-4AQ7kNvwHKWbsJ&_nc_oc=AdrX2388educj_alvcCgb45sgL-EfFjsAiaR6BBjEfQWm15s0yxhBsuCTXInoT0HygI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE1hpFRyLY2OuRiJqbprqsowpBv5mTYUsvNVnYW_ju8Q&oe=6A6F5D0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7IS0GEqIu8Q7kNvwHFFa6A&_nc_oc=Adp-fv6AzXJxq35QBbTWy_CxqlEa7c6X8Ct92awg5BE70RUY2vN5ifP7OEFYexCB5eE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaAzGv5irNDsD7xydWDXXL4kdzoJ9MWlRrXbqADtJXIw&oe=6A6F4355"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=193yXhHE-LMQ7kNvwF0XkC8&_nc_oc=AdrRGikZRXSg-6-x2a57zv5YgLQKsEt_np7J6Y0ACuxQ_yAX4qLzKBEvIrKLWm9jGF8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6wgrbjru0k0Ci1N3b0XRbEvmzzrUuR-JH7tdM6hyL1g&oe=6A6F3B34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxLQcdleMVYQ7kNvwGi0vGF&_nc_oc=Adpe9eCT34ZYAIr3cqPRBRdvlS9gE6pRH1yPkdE8tCDaIY-IpKw56gXUCRQKPuHBZ_g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlr_KwcTxCj6Tz5DW5CAkvgbenN6al5l1ARaDJm-xX2A&oe=6A6F2A81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvQzywHWpYgQ7kNvwEcAEkZ&_nc_oc=AdqFHHKNXl-ELT9_mZUrux147JHeq0OW-CFytTEvH036EQZPqAoWVVInfMXyB0KBGwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKnXyzEInTJaXxmvZLUXnNdhobhk1uRXf90jUQGPM2vw&oe=6A6F2EE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
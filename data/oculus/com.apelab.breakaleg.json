c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJJhpEhCv20Q7kNvwF4QKw7&_nc_oc=Adr23LLoO1kvjm5nO6czisCeRlxmGZEg6EWUz9FSEjV_sH_4Fm8InKdQY8v0rJ4PEZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z9JahA7-R1_AaX-AnaWXk6OOIRSBbrEXkgdosSpOfYQ&oe=6A3AA10B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKmxY2C6tKsQ7kNvwHPUHt0&_nc_oc=AdrJcXIopsBDFCpxeUMZBxGmuWWCHXxGrU2Esp_DCpkZlRhridjCK3X3NMliwLwOOBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EJr4oLprLiNqNJw0KlA12pxjn-LjPv84gw8eWF7JP6A&oe=6A3A8755"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkRH_BaWKvkQ7kNvwFUV_YS&_nc_oc=AdqIBirwMWLXdSchNaZrG9kuheTLkUY5eCi61PSxU8VaKCHFJMkwZJC9tEW2JJMMIYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T-JehQ5CucrUPRs_l9gEhRzPOg-UwuUpk8pcmNFCW5A&oe=6A3AB774"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjjrsUariZsQ7kNvwFP3ddE&_nc_oc=Adp-58qekpIxU3NOhm-yrfadVJ9bZZZyZzlNvTVjbfSQ2UQJKdy6krI1Q4zHotM7IaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9za43-K5MhZua3TP9u_dDnE3E0yWhMe0ddKCuvGHyS2g&oe=6A3AA6C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9rZVzkd7-oQ7kNvwFF-yWz&_nc_oc=Adrcpq9l50GuXqeI68jAFbKR5wNObMPG9UcQN1te3XxRl5R_yjjYn5jPBooGuTmC3ZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BvVBJfL8oez1KXeKcpG7siAhey7VdV40q7Rs9BsA55Q&oe=6A3AAB23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
ntent-sin2-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuNe4cOiGA8Q7kNvwEj6jSY&_nc_oc=Adrp3-yVnU0rmG5_pz8azR9JmINM39D9mmiJT0BG6BMZx0DhxlNqWfe8xnVBJ0RxIhc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gAOCZDMRclwSuK16Exbo8oJe_P0zAKyKHr5XyPWOTQw&oe=6A11C28B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reG7UMmUbVMQ7kNvwGXExkY&_nc_oc=AdpSSorzwVa4y7i3d9QP1e-swfdH1_2fJjQ3A2TrjbL3Ha7hXxtkd-zz-nkKR4scVOA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d8ZQqADnm16fCWjcZUgssDvfOiWg86dncVvriSrEGcQ&oe=6A11A8D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMIrO3P965wQ7kNvwF4GkyU&_nc_oc=Adqe0AAb9rK6mx5LoR29K7oxWI6-9wNQzbHmVNbH24RyOVtk3Bk29tl6_pnnYh2UzGc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b4Mog83gTlMVvAD62uGYqqYk4Bx8Isj7v5ObUWJ8Nhg&oe=6A11A0B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T079NO4Tpk0Q7kNvwHPGftw&_nc_oc=AdrnGzMKnanSaY0O7S6eEpA1t0gmgDlJEtWCZ2g9Hnn9URX76F098kfNzgamzxmBUNA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rwcsn2_LPxh9s1fxKmgGksd7ESjbBvpwLqH19-WWP9A&oe=6A11C841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6RWAN8T0iMQ7kNvwGQK6Nw&_nc_oc=AdohuMFitHQOhCRpl8xJpYqfjcLNx8JB-gHllClEr8xwWycOsqAgzRtVyGlhBSivb0I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kjPDgjDQZi1CrEsECPl1s-6AkBSV1hJdDO2I0IOR-_Q&oe=6A11CCA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bF3Yjq4aPqYQ7kNvwG4W0OW&_nc_oc=AdrxldaYpg2uZKV5Q25JfJ2yZ9SDur6XqYm4JDNqhwcQIPypW34dcOLgaLXnYRJ_XTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkre6dieS_PUkHRwkHdPuongPMjffqOiyQfLJuLsHRQA&oe=6AAAB08B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Xn7wosDeIQ7kNvwEI7Mnl&_nc_oc=AdouVTq9vZno2Bxw6RVkjgFSUlnzu1poj2EHIk6rfEHwdj-X8TaZPdVsnUytIhwM0SI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmu06JjsHApAlecQxGTUy83U2e8XBA875W9Z8J2-OA2A&oe=6AAA96D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihPP1fAnH9kQ7kNvwE35T59&_nc_oc=AdqMF_mMvglRAmO2UvgmDnpgHh8Rh-unRXi6HWg1y9nalk3RZlpUp68jqNhtXlh8-zE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrEpNhq5biHbqHRBv8V03yLlpcpYmpD_vyG4-70gKeHw&oe=6AAA8EB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0hOoiq63IgQ7kNvwGvxWn7&_nc_oc=AdpaOCOshiH0myUW6OysKkELj-6KkUxDO7tKfi_ilbRuqeWlJLxVwTArT19G-Z3d3Qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnRqmJPZCwCCyWj4wgEeR04VOVK0D0q9HMnrkGzzZEbg&oe=6AAAB641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEBu4zrBWRIQ7kNvwFPaLD1&_nc_oc=AdrIwfaDQ4AV3kH10HV56dfW3gFoMng9DbOj_qGKoc59ubp1N56IS9V0qfauFidj7RM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPx_7gBmL2h7O6UG4LQ6JZ7Nq6kf9puiijvr6ee-ztVA&oe=6AAABAA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
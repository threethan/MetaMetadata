d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkBnTdkxWH0Q7kNvwHEUobx&_nc_oc=Adq65bcrWu9J306yyJBkNVl1mDC6vB184Olfh-Ui2-SR6LNslWvLLDR5rnNb6VoGn80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RJ9JPyRzaYD6WDrpD_nY8f46PwLFv5gQhvCzbC2haQQ&oe=6A009F0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mJYKSHrFBIQ7kNvwGbc3Dp&_nc_oc=AdqKs58o2N0wxYKzsNak4gMaGCkDtEIqa6zaboEdPj6ZiX_tWdzkCj9rVidKGbc19WE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y-ircumyfDF50QCwR_OnJJaQ9TY_9nTqt9FMrl_WEtw&oe=6A008555"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItKHcFlVSAYQ7kNvwGRbWvZ&_nc_oc=Ado-Z0Ng2123EqL0I6MK6mh2YaLXIKGt3Q_WqH_yAFAi64U04DdMOaJWUtqofuEjlJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58VEjj0EeSqwrF9OVoaMVBsZMHzBfmkJVX4Xbu7zW4zA&oe=6A007D34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4zoOu6V1t4Q7kNvwFCTnSP&_nc_oc=AdoRJEEPVdu5ntpGv2bJNzcavzoPqGFbCjXuih1yL-lWEVNndLdqwDHLUqQfEznnIuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lkHlucm9ElPyuTGxTVHo-wjD6JS6qWWsMqZnYGoMEuA&oe=6A00A4C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RE7xkEshB4Q7kNvwFwwo7E&_nc_oc=AdoKmB0kdpMeydGXrPgAFFyt1FbOih5Wa7NSbOZRDjAycNZrQjrAmnm9OYgpmF9BfMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ndHueJ5FhW66lKh5jvKnfXAG2hWaEDvWpHT7tOhD0pg&oe=6A0070E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
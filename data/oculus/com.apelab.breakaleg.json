d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AigqcMPWNikQ7kNvwEJTion&_nc_oc=AdqusRB9bOEk4MyXoILOT-slkAJILKzl6M0qmEH3uUcoY8BkwhVbpVJBgeqa-BiTgCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-gIfC5eyr7iMcQJ98K2Gj20V-OQfDP1zYzw47ssKFWQ&oe=6AF1E18B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YhscHET4DwQ7kNvwFKGoqZ&_nc_oc=Adp6MkVMlgs2-Mf9GcFo5hxJ5irJ8HgqjjYz8kPGqdRtc1TMhye-zPpLBPw_oboR_m8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHU8w89YxXx8fD0df6_itTkrRwEMLXEWEhRCO_dFQEcg&oe=6AF20015"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlqKlJWoFdIQ7kNvwGVp0vo&_nc_oc=Adoi0rMo6stTDlY9-9Z9cBWev1bTX1Es_0y602ILAaV7P9qgZAbCwpEmrfPkHPipkZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxKvCmnzDGIsT8cRIuIoZ6aT-41EAH8UPgNqNp-RI6ag&oe=6AF1F7F4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_VojAIOJd0Q7kNvwH9Z377&_nc_oc=AdoKhmKO9Rxg22vwLSS22V1V27O59fYvIfxFQywj8vs8Zolkna0GIKBDYYDE6NSjUuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzslv9en-QiYgL2MuBPzxMAqbVIpW4YzQ7LGMEWZiSFw&oe=6AF1E741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3tdD7Bdm38Q7kNvwEsj-KW&_nc_oc=AdoTpzg1SQ3pFeyLOVHoFLvnNf9qbOiAeDACtUpgTQPNumYNp0dbd_lUB5pNnRqlJBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxXJPHZwVXv_ulrYXxVAZAfuZ5oeZai-Cfo_DEeBzz7w&oe=6AF1EBA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
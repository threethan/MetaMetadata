d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i126TY2zt7EQ7kNvwEnrzn2&_nc_oc=AdpoLtBesw_pGBCalXsYYDsZCaej51KZ-vevgF4NGdgK2nJMjgQC1A5XYrugQZPeIJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEKqAYqazH1qSFUzmoIE95v55IXzNiiKDAlf3s4pBSCQ&oe=6AC6600B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99vyVNTZnuMQ7kNvwHI5BEH&_nc_oc=AdonHikYtYNhdBEj0V-X8wbXeyOVYLcR3pIgsIK7zUmKNPXhs5PXR5oOMt_FzbUKKCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEv_YlIR5fVzqJ6rzLfuv3KfdLwS4nyREJmXjT1fY4Bw&oe=6AC64655"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiBP1QICH20Q7kNvwEEFPrd&_nc_oc=AdryGDEc_xAzOPeugW3hkxmpvO0yq4QwBMw1gsYXCkpyZ7jyT6Yvw2_f4aSfiKUojfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-VHkb5lT_9YZT_Qbw6bpLvI7_mRt23sRMGdMHrst7mQ&oe=6AC67674"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZB3vf4HGCUQ7kNvwENehpJ&_nc_oc=AdoHpNywGvqkunWpk_hjeoHn7sLUwJQjHh_A2RDwglJ1g5D6YUVT3Cl21ohRJLmdnjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8TBnmDT-Pmdv-wGaFnH7px3k292e9cb1eW4iR1rwuWw&oe=6AC665C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNHZflGE7ToQ7kNvwExcgCn&_nc_oc=Adq9KYVUTI66iyyRGi9PL3qMGMnqAfh2iikXFGmSYLEzc4qU7HPBp0MeDq6YreZrlxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOedBfxCcQhIXwLXdcqSqVTEDdsljN5JPpCTJX7U8h5og&oe=6AC66A23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJBIwVX503MQ7kNvwGpYLep&_nc_oc=AdpM3AUDAEMaigxrUCmjIbciNaVC-quZgFv3VpK8lK3lCU_uWNVFE1KvUbleZ5yG9_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGArqfrrx8Ftwy0WKtW4kQE7rrrW8GqmxXwqNWqJH7lrg&oe=6A82EB4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfysKHCrIZYQ7kNvwHGrpdX&_nc_oc=AdqixW0GzMl4EoEv5v6uc1cZ796puq9NfkA4v3X1Ax90xVUX52qZ01c4S9cVHvQSpqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjAb0595kmWNLjr8N_qFp2U7Za4spPcUSe3MvI4dJFOw&oe=6A8309D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afuu3LXvT5gQ7kNvwGsqL-S&_nc_oc=AdqXVV2zfeDFdxhQDJ1zlnVWZC8YvmXCAJZJ0aeotR1SVSbQSeCL9cSLDFkV_nvw2L0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH44St1scA6-EIa49S1MXVoe9lVLGl3aazu8qajQY4rjg&oe=6A8301B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us3vXV3F9AwQ7kNvwFET-AQ&_nc_oc=AdpIqleBVuSka8HE-uCYCkuSDayKdHI446hUDL244L03knddNL1LWkIldb24AtbU2Qo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxw_jAIRsOyq3GjzhhMpmboyBLooxpP3I9TOzT7VQ0XQ&oe=6A82F101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSLRnqKmZCUQ7kNvwG_QLa2&_nc_oc=AdrvrmcvCA_m5FGiFy-KIwaiVRh6iJWXTiYEQ3ihajN0CEMihj7UWBfzXynWRw6FtPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQVak7AzqEERSSbvuKAhKjXDsLN5D1OdI749Ym0C-vTw&oe=6A82F563"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
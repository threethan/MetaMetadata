d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K3Lmh8BduEQ7kNvwGzncAt&_nc_oc=AdoqhcviWfWD0eNKMh37YGsrGJ2k9U3o7tZSABkVxS_z-8TctKEX5o2SF0rRuv9Gcgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmVe6jVKzsOIFxuNYNx_gAdvMGaum7nt3twS3YJn1nuQ&oe=6A64D10B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihIWbveJcsgQ7kNvwF1HZnd&_nc_oc=Adon5etdgggWR88oGeeqjyYCvC6zJieoWHHkWfIMf1ABXAfq974_oxp9EKc8H4TFJLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBNIaN8x7rYbocTTzJ1VbPF3dDjBziq6Z8LZ5fg1c7YA&oe=6A64B755"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDKcSv9uN50Q7kNvwGG6qIk&_nc_oc=Adrb2_Z3HblyukMX1hl3NGEfsSymn_j9fH3i4GL633o9VUTRSjM3wXR3IplgFVVkzGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfcKMUmqw31M53D18NMF3orT8jcxjywpg-H0OPm2VkJA&oe=6A64AF34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_yB09nrJxMQ7kNvwGzZqfs&_nc_oc=Adp03k54zcfBW4y3twPgzpO8Th_k3Rq4NrpV69kafkGm_cD7eMks4BekxgUM8IN-RUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxX-4fen6z3_WutSOUyJ8Tn_HD6e0n_kjt5Duif-gZZQ&oe=6A649E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtFrDCt1P2YQ7kNvwF8VWer&_nc_oc=Adqz9fO2ZaHdd8zD0yMlOpx91jPuaJQPEYOuHoClj8GI2sczUgXBtjkhws86Ps-mAuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCmC_oYUszj0lbQ-QnLDxDh6nm-1wQbDiS9UcyukoGQw&oe=6A64A2E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
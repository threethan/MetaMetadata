w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuNe4cOiGA8Q7kNvwHO-hxs&_nc_oc=AdpIknMcLnnzGTzP0tROP7KM1Ty1X__22Q7RzN7lD-fSusTnlSgS8-hiksc3NfPMwho&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74cwv7FmOmx_gX0cNtvQ4T-N9cmAlfrACv6q3CMPGOjQ&oe=6A0F1F8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guXRQCNBYFcQ7kNvwEVRYSs&_nc_oc=AdpK5r7d0NBnSpjZs_yQmt7zva8R4XM1IYYhyvWcTiiK9JH5csCqiCtUtvbimDABHus&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af702DH4RLKcllVU7-tCyLnwuTKIyOVHG7DPehzeZFqW3Q&oe=6A0F05D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMIrO3P965wQ7kNvwHDSWEn&_nc_oc=Adq8QPhmUmrdvBeZp57Cc9zSRkIDGE70r67CykIkH_Bbf09hsNHRW9aZguekfSBLz2c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cQt5Nkh27RdoqrrWzCJPKaQfJ0kCLGYpgaXZiejyijA&oe=6A0EFDB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T079NO4Tpk0Q7kNvwH8NpP_&_nc_oc=Adqd2aYPt9fCbOj6v8LHmbNxT6KxelSPS5Z-EQjYCEu7oughcuUWGQyj1Q0jXDQxUxU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52h-8UU6Frzvc9mVpIG7H_szRqyI5XfmJm9ot4SbfP8Q&oe=6A0F2541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgIIBoHwRfUQ7kNvwH401KG&_nc_oc=AdqZCoptKiaLvPK-_gQqnKLtwqsj7IrQ6TdDcjTvgY-bvxrFPqoentC2dVVZFzJPwgw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M194o4ky-Pl53Qh8M9-aXF9ApfpqJmD4LNnSkpyrGow&oe=6A0F29A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
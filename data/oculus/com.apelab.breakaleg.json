d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm9G6Si-SrYQ7kNvwGA0joz&_nc_oc=Adpn3M-01k5CD0P7W-6Mf3ibq2z_KuY5pkcRKMd2NnF88RRNPrangEb0zVSZuIjPSyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStJCoyMK2AI4FJcCO0HJMu5scWh0lM7rj3Tv242JB7TQ&oe=6AF4848B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwuFJ70tLxAQ7kNvwFPTqx3&_nc_oc=Adozoo_dL1miDeIUtUG0FysFYTvhG1Poz4ARXq3xhzVZ0JrE51Pp9Ja3RHP7U94g0F8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjYHxY3CSNv4NpgUGyaUSxC52POb6dsaL18MggPDTpdg&oe=6AF4A315"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUMna0OFb_IQ7kNvwGPREo4&_nc_oc=Ado557IVi4E7hs26Ozpx4qDHmAT0GmeOI2e-nocBEAOhYBYX_wkEBhMRuwR8xZP1uN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgYuOLOwZDr7PgSFRr4GFGm3-r6J-BbOkpu2Bc8kXIww&oe=6AF49AF4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-O4JPruGSMQ7kNvwExoy2e&_nc_oc=AdqY2XlCZlXzAi1EX-IOt41fSkEPD7NhA_BbOWoq4dhE6N4Y8OOeCVPTi0WskSyhhhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStJ3em8S2KwBodU81J6RPYZ457TyXAtl68v48ZgUB87g&oe=6AF48A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3tdD7Bdm38Q7kNvwESc2Qn&_nc_oc=AdoaTGtehsvCTZo57VFvfNoefpzbF7FkX77l5XLfUEHzMnCzs28qzgRX3pPpaDAezt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ0c4fIxRSHsDCOF7X2J_FArUI5uFnT6rPAtisDO51qg&oe=6AF48EA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
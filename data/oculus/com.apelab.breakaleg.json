d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJJhpEhCv20Q7kNvwF-PY1A&_nc_oc=AdqzsArYOCp9v8Y724jhRkzcWnZeiDmi6Ma1zhOrJokNqzOGw2CvGItWkcCg8BrlAd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OhFyPw-Vker6S5iJO8NCfI_oQCN5ZCUl8lzO4WVhgrA&oe=6A3BF28B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKmxY2C6tKsQ7kNvwHGeqc4&_nc_oc=AdrxJ4Yml0wmFctjx6H7YdVe4vNkkzx0UFidoEBYjYxHEiITjNgYMJHpsRf2E3JhG50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y4Z2r6pHi9PQPan6LO8g1GvEEWemDzl8lI7LH_TyDww&oe=6A3BD8D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkRH_BaWKvkQ7kNvwF72tg0&_nc_oc=AdpOlo1NyjFQ9qALz2jkolPVLYOBQx0xAGQzHvQcoMyzgJg52PwE4_zMTKrGPidFS7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cjqDGBktTQ3UEYmd46VbUtA3_aIGLTSl2RW4JVY1ACA&oe=6A3BD0B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjjrsUariZsQ7kNvwHv6EgU&_nc_oc=AdrPx_tZlvWkZsaKurVI7nvBONdRHlKnemL8nD3yXhOcPbHhzTxohdnu3X41buZiZZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZOI4iaA4Z7Y9r5qCXGWwQ9Ejf_Q6CG6Y2i_TyzCIKQQ&oe=6A3BF841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Munl5CT_CL8Q7kNvwHhKO1c&_nc_oc=AdoHZbuIboSZAdFWzttN04DUMfxUX_xlCzaZk93VA5uLKDVqfmlF05uiiMKYWpxNWPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CL4aIPeSBjBPaak4Gkvz5reziumbo_nj0nZgjVD15Yw&oe=6A3BFCA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
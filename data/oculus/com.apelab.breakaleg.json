21107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29Rie49DV98Q7kNvwE1BZnz&_nc_oc=Adp2AFPpeNt4YJ55c58QTRIETgSTe2iJ1w1Z4wnjBGXGfaNe9RGeFmAQWcNmyoi07LY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af26xYWXqIRreFg4TOvcKEoIqweDaiF1juYUnrQj0IuIiQ&oe=69F1E64B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQcO-HjOuFEQ7kNvwFcOFa_&_nc_oc=Adoi4IPwJqibupo0u_KYCtEUodLPuEB-R6HpEYy6Z7CaG9pf1OrzuAP4nQck5_P9Tzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3y0bOVu64VF86I8Psi3z-2qxnRbIEDknV2J_lFuGujWg&oe=69F204D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_9RsYz-rqcQ7kNvwHLBWZZ&_nc_oc=Ado63YVLzH6Nf-j1qDh4jxafFQOBs59bEiKf7uJbsWo_ySkoW-evTi_KWVqdNM_FixA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3wDYnWuLRq6hKvL-ZYHhXW6vgPyFw-RMBhv1sLIij49w&oe=69F1FCB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oHV5ZlcC_cQ7kNvwFaOmWm&_nc_oc=AdqsgZNii895bt5WkLE6ISpSvCcSW0iW0dT5OMma0ss83LpCtP3VkAuhMDuQSGUn4FA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3Y9GNapV8QBnaP_jX-Z6b6nspIi1Lv_gDElQAWWKg2KQ&oe=69F1EC01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5jUoBxhOTsQ7kNvwGEAEVa&_nc_oc=AdrM4h9cO8pdB3tpDmeEH1kYSjViq4Q5Iti6Lixxo7T5TL6FRR_ZuEH59s3mZ9zT0EE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0LfVrq4LTuhWypC8inO1JkPz543g08tSR5LjqjpGZ9gQ&oe=69F1F063"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, 
o1-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXXPI8exl1sQ7kNvwG_T-Jr&_nc_oc=AdrjAYlvWVAzYNJ6PFmIHGSF92HQULmWnJuMJBSWgoF8no_RXe7d8N_i0VmACzHMAoI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtfE64rWokmIkhjD8soNG-b7RAX_lPsAqKlQEMcbIfoA&oe=6A940ECB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUsgFkB6FtsQ7kNvwFNO4Ig&_nc_oc=AdrxH04UTlknIxJqqxxaytB4nN-YdxMt3DFbxaNtux8TmRkH7x3iZtWeg--nlQK29Qo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJq7uObM9nmhro-afNFzb65ga4ic-_NvOyAn0CeYyegA&oe=6A942D55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdqHTSl9WcsQ7kNvwFM14BN&_nc_oc=AdrEfmtpDsyzp-yoT7Hj9Pv8aN-7Dzu070Heht9mU7rorMFcpWbihCJlbcbO1c5Jz6I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaWyrbf_AqYPwrl97Df1K7n_IZgJ3wUHtnq9FWV0hirw&oe=6A942534"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVPYCt6Ah3EQ7kNvwGwapYf&_nc_oc=AdqA4BuD4RYKTlZ441RU-0Z6cg0L3zhFafs9R0AQVrMukI7bPXwGy07rm6hYuVU0It8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYcxiAima3wK1HBW081YEasyVewBXtTvdvTQRGuRmvfw&oe=6A941481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCcIP6rbwToQ7kNvwHE_kfC&_nc_oc=AdoG_p7UxkP4iGigYoYmG2ghRLNgoK8KWjafiBqVQElJv675LM4UGf_vQXT6wZMonQU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyuStbzCYlkLnGy3gW4kPfZEQz4dHuVkNuIGiNjbPgFA&oe=6A9418E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
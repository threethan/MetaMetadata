d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy08JUUKVXIQ7kNvwFiC8op&_nc_oc=AdrqBbSIAieWhyyfxGdCTy3MzwjXFve4OSzSali5zT34GoeKCc2vJTWShxJzuHRz3c4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINcusFb4pQu35N7KTzXxONr4mQraOzxuDIPssT3CqDdQ&oe=6AA80D8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Xn7wosDeIQ7kNvwHhY-bC&_nc_oc=AdrSSYP9g52yNFcQojaFPsq1H5El9fudF17zhXh_PpLknvcvpdFtDIrrzwEIpUPkYtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXoeeJQmfejdFOlOjZWlI1sls20lMrDJqyNYvGxap0-g&oe=6AA7F3D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oA5i3fluUSMQ7kNvwFcGTku&_nc_oc=AdpWBJH09cyuSx_LkjDap5wc6ZOiTjzxI2Iq9xDauCASX8wISOE_INgWvBrNuObjbYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMl3sX_F9HskgkOlmhioGja30dhYJFBzrsTqD-CLJvpA&oe=6AA7EBB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zQgVGUAD_oQ7kNvwHR25Yw&_nc_oc=Adp0QFs70hpeEfaTd61UQL8RvoJduw3wZbo1K2YAc8dER1VjiBvDSnCC3ywXiejYS1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPSur4Po8-JuBG89MFcFc4XyKQ5eQr81-R31KflkMyfQ&oe=6AA81341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-X0jdW28sEQ7kNvwF2F0KL&_nc_oc=AdoAv44IFRlxQFvG8-ky7j2aFM2QsgHtuuGdIhxUToMoIBIeTA-8DRRdzv7XiB_b-EU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7SEX8GladUgc2RyBiPiD2tZlKgoVVI1bUfI8BelFQgQ&oe=6AA817A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
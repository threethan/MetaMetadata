c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K3Lmh8BduEQ7kNvwFbx9bG&_nc_oc=AdpJCbRBt15TF-zQ-ShUzsR_3vAyWRc_1SL4_hHlvXKvlDZAN1QDd_8yJyJNGv5IQYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXg7fW8BAk5IrCqXnhr45hXtLXqLmEs-DAGCi0HwKeDg&oe=6A622E0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voZSu_a-JjkQ7kNvwElndiZ&_nc_oc=Adr-AYvAk_BzPanaKfJQNyCbFELX7EiT8mo8GXezy3MjUuOaLuQuJ9Qt4ekj1CeuhBA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAGlLUnWPPHjosgU7llQD3uKSCkd3ua57CHwQsWDkohQ&oe=6A621455"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDKcSv9uN50Q7kNvwESWj_-&_nc_oc=AdreqAvUv0u85Nu0OWoNSEZ7WGTmVy3puGo06iYy5F8BX5j9uL-uObAqUR2xxLrRH0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClgXvkWe7YNfsDhYkaVQ3cpVZy86c27ZcDKt9lEdd_ng&oe=6A620C34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_yB09nrJxMQ7kNvwH4nz8w&_nc_oc=AdodzHUKpZwjvs97XPBVZS2P3ZCjTh3PsZWoEGDZVrBWlS1alp2Y4Mzd8zrlA7OnCvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFzekQ_LAgkzPtjw02tCmYhnVy32s_q96LFFORL3NR2A&oe=6A61FB81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yyu1JILKw8Q7kNvwHQcfT_&_nc_oc=Adqt43anNfeUYpi2OK_eMGiwQJrTuBr5Wi_MLKRL3scT4lQN0JWHDjcxgN2detqh2K8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP1OWTsyb7ZisjMt-Xt5_yc2_gwR8aHBL4ZtJ13wdcuQ&oe=6A61FFE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
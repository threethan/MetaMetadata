d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de6EHFKKX5IQ7kNvwENmPdM&_nc_oc=Adoi4JQDSDDxSDke_7Y_O2sxpmMo1_h5F67ql-zcSmWGv6ltzGVEaXdUjUnBp16FMxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHGwQZKWLV5FqogQuz9hrWP-ZYbnIoA2dsCi0SAvwj-g&oe=6AEDED0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_z_1k6O2osQ7kNvwHP5XTb&_nc_oc=AdoaK9jb2J1vpW-HkJKbzdEmYLnFQqcrikY9svn-P7D-e0wjN4YgwM0b-oIEgYurufo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSxTCUe3I0uDYJVWVNwRp3BXfU6Y-ocoUp558WEXU-TA&oe=6AEDD355"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKJwVgB2haQQ7kNvwE89563&_nc_oc=AdrbRvWKxngYvBbpdCIglcIab1cW5o56TTOF6rVYBNiAHKF0kEkjaSUcuoSLfv4-_5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1y0oSgqcHh8iWNZnfAIHqRL0bAQtE676C9iGJnYdkdQ&oe=6AEE0374"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmMc545R4BEQ7kNvwGpp1hm&_nc_oc=Adrni9Os5rQivSqJMOZZk_mbcrj3WChrrVm5yHlzer2SUSZdg4GjJIB9JxiGU9l_GsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjVckOOpzL2IXsfnHN9PODeIlON5afVUQcVylPkHrM-A&oe=6AEDF2C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV8S9o3WMfoQ7kNvwFRqeP3&_nc_oc=Adq_fVsxAdkfHLHjWsaJWZ3CoCQr5lzl-XWTpu76jJth-kJNv11JCLVLLl5dsgaWuS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA3Xba2Sbe70EYqQ9rzx9srItpF3byUykV7njf9CjOJw&oe=6AEDF723"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
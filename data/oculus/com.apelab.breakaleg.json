d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_5qKPCRSncQ7kNvwGipW6v&_nc_oc=AdouxsRuA8QLjg02ZS7w2_oyrNyRePAdfgUDsBWUbL-U6VE6MZRI3I3uiegYJ3cZRyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaCHpp1De_uWObOgFxTWTgs6ZMIlI33EbKpjJeQDFZ5Q&oe=6A5F52CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWkz_PAm-BkQ7kNvwHIrYZb&_nc_oc=Ado6jzVdZkH44V6JfqAabahYSZCsYubSZh8-8ZPfCwubkTB37Dxz02j-s-WnO1A1eLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx5UuFG_rE2NWW_h5ib-l97YbxMWtoZw4s6Ij3GkWYOA&oe=6A5F7155"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r7Xx44D-gsQ7kNvwFkXemt&_nc_oc=AdpoqwTGP6RdHuoRcsaE5T8xogy2CshbbGUDC_EJEQK7Jbz8kVLZ6euxZ1Hy9dgWYiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByRU_s51sWBnEozvZdlMFYRfI0ZJEQevSVN9ZcvGy6jA&oe=6A5F6934"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISKDFsdBdx4Q7kNvwGxBCNN&_nc_oc=Adp97wvo3JbBYNzvtSzrFpf_TKEkHXpjtl415xLj6AWBIBQzopwKyffF_gRDFGW3-iA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqwCopNaHZmaVnwUFCEY4rYgR9Fys_bSH3ZoYGhqeylQ&oe=6A5F5881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yyu1JILKw8Q7kNvwGAaZ4S&_nc_oc=Adoqc50suneXxKW6WrffINNfTScUmnE4blLzUptYw7g0uVCz8hoQplniKxGmPPnbqO8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSfjnCD_fwhm78KyXEqbSicnzOKEKvbP7HD8-3dcoyiQ&oe=6A5F5CE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
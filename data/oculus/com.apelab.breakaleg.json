d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQiPwGEurwoQ7kNvwFCQq__&_nc_oc=AdoG-N9JBcQB-djb4-lUgry2zXr0703RVJuN7OnMwCU_DXx_UadUChftD_sbr5G4-M0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHhTIA41OceYoM4-Q0S9txBZKDIMKQhQn8M9SN0CqYLw&oe=6AE4B28B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqjJkFfsHFoQ7kNvwGwW6dm&_nc_oc=AdqgkEZdsV1kfVijde4eG4n9vMi92W2z1xRgPU4L7U9ocKo4utTeAHaHBD3KyeAO9xk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdhrMwJqeavuz-2kEQIk8KwpW2h0KFA_n0CO9rHZRTYw&oe=6AE498D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jt7JBCmr7oQ7kNvwE3Kvdz&_nc_oc=AdqVQuconuCjIr2T_ey2VWgoZPl35iIQbGPSExYF2u7Zz_meFQTHtPnq3fC88CwhT7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtmKpfevXnwC-oHgmgBLJy0dUExFYkbDXg8i8hb1IM2Q&oe=6AE490B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGollWDuhyUQ7kNvwFx5adX&_nc_oc=AdpsWgy-wiTBryrUMUZCvTVDoB57fu2hRWxFXtidwmuK4tKBsXPw48R-hjOknzvaduk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxRbY8JB1ii7WPyusmMNZpbDEymMAw5FsL2X6Jbar3eA&oe=6AE4B841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6PG85uUlzAQ7kNvwGNdTxe&_nc_oc=AdqL0nF6a7cG8XzIIwRntROLFaGtgX-7bpJsQW-0IcgxNPQ3Sup-OGYR7KD2YlBboxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSKzfo9Uw9UiFeFLtbk1yPDwKRfo1AxmIMcqFOKEFc7A&oe=6AE4BCA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
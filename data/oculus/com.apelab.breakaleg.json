d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bF3Yjq4aPqYQ7kNvwGX7SUN&_nc_oc=AdrdJMjoRN3djbiL8HTjfLgRI3c5X92_Zm0UvAI_eFfFxyraZDx0lGIXXYVR-IZNLTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw4vm18vcRXCiJSVXg29VkDanHh9oTG3KCCvaoZWnF5A&oe=6AAC020B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66Fft6rLgE4Q7kNvwHd5YQJ&_nc_oc=AdpkvfXaMEhMhdr90pT8WcqjSWfNOv2SQECL2dIn5RkdV0CANCmSJLkLEyt48lk30yk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9u6JgYE_XgwazpDgqESI9v1u9aLkOcoA4uuDfPe-Yxw&oe=6AABE855"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihPP1fAnH9kQ7kNvwHWN3Gn&_nc_oc=AdrSXmvReorGOQpAqluLY2L5xVMSOXvHnX9rXKwS47brRRtRL2R2M1os0jEZwPN896c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkbseyJzOJtFYcKBiM6WtNsnK8EUPgaWDJWwk8dtNb5w&oe=6AABE034"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0hOoiq63IgQ7kNvwGg4NFH&_nc_oc=AdqUNxGEONm2xg_X4tG2i7Sn5SzKthyXJT18iZTky37eeTt0tObxGKHFfM3nFnQT-hI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5xMWkeJDh2M577q72qQoLVhUk-JlXCnuNP90xi5Dkww&oe=6AAC07C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEBu4zrBWRIQ7kNvwH3TG9Q&_nc_oc=AdqvYI1BrvUURvwAz9N0-0e47kv2NYz68Rh8GKhPc4y77I724mVh12570bCN2aVn1vM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu8M1czILLBDXb-PWn1gzd6l1068e8fMEQS22FkN291g&oe=6AAC0C23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
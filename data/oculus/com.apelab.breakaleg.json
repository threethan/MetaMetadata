c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rBIE1BxPr8Q7kNvwGZxqNf&_nc_oc=Adqua8MKzkYZ5A0PoU_h6w9JvcRP9gUwnaiViiwnvioniXeWt0OP5DV4FICJz7PTINQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFsSo-dbAcBwPahbyZGET6LTMzTHopXlTe7fqtb_zJlw&oe=6A9D818B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnNI-H7U2e4Q7kNvwHByYv4&_nc_oc=AdomywKbQrY7001LxLqUGm8LlUkK9AWYZhyQz8zVRUpxN2kj1_0G5C7RnyJ7bgcDbyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgozDLxCY-nXqkg9w_Y5HqUy7AaOnxE1sDgpj9JHMC_w&oe=6A9D67D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mirlICyFlpQQ7kNvwExrR7z&_nc_oc=AdpSMve3mWgJ67w9XgusLJToYsCPGHeYC2TZjgDLQxKfGG1TFZUCtWFQpaqw_Y2NYIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjyhQa7ID-5tqmNn-NDuHV46fXQlIAqj2uEeTWANcjUg&oe=6A9D5FB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXn5auhq_c0Q7kNvwHVi3Oz&_nc_oc=Adr4FxBEXO7jdtpAca-RNNat_7OHLbt1ipvTFgF0gHi6LrVhG9-pCrq1JCrbG2GvQ_Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZRDDntdLrFTOadk22gPbqGi2abj9JzwQYAfg2YxG4ow&oe=6A9D8741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YLdIOW09hYQ7kNvwEh35If&_nc_oc=Adok1gkaNbR8dbYJFgZWC4t3Zj856X59vs1-YMO3bmyXcIWye_Be6R9hP9DD5MbQgac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsaxGWZRYJUdPHLUsfVzU-eAhKGHHyQ4Z9uGatMf9fFg&oe=6A9D5363"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
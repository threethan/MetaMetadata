/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL6dmEopA18Q7kNvwHAUNZx&_nc_oc=AdnBpYR24mk-C19l43uXdF0NynTBWD3b0bbIi3jiE38upRblj_i2JdyhTNPMoxJKCXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZ3EbdfJp7UFgD3pHjs5ac6q54NgDAhVPHe3UYMyWwjA&oe=69BC110B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kHEg99cEFUQ7kNvwFeBxmR&_nc_oc=Adm8Gne-TaEDIBKblL86Y49f9aqASQ4-7ai2qfsCvEbhDuzmufpM-WWwgJpTTpqIG9I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzwe_H2Hk4oytHTygtE740z7TcVMmBLJspUEeUDxnzNzQ&oe=69BBF755"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Iz6gch60fQQ7kNvwF3onIh&_nc_oc=Admz1zK8d16-lkYQauMSN6klgZZi6llRStSjpoOUyRtNp_p6NR5WxAI-Y9dRpusuOZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTCsIzlBWfOr_ILnafgEoS1acrjUCrdGKbCy0XY7sc9w&oe=69BBEF34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pep2XAjxEcYQ7kNvwFZIbpD&_nc_oc=AdmjS8HyH4ZSXzdFM5kfwj9pdLDlKAIzHyxjDCjvX5RWDfKWqE9IcTczMe_i3fSHxJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8Z9phUce8h0_o_Q7BEQtFUwlPfv_9K_6a97J2yxnF2A&oe=69BBDE81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0UsXk0jHTAQ7kNvwFgOj-A&_nc_oc=AdnLqVHZOC2fC1lR6L73YW-usjFayqj3JaTbo5l_y5thpoa2ZsITRLJh29gVK6Eql_o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLw5_XS53Exo6xwYSky_lRggBShx9vGj2AY8Uy-77Z1Q&oe=69BBE2E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
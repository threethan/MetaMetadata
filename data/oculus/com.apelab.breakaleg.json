a3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSo6yjdOdRcQ7kNvwEpyQ8t&_nc_oc=AdramcJ4igRADfaGG8eEny0OR_Vxk8-f0HpJiz9vwrylijsJANPLUiOlPrCgARsdFRs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6NFxu6hGZIvrnC9SuYiu17obsHmSkfAYbtX1hsf3JQg&oe=6A56508B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SgLXkO845oQ7kNvwFwtVFO&_nc_oc=AdqJJASYd3hfC8iUBYsNgw3nAiOAJw4Br_NlAVwolhnNhRj5FN_5WS9NbbnjlJs3Zes&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3XcSrtw2SFL3ZlCGLHyFDuhAupZRIIzK_eUuTZWSVHA&oe=6A5636D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM9S7a-KPyEQ7kNvwG6Q_D7&_nc_oc=AdroF7OscPHT5vzdCie5C1385BswJ9kvzGqOdzThPn4qbagpRWHmyK845EzL17o3vVE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg7uejJ5ib5iJXKkMHE0Wveoob3lc7qtyNHlX8zIBRHg&oe=6A562EB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMJzeXxcT7UQ7kNvwEsI_bY&_nc_oc=AdrBlg-vaw8HdGxfTrisMSGzHKNoG_-PzzXYMgT5b_uBdBsOkZ0KFAlRME0Z63ktY10&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2zJoNxKIrVyKEPiIaCsw5943MqweE5Xj3RjBEr9l3pg&oe=6A565641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p0AohDyRmoQ7kNvwHSwlVW&_nc_oc=AdoYdwVCiycVGTpw2hxQRvDVj4voikcx6e8iRxnvLdBGbGdH-mirjl0LvSYFp85Myrc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt9-_O2y8oCJPuKM0bu1P-fOFssU-Bd6JhZlARpZ6fnA&oe=6A565AA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
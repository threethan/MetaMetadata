d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTBZWOsAP0cQ7kNvwFEkcYF&_nc_oc=AdqXl0nBoJOJuFj6TxpRwVUc4m4n3wQu1GgiZH8p0XKfS1x1u6G1s8g5Z0GHGbpux40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUKeHfTlm8gvcKs8WhfUI5I1xva-4jA2e002BOLKOwKQ&oe=6AA2C78B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32Gw6pFolQEQ7kNvwHn1jFm&_nc_oc=AdqUWez29L9hsOEquj_rkaPleaLfjp-frBVU8zEbpz8L8iy_RpiHgurfL-HZ7E1VQH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA85W8c_jrCpHnhb67BwcZpTf2qjYwY72MhzPRTvYQUw&oe=6AA2ADD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvpfRjdodU8Q7kNvwFn-l_x&_nc_oc=AdoGa-WgdPyg_D0BVpG1ukngc8mExtec8xZEcjtu8UTCSBqIk45p7yacUTJ6GlQHiTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo-dR9QOalL3oiqkt_sN7lRrSANQvrVyrvMrs24LacpA&oe=6AA2A5B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMxy8BXzNJkQ7kNvwH6l1-0&_nc_oc=AdqtFXqnscCs2pQ-pDuLgn7dKrH9wySH7fBf5eOlwMEvSQha-3ZdXee4zAaqj2-vZEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXP3hlGTykwnl2yG8VKEn-UYGW4TWJ0sFYbn1-OfV52A&oe=6AA2CD41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrto4DRp5-kQ7kNvwEltLFY&_nc_oc=AdqGkGRjE9R-ZfTfsDGhfgfFfPlFW1f4TV9587Pf3vgSdOTM-5oWtS5MMmJT_3_4558&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDkmRkncAiEw0yiaLTqbg8kiWpoXN5uVArf0KqlTJ_cg&oe=6AA2D1A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
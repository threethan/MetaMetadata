a3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smXSRyWxD5wQ7kNvwEUxp4t&_nc_oc=AdpuBp5mb3pN4EDoqENbn8B-VImnl8M7VkRz-pDEWdyN5u06fI4qw43_ZuJ2ekuAZYI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lbb0RHSZxjBvtxcVtux1-g2-K08T5gIYwD3lOGMaY8w&oe=6A1C4E8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m815XCMSK20Q7kNvwGMI65-&_nc_oc=Adrai8I0q8A3toivR4-9p0jnvwCOuE55DZ3CkOc8IgTpvUEzqZiMhSUC78hcFphRwLw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EyJ2Fx7qq1uNr2k3Ry1Bq8AHi5-DrBFm_jhVv2GlH0g&oe=6A1C34D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmGYY2DlM1kQ7kNvwHF-2RW&_nc_oc=AdrpmI2dz-jwmGrc2X6P-qCFsFGlwRWxnVzprOkGMQWus-ASzLhkKIF5oeoz8_FbcNM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eZ3smcvlAu_BUwi--v7gj4E86CEP6Xl_SrUjidm_7Rw&oe=6A1C2CB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT24RTKpFbUQ7kNvwEtD4an&_nc_oc=AdqrhKgp_4XICFkiPwN1feCp2AQoDyGx0sG6Zpy43hU0dh1YzzT9kVXY5rcKSx0Nnb8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dINMMrsosQikMht6YQMClSqPdfLXzxZ-llI4SQLRw8A&oe=6A1C5441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfmtTWtugqoQ7kNvwFn7pZC&_nc_oc=AdqFMrUY5yllhPOCT2lKvCRH9gqHtd-ZJPuy05zxJW_2H9Q6DC_l_A3GOBDaHWyNvEs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wr4fUm5yOfqorKJCmlg3qNDwNeSsnhqMdcrIHiAtDuQ&oe=6A1C58A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
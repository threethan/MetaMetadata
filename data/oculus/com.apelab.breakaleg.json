d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAlZNJLMJtcQ7kNvwHgb_6Y&_nc_oc=Adra6q-oYsEeu2pEJinM3ic-4t8Y74xn6f1Ndk_YbqfWvcfxEdyF4OxxEIarFNoRCHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKY48ykw9VUCckAYjYa1Q3WUV0ufbRmZjAQCNZvdfcng&oe=6AB7DF8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JddZ0eslNgIQ7kNvwH0LF0H&_nc_oc=AdpaqxxM8NrjK8StQDVeHWjn-0GmfONWF1Fg5tME4NXY_FOMvVLEDTlWZdKHUwstgyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsvTAZvFEaK-z42_sZ5gU2dc0wK_LZ_CctWy2SxStCXQ&oe=6AB7C5D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P-bSCoFBwoQ7kNvwF0kO-X&_nc_oc=AdquRmyekVHuEgSex9GlrnltT9pCUmPHVia4OOaqKaolqqt_sSv4gjpYex0iaVOKe68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYzVcP5HkQGdmb2uGeRS0QzMGo5vR7dGwWXkCdmt1QQA&oe=6AB7BDB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ChBMbQbn_cQ7kNvwFdQal7&_nc_oc=Adrvi2Ai2veSxPFBkR9QlWD3c1ePdLqa7WwiM155Pp51vJQYb_i8L3ivkx3ZjjiyWVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSXSlHXSEJBXkjNuynl1VFSv22XR9QncQOwiKG_B8_5g&oe=6AB7E541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfcaX0Cow6kQ7kNvwHbupKw&_nc_oc=Adrfd0ljhbMP_9jdtpQLV9o58KZGqO4novGCta-svuDh0dsHKltN5js_ql6Y-2o0sVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfVg0P7OEy4J1uCE-G5jtgV_GQJuxrQvVZ10ZwROP12A&oe=6AB7E9A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
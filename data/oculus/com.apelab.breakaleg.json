l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HTe75yorrwQ7kNvwEOZ1D_&_nc_oc=AdoWj6zWiPh2udaaRF9uBWiQjCzvKib9tvIUDhDzwJHSeQr2p0RxqLE0dBq_FGWcasc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy3JgfVy7ntl29OuhUofJB8HEVjExzqUj0Xg_WoajngQ&oe=69C664CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpHfqeL7-nwQ7kNvwEXxVq_&_nc_oc=Adr8AmmxoTVRUh1VMMwEdDPPoyvUkW0Vo4haEt4G40ki7VpzTsYj7QGGMH4LjjFiL4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjiN2_6F2YBeQ4DVmuoiCwIMmfC6k8tey83NlA7DJVYQ&oe=69C68355"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqTAHvzd_HQQ7kNvwEPaRCn&_nc_oc=AdpriLzTAvdI5MGMn3Obr7K6hZRmxfbKy3gQ20itHMphw03UhPLGr4VmYkM4ztvrtcI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ1I4SBatFL9eQS_2vKBHBL3aK4PpOOfLC9aVk0kLP4A&oe=69C67B34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzoGHYmVvwUQ7kNvwH4Q5p-&_nc_oc=AdovoonEXkPELjZ0RoS6kzyBg6ISqXcktoxVXIOPVCPeC2Xan0JX-6IYojqxT8flalM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afza9KEi2QMLrvR1b3TzNYr5sdaJf8FTpyZC3af_UnQHGg&oe=69C66A81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsvCpKlp6WwQ7kNvwGyQl4Y&_nc_oc=AdpPdl_gkphu13S2ysJwcABtxTXAFU05hAP5qzZqkhdrcgrh6jwO__Lo0uIPT0Qgaxs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQhwUyZz3GJlrbUVkbEvZv7XtwAaNJcHJlWt55nmlYNw&oe=69C66EE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvO7uckilO8Q7kNvwGO6Apg&_nc_oc=AdmXxsqY2lSF2dcFHAjbBLNdYGJY1eGP8DxXd27KVuqQ9eYTHMTSJojooTbBbjZlRTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbNHZiK3e-vR8FuK7RbmYX_dxqTSrXb5PKoj72KKk8rg&oe=69B29E4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u41DxuEe74Q7kNvwE2i1w7&_nc_oc=Adna7_c-G1iqEfmzIjZzUGX6pRrGGhWjCdLs4DvMdju5n6NjAy_wOAJNXjn47axEgxo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4KoajzHkQndKh0blwRRguC7bzLp_UK8zZ9lfwkOnt4Q&oe=69B2BCD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoq8LgCRc6UQ7kNvwFmx-4Y&_nc_oc=Adnqj5SQ7_niARZVwqlZ0KOegyRzPa4J3tR5fdeN0ZPzxv-RE53ai1xTxdalPQCJCjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVpNEOrJ7NKRWl94Swbc3Ei93KeGA0rJo_apkvAB-IYQ&oe=69B2B4B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhWn1DNbFXUQ7kNvwGS2f6y&_nc_oc=AdlVgcNB6-fIrS4LHwM8BJVqrVzRTa1BPQJ86g2bMP2vw7s9F5gb5NpMKJIFiRWbUWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzgj-2HAQa3fBTK6uyIIzBnPZGXGNXsYqPpXtxCX6wsgw&oe=69B2A401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLtzMRBsYiAQ7kNvwGgLGSw&_nc_oc=AdmE6aob93pCqsl7LkuE8UqjLRWKxPHYluy6IWL3WutHZE0epmGBe1zOH7GgIcdNJ0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrOQjBatkYHIedYjBLq7h_8VzaEsAuQDobhcx6NsmHBA&oe=69B2A863"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
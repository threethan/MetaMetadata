c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqNFf6zdS5kQ7kNvwEFliRR&_nc_oc=AdpVG4rgtr1G9GJcvKdelLfpks5EIafXo2TJiOoFtfeJjCTcaD-MJ_U3t7gVt5Bbt2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d9Ik416GpZFLoEPEVKw4kjGrFEZI-EevUGOzl_kTpaA&oe=6A282C0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMD5xePWik4Q7kNvwFCjQ6d&_nc_oc=Adoo0RykoSo3v0TnToDSxrmrYEK5gzVOXzZmFS6ilOJgcT1Nf7ViP_2HppUJ0aXW6KU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TYDa0VXFc0_LEJUVxo80mAUkG6EuZkXB4djgNQKrhkw&oe=6A281255"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=127bAb41J_AQ7kNvwHq61Yf&_nc_oc=Adp_YKIWGzsjYHyHQG7pq8OhEraroab0jUNeEcVSyCWQA4bTfqF94iCccwwQMHNj91M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91CR4A33ZM5qgilVFzzDXS1-y32LXuYYIpVNkgL-u-9A&oe=6A280A34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izbogDmvIboQ7kNvwHhaRdT&_nc_oc=Adr_5Uu9fpOD1uV3_x0KFZHMK4x4G2PawFkD853rgE3SOSEl89sfUJaR26pt2ouXbtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MotgdNdD-OV67oTaJpwmdrF4ws3I1kXmxnfM0cu8Xog&oe=6A2831C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyaPrFd-eqgQ7kNvwH_lNDv&_nc_oc=AdqoW85EpbtgnJeakkHzCGFW_3xlNDm7dxN7Ncnr68IPODPrzkfdl9woune6fCScDaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vXsutcEXlmQw7mRMuIzIZBFgV5HOpMRkezBwGZeyWcw&oe=6A283623"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
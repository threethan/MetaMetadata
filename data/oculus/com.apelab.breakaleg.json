d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFuc-Padtq0Q7kNvwGhghn4&_nc_oc=Adqi3UYq8z9m6NyNtac07NgH07FTqeD7LCW09SmUTW_yFAJaM7KY4sAoAe8bmyx91Hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GKPnRrEvNUc_J8PUU64pEd2bC_HikABbUyAeU8eal1A&oe=69DB7CCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8RpB-0dvJ8Q7kNvwEcGZsW&_nc_oc=Adr9paHf6RY1P6JzHKr4a7vOcNoxJW3P0Pv0quzLDkq_KWMqPaBKN4_SOD12e9yPvL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HHRV3akMWCO9WnRsMC5gh5Lry4dUXWIlV-Wsgx4_-rA&oe=69DB9B55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFcq7oPw1FwQ7kNvwFIiCAP&_nc_oc=AdrjAbxYZgu92LWuoMzSqtZ_GXqoMfrVRDnKbJAvuQdDMmPefdNcezuQlwjBxiZ5SUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OmPVfPEdHNZxDCCqos3BhpWiStwmtdpbRO-CAtMB4Cg&oe=69DB9334"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJLaoX7KVcgQ7kNvwG-O_Rb&_nc_oc=AdrKXcdgtXBfNcEn_7-Q696vg9X60uXYzTieKQYzjfumwbhliFNEXGSkfW0PVC0x-Lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v7bPbMVoupn8VnYGAuebcgy_j-VkbiPPIB9rbTenLcw&oe=69DB8281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmcmcnmtp8UQ7kNvwF-lj05&_nc_oc=AdrBX92YO3oyeYN9MnzsmPxF86kLnWOFy_6xj_Jo3LX5BJ6vtUlzXpefNiTffbmaXBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TNKvyMUuTey4GWGyX08Ro4O4VEWAQe19vFJX15WlhUA&oe=69DB86E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
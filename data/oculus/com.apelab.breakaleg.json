a5-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAlZNJLMJtcQ7kNvwENw6pd&_nc_oc=Adq2e8i09xoFA8Kt5KqBr6nxNS77ux6gNqB8GgGxmgW0Fuc_vO_JJ1fwU6HixliDFHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqZkQR-6IK2Xb0tArZIcDLJKBFHw6BzvMA26XJczBORQ&oe=6AB68E0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLFRKF1OAHkQ7kNvwFijE7k&_nc_oc=AdqNudw8inXQrWEfDty3naK-rV5-Wou8ezbnDNqASi-QMQ8EBz36ELuN2CFpX0rQGTk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlZGnYxkC91ausLlprOXlfVuYaDfqhYU4LKPgREMWArQ&oe=6AB67455"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P-bSCoFBwoQ7kNvwG7py1m&_nc_oc=AdoJLGKfW0v1JaYW-YhzaYPfTlB-KGIXyV1RH86kfRgxFZEIzsioGeyn_SYckDY7KV4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj2WiO-ijRiw2ZJwb4kxJkGVa7sj5-eCsn_oHDkU-G2g&oe=6AB66C34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ChBMbQbn_cQ7kNvwF6Ssb6&_nc_oc=AdpUxWZlVuvR0NnimrJm_4Qd33i5dXKE6Q3KdGCJSm2rXO8Qv_qeais5xtuedFkAZgg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYuRwnSh08wlHlAXBqPLIfC2icvVwU8NR-dfvjp-Db5Q&oe=6AB693C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfcaX0Cow6kQ7kNvwHvvcRr&_nc_oc=AdouvYM8_eylDH1LwcfImao88WbgY4OjLLhdPwIYCqss98ZXv7ukl2KSbwNhXlJjNpA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0zSkSA2EqDk3RDCSlX8wKhpAoMtdJKNrbH7rlQGnShg&oe=6AB69823"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7lhTlOWFKsQ7kNvwE_w_yc&_nc_oc=Adq8gk0uzreA5lQCZHYyItVfiNtVRVMN_vKIfZ_8_RvbkeK6B7sPU2xWqFGO7D1ISiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkmbo43bcO-yUjFTIly3aFgJEQBU-4FboX4Eby4iia8w&oe=6A525C0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsdaKHTm5pIQ7kNvwEI4FU7&_nc_oc=Adp2I6ToaBecTFcgI5oQDLwpr4Bv_qiEe4XYKdmWaPGM95RDwSMR0EzhRN-uuRC8KzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbLi03aBD6gOvKi4uy8euSHHhWkWV1PnUf0dd1gZcg8Q&oe=6A524255"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO1T5n2cYrUQ7kNvwFg1iiM&_nc_oc=AdogoSYWzA77wkuH8Q8HCzcNDap5ZaAurnszU0kVLXBW4TiG-_lxQF6veEpMWU8A000&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBL69nBPjTBTkgdH-NopumG5od1TT-VNM_vPYCm4sj9w&oe=6A523A34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOE9t9veoU8Q7kNvwGtI10f&_nc_oc=AdrnATKyQrtJfJIhz7hPIVxaFlkRZAFg4f7oQ537FnFP3Fe6bGBRZfYH50P1a4Gu8sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhgHvaK61lKxeI8LQ_IA2FRlkrqB3Q13_hzuj3WcwJjA&oe=6A5261C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iTwDJRUXgMQ7kNvwG6zmIK&_nc_oc=AdryV4dK3-4TdFnY42jg1v5hUSESh6Rhzd1QatY8YUabpDSx74mIVnWMZpUhCqG5HTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0JPclGbpZHo6_HhTSI2QpkhQe-n3vIvbPr9WvrU04-w&oe=6A526623"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
X2TX9&_nc_oc=Adnm-XGVSVOlMMe31ydLWtITnrO6tHQy4ixHAWH_pd08cpDZgCty86s8jOI38331aVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtCgRA17M17aeVtIgy_0dZevMfoWhU9GPfKc91u4qKcA&oe=69B55FD5"}, {"file_name": "migrated_image.png", "id": "508436326728391", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8a9iXvJHbcQ7kNvwHjQcP2&_nc_oc=AdkywM3HXcYQzalwH5cihpuSd-khT99xV9JYh9nNvmsg9a2UUYGPId8cvr2ZBTTETuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfysX8YmCvNdkS_G13SEjtS1-hqJybFO60uFK2E5LChX6w&oe=69B557B4"}, {"file_name": "migrated_image.png", "id": "196592148452346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tveu4FUcGYQ7kNvwG68uXI&_nc_oc=AdnuIDbmC8CZvBp4fpCegWATBIEJfgqr_Sl63r1ROnV1842rHuKALMnnS9ufOPZGJWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXBUCOT5d6mgR2rkQTbRTiLsaLuYHrg6x1OfBc6-5LLQ&oe=69B5414B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "129032964466611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162708_129032967799944_8089233936061825024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHf1DJEeIMAQ7kNvwGNlT7m&_nc_oc=Adkh7uLzr3KEB0thp1tk0VmI4gHpNZ-47cQ2-2cpzSugrlOe5lQrz4Gq6k6cNfi-0hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzb5oDf3Zff68iFbeBbECSn-Bo-vmx3aukZJ9QyObCApw&oe=69B56CDC"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "You have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin! But be careful, they do not like failure....", "short_description": "--- FULL VERSION RELEASED ---\n5 chapters, +1.5 hour playtime!\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466098328345905"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": 
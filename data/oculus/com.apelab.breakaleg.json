d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47_7QwZ3EZMQ7kNvwEf7SXO&_nc_oc=AdqI5K30Sy2BNIyIKV8qegu0wo_EZ5tPJCZ8qoyNylyMTqllx6v7zfRfIWVIazKLGFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50vHwQiKG_jRKz5mT5ju8tABpV8s5z4MjsEV0MHDvLtg&oe=6A07368B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLdBLj_yOJoQ7kNvwGnUalC&_nc_oc=AdoOatoFhCqKsuuJvoexPVTRfHWVg2BxKdIXSe_FegAqssU4NQ0FOudKY38SJaD3nWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OqQ7gPRGM64qj6pwgHW2rj2yzUQbGVWpJ2YG5lsJ91g&oe=6A071CD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsgApFDfSlMQ7kNvwEcP45b&_nc_oc=AdqOsblfWsl8vQobrZkq02SFBRWLbYDwK9FhHZeLxSI9ggfK87ATToaQpPPXP9vnktw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M8tvM09ANG1mbeq1GNUzcb8QGZZD6xJc2XSfaDR8RCA&oe=6A0714B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zxw_gvyDBAQ7kNvwGsw-zl&_nc_oc=Adqu86AyUtnUeNYSZ-RYA6nwWtE5mffkUBlirgJcWJUUll8aUrJsCgOlQwEZhn0wd-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MB1W8vaPSDV6aIgj86dgFVbqBVVq1TxJ3QXcQ18QOJw&oe=6A073C41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GDqD77TthEQ7kNvwEvIEEM&_nc_oc=Adq1Ncs31UvUmv5ZCIRZxArb-Hz_aVYGhW6scO5pOmDYgZFck8aDtkdDxX2-YYzbC7w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kLObRMG7Yy4_kzQt3c3xAAgYIq8qjDkhn9w9RnK-gyg&oe=6A0740A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
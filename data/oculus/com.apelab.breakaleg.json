d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvvvr5d4g2AQ7kNvwGqERgD&_nc_oc=Adp7ds0_XBX-tucW4WQ_0c9YaSECs5BUfyGMGQNbha0x0NMY5IDbsl9odK0gKm-DD_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VkpUGGEUmaBFitlaJMm8SwlKGU230Rhv0B4FqnwCYmg&oe=69D636CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RnbNrJTdi4Q7kNvwFy2DfR&_nc_oc=Adr88NjlQEiriGpg1bDa0_B-7QaKzc28vv-E2Hde75SHxzToguL8GXN_iC7X_KNBWj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2izR9vvgrcF3qh8wpWAYyKo_ClCBgX2Sw88oES-g9qUQ&oe=69D65555"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q-9kFCrMmIQ7kNvwF0gVB1&_nc_oc=AdrQeNN8lmge3WhPzgHYzoeXjFfi3UqsBgij1ZH95bXKJDbJFI3rByPrJ_i2BA_yyGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2czM39B6DL4CUjkfYBRRBVYBLfMVwFkIunuVJ_D6P3aA&oe=69D64D34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEKdCK56Gt8Q7kNvwHCmu_S&_nc_oc=AdqxrbbSZ0AOYz1Es5YHp1QGwF7PMq7qNCfNl0Cz7RxyCiVUDuJ5othp5i0E_mteJQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VYL2fDQZX6DWVEq9k1wtYymQFLRJmF2Pz5n-j4onhIA&oe=69D63C81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxgM2ac8Kk0Q7kNvwGzNPlm&_nc_oc=AdpbZur0gbxh5aYFkpW78BG1MhB6eV2k_WiHBRisBCS2iCgI7uX4beWyNLeCtLGeIz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Sdr6MtJO3_dupllN7cYLsq-Tn3yKPbLwFkZwvrAGgDg&oe=69D640E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlIwhiYqO70Q7kNvwHH_3CY&_nc_oc=AdotwZVx_Q6LLb9khdW8yMxN5n-21ghvQ1q0PpMJttNjYln_VAP8X8-3TxA12yVKRtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2_1MJ4RhwHqOIQEqGW1OlKCAJK31NFE5MJ_c4gI6njQ&oe=6ACE490B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P4iZFDK_o4Q7kNvwG8Uqzw&_nc_oc=AdobbPxv5yrUFFx-kpG6y9Dtl7SLkHHQ4zs6mUEtAOJp5fzS6sWBfx4uEiejKGmT7uY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN83z9Fcbs0ryNyYukO2KG1Mp8iYssp6qCt2BsBdBjyOw&oe=6ACE6795"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXLlkznB01oQ7kNvwEDwnUo&_nc_oc=Adr0zm2P7JDeYxlQz6xWv2T8P68ySG8-RV3280zbw3skLKMG4resRWSpM4DXm1jjfZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmHIvEcSLEYDc_6McIFUQ6Yi0nkCC3udeLObFlcjePLA&oe=6ACE5F74"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeZDrUi5SDwQ7kNvwEPQLkq&_nc_oc=AdoBsR8J72Y_y0ZiZ1nVv4NqLvHehvNAgipgf1AtmnZ7WwCCP-aqBIPzVk25uLgGyPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNacTknfYUCcSajWlNgTrbrPCvxyUmfjwNeFKvfs9adTA&oe=6ACE4EC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqNhF58VYqgQ7kNvwEO-Fx_&_nc_oc=AdrJD83MwfZclTSO1vHVF7GajEpOpmgUHEBO7UQtpDA4MEJLM1lDXGT9So-j1GUt03A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgNhz0Gy7TKz6IGgNjllpzhTeVYaT3j-HjtRG1QJmzgQ&oe=6ACE5323"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
t-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_129032967799944_8089233936061825024_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3P5Cw9qy3wQ7kNvwFY95aX&_nc_oc=Adp9Mnc6629xSSAeX6fyFhpW4DmeCP3SgBzjzukRbxjvBYTPlDfN7beqv_8mA-mxSeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIsjgomuAjGYWu6I5o5sV2MWJF6oZkohHocwzvhA8efw&oe=6B07251C"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "You have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin! But be careful, they do not like failure....", "short_description": "--- FULL VERSION RELEASED ---\n5 chapters, +1.5 hour playtime!\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466098328345905"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "280372589410782"}, {"status": "PUBLISHED", "id": "2332927053410945"}, {"status": "PUBLISHED", "id": "342828209774406"}, {"status": "PUBLISHED", "id": "127309264636771"}, {"status": "PUBLISHED", "id": "157951264926523"}, {"status": "PUBLISHED", "id": "518949291794252"}, {"status": "PUBLISHED", "id": "305308436836719"}, {"status": "PUBLISHED", "id": "293770494894376"}, {"status": "PUBLISHED", "id": "732003623668128"}, {"status": "PUBLISHED", "id": "232295354195492"}, {"status": "PUBLISHED", "id": "396790724528517"}, {"status": "PUBLISHED", "id": "1498666280246731"}, {"status": "PUBLISHED", "id": "1245431218923566"}, {"status": "PUBLISHED", "id": "378238623011313"}, {"status": "PUBLISHED", "id": "319435281978749"}]}, "baseline_offer": {"id": "342828209774406"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1535007600, "status": "PUBLISHED", "id": "280372589410782"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1290987367673086", "version": "1.0.28"}, "id": "356240901495574", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typ
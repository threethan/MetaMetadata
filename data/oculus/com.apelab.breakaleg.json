w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HTe75yorrwQ7kNvwGiRvCF&_nc_oc=AdqNcIH-2TssIi90qGi97uxBSg8iwbOMdTsvIYMrCx1GTmuBSFpoo1DT6cFD_zvwavY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxACnI2StjTodtaBDCFFKcRGxo4SJ80kq3qaPuKWaauQA&oe=69C5134B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr78PSffQ6YQ7kNvwF43Jzj&_nc_oc=Adojg0QhAiJoLpdsfwbY1pGhWJIzkfIhls7XDMMUMWB4vDU22WOLP_aCjab0CnMRp5w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZlU3fTMRgavA-aYlMX0L1CwH52foeAkgSepmABWzPeg&oe=69C531D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqTAHvzd_HQQ7kNvwEV9WFp&_nc_oc=AdqPsnhJH6A-QFvBESpxCWnEP9WxbzgOF4_Lq7rgjwe37YUWVIhm6WV2d4SrTNe8wdQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxjw7MRvCBOFtYLHuGZSvu8U9lLFTgUitiHS5GWnmP7QA&oe=69C529B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzoGHYmVvwUQ7kNvwHrSj3W&_nc_oc=AdoO-5J4RQPTEwdcXADgcbPKHI7axODX8XrAVZF_TscFHYFO47n3BmUbW789HnDyyUE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTb3wG-dnhyiLlU-6RxDS-VnzE7_2IdcP_uVY_8Lczhw&oe=69C51901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsvCpKlp6WwQ7kNvwHRkwF4&_nc_oc=Adp7RNLH_BraSZV9XFYaCPFo8c6xJk_JA_injJv69jpJMB1mKUfUDTg2nd_d78fOAok&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi_X4fDFciIcV_kBBgZVqX-uHyFc8ZZC9CCWh86Wu1vw&oe=69C51D63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
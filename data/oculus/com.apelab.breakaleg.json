d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbaTAS6T8ycQ7kNvwFmCYVB&_nc_oc=AdpTIX5_a1RCcYAn9i9LIm3ugBjZWg3dfyt090wyjykJnvNi64PMcSA443FeRFRo3Fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pBjHYTUWZb8cN6f_FjqIW3nkFPNDW26ezHz1BYxBNMw&oe=69E4B74B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc_dsEurYawQ7kNvwE2li3G&_nc_oc=Adry1MhpF3C0BbWPtzdvBYRijRhlDUEYmOROwxoJ901TDGdRAmdcL1Txs2xkTA5Kots&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P4SYmpGrJ5_fInj2dn01ow9lJpZP_5AzrPkCI8732Uw&oe=69E4D5D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWLVOpeCM9sQ7kNvwEp1-cF&_nc_oc=Adq5Som1QAu-_HBAEeekiDyOXIWyANryf4YhfL3QA2YbFKUIg41JLxKhF0e3rEdCVbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VFsqEmBOL601pi3_CDsroT5Hs1Oa44Vc5pUABg-hJgg&oe=69E4CDB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jtp2F7mek1AQ7kNvwEhiTKV&_nc_oc=AdrKpv6gLAGEm_YjMEWKkkxHL_J4tKFDBRnFcDVHIq_yrRCKkTYtHd125zoIGr5jtIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24tcRT5cEBkNwUjPGi0QyS5b3thlrDaBSVdwN6yg1veg&oe=69E4BD01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GrfG0kBEuAQ7kNvwFs4xQ5&_nc_oc=AdrbfsEreS6Pd50cHiJQ4upZycbQJoETU2JXuhljLPaufg_h3J-N2j4bzP7l7B1nX4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02mYsypmlMxIWVqHbhi2G40R_pvjlUA-b81Geo17PDsw&oe=69E4C163"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-PEOxyHq98Q7kNvwEpXcm0&_nc_oc=AdowmMuTYcs-eeqKmkvCiObwm4y1nBLNkAmVxfbSq32qZY9tvJrz46phQjU0Mt2mrfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtmqtFjc6EK4uExUTM-W8HM1w8ilSvWntGmPD2410Mtw&oe=6A8982CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7uGVE8IY4YQ7kNvwEkcXuG&_nc_oc=Adrr6LhUmJWMkGRkF9bNbC1N308aoKqWj_Nn4kZt2jbRBUwkciqtTo1LxI0pZkotBTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGStUcFtU6jx8gRXTIV0_2fP1Lk_L6G1u5z0lp_ZSenrg&oe=6A89A155"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AXTGQDmPi4Q7kNvwG5vO6Y&_nc_oc=AdqOooQoJfdUUNlq1KyVcWI5wJkoIj6HNKljaijyanEInV4KQenrz2ykXJUjxRZzQLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLWfyGiqehaPjdQzKm86klyUMQldXIXCjItynKaE39aw&oe=6A899934"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u9vLpDlMsgQ7kNvwFrDljr&_nc_oc=AdptBxy2yiE3-MqzZElpdu2rZZQRvR_drBfttytnc4g4fQrtn9l5SxZ4IVQssyXZlJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlwy9WdYIzH5woFZowRg67LQU-IUgQUOJKbYdnnlrj5Q&oe=6A898881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ7gQdD--5sQ7kNvwHT258f&_nc_oc=AdqzvE8WUOrYyL7eVen4ecIkeCxecKiTqh4e0QX5k4WGTnJ63Sg0u_WVLC6SVhLPrq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEequNBMaAq_5YjKl_EdfmKt4cGWiAH6a27rno9wbobCQ&oe=6A898CE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
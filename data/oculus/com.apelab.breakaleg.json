a5-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUUqnC9Vnm8Q7kNvwGC81Bj&_nc_oc=AdoUoR_UziqXHVjDn0i0FSAkPGW86nipw5UBD02Op58ezYmP0DgMu_pzG-SJDM3UtTg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JcrhDcJdmNdJCFHFqNwkzbSJ6IhPtgFZXU9dSqOO5lw&oe=6A15B70B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fjdWbQwHSkQ7kNvwF6iZRH&_nc_oc=AdoVh5nVGnPPE3sXyGkFd9QqUmCO5Bp-MI4kWpIt-oRlCTFozLD_f6cV77r6Uqqe1UU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bT4lOyFvo4yAwRJFamcL4tFei-56g9iT0hg6WlBcdaA&oe=6A159D55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YdZQetBZf0Q7kNvwGOEcy7&_nc_oc=AdpCYUMQ5xUtfTXNQuqFWrLQcNVztDVHVo5CB4NFUNG3-Q0CpFyGUbKiqYixV6xmeIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4efkuYRoq0nmdPSETQYR5OXd6oGxfH0l3HWCkFSAUVRw&oe=6A159534"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxyeWaD4iVMQ7kNvwGaq8pe&_nc_oc=AdooIV_5WMisjgF8HeYv0eMWQrW8hteamZxK7aUTPnd8spj4M_rsfQYnxSnPV_m1K1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51QCfQoqBBmzSsDI6ysk6D3CSZ4IFYklpMyG8d08s0yg&oe=6A15BCC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrD-GB5XZqwQ7kNvwFigCD5&_nc_oc=AdrMiq2Txpf30pRYGZ3Q4EXx23iR5GJ4m1174Duov4UrgbhWDw8rOzRa7nlGJAYLDEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HxILBFQgUieC79RB4X9gLAvM7u9IIxosQq43-B5Z-cw&oe=6A15C123"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
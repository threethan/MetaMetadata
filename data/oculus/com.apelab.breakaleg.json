c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpTKVStk4a4Q7kNvwGNHBg_&_nc_oc=AdoHSyngv6ednB8uKyDhI4NlMx4DRlHb-tMVT71QBD8ZPLC08Sfobs3aqv9447BwgiM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VnZ-TMikGSScgkMeIniXM5SDt2jhKrwo1pDZObZoAZg&oe=6A355B0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m08yiM9_kNoQ7kNvwH5HEko&_nc_oc=Adr2kh4G8zfS_XQbhzpDcaUXhA31ybyabGnFVXzQKAbdcN8UriEHMYwWJ-8S0B9zpdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5RqvHy5bKOzUceZHnfAgw-gO6IXz3_LgeYKYbM_PiNQ&oe=6A354155"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPAaVMDCCREQ7kNvwEvHQ27&_nc_oc=AdrwkvsIvxyh9ZqKX7lChNIYDEmKhMVHZ8Wgi5Ytd3ivny9O_S1Cv039xGzKrgRKFg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZmSppBppF7vzxegJ1vaMCVMs3FbVvbXhweweRj7qs6g&oe=6A357174"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUUpdJP-WJAQ7kNvwHbRgDq&_nc_oc=Adq9iv-brDqxKcf5d4Qvo1K9gX7qg-dp87SQHNCSahWQ-VpBa5JvBL8D2d4R_rvhp5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JlKogDfFRbhkfHkqlAnN9SagXINxBnzsPowwhVcqRRA&oe=6A3560C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgZC0Zz7aiYQ7kNvwE3EX5v&_nc_oc=AdrouVC2yas1Tb5rtGc7TRx6JwEmPiZSiO71alPXrN4_6wnyzWmFQLV_ZAz9hYeOFyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4nrJlwZF36L8s6J8hdgF0C8XzecY7Vc8qxFA300yATg&oe=6A356523"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
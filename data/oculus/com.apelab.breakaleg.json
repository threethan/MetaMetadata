/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5BNyTVsD8YQ7kNvwHa9ap4&_nc_oc=AdnjSO9YfYzR2hZuT-rFOycbkcYBKsExkeGMdzCwr6FhIp1a4uEZomKq3BTSCFuwEgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyh-eiVXBTxfsF0DSgWfMd5OqpYUtZMRRaseW0T6IOfWg&oe=69AC06CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzkTJoLKJOUQ7kNvwG4M9dZ&_nc_oc=AdkSnfkP0BQzwpP_gFSJvIKq70x4peUB6UXpsNLEupUPuXGw1I8LlaOVyTyHYhTl84A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxSpVdZ89Yse_QIcIHsI0hTSafmmScY-lhhSehejGFlvA&oe=69AC2555"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAC-EZ2J7dwQ7kNvwGEYulx&_nc_oc=AdneKIuHxqzosmg7QzqLCbvshw3J82sSTbm0-o3Ipo0HKJennRVMfMik01U8tkYoFkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2BOS9UY4rHxtVz7Pud14GSN14bOXIMsB1wGBM7BnUGg&oe=69AC1D34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9-Vzw7ltnQQ7kNvwEC4Wur&_nc_oc=Adl_kz0OBtKKd6_jR38mvJrQlEkBdjVyk-eSSufyxTCLqAqo9YMQ9m_6TpEinfkQ-Eg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsimsJQVAT2ZAUM6LXrmgXgWUWC1isN_Gv7DFZOVcj6Q&oe=69AC0C81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf41GFxNiDsQ7kNvwE2_gYV&_nc_oc=AdlIxsbKA8mVK27uV7sM0qi51BqaQh9fBf2oKBWFlWP6ds7HCco1Y2uWyfoum1ClEQs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPOptQHmmFM2YbvdcvA1TCxUG9nmhWZxZ2oWKvRKzmaQ&oe=69AC10E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
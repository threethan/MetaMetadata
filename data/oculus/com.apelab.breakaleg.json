g1-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXXPI8exl1sQ7kNvwGHqkis&_nc_oc=AdqO72ZL-IM3pwVuBfJqaL2TwQ9opRGp3rKys0zl1HodpfMS61eehgPw0spacBCEmK8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcT0YQs-drO5un4Om3FnmQQCZVsbPy_EUSkqmCIYu7Nw&oe=6A916BCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPCrc64pZ_UQ7kNvwGMElJo&_nc_oc=AdpP5LjTYX0qoBgMnOUZJBnsTwVHXoUHCnyvdbrEs4Vn0VmIy9X0056KBRi6l0-GWBs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM44MCY82gPCSGV5ItcIZa8hcDLzrIVcB0PRGV8y1Mew&oe=6A918A55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdqHTSl9WcsQ7kNvwEBswZ4&_nc_oc=Adpw-V0F4TtER9CrYSPpxp4duQngLgdBP0VyC_CPiGtpIWcBKWR2kF31L2eivY-ec-k&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF71aDhpnqKLLtCMZaLt-872JAoye0xoH_TZOqmaIr5mQ&oe=6A918234"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVPYCt6Ah3EQ7kNvwGGplr8&_nc_oc=AdqFChHkb5OwTzfACzu_DpA3aBgIVQnmmr10Jp3iwxKQs0RJFcOcXFkmobAsVuhhc20&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJoqjk2RVmRL7R1BTXm4ow-P8d8jqWV1kmqz-xNlMSgw&oe=6A917181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zknx82CXvroQ7kNvwH93cCZ&_nc_oc=AdrZEBnaoQXByD6dVqpamrQRzbo_vfnLiW5bj8hSy94DGtJVuEaDg13W-MJq2TPhNB4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjtbXtHUvvL0_BF3Yc7aOCwSwcu_4AsEzi3FLfdQtrJA&oe=6A9175E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35kWNjn0OkMQ7kNvwFdnexI&_nc_oc=Adqt_gq_CY0eu9rvYh9gMOV3jnT3p0DsjJvnpX30AI1QeR7ZPGq9zFAFHZQLl1ZAt5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j8Mn05IfRiWuQzs_utM0VGJ8zDLS31-VJkhIiUr_Raw&oe=69E8ABCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JAIoYJU_CgQ7kNvwFshTY0&_nc_oc=AdqdO97OOur0W6XP7l9Nj1v6isf5Y13TSLI2yNEnot_l4jy2w3_bQC8G7SqfqcUA5bI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09c21x9JXUD-Ekx3WsYBoXt1k42X0OkJBkoOrwW2vmdg&oe=69E8CA55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZgWJN1vIjkQ7kNvwHVEGn4&_nc_oc=AdqUGqwKTSejdz0LYbu6Oep5zVl_DS0LwDri0Oz6b5CwRzf0K0JuOZ8hdGZZk1mgd5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x8vGitt3yx2AttCbYHevcmZRYaTBXqaZZoUzJVipF4g&oe=69E8C234"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZVdoQaacHAQ7kNvwGW7hNy&_nc_oc=AdrYd466Y-p0l5c4pfpNDEJt7QrUOUDEfsuHxolQd90nlNHPDKrzOM1Wfn5Tczpt7U8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mAYx7Ps0W7pHLu38XHI1Q6TbxD3gSlFz-_b-hZNVXlg&oe=69E8B181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x07CAUbCFAMQ7kNvwHs8oGY&_nc_oc=Adr-sqJZDROFUNe_rw1AtalONBeHFYcizMJZlen0UJhOTify1IxGC1pJs_z2DaNn_x4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KAKcdTO8AR87_nFbDDpQDcwacAbxtUisURrY-vJg0Gg&oe=69E8B5E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0YoOYZ7PH8Q7kNvwHGUXM5&_nc_oc=AdkH_XUvjpznwKyJhxK3NwSMl8C7hS4DrYONgbOheZQwU2NJ4FxCcrWFuzZN4EbjlsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx87kwi0Y92oZHkeLpfYqSjmjCl9EV6DWU41nBoOYGxmA&oe=69BFCD4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWebBKBq1ZsQ7kNvwEDYN9L&_nc_oc=AdkDd0mURFjlabnEwhm6RsLJKWxvEMRbaAyQ4sbaSUbZqouShH4pv-M8OhNtRLU3IIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7Mxcg1H_OG6WjIptKijgBMCF7DvKrh7AfLMuHOdoPFA&oe=69BFEBD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VftSu4rdrakQ7kNvwGuyotF&_nc_oc=AdmnPYUeXc4ev76Sn6weEo0cKGRyao0B_ag8GrGM7nPUdV1SGJsp0WO2wCtJ3dh1XIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzwOwbohpy5YPaGwfKl82CfrezMaf-jY3aPwZQIR-KSwg&oe=69BFE3B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHcbmrYtLCcQ7kNvwF6LIYQ&_nc_oc=Adnvi6XM9fnSAMQS3mqz3vOSF0vdM1mjUQ4yH6Yz0ES64LQ4_FNnB2VfPgRHFTIQwYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_gOJAlq7avaqxdZBPCVJ6-ELLbxGyOyxQP_Q5HJiHvA&oe=69BFD301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nQRW0dxdiYQ7kNvwFhK8Uv&_nc_oc=AdlCQ7GWsz3fFUVmzxONDjw18gtOaUCcgFZMQ3igEKfajH6KXvo6BewCTQOZH4o-kg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwggnKx5jWh65AH2gmSXZ1DH5dOcax8BH7Vo6pHl_KlMA&oe=69BFD763"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
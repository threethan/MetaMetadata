d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14O5XZghza4Q7kNvwE26iQ6&_nc_oc=Adqgozo49kU6D_Sak7dLsEXkilsVF-eAmPM6kWDoaHNL3ocmnB4_YDeprSmn10Qc-p8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fKRWPxo-VYwNJZU_ozlbkYqUVl1RR4M3kJZN73d-54A&oe=69EDF1CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38K4bOTcrJ4Q7kNvwEGjYD8&_nc_oc=Adrn3d4toufLHLwrIJq63jyuS3ww16IChFosm9DwRpz5KI-5GGGSIfuZE-H7vQjxEps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oAHMJUuBTXqb-j_27LFG4ZTZ__3OseBSoDdYMkf5N6g&oe=69EE1055"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVrNVYv81-MQ7kNvwHo0U-h&_nc_oc=Adqh63HuqkW93ySn1zOKksOXFbex1vAeVRHEd1WmLmhTyAq-Z_hjKml8LgApsaFxjzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09VeyiZBsWbGGoyg9yTfPGimKqK1bWnqbIJWwyb7RLkw&oe=69EE0834"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7w61Nrm3lQQ7kNvwFH_sWT&_nc_oc=AdqV2kF2oc4VMYR4Em2FbcNNycjuC7eQpMuTVyL_fh0NGizsnrY6N9nPjC5KoB2ud3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YAKSbGk_0epWKlDqpRBBeyQw6_VaTVNhUecrGYeASSA&oe=69EDF781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4Nu1WDi928Q7kNvwEl80-l&_nc_oc=AdqTpfp5SIJHG6N3Hjrv176JDYq6f5fShBSR1YD930zV21ZmH-0m3twXQI3Xzc9QMac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sa-vBCu0kPxzkCrcW7tDZUoSXmWnlYgMeu8rO4H07eg&oe=69EDFBE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
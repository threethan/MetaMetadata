d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvvvr5d4g2AQ7kNvwElCI05&_nc_oc=AdqIimaQsswdff3IaiF3_dSeIPYemEeq_tjy7tu-Zh3dhlD5hgx-NjQEKVi0fWCqhVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af042yZRIDhTmBaWlXkojS4BcMGPfwcZVX09ZKWZQlVxTw&oe=69D4E54B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw0xZK0g7TYQ7kNvwFzBZgs&_nc_oc=Adq93GZNGdjQAUFw2PsFbnGEAH52s6ulrfReeJnqExWuedi-bJsRn_K6vsV1X2yeP0k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fjLRt260iLUIb95A2ZvNtQfye82ZWWoXtgOA_ztuGBQ&oe=69D503D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q-9kFCrMmIQ7kNvwHEOSjV&_nc_oc=AdrQvIvGVbCoxnZgupqQ3diT1aE2D2zvH4ZNzd8cGUhcEM7D48dc1OWa9a2rtpSoGXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F7e15HNzA7ZaZ34oJVE63x6NMM_jnzQCp6rtGYfd2zg&oe=69D4FBB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEKdCK56Gt8Q7kNvwEweZ10&_nc_oc=AdomCbR85a84Ed2Zd-yAikBTNexQRq962FmT9J4lhfErH6qA9MP3WztLQnPs8hpuC6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d0LVkveV2NsFD2Z4aF1dblL0iZCwf4gWMD_nr5P2LTw&oe=69D4EB01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxgM2ac8Kk0Q7kNvwEuTy5K&_nc_oc=Ado_r6qKCU7ogE17PVG4f3biEZT4YRGIj_ZZoUCSyrSp1w2krA6ODZ374GSPvX1jx-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af333o7J9_muuhTylHVuzyB-0aMkdWUD3J6w5_fCPGKXWQ&oe=69D4EF63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
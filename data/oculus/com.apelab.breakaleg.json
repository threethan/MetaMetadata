l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB0vuT3VtrMQ7kNvwExMkt2&_nc_oc=Adr1VGxP6g9l2eUCC8Si2ozBpU2mQGLU26zp43i3GFe29wuZUOORnwJYGD0jL-dMcwI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UOBpB6omQMq1c-f53U5uM5fna2un3CcdGJS9UD6x8zA&oe=6A41388B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK2cAvH2MekQ7kNvwE305P3&_nc_oc=Adr5Vb7Rmdt_8-CPJmhfs5Tv_liXMRY4nfzsNepwMQJehRVJhbkwctMa78AFpVlljNQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uD0jpJs1AIuwO92-moU7oWgK9s7iIZ450LA9RIkG2vQ&oe=6A411ED5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjOZqkeledgQ7kNvwEpmGyS&_nc_oc=AdpWNPRoEA_iCDIu_NSTD6i2cgfr58MKflNHZJ72UURuwUM2jqCbokPiEj7w-a-K0sw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pjJsJQ9U8vkot9eU5lXdm-d_9QSOPok3iBzmATChACg&oe=6A4116B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUFVqOQ_TokQ7kNvwEjZOUZ&_nc_oc=Adqjij4uYw_hLX7yNS2ZGYp11VRRC6JCrWeZwvhYWOE_LqiXxvZFSZfpXseD7aMW1SU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xz28_qiwGpNQM11zp17eQb62QlWBhIqR-mISSkk3jDA&oe=6A413E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVDK7EVwIosQ7kNvwGfXzf2&_nc_oc=Adq39zdDOFpiX2z2mxdc437NDH6n7SFFqDgNPOj6tIaSK9Aish9_r1WcHSk_9v8HQB8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JbFmXLKYQ99mqWO34pmVnI9kgr8jsgvtqHEL27ewYzA&oe=6A4142A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
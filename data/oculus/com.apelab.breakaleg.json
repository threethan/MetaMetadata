s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i5_iuMlvRoQ7kNvwET0b9w&_nc_oc=Adq3eFKKRcuWVWZSL-YPcw7oPop9QjKMi81alpFDO639ze11fTgqyewcCmBqiLzx3zI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TVFBQInFHNrwOl6L2NSumovGSvJRjuPGKK7dNA3rcbQ&oe=69D27A8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw0xZK0g7TYQ7kNvwEBPgTP&_nc_oc=Adr8KmWCboJJcsqAtIuBrTNYHipDz7Jijz2bMueZkwHcchv5nwdBvns0etjKAHmKmp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JFc5_yBriXUDbbtdVRroqssjY51R7XkBosacYkX2fUg&oe=69D260D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCTkOkzl5T8Q7kNvwHsAykQ&_nc_oc=AdpbHFYF83O5T2sYJ7jnM8k4ibgLxtBeTPVcumDrrpdtaE5wwwkGM3kOF2mULEgAnZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F_8H6IoyW4Kws-xEnlWGMkSGMlFYnko0DZtzaXX71Qw&oe=69D258B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIfthFsQxZgQ7kNvwHtujpL&_nc_oc=AdoOmZAAMGAdGQ12_F8pJSpiSwCtrRRMPJ8fUcRicE9eL_oZlaUXXT8ow0zHjmLGF5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Le1M00ijLSdJPtY0ffhHV_Svry8faLq__LN6IRo1Ong&oe=69D24801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eq76dIJxXX4Q7kNvwEB2ctR&_nc_oc=AdqRDX3nGrT0b2cI5ZXgKM40Bkf3pS8BMDQ_rZk29XzulNC5rkb_3sbzbjzPOm-n_0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LSXFvYc56Soio7QAMywhQaqepuWsMeefFHwoDs-x_UQ&oe=69D24C63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
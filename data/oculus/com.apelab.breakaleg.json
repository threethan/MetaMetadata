c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJBIwVX503MQ7kNvwGQQzIn&_nc_oc=AdrwSFKgoBaWRXo3y5yg4rdfwvlUseUfrId4EiQS-M2qxuj8fkqTNiPqlw2jRkJ7-x0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-5Egl_VTvRk4LEt9pYbzy7jrEQjA6mFKdMhyDz_vPMw&oe=6A843CCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ie6U4wB8-IQ7kNvwFpJRW8&_nc_oc=AdrnZDlfk-qXHgE-Dwq_dQWnH_DTKyt-wtQh54L83ifKyqnUkuYYe5SRqtW88-7NuPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERg3toOR8pv7TYc780oT1kBqELah4qmY9X3tlMC2nOGg&oe=6A845B55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afuu3LXvT5gQ7kNvwEO5D29&_nc_oc=Ado89yKRqUSXT6eE10rLwJWzPJUKFS5-yP-DzIfjQEmgWeuLLIViIbxcHCFyQKobuoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfnGdLht-PBJS0gIKycH9m-DMqKpuIDcZj9M6eg6tD_g&oe=6A845334"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us3vXV3F9AwQ7kNvwFsYxO7&_nc_oc=Adpy6AXic1qXUO91-MXr223tw_vZe-sMZvYNIpusuAEuJKVSsqyPEbBX7pBTZRcQnjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn3KdmdO1sSTAf61HOHj4qLdzcvHd4NEgIIschL4gQPQ&oe=6A844281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSLRnqKmZCUQ7kNvwES-GRx&_nc_oc=Adr8oW5zXmHXJS_FquIUUfDmfFEDH8dL7Yfhbw2NOX9yClVgRQiSMw1lZYyWOE9e3_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWyNIBHfMF3O7YrTXNrjQO09nO1rPNVQyIv0fJ71XZjg&oe=6A8446E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
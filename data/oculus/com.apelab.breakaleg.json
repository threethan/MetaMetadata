s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzw8WLYbaSEQ7kNvwF5Efq6&_nc_oc=AdrWXkcUrpYA4R6li_igD1lV8lLBBbufhDbEru5PSpdgB-nFKHcje3GGuS6mM66F5mg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NGt37MdKehTutAESd1KNu7gfINxmmx2-Y71Z36Fk2fg&oe=69FB590B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZRAR2vDb2sQ7kNvwFXC24m&_nc_oc=AdriDZdBajHxu4KjzfKyInbBrMdwzCqlpni0qQDK7d9FVvrPrJx02Ms5KbjYgZ3D7-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_0alzjsxejHTzKWTkRmOEzIi8Z9DTFx2N5v3QgwGxVg&oe=69FB3F55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvHmQR9YYM0Q7kNvwGTtmqr&_nc_oc=AdqTOOpZ3Dm-eWGz5vDSf9evE8IOeDsw5g6Fbmju42BVsVfMr06lM9kq99Z0Wa6zt8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nb92SGpofkTMwlOR5N4SNJM9g3UnJb0dySaMnueicIg&oe=69FB3734"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbVM-OSTavUQ7kNvwE4jufx&_nc_oc=Adre6MbSfGAw-KfRYxpzEer2y63w2y5ieXf9cJi2feLWkIHkHWlfRAiutMihD0Vd_L0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DFaKVIZpKC_WvsM3B4A6NLFKeHykwJt3kzAibD6q4TA&oe=69FB5EC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnzN5d2ra1YQ7kNvwGYRzkR&_nc_oc=AdpO4eOk2Xfg3ltaSQdSLvNa_9v4GUpp00gJx61QeFi_1undZ0tARdiuIvBtUCHAIfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z7qdilQLcgcyK777lRwD_fpLhWA1ZUvBWs1cTvqpEXw&oe=69FB2AE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
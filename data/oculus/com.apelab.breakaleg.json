d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udl-GYDN6tcQ7kNvwHze-pW&_nc_oc=AdpRGhZ7JKtC9VgJ1-BQdOzAVwuN1LxqME59tbOcexmDXhSkWn01axroja75hE-Evn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmu8liPf74EMkvsQREJjUaqppqn2ZqUfS2MNcDhBuvVQ&oe=6AB3EB0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLFRKF1OAHkQ7kNvwF-XtdL&_nc_oc=AdoVqdT44SgqQA4bLnjvFEBIuJZxvOZsk6cunZDdgJRUg6JdOyEvNxr6zD4YSQCL0S0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf7NFfFXAEV-_Q3e1Td5N5FTZJ8zVYBKqHhSw_NyIdOw&oe=6AB3D155"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIeJvvHq18IQ7kNvwH9nu5h&_nc_oc=AdoNH-ytri9RNHrr8Gj9Q3OzsEptn_WWGw4Xc6eGSVCFApHLWdzh1wJHoG4fWE5fTSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5aNBAfPXNx27GHq-WJKYDKc6-Quz_80246sCeeFW9XQ&oe=6AB3C934"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYNXo4sQ6aUQ7kNvwGZ9gu6&_nc_oc=Adpg3oLNgB24ZFDqT6N9tFlO0e7aQf16F4uYD9lie9zjsv50lQQn2iXilXjtg7NoWBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILOy8tTClWLur1WExo8R4YzoaW_JMJJ-BwcNJ5ZkEyCA&oe=6AB3F0C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nsj47jncQ0Q7kNvwHA-Uf8&_nc_oc=AdoBopoSGMopsEzcnm0LQKzhFLGBw911i1pGed8biKMCfLJ_LZf1SGseqsnRCbv0R1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe1ZrnXtPBD0r44q7ezudnsC0m2zjVe2ZNq2xr3krjLw&oe=6AB3F523"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
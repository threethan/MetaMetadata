s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqNFf6zdS5kQ7kNvwF9cv7q&_nc_oc=AdqZSjUXK_qnGPJvtge3yH8Hz1HUAoKGeY04xx5vm_h1Utvt0QAM-7t2FP-86j3xVTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8grfex6mTUpAeKzfd-6O8JBQkAzhiVSLXryhf5kfi7vA&oe=6A297D8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIN3klnLv6gQ7kNvwHYI9yJ&_nc_oc=AdqhRFxpCXM1qredRF3ly8343wJKM8VgF8cyhuHfrfrVs-K2IQfhlFIYRkvUUrDiiuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x4brHZDH9TkAIUxfEZfw79m_SbS3pilDfB-pvgITxiw&oe=6A2963D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=127bAb41J_AQ7kNvwFbnCfV&_nc_oc=AdqbFBwRi462kuUJ1WakZSroSx0NGuMdVwK4mOdSWcmzyuRMV2FftvJncSh99Uc3jf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85UkjCA7lIi7uKl049A0FmGvhQ1s0i7hRt9_liTZol_g&oe=6A295BB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izbogDmvIboQ7kNvwExP5gu&_nc_oc=Adq2zO-0xLKRVrtecE1zrJ3PQEvciczF-vglSVg5OEfF2SJ-eSnpRtTMg-tIsqBx2Hc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aDgjx7v3l402dRd3khjNRqX5dbAVmIw6ZtqfGndcUVA&oe=6A298341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyaPrFd-eqgQ7kNvwG60Mhc&_nc_oc=AdrYTH5QwJU2sBUzkyEpKxIBl2mkSQExe3XsT2N8Rhzgiqp0O9AZBNUc_W2X_sQ90yo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o9-w-Wi3ClqGv__kKQ94rUzq6KIDrb8PU2HkcZYvrnw&oe=6A2987A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
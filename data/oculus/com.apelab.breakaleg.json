d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9e3xXyf3OgsQ7kNvwGMZV6z&_nc_oc=AdoIJE_5_nBr02KdKIW_CqBho3sRorbRIj0oBAY_7C2nLsuF-uVJTy9Ur-py0uyYetA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp5USVhLrgcv6B3zL2gw6FniVP3G7MBQa3EIAcDEHu-A&oe=6ACA548B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mGRL3dr4TcQ7kNvwF0w2Ni&_nc_oc=Adq0wKqOtu0_aSRYCSvlCu08tT4xTLTw-bdTNXRZDO3-vUqHwJG-0hoEVkUNkM0fBuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSuP5p9u8sQNOMvR1wSL6ZV9ENeVR1DuFgTTFEPlhDXA&oe=6ACA7315"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaE_76DhtRUQ7kNvwHU6lNX&_nc_oc=AdqxECqZVRH2mG2cgpXT9OH42iKWF_IUKNpaqAfLpRNAdl9-bPFkyLjSfJ0IRrtiUDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNodG0FO4Cp5JLYSsBuSoi8w03NJLou4vu5WJ0b9A2Aww&oe=6ACA6AF4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB6eeAbk_2kQ7kNvwEnTbP9&_nc_oc=AdqQRa6KthYnd60J62BXOB9jL8aW7Ex9_LKON_-ZoZZt3V50C4xYKHSolSsofiXWESs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHSaxyf_uP3SLt_YQ4QxQv9CPLqh47MJ1ZojnqH7pySw&oe=6ACA5A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixuh-_clImAQ7kNvwFY41Nm&_nc_oc=AdobnCK-pC-riTmhDpvlMm_dcEYOXCjo8sg-OeUNutL-_usiT-cjmCvYb6Mg66FzMOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZqA-BcDz3fBvfDdT_m-RuZmaMm3cJYEDimqTRI1vGfg&oe=6ACA5EA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
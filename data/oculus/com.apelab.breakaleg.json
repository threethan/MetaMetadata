/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tveu4FUcGYQ7kNvwG68uXI&_nc_oc=AdnuIDbmC8CZvBp4fpCegWATBIEJfgqr_Sl63r1ROnV1842rHuKALMnnS9ufOPZGJWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXBUCOT5d6mgR2rkQTbRTiLsaLuYHrg6x1OfBc6-5LLQ&oe=69B5414B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u41DxuEe74Q7kNvwEX2TX9&_nc_oc=Adnm-XGVSVOlMMe31ydLWtITnrO6tHQy4ixHAWH_pd08cpDZgCty86s8jOI38331aVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtCgRA17M17aeVtIgy_0dZevMfoWhU9GPfKc91u4qKcA&oe=69B55FD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8a9iXvJHbcQ7kNvwHjQcP2&_nc_oc=AdkywM3HXcYQzalwH5cihpuSd-khT99xV9JYh9nNvmsg9a2UUYGPId8cvr2ZBTTETuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfysX8YmCvNdkS_G13SEjtS1-hqJybFO60uFK2E5LChX6w&oe=69B557B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9xDTVIXzdsQ7kNvwGzIUwd&_nc_oc=Adlym3a5qMQZlUwi-JQGvIkZVc65s6mZSHSNMiCTkXtZVjHNBnV3SFqJI_C75BzQTOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyZbVSUnkVnHM549eCLdB2kNxW6ueVGFik_Ux62PTNrg&oe=69B54701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fioViXfI-I4Q7kNvwFae_pO&_nc_oc=AdnepHdlCVairNJ1caVfBzY0HGoajgHRQoeqHEU7jJODWPeCJDSm3Py1rJicjaRF9Rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJdfZruGRGMtckS_NUugCcaPQ8drSEZty2ryTdhdw4vg&oe=69B54B63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
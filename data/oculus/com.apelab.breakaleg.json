d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeJl25A2ejEQ7kNvwHlyH7F&_nc_oc=AdrApVXTwGAATUvoa6k8lXwPMcGZjRJgli8ST8lcvisCBu1lSaxAnl5oN7o8uy14ISI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgNGwnzkp3suB15pyCpAfCsQTwtgBh67nEQGZG9bRToQ&oe=6A4D160B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrobyteKDygQ7kNvwG91n-6&_nc_oc=AdrzWnVA12FvXVgis5udhsLpdAYKwmOgmLyi_QBfhMK4wCeWm4r0SFheTD8S5Irjjnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf99j48xZXEk_zp9-A8ZTV1NAVuYebTtZ13jNwgEc1SQ&oe=6A4CFC55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjCZmAk8MdUQ7kNvwEag7d3&_nc_oc=AdoIOBlfFDgHH0YfZ48Uwu_OGCGgjGNYMgD8T69tvG8-FGWUD9cFsKwp_RE633rtHWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm8PGgYNPx8qG-e4xXbsyn3Zt99El2HaDNBulm_WojwA&oe=6A4CF434"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE1GckH3L9YQ7kNvwGtjCFw&_nc_oc=Adpuq_nY9R49bYvfhrHOLG0iwVOuHrKNbb_hHXdzNobF3Bhbmb39NsHmSBR7kPgkQ7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW7thneCWAT5NHcCEV36h6aSaNVfWWmMm0B3UfhX0xEw&oe=6A4D1BC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaboMwUu64UQ7kNvwGRbILD&_nc_oc=AdpPrvZHAi1M55-Wr7SKs8_V7IQ1upiFSDjjWw0cllCQmHF7lBbMOR3jsE0ROqEXPXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmRvsSsIxr1s6eLGFPyTmFx95j_oNUkSv-2VZTvJSSyw&oe=6A4CE7E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeJl25A2ejEQ7kNvwEipY6-&_nc_oc=AdqiFIFulkDiHFk1eLBLD8PsKjtHAPSJq09J03B6o8nBZI_IffT6GTeEMFbH2J_1nZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE5BWIkj9DxS_vrvEyPtvPjuuUaK27od8OCV9Z_EgH8w&oe=6A4A730B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGXeCLd1ECIQ7kNvwFG6n5j&_nc_oc=AdoR7bas0C-y9tL8xNjppUE9p1u1MSLzQvnuEkvwpN2QnhGZzJbmZw4lj-BeGS9N0MQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7np_FYMB7Xld3Uje9NM-57JrHJo3TEiJEElVo_lYq5g&oe=6A4A5955"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjCZmAk8MdUQ7kNvwE4oQMi&_nc_oc=AdoylArHNTtMlXeP7i8140Iq_1S7ZAcs11CyM-ekcC8PUlcphMrmqqLtnMbrXS08IHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR4-oGLkywWUc4LAVVdCx74dyDcvpYjmvjNoFoUF3rHg&oe=6A4A5134"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE1GckH3L9YQ7kNvwGijs98&_nc_oc=Adr7h5s_y4trtBPuY-dCkSIwYYtrW7TKNw1orlAv9bgBzTbcqyLB7MWRSEFmMP86hk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7_tm_55s2l8PvT27k6G0DgYdJoaMFf7Wx_i9dSj-E2A&oe=6A4A78C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X-01EiUeAgQ7kNvwHPviM3&_nc_oc=AdqmV3033_VOyh0LTfCXMmYRzz25lYi5aC-fB-8-MoPbpEZX7AbP0uFfPsFpML0F9cU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMeA57xcf2iMH4JoZ6nRun0zJ5uU2XYuMvAeBc20yH1w&oe=6A4A7D23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bXXCHYHomUQ7kNvwEdmHRv&_nc_oc=AdrAejka5n9HKRfdkN1ybJ6taZWoKyrnvfq-2fv_2eo15yUWZyLsuZGHnyjw4zvzPhU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44IwHjtc8qn4orEQW6FNHG_ApSMKEoYajjjYTWYNIMMQ&oe=6A17088B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fjdWbQwHSkQ7kNvwGF03KM&_nc_oc=Adp9o2_zVWC1nx2be66dhhldnropoRsbaW3UFC3KbnC6Zw0Z3T24fo5xYDqs8YLtJig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YYbcqT3ZGa59I54BvcGm04spKJLRWeXbXsXzo3EnduA&oe=6A16EED5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlC3KjfQe4AQ7kNvwFhCb3q&_nc_oc=Adpniruzv9GWW9pGcOHnv7ClyDQGpY_ex74H2O210bhNjeqKGHGmFLP7v7U1xtQhr9g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_PYuvzZVRJU5_Cv0A1gHHS47UlH7GQihFf4ldHH83Kg&oe=6A16E6B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qtATxEwr30Q7kNvwGc05xF&_nc_oc=AdpOImKB3vLh32FbVGhvcekS_5eGNtBS7OEanIEHBZTAI7EMeRyGESBjW7Ods_HPxzM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P0xh9lKoFDNsLW7mStI3EVuxi-2ZyZdiJFECUf7yIqw&oe=6A170E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrD-GB5XZqwQ7kNvwFfuUvm&_nc_oc=AdrvadLG0D-XkFFdTr6ihAf4M2WO2nRCEDQNABxeMLrPnd-Z_h_jKc64LREMM3qU50Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mzzhNRYDxqpaiXmonX419WkRM7V-mxH4c9ZD3Grcv8w&oe=6A1712A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
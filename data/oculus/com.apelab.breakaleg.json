d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoGgzH0o87UQ7kNvwGlDMaU&_nc_oc=AdqIVxHPRNOEg1HOSJkzqt1qTBrnuGHJHjdDvVWJxQ8g6ZF6Hm_yi0wxxrwVLxe2-eI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxV93IjOdnNAb-jpbt7wYxGeHOdc493DW-ZFtZGSLxHg&oe=6A4FB90B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrobyteKDygQ7kNvwEs7ZW7&_nc_oc=AdryvfZ_8GMxenH-PAX3OAhLq-odj0TaGOwYyM0uXXZwPZ0BvJf-pva7Vbbt6Yj8Vbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgzLw2GcQtnrt3A-aeniZqtKkk_o0_rZGlZ468CPv1Jg&oe=6A4F9F55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISBp55M4iqUQ7kNvwFO7k1i&_nc_oc=AdofKaQ2E5Kn5-LPTOUr64cNYGGQMA9wQE-_QMZdPLGGWfOuQlT9UdbUvZoBXZiBqoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEI_3wge0QbceTn1AM23rYWXzGbA5De27MeurdQKkZcA&oe=6A4F9734"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elQyxuzyzDUQ7kNvwFYsJ-v&_nc_oc=AdoocPss5xs-ZQdvRa93kdxc3degBvtyPYankPmHxgoKKV-3dYf6V8z9ZLzRh7YPdks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeYoCOJHUHkL1G0alY93x6b9sNlhmtAb1QyuMw7g-3-A&oe=6A4FBEC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iTwDJRUXgMQ7kNvwGLTceM&_nc_oc=AdqYhIafN7BH8nfGbULXqTuPy6YwRMm4UmOpxVkA0eCKzNDqKjb9udXFrsgV472YPrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1jhKiKEEyIvSJEiIMZCnJTeFiEw24K36kbJgOrNz8rw&oe=6A4FC323"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
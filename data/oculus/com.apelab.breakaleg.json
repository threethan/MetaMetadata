l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB3ynrgfyNoQ7kNvwHtVLS4&_nc_oc=AdoANzJXdvFYbB_qp2W_Vuo1kH2jBifhj8uMM7FQCH4ViNNLnFpDCjbfssyqdO3MMMU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU2NVzZfnbSGGN-uli3w8kSc4iZSHLpn3tnq0QYheyMQ&oe=69CBAACB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dklIpHZqu0kQ7kNvwHSEp66&_nc_oc=AdoD5Rj3kNIA8dWXZb9v3UdgopwHIHq_w_8yZ8uxSqSuIpgsstUGcOYOLv7zcrTxpI8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMdWJtRvvAAhDG1VCjakpxP4bGhnQxxARM1ZOpVW6bBg&oe=69CBC955"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnw-v26zCVwQ7kNvwG02c2V&_nc_oc=AdqS3jZHWWeA8P_Oe1WxqHVbZwxuy7QBehFcAbLxwxAvXy80ZIG_5ybj_ZS0z374Irc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqzfpTbqfTdjXaHZMa7m2n3yfPCUkpwJZKNanvU3qK9Q&oe=69CBC134"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPKJwAMe1zQQ7kNvwFSnNFA&_nc_oc=AdpV8CEc03q52-nDptR99RCwMLct_MVwdMghm7QVTKfnFzDZbxhrrzJxEo-v6C84LVI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmPgGtKo0Rc-sgxXkVJZEZiLSJn4v2_wf229h10C1qpw&oe=69CBB081"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PVWtGksD4AQ7kNvwG8YMQy&_nc_oc=AdqKR1XQIt5R50rQvjBye7XUGbA5IlsInfHaPqO5pOO_ERyN2lUdtIJZJrv0YVyMoVI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4OhENSX6yfI4xUyAz5CIAmWbUuDoQ4nQa5yW0BG3eHw&oe=69CBB4E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
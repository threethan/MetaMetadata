d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJVWHIydP7UQ7kNvwFaNLJl&_nc_oc=AdoZmS4teul-_pxt8xJV654Mcm89nAFboEv36SmlaTT5ZaZkRxHUln0WCJB6j-JaWlQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi3wCUVe3KLDWpuHss8kswl15F9WdRfU2jsogsZjU31g&oe=69CA594B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dklIpHZqu0kQ7kNvwFHnW3A&_nc_oc=AdqWpXpSPzYz5l2Cy9Q1C5e2saaHuFETSQzYTICsDxigN1C8Vq2p9KXlQNu3y4Sg1KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxX-CtFvo1bgKpW_IfbwgIjAwoiCxuOK3vhjIdGRg9LFA&oe=69CA77D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyUAIEO7cDMQ7kNvwFtquD3&_nc_oc=Adoer10PsGlV2cH9eXD9m39F8QxI6BF_QaHe5BIEyjZlDUKCiNrAJdeW44FNp4Qyn10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAqHPG1o2xUOPmR5nRkXcZmZYmTiEZzBoQG42TVAgyvw&oe=69CA6FB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV561_kVzfYQ7kNvwEtFJ1b&_nc_oc=AdrpxIkxgUpU1hDunUti41wt3iEiV8i66zsc6sejkbCC_olbgR6KXVgZ3HaBXPyzt0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxQCPVwsWRNSzFXOGNECA-tpbuMQ0vWnsy9y4TzFrxrA&oe=69CA5F01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PVWtGksD4AQ7kNvwFwyu70&_nc_oc=AdpFL0TTHRRKny2VAzRTgUngoGcWMvzpxyPWVD2gzV8yBZVjf5xGxuyNwQoKXepbppU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxwejp3HL8DkaPCM0s0TtnNwdNmebZhT7TTZIUNrD3wzA&oe=69CA6363"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
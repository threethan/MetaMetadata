d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB3gbEKGWFQQ7kNvwEHJUK8&_nc_oc=AdpgOXSQU6j3gBwfCpAKIsXOOyt60LSeyle4Llo6QHaAk2B93NSiEJ_ldOOuisEtflg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpOyzJkCQENoX9u145jynlGZ8iinl0zSKUBe_xX7gubw&oe=6AB9310B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JddZ0eslNgIQ7kNvwHAoQuV&_nc_oc=Adq0e5KvWbXvCdn3hlwEPPNpu3d4zfnk7-TJeC3eKpl1ziYJJHfmOCQ83i8ISpF_Ycs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjFM4FLu19aNCuzKhCKv655dbB4lydHVmik3xk-rKkQQ&oe=6AB91755"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyUxZQJajZ0Q7kNvwGBdw9_&_nc_oc=AdpbZJITO1M_z0rpoXQ2FR9jtyCTeGaJm36vEd7ZQg31GwdaWpUBh00fTssTSoIYJJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPXHmxMiN0b1pDFjuzfAFTiRBu4BxJQOct3cGP3sdGFA&oe=6AB90F34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op27K-IR_iMQ7kNvwEpEw7R&_nc_oc=Ado_2O06eTT8pAlyCaOJ6UbcAbxohir0iIR4ff546ZeA1hmwPDsig7yDYq3x7zom_UU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhylxfSvPVQyvM_hFMC8p-a_Zmg2W3i8mOtxKHjuiFqA&oe=6AB936C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfcaX0Cow6kQ7kNvwEqqP51&_nc_oc=AdpR-fVGt39zFSuWFwoaWi5jYuz-Adw29WApLTyvdpLqixcTFZViYBkB5puFgm6xLE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGtBvMRyIA91vUhzTpI_ZuSz3x3N_S4b6t7SsLxEIzmg&oe=6AB93B23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
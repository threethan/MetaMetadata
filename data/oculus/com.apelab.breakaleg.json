w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMaVofnz0BwQ7kNvwGicTS4&_nc_oc=AdqSQ07qwYDsTm-4CIQOXOlVX5a2zPR_GGg33F3ffCQz5C6KToKknHbjq_M5ju1zbCE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZfJubWpvrjWZyOEpoboITI3tYQ3ctjPk9cqsuZT7HqA&oe=6AD38F0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9K_UIM5eMUQ7kNvwG22FZG&_nc_oc=Adqo1gkYjiQcCZfW-SorRLEvhMuUbLIcWGkBevbuky_YYVbMj2BaJXDYyAfQWZ7xeOg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaeSIB9bfNLd96j8h7PpC_PTYgcDhGz2HntWBSjpl-ww&oe=6AD3AD95"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKTmWjvMUTgQ7kNvwFcU6e9&_nc_oc=Adp0IRbmReSgrvV2YEn2bNV1OKDg-Qzk3rL2lFE0Crm2KLIHMauccFF98ixzL2Dv2_4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkNZW6hC9QG41KLvPasMoHJ5OsTA8WJx_SMxPxjGgX0w&oe=6AD3A574"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omYC5CudG-AQ7kNvwHRqzpg&_nc_oc=AdpKQnU6prSuYAfgQLJkUxPLbSWX5n96tDEF0lwuJgQL9lpE_SuvsJYqlkeN0awEhOQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNllpRu1aovRPoMtjFBSWlj2HoCOzoPUs98MdEW1XERAg&oe=6AD394C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj2PEOmFADIQ7kNvwGoKaGH&_nc_oc=AdopJ4i_w3KB86ntBYJbQyRAw_zkCkVeCxIrWXuJSgZh-Q-cIVMYH9K0klD1DYTYk_Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMivyx9s7SRpDs1mJ4crzEFs1ZZC2lVUMB6xWpHFU9k2w&oe=6AD39923"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
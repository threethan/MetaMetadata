l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i5_iuMlvRoQ7kNvwFvj3Hs&_nc_oc=AdrNlguRzJsDuvLTYQRM7v1jolCXNGI6nta74UcUsCybdmr0YbJL58vBlvuaaA-dLqA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8mJMD2_B27zot3nL-4GblRPBSHQYnd1UI0IfiirOf7w&oe=69CF9F4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p38g7JyF9KMQ7kNvwHg1k4C&_nc_oc=AdpOajFlcyEnAh2BWbapYISB6pi81xxI6Ith0qWR62opFNRhS-NtamKPbv-j0NtwNdY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8dAHvCFZDKG6PTqDkqj1B1TBXNZJQVYbASjIr8dhHPA&oe=69CFBDD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCTkOkzl5T8Q7kNvwHjcxI1&_nc_oc=AdrT8fepehKfY-7uK1ykGuK0RZASDu6Mpf1MCFcSkbw5wEwXX5-uzuym9_GryWbbF_A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy85VGzrUe0SrdVGqF0q_P8gn1fYJ1uFQXsmbBEZhGrow&oe=69CFB5B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIfthFsQxZgQ7kNvwH4asz-&_nc_oc=Adov5R1HwWqu0uamfEStl3sH_ZkxoEsNOlPONsuKyMGjhLCb0LiDSa6UPAn8-AskSz0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwBCIQSPcfWnH4qD-sZGTbP51lfmKhDyQMDqNJ6m5V7A&oe=69CFA501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yz6XdOs3qUoQ7kNvwGxulU-&_nc_oc=Adra-Gc-4itrXjtdyy4YwtX6xi1HlZOhePhspaZZnIt9Z4FzaSh_CTaa5Mk1KP2SGsM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPNCGglu8bF2OU6TS04nZvtc_Q2AmPVQUUf2V05S3vdg&oe=69CFA963"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFuc-Padtq0Q7kNvwHONTwX&_nc_oc=AdrF0xA2SBU1rPfZkZvT3tUJ3eTzZCaJjKBToNu6WkXSp6O7BOT74TXex0qUfazTP_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IDavDF_BlYFQuO53KJXuAm1NOePNQNTW9Jov1Rv1tuA&oe=69DCCE4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8RpB-0dvJ8Q7kNvwHKk2EU&_nc_oc=AdpIy0jJrUDBNeIK59weM_4PtIV3SUbAPmXbhS9jLdPHsYc0lHdmraS8KyoFHers_gE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mCgee8MlNUQkDKHRdJF_DB1lXLOZZQdV-R-VZ6mY1AQ&oe=69DCECD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFcq7oPw1FwQ7kNvwGrnxb8&_nc_oc=Ado3MBORZtHd31I5oaerI0o-KraLeWzstHKUDCMRvQEMEeiY3rgEuidY6bJQH40mYu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ycuJ37jA4H93I4_Tm7p-WWQ7QlerHeq8avTQpaZhqmA&oe=69DCE4B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJLaoX7KVcgQ7kNvwFgMI7O&_nc_oc=AdrECaMr9AwFqSWMMh6pz3cDcNXAZbxwOv47sNfBQJ8_-wGmsLkJ8Z9kyNejAf5zsBs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vAcFiNdH-v80GvQFx18ab7anS-iDQ4KyMspuR9bSVZw&oe=69DCD401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiX2T5FnmqIQ7kNvwFRD2Uj&_nc_oc=AdqHMe5xYexWwEmgqJKbo9Nr9uozoon5t7HdZ2UoVB_aULzm9p6IO_neHG8CoGsPwXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14dX5QHJ6983CDWrqc3JcksRhoAKovhBSXmVFq3I936Q&oe=69DCD863"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
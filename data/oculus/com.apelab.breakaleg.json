d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U-dyjl3G04Q7kNvwHgAobd&_nc_oc=AdpqOxz5BRbE-PjWofSHwGpdx1QyBHOS4-IsK5L59vItp9HQJyztbD5HEgXf5A5j6YA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ6mVWwod5AJ-haR95pP76G_A0pmXX1ItXziYY3my-aA&oe=6A73518B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6rhDWHNiVYQ7kNvwFX4nWh&_nc_oc=AdotP4Yhxaigjz8ILoxjxz5TKQrzCXkvO11H6WPOQda5HTyd0iNSYmno7ZYrYmW8VbM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG95kNBjhSL3A4NNaZiXZ79uisjEwElMIYHuLTHO6sQWw&oe=6A7337D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_x_1fpL8n4Q7kNvwH6_tAG&_nc_oc=AdqnMk1RIs9x_vvYNNG2ctBPWw0nSnsYRm8mxks9JsBJaDL3A6IUxFe-J_ORxXgb5bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF65Iwzn9GxJHlELvy2FVMo1jVWFlLC1kSR022rTkcI5w&oe=6A732FB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoGiZ4LxOCIQ7kNvwFP0AQ9&_nc_oc=AdqT9ZBx1uge4OIDNKJF7DNygbSyuI78hauq-fqDpFlEJmyuyBMan-axArfj9rxIgG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhbx12ZdTE78SL32Lf76oP89GURHr4XKN6DS0EtsT05w&oe=6A735741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kICcHUj1WsQ7kNvwEMO6mN&_nc_oc=Adrx-1vkAk2mfmh5izUjL46XWwuI7G4yySmlazIL_8Z04fdmdH-ZOL5ejReSxXNTSpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR-Wpd001GLdX__5ie2MU95YT6bU-MRkWAY5B601tX4Q&oe=6A732363"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tveu4FUcGYQ7kNvwG5CcGe&_nc_oc=AdkYNNbiK0Xku6S_bzghdPspa6urvme3t4NB_-XcTPE7UbLQyFkF4KcVoy5Bu6d8w2c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxieAqPny8ruq5wrC9lU4Eot1HXPnOVBFWJUlFhlldVdA&oe=69B692CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP5N0JcMwkMQ7kNvwFfb1oh&_nc_oc=Admkyioyya1VSoa9YbhVTELYRq3GBtJ3bvQ3vzxA2IGFqu1w3zsHyJV6jRbUOsqbtxo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd-E_XmyNlBXwlZjEx4FO9vUa9lW6Z3zoUFGt5QkoAaA&oe=69B6B155"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8a9iXvJHbcQ7kNvwFKVIIP&_nc_oc=AdlF4mkoCZ_KCvaMOZvUvUvqeKoLQVJ_RDkWfUCeAc5ZSYxXgSrdbtgsqECY6EvmTkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu3ynvR9m31XeeCSV3bpPWEU8ZxgEI6PUo3g2hLsryzw&oe=69B6A934"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9xDTVIXzdsQ7kNvwEzpASy&_nc_oc=Adl6n0iesbAloDfLWKLxg6Z1ot1N4V6l98Z7Tg9GE1MTjb3efPsmkzKIwwOS4XprY0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaxdsiHvcI7RXWDlkm1aJpF-95haD4V9hfhCqLnpazYQ&oe=69B69881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fioViXfI-I4Q7kNvwGKA8WN&_nc_oc=AdlRtRwhmxwLXhtiYPF-dCTh2FOUM4E3GPEKVjBiAM5WrlDur0xfX9b84ZSKCWfV7Wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGIcYPMW2PhllSbizPXv4z67BXagUupGLE42aZH_MDnw&oe=69B69CE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB3ynrgfyNoQ7kNvwHYkLFH&_nc_oc=Adpg_Rc4d8T3vKjx14xAfNpDC88xDI4gIa1-mMZhHFVuU37hQA25tUWJAzxukRJOyZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLeIEEAWhGoHxdtTnoqIBKqAUcubL_QQyleDTHtadFrQ&oe=69CE4DCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p38g7JyF9KMQ7kNvwFVCWqs&_nc_oc=AdrcShkGF-q1WT67IaSoJnEXapP7A4Dtdnum8wypoouecSEfQJf_umiGW9lnADG_CiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLKm6YWvq3V52MMeIGwNKOar7m2s-5aUDamit3fg2vUQ&oe=69CE6C55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnw-v26zCVwQ7kNvwG6h7IT&_nc_oc=AdrmehoBfHLuydAJiNEuvqVUdAi6CV9ifAQ5GxHDz_9k19kTR5NTwpXn8FPawml4iDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaYFJPBvV877JNyMC_GE-X-xVqdd6PPMPceBcxa3nPdg&oe=69CE6434"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPKJwAMe1zQQ7kNvwG1khKT&_nc_oc=Adq0iHvZRlAmmIDhZR5Tv_9V68G8IEu9oZ2lkl-eLnMhOO2bDLhbZ3APPdVsKt8YXTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3wZBwVOBbtZQMoLBX1x0KWU9bjOWUh7D0UGsp8KohuA&oe=69CE5381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yz6XdOs3qUoQ7kNvwGQOg5M&_nc_oc=Adps8X_n81GSzIxx-gjzJAZysxdv2GsWNoCAPU1I4IgUv3QIFX-yd_0LEd2r6m0R1rI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy8Kl7B1AMeRDfdiNIV-pSmDxd8NpqFW1iDOUDAukh6g&oe=69CE57E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
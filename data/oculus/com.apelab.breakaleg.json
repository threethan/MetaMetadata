l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJJhpEhCv20Q7kNvwHSfDZV&_nc_oc=AdpbTFEe39NWNqGdA8aqSAkFZ7gebsukwA7lxev5joi70k6hdHsdmpTlChe3Np7blFk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mqg32uX3pfxqDkxp598yfOhzTD59BhqdPTkl5Q5b-Vw&oe=6A3D440B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALhjvKlVf08Q7kNvwHQwKD6&_nc_oc=Adp650Rr5opRrecQguyVmymMhosdHfFzD0pL-czJP_IRH17ysWXXOy0PTBs8yuy6Cgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sZAEXRaB4fpC6fExeSo69DauY10BDufeLGCuhXiVVaw&oe=6A3D2A55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkRH_BaWKvkQ7kNvwE-3J8X&_nc_oc=AdqvJUgIfs7wbFvDvbig0j2mRbd9Dk2pekj_yTufYrGLndb9bT-pcu081A5qxCuROsA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4XVF4XcuoO5Kv6SIZX9AXAq574t6knLNAEOJTMESmSg&oe=6A3D5A74"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjjrsUariZsQ7kNvwElU-7z&_nc_oc=AdrYBA7RsAfPNP-y4hl6O8rbLGVOtShHiISBEemZP-e_P21A2eALstpE5U-o3tfnzyk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A69THSjR9akjhq-TztKQ70aSHkuLZ4hmr87TSVxXGYg&oe=6A3D49C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Munl5CT_CL8Q7kNvwH26x5h&_nc_oc=AdqymRu6Wb0utXLH7u-435T_BddWDkl9uw1KSJYDAQeB-7DIhSlTEmyeXvdafnQxosU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w99Tyw69y7xQp14U9lPdyHdVUUbMy_hXQ4G2ak3UqVQ&oe=6A3D4E23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
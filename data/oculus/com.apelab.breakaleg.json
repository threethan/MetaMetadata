d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV3F8ylUItsQ7kNvwHwMyLn&_nc_oc=AdqiCdY6ezZtMoy0nFBSFQBgZCMK8UeCEqS5Qpt6IyZctWmJ8j9-sBBU7mXVwXuFbO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUVDjQwfViRp0eVtg-EKxrRL7G04MtALN2Zd-C-eK2VA&oe=6ABFC88B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fczrbU9xB7AQ7kNvwH0yHy8&_nc_oc=Adrpkz_d5mpsak6Lb-1fIla2AezAstkTO-RQw1ygQgCCa8sZUYTJ-bSvHI2-oaIFPPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR5jK32KBZV6UqPkMdnepLE0eWGOQ3YB-sKvxWeCu2wg&oe=6ABFAED5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT2PP-XfdCwQ7kNvwFzZY6q&_nc_oc=Adp3ZD5yFXzv02RHptCkAolHqKM_mUyi2mNd-5xIU7t2o1wL_LGzxD2Vk1dZRL7y7Yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj0VsJ-mjQZNLM3g5O27MDhOlCC3WhTub6U0kVdIX3sQ&oe=6ABFDEF4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIZcJSclP7cQ7kNvwGxa0zm&_nc_oc=AdrC35NpT5Cok1HyIA4Mu_0tz5zGR7pbZRvJ6k-_HTf8HAufCtmqzT3eBzH0iiNuX8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj-08bnUG4LeV71Eqm4UMsjxjMFyviJRHA42SAB2bcng&oe=6ABFCE41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Epg5F0BwVAQ7kNvwGrSZRu&_nc_oc=AdrqKHZTkvhtOFW4ONexANJeL6gTftY3gS57yhlZRe4vWcDPO5WAk7n__2v7Wz6mbT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEaCSV6RQb-pBeB6jCuGribKvuikpp1W710BTKc0oLSQ&oe=6ABFD2A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
o1-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47_7QwZ3EZMQ7kNvwHZuOX3&_nc_oc=AdqE22mmhgvT8QpDjwVH_uDRdxQBrTleB5zxWhjURvbCRY4S5OBPkGP6kbjc7O3P2w4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RY-_LxKFHrsTQpdeDs1N5dqdIq-33RLhN_iRAFxpeng&oe=6A09D98B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqhXJFBEd_AQ7kNvwHWx8gR&_nc_oc=AdpuXidF3siZFRNLEL20bAPZoKcOa-LlC2U8d7IuJVh8fj2uKPQGBNrJnOj0MVzUzrk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72EC1FYP_I9Ymbh9ANYy4mwCyquZcQ_Iom5kBH2YL_tQ&oe=6A09BFD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsgApFDfSlMQ7kNvwFMJUEk&_nc_oc=Adpezh7g5dMTxRV_54DeGwQGV33NP47L8UW4DkH3DMUQFSfjAKoR9_E5PRbO5ZE4xtM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UOnsG1WCgdo4CgjB0E7hqKcW4IYDvro1zAydRR_2omA&oe=6A09B7B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zxw_gvyDBAQ7kNvwEe65_5&_nc_oc=AdrstfiZ8PP_8iMXkiT2aXyM-fFvNykxxJZCh8uqxoyP9VGtXBVu-fQql3TU6KVr70E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M6MQ8e0oqN4UkKFTV6A3Ez7lQ_ddoIRiA_OQmuuyyKA&oe=6A09DF41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE-uwk4JFCwQ7kNvwHz9Kz8&_nc_oc=Adraa9bBtPbRPFLBjDGyT67cH6jYDeHeD6L2_oHvY_0FM-jNpYoNf0YW6Vftm6jIzQo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OhbngmFVXaAaypxQXTuU9u55CBzqdlKwh8z-DPDaMxw&oe=6A09E3A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
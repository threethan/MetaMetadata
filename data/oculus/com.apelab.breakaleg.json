d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83anU2FgZeEQ7kNvwF6BWsR&_nc_oc=Adp3MKMiON3lk4IlcWymfAL_3X6pZFng-c8ABoTFDNEcynxu2gvBzKRCVhukaa6lgJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RM6QZpumBzJoKfPDJuZzFJ2bBlsnbbBtYEmG0jgYcgg&oe=6A2EC38B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuvWVWE4hscQ7kNvwHj-BSR&_nc_oc=AdqzGPAVtyfTpPBsvYq9swwFRFArJMUWPGigZQgz0POHl8KwyksblPIE9KhMT4T1lsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yHSME08-H8YOyk2Xgr8cjpSSJbFsBjsGA9ssuqqABvg&oe=6A2EA9D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5e_UUuNWMLUQ7kNvwFh0uEE&_nc_oc=AdqeVDIQVe00M1hEn18hdFB8x185TfVcdO3Hxlm_OjQ6YlCI5pS602uhz3qBcR8gzKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8So7q4-bhcoJc9d2PwLgPcVRKdUOqvyYhUHnJ_A_DqsA&oe=6A2EA1B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIPbWmLkZEUQ7kNvwHFKapp&_nc_oc=Adq7Bg9G1RLpuA3fBaLXdUvdP2ZF4fo3iPJdh4s5JB5YRPZB3qXpn8FWFfkRwtpQfjg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NEH6tIP2rBbsxpEb3iU24T9hrHIO4eFytWooWsiTUxg&oe=6A2EC941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvL82STzsvwQ7kNvwG3fhy6&_nc_oc=AdreeI8xAXEZWCaZcUiUUUlWu6HiXdDq49pYxopQ4UOMeUYxhaMm2dLfB4Zic01PnUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hzp__8FKWiBmKu3m1_4anhQcrowh-OpdprhsYHTx73Q&oe=6A2ECDA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
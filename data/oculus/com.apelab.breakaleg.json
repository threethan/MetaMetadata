a3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJBIwVX503MQ7kNvwHfbkcn&_nc_oc=AdoQOjO2xIXM7MqE4QCKo9645XUZQYKVAFHT_c9GCCLxzSucgu65BvXuFJWiLPWwL80&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFffCMynzPa4rlllmuXSvRdjDtBKeqvK4FCJYTmgyT5ag&oe=6A8199CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfysKHCrIZYQ7kNvwH82aRJ&_nc_oc=Adq20qUn0jHPsaRwheD4HOXwks44zTepG6b9AlSFVvdG8G7eCGyuzdLZLxe9Etx3pz0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNqv1Rep49Af4tOlLMfLqVNFUKxueIxnhsWXM7dgro-Q&oe=6A81B855"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afuu3LXvT5gQ7kNvwE8wlUT&_nc_oc=AdqolZ3cdujC43Z0v1s6sTueBwzfzbfvXKLKM9UVqv_zmm3tPxOzFMkJdMrMkUhNaRk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrsGwoLeyAvMa85UqNPqIBeBR2-u4xVwd-RZpX4yyw2Q&oe=6A81B034"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us3vXV3F9AwQ7kNvwFQJIN8&_nc_oc=AdrlncFRxRQFI0fvAlJvzBWS5zko8hQVTbyfc_pVZbKvpHn2zeZre_MtbNndQ7tyAbA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdJy3-BXtO8oa4H_2zVStRNnSCIG8r9UQonsjvqY9krg&oe=6A819F81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHU-dW9Q00cQ7kNvwHIKMFm&_nc_oc=AdrpBdxGph8vI5fpBT1lK-PTn-M42yTGL3eVX4ZqFaXLDN-m7z5rG9bS_Wihrmvdz30&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMeZmIgr67nMcPtUrwRLRwiXqB3IU3e1hhy-mxD9BWfA&oe=6A81A3E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bXXCHYHomUQ7kNvwH0A9kt&_nc_oc=AdpAghD7xTmIdKxzP4y3dO_C7cPi7317xlChlgaQ-9tXs68U5QXkOuneR6Se0o21YPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eFVqlYBD3jdaN2mcMDO5vT-rpAvJY4d3pXwEAWzqvBw&oe=6A19AB8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m815XCMSK20Q7kNvwG6m7_2&_nc_oc=AdoCu37GdHcVRaQQwKqBfJR7SkQxKV9uId6-u67KgaYdYaph9ybZ1FQNMJndUcoghvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mUTW9anQNqLLRZM1qatWqB06cIdZuGJrpvBygkupdXA&oe=6A1991D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlC3KjfQe4AQ7kNvwHIXWVG&_nc_oc=AdrkeKeEVDdKPwTo_h7AyxaxecbH1S_ebC2Kz7rxPhRGRk_wLoaqpG3DHW6Y6I5wpfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u7RjALCCVF1SpPdUMXl8pIBv8Cup4KfhsiRe88N8zig&oe=6A1989B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qtATxEwr30Q7kNvwFOOSvt&_nc_oc=AdrRzGRnEqLGwDN6Q9TDR8YwEVQ2rVoWij3cB3QMkOGEs6OagpfbpIxFijfSfPRyRnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PBq4GlUHVXsl4lbxMQwszlXrZW3qWNXJ6ojEOgc46jw&oe=6A19B141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfdvOWD66qsQ7kNvwEfdf7U&_nc_oc=Adoj2C7z61xoKl-zp0da5tMv_ly1dIAL6TdrJuOP3PN2xs4p3FMwJnGm30VPtZFJubo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HcOgtrgiYnExMbqZHAP_wQJbcWxaLIVfex9lFL-skgQ&oe=6A19B5A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
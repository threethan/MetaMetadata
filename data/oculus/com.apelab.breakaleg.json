w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj79niNFNJIQ7kNvwG04hci&_nc_oc=AdpJui1C96kGSZGWUMNiFSTOuBY1JqsIsveAeyNqEpqpOcHOLfoM-9i924fZ7ZoA5Kg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvizbsCti33uPE6RLBYfs877deuVi_NVOj4EG1B-DHNQ&oe=6AE3610B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqjJkFfsHFoQ7kNvwFIooNp&_nc_oc=Adp4XihgmxD_L-9RF99hiMwnrWZOKsnsshCLiqVF9resrVtrmZTv6M4YNWbmfZR6hUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIK_p7Wf5YdHgltmkb_CJ28D-l4T9kZZP6xwPEmv97Uw&oe=6AE34755"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBbnBFXIdvwQ7kNvwE8NYUw&_nc_oc=AdoEHqhEsCfhmr9pVSyFmexZRDTngAncplZbkPv-3GZOiDsHVUjsPYWioojIMTR6gvQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZWFd67wk-xgvwkENOWcA7DD1rpE0b_Gfl6tpYxnd3_g&oe=6AE33F34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wxh2H4Vla0Q7kNvwE6okx8&_nc_oc=AdpV3KW7z2G8MNb3XDHk_ZLwPpbjXIYv9hmLVwqZLJKQcMIMQKNmL_mg-Ted44YtN_Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_yS90ZhsNVZEtlWeFjkG459LcoNqiAcgcUGv2XdDqTA&oe=6AE366C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6PG85uUlzAQ7kNvwGKF8M4&_nc_oc=Adqd5GaeTlnYjDkdvnedNV02xF8seCRiM68Tp0vtef--Wp2A0HPhzLz03EzVyYx-SZA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoCkw9Jq9O-zt5Yjy486GwAim8SJvXJQNx1EYk7lwsjA&oe=6AE36B23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09OjPwjxo24Q7kNvwHG3E5D&_nc_oc=Ado3cFCot8UU9edR6MzQxOCCSBzoMTV5sM9CsUSk-HMb1IOAI0xk-pMyfayaqzN2uiM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqgz00zlq8dhe2cQ7a2oMl35r8cwnDM1bNp5J9nWRu4A&oe=6A5A450B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-4eIPRuLUcQ7kNvwHU3dmb&_nc_oc=AdplGNPW0BiHi9sbldc6oepJ5kadmICXKM8j-cbDf2RWtvaPJSDHc0sZCLA-0VSqKH4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPYBV7T3vFwmb8bLGrK8BMm82ajnWwmDRg07WEjsbVDQ&oe=6A5A2B55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPZ4KRvPzKsQ7kNvwGxR_uv&_nc_oc=AdoBTjnybAmN0kQblznYVbjOe4_5K6n8gUlYyqXFxo22jje3PIO_DvRg4JatZClO8tM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuQihPArnROY1J4-nQQiF2Sz9EhoJnt7TnE8XviW2lTA&oe=6A5A2334"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yckEk2UwN_EQ7kNvwHDFtpg&_nc_oc=Adrh3b7Oyq2JNwh3vA4SMqSCyELiL5QpfR2QN8dOb7ji5FPonOI1nxFI-R7D-uMPXYM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxSh4qUKEdr_MI5aqJvSPitc5A4TdlpLBhTql5axEG8g&oe=6A5A4AC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tL93-vqf9UQ7kNvwEvHwQB&_nc_oc=Adr9HKu525zosT08Mv6UUs7Cj492yhDSKLQ-U91qCiZ7NDyYYfjzTpHKDgZAC8aaB1g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC16tjPFaqW0O_VoLIpD_QSg1QOIPBYW8cWVVoJaAQhXg&oe=6A5A16E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
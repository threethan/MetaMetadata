/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5BNyTVsD8YQ7kNvwHU9TYc&_nc_oc=AdkbHBj3eJlGwJGVtQAd93mk8ieCju34dgf8Qm55GOKjyXGGgdlRB5OAht0EzUCD8pU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFY96oOtvirxlxz7m2r9n6LNf_e_6XZc0Dk6FpedJ1DA&oe=69AD584B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzkTJoLKJOUQ7kNvwGSd1MG&_nc_oc=Adl7k4VDnQLWOVpe_zkO3xIcxSSCoaJKLPEEeUXjZU_QdIBsTOy-8EEvCHlbwaiy4xw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOL-tWTOITDVVE4PrQrqJrwTHpqcH8oPveXX3xXY3qlQ&oe=69AD76D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAC-EZ2J7dwQ7kNvwHU8oK9&_nc_oc=Admx06AH1EKi_aKWU4mcP07lQovjfqReAVs--Mw0NGsjSMwRJHp2vhLZJwsaFZwYxw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7yQFzMiXIdVGJT5UkA8lYYQLAJY779DQrxt8DUy0DMA&oe=69AD6EB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9-Vzw7ltnQQ7kNvwGJyFR_&_nc_oc=AdkvsNflk_112BOWiYYv1QEN7vNRCvt1E3sa-RAxwwEHHEy453ETrWOmNUr0APReBqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRpTPbmQAduUrnN-CVGJCiUwx7QFv7YEp9e_GeWvi_zg&oe=69AD5E01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGCdW8eDcnYQ7kNvwGv8_bk&_nc_oc=AdnC46GEwCXUtVTfM_mVeJhduWXOmnIZhxcGkU1bjTUdKpHTictw3geLBFdu0bxAAro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvjdZvjnbQSix7OA0o3A3Db283o-qMwZEU3ohENQeNSQ&oe=69AD6263"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
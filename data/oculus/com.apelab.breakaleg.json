s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhEbUS3JGM0Q7kNvwGwRg-d&_nc_oc=AdomDl5y8QzE9f4C4JFUjYlw_RofYQQG7QWAxRWHXxqp0yQQFE_1h5lL6RzBO6W4ugk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xClL33R58r_oVXzNYqFJHNhRrS9k0u53cuUZva2g_8A&oe=6A0B2B0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqhXJFBEd_AQ7kNvwGCpQt-&_nc_oc=Adr1PpCV0JKpd_WLgN96aE8XYQoa_ytXPYCJTBZOQLkPueKokLWu-zlkwjTrZYXy4-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a1-S_55thKKdvHDkpauX657hGjy-QmPbx-uNVExJVFw&oe=6A0B1155"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkQXgKSgmoQQ7kNvwEwKejY&_nc_oc=Adp6dKVMpzXDR6CMXT2yzVdYaGXgsMDW9w5-2anWQFPiwHQX3Qf0gJxpKaxKUcIQdAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M8AMH_yHW88ZAl8FiMS_vvLSqg_6EX5Sw1LZUwSc9Kw&oe=6A0B0934"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbuSkquMY-8Q7kNvwEOVHjF&_nc_oc=AdqZ7BJvyOYtzYpQRLkentfYNRdb4DG922aCDcEa-VxZ0NnZDGg5YHiGE-vQ-7MnXgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zZwvu1ZSeiuSyvH1glxVsh30DnCEcOhk8Xchww8kfvA&oe=6A0B30C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE-uwk4JFCwQ7kNvwHtENOj&_nc_oc=AdpnVFt8vqXBrEbVZ3n5fQfRNGvImGoClzDu6OZEGnGU6xCBUOnFomdkFqCYB8AKEII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_zVpnotR1R9tmzDKSvYm0n0FWv3f5VtDCS2aLlg06ng&oe=6A0B3523"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
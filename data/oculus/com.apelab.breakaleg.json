d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDUJY5d7bfUQ7kNvwGzEufZ&_nc_oc=AdpJFn_HOL87jut8BjjM9fqohPq1h-z6vYWMXPBKnX6tZuTGAz62zECEFZ7hqZRNbfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1Crxi2JQGUXx8O8WCOpMONSi6lzbE_rdlxjwEAtAOfg&oe=6A67740B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihIWbveJcsgQ7kNvwGsXrdr&_nc_oc=AdrFbjKqB3ZA-nPJcprIxWCK2fTwhJ7k36DoqWiwC3rFAzNuQNY2tPEKP3bwKtWLP1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK810Cd92z_IlH_dX2wVlUZ9qgPpt-RliFFtXwZlRKcA&oe=6A675A55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9-U9v5y798Q7kNvwEYKpFq&_nc_oc=AdpR0gIQ8TqjOLReZqlvMLNFtcXh-FoCuXnzW93da4YWALql1mm88WUa25pUU_rRXNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOoiMX9_K0PvejnZc1XuuUb4LzCfSSYDPDaHakZNtF2w&oe=6A675234"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLbRuCiJ-yQQ7kNvwE5bBfV&_nc_oc=AdrC97Z-WP4mXZIIQyPc9Z_wu7w-XkNFuprV6pGT60pxth6x2K3PUZLamQ1NnN31ZUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZx3z_IwyBUgyylUDUWyoMIWYvc-asBBNAtlaYy59WNA&oe=6A674181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zBaVsT1ITkQ7kNvwEEm7cK&_nc_oc=Adru1jCNWhRzFCW0oKRAMePLdU4R5iRQyHVYfQc9_vvUszKemULv3CcHhen2aZTT_vI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCroYnLFuWsb3eY29H4ikVXMdlJRSAx6vHGNRAxnlLQXg&oe=6A6745E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
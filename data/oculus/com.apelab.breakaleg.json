/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWZtcJYxZ_AQ7kNvwE3Z2Vr&_nc_oc=AdkIH7zhigTEKEXvw-Yt6sTIdZm2n5PLVvmoZbzdIMeOzOXX9F1Mp2RV6XFgF_2wG6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsm5PHKMGZCLP6KRvrZuNUxFyolixf6shqHMstKs5gKcA&oe=69A8124B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPXlsEMoCwsQ7kNvwH9jQ8y&_nc_oc=Adm_7TyXwZC1yHrsN59CHeSpU6BUwIz6Mk9NbD677sskxrfhjdu3eONH52S9ax5Uns4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsnZ1guVVIM0UQQSD-R_5wu6msYBQ4qLDZ4yZOoleZiQw&oe=69A830D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDLWmH3U1IIQ7kNvwFwVkrP&_nc_oc=Adl-_mQiasnocCW1Y5ysEezIbswJDGOlWsXTcBgH-Nr_TwUSgftnhCM7Njw0FXFTes8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGrzX0KGCt0vaWsdGYhiq4bEjwYwCqDu65ZSQfrYK4zw&oe=69A828B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfq3ouTIJ6MQ7kNvwGBt3vx&_nc_oc=AdmC-jFpkhUi0ktRTszQsw6zjkOBEbULLtMGnTbkmJdmVoM2jrU3kb403tk2rDqO1dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftxNqs5PBGC_kHILU23wZhvVpPsnpI6OL1rFp_lr_l7_w&oe=69A81801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt7WFi8nriEQ7kNvwGVWlTV&_nc_oc=AdlJcs2o_GQre87_tYSLTMQXH25rdUFTacaSohVfc-c1uyjMMDjmdf26_Jk8vUTgAsw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_vvH2_iYZSkgC2bYUY8veYIh32UnKhnOvgqsETwPAfQ&oe=69A81C63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
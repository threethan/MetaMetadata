w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29Rie49DV98Q7kNvwEKzF-1&_nc_oc=Adr-4dOH1njR8UHqPz-lzx_LT5zfp7EmLU3dbYa1vxlNvvH_G6rsii5d8YBm1Umn9pg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29Tbfu1UtDNMHdlDRmp8eXlFLbPjDUHUkgdYEcHCItEA&oe=69EF7B8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38K4bOTcrJ4Q7kNvwE5AxQZ&_nc_oc=AdpKLQgk6RFJg9q8jN75gByG6fPU994cA_iFOHCJ8PZ018NEFx8ipVEuBBz0I0fAqi8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1U3l6QhH61OdTseOlDLxeyneKotDWsHiFqoQfJr0nJGA&oe=69EF61D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_9RsYz-rqcQ7kNvwHTvoX9&_nc_oc=AdoxdHinsJGRB77TrrHFMM-fHcovmBCdRMRjxeJmzhe3Yzz9uGDhtFzF3ECNKRBhyZ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VjFHixR4DjQas3vnACp5bGI2BRyJhqsCUsurgSJp80g&oe=69EF59B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oHV5ZlcC_cQ7kNvwEyRUOj&_nc_oc=AdrciqIY6bK3KPPt-zhFO3ZSTcf0671dDYIww_ENg8L0JYOiD-HLNRMDoklUVGxuwbY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uVImQsYQf8uUyV24gQmYnffXJIeWgQ0St72xli-UvTg&oe=69EF4901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4Nu1WDi928Q7kNvwGlVaaR&_nc_oc=AdpytmmSvKZEyjG47oOUm4KJMXo7pFbRm5CQ5jx8foroH0C4hoKZDgaCRM_-9RKH4ac&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iJjKu5hg2ZBnzjW_FZFf5C_XAtG_C8j18QWASUSpI5g&oe=69EF4D63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
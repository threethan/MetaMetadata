/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWZtcJYxZ_AQ7kNvwG4bAt_&_nc_oc=AdnNjTGHDsDomqRFq1aQEYCkEldJlBvjwwiza7zlMSmKP88BrMGjlBgHmcCbPbYzWxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvv4hjGiVkkR6xu03YCBzuY-X-YkBCccNBo_wQP_JWGZA&oe=69A963CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPXlsEMoCwsQ7kNvwHhPCUu&_nc_oc=AdlFUTaeGdO0YNzTSw5oZj7kpOvO6FarDZ4b0tljkxn1B6CqwO1HZAjNg02DoVaczC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvZgH7kb3jMMviMP6iZkUUOvWAMX0GuvNGIcwPk9wNZAQ&oe=69A98255"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDLWmH3U1IIQ7kNvwGhaeRZ&_nc_oc=AdlfTKkxnOMG0KBL1EgL6cVKBi8yvGS6ZRT6AiznKmwY35VRJwMRJ_V50MgUJUuzqbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftEe7dQ6-0p89MND05dbHUTpczJJUI4xvAoYwWOE2SXhw&oe=69A97A34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfq3ouTIJ6MQ7kNvwFTcFKa&_nc_oc=Adm6hWOpOusPT9bELvOM8rWGQNtjS8g1eTTbM2ec02xeSGlr0wd4TSSlLwXoSHcNGBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvaNzYjQTl9uiX32TfTSAMI59MIcsxA_3Igfx9FJcNvRA&oe=69A96981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf41GFxNiDsQ7kNvwGfue37&_nc_oc=AdmvWO4dhwhVtsbrMnEQG3jZiIbau_LxBrmw3Lqmri-YL2ZXE9UkE4Cf_c3F-iNLx9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuMBb8kX9MyKOL-QF-lAq798FBPltdC73Qyzp9cmg7i0w&oe=69A96DE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kEEEJyGIOkQ7kNvwExqG6c&_nc_oc=AdpmeYFaIcPul-ZT7RAMWr0a-Q8uIBs_uaqsTAL9NvkLFY9fpqOrgFJ-qx8nM19oVFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4vl8tJPWBbK9GTIoNwAWQnp8zZTxJgGCqT12bfs0mA&oe=6AE9F88B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEUx-XQubTcQ7kNvwGiWKlf&_nc_oc=AdrNF4YWRMZm7UKhC_1m4XIOoEKp9rfw6dCByjX5lqwo_nO7z1tBXk3aprVuJ2r8ozY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjc4Fh6OSHCILwOVPfHspZbOHonXZK4jPzUtBFYtMwwQ&oe=6AE9DED5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qydz40jpHMYQ7kNvwH_TWmN&_nc_oc=AdpJlrkzzxiyMjmxoGmrzu52w75WAv53BODUJiiUdXPVpXwEogU8DMAbMsFmgxOX9_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIMjSDbnBMiU8zR5qBzFri3aFYpPqH6jNEjQQ9Lra2tA&oe=6AEA0EF4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvn2oFB3wWQQ7kNvwFuSXZH&_nc_oc=AdrTtIgNcERSmtXpwFobPzAXdQpYD9nEnRoGgCdEZnvH4jjnQs9CNrOU-VQjClwSiiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8vcVmiRxSKU0IKPWtlyjEqXkzQ6dH07pqeQui4RDAjw&oe=6AE9FE41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKOXUpu-LM8Q7kNvwExFxfP&_nc_oc=AdoTARw7rPUDrk2VHtOZ6slYzO7Qqvb7MGxcuMcDv5HULDw_dfQ6sV1pMNiHD3aSB1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_6361HZAhr-F_BBdBwmEzaQZL3DilZ6YSc4ACuo6xKA&oe=6AEA02A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
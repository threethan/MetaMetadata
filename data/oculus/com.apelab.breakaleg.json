d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6RJsxbpf2gQ7kNvwHpRztZ&_nc_oc=AdoHrRO4Topp8YHe-oOVd8gE73K5kKxq4feack80e0n3OO4e4zxpk56dFz8Fu2carsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESTf10qzwka3wnZk6ORD2JY6Cc2_js--q6K4-8erV-Pg&oe=6A78978B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_a_r_-DKjQQ7kNvwE7GAaF&_nc_oc=AdqTDxut6fAsiaQmTADRHsiUw225COUqsXyrtlzS7Pzva2Jib61Hns1XvpvR_NfHoX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3gbVtIRt4O6KylENYcbqmSJgQh-_xXybw49OC1NGidg&oe=6A787DD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJjuA77dvfwQ7kNvwE4Wz-S&_nc_oc=AdqMjyFpgn32p8nyFSV19sHkFQyKLJ77Ez71DOZJUqm1eSb4PRun0KmOGysKdmuguhI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_4TpciP1qpBk6A68EKxPvF9bDOCsJt4V1JAxPSatxqA&oe=6A7875B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeqzKQbgNIYQ7kNvwFgqcxi&_nc_oc=AdqbYHKPYIgeVP3rLFUiF-gJ6cf0pfQaMNJLyaZNzqUA4OqueCk-cKHOwhg286CSodo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHD1WET-vJ78MNQo9tCg07FM-3jHDD-jRxLpD0KKAIkg&oe=6A786501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt_WNCc-neIQ7kNvwE9lo6P&_nc_oc=Adp7BGQFh7Ok6CvngaQ2YFFqoepJENggsYzX5Q6JHXMYyXuFQDcdbtmgl7LSjmb8iSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbE0vaEHZn-7T2wm6i2fPZNBzHhRLRIhKXZG8dq676wA&oe=6A786963"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U-dyjl3G04Q7kNvwHRXjCC&_nc_oc=AdrEkNa1BpUHuCgH6RxSpfdYvXGFmQVYaKOcWpFgKtxcanalSmPRbBCD34vBIeuZYm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGehIkXe6FfGMUuyhQHu2jjYdbR6J-KzrVNElMW7vTyZQ&oe=6A74A30B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAbLbSeW0AoQ7kNvwGdy2bU&_nc_oc=AdrO3X0cyvgZN6kdPEXQF9oa7zgK0hZZf6Aze_Shf267LpctFsIvqoOgcFfx1HiWqw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkF3NrNbAatkauDx5FGPPCF6J64noGb39CsKUjkW5qCw&oe=6A748955"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_x_1fpL8n4Q7kNvwFPb1dr&_nc_oc=Adok0oOaNI9Ra9ES-MUqHZO5T9UVeQev23UzfzGSREd4SL7Ror5fGb79pvERgkyyElk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdgoFwbz6j1uP_mzf20cGqv8g7bvt1oB6mLgVKnPM6Lg&oe=6A748134"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoGiZ4LxOCIQ7kNvwHBM6MG&_nc_oc=Adqj9jXH7wCi2aw6qfzkXxWzOywO2Dd6Z2bF5v1-CnfHrOqWlexAzcenTdV69OlwJSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6UA5b8wVFQ3NE1o7YRaCwo2A19cXaQKISoEdd6cS9Xw&oe=6A74A8C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kICcHUj1WsQ7kNvwGaF_Kw&_nc_oc=AdrxeqCr-JdDOPYaG25mL3d-atGTZax4SMhBK_8vRFriGFm_NGhJPwvBItR9bbh1-mk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbmWbtA6gjCV7LfYCUlGrNSrFyyS-BksuNONTruenrxA&oe=6A7474E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
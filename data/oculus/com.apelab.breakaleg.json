c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVMPDAzD-4AQ7kNvwGaiSPW&_nc_oc=Adp8BoLRZ1YC0nFY4oQzJ--lhjWXuYbbX04OeM-lfu7zzy78vn2wrqQqZiLMosMQYng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrnQuNg0z9KPVMfNX2ZxV6oQsSkVk9G2Wh3bsTPEe_5A&oe=6A6DD34B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7IS0GEqIu8Q7kNvwH2BHOt&_nc_oc=AdpKF6ntSjotoxPotLuEaS2RQitLTYB0xjiAePkPCtXmPl0JBp9tIH1o6tGyf0UTnRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvEuHKIuQA9jV_xO0Psne_r7lnx25lbKxO9BARl5slWw&oe=6A6DF1D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=193yXhHE-LMQ7kNvwEpu90g&_nc_oc=AdrsNIO1YLqCwHjDo2F7j0mhWIf9gCgYbBc-WM0hi-lI9HO4jdo3I13IObnIRtYA3dI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxnR3L5xJ1z1HuhARaisOoUNDo1BwDCpCt6K_J5BxX2w&oe=6A6DE9B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxLQcdleMVYQ7kNvwFRtRmD&_nc_oc=AdrjzfYvFynRQ4MOcZmBL9c0j0-9AGN9qrjVczANaCI9ZOj51rRqLAUrLvDKD6V0Z-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwp_rUBtZWx8Tqy3mFXQ2SvURO5EaA45R9ZLzq1gq-cA&oe=6A6DD901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnfqy6Q0QzwQ7kNvwEmN-lE&_nc_oc=AdrajhcoQoyOJ0kplPIW6M_WH-IYmtNTiFI217mrpqAoMvKON4_Sd_E-MGH-LtKz5xQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkJyJ0Ld-oloOKC_GBipk2lbWTteI5yqEsfDDwBMJc2Q&oe=6A6DDD63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
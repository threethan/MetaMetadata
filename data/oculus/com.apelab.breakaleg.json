/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrNR5Kf18rAQ7kNvwHfHvbC&_nc_oc=AdkrtPLTv2YLLulrB1EBX0W2BKd_sdbi-wqokLZQ7YQ2qmckc9eghP63aG3WFagr_4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsLPRxtIOnsmtV7sHzgr_EEVCDJtPdJ1Jn_SCcDRX37g&oe=69B935CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP5N0JcMwkMQ7kNvwF3Hnp-&_nc_oc=Adm-A-sVyW55vilj_3BGhsDNxt4_jBkcbBUI1U7r9ShA_9npEaY_axIdvTh3NUVAE2s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvwQICoRP56SbfkaNVfqlTw7FzArdAyx0PdDnF4lSDOA&oe=69B95455"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyJP1z6deb4Q7kNvwGkbxYs&_nc_oc=Adkcx2lyt8fKtAPs0uDcsaaiXmm9xH6E2Tj0VthlgkHxDeJnTgwIVN5Lu0nD5ndbvYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwjj9DfK5XxIxlCxa4FpgbH4x3O73RNCXWLXMGj2w-H7g&oe=69B94C34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHT8A1UNUgMQ7kNvwGo-qjw&_nc_oc=AdkXp2vNwBO-YSi0at84VIekk1vvEvZmP-R0W4cHZ8VZ3mV9nReP8tJ7PW82cELkzbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydpJ0eGtWv7CNUcHhzkrhHm8EZnpXmqC2lJS9Kq_ZA0Q&oe=69B93B81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0UsXk0jHTAQ7kNvwE-Ft_x&_nc_oc=Adnl22KL39o7O7DPwbA3xak-TA1q4lvv4HcHz1wAdIR5wCrH0n6VGEz3_29YBPjFGVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-V0eRtVI424BFGwPZYVUl-ZaV_uWBhTihxjjGThqhEg&oe=69B93FE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
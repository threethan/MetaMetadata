s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd3ihXLy8skQ7kNvwH5BRr4&_nc_oc=Adq1mKeYXpImzPpKM02C0as7UOVS-bfq_Q223wOfYlN-G1U5Dj4Dg3TGwUuRl8CbJ00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKH6_wktFW6atU190Lox2VM87dwKaEW4UT5G3FKv8Lxw&oe=6A9C300B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnNI-H7U2e4Q7kNvwE2gIM_&_nc_oc=Adrmh2F88xUQ9QGgo1nQtUJoNM60DWS31KpNf3XlDOIhgv1WmNNUKXvGdjfb4CcScgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw8ycqt_FBu0riw_UzFr0ojGdA9dWNxEEhH42_2xRAZQ&oe=6A9C1655"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZam387d4h8Q7kNvwH-gj8u&_nc_oc=Adp3zXYn_HjbNb5WWGzD29-M4NVLujt2xc5qmM9FTd_C9N00F2K8EqUJnn293qixd0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3An6Yi2OxIUJC7dM8QgCsLjc-nxqSkOxOJeBreut-rA&oe=6A9C0E34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu-LXdX1uKkQ7kNvwH0pDuh&_nc_oc=Adp5xkOJN7K-Fvurhv5cJ3kIHIc7zkQ1opUfzvLJfKwyDPFfJcBty6UyobYMpUjGdMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO89Qonw-6GdXcPDaUaOoGLVlJEMUP-vitZNVuOxXVeQ&oe=6A9C35C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YLdIOW09hYQ7kNvwHxrp8K&_nc_oc=Adp6cu56hkHcYPMMKXhwMbQ1QeBuEf5jvGCNx4hKu90IQqcz-dMtDPdeND-g3U7cXOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFkmPIOUat70VasoQ4Do14rg0dKZ0rKn4UzmUnTTbSnQ&oe=6A9C3A23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
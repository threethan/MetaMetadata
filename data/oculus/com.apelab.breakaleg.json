w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYUAnnsVSskQ7kNvwF7WkOb&_nc_oc=AdqXC-YnZoB0FloqamDxdkKfF4NVzcQeniD2HyNA882F3d7Z7_qjBPpymayyMYtOaL4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEqSAsmT0JgueG73191yOoZEzXfbTlqyXCrlMoVpJfPQ&oe=6AF9CA8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKl2YitsfC0Q7kNvwHX5GYd&_nc_oc=Adrz1Q8k05phC7j_AKhATHwMQTz32RMbFkFO8bZcj4aBQgnDJYxY1ilRxvWSnynAXlI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1kJkMbYXKLddYqbH9AH0Kir455fVtnC2MwT9TGGpovw&oe=6AF9E915"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HugKi-mVng8Q7kNvwF_Marr&_nc_oc=Adq39_64X9AU1832UhD0Mwax4pr1VAYCsfV-z23EFXqg4jar1QZuNx2bPT0EBQndJbs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH73juzAkBRmza5tgqiwQgB4akfk584WAgecxrrUhilw&oe=6AF9E0F4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6uIcy9VRgYQ7kNvwGRRQck&_nc_oc=AdoMiOvDZwIx_qcDelSQgeSWZHFAKkaRG7QtcAxNRI1uF3d00Xc39b8LR_LlJrefFZs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjam6-ZnKQTbxbQw0romokWtAwQ8oeqPjI-JnPLjU0og&oe=6AF9D041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoaQ92Xb6NwQ7kNvwHz3O1a&_nc_oc=AdpApc6dpSxpniQENy4v6yYgNteNJev09iIMDrcqtKBrexr1M2NRRl-OGX75UZDY9wg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScfp8OdvF_6su19KRaM_Ek0zFdtVgTlnVVSSSGHaUAgA&oe=6AF9D4A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
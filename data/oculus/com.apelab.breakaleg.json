c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m6CTthUaLEQ7kNvwG4bLvS&_nc_oc=AdpJYhsKvK_G_5C9lR4gPckIAAfFC_R8dMRneJdABJWol_Vd1sBEguj4pLytKZoFuOw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cxZ1yJTX8vI1dDIPdSLim1uiG4Lvvi6XB1ynteoAxWQ&oe=6A428A0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK2cAvH2MekQ7kNvwFzDoKJ&_nc_oc=AdqBRYAhzmmHtorBlLMImc78BmOifFQzicNxFJpqJmQuIr9utAL9CyvhGNJnowFefrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kM9estNuCs013pfmYnpuVjZQl1L05rzX1BUNTENSajA&oe=6A427055"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx0YGZnc6UMQ7kNvwHBtC5m&_nc_oc=AdpgS6GNDBrEH-KmQLUe5b3ZJxPhh_whSzkN5op2XL-gtK9nKv9wL2YMmU2EcYJLnR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-he1rSVS1EQvmt5LJaZlviDucR7ODPdbmBGvvd_LNjsg&oe=6A426834"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnWSgiByvx0Q7kNvwFOzfoV&_nc_oc=AdqLZEa-eBrhAfuGiytSMbXGf_E6vHmeYoekPdQ7oveaX6ajrPa9T1TD46ygV14kLwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RJZ5BPQX3YoAjGMdWoAkJ2sSr_j44wfwYGASaQD8CHw&oe=6A428FC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVDK7EVwIosQ7kNvwHU-5Lm&_nc_oc=Ado50HRDbpUOrd0bLZpbmZI-IVAcjGtjkzEsxBIFs5vz6xufYDyZgNm_cbqX5xNRHGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ib-gMI1hj-yTmNKrL5vCSNtZ2U8kC5gvgVmQvrhfoqQ&oe=6A429423"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
r8-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10eOj810wn8Q7kNvwFdFBit&_nc_oc=Adrh1c_nh68v_lNR8uaJ-wswSE_j1yiHKsa1yPfQHl4JyuArhw_qHjwbVwpFVOGTUEQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zzpK7aaINVAujvhCyPJXYf0wU0-fWRmkUXGGSfWT6AQ&oe=69E24C8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc_dsEurYawQ7kNvwELSWUu&_nc_oc=AdpWMXKuunz95xuqGdoq07ha7E3iZFuibj8X6ing7t0PjRsRk1qEqdOFZSe1fBA1qUM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aSEbZe3mqJXkvittx1W23szxpOc9LRk_YsrZ9tlawBg&oe=69E232D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUf42fvJuX8Q7kNvwFkrxBq&_nc_oc=Adp5FPVLD4CFAHAhMyVU6_AxzFI156iAlTtVhJiIGQNdmarzV_6puqb_pU9D4s0aUUY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GguK_NoNFWQXsJyG4_TrOUajZXCxSNvr5f13kDpzdUw&oe=69E22AB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0ewe5HZrgoQ7kNvwHB4nkW&_nc_oc=AdpDCcV5reKsHc6KKPTw8ZpKJbvFeFAk1-LGCeRfu-MF9KGaHz2lMBfSfPAkBwkRaKY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z_7R1dvjayK8hORyFRVJw3jzemNiU75bkEnYDLQwFww&oe=69E21A01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG5Yacrf6JYQ7kNvwFVarpd&_nc_oc=AdohzQYkPTZ3IFRxMsp18F_ouzssRlFkouYMFHVQfqV5TzLvlDAD6FQhg6flHmxC5Lo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SSeA-MevZM6GERVno3XKzHd0d69DPXuZracO6zZossQ&oe=69E21E63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U-dyjl3G04Q7kNvwGqt8yR&_nc_oc=Adpf8pD1rcSLj40BxEMI2PKfsSQWgNyRSdsAtjAGif_VezOBn-cSXeTbsgbqqMzo1vU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErfLID-2ouGLY6_33sdfJP1uOshsl8lr3ON57wry6N0A&oe=6A72000B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6rhDWHNiVYQ7kNvwGrNYzM&_nc_oc=Adr-GJQyWh4vrJ6IXjPzAbYTfz3pYmkat9I9GdFJm5OHXK7HiNtEyaWRcYjbNvrpJ1E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3y9eyl0pJF9J6j9DO91oTFDIOFgA9T8Ao3OaKQ40jWg&oe=6A71E655"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_x_1fpL8n4Q7kNvwERGOTU&_nc_oc=AdrGI6PCBEGVWZqc6bsWHebZmPWUZZmEQ0GqK2fKWlMsExcRGaqzreyy76X1ok0BDg0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5oKJ3IR6rKTwS-s7zGkoAmxt3jkVEk9A1nFgirSCkRQ&oe=6A71DE34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoGiZ4LxOCIQ7kNvwEyC81g&_nc_oc=AdpPIchJElrTemwguQUtuRflHgQZbUkQgjNImICHwwifyA7rdsXVq0v2Kq-VuNwP3Ws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNCmXOAsAX_gyCj5ohXc4j9jHPjhSK-Cq5uQ04LiFn6g&oe=6A71CD81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvQzywHWpYgQ7kNvwE1t67p&_nc_oc=AdpxW_jtFjJxob6D0ikgMzuAWWCG-LidmSwu8xQGzjEuYUirIkx7lpSJPqXDS5pYoec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8IoziPxF8_L00kjjO8aSthrIiJLHql_Unci1AzSEtpA&oe=6A71D1E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
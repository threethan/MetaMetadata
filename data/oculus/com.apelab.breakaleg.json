d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB0vuT3VtrMQ7kNvwH0OxH_&_nc_oc=Adplr5dZ-THla-7uLX6jmxOf6nfQNOa4n74Z-z6t9g7sJzgqyO0WD0ZR13qJD4W4feY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wXJs6fghrYxh_OnP-3489bx16OPeoOE9C4KYixLnTZA&oe=6A3FE70B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALhjvKlVf08Q7kNvwF-ttT2&_nc_oc=AdofvuO8S56mFVZ9dsBYp-Gl6IygxGS3OHMQB16nnooiVqDYy1lxvJzIfJ9rJW7NNxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mf0ms-_9W76oYnjdyNFjn7enhGEQEoHCIFhPUOZGvdw&oe=6A3FCD55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjOZqkeledgQ7kNvwGv89nE&_nc_oc=AdruOPtQCVKRajuKxLR_YPhqyQYj_kOCceurim21mL8-lYWbnroHUueDIzc0sQUaDKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2xSyZUPuWo7qI4TlK1hI-FuYRRRdg24JpWNh3Ii5ooA&oe=6A3FC534"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUFVqOQ_TokQ7kNvwGBE3nZ&_nc_oc=AdpIPYzLSDvOX6rs-Uo_MPBMlrm5GTMgmQ3Pz2_aETpL4CLJob3hH3gcP_Jq8CE44Qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E0291PlwSFsnOc9vuzdc3xtp_sGE5xR7lnjSfYmuqNw&oe=6A3FECC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVDK7EVwIosQ7kNvwFxMntY&_nc_oc=Adp2ULLxm6wytgLBqHyZ5WpW6CmopbxDywPTXWqKo8keCU060FeIIpJSNEUiTeLvaOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BdL9M8NPH-DIgd_L1vpJtqc4VVxuCUsHk5U0M__Zs0A&oe=6A3FF123"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
a3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smXSRyWxD5wQ7kNvwGGwN_-&_nc_oc=AdpES7QqI-MSB_f7FeDJ6BeuABzPSWQct2gt_bTAjNVT4gGSCkxthjQBqRRu0pvKSw8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dNFve-isplg3W4C4oL3cW8Fq_1RBI2FP1LudMfpg2zA&oe=6A1AFD0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m815XCMSK20Q7kNvwHNd_TR&_nc_oc=AdqBPFjsbL08-vo_eKDmpjBWld1AYMSdPJwcgAZt3iSi2ITq1-M4yq3QVuM1XyU_-S8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w7Jt3Co5Cy0OlC1sCV3MHw5Kj1Ym7zWaOv_Inawikmw&oe=6A1AE355"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmGYY2DlM1kQ7kNvwHf1QTe&_nc_oc=AdpxtRACkilVCNYoI4EYrz5alq-dkB3Y1_tBZEemBQd_xLzXJ_soOGDAtaaxYIzYXyE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ano8gf7jkt67crFpkTR5JNEpfRL9Mm70Gam1zIkTtXA&oe=6A1ADB34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT24RTKpFbUQ7kNvwEmcu2y&_nc_oc=AdqHvOj1EUbwVEg9fRIVb0v7e-vOD78Dj0ea_StWOSM9rBdxsUmTNmIQL-6aGjsJosI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BO_fSUppuWPMxluLaMW2eeuApLvJCPibIBUnwSP1mJA&oe=6A1B02C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfdvOWD66qsQ7kNvwFHRiiS&_nc_oc=Adq_dUEdUnfek0o1OBQtTE5FIbaTyolgnPARXf61xP5Rb8k3ORac3LsWoUZVffytUMw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P5N-I5dNc27zmmpqI1APOCe1NfJEuqLERqjwg0JpyZw&oe=6A1B0723"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
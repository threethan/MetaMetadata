zuAP4nQck5_P9Tzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3y0bOVu64VF86I8Psi3z-2qxnRbIEDknV2J_lFuGujWg&oe=69F204D5"}, {"file_name": "migrated_image.png", "id": "508436326728391", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_9RsYz-rqcQ7kNvwHLBWZZ&_nc_oc=Ado63YVLzH6Nf-j1qDh4jxafFQOBs59bEiKf7uJbsWo_ySkoW-evTi_KWVqdNM_FixA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3wDYnWuLRq6hKvL-ZYHhXW6vgPyFw-RMBhv1sLIij49w&oe=69F1FCB4"}, {"file_name": "migrated_image.png", "id": "196592148452346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29Rie49DV98Q7kNvwE1BZnz&_nc_oc=Adp2AFPpeNt4YJ55c58QTRIETgSTe2iJ1w1Z4wnjBGXGfaNe9RGeFmAQWcNmyoi07LY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af26xYWXqIRreFg4TOvcKEoIqweDaiF1juYUnrQj0IuIiQ&oe=69F1E64B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "129032964466611", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162708_129032967799944_8089233936061825024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfTP1fdbbEYQ7kNvwE3IheB&_nc_oc=AdoyXLUtMw729A1S5vDYB1cGQebSUSY4uc_bLSVmWbGZKB9b2PH3s8XEbwtU6FN-cDs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oEFXXh795Ke58Q6S3L3zyRSMLKl07Xij8MqqIywDb7g&oe=69F211DC"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "You have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin! But be careful, they do not like failure....", "short_description": "--- FULL VERSION RELEASED ---\n5 chapters, +1.5 hour playtime!\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466098328345905"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "280372589410782"}, {"status": "PUBLISHED", "id": "2332927053410945"}, {"s
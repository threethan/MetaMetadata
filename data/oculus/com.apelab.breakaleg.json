d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v8hZ5ZQ89oQ7kNvwGQnmE4&_nc_oc=Adq7NsoluMG3UiBNp5DDMoGrWm4_Ngy96O6KFgYbQ1BlGpHUPeXGIlaM_y3K4I6TP6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ee2_ps_Se24Gj9av7TyEguR9aqj1qZNtwErnlqz81QA&oe=69D8D9CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RnbNrJTdi4Q7kNvwFxRhX-&_nc_oc=AdoK3cAVYKgwcvFghBohGbFc4grzda5rHP57U7eV4TCpv3mwNlNT-66nSUIEFfiCbok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J090-_bFHH-Mlvb1xl6TBJtYEgMvxtk9RUvaPvsMXRA&oe=69D8F855"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7rM9v_Tby4Q7kNvwHC2lWn&_nc_oc=Adp_HfGbQtAJOLzEoMLMF_503W2wXAManvA1dzNNE5TDVLc5oyGCaY18pF02uCup-UQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O3ZnrY04rYLDucuSrdGewfReQpccpmU8z7HftSzeVVQ&oe=69D8F034"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szxpJYzKt8AQ7kNvwFm44WC&_nc_oc=Adr-EJ-L9R3eTQ5MylMyacQk9yqm6yt655DV6Q6wHe5cm_cvWfRb8ur-UO_9SBfSSQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yo9_pzEUjxr3re6rwMEak2Fs3WlJLM0oGPQimPkieFA&oe=69D8DF81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmcmcnmtp8UQ7kNvwEkDb9k&_nc_oc=Adr4U2U_LiYEJC3-vFcGzFnKiQjS0b6rJs9yO7b5IXo1mRZWj6_WTgZo1nsnMHBrlK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z5FO1ZkS8gpf2Lw9Q8kC8cg0QF_ucQ9M1knoj-RQJ7g&oe=69D8E3E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
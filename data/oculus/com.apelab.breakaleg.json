ntent-sin2-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTVa3RWKvAwQ7kNvwE2rR_d&_nc_oc=AdpfXJXKmfzIhAALdLm6zo2krRi5d2dmji9oYv4hYgttg8_OgxcNjX_DFrfVoPhSgKs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7ttiZS3uAPyuievIEb7WgUo3VzwIhYgJoQkvsykK3Ag&oe=6AAEA50B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66Fft6rLgE4Q7kNvwEUgSKP&_nc_oc=AdpQYU1SaGQEk3aXjBVVGYoOtZDZJcWizge9e829vVkD9WiV6vbIgaOz77A9gFRsCk4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFdFWd4v9Nqq3T70Qzj-JHIcLuJ57woAla9GdcejDOhg&oe=6AAE8B55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGgMSfSJ4i0Q7kNvwG4Gsvm&_nc_oc=AdqGfDcPzftpJd_X6dHQYL-Qd4P-4NPwtwGhx-slveXsdivkmeSl4TV9K9Qi5CNcgSo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqlaBqFtjcNfvy1O-pWI4_fW6qPKLWfuHbY95GtJxJrQ&oe=6AAE8334"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_mAx_28UAMQ7kNvwFB2kb3&_nc_oc=AdolKI0HNpaTamjMvxMa_CASSC9uIfMCT9fHnMC3xv4N7kyc5CcJBnySk2gpBtnXoYQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPhdd2mQwDguF4shdCkmddrSQjhniUO9m4gWPA38KvTA&oe=6AAEAAC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnBTOUXR8fQQ7kNvwEFMqLZ&_nc_oc=AdqSqK817NbIfxiIaeh2ydyCpncyJaDSGW6KD4rD0_ceesus0U4_QDmTtKiDyzXhbcM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIptfJoJgZXCayAy8oUHVJKybQeLQjYo_b5VMqxu2-qg&oe=6AAEAF23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
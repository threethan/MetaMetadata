l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HTe75yorrwQ7kNvwGoGyRJ&_nc_oc=Adp0iFbhpwYjEmXHC2u4KTWuCgBhrMVYoXXjIVmHsf-PbRDoj4rcmjUe15f3WK8ga4A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcGHolG-9p5-i2VzJ0QqIh4C5wj3BA9CfiOK2hN6Q5aw&oe=69C3C1CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr78PSffQ6YQ7kNvwHBRlPW&_nc_oc=AdqNJDH1T18Z611i7UsQaci983nb_G-eW_IMxwr9BX2Mn_itJ2vNJExzXiQWTboO0Os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4A1gVHQaMPjoIje_YN7vMp_BQo09hlEUjEtsL2uwKHg&oe=69C3E055"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqTAHvzd_HQQ7kNvwFSkZZR&_nc_oc=AdoLiYqtnjVFGkYQ7DDZ6Lq-UNwHWaztAqXhXJnHpJ-mtCcfllcsEBFL-taFjM71t9o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4TfLGN-fk6yMKwm3WBzLQ6ouqAWpG_bJrveB7cV0kHQ&oe=69C3D834"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzoGHYmVvwUQ7kNvwGUvE7P&_nc_oc=Adp0zlihDLS2BQh0xWrlAiEvgP5yhWPJ0TKDZ7A3W5TrcurDjpkj5jyyP2lBeey_H9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypVzyK6j7gqhFYz-R-_r1k5AGGiy_TFye0XPJn96DH-Q&oe=69C3C781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI80SB4z9VIQ7kNvwHjNDGx&_nc_oc=AdqIoWCOCU4ZLdeQHA5buKrx-ZN9E8XJCZUCsZa0RJNvA3xHBPGIaTKvA7-eONtyhUY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5dV1J-uJZNqcl6mHe0v3z6LIgLpr1Ul5THuh_xfRWQw&oe=69C3CBE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
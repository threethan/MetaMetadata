d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhEbUS3JGM0Q7kNvwEuHOjd&_nc_oc=Ado4iPHxy1eOaCxOSmAEjJEBqLKm6s3CNFSVaPuAYiXgV2hs2R6_3zTD5sEZItuUxjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c2Tl_iJh9pBO7kMaFpFZX67w6Gx6Xh1twvpQBRcML5g&oe=6A0DCE0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guXRQCNBYFcQ7kNvwE8Wjz1&_nc_oc=AdrCr9usE_3_0x9gDqj3MZo8sn9PEig2-Px_G4SwTuQk9Xx-qi2eSE9mh4iqut-L65I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x3qqtYuo4arpMf5JfARVabGiQwleukl8zZY1vYcbVAQ&oe=6A0DB455"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkQXgKSgmoQQ7kNvwHDAOHr&_nc_oc=AdpKGrX26rLBmBRMZ49AQOPjyG1h4lNwFvHcNbNz5vssfNx5gH4I4Zm4u-x-zWPL2CI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GzDKvcWQaPtf1mXdPwXmBoflizp0nD09iHdvTO_LK5A&oe=6A0DAC34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbuSkquMY-8Q7kNvwGx9780&_nc_oc=AdrgjhfE6mpEZnWxWA6vRQ-ztDtgMbypw6GaQNMy38ynxhABFWbWCINczLBOrtWyEKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XV7QYBE4WPngwsnQ5ZJm-SwISKolFFoOaYqZhMvYbmw&oe=6A0DD3C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgIIBoHwRfUQ7kNvwHnFukt&_nc_oc=Adpcet0H5pbp_AEylKjP3vPJbvN0jZWwmEx1kfJEzYmdAp4fonOqonfRoi1I7_8ejt8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mIH-KZsIZqSuhy8jBuhQfw8sSx1l6P_GVLtEnGqpniQ&oe=6A0D9FE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
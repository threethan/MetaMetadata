d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14O5XZghza4Q7kNvwHvJVaU&_nc_oc=AdowNmdJ5-MEww_SdsIMdolbwoM6bdYHf0lGsjLeTrHHfA-ehXfPVqTUd3Z4g19TMHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23mxkpUGFM7ojKWQ0QGLCnMb8dP3xEgWc5-KW7mIN2Vg&oe=69EB870B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHlyX2JqkucQ7kNvwG3DOgm&_nc_oc=AdpBPJPZAi2jy2GVuV7rra4iLr24tZOCCNlHbp5-ZOFIMqZ2Wk-3WLRxOAWZ3I4s0-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V1qw6-47Zz43K3SmkdgE1vQ9kO-fD0wcOAFtH3ZdTCw&oe=69EB6D55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVrNVYv81-MQ7kNvwHcAyFx&_nc_oc=Adp9G8gP_yXOXOP4XcKqFg4nIdKlGxSGNri-aM7tltmxe5dSwRN9HvDuE-Ac3x15ILc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tdc67NALhEf_nyVArvFs7cH6UX2vpBvOLEqF5TEl5XA&oe=69EB6534"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7w61Nrm3lQQ7kNvwH8iT62&_nc_oc=AdqqQauVRl3Z6uf5JKTlObKwgeioe-w86i4aI6JWhPhYr2N8L9lMC8rHcAEnLld5_zo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pzwwoWrmS6RAxiNzCFRUdD22gKTu6uHzlMvC_NzIhMg&oe=69EB8CC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x07CAUbCFAMQ7kNvwGXeWXY&_nc_oc=AdpHQtsdJCsNt4DFLEO4Kg28dAa8yALXekQ9Xcvkg0CzXGHrZqeuc9ijGUuV1R-P4QA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05izIdOUQMLJPpLMQghMtXxT85ZfoRpd7eTSHZFSUf6Q&oe=69EB58E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
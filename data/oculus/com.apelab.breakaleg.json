d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_5qKPCRSncQ7kNvwHAB6ko&_nc_oc=AdqPed8Lhh7ISmh2fyLs0sK0wDNZ5BoLGMbjPStXGyf6v7k5JjQJ7KQ65wqWoqukLgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB6bryXkRPkQot8FiQEdekmUnsSGAgtPqHyIqFeB8yuQ&oe=6A60A44B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voZSu_a-JjkQ7kNvwE2pWV6&_nc_oc=Ado6pQQVBLxXUzH89P3Uxg3Spg_xQU7wWA8fYjSKK9etXMGzMp-YXw1lx_x0zoBjJmQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh9QPnw1LlMJQ8BUqUEgYHJQIeBdWuHdUV1Yya1r5m9g&oe=6A60C2D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r7Xx44D-gsQ7kNvwGgrnVf&_nc_oc=AdpYnVkN3iZeuKH4BAOZl-6_j_wk1fFCwwKpjM9h49t9r7BR_ot8jL89YX1PfDPo7cQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCADa0uB9KobwrAt4KKd1n1Ra2H8cK64_MzAsblN2l5OA&oe=6A60BAB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISKDFsdBdx4Q7kNvwFfQvmQ&_nc_oc=Adp0P1CzrzT9tuYlAlYCOfeBFtLJjO0BYfki7-dbtU-jZNdDnzSU2Qex5sEjvlCpfg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlbrrWMHjBdPwioQOhJAw2nwPF9bqlBGKAxOxx5oGPwQ&oe=6A60AA01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yyu1JILKw8Q7kNvwH7RzmH&_nc_oc=AdrXit55kpVHg2-gckqE8no1DlXgFcHrAb1aA0tPW1IkN2wQdmC5HPXUy-anX4oztCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVnKbWek4HvedNMH_hdaBjtITOLiV416Xj7ETReGm7Ug&oe=6A60AE63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
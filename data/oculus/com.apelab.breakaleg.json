c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkBnTdkxWH0Q7kNvwGupyWH&_nc_oc=AdoGYYpi1crLSaM9gtlOBRozjcdKHMVD1aiq923ODuDmT3fN1jbCZHZ_jJZUqRjAEew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VI-v44gVvLpOK37MHnhFlYDxzA5naqHl92AA-dSqaTg&oe=69FF4D8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mJYKSHrFBIQ7kNvwG2JbIn&_nc_oc=AdrcBCsPw3qKchUH0KN0WoJrGTj-kPoq7VCuZk6pWhS-Zo8fEPR__mDrPWAXQ3yZkEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FaYRPBjnpAnQBQ9vVv9NwqagTHEI6uqEWMnY__Y3bjQ&oe=69FF33D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItKHcFlVSAYQ7kNvwE0aw_S&_nc_oc=Ado84oEvKJQHlBWXw9p4KpAnaIGKJEh1cJI3283uGPav6b_AR5o3aGoTQbPp1QZi210&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42H-uYaSQ-QoJuyUFQI56aE5LC9HhykHKKuYVQRLHc0A&oe=69FF2BB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4zoOu6V1t4Q7kNvwGIXZwE&_nc_oc=AdrJrQDBNcA4Kv9veQi0Yh1UTUxxiWrsJF5sivs-HZDOjZl6hL7zJClDxy5Nsp9wkz4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dliT41WyJe1abWKVjD4AtaISaa0QFOTkjO08vWHOVhQ&oe=69FF1B01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyk1PoYrTsYQ7kNvwGu1sjD&_nc_oc=Adq0goAj09KxKwnLBBn-kmPkuNI0OBymHQ2I4cmKqdJ1QCsj0MvRXUWU8pzWz5UANR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xp0T2sXSwf1O1ARI2eloIn3OE2UB5U7QpvsANTLxHuQ&oe=69FF1F63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
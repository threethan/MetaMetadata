d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzw8WLYbaSEQ7kNvwF1XEcg&_nc_oc=AdodF0K3liWctznk7gTysYDKiM26IePr0m7MwAOlLHoXFcFAXhcGBmWPxn7hNhrQ2qk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SBjjVMctoyqdoVi6S1ETkPS7hvoTFGLZ9OufQnggpZw&oe=69FCAA8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZRAR2vDb2sQ7kNvwF1XhgC&_nc_oc=AdrVsupvfVLNhgKCxRLSqHO7pxvKRpChx_4bXL1YJcWqmQNOTZs_3jsZaqpKWDiM_A0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qdVByrK8MAsouZXp2vO439jxJGvA6BRnXgcku_m1vWg&oe=69FC90D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvHmQR9YYM0Q7kNvwGyXt6P&_nc_oc=AdoX5lpVM98mMx--sHPeW4ZIgGBKeH8br69ce6w0-_yPJS9qQiQsWW_x7Svn0dCeL44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L6zeDTyu5n3RZF4BFpV3aGHhDd-cLaR74Np0lMGIUaA&oe=69FC88B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbVM-OSTavUQ7kNvwGbaPJd&_nc_oc=AdqIlPBlrN0A5hnQrraf0OvwJYr-O_j5h7KmeWQknhRKVCBvuJav9nZvRe82z4FWxc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Iyekkyz4e1qcx4wtMbN_5jYMd4OSCSFpICIUDzu68Xg&oe=69FCB041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyk1PoYrTsYQ7kNvwEn-eBu&_nc_oc=AdpCgB1puWvPN1z64PcKINOKRoshzUM5mOvhFjj2XwbZLJIpLlykUArRFz9SA2Svehk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p6_NBzHZGvZT3jFurytYjNnp3Ql00Clc18NaJYTqQlw&oe=69FC7C63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
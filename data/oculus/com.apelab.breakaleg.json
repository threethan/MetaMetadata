d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm9G6Si-SrYQ7kNvwGGmgQU&_nc_oc=AdoZBJTRlQcVfhSXMy0VAOjjloyTEN2zxzpBvoeoFVikp6xk4yQ4JYjSoId9BnMRmp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIkGZrT0qrBT37s4idUxf_X7rVZB0zouJ3luSsVQmrUw&oe=6AF5D60B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwuFJ70tLxAQ7kNvwFGFP22&_nc_oc=AdpnRXOTi45HlCfrzbpN1cuwBxZTWfJYZGFZlhV6_erqswIAukJxa3_JhxbyxngaCPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvlk27XjWsUpeRAyH8NfwjGQ5iGA7q0qOxzmf1oxEw9Q&oe=6AF5F495"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUMna0OFb_IQ7kNvwGXvYRy&_nc_oc=Adq_HgKMkETI7bnL9p6YttvuZNBWLtJBHdnP9LWwdmOLKAuKtL7PZK3bRaAfOPydgDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFVbQY4V8BEpS2DyaQssxUVULh4mN5gvmDHNKo3bIwvg&oe=6AF5EC74"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-O4JPruGSMQ7kNvwE6-tkq&_nc_oc=AdqTnzUFQ5VVF3nGsDiq5w5ixQm4E-XwaLJoIRkkeTbckv1RVIACb2wbqdV4fNCJIa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVhs8N8Uge_JRYcuh99j12d6tk9Ae295DQWKQLI7mesQ&oe=6AF5DBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrxls8hPcrMQ7kNvwHegTiL&_nc_oc=AdqTzz8RDk6iaIdDfOG77ewlx-7Qtu0FgDWMlzyYACrig1bIYfX-6cLKkFHMVxIeWPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl8b35wkDhGVI3OniV8IQY4ug8Hk8may1Yxtf_wbuXow&oe=6AF5E023"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
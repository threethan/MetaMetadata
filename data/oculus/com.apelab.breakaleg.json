w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BG3OdWpeTcQ7kNvwG7sPfu&_nc_oc=AdpfrGeCUUIzD4KVsg3eqguqGI9lAQgTa16KtTZ65ojXQyumSrhUP67DB3EFp6FGZgY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MaiEMYdHDytPGmp1n4m15kZHjNrk4C0EdFt7B3hr5lw&oe=69F4C18B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQcO-HjOuFEQ7kNvwEOkEkm&_nc_oc=AdoXOe6jty5BgKXxPKZDdqxZoIHlT3_Q3vSw_cM5PuwoBTFGOcLy8LZ4fAUL2baQmuA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oq6g9lLCnvoM6cAdggolSDxQX4XcEazEVSzYIvuIskQ&oe=69F4A7D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfb1VRLbQS8Q7kNvwGD93-B&_nc_oc=AdomnfjwxdtvXy4Q3byjIq2xAlZOkrdrqmYMnK7dtuk0fGV57a9VyOUXTUx2AnvR0Bc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0faC-ZTKNksENy0s5IEj9JvA5Ndg0BlmZtdf6Fyj0C8A&oe=69F49FB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4OFlynij_EQ7kNvwFsH--Q&_nc_oc=Adp9pZLjO8prouT_UirZgaWdy4b7nncHSMOvShi3giDIP2fIib_PvESbo7N74uuyUrg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0n4H0YRadxCj3ywkoUGCw7QZj-uIb3Ku2ptyFs0_vnyA&oe=69F4C741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBOh_56Zaf4Q7kNvwEPdP3M&_nc_oc=AdotBp1Pr0gnNYtaVc4dtGJvOeV4RS2aBmrKZnshY0K0CIIYrbp-RppFp2fHX4-EM1o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sTMPr6HcR0Fg7XXcC8v-W06m2RLUchuWVW0iT0LjOPw&oe=69F49363"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPYT_fywkuEQ7kNvwF3C-mu&_nc_oc=AdqrmLGSg7KmHJyBIN_YOp9vaDDMuVCxZO8umH2xkiKFWCHQFHcnL7kh6_BjA0-PwAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu1br5qk7ZP1NDtlvo3aViQQEdN_RoiLKOTqzYK7QjTw&oe=6A79B0CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_a_r_-DKjQQ7kNvwEWl4gx&_nc_oc=Adq0H_DUApn6MxN5UytAHpLgHYw7w2E5qtH-iHq-dsrNfetTyRh9x9nyvtvk-ZDDyeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqHKwXx9SeUtzdhDfMOtm9l0oViOpbwY3xrEnCyuyrnQ&oe=6A79CF55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L_N3GDG5YMQ7kNvwFzTKrb&_nc_oc=AdrbZ8e5_NhMlQxfRA9UA1O2EATEDq0q6UdebCHuUssQrWh1QEqbvtFUlHGMVF8S-dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc6YbMdQWIc1RaGgppwycxmsrqIK9f9PuPLP6zdSg11Q&oe=6A79C734"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QwFkeR4ms0Q7kNvwG6bhr7&_nc_oc=AdpA0AUAWsNFqIly6yRkhJZWHpRXRqJZkaZMY_4jq7cjt4Z6TM-GuFby7DuSkyo8nME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzI-cZJJhkHiqI82KNTQhEovC9Stou6d6nXu5APg7cPw&oe=6A79B681"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt_WNCc-neIQ7kNvwEXJiOY&_nc_oc=Ado9HRkExkTa0xP3OSI0jDIxFagpTF1qK2P5K4vilk8YWv51t0RvtKpRT1mdLjGDkas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpmJ8Kmv9cISMG5TJLigWzxgtLBmi_AoJbzScPC9o0yQ&oe=6A79BAE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrNR5Kf18rAQ7kNvwGdjc7z&_nc_oc=AdlRLZYud33dzcErN8jyT4mFBWxMqtPAYQoHoJFjkJR4ZwnwGwnhwKiufbaklCRVWzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFkKgeWgKQNJf7v4yM7eSoFpum4v7gMTC2Vx3ftGIW8A&oe=69B7E44B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP5N0JcMwkMQ7kNvwEqmK8x&_nc_oc=AdmTML69Nl8UCAPywsshsWI8NYITpz8_ZJ6kWqS4m9UGwujUW0zARyuBvlNd65HHm4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0gX32OIYaFMnZgeJ5sFA9EYzKGLA-ULgw9efgSTVbFw&oe=69B802D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyJP1z6deb4Q7kNvwF3wg6x&_nc_oc=AdmQGAe7vCuAR9W0FCxcmfL7c9ZQ0YZ56MTjDvnHLpBEsxDdg5YO6yX43lwDoXVwCLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhpJZYbkkOmaefqt-8CnaTQP3L81GyVoANbJtpmBYgJw&oe=69B7FAB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHT8A1UNUgMQ7kNvwFG2sff&_nc_oc=Adl6ibnjYRX9wLcF9KX_n6yJFP0f0NEH63SVkogLqkqdT5AWAN28mD1Mou_Yit1iXa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOq0kfaCA9aDLPNA4ND0IrDFKZFqGMcNicx-sXjvY5AQ&oe=69B7EA01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fioViXfI-I4Q7kNvwEC-xwA&_nc_oc=Admgzf9Gqpp-fxCUVg-rZ_V8cAHQAi-xNY9915-IGRZENVR4oFNGtquPVEJP3SnOVtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzuhaxJgAOM3zSgAVCjB834XpCtzfnfFpBLjB59PQmHFA&oe=69B7EE63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
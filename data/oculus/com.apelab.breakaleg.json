/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL6dmEopA18Q7kNvwFbEld4&_nc_oc=AdnV8v_JprDOfNReot6t4nGb4mNV7jSzKiBkWXmohw6-TNTqdo0RatvUfE9BjLXuc1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGgGrBzUjYIWBmwpF9m59gMDp363hd6ga-DknyD2Ba8g&oe=69BE7BCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWebBKBq1ZsQ7kNvwFw8pua&_nc_oc=AdnY34lISQzdALuPQlfOPsHwsuiVa3S8hAbRHNFR7wOI4YD-XLGYNCtzky-m0foGXI4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZckxdyBKUxNL3YXEOzVpDkqv5eDDYpE8vCgv8N5i3Ow&oe=69BE9A55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Iz6gch60fQQ7kNvwHs85Ix&_nc_oc=AdmPwgNNxu2r8UmgyIKa32htq-E3jWfnekAJQR_jgmi8yuQtZD3FH-nWXxoAfnVeDso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBxrAAMrOe6aYMjIh-WfpdJmBSjO4Qz79jdQlhN6xkyw&oe=69BE9234"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pep2XAjxEcYQ7kNvwHFc6be&_nc_oc=Adn8zvVeCPXbREB9nxkUPssfvrO0reNcnM3ZRy0VTvmi4tMDVUi6r1y5qnE0XKIC6BE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrubbzkBjiAq6chB8sppDhNHprehHIy8pAD-t8crdHGA&oe=69BE8181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nQRW0dxdiYQ7kNvwGYnppv&_nc_oc=Adkcu9GZobwn0UOUD6mxgzIymHuWNEfjfxCXvNDNjLOwPVntSYfgCwUytYxJszx_f0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLNKeRtGxqu2QGuIwrh9uNPmvKXf-ZqnX2IDZU9zN7eg&oe=69BE85E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smXSRyWxD5wQ7kNvwEC_GhR&_nc_oc=AdpXPmflYfwPX-cUGalxLwHNwAFH6ywUz5ZyIupDuTNB8xyFAI4cDF5RMv-PAUL32WM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yVkDmSRJa4bwAa9Bbw9_NXf0llMdnxPlKdk_rw8yNBg&oe=6A1DA00B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wldjxzdXEsQ7kNvwHGhGoW&_nc_oc=AdrRDl3A4AmXGcboeR70V2PCWSMcosbRSDjeErN2u_FfL06p55ZOPrHcmdCrXu7DFJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44sIyRwZPH9CO45wZHneVfjo_kxiPNXWkuqwjZrbpw5A&oe=6A1D8655"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmGYY2DlM1kQ7kNvwEidlaB&_nc_oc=AdqlA0pHtuJl8yJSM6O8gXRmT00Mll0YMphEa5sJLoGHwF9w-M13pPfq_wVZanS94ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bfzHORo32o-HO1p6m_ABzVt7Dgpy3sNRfpoZSRZ2kYQ&oe=6A1D7E34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT24RTKpFbUQ7kNvwHP-tda&_nc_oc=Adolbqto-X8X6oSGPcH4wumVuxV8QOjH0Ttu7WBUEDRu8tLJpd4cBPWMMtUmDtx2No8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72t4K-TEh5EoekqB_sBCacpB7BraJG-lLdcdKgsLLZFQ&oe=6A1DA5C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfmtTWtugqoQ7kNvwFYw-px&_nc_oc=AdoCb9X1U6nAxD7Fd6H2b87qkrYGWzwayGm-cHP_N409MrIjLYVchVP9WcZwUGOzjvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lt0-GHnKBAstZ8fKeopwTFvpqd_X33hKwy_tKbfUJrA&oe=6A1DAA23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
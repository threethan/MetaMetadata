qmK8x&_nc_oc=AdmTML69Nl8UCAPywsshsWI8NYITpz8_ZJ6kWqS4m9UGwujUW0zARyuBvlNd65HHm4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0gX32OIYaFMnZgeJ5sFA9EYzKGLA-ULgw9efgSTVbFw&oe=69B802D5"}, {"file_name": "migrated_image.png", "id": "508436326728391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyJP1z6deb4Q7kNvwF3wg6x&_nc_oc=AdmQGAe7vCuAR9W0FCxcmfL7c9ZQ0YZ56MTjDvnHLpBEsxDdg5YO6yX43lwDoXVwCLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhpJZYbkkOmaefqt-8CnaTQP3L81GyVoANbJtpmBYgJw&oe=69B7FAB4"}, {"file_name": "migrated_image.png", "id": "196592148452346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrNR5Kf18rAQ7kNvwGdjc7z&_nc_oc=AdlRLZYud33dzcErN8jyT4mFBWxMqtPAYQoHoJFjkJR4ZwnwGwnhwKiufbaklCRVWzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFkKgeWgKQNJf7v4yM7eSoFpum4v7gMTC2Vx3ftGIW8A&oe=69B7E44B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "129032964466611", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162708_129032967799944_8089233936061825024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSfLW4cTY8QQ7kNvwGoS5-m&_nc_oc=AdmS7witPMg3rRWhV7Dp41fIIEHcMrEPgEJbWhaRYcYVHsbfm7wL-EOf-VIILpPXFUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzidYmONn1W66t_cBcCMTbCNqziVtrL-2riDlDh_58Wdw&oe=69B80FDC"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "You have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin! But be careful, they do not like failure....", "short_description": "--- FULL VERSION RELEASED ---\n5 chapters, +1.5 hour playtime!\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466098328345905"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": 
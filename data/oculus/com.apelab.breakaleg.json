.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWZtcJYxZ_AQ7kNvwFBOMXs&_nc_oc=AdmVIH8FXSM0f0dP1hKS3b8ZDa6OTNoTEB976_khJ9xESQTxfLptxDivHVvQiyzSwXc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzorsueJoE5oon9U40lrPxhqLUy4FuWk4aPTRKDAuambA&oe=69AAB54B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzkTJoLKJOUQ7kNvwHuaXLc&_nc_oc=Adk8GH7qbfRh4F-n6F-ec8vz0W8lASvOR0cfT3NO1FZB9KKda4fOYdJD01VC1m_BfRw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7iX0OCQmVH--bc_cHquhaySsJAYLes0FNKv52cNLg-w&oe=69AAD3D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDLWmH3U1IIQ7kNvwHzonih&_nc_oc=AdkCQYkqOPG0XrzopXq2kKawCVhf0y80bqQqRbh5jQepvSSzBXGtgk0s8iT2fHGqrE8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTTw3hBHqQVeRpAS0R2HOiNR-ToSF7cb-Q8OE37IZuVw&oe=69AACBB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfq3ouTIJ6MQ7kNvwGrStbF&_nc_oc=Adkrlq0x3duZUnXongHIbP6CbGjEE8gw4FqUE4qhmHFnFbRf2qIuR5ZlLwwTXmVzfi0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfySkRtfBGRpEiVsmQ8OMqj9nD0_BMqJ_B0MGWgtLMwk_A&oe=69AABB01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf41GFxNiDsQ7kNvwGe8UMu&_nc_oc=Adk82uunHKvLojmAabnbj0cKfynUt72BPj_rhNy_fgTzvgITq4o6yxGKvRcbNTFmhGk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCiXniQRSMkXVou_U8YqmVPyw-i37uofvEU02RjhSQqQ&oe=69AABF63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "
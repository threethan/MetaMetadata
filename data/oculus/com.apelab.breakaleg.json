a5-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AigqcMPWNikQ7kNvwGwOyPj&_nc_oc=AdqInw19R6JmMIx2XQG6ATy3J2ZT6FKD4ENUVU8swhXNYuYBgpwDBe04l6bmq5wt8MA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbos32xm-36pFjypML2rUhAKXURzOZS9iziFjFpIiWBg&oe=6AF0900B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YhscHET4DwQ7kNvwEYv-ZK&_nc_oc=AdrNjMp-8Xd7MPT9Lg-ZeUf7V0WtOx29-b7WJ0K_3FNab-YwIcQRQImjskEqdvGhPGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUfO4Yb0mgVZGl1INGGzaiZcDXvfRcML-hBvTonXPaBA&oe=6AF0AE95"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlqKlJWoFdIQ7kNvwHOJvyg&_nc_oc=AdpqoX2FjuwtI2o2YxNhX2x9AvyYwwtNk6w0vS9kLfxijeeF72yL-h6Y0R8HvjzzEvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLMVNrckm2PVXb8bKkPkfwh5TC-VnO8QsgNUhNRV2Frw&oe=6AF0A674"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_VojAIOJd0Q7kNvwH5NPWk&_nc_oc=AdrU8mCZdwPZu8zSV40VHRe-NQs7D-wM_FuLeFjwzcjvQiYAQj4FuamkTeZ24OYhQdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyo7o8kv56Mf3IwihRi1pHBcNDZX1HrV7tVgngq4Lriw&oe=6AF095C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV8S9o3WMfoQ7kNvwEP22ti&_nc_oc=Adoa6s0KQzoYrRmT4KngPv6GMHSm6mVfXRd1PmHZ4mrKcKhOKW8RZjJRTg2IVg7QqFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqMegYmP2Ha8HB_LLW3cqoX4ba5O4dDnGPOt1DlmHv7Q&oe=6AF09A23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
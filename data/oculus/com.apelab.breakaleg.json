c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6RJsxbpf2gQ7kNvwHyXG9o&_nc_oc=AdpmmUpGY1pME0P00RqLpRYNEe3ukYrxP0pHTrtOzRCNqkMAOBRzIpLEL4xaWFvOyoU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB6vYm2G4LHZONSBzsSrzYERrjqoYYl6oM7Lz9D4SG4g&oe=6A770DCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAbLbSeW0AoQ7kNvwGhxBBW&_nc_oc=AdpkiJ1Q_G6LE_Pmf11hL3Ww58kItRjyUnOzs9Z2t5VssFfa35zoVUZoOS1RP-iW8ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-HSAg690J5OJ60fNjbct8GLlo1bdQLYx4bQiPjMAYGg&oe=6A772C55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJjuA77dvfwQ7kNvwETxUy8&_nc_oc=Adq14I4qdZqc4MSZUPelFQucD3-6yOL1wyIml6KkuWTwRkclV0d_69_bjas5vD-yeoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ-TIeB8aPEJ1LJqqI6eNOB01WaEcBS0TL4r8MHRYLCg&oe=6A772434"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeqzKQbgNIYQ7kNvwH1ACn2&_nc_oc=Adqd4R5Dp1RBoKPkKlG1o8uH2OdH0BF9PEF5PCRjQih1o_Um4TQ62kWp3-GywJczui8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiQA5Q8vIE_ZuLV9xmuC21zzQN0GrKc-T96LW44Ym7JQ&oe=6A771381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt_WNCc-neIQ7kNvwGjG0tf&_nc_oc=Adq8CU4WXsNRLESCfCHN0BioljSNI1PpFgwAl2WOS_L5uTiEDDe4qp3KBcoAJm-ZlCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfGtElUxZtctYi5HSXNOI-baWnZ5pNtje213nNcoFDGQ&oe=6A7717E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
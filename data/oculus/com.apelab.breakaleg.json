c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09OjPwjxo24Q7kNvwFifSB8&_nc_oc=AdpAoywLjBlxx5eEYYpEP1IdRp6XLDoOUzaKzfGaF7KjIMbgO2HwkVopTcfJ_EVjwQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8M-JBEyV7Gl4fKx6NajiyDiTKK5KNBmXs8R-aegm-DA&oe=6A5B5E4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-4eIPRuLUcQ7kNvwF5FEK-&_nc_oc=AdqbK51qmp0AcEOeQLc2t36f7932I6kHBB1ZmRseYwoarg5k4VzMRL4S-hEN1TG79fM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-qQGLidiQNtbi8x4fZtCY8lGEsfDOKxhebyYbeLanyQ&oe=6A5B7CD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPZ4KRvPzKsQ7kNvwHnAXRa&_nc_oc=Adqli1Ax54zf0K4PHn06yurMjdHeL_re47H16L8Qa041Wah0kA9ByD702CElFZiGOho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxuzeJUkmlWn46e1En9hWO2eCQjREXwyGFzdEGvaxynw&oe=6A5B74B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yckEk2UwN_EQ7kNvwHMzxYw&_nc_oc=AdpLDRi7WlBUpaju_lom97LZZZJKlSY2JMVXIte5uNgacurYFteb_5bHuUadFnUhz68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOqumojsoPPPsc9P8DZzJ4Xa2AmORS0T73mZgZvcaIaw&oe=6A5B6401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0_eu_-5HsoQ7kNvwFpmehM&_nc_oc=AdpTXx9RNb6p-VzlFbaA7cGkEBAC1Pn22FI1uGAf9wfjq9rsvRNabsRmTl3qfL7mCqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLS2Y1BCJmel_9a6FfBVRo66fe5tnON7sOZDLGQL5q7g&oe=6A5B6863"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
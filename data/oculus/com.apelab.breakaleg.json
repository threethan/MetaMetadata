d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de6EHFKKX5IQ7kNvwHdbw77&_nc_oc=AdpZAM0i-NCPHpU6uEOPoR0vrvPSdyL-h75R0qgK9AKVOmPx5xWZ2a-K6DNeVKvWDLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGKXplKeyqYXBRfbHZHdLJ6332nL2yPZZEitPaB_6DUw&oe=6AEF3E8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YhscHET4DwQ7kNvwHJQJD8&_nc_oc=AdpbAki6GwKU8vp_6-Uv-kJuue8AUCMgQxt_YJQrvBeK73bdgw9zw4CNO78OqXQwHts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWpSGhf5lTUN4fMnRS8PtZundsrNT5EilRY83m-1VjIg&oe=6AEF5D15"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKJwVgB2haQQ7kNvwGullHr&_nc_oc=AdpjqyOeQoBhiFQtfHQx8SGu0uj3uozS8AMhZlTvv6MJoEJaaT6Wq-XnserDwocUWo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6gT3qDq4vLdndD_isFrZd5RfAf5ZGcwnuSMYB5CH-yw&oe=6AEF54F4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmMc545R4BEQ7kNvwHOPTpS&_nc_oc=AdoKPOVZRGTGTbEsjPSwqbKEAaRv7uuYBFPN8UN6K6SqCpOZh6qK6vxLDwQElzR2ncE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRie9uVeiSgdDK-NqEWW2NyRXxg9gBir0szEqKAMva6bA&oe=6AEF4441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV8S9o3WMfoQ7kNvwG7LxNY&_nc_oc=AdolrIXcFLMtKb-sQx5HLhqUAuSjEMjLJQzpPqdD1EWKXjgDlopRlXJYp1ChtPXjle8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToMYSGxMlu5UBxZxalNUP50M9hCITGZB0teF3Qakg6fg&oe=6AEF48A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v-ltL4cKdsQ7kNvwE5sRCB&_nc_oc=Ado6xZpcYP_Eo-eVr42r3ENyewrZcokKQ62-Np2SL2ODwhvJFIWAMHrcdpGNqOyaA24&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNbkz_xgk2I-6E9HPCGlUzIE5vCAeKp9K_xVr4DlXVhw&oe=6A8EE755"}, {"file_name": "migrated_image.png", "id": "508436326728391", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3kzj8ohIXkQ7kNvwFE5oZ5&_nc_oc=AdpPwzFis2_BVofoZrp_7wL6CdaBzmw_XicphLasX0JhdDJuRu4aE1BI0IvjS5g6zkw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-eBNPybjrDfUGboxDFih2e2eBvDmtBWyCxigjoDYayA&oe=6A8EDF34"}, {"file_name": "migrated_image.png", "id": "196592148452346", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icklaq7DmDsQ7kNvwE5K-dp&_nc_oc=AdowkJ83hKTjM8HCftuIdhwrwpQglHkZR8FibJq5DZTUyD_g7jGQS0iOnbHw_ph6UG0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF063qPrv7R3lwPof0cnuStasNWTHnNswIA0ro7uI4vVw&oe=6A8EC8CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "129032964466611", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162708_129032967799944_8089233936061825024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB9V7d73dc4Q7kNvwGD4hb4&_nc_oc=Ado7DuPhH_eQJBIpS6E5Dv5hMjemN-IXERnIollenjFxEVS1u5GySNuoNKClcVOPpyw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9ixAEX80DVjKoXN7Gd57mFkxMnh2TbwCRBB3QO2_dfg&oe=6A8EF45C"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "You have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin! But be careful, they do not like failure....", "short_description": "--- FULL VERSION RELEASED ---\n5 chapters, +1.5 hour playtime!\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_
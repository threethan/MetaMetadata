a3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BG3OdWpeTcQ7kNvwGzUFla&_nc_oc=Adp6YuJ1rRWvzTIP3t0R7qd916q9de9dvHYJfjY6nud4Si6LKYEGyeua2iBokFJBLR0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ttp5mWMo-NbsczpNQ0AlIPXx5eXW2qynPOtvSFze6DQ&oe=69F6130B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpC_ZAkvnK4Q7kNvwGvXJHs&_nc_oc=AdpNxzUEIXgqvy7vLFhHzMeCmAcuR6kLzPXwnlPaRM0lK-UfY-W9DRF-n5djUfpUMXQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0e8drf5u8WhxvWPQEQ4JW3-Crn--OQXa49zoJTHHKs4w&oe=69F5F955"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfb1VRLbQS8Q7kNvwFCDjni&_nc_oc=AdpYMh4LnmCsN5yYOut56U04G8Tb6mDWhJf1NG1m3A3iqTv5z7SdXP8BMxSRN6GoOnY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WpLJ_g4jqWtBVuxLHDY43A_c49PhG4vebFo9hejyCAw&oe=69F5F134"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4OFlynij_EQ7kNvwH81H-p&_nc_oc=AdoE7RwTIGk5HpyJ4pFahnPRuIz1fW9gGcuNSt3kEKqwSqmtPOXAqI-QU4b4WuEUAs8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OuQ8bu-fISNvnyc6vHCdoMp1AZtz6NmoH9w3r6xWCIA&oe=69F618C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBOh_56Zaf4Q7kNvwG0MTJI&_nc_oc=Adp8H2YhBxK1U15ey3zebNL6IyLKg0Jpc73hr8-mlNrNJ70Ve9FTyndBb7T2SH10oKM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mg08WfmFaoud4QNHeUA3WouKoi8nbipO3aFIpCrFaLg&oe=69F5E4E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
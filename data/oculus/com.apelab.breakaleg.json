d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SDPuU_6QNQQ7kNvwGcv-yO&_nc_oc=AdqJsinXBRUUhvKa2PerBY4D6yqEJs3zQ45Hak-h4SE-D9QoR41sZMk3UDi-CyPqaZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x_5yF96cUZxs7-u8TAkMolakowh_xQjp0FeQDlsDHJQ&oe=6A04938B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axzeGDl5b6YQ7kNvwFJ7AwC&_nc_oc=AdqW1Ql3y5obFYSe3ogldQ0YDWk83mplBD8KwdGRYCySpIjB2-MFFhLJS4Zrxh4pMdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PKDbT-fPGeW7H_qZH1CbyPzc0MyjC5nxXHpMleVK_Mw&oe=6A0479D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfF9X06jFU0Q7kNvwEr0dWB&_nc_oc=AdqQNVIAkyTxcuT1ZzSueKwJWk6eWiJ-Mxc1iKEzKiOTlq68M6ui6f9iOvx_3UMGdko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lu598aXsZvo9QTcqsf7_mfd_yt2zxZnuu-Rot7Q8mvQ&oe=6A0471B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8vr7xywdh0Q7kNvwHlxd4u&_nc_oc=AdpJHJOaPBkve-d8WQNKg3-iVfg6mx1dRWy_JSPuxpm6lVuKZK24gRYu8psA_t5AqBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59SkIR01azWQxujA9XzrfXhbQM851hSupoF_FotEW0XQ&oe=6A049941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GDqD77TthEQ7kNvwHHUEBu&_nc_oc=AdqexkR_pQqSwYIyLyu6Pd04EfOquhhVRNFCZ0bCeRceLbzoK_UGYecmxE_2TZIRPJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kf9H0e0ju2_ltje_jQNTdKaX1-9wP_6zUsgLaIA7IIA&oe=6A046563"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
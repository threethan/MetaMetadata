d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHD6iSaexNgQ7kNvwHqKxS6&_nc_oc=AdoszBVSpEFB10UsTa6r33xgU0aIhNxv2tfnDVqot0UK_qWuehcoM_aE_skigamLi6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oPgONxLWV58uPgx9mZQMnJpL1wTsLFV2E_M_J0wxXyw&oe=69FA078B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZRAR2vDb2sQ7kNvwFtbO5B&_nc_oc=AdrVvyoEivv5JW4x6l7GkMhuj47UtElS3vqW6s9LTSExy56a-m0dvn-LITh5vHiDCE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZKDsH5CaxVCD4YQHDNfgCUECok4PxHLX8BO05s9oYmg&oe=69F9EDD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5EGs0mh9gEQ7kNvwHT8_du&_nc_oc=Adq0hGpD5KUoLRIbqboxV9G5P7-kAdnnxt1CRvZP-PuqSJfkZw5FXGwgjkFA25AJew8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IqBLPbLMbYO5N0tYZkU36AUF6kNGdOGypsPL37spf2Q&oe=69F9E5B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nEmzjcmTd4Q7kNvwHy_PzQ&_nc_oc=Adq_Ls7Qsqq8huOm4ZdsCFKMBR57r6vdGxqpW6IwjLRXDnBFBFAotSlS5iBmybKDKpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mttG9qLfSNT2IqkxPMn501yevLs32cjA3ClPGiKe-jg&oe=69FA0D41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnzN5d2ra1YQ7kNvwHhfLN0&_nc_oc=AdpGHxMOGAjeB4vJqKtqw-oFLAsK-nsmnXfUIiG8zq75PgE0xksgoU2nCPKoAmqnLZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63zx2XqO1GaxFehP8FlvOWJr1yzmqPoJzAJKyXSG680Q&oe=69FA11A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
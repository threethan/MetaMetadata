d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1BjYLBiVIcQ7kNvwFFgsip&_nc_oc=AdosIl942sPMNi-heJ0a9bBRI8LdKht-DXvCAe-tfazuy_O1F0MdKAFG2dtC9qK3oBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz4cQVMVUBmfIWTlQqI3BwzFca66jtydFovcc7VlEkhg&oe=6AC26B8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fczrbU9xB7AQ7kNvwHVmFYv&_nc_oc=AdqyTd7sKODvWRhTiV9484F-orucER4et_AT3Ay6B0smVEa-1W5C8aDYvGxLNvP0xE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO57Wv81M1a4tV3D38U9F17rVzV4J5vXrW0czpo1yoJ5Q&oe=6AC251D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3nmbtmBy5IQ7kNvwEs9o_k&_nc_oc=AdpVcSAhImqyZBGKD0K59CcNCOvvDj98DXobkJYOROh0PzxWMjaocqjuC0HhLxneVWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP90sOFIJgHJ4e1QW8qNn4B2fjH0QfBZ8HzZiIEdHdI_w&oe=6AC281F4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhL6PBGS3-UQ7kNvwGnLq5h&_nc_oc=AdoojKBvmcFlnUfvFT5PwBePa8upeVdtILs_Jzpv8CCPapxv73qG7UtVIL3KQZvjNco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIofQZkNHqHfxBtL6W9I8MWs-y62sxzWhviqoRo4DWuw&oe=6AC27141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dun-qgnX7eQQ7kNvwE--61c&_nc_oc=AdpLq15cH_BjRmIAfHjjTsmtkWR_SGoZa0mhCaz3j6R-GKszRr_Ll14yLzNQbcPj0sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXIU6NS-zZ3lXInPj-L6mKRuDz4NTcJza6_GXNLUtItQ&oe=6AC275A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
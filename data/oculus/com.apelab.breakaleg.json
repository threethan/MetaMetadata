s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoGgzH0o87UQ7kNvwGz1lPT&_nc_oc=AdrLj8GmEDV7h_Q02x_oDLnzQBQTWoB_rxnYzNCYj8EpRm2a3XdFbVuHcJl83PjhuUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjCX_nYD908MbrEOK2cz3UKe-fRPwrOIAOmL1T4aMBag&oe=6A510A8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsdaKHTm5pIQ7kNvwF1iLCc&_nc_oc=AdqpjwuzhPikdGubX3pzmr02aOeZ7vxnHcOXHYRniNCwPwEEoSjoTbaZxzWi57K3A9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEsjguk2wF-YtMeiced-IIpKXbjJhGAr7r2SRDINGKSQ&oe=6A50F0D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISBp55M4iqUQ7kNvwEBKGM0&_nc_oc=AdriPfzlbSGxpSeePRcAKX699AN53OXI5jAAcwNbmFfLup-2WGhSBFfQ2jsAgeVK5GY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD5ABoSqRUZKRZ42X54iM0JXbMuo2Dbt14C_o4UIZxWg&oe=6A50E8B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elQyxuzyzDUQ7kNvwFtsTri&_nc_oc=AdqMIbNBtHs4Cj2oK8DXkavJWuTcIOyWNJXpdutIswCv30In84FBkI8M4r-7xt4WV9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWItYAWGOxZvk1rZlVmGTCa8p-0dy9ih0uCZINYpknzg&oe=6A511041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iTwDJRUXgMQ7kNvwF9GzHU&_nc_oc=Ado4SMGMFnDN-LxPMLqPlf6TAgP55LS2APWng97W1DbwepLiZIChFP3V39yMqogGew0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoGoGNCg5POaVZhUdLDXA24hUhE3PKj2WVIrP2ycIX1Q&oe=6A5114A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
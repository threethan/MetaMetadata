a3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v8hZ5ZQ89oQ7kNvwG_l56S&_nc_oc=Adr9azzALri2EK5Kz4A_yBqVIBlwpEtMB1vU5a2mAda9Hlg8Qd5cUncETHDMW8rLBEg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14t5BBdjtOrhGEgpg2P2qCv8ROn1qC6NPLL6L7d9beAg&oe=69D7884B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RnbNrJTdi4Q7kNvwFsQXfl&_nc_oc=AdqOFspfh-nQx1p3smh2e3bDW-QB8nTSLINP5KkgkpBBcuhu7lMb14FHyrMUu3EnEQk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UVQPdKZrbiBiNuWkCnYu4kls-QNoTgn5LuMsnpKAwgQ&oe=69D7A6D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7rM9v_Tby4Q7kNvwH3U7pS&_nc_oc=AdoeuOergh7Rbldl5hEERR_qQTuYzgP2yxzijbicnu5S_rqnjBEIL9z7D0Y46agOmfg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17hNYUgrfygnGRMl6aogw_cpweJk2NztajvQzlFyto9Q&oe=69D79EB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szxpJYzKt8AQ7kNvwHRnCTO&_nc_oc=AdqykzEiNGWIQnAV6oqwLyDANl5pGsEd3rP4Kq72a9N4aFRu4IuozYDPft2G05AbAPc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FUG59SHT-9GMFF-yMKe6WGYBj-M0Jzb-IG9BLqA_Oag&oe=69D78E01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxgM2ac8Kk0Q7kNvwHAeomr&_nc_oc=AdpDmFM3Cf-PMIrFyVp2UMUFwfR_Lzb9qZYj7gkbejdfYbetYIckH19TDan4Ju3ITTo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z-tE43rrL5VZG_YLKozav3FHUpQQwYvrkMGVrLcLngw&oe=69D79263"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K3Lmh8BduEQ7kNvwHwooLx&_nc_oc=Adpu2nMYDy6Kp4Ty4LDbf3bRb5fAJP_y-zhZFxgcaW7XG64YkSvdCm6uahej3PrPyyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM2bKulr5jzxM0OuSiFcsyVr4Jn2SNCSPI2zyk1fSh8g&oe=6A637F8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voZSu_a-JjkQ7kNvwFiPkp4&_nc_oc=AdqmjqRdVjwjMKWmqSwrOgpOOp8mSvGsw6MwyLt3RhsU5XIw6WlwkXup0ZvPe1CoLM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2gU069k6s7iyDgix7ISUiT-2cWkLSI6qNPJA05Otf7Q&oe=6A6365D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDKcSv9uN50Q7kNvwHr3D2Q&_nc_oc=AdoC8Gnr97lD9Ip4dHylmcXNPAI4z2NV8Y1_ZXMIvH1eEsuVun63siJ2Ov8Q9NX-zIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4xiSFtYKSTt4crs0m2R7tXgUuQemdtyaGzvI_OAYWSg&oe=6A635DB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_yB09nrJxMQ7kNvwFvQpbH&_nc_oc=AdoJwrBdQjSKTmsP7OkE3EY2YZ6pTLeYnZhgzQ6FMbcyFyavVYNKGg5UPBI2RLGlPzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM_qXxOidG-WX6IUcBd6AuRNG62A1_h9gLSf42CZdGwg&oe=6A638541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtFrDCt1P2YQ7kNvwFQRTM8&_nc_oc=AdpbECYza7YsYRE0BwU4xpK3ypRe6LoPbT9o7RnYGJN1D-lSZpv3elk_hrwsInjzrvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaV2DVzyOeeiHj9fa9EfIEvPLfkn-7OhiqGTjvzzTIuQ&oe=6A635163"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bXXCHYHomUQ7kNvwGNfrNR&_nc_oc=AdpEkeWZ4Ig7o7zp3cpSfoUVy0l0ajkSqCiyHpnt1rDc1oEAecIHDk0XNEs8uV59d3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AdtFO6-HdyNbpjTzPeRDElFVcAFd-_IH2TXsr8lwzWA&oe=6A185A0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fjdWbQwHSkQ7kNvwG0koJG&_nc_oc=Ados6r5teh4x3eoc84mqPNsL61VdG48zEFtg7tPeZbgZKiXhevk0iQ1mqhhwWR21GYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dNk71a9oA2fosOY22QbKF1lqzzF-xAiu0mAs-hwS9Zw&oe=6A184055"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlC3KjfQe4AQ7kNvwF8g-B8&_nc_oc=Ado9M4Ucpo5ZFy5-FF2hTQHF54Zym6UHPwl2hQ-ZSIBIw6IN3-7ViO5NYKRfudkvhFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N2_LU-ul6yj3WZS8rnkhEaMX0ljNj9_PnmLeVP89K7Q&oe=6A183834"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qtATxEwr30Q7kNvwHFdkD8&_nc_oc=Ado0g4uwOGGcOD3EiNgdk5y7s-vmtuQnFv1w5HxRwUTk3ZV8OK4NQ-Rkn6o0TAU7NbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o9KLKbFFhQhJRP1AeTYTRw8T4fKTvgCzwGUz-87txkQ&oe=6A185FC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfdvOWD66qsQ7kNvwFjy0vV&_nc_oc=AdpU0R37_XkNt6qYZZUx2ClPIcQM7-Q3GywZiE8WWH7w6hlBVSo9OZOKemSNTJtXtJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s3whpMlvXN4Gqj9yzVoJgVWGJMb3yzqsRHeQ_dce1AQ&oe=6A186423"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
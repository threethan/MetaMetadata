/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvO7uckilO8Q7kNvwGWWWCf&_nc_oc=AdnxrJyF5uIIcWsEJbPQDiAfMY0I_m9mlRtbZremW-XSu5VTFIAtmjYpmzN0v4GHAl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx52PMkIbzEb-rmj4Rk3aDvTjS3P2dMk4vVzBrhJDwafA&oe=69B14CCB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IS_UFL5avkQ7kNvwGQh4pV&_nc_oc=AdmO7HVxI1nrsUrw-ZVlVZ9n4NzYCIuHGFnwmRxZZYv_k9EynnbXTt9xE1RLwY87_ao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2IzuUiXMzZKJ9BPQNP8bJ3GWwV7FlL7hYcPbj4o-q8A&oe=69B16B55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoq8LgCRc6UQ7kNvwEuQ0Dj&_nc_oc=AdkRGkF1UHvhGYTMd_kAz4n20iVAgA_QPIeGiMMvKAp9uJob6uJ8oICWlHY0L7cI3XU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-sxMr_WdIL2ZjUZjpzuiYmNhziD-MZYTCUUScvFPxwg&oe=69B16334"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhWn1DNbFXUQ7kNvwFOa1iq&_nc_oc=AdmX4ll8hq7hra5iSfYhwmqvP1v-MXlmMIbgfmb7XF7Xrrj188wYpTPafF6T8k3Fm1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuQiMmdQMuYJBjCR-YhFA7Eojq0HSnV02A3IQKhQxDjg&oe=69B15281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLtzMRBsYiAQ7kNvwGEY8IK&_nc_oc=Adm_w2I5fqUSHkGc0Sw8pVfoWGOiJDgGXUJN7vw9vZWtI4aL0CFxnw-gOiGX5vHPWok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCK6-LdbqQTE6Xs7zNPEVtWdw-tFKzhjyeHi9uWxElyw&oe=69B156E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
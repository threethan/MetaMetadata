d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1BjYLBiVIcQ7kNvwFYOuEP&_nc_oc=AdoaTkmuEwVHA7wzlpOpsxPzog8KANbd3A7DgpgMQmNvyBtOwZbN-omMxlOIg02frGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW7T6W2bUjRA9u8rHnrY_iqk4WJ3tdrOw2XRuUOJbe9A&oe=6AC11A0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fczrbU9xB7AQ7kNvwEpYmf1&_nc_oc=AdohdI_8ZfWjR8Gnip31SdhQFOeTKeZTMJguCZBwBZDQbGJH9fV-UuP1FZKHzUP6VT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLp_q-uyUG-9Kt0_KD_H_J0Y3w7jRq6foaNp_DL3jsOA&oe=6AC10055"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3nmbtmBy5IQ7kNvwEkbuvZ&_nc_oc=AdrfI-H-7SY8V4ExxS_b6Bwn8avoVT5BqGWB-vUl3EIVLQPYkXinWp9tJ-eHddAxxQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9Sf7YArEFFaefJtlMIy-tDK_gcR5DOHVMTwa5qAPKYA&oe=6AC13074"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhL6PBGS3-UQ7kNvwGyl0G8&_nc_oc=AdpvIL2_7gdmamgIiK0BofTOthINNnYYT_1cWAv0ALQsRdSCHr0BJDQVcv7XnD5h9Co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnq4s97eG72spOZ6RZA-trKaWAE816Q_-IHWaygaL_OQ&oe=6AC11FC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Epg5F0BwVAQ7kNvwFpgugH&_nc_oc=AdqhWztZy9B5wud9NI5yXWbE8ibEMgpYiWTRxdwqCp6szOSzbG9dv58c0Sz_5ZpWpic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXIPGLHDGUfudUEACXfoCT4FLGAyQGglqpoOWJGXS5yQ&oe=6AC12423"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-PEOxyHq98Q7kNvwFDG7zX&_nc_oc=AdoZf11o_ZGUXxdjdqGb25PXX2ZhlYWfYx8nhD6ynS3GPe68blQC5zqVVRysbcWfMnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2bZUcL26_wMFgOoHKbtKs4bXwpJGXpeLSfcy50GHDfA&oe=6A8C25CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v-ltL4cKdsQ7kNvwFqdfOX&_nc_oc=Adp30QUuYqSdIfZWAYzy8jGwD7G2sgZl-m5CbhjZDAah5GnDlz4bVOzhVdVk8Mo-zE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhHTnZBcU4KWSpajddXvTrVmpofI11GMvnAp78kUhFtw&oe=6A8C4455"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AXTGQDmPi4Q7kNvwFLCwBs&_nc_oc=Adr6QCxT871wKBaQW0BhZUiukbrxUWcWK20LjXZkWK5Ez2uzIv3D7dVfbxmrnVold2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM57NZMaQONwuQY7EXcyjlq2jaNsHr_YS3WOZG3dRX6w&oe=6A8C3C34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u9vLpDlMsgQ7kNvwHK7yPt&_nc_oc=Adp6sjLBBtVqQB-jwMdpQaI48sTWmmQik6ebBvHUNBqaKAjtqa2AdZCP2ZHegGI-Nq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Xpg0qAez7WW6Gfv_7pr2KUI3dKwUMEmsFpK0KamMVQ&oe=6A8C2B81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dai_fOU9T-EQ7kNvwEKSFIA&_nc_oc=Adrl_ddNikBDLwiEbw1W5k0KiaeEAY3ygPQzS9k8SS2ZLqM06YtYF4G2dsc8AxiGStA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ9V_vcJ6Mzh3l2qB4jAf1xi2maUDoz7mNEjLDjKZ0yA&oe=6A8C2FE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
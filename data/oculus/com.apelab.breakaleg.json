d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rBIE1BxPr8Q7kNvwFCGEvY&_nc_oc=Adrr6s6TyOSQIuUBPF9lk3xzLLdI0brjYINruYszuZfnIhFzv6XQOeMhpaeo5kWntiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCrBBWllSiC6F8MJs_j_JJjCVWMWXRnZOLzcXVaISdAw&oe=6A9ED30B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnNI-H7U2e4Q7kNvwGRjc9k&_nc_oc=Ado2Rn7f5bfXd1awVqqhkKwSK3R7PmDoGq5l-XEV-aE_YwAnvUuybsWV8lEIcV5DAsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDGHKvoTB84phawP4Ericvr069X1XF6CeuupdRkb_hFw&oe=6A9EB955"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mirlICyFlpQQ7kNvwHYIt_B&_nc_oc=AdoZWvLW2t_F7LGh5Cc6VNXaULseHuybnI1F-ExYe3MBAjk6XLS6J6VFPgLLzOYT9Wk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2xC9wQsFOPCkoC38owmBN_OQK4AWzzcuy8V_53a25Qg&oe=6A9EB134"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXn5auhq_c0Q7kNvwGz5TPJ&_nc_oc=AdrRPSrl2GbMk9VNKKOPKxqNK7tl56WmY5MFDHwlL9ehhCZaOb4kyGjbY4AVidqdZrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQayVkMX5vwRsQ97f1YaCaz56VdK-As_Yqew6c3-RDsw&oe=6A9ED8C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-NvQKjFCN0Q7kNvwHDklaK&_nc_oc=Adpg88jZGW_3a4atHLUa14LIUbcIqh-kF6cgCDPi394UmWPstOpGYtTC3HqtgccPFJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw6pzRh3qBpW7DZVc2QHrptaON0WRRWDQoM5x8J38Xyg&oe=6A9EDD23"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
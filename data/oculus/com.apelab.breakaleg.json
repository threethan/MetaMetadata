/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL6dmEopA18Q7kNvwGhz-wB&_nc_oc=AdnpCGTmqRWq-1L5dozglfyNoM4NhX1Ez3wSaUcpRazNIhWX_RrR-kHxIIChEcePa3Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAGPw2CvnEUFLWuqf-yuXbGadabIkfnObjk-Jt3VG2BA&oe=69BD2A4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kHEg99cEFUQ7kNvwE0W706&_nc_oc=Adkb0oTuEmr0fycXLSLHod0oaT6gWTNnYx7w1JMn5xBmuQRMol9eZSTJ8j7d5E5FmTE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyT93wkop4ChzI3-dkrC1UzjcXxW_0vfEf4o2n9NKxETA&oe=69BD48D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Iz6gch60fQQ7kNvwHXs5nt&_nc_oc=AdnecfisdzKoj0J0PVBBNsOXnUvarkNIjKYpbqdiIVcH90zHFjit-Gb4YSfKuXaG66s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ00-ixkAOBVy9jQjEU0wXXHa3KnAxcP_0EppXA2kxDw&oe=69BD40B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pep2XAjxEcYQ7kNvwENbBKT&_nc_oc=Adng6X_q11FQp0oxd1-esKI56kiE9hLrgT03ppqu4RTmZjNbWio-jhpMjj-Dxc9oZzg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeAj8tmwSB4ITDyi9O6YEnlCjMP-kVR0lRbLCeqJ3Rzg&oe=69BD3001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nQRW0dxdiYQ7kNvwHA_RkG&_nc_oc=Adm4Tz-37pRTGst9Fhp-zpWew6lhMpFOcMxfRfqZeTqUJxdVXLyzG9h4Vp_gaZdiwOU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6Iz-2P3FfuD59YRYE2rXNfYK_wQ0CaVweP00SRQXRpg&oe=69BD3463"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
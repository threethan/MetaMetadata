s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10eOj810wn8Q7kNvwGjVDIL&_nc_oc=AdpEDm5RrZqjBoh1ZfLBv_Ws63nKZ3yXfXTFuIq28I071lA6e1VCtHGyNN9U8WWG_GU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XIc-XZm4HEriorNz48k-BrWvEZ1c0cDkQGEMLZDglrA&oe=69E0FB0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOdSeKQuveAQ7kNvwEry7_c&_nc_oc=Adq8PA0Y3ARA8COzCI9xjJlL2u2OPNqr-i9orKhyK3XarZVcEtb9gR76NEF35tk9ANg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MYnlrQVgPNy-6a7IsWUPY61uNRAAb15_9moEyOb7mVA&oe=69E0E155"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUf42fvJuX8Q7kNvwHF0rrl&_nc_oc=AdrkhmQTMVHcP39pHgU-xLP0aoZek52LkGXJzz1fHsVHDvXkllHs1iEifm-ouiDfK7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nA_z11rzVKsrmlFi4vCQj7X2Iq2zz9lul0fxkTS_OTw&oe=69E0D934"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0ewe5HZrgoQ7kNvwGqzydT&_nc_oc=AdryzUn5JjbkB3TqGhPNYHtAkwHuA1ul_xgpDn0Fb8ojKOpzm6xs7gM0CaQZt1mn2WE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-50AOgDPBoCU6z75lPyyiRihGa6HDYBeHr9uYLS9c0g&oe=69E0C881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG5Yacrf6JYQ7kNvwERBn6q&_nc_oc=AdrCprMvqHAB_UlRrU637Uym0o82vI-VcDh49ZZqLNQxD5QRmEfbi8iJNVuBxEWt2Dg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R0pdzb4ohIGoSBKdQfaJzRaTvtJwPiOoLN5_xWlOaqw&oe=69E0CCE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
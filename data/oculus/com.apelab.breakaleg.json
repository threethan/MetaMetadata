d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMaVofnz0BwQ7kNvwES3S7N&_nc_oc=AdqzDOoX1ypLYKQJBGyE8bh9RGy6a6JRV5YwmwVAojB1F6xCHbjz3NFtzR8MeJYWeaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXYN3e4j4osB5uQuiz7jfZtVnuefWBJZMIXVZnYbZPcA&oe=6AD23D8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgUZl3RnckAQ7kNvwH0USH_&_nc_oc=AdrzLHRCRv8nSKwiQHk436EBpffM3kxs8LKDuy5BfrJ5i3nZbPgoCDQDgr-YIK8lv08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwsgnQBQ3lS-_cXrYvHl8jyx1eFE2WiTPEqfUdQmq4eg&oe=6AD223D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKTmWjvMUTgQ7kNvwHaEJsd&_nc_oc=Adq89U87xpiIx4KiP0Abf7Zk0gRes7DsTQ7ao_iQ62SKrPrlsSykyB5RUwRGZSyR8HQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5lkToVH3YcbWIDrYDF2RrMyvFIuFntH8_VmAcFiF50g&oe=6AD253F4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omYC5CudG-AQ7kNvwFs6Ct4&_nc_oc=AdqJsWhvnhDxE97I8LEznQ_PKvD2-7dckz98bA_1OCKD-6u2i6vQvJTS6yEMuy6qqmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7bFjRL7rrbo3VRkAHK2BPUhBt31sBsQ6mf1t43cNgHg&oe=6AD24341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj2PEOmFADIQ7kNvwG2ey7k&_nc_oc=Adoej0vgARXfE2iS4XjIzat_K4tEHVm06SmLo5t7D3qgTfuHcDligEmLHreVBGUrD8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaSqm843PPS3DahTVy2XaYXvv4rylRwY-GuYig168C3Q&oe=6AD247A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
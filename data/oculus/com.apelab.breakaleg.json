d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14O5XZghza4Q7kNvwF6IT-G&_nc_oc=AdqpvhXrRqKcXr2UwnuO6uwma_qF4xxTYSJJ5odXHk31_m6rlVfkJXRUuIYDve-bhXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HYLgibuvn4AXgll81HtSyd1ajxMt23RFz8eegrgGBFw&oe=69ECA04B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHlyX2JqkucQ7kNvwGsyjMs&_nc_oc=AdpsNY7fMMvB3mPAFoqmxUDEBg7d_qr3TGTe7lBKAmdS4L1FXAVNLCNqZUiSVARxMLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00y0esBEzWY3FlPssSHAHRHYrkwEjU4xtJTJyJMhUzMQ&oe=69ECBED5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVrNVYv81-MQ7kNvwFhcVEn&_nc_oc=AdoN1AZQLRLverN_IZUI3beOAhgAmCZqByvrPLPEp4rxJHXfIvC9BR4sLyrdGNePD2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FT6btnykAfyIqrNdolRK4tp11NbNPsRf2XBSbpY5EGQ&oe=69ECB6B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7w61Nrm3lQQ7kNvwEIchxl&_nc_oc=AdoFwp18OZeQUq9AcaGQWpyXbtq-a8o5vRncw3_nEow84euSyDBtXeCyWVMVmoqOatE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32m-pqRR5Q2wOvOcICXCHu1wrILUUVqh5ekNIdQ7YeWg&oe=69ECA601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4Nu1WDi928Q7kNvwGNSs1f&_nc_oc=Adp8vtzQfANbagaawWPkgXud8mY3MPwPIyq2FxStzB7lf7XZfJSkPJTOr18E7hXbuHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15Ze1GkwvLmSc8mU7Ic4CGjgf7Hldfx-DrpeWNSohTeQ&oe=69ECAA63"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
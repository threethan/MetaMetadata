d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35kWNjn0OkMQ7kNvwHyNcPr&_nc_oc=Adrc7RKsFjEpfHiTAkd0U0Ib7BMeRGxujbwV62Z8saXweJS6sSkTOZLiZ0DWKGOLJI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Yru6V6LxgMW5Kil3ZR8DIZPSWPJkrOxoVxNqyxSsCqA&oe=69EA358B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHlyX2JqkucQ7kNvwHkSmkv&_nc_oc=Adr138XqY5kRteXCP3uduM_WBrpux4LuaiWdwzauz0OEKht09lxQqiOjsYUJmQ5suz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17wdwyv8jQbiljNe6_yRkfLSRnL7j7xWjhMXD9OeX7Ag&oe=69EA1BD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZgWJN1vIjkQ7kNvwFi7h9B&_nc_oc=AdpX26qPl2i9W1CEBiV0zudbFvebKDQaSC0tlC9ywUcm4hUg6rY374D9xP8h3u4NYqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05xM4M1CESg-N03czBHDd96FPUVvLeHrB8XLp8zo9Njw&oe=69EA13B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZVdoQaacHAQ7kNvwEXdO2f&_nc_oc=AdpumUBbLzFsQ7VufZ3kvnDxtQbvxNtZ5kqthphoMagteJ0TI3fkviVm2AMCoMH_1Tk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tEhQJ-oWgwD1C-fGw7mbtPkkMZ1LjShpxbsO4Ya1aVQ&oe=69EA3B41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x07CAUbCFAMQ7kNvwFwdt-c&_nc_oc=AdqvlKVEpKGHhRGlu0mZ_RM9isiDQDZEIx6jSKZlJ2wDp_tUI0C-wGX0b0vRkRtj1_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eoDzH0w0Qm-NlwPgrRtL7Qov4VpaTUMQv2d7QdOq6Ug&oe=69EA0763"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAlZNJLMJtcQ7kNvwF79BXO&_nc_oc=Adr7f9qsy3HftMhYE3E_JsXFfyC9xZPCwdoWEy7DTT_EhxQ6O_x-T9z6Q_uohd7_c5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOl2vgBg7TGoGADm4cbpmSLic7tEkpA4FcKkXAclcqBQ&oe=6AB53C8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLFRKF1OAHkQ7kNvwGg1xU7&_nc_oc=AdqFOJlV17iPJUSFfa_Uj92HRelqqHhtl3UjElTG6PW0crjap4kyOGtaJzBvBK4a0jo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJZ6Xsy4GcBqrGthepTp-TuH4geJkJ4V2zxXcwzfvSLA&oe=6AB522D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P-bSCoFBwoQ7kNvwEMvBeX&_nc_oc=AdoyyvCk3KvIu5G7jWSRmgHstAJxcFsIioIr4QZqs2CDD60Dy3VfetIHcS-6I0yTTNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl-WKklxxsg2Gm2fPWxKhVHTV4KEdqzZj8CeiDl2GKtA&oe=6AB51AB4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ChBMbQbn_cQ7kNvwEO0Zhs&_nc_oc=AdofWfAjR3RWXDl1yKFvZegQXo5l2NJnmenN1JAE_37kcIJc4trGrUUKc2ND5SUwI_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFds3btl0sk32qsZQ78CIQakWIQagJXfvresGiMuqSjA&oe=6AB54241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nsj47jncQ0Q7kNvwGSWfg9&_nc_oc=Adq3fcFSx7gpbT_GWfBUA8Bjv86NAuvVirCXGtU2fwJJYgXlI6aDkysztO1uzrf5dGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe7NOj28IxWQZAhrZXNK1f0lnd3BFGq-a5QCixXXBHTw&oe=6AB546A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
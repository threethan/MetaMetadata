l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTVa3RWKvAwQ7kNvwEzByI2&_nc_oc=AdqV-kuW4xJI2lYLGKADBBsN3aZiyBgKdvLHVJWFqYloIMJK072dTRfVkmZM_577o0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUSRO967btAVv1cictKat55xrbTmdbjiRh8ACkMAHDxg&oe=6AAD538B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66Fft6rLgE4Q7kNvwF7AT0F&_nc_oc=Adqtke7i7DvR8-kkwBoao6l22okqWWtfYoAwApCgfgeNaw0gAV2VMx7GJOHy3Tcxk9Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnFIDVu0MR6NgEKRlXnRA1e50PXt9tJOz7SnQ7U9mM7Q&oe=6AAD39D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGgMSfSJ4i0Q7kNvwEWdTmn&_nc_oc=AdrPnOSr_DBdD2wQUygYHeKooXrkpOXcAP3lY_YplMdPAtTt9BKnkSpq00p_YTwf9-k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6xy_zHPeoUl18Z8mdCJ2iemLf1xpjM_Yj0ojui85PYw&oe=6AAD31B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_mAx_28UAMQ7kNvwGXtjHs&_nc_oc=Adrifo8sCdgCxdzuBJTM6ayl94cEkKrP9GiXFIcX_pnrmHfDBNpxebUmXCACaX80amw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvTqOZ-yqnGvAeqWQ1hahNfmyQEmJF7Q1rVKXZmPEjug&oe=6AAD5941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEBu4zrBWRIQ7kNvwGIgH7W&_nc_oc=Adoras5MDwcORGsNQXi5q1XE9exN-Iipv22WJFfKIfhj6JpjCrJXgul9agoeNAw7INc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDuBvr5ckdGfQIwrzirFNR7VxMpsai5UcT2UU0IWL0Jw&oe=6AAD5DA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
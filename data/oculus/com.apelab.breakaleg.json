d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy08JUUKVXIQ7kNvwFuCkWD&_nc_oc=AdpZ5krvt3FZoRCC12eAVyEX3qqkFwRZxL_AVOr_-5f8vjRGm1yxcKgf6TUbjzsyZO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuOW0VRrRwtkJeRNzNM236Yn6nfSpyGkH-c3IUIb8XBQ&oe=6AA6BC0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70F5QmEilB0Q7kNvwGZmp0o&_nc_oc=AdpJbZbAzNRI8GDZqbr5EDtEkPdxRvFEGufuDNPomoIUBKhvLpAUkCgn6hky-tKDElI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAJkYgEKBYAzJQbMua29MwtLLD3_vP0g7Cl5_zQ3MTrA&oe=6AA6A255"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oA5i3fluUSMQ7kNvwHctkJ1&_nc_oc=AdoDn8fzJUQwmL63gP60Z2Lz0YNGDwGqSD-VEOpyHSf44K7R_6VaQ-Pa-QvulIDrWQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_4hI0T_q8vNHc6htB2hshrWMhNjDOQw5aPyVQLIbeVw&oe=6AA69A34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zQgVGUAD_oQ7kNvwHYAUNa&_nc_oc=Adp5UmqLDTNgmXrOU2jls98B0m7GE9k7YkV2fD7FVz6c498p9-fi4XnlCTUgp5LrVTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO_Me9UY_UGUokHKjnpxwlGPlafQSDOxN6u2ZbrO1sGQ&oe=6AA6C1C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-X0jdW28sEQ7kNvwHpOaJS&_nc_oc=AdooAELgWFDm27QRbpYWkG1fh6jg_Pabe1ROFiBgTlAmhSbxcWuekmdbGFuagPXO7A0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa0zMV6wN44zfg7WS-EWHn2vFUqQnJIxEewurl3zlB6w&oe=6AA6C623"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
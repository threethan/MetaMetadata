d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHD6iSaexNgQ7kNvwE25oSG&_nc_oc=AdpJ86L7k-4uM-0NfhvlW7Fi5g48k8j7YEYEUOq6-XUDN7-jtAqGdw8az3Jn0jvIIKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2A-wNqxpWMKaAYhFnqMuuCIn-BPNUiPL_iy-6G9A7YFA&oe=69F7648B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpC_ZAkvnK4Q7kNvwG0Oj2U&_nc_oc=AdrmLKqlJ0LXRrhqzDNtSpUVLSnF3FZaI5qPXp6bX6uny6NHiq7VPStuirNbE-MbXSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TtxA_mu2ZiD83QO6fEfKSwxHVnIAfQK5zjpXAPhxecw&oe=69F74AD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5EGs0mh9gEQ7kNvwELEnyw&_nc_oc=AdrDPT4bjmmkLamYsB-V8wrotCWaH-f3ng8QMih5tKapU65FWcrfW4KxIn-DGlJmXFs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2x2xFADzJbC0oUjk4yYYei5a0ad6C55HkgRcNdEuW7Qw&oe=69F742B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nEmzjcmTd4Q7kNvwEVrYzj&_nc_oc=Ado9mec6cqn8OlJrpA39OMJg8XCqz4N0sZG8nRHcQczaYqjIYcutMbA0VHHoC5pimTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LMZSGd6VUxCToR1DRc0JMIWU9Hl2EOJDclkjn_3pcYA&oe=69F76A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBOh_56Zaf4Q7kNvwFvxLu-&_nc_oc=AdofbpBbJvHYxY7r2a5Nd4oLSa5VlZvNMzSVmcqV-hi3cKkigYR3ZgRkpI7gmMFk9Rw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fWglAB3p9jZOuwbUZF-LE6YpAXbF4WcdhKuF5Jf3y9A&oe=69F76EA3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
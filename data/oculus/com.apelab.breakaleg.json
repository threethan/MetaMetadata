d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJVWHIydP7UQ7kNvwHtTiBh&_nc_oc=AdphbR9Rjn8vAUNBov0v8duSB_8FvqmsMPVh6nwDFatwv-R-OZ1FuUpIudPfaZdmhe0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwicT-p37CnBX0-mnbLVydYqAdXfCI3KQcX0enk3GUrVw&oe=69C907CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpHfqeL7-nwQ7kNvwH3LaPG&_nc_oc=AdqrpJ2jjxD_CjTpOJJbCn6dwLSf2R6kfP1aK9HWwu2r6-swBdXtq0nVimXXNmcSrdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUXOBQ7vCk14sJTlHM4Ld60hZBxvWnVyNGVqXu_YKBXw&oe=69C92655"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyUAIEO7cDMQ7kNvwErIApb&_nc_oc=AdpXA5ldJARbV-qLXVSaQXEGB9WM0s2rPJ284xagpCWWnYQgD462pkZ3Sq0RBcQ7PnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyu-k8TRm_OmW50iinXAFWJBvUH9X9zjWjqnbVAwD-Bsw&oe=69C91E34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV561_kVzfYQ7kNvwFs5gyW&_nc_oc=AdofnOKgSDfPxz_kbdLevK68pZ6JM7U2CpggAo8-J6mXUW-eqLDLPD6sJK2-cDfJJ3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfsjUwRZewn6fRJHz5qVMog-R64VWa3UMs_f6-zq2xeQ&oe=69C90D81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PVWtGksD4AQ7kNvwF7T5k7&_nc_oc=AdpgSmBvmLUOGi4n25eR6BP3WuWK5iP5WulZqt57Dxh_2W9l0UlYEcaddxVkUJ5cwbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRdNfpPAbk4-GtyV7G-pVAy9jC_v2HYqC6Xob55Yi2rA&oe=69C911E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
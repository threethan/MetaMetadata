d3-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSo6yjdOdRcQ7kNvwFpCkLt&_nc_oc=AdoaypwYVoSo2bYJTKLL7y22zBggnt27LOqOvez1Ugpu9-EHgqPaUiBHTZNPSaZlJfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwyfHDn58u2UgzbRXMY2qR7QUlfwVMyUqz6Gr8ReCMiQ&oe=6A57A20B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SgLXkO845oQ7kNvwEyYqei&_nc_oc=AdpsHjsAXMT_tMJBWzWrZmv-rXDVv-D7I45hmPBYR0zl2Spdatf_HzXT67kH1r-XnvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARUQkEzlEhF3G1eJxcUzrpKONm-2UJ-S0f5BG7VpmNxQ&oe=6A578855"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM9S7a-KPyEQ7kNvwETobLi&_nc_oc=Adr4qCXH3mNTHXBLRZGnpt6YEBjYC1Nm6urqV5vSr1Kr6KtWB6IEwTbynrpQ6YhKXlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTlxHCTVhcKZGkFhB9kEenyIOjrRlYaDmZZCqFZ9vmgg&oe=6A578034"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMJzeXxcT7UQ7kNvwGhaJac&_nc_oc=AdpxAqvSlnV7o-Hx0YsRXIcgbVYLCzwKYiMf_nS7LRB6lYV_2jvmi6hPlhN77aKqRLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjNIyfLLR80Y2G2MaXnQarSL4iEIm-BOHEgrDVb5ivSg&oe=6A576F81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tL93-vqf9UQ7kNvwHlyBRc&_nc_oc=Ado-5pyRN1G13KM40YM74-xQG3ft6qtcxAX0AdpbSkvKP2D13AhLNaGV1wjMOlbJl5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCof6EGngUMrV-o3Wzk854_yv_FiE-ap4uOP_KylKrGfA&oe=6A5773E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
w6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqNFf6zdS5kQ7kNvwE_gqhO&_nc_oc=AdqXVTR0GLZgPp0PdVEdOV6ChJ7K7B54zaE4ffDQxsQtq4JZr8vhVZ5RK6TWM_7j7qE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ESsBIc7loUyYR7JbEoBOuTQ8QREQ7IGqGqle32DgPTQ&oe=6A26DA8B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMD5xePWik4Q7kNvwEdRWLo&_nc_oc=Adrwl5Twr5JDY8KSDkWSTUBD1nmzBIwSwgZIIo_nZa3xZ2RjPDlMuUByC9I0g0dwvIw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rcIjJqcdIJNZ708w-TJGlGP-CBXAvuFyD9Pc2J-s_IA&oe=6A26C0D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=127bAb41J_AQ7kNvwGVT7_e&_nc_oc=AdrX6tBqvLi9QwQmFOi2qvZll3INZzLohXit2wSQseMVgy6NG5GuFpQb3udesbvhekc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X_e8DinzSvTUVFIliNBj1kNNsCPOTgr2NjuFMaNYtww&oe=6A26B8B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izbogDmvIboQ7kNvwF5PykQ&_nc_oc=AdpXyBxCPFKQITE3KIujMWVv7aE83mKu4kAH4OvXvAKmrpXMRN9RCT4vQMwdQREeGh0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xOgWz_rxpyOLZlTqum7IvqlAnLD9jsHVTO7PAFnJ3gw&oe=6A26E041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7B_FmEdNpUQ7kNvwFUttkU&_nc_oc=AdqO36Pn87b2YHcHDP6Ld2p25IFsuvaRmJ1CaawLvr_QeodU7nUAMQv40GhYCYtXqhU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cXvN5h6JvXFLjiGebeRvbiYt2tiZzxFlfKPebZBicdQ&oe=6A26E4A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
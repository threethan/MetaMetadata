/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0YoOYZ7PH8Q7kNvwHjEC-g&_nc_oc=AdpUruT9Xz1dsATF1FOaSZUGDWXrjmz9fTcYcoXthIsmTT_dUoBmj03q40_yqOYLjkQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyY6XRj_dubF1ZCsqp2yih7UuefnJe1wDkyOpV9oZ6eXA&oe=69C11ECB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWebBKBq1ZsQ7kNvwEeECc9&_nc_oc=AdpnGQ1eMAU2o8AUu8CplP4JMxBoO5SIuFPilXgquGLQ-rfhyN8CqD1Io0y_vIwBoPs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMEHw6NeQKqSk12K6uaJNRdbLYs5d6ZW6EyIA2tC_eTg&oe=69C13D55"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VftSu4rdrakQ7kNvwGgwHVC&_nc_oc=AdpA9-BbXdQDmwWiya4zqeE6JRwnjvsMuJjQp4FU56klKHFZUSPo9ZgJbVKYYUju-fg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxF2S1e8tu4htAUyyH9PD2AVQtnmvbkHjqhGbCeripjdA&oe=69C13534"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHcbmrYtLCcQ7kNvwHlndlT&_nc_oc=AdoO837GJ3_QMzrB2rOIhktddX61VGgnrCQWmDPa56MLKhbmr0z25ScHii5zf7cpaPI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcbVCJZv9F79Ypr9pCnzzdG64-4isTGKMmJo6z7FCWCw&oe=69C12481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI80SB4z9VIQ7kNvwGhzHSD&_nc_oc=AdqiLx0pgS1PjZWil0gs7dfkdUHgr5aeohcGW0guVIRM_WeKRNftmm27yGx5j8cDm00&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVgef-40UZgiX4Sd2sZ2Ascm-OhUVRrQ7QOmUr4WYgwg&oe=69C128E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
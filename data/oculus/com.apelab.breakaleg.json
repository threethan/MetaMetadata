s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v8hZ5ZQ89oQ7kNvwEHUFOI&_nc_oc=AdphvKZKrhGHSvowi5j4RxymaLGZmWmpNIrPcTQtbBcQnaSw1fFKGQgFmeLhYVWdMAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08e3_yJESIHiT3wKuP9xZsX76rgrnETDvNwTPS4AlLqg&oe=69DA2B4B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8RpB-0dvJ8Q7kNvwFXVoIS&_nc_oc=AdrYmUH5OskRmwybxGu936Pr2P95JLZUiGiKzWto02RCCyQefLCNPH-b3zXOuhIfsQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UbSuVmjvxRwKVR_NjWQfXo4z-EjRjr636HHnqfNCNwg&oe=69DA49D5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7rM9v_Tby4Q7kNvwFexCP_&_nc_oc=AdouzCszGq0G5QlELyyRhRbsp2Zn2KlonbS2d0gyuitI8ix0etTVNCFI4MVE_2mCPQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0__RRO9wTGZK0btz98qKP9DqV2HSN8oxrZRrJbmddF_Q&oe=69DA41B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szxpJYzKt8AQ7kNvwEiupAA&_nc_oc=AdrmbbvfTOIbnyb0zvqCsrIyP1u9dGmpAwFX5s2uHTypDst7KjIDXEM0ZzGsT3CK27c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g_SRnebivbw3xXUONEzKR7j1GVj5AMViR9kQg4TxdDw&oe=69DA3101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmcmcnmtp8UQ7kNvwF6nAOu&_nc_oc=Adr8BMQaXNZLxE8wd21PIvMXImxrvrCnxPgwvy0FxZMseK8bvMGucIdKH-HiNkvzBHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KY5fIsv4wgl0g_VneF8gdg8sqvCNiXMt95CJ4MaU9kA&oe=69DA3563"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
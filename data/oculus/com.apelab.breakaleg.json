ntent-sin2-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bF3Yjq4aPqYQ7kNvwHHshfH&_nc_oc=Ado9lK-TzfbyHaVI7_O5tIH_lBxN8VNeC0ukJaozKHw9pj2HTfKt911nWuhYXegnSjk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnbGKRtUtQGUQzjlBRe6QNfj4wkWeLxA2-1yDeCJEhKA&oe=6AA95F0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Xn7wosDeIQ7kNvwF_ynUT&_nc_oc=AdooLCS2I0lr0KIemrYjivLLP36yEOYXbkmstOnyR3c4Bf9nfZPwawl03Z0PFwa0-3c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ11QM08j0GB2xNsJAoOcLZUsU1JuI1CejgLXDYOopLTQ&oe=6AA94555"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihPP1fAnH9kQ7kNvwHUp4CJ&_nc_oc=AdpPJOzPtxEpx5r8Gw_vmYE6bv9wIQEbOgfA3iygRCMomF_xv71hLrBjJdvyLtw8xVE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuCDa3Iw846koIsFyGsnZpbgSBr4_LLgV8kC1eVuJgZg&oe=6AA93D34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0hOoiq63IgQ7kNvwGwItL5&_nc_oc=AdqI4K5VaZWIwGE6lfvRfrqbBNBDUwZIVXPoKswOKlZA-AnY3wMcurhDxL0gRcVjLu4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKhNGJ0W0wStfeFPqA-Cr8wIvnIjblU5g6P_81yDanqw&oe=6AA964C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-X0jdW28sEQ7kNvwFPzKVl&_nc_oc=AdqqFcadufwJzoqx1Hd_MdJ8uWcbZdiuFcFMgQyQ0OJj1iY4I1_bmi4wDjEWmCXI-xY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzJ97sQU0fKUCnMlqn9L0P00KRHqt-VZe7zx_9ZJVWfA&oe=6AA96923"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
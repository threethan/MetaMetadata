d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd3ihXLy8skQ7kNvwFncRAu&_nc_oc=Adpbaar7pbzA3SMfWr8Dw3fZXD_ySk0KV-BKK_kH3yFCC9CpKIjgQpIfCpPL1f9EMno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkdpkUKZfjzOu0Vp6q2l774P0_zUwmMjKGYfOkTWZgoA&oe=6A998D0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HevwP0KPpRsQ7kNvwFUDqdc&_nc_oc=AdoU494gibC4Oiyt2lTc5kmLYb3tjPioYRGBQC0ASHK9JHnqSTvCjMrGJ_9RpLwM6SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_QJjTGbPA5bYZ4y5mJ7wyRE7sHZvgy1opctgcfXgLGA&oe=6A997355"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZam387d4h8Q7kNvwHnAIb9&_nc_oc=Adqjb65LQ2jvN5pmKs38Mj7c4zkweDvGwfLH2x9Ko9rPqGYm1thhX-ImRWJooGZ6X_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdlOdGHyxebBg2gRSfMLlJOTXGB0VIgOyUsEHqJ6PxEw&oe=6A99A374"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu-LXdX1uKkQ7kNvwEmIH_p&_nc_oc=AdqNKq5nGgw1vdFJa4mw8BktuFnVE--oRTjUKbDHpmShdMv3ExIfa7nQ9t3nMpBYok0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIWQ3shoaYnJwbzq22f3cOTFxarvPHDD5CPdwUhvJTNQ&oe=6A9992C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_p6YktgCBsQ7kNvwF8x-s7&_nc_oc=AdrcqWQRhuPbkYCoam3yUT9fifR44C-2Hzmogtnx0lf5CtqVWKR5K_gi_OQ_wlaHrqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2A52F_BSuPMegVvAt4H9pB3OQe1BIZSQ6efKaCXF3rQ&oe=6A999723"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
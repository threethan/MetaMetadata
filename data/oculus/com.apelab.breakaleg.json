content-lhr6-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icklaq7DmDsQ7kNvwE5K-dp&_nc_oc=AdowkJ83hKTjM8HCftuIdhwrwpQglHkZR8FibJq5DZTUyD_g7jGQS0iOnbHw_ph6UG0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF063qPrv7R3lwPof0cnuStasNWTHnNswIA0ro7uI4vVw&oe=6A8EC8CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v-ltL4cKdsQ7kNvwE5sRCB&_nc_oc=Ado6xZpcYP_Eo-eVr42r3ENyewrZcokKQ62-Np2SL2ODwhvJFIWAMHrcdpGNqOyaA24&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNbkz_xgk2I-6E9HPCGlUzIE5vCAeKp9K_xVr4DlXVhw&oe=6A8EE755"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3kzj8ohIXkQ7kNvwFE5oZ5&_nc_oc=AdpPwzFis2_BVofoZrp_7wL6CdaBzmw_XicphLasX0JhdDJuRu4aE1BI0IvjS5g6zkw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-eBNPybjrDfUGboxDFih2e2eBvDmtBWyCxigjoDYayA&oe=6A8EDF34"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyNUAbHe7QsQ7kNvwEUYRQr&_nc_oc=AdpaYQTjFNbLhHdhe_DePhhwElGYdFPv6v-gsrDhvwkPaxPX2VVnL4-TH1FiHT-FmYA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxEJbLCvsc1G854-KzmYoT1XmkiXhb8whSHsG1kViujg&oe=6A8ECE81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zknx82CXvroQ7kNvwGnMcZT&_nc_oc=AdrDpNcva_-SfV6PKoA5AY2H-MGJFfgcpV4asJIhE-IHHy5VrJBIqT_FBDb2mtGVb04&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL9QlbOOFyw2KhUEFqGnkoTdWY3SS0L5V2zMhRTkXBow&oe=6A8ED2E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_sub
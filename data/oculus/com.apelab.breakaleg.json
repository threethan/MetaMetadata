c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtTfD-Fnr5IQ7kNvwFVQBL4&_nc_oc=AdpRlz2uu8MC0SSAf98Z8RGhPnSttUe6L4_dvH5TlhriD6ihG7qV8qMLKKd5aoTGid4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOdpavDB4Sp6kDJMlPoWIgQwsSS73llz0m78Rwtk0xPg&oe=6A6CBA0B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7IS0GEqIu8Q7kNvwE-wQc6&_nc_oc=Adq3DLkAQ3bjuO3jPxGPWxOMzkv9nN5dEr_rF4VQn25L-kstp7R11C32pTQcziFpsmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmHXFQA2fsSVAneHqiitRL9a7N3D-yI1JoFbipYRIf2w&oe=6A6CA055"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_SckOIc7DUQ7kNvwECROKg&_nc_oc=Adp8nkfgxh3Vmjo_7Oo9mFlmw9o_0EXWCTnAPvr92vnq7m9D91SagcdmoUZ6bFfC9nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhB6FUz_3HcJC22wA4LF1e9ZvqEbVmyLFpkd9qbhjZeQ&oe=6A6C9834"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxed1CT6jIcQ7kNvwGm6N3N&_nc_oc=AdoXA9zNPJa3jCssXAL81RwBy6BKAWhXbni6yx5zCkQwqrKb7igF9gMzQFjXk69x_-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo7WGqV_0RF7sYSNBvFPOjVX0Gw-UNg6CPEiayRif4mg&oe=6A6CBFC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnfqy6Q0QzwQ7kNvwHI4IRk&_nc_oc=Adpq-6ur7I1MOXwPaJLOeH8FTFMYPMwQqLtbn2nR6D2UtFSzBu82f2ik1rZWT1YRorc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0E9lXxKSle2moicAYOaVYMaBOJS3afORvzdYSv0A4yg&oe=6A6C8BE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
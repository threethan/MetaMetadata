/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5BNyTVsD8YQ7kNvwFmQ1Ko&_nc_oc=AdnZLIrW8kdZGzLPzuwBorC4SLO2YAfVFTs7NUnBSFSjT9ojn-n5n524XzoPef2fQM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzceZBqwhT3sWk9Qhn42dQU8e7lbTIQPZuMI2lUTJqyvw&oe=69AEA9CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IS_UFL5avkQ7kNvwH6NRAr&_nc_oc=Adnu_fPsHNjvwsM9CYLouVgvdCu_CdAghRhI4xspnAmVetSZ6YBlfP_qSnZY3ZJ-B0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBHsPv_UqAAh-FqdkN-U_GC8lJ65bpuMtwCZArD_ANnw&oe=69AEC855"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAC-EZ2J7dwQ7kNvwH5lklK&_nc_oc=AdnmfdC6tR8UsK9BzERFibux62D1zlQXvFNrjM0KhrRX1Kh7iG3lkF7BxB2LK0lgCGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD_ESYA4j6c6oHyKSrVQM-sFfjddPFouSUV9lVqLsFkw&oe=69AEC034"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9-Vzw7ltnQQ7kNvwGVM65y&_nc_oc=AdlCDKPbBmp4pOYSlGcOSLypRv9upHhj_nUKSeLnMnxTKpXT2pIV0V4X8N8O0IKtFp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWotUKdDNWhX_iIm0aevXZNKuCn8Ut1goIkxuXXFys8w&oe=69AEAF81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGCdW8eDcnYQ7kNvwF7KVxt&_nc_oc=AdmzdBHV91XHhfpMumvpeVv2ruybJsRcAc7LjfszuPhsfNkUL0X5XIcsQwuptmab8F0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeYjeJFQodYZA36C596ec0A5q9MuTYmstjK7OcKQJuEA&oe=69AEB3E3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATIO
s2-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83anU2FgZeEQ7kNvwHSg3iW&_nc_oc=AdrVIkw73jaiMQsCOCzXs0TzlZ5kO5NWB_NbMh_Hqb9pRE4kG2LwN0VWq8i6vqODbfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83znwEV9Lk5n4sNULJFhGG7sYku3rc31Ce4Hl8WLYaMQ&oe=6A31668B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx0gqBCcPyUQ7kNvwH1H-U_&_nc_oc=AdpWXhjElsBic2xQdy5FkIIPVpLw7xvIkYYkeWZkOABjlX3HE5fcUErDHZw-ev0l_l4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cSQoudmX5vWveTGvPg-kBDV8juXqoheWhjE5g6rVmhg&oe=6A314CD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5e_UUuNWMLUQ7kNvwEDwlNN&_nc_oc=Ado8rytsT7t31WpQXvj6HajsCKEPqXA5Mx4jzApQNtbsPnpik28IKFzkG7jkIZLPfdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TXLAcEELT6BcKz6I20bk3nJs8O6_Rpg5RIa0OwWlvUg&oe=6A3144B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIPbWmLkZEUQ7kNvwFBqMBQ&_nc_oc=AdrJ3hRt4kzRlBfqQWtcCw2Vj53S3MVd3yarmI4-xCEJwD89P3rrFBCZuPvKglvta4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o5mQhBFKOkQcjLYaSlCgu0qrIsLwZyqEuR-ExpwmEjg&oe=6A316C41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOGJn7HI64wQ7kNvwHQgHHb&_nc_oc=AdqneT0JG1UDpo-fxQGnFo8562d6pTkxjgFQduzsPmK71hE5jHzjfkG3P-YPixbjhuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DQYcintjmi971iqRnqkcqsSHGLbfApTGKmebTA_dTmw&oe=6A3170A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
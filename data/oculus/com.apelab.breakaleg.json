l3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsb_D80lCQUQ7kNvwGT3XMj&_nc_oc=Adqf7nlTczCR31sFJ0JP_9olNJUtJz1jxwYmz5AD_WC_WAM1ooStGUrDa-XvUxMHN9w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM55jQXWVrDH88eeYijDcs5fU_6aXzFzOHr0mk8WgG3ig&oe=6ADCC98B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2VMf-6MdOMQ7kNvwEMpu6-&_nc_oc=AdqxuXsRB1VhA4eN4XFR3Sn0rWz4gIOUchu5-qMgSXdJquUWi5Z5wgqQvk14F9NDwIc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqVj8FTz4HKNPD8oPLt7oHYK-IeV7qKAhJeGqqwR7TvQ&oe=6ADCAFD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1HW0WiimeAQ7kNvwFfWva3&_nc_oc=AdoTaqRPQmzrUpQf_e0HTcipbL0pFH37PbZjsbLOqSqb3i4PGpzZ5jTUX6TwK36iYhI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgwl-_vhJBdV2QK4mMmetDAglaCyUaTnMhXn89s1E_dA&oe=6ADCA7B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qay_yUAI31AQ7kNvwGyjlBk&_nc_oc=AdoBS2PtJDzyEqltTzYknD5o2Njcd5wGtl2VI0nSdeTtqA8B-F_6LMj23Mes_O8Dae4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc_8a015gRkCkVRR6V8W2RvGHzrtiT5jTEF8shmzc82A&oe=6ADCCF41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7Hl48ihILMQ7kNvwGp8fc7&_nc_oc=AdrYZ4xN_MifVWNXNpmgRs07QSkctChqkl3NzybS0VQ85VQQCbx3udsqxC-0N-BTGgs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdw9wlVcFwyeeF7R-bQ1qZaHkozIuLDhpz-SegDpZFNA&oe=6ADCD3A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
c3-1.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udl-GYDN6tcQ7kNvwEzPSQo&_nc_oc=AdpCSvre4FeXzICebQSOlZJ83VXG6oXgw5PkPmkH7OR0-b30X6f5iwya3pJ59WHtcbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB4wrm67FZmovEPWhMRjTXR_VQdiWCPQIPle8VEtbyTQ&oe=6AB2998B"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNr0XbgzWqsQ7kNvwECWuLV&_nc_oc=Adp9sYvToru99UJZ5eVu5Hix2Oqmx7xrXUekUF5qKe1BzVrWBX8RFCPlnYhfRq4fyfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxIRP8HUvWuqO4wQFan_c5l7cTnYbL4YeKEqnc9G4bcw&oe=6AB27FD5"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIeJvvHq18IQ7kNvwH364KT&_nc_oc=Ado9vp7GWPQUfYZtcU3R6qQ266TEUa78CM1Ukc31N2FnqTPivVLKtFkAratc8GsO8ok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa9ymIkmdCbkuQzMQIe8FYGsLIBTa63xCdgNApicYQnQ&oe=6AB277B4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYNXo4sQ6aUQ7kNvwFnW00X&_nc_oc=AdqKMLsBvVkvH4UYCFyMh9lM8cgdoJlyHqcAuSpU5_KF0DAHJQFGEIVfrPoL0llnpcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWH3xmBIUqRU6FUkdniH5VXXXHScDu5SFzgNJJuT__BA&oe=6AB29F41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nsj47jncQ0Q7kNvwHJ7yWA&_nc_oc=Adp14ITHMLyT6HHPBoDQa2ocT5qkwfNJkIPOALpQ1ORAEp1_oMydccGN9fwn-6Cxols&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKikPE30ULNkFvxOySdSAjzTUfLWtXSBQyIfuBgybJ1bw&oe=6AB2A3A3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
d5-2.oculuscdn.com/v/t64.5771-25/11162694_324965564644067_127833521107501056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twT6cuoVXqwQ7kNvwHwY_ew&_nc_oc=AdpsUbckDZf1bDk_bPTy3TSft8stfi52BH7wzOXuBEXotur5aV_n6bjnyFP12pIgf8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3qj943Doto3srNPJlc57CMbrZ7a0Sah1XAftHCV-S_Q&oe=6A95D0CB"}, {"file_name": "migrated_image.png", "id": "1681201982019052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386200_333001757110341_7986645352251916288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUsgFkB6FtsQ7kNvwGhUHP9&_nc_oc=AdomOrmPX9M6u33oqV4tbCylaIFzyYfO1ElCNMJGEA7MyMU1vgPVGT_ajuzL92HGaoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1t92EtT7GOIsD3T-4mhPdcfToguiAe2edA3GfBS59-A&oe=6A95B715"}, {"file_name": "migrated_image.png", "id": "238783880635704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_370823760008391_1615348551624163328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCWQ1NY6_qQQ7kNvwFhfk5e&_nc_oc=AdoYpHU3gkeg_4U18eQ15RljuOOxGTZtrK_aDqpu3t-lAHS60Kap7F8HUKcv-Fa0yvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMPNTgfVgTSwUxskYne9djqDcLi93id6hmtjVS2CmcbA&oe=6A95AEF4"}, {"file_name": "migrated_image.png", "id": "206586677225229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_190765171493331_1285669735316324352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM5L7JqYkQkQ7kNvwH2qNUO&_nc_oc=AdrQbrPiZ1TCS1kcfDKG3FZZ_5IDiEMETK0XCTO4jRyF6eHpVBSbOZtZJ-GC5sNB_y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-L-dVEh1BxpsScmt024Dke5-CPN6_iYiRiRij6YsSkg&oe=6A95D681"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BaL_CoverArt-Landscape.png", "id": "150723655630875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_150723658964208_1592275076776984576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_p6YktgCBsQ7kNvwEsGlwm&_nc_oc=AdpdE1z5JxXZb_B_nmCTkXsmAfzqvclWflADzezQxdCO1lpdZipWi7ASdQREP5rakCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLDzBCdyziqQbJbXMMN2VbQhV2nRqGqYXhC6XLRMGiGg&oe=6A95DAE3"}, "display_name": "Break a Leg", "keywords": ["magic", "story", "game", "wand"], "long_description": "- Break a Leg (full game) -\n\nYou have been kidnapped by peculiar alien creatures. They want to unleash The Greatest Power of the Galaxy, to finally rule the galaxies and worlds beyond. For centuries, they have been looking for a master illusionist able to control this universal force. Only a human magician can unlock the mysterious apparatus sealed by Houdini\u2019s great great Aunt Maggie. But be careful, those creatures do not like failure...\n\nBuilt from the ground up with apelab's SpatialStories creation toolkit, Break a Leg is an award winning interactive adventure designed for the Gear VR controller. Inspired by the magic shows of the 19th century, it immerses you in the offbeat adventures of an improvised magician who will have to go through multiple stages of a conjurer\u2019s performance without missing a beat.\n\nLet the show begin!", "short_description": "- Break a Leg (full game) -\n\nAn unknown species has kidnapped you to unleash The Ultimate Power of the Galaxy. They believe only a magician from planet Earth is able to master this universal force by going through the Ancient Book of Stellar Tricks. Do you have the necessary skills? Find out in this peculiar adventure using the Gear VR controller. Break a Leg was made with the SpatialStories creation toolkit (www.spatialstories.net)"}]}, "developer_name": "apelab", "developer_privacy_policy_url": "http://apelab.ch/", "developer_terms_of_service_url": "http://apelab.ch/", "publisher_name": "apelab", "support_website_url": null, "website_url": "http://apelab.ch/breakaleg", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type":
ideo_trailer_thumbnail": {"file_name": "landscape3.png", "id": "1127878951263047", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974871_1127878954596380_6514816579245165761_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmAUzylTjQkQ7kNvwFWqyGv&_nc_oc=AdosOFKBmAHc4Wr-ElcPnjYMzv1Qhl5uEdpApg5gcLEk9K9iCbjq8XDd_6zbvk1sR3k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1O63iiNmvVWq3buS8vZzxQ_feVLNAZ6m_etbzX_RZgA&oe=6A22E73A"}, "display_name": "Wonder Trips", "keywords": [], "long_description": "It's time to discover different wonderlands and enjoy your own trips.\nHave Lot Of Fun by riding, racing, para-sailing and more..\n\nWonder Trips is designed to take you into different lands to enjoy many trips and activities.\n\nYou start by a beautiful landscape view around the island; Then you get your free time to discover different monuments and parts of environment; You are lucky to participate in the racing and to be the winner.\n\nBy the end, get fun time over a para-sailing and enjoy the wonderful sunset view.\n\nNew trips are coming soon..", "short_description": "It's time to discover different wonderlands and enjoy your own trips.\nHave Lot Of Fun by riding, racing, para-sailing and more.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wonder.sayoo.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SAYOO VR Studio", "support_website_url": null, "website_url": "https://wonder.sayoo.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
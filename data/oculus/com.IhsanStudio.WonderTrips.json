_trailer_thumbnail": {"file_name": "landscape3.png", "id": "1127878951263047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974871_1127878954596380_6514816579245165761_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yqJGW-diC8Q7kNvwE0UWVF&_nc_oc=AdpgWwBDiw2UnvnwVe4n_k_EzknRvUs5A96mfhOyWR3QuWWQHaCSXnWPVhSQ77z6pZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1AO-GdDsgWaZRuCMMHHxgaJU1UyqddsWwSsWd3pkgEA&oe=6A70777A"}, "display_name": "Wonder Trips", "keywords": [], "long_description": "It's time to discover different wonderlands and enjoy your own trips.\nHave Lot Of Fun by riding, racing, para-sailing and more..\n\nWonder Trips is designed to take you into different lands to enjoy many trips and activities.\n\nYou start by a beautiful landscape view around the island; Then you get your free time to discover different monuments and parts of environment; You are lucky to participate in the racing and to be the winner.\n\nBy the end, get fun time over a para-sailing and enjoy the wonderful sunset view.\n\nNew trips are coming soon..", "short_description": "It's time to discover different wonderlands and enjoy your own trips.\nHave Lot Of Fun by riding, racing, para-sailing and more.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wonder.sayoo.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SAYOO VR Studio", "support_website_url": null, "website_url": "https://wonder.sayoo.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
700452_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3hg17BiJnwQ7kNvwFsYKIL&_nc_oc=AdrLqdEuRbRUYVSthebuEGeaqzgdmwIwL_au-qorr_ItmYYxuaVCNH-KcTxKxMjYE4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmKYf8ic76dZeceMst7BPkFPMGS5TX13dr67_RLmJ4vA&oe=6B01C97E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "1127878951263047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_1127878954596380_6514816579245165761_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfQsAZN7HpoQ7kNvwFkBk9F&_nc_oc=AdotTF8Bpdxoi7v3p9bZPB5VlECOq2niLxKtHkxKAj5fXfdHiL0o17tvGempLa41JHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjatr4IOa0mAKq6UAMY9Ma3KrbkZ-hT7_XT0k70AqAjg&oe=6B01ECFA"}, "display_name": "Wonder Trips", "keywords": [], "long_description": "It's time to discover different wonderlands and enjoy your own trips.\nHave Lot Of Fun by riding, racing, para-sailing and more..\n\nWonder Trips is designed to take you into different lands to enjoy many trips and activities.\n\nYou start by a beautiful landscape view around the island; Then you get your free time to discover different monuments and parts of environment; You are lucky to participate in the racing and to be the winner.\n\nBy the end, get fun time over a para-sailing and enjoy the wonderful sunset view.\n\nNew trips are coming soon..", "short_description": "It's time to discover different wonderlands and enjoy your own trips.\nHave Lot Of Fun by riding, racing, para-sailing and more.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wonder.sayoo.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SAYOO VR Studio", "support_website_url": null, "website_url": "https://wonder.sayoo.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}
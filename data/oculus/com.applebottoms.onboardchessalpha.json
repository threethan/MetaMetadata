0", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822924_1783161778937333_3939975369318646972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ4xP6vbJwIQ7kNvwHtWeSA&_nc_oc=Adonu7Xa212JUBpR94T7ibtK6ZmHwnSakJxSmlJxnYpplQiZdmb035bB-D8bswGcCqA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaZY2hf7fpF4NxR-RstREibuquG_wLs52bgq_X2clwaw&oe=6A7DB3D5"}, {"file_name": "494966c9b1604a0c82472b374363fe26.png", "id": "996368815808009", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823968_996368819141342_966178876641732340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXtJRyO2uTAQ7kNvwFN8Qqb&_nc_oc=AdoIkpFSWZLsBugtKuHbenc5WS00NUKRKpDctUAcW2gTgf3913PN5VNTUTg3O0ej6lQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMlxcttLm7bMjD9H4xNIlKV9zIgXCcwD6Rixk6hSCQKw&oe=6A7D9952"}, {"file_name": "67315fcb04b44ff2864cdb9a10db0ae0.png", "id": "732357889719165", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819473_732357893052498_8558105112975537782_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Uvb46_XPigQ7kNvwFLdYy_&_nc_oc=AdrmgowddCG323OG8IvNCyumAacXvGmuQ7ZNYn5vSOnjIPZLLCBUGHnHSM5ixbmHU_c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEobrbWmCaED5ShqV79rkzCpcYvjExV87Ea8r0FC9k43g&oe=6A7DA194"}, {"file_name": "30fb290492d442bc9c978e28c8229b6b.png", "id": "1296560675177471", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828846_1296560678510804_4429810267946563798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aCXFZhkpFQQ7kNvwFfYO7J&_nc_oc=Adpi1IyS4bA3mRFhDlNXei_-TI-vOAzhFxh9B6uBNNeP9fDBmC-vUUWRphmS26W08kw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5jNQbDGwnbgSGlpu4zzSnMak-sMSLK3Xf-usP7OPJfA&oe=6A7DA76A"}, {"file_name": "moon_chess_2560x1440.png", "id": "1415118929750539", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820548_1415118933083872_4149511354847082836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTxsLqO2M0MQ7kNvwEVT46D&_nc_oc=AdqcuwWujYLJPe4SV7QehVZj6AtcvJTmfBNoyBZsjQKx20KT3OqJnqonWCUOKgJ_zgM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8Kyi_YNPoak4ssyIieoPbW6pb57o8_fPRoxmaAjReGg&oe=6A7D9E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OnBoard_Logo_Extended_2560x1440.png", "id": "1237346655103656", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307311_1237346658436989_496582574634891286_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdKx0vlAuo8Q7kNvwEMJGGD&_nc_oc=Ado8YUh1uwIh7Acn43-zr_JsbmeMIk7Rt5QPjbdd6UJoQElROCCrmhz73mwVCxg38Gs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOFjYABiWynAi6OzHU6FqRT7s4ayM6x5bqjDWimd7_6Q&oe=6A7DBCD3"}, "display_name": "OnBoard Chess", "keywords": ["Chess", "Board", "Game", "Strategy", "Puzzle"], "long_description": "OnBoard Chess brings the classic strategy of chess into an immersive, competitive VR experience. Designed for Oculus Quest, this game lets you sit across from real opponents in beautiful, interactive environments.\n\n\ud83e\udde0 Play Online or Solo \u2013 Face real players in multiplayer, test your skills against AI, or connect with millions of players through official Lichess integration.\n\n\ud83c\udf10 Lichess Integration \u2013 Log in to your Lichess account to challenge players, join seeks, view your games, and track your rating \u2013 all within VR.\n\n\ud83d\udd0d Game History & Analysis \u2013 Upgrade to unlock powerful game review tools powered by the Stockfish engine and evaluation bar.\n\n\ud83c\udfa8 Custom Boards & Pieces \u2013 Personalize your set and table to match your style.\n\n\ud83d\udd70\ufe0f Built-In Timer & Ratings \u2013 Compete on a global leaderboard with an ELO-based ranking system.\n\n\ud83d\udc50 Hand & Controller Support \u2013 Move your pieces naturally using either hands or controllers.", "short_description": "Want to improve your chess skill? Does playing on a flat, 2D screen leave you disconnected from the thrill of a real-life chess experience? OnBoard Chess is here to change that. Offering a truly immersive, over-the-board experience, OnBoard Chess brings the excitement of chess to life. Challenge players from around the world, play Lichess games from within the app, earn ELO, and use the powerful Stockfish engine for in-depth game analysis."}]}, "developer_name": "Knight Vision Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSwv9-bsMu654mwfp55ZWr0v_Udke3dlf72R6Wn8sJdIjewPRFFRRtzn_XgUcBO92DhrhSvZ08mREaJ/pub", "developer_terms_of_service_url": null, "publisher_name": "Knight Vision Games", "support_website_url": "https://discord.gg/GaNgYCrPUa", "website_url": "http://knightvisiongames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27053563587575455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1112947857270268"}]}, "baseline_offer": {"id": "1112947857270268"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754539380, "status": "PUBLISHED", "id": "1112947857270268"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38006970735567964", "version": "0.8.10"}, "id": "2771344013025596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fal
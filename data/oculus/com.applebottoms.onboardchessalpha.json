6Gc&_nc_oc=Adrbj_yclTFbyyv_1zsEp1zrkNCoQ-OGfqHAqaS52hOzJgpczqutYLuEVwdHUpW-8e8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pku-Et7eXUVKCS7x4oBudVX9Wr5wJxme2OIXlDMbmJQ&oe=6A3D3CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OnBoard_Logo_Extended_2560x1440.png", "id": "1237346655103656", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1237346658436989_496582574634891286_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acWPKDu8WMwQ7kNvwEPJ10_&_nc_oc=Adr2BfF-zsOQAfw1n3l_i9qfhAR2-h0rOgBjQY9ZnoaDhRoHtFsXbAfWuxZgal1S96g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EdJ3N7QKI0hS1YSCHPm1sgRunV9ge5VFFjLJK6uLZDg&oe=6A3D5B93"}, "display_name": "OnBoard Chess", "keywords": ["Chess", "Board", "Game", "Strategy", "Puzzle"], "long_description": "OnBoard Chess brings the classic strategy of chess into an immersive, competitive VR experience. Designed for Oculus Quest, this game lets you sit across from real opponents in beautiful, interactive environments.\n\n\ud83e\udde0 Play Online or Solo \u2013 Face real players in multiplayer, test your skills against AI, or connect with millions of players through official Lichess integration.\n\n\ud83c\udf10 Lichess Integration \u2013 Log in to your Lichess account to challenge players, join seeks, view your games, and track your rating \u2013 all within VR.\n\n\ud83d\udd0d Game History & Analysis \u2013 Upgrade to unlock powerful game review tools powered by the Stockfish engine and evaluation bar.\n\n\ud83c\udfa8 Custom Boards & Pieces \u2013 Personalize your set and table to match your style.\n\n\ud83d\udd70\ufe0f Built-In Timer & Ratings \u2013 Compete on a global leaderboard with an ELO-based ranking system.\n\n\ud83d\udc50 Hand & Controller Support \u2013 Move your pieces naturally using either hands or controllers.", "short_description": "Want to improve your chess skill? Does playing on a flat, 2D screen leave you disconnected from the thrill of a real-life chess experience? OnBoard Chess is here to change that. Offering a truly immersive, over-the-board experience, OnBoard Chess brings the excitement of chess to life. Challenge players from around the world, play Lichess games from within the app, earn ELO, and use the powerful Stockfish engine for in-depth game analysis."}]}, "developer_name": "Knight Vision Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSwv9-bsMu654mwfp55ZWr0v_Udke3dlf72R6Wn8sJdIjewPRFFRRtzn_XgUcBO92DhrhSvZ08mREaJ/pub", "developer_terms_of_service_url": null, "publisher_name": "Knight Vision Games", "support_website_url": "https://discord.gg/GaNgYCrPUa", "website_url": "http://knightvisiongames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27053563587575455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1112947857270268"}]}, "baseline_offer": {"id": "1112947857270268"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754539380, "status": "PUBLISHED", "id": "1112947857270268"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37083073274624386", "version": "0.8.8"}, "id": "2771344013025596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
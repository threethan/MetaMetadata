 "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822924_1783161778937333_3939975369318646972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9e9HkubnLgQ7kNvwHhiC8b&_nc_oc=Ado-FbTIf8oQ1ut32203Ut0GQd4217n9mjQcN7IhOtIhAMNk5GzHfAfMS9dXi6Tp8S4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw8nGoCwLBk2mA-o3FHmBI3FDTi9-WKxb5zFj0bUOnWA&oe=6AAA86D5"}, {"file_name": "494966c9b1604a0c82472b374363fe26.png", "id": "996368815808009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823968_996368819141342_966178876641732340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azpAI9xQlDEQ7kNvwF4gRbY&_nc_oc=Adp_94s1adxHikACs4sDdDqSieIE8-uJCwcS9RUW0eRJaRpTEwUf56z1S20JfI7lteY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3euKMzQZw90qLhTp89OlB6GKYExWMKrwwHznvQ85SgQ&oe=6AAAA492"}, {"file_name": "67315fcb04b44ff2864cdb9a10db0ae0.png", "id": "732357889719165", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819473_732357893052498_8558105112975537782_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2o1m_aOWnYQ7kNvwHENM7d&_nc_oc=Adr6JJWS-4Cr-Zzlm07IQlDQIdVIU2UEuDwOInb_85Jbi_dgwc4AGdmxOy9YP546t_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOXZDTw5QL1AoY4Fra1-9nnOoS7N4LUyLF8ey2Sa9bqA&oe=6AAAACD4"}, {"file_name": "30fb290492d442bc9c978e28c8229b6b.png", "id": "1296560675177471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828846_1296560678510804_4429810267946563798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5fL9fKM2i0Q7kNvwHFuxg2&_nc_oc=AdpRUPbmBhvK6Zkjj8YLhYnDcMvgRp1NsbbCMeLqV2G6KgGSD6p3Db_geK4BWGNFMrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTx6enYkHe3CCccs6446Wlc7zUduOHK1A4g7fkPCU6PQ&oe=6AAAB2AA"}, {"file_name": "moon_chess_2560x1440.png", "id": "1415118929750539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820548_1415118933083872_4149511354847082836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ3EQBYdghcQ7kNvwHk3K8R&_nc_oc=Adr6p6rFvY7HFsnVYL84YBa0YDu9rtmscI7brQL3ZDT-5v_0Lz-KufdKgNcHeilELjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLWOSfNf73h-8hIZ8XOTd3PD75ibqHdhLKpVLBytv52A&oe=6AAAA942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OnBoard_Logo_Extended_2560x1440.png", "id": "1237346655103656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1237346658436989_496582574634891286_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MFurlw9HJEQ7kNvwEmmnht&_nc_oc=AdqwmagzjOHH_pqqXcRIDbrquDZfZM8647iDMAqmN8iE1gU6TAqL64QB_21x3_82Fl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLyI-v370liZSuTbYGNxVyLDwmyFGmh92GSEDBZ6LLNA&oe=6AAA8FD3"}, "display_name": "OnBoard Chess", "keywords": ["Chess", "Board", "Game", "Strategy", "Puzzle"], "long_description": "OnBoard Chess brings the classic strategy of chess into an immersive, competitive VR experience. Designed for Oculus Quest, this game lets you sit across from real opponents in beautiful, interactive environments.\n\n\ud83e\udde0 Play Online or Solo \u2013 Face real players in multiplayer, test your skills against AI, or connect with millions of players through official Lichess integration.\n\n\ud83c\udf10 Lichess Integration \u2013 Log in to your Lichess account to challenge players, join seeks, view your games, and track your rating \u2013 all within VR.\n\n\ud83d\udd0d Game History & Analysis \u2013 Upgrade to unlock powerful game review tools powered by the Stockfish engine and evaluation bar.\n\n\ud83c\udfa8 Custom Boards & Pieces \u2013 Personalize your set and table to match your style.\n\n\ud83d\udd70\ufe0f Built-In Timer & Ratings \u2013 Compete on a global leaderboard with an ELO-based ranking system.\n\n\ud83d\udc50 Hand & Controller Support \u2013 Move your pieces naturally using either hands or controllers.", "short_description": "Want to improve your chess skill? Does playing on a flat, 2D screen leave you disconnected from the thrill of a real-life chess experience? OnBoard Chess is here to change that. Offering a truly immersive, over-the-board experience, OnBoard Chess brings the excitement of chess to life. Challenge players from around the world, play Lichess games from within the app, earn ELO, and use the powerful Stockfish engine for in-depth game analysis."}]}, "developer_name": "Knight Vision Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSwv9-bsMu654mwfp55ZWr0v_Udke3dlf72R6Wn8sJdIjewPRFFRRtzn_XgUcBO92DhrhSvZ08mREaJ/pub", "developer_terms_of_service_url": null, "publisher_name": "Knight Vision Games", "support_website_url": "https://discord.gg/GaNgYCrPUa", "website_url": "http://knightvisiongames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27053563587575455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1112947857270268"}]}, "baseline_offer": {"id": "1112947857270268"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754539380, "status": "PUBLISHED", "id": "1112947857270268"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38959808056950889", "version": "0.8.11"}, "id": "2771344013025596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
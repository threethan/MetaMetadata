B"}, {"file_name": "cover_square_1440x1440.png", "id": "879580888483919", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/761640323_879580891817252_6876941502948905449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tjv9D22s9YMQ7kNvwEsOXQw&_nc_oc=AdoaxdMCCSrgA5ikevnT6hA8CmBYPmIz7FHMLR9WZWDlJd0oSGw1Ns1Ppb-OupzBY-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzkOmdBZXUg0B22359gYA_LO_hu32Kq3saka2-FABvdw&oe=6ADCB514"}]}, "id": "2085942178956637", "locale": "en_US", "screenshots": [{"file_name": "ss_lobby_plaza_2560x1440.png", "id": "1794998301811366", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303976_1794998305144699_7709552132248264175_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9RIBZIS4TQQ7kNvwF5Rol9&_nc_oc=AdqHRtwksY9dHFhZThT7YfnVInflqoO48b5Dm-cvjHCKO60_hnSlLqYDiz43faL-l8M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTR60cHnZMxgAP9b7h5orrFaSTxdV_rrKQ1ZYrayA_cQ&oe=6ADCBD12"}, {"file_name": "ss1_gazebo.png", "id": "1124186773479879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312439_1124186776813212_1841756093664337464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVGWFzej0QkQ7kNvwFna6Wd&_nc_oc=AdqRvuK7WxjICwZLlrZSKel465vB9tZwIKhcpCajw9XIuUo4S7F-ApSdk0OS2DX-n7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6ih9vkDtshSggenhrG-bYC587KQ8EXkvUUEsByvFsuw&oe=6ADCBB6C"}, {"file_name": "ss_pov_game_2560x1440.png", "id": "1443641651286492", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299745_1443641654619825_5227599424884171735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZY6uwdalyQQ7kNvwHksad4&_nc_oc=AdqXhFpTOONIZMi3leHxrvGOndFSMRUcLk_WMlwJ5mjbqdBAuRdPnd8LIM8fPSDGwzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEAKnaEb_150sVFv0Bmt0RxwIhD1V6ETAIiXGAFqcOHw&oe=6ADCAB74"}, {"file_name": "ss_pov_review_2560x1440.png", "id": "2334294777370864", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296027_2334294784037530_8910587631868332273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iqWYbxsoRMQ7kNvwH2bydH&_nc_oc=Adr2iOjNgAr7UsRC37T12RganzEwhoBrUpUI2164c8DkIrCAKTJYl1BAjBCITtpA8CI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZeopNqJtXL8lFtqg_zsw-GeC-N-o9pxmhTFmmzUuufg&oe=6ADCAFCD"}, {"file_name": "ss_pov_puzzle_2560x1440.png", "id": "1081637151165630", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312380_1081637154498963_3076388731855490662_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIgq-IHJK1wQ7kNvwF3D_6s&_nc_oc=Adq555pfwXHePeKAT-ZriIlpxp7MHs1vMvaRAXYrORfkb0kb_nJGCLcUBaPw5KU_mBg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVTBe4gdt2Fa49wkQuzpp8qRE60pAgaq-xx5jX48PRgg&oe=6ADCBC08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1772692817275316", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294643_1772692820608649_9158288212011671320_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SodCqeM6IdkQ7kNvwFIYW_X&_nc_oc=Adpn0wLZ4su1sM72z76Kgc81YWVkCCRrLzdHzhREwwC_OyAvIvhjTM-Zm9yTUz1Iv2A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPeXpnJrU5MQRIOMppRDhk1Es1Vr13Mu5yCd-Fy2jVNA&oe=6ADCA44A"}, "display_name": "OnBoard Chess", "keywords": ["Chess", "Board", "Game", "Strategy", "Puzzle"], "long_description": "OnBoard Chess is the chess club of VR. Real players, real boards, and a seat waiting for you at the table.\n\n**The OnBoard Lobbies**\n\nAn open lobby where you can drop in any time. Pull up a chair at any table and play whoever's there, talk across the board with live voice chat, or walk between tables and watch the games around you. It feels like a real chess club, with players from around the world.\n\n**Ranked play and leaderboards**\n\nRated Bullet, Blitz and Rapid, with leaderboards for every time control plus Puzzle and Puzzle Rush. Your profile tracks your ratings, record and recent games.\n\n**Puzzles and Puzzle Rush**\n\nTrain with rated puzzles, or race the clock in Puzzle Rush.\n\n**Play the computer**\n\nPractice against the computer at any level, whenever you want a quick game.\n\n**Lichess integration**\n\nLog in with your Lichess account to find games, play rated Lichess matches on a real board and track your Lichess ratings without leaving VR.\n\n**Game review**\n\nEvery move rated from Best to Blunder, accuracy for both players, an evaluation graph, best lines, and a jump straight to the moves that decided the game. Full review is part of OnBoard Pro.\n\n**Make it yours**\n\nCollect boards, piece sets, clock skins, avatar apparel and nametag borders from the OnBoard Shop and seasonal Chapters.\n\n**Hands or controllers**\n\nPick up and move pieces naturally with hand tracking or controllers.\n\nGrab a seat. Your next opponent is already at the table.", "short_description": "The chess club of VR. Walk into an open lobby full of real players, pull up a chair, and play across the board with live voice chat. Play ranked games and climb the leaderboards, spectate any table, sharpen up with puzzles and Puzzle Rush, or take on the computer at any level. Connect your Lichess account to play Lichess games in VR, then review every game with a full engine analysis. New chapters, boards, pieces and apparel arrive throughout the year."}]}, "developer_name": "Knight Vision Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSwv9-bsMu654mwfp55ZWr0v_Udke3dlf72R6Wn8sJdIjewPRFFRRtzn_XgUcBO92DhrhSvZ08mREaJ/pub", "developer_terms_of_service_url": null, "publisher_name": "Knight Vision Games", "support_website_url": "https://discord.gg/GaNgYCrPUa", "website_url": "http://knightvisiongames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {
18646972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2v9ICwOB4cQ7kNvwEk68Jt&_nc_oc=Adns-j5ZKQ8yGbZL_KvnQXMPazASy4fWji4NgLmubnlyzk3ThNZOW0SFonW5ac8rer4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvvfxzvh5KZX_2l7HgeOYxtoMCphbJoYrcSWjzLZNRvmg&oe=69A42C55"}, {"file_name": "494966c9b1604a0c82472b374363fe26.png", "id": "996368815808009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823968_996368819141342_966178876641732340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuFF2LQ3k6MQ7kNvwEVNfIC&_nc_oc=AdlJCT5sj0hEPdhhBspjibUaIdWA3Hz5TjfC4IAz8ucSExfRyoUvACNAr6NPaTnTloo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv4o9oIf5TScx_4suNrHRHodjQNF8jjCqwoZO0SbaYa6g&oe=69A44A12"}, {"file_name": "67315fcb04b44ff2864cdb9a10db0ae0.png", "id": "732357889719165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819473_732357893052498_8558105112975537782_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2VnVavdHXIQ7kNvwFvDfzV&_nc_oc=AdlHgBRrApuOEXTuNivPyCOV0hUDSucBB7Mj9ITS9IV6Ta5kYpgHKt0N8BKPNTIZHPw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs5USa6BQjSEEtFVBZ6LkkQs7E4RuGbE354w8EbT11_tQ&oe=69A41A14"}, {"file_name": "30fb290492d442bc9c978e28c8229b6b.png", "id": "1296560675177471", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828846_1296560678510804_4429810267946563798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqN1JYEiKR4Q7kNvwHKZjXc&_nc_oc=AdnhsfSDFaDcyEI5ZPdSq6_0u7xZ5DO6633ii8_rtGuA8Bo0ZlbDpH2bmFesBMOK9S4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsETEXGdc7qB4smYwRxQ7ayp6OwZJ9NVmOCcGt66G6eUQ&oe=69A41FEA"}, {"file_name": "moon_chess_2560x1440.png", "id": "1415118929750539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820548_1415118933083872_4149511354847082836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrvXna2i180Q7kNvwHW3z-_&_nc_oc=Adkw7qLxTP2pdFoqXn2OTmxieNZQlK5Q2ilMecKa0_90oyFml8ZQgDUXpYKxFWcWDqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfunaOhPsdskoywWYWKajenba6CwUjVunIqG9D2rBzNrAQ&oe=69A44EC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OnBoard_Logo_Extended_2560x1440.png", "id": "1237346655103656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1237346658436989_496582574634891286_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isvpuL2pr6kQ7kNvwF8wBiG&_nc_oc=AdkvCRzkx_aKvh-3xjZlCuhiL8wJBAI_VehnK6Sv9dgfHUxhOXBaIQNLvfGGyCys6gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft5oQ7LypqgjuSohcTx_IIGMFyNq8a-09K5ORWu1QRbJQ&oe=69A43553"}, "display_name": "OnBoard Chess", "keywords": ["Chess", "Board", "Game", "Strategy", "Puzzle"], "long_description": "OnBoard Chess brings the classic strategy of chess into an immersive, competitive VR experience. Designed for Oculus Quest, this game lets you sit across from real opponents in beautiful, interactive environments.\n\n\ud83e\udde0 Play Online or Solo \u2013 Face real players in multiplayer, test your skills against AI, or connect with millions of players through official Lichess integration.\n\n\ud83c\udf10 Lichess Integration \u2013 Log in to your Lichess account to challenge players, join seeks, view your games, and track your rating \u2013 all within VR.\n\n\ud83d\udd0d Game History & Analysis \u2013 Upgrade to unlock powerful game review tools powered by the Stockfish engine and evaluation bar.\n\n\ud83c\udfa8 Custom Boards & Pieces \u2013 Personalize your set and table to match your style.\n\n\ud83d\udd70\ufe0f Built-In Timer & Ratings \u2013 Compete on a global leaderboard with an ELO-based ranking system.\n\n\ud83d\udc50 Hand & Controller Support \u2013 Move your pieces naturally using either hands or controllers.", "short_description": "Want to improve your chess skill? Does playing on a flat, 2D screen leave you disconnected from the thrill of a real-life chess experience? OnBoard Chess is here to change that. Offering a truly immersive, over-the-board experience, OnBoard Chess brings the excitement of chess to life. Challenge players from around the world, play Lichess games from within the app, earn ELO, and use the powerful Stockfish engine for in-depth game analysis."}]}, "developer_name": "Knight Vision Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSwv9-bsMu654mwfp55ZWr0v_Udke3dlf72R6Wn8sJdIjewPRFFRRtzn_XgUcBO92DhrhSvZ08mREaJ/pub", "developer_terms_of_service_url": null, "publisher_name": "Knight Vision Games", "support_website_url": "https://discord.gg/GaNgYCrPUa", "website_url": "http://knightvisiongames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27053563587575455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1112947857270268"}]}, "baseline_offer": {"id": "1112947857270268"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754539380, "status": "PUBLISHED", "id": "1112947857270268"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34253188700946205", "version": "0.7.6"}, "id": "2771344013025596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27053563564242124", "is_c
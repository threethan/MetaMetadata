5dLn04fTl30N3O7nkqlMMZE4Ug&oe=6AFB1E2A"}, {"file_name": "moon_chess_2560x1440.png", "id": "1415118929750539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820548_1415118933083872_4149511354847082836_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDAtwbriVFgQ7kNvwG38E0b&_nc_oc=AdoKAO0qw24JACZsyXGmaUM-HILoerH-zpvhikjobV0fTNvreLvQwWuKWJbQGtNhtuk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs8-M3zkXmNA_O_MTbM-8Tcd_BX9XULNlPy9vPVRBnrw&oe=6AFB4D02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OnBoard_Logo_Extended_2560x1440.png", "id": "1237346655103656", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307311_1237346658436989_496582574634891286_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grPMIXEsxqoQ7kNvwHGaa3N&_nc_oc=Adq7d3qvqnyAagnKA2Zx72syBWNird-Eoj9v7_WmKMUNNpc-8QVOkG3jZvbGFU_1HpM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShPuZ2kPSAXSl_HuLd1lA-uGHN2nPLW_stkftLkpXiIQ&oe=6AFB3393"}, "display_name": "OnBoard Chess", "keywords": ["Chess", "Board", "Game", "Strategy", "Puzzle"], "long_description": "OnBoard Chess brings the classic strategy of chess into an immersive, competitive VR experience. Designed for Oculus Quest, this game lets you sit across from real opponents in beautiful, interactive environments.\n\n\ud83e\udde0 Play Online or Solo \u2013 Face real players in multiplayer, test your skills against AI, or connect with millions of players through official Lichess integration.\n\n\ud83c\udf10 Lichess Integration \u2013 Log in to your Lichess account to challenge players, join seeks, view your games, and track your rating \u2013 all within VR.\n\n\ud83d\udd0d Game History & Analysis \u2013 Upgrade to unlock powerful game review tools powered by the Stockfish engine and evaluation bar.\n\n\ud83c\udfa8 Custom Boards & Pieces \u2013 Personalize your set and table to match your style.\n\n\ud83d\udd70\ufe0f Built-In Timer & Ratings \u2013 Compete on a global leaderboard with an ELO-based ranking system.\n\n\ud83d\udc50 Hand & Controller Support \u2013 Move your pieces naturally using either hands or controllers.", "short_description": "Want to improve your chess skill? Does playing on a flat, 2D screen leave you disconnected from the thrill of a real-life chess experience? OnBoard Chess is here to change that. Offering a truly immersive, over-the-board experience, OnBoard Chess brings the excitement of chess to life. Challenge players from around the world, play Lichess games from within the app, earn ELO, and use the powerful Stockfish engine for in-depth game analysis."}]}, "developer_name": "Knight Vision Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSwv9-bsMu654mwfp55ZWr0v_Udke3dlf72R6Wn8sJdIjewPRFFRRtzn_XgUcBO92DhrhSvZ08mREaJ/pub", "developer_terms_of_service_url": null, "publisher_name": "Knight Vision Games", "support_website_url": "https://discord.gg/GaNgYCrPUa", "website_url": "http://knightvisiongames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27053563587575455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1112947857270268"}]}, "baseline_offer": {"id": "1112947857270268"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time
18646972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnJ3YJ2iTFEQ7kNvwH2ff7G&_nc_oc=AdlPUw0yFUCTVZNf2EYu7I67sm9joXojugbjdg2JR0zkcDw_Yv_yAtJPfezWGD4z0fM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsD0TCRdY9iJNlQnYlpWP_uKxiCVrWQY8trYWDcGbMv8A&oe=69A2DAD5"}, {"file_name": "494966c9b1604a0c82472b374363fe26.png", "id": "996368815808009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823968_996368819141342_966178876641732340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hwn7LiDE5dMQ7kNvwFs5dC5&_nc_oc=Adn6wEqDDShkwJwcFwrWPwyfVrkCisK6KedKvGS8BzB0f07AbYUXOJzg5AC-9G0Gdqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9SsqTDKJ09OlvSI5fKbK-2xpM6iw2R2iV7NEuaq-8bg&oe=69A2F892"}, {"file_name": "67315fcb04b44ff2864cdb9a10db0ae0.png", "id": "732357889719165", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819473_732357893052498_8558105112975537782_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2VnVavdHXIQ7kNvwHfH2a8&_nc_oc=AdlDsJfi-g3dl3rmtOp0hBwe397KOttvw5C0zpEYTmDRS_PMy-ogKKwMUam4ADMXwTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8VAE8iH_D2AsEIKXd7hgiW5RUZ8LAiyx5eHhRfyBRlg&oe=69A2C894"}, {"file_name": "30fb290492d442bc9c978e28c8229b6b.png", "id": "1296560675177471", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828846_1296560678510804_4429810267946563798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAlkTZqeelwQ7kNvwFJvx-_&_nc_oc=AdlMy7F2BY7rxrPk3gwifM2FvsMUjN_3OtyTcAoDJs3_tK-bUd3Qo5_aXPIFWdvxweg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuoLsyeDh90-l1n05ii7QrxVTqmG6cRWQnfVMEOo0GDng&oe=69A2CE6A"}, {"file_name": "moon_chess_2560x1440.png", "id": "1415118929750539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820548_1415118933083872_4149511354847082836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrvXna2i180Q7kNvwHljOyE&_nc_oc=AdmPcOseg8aE3KSXXMMAsFA_ZcnI4u7o201b-Ap1pZX6TaLXQ7d_E0WgrusmV-RkPKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrPINYxmqpiz_S8npH6iRVPuzeUZgbO5N9xpfUVCWvHg&oe=69A2FD42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OnBoard_Logo_Extended_2560x1440.png", "id": "1237346655103656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_1237346658436989_496582574634891286_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ1Qbd2vQ3EQ7kNvwF3MzN6&_nc_oc=AdlVv5f9JgDVmrD0FBaGavo3xjvRexJw_i96dfAQsLD63qsjcUusSk8J0WeqcdG2gD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDGlI8Sd_eKCcOIzahbl5rrGDC_q8yom8BGR1riFlFTg&oe=69A2E3D3"}, "display_name": "OnBoard Chess", "keywords": ["Chess", "Board", "Game", "Strategy", "Puzzle"], "long_description": "OnBoard Chess brings the classic strategy of chess into an immersive, competitive VR experience. Designed for Oculus Quest, this game lets you sit across from real opponents in beautiful, interactive environments.\n\n\ud83e\udde0 Play Online or Solo \u2013 Face real players in multiplayer, test your skills against AI, or connect with millions of players through official Lichess integration.\n\n\ud83c\udf10 Lichess Integration \u2013 Log in to your Lichess account to challenge players, join seeks, view your games, and track your rating \u2013 all within VR.\n\n\ud83d\udd0d Game History & Analysis \u2013 Upgrade to unlock powerful game review tools powered by the Stockfish engine and evaluation bar.\n\n\ud83c\udfa8 Custom Boards & Pieces \u2013 Personalize your set and table to match your style.\n\n\ud83d\udd70\ufe0f Built-In Timer & Ratings \u2013 Compete on a global leaderboard with an ELO-based ranking system.\n\n\ud83d\udc50 Hand & Controller Support \u2013 Move your pieces naturally using either hands or controllers.", "short_description": "Want to improve your chess skill? Does playing on a flat, 2D screen leave you disconnected from the thrill of a real-life chess experience? OnBoard Chess is here to change that. Offering a truly immersive, over-the-board experience, OnBoard Chess brings the excitement of chess to life. Challenge players from around the world, play Lichess games from within the app, earn ELO, and use the powerful Stockfish engine for in-depth game analysis."}]}, "developer_name": "Knight Vision Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSwv9-bsMu654mwfp55ZWr0v_Udke3dlf72R6Wn8sJdIjewPRFFRRtzn_XgUcBO92DhrhSvZ08mREaJ/pub", "developer_terms_of_service_url": null, "publisher_name": "Knight Vision Games", "support_website_url": "https://discord.gg/GaNgYCrPUa", "website_url": "http://knightvisiongames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27053563587575455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1112947857270268"}]}, "baseline_offer": {"id": "1112947857270268"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754539380, "status": "PUBLISHED", "id": "1112947857270268"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34253188700946205", "version": "0.7.6"}, "id": "2771344013025596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27053563564242124", "is_c
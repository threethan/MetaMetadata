477455701105_6378328677015560535_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYRKH3-24eYQ7kNvwHx9qMA&_nc_oc=AdompuCuaANcj8rZ--P9WrdvbLv2ycfvBQI2MzIq_U-D8jgv5NOKY8pM5WFvTZmFqUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtw8seJmKKyO8U72XT9aAFLf8hskmnuXYULbdTmYEk0Q&oe=6AFDDDF7"}, "display_name": "ZombieHunterWater", "keywords": [], "long_description": "Welcome to [Zombie Hunter]!\nIn a post-apocalyptic world overrun by zombies, humanity's last hope lies in the precious water towers. As the commander of a brave defense squad, your mission is to protect these vital resources from relentless waves of undead. Strategize, upgrade your arsenal, and deploy your troops wisely to fend off the zombie horde. Every decision counts as you fight to ensure the survival of civilization. Will you be able to withstand the onslaught and secure the water towers for humanity's future? Join the battle in Zombie Hunter and find out!", "short_description": "Prevent the destruction by zombies "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/87b5d61a-a9d3-4492-914f-b903aa4b4738", "developer_terms_of_service_url": null, "publisher_name": "Tien", "support_website_url": null, "website_url": "https://sites.google.com/view/zombie-hunt-game/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
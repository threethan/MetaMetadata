.com/v/t64.5771-25/499307935_887249430416578_3027113437012114210_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37gE7Ni4qYAQ7kNvwGxv3gl&_nc_oc=AdqWqRLccXi-BT9E55JEiKZy1B8TQTRf4ME7AKvWi3s8aZaC4k_9hZj6RpZskxP4zl4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwp7-KTnJTS4fL5LiBxYCy1HzvZesY7olE5XOqgrFHNw&oe=6ADE0D69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkilite", "keywords": ["monkey", "horror", "chimp"], "long_description": "Monkilite is an intense VR horror experience built around fast, physical movement and momentum \ud83e\udd8d\ud83d\udca8 Use your arms to climb, swing, and launch yourself through unsettling environments where every decision matters. The game features five handcrafted levels, each with a distinct atmosphere and growing sense of dread. Descend into a pitch-dark cave \ud83d\ude13, lose yourself in a confusing and claustrophobic maze \ud83c\udf00, endure the disturbing sights of a grotesque meat cave \ud83e\ude78, navigate filthy abandoned sewers \ud83d\udebf, and uncover the secrets hidden inside a cold and mysterious laboratory \ud83e\uddea.\n\nAs you progress, the world becomes more dangerous and unpredictable, constantly testing your skill and nerves. Monkilite focuses on tension, exploration, and environmental storytelling, rewarding players who push deeper and take risks \ud83d\udc40 The fear builds slowly, turning movement itself into part of the challenge.\n\nThis is only the beginning. More levels, mechanics, secrets, and horrors are planned for future updates \ud83d\udd25 Step inside Monkilite and see how long you can survive.", "short_description": "Monkilite throws you into a fast-paced VR horror experience using Gorilla Tag\u2013style movement \ud83e\udd8d\ud83d\udca8 Explore 5 intense levels, including a dark cave \ud83d\ude13, a twisted maze \ud83c\udf00, a disturbing meat cave \ud83e\ude78, grimy sewers \ud83d\udebf, and a mysterious laboratory \ud83e\uddea. Climb, swing, and survive as the world grows more dangerous\u2026 and this is just the start. More content, secrets, and horrors coming soon \ud83d\udc40\ud83d\udd25"}]}, "developer_name": "juniorsstupidstuff", "developer_privacy_policy_url": "https://sites.google.com/view/juniorsstupidstuff/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "juniorsstupidstuff", "support_website_url": null, "website_url": "https://sites.google.com/view/juniorsstupidstuff/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24589192994090241"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1559366765338608"}]}, "baseline_offer": {"id": "1559366765338608"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767659940, "status": "PUBLISHED", "id": "1559366765338608"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24614920381517502", "version": "0.1.0"}, "id": "890616680318898", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24572055309137343", "is_concept": false, "latest_released_binary": {"__typename": "Android
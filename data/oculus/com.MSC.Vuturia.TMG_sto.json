/491831595_4088203578102548_5670565483649572819_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIRVX_wNtXIQ7kNvwGVW930&_nc_oc=Adqxdd_yOLwhtP5_p7GNoSdCcRKOC7mB46sbKAPCmRK5pLPy6KQO2um8U72J8ufAWFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53beVA36RQwZC2IY1LS2vi6n3Mm-Vh1xIeuDeStVVokg&oe=6A1D9790"}, {"file_name": "Screenshot_05.png", "id": "626371337128657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312255_626371340461990_8378619184850362587_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h4ozucJYj0Q7kNvwGKJFZs&_nc_oc=AdoMnYGX5eL85_dwzZPwPI7GD7UmhqK0TIFUQP6WMvIAC_JbQcD2G5794NCK1Blkcjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hYxrMKyA9C2KfCUlkaLC80PvZB6cVXGhP1wQ5q0kBnA&oe=6A1D7B31"}, {"file_name": "Screenshot_04.png", "id": "1594271861266075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824532_1594271867932741_3842811992649843391_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgooQQBP2IwQ7kNvwG1YMa-&_nc_oc=AdrP_Yk5rT10RJR6K598ABpYQ6_s16sRNbQLs5HQfuhwtQRG7Y_6xolJZ8cFAhdoJbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D0u7wm_JWae0EAhpaoHwH_ONYnsvwhSnv5loKAP-zGA&oe=6A1D96D2"}, {"file_name": "Screenshot_01.png", "id": "592548107193274", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312039_592548110526607_3935699260706373165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZVyHjiBUBwQ7kNvwFMB8ay&_nc_oc=AdoKE5ljW8RiAkgWnVIPwEowqzK48LtUVkXGb-KKBQ_EdgIY3_QyyHYKLPrtIBOB9Bs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UWrFnwk2AeYSe2ucnZT1k9SgMuO-itnmGhcYzKMzRUg&oe=6A1D9C31"}, {"file_name": "Screenshot_02.png", "id": "1619317862081222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299789_1619317865414555_4715324583631629272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BA6ZVVzISQQ7kNvwH7EWvI&_nc_oc=Adoc2tbwXhd8StLB_ibMxVOKpHD1eyAvbI6MPj5Y0R5SYs_Uuz0hyZPzpP_bFcReVHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hgGCXJEu84Q5vKO2vDIyyLM7rrLZrNqii12rRa6c1gQ&oe=6A1D7A21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Minigames Game", "keywords": ["party", "minigame", "friends"], "long_description": "**The Minigames Game is a multiplayer Virtual Reality collection of Minigames for up to 12 players. The game offers a wide variety of minigames catering to different Virtual Reality mechanics.**\n\n# ONLINE MULTIPLAYER\n\nRuin Friendships with up to 11 of your friends from the comfort of your own home. You can also decide to be nice, but who wants that? \n\n# TOURNAMENT MODE\n\nPlay minigames with your friends in a tournament format, battling it out until the end. Collect epic companions in between minigames to flex your exploration skills.\n\n# MINIGAME MODE\n\nDon't want to commit to a tournament? The Minigames Game provides ways to spend 5 minutes or 5 hours without commitment. Jump into the minigame mode to play whatever you wish.\n\n# LEADERBOARDS\n\nClimb to the top in all of our highscore and speedrun minigames. \n", "short_description": "The Minigames Game is a multiplayer Virtual Reality collection of Minigames for up to 12 players. Ruin Friendships in a wide variety of minigames from the comfort of your own home."}, {"images": {"nodes": []}, "id": "1061095079448969", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Minigames Game", "keywords": [], "long_description": "**The Minigames Game ist eine Multiplayer-Virtual-Reality-Sammlung von Minispielen f\u00fcr bis zu 12 Spieler. Das Spiel bietet eine gro\u00dfe Auswahl an Minispielen, aus allen Bereichen der Virtuellen Realit\u00e4t**\n\n# ONLINE-MULTIPLAYER\nZerst\u00f6re Freundschaften mit bis zu 11 deiner Freunde \u2013 ganz bequem von zu Hause aus. Du kannst dich nat\u00fcrlich auch nett verhalten, aber wer will das schon?\n\n# TURNIERMODUS\nSpiele Minispiele mit deinen Freunden im Turnierformat und k\u00e4mpft euch bis zum Schluss durch. Sammle epische Begleiter zwischen den Minispielen, um deine Erkundungsk\u00fcnste zu zeigen.\n\n# MINISPIELMODUS\nKeine Lust auf ein ganzes Turnier? The Minigames Game bietet M\u00f6glichkeiten, 5 Minuten oder 5 Stunden zu verbringen \u2013 ganz ohne Verpflichtung. Tauche in den Minispielmodus und spiele, was du willst.\n\n# BESTENLISTEN\nErklimme die Spitze in all unseren Highscore- und Speedrun-Minispielen.", "short_description": "The Minigames Game ist eine Multiplayer-Virtual-Reality-Sammlung von Minispielen f\u00fcr bis zu 12 Spieler.\nZerst\u00f6re Freundschaften in einer Vielzahl von Minispielen \u2013 ganz bequem von zu Hause aus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tmg.vuturia.de/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "VUTURIA", "support_website_url": null, "website_url": "https://tmg.vuturia.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9609644929139474"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24850329857977733", "version": "v0.6.31m"}, "id": "1912031026205164", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only
H-Z&_nc_oc=AdpLAIzwlMgdoTO6IdCxapR13CcGicOkgSMZwTcukGJt_DlfUpl89uEDTYUHySRRscU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IlNTEgt5q00n0USxH7gMb-DjrlaiTeVbQEw1CKvVkXg&oe=6A3162B1"}, {"file_name": "Screenshot_02.png", "id": "1619317862081222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299789_1619317865414555_4715324583631629272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K212FF6FK4Q7kNvwG_cnqw&_nc_oc=AdqKZkDhz8IgqTUIR2y2i8fKcodQpAcJ7WbYC1v4XS0aD-ZND3-p2NxJ0GCm3J51ftA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B_mtJjaInUa1iVQzPVO2eIxKWxtQoSVmzbBzVFQXu9w&oe=6A3178E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverArt_Landscape.png", "id": "2759913480870229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_2759913484203562_3844212442751558475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-CQr2C6ObYQ7kNvwG22yH0&_nc_oc=Adp23Zl67lOy9EzSKvB02O19gsKO-AXHBYMFeIcxG_5LbG3HmgsE4pApg7_lJ4fm0Nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--WhK6wwDkNtJ_0d3i7luXts1MUUiFsdfBHTd2ub5xGw&oe=6A31617A"}, "display_name": "The Minigames Game", "keywords": ["party", "minigame", "friends"], "long_description": "**The Minigames Game is a multiplayer Virtual Reality collection of Minigames for up to 12 players. The game offers a wide variety of minigames catering to different Virtual Reality mechanics.**\n\n# ONLINE MULTIPLAYER\n\nRuin Friendships with up to 11 of your friends from the comfort of your own home. You can also decide to be nice, but who wants that? \n\n# TOURNAMENT MODE\n\nPlay minigames with your friends in a tournament format, battling it out until the end. Collect epic companions in between minigames to flex your exploration skills.\n\n# MINIGAME MODE\n\nDon't want to commit to a tournament? The Minigames Game provides ways to spend 5 minutes or 5 hours without commitment. Jump into the minigame mode to play whatever you wish.\n\n# LEADERBOARDS\n\nClimb to the top in all of our highscore and speedrun minigames. \n", "short_description": "The Minigames Game is a multiplayer Virtual Reality collection of Minigames for up to 12 players. Ruin Friendships in a wide variety of minigames from the comfort of your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tmg.vuturia.de/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "VUTURIA", "support_website_url": null, "website_url": "https://tmg.vuturia.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24865197889824263"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296201_9682624181849311_59945643561143835_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpoZVlK0qTwQ7kNvwEEAbT9&_nc_oc=AdpuIjotD1jix-4DOsTLR4ZNCXX32Gc0Wf02C2XyIU046tAHyBWavCK00MjFYoSdVPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eqU7A1tImnLiWRvIcXyt-fklC-4OXylaSH4PZjH87LQ&oe=6A3148AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Minigames Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1765796400, "lastRe
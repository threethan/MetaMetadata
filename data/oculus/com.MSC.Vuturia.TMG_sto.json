.oculuscdn.com/v/t64.5771-25/491831595_4088203578102548_5670565483649572819_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggjkKyHwi4YQ7kNvwH8mZYr&_nc_oc=Adqj0209anWq78dp-OPM2I-jK_L3dFvAstQiK9DplcDCg1jRlipQCVqNMIhkF5E2y9c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVkeG9dsDcrHKYaFY2qEyOuJCiem6XOor6ZT1z3xL3oA&oe=6A8D6ED0"}, {"file_name": "Screenshot_05.png", "id": "626371337128657", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312255_626371340461990_8378619184850362587_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXc-SFZjWYoQ7kNvwG3vmHR&_nc_oc=AdotjdwIW0i8JXF8lc8IXwKpTBxNRsB1WkZKjIdrfofEBjDRa5OATGL1uIKfsVxnhXk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBBkIbQtt_MJqSI6p-kEM6s6w7t7uNOgnnjqjYXlM2Cg&oe=6A8D8AB1"}, {"file_name": "Screenshot_04.png", "id": "1594271861266075", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824532_1594271867932741_3842811992649843391_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nieQ3L-XmcQ7kNvwFwq3uy&_nc_oc=Adoe3rY9LG-2S662Z8rXPFovyNRiQOwcenwQsqzNPlDj_JyaV6inLpTvu6ZKfhALVXk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgdj1eqdGDYRpXMF2QVv65K42t7Gwak9b3Pedr8L8krQ&oe=6A8D6E12"}, {"file_name": "Screenshot_01.png", "id": "592548107193274", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312039_592548110526607_3935699260706373165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi1JMjGeOlkQ7kNvwHSwUoW&_nc_oc=AdojTxl1fnVaFFAlNejLEjb2_IbcaGMEWcgDfADrhRwE0CV_eHPYj73vCV6iF9-RR4s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG2-QQADpa8eWTFCbMUNfUlBNB6Dgtb9hpv6mm5dKY_A&oe=6A8D7371"}, {"file_name": "Screenshot_02.png", "id": "1619317862081222", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499299789_1619317865414555_4715324583631629272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBwBTzYOto8Q7kNvwFBTHd2&_nc_oc=AdpThyl6mWWHHYHAIphkChSrAnhuCDIKMq3vttmgGhpaJRrbheiuRLmtn6if9NRaRcw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbA0JzuxRz32N1r5aIEx3L_zVzWJxsFAufh2ha3QWI5w&oe=6A8D89A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Minigames Game", "keywords": ["party", "minigame", "friends"], "long_description": "**The Minigames Game is a multiplayer Virtual Reality collection of Minigames for up to 12 players. The game offers a wide variety of minigames catering to different Virtual Reality mechanics.**\n\n# ONLINE MULTIPLAYER\n\nRuin Friendships with up to 11 of your friends from the comfort of your own home. You can also decide to be nice, but who wants that? \n\n# TOURNAMENT MODE\n\nPlay minigames with your friends in a tournament format, battling it out until the end. Collect epic companions in between minigames to flex your exploration skills.\n\n# MINIGAME MODE\n\nDon't want to commit to a tournament? The Minigames Game provides ways to spend 5 minutes or 5 hours without commitment. Jump into the minigame mode to play whatever you wish.\n\n# LEADERBOARDS\n\nClimb to the top in all of our highscore and speedrun minigames. \n", "short_description": "The Minigames Game is a multiplayer Virtual Reality collection of Minigames for up to 12 players. Ruin Friendships in a wide variety of minigames from the comfort of your own home."}, {"images": {"nodes": []}, "id": "1061095079448969", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Minigames Game", "keywords": [], "long_description": "**The Minigames Game ist eine Multiplayer-Virtual-Reality-Sammlung von Minispielen f\u00fcr bis zu 12 Spieler. Das Spiel bietet eine gro\u00dfe Auswahl an Minispielen, aus allen Bereichen der Virtuellen Realit\u00e4t**\n\n# ONLINE-MULTIPLAYER\nZerst\u00f6re Freundschaften mit bis zu 11 deiner Freunde \u2013 ganz bequem von zu Hause aus. Du kannst dich nat\u00fcrlich auch nett verhalten, aber wer will das schon?\n\n# TURNIERMODUS\nSpiele Minispiele mit deinen Freunden im Turnierformat und k\u00e4mpft euch bis zum Schluss durch. Sammle epische Begleiter zwischen den Minispielen, um deine Erkundungsk\u00fcnste zu zeigen.\n\n# MINISPIELMODUS\nKeine Lust auf ein ganzes Turnier? The Minigames Game bietet M\u00f6glichkeiten, 5 Minuten oder 5 Stunden zu verbringen \u2013 ganz ohne Verpflichtung. Tauche in den Minispielmodus und spiele, was du willst.\n\n# BESTENLISTEN\nErklimme die Spitze in all unseren Highscore- und Speedrun-Minispielen.", "short_description": "The Minigames Game ist eine Multiplayer-Virtual-Reality-Sammlung von Minispielen f\u00fcr bis zu 12 Spieler.\nZerst\u00f6re Freundschaften in einer Vielzahl von Minispielen \u2013 ganz bequem von zu Hause aus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tmg.vuturia.de/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "VUTURIA", "support_website_url": null, "website_url": "https://tmg.vuturia.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9609644929139474"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24850329857977733", "version": "v0.6.31m"}, "id": "1912031026205164", "channel_name": "LI
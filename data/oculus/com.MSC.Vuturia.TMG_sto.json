{"data": {"node": {"__typename": "Application", "id": "9367132470057389", "organization": {"id": "669249135102722", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9367132470057389"}]}, "id": "1729979381269441"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8883245851696878"}]}, "id": "1603032463761082"}]}}, "firstRevision": {"nodes": [{"application": {"id": "9367132470057389", "release_date": 1765796400, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 0}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24850329857977733"}, "id": "1912031026205164"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367132470057389", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24850329857977733"}, "release_status": "RELEASED"}, "id": "24850329857977733", "version": "v0.6.31m", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1753369026, "id": "9944658002304830", "is_initial_release": true, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 3, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "24865197889824263"}, "release_status": "RELEASED", "id": "9367132470057389"}, "id": "24865197889824263", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9367132470057389", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1247190423489997"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "870370725504995", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Minigames Game", "keywords": [], "long_description": "**The Minigames Game ist eine Multiplayer-Virtual-Reality-Sammlung von Minispielen f\u00fcr bis zu 12 Spieler. Das Spiel bietet eine gro\u00dfe Auswahl an Minispielen, aus allen Bereichen der Virtuellen Realit\u00e4t**\n\n# ONLINE-MULTIPLAYER\nZerst\u00f6re Freundschaften mit bis zu 11 deiner Freunde \u2013 ganz bequem von zu Hause aus. Du kannst dich nat\u00fcrlich auch nett verhalten, aber wer will das schon?\n\n# TURNIERMODUS\nSpiele Minispiele mit deinen Freunden im Turnierformat und k\u00e4mpft euch bis zum Schluss durch. Sammle epische Begleiter zwischen den Minispielen, um deine Erkundungsk\u00fcnste zu zeigen.\n\n# MINISPIELMODUS\nKeine Lust auf ein ganzes Turnier? The Minigames Game bietet M\u00f6glichkeiten, 5 Minuten oder 5 Stunden zu verbringen \u2013 ganz ohne Verpflichtung. Tauche in den Minispielmodus und spiele, was du willst.\n\n# BESTENLISTEN\nErklimme die Spitze in all unseren Highscore- und Speedrun-Minispielen.", "short_description": "The Minigames Game ist eine Multiplayer-Virtual-Reality-Sammlung von Minispielen f\u00fcr bis zu 12 Spieler.\nZerst\u00f6re Freundschaften in einer Vielzahl von Minispielen \u2013 ganz bequem von zu Hause aus."}, {"images": {"nodes": [{"file_name": "Meta_CoverArt_Square.png", "id": "9682624175182645", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296201_9682624181849311_59945643561143835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3yAV2iI45QQ7kNvwGtWWIp&_nc_oc=AdpK4voSAUibJNscIoAAzVYa6Ejrr5azW0liZ9jswLrqUnUa_6gq2QKfOVgIpAVhc6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSutkcs5gfMXMsvrFUl3hvXfPQBU7-9M3qELiyiJdtVkQ&oe=6B007C6D"}, {"file_name":
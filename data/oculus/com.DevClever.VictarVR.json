2D8oNYUS76zilP9yD6ZjnZsccKcFIQ&oe=6AFB1F4A"}, "display_name": "VictarVR", "keywords": ["Career", "Victar", "Job", "Robot", "Personality"], "long_description": "VICTAR is our Virtual Interactive Careers Training and Apprenticeship Robot your personal and independent careers guide here to help young people launch their future career.\n\nSupported by key partnerships and credible resources VICTAR is able to match young people, their personality and interests to the careers that suit them the most. More importantly once they arrive at their chosen career they are able to see Labour Market Information(LMI) statistics and information about the role such as how much they could earn, the careers growth potential as well as a video recorded by industry professionals.\n\nHowever it doesn\u2019t stop there, once satisfied with the selected career VICTAR then shows the academic, vocational and apprenticeship study options available as well as the specific courses and locations they can study at to reach their career goal.", "short_description": "Victar VR is a career finder tool that uses a personality test, interests, and Labour Market Information(LMI) data in order for you to make an informed decision on your career and how to get there."}]}, "developer_name": "DevClever Ltd", "developer_privacy_policy_url": "https://www.devclever.co.uk/privacy-policy/", "developer_terms_of_service_url": "https://www.devclever.co.uk/privacy-policy/", "publisher_name": "DevClever Ltd", "support_website_url": "https://www.devclever.co.uk/", "website_url": "https://www.devclever.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppor
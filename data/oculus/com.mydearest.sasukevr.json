-11-12 195449.png", "id": "2011093236342346", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617850_2011093239675679_4288240380084754186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwtTXliOth0Q7kNvwFHkUek&_nc_oc=AdnCIcj0YX8wBu39_J4KCi4ugmVMBRWooXfPHzde2kGe4G_OBJA_4r02_0bhnS1KLdU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEhmXbCF0Wt-fzokL1NrWtDRk6YOD6TFla1zZQ249GZA&oe=69BAAD33"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(3).png", "id": "1351315559773459", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822045_1351315563106792_3211899487096608506_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E170rwAHBi4Q7kNvwF4Fdiy&_nc_oc=AdnfNYdow3P5ojKpnhcsgl0XhGvXrlVzcF8AlXr0rqShuEyr3Ip4UXtctqWDBntBs1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYch36WMZXABBOWk2py0PFUGc_pfdpvA27VrT1-Jo32w&oe=69BA8806"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(5) (1).png", "id": "757322207324853", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619774_757322213991519_2781578561473256126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tC-RFeAiQMQ7kNvwEIqeIP&_nc_oc=Adli_yLCrlMzkqGiZAo2OWjZ_VrkS4RrrJP7YyGcdX0OrO_mFKg8zyw49ZTx1UissNI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywI5bY2mTcev-ZArlcE3eiYGXZ0f1TQwfFfJ71AtnYWA&oe=69BA8D8D"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-12 194903_NW.png", "id": "1011922691099818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619098_1011922694433151_8652263347591575943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np43mbuMfcUQ7kNvwFB9-jn&_nc_oc=AdnlbnId7v9WYJJOsD7BoBapAt_S7YnhOFJju7zg5iPGMAA83qP9U-6T2IbYI1SBvWw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzn1LZmntf0koAizfazndXdz9BJ0Jz7GbMXai4evN5wbw&oe=69BAB52D"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5)_NW.png", "id": "823153967022922", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0eaX-kN384Q7kNvwEDuJTK&_nc_oc=AdlEr0gZsz51aL5RxEmoeVsVrqnM9OIZJ66NQqx5y79yO49K7WLW1BKcagdOe1PwtNI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyrIlQwNnBRJcPk3uPvtUhtqGpGpHHDMr6lj1GNbObKaQ&oe=69BAA245"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1293441179265152", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618102_1293441182598485_5756413485734718909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTZm2gji5NwQ7kNvwFyg-Z-&_nc_oc=Adm93W_DTy-Yu86DHeKjihtnico6JhRjh8MYqummW1M69Nn_pFZsgxgLi7lIETARlaQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN8uDWoNDgHLTWYiNNM9AnkXdsLzveuHexBco-EBSUFA&oe=69BAA3E4"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "# \ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior finally moves to the open ocean. The Marine stage is on a whole different level!\n\nNow spectators can do more than cheer! Press one of the audience buttons to interfere with challengers! Move the floors and trigger traps! Will you be a supporter or a saboteur?\n\nAnd look out for the sharks that stalk the stage waters! They'll make quick lunch of fallen players, and will sometimes even leap at challengers as they run the course!\n{1235996518643259}\n# \ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n{1259564035608866}\n# \ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n{944928581554413}\n\n# \ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.\n\n", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior has moved to the open ocean with the new Marine stage!\n\nSpectators can trigger traps like moving floors to sabotage challengers. \nLeaping sharks await in the water for falling challengers! It's unpredictable chaos!"}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.png", "id": "4264163103849084", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499292426_4264163107182417_2496132574571041136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd67vKWtbV4Q7kNvwHCu3yy&_nc_oc=AdltZoS-Xbob-MNY8L61a1t8lY3EJPQyXVGRdAh19NEGVtUUndBjE4N5hFSrXg36rmw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycTGI6uFJUxBv7yxpfOWycuCJdZY2Y6krSBRJ2_9EFDA&oe=69BA8183"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "2049001385961938", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618252_2049001392628604_2311735195368987482_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt2WExfEFz4Q7kNvwHWNDB-&_nc_oc=Adk1S1I2ZiBNhtjo1HfJvplZbJhurvNdhwzFUYHPWCUPxEOpkUibpuYfnrpoY9werYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyijNrW1hwqiWxbLfNa4YZvQy-Fk6Z5feVXj3eb-VLtg&oe=69BAAF17"}, {"file_name": "\u30ed\u30b3\u3099_.png", "id": "198754
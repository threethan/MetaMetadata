-11-12 195449.png", "id": "2011093236342346", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617850_2011093239675679_4288240380084754186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSwRYgJ40tQQ7kNvwH-Tf_z&_nc_oc=AdrCqRFK4NY3po1qoyrvTUDqeuzb-ZXExkY5VcLPHWXnual8t3hyAU1cO4DiPAzvckE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgMeJRcFUBC8mZYqwo-6j5WUB9rnQPglgdkCDIlrkr_Q&oe=69C144B3"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(3).png", "id": "1351315559773459", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822045_1351315563106792_3211899487096608506_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8P8-n1dXxkQ7kNvwF6wsZM&_nc_oc=AdqFsAdv_19aufyO4ZMaaJmMCxRa4hswuvKvrYYy8eq2tlVatZp8nQFFq5V7gLYfIuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5Tkh72HmcU_jCqdjoYSP9rnrEKw-gysKoTzv20ReLhg&oe=69C11F86"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(5) (1).png", "id": "757322207324853", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619774_757322213991519_2781578561473256126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veP9zE4LOugQ7kNvwEB0XJw&_nc_oc=Adq1YNIebrqO13rAt6bERKjpZbNQiOWBvwOohqHTQaTB_ppkREZOoV04AC3n_Tx3Nsg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwA4VrPQBSuqGeqRPv9tSGnoresflTHN-NU-H7_3mlR4A&oe=69C1250D"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-12 194903_NW.png", "id": "1011922691099818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619098_1011922694433151_8652263347591575943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BxJc0ATDa4Q7kNvwFu0rII&_nc_oc=AdreaSGF5J5hzbLmOsFBehgdsD1Tm9E0Iaw7jgEhBMF38GQTiKSb_Q9_8mKJp_MDj_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyv2kG8-lqNNxpfBeOHMe_UQTLUdJLFFef_Osd1zXOn4A&oe=69C14CAD"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5)_NW.png", "id": "823153967022922", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgmsXa0v1d0Q7kNvwHDesMP&_nc_oc=AdpG3eaOW_8UGJGQYVY7GJx2Re8H2f-DtfKlBkXA9croxoTgp5ayCytJajBjYNmd5Ig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOafuIV9Lq_RMAAtbBrqSvJoleqCks0GjiHrhahMEy-Q&oe=69C139C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1293441179265152", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618102_1293441182598485_5756413485734718909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2BFO51g9NoQ7kNvwF55GYw&_nc_oc=AdqfbXCuM9UDpQZGATUwADjP0n8vJOcYJxbRTdnk0vpT2GGcFVAhYPY0rIPHVHtzWrQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_yFJHbmTP8mr-ymKkomqZSN3Ep07-EoIJ_hPAnOT73g&oe=69C13B64"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "# \ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior finally moves to the open ocean. The Marine stage is on a whole different level!\n\nNow spectators can do more than cheer! Press one of the audience buttons to interfere with challengers! Move the floors and trigger traps! Will you be a supporter or a saboteur?\n\nAnd look out for the sharks that stalk the stage waters! They'll make quick lunch of fallen players, and will sometimes even leap at challengers as they run the course!\n{1235996518643259}\n# \ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n{1259564035608866}\n# \ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n{944928581554413}\n\n# \ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.\n\n", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior has moved to the open ocean with the new Marine stage!\n\nSpectators can trigger traps like moving floors to sabotage challengers. \nLeaping sharks await in the water for falling challengers! It's unpredictable chaos!"}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.png", "id": "4264163103849084", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499292426_4264163107182417_2496132574571041136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl63Ea_tVmIQ7kNvwFfcbPM&_nc_oc=Adr9dYxzEodWAXnJEyVbqJyZ-EM21R4sB4WAtqaKuToMDhkBw1mwZyOWH000k1W9O_o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSSBQYhxX-AE5mJwx5zuyclK-g5f546QAfQc_8GdHS6A&oe=69C15143"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "2049001385961938", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618252_2049001392628604_2311735195368987482_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ8MCFpZVJkQ7kNvwFjJKdF&_nc_oc=AdqbkEm6N1RWkrVI3HEIp9ch7UN6m2LgLSqjsZ2GoXg-g-KfjnxOGxuP-Nq17sEAQxQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2co89UirGipeamckGV1C_YAYdbVd6C5q9KeYNRqyMCw&oe=69C14697"}, {"file_name": "\u30ed\u30b3\u3099_.png", "id": "198754
jc3-1.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xdQPFiK8KQQ7kNvwHkBX3V&_nc_oc=Adobhw6J-BVYo1wdkA-hpbsh0QO2GRQ54EtHor0ex2tKaTu5UxlB_F0ff1ZGrLjSarY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29vFp74Un0ICxIXEPK5QVj1hVBhqNGU4rOsBgjkp15Fw&oe=69E8C6C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1293441179265152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618102_1293441182598485_5756413485734718909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLEnW7npNOIQ7kNvwHekW2A&_nc_oc=AdrIfvvemgLmdVhKBlqXr9h-zOMNUkzN5WgKp8B-GEvqqFn6qjEUol_bpGkz_AlOrQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p9FYbULD9LbDlGesgLw753c7yWOHhgbMQ7SRSEF_qag&oe=69E8C864"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "# \ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior finally moves to the open ocean. The Marine stage is on a whole different level!\n\nNow spectators can do more than cheer! Press one of the audience buttons to interfere with challengers! Move the floors and trigger traps! Will you be a supporter or a saboteur?\n\nAnd look out for the sharks that stalk the stage waters! They'll make quick lunch of fallen players, and will sometimes even leap at challengers as they run the course!\n{1235996518643259}\n# \ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n{1259564035608866}\n# \ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n{944928581554413}\n\n# \ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.\n\n", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior has moved to the open ocean with the new Marine stage!\n\nSpectators can trigger traps like moving floors to sabotage challengers. \nLeaping sharks await in the water for falling challengers! It's unpredictable chaos!"}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.png", "id": "4264163103849084", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499292426_4264163107182417_2496132574571041136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T7pAnFdD7sQ7kNvwECf0SF&_nc_oc=Adp6GYoL-gLlpWe3V-xmaHj0PIW7_BQFEtGmftOLZcRYxVoLAgCFX-Pkqe8eoVpfm5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D8jZsMaA28yoTuN2uyOA7yzvHD-EMEBb3i9L1qWy09Q&oe=69E8DE43"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "2049001385961938", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618252_2049001392628604_2311735195368987482_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toCsLzEXVBsQ7kNvwElEP65&_nc_oc=AdqjLhdGevK01yi2Wl-96AcYYXS0ciuKWsXF2rTv_NBpVhHIoFoqhwARsjePPs6H2o4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J87OG1YApxYAhycdqzld_4Jh6e0rCMuoYZld5TkM5RQ&oe=69E8D397"}
7_4108490222735880_3208653933078458760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWZC0afHwWsQ7kNvwHwJd_0&_nc_oc=AdoPDm1_2J9RGxmtEnr6460_a1K-8qSKyKvL4GaSourXarn1ueKTKqePRyH4ZKVuo-8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0SdbaHRSuHTWd2uPD645IYqmuJtzU3fFxRiNr44JIyVg&oe=69F20989"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A17wStS6ImkQ7kNvwFtyycS&_nc_oc=AdqAMIumVcUF5EOxXHIifZAutRT6uhn69YWgm5oR3WRcHGETIQnaIS5t_2xC7jYTOJ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3J3wi75ilKUXScUTZXTDJzxR7hBPpEnoJwcjLc5J1ATw&oe=69F205B7"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNbHOeFzczgQ7kNvwFfRrm9&_nc_oc=AdovNmABwtdm2ya20nhBHS6D1jp-LYMttWXeXbR_UQr6b8_g4kDZSw9Dmz_aMT-ljrY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2QOyEwo6KGzYZjlwUVRJvxWqes0llXPPJAcUZGIRaaeg&oe=69F1EEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zy9gypOvyEQ7kNvwE9RAzI&_nc_oc=Adp11o-WjxeQyvzxEoW55NHOcoG78Eu-obJaMYzG2AHgn3GqTInmj_oY8KFl5B3VYqc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2imOSBuGMiRNWyQZgX4jIsWmnfQ7x-OUgjwXHmvFChqQ&oe=69F1F87F"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJDq1ZkDdR8Q7kNvwEWIrZT&_nc_oc=AdoyI8qgHyuNOJ3-wSw3A3xdQBvBdgyhL9XrmI4X1iVEuxSOO0JZYF9ORHHMB0wPg38&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0ycqXwqGCEjtolgTg8D4lZGdIjgd_PLIRgg591Y_Chfw&oe=69F1E56F"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619774_2975615622637142_1331376706207959328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9
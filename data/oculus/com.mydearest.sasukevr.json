/scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_4108490222735880_3208653933078458760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quHvV60QtcAQ7kNvwH7OJYG&_nc_oc=AdobJEFbeWHUJEY--gD1-jGyeWTPlqLQpUzGfCNwdjPDWOVt8RuPgslW9KLu9zQBdDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tgZyCLXn5xm6_cF5uhGsHPT13_3CMs_I9YZmWHufVAw&oe=6A087309"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqcQ48AMF9YQ7kNvwHdNpn5&_nc_oc=AdrMHUMjPOV3qtUquuQaJivVCWIDPEQRjNoH2pucWO7-CffcK6bB9Y0qoybIqQNlf80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ifteir_taYm8PUauXYFsCRDFhSfQSdD6YM6z6z04naw&oe=6A086F37"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_6H8q5_7XQQ7kNvwG8it4t&_nc_oc=AdqsF8J6sItFVXnsFv02XsgL0aH48udn5v4FIjzKtLS9dk8LS1iHcUF-SLrd-CpYs0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gvd53rjURM5to7EXSN_3JNvwq1lBsYMBSH6dDVURLwg&oe=6A089073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fp-S12ztn4Q7kNvwGNIwZg&_nc_oc=Adrv08uR2n_vyQ0iTVRndTVNf4U9tMVvutdAQ2Fa_QJdIAaTTbAfbE6BuMH0pRWwcQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-MHKsNSeOUse5QNwyoOSyyzHsXlxIOHyqNHV2fqREeA&oe=6A0861FF"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3emqDeRNmUQ7kNvwH5PaUJ&_nc_oc=AdqLXcs6zygPoI6KCQNI8UAUBwn0SxiZSDshSdUDDw2VV5pxe_m9D4HcJRww0MeCARI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79tTkYrRp7k86FWTaycv7WuFPqSEgJ0YXfWzyzPZz6kA&oe=6A08872F"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619
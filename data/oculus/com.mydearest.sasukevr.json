7&_nc_sid=6e7a0a&_nc_ohc=AZI0H6eYZEkQ7kNvwGVNExq&_nc_oc=AdkrcpjGlUnv-6BQiYbZKPE9RxFc6DUoHRnQXsqPK9CzZnVPaeC3-jwoJCI3w7cCG_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvMfHo5EWgFZa_jCFAOUZwcobJsAsv39Y6qMKxmRaxDeA&oe=699C5809"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQTvjm9QpxEQ7kNvwGo_xfa&_nc_oc=Admpsq-druQdNus47P6y3BG7cIS3RjPrRWSIl3bnPB7jX6a6DBcotdtl9h-EjoPsF_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs1pL2AaeJZiFR6wyUmzFC0y-zSPkIhXrOJm-grhDue1A&oe=699C5437"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv4Ub7FbMowQ7kNvwHnliX_&_nc_oc=AdkSyXSDFg_dyausCiSZ4RXH0FhJECBSq1jKWlAKwvv1PQCFz3mRkR2qKbLkAsH4gKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs11C6vHYxZtpInq3080tEKnyfxbSV2LrdkvVZMewvFIw&oe=699C3D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AUgrpIcXP0Q7kNvwHA9iNH&_nc_oc=AdnF5D64RX0azRoD6y0K0Ba9w__54zdaVsG4CVIn-YLgsEyIiG4fLUlTHYUO57Cf9CQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afur1VYBc3sGWMLMdumYyQzpt_cLLl8tXDyxniZyxmluMw&oe=699C46FF"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp-tOkM27q0Q7kNvwHWHy62&_nc_oc=Adl4z11WiEpWQDkycm96WycdIIswZ_ulD8vaKpKEO6bw5egj6j5nCzYLAmJJZdMmY4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft93_GjoBIybMq5nVtSvhgbA2UOEYgKEX_4L9mBq9C0DA&oe=699C33EF"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_2975615622637142_1331376706207959328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SldazNLyhsgQ7kNvwHclvju&_nc_oc=AdnTTjmxAtjSPFv7V6jSueEvYr-0Y8hYNu6RaoBIPswtMUMk6IqCEuO2AgGK
_nc_sid=6e7a0a&_nc_ohc=U3mgv09uqJkQ7kNvwGbauYz&_nc_oc=AdocmFBQ2_4zDK9E1pKwrx3ZmU10ZRHD6FbpTzQpnLfrL0HQATjqfxeT4ErZOPeU0Qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Ujh6GgxIF_whpLuuqgqQ0eFS8HCX-XpOCWAbxeWjZQ&oe=6AFDC773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVJ0l0LFQ7gQ7kNvwFrCMgX&_nc_oc=AdqO9eKtWNQlmr9WsIvgPL2cPNgFVWEvkL_u0eLZ1AQf5BstsRxkyssDapMzr3pb3mw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFJUyPL8h_z2EoYptRta-pT89Vqu1aEF6FnpQCx-dONw&oe=6AFDD13F"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogb77RDvtYsQ7kNvwG6tDJ_&_nc_oc=AdpOaqYkrW0GfVhogjyfuoH7PVS__t67RvkqIrAJLIg6virFxxRs_nfQl3gK3-gVTAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCKjJRMoure4bMPMkcDow6H1yZuG3JnLPB0zdKxGs_gg&oe=6AFDBE2F"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_2975615622637142_1331376706207959328_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTDU8WKjrjMQ7kNvwGAGDnc&_nc_oc=AdovxpgAVe_oyiAM67iRYhACB4sRGq-FiCXmF8OBrtOaLsYkxVJTTRgWwIlASQSbA6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAUScAWMirYNsU21qJbRcRkX4zpYjYz_Vb78hUXD4zyA&oe=6AFDD01A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.png", "id": "1459347908497843", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1459347911831176_5240984296618367253_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAbz4HGueOwQ7kNvwHWlEeG&_nc_oc=AdrhW1XpzLi-sB3_0QuGLDydAKsy3rZGuHZqm1xN2U1FB9Vq4S-aPchTyxadAj-3tG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUzeXbmQqUO3D9cFQkGQUE3sAnvYmjmdP1iHiUFqOWyg&oe=6AFDB53C"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "1182588407080721", "image_type": "APP_IMG_ICON", "uri": "https://scon
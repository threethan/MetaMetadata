4yO_y0gEDF971Pk5_8UnAFCKw&oe=69A44109"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a2a53HXFyAQ7kNvwHTm3Oy&_nc_oc=AdmIBjSR1ww3uJvRHMzxzaSEf9C6kn0dZUn_uEY759le8dWw8a2CO73v9BYNiNEM7gI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBVSUg7TbuoXke2b16fpGiKL7_VWCKWUiS1jzXB3gbqw&oe=69A43D37"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4RDak2raQQ7kNvwGW5yer&_nc_oc=AdneBnf7cutKLb7C4xiDMVNdXvxMXwL_I3aGq2rQuHEIAmjs7Pw9FZqD0vrgClEo6rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afva_DdIztHz0Wg1CakTW5_TsVPEzz9kolCfUhWT8QFXbQ&oe=69A42633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zqgN7Jo-M4Q7kNvwEnKqqh&_nc_oc=Adn5AWoOFZSnpYCo9EhFpyYl1bxz_xVbd0cOP-DeQInYY1YaUetDS8lCAC4YRfOj3qE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftAAm1fbAYHZN1GC5RBQYqp9lFx1IAGs4QrwjqU0slRnw&oe=69A42FFF"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s15xknRK1e0Q7kNvwFeLPT9&_nc_oc=AdnxzuABG_89dvryLZbNFk0RTqUTvzOQF89aAgIOtin1_4XyFaypLP0VJCW5disD0qw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftAgU7q1EeFv35WCAf9IpjHd4s0pXLtJN_NEnUTXH9Aug&oe=69A41CEF"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_2975615622637142_1331376706207959328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTLc9l6oLHQQ7kNvwEIzc5S&_nc_oc=AdlJH-_0P0i9BS5c7phWEPpXlMgsusHNZ78zJU1oTgb0GCLw-oXctSJ3J3Dz5Qr_NEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afswi2k8i5DdQQ_rCfeIc72ePNJSV7Aik46H5ov_cb0StA&oe=69A42EDA"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.
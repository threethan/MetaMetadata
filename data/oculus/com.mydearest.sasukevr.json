F7QceO3GT3kQ2RRexaQFpehmQ&oe=699EFB09"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQTvjm9QpxEQ7kNvwFH195i&_nc_oc=AdnrGP6N98Yjk3fQHMaXAGxR7zDC0l-ZkDMSJGdB1-Wt6yIVEVeq-cB_QL3fKoipjgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftM9BMlausZSpqs4Jx_UCPmZpqsy7ADWWQ7GbGpPQNghQ&oe=699EF737"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv4Ub7FbMowQ7kNvwGwFTcJ&_nc_oc=Adl1D_VxLf6dsCzST6VGaPQpga-Q_WvniNf9fHZvatyIf22X6GXXE8kkqUgCTj4xMz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv4jhRZH6EhyUBK8ZoXS0u7Un1dqCBmFCffxPgCIlFFKw&oe=699EE033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AUgrpIcXP0Q7kNvwEUdTjN&_nc_oc=AdkxNoWYdLLJS4eZsVN8NACIxxINXktph9iAe0QGnFZfPXlMrYSy-l4McpTqMverBEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv5DHWL_8X_FMf8Hj2LihWWwWekmkUAoONaQpshXUJLxw&oe=699EE9FF"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-zLF3Sa5AoQ7kNvwG5gv_T&_nc_oc=AdnoKdMCM2-bOdotxKG775l1nQdVzas9v7RK0XaqZQACcTF5qVk0s41UuuFtKt8Pkxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftG4AqcSJZBbe8TxIiz5E89ARUCbiK8aIqXXURBQdlWzA&oe=699ED6EF"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619774_2975615622637142_1331376706207959328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQUJ1y4tL8QQ7kNvwGTZ6Fn&_nc_oc=Adnk6RW4ZPK7OVaP48NrEmDea1OUP6OBF4inKo7FRJK_ARb0UN5d_B34qj9J8WxlFaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuLhTBkHN6-vrabG2chFYCZT4hk4iw5qBrlz7uSGhOT8Q&oe=699EE8DA"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.
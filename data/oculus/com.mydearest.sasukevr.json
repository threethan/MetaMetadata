-11-12 195449.png", "id": "2011093236342346", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617850_2011093239675679_4288240380084754186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96Ysd31eATwQ7kNvwG9js0p&_nc_oc=AdnDpfkE1GS8WtaDvaPnoWwKleE-5-u_zEHZNzvGby3zTSDUAMCg4-JkFeezWaMdHUc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyczEjYe5OtH4-ez5RLOFX1t1ntvmxhU4_Def9jYXKRHA&oe=69BD5033"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(3).png", "id": "1351315559773459", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822045_1351315563106792_3211899487096608506_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E170rwAHBi4Q7kNvwGJecuV&_nc_oc=AdknanQPyFPFR440g8I4MfvtPMFimp7PvBQE_hHuqK2xWdeQUFTbiFb726Fuc1dreRM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOyvoyGr0GCIrKPLV8eGg7iOmOKQn2TBg_JUF-64kGdA&oe=69BD2B06"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(5) (1).png", "id": "757322207324853", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619774_757322213991519_2781578561473256126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UyqkBGetwQQ7kNvwEk8kjk&_nc_oc=AdkzQCON-qPucxiXYgvQ7U1Q4it8ZhN8WFzXidq-2SeZSFPTJtXBBamWN-tJ0cLWqTQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtCtKKUWn4Lf4AfsMDZnRGI-_Mpzl05G2mXMCTDMx2FA&oe=69BD308D"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-12 194903_NW.png", "id": "1011922691099818", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619098_1011922694433151_8652263347591575943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R6Tsst9XpwQ7kNvwHFZI8h&_nc_oc=AdkuZ3yC6wkBps__z4oyfk_A2Fg-B1bnA6PIcsLuR_9RO1ZW8DKoPH0L7NWAW-4PeQY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXiAR5iGXyK1IEx2cYp3pNbFP2TIrqHpsdahGxp1ou-w&oe=69BD582D"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5)_NW.png", "id": "823153967022922", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0eaX-kN384Q7kNvwGfM5eM&_nc_oc=Adkh745ttjqQ8EOT30hEzWKbk980K_xTXz5DIKcqQ-IKRiMq1Rnsi7XoTQczbfT4lQE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfykQFe18Fdz-Cj2ZYIkjKjxoEvFgO20S__KDOU1yFYJdA&oe=69BD4545"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1293441179265152", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618102_1293441182598485_5756413485734718909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUSbPWR3zC8Q7kNvwHU9-uJ&_nc_oc=AdmvKeTicYZx3VZqKUZAhCkoKaZjQx10rQyIh2hjqzLYRePTTlqVV6bHV5u68aL52Qc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLe3WZOXbPm4y1oJvrvJOliZKIoCoA-GtXsFEoxwzG5Q&oe=69BD46E4"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "# \ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior finally moves to the open ocean. The Marine stage is on a whole different level!\n\nNow spectators can do more than cheer! Press one of the audience buttons to interfere with challengers! Move the floors and trigger traps! Will you be a supporter or a saboteur?\n\nAnd look out for the sharks that stalk the stage waters! They'll make quick lunch of fallen players, and will sometimes even leap at challengers as they run the course!\n{1235996518643259}\n# \ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n{1259564035608866}\n# \ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n{944928581554413}\n\n# \ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.\n\n", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior has moved to the open ocean with the new Marine stage!\n\nSpectators can trigger traps like moving floors to sabotage challengers. \nLeaping sharks await in the water for falling challengers! It's unpredictable chaos!"}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.png", "id": "4264163103849084", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499292426_4264163107182417_2496132574571041136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7hYpz28pnEQ7kNvwGQgSrg&_nc_oc=Adlt3ARfiWkWI_YBvQ3CXoqvSvf2F_vRwhPe6I7MRNtPtXQAC3-16zr1URmv1Xm0zfo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHPtAWPz0oOz4I_EE92xhO5Co7C0qZHsUkW7IaXjZcTw&oe=69BD5CC3"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "2049001385961938", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618252_2049001392628604_2311735195368987482_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TKMKVhlJm8Q7kNvwGkK1lB&_nc_oc=Adle9Q7WnG-GHdHoUezZjsieBAmD9xK9c_UbzcVFSo-io4eBVLzeiPtXd9yRKh9SmW4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB4UXAK0pjOsDgG9PoLAANC7XsFy0Z5WM1F-gEPXXI8g&oe=69BD5217"}, {"file_name": "\u30ed\u30b3\u3099_.png", "id": "198754
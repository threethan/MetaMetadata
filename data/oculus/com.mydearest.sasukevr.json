43_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGENt07hnI0Q7kNvwG94qaJ&_nc_oc=AdnzziEHm4iOeLV4tCXppEf6JXWoU0zZwYH5PUf5dN2Jx6dPSvqiUsZhrTkIpBnNaFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwDnrqeR6pUz94e-E8sXHWYVz0ZoNznEsaLbiI7rjRMA&oe=69A0572D"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5)_NW.png", "id": "823153967022922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfflUm7z5QEQ7kNvwGHibv0&_nc_oc=Adkaqs3rauSKmShgZFBmEzb9J-4EGpehLrckTdlw0SzAeHGMJbKpy5KA-G9bMADR9R0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYANFrmtTqCDfsyMwPrXrXH94OJ9S_PH-0niHOj-OApw&oe=69A04445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "2456225038143164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_2456225041476497_5703262178124888082_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2v-2qo4h6EQ7kNvwH5e9cj&_nc_oc=AdnKsWWG-KjSECw6x46LtOvUupuqj9nSksu3ILRpjFW8rbdHVjbnZ-qWaFeC02CNgnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNUEcvIXFG7swBddtEzYGUdFO4Mc6E97qKWs-5Vpi3Rw&oe=69A0561F"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "\ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior finally moves to the open ocean. The Marine stage is on a whole different level!\n\nNow spectators can do more than cheer! Press one of the audience buttons to interfere with challengers! Move the floors and trigger traps! Will you be a supporter or a saboteur?\n\nAnd look out for the sharks that stalk the stage waters! They'll make quick lunch of fallen players, and will sometimes even leap at challengers as they run the course!\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior has moved to the open ocean with the new Marine stage!\n\nSpectators can trigger traps like moving floors to sabotage challengers. \nLeaping sharks await in the water for falling challengers! It's unpredictable chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tokyo Broadcasting SystemTelevison, inc. / MyDearest, Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
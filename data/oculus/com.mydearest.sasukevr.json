O6u88tndRa3QFa2Hdx3MB-XlQ&oe=69A59289"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a2a53HXFyAQ7kNvwGtg5C8&_nc_oc=AdkYeJ_35v2TOpgOXCw9xehwl9ctdsxlbhxd6klv7MlA238yk_UnswzHMlXQOzFQ_HM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvKn5BwLba2fYvFF7NDBFJzKcC9BD0Dx8DXf8WuQfFhaQ&oe=69A58EB7"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4RDak2raQQ7kNvwFt_ebV&_nc_oc=AdlBE8dMIu5QXNEPcNIgTPdt-T3REvFLDv7E9T1H8FXBbpW6qfGogKFMRVz2Sj8jH2M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvta2jhayJLoBd33OJXkuAGYFij1dVT0ydSIJgpxm9iCw&oe=69A577B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zqgN7Jo-M4Q7kNvwF7vO-p&_nc_oc=Adka-1OsBGCqFyy_UffZOpjNBKvLkYOtFxSQ5_bwjjZyEU1WAVBRWuP1ECRDsKTaS4U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvoE2xWbRKLMoU4dX7vG_rRa0SQTJWkvtOZKJweM7FFeg&oe=69A5817F"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yz9gULWSYeAQ7kNvwFGEuw_&_nc_oc=AdmO7WjL2Oxb6NTivDvr-HunwG6sqwBjFY82e0jruJOESVClchd9m9T2Cnn1LzC2sxs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu5y7masaLXe2ms0FsVLyXRqc14ormt3Mri7CoZSg5zBQ&oe=69A56E6F"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619774_2975615622637142_1331376706207959328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03PBFgRXd24Q7kNvwGKe0hY&_nc_oc=Adn2odbE4daSQqGEKHbayqA7uykskpUsUmEju7LlQ_oPGZwuz2HXlsslDPneUNrZQ0A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsPS_Nu7yfiOjOSQVnlHEF6zW_hhQPNHhAzh5yMmY194g&oe=69A5805A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.
-11-12 195449.png", "id": "2011093236342346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_2011093239675679_4288240380084754186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_obwUIpdeAQ7kNvwGpb-IA&_nc_oc=AdlhaEYHgt0CK8STQQ6bXVY_p9teY38IbWxGVsd-SSRv8_vd-Zs4yXJFWG3Z0OVzBHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoB7H_tGegKI2D1ByLJ2gkx_qDgcGAkLG2kNsmd9qalA&oe=69B6B8B3"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(3).png", "id": "1351315559773459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_1351315563106792_3211899487096608506_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeJeUweyCvkQ7kNvwEaxZh5&_nc_oc=Adkd3TcG9TZGZWDBhOdsHds6dIxajq1ZPU6RxqjJiV0C669nC1hsuooSS43g1EfrdiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfynjOBJh3YNy3d-Qcz5-XM47_cwtAG9R_JamJwQlPQXJA&oe=69B69386"}, {"file_name": "SASUKE VR\u7d39\u4ecb\u753b\u50cf(5) (1).png", "id": "757322207324853", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619774_757322213991519_2781578561473256126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0C4i8u9WfUQ7kNvwET6T2l&_nc_oc=AdmT_qJhEwGSMjIf8PmakymK1xNGjg9zAqQ8UcYMzDgspMB3e_ITkhA4GEtIa3ffFNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqJUEuOdsaVUI-rgcAULJMWxfsd5DV7rPGqMhU_VaOTw&oe=69B6990D"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-12 194903_NW.png", "id": "1011922691099818", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619098_1011922694433151_8652263347591575943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zozPH8__WnAQ7kNvwEkO1VR&_nc_oc=AdmPDwB17WrGnpQmMJuKVaZWdFBQuywSBiuQ__8Q75d3pezokwG3zUaZg5GfJumK5nM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOPeniF7RAOJL9IJY9EBS7DqSNiFXIgg9290dH6FbmJw&oe=69B6C0AD"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5)_NW.png", "id": "823153967022922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbRK91adn6sQ7kNvwGJ_h1j&_nc_oc=AdmHo8l279ibRnF4FBlFIExFHSHOx455Wo4nMp8-vL_vZkT3XSJFOVEyALIi-JINjZI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSLl3elMe1c-5t9xAxJSQ8lRnOM-udsK6MGOt5lD2uvA&oe=69B6ADC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1293441179265152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618102_1293441182598485_5756413485734718909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO84jWde9OUQ7kNvwE2zhAl&_nc_oc=Admh0PRzyKIL0L2twrpKgEHyaf3aOiMH2JYIL2RPvLvPEBhnb4InK8muKjnsmekxbyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUF6vGQaSGfuuK9uiz2vD1WGXLJjaNAg6VNNsN97Yugw&oe=69B6AF64"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "# \ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior finally moves to the open ocean. The Marine stage is on a whole different level!\n\nNow spectators can do more than cheer! Press one of the audience buttons to interfere with challengers! Move the floors and trigger traps! Will you be a supporter or a saboteur?\n\nAnd look out for the sharks that stalk the stage waters! They'll make quick lunch of fallen players, and will sometimes even leap at challengers as they run the course!\n{1235996518643259}\n# \ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n{1259564035608866}\n# \ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n{944928581554413}\n\n# \ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.\n\n", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udf0aThe new \"Marine\" Stage Update is HERE \ud83e\udd88\nNinja Warrior has moved to the open ocean with the new Marine stage!\n\nSpectators can trigger traps like moving floors to sabotage challengers. \nLeaping sharks await in the water for falling challengers! It's unpredictable chaos!"}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u306e\u30ab\u30cf\u3099\u30fc_1008\u00d71440px.png", "id": "4264163103849084", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499292426_4264163107182417_2496132574571041136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcWoJ74Na80Q7kNvwEOkzu1&_nc_oc=AdloOqsD2DpgQYyPcPQus5JEnwH7A4VssltynwxB81t6ze6yDNUwAeliR2u88yXV7n0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNsWlq10KytsF6LevW6h5mdL7N1uObJ56UYQr-SRmWBA&oe=69B68D03"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "2049001385961938", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618252_2049001392628604_2311735195368987482_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfhWCPKIU1EQ7kNvwFjg0HX&_nc_oc=AdnWcZSDuD-cu57W0XzODiag0MbQ-PcRBZck0RkAfk-7aXR8volI9AMvHHVZmsgBgPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtzwCDC7gmXYPbAO0YyQV1GZexJsCa_SYI-uAUlAbh7g&oe=69B6BA97"}, {"file_name": "\u30ed\u30b3\u3099_.png", "id": "198754
_nc_sid=6e7a0a&_nc_ohc=yjtgdqIehHMQ7kNvwGeXywY&_nc_oc=AdlV4Ya8ny8AnQAuuwJI64Tp3UujAWJ06rvjmkuzofVXmgVy-O5I7lRQNV6zoQptCXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsgwWdQTeRan7idZ2bQLcnKvi3kFs7ZSldxKzra-RLJhw&oe=69986389"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzNJ2-iTGSwQ7kNvwGuzDz1&_nc_oc=Adks6fDNO7oq8Wf0-jMQvmJWkmCqylbFOkEq_BAQUhf8ICrMAUjx1t8rKgQ7vGaV2s0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftKsGoYKh7epquxhZSns-CrhF6N1U04ErE0U3WsrLaBVQ&oe=69985FB7"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbRW_vNx2-8Q7kNvwE9CUI5&_nc_oc=AdmPim7X_cQMki8fCDPXi1D5c7kLxDTUNGihxFkyZX5pvVZ7OA2AqPP5JcGh2QEBHOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftML0zd4xNR7qsEWomCAI51RtzejY-eGynAt-n6a12gIQ&oe=699848B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYzXkLrT6esQ7kNvwFWwoVT&_nc_oc=Adm0kwrPNF86VPrQmbUC6hI-PPvOd7MouZ5JKv3qLgl0iZLyuw7T8D8IdHfMN0bJELY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfubQMOVVNmt5p5FuHzeWTGPBkBY6GMrWOalbDhvi945ng&oe=6998527F"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6eIslV-qBsQ7kNvwFwt3oY&_nc_oc=Admp6Rt-NkgMiYCXtIaE5dMJkkGA3y8ognRFjEnrgNlrZ-EwfM90ymVCDTW-V5esCW0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuA9uPpz-yyxyddlKmmZaclotAAIv0OY1tfpvtI8aiZYQ&oe=69983F6F"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_2975615622637142_1331376706207959328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1FwduZ0Jc0Q7kNvwEuO2fQ&_nc_oc=AdkN7IJhtshfYP2J11CUU0x2aUXeWWVimbdW-by1n5ldACuirhvjRfcgUaVP-T
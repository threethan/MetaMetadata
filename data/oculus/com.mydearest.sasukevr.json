/scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_4108490222735880_3208653933078458760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKyhtbxxdeIQ7kNvwGRVAGS&_nc_oc=Adp_v5nuTvh6JXGLTSDlOyhjGcr64Erw6Gm_ofOg0SkEQjLMokcauVcwcUn-2zkifLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af441Ee2cvsR-KqZ79pVIudSBPMsi6pVS9LHJWOL8jhDPA&oe=6A008A09"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2025-11-04 170827.png", "id": "2414238185699912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619646_2414238189033245_883162066646786756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utfW7R8gL6sQ7kNvwFsJTil&_nc_oc=AdpROU8b4gsKuUPtBWb-Fw9pQwbOrYyqKNJj1al7z1m9oG_GraBKSuNZHaJQ0m_g2BU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_FhJHrjl4vHvlOJ30hkSr0nebgRd4PW-L7A_lMTpB3A&oe=6A008637"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5) (1).png", "id": "1525810365213107", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1525810368546440_7669815243870983139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTNZ_wdKC3YQ7kNvwElPqZ9&_nc_oc=AdrnAUKWsBQzKi5Iml_gg6zwr3-ByhJe1khcy0EYdkTcFglK3H288iQdv5iwVNv4Nro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o9H-1_uer8dtkde0pr_1JUeHYebr9cunAApMYXTTxFg&oe=6A006F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4101614343388727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_4101614346722060_6507202841467624039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCePsdCC7voQ7kNvwGx4zej&_nc_oc=AdoAEBBuw4AC22CeplqnLHnXRV3aZOa3xPGb8BmWYK9GzzjLi8RHbuK0_r24I78pRSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nTU_SlUQC-WSK7yc4VmTfo3FmRl1ipX1E_O6MZY3AJg&oe=6A0078FF"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n\n\ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n\n\ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.", "short_description": "The thrill and excitement of \u201cNinja Warrior\u201d come alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "4206557512967114", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_4206557516300447_943281957663249977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkEWE0rxbekQ7kNvwF4l9Tl&_nc_oc=AdphNSYtii4-HiAWbS0imgLlrJMTC0NPJnCpTadO-vBCL2zxnfIsm3_UCtX7iL9AXjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D9AnXlRteVyQWJJGvIw1ZrMUsgAX4AOuh8oEbq1vkRg&oe=6A009E2F"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2975615619303809", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619
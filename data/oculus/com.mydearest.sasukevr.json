011922694433151_8652263347591575943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lGZSbRslTYQ7kNvwFDNFAJ&_nc_oc=AdpqLmzGa5AR7ZR-C5jQFAkZ1whRb64kJrgCYIycRm47tT_R54Pn6veDFAyuLXvLT70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFidJSBJUNJFnovjfr2w_IvKJ4Q4v3hy3sy5yzvBUmOg&oe=6A7EEC6D"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5)_NW.png", "id": "823153967022922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyEHsrJ1J8YQ7kNvwF857PG&_nc_oc=Adqqv_re2083NzdwpLrf0_vtBEnN_7jJ29d9zE6gVXtrxMJWLebu7R8axgUqdtR3Im0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC0iu6Dyo4r8N_Yl9ls4POjezRSLs0HMxqTPd48rCkFw&oe=6A7F11C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "977868641947383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620860_977868645280716_2973662484457917442_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_YAmMuRp5MQ7kNvwHfxIWh&_nc_oc=AdonwcIxB5YQM75HzMlxjH2b36SxKJrTmKhOl9i9qiYB7Sfh5Rr7LiNgeI3993WeNqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs6sIg9uXgEbmMpKE-F1ENHPVHuSTnh4kFpql5q7Lsrg&oe=6A7EEDFE"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "# \ud83d\udc8eThe new GOLDMINER Update is HERE! \u26cf\ufe0f\nTreasure-hunting miners have arrived in Ninja Warrior VR!\n\nGrab the latest themed skin, Goldminer, and blast through the many courses of Ninja Warrior VR. With their functional strength and hardened physiques, reaching the finish line will be a breeze!\n\nEnjoy all of the fun stages and gimmicks of Ninja Warrior VR!\n\n{1235996518643259}\n# \ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n{1259564035608866}\n# \ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n{944928581554413}\n\n# \ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.\n\n", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83d\udc8eThe new GOLDMINER Update is HERE! \u26cf\ufe0f\nTreasure-hunting miners have arrived in Ninja Warrior VR!\n\nGrab the latest themed skin, Goldminer, and blast through the many courses of Ninja Warrior VR. With their functional strength and hardened physiques, reaching the finish line will be a breeze!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tokyo Broadcasting SystemTelevison, inc. / MyDearest, Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/products/sasukevr/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_gr
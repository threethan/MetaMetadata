/499619098_1011922694433151_8652263347591575943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZnMCROhpk0Q7kNvwEo2KIx&_nc_oc=Adolm09n2D2sLb8uZM1nz5sJsHT-XvOCh6up7_zaQBiu-Ksr_GjEKWoGKvEaBDKdo-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtz4jPv4LuUPyQFsegvdP-GKZzqFpTRXWn_TYMQu4Lhg&oe=6A49172D"}, {"file_name": "\u30b3\u30f3\u30da\u5019\u88dc(5)_NW.png", "id": "823153967022922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818900_823153970356255_6419549263454107380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyUXChne-rwQ7kNvwHi32py&_nc_oc=AdrzohA10cnVoD-OVnthWIbGz_NfA2mSk6KS2ImhyO0bsxvOS-Ls_qOJL6roKhlQDeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBARCWv4LZJ-ggh6m88TQdUY3HmTYdWEA2WDUQyiQ5iWg&oe=6A490445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1727201171782090", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626172_1727201175115423_8189987562317738813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPp_4p8MS_0Q7kNvwF9jlEy&_nc_oc=Adqiwzs0hJkWH55TolGYCXPOhOBb2SDDyR6fc7l8pCGF_HHvq2ze0jYSnxq9UPOmozM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKKkQAXgJM3GJfNMraE182-oer-uJk3-ZCMxZb781oNQ&oe=6A48FE43"}, "display_name": "NINJA WARRIOR VR", "keywords": ["NINJAWARRIOR", "SASUKE"], "long_description": "# \ud83e\ude90The new Nullshade Update is HERE \ud83d\udc7e\nNinja Warrior VR has been invaded by space warriors!\n\nGrab the latest space themed skins, Nullshade, and scorch the many courses of Ninja Warrior VR. You've proven yourself in space, now it's time to prove yourself to these earthlings! \n\nEnjoy all of the fun stages and gimmicks of Ninja Warrior VR!\n\n{1235996518643259}\n# \ud83c\udfc3\u200d\u2642\ufe0f Push your limits with nothing but your own body! \ud83c\udfc3\u200d\u2640\ufe0f\nRun, climb, grab, swim, and leap through each challenge.\nThere are no tricks or shortcuts, only your determination.\nCan you make it all the way to the end?\n{1259564035608866}\n# \ud83d\udd25 Conquer four legendary stages! \ud83d\udd25\nThere's no time to waste in this test of true skill!\nChallenge your strength, stamina, and skill on all three stages to make it to the Finals!\nClear them all and make your mark on the leaderboard for all to see! New stages will be added in future updates.\n{944928581554413}\n\n# \ud83c\udf99\ufe0fLet's play Ninja Warrior together! \ud83c\udf99\ufe0f\nRace through courses with your friends, commentate from the announcer\u2019s booth, swing swords, or bounce on trampolines.\nEnjoy the wild, chaotic fun of Ninja Warrior with players from around the world.\n\n", "short_description": "The thrill and excitement of \"Ninja Warrior\" comes alive in VR!\nUse every bit of your strength, balance, and reflexes to conquer intense obstacle courses through full-body motion.\n\n\ud83e\ude90The new Nullshade Update is HERE \ud83d\udc7e\nNinja Warrior VR has been invaded by space warriors!\n\nGrab the latest space themed skins, Nullshade, and scorch the many courses of Ninja Warrior VR. You've proven yourself in space, now it's time to prove yourself to these earthlings! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tokyo Broadcasting SystemTelevison, inc. / MyDearest, Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/products/sasukevr/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
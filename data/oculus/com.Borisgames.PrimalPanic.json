g&oe=6AAE9F89"}, {"file_name": "SampleScene_1440p_28.10.2025_13-06-49.png", "id": "1545633793547848", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618444_1545633796881181_284108309863182369_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1ADpTCEoXQQ7kNvwGkJh87&_nc_oc=Ado3grTOwhFp78kyZwLu9WixLqTdl8-QzrSvOVVkl-Lm6S51Q6dHT_z1poLJF-aEhs0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ2zbdaxpo2TxhTKkqlJ4oe5TeE57h8gBL5Sg_B9iO1Q&oe=6AAEACDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Panic", "keywords": [], "long_description": "Primal Panic  is a Virtual reality horror game inspired by the fan favorite Gorilla Tag locomotion. In primal panic you are in a facility and a bunch of other maps. The goal of Primal Panic is to run and stay away from monsters. You can also go to Primal Panic to make friends. Primal Panic will always be getting active updates. And high-quality updates. Game Developed by BorisGames.", "short_description": "Primal Panic is a Virtual reality horror game inspired by the fan favorite Gorilla Tag locomotion. In Primal Panic you are in a facility and a bunch of other maps. The goal is to run and stay away from monsters. Game developed by BorisGames.\n\n\ud83e\udd8d Primal Panic is a Gorilla Tag\u2013inspired multiplayer horror fan-game with cosmetics, events, and tasks. Hang out with friends, survive terrifying encounters, and enjoy rapid updates from a solo developer. \ud83d\udc7b\u26a1"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/primalpanicv1/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "WBoris", "support_website_url": null, "website_url": "https://sites.google.com/view/primalpanicv1/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4
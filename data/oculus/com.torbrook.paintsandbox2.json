t-sea5-2.oculuscdn.com/v/t64.5771-25/596061819_4265360977049834_6171279220243046451_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ErcBYcgydIQ7kNvwGwrRFo&_nc_oc=AdqdPHbqipIab8Sh7cvVzOVSB0Ev-0XZbdkIAxvsz78kwOaSYzK2ZmC1gIG0SDdRydM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVRjRG3deETHXQM80WZDtFkIX5gWDB3EeP2DZHzMs0Kw&oe=6B09A628"}, {"file_name": "shot3-corner-2560x1440.png", "id": "1379594807652073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1379594810985406_8303663906909117986_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9Y1z5qEmTMQ7kNvwHWAH_i&_nc_oc=AdqmV705_U8ysRWGdIDrntYcaNaHYORwxOSI2rlM5-304aiBrF7AirzQBeoLmAJZh8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREkZTI55J1S8k8rELuNeSZSN1zXpY2XMP18TQaht3iig&oe=6B09BC11"}, {"file_name": "shot4-friends-2560x1440.png", "id": "1087150897196654", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604375581_1087150903863320_8936845811021353937_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAcZ_e4eA3AQ7kNvwEOmF1s&_nc_oc=Adov7PAjQBr79zZHCzNHIVAiOhCKnE1lNwEN3Wejiq1b5QaCUDGpE-brfSoWS6DGQXE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT83aVLdIdHyAnkRKo8hrzsSm-NtV4Ar1yKYGiB_LzEQ&oe=6B09C69E"}, {"file_name": "shot5-tools-2560x1440.png", "id": "1646978760286551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1646978763619884_3894330370982066383_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z82X2Ht16KsQ7kNvwHazV2F&_nc_oc=Adr1-E7dpoQQxgwgQdR72bpnIKAtffdq-fQJDXMhSjpkqFCBCaM0eZf3JOUvFuLKWxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK5Iln7cpmPO8QkmFQmxEDRGqRrZ9K2jZT6Mgnr3zGKQ&oe=6B09A917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1121694863762800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_1121694867096133_1567409505969883786_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fhf9BhWHfJoQ7kNvwHEzZCV&_nc_oc=AdrHCUvG8YE5XtajNKvOpRTMtXxyooKxFveFJtwvShV-Z0Vn__Lsgmolaq2JrlQZaq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThZhWMENLVb1r-J58f7Un9LhD919Fr7Mk7Ydh41N1QEA&oe=6B09C57F"}, "display_name": "Paint", "keywords": ["paint", "painting", "art", "multiplayer", "sandbox"], "long_description": "Paint gives you a huge bright room with blank walls, a bench full of real painting tools, and nothing to stop you.\n\nTHE TOOLS\nSpray cans and spray guns lay down soft clouds of colour. The airless sprayer covers a wall in seconds. Rollers put down solid, even coats, and brushes pick out the detail.\n\nTHE COLOUR WHEEL\nPress X and a wheel of 44 colours opens in front of you. Point the laser, pull the trigger, and your tools are loaded with that colour.\n\nPAINT TOGETHER\nPress Y for the multiplayer menu. Host a public room anyone can join, or a private room with a four-digit code for your friends. Everyone sees the same walls and every stroke as it happens. Voice chat is there when you want it and off until you turn it on. If the host leaves, the room carries on with a new host.\n\nSAFE ROOMS\nOpen the player list to mute, block or report anyone. Block a player and you will not share a room with them again.\n\nFEATURES\n- Spray cans, spray guns, an airless sprayer, rollers and brushes\n- A 44-colour wheel, picked with a laser\n- Wipe the walls clean any time and start again\n- Public rooms, and private rooms with a room code\n- Optional voice chat with per-player mute\n- Male and female avatars", "short_description": "Paint the walls of a big, bright room in VR. Grab a spray can, a spray gun, an airless sprayer, a roller or a brush from the bench, open the colour wheel with X, and cover the walls in any colour you want. Paint on your own, or host a room and paint together with friends online."}]}, "developer
&_nc_ohc=X1_K6rL59LcQ7kNvwEpnoFy&_nc_oc=AdoPCRh6_9_oAiXq4Hmp2IGIhoB320TpVeMAt1UzxwqYl8gq_e9HFVZWOrGbUVY99zQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBBj14K-eQ0AUPFy6OevC--oDdcR58K4mh5nOjOULLPg&oe=6ABBC5DE"}, {"file_name": "shot5-tools-2560x1440.png", "id": "1646978760286551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1646978763619884_3894330370982066383_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK7oe3ndYIEQ7kNvwHpw3RQ&_nc_oc=Adpp1j0GYp4p0FvY1FrknNxCX8TdK-h-KFl7R26SQMKn71ugfXGdFuQjujR1UrOJhag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF6hckBjtmJoQtZbK70mZ-Q-8RwIHf9HVbO2vBYcv-bA&oe=6ABBE097"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1121694863762800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_1121694867096133_1567409505969883786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F147l_hiEkQ7kNvwGnW-Um&_nc_oc=AdpxNEHxHfWWIUF6lAvQ7HyXLB4gferl9-MUmulCR0J233MfEug7Qdxje95C9IsxFVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7HCXvCVeTVC8I5Hdb5s9TPhFywGYmK6HqJgzAv9MZbg&oe=6ABBC4BF"}, "display_name": "Paint", "keywords": ["paint", "painting", "art", "multiplayer", "sandbox"], "long_description": "Paint gives you a huge bright room with blank walls, a bench full of real painting tools, and nothing to stop you.\n\nTHE TOOLS\nSpray cans and spray guns lay down soft clouds of colour. The airless sprayer covers a wall in seconds. Rollers put down solid, even coats, and brushes pick out the detail.\n\nTHE COLOUR WHEEL\nPress X and a wheel of 44 colours opens in front of you. Point the laser, pull the trigger, and your tools are loaded with that colour.\n\nPAINT TOGETHER\nPress Y for the multiplayer menu. Host a public room anyone can join, or a private room with a four-digit code for your friends. Everyone sees the same walls and every stroke as it happens. Voice chat is there when you want it and off until you turn it on. If the host leaves, the room carries on with a new host.\n\nSAFE ROOMS\nOpen the player list to mute, block or report anyone. Block a player and you will not share a room with them again.\n\nFEATURES\n- Spray cans, spray guns, an airless sprayer, rollers and brushes\n- A 44-colour wheel, picked with a laser\n- Wipe the walls clean any time and start again\n- Public rooms, and private rooms with a room code\n- Optional voice chat with per-player mute\n- Male and female avatars", "short_description": "Paint the walls of a big, bright room in VR. Grab a spray can, a spray gun, an airless sprayer, a roller or a brush from the bench, open the colour wheel with X, and cover the walls in any colour you want. Paint on your own, or host a room and paint together with friends online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-paint.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-paint.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1234472996425340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_2770315196696309_943209338620945925_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GMR7
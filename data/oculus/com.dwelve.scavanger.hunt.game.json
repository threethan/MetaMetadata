COhBvGE6ATZRV5BjpODA&oe=6B0F1BD9"}, {"file_name": "5.png", "id": "2363211107773311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604317775_2363211111106644_6339555539293872601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_BHdTjmOK8Q7kNvwHEtHSd&_nc_oc=AdrSeLhlD01SPhpzdBKz5Px1cFHIE8NK5rY6259qJgE9KxJ1nRlmjJ0w6DEJ3O3cSQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXcIjSVRJPUb6poUu-Wuv_A1THNoiwM4gclD4_Eo2Hk8w&oe=6B0F1466"}, {"file_name": "4.png", "id": "3412115968960690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_3412115975627356_210867773840934577_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCfot5tA-KcQ7kNvwEwG0Uk&_nc_oc=Adoeeo90R4Fo-BT-Mtovn_hEo1tWbd5XE5_iE2s57GV9bf97nNqRCilp0ssA-uwyvnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCB66XJI5y2_WH8H4cfhSQS1LdFAJMuFlfmeqekyrjlw&oe=6B0F1A6A"}, {"file_name": "6.png", "id": "1676515197499861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613082348_1676515200833194_2520532713821317076_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKRS-I6z6qIQ7kNvwGY--w9&_nc_oc=AdqJU0TBOa4Ew594xf125nt76bCL01eEShZynk5JbtrxOCxDaIJaSU5N85R0xl6mpxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgfMdpWw7_pyOfFxBfdpXMnExheMJ6T5DddbjiQwmTuQ&oe=6B0F15B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scavenger Hunt - Find It Out Game", "keywords": ["find", "scavenger", "hunt", "mind", "puzzle"], "long_description": "Think you have a sharp eye for detail? Put your observation, memory, and searching skills to the ultimate test in Scavenger Hunt!\n\nEnter a world of exciting hidden object challenges where every detail matters. Your mission is simple: look closely at the displayed scene, carefully observe and remember the objects, then find the required products within the given time limit.\n\nPay attention to every corner, remember product appearances, and follow the instructions to complete each challenge. Some items may be difficult to identify, so stay focused and use helpful hints whenever you need assistance.\n\nEach task challenges your ability to observe, memorize, recognize, and locate objects quickly. Beat the clock, complete your objectives, and prove that you have what it takes to become a scavenger hunt expert.\n\nCan you find everything before time runs out?\nKey Features\n- Look Closely Challenges: Carefully observe scenes and remember important details.\n- Hidden Object Search: Find specific products among various objects.\n- Beat the Clock: Complete scavenger hunt tasks within limited time.\n- Memory-Based Gameplay: Remember product appearances and locations.\n- Helpful Hints: Get assistance when you cannot identify a required item.\n- Interactive VR Experience: Explore scenes and search for objects using immersive VR interactions.\n- Progressive Challenges: Test your observation and recognition skills with different tasks.", "short_description": "Put your observation skills to the test in Scavenger Hunt, an exciting hidden object search game in virtual reality. Carefully study each scene, remember the details, and find the required products before time runs out. Follow visual clues, complete challenging search tasks, and explore every corner to discover hidden items. Use helpful hints when you're stuck and sharpen your memory, focus, and attention to detail as you progress through increasingly challenging scavenger hunts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uafle.github.io/dwelve/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Dwelve", "support_website_url": null, "website_url": "https://uafle.github.io/dwelve/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
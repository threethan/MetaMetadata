d": "1821365835964214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1821365842630880_2454736888641433601_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5yNF7dTaykQ7kNvwEFthD6&_nc_oc=AdqZbkYgATkp9RVDnoQ7yX1watotm2zIG1VM6D8xGZ7vxSUUIPvHGuSfwft1JPxw2tU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTZqdbedh6FlFVc_hwqj6N6MxUhSj-_ehZ-UppoiarUg&oe=6AB2820F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "2000701453781032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824292_2000701460447698_3360556371350616484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-zNyphZ6IwQ7kNvwFoVliB&_nc_oc=Adp_AUY-dB3uKdfQbeU_sKUuM8hSy0wxzBqNaEHaBEU1XeIPBVJwSvu0RyAt2tTaSqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfPTbmc9YvWulJvroQl2tciXknLqmW03WMukkKRPK4QA&oe=6AB27E9C"}, "display_name": "Room Bloom", "keywords": [], "long_description": "Discover a different side of your everyday space. Room Bloom brings four atmospheric mixed-reality scenes into your room, with effects that respond to scanned walls, floors and furniture.\n\nROOM BLOOM\nRelease colourful motes, gather them close and scatter them with a pulse, accompanied by gentle ambient music.\n\nRAIN ROOM\nSettle into the sound of rain as drops fall around you and splash against the surfaces in your room.\n\nFRACTAL GROVE\nPlant intricate geometric forms on real surfaces. Reshape your grove, bend nearby forms with your hands and dissolve small patches to make space for new designs.\n\nROOM GARDEN\nTrace a path across your room and watch glowing lotus flowers gradually unfold. Prune, renew and shape your own luminous garden.\n\nUse tracked hands or controllers, switch scenes from the floating menu and adjust visual quality and lighting in Settings.\n\nRoom Bloom is a single-player experience. Spatial-data permission and a scanned room are required for surface-aware effects. Your creations are temporary and begin anew each session.", "short_description": "Turn your room into a playful mixed-reality canvas. Send colourful motes drifting through your space, listen to rain falling around your furniture, grow geometric fractals, or trace glowing flower gardens across real surfaces. Explore four atmospheric scenes with hand tracking or controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kwrona.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Krzysztof Wrona", "support_website_url": null, "website_url": "https://kwrona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1771002220599461"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1438828094919148"}]}, "baseline_offer": {"id": "1438828094919148"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789405860, "status": "PUBLISHED", "id": "1438828094919148"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1771282167238133", "version": "1.0.1"}, "id": "4495835060675883", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "
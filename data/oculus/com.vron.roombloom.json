 "28631259496509866", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827973_28631259509843198_1328131101326527003_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VL85VEZdlMQ7kNvwGpIa48&_nc_oc=AdoCTYZPxQuKoDMNDCRsiewHepW1AiMjyj0r_Z1rnpJClDZHgM0AiDlnVWAzJC2dUfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqzB4dpak-5LmVJBw2hFJ1VP4rL4c3KbZmJcdIqgQ1tg&oe=6AB277F2"}, {"file_name": "02-rain-room.png", "id": "4052021258266222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_4052021261599555_7160601809818238265_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz24tsg-R8YQ7kNvwEob93t&_nc_oc=AdoBOHilUCjgCHn0dNNhyfKLXgGZV_1xfbuFhO5dwTxGB0OkvxJThsMdt6sJdmuzXEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyQiIoT-JQzyHvwXQMKDX_cG_TDOf5nfH7IKYZieDdEw&oe=6AB29A4F"}, {"file_name": "03-room-garden.png", "id": "1733245414560555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1733245417893888_2975462257640087065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSvf29pl4JEQ7kNvwGGI1kP&_nc_oc=Adr80xfomci3pQS7YQmuE-i0F2w5FWCQg85sv5ENQHPs0sAlenWdvCbA-b8UxYjkydc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWPXrZHYmsxtCCk9icuSALnmc3jQm-XhYkFb-Tt2bJLA&oe=6AB297D6"}, {"file_name": "04-room-bloom.png", "id": "1380060383764024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1380060390430690_3738127928688293481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCwac-NdzUgQ7kNvwEZNq1t&_nc_oc=AdoaHuJKwJ7FS2TxPBFxXcqmhYvieXYKUs9Neks9AQNYTNJNNjEH2OixOtGV3p6HoX4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuly7H70HYr0jwTQASPzzKtC07prpX4QgHxJ_99NpgtA&oe=6AB27A37"}, {"file_name": "05-gravity-stretch.png", "id": "1821365835964214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1821365842630880_2454736888641433601_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5yNF7dTaykQ7kNvwEFthD6&_nc_oc=AdqZbkYgATkp9RVDnoQ7yX1watotm2zIG1VM6D8xGZ7vxSUUIPvHGuSfwft1JPxw2tU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTZqdbedh6FlFVc_hwqj6N6MxUhSj-_ehZ-UppoiarUg&oe=6AB2820F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "2000701453781032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824292_2000701460447698_3360556371350616484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-zNyphZ6IwQ7kNvwFoVliB&_nc_oc=Adp_AUY-dB3uKdfQbeU_sKUuM8hSy0wxzBqNaEHaBEU1XeIPBVJwSvu0RyAt2tTaSqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfPTbmc9YvWulJvroQl2tciXknLqmW03WMukkKRPK4QA&oe=6AB27E9C"}, "display_name": "Room Bloom", "keywords": [], "long_description": "Discover a different side of your everyday space. Room Bloom brings four atmospheric mixed-reality scenes into your room, with effects that respond to scanned walls, floors and furniture.\n\nROOM BLOOM\nRelease colourful motes, gather them close and scatter them with a pulse, accompanied by gentle ambient music.\n\nRAIN ROOM\nSettle into the sound of rain as drops fall around you and splash against the surfaces in your room.\n\nFRACTAL GROVE\nPlant intricate geometric forms on real surfaces. Reshape your grove, bend nearby forms with your hands and dissolve small patches to make space for new designs.\n\nROOM GARDEN\nTrace a path across your room and watch glowing lotus flowers gradually unfold. Prune, renew and shape your own luminous garden.\n\nUse tracked hands or controllers, switch scenes from the floating menu and adjust visual quality and lighting in Settings.\n\nRoom Bloom is a single-player experience. Spatial-data permission and a scanned room are required for surface-aware effects. Your creations are temporary and begin anew each session.", "short_description": "Turn your room into a playful mixed-reality canvas. Send colourful motes drifting through your space, listen to rain falling around your furniture, grow geometric fractals, or trace glowing flower gardens across real surfaces. Explore four atmospheric scenes with hand tracking or controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kwrona.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Krzysztof Wrona", "support_website_url": null, "website_url": "https://kwrona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1771002220599461"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_2314335759369267_4248616445219684097_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0UfUtZK1mMQ7kNvwHheF1V&_nc_oc=AdpVbpmntBLIi76lo-YXJ_svI8L2WKduVcb5LHpeAsWPuizUGJbe0cDebAcB1dOeH9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6-mCR9SG1MzgzFRUh7Jf77eMFSltWF-FFyjFTHhZE1g&oe=6AB27DA4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Room Bloom", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1789405860, "lastRevision": {"nodes": [{"id": "1771002240599459", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application
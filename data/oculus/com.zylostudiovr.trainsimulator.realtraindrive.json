EgCsQ7kNvwG9jUmi&_nc_oc=AdrGzACT6NI4kr09K-MiVKd8Xt0ISp1IDGeblqpAMhTnZJiexnt7Isf6JjUELR9SYic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6taYkGOt2w1Gny5xr3AagppAf4emigQJD-MjqgVnFAA&oe=6AAFD8D9"}, {"file_name": "4.png", "id": "2564841207270039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_2564841210603372_2904282679683741409_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGTTr5A9jjoQ7kNvwGZR6VS&_nc_oc=AdpmZx39f-CjJy4XUyIVvXk5_-IOFTvMCwJF4wc2HoAxDWQKqn_JjeaAeaCGeV9M4Vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHkNaYgpgaNxQSCDIQ6kNnrlBxc6UNsCscT5Li1KMYvw&oe=6AAFFCA9"}, {"file_name": "5.png", "id": "1603095271420705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618730118_1603095278087371_306434686119118825_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwOrbTbu_5EQ7kNvwEjZeA8&_nc_oc=Adpu96ROWQqMbZGvsJ24r7gtXQ7cU-Odx7qJkEucxEr_jkdv-hE3puWY26pJ2QL5yQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLakp7I1l6DQnmKhGLQK2PxpyloVFtRZFnusjFWKR1U7w&oe=6AAFE692"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Train Simulator: Real Train Driver", "keywords": ["trainsimulator", "traindriver", "traingame", "railwaysimulator", "traindriving"], "long_description": "Step into the driver's cabin and experience the excitement of operating powerful trains in Train Simulator: Real Train Driver. Drive modern locomotives across detailed railway routes, transport passengers safely between stations, and master realistic train controls in an immersive simulation adventure.\n\nTake control of every journey as you accelerate, brake, sound the horn, and navigate through beautiful environments. Complete challenging missions, follow railway signals, and enjoy smooth, realistic train driving designed for both casual players and train simulation enthusiasts.\n\nWhether you enjoy passenger transport, exploring scenic railways, or simply love train games, this simulator offers an authentic driving experience with engaging gameplay and detailed train operations.\n\nFeatures\n\ud83d\ude86 Realistic train driving simulation\n\ud83d\ude89 Transport passengers between railway stations\n\ud83d\udea6 Follow railway signals and traffic rules\n\ud83c\udf0d Explore detailed railway routes and environments\n\ud83c\udfae Easy-to-learn controls with immersive gameplay\n\ud83d\ude84 Drive modern and classic locomotives\n\u2b50 Complete exciting missions and driving challenges\n\ud83d\udd0a Realistic train sounds, horn, and engine effects\n\ud83c\udf24\ufe0f Beautiful landscapes and dynamic environments\n\ud83d\udd79\ufe0f Smooth performance designed for an enjoyable simulation experience\n\nBecome the ultimate real train driver and master every railway journey. Drive with precision, complete rewarding missions, and experience one of the most immersive train simulator adventures.", "short_description": "Real train driving simulator with passenger transport, railway routes, train stations, and realistic controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING
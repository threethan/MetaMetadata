t=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0EU8Vkw2NIQ7kNvwG7vq_M&_nc_oc=AdnseunLXYHTFLYrJURw0o64rbCstOFzoy2Wlpabbcc6dRwepu1ub0IZrabMPoRZipg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVE5HEmrkHds0NAJMB6bOBNKZ_hhWR1qoZ5HeyxitTsA&oe=699D9144"}, {"file_name": "migrated_image.png", "id": "236352034205115", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203622_413071549377624_7534618134750167040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JQg4JoxfF4Q7kNvwF4QCmA&_nc_oc=Adm84iZxLZljkoZcxsAQsKphAZeWytjaenPk8CNK5wOYJMNBGjsBjLXyES9xHhR8nQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQy0Jo0QgQ0OXJokl9oT_085MF2UbXe6Bfew5rzRajgA&oe=699D8261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/WKZpyo", "id": "1149460935264777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974600_1149460938598110_3245760554282778624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m_eTBH-yJ8Q7kNvwEhW9zm&_nc_oc=Adnjn3LQb1Z6u7D04dq1qeDMfYamc_wreTaVFaqW4ULHZQrEirdrT2RjCmI6qV0Tmvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthxJV7RyyBGL3xCeRR7GvSeSEE9G3CZMShDN6ICqfCag&oe=699DAEF0"}, "display_name": "The Under Presents", "keywords": ["Exploration", "Adventure", "Story", "Narrative", "Multiplayer"], "long_description": "From the creators of \u201cVirtual Virtual Reality\u201d - Welcome to the Under! A time and mind bending theatrical adventure.\n\nUnravel the mysteries of The Aickman, a doomed research vessel trapped in Arctic ice, in our newest act \u201cTimeboat!\u201d\nFollow our crew as they vanish one by one\nManipulate time to alter characters\u2019 fates\nCollaborate with your past selves to explore our crew\u2019s memories\nMeet Gerald, a most unusual dolphin\nCozy up to new friends and enjoy stage shows\n\nThe Under Presents:\nErin Markey sings \u201cWet Food\u201d\nSweaty Eddie does his laundry\nShasta Geaux Pop thrusts exponentially\nRonald Peet navigates the fog\nDeepali Gupta conducts murmurations\nEveryone\u2019s favorite animatronics: The Lame Drivers\nSean Spada takes it slow\nApple Pie Bundy has some special friends he\u2019d like you to meet\n\n** For a limited time, guests may experience special performances by live actors **\n\n*For everyone\u2019s safety, the staff of the Under wants to discourage guests from using ritual magic to enlarge the crobs.*", "short_description": "The newest game from the creators of \u201cVirtual Virtual Reality:\u201d a time and mind bending theatrical adventure -  complete with ghost puzzles, jazzercise and dolphins."}]}, "developer_name": "Tender Claws", "developer_privacy_policy_url": "http://tenderclaws.com/privacy/PrivacyPolicy.html", "developer_terms_of_service_url": "http://tenderclaws.com/privacy/EULA.html", "publisher_name": "Tender Claws", "support_website_url": "https://tenderclaws.com/about", "website_url": "https://tenderclaws.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "998404040762632"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "CANCELLED", "id": "270088040754591"}, {"status": "CANCELLED", "id": "666904643892590"}, {"status": "PUBLISHED", "id": "725378238277947"}, {"status": "CANCELLED", "id": "1160968084073628"}]}, "baseline_offer": {"id": "725378238277947"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 15
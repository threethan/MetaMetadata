.io/calmvr-privacy-policy/468bd3bb-0f38-4c09-be8c-50872483c1eb/privacy", "developer_terms_of_service_url": null, "publisher_name": "Future Reality", "support_website_url": null, "website_url": "https://ftr.by/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24842788705356285"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499312422_1286728393000356_1452692209922305890_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=Svw4NK03hjEQ7kNvwEGkeAc&_nc_oc=Ado9IkjdZcJGD-ya7xAx3eSQPL2rELVk15QPYxLbSNZQFd7djhmncln4_awn37YspSo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTYaVCzxLeV0DSY_p7ORZsJ2v1K5hGTJzO73-NySpYHw&oe=6A8ED782"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CalmVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1758893400, "lastRevision": {"nodes": [{"id": "24810989655202857", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24810989605202862", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"i
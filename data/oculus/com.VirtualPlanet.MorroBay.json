3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MC3Ymw3rt9jZ0QMZOS22_IbI8N44vSde4S_bb0GbYOg&oe=6A2585CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Morro Bay", "keywords": ["Climate", "Adaptation", "Cycling", "Resilience", "SLR"], "long_description": "Every great community story begins with a challenge \u2014 and a shared vision to overcome it.\n\nAlong California\u2019s Central Coast, the Morro Bay Estuary Climate Resiliency Transportation Plan invites residents to explore how rising seas and stronger storms are reshaping vital connections between Morro Bay and Los Osos.\n\nThrough Virtual Planet\u2019s Sea Level Rise Explorer: Morro Bay, viewers step inside an immersive 360\u00b0 experience that brings science and design to life. Explore real locations, witness future flooding scenarios, and see how innovative adaptation ideas \u2014 from raised roadways to levee-based trails \u2014 can protect access, ecosystems, and communities.\n\nThis interactive experience is part of a collaboration led by the San Luis Obispo Council of Governments (SLOCOG) and partners, designed to inspire understanding, spark dialogue, and support planning for a resilient Central Coast.\n\nDiscover how technology, storytelling, and community come together to shape a safer future for all. \ud83c\udf0a", "short_description": "Explore how rising seas are reshaping California\u2019s Central Coast in this immersive 360\u00b0 experience. The Morro Bay Estuary Climate Resiliency Transportation Plan reveals real locations, future flooding, and adaptation ideas to protect roads, habitats, and communities. Created by Virtual Planet with SLOCOG, Environmental Science Associates, RRM Design Group, and the Middlebury Institute of International Studies, this VR journey blends science, design, and storytelling for a climate-ready future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet", "support_website_url": "https://www.virtualplanet.tech/#contact-us", "website_url": "https://www.virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25046401228352599"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1561478168710952"}, {"status": "PUBLISHED", "id": "823005120456254"}]}, "baseline_offer": {"id": "1561478168710952"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780061520, "status": "PUBLISHED", "id": "1561478168710952"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25113595061633215", "version": "0.33.0"}, "id": "24563544919964529", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24525645183761542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25113595061633215"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "24563544919964529"}]}, "change_log
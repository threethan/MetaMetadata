 "locale": "en_US", "screenshots": [{"file_name": "screenshot01.png", "id": "1981932802347321", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507849536_1981932805680654_4025868734460278296_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMG1JmUv1pgQ7kNvwHmDKlz&_nc_oc=AdqDaDOWTrCnIjqvvBOiq0Fl-jfrZZOLp8UbTgc1siKiDJrJLwlH_b62Fm15-9YtBPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqfwJu3vTQCFydhKBWKRu3dcrb9BZpZLEjl3f5Lu6GqQ&oe=6ACA6701"}, {"file_name": "screenshot03.png", "id": "1852778875356303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_1852778878689636_6277195834180183945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a0y1-6J32gQ7kNvwEGCEEG&_nc_oc=Adop1VPH3oKBzqUBDFsI4N4nZ-05BCgHKoVGmooJlrqkyBkk5b4MCTTSC6lpBHD28n4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDB7Dy7ukF4znl1sLkCKiyHqloeeXwuMzhu7cBA4IUjA&oe=6ACA4232"}, {"file_name": "screenshot04.png", "id": "1156173343099514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300910_1156173346432847_9021329053418088198_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wjeOrqdSrsQ7kNvwEPU7EG&_nc_oc=AdpLl73fHKu4BDHzgeZjYDzgg1tBkPs2fuAT8sdeEfRuZykqbX78Q9ntWXrb5xcTQM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSDRrWAKhul5OAi8jHyoFf6i2-pBKw1KoOnY8c7SU_Gw&oe=6ACA50DF"}, {"file_name": "screenshot02.png", "id": "24962366060055542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827703_24962366073388874_2376569329385509602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmkKFWH4q9oQ7kNvwEC5hvo&_nc_oc=Ado72vRFVf5Bau349qWA-rfXvz9QIsLuHwSZMWJMCQUi9YDbvQbLrKwAepS8woRGiss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtLb1WasWEK9it966MoAacSHuy-HuWD6EQZEFSfW16Dg&oe=6ACA6220"}, {"file_name": "screenshot05.png", "id": "765530149687058", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827703_765530153020391_520786291548993371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny-cdwkYFAIQ7kNvwH2JmXG&_nc_oc=AdqQemaC6wvb8xresFMEwzRxvQgEV09eoX4cCXYf35LBz2pwZaXJXA1iObx1K39ILF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRYTOHMVM1WQH3SuBUksGRwPmnZSc6r4DZOGuHRQfbLg&oe=6ACA514F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Morro Bay", "keywords": ["Climate", "Adaptation", "Cycling", "Resilience", "SLR"], "long_description": "Every great community story begins with a challenge \u2014 and a shared vision to overcome it.\n\nAlong California\u2019s Central Coast, the Morro Bay Estuary Climate Resiliency Transportation Plan invites residents to explore how rising seas and stronger storms are reshaping vital connections between Morro Bay and Los Osos.\n\nThrough Virtual Planet\u2019s Sea Level Rise Explorer: Morro Bay, viewers step inside an immersive 360\u00b0 experience that brings science and design to life. Explore real locations, witness future flooding scenarios, and see how innovative adaptation ideas \u2014 from raised roadways to levee-based trails \u2014 can protect access, ecosystems, and communities.\n\nThis interactive experience is part of a collaboration led by the San Luis Obispo Council of Governments (SLOCOG) and partners, designed to inspire understanding, spark dialogue, and support planning for a resilient Central Coast.\n\nDiscover how technology, storytelling, and community come together to shape a safer future for all. \ud83c\udf0a", "short_description": "Explore how rising seas are reshaping California\u2019s Central Coast in this immersive 360\u00b0 experience. The Morro Bay Estuary Climate Resiliency Transportation Plan reveals real locations, future flooding, and adaptation ideas to protect roads, habitats, and communities. Created by Virtual Planet with SLOCOG, Environmental Science Associates, RRM Design Group, and the Middlebury Institute of International Studies, this VR journey blends science, design, and storytelling for a climate-ready future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet", "support_website_url": "https://www.virtualplanet.tech/#contact-us", "website_url": "https://www.virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25046401228352599"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1561478168710952"}, {"status": "PUBLISHED", "id": "823005120456254"}]}, "baseline_offer": {"id": "1561478168710952"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780061520, "status": "PUBLISHED", "id": "1561478168710952"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25113595061633215", "version": "0.33.0"}, "id": "24563544919964529", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24525645183761542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25113595061633215"}, "release_s
luscdn.com&_nc_ss=7f20f&oh=00_AQQaM6TaVZOuZh8WB7zdalPAQbNPiaWSJqAaLYqZdQKyzg&oe=6AFC7B20"}, {"file_name": "screenshot05.png", "id": "765530149687058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827703_765530153020391_520786291548993371_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS8r4TH8dO8Q7kNvwGoxyU7&_nc_oc=Ado2zwBGW-V4vhPr43nHSiLyM3m6hwgJ-nwmOKkGqwdgTH-FF-_L3kj1IJdonoRXnR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG8OVH_w5QP2XnubT_1G5W_ms60MdDY9DtCucbhOYTSg&oe=6AFC6A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Morro Bay", "keywords": ["Climate", "Adaptation", "Cycling", "Resilience", "SLR"], "long_description": "Every great community story begins with a challenge \u2014 and a shared vision to overcome it.\n\nAlong California\u2019s Central Coast, the Morro Bay Estuary Climate Resiliency Transportation Plan invites residents to explore how rising seas and stronger storms are reshaping vital connections between Morro Bay and Los Osos.\n\nThrough Virtual Planet\u2019s Sea Level Rise Explorer: Morro Bay, viewers step inside an immersive 360\u00b0 experience that brings science and design to life. Explore real locations, witness future flooding scenarios, and see how innovative adaptation ideas \u2014 from raised roadways to levee-based trails \u2014 can protect access, ecosystems, and communities.\n\nThis interactive experience is part of a collaboration led by the San Luis Obispo Council of Governments (SLOCOG) and partners, designed to inspire understanding, spark dialogue, and support planning for a resilient Central Coast.\n\nDiscover how technology, storytelling, and community come together to shape a safer future for all. \ud83c\udf0a", "short_description": "Explore how rising seas are reshaping California\u2019s Central Coast in this immersive 360\u00b0 experience. The Morro Bay Estuary Climate Resiliency Transportation Plan reveals real locations, future flooding, and adaptation ideas to protect roads, habitats, and communities. Created by Virtual Planet with SLOCOG, Environmental Science Associates, RRM Design Group, and the Middlebury Institute of International Studies, this VR journey blends science, design, and storytelling for a climate-ready future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet", "support_website_url": "https://www.virtualplanet.tech/#contact-us", "website_url": "https://www.virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25046401228352599"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1561478168710952"}, {"status": "PUBLISHED", "id": "823005120456254"}]}, "baseline_offer": {"id": "1561478168710952"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780061520, "status": "PUBLISHED", "id": "1561478168710952"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25113595061633215", "version": "0.33.0"}, "id": "24563544919964529", "channel_name": "LIVE"}]}, "is_for_oculus_
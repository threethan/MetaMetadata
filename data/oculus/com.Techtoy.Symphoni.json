CG1xXFBrhyz4II8_OdVATik2hngkreueyYedvNB6P_wYvQUwgWpQ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp4jllBMNrznrJSL-iOJCZiu5lcq3zAGbkfeb36kEFHw&oe=6AA3FC07"}, {"file_name": "Symphoni_Launch_Trailer _LIV.mp4.00_00_39_33.Still002.png", "id": "1545533193073242", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821568_1545533196406575_5728491878252193886_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPaULgpaHKEQ7kNvwGCh8Cm&_nc_oc=Adop8_Hbb5Kz8vfTQff2zwnjdBrZoRv80dY80GLwIR1VfcsF34EagyogOl29m9Otxow&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGer2BlRo5-YOJGCUNqnPafbKK5IkY1j0tAzJ5_nqw5A&oe=6AA3F282"}, {"file_name": "Symphoni-Screenshot-04.png", "id": "473694689137535", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393320_473694692470868_5425549575320582278_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnJEfuCFnAQQ7kNvwEszSOc&_nc_oc=AdrdL47MJxEQbDkUMXdhogIZ9JzTA9i1ID2IBkmRsSMmdbBH6bbFtZ7JLN61jtTS4G4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0qzulfTZM7QjBFGtTGILzKfqWa1uCe9MkGybH3lo18Q&oe=6AA40DEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_Symphoni_Landscape_2560x1440_v2.png", "id": "710430601453195", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823301_710430608119861_5556723322279509536_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJyGMNp-mlkQ7kNvwHuyst-&_nc_oc=AdqMny92ikEIXIkZ8GlsmSBSIM_NXZf_K6cnZw-qGVGk_3agL46tsg9b_3puJBbH-oI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmMNzh9cFiWihycfDDUC7oT8gzEaq703jawt2ypdiA5g&oe=6AA406C8"}, "display_name": "Symphoni", "keywords": ["Conducting", "Maestro", "Wizard", "Magic", "Rhythm"], "long_description": "# \ud83c\udd95 April Update | PLAY & CREATE Custom Songs with Symphoni Composer (Beta)\n**Community-made symphonies** are now available with **mod.io** integration + **Symphoni Composer** (Beta). Check out our community library here: https://mod.io/g/symphoni\n{707255111657422}\n\n# \ud83c\udf0e Step Into Magical Realms\n{921407033308625}\n\n# \ud83c\udf20 Wield the Power of Music\n{1017135330244800}{633925752354407}\n\n# \ud83d\udd2e Collect Wands & Unlock Crystals\n{2753157158218964}{602916329194974}\n\n# \ud83e\ude84 Master the Magic of Motion\n{1132195501699773}{664540836007804}\n\n# \u2728 Experience the Magic of Music\nJoin our Discord for exclusive updates: https://discord.gg/symphoni\n{1043215534309263}", "short_description": "Welcome to Symphoni, where you can be a grand musical wizard who breathes new life into classical music. Unlike traditional rhythm games, Symphoni lets you conduct, cast spells, and transform reality while grooving to the classics.\n\nWith 16 masterpieces, 3 difficulties, wand collection, collectible crystals, a community map library, and free song updates planned in the near future, get ready to raise your wand and experience the magic of classical music like never before."}]}, "developer_name": "techToy Studio", "developer_privacy_policy_url": "https://techtoy.studio/symphoni-privacy-policy/", "developer_terms_of_service_url": "https://techtoy.studio/tos/", "publisher_name": "techToy Studio", "support_website_url": null, "website_url": "https://symphoni.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mod
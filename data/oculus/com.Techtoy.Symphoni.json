WxP1&_nc_oc=AdqhF4a-aWC6u1NMYjU25OlLoBf5LD3D1F3-vgsgLKUcQ-_DT-bx_J0R9oNsygwWrDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLENQBJtdwL4T8TmQDtDM95O3Re2AwjhPwD9c91vXqJ9g&oe=6AAFF332"}, {"file_name": "Symphoni-Screenshot-04.png", "id": "473694689137535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393320_473694692470868_5425549575320582278_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62fD9bmtCM4Q7kNvwHL8vSC&_nc_oc=Ado3EeP2uGxJS9nVjcuhE49mZubUkSaL0uiu0FpyPdUwR5JO5A1SNEA8rS6F1WdU8Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2JWFPV4BWxZaK15EAaJ8F7k39Mkum9uOWzQBgW9ru_w&oe=6AAFEB6C"}, {"file_name": "Symphoni-Screenshot-05.png", "id": "1349648676476742", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391862_1349648679810075_447301309409170078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u40h7sPj4V8Q7kNvwGD4Qkw&_nc_oc=AdqsfaubB8UYbyFtaBwx6DisoTayqZ5qgeUEWDAV9kU-qA05nPY74MUio63fzJHXc9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPb_65RNmWhGQktdoNtAS-xXpD4Z56R5aBaEioYE6Jkw&oe=6AAFD671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_Symphoni_Landscape_2560x1440.png", "id": "9364163683649872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393723_9364163690316538_1881822928577390435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfOzLj7DZc0Q7kNvwFL9wl5&_nc_oc=Ado8ojFZA-cE6cPRDOFbaMuVGpmZmprHkXrn4Is2qxbzZenfKVcCkQhbSJT_T1GiKtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoTifwfAlVj9bcJ1OY1RNP0L6I7m1p9bzzKFNQhVzjEA&oe=6AAFFBAB"}, "display_name": "Symphoni", "keywords": ["Conducting", "Maestro", "Wizard", "Magic", "Rhythm"], "long_description": "# Wave Your Wand. Command the Music. Become the Wizard of Symphonies.\nWelcome to **Symphoni**, where you can be a grand musical wizard who breathes new life into classical music. Unlike traditional rhythm games, **Symphoni** lets you conduct, cast spells, and transform reality while grooving to the classics.\n{1043215534309263}{664540836007804}\n\n\n# \ud83c\udfbc Wield the Power of Music\nConduct the symphony with your wand and cast spellbinding portals to the rhythm of classical masterpieces.\n{633925752354407}\n\n# \ud83c\udf0e Step Into Magical Realms\nExperience visually stunning MR transitions as your living room transforms into enchanted symphonic worlds.\n{1017135330244800}\n# \ud83c\udfb5 16 Timeless Masterpieces\nChallenge yourself with Tchaikovsky, Beethoven, and more across three difficulty levels and four magical realms.\n{921407033308625}\n# \ud83d\udd2e Collect Wands & Unlock Crystals\nLevel up your magical abilities, unlock 25 unique achievement crystals, and collect four legendary wands.\n{2753157158218964}{602916329194974}\n# \ud83e\ude84 Master the Magic of Motion\nPlay using **hand-tracking** for an immersive conducting experience, or use **controllers** for precise rhythmic gameplay.\n{1132195501699773}\n# \ud83d\udcdd Symphoni Creator (Coming Soon)\nCompose your own musical challenges and try out **user-generated Symphonies**.\n{971665371137427}\n#  \u2728 Experience the Magic of Music\nWith **16 masterpieces, 3 difficulties, wand collections, collectible crystals, and a custom song editor + free song updates** planned in the near future, get ready to raise your wand and experience the magic of classical music like never before.\n", "short_description": "Welcome to Symphoni, where you can be a grand musical wizard who breathes new life into classical music. Unlike traditional rhythm games, Symphoni lets you conduct, cast spells, and transform reality while grooving tothe classics.\n\nWith 16 masterpieces, 3 difficulties, wand collections, collectible crystals, and a custom song editor + free song updates planned in the near future, get ready to raise your wand and experience the magic of classical music like never before."}]}, "developer_name": "techToy Studio", "developer_privacy_policy_url": "https
-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUwCJKaDRWaj9c-t-9O4rM2psKq0QLFf71eQ2LS9hLZg&oe=69AFF7F2"}, {"file_name": "Symphoni-Screenshot-04.png", "id": "473694689137535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393320_473694692470868_5425549575320582278_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avMyYFv95KMQ7kNvwEk0jaR&_nc_oc=AdmiD8yDIsrJyLuiIJLthMJ6Hqa5N6AuJGQxtadVqNqLe_vXhbGzfz84wE9mIrIvwTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCRC3JLW1owVTAhCfcC_pW0-BGRAync8YBvOevz0s0gQ&oe=69B0286C"}, {"file_name": "Symphoni-Screenshot-05.png", "id": "1349648676476742", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391862_1349648679810075_447301309409170078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly6rOwj3MucQ7kNvwGQYQy5&_nc_oc=AdkdSzkK9c9zv4YZ6nZ_KYlmYUM638ZUKPI5fsJ_bhWYKbFr2Md6VU6gOY573dDahVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmwQBx-OM9Psl_fYcHLf4CeD-pS4Ic2glslTHOEuXTyQ&oe=69B01371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_Symphoni_Landscape_2560x1440.png", "id": "9364163683649872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393723_9364163690316538_1881822928577390435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T60UPApWVCgQ7kNvwEbmO9a&_nc_oc=Adk9gl7Olvab1GAsF2TCv4dAjy8rxgtw5HhkANawBXBDCtF7mOjKYol_lAdwWNVZ7yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcrTfo-yvd1Ix7RFz-0maIvawGZ0DfTE5o7byyFdsTfA&oe=69B0006B"}, "display_name": "Symphoni", "keywords": ["Conducting", "Maestro", "Wizard", "Magic", "Rhythm"], "long_description": "# Wave Your Wand. Command the Music. Become the Wizard of Symphonies.\nWelcome to **Symphoni**, where you can be a grand musical wizard who breathes new life into classical music. Unlike traditional rhythm games, **Symphoni** lets you conduct, cast spells, and transform reality while grooving to the classics.\n{1043215534309263}{664540836007804}\n\n\n# \ud83c\udfbc Wield the Power of Music\nConduct the symphony with your wand and cast spellbinding portals to the rhythm of classical masterpieces.\n{633925752354407}\n\n# \ud83c\udf0e Step Into Magical Realms\nExperience visually stunning MR transitions as your living room transforms into enchanted symphonic worlds.\n{1017135330244800}\n# \ud83c\udfb5 16 Timeless Masterpieces\nChallenge yourself with Tchaikovsky, Beethoven, and more across three difficulty levels and four magical realms.\n{921407033308625}\n# \ud83d\udd2e Collect Wands & Unlock Crystals\nLevel up your magical abilities, unlock 25 unique achievement crystals, and collect four legendary wands.\n{2753157158218964}{602916329194974}\n# \ud83e\ude84 Master the Magic of Motion\nPlay using **hand-tracking** for an immersive conducting experience, or use **controllers** for precise rhythmic gameplay.\n{1132195501699773}\n# \ud83d\udcdd Symphoni Creator (Coming Soon)\nCompose your own musical challenges and try out **user-generated Symphonies**.\n{971665371137427}\n#  \u2728 Experience the Magic of Music\nWith **16 masterpieces, 3 difficulties, wand collections, collectible crystals, and a custom song editor + free song updates** planned in the near future, get ready to raise your wand and experience the magic of classical music like never before.\n", "short_description": "Welcome to Symphoni, where you can be a grand musical wizard who breathes new life into classical music. Unlike traditional rhythm games, Symphoni lets you conduct, cast spells, and transform reality while grooving tothe classics.\n\nWith 16 masterpieces, 3 difficulties, wand collections, collectible crystals, and a custom song editor + free song updates planned in the near future, get ready to raise your wand and experience the magic of classical music like never before."}]}, "developer_name": "techToy Studio", "developer_privacy_policy_url": "https://techtoy.studio/symphoni-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "techToy Studio",
qtWX3c", "id": "1327426844094257", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974458_1327426847427590_8265756859999191040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBxKPaLZLmcQ7kNvwFSNacE&_nc_oc=AdlGAPCMQVJ-FPF4P5Z0Esw5mcG52-krRn8AzEU4_8fbcyO5uQrjuiWw97V94mJk_WU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzahUD9BF2zi8NUwGOMHeuG09QnrxXrUjntNNnrD2fa2w&oe=69BBF230"}, "display_name": "REFLEX UNIT 2", "keywords": ["Action", "Shooter", "Arcade", "Multiplayer"], "long_description": "The year is 2039 and the planet has recovered after the events of Reflex Unit 1. Life seems safe, until a new larger army of remote control drones suddenly attacks strategic cities around the globe. \u200b\n\nIt is up to you again to pilot a new batch of experimental hardware to fight back the invading forces and save the planet, and beyond...\n\n- 1 or 2 Player Campaign\n- 2 to 4 Player Versus and Survival modes\n- Cross Platform Multiplayer (iOS, Android, Oculus Platforms)\n- Game Controller Compatible*\n\n*XBOX Game Controller Recommended", "short_description": "Take control of an advanced walking tank facing waves of challenging enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.robosarugames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ROBOSARU GAMES", "support_website_url": "https://www.robosarugames.com/", "website_url": "https://www.robosarugames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "suppor
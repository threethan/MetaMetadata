8Tq0RiCRmLze1K9UVosUOWmUsep50UCg&oe=69CA7460"}, "display_name": "Exotic Howlers", "keywords": [], "long_description": "In this game you can venture zero gravity, or take a relaxing spot and our friendly old beach! If that does not seem much meet Kitty Kat will be wanting to meet you in the pond in forest! Oh ya in forest you will be able to slide down a clear slide, swim in a pond, and spawn in a place called stump! In stump you will be able to type in your name, look at yourself in a mirror, and look at what is new on our black board! Now that is all for now but we will add much more in future updates!", "short_description": "Exotic Howlers is a game where you are a Black Howler is a big great world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1M37mR9dBMIEI_qE9vdh_Vu71S1d51y92n-SuezpZcvc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Qwertyquy", "support_website_url": null, "website_url": "https://sole-games.webador.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "800207691664872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982468_1009215400439040_4625483677151251194_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLzVYmGNQjkQ7kNvwFL0Y9c&_nc_oc=AdoJH2ywdoDUTyr_0aQA46w3vF0fTaMADMqqEllB
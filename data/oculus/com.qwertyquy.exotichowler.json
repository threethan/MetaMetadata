40832245117_6176039483427624048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxBBLWHiF18Q7kNvwHLMeS6&_nc_oc=AdmGvryOtop-pYzsUziE4iz2evm5jK4OgfakLsdUZC9-v_EouJ6ptYHbYBhYnS7rwzs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGnH1YS7kS_mULYNa-irVCVqa8C3o0bFhprSDb1gAeTQ&oe=69BAB650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eh12.png", "id": "1332359011027692", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75250455_1332359014361025_680478586510360824_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z7_YHgQ5fgQ7kNvwEUgek4&_nc_oc=AdntzNACMM-o-Ki3A1GtE0iT4xSKB2J7b2KZgkMVC7uJobW6kJpkYR7yTmaCaeK0l_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzGmXyoiBLfTQLdSJ3jLyDW3jy-4wKH1ykmcn6bJo68Hw&oe=69BAA260"}, "display_name": "Exotic Howlers", "keywords": [], "long_description": "In this game you can venture zero gravity, or take a relaxing spot and our friendly old beach! If that does not seem much meet Kitty Kat will be wanting to meet you in the pond in forest! Oh ya in forest you will be able to slide down a clear slide, swim in a pond, and spawn in a place called stump! In stump you will be able to type in your name, look at yourself in a mirror, and look at what is new on our black board! Now that is all for now but we will add much more in future updates!", "short_description": "Exotic Howlers is a game where you are a Black Howler is a big great world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1M37mR9dBMIEI_qE9vdh_Vu71S1d51y92n-SuezpZcvc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Qwertyquy", "support_website_url": null, "website_url": "https://sole-games.webador.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "gen
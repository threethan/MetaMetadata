40832245117_6176039483427624048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FITAaNVGLGAQ7kNvwESEjX8&_nc_oc=AdkziG6x7N-dxne7ccFa3u2jPJbONNTYGV9od2dY-UvpxNsY63rWQdwI9mH45QP2xHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1cwjEtjjGABqfM_minzxwNQ8xPAK-1zreWxywD9yWfg&oe=69AD8750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eh12.png", "id": "1332359011027692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250455_1332359014361025_680478586510360824_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT7tvPqUbXUQ7kNvwGlXVry&_nc_oc=AdkXDjyy_PVFqzbQvDHUpBxtdhsQU6-cYe3PXnJGu115lNHt5Um5aH3yuNd_EYlAm6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyONkdCMEZR584FWnkd-lYtjkkhp6MXmQKnBhACpZmqug&oe=69AD7360"}, "display_name": "Exotic Howlers", "keywords": [], "long_description": "In this game you can venture zero gravity, or take a relaxing spot and our friendly old beach! If that does not seem much meet Kitty Kat will be wanting to meet you in the pond in forest! Oh ya in forest you will be able to slide down a clear slide, swim in a pond, and spawn in a place called stump! In stump you will be able to type in your name, look at yourself in a mirror, and look at what is new on our black board! Now that is all for now but we will add much more in future updates!", "short_description": "Exotic Howlers is a game where you are a Black Howler is a big great world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1M37mR9dBMIEI_qE9vdh_Vu71S1d51y92n-SuezpZcvc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Qwertyquy", "support_website_url": null, "website_url": "https://sole-games.webador.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "gen
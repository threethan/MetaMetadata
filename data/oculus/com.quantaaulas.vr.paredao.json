tura-5-meta-final.png", "id": "1497596198861335", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499292232_1497596202194668_6827644370824482634_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ADglfdJuxEQ7kNvwFOhGFs&_nc_oc=Adop0GOr1LFG5KAahdx3kFhaI-Sr9juVaF2haJCWyULnxVuFCqNvSSuu9SdKgUW-314&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4kTzupUq0lC47WCqxF7jso4XWwMgOuLsddvrv7HTRMA&oe=6AFF07A5"}, {"file_name": "paredao-captura-2-meta-final.png", "id": "1449127160690568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312306_1449127164023901_6877115744520236268_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Aj6ZTvS06UQ7kNvwGaxWPJ&_nc_oc=AdpM9MyhJVl-Rwtv7dbgCUUp-4LtQGCMCNZKngLuOnrdIJZuJkzABBBFyh2fAz8_cOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUeqoUJcjLQOpvtRvV1M68-D52PxMsiuAox16kikekXQ&oe=6AFF1173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pared\u00e3o: VR Goalkeeper", "keywords": ["soccer", "goalkeeper", "football", "sports", "reflexes"], "long_description": "Become the goalkeeper in Pared\u00e3o: VR Goalkeeper by Quanta Aulas. Read the shot, move your hands and stop the ball in virtual reality.\n\nBuild your reflexes in guided training, progress through the campaign, or see how long you can last in survival mode. Track your score and saved progress. Choose English or Brazilian Portuguese for menus, instructions and match messages.\n\nDesigned for Meta Quest 3 and Quest 3S. Use Touch controllers or supported hand tracking. Play standing in a clear, safe area; step sideways and stretch your arms, but never dive onto the floor. Follow the in-game safety instructions.\n\nFree download with a one-time in-app purchase to unlock the complete game. No subscription or ads. Restore your purchase using the same Meta account without paying again. Internet connection required to load this WebXR experience.", "short_description": "Step into the goal. Save soccer shots with your hands or Touch controllers in an immersive VR goalkeeper challenge. Play in English or Brazilian Portuguese."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quantaaulas.com/meta-games/store/paredao/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Quanta Aulas", "support_website_url": null, "website_url": "https://quantaaulas.com/paredao/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR", "en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381398998390090"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831964_1652699329560368_8225879685495465623_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNJ-jsnveSkQ7kNvwHbCRou&_nc_oc=AdoI4uaF9-BhWABR_DWb-1s_B2C9m1uGshUbourEQEIH0YN1gBP83KuVqpIlftQqBAQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrIhEsdl7WwJ23L_iFTk9QkIBkTVQW1qlPNYMBaiwiKQ&oe=6AFF0B3D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pared\u00e3o: VR Goalkeeper", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1792007880, "lastRevision": {"nodes": [{"id": "1372246
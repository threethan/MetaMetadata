&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKA2xDUOFyIQ7kNvwFo8W_V&_nc_oc=AdqXjbB3Kyo-fRL2CjVocambzrSZ0YBZN4nTcUnzzywC2BWYei697gVi0CsWsZm4KGw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdiYjA8aLYV2x8R98czT8WBe71crjuGt_NHxj7qmvIvA&oe=6A8EC8C2"}, "display_name": "Patchwork", "keywords": [], "long_description": "3D modeling in VR. Use curve-based \"patches\" to create geometry, and paint them using simple, intuitive controls. Export your models to .glb and share with the world. The easy way to create 3D models, no need for UV unwrapping or other complicated procedures. Simply drag and stretch geometry out of thin air and paint on them. Pull in images to use as reference.", "short_description": "3D modeling in VR. Use curve-based \"patches\" to create geometry, and paint them using simple, intuitive controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.floatstudiovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Float Studio VR", "support_website_url": null, "website_url": "http://www.floatstudiovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628464565060082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75443237_388729108827911_7208666403273050049_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e
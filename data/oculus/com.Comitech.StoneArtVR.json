g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo-YgKh-v1gQ7kNvwFi8l0h&_nc_oc=AdlXOXjgl8QZLafMkYYEAx9H0r0KpMBqG9vPn6DVqu_ZY9RgdajKOtqdt6TqyXIPRgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyD7be0NuoHmHu51sLIrir_QpHnK3WV2--9oSEtVbC7w&oe=69B41B1D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPdQ8A-p7_oQ7kNvwFu8nHK&_nc_oc=Adn-ytGFst1yqTMgk9JuWhxACUAeGit7JOlzRO8NGNLXIlnbWzvZBpEBUi7UB2UyOAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5KF8XwF2lQSEbp4xc9KRMuMW4EsG8shtHyQ-UFbyxFA&oe=69B420B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLUPteY0xnMQ7kNvwHR3xky&_nc_oc=AdkxaGD0_pGU_RK8awbn4ZeLQrgM9zISmlcy_qwk7eLPpHbn041nvllfV0-sQeKF4ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzW80_0sfRIhG-hioKJiQejxiNcYwyGV7R4klFydEtDbg&oe=69B3ED93"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHQLV0AfccIQ7kNvwG2E905&_nc_oc=AdmcFi1KUUjekFm0ENNAHjpyIyt0t18KaqrXj8uvhsUlJ9LH9PFOsj_bsQA3YEiVWpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzV1hiLT1rNeGCAMoUya1GWapdcmOtg33WBx3id435fOA&oe=69B410A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7B5_MZ6VjIQ7kNvwHz50nW&_nc_oc=AdnP5vTmllOhOqt33mlndOzQLGSQzNU9Lz6MaJEXiDv2_I6PoZq5Wi9aGurpThazjEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkhGByvvH6o8ACl3AL4sEtxEfZZ4whQS8tpa_PJXkYEg&oe=69B3F4D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLFswd69rGQQ7kNvwEKsT86&_nc_oc=AdohdXebOLZhJEBo4VUdRvVxIuNNmj3XrDXxikVcWeCg-PD40xUrDo9hw3MZujtaMkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h1OFmWnXcIaGR1THlvVnewDq3fjY6L3fOzwy7B3B7Dw&oe=6A427D1D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TN2meKHLaoQ7kNvwGplbsj&_nc_oc=AdotRi4qwm1fHYMyvqXBBvmI3FCokXlraz5c6mCuGgb5Eb6NmCtkAjyhlCR0dfbSC9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b7ctQM1-3rBt8W3OppH7wBRBmUqi1XAuEDuQcC9Y8Vw&oe=6A4282B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zE9u_I5FAVAQ7kNvwGkmqtA&_nc_oc=AdpYJE9eGTULEtdNFAbcYJXww3uTvHXJiIs9QNPWG0yd5q6ACnF6VeaGH6FCc-kXxkE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pcz-UOdUKzIrOtxSsA3Y9Kl3PY7gzEQlXXlwjvL6grQ&oe=6A4287D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCiv7WliiWQQ7kNvwFjGRUm&_nc_oc=AdoHp_PDywXRXjuvS6SfdmteGLCYLu_KMiPs7S2NyMnAAhFwRQLuf4ibdh34LodlT0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RZ9MAGArPEadaRnubS6HI9epCynVboJt7HmHeEGsY5w&oe=6A4272A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okdXu-RQ1iMQ7kNvwEUWCxk&_nc_oc=AdrrvwkI5foe2os39MzAsuvNRgtb8hcs1sSZ6bPWaUiNWGebjpOHJp_wqMfWWS7NpO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2YbKcpXMCQ24XJmp4BH28kCjHXbM99ttNajRRTdZ72Q&oe=6A428F19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GozdJLefboQ7kNvwE73sOB&_nc_oc=AdmSFgXU7LB-RzwMhoEKzXdIz6ujJXPtQvccID3siVOYnv5AphcrsCcVlppbXk-P2B0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBBImMtox1NC6ylEJlOSxCVx7dY9YPTvaHs1c0x68tVw&oe=69AD839D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVOWqkRY7vIQ7kNvwGC-pC-&_nc_oc=AdkhneHmEvOC7iaZev2L_tB86gIboMniQy1i9r_uWm7vwvQ0LnFb_V_rljKFrRQWqII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOfArEAuLFPaeoic4g-uWdK0MgXkh04PNYeX5GlapCEA&oe=69AD50F4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGosLCEGrFsQ7kNvwH4o2WD&_nc_oc=Adn62kjwW6_l02LkQzCZx6XH4XJNOmYkWKGs0jTQBlMNWHHnPkOW9ihcJoTSDvZASEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi6D5sz_uUC_8FYbQF5sMOHB49nz8QoTKthjo2L2_b5g&oe=69AD5613"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNMB7ki1q1wQ7kNvwFXLzTa&_nc_oc=AdmgTtoquj60L079zbNhCUjPpi2MLQv5yD3oVDFRGBfns19aObgsC5ZMjUQAl8PTzRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNSejNjRjuEXarSDxwz4W8T2yyENfT4jI1SjeohN1S2Q&oe=69AD7923"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0InfvpVy7McQ7kNvwE1ZoV6&_nc_oc=AdnYomH6MSkho_-AsVddN5z0bcLZRvAxN1D1skf5Pmy6TrjQ-pXXrn3DTo0d9rf5huY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIuQEUqyYlGaIa-y7NrncQJqm2fm8NHOTMjeqoHsrMaA&oe=69AD5D59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
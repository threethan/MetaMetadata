g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXmO2nik-T4Q7kNvwFO2-7y&_nc_oc=AdmuosdTfDEfpkw08AR6OflAuXyPV9uT41k7BH8vjwmfft0FB-E1bdGPXFH4UzQM8ss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzp4LcsPlkl4z5CCufFosNexagIJGkhxIchzYmIWp62ug&oe=69BD559D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpfCTGKJ0HYQ7kNvwGnZtid&_nc_oc=AdmglP86mS1SoRJ3SzhbhTmyLHzOE2Vaa10auIqzHIluRClUmGay93B43ZwKiQkwEOs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkYbDLZGxIz51wG6vghSLM0nE64fiJFX5sZjeNJw0F3g&oe=69BD5B34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YZSwIDbloYQ7kNvwHS9KOm&_nc_oc=Adnm5UxyN8LHBMZD8tuiypB1YiwZATDGo46GeJVsMo1nPnL1VuZMsw3l6PnlLg6uQYU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxf8pXMKT-EQtC-ZplrwtU3AM0fMzUMUhmBh2TBhPwKww&oe=69BD6053"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ovIk53hlN4Q7kNvwER7zp-&_nc_oc=AdnGVBeVidFvlwd3m0k898H79ZpCctOTD-mjVI0cDxxV_fFaOXTO4Jik2qQdl94eFvA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRuDeeaJicJ15A3RVAQkmRZUtkQiX9zecaQJdUMQewUQ&oe=69BD4B23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n_6k02lOgcQ7kNvwF-HZSI&_nc_oc=AdkNMlgtS2UWRMRfKfawpf3VFeXZnPC0GHiiuE1d5bwXKNPMd1WDffesZ-3uJVDoCqE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9djGSlGS3uDogDcFjLLkdAjN1f1X0Xc8YhdRPK6ohkg&oe=69BD2F59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
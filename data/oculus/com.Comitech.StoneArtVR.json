g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKe3tUS_DXMQ7kNvwGGLw0W&_nc_oc=Adnw5tCQ5ZWKf6Xm4DVz4MeHHAKutyLZMRbllAhdQ7GHEZM3TKcZ4icfMA-MvWGr2Nc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvtQFM9o4PP59SfNkvwH1ZGBwC_Pjkrv8dLWmL2V_HzsA&oe=69A98F1D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWGsVBpUn24Q7kNvwHA0fVJ&_nc_oc=Adl42gWgPCahM-euTZkziJjpxqSIp5wt4_jAYOT1VuNLtsExdbS7E_ByYCuuLYA6vHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvDL7rIVI41zAOV4axBUF8y7Hst5Iq7ebIeg9lljbnBeA&oe=69A994B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn1wDaLb-pUQ7kNvwGzk9-t&_nc_oc=Adl5hLNIycZ8CAHANYlG_1vK0m1orlJatmU2EdJfDBlxNZ_1h04OO8dzVr8rgql6ARs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuih_rx1WTI19ManQAd_9okIeWiI0t2l_5LG7GYpvqfWw&oe=69A96193"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMh4Cb1mFKwQ7kNvwF78H_p&_nc_oc=Adka_EiZXSdvDGTMoRpU2416y4PPPF53w7f11CXqCfVc9_NPzjT91WKi9pWk3idSz74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftFX4fU4CPPTxK9WLRRy8uegYYCWsfCa2pKvqOtT5qf1g&oe=69A984A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qD_LqMFGOYQ7kNvwFwX0DK&_nc_oc=AdmWGhNP0gqkNtYy6h2JOdDNjtZy3O92m2Xpn3UW9bDmfRqpsIAaRtc3GjjPBb5WxiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftJ0VqiytjouugQsxKSE_0ovLfFhFgtKC_eZN644Gln6g&oe=69A968D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
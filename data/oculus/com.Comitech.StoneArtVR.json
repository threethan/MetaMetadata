3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFBVZDZvCMcQ7kNvwGczZyC&_nc_oc=AdrJdQ20ftigrCngQNhQ68-SohLfmYzm8TGMPJB2TBqesPtqkGYK_pYXuOPETvTX9Xc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IGUZARBqXJwR3zTHUd-DfuLYC75p61GSaDbf_zbNkBg&oe=69F6061D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSmjd6GP0XgQ7kNvwEkS87F&_nc_oc=AdpsSsQzwEqPiRVIA_QqBZolCYDqNGZnFdAkUoDxLs7uWNYPporevSCh6gK5gaUiiJo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CHsCjt-kJ1d4omWG1RsjHjkGn_K-Ijc8n6JNHV0IT6w&oe=69F60BB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3ZhgYnBmUUQ7kNvwHksX-P&_nc_oc=AdrQgIX86Wz3QvJWnTr04pDs861ntyhPgOiDls7HgarrnCg1kNJneXFOM4GniwsEJvg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af151qbR6gWii3jWQBtHX374W8tGnDwc2cZJU6n608SPNA&oe=69F610D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v-1rSyDy5cQ7kNvwHcXX6G&_nc_oc=AdrxcYrPw4rokbaKixNHyqK3Hg0HN4hgTRURctbTrBVWu3lTrkWQk2MQ_hCAgCZV3l4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uRYXCoNwrJY5Hxw0KdhCfysjINVGUV3yYTM81PR2TUA&oe=69F5FBA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH-_hsDa8vMQ7kNvwFwQv1z&_nc_oc=AdqKl2wgat8CWenGIDDbxFM1_ULx7HjtpSNvX_-zh0SVjiJPzQibWOy66xXBVKWrSn4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uUDytejd3Jti7T84NDUY2ui6HV9Jjc37TurjLI261sA&oe=69F61819"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
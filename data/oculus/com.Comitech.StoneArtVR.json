3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09tHb4BhGV8Q7kNvwEa9YGn&_nc_oc=AdrZ-EOKtPb4ciSyOOc3CJD68mpye7xs9qVCkqk2lx2v2IckW4zshfHyANtyNj13ilY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DJHkRNdABqrnJYv_C9Z9meHvjPIC7rfqkx3QrwXDyrA&oe=6A0DC11D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlvZlrNBJ9MQ7kNvwGi2Ttv&_nc_oc=AdoiApk9t5nmY937EkmZ7Dy-Oa-RCciT_F5eQGzFQCNHKXLdTposEDOmvZzIwJKO9rA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IE13oYEHiFIOy8a_yIjDm6lBpe5-klKjA9l4-uJi6RA&oe=6A0DC6B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MGZBrV0qkkQ7kNvwGwbYVd&_nc_oc=AdqT08jbqbo1GPVtlWMDZKzWIMTn_Yd5rWzpMSZILg9Zf7T0Nmr5QcR4PP2BKq0i3DI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S4HX4PJCnCT15GVIbyFlby2sdsQkTTq1WXt49coIFug&oe=6A0DCBD3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6bkR2k_hrQQ7kNvwFpll1w&_nc_oc=Ado9eg-06Wci6PT96hvh2zQbR6WcYCfCeO6bilGym_WeeDqP2OOTb7BhCpBnr3sFfRE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h9ESe3bwz_L644PO0skHHCSKCynvGx91HErOtOSk-cg&oe=6A0DB6A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0sMvqBELLkQ7kNvwE4h-9M&_nc_oc=AdoeIC2x_0-TXnQJaRdLhTzL000Cdr00PIKvK_WaCqcrZa7PMCHz11iEvoQS8RpYWDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q4F2DAsN3no4AVUx7pSX_7ezBjaBYp0scuiZ9zX1pEw&oe=6A0DD319"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
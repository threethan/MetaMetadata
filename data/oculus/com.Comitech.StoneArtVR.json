3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKrN-E317D8Q7kNvwG4xF8C&_nc_oc=AdqPKddCkOJkzqLOulJCJb92H9wny4F6h0dOyf45c1ZdgsjFltJRtH7cue5Cow_YSKs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tpSDbpOCFrcWbJPDdIoi5mU-6aDCgEEIGxrrmmo8Zag&oe=6A10641D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPyuER4ha0IQ7kNvwHNcsW4&_nc_oc=AdpSuQb0rVR0Z5CEULYBC-NuPXCic6GY4CniRlcwjzRgK6rDPmEjJJVXJlXtdWrqVIo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TOASIpB0-BYKBIfbg22Q6lcQWrQ0uCD6l49NeHQQNcw&oe=6A1069B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MGZBrV0qkkQ7kNvwE8Uk6F&_nc_oc=Adre3Fci98ZpY5DZU4a2dTXT2kfDum9yfujA1O2JyDTWTMeVsTaIHYB20KQqeM-YvNY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cSaiJ8MnvcKtLe5raGjMaksMZlTmwRKoSbAax8rMWrw&oe=6A106ED3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6bkR2k_hrQQ7kNvwGEkosa&_nc_oc=AdoTP4yT9SGdoSYl5RpoY0wjP2HP8GmVtxN-HllZbZztyv48QkCW82iq1dQb15Pe3jc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5htlVMLDnW7uo7IiUK6Q65QFVLOMgFmZiGgewFvG659Q&oe=6A1059A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0sMvqBELLkQ7kNvwFk7HID&_nc_oc=AdouqcUy67yUr_4z89x1cUcvEDsgaG6P-YcqVb8DNg9ayKx7S0ltRIZMabMv4MMJV_c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I0xOpVkXJTDJ6EdnFyA0xqTf7W5PtfEEa5D3r1epRbA&oe=6A107619"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
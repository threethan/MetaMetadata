3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyIZehtRB2QQ7kNvwFERy3_&_nc_oc=AdqrmGQusDwn7L6N6ET-ey7BcBa03FvlQByjKEMcUP2NQp-OQD6mJpI83kUKcHQkbc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z0aW0bnL6Di4vpulxqUvNOWsv4vnkvlvvDUlVk8T57Q&oe=6A30081D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8jXPBGu9ooQ7kNvwHj-dhs&_nc_oc=AdpTG3k7FQPddRrtju8m8i0uahsd7j5XXW8remBGf_69-hrQogFHlhelg7yz4yFK3Nc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z0LmHn-NSgMgAQ79wqqVbaPTYji5Ryy9crXrEwnWK-A&oe=6A300DB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA5TVQ8_5pUQ7kNvwGQaE4a&_nc_oc=Adq-EU8ui4-1ONyy7tglk1h93CeNHOSGwXhepseo6A2h9ZWWnP9edUzdIgNbOOl9AXk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pBvLCoIGGUi-1qGuUTEgfQxPsX0Mm22yEvcpRZMRcZg&oe=6A3012D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo9Z-yTOwdsQ7kNvwHrym-f&_nc_oc=Ado_7_ZteezVSFjbTN8rhbLqJGYqL4jIVpP6fF-0EfDD7QHgvWeP14VRDLM2bEvjglo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uO-ilU1LVn6gzPa2SAcnWqTfa6qrtEGRcHJUTtnJYWA&oe=6A2FFDA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htFj7t5ewSAQ7kNvwEiZi2t&_nc_oc=AdoOxqGrm1ZKrc520nDQLdhAr1AIDPeE1AED00r5osyMBeM8xUE7AhKXDv0mfB3SuaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80TPH9O5KJh5WYHjNqz25BORqIFrwBQSu1dU90A_AEWg&oe=6A301A19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
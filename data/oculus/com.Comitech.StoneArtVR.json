3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAWwzKxnXx0Q7kNvwEPr0bw&_nc_oc=AdrKtuxoym7KxEMwkW1rBulBS5e2RCCUZZj0MXjW_9OjUeSRROfphgr6gPgvLgLdBco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eEhQcPG0k2m35lGVH7V0XzCOSrEbyEHhVtv_I4F1Kuw&oe=6A0B1E1D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcGeXMfZ8GoQ7kNvwGpxCJM&_nc_oc=Adpfja0V_S9uKtnhh9YmlI45kHhqJmc6Yn07YKC3baa9cNEawBn4F9LStMdLpKXCwbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ah-LImGRar5tj5jFp6JLmoLH6M8a54bZKmllmDPk4YA&oe=6A0B23B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEcfSxXODqoQ7kNvwG6Ztvs&_nc_oc=AdrZVV9nm1gX0lXMpSEHrUkft9OFjlAisqlEYVw7pcsaVpZNgAyhxae3gQtrD9o3mtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KTtmSzJgDAZDV_7205HEBV6uQE2Z19aizVCHK_Uf3Pg&oe=6A0B28D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVJ57IrhvakQ7kNvwELqDta&_nc_oc=AdojCPlV4s_vGZGImI_9HM0QwL0SyiUe9ZI8m-cVaUksIrbWOMD0kUP90i2cM7m9a_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WTG73d0WGlRpwV1AjnoE-liNYWjZmnnBh4eajfGfRKA&oe=6A0B13A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD808P7ejxMQ7kNvwFUtDnS&_nc_oc=Adp1iePug_cvE8vEIoHSSY7MRcJ9DCTaUrSwxmQh5K0rZ81b5bTm63MlqTanQuMDOR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GroxVAqDJfzBFeX9mrOhROkS4ymQ4LDsW-HmD7hSjsg&oe=6A0B3019"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
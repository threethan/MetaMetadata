3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw13qwK5mM8Q7kNvwF-7psg&_nc_oc=AdpkA6D58hGMevfK04YuNZrHFLVAk2Rzpq902Ymgh76OnLAb_eqo7gf40aPaB5idrsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxexXLGCjUOgKahUv5qtSktYohncy2onD-R4qX-ncGtg&oe=6A57951D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fV6dycOTVIAQ7kNvwEw3hf7&_nc_oc=Adq3784CHrKQNDrNoOUrJMh6jujXKIRvCpnfAt7ierXu6BGOvN8Qf61ya1FzpugkzWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsT3iyk9GP2wGQt02l4qThAXtjdhSb9t63qEbOnX9pfw&oe=6A579AB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77TN1nXEeOkQ7kNvwFFuqxB&_nc_oc=AdrxtWkqmLBT39djxsPHRRK9sOqkG1UXv0pAE68i19Z9DgISX6hSCjwjHE55F2NOsrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4SzuyhWlSNi6D_73n7cnrHkJiEq1ChXvhjHbp-Phrrw&oe=6A579FD3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5WSNhs6t-QQ7kNvwE5WDgg&_nc_oc=Adq7WK382yMJ6Wr_6ifmk0E2x_tEl8sNo8yoQcrqpg_JT6Afv-n80FPRJf2EOoQ2X-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiotbi6BlXyW5z6iGa0dd45JqUYWKRWyQifIiWXYTtdw&oe=6A578AA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ifAmw38oRIQ7kNvwHQuxps&_nc_oc=Adpy-JE3Bb_OeoBNaVpBS7nd-Nb_ILO_lFAPFo06VVBkonFNJjl5Uw2s-cBgHs-C9Ho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm807TXtiZbqr7J-5BFgtxuZRiM39hX1MIji8Sep7nAw&oe=6A576ED9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
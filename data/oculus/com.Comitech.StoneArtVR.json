g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n-ABN_JrwsQ7kNvwGeDWyj&_nc_oc=Adk0W0QZLoNE8kxZxDm3dFPFpDmqbUDG4h0YqRnqDAO3S-U45JabUXbqslYsVFTzxqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYRd6U4K6aqkFfN73UUjRh2f2LPO3BIDhfSxdaWLXPLQ&oe=69B56C9D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmIR44mlNtQQ7kNvwFI6D3a&_nc_oc=AdmU957-VPLF4GsAj_SlMPeuuM_Y0G-sgpzQYcVJLM0hr3VVp8DbFcdYhWyHnUVTH9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQQGPXaJ1AGmtpWBijYXCWLc_5nQEkEDRaOanMHCJbZw&oe=69B57234"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLUPteY0xnMQ7kNvwEdtj5a&_nc_oc=Adn1ZlHR_1S62wlpusSllm_nM3VLGGvN7gA5Y1RiuH_gGK5l_XwvU7g3sOdB1Z6Gig0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6cV6a2nEXjMHLeG_PHobYd_KvHPSjH8RGq9bEBWiEJQ&oe=69B53F13"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHQLV0AfccIQ7kNvwHNZsSp&_nc_oc=AdlKa35TBTYKIYZOy2a6IVaIg5BkOHV5TquSz207-SHvyRwy6LYgWUEzJucsfjBY7lo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwO8VhBJm3ikzXk9WStEd4Uow7eQ4NHIyRpgkqc85_E-Q&oe=69B56223"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7B5_MZ6VjIQ7kNvwFlbqyo&_nc_oc=AdmCn7GTDw71_liiN63wWdGqw9rUqOQgBn0S_V-bNvERp93QM7cmkpQ1V3o0ablx0Go&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFEsxC7Z9UDwPc4pXV_dCOmys08miVCjI1a3B-OAHjzA&oe=69B54659"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
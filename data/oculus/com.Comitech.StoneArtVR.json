3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6uDUQ96b1cQ7kNvwEH3Cf5&_nc_oc=AdrUndIwyQz4c8wUGLgwIBtVzFPtdSH1-IVgSYch47_sgZwf4wluzzrX1fcKg-eFuTM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B6zj6K_V9eWbCfFDXbRnCNdUP20Dv6l3S4eTc9BAK9A&oe=69E7859D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVdYRTkiex8Q7kNvwHlCS4I&_nc_oc=AdqOXdgtdLSbWN9U6f8RAs-e3yhxum4UFLiDBI-MZ1-6WRniT_0wZIxW5IwDvgp5i1g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0721W6KzRUT6aas1Q0_DN19Os94EG7oNKSkor19EmO0Q&oe=69E78B34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jAM1luaJS0Q7kNvwEBDjpb&_nc_oc=Adqtqvvx9x4bsMfiSnvlf17leLsu3mM-Z25nicOaZJr3wVl5EnRUITRHrLoqPJ4fxUE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-0POoMvc3vdK2qUF2m_o1QqYFNBG6ap0ebTMqcETyFw&oe=69E79053"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwE6neSLrv4Q7kNvwEi4QbZ&_nc_oc=Adrp-WisiIAS4IHU4GKTRj--ookHT25Z7-3m04KQcZZLDDGCwormtdIpDxj-pVqzZD4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XkIRK5dxFlZ8ZDeCJaIq9f_0B2rdU3p12d_lYtGQ7tA&oe=69E77B23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLyevVUyPCwQ7kNvwGsOElP&_nc_oc=AdrVx5HnW7uj0XNGupjRrjv9TaXoo8KOnvTji5ByQUTo20OI-VfuVMb68SHcGLJCeBw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-s9hf4PQZCcm7ESDQXLDe5E3OS2GIEJOS1bL8p4eS9A&oe=69E75F59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIOox3sQGWwQ7kNvwHDStWS&_nc_oc=AdrCAJIns8yY_6ds0QHwgDEbrjvJY5xo3DBKKNlItjulXCFtgqL8h3RCmylcHkIZLoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAbCDWM5VGb7j6T1u_CI46ZodV8guriT89k1uY3LQpFQ&oe=6A53A09D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKWv9_li9ZQQ7kNvwHsO6Qx&_nc_oc=AdqKuqArZHxgtJXC2mQsvO986sDnzWMXVNx-PPjNYKob7I6ZHZZXwdunBzFli9EnVZ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrHzGMtudvhojWXXpN2oIwTcyn-gtiXr_4sAxE4bECZA&oe=6A53A634"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbbhLF6iFMsQ7kNvwGBZu-6&_nc_oc=Adpx1KvgoHqJMh4KRkeaWbyhYM3T_JfOcNr6cQCFRhXEKu-VP9EQTpAZGyfMeGVZiWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoZrvwn60Ib2l2ROfUpcrD1V0alnTehgy_A1N_ZddHuw&oe=6A53AB53"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS6TUosM36YQ7kNvwH3m3fV&_nc_oc=AdoYsbsiexHgR2lkN4GfjK4teFgKsnvuifzA8EyM6ch7nTg83UlSoI9GIT8rMaUmyCs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB44B5NBwRkC2ISeupOh32zdvsovv4nI63lV80OSSZvVA&oe=6A539623"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdTUtwcKdZwQ7kNvwGFhsgc&_nc_oc=AdrLMjkV6No4TY1nlzncYdaJkhpheacUnhkoJfz7llc82nxNDGWi5GNivz8gQLVI2yA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMOzh6LFmiNJgjSjwPgzkHOJIIf2ttxDZJYEsVeImurA&oe=6A53B299"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
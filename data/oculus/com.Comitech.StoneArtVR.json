674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCgLtYuSfFcQ7kNvwGadSVS&_nc_oc=AdoNkDVqXloC0l8DaIlplPQMUrkRQeIL_cFcqm4ugcF-3wZIcvtFUw4XPN9ZOQL8PBY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHMkuOR6ofF6xZ_lzU_zmqdGITAQ8K4aJjYI8hqquDXA&oe=6A8D9823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_mod
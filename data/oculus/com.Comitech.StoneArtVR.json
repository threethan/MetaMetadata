3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09tHb4BhGV8Q7kNvwHwfnb5&_nc_oc=AdrMjzL9LCFJ6XhRCu1bsl_KIcOXbbpz13v7RZNwZKS5eIrcthOLIp0NnNRilCEmIwA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ylcs2kiGehD8TU3vaEzxEuGqHj-e0LMX1tpRrpv8f2w&oe=6A0C6F9D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlvZlrNBJ9MQ7kNvwGbe92i&_nc_oc=Ado-paGUNpXrelyklIVPTzEi-uCDF4mFP4UaRKFfxJZ_r5DIe6ZKeo8cf4C2C6MSM7Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s_rtc9T4dqk-oOcg4IYpSIsOBCQ7fKNt2i75_vK83VA&oe=6A0C7534"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEcfSxXODqoQ7kNvwGEdUIL&_nc_oc=AdqOBRSPEmcbvvA9w6LLwRIiQHpy5w2Fpp0uzOOfYYXzw9EDl5cPhZ5nDz8Md6_IRIQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e7fQTO4geZ88BuBwiSfPKle7iYwNcl6um3qZNYU8-kg&oe=6A0C7A53"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVJ57IrhvakQ7kNvwGRgOLQ&_nc_oc=AdoA32V2hq7EtK2PYVAKGshHZTrUDzGdWgV5nUeuTsEC2CTRmeqtcgZqisfEQ84YBpA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-XnWk3VLpFySX_qOhElSHK7oU9DMDW0bqQyWZ18K3xA&oe=6A0C6523"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD808P7ejxMQ7kNvwFXSXo4&_nc_oc=AdpRw3kXxmvKCj5ahtHtDa--Fswe8US_eRiZrap3lGqo2jGvJIKQhLnet_jjvdR01IE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uNAkkYGLLsgJn9A4tfxlTz0Cc_eixPUj4xyKTqY6CYQ&oe=6A0C8199"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
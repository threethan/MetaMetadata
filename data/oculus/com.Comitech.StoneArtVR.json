3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owvvsgC4JQwQ7kNvwH1EXkA&_nc_oc=AdohshWI0ISvsTkbU-qbofI53BxWPO7F2NE0ywYWN7rAzlmCrtguOTAqInKUmo6yqOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XFMT1UXDlF1PhotOpkkXGLXtulpVZrC7ELR-726abrg&oe=69D9051D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3pywn03M7kQ7kNvwGRyGk-&_nc_oc=AdpWfkAPB5LfEpO6hOB-EP9hh40dZlUzm9SQvuFvz5N3hqwgiC0VHZAljMiFSWWbxZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ln-58nycHQllbtBtSPbff1eKHSPD8AQz9g3QgFA-KxQ&oe=69D90AB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PutMARs4smcQ7kNvwFqxtni&_nc_oc=AdowNk7DxWobrkvDXdq_i7LK7XXByYmroYlvi01RnVRWfr2RR0zrF3CBAJokh2SusGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38nl5EgKDb_6_vA26nByCR_10dri-CkN-7-AggPx0RMw&oe=69D90FD3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg0mqIr--ioQ7kNvwHtXCV4&_nc_oc=AdpsPUB9cY5bZDtk3ox5gmSdi_2eb7LMk6nMHoksgefLYuuPYcOBfZkAiXS_8Ohb6sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qfy0U3HlHG6DUn8O1i0xvWfMLSPMyRkEHX-aEBBg8DA&oe=69D8FAA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM_PP1BkhzkQ7kNvwHWIIfP&_nc_oc=Ado_IQgqjLeVxQal4XjJzvlm-ukfkaoWoildH5kfqSJ1uXFMCroiWbSXIJLccPwO_bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DbeITJBYrVnYAU305UXFhm8dg0CBmRV3C-d7hguTRww&oe=69D8DED9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
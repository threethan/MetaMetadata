3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw13qwK5mM8Q7kNvwH8WBLP&_nc_oc=Adr_csiqLLkIhcQJ3N2O1hL8uwVY3ysr7SQ1oH8g7JiRsvA30Mn0yeriy2uGko8Fvdc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiGfHTzwfNRxqk4m32b8e9wcDuGTolPL2upAzZeBw6sw&oe=6A58E69D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fV6dycOTVIAQ7kNvwFXt5ZC&_nc_oc=AdqDAZf4Gly_UUqUN0wDzychPWsBbNqCNXyQOJm4nY1m_jpYtAOCYZTdUrczWy37kEw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWDuqYAY4aIIqnNP5p33DOoFVvmLwRrs9ir2HeLAYhog&oe=6A58EC34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3hkg_gIxaYQ7kNvwHDpPE6&_nc_oc=Adr0DGu4ZXmZSIA7JZzOGsvLhAYk-OXSwM7aua0MfUz2P6zA9x1HLO97_9Qx0g7ROKg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYUF1adl71otWM3l-tylYH-CRGE5mlBrcZaCcqUYveww&oe=6A58F153"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceMTKRXnFVkQ7kNvwERpBNT&_nc_oc=AdpE_FMUpR6vkfv1y7lHM9Q8A_YV5Eyf5kwqZdHtuC1P-aK015qXxGpiHoRjFCSEz4Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfzokNzmM_wmOxeE72wfXh0cKXa00fO3CFAWeJp8lenA&oe=6A58DC23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEkkAAwpjrgQ7kNvwG-sJ4F&_nc_oc=AdqJYdOxqcwkmX6ezDjtqybWGD7GAh48xCL5ijvzlEDlkPltkRzeA0YEeVM8_eei20U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg_YeCHIVBY3nQVxkugUOfa1HQes_pLsdMwpmFbzHk3g&oe=6A58C059"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
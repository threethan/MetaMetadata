3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6uDUQ96b1cQ7kNvwG0lM7i&_nc_oc=AdocWkyjudhT3jQvGVWBPEULGMEWH7uoNwJJypmomvR0ge0II41NkTWBfS-w9JRcjHo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tu4pvddsa2Thb6gkh7B0JXO7JpVjNJ6iczfxIAJurFg&oe=69E6341D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVdYRTkiex8Q7kNvwFCqtq_&_nc_oc=Adqzmmv6tMoocCO3-RgG6obP87eCBbPSDoRYw_S0j7LhRaSgMVNoDTK89NjQaiaV0p0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26GmoN-gBHo1-VZndaug2lZP70Ss3F8uCE0BYYhVEySA&oe=69E639B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jAM1luaJS0Q7kNvwGzKOT8&_nc_oc=AdrPIf7KmrDXlDdKgndf_MNR888t8I2f6HOJR8IEDE-YAJpX-6bfeKd7XvBM_Qj6iXo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w5VZAXgEiQzHqyQDq6h4gV0MIG_owDVMOEnNj3Dwy_Q&oe=69E63ED3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwE6neSLrv4Q7kNvwF1WAhb&_nc_oc=Adq2J75Iz8loL0vMWB5u84vFyDPwzI482Ch1a_5wkQDmM5dynixASmKKnx4OGTYBxpY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lcWtIwmUTMBNK39MR-CGOzC8i9aVsqONCx4ZWCqfJwQ&oe=69E629A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLyevVUyPCwQ7kNvwESyQFT&_nc_oc=Adpwpdyf2Utvua_5VWKHhkUZtn_aL_5xEXovmG4yd-gCN9NFRonKy6Fx1txHkmEBDAI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qTmSSsxO2oXhxRBUKC8Bqc-k-YSBTUz1GJH-l-1pONg&oe=69E64619"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
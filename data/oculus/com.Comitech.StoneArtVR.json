3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI3K2I1ad44Q7kNvwHdV3xY&_nc_oc=AdprMXWDqPFpGbouU2dv4kzQpmHTV3lsqddY7ze6YVuvi4xkYI0P5lSkGWQHHnx5DCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JDah5bfv9OciSiIXboDdEjQeOAU4bp7yqToPy-67iIA&oe=69DCF99D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bTrynp5dYQQ7kNvwEoDm6L&_nc_oc=AdrtOMqalSOZIPxMubRwBeyjBjm7m-QAcEIcxdNb_MtTQzXJbUKpYhM6QEmd2kyic_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pTyHyBSyoZv3z40L8EhsrVc1NdZBNn-cO8ocpylaW7g&oe=69DCFF34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N26xbYodZoQ7kNvwFffOwV&_nc_oc=AdqjoU_AD45t7RaJkhpfg2_rgPH14CVsH53k2Kzj0fdAOfO0FEtJap6m1tUdNUWRhCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hpv1ozdHTDNB1HAUhy-lO-RFs4kUfWB0eUPs9oJS-lA&oe=69DCCC13"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuyI4cHq6jgQ7kNvwFyb2-m&_nc_oc=AdpPeLwbLFG-JriVUBA3vnYA4ZPzuHyVHvmclTaFLmm1Z-wVtKKJBdCYBL0b3SuB218&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LDMxSYKlLqQsRrvMsWNFNq_BdDJ94XZXFZAZV7d0vlA&oe=69DCEF23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsau5vjPkLIQ7kNvwHXVNV4&_nc_oc=AdqVFl21dbNhvsVlwKQxmqq9o5lDZYejX5I9l8aFTBxLvKQrgVpQ7yLX_cEvxKMeioI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ujmqWQP6RAFWXTjJ4zeTJcb2LbSo2nJATofg7JFc6jg&oe=69DCD359"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
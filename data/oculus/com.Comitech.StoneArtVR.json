3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VAW61fnK4kQ7kNvwE6tfLg&_nc_oc=Ado2sv7PoBSSkCEgQqQ4MW_7IXaCA1rP8TEmj1bXyOWu0IfUNhiCd3zBbgUoVOtZo_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GgEG8QccfvVu7kiOQxJ2c_gA0k67G9DTrPNXA-epFhg&oe=69D5109D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Y5dvKt1m14Q7kNvwGV8Odb&_nc_oc=Adr2VjQH8lwo1yl6ksWz0v_rn6uy1WQtd5XCoFQRvr2fEOpRyhoimtOzeWz7sbKIRgY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wCJMhbbgiksOa2dPQLkfbiQHP1tztsBoAoTUl1qWpKQ&oe=69D51634"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1peB9b-dUUQ7kNvwFkikTx&_nc_oc=Ado7-qmdFENXdcwZs3L6So7qCD0_zI2FJJqrcsNwY0uvoa2o00J4WNnuZINwc96gbmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tF4vDty6nHo_PiTwsOR7da-ezlvo0fYOdwTIIYYk3Jw&oe=69D4E313"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2Av3Aw9l5gQ7kNvwEj4ERV&_nc_oc=Adrssrx1yWStYS1fBfq19gU_gLHdhApDMkteP54NBikdX46OyE_TnMqYb4ZF66vcA1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af304YS7WiB2MEnBLGKf8EveJVFCEuT1Zn7LwE4YCU7gtQ&oe=69D50623"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWLsmUioE70Q7kNvwGslveP&_nc_oc=AdphaKLaLWZ-E_amwgWZ1_uBX-0FBum8LbKVN9HQFgCqsybeApBUAolKNsn1rhVnAng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UE-C1hKKG2MogvFhyNl37zNfs3cZcJrDLvV45JJPIUQ&oe=69D4EA59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
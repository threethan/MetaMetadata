3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPchAcJNdVkQ7kNvwEOret6&_nc_oc=AdpOWr0I3RLRIodyBAByA2vcimhbAG4TffGvIIXtLP8cdr-t0sziwwWUI_ew3XJ_I2M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Qk1jnWxC8XToUnDkj6CXoCnlO5wy3a6RZ2cFL0KN_Yw&oe=69F3631D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMqU4JTFikAQ7kNvwE3GXDn&_nc_oc=AdoblTWzoVPNUYJF70l6UC0MzJNLguPvG7cdb-qf6z_M2FtJu7tOegXNRZ9itJ-w-BY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OkN0WPO9JKXwrZEIQaOLrRd95gCXheLyhGN_pnrhxuA&oe=69F368B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_ICEvmCYP0Q7kNvwGDi-i8&_nc_oc=Adqv-lcH5b3747Ce0nNMzxipeaEUvgoCZFVDLvwA9j7sKMU4UgFU__Y9Er2VRpLsztM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Fz9HZaHfUTJ7OIMe5C3ZJZwhu6ZP2XcqlOMPF1-9VNA&oe=69F36DD3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-Bx25cBE2wQ7kNvwE743Mj&_nc_oc=AdpvHTZ0pv6-FlvHSZxQC9j94AcuAocSX4kAK-LQ4qVnxSP0Y4p_HyOHi_qWMIP62Pw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0q5JBYbHFdSTeIcLWOcLPTNuqBZpopMRw8m_bRS007Pg&oe=69F358A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSPgHe-Cd1QQ7kNvwGCBoCa&_nc_oc=Adowug85vkH54ZYtIxFL-4J3yNwf0eqe6PfST78m-fxp6uQ3IB_imFVw-GwYionDQE4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lKOgCrvyj_7hdrZpukr8HZIeoMg20t8oR99HkPoQ2Hg&oe=69F37519"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
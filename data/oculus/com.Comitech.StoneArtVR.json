3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQPnkgIHA6wQ7kNvwHsKfTU&_nc_oc=AdqnvuDacx4ZxPPpgPxlidbhZpjtGx2miGsEICJFhMrEBXx9VZnootCZvKOCi9n2nSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PJZFg6qDL7bSEU9Ac3Gg63WUM1LehQoKTXifOmEkbCQ&oe=69EA289D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZo4vYgLcNgQ7kNvwEC4JuJ&_nc_oc=AdppnDY_WO_2x4A3U6VWuZ66Th8Mec7FtCt6Zi8jQSv51hn5X85-_3CW4vTnnx5BRoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EHYhP69JzAD-2mKAeoy-j9eK140wmn8ju8KwnPa_pfA&oe=69EA2E34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMnCqFWmxfQQ7kNvwGDKoL7&_nc_oc=Adqz8hldJmHgUctNQ0M4OP5PwFswmfhKm3JQEy3PSOmX5AeAx1Brc-O7nqFGqjMyLK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kNwMawb-yNmqsr_CelDUzeGwLxi4p8VkH0HT6rBwMKg&oe=69EA3353"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-3WbEXBpy4Q7kNvwFkdKR4&_nc_oc=Adpzc8cSzeWO4wE8XYA5nUZyXhqEsuRBzjtYySAgWr6nHOtUqksZi2QsLApJgRVDnu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dYRsxD5f8lHr5Nf1FUYq7FEbmkNzp8sMTabcTe1Vj7g&oe=69EA1E23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4s4Warb25gQ7kNvwFVRaxd&_nc_oc=Adr0n2olz5GCplZbL2e9KYMrYFb8ydIcsb9kv1j0qblIeixw_Viag8bVTkSMBdCKno8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lC2D0czGGGoTevfVpNz2vJKckEFhj4qYQXiXcPZ0LPQ&oe=69EA3A99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
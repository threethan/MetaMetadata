3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeZDz7QApSsQ7kNvwFuKrRl&_nc_oc=AdrbbUAkXw4X-IpLASlNRvr7e4_GUkiZ6WswUU7zM8aFVtDd5EGPUSQZ4zHkX2Gj4bM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU__EpZygMl8RZdXW_bjhyg7FbB6J0DCBKeJp4hb-mrw&oe=6A4BB79D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed7bDIj9_sEQ7kNvwE0WoAD&_nc_oc=AdpeyLR2sNJ3XaZnXWYdMg1TnSwh2pc9Cnp2G5zk2mLjPnlQOxbUP5ksyu1mmNnagxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlqJoBqUS7xo_52OE9MweTwShqibbDij3YJFVPdD-9TA&oe=6A4BBD34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6yMzm-SnPwQ7kNvwHi52Pw&_nc_oc=AdpjbBVsD_hAfXbqj3YnJYFhnseiMg23iuVGszFugfEPipyOg5en79tTyzgljbB4EWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRAdX6_cdPWVNEuagqGatIiLkCkjlM8vrFfPiHPhAppw&oe=6A4BC253"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_NqXVeJUjcQ7kNvwE_Uuam&_nc_oc=AdqgvnzCvk0rkjjAsukAvVWFt0eEo-H20KPDRvyV9s-sXIQ3V5H0FulQZxy4x0MKxwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8akc3FjL3jR-YJAguhmpX6l_A1nerXmOEuLdO1aA9zA&oe=6A4BAD23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXCQmc-SUuoQ7kNvwGOnY3x&_nc_oc=AdoXGA1UqWq9B36tcD3yEL65AWQ94rG3TgNwTmz8GGH02Bsg6pfYeA4veLBVIFYBJYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeCdSZ9aaF7fPE1GHo7FPjSb814mfQSqKPEEDJs5_81Q&oe=6A4BC999"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
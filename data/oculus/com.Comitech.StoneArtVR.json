3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB7laAcIQ-sQ7kNvwFDjxaf&_nc_oc=AdpBCTQtRo9BK6cy7HwtQurMDVLopgIc54tOXrZZf7O8wd-RTYFcafwGI9GPmn1ct1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PWjmcLPKz4V5I0pM_l9LeU4E8XcdO_8r4Usfe1S1yXg&oe=69E0EE1D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTi3tAz1DtwQ7kNvwG33h4G&_nc_oc=AdocjvkU-Sk9a0KDpmv4dQAO1f5dG18Al2nKiQ69abG-HeJZVrL05ObIke8eD86eKNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06eD4D4f8_Md2DRryKtNQ7gtWPBZMDbYI8ICedHzV1wQ&oe=69E0F3B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0AWoCgPk7IQ7kNvwHAthQs&_nc_oc=AdqxLZ5yTtlgftF-8KWEqAovfW2k73C8-vmj-FYFCORDiQs7aW9G9tHPiDQUTa-dTSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QDU1KKRLoHUFow3Py5VF1lzhKUwSmYuznLWU9UCVwAg&oe=69E0F8D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a98ryk8ORpEQ7kNvwEBmRwK&_nc_oc=AdrqyoLneypBUBG4PHH77f-w_WdCPupfOzAvptj2tYidcfgFUgG1IDz8BQ_km-3pDN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VH6ZO5AePqLR8pGNJXWSUZtNVxt113TOGxaKvy7VUFQ&oe=69E0E3A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2ftpNf7MEoQ7kNvwEQVtI2&_nc_oc=AdpVZfJ_4DdUksYuNGv4gl8yYp39CN6lPVpmRnuPnMLtXh-j-0ooQZQrsDRestFtBHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PO-metq7GnCsdRt5cwTynJgAvl2g4OZLNBPcVd5573A&oe=69E0C7D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlBxHIPI6qIQ7kNvwGDi94e&_nc_oc=AdpFcyWHan_Z2kA_lwGIW5yljsewjEWk8sVSG4NWtXfoxe4u04xwqODvsOrNElDkPrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf9kEhuSwl3RZzkwKN7EB1y_lSeasku5SQ1wG6T67IGA&oe=6A49149D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PXNe32wFs8Q7kNvwGqMr10&_nc_oc=AdqvArAZoFMNyhJ5z9u6im4jHeTn93Rbmmy3YnSDdFlud1Hu2IlUaFMqUddcLv-4AD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADqUydNSqftW8N8Mcrdnx_xaMp7LAGjBYdqt91zhgGgw&oe=6A491A34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6yMzm-SnPwQ7kNvwFnOEts&_nc_oc=AdrvJAEWAfxa4KVv9vOLhVEuiuZ9EDAnp-pVcpbJTk4rIReaNFN-zYUtx2v4YC3at0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8GVSxAq2Eft0aiS9J_lAfFogtjMa-V3ommH_GWJdL_Q&oe=6A491F53"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_NqXVeJUjcQ7kNvwF0E40h&_nc_oc=AdqW-raYkraBEQZI398RNaGnfFcO2jB-UJb3zZywgXKk8R58S3yi_385dW7YkqbT9GU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQColQxGoFBoJDAe8tTLCSswZ7T6Z2kzTFcAAuOjV6K7kw&oe=6A490A23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXCQmc-SUuoQ7kNvwEpTVX3&_nc_oc=Adq7ecmJQUH2OdIntVCyDxpDYs1lRPgOy0nBIP3_dtm7VtVw1sbNcwXzMHnkygFaMpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD88-TAYDLqzYWcmKhZmHLdehrFY2kdmHVH5c1OdhHMTQ&oe=6A492699"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CiZdKZw6MwQ7kNvwHYg1e6&_nc_oc=AdoCvfj8ugDDMy8hYKeGmfxwo4368Su2nta9VzCCSfHVtl4milwDH55WNmnz4clh0Ac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWwNY8JDLgDU7x9VGussmntAn_4ztr3Z8_a2ITNugydw&oe=69C14A1D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK1POusODnwQ7kNvwFxHnjM&_nc_oc=AdpgF-hnVrVnh4Q6RMf9PewfBSF48lTXdZ21xhUQcLRS718XFa-QM1MhsNEFL0MS4DI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8Ikx3XFvVAjhUPEhAi5Y9vlml0Ozis55jDftEuF6oWg&oe=69C14FB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbCFNyTlbaoQ7kNvwGshP0P&_nc_oc=AdpumFmO5rI_9h_1bYxZ2gSW2zh0B0LFsDlnZjUAAwQR3yoR1_g5RCxLp5hcRfl08Sg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afydbg_SfBZemC8MgeK6TYTL-U1W6qHZhilp1R8vpv8Odw&oe=69C11C93"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIxYlAFHoe0Q7kNvwHriBtp&_nc_oc=Adpk8S74phOpwA8dChxJa4UiRRQFk_fcCLHFPjbXJOLLM3xO_f8y4cO1DF9veofoCgc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWT1CWVCh4NYzFZDy_xEfd1BrwRje55Fy-f5nQi7G9IA&oe=69C13FA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAx59PUTfaYQ7kNvwE5vs6G&_nc_oc=AdrWiy0tIUMWwKBnmmUo2tX5_66WvxmxUdTn9wp6biyc8siJtWp2YbQEP_Yxsnqnptk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxx7GR1G3e-L5Qlhk6LeQ1x-rkGq-ZC9CnhaShresPCOQ&oe=69C123D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
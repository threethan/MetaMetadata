3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrwsu2PTBtkQ7kNvwFyoztf&_nc_oc=Adoy_MVrBluOa8F3TbmB4DYV_CWgvEXKqeSxSd-40WokRE6CDOMZE_EYmsssf_VOPPM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9tPAo1Bv8YEuGDxNqLco_IHdmzNzPO_asPIxTKM1gDw&oe=6A3E889D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLzEeJdu6-EQ7kNvwHUjKYe&_nc_oc=Ado6WDolj3_nRGhYxVnxmMiJRKXP5tyvwBAgBZwOeDvQyUs01jc2njgv_TbKYVX_rwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EDj7PclcLoAT6pSJZh60xp-1decuJH4e0lXNVOM9iPQ&oe=6A3E8E34"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IWAk57Nn1gQ7kNvwHtQcCj&_nc_oc=Adqfjk5sJrYte8aA7wXnlxHUeQwW_kjtqOfsqvkeAlQSQGFhY_4cFB9zGOoNsKwebXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NfOcXSveLUF-mzokHww9q5GK6si1ZRrQIYGFq2F9i0g&oe=6A3E9353"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFlttkQ68BoQ7kNvwGzCzGJ&_nc_oc=AdrCYep7vIrz5e7SRyICIGJ1O-OyK6XPs22sGQj8wwTrAjSxtul_eKoeW-f3Czg-5KM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vIE4ubmtq13YPZRo_EpTerKDQYCNhYkfGevsp2d7hBw&oe=6A3E7E23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7cjK2WoR3IQ7kNvwHaBPCf&_nc_oc=AdqX4NAhC0qA49yPE0GcltPtwjRRNxYeOSTwfCOIsa0ir3089iK1MOBCg9APJpdvNKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aYgxVD0jmLaCefcMhxf_-GiHRScFU7EGS35fK_m28hQ&oe=6A3E9A99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKA7ErMTiF0Q7kNvwE2ck7d&_nc_oc=AdqGGokdV9eMkS0N_J667TlZfuqLCSsamf-7XWgh7bfQBCd7mfMI1_Yd7G0EEY6EiS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxnb6P_6u_74Wxoj7RdPSM9UE7uwuwrIu6u-EfkBiBSSQ&oe=69C9331D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zumZPS7wWjgQ7kNvwEydZV8&_nc_oc=AdqIfuTMYTbetH51TT5F0LypN48D8u49qu6YsXUJr54ODMOA9v1sCYpJE8S5YT9X-2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwd-JTNcdABO-Ce27PhVMhlaVINmlziwOmFun4NBp_IPA&oe=69C938B4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsELDLJB96oQ7kNvwFGZzSM&_nc_oc=Adqv1YzmdKWegq_ZusjjbwMNp3agYxQYUXHnCzOuyI0UcmZlQogBDD1ivA0cvN-dyow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEY72kSyPgsC2GMe3b9rKVHBqnVSasaPf7L9u9PrQcwQ&oe=69C90593"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN0iPsxhGzYQ7kNvwE5A1qc&_nc_oc=Adpxrw_d98pusFZNNddog0bZLl1uZ_GbIfCyqxMTBdi0vWhjLSOtxzA6OKNKvwN9XgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxparpxK8n9HkyCJuzW9W9SdVt4JTYeEQ6m4hKaG-6jRA&oe=69C928A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0FRbsnk02sQ7kNvwFJSNUl&_nc_oc=Ado0jiz55fv_3-xIdcQLB5U9ec99_VCYrnFxl2vdhia0GmqIDfoyK6LKMwUrXOKz9Ng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8N5CvvXxKpq5Wjz-dm7jNrikyzqHmE8nlaF7zVolTIg&oe=69C90CD9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
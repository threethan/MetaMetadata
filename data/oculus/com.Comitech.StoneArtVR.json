g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Mwuk-V5nvEQ7kNvwENJDcj&_nc_oc=Adnfn3BlksdGSA2PYI2tYZJMVeK5juWU5aMY9sDvY8ukEBYhyurNSUNbyek7vA_ACaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvFWCeJ8PXC8si6U1N7jNDMI5Pk-FeQIsBze29QBkFR2w&oe=69A83D9D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-idVIjoNXAQ7kNvwEW3FYU&_nc_oc=AdluBr5LqlvQ3FJJ_2A3OtxIAio1ONeEjngowsT-u5EkXUpc5oXCxWltedldSAUmYEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu4_zIiZYofQnldfBmESDugXgzNndZI091vPxcwahCk2w&oe=69A80AF4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn1wDaLb-pUQ7kNvwGmdx0x&_nc_oc=AdkR5Ey_ekzJQcRXsBZn2Zg_ToLG8PY7hydh3tKcR_NKcR9leyVQLvj3TH6pm03sV38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5NIdGw2u1H3-vndBoeFebVwi3UrysxQaWYHHH8dVf5g&oe=69A81013"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMh4Cb1mFKwQ7kNvwElb1xz&_nc_oc=Adk4HphBjNgnMmfc9pvoQHE_1i2PfCmyLpO9ObXfjjfggX7mNud7JP_GxBuMUmKZToA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjoiIrmScIbjOFG1hcH42ivjiCdMBblW1hkY1vxcO9Hg&oe=69A83323"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qD_LqMFGOYQ7kNvwF5lk0e&_nc_oc=AdlHEwXIRMGm1tL91vAw00jgzI_DS32vXgRgeYOtyo6T-g1o9LPJuAuDmYop8_4TIW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvNC2badmxb4sjFFAH6UckDWF66KE8dG6Fh7q_nZpYS6g&oe=69A81759"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
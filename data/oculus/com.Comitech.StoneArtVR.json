3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlBxHIPI6qIQ7kNvwHbGAa8&_nc_oc=AdrmGb68hAoIJ7C29NcLdsigFcKHgilBeFKZHq9P2w7yCe2RsNjp3W1sA06r6Tdv9iQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6RFEZFl_1rnFT76U7L57-8zprXa4zZnpl9Ki9T3pA4g&oe=6A4A661D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PXNe32wFs8Q7kNvwG5JfVt&_nc_oc=AdoTw0FNRW8KOoiPy3c3n_4TDxsc0Gbm-TxagexY_Z5Hqhv7wMVoLVAMKo0sWHVC5rA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyIZPlttWrSo_SVVww4j2-Kq7UemH-pn_gbFFsrRbCZg&oe=6A4A6BB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6yMzm-SnPwQ7kNvwGrLWOt&_nc_oc=AdoXjBxCxpUDemebQJYPa4Bq5ulDAyvAdnH8gRAFsRAmLPvlh6lMwqVFp5Ky--vyGcw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfFGCNVBr5oQPkB5zksaRIN9Lex2C6UueevNZrkZPpsA&oe=6A4A70D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_NqXVeJUjcQ7kNvwG_eBbq&_nc_oc=AdpIzMajsKxRThdpaXObJyln5pq5LTXBP8I7HM2Ho03h5YRvUfsvuGtCXO_4dzyENpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt7RtXTfgkHf4GndyelgUFGvithjvf-K6FQrS-p-dFyQ&oe=6A4A5BA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXCQmc-SUuoQ7kNvwEzNr4R&_nc_oc=AdqBAyBeCxAVZd5KaQkBzVcfDtqLrPZ8Ajk5FysjdhUCjgAjOgnYtIKya6cPrJEE58k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbS9Z19X60n-fbG1cGCBxyJ3HJfJkU2ioNXYqJouqWfA&oe=6A4A7819"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
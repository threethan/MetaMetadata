_1279208523415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=316nldMJUEYQ7kNvwHrZ0BE&_nc_oc=AdqBmQO6qh9eCJ1xz_-6cKOeip0uDTFoTAvi98XfpmHfpkGbm0gYv_3b4Z1PLtA-22o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g8WfWpg4ebt9iiL1cMh7zdOdbSEO6tqf4KSAZ7MxHxw&oe=6A22D91D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUqvAqWK6-sQ7kNvwELXjXF&_nc_oc=AdrUYEa2t6uOnWfwAoPpwbcUIJxDP1BBcFOfoyEPEv7eKj-YqFzizI_zNPg9D1eTsS4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sf2Q6i1tQ_TkBbuw96vUumWihCUIjt9m8WFwjowm3Vw&oe=6A22DEB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfH92gwhRvcQ7kNvwG6QzNW&_nc_oc=AdpsAD4H0ecQkVM_OJeQZL9lri3ymLmscdwdZTzOZ3GkTNsO1iFVayiupz3grARQciA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8In3fd_RTu9M6gIUt1suxDzlbq3r62L8R3RQfJ1Q_ErQ&oe=6A22E3D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftLBmEF6x9UQ7kNvwFmy3iC&_nc_oc=AdrdNDIkFaFh_jDwKjqBkycV4tzRt4TEuQcxnQnqdbe8xQdiBFXVRMrBE-ykiovaPnI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yAjwNz2LzJF-n-DA0jrIKv8q0RhKGMqsBLgQEHSfmMg&oe=6A22CEA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRt7PIJg59gQ7kNvwGGWaS4&_nc_oc=AdrLMbJ4nQeWRE0b2KsU2P2oYmdu8Ig_JiMCi_0KILNQAR-wqPEBQYsBnj0TNaE9odU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mfFz2YVCr-QgB0teS8elGBaRRlp8wT18tL-PGclw-PA&oe=6A22EB19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "cont
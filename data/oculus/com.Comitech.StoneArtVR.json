3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWuAJIBvIvEQ7kNvwEEY5P4&_nc_oc=Ado8dgE8vtD-StGKNGX2wvn0uzRPUc60OjHPp6N75EPjUnTX6ZcH8cdSWGiR-qu3yEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YBc0EAHNfVMibFbKfU22jBKftPNLQfQp-6xC1VqIAVA&oe=69EF6E9D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRwqxkLMmEwQ7kNvwGfl6-G&_nc_oc=Adq-pPdNaqDN5e2EHdkReBduV8-5ZRxjwpDkUz-k8g-CmgsK9KCBeSUxbzWIC0QKlQY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3P_dHZreSXbXSAdUl-vtFoapBXec5PY5V5dutlgbs5fA&oe=69EF7434"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3nlgojLOm0Q7kNvwErlHnm&_nc_oc=AdqYZbt5V66N0vymZRcnETwEIKuIfvDaFqTNB66s7fsHQXQJyFEz4_LqThD39xs9mB0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GOOlzba7Emc_vt2FpkhUTJH-Hjb31Yy1FwwKXGiepPA&oe=69EF7953"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFXEFHS_RHgQ7kNvwEX8ZTs&_nc_oc=AdoqNHHi5je_2Wcbvm3_BvxIdYFdU6OSa5kR3BdbowOfE1oaZ2siBpZHiYCcSu107H8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fWIN_NiO6Mnrn_KYyjDQ-0VC-ghyP3fjtyNI6lLJP3Q&oe=69EF6423"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXDLuxSdnP4Q7kNvwFSwvyK&_nc_oc=AdpBbt4AzxJBzZtCl2FMWWPzvE-jmHGaFm9WMwQbR11ILUfQRPz9UypEGOlsO8PFr10&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2azjsnXTtpjvfCfiEfBFMwbZ9ZlGEipVoABsh6mFQPvg&oe=69EF4859"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
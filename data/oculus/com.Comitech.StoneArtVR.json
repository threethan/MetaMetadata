16593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKe3tUS_DXMQ7kNvwF6DJtv&_nc_oc=Adm1gjl2-dZO8YhXSAqiWMq55nAmiNkp5jv-w44_HJ8x8D4MQ0Obv7u1fBlxwwgz9Go&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaFF8y6tkKAseXl0JJbY1P1Wh5Nrm1f1wolbLRuRe0qg&oe=69AAE09D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWGsVBpUn24Q7kNvwFKCXBB&_nc_oc=AdmAytaxwuQ8IUsRRqBqXh6jz_cBomI-C6XTwM426NeKFKsoNX57qGiJqGAnuRoGv0A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJBGC5R9NkHDCH_24oJEQG5dYapSNkWH2e8H-zotwUtg&oe=69AAE634"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGosLCEGrFsQ7kNvwE_8udi&_nc_oc=AdmxaOsIagMxvr4SnzmeombtEJG1TWguF0OWyxRwq0HzeKLby9kYu_fizX-CB8p1unY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2gm7YRilLoV4K6UDBF45lXmYJzCIx3HgklxmagAf8mw&oe=69AAB313"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNMB7ki1q1wQ7kNvwHuSWrH&_nc_oc=Admn1KpxpChNU9KTXPEpu_nf0kUMOySMbiMVaQUv0FEtU_GaVYZFHjqz8psrMvjX5Wc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyewzxKst8CSqpH5iBKn8GucgROn7c1LaVkr1LrTkGQjQ&oe=69AAD623"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0InfvpVy7McQ7kNvwFFKPph&_nc_oc=AdmdnX37i7DVcynMaXEBRIlDpWs40_grEozDw-a4XlRCoHNDrRqgld6IchYHV0PyRCc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_stuvWxw6Fn9sjW_SZitfvfPc1kG4bLlC7KJDqwW2kQ&oe=69AABA59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "
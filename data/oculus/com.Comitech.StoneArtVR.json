3415076_8728018630193916593_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKrN-E317D8Q7kNvwFgWkJ8&_nc_oc=AdoFNrOB_9_7pl5Q-r52prSIrzgl1LSR27HsYIcgVFotf3qJqfBBdnhHNTIB0uIMeZM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66B9EzyOkkuW8A_lZ4AlFnBMD8FiO7mRsHkh1DoIATKQ&oe=6A13071D"}, {"file_name": "47crop.png", "id": "599914449124544", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031631_599914452457877_6851070833779568458_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPyuER4ha0IQ7kNvwEEe-tS&_nc_oc=AdrzyZiaJthcYBYskKHKIK5GY81UIb1qmgk6b2CU7OTD0FzjD06zpfQSDSFLEklqyJY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oIElo4SR-8DH-7VqKbVPdDWghK5mXA-jDIZD96hb5mQ&oe=6A130CB4"}, {"file_name": "48crop.png", "id": "1228911325079163", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75462959_1228911328412496_5579049921468923839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyLpAtHzROQQ7kNvwHUfp2-&_nc_oc=AdpaMjGvdvKL2h0ahhCgc5GW0q6rGE0ccQ0u_07EVZ8JUf70-Qg4mR4blEt-DFfbGYE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65XlP2fVCawY4AmjnW5V-O4XS1XHhzPZgoI0AWXQkIOw&oe=6A1311D3"}, {"file_name": "56crop (1).png", "id": "882305357442087", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974634_882305364108753_1044507674213928199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJYtyCuunjAQ7kNvwEdQj3n&_nc_oc=AdrPvbbNc2v2Y3-VmBhI8679_ujWBg6Q3bdht1QwM4izeBV3uMjxq4GEvpVZhgFY4eU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yoly2ldS4DtNN8EMpDimcvy10pLhoxJcOBOa0B5mdHA&oe=6A12FCA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stone Art VR", "keywords": [], "long_description": "Epirus and especially the area of Konitsa is famous for the skillful bridge constructions that remain unchanged over time and remind us of the greatness of man. In perfect combination with the environment, the Konitsio bridges offer the visitor amazing images that remain deeply etched in the memory. Of these, the bridge of Konitsa stands out, the highest single arch in the Balkans with dimensions of 20m. height and 40m. wide, built in 1870 by the master craftsman Ziogas Frontzos from Pyrsogianni, the bridge of Klidonia, Drosopigi-Zermas, Kastaniana, Topolitsa, etc", "short_description": "Become a professional craftsman too.\n\nJoin the pieces to build a stone bridge. But be careful! If you make a mistake, the bridge will collapse."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8732319073511379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984441_930720701837008_6051054396238674232_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEOyjhUhfQEQ7kNvwFpHCkE&_nc_oc=AdoKiZG3KfL-YTBPLItvylhxIs7vlUmiN2QvnhzPK0nbLsRMJbwZfJFHYwbYMVyCKyE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TexASMmgXMOdPG3cd5Nza1jZnbZIf-d_udBfG6NtJZg&oe=6A131919"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Art VR", "platform": "ANDROID_6DOF", "context_category": {
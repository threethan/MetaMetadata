058_4557298130576498943_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icOOCg9IpMEQ7kNvwEZmu4k&_nc_oc=AdlV94OGDpzOU7PSsAUtlSyLn-o_yXKw9IKP5nbh18yQhUfGX-XlazYsnxPOw7njW_o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZnDaE8rdpeS4xlhZp9UGoHg8B33pe_3uha-lwE25ShA&oe=69AACAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen03.png", "id": "284620004208715", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57575362_284620007542048_2635374427961839480_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VUkF0AOgSMQ7kNvwEwMA0U&_nc_oc=AdnYHP5XfEEmRmp0nveRuv7U4eD0yX7zapgcpig_VCicFYsrcShEWFZbAkwgMd-5l5U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afzcjun1nj-hh9Mi_CRvSm62Sw5udYV7TWfhWnyuQVxhcQ&oe=69AAE1A8"}, "display_name": "TAROTS", "keywords": [], "long_description": "The earliest references to tarot all date to the 1440s and 1450s and fall within the quadrilateral defined by the northern cities of Venice, Milan, Florence, and Urbino.The first tarot card decks were created in Italy in the 1430s. Regular playing cards had become popular in Europe in the preceding half-century, which led to wealthy families commissioning customized decks from artists.Tarot decks were invented in Italy in the 1430s by adding to the existing four-suited pack a fifth suit of 21 specially illustrated cards called trionfi (\u201ctriumphs\u201d) and an odd card called il matto (\u201cthe fool\u201d).", "short_description": "The first tarot game in the metaverse"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.enigmatime.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ENIGMATIME", "support_website_url": null, "website_url": "http://www.enigmatime.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_RE
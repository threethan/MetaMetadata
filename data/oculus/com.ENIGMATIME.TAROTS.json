decks from artists.Tarot decks were invented in Italy in the 1430s by adding to the existing four-suited pack a fifth suit of 21 specially illustrated cards called trionfi (\u201ctriumphs\u201d) and an odd card called il matto (\u201cthe fool\u201d).", "short_description": "The first tarot game in the metaverse"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.enigmatime.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ENIGMATIME", "support_website_url": null, "website_url": "http://www.enigmatime.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "839063407582220"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6681692095283879", "version": "0.1.0"}, "id": "303743822175581", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6402087133244378", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6681692095283879"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "303743822175581"}
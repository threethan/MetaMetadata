6V9CxXmmNLZAiz48vqsbu2UCBQ&oe=69A4332D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen03.png", "id": "284620004208715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575362_284620007542048_2635374427961839480_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebODjb_mSywQ7kNvwEC-bwm&_nc_oc=AdndcCBz1FZyKv0liO4CRPwLnd7tJZGpPph-De6slA_mififyRX6M-ZftyuMgTAXiCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsljEW1jIXm8BI64Goh5wLqiMwH0IKXfdq67uQSjXDbzQ&oe=69A44A28"}, "display_name": "TAROTS", "keywords": [], "long_description": "The earliest references to tarot all date to the 1440s and 1450s and fall within the quadrilateral defined by the northern cities of Venice, Milan, Florence, and Urbino.The first tarot card decks were created in Italy in the 1430s. Regular playing cards had become popular in Europe in the preceding half-century, which led to wealthy families commissioning customized decks from artists.Tarot decks were invented in Italy in the 1430s by adding to the existing four-suited pack a fifth suit of 21 specially illustrated cards called trionfi (\u201ctriumphs\u201d) and an odd card called il matto (\u201cthe fool\u201d).", "short_description": "The first tarot game in the metaverse"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.enigmatime.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ENIGMATIME", "support_website_url": null, "website_url": "http://www.enigmatime.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
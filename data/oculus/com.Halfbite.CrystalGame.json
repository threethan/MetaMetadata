rystal hunting into a high-risk adventure where every decision matters.", "short_description": "Crystal Game is a cave-exploration adventure where you play as a monkey collecting glowing crystals to sell for profit \u2014 all while something dangerous lurks deep in the tunnels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/crystal-game/home", "developer_terms_of_service_url": null, "publisher_name": "Shiva", "support_website_url": null, "website_url": "https://sites.google.com/view/crystal-game/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25539757258987128"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491818852_4448185935410117_3598088527280810839_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl_DKh_TGHwQ7kNvwHK1i13&_nc_oc=AdoFtoApA5Wt_CJN9Xs-HeM01Z7Sc_dlm1rakGol9-b4bgTSfSxlROGHDlL6c-n1LBY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfSDWKS1QOHVuyTpd3xyM14DurhuHBe_wbYkzypN0foA&oe=69C7C1B3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crystal Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name
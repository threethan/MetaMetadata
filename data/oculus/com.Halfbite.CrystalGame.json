la", "Lethal", "Monke", "FMH"], "long_description": "Crystal Game puts you in the role of a monkey exploring a dark, winding cave filled with valuable crystals. Your goal is simple: venture into the depths, collect as many crystals as you can, and bring them back to sell. The deeper you go, the more valuable \u2014 and dangerous \u2014 the cave becomes.\n\nBut you\u2019re not alone. A mysterious monster roams the cave tunnels, forcing you to stay alert and think carefully about how long you\u2019re willing to risk staying underground. Every trip is a balance between greed and survival. Push too far, and you may not make it back.\n\nWith tense exploration, simple mechanics, and an ever-present threat, Crystal Game turns crystal hunting into a high-risk adventure where every decision matters.", "short_description": "Crystal Game is a cave-exploration adventure where you play as a monkey collecting glowing crystals to sell for profit \u2014 all while something dangerous lurks deep in the tunnels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/crystal-game/home", "developer_terms_of_service_url": null, "publisher_name": "Shiva", "support_website_url": null, "website_url": "https://sites.google.com/view/crystal-game/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25539757258987128"}}]}, "schedul
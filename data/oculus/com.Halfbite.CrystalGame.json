2025-12-24 220826.png", "id": "750108721474873", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499294659_750108724808206_8170572892340606463_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KTUkjcV57sQ7kNvwFjvjnE&_nc_oc=Adr-vY6UKoG2dK2iyFRnYpteZtccNqb_vbmICMZAO1vAp6rch3zELvpn2fzGYTy8ZLk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyu1SP4Z5ZjJk-JBIinSl2blIAv5O0TrBjMz3cWMGDog&oe=6B084BA4"}, {"file_name": "Screenshot 2025-12-24 220820.png", "id": "888192807142224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499293658_888192810475557_4812629844720795323_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehvRCQ3raqcQ7kNvwHppz5_&_nc_oc=AdpKWslWhdMMQpikJlK3Q7F3ko-ythflLZz2vzI16Bkjq3X45qPPaxdfAJAfcIuSSAM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9XM_LlINujNrAx3r8G0p0t4xlJJMxfzy7UJc9BwgSWg&oe=6B08545C"}, {"file_name": "Screenshot 2025-12-24 220752.png", "id": "2596957070684231", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821178_2596957074017564_1602130208841824029_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A74YyYYzScwQ7kNvwFKF19V&_nc_oc=Adq4uLxfrmh7kZHg-gwL95F8ix3whTgpU3QQkufgT0tGSu7PcxcJyVZjj179EKHcBGw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVMy-xAUDoGZ0VqnFCY6-IjRJEmNepa8umjUuSH3myVA&oe=6B087069"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crystal Game", "keywords": ["Gorilla", "Lethal", "Monke", "FMH"], "long_description": "Crystal Game puts you in the role of a monkey exploring a dark, winding cave filled with valuable crystals. Your goal is simple: venture into the depths, collect as many crystals as you can, and bring them back to sell. The deeper you go, the more valuable \u2014 and dangerous \u2014 the cave becomes.\n\nBut you\u2019re not alone. A mysterious monster roams the cave tunnels, forcing you to stay alert and think carefully about how long you\u2019re willing to risk staying underground. Every trip is a balance between greed and survival. Push too far, and you may not make it back.\n\nWith tense exploration, simple mechanics, and an ever-present threat, Crystal Game turns crystal hunting into a high-risk adventure where every decision matters.", "short_description": "Crystal Game is a cave-exploration adventure where you play as a monkey collecting glowing crystals to sell for profit \u2014 all while something dangerous lurks deep in the tunnels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/crystal-game/home", "developer_terms_of_service_url": null, "publisher_name": "Shiva", "support_website_url": null, "website_url": "https://sites.google.com/view/crystal-game/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25539757258987128"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491818852_4448185935410117_3598088527280810839_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReNiOstnOGoQ7kNvwHcgF5V&_nc_oc=Ado0x16HLpJ6GcFr4SyKzo3Ci8jkwYGvykDEcU2x5nPXwR6QH-76LwIVV2DNcM3gLJI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThRBfkmr-WtB1X1v2pLg_HtnRV_xqV3aMWgXv_u-5b5Q&oe=6B085673"}, "is
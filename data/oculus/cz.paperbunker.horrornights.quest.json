.cz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Paper Bunker", "support_website_url": null, "website_url": "http://paperbunker.cz/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "ACTION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "665306167991276"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "789384401938694"}, {"status": "PUBLISHED", "id": "333002164943714"}]}, "baseline_offer": {"id": "333002164943714"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1622572260, "status": "PUBLISHED", "id": "789384401938694"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3982266618518533", "version": "0.1"}, "id": "1235213150208482", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3690488997696298", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3982266618518533"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1235213150208482"}]}, "change_log": null, "created_date": 1622229504, "id": "3982266618518533", "version": "0.1", "version_code": 11, "release_status": "RELEASED", "status": "A
illa Tag fan game (NOT A COPY) made by Otisdub. It has many features, including:\n\n1. Three maps!\n2. Two cosmetics!\n3. A Rec Room remake! ^OtisdubTag by Stungspore\n\nAnd more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://otisdub-tag.otisdub.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Otisclub", "support_website_url": "https://otisdub-tag.otisdub.com/support", "website_url": "https://otisdub-tag.otisdub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8358963810870313"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1703635954110130"}, {"status": "PUBLISHED", "id": "1868904080559093"}, {"status": "PUBLISHED", "id": "8445075308931183"}]}, "baseline_offer": {"id": "1703635954110130"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783013940, "status": "PUBLISHED", "id": "1703635954110130"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8935428733223815", "version": "1.7.3"}, "id": "1116071530067000", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": 
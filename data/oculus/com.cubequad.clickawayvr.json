pb1DXxJOU8pHAJQ-kRMGVAAHn8_gHUT6TFkv2cv0g&oe=6A11BA9F"}, {"file_name": "screenshot4.png", "id": "2463466914017587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820478_2463466920684253_8421467435587303831_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWwbgyiiznEQ7kNvwG_1ihV&_nc_oc=Adoj5CMSLqH2oCZVhNBP6047COMLXARPYpzU6x-io_RXzar_fxKqyQOp93e678Gqm_Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HQ0ZDFRR4o6IcxVWX0A_80_NI1P9Bcg_I4Xv0q1uSjw&oe=6A11B48D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "whishlist_now_banner.png", "id": "1260628585424861", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824618_1260628588758194_1445043987954110363_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAM9_H9MWXEQ7kNvwE4Qo5p&_nc_oc=Adoaj_53AFGOdr81SYh2iB-LY-gLxLG2YVfq2fURU-gHIKm1QRYUfvA4aGH9nAv7t-Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XjEKQ6YzzIoWZdA2y2tC2wYSaDwUbS5OY5TwILNfFLA&oe=6A11AA4B"}, "display_name": "Tap Away VR", "keywords": ["puzzle", "block", "asmr", "casual", "simple"], "long_description": "\ud83d\ude35\u200d\ud83d\udcab Tired of complicated VR games that make your head spin? This game is as simple as it gets! Just tap on blocks in the correct order to move them and clear the puzzle. No complex mechanics \u2014 just pure, relaxing fun! \u2728\n\n- \ud83e\udd13 **The Best Game to Get Familiar with VR** \u2013 Perfect for beginners and experienced players alike!\n- \ud83e\udde9 **Over 100 Unique Puzzles** \u2013 Easy to pick up, yet satisfying to solve.\n- \u270b\ud83c\udfae **Simple & Accessible** \u2013 Play effortlessly using your VR controller or even just your hands!\n- \ud83d\udca5 **Powerful Weapons** \u2013 Smash through tricky puzzles with special tools. \ud83d\udd28\ud83d\ude80\n- \ud83c\udfd6\ufe0f **Relaxing & Engaging** \u2013 A stress-free experience designed for everyone.\n\nNo frustration - just intuitive gameplay that anyone can enjoy. Whether you\u2019re new to VR or just looking for a fun, casual experience, this is the perfect game to start with. Put on your headset and start tapping your way to victory! \ud83c\udfc6", "short_description": "Tap on blocks in the correct order to move them and clear the puzzle in this relaxing game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cubequad.net/policy/", "developer_terms_of_service_url": null, "publisher_name": "Cubequad", "support_website_url": null, "website_url": "https://cubequad.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29967201502894415"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "34874100042189193"}, {"status": "PUBLISHED", "id": "1836854024376128"}, {"status": "PUBLISHED", "id": "1508645586956873"}, {"status": "PUBLISHED", "id": "685997614447703"}, {"status": "PUBLISHED", "id": "1634682063892130"}]}, "baseline_offer": {"id": "1634682063892130"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "34874100042189193"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30941109758836913", "version": "0.1.7"}, "id": "557872824074923", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes
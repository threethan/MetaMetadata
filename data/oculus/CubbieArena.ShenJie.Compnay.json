_ohc=ZgTG06KYwDAQ7kNvwEM-AIv&_nc_oc=Ado53_3F1uXe6DesgiMGhJpIJCUF7Rmf_sXWoTEL8N_uUzIozdkSSLK43Fh-4ifCOII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dwou9jXDPiIewhKPBJJRWQh1mGsYvqflJmePe_cSDNA&oe=6A1ED280"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3kVTaA6oUIQ7kNvwHDDeMm&_nc_oc=Adr5sn0xXDzPyW9pXtJaLzwZdxQheXfjeNYqvJz1s8H0ileW1GNm6GSxZ8nhNQZQ6_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fcw4cvBGhRz8ifRyr4sA4v0lKIBm9wIN3jmk0dnI_Gg&oe=6A1EF3AB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSPKa1AWVaMQ7kNvwFVESjy&_nc_oc=AdrY4skJNS6jelFE1w5rJCdec25ycPYl3E6H-oLFLZwX4L-UtbNb3fHvyQA4vBIJeVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M5GEo7w8j_0zve_zyH9KRh54ETjNg_enzFo977sUbag&oe=6A1EDF76"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJF53JYxmDkQ7kNvwEweXtG&_nc_oc=AdpoF-4bKGiaNnuLaHGgpAG_s34PN_f423cguR03bs5Ncp3OWINJ3ik0skUtcU58CNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5626r6S7bGkuUpTB1XWXAHMRDqYAU47-EbhKf8pEvGrw&oe=6A1ED3DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIH9_hXIGMIQ7kNvwHCaLtH&_nc_oc=Adp6sHDm58Fjrk_SMvyTFCIkoK5FsWyXYxHzGEJUEIR_hRvtTXuKvbdJGT08kaSsgeE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XjI_nZnddtqgThjGnYDiMz8ESC6ZAjE0lelXJ6tm-dw&oe=6A1EED02"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
_ohc=xe4M9wGOeagQ7kNvwH2BRjn&_nc_oc=AdrFqaqG3svAz-b1_ysk-6hIWLOZHf4xhZbBgGUY-psPVMuIK2gwhpI5fcxsMFtPzGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0thNVISz6j-HrTdyHlRu8bN8RVbBmE2u3SLiu2gVdAsg&oe=69D3AD00"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsC61JBHIiQQ7kNvwG1NJWt&_nc_oc=AdpNAS9fyggLvP39MHh95h5H-QAP71TaRo1Rd0lskhrAfwcnVDqNc007RIgmc0r0wBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X51uI2pa2HIwfLUkA5_45N1TvP9KyMk21NFroARcM8A&oe=69D395EB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBt_ZYv66ZAQ7kNvwFONMef&_nc_oc=AdoPTyEIPM7nm0OqFfzTd-B4H8j2hjplLC1kAlKiqMTz6oXPE6dhNHj-JTKMOzr_PHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2De4Go2xPfdRgUuc2pURwdtn3ioFhK3odKHudB6kcjWg&oe=69D3B9F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dRS-YnjuP4Q7kNvwEGgldD&_nc_oc=AdpGvme76i9y2HL7I13CnEiWTRozZsjt_e-SdLAPM9iEie4J4-sfvDcFnFeXpA83t4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34G-LFV2h9ItkCMw9YO4LcEzpPu2AD58nWrIu6-AmyzA&oe=69D3AE5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UruDvIrMgbcQ7kNvwH2kiNM&_nc_oc=AdpixDzup3pzKt-L_7SjacsEsoRlcJMyWqJsmIoz4M6xXSZnmFISK67LRAb14NF7rQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21i_BnnHMYK4sjV7RetCAjbVKahnbcwU85VBkhPHD-8g&oe=69D3C782"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
_ohc=EetvrgGgZEkQ7kNvwEn58qr&_nc_oc=Adrm4VyJGStW2qEPob-isAt2kO5LOtTKxOI0v6PWnCjt01bRWhkmSYS2VeglwkR0A20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUA44zW2KrzPkV2XD2ulIHvB4SaXsL574lH1CaSVEsUw&oe=6AB91200"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB9hlnJMg80Q7kNvwGKRqg6&_nc_oc=AdpR00wFylWrp508wy08GDswL4FchxjMx3RI1KfUNSNni3rxhwbBIpee2retw5xMc6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUfEaH99MEFuWk4mxGpA1_ZheIrto89_vBdGzY1hvnEA&oe=6AB9332B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGaAfe5Qec4Q7kNvwFU2PM1&_nc_oc=AdpuorCjcfoG_7RO4fdE1oPU0x9UtWIONwKjbTzdwQKo-mBdwa576vTZg8fdFeQtHTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-W4uG6E4i4IFKz8Qlnkppu7WKbPbd8uYN-ebfiyIJkA&oe=6AB91EF6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvQbh8MzQfgQ7kNvwFoU8gm&_nc_oc=Adp5bDZuHbOImIUKDKPShvVK9bnbkKYv6VXAuVgWW6DYuQnPv6mj-xnDqRXl7819vm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgBoD1ROXKCdLkKMmSIlwcx0W_owww92NVUJPfOdnIRg&oe=6AB9135F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_b9KDFWrFsQ7kNvwF_Ugkb&_nc_oc=AdqaVEDXHUI6wJGmwojRMQRdhSgq2emmGLbpLlerI0e6j4iq0Y966GPYNnKbGMjOwgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8endvEKDLrKe2pY0a9z41OqxZ8M94dysSS2slprd_Bw&oe=6AB92C82"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
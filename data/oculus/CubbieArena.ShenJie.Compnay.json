_ohc=kkqG8ZielZEQ7kNvwGBsAED&_nc_oc=Ado--KVtxdCSFMX4biwpG7eKUrJw8fH4dgJYrl83OR7vlImCFGHJY9wJUkUBLJ6GUrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMiM-fJrznsf1TpiDWbR4Y2bpbUIiFXgdJOtNW3937pQ&oe=6A523D00"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9UjZm7Z4QwQ7kNvwGVM50f&_nc_oc=AdpslgodIE-EXT2-xPmvhDEhWPN8qlOBYYH0znSeLu0z3vZplD7EGDicFPZrxsxQk5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUxwSIgtISHRl6bKnjB7oq7YwqBPPM1jZDYwuIppwSIg&oe=6A525E2B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3TSavgCzIoQ7kNvwGjs_-F&_nc_oc=Adqic8IPpcM18PZqBsxCprMaeMwdr7xfC07bmSTXf_k8K8CTM6YtLI1mw-9tuAbzlJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgVN7lD5ndK-HlUQjCLlOX3UGy3pV58sNit92Eq5yk-w&oe=6A5249F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANpNuzCDASoQ7kNvwFlDs3S&_nc_oc=Adr2rh0pnX6RAkXfaWJmxHcBuVszsxYUWhfU98OGlXg84tFvZ9SRpQx5U9w7wv4OJFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuETRoL5ReABQtsnveN-43HZLSfyvdDz4OnhQk5CcJaQ&oe=6A523E5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VadhN2mrGeoQ7kNvwFTf46G&_nc_oc=AdqUEfK29HMfE-E2i-w47uEiVPDR4cVP71I8uVwJhKuVTDr9UQ-HB_NN_pEnD97KVhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkO2efKbag1tQ0AixORBEBR_Mc5C8jbNi0Os-JuvOj1g&oe=6A525782"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
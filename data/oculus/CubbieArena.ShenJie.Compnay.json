-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy6FOdg362oQ7kNvwEg4ilR&_nc_oc=AdqnoOwqXFhDGasSDlF-pK34G6qSGeelSthI0we_Flu7MZ2bkaf--0nnQ3zsextwHm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpN8UvKaO3aCY_-3c9yXN9DEw3kJmQSqTnxvy6DLIy-g&oe=6ACF8876"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L1K8Cse22UQ7kNvwGmVdsD&_nc_oc=AdrNMaeEAT5tcp3-EqBUORUfYKY1FlgsbskGsKe-ghdLTEX2HpzdkCB9eM7kfb9J_BA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh_VpSqhvXeue1jKBQWlgHaKVZsK8BK-BJPm38zfhwKQ&oe=6ACFB51F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPlTHf8fggkQ7kNvwF8C8o0&_nc_oc=AdrThRgFI6T_0_DMv4tcFOkdSJqBnRX6LmDRD8RgKzeL024Ff0cyv_TrKRnb9-iZSEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8e-VgXUcUysWI-f06-J8XyiN15HrEM1dRtl7MY1d7VQ&oe=6ACF9602"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "617557069315098"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1211354912303025"}]}, "baseline_offer": {"id": "1211354912303025"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1502262000, "status": "PUBLISHED", "id": "1211354912303025"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1591614754242805", "version": "1.0.18"}, "id": "1678764262426571", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", 
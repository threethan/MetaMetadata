_ohc=VPe-J3OxMQ4Q7kNvwFxP6hQ&_nc_oc=AdpUIBZnLz8Qu8BfJ6ZLIhmC3mWpn76MFxlYyps388fgtqhwTMpi_ZHna776_wOz_BU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nAWKYyWwUF52HEA7p7QmODAqeEhSW4cXy_Wy6I-tk0A&oe=69FDDD00"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=118sp-SuXsgQ7kNvwFR6qjp&_nc_oc=AdpjwilTXxTwiOhcXYYv9NG4ILOenPtLUDOL1LsGLWlDBDRssD0-m0mstmnbOmQsLU4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zjJSxyT_7f6Cf6fiQ4-tn4VMLQujOAV6vmynlr09OUA&oe=69FDFE2B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc2tWGUPSaQQ7kNvwFI1faO&_nc_oc=AdrIVg4YRNn1QWgupVV9vpAGl--aADnzkUwTjnrVEBHIFgPd_hyxphlwJXSwo0erjs4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yEef8sUif0M35h4T3fW9_kmbnXGlYvtReMdLTWydeiw&oe=69FDE9F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X87g1ZQsKUYQ7kNvwGMtr11&_nc_oc=AdrGDbkHO9BsKS_AzDPKDAyi4mVwMENFR7jHcflfonl4qL8xGHUfU8MOgcQW7pwYR7A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43jR-h5eCVgFW6I9cJPWkfTL7CRK3ElbwrnV50nZhr0Q&oe=69FDDE5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAgqL4smjr4Q7kNvwEJH0vF&_nc_oc=AdqpYRRd7tkw2ysT5BVIgysUnDWfnD8bgkDazh0pPKgtT-lhz963WjVs0okzclfkoZM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hozTdeksmSqt88BscdwHnBk8mR5tWK79hUxnfJqCAdg&oe=69FDF782"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
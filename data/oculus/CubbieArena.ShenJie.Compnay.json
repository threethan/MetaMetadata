_ohc=o34aQks-3pIQ7kNvwGbqVON&_nc_oc=AdotPOxO8o0xtgYMTYkl4onUJcdDtooNDeTYpysrBudyfYlIvfFlPv5an7WtxJyrYv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u4ZwwbRmBkBXjiYloe3nskxZhYwElLQj4BA03Dtd2Rw&oe=6A411980"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3-EKw-d4MUQ7kNvwHx4Qba&_nc_oc=AdrzvUPSC7hhzhY1fEy9VRWd6zzoLYvIXQWBMm2u-1g0VambpxRnuU-vTjF4Jfj9agw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lrk6aoW326rZJrLQIriKWWX2DDlbLeKtfCL2eBhRqzw&oe=6A413AAB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkpEcpQim_sQ7kNvwE_tQ9d&_nc_oc=AdpXi5ODOYGhrpDBg4QbrI3iu5IKyklRDlytcUE2fvgk89CRF-iB9hYobKQ7KhQqGSE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cc6OAZ9IjYqf6b2_HZqIGGR8G4QdeqhipFHzt9hfrfw&oe=6A412676"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krujtDXp3k4Q7kNvwEUoXd0&_nc_oc=Adpixi2a_P3XsOhbbtyEU47hh1QeWRm49BRfPdmRwy0SEe_QtrtGGRmNA_bopmJaDcM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AMIMOlzMv6zDdJa0EsDQSQpmb0exeheDqtx3dH-LHGg&oe=6A411ADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVZGYyPlK3gQ7kNvwFHenU4&_nc_oc=Adq4sbXY98x0I0PTbr-wdsFZ9lVn5_7D8XLqCd2t6kUp-wVz1dZzSdv-Q5cH8dK9iL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qvgmrhsNEbvL9mRztdReoF3SG6g9DjnBhdc77UESr_A&oe=6A413402"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
_ohc=ZmLJos8RX6cQ7kNvwHVPqcX&_nc_oc=AdqP7Xh_MmlXMfGPWnL1zhNIVgNTAKj-MEvRjzA6lHiq4dOMLCoD_mGju12GtdOux5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCsuaMb3n8jEfyAy-AAgOGuNp_YSERIWtSs18Gd0jfoA&oe=6AE5E500"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8vEwl81DdAQ7kNvwEGk4Un&_nc_oc=Adp3HYe2W-VL_WL3VTUqV0F-boxcRAaBFOtxAW36kbgtpYaiRbWJf4d3zEggjGk5uBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz2fr5LXMrVh3kxPlW0RodXj5rvZHLmaBNsBtgVv2M3g&oe=6AE6062B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlRLSgouq-EQ7kNvwE1GUAW&_nc_oc=AdpdgmB1DI6ajp1r-oWWq5LFI8-w56U8-LV_K1OQvk5zphKjgKd-4sQF00EK431cjv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgV6_6mlOzSk7P9T8Dbjm-TPJ5vNWonh9POcQpviQAfQ&oe=6AE5F1F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MivZ93drnwQ7kNvwFI5aLW&_nc_oc=AdpilxCgvfJrAhl2o5Wup8cxIhN9apBJYVq4Hx7JYRm9DpehFniNJSVtdM0gzg5Qwxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4V1S6tkmMNy28Y0uJcaeWzpj-6I7vEfVwVz2QPHtE4g&oe=6AE5E65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7iseg8wjAgQ7kNvwEDxkhw&_nc_oc=Adpc-liCsnTgCMg5KC0_4yTZClZeiTLUaS-tP8N_lZEE-ExKA0HlsvV5IhFwWuULPjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5PfOIVUQdRgIgFyGOy4wV9njM65zX8CCBMaAN_WfhXw&oe=6AE5FF82"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
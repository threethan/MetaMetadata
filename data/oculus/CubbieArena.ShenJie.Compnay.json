_ohc=6gIL5c2Br1EQ7kNvwExFspe&_nc_oc=Ado8ahOYqbRZTtlx3hfsXnXAcbIIBPEnBiL6-I9aZQhe6OUrN-6k8audyxJYLgZ6pX4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57b0ZEsxCVGe0zDIJ424RY60jSmXRY0nltgQvedJcGrA&oe=6A0F0080"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj79_ObH05wQ7kNvwERZNeI&_nc_oc=AdozebufM3E2dYiJKF1ft_HHd8mayiAILfguPrxSDUGe1JztNn9APcNovDgULGxYO0Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ca9utvDbaudsqneQHihxgJhuazxuo-wFTOg4b2f-ElQ&oe=6A0F21AB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hESWhUshbN4Q7kNvwEFwkf-&_nc_oc=AdphJdGZbmppp6OIn9X8l-IbH4aP-nY51goeMF_EyFImPNF-PWteiu5o9cWE3pPQDBU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wrcAKTYc2FHSdaJHnf5lXvXsL_JiAQw3isTgKLxbpjA&oe=6A0F0D76"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDy36LBxNscQ7kNvwExCEXC&_nc_oc=AdpQWueBkGHEHgD_ry-F78PkoLAoeLoR5mrag1djN5tKKZXj-KaHIyAPlkwjt6WiC9c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sQSeBdIi7F-6t3sWG3x-soMOc9fwMfmQGOLBnfwjrVQ&oe=6A0F01DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQihZVouEEoQ7kNvwEpvp5p&_nc_oc=AdoE3iZ04kBHBlgUjgD5Wzs739fAplKqDxnwqTr9YoeCIChSVqLqhu7xJFtMu8mel9I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pE8mquh6FCNwul8lKOu9h0AUzPYn4n5qHVW8245_o4A&oe=6A0F1B02"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
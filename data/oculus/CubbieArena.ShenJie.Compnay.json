_ohc=2wzR5nMMClsQ7kNvwFaU-Lt&_nc_oc=AdpoVEV1HtieHP9DqGtsne79wq0lvgapiqETFHKZ-QYsWyIi7u0rf4nXpe53jZZ9rFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Kw4QeG_76NfQH53bC5a_faesael0ywEd6EtV-KWZ4w&oe=6AF740C0"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr1Bl8g_5t4Q7kNvwEbHpyU&_nc_oc=AdrRkERyIE9uS1AALjIQtZUuEfGQkjpGDulFXLlMWtA20yDHOyX5REwJrLX8Lod2Gow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7FzDeJAOG_1ewuEAosiAlK8JUhuHVuKHmsYNukwkrtA&oe=6AF729AB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkDHMoBnPScQ7kNvwE_imY0&_nc_oc=AdpwKNLBxDQU0_Cj-oMvGa9A95pbD_qUU9EWXHIePTrenmoZApIt4vDT5_2dsXCqSaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuZUikypPyOXuhuFozt8sgOB719DFCHdy2u__MCt2pBg&oe=6AF71576"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE7t3YQjemMQ7kNvwFhGb1u&_nc_oc=AdpV1mqqu8Hbj5hIdsRvdSiguEHVTq_l1sPseUFJgv63HUVSHuhcrl-_3oFyD1QuXr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWNmTWz3arz8b50MekpCVKymGePtfLfIaaYQW6tOUFuA&oe=6AF7421F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQxa0L0iBiwQ7kNvwF3knUh&_nc_oc=Adql6PeU6f8bRF7ZCwgj0TSf3Xn8HGfl9JqlNAZ32Olb5Ogwt1SL5jKCLodoIQevddg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOfxRG-7nY6rFGfEy5PrGhV0VR8tslssZRptdrd9429Q&oe=6AF72302"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
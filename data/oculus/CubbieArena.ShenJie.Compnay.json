_ohc=Cgsh9D40xJUQ7kNvwEJhRuK&_nc_oc=Adp_atxLwyl8OOvo9cgOe8dokCRs_CQOSYinNrkIlN8L3kltJFNge7TnXXHpFGLHrpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzFZCWMZ2xXZACtolv_OV9ys_gdZrEC_QP6FUOXRgegg&oe=6AEA11C0"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdLdFZRo2VoQ7kNvwGBUL24&_nc_oc=AdqOgIqntbxvuhmt2yf11uXPf7VdxOq3km4gK1rh7ev_gP8EOhEjQ3GJ7OMa8vChHZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlTA5lhPK87KfQwz3C-DgMZi0sbhWGZBSJc76mEms0aA&oe=6AE9FAAB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbDO_IoT2vQQ7kNvwHmyzpj&_nc_oc=Adp1O_jjmiY8hevtYVaG6s80HiDbwwJccJwfaBu9rT1ctGOfqsHBM4Uqt1e_IXYEA7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAhTSMsb6kCZwGmNW3qOdmPu15qlocExicj_9ST-ydAQ&oe=6AE9E676"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_40SCMTyAcQ7kNvwGH6jFb&_nc_oc=Adp1oJ1qBEWVTrSSQtKY_SOs_PRqo4nXyp_JAMtGDZ0BRkWFrIwZGUXI8_0eowih2cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtI7yBeIRYd_leYhjNUHybf2BBIKV8BtoLp5eOs5Az7w&oe=6AEA131F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djqC5t7fCSAQ7kNvwHqjxRM&_nc_oc=Adpq9y_AWDYuRgYFxQkKFRPlwKCIhmZuEDdRcCtVa9a_DqjG0n3GrRodhB4rS57Q5hA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2yZZkxThddFMkL4jDk7EZcEmAG5fs697eZfPlpSsl2g&oe=6AE9F402"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
_ohc=o34aQks-3pIQ7kNvwGozSl-&_nc_oc=AdqSfmYjaeOyNWM1WYNux6wDin7ttMm0RJlJyP0dlX2fmxIT0oplsdh6v6SvUagxvSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rteCLr7PCZqS2NbyzqB-msDa8ILmmdC6y-0I7U12GRA&oe=6A3FC800"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3-EKw-d4MUQ7kNvwEtihfg&_nc_oc=AdrnbMKRhXMc0xfBr7Vj-DjnbTzOlgFE2mRaxutffjmdFSoRnlvTYeAEq-5taJrlqPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pI2fMZeiThJY0IoxUEG58hgJlXCNP8tWkpfK9vKuEDg&oe=6A3FE92B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkpEcpQim_sQ7kNvwFkkFZL&_nc_oc=AdoDcuW6wExqzWsKT2NcOU67KulMYNFgu37uz2N-8KiWRk_C16Zp_Qxq1gwfsD0EYLw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jgSv-mvdd9psSP2VemAwsgYe3pRMscgyio_BAzwU9ww&oe=6A3FD4F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5WlKG3G60AQ7kNvwFzUm7L&_nc_oc=Adou7A99GTK8-n-BuJt3H1pAjQpKWqbis_75pSBX-e8HAvyGfIPFo_lCMj5ayWgDegE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s_sF59m2ge24D-DyZaCWuN7U2DhI6GCvibcfk69gfsw&oe=6A3FC95F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVZGYyPlK3gQ7kNvwFK4Qxg&_nc_oc=Adpthh5bQYD4sWmre5pUCC0PRQuJ7VxfRYmThQVbFB68sjixeN5-XnPINwfoSHr83Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rh3LC9C8PMlSQQMz7qVt6PuqTyct5PE1NtaEi2TvvVg&oe=6A3FE282"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
_ohc=EetvrgGgZEkQ7kNvwG-bCVr&_nc_oc=AdqSMmKSOm0ATE1hzQef5J4nGTelye4s64zEdRaMxMjWRHxoS6iWYUSPhVPamES782s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4aDTFdbjgSTSwjmMflwlCitM4NfN4iOLWupQkk5_Usw&oe=6ABBB500"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB9hlnJMg80Q7kNvwERznWZ&_nc_oc=AdqxTFGOpFuJ9HGkjc2JOCLnbVtvfU1thsyJhFpSMWvRDaWHT3gAknc7P-PV9G5di3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdnEdC2AMRI6xcALQHQ_YqM25W7c7n_-e6swL6FOFHzw&oe=6ABBD62B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeCazsXY_H8Q7kNvwHT3c_t&_nc_oc=AdqjtFiSiZQPAPT6q0oAw8PgSUIlSeZYOfI9LA0Laqm8IuTh5yT2COk3IK3-dEaVLiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7w-1bCd88fXFN6roe6KKt4bFN_mdegzTid50Jcgl6WQ&oe=6ABBC1F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHrrLHzyMl8Q7kNvwH8RvDs&_nc_oc=AdpNqML6sG7BsWCQ9_XZhNBWM3qwHhX-t3pxILZx7EEHON_QMM04vgXTs_Uada0M6Mg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL20j65pcNqKOm5MfkbRBw4Hqeyyh5v6joO1JZnaAQaVg&oe=6ABBB65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_b9KDFWrFsQ7kNvwF4-FVE&_nc_oc=AdrtTKcHuNbnqivOqk-zzQzphqd1Azkd0Tj8l2JcDS64G_EjaduiCKjRTUVo-S7p0BM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8a7KASqU-YFFEdjHxq11SXbIw0qBlN8W2RYGpqrikYw&oe=6ABBCF82"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
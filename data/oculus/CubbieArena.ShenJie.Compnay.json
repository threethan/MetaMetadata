_ohc=VPe-J3OxMQ4Q7kNvwFF2EwE&_nc_oc=AdouUScxuzDDsBO2clcnJdAmym0F_borsL5wTXfyO6K4Q1fBc4pyEeZ0_JRCm_5GU9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HP7vRb0e1bcHLcEk9T8aAaIitCzQJL42mI9SQzgWuww&oe=69FB3A00"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=118sp-SuXsgQ7kNvwGi-hsI&_nc_oc=Adq8GB14Vi8pHOsOeCKakYDSd4VlgpZVgKRpxIDADb_-rmSlByS3ni3ssprSnrivzJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cBaq0Huf405hDZVtNvzzu4nDDWKdRlV5qcA54Mnr0FQ&oe=69FB5B2B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMk12OfNmeAQ7kNvwEJKjWt&_nc_oc=Adoy8np0OmIY0S3sgSI7hD9B2vTuKOBrOTWZ8s7DPByj-vhP-bVhL5oUI4-Mc-78TuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rfWAd3G2JC7AaRmaowmyB969HgrZEkzcltccvBdv4Rg&oe=69FB46F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3Kos7TOaz4Q7kNvwEo9rMv&_nc_oc=AdqtToz5VeVnhkuBt4mE5E-GeciCik7XhoOClx_uaktnf1VSjhmKs1T2LVNrlWiLFsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yXn7ncYdVTxtDCquy3EFEafl1evgyiWgPdh83rvx5hQ&oe=69FB3B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAgqL4smjr4Q7kNvwHjldqF&_nc_oc=AdruqOdduRIvyujUtCmtUaWycs-Ns_KikpG92gbbioqfyocDu1ani6kL2EqmE7IlKbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cge76GknpZ1cO7Qx-oC-GYklM8DtWEtES2bZfk2vWVA&oe=69FB5482"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
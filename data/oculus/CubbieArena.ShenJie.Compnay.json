_ohc=Cgsh9D40xJUQ7kNvwH2t8fF&_nc_oc=AdpR_aIGq_F9oKZJ61UAXCmNtlUptJgRHdtb8POwCmndRtvKTMJyVfHAI9umR8t4x2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR66rddGc57s5Ap0724AZALQimHtooRydCiEACSx6jZlw&oe=6AEB6340"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdLdFZRo2VoQ7kNvwEsvGjf&_nc_oc=Adr4jnrmrm_GTA6NRIcP2biKY6m964Qvtpjq0ILue3eKEN6jiiS6GPxQY1w7ADntTx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWQKE_pQxC_8xiB26NJeXUnwP_YEOeXZtRMuThbz5x4A&oe=6AEB4C2B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbDO_IoT2vQQ7kNvwEBjMQm&_nc_oc=AdqayTVdp9OmqUpqk16XvZijgjZH-3n5WJW1XqVOJ_ghldOm48Bn3SSkbCNlhK2I2Gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ85OW4X3PcBA0ABxshb8ThIcdZdtga9I4jldIaLgHmg&oe=6AEB37F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs8ExdCgubsQ7kNvwHuIsrS&_nc_oc=AdrvMuu03CmY4mb-zymfDzAshAxE5kb6yT_mONlfpKztHIklm5LvONrpgZhcaLlT1Fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7aPbmlCkBPgIckqD5kHbItROK7THqUSUy8GEw8cDQWg&oe=6AEB2C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djqC5t7fCSAQ7kNvwGnXy9y&_nc_oc=Adq9mblD5hoRx8kHeuM7mJSVFrGq9ty6TPJ590Pga7C0wOsEAR_9b6LuLy3xoFdHU-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPjIAk36kUoFKQUIbIh0z5OADChJxVT6AOGeUdlBsF5w&oe=6AEB4582"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
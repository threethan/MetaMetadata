-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXylSmi27wwQ7kNvwFEZUpi&_nc_oc=AdqjMou12kJXUip4ED1mO1nP3_kmBthbE_qTZerJYnumRkzNXfflVnoK_n8yp-ELUfk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-LCIRR2uHrU_LzvNfh4KprkHiLM7vUA4msp3XShiR6w&oe=69F600F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzpV-m_3tRMQ7kNvwHsgqzr&_nc_oc=AdqqgdXwphiBWI3jeBlvpAuT65ICSto10bV0GVGs3kfuUQzrDOZUfntOPCpEL4RJA7s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Twz4TKEwswHyoLCNXob01Vgc9PJmFZn2A9ML-kSXD_A&oe=69F5F55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tr_Zpe4KgIQ7kNvwGi8P-t&_nc_oc=AdrUriEgGCFpRuMKLNePB-7T0vgh9KZoamvntYeSzUMw0KIDhI-JgM1fmL4LYvrIprg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2djjmQvIHThuTlSRHYOYgHOsWKn2O1Ami5h_Y3rPKDlw&oe=69F60E82"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "617557069315098"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1211354912303025"}]}, "baseline_offer": {"id": "1211354912303025"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1502262000, "status": "PUBLISHED", "id": "1211354912303025"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1591614754242805", "version": "1.0.18"}, "id": "1678764262426571", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", 
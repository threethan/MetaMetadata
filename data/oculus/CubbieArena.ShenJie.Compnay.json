_ohc=ztdl7926q7MQ7kNvwFnPBlz&_nc_oc=Adp4O77gJyIG5jyWWZ5b6Oiw-RtGsUabtoBsIGTy4UsLUNeJ04Ebh7nQwSvuvgHkeKE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VKRC2SsrSIOXLaWKpbyudDvR6tp1z0xkOLe_17sil2Q&oe=6A2C0180"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6ECjKg9vfUQ7kNvwF_76jX&_nc_oc=Adr7FJ-49eXFmJRLzHq0mANaI1P2L8-1-vHKtTwPYY89wBpr_ROneUh9ZeinENkVan0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4t17ZgnOwapKxWtq3Fp6H899DbdhEYdF-js0I43Sr0g&oe=6A2C22AB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdvFcsvBrF4Q7kNvwGLWUMn&_nc_oc=AdpWNWEQDsdTjRrU1ZvWkdstQc8oaPJCxT5IdcKyHVfc-bIS8Cc1g6NZdZ81osztdEw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9D4AUxQ6etqNkuE6arnkZD2vC22qqtG35AXtVrxFUTQ&oe=6A2C0E76"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wxD-Q9BN5IQ7kNvwF4PhtB&_nc_oc=Adraa92YpbIDDhpuMfqZN2-LKrYmL-hZqyuh-KZ97O-8M5qr5XBVRY8A8HVyt70zv-8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dJApbOTFxze1WR968s5dxg5lGH31qEFsgvwZtJMUxwQ&oe=6A2C02DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me4_lUlOH7wQ7kNvwEPDHzk&_nc_oc=AdoC4H1HAP_V5nmqxPatyngt5cXqlwbE7xyrEsiLhCLEuuJ215dflHjCEKh0K0rWpvA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZEjkqoixF3grvQ2IJIFUz67wcQHY3F5AHwBdrb3G2XA&oe=6A2C1C02"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
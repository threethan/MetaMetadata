_ohc=HLE4H859zsgQ7kNvwEifBC1&_nc_oc=Adomegll86JlAUTOcPrjGuZjn5BuMXbM8ySsREbSZjMqAxN8VZALe2_IZm6MWux0A9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGImgbO5RCzti8jXvkqIIZVRTk3FyF1l9wXBwuqIA4yg&oe=6ACE6240"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaPwrwqa7XwQ7kNvwEv4gvo&_nc_oc=Adr5eBw9Sl69CrVsgxX1RFNHEScQiAF-iYrNveeYe7fJad6vTvgEyTQd5fwTSrFc-Yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9vJleAYRjGXDPtYhatn1I91gxKEg5FKzUtzBcITJ-gw&oe=6ACE4B2B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy6FOdg362oQ7kNvwH8vQU4&_nc_oc=AdrISDBuf1HlLr_Yg_2QnnlVzKysPM-QVZz9kzP2CULaKJzunx35f2GqRLOC63Jt1Xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRbHKR_LhpGfEFpvlEmMB0duViO0bzBZCUWTmp0ZyPUw&oe=6ACE36F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHVBeENLNO0Q7kNvwGPBduP&_nc_oc=AdpWqQZ_ya418JYsLwUlLMfJbKH2YN0sVHOj8_3dVkUC33vMTTLBYOxtjaHKn3l-kCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4F4MEnTvRA039xQyXoUqeTR9I8jt8hDV40OoT1NPG8Q&oe=6ACE639F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPlTHf8fggkQ7kNvwFOagx6&_nc_oc=AdpJWKrhbFgirw7-59Tm4RN_cWiZJGobCsmBUZjBucbUGWAim7soET1UUPFYqYhmyEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9k4DrgKD2s8QMUnYjIU4ZHb4MNlhVg8xvBKDXMDIb2A&oe=6ACE4482"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
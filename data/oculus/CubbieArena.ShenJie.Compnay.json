_ohc=X8DWB4PA2BAQ7kNvwHtkuV1&_nc_oc=AdoUqJsBY3ZK1wR7aOkfs45ZK59FaBcNxr3ayLLAUlsb-DD37WG26rCru5prxELy9RI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6RuPkCUo5tACFjaRBuYByjrlGv0rLt7Twxelt-DOVvA&oe=6A75D580"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czebgpag8LUQ7kNvwHzqgKn&_nc_oc=AdrZgFfcMsmKWuze6eAMiSweIBIcdZXcHkemX6AF5TJBkDw5nyIRTfJf0zRwpefW_J4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH82Hp-uNSslMdRaf37_Eb__gp2gf0w4xNvz8ec2AdNCQ&oe=6A75F6AB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcYCVnHYoHoQ7kNvwFWdbVR&_nc_oc=AdrVHurw9libbcySTLwnQT3Dn6Iz5iU-cTL74u9KcVLvd_makbDiGT60RKJUoJ-oq2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjRW9TeGGkYHXgnxfd-iCtdellDbp24ObinTFu5S2yDw&oe=6A75E276"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBYoNt-nBcoQ7kNvwGc4NHw&_nc_oc=AdqIzSCjpVqfyvyDgQM0K4Fc7MPQ_45FNQg9VK7nG-lIQI0UB4ElIvxHDDt-lc5ualg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8tL9KEr5IYtcyliGli4jn1Ak1lsPC-WqEUy6QJpRSRg&oe=6A75D6DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ywsArIOSGEQ7kNvwHiVcIs&_nc_oc=AdookH6RMaRqchSeonq5p3avXGz_5QnedufVr4PPaYZ4sA128iDyjyw_aWqKGqumAwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQrGuO7wtz_XdVxlEamK0Kzp9sm0bJX-2UMVUWJdk07A&oe=6A75F002"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
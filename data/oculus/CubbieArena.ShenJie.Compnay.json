_ohc=NR9qV2KUjxAQ7kNvwEeLNPu&_nc_oc=AdpXeVZwEQ31ViWKbD5KukKEr_M0nfIRhCIQEKHT4WuMztnPwqj1j2vSp5kVwLtStR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPbB4sNpRGUUkukNdO4NR2z39LKIj3V4UmSnWNj71xTQ&oe=6ACBBF40"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2cFtQj6X2QQ7kNvwEDb5ik&_nc_oc=AdpDH3OxxNMKno0sGBNxmI2SMjqEX8e_hFHap8J2l6KDa_QSk_rgsHEMUGbaPs5dofA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwRzCELSH13Q-EEFa5IJBfp3c4UxKDwfzTCA2rtOIeNg&oe=6ACBA82B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgBYLugVR5YQ7kNvwEPc9qm&_nc_oc=AdoENARoPvTN9UFHY1oOTtTf8otgpdFv9qCFLk7pe3RvF8pwGyuBvNh3ERog88gFNZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP61xOkBPG60EAles9GStAeQhXcMvFtzOMhS4uKobcTOg&oe=6ACB93F6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHVBeENLNO0Q7kNvwF5fy_4&_nc_oc=AdrzxrShwhL0x6A02crkv31kUEvbpNDkt8YAeerKWuX2Z4soaZx6a6Wghw3vc9v6Ii0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuIM5pcdOWzoJ67QmKIfahUYBg5r_l3JSLWmuZHXxtvQ&oe=6ACBC09F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQA4vG24XDoQ7kNvwHbTtGa&_nc_oc=Adou6C9Q4Vgeo3fqA-Oh85UJSQr16QYkAu8jW15vZbk0fFbc6So2xIBR76D_eipdu6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMGwFr_FtkavnpHVzRnnjk3I8BP8DGwRcdH0LuB4qVAQ&oe=6ACBA182"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
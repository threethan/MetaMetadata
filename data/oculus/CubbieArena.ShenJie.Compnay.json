_ohc=y61Dzwo6aSkQ7kNvwH5OyAe&_nc_oc=AdpFZOz_778WthEuq6NODb87S0uIPdpCmtaJtUUfu4bHTM6G5OWm51SNsDZGWgLl3gY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pCg5B5B4QYDrY4NV9H_Et6xK6ahckcohECFfiVfrnag&oe=6A26BB80"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvIEPf_Uy3MQ7kNvwEC76Db&_nc_oc=AdoAZgIocvLggOotSjQlE_QwX4K9TALMX1liVJthmH76UHdewlmOjuB_yyDo0ht7Nv4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1p2PPCmSox3-xo5aofQZKf4v7jJlHT_rrIXV5661W8w&oe=6A26DCAB"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmFN0Nvdc58Q7kNvwHo509a&_nc_oc=AdqBQCS0E6BrS2UJdZbaQ0KwG12aA_eS13pgkTfTNWowtRquA0yiMeAcRRuyby6QWT8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_feuFKb2Z_jquXm7OP4z_ZYBloPW7YZGVxd4es7FqrIA&oe=6A26C876"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMShSl4r-eoQ7kNvwHqJ2OY&_nc_oc=AdrZei8KwhUc1vRFkdz_FkTA0lUIV4jq_mn0-R0ilVWmwJvhUuHDqhdM2QmC_OnTrTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af885Q8mzGOIxvnWTHeLnjeznXYl_r4LrNiZz83ipLbkjQ&oe=6A26BCDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBTc6glNl3QQ7kNvwEgwFaI&_nc_oc=AdqtnguAkYkApUgEGiDa36o5ELTwTNTE4cb_tkA_iDtKHp5jAMm13Xwz1NKA4vItjWk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pw-5EtuGWt2_4a2qVIhHaCMH2d3d94cag0OrET7UpdQ&oe=6A26D602"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
_ohc=4toEFWdsyK0Q7kNvwHg3GvG&_nc_oc=Adppb-qCRHc9UuikdIAwXRy9-bOuGt8fAvcnG8wDwGeb49MXr3TE6VXmFWFOshH4qvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT77jyVKbXyXcVUwadUA21gRIq-SxUOck4_rctDbwEijg&oe=6AF0A940"}, {"file_name": "migrated_image.png", "id": "513174776285533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162727_733292856857417_5733681301781741568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK5vjFKWpdMQ7kNvwGEZski&_nc_oc=Adok1L9eMuTv5LflsQgff2zPuQQhBfGNrfaun0LTFQCpDDpcmstDNi49XynfIwuLct0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRznqt_-2vk1EuXiJkWWvt2_hLvdMD_Zw4jjjUKc817SQ&oe=6AF0922B"}, {"file_name": "migrated_image.png", "id": "495059571172936", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_1714483795260795_4203211062092234752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2glnLnyvDscQ7kNvwGWBetp&_nc_oc=Adr8qj4luR1OB-OWQiccjxFiqYY1X3Ndkh7HNDQ4AoC1NWEkG8B3XQrtXYnwwWokhD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAXstn1J6-aNDl4lFUE6WZMnaWBnxzVk2Wa2STWS5u4Q&oe=6AF07DF6"}, {"file_name": "migrated_image.png", "id": "291015905214338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_509571692716167_3945154394563018752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rDDGJvXnIEQ7kNvwHI3SGG&_nc_oc=AdqDNiRUxBtzh3BrSGJrHBpT6uT0Da7W0lmj6K38BQY9d10lM-LDkNti3mdqffaem5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg6c16gje-_A9oOBSPvmOhnc7k0rhuTiiokJef0P6BBw&oe=6AF0AA9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "2236976899861896", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162748_2236976903195229_1956448686699446272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoZ3iwhvAsMQ7kNvwGpwbh6&_nc_oc=AdqJYx1B37ODvVvljxKPR4C1LKXatSn_3rd2kYgJxTqqGm8CkrWqWZSDRlVM8Kwexus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlvvUA59le0i6n_OcMXmpGZwm93AYqJLbUG5-iE-ZcGg&oe=6AF08B82"}, "display_name": "Gubbie Arena", "keywords": ["Cards", "Strategy", "Battle", "Fight", "Game"], "long_description": "What things can you do within 2 minutes? An intense, and epic battle? A soul-stirring showdown? A campaign that tests your intelligence and reaction? A pet fight right in front of your eyes? A strategic game in which all you need to do is swing your hands? A VR game that gets full support of the new controller? Come to Gubbie Arena! You will have them all!\nA shooting star with strange energy fell on a green planet, bringing life to a new kind of creature [Gubbies]. The devastating invasive species almost destroyed all of the original inhabitants on the small planet. Facing the danger of imminent extinction, Surviving creatures worked together and managed to tame some of the Gubbies from their hatchlings. As their master, your mission is to train them in the Arena while they fight with other kinds of Gubbies. Polish their fighting skills, watch them learn, and finally fight along their side to bring down evil Gubbies still at large.", "short_description": "First-person Strategic Card Game, Battle with cute Gubbies in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voidrhythm.com/", "developer_terms_of_service_url": "http://www.voidrhythm.com/", "publisher_name": "VoidRhythm Co.,Ltd.", "support_website_url": null, "website_url": "http://www.voidrhythm.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "RPG", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_track
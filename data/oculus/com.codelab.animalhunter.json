27127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rxZj_5TnJEQ7kNvwEG4tC4&_nc_oc=Adqq91MZ2orfXkkCLssoOgKf-2DOf6Y3pUtS_xic9SayMEhP0HWt5Omx1YeEmMBR8Y8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f4mlTR9FHVYlx2lYGcuLlKBlQY-XxeqiB3os1jIDQ9A&oe=6A295AA3"}, {"file_name": "image5-wolfs.png", "id": "2011315162732835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_2011315166066168_1594566639237375416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdJNCbMrzqEQ7kNvwEahrm5&_nc_oc=AdrIE9Kd6M-7jqDzWRh3-PfniEcFfPY5CdrNceE2jOopFv1XcU1-f9p0IdsinTk4vhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lSJKaIUCiwQ8YqgcACnROp9hWoShNBSM2RKWgPvjpXA&oe=6A297CD6"}, {"file_name": "image4-zebras.png", "id": "1474354487317075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310651_1474354490650408_4168006281559481016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hstzvLZP860Q7kNvwGy2ZN-&_nc_oc=Adrmz6OzSkNlmD5ySk-8BhEfhs9F4icfJiAa6y4Yk7nzLQZ-ePHWr4n8tKi2XwSo1To&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DKQxqb85wwbZxFv2rHpJMSisg2hKzcRuj8J3mIscJXg&oe=6A296F34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 - PNG.png", "id": "1515573886276711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310804_1515573889610044_4448593629849793003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8cqOWkjxaEQ7kNvwHFAap5&_nc_oc=AdqctL5je586TwWxqou0CFaBDJ0dlCmHKQFqd4Kt1ce5yV9DhJ_zZlyKU3lwzmWrboI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H7sW_grYn0HpC90wTWro_kFaafXXiLhjMv84gS4ZAqw&oe=6A297D27"}, "display_name": "Animal Hunter", "keywords": ["AnimalHunterVR", "HuntingSimulatorVR", "WildlifeAdventure", "SurvivalShooterVR", "OutdoorAdventureVR"], "long_description": "Animal Hunter takes you straight into the heart of nature, where adrenaline and adventure meet. With realistic graphics and fun gameplay mechanics, every mission brings new challenges that put your skills to the test in thrilling encounters with wildlife.\n\nFace animals such as lions, hippos, wild boars, crocodiles, deer, rabbits, and a wide variety of birds. The experience feels immersive and exciting, giving you the sensation of being in a living, breathing wilderness.\n\nSurvival depends on precision, quick reflexes, and smart decision-making. From stealthy approaches to fast reactions in intense encounters, Animal Hunter blends action and strategy to keep the excitement high.\n\nWhether you\u2019re exploring on your own or seeking new challenges, Animal Hunter delivers an unforgettable adventure in the wild. Get ready to test your limits, sharpen your aim, and feel the thrill of the hunt like never before!", "short_description": "If you enjoy adrenaline and adventure, Animal Hunter is your game! Explore wild landscapes and face thrilling challenges with lions, hippos, wild boars, crocodiles, deer, rabbits, and a variety of birds. Realistic graphics and fun gameplay make each mission exciting, where survival skills and precision define success. Get ready for unforgettable adventures in the wild!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-animal-hunter", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
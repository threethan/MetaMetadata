27127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-7E9EBDXkAQ7kNvwHQFYYa&_nc_oc=Adp6wJUbwLT6Bu6g6q03-ffu19cmqvSV5vUvLCsv_vYH3b2sjoT_DKSqLTf4V0vd2C8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O4I7lgjeb605aTEq5iDTBMXaRdx_T0QPBeSSH_X5ipg&oe=6A104E23"}, {"file_name": "image5-wolfs.png", "id": "2011315162732835", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491819980_2011315166066168_1594566639237375416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U3BteNqs-8Q7kNvwE1ngHb&_nc_oc=Adr6wWgpd6aRdksDxXupzMjidMPqBooJ2RU8LTPOb9jOMX4DSBfAYsQ5IaMU23cMkOA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eAQU1CjJ17kwq8tFrAK_Kr7x5sq3NCwi2IEStpuRCcA&oe=6A107056"}, {"file_name": "image4-zebras.png", "id": "1474354487317075", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499310651_1474354490650408_4168006281559481016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV9fZ2RabEcQ7kNvwEcv9Gr&_nc_oc=AdpvUCaY5H4uZPQZdfUWW_j7AyicZ0WANaqJ-GBRffSgR7-5klHeXKI4kBpC4ON6_xw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jQXmu_wALPzxQADwDzi8vsWrA4mvhry0YCO6fm-FCHg&oe=6A1062B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 - PNG.png", "id": "1515573886276711", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499310804_1515573889610044_4448593629849793003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLr2fk-UMfEQ7kNvwEUXpeY&_nc_oc=Adom8dOF5SXOJiE2fIZFrECtOgz-CJXH-Da1ho4GrewC6ty_01MxxmQGA3pi6e9cJJo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tHBAtF6A_PwDSrl_ktvFUtjOgYhnkYXMnID4CrVcEbg&oe=6A1070A7"}, "display_name": "Animal Hunter", "keywords": ["AnimalHunterVR", "HuntingSimulatorVR", "WildlifeAdventure", "SurvivalShooterVR", "OutdoorAdventureVR"], "long_description": "Animal Hunter takes you straight into the heart of nature, where adrenaline and adventure meet. With realistic graphics and fun gameplay mechanics, every mission brings new challenges that put your skills to the test in thrilling encounters with wildlife.\n\nFace animals such as lions, hippos, wild boars, crocodiles, deer, rabbits, and a wide variety of birds. The experience feels immersive and exciting, giving you the sensation of being in a living, breathing wilderness.\n\nSurvival depends on precision, quick reflexes, and smart decision-making. From stealthy approaches to fast reactions in intense encounters, Animal Hunter blends action and strategy to keep the excitement high.\n\nWhether you\u2019re exploring on your own or seeking new challenges, Animal Hunter delivers an unforgettable adventure in the wild. Get ready to test your limits, sharpen your aim, and feel the thrill of the hunt like never before!", "short_description": "If you enjoy adrenaline and adventure, Animal Hunter is your game! Explore wild landscapes and face thrilling challenges with lions, hippos, wild boars, crocodiles, deer, rabbits, and a variety of birds. Realistic graphics and fun gameplay make each mission exciting, where survival skills and precision define success. Get ready for unforgettable adventures in the wild!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-animal-hunter", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
 to fight to the end.", "short_description": "If you're the type who enjoys adrenaline and lots of fun, you're in the right place.\nExplore dangerous adventures in search of lions, hippos, herds of wild boar, crocodiles, deer, rabbits and various birds. Challenge your hunting instincts by diving into these wild adventures, feeling the thrill of chasing incredible prey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelab.megatextos.com.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelab.megatextos.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23903665909280233"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2144939166324923"}, {"status": "PUBLISHED", "id": "897457559273779"}, {"status": "PUBLISHED", "id": "1213025660126145"}, {"status": "PUBLISHED", "id": "1297912664231383"}, {"status": "PUBLISHED", "id": "7201709079894067"}]}, "baseline_offer": {"id": "1213025660126145"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "2144939166324923"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25097212299925582", "version": "1.03"}, "id": "66581726
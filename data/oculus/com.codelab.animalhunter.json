27127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FmTNvC11fkQ7kNvwHC0kPv&_nc_oc=AdrzCgtSPoh31hBIKfOjkfPaNfrZDNTb0-yGP_1Si4QD6NU2wNbtSVXoUauMScVRmt0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qDxL08jpCpMC4l3Y_r-Vb0TBGp27yBqwwVUbNEIXv7g&oe=69F34D23"}, {"file_name": "image5-wolfs.png", "id": "2011315162732835", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819980_2011315166066168_1594566639237375416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VxfhQmvS58Q7kNvwFu2WIv&_nc_oc=AdoJyXdcRJo4BAihtVG3KAVFMV7YNDPPM6mkD8xREWURcidxMHRmN6pg937Zxn-SlVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30DzIDvLtFvANGIDYalCdjP_uzJgmZUg3WksJisuojaw&oe=69F36F56"}, {"file_name": "image4-zebras.png", "id": "1474354487317075", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310651_1474354490650408_4168006281559481016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_ljlZp-1dsQ7kNvwGgGst3&_nc_oc=AdptELJ-TZ4cUya8v9-a9u2UKzSCY8DzOcQbgq2B90YO87EotPdPxptnYE_SZGn_GCk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uFARF3Ha1WQ8wg0YSw3wVcsw2gR3VaF-kwNVhqIJC6A&oe=69F361B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 - PNG.png", "id": "1515573886276711", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310804_1515573889610044_4448593629849793003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvmkLvqogSUQ7kNvwFgoXAQ&_nc_oc=Adoqf8Cxl5JaQtt17TqrokScs3b1GwkbsKgrdB5YbJzlJ6_JseoUAtkYAPtGlWx7LCQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yC7Lkob_myHwnPyCeWFU4BbS-6KeztxVaJyq7kBdxoA&oe=69F36FA7"}, "display_name": "Animal Hunter", "keywords": ["AnimalHunterVR", "HuntingSimulatorVR", "WildlifeAdventure", "SurvivalShooterVR", "OutdoorAdventureVR"], "long_description": "Animal Hunter takes you straight into the heart of nature, where adrenaline and adventure meet. With realistic graphics and fun gameplay mechanics, every mission brings new challenges that put your skills to the test in thrilling encounters with wildlife.\n\nFace animals such as lions, hippos, wild boars, crocodiles, deer, rabbits, and a wide variety of birds. The experience feels immersive and exciting, giving you the sensation of being in a living, breathing wilderness.\n\nSurvival depends on precision, quick reflexes, and smart decision-making. From stealthy approaches to fast reactions in intense encounters, Animal Hunter blends action and strategy to keep the excitement high.\n\nWhether you\u2019re exploring on your own or seeking new challenges, Animal Hunter delivers an unforgettable adventure in the wild. Get ready to test your limits, sharpen your aim, and feel the thrill of the hunt like never before!", "short_description": "If you enjoy adrenaline and adventure, Animal Hunter is your game! Explore wild landscapes and face thrilling challenges with lions, hippos, wild boars, crocodiles, deer, rabbits, and a variety of birds. Realistic graphics and fun gameplay make each mission exciting, where survival skills and precision define success. Get ready for unforgettable adventures in the wild!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-animal-hunter", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
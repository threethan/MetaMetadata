1-25/499298281_1387631746245825_290226088165823395_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WPertuDtCoQ7kNvwETScIJ&_nc_oc=Adpo4QdzwaLVshAx96vdo7sNVhjYnGvsz3d21ia4AtaOrlG_HdvZbxNBAFjbeMBv7OA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIQUD_V5x56N0M7ceNXmkM4u4c6ebWUB9sIeuTK51R8w&oe=6ACF8A58"}, {"file_name": "cabinet_overhead.png", "id": "1022604437246181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_1022604440579514_5452817108904867000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9JaVm4u2dIQ7kNvwHwyVO3&_nc_oc=AdpwcJ_K8ZwdqdZfb6fzEpMx4IGCgZex9idN-hOkAA6kMu4jutZJwREIlwYedRdaiiQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP420bLCGVNsucuIistAqK4n4Gpe58M0LL5pdsUivbskg&oe=6ACFA144"}, {"file_name": "delivery_tray_slope.png", "id": "1774918340307582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623565_1774918343640915_5562253993908911589_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPPmAureFRUQ7kNvwEIgqIU&_nc_oc=Adp1VzMIQvwyy-Zop51fqCb-ccbjXl1p4szfmCp7lwHSF5FVgNdfc33BiYnMgHCLLRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWXYjTFAyx3-JsEoK-F6xguwOxKFiEvvMuXTKF-2qIxw&oe=6ACFB073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2144441573157966", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623443_2144441576491299_6029004986333814593_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgWlAn2OXXcQ7kNvwEvZa8I&_nc_oc=AdreiPzS4xXYBEncXV9OiephcMQR4tyVq50_Ay76OlxftZw3Es7ZExyv9yR9s9f6TG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZPWgnWlxQvqBurwHF21CCpHD_EkOsnQkxm9YSkyi5NQ&oe=6ACFBA01"}, "display_name": "Goton - Crane Game Simulator", "keywords": ["arcade", "prize", "simulator", "claw", "crane"], "long_description": "A VR simulator that recreates the arcade claw machine down to the smallest detail.\n\nThe arm flexes, the claw grips with realistic friction, and boxes slide and tumble the way they do in a real cabinet. Real-world techniques work here: nudge prizes toward the chute, tip boxes over the edge, slip the claw into gaps.\n\n- Take on more than 100 quests with a wide range of prizes and difficulties\n- Display everything you win in your collection\n- Switch viewpoints and height freely - comfortable to play seated or standing\n- Fully offline, no ads, no in-app purchases\n\nNo lines, no closing time, no coins down the drain. That satisfying \"thunk\" of a prize dropping - now at home.", "short_description": "A crane game that moves like the real thing. Aim, grab, and drop your way to victory with lifelike claw physics, and clear over 100 quests as you build your prize collection."}, {"images": {"nodes": []}, "id": "1401011542126516", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goton - \ud06c\ub808\uc778 \uac8c\uc784 \uc2dc\ubbac\ub808\uc774\ud130", "keywords": ["\uc778\ud615\ubf51\uae30", "\ud06c\ub808\uc778\uac8c\uc784", "\uc544\ucf00\uc774\ub4dc", "\uacbd\ud488", "\uc2dc\ubbac\ub808\uc774\ud130"], "long_description": "\uc624\ub77d\uc2e4 \uc778\ud615\ubf51\uae30\ub97c \uc138\ubd80\uae4c\uc9c0 \uc2e4\uae30 \uadf8\ub300\ub85c \uc7ac\ud604\ud55c VR \uc2dc\ubbac\ub808\uc774\ud130\uc785\ub2c8\ub2e4.\n\n\uc554\uc774 \ud718\uc5b4\uc9c0\uace0, \uc9d1\uac8c\uc5d0\ub294 \uc2e4\uc81c \uac19\uc740 \ub9c8\ucc30\uc774 \uc788\uc73c\uba70, \uc0c1\uc790\ub294 \uc2e4\uae30\ucc98\ub7fc \ubbf8\ub044\ub7ec\uc9c0\uace0 \ub118\uc5b4\uc9d1\ub2c8\ub2e4. \uc2e4\uc804 \ud14c\ud06c\ub2c9\uc774 \uadf8\ub300\ub85c \ud1b5\ud569\ub2c8\ub2e4: \uacbd\ud488\uc744 \ub099\ud558\uad6c \ucabd\uc73c\ub85c \ubc00\uae30, \uc0c1\uc790\ub97c \ubaa8\uc11c\ub9ac \ub108\uba38\ub85c \uae30\uc6b8\uc774\uae30, \ud2c8\uc0c8\uc5d0 \uc9d1\uac8c \ucc14\ub7ec \ub123\uae30.\n\n- 100\uac1c\uac00 \ub118\ub294 \ud018\uc2a4\ud2b8\uc5d0 \ub3c4\uc804, \ub2e4\uc591\ud55c \uacbd\ud488\uacfc \ub09c\uc774\ub3c4\n- \ud68d\ub4dd\ud55c \uacbd\ud488\uc740 \uceec\ub809\uc158\uc73c\ub85c \uc9c4\uc5f4 \uac00\ub2a5\n- \uc2dc\uc810 \uc704\uce58\uc640 \ub192\uc774\ub97c \uc790\uc720\ub86d\uac8c \uc804\ud658, \uc549\uc544\uc11c\ub3c4 \ud3b8\ud558\uac8c \ud50c\ub808\uc774\n- \uc644\uc804 \uc624\ud504\ub77c\uc778, \uad11\uace0 \uc5c6\uc74c, \uc778\uc571 \uacb0\uc81c \uc5c6\uc74c\n\n\uc904 \uc11c\uc9c0 \uc54a\uace0, \ub9c8\uac10 \uc2dc\uac04 \uac71\uc815 \uc5c6\uc774, \ub3d9\uc804 \ub0ad\ube44\ub3c4 \uc5c6\uc774. \uacbd\ud488\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uadf8 \"\ucff5\" \uc18c\ub9ac\ub97c \uc9d1\uc5d0\uc11c.", "short_description": "\uc2e4\uae30 \uac19\uc740 \ubb3c\ub9ac\ub85c \uc990\uae30\ub294 VR \uc778\ud615\ubf51\uae30. \uc870\uc900\ud558\uace0, \uc9d1\uace0, \ub5a8\uc5b4\ub728\ub824 \ud68d\ub4dd\ud558\uc138\uc694. 100\uac1c\uac00 \ub118\ub294 \ud018\uc2a4\ud2b8\ub97c \ud074\ub9ac\uc5b4\ud558\uba70 \uacbd\ud488\uc744 \ubaa8\uc544\ubcf4\uc138\uc694."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hypnos.co.jp/privacy-policy-goton/", "developer_terms_of_service_url": null, "publisher_name": "Hypnos Co., Ltd.", "support_website_url": null, "website_url": "https://hypnos.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "zh_HK", "zh_TW", "ko", "fr", "fr_CA", "fr_BE", "de", "en_US", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE
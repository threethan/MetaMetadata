=Adr0oiZ9kP0ESWGUvq2zqfD58FwjcTnpw43BEbp8RHMbAZUHXgvqoKppdAXs067rufE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2MiNbQWuv-f3qKV14MIAgF-paJ7HYwq_ooRI823YgXA&oe=6A99A2F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2144441573157966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623443_2144441576491299_6029004986333814593_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T7zuFOofoUQ7kNvwEOOuII&_nc_oc=AdoyX5UiHokPUDTsz3UQ217ITj3Ofj7RHjCivJN0EsaeF7KHIJqzb_fHKS8FUaXoXfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC_ELphcGGAjYCfAjHDbDZjNg-fowCNJMVM2RdjIhRbA&oe=6A997441"}, "display_name": "Goton - Crane Game Simulator", "keywords": ["arcade", "prize", "simulator", "claw", "crane"], "long_description": "A VR simulator that recreates the arcade claw machine down to the smallest detail.\n\nThe arm flexes, the claw grips with realistic friction, and boxes slide and tumble the way they do in a real cabinet. Real-world techniques work here: nudge prizes toward the chute, tip boxes over the edge, slip the claw into gaps.\n\n- Take on more than 100 quests with a wide range of prizes and difficulties\n- Display everything you win in your collection\n- Switch viewpoints and height freely - comfortable to play seated or standing\n- Fully offline, no ads, no in-app purchases\n\nNo lines, no closing time, no coins down the drain. That satisfying \"thunk\" of a prize dropping - now at home.", "short_description": "A crane game that moves like the real thing. Aim, grab, and drop your way to victory with lifelike claw physics, and clear over 100 quests as you build your prize collection."}, {"images": {"nodes": []}, "id": "1401011542126516", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goton - \ud06c\ub808\uc778 \uac8c\uc784 \uc2dc\ubbac\ub808\uc774\ud130", "keywords": ["\uc778\ud615\ubf51\uae30", "\ud06c\ub808\uc778\uac8c\uc784", "\uc544\ucf00\uc774\ub4dc", "\uacbd\ud488", "\uc2dc\ubbac\ub808\uc774\ud130"], "long_description": "\uc624\ub77d\uc2e4 \uc778\ud615\ubf51\uae30\ub97c \uc138\ubd80\uae4c\uc9c0 \uc2e4\uae30 \uadf8\ub300\ub85c \uc7ac\ud604\ud55c VR \uc2dc\ubbac\ub808\uc774\ud130\uc785\ub2c8\ub2e4.\n\n\uc554\uc774 \ud718\uc5b4\uc9c0\uace0, \uc9d1\uac8c\uc5d0\ub294 \uc2e4\uc81c \uac19\uc740 \ub9c8\ucc30\uc774 \uc788\uc73c\uba70, \uc0c1\uc790\ub294 \uc2e4\uae30\ucc98\ub7fc \ubbf8\ub044\ub7ec\uc9c0\uace0 \ub118\uc5b4\uc9d1\ub2c8\ub2e4. \uc2e4\uc804 \ud14c\ud06c\ub2c9\uc774 \uadf8\ub300\ub85c \ud1b5\ud569\ub2c8\ub2e4: \uacbd\ud488\uc744 \ub099\ud558\uad6c \ucabd\uc73c\ub85c \ubc00\uae30, \uc0c1\uc790\ub97c \ubaa8\uc11c\ub9ac \ub108\uba38\ub85c \uae30\uc6b8\uc774\uae30, \ud2c8\uc0c8\uc5d0 \uc9d1\uac8c \ucc14\ub7ec \ub123\uae30.\n\n- 100\uac1c\uac00 \ub118\ub294 \ud018\uc2a4\ud2b8\uc5d0 \ub3c4\uc804, \ub2e4\uc591\ud55c \uacbd\ud488\uacfc \ub09c\uc774\ub3c4\n- \ud68d\ub4dd\ud55c \uacbd\ud488\uc740 \uceec\ub809\uc158\uc73c\ub85c \uc9c4\uc5f4 \uac00\ub2a5\n- \uc2dc\uc810 \uc704\uce58\uc640 \ub192\uc774\ub97c \uc790\uc720\ub86d\uac8c \uc804\ud658, \uc549\uc544\uc11c\ub3c4 \ud3b8\ud558\uac8c \ud50c\ub808\uc774\n- \uc644\uc804 \uc624\ud504\ub77c\uc778, \uad11\uace0 \uc5c6\uc74c, \uc778\uc571 \uacb0\uc81c \uc5c6\uc74c\n\n\uc904 \uc11c\uc9c0 \uc54a\uace0, \ub9c8\uac10 \uc2dc\uac04 \uac71\uc815 \uc5c6\uc774, \ub3d9\uc804 \ub0ad\ube44\ub3c4 \uc5c6\uc774. \uacbd\ud488\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uadf8 \"\ucff5\" \uc18c\ub9ac\ub97c \uc9d1\uc5d0\uc11c.", "short_description": "\uc2e4\uae30 \uac19\uc740 \ubb3c\ub9ac\ub85c \uc990\uae30\ub294 VR \uc778\ud615\ubf51\uae30. \uc870\uc900\ud558\uace0, \uc9d1\uace0, \ub5a8\uc5b4\ub728\ub824 \ud68d\ub4dd\ud558\uc138\uc694. 100\uac1c\uac00 \ub118\ub294 \ud018\uc2a4\ud2b8\ub97c \ud074\ub9ac\uc5b4\ud558\uba70 \uacbd\ud488\uc744 \ubaa8\uc544\ubcf4\uc138\uc694."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hypnos.co.jp
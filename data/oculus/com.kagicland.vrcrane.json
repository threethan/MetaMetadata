v/t64.5771-25/499623565_1774918343640915_5562253993908911589_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt8N0perCAUQ7kNvwFH1spL&_nc_oc=Adr0oiZ9kP0ESWGUvq2zqfD58FwjcTnpw43BEbp8RHMbAZUHXgvqoKppdAXs067rufE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2MiNbQWuv-f3qKV14MIAgF-paJ7HYwq_ooRI823YgXA&oe=6A99A2F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2144441573157966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623443_2144441576491299_6029004986333814593_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T7zuFOofoUQ7kNvwEOOuII&_nc_oc=AdoyX5UiHokPUDTsz3UQ217ITj3Ofj7RHjCivJN0EsaeF7KHIJqzb_fHKS8FUaXoXfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC_ELphcGGAjYCfAjHDbDZjNg-fowCNJMVM2RdjIhRbA&oe=6A997441"}, "display_name": "Goton - Crane Game Simulator", "keywords": ["arcade", "prize", "simulator", "claw", "crane"], "long_description": "A VR simulator that recreates the arcade claw machine down to the smallest detail.\n\nThe arm flexes, the claw grips with realistic friction, and boxes slide and tumble the way they do in a real cabinet. Real-world techniques work here: nudge prizes toward the chute, tip boxes over the edge, slip the claw into gaps.\n\n- Take on more than 100 quests with a wide range of prizes and difficulties\n- Display everything you win in your collection\n- Switch viewpoints and height freely - comfortable to play seated or standing\n- Fully offline, no ads, no in-app purchases\n\nNo lines, no closing time, no coins down the drain. That satisfying \"thunk\" of a prize dropping - now at home.", "short_description": "A crane game that moves like the real thing. Aim, grab, and drop your way to victory with lifelike claw physics, and clear over 100 quests as you build your prize collection."}, {"images": {"nodes": []}, "id": "1401011542126516", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, 
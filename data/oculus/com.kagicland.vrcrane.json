1-25/499622211_1578096123865689_7370663600678832389_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o-guuMcPE4Q7kNvwF1-Aqa&_nc_oc=Adq9mzU1ABqqU4OwMUJ-_AF5-s94umqJ4ZoEvDOelnSZ0SG8iLKWH51_hPiGSHcx27A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsm_fyqT_pNLJBwFJxytjudTBWNEUIS3cnJVkhmnB6Dg&oe=6AE36341"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Goton - Crane Game Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1787281140, "lastRevision": {"nodes": [{"id": "1251743388028573", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1251743328028579", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "927368769802868"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4404895809826758", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goton - \u6293\u5a03\u5a03\u673a\u6a21\u62df\u5668", "keywords": ["\u6293\u5a03\u5a03\u673a", "\u5a03\u5a03\u673a", "\u8857\u673a", "\u5956\u54c1", "\u6a21\u62df\u5668"], "long_description": "\u4e00\u6b3e\u5c06\u8857\u673a\u6293\u5a03\u5a03\u673a\u8fd8\u539f\u5230\u6bcf\u4e2a\u7ec6\u8282\u7684VR\u6a21\u62df\u5668\u3002\n\n\u673a\u68b0\u81c2\u4f1a\u5f2f\u66f2\uff0c\u722a\u5b50\u6709\u771f\u5b9e\u7684\u6469\u64e6\u529b\uff0c\u76d2\u5b50\u4f1a\u50cf\u771f\u673a\u91cc\u4e00\u6837\u6ed1\u52a8\u7ffb\u5012\u3002\u771f\u5b9e\u4e16\u754c\u7684\u6280\u5de7\u5728\u8fd9\u91cc\u540c\u6837\u6709\u6548\uff1a\u628a\u5956\u54c1\u63a8\u5411\u843d\u53e3\u3001\u8ba9\u76d2\u5b50\u7ffb\u8fc7\u8fb9\u7f18\u3001\u628a\u722a\u5c16\u63d2\u8fdb\u7f1d\u9699\u3002\n\n- \u6311\u6218100\u591a\u4e2a\u4efb\u52a1\uff0c\u5956\u54c1\u4e0e\u96be\u5ea6\u4e30\u5bcc\u591a\u6837\n- \u8d62\u5f97\u7684\u5956\u54c1\u90fd\u53ef\u4ee5\u9648\u5217\u5728\u4f60\u7684\u6536\u85cf\u4e2d\n- \u89c6\u89d2\u4f4d\u7f6e\u4e0e\u9ad8\u5ea6\u81ea\u7531\u5207\u6362\uff0c\u5750\u7740\u73a9\u4e5f\u5f88\u8212\u9002\n- \u5b8c\u5168\u79bb\u7ebf\uff0c\u65e0\u5e7f\u544a\uff0c\u65e0\u5185\u8d2d\n\n\u4e0d\u7528\u6392\u961f\uff0c\u4e0d\u53d7\u6253\u70ca\u65f6\u95f4\u9650\u5236\uff0c\u4e5f\u4e0d\u518d\u6d6a\u8d39\u6e38\u620f\u5e01\u3002\u5956\u54c1\u843d\u4e0b\u7684\u90a3\u58f0\"\u549a\"\uff0c\u5728\u5bb6\u5c31\u80fd\u542c\u5230\u3002", "short_description": "\u7269\u7406\u6548\u679c\u5ab2\u7f8e\u771f\u673a\u7684VR\u6293\u5a03\u5a03\u673a\u3002\u7784\u51c6\u3001\u6293\u53d6\u3001\u6295\u843d\u8d62\u53d6\u5956\u54c1\uff0c\u6311\u6218100\u591a\u4e2a\u4efb\u52a1\uff0c\u6536\u96c6\u5c5e\u4e8e\u4f60\u7684\u6218\u5229\u54c1\u3002"}, {"images": {"nodes": []}, "id": "3765499556926016", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goton - Crane Game Simulator", "keywords": ["Greifautomat", "Kranspiel", "Arcade", "Simulator", "Automat"], "long_description": "Ein VR-Simulator, der den Arcade-Greifautomaten bis ins kleinste Detail nachbildet.\n\nDer Arm federt, der Greifer packt mit realistischer Reibung, und Boxen rutschen und kippen wie im echten Automaten. Echte Tricks funktionieren auch hier: Preise zum Schacht schieben, Boxen \u00fcber die Kante kippen, den Greifer in L\u00fccken schieben.\n\n- \u00dcber 100 Quests mit vielf\u00e4ltigen Preisen und Schwierigkeitsgraden\n- Alle Gewinne landen in deiner Sammlung\n- Blickwinkel und H\u00f6he frei w\u00e4hlbar - bequem im Sitzen oder Stehen\n- Komplett offline, keine Werbung, keine In-App-K\u00e4ufe\n\nKeine Schlange, kein Ladenschluss, keine verlorenen M\u00fcnzen. Dieses befriedigende \"Plopp\" des fallenden Preises - jetzt zuhause.", "short_description": "Ein Greifautomat, der sich wie echt anf\u00fchlt. Zielen, greifen, fallen lassen - mit realistischer Physik \u00fcber 100 Quests meistern und die Preissammlung f\u00fcllen."}, {"images": {"nodes": []}, "id": "1697974928387594", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30b4\u30c8\u30f3 - \u30af\u30ec\u30fc\u30f3\u30b2\u30fc\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc", "keywords": ["\u30af\u30ec\u30fc\u30f3\u30b2\u30fc\u30e0", "\u30af\u30ec\u30fc\u30f3", "\u30a2\u30fc\u30b1\u30fc\u30c9", "\u666f\u54c1", "\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc"], "long_description": "\u30b2\u30fc\u30e0\u30bb\u30f3\u30bf\u30fc\u306e\u30af\u30ec\u30fc\u30f3\u30b2\u30fc\u30e0\u3092\u3001\u7d30\u90e8\u307e\u3067\u5b9f\u6a5f\u3055\u306a\u304c\u3089\u306b\u518d\u73fe\u3057\u305fVR\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u3067\u3059\u3002\n\n\u30a2\u30fc\u30e0\u306e\u3057\u306a\u308a\u3001\u722a\u3068\u666f\u54c1\u306e\u6469\u64e6\u3001\u7bb1\u306e\u6ed1\u308a\u3084\u3059\u3055\u307e\u3067\u7269\u7406\u6319\u52d5\u3092\u4f5c\u308a\u8fbc\u307f\u307e\u3057\u305f\u3002\u30c1\u30fc\u30c8\u306a\u3057\u306e\u6b63\u653b\u6cd5\u2014\u2014\u62bc\u3057\u8fbc\u307f\u3001\u305a\u3089\u3057\u3001\u9699\u9593\u3078\u306e\u5dee\u3057\u8fbc\u307f\u2014\u2014\u304c\u3001\u5b9f\u6a5f\u3068\u540c\u3058\u3088\u3046\u306b\u901a\u7528\u3057\u307e\u3059\u3002\n\n\u30fb100\u7a2e\u985e\u3092\u8d85\u3048\u308b\u30af\u30a8\u30b9\u30c8\u306b\u6311\u6226\u3002\u666f\u54c1\u3082\u96e3\u6613\u5ea6\u3082\u3055\u307e\u3056\u307e\n\u30fb\u7372\u5f97\u3057\u305f\u666f\u54c1\u306f\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u3068\u3057\u3066\u98fe\u308c\u308b\n\u30fb\u8996\u70b9\u306f\u597d\u307f\u306e\u4f4d\u7f6e\u3068\u9ad8\u3055\u306b\u5207\u308a\u66ff\u3048\u53ef\u80fd\u3002\u5ea7\u3063\u305f\u307e\u307e\u3067\u3082\u5feb\u9069\u306b\u30d7\u30ec\u30a4\n\u30fb\u30aa\u30d5\u30e9\u30a4\u30f3\u3067\u5b8c\u7d50\u3002\u5e83\u544a\u306a\u3057\u3001\u8ffd\u52a0\u8ab2\u91d1\u306a\u3057\n\n\u4f55\u5ea6\u3067\u3082\u3001\u5f85\u3061\u6642\u9593\u306a\u3057\u3067\u3001\u9589\u5e97\u6642\u9593\u3082\u6c17\u306b\u305b\u305a\u306b\u3002\u3042\u306e\u300c\u30b4\u30c8\u30f3\u300d\u3068\u3044\u3046\u97f3\u3092\u3001\u81ea\u5b85\u3067\u3002", "short_description": "\u672c\u7269\u305d\u3063\u304f\u308a\u306e\u7269\u7406\u6319\u52d5\u3067\u697d\u3057\u3080VR\u30af\u30ec\u30fc\u30f3\u30b2\u30fc\u30e0\u3002\u72d9\u3063\u3066\u3001\u63b4\u3093\u3067\u3001\u843d\u3068\u3057\u3066\u7372\u5f97\u3002100\u7a2e\u985e\u3092\u8d85\u3048\u308b\u30af\u30a8\u30b9\u30c8\u3092\u30af\u30ea\u30a2\u3057\u3066\u3001\u666f\u54c1\u3092\u96c6\u3081\u3088\u3046\u3002"}, {"images": {"nodes": []}, "id": "1665842025161084", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goton - Crane Game Simulator", "keywords": ["pince", "grue", "arcade", "peluche", "simulateur"], "long_description": "Un simulateur VR qui recr\u00e9e la machine \u00e0 pince d'arcade dans les moindres d\u00e9tails.\n\nLe bras fl\u00e9chit, la pince agrippe avec une friction r\u00e9aliste, et les bo\u00eetes glissent et basculent comme dans une vraie machine. Les techniques du monde r\u00e9el fonctionnent ici : poussez les prix vers la goulotte, faites basculer les bo\u00eetes, glissez la pince dans les interstices.\n\n- Plus de 100 qu\u00eates avec des prix et des difficult\u00e9s vari\u00e9s\n- Exposez tous vos gains dans votre collection\n- Changez librement de point de vue et de hauteur - confortable assis ou debout\n- Enti\u00e8rement hors ligne, sans pub, sans achats int\u00e9gr\u00e9s\n\nSans file d'attente, sans heure de fermeture, sans jetons gaspill\u00e9s. Ce \"toc\" satisfaisant du prix qui tombe - d\u00e9sormais chez vous.", "short_description": "Un jeu de grue au r\u00e9alisme saisissant. Visez, attrapez, l\u00e2chez pour gagner. Plus de 100 qu\u00eates \u00e0 relever en b\u00e2tissant votre collection de prix."}, {"images": {"nodes": [{"file_name": "hero.png", "id": "4762108817408583", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622325_4762108820741916_7879399921466004462_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eZ4sBTi_MYQ7kNvwEHiIkp&_nc_oc=AdrvpRpbapCUO8Dyd6atfAM-iELAENoU_yCMTQ76iBBV4x8yurCq2vLZX0MUocK5JyY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsJuF7SIsFnMPDEYBEn4EPyuDyc0Csb28V-9axWREaYQ&oe=6AE362DD"}, {"file_name": "background.png", "id": "2270205563810808", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620384_2270205567144141_2508689161450064355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIGtY4WfvMgQ7kNvwFCq56c&_nc_oc=AdrwZyY3ki5bpyva4vM2ANy24nbDRZ3M3qFIe4gfsEdlLtS2tWt211iucT5ApzYtyZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW9Dyxwmd5OsDgB_f2f6xODtiT_R7nlMGQuV_O1zO4cA&oe=6AE36DBE"}, {"file_name": "foreground.png", "id": "1679493117165748", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619704_1679493120499081_3959554190581758276_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaWKLXBSC1wQ7kNvwEHTg4Q&_nc_oc=AdqAe15JP_vrN2bt7rVFGNyhQJVzk79cQTo8oPJd6W_GW2BodubJVaBFOx2XmzuJ2-c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMylWL20aiaAsfNIUeBDAQzJpXXcnXNyCG91d8fiEwf2w&oe=6AE337E0"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1664748895237552", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499295279_1664748898570885_2261735669920515028_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NeqIDYqp4kQ7kNvwGNmx4a&_nc_oc=Adq9BJjRT-9gD9ZlqKav-eAb0A39c2jb18T6gIC52xsZNSDWBNBpugvsIkNuMA7lB5I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObRaHZCA124KKhP2fxZaw-_uLy
ursing schools across the country, SimX is the most advanced VR medical training system.", "short_description": "SimX is the first professional-grade wireless, multiplayer VR medical training simulation. Physicians, nurses, and allied professionals can learn their skills on any virtual patient in any environment. Designed by physicians at Stanford and UCSF and already in use at top medical and nursing schools across the country, SimX is the most advanced VR medical training system. "}]}, "developer_name": "SimX, Inc.", "developer_privacy_policy_url": "https://www.simxvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimX, Inc.", "support_website_url": null, "website_url": "https://www.simxvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24908582225464721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827712_1019627489598552_1438862653151717781_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOqutNBEjW8Q7kNvwFJeh7-&_nc_oc=Adk2u-oVhN_9p3vJTKzEJd6FHnfFqBYvISieKKkTXgkl3gv67_JdsPG97LqKg-sIdaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkSePtlcHhn7n7HHQ9iO3pbVfe1lF__6Mlco06r5etow&oe=69B2A3D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SimX VR (2025
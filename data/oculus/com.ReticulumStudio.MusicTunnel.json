s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1tnqWf8zPUQ7kNvwFy7ntm&_nc_oc=AdpKzH53bxOMb1_EuPm_MJhWfPcC8JguktQ4X_UTli6OeOessb3l59zN-6gcLh5jKmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThXkRrujTriwQ9WA4M8ftBal_ogN1iH61h_M99aaoErw&oe=6AFF19D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Music_Tunnel_Lanscape_2560x1440.png", "id": "1475788907472696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820441_1475788910806029_2674395800550827469_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veEXr15kCgwQ7kNvwFaInsK&_nc_oc=AdomH5fPYMg80Gl8OSzhuLr7KtQ5KuatSV_GMBRGYthWHLnp0gVVyn4tOmKfnZA9yuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSku0cI4NtM2PLMlFH2Y5Wgk6PfGwA0A58OWcMFbEN9jQ&oe=6AFF2F0C"}, "display_name": "Music Tunnel", "keywords": ["Music", "rhythm", "tile", "beat", "dance"], "long_description": "Enter Music Tunnel \u2014 a next-generation VR music tile game where rhythm surrounds you.\n\nUnlike traditional mobile tile games where tiles move on a flat screen, Music Tunnel places you inside a glowing hexagonal tunnel. Music tiles move across every inner side of the tunnel, forcing you to react in full 360\u00b0 space. Look around. Move your body. Listen to the music. Follow the beat.\n\nHit tiles to the rhythm and release energy from your hands to burn them away. Choose male or female hands and customize your experience with powerful visual effects that feel like casting music energy.\n\nWhether you want a light dance session or an intense cardio workout, Music Tunnel delivers:\n\u2022 4 difficulty levels \u2014 Easy, Normal, Hard, Expert\n\u2022 Slow and Fast modes for different rhythm intensity\n\u2022 Active gameplay that burns calories and keeps you moving\n\u2022 Competitive leaderboards for every level of every song\n\nMusic Tunnel is not just a rhythm game \u2014 it\u2019s movement, music, and immersion combined. Train your reflexes, improve coordination, and feel every beat in VR.\n\nComing Soon \u2014 add Music Tunnel to your wishlist and be ready to enter the tunnel.", "short_description": "Music Tunnel is a high-energy VR rhythm game where music tiles move through a hexagonal tunnel around you. \n\nHit tiles to the beat, burn calories, and feel the rhythm in full 360\u00b0 motion. \n\nChoose difficulty, speed modes, hand effects, and compete on leaderboards. \n\nDance, move, and master the tunnel. \n\nAdd Music Tunnel to your wishlist now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://reticulum.studio/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Reticulum Studio", "support_website_url": "https://reticulum.studio/Contacts", "website_url": "https://reticulum.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24925388887082042"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1393001149002585"}, {"status": "CANCELLED", "id": "3114183978785094"}, {"status": "PUBLISHED", "id": "894765916768834"}, {"status": "PUBLISHED", "id": "1791937278901747"}, {"status": "PUBLISHED", "id": "27448385951489157"}, {"status": "PUBLISHED", "id": "2283040092454591"}, {"status": "PUBLISHED", "id": "965612489146861"}]}, "baseline_offer": {"id": "1791937278901747"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "139
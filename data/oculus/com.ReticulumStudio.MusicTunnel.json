=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MFwgH4N0P0aZOUyU7rfyIz3yvcj9fNDf_qEAPlTKOBg&oe=6A3A8D88"}, {"file_name": "Screenshots3.png", "id": "945830051346842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_945830054680175_4288566859527737109_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSjX9p6jNKoQ7kNvwEfHdCk&_nc_oc=AdruEeu0Os3sZeIQzgiQFsxJ8EG6Z7oIW0ShVdpMwlDVxMZQsxxHGuqs8wzUjsMKOG8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jqmQr3-IzQsEX2cJt6bMrWRAkrSRON3OgSCIvsRSKZg&oe=6A3A9585"}, {"file_name": "Screenshots4.png", "id": "1468576828178174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821696_1468576831511507_1602839011818253749_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3sz0pm_GeEQ7kNvwFFdfZN&_nc_oc=Adr_KCde3af6jkmYJb0PLzmHmCA680b9IKB21gWqyBPlV0e3b2VpDlO-dfKFEmhf64o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RH-POWgLkt9thxyv8Lh9KlQNmZqeceEm8uXd6GZd-sw&oe=6A3A8596"}, {"file_name": "Screenshots5.png", "id": "799968932496040", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_799968935829373_8467684968231925258_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7EwT9xa9nsQ7kNvwEXAgj8&_nc_oc=AdoU3JtcvtQeVD7_fr0qvHbFjBzbGYMCq8hDMFshV5fOB3Zf-DjcqOcQSW9CPr6FXM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Jr6cvtN7Y6CSaXSHAGjrvHU-w5YwgnLxFZ16g1cJvlw&oe=6A3AAA59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Music_Tunnel_Lanscape_2560x1440.png", "id": "1475788907472696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1475788910806029_2674395800550827469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a4m2KlgUTEQ7kNvwFKcUvi&_nc_oc=Adr_T0SJ95Fe_ZmgIE3vAsbvAzqaYAFcd9wTFuWNa4EMab1Vw3_obr1_Xs3Ghm4fPXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JCy4VyQYSPTxaoDQxhabdufcd9PJO7rgWMxNOKW01KA&oe=6A3A874C"}, "display_name": "Music Tunnel", "keywords": ["Music", "rhythm", "tile", "beat", "dance"], "long_description": "Enter Music Tunnel \u2014 a next-generation VR music tile game where rhythm surrounds you.\n\nUnlike traditional mobile tile games where tiles move on a flat screen, Music Tunnel places you inside a glowing hexagonal tunnel. Music tiles move across every inner side of the tunnel, forcing you to react in full 360\u00b0 space. Look around. Move your body. Listen to the music. Follow the beat.\n\nHit tiles to the rhythm and release energy from your hands to burn them away. Choose male or female hands and customize your experience with powerful visual effects that feel like casting music energy.\n\nWhether you want a light dance session or an intense cardio workout, Music Tunnel delivers:\n\u2022 4 difficulty levels \u2014 Easy, Normal, Hard, Expert\n\u2022 Slow and Fast modes for different rhythm intensity\n\u2022 Active gameplay that burns calories and keeps you moving\n\u2022 Competitive leaderboards for every level of every song\n\nMusic Tunnel is not just a rhythm game \u2014 it\u2019s movement, music, and immersion combined. Train your reflexes, improve coordination, and feel every beat in VR.\n\nComing Soon \u2014 add Music Tunnel to your wishlist and be ready to enter the tunnel.", "short_description": "Music Tunnel is a high-energy VR rhythm game where music tiles move through a hexagonal tunnel around you. \n\nHit tiles to the beat, burn calories, and feel the rhythm in full 360\u00b0 motion. \n\nChoose difficulty, speed modes, hand effects, and compete on leaderboards. \n\nDance, move, and master the tunnel. \n\nAdd Music Tunnel to your wishlist now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://reticulum.studio/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Reticulum Studio", "support_website_url": "https://reticulum.studio/Contacts", "website_url": "https://reticulum.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comf
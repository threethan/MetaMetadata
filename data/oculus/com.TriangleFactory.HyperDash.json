nt-atl3-2.oculuscdn.com&oh=00_Afs6WGLBfBz2k10I_vmz9_oF4fi970pI7z0Rk45TDNRu7g&oe=69A579FB"}, {"file_name": "Screenshot02.png", "id": "2844143979175919", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210888_2844143982509252_2266304723585096539_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4acbEoO3KMQ7kNvwFnWdZd&_nc_oc=Adl16jmEWj3sR3ioKQjapVNHr6ZBOheXeFZXzkXegL7s8b8Vu-DiQktR9196kdsuYQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsopJbIxmxz4wQyXUg511jKhGsp1QbUMK5EJnDNAGk0Hw&oe=69A59333"}, {"file_name": "Screenshot01.png", "id": "212968357216442", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974593_212968360549775_8534305649088085796_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDUjj4GsR1AQ7kNvwHrznto&_nc_oc=AdnyE70EzqdKTc4WUVtOC97WnmRjHXTbq14EujxFqynnYqWZ53cFfJB6wZkREEEUplM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftxUTyoMfba_s-6QBobn12RnuSxMEkVt3p8iO6Vj-B3Zg&oe=69A5766D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerOculus_2560x1440.png", "id": "1175000374010051", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392298_1175000377343384_1771980126494048581_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr32P86k7HEQ7kNvwHwWj8S&_nc_oc=AdkTS0BpMcWskKoK9fjh2Tyss3c9M83zIlv89JMy5sC137LVh3T7nf5RvyPVjlzLVXs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvs0rHgOde6FxEyjyN1pxSweMqOEn8RUP5KIha-MsEAig&oe=69A59215"}, "display_name": "Hyper Dash", "keywords": ["fps", "multiplayer", "fast", "unreal", "arena"], "long_description": "# \ud83d\ude80 Rail Grind Into the Ultimate VR Multiplayer Shooter: Hyper Dash\n\nStep into **Hyper Dash**, the free-to-play VR sensation where teamwork, speed, and strategy collide. Experience pulse-pounding action across diverse maps and game modes that will keep you coming back for more!\n\n\ud83c\udfc3**Master the Art of Movement**\n\nSpeed and agility are your greatest allies. Dash, sprint, and rail grind your way through intense arenas, outmanoeuvring opponents and securing objectives to lead your team to victory. \n\n\ud83c\udfaf**Endless Game Modes, Infinite Fun**\n\nChallenge yourself across different game modes, including:\n- Payload \n- Domination \n- Control Point \n- (Team) Deathmatch \n- Capture the Flag \n- Elimination \n- Ball \n\nMix it up by adding mutators -like Instagib or Low Gravity- to your custom matches or use the server browser to check out what others have created.\n\n\u23f1\ufe0f**Action Without the Wait**\n\nIn **Hyper Dash**, you can jump straight into the action. With compact maps, fast respawns, and steady pacing, the game ensures you spend less time waiting and more time immersed in the thrill of combat. It\u2019s designed for players who appreciate quick, engaging gameplay sessions.\n\n# \ud83c\udfae Ready to Dash?\n\nGet ready to dash, grind, and dominate in the most exhilarating VR shooter around. The arena awaits\u2014will you rise to the challenge? \n\n", "short_description": "Hyper Dash is the ultimate free-to-play VR shooter where speed and strategy collide. Dash, sprint, and rail grind your way to victory across compact arenas packed with fast-paced action. With diverse game modes like Payload and Capture the Flag, plus custom Mutators for endless variety, the action never stops. Designed for quick, thrilling matches, Hyper Dash lets you jump right into the fight. Are you ready to dominate the arena?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.hyperdashvr.com/", "developer_terms_of_service_url": "https://www.hyperdashvr.com/terms-of-use/", "publisher_name": "Triangle Factory", "support_website_url": null, "website_url": "https://hyperdashvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1023770785722696"}], "
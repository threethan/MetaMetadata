oGwgL1Llop-g-fOwxznDozO1hrwBFrOgf9bu-4LU37FobxbcVVegxXCB27TXmsptg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxEqjREzyLi33Vs8XyJoCBQ7RQgi50AlTVij62NUFE4Q&oe=6B0B30FB"}, {"file_name": "Screenshot02.png", "id": "2844143979175919", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210888_2844143982509252_2266304723585096539_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nvc1ijhoPGQQ7kNvwH8Rvnv&_nc_oc=Adr2Ji4xpb3A9cD-zVHwH_KuZq_iUYsf6l2IkeWzKeASye63s0_2TtD8uK1xzQL-9GY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS--cziyOaANkwE-dppmMxNvczHv6R4q7nhkmHzdHvQDQ&oe=6B0B11F3"}, {"file_name": "Screenshot01.png", "id": "212968357216442", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974593_212968360549775_8534305649088085796_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3frVDQm1lMQ7kNvwHW6irl&_nc_oc=AdoDUUvIU8nF5QHPwoGrgPnlnD2mc0Lg-ldgfmGPIpq4T37cR4-zuebiTZozXKOFq7U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlsGpRyBCbcGzFDULVxVcBBMzsnoEq06qXHa-bBHL0kg&oe=6B0B2D6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerOculus_2560x1440.png", "id": "1175000374010051", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392298_1175000377343384_1771980126494048581_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI5fMn3NbX4Q7kNvwGFl3AU&_nc_oc=AdqX6eQS12PhuHpZNR1bdloyXjcBBHSlSq7rAhv4oSj3R456zcHLGnNuoKBB8--PvMc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-LijxvEdC6agrRLQiPhtdVvhSTqQ44WYjYfVxQjMypg&oe=6B0B10D5"}, "display_name": "Hyper Dash", "keywords": ["fps", "multiplayer", "fast", "unreal", "arena"], "long_description": "# \ud83d\ude80 Rail Grind Into the Ultimate VR Multiplayer Shooter: Hyper Dash\n\nStep into **Hyper Dash**, the free-to-play VR sensation where teamwork, speed, and strategy collide. Experience pulse-pounding action across diverse maps and game modes that will keep you coming back for more!\n\n\ud83c\udfc3**Master the Art of Movement**\n\nSpeed and agility are your greatest allies. Dash, sprint, and rail grind your way through intense arenas, outmanoeuvring opponents and securing objectives to lead your team to victory. \n\n\ud83c\udfaf**Endless Game Modes, Infinite Fun**\n\nChallenge yourself across different game modes, including:\n- Payload \n- Domination \n- Control Point \n- (Team) Deathmatch \n- Capture the Flag \n- Elimination \n- Ball \n\nMix it up by adding mutators -like Instagib or Low Gravity- to your custom matches or use the server browser to check out what others have created.\n\n\u23f1\ufe0f**Action Without the Wait**\n\nIn **Hyper Dash**, you can jump straight into the action. With compact maps, fast respawns, and steady pacing, the game ensures you spend less time waiting and more time immersed in the thrill of combat. It\u2019s designed for players who appreciate quick, engaging gameplay sessions.\n\n# \ud83c\udfae Ready to Dash?\n\nGet ready to dash, grind, and dominate in the most exhilarating VR shooter around. The arena awaits\u2014will you rise to the challenge? \n\n", "short_description": "Hyper Dash is the ultimate free-to-play VR shooter where speed and strategy collide. Dash, sprint, and rail grind your way to victory across compact arenas packed with fast-paced action. With diverse game modes like Payload and Capture the Flag, plus custom Mutators for endless variety, the action never stops. Designed for quick, thrilling matches, Hyper Dash lets you jump right into the fight. Are you ready to dominate the arena?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.hyperdashvr.com/", "developer_terms_of_service_url": "https://www.hyperdashvr.com/terms-of-use/", "publisher_name": "Triangle Factory", "support_website_url": null, "website_url": "https://hyperdashvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_t
c_oc=AdqRaBH_MSOj-hDqvUv4mE0GLIV9M6Cmf4ctNDcWju7WPL2JdRMuUi2QTQDAtuP2ors&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHF1nSKsGBRSmfI6hG5O_Q8l3GAynGHGEnZcLPtTs2Sg&oe=6A8468B0"}, {"file_name": "DigiGods_Tuto_Buttons.00_21_47_50.Still020.png", "id": "1423214942562671", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823431_1423214945896004_9219491925936990162_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93f31iFuOisQ7kNvwGCy7nK&_nc_oc=AdoPKauLbr3epkAr7GgyAt8E_gs5HnX0y90PvA-BIrckhk7a6haErPZJfYmubN2xnt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPE_LELE1Nnni2ZlEKg-8qAMP7W0c9Dt3inb5jmHjKDg&oe=6A844184"}, {"file_name": "DigiGods_Tuto_Buttons.00_22_45_43.Still022.png", "id": "1219010566768909", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307479_1219010570102242_6933035360549527111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4giFP_-u4wcQ7kNvwH8iXi6&_nc_oc=Adrwh4L3MgQG9eOT3SCaoWqOAJofm4H8o7ZaicI4hL9VNEZcraU7Bnb4YOuYK313kig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4djLR3X2Mr4ASMAWI6Ot9_akKhdJ7KQrmWk6HHdSeqg&oe=6A8433A9"}, {"file_name": "DigiGods_Tuto_Buttons.00_22_06_41.Still021.png", "id": "855936300313698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300619_855936306980364_7367571528779449736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XbxIdoA3cYQ7kNvwFDT6HJ&_nc_oc=AdoxH5m9PcVIxGuiaJQ1eB_CAmWRXT-qIsqWvE0DJyMYxkHlOPvaCK3m0tadJYC1WOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIDzzBxApQebfrfvVgDa59LRSYckkOsPC1nb0PTowJcw&oe=6A8441A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpellCast", "keywords": ["wizard", "magic", "free", "social", "fantasy"], "long_description": "# Master the Arcane. Conquer the Dungeons.\n\nSpellCast is a fast-paced, dungeon-crawling VR adventure where you wield the magic. Sling powerful spells with your own hands, carve through waves of enemies, and face off against towering zone bosses!\n\nEquip unique spells, perks, and enchanted rings to shape your playstyle. Charge into battle solo or team up with friends for chaotic cooperative gameplay. Every run offers new dangers, new loot, and new ways to become a legendary spellcaster.\n\n**Key Features:**\n- \ud83c\udf0d Open World \u2013 Explore expanding environments and encounter smarter, deadlier enemies.\n- \ud83c\udff0 Explore Dungeons \u2013 Battle through 15 escalating difficulty tiers.\n- \ud83e\udd1d Co-op & Private Lobbies \u2013 Brave the chaos alone or with friends.\n- \ud83e\udde5 Wardrobe System \u2013 Customize your wizard\u2019s look with magical looks.\n- \u2728 Deep Magic Customization \u2013 Mix spells, perks, and ring buffs to master your craft.\n\nJoin the community, shape the future of the game, and experience the magic before anyone else. SpellCast is only getting stronger! ", "short_description": "SpellCast is a fast-paced, dungeon-crawling VR adventure where you wield the magic. Sling powerful spells with your own hands, carve through waves of enemies, and face off against towering zone bosses!\n\nEquip unique spells, perks, and enchanted rings to shape your playstyle. Charge into battle solo or team up with friends for chaotic cooperative gameplay. Every run offers new dangers, new loot, and new ways to become a legendary spellcaster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "https://www.squidostudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
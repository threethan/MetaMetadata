102242_6933035360549527111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuXD6eDShjoQ7kNvwGMzzaP&_nc_oc=AdqO9FUt2frYq5QskbPvtYw8_LSuZ9-KLx7HfCdbrpyFC7KQL1XAW75YC8LNxLVesHQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UgtE_M1BJUi3iMwN2zImsG3xZ6LFBoku8paRX-s4WCw&oe=69E24369"}, {"file_name": "DigiGods_Tuto_Buttons.00_22_06_41.Still021.png", "id": "855936300313698", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499300619_855936306980364_7367571528779449736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gqpElZjLP0Q7kNvwH6wUKG&_nc_oc=AdpWpO3QFuvgTopdtlsJeTxtkL6oWhWwkHO3Qar-1rZqnsOvoUx-eTm46zvy1uY9Lh0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16YdbCxvxbXOwyXS0twiRWQz2QU_qCkqGBoFC01wzP7w&oe=69E25161"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpellCast", "keywords": ["wizard", "magic", "free", "social", "fantasy"], "long_description": "# Master the Arcane. Conquer the Dungeons.\n\nSpellCast is a fast-paced, dungeon-crawling VR adventure where you wield the magic. Sling powerful spells with your own hands, carve through waves of enemies, and face off against towering zone bosses!\n\nEquip unique spells, perks, and enchanted rings to shape your playstyle. Charge into battle solo or team up with friends for chaotic cooperative gameplay. Every run offers new dangers, new loot, and new ways to become a legendary spellcaster.\n\n**Key Features:**\n- \ud83c\udf0d Open World \u2013 Explore expanding environments and encounter smarter, deadlier enemies.\n- \ud83c\udff0 Explore Dungeons \u2013 Battle through 15 escalating difficulty tiers.\n- \ud83e\udd1d Co-op & Private Lobbies \u2013 Brave the chaos alone or with friends.\n- \ud83e\udde5 Wardrobe System \u2013 Customize your wizard\u2019s look with magical looks.\n- \u2728 Deep Magic Customization \u2013 Mix spells, perks, and ring buffs to master your craft.\n\nJoin the community, shape the future of the game, and experience the magic before anyone else. SpellCast is only getting stronger! ", "short_description": "SpellCast is a fast-paced, dungeon-crawling VR adventure where you wield the magic. Sling powerful spells with your own hands, carve through waves of enemies, and face off against towering zone bosses!\n\nEquip unique spells, perks, and enchanted rings to shape your playstyle. Charge into battle solo or team up with friends for chaotic cooperative gameplay. Every run offers new dangers, new loot, and new ways to become a legendary spellcaster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "https://www.squidostudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24673981108894135"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1316805993799599"}, {"status": "PENDING", "id": "24940247635650149"}]}, "baseline_offer": {"id": "1316805993799599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770919200, "status": "PUBLISHED", "id": "1316805993799599"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
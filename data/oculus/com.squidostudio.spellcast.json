LPcw&oe=6ACB8ECC"}, {"file_name": "DigiGods_Tuto_Buttons.00_15_08_31.Still025.png", "id": "2351356215361327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_2351356218694660_8372454558191438011_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v1ppo6BmkwQ7kNvwF9m74i&_nc_oc=AdpZHSSgjaIbryUUtN_Hp3vBWq3OBWWTE6N7Imit1qeBfWp_WSlQ5QVWYISDv57dM4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMInNwsZoLiLetQeHCUfOnAoq2jLapYqhHYuG-69Uhemw&oe=6ACBB295"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyArt_landscapeBroom_01.png", "id": "2146949372893751", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_2146949376227084_7306370331162819152_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO1ld0q2nOEQ7kNvwFc2upt&_nc_oc=AdrTFjf41-MQZj0CSuL3M2vRwKtUsBv8u0fUfjtmwbF3Rjw3kMlelYcKioLcuGKc1JQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsk8tRhMtcRxowoQmIqFK1phW8lBDEIdkx6k7OrN56Zg&oe=6ACBAE66"}, "display_name": "Wizherd", "keywords": ["wizard", "magic", "free", "spells", "multiplayer"], "long_description": "                                                                                                                                                                                                                                         \n# \ud83d\udea8 WIZHERD FULL RELEASE IS HERE! \ud83d\udea8\n{28515592344762649}\n# \ud83e\uddf9 NEW IN WIZHERD \ud83e\uddf9\n- \ud83e\uddf9 **Brooms** \u2013 Fly across the world, reach new dungeons, and fight from the air!\n- \u2699\ufe0f **Broom Customization** \u2013 Mix and match broom heads, handles, and trails.\n- \ud83c\udf25\ufe0f **Celestial Skies Dungeon** - Test your aerial skills in a brand-new unique dungeon built specifically around the brand new broom flying mechanics!\n- \ud83d\udce6 **Season 3** \u2013 New rings, brooms, and cosmetics to unlock!\n- \u23f1\ufe0f **Dungeon Time Trials** - Race against the clock and compare your fastest times on the new leaderboards!\n- \ud83d\udcdc **Quest Journal** - Read and track your active quests anywhere directly from your inventory.\n\n{1483454707000531}\n\nWizherd is a fast-paced VR wizard game where you cast spells with your own hands. Blast through waves of enemies, explore dungeons, and take down giant bosses in this magic dungeon crawler.\n{2047933789440676}\nBuild your wizard with unique spells, perks, and enchanted rings. Play solo or team up with friends in online co-op. Every run brings new enemies, new loot, and new ways to become a legendary spellcaster.\n\n**Key Features:**\n- \u2728 **Hand-Cast Spells** \u2013 Aim and throw magic with real hand motions.\n- \ud83c\udf0d **Open World** \u2013 Explore a growing world full of tougher, smarter enemies.\n- \ud83c\udff0 **Dungeon Difficulty Tiers** \u2013 Push through rising difficulty and harder bosses.\n- \ud83e\udd1d **Co-op Multiplayer** \u2013 Play with friends in public or private lobbies.\n- \ud83d\udd2e **Deep Build Customization** \u2013 Combine spells, perks, and rings to fit your playstyle.\n- \ud83e\udde5 **Wardrobe System** \u2013 Customize your wizard's look with robes, hats, and cosmetics.", "short_description": "\ud83d\udea8 THE WIZHERD FULL RELEASE HAS LANDED! \ud83d\udea8\n\nWizherd is a fast-paced VR wizard game where you cast spells with your own hands. Blast through waves of enemies, explore dungeons, and take down giant bosses in this magic dungeon crawler."}, {"images": {"nodes": []}, "id": "1361603452711435", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizherd", "keywords": [], "long_description": "# Ma\u00eetrisez les arcanes. Conqu\u00e9rez les donjons.\nWizherd est une aventure VR effr\u00e9n\u00e9e d\u2019exploration de donjons o\u00f9 la magie est entre vos mains. Lancez des sorts d\u00e9vastateurs par vos propres mouvements, frayez-vous un chemin \u00e0 travers des vagues d'ennemis et affrontez d'imposants boss de zone !\n\n\u00c9quipez-vous de sorts uniques, d'atouts et d'anneaux enchant\u00e9s pour d\u00e9finir votre style de jeu. Foncez dans la bataille en solo ou faites \u00e9quipe avec des amis pour une exp\u00e9rience coop\u00e9rative chaotique. Chaque exp\u00e9dition offre de nouveaux dangers, de nouveaux butins et de nouvelles fa\u00e7ons de devenir un sorcier l\u00e9gendaire.\n\nCaract\u00e9ristiques principales :\n- \ud83c\udf0d Monde ouvert \u2013 Explorez des environnements en expansion et affrontez des ennemis plus intelligents et plus mortels.\n- \ud83c\udff0 Exploration de donjons \u2013 Combattez \u00e0 travers 15 niveaux de difficult\u00e9 croissante.\n- \ud83e\udd1d Coop et salons priv\u00e9s \u2013 Bravez le chaos seul ou entre amis.\n- \ud83e\udde5 Syst\u00e8me de garde-robe \u2013 Personnalisez l'apparence de votre sorcier avec des tenues magiques.\n- \u2728 Personnalisation magique pouss\u00e9e \u2013 Combinez sorts, atouts et bonus d'anneaux pour ma\u00eetriser votre art.\n\nRejoignez la communaut\u00e9, fa\u00e7onnez l'avenir du jeu et faites l'exp\u00e9rience de la magie avant tout le monde. Wizherd ne fait que gagner en puissance !", "short_description": "Wizherd est une aventure VR effr\u00e9n\u00e9e d\u2019exploration de donjons o\u00f9 la magie est entre vos mains. Lancez des sorts d\u00e9vastateurs par vos propres mouvements, frayez-vous un chemin \u00e0 travers des vagues d'ennemis et affrontez d'imposants boss de zone !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curlyblue.com/privacy-policy/", "developer_terms_of_service_url": "https://curlyblue.com/terms-of-service", "publisher_name": "CurlyBlue LTD.", "support_website_url": null, "website_url": "https://curlyblue.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"i
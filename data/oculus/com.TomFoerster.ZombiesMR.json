cdn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etp_LLMK8LkQ7kNvwFXwqky&_nc_oc=Adkck04khw5MoJDMZEElyqs0dFlXvypJrSXRC6qXEbfCWMmCe-WmQhMgpOusGY9M4p0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjvPW3nOjamlHKzrpPWJLqsMBE-uWS8-GJ2R3w24tdvA&oe=69B16F7E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PCzeSu73RAQ7kNvwHzmI-r&_nc_oc=AdlWoUYjw8YAuApluCEQJaDaLTQWLCegHGYshXxWc0P1bNvoODDqlmAnvLvX6k-_f-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPh7Rm2Yk3R0W9DngxLnn47qjAjKYUbc_zGMtiC40ROA&oe=69B15440"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaDa-iH7RGAQ7kNvwGSJgPd&_nc_oc=AdnPgmikrGjeVbRNkrW4-QxkVkQOzW1FfjokFrmp930XCIciT-CmQWlvR5FvCFFN9-4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVSq_ua7SqKMsZK2QaTP2KfmR6uDLeqvzwQ8qH9LKnjw&oe=69B171B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4fuCFBqd_oQ7kNvwFapz3x&_nc_oc=Adnm1vz26qdiwngnHa2HhqaH0pmOpd94rCHOHUcY7118mV7a_ktFtOl-ROJEOlSZzaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdjnbS-y0P5HIYKdausflLdzpSfSsLfjEclFD_-2fIZw&oe=69B1790D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiVrOs5epFkQ7kNvwGq1Lux&_nc_oc=AdnP_Cji45Brg3AYHHSJnASc88GnO-yfZwSdphkcpZfVDm-5cPyYD_pot5vUiEZGQqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzod1_HV6iDaIDce-W9UJ2HEeDXjPB_JuALVDLDkKNT3g&oe=69B15735"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url
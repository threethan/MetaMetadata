cdn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ttpa-ZNOAQ7kNvwFQBdhV&_nc_oc=AdlO8csuSK_NRIgs6GPMJB1CmxnD0TxdA0wntgh65XWrBrJT1n0pZSFcXm6RZh2GeI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft22cNO1FPvpW27XMMUrqCrpqzePcCIqMdhVMFVYKMMOg&oe=69A9867E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggUyGKKgxYkQ7kNvwEToGwx&_nc_oc=AdmGWaTF550ek-Va3EbXZTR1TJpOYYuz7FVM-hvbQvk3dm5QH7zjIxw9U_O6xG9n6W4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsSeZpQkuWsD3nI8YrUU0vvXO7T0DdBPE9a9QNr8M9A7A&oe=69A96B40"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAOUQ7Vu2kIQ7kNvwEu10Cg&_nc_oc=AdnjRN8Kz4nHslKBXpz707xLhdqCOsgTZoKzsy1yC-qTMNR1n1SKoXjTYLV2sKPysJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvuZKcwbATAFVsYeeZpTTHBty3pzbT0MweP62gWLkN72w&oe=69A988B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wp5WZc9orAQ7kNvwHEi5eh&_nc_oc=AdlGC-qG6qlVQs-1vS3jdzTCojjk8mQ0X--HvENFc0xbr4dSnhUnuevppMr7Yjg2OG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv2lpLLfd74oKyXOoQJG7wWd9XYm0bF9zQiVrwQF_0RvQ&oe=69A9900D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rllfYr5k88Q7kNvwEFFCJI&_nc_oc=AdkCzmOuIF98AWEZEeFxT-u_RxsjDl0Pnh-48Ms1OVuLppaVo7g3HHEdDI1KQIEBzeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu5-LGzNGMctC3EmrS4ShxmvnGoeeLdQNXO9WYF0YZiLg&oe=69A96E35"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url
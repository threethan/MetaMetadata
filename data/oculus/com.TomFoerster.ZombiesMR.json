1363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ekVnDXj7HQQ7kNvwFC52WH&_nc_oc=AdlfRTMpx3UfP4V0GAK8x81e_6evfHntqVCJVWIiGQZ6g0xp0JeBvG1qhcirTO06lyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsMqIjDBNQ-6Scg0w5syel8rxR-GQI-rWzuIFlFaDxucA&oe=699DA8FE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKkEYFBGj-sQ7kNvwFnGeW9&_nc_oc=AdnlGrEfCMWKEbtWj5UdTnO8bWb_kMrxZ48G1hijyqrttzwCV1e9xI4ovLPgJpxmyQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8jZsJvUA0Me_Whe0pEp7w8VprWE7oEhsYjaQaLmJiTg&oe=699D8DC0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv70W3v-yjUQ7kNvwFgGK2p&_nc_oc=AdmrOMCODaVklJRI0-LL0VLPEA81a3_M6ng8djJr8zbpf-8B4vO1dOBjUK8qi-ZrOxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQmo7j7yczE_Zqzx3amoJ0rpRLXh_0f4qQVBpL7ILmWw&oe=699DAB35"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mK4iY6EyXcQ7kNvwGelKZ4&_nc_oc=AdkOVKPKNWB6JGYSSrY4_HAgjPgUy1e7izVPHhxcmS1TyQia0W_3NyfMwCgJZBbMVoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuTeANg8gRTbF-kpqvV8Ytq1K1spf1OsZCaXQEdVRA8AQ&oe=699DB28D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqpJco1UN38Q7kNvwEbHUa_&_nc_oc=AdnIwOcFfyGVsQM6tfZ8J5S5elKoFpzTpA48iUs8IBIEvTzOnGD9LVjVjullKZ_DbUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsK6t3RB5u_bG6xgEFwjsAKCUh8SQ1E86FNslsiMrqtnw&oe=699D90B5"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "c
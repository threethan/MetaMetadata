dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Wh3V-kB5gQ7kNvwHJJ1s9&_nc_oc=AdrqvvcH8eZ0FYGedmV_cyNWYHqGr3_4ABGm0hpqniYfuZgNWIvdmlFOfZioyEILaTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14su-6m6kZiGWoQ7OWwtrPKNpd0hBXmB6uN0PjXc1KHw&oe=69D264FE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdn0kP6BDvoQ7kNvwGx55i6&_nc_oc=Adr93IdaxIBBMrcZrrPPxeep28PO82F048dWXgIb9Lh-K7vJfWm4A0KdCMyiF3wtWjg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S3ER7CxKnPMgR6-uOl2wDnxdPmpQKSsql5xWVu_nXZg&oe=69D249C0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHfSQsmaQpAQ7kNvwGiGW0H&_nc_oc=Adrgbx1n-lnexTBXoF-OIMZDhc7gF8n1QDfmIoW8iVjF8DdHBRGwJgxT7YuBV01ZX-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D-qX7VNmXW26NsRL_8kG9Nw0K1jLTDsNToFETXMtUHg&oe=69D26735"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEJ0lkAReMMQ7kNvwGbZCQR&_nc_oc=Adrhpsn6Zv_ptKZ038YsDqzRIAM0YvUk3Gk50LbTWytgUB5A5JvfuDYUfcCHKlgGsVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0advVEe4RLgJKYhd-0lw0MmhisTHBuYddc9D9wGZu_ag&oe=69D26E8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cb-fKrBjGMQ7kNvwH87Kws&_nc_oc=Adqhw3IRk5a61sD_XKCMve6PoThBig72d-VRnS_3aw7_17ZlJdRcrTPWDXh8PDlB7bU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l9Hv0KXLdjvaazn2F9Bb8dGKnspq-StLNWNqEo4_nJg&oe=69D25422"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_we
cdn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ttpa-ZNOAQ7kNvwFZk-rs&_nc_oc=AdkBAfgEBZ4xzv6jezMl1yEbj82Gf6fhlJ1nv2yzx6OZWcmN-6MEtHlizZqtF0fiD3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd6AQMI1wQCwGkaeitank3zzoTtghcYY-bOus6EdY94w&oe=69AC297E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HGp3rjrDiQQ7kNvwF_ITBE&_nc_oc=Adk9J8SbXjvM0hrcjsYDduK4W4koQsnNUtBsPsznZOpIS9VggoOpHIn8GwzcePx2dSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHbebfzus9fSpVk-YKlBYa2rE-RBHIr_ng39favesF3A&oe=69AC0E40"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_OKf6K5m5AQ7kNvwGH1n0P&_nc_oc=AdndQTfyNGkAmEPG849gn8_RIwmDGQazhRV9KjdK560CApuGELXsVy4tPtW4l-X0aPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJ8QxxOx1SmgyQ6bvE_qZEde1rVMArUYvoqzYUXYUXYQ&oe=69AC2BB5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mALKRejCwGcQ7kNvwEDHZml&_nc_oc=AdnLvA6Qt8n54SkAs0xqU66uaN8U_1H__SETY1bHpFbvzr1zQs_LUhk82yjOpyeKoe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJFMiwqpOwCaY97Cji2paTR0MIoUPWA4s4Jxoy5WNjhg&oe=69AC330D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rllfYr5k88Q7kNvwEC9nSG&_nc_oc=AdlhKmD6wKjohvn1c1GolQBcFh43__sJV_f6T6K0uwudBBVaIcjHd3Gob7VlLbTD_To&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6JlknKYC5BqOSc4W2EqbepzriFjcb7k0_cxVIBsgg3A&oe=69AC1135"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url
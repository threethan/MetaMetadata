1363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk47uAoq2gEQ7kNvwEMpVXA&_nc_oc=Adk4sICFQIPFtRdSIFYFknFwwzqho_521FfstXtzTInSMFqoyF4guEAVFfQzsi3jZlc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs39tQQ_lT5ykiXPWLGp3mF3EVC1FNkdAOB2ZpENtqaUQ&oe=69A6E37E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggUyGKKgxYkQ7kNvwGIQVwa&_nc_oc=AdkvV8ZYuvVbSAf4LP65czk3N1yshNW0J3d5PuX1EzXm1o6Lcb1bWNMIK4EMD4lb7qs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBfb8F4iD_X5hDZnPyZ5svFn8YCWIh1Egj4jnGRnbV7A&oe=69A6C840"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg_SqoNPcAYQ7kNvwH0GPpa&_nc_oc=AdmQAko38SUFsDiho8bpZV0g45hWZiKNIizCQV8D8bRfK_eiJzs_0vdxkvU7JN9sMf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuwwgeNJQJNDP13UFzUNiV9t06dy_b907IG3xNhEbGWag&oe=69A6E5B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_NbGSe-ak8Q7kNvwFhG0_y&_nc_oc=AdmE0w8P4eflDaZuAN7A3WKcPpLqXo_ne3ZGReqaF_vnaq5Rh_P6laqnnv0LvtrXIqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvj5_9BI3gcwv7mBPovkdKbWMThESWbBQZoMnPNN_Ks0g&oe=69A6ED0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABuVQXLjYh0Q7kNvwGVikAX&_nc_oc=AdnhtDWyYglpLnpRKr-x2KTstvVHYIgefUywphZ58bho-sUV58ll8Xw1yP3P98LTKgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMWTSVYCnAvJiHZN3tRiVYLy5dc1eMuPYcA1yc9mL4qA&oe=69A6CB35"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "c
dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6SwBH35ofoQ7kNvwFbVyXN&_nc_oc=AdooVTD3wRuGnraahLx5IZv_nFIDQRyWoe2wjgeU_VN3NQfOXWXpnlHBBuyL1muo9b0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05udE5cX7A-r9cOw3Bi8KC3Z6K6C5bBbCOPOvcOFuOCg&oe=69D507FE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdn0kP6BDvoQ7kNvwFRbM0R&_nc_oc=AdrTYbR1tN0KFYwIG439ZtN8lflEMghaQs8i1NNAHcCeq6X2HfF5UXaSGL5T-WVeOzs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g9HWH5333icy_bf93z4_IaIYTVpqUrzZ8ltEbNER0Lw&oe=69D4ECC0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj91GxyXkvoQ7kNvwEP1Tet&_nc_oc=Adp7OTF-XNkS4iAq3A3_CsnazMuTXoGh3QBTyXJi0seNjr200tAy9Ce9UWBDgtm1r4M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a5G9G2UmgRrg1cQw-FpTFyFy-KDkqu-0u-1KSHp9n-A&oe=69D50A35"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNTLuZPIsZwQ7kNvwGyHiHX&_nc_oc=Adqf1oUJkl9NYfHptutbfGOkbQNeq8MTQkffdV7IUkcGmW_3Fj5DiN5yczdLH-07Kz4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SYq3q9hOkiut2dsfj2V5vyepS3MwP2L57p-f8wgElEQ&oe=69D5118D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cb-fKrBjGMQ7kNvwF9MjiT&_nc_oc=AdqW25MTRP6wc5PL2KisgFgHUBM-yOleR3mnw9erwUnJqAOWpbDZNDSmEVV7wjIvAL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cjIq1vdKQlt6n8spSR4u6o3Fi9yv1SPJens8-CQQvFg&oe=69D4F722"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_we
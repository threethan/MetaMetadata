dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMMie1T_1msQ7kNvwEPi10Y&_nc_oc=AdoIxmzShORN-3hCNyXKDpgdZrin0yARHq7d4X8Kkxz7G2YYWDIofu6uc5islKbvwr8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7Fw3S6iXBu2QwhnxZrSMnBnIn-YmJv7DEfGNrGA150w&oe=69CBCD7E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVKRsjVadaMQ7kNvwHQgR9U&_nc_oc=AdoouwUaGIf2PU47X4bEbQOyBf9IFsLvNVE6izqTCeQOD1QvjRVWvMoYqf8bsnS-8DY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7mA8tcyzR6x7OUyypp0470gQ8wCK9x9SO77Zx0vRp8A&oe=69CBB240"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjuCUZeBSo4Q7kNvwGzwm3j&_nc_oc=AdrjL1OUUkh30J7Ek3MAtMXo_iLgWg5vL0CDjKFu-UUXf56xfMxwe4uDw2cJuG-hvzk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0oSOuV_SRw1rKI3SAb32Avmk36SqArFZSpy1rOn_Yaw&oe=69CBCFB5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no9nvi9uFA8Q7kNvwHwZVCq&_nc_oc=AdoLsajNXiOpOHF9Dtc2WcMUPPcqwocyEDVSrNIMxkVN-ZWF3WE_KrIZU48a45Y15lo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwp-66qaKYPMEP2kxQMpCQ8zeKxljkclGHkaJ9tQQHoBA&oe=69CBD70D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRqVTLeDGsAQ7kNvwGpMjBb&_nc_oc=AdrgTO8FBuLyrRb9i1D_7HLPOJwkLNNupsjmZOkeKI7CkJ1XaJ3Z0Tt7n__vz2sGnkY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8UYn_csChlXbKV1tcXNvQhxOGHr3dT43UT21cUPzk6g&oe=69CBBCA2"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_we
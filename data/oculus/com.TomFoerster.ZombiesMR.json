dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Os6B3jyXwQ7kNvwHOmng-&_nc_oc=AdlMpOiWCfWn_BY7nOqi_GDjzCtlWbPe__YwWIPCsJS1IyRgIC0ZzgXMwZ_yoE2gBLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzabuzLIkeVrqLXWi5TfwMu-LTUOIH5ZS3b-Jt4orQrDA&oe=69B9587E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z8oqFImHcYQ7kNvwFkBvMH&_nc_oc=Adm5fQbHoU8aFXHlceqmgtrjA1KLKASJjt2HtxdpfLMBScLpwCof5Glns7Ms9Oa8fM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKQ1zS76pzSK-wj8shbNmzphJtSNhhVS-RWo-wUKtQ6g&oe=69B93D40"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj1nr_EQYmIQ7kNvwGT58IO&_nc_oc=Adme1VIypO2yUiT9o2iRZeQNNH2iyvS9_0NAVa-MP-O_iT8Y8HPZu7abpqFXhMLyNQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyBuBj_VmaUS5RbErzOB6ayUYeDF9cKMgenAwdBOZWKQ&oe=69B95AB5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZHEIDWj8tkQ7kNvwHy7vEp&_nc_oc=AdloIapbY2C8KbeOhImGmLi3yg3mXISAsJmwLcZ_I8uPcSARVXlmuUhZddH1KBJO1t0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNbtDw0d4pprFPwp60761AsZ39luylME2uyzlYjFsgGw&oe=69B9620D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ACrHwVEf40Q7kNvwGtZKRz&_nc_oc=AdlClWUtMX1VafxEkg9ZsHxVbnhaJEFqK7fpxIaZM2jI60d_uznRyGkMACD6mw0qtRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAK0V0qTMCX9O0U35blf5E_7MOaCAZQ3S7o0x3dsyAlQ&oe=69B94035"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "
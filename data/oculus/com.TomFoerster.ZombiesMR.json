TOqkUQ7kNvwG2BOjy&_nc_oc=Adl1WKAIfBjSe03WHM0FCwj6_OURmfc_TjURfilxky3YaZr3-V3aMex-x3K6GRySbiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxu9WWuy4mO7SQtTNStrY-zj25TJkf49wkdPqLAJXWHLw&oe=69B93164"}, "display_name": "Horror Zombies Mixed Reality", "keywords": [], "long_description": "Immerse yourself in the captivating world of \"Horror Zombies Mixed Reality\" and get ready for an unforgettable experience! \n\nTHEY ARE HERE!\nArm with multiple weapons, including knives, your pistol and a trusty crowbar, as you engage in pulse-pounding battles against the undead.\n\nMIXED REALITY\nDive headfirst into the experience with the innovative Mixed Reality mode, leveraging the cutting-edge passthrough technology of the Meta Quest VR headset, as you fend off zombies in YOUR own home. \n\nHIGHLIGHTS\n* A captivating Mixed Reality world for an unforgettable experience.\n* Battle against zombies using multiple weapons.\n* Improve your skills at the tryout.\n* Multiple accessibility options.\n\n-> More content coming soon!", "short_description": "Immerse yourself in the captivating world of \"Horror Zombies Mixed Reality\" and get ready for an unforgettable experience! \nArm with multiple weapons, including knives, your pistol and a trusty crowbar, as you engage in pulse-pounding battles against the undead.\nDive headfirst into the experience with the innovative Mixed Reality mode, leveraging the cutting-edge passthrough technology of the Meta Quest VR headset, as you fend off zombies in YOUR own home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_su
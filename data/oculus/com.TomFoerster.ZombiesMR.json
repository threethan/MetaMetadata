1363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk47uAoq2gEQ7kNvwH5Ohc7&_nc_oc=Adl3t9wnfJeANa2GPImIHMrDrKrW7RrqitrNJ58jexkKB2EqiVvbEHEGQX7FeEL_Ikc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvR8m2PmmlIatXpwWUOF7z1Gftuqcwwzhh9F4ArcFPiQw&oe=69A591FE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VIbZw8xQisQ7kNvwFzSOIL&_nc_oc=AdkXnmoutM6ZoNm9dxxbR9F_FzIFYKrK_kOFfT18quJ_g1KMo_8nZ4EbvbzG6f2YOpU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvDqH34ES4Yh_jNYQn3mmMOVTTUOwPNpcuFNaKisfCDiQ&oe=69A576C0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg_SqoNPcAYQ7kNvwFvcsFW&_nc_oc=AdlCeHiZfrFBZt38m9oJBxRs3xmC4st98Wg9XyXKXF2sAEzpY77gmY0wtpxnd7C9ySk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft6H-moJ5S9HCal2mOqwS882EQ9maU0SEIimoLSCwDNzQ&oe=69A59435"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_NbGSe-ak8Q7kNvwFppevo&_nc_oc=Adke0adzh0jcyex4K0B1g6xl7b0UWu_t68rl-EQOS-L2nW5zVfIw79BXNkKWtUY9WR8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftdXdcmKJgB_xwy_2klJrRAOhQzaJ-6X_oQ6uG2yc4YCg&oe=69A59B8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABuVQXLjYh0Q7kNvwH3y10U&_nc_oc=Adn6XDxwyW7hykVMs1Cb64Ptn0pBHrGpZMEncPJkftJ2B7a0OA44KDGcAvWEtDlr8YA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afug3Or2U4xH827k3VFlMXGgrhTpu99Feopl2UEDoFKFdA&oe=69A579B5"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "c
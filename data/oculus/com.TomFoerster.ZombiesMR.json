dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etp_LLMK8LkQ7kNvwFEdH5t&_nc_oc=AdmeziQerPjHOz5Jvf6nc7NC6uOoISUTaNVcrlTG4PTzzowwXVn7avrejTl5272_ci0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgwji1yrjgCYI5DNEt2xX_a0MeTa0fxoLrX6YB_VgIag&oe=69B2C0FE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BC8oiqnK1AQ7kNvwGzs_po&_nc_oc=AdmTcgn-Vn3VhL_lqLT52IJs3-AnRFWsuYH8s3bkDaeWoXZj065c_IDSxQFgkfUow2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhMlnUzEHnh_FO9H2-G_D8iHrjwec53slTr17yeGyfCw&oe=69B2A5C0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaDa-iH7RGAQ7kNvwHlnpFC&_nc_oc=AdkIauJYc_rEE0Uexs76T1sbbT6iizKgH-bjRdy_r47PB8PwHFaHz6OM37mq-M30nFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTmTyL7X1ydZ2ipOcfocK-AAaO1bCzHlHze_NKpOpnkw&oe=69B2C335"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4fuCFBqd_oQ7kNvwGZIJ9J&_nc_oc=Adl5Q6oSDVE6UKY4FTN2PemO1wVVvCJmumYhlt5h6nqi3JEN2PL78SUrSngWD8GYnpc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkBBckLEjIMsVyEt__fddUnPUp07OYhidyISyvwNh7Zw&oe=69B2CA8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiVrOs5epFkQ7kNvwEvFCEH&_nc_oc=Adl6AcNoLTT8SkOKPRjNOf4HzGYPBTm_Tfkk-sJx44OHZUa0VXMOOnxT2EOqNgGTYhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy610qtw6DCrXy7zyJVYeEL7nhZba5AULRdmk1c_SlEUA&oe=69B2A8B5"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "
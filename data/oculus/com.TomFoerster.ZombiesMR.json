cdn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdpVZ2RAug4Q7kNvwHbL3Ln&_nc_oc=AdmRWJjLwISWpZxAEjLDkrFlcSQcJr8CUgP_BofXiNwpSGEW6hJmipGNZoetTtWInxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUo0KK5bB8u5hNde43UeTJjyZ4Cx0G8e6vAMLz9RKpMw&oe=69AECC7E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PCzeSu73RAQ7kNvwFLuExW&_nc_oc=Admem5eSe7gPOoZpH8Tn4tsXppII4YT5FqRihCOsk4BSGbO7ebtVtqQh2hE70KSF_pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuFZdxqTTcUYUDKDaM3wiG2uXSwI21qcAOfvL7msiMzA&oe=69AEB140"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_OKf6K5m5AQ7kNvwF9N16t&_nc_oc=AdkziINQGq-jPR0b_jG1Kuf3tYPaiaVfvdHqqx-IfqgFbzWvWkZb1eUovgVzgPLSaBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPM4ck_O8mOA83k5l3DgkAsQpsRhoonI3Uer532jBGmQ&oe=69AECEB5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mALKRejCwGcQ7kNvwFgQt8N&_nc_oc=AdkueBHiGXqNp0WA9037FFID80uPnd9Hnko4s5qud7My3SxIogX_ShgAsLPJ054F4WU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1bbedMEZyiMnZT9gK8gWjPOud2LjXG4Y27cmmWBzBxQ&oe=69AED60D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWbQN_1fd2AQ7kNvwFAITb1&_nc_oc=AdlCdapQO2nN8CnZv4HZ-851DD7Z328p1b6MZzUHp-NVe8YppphwYf7glf_QV_e_QRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5pgA4rXcP_3mIcEtwd93w67SgE2QNx84o3cV4KbjlDg&oe=69AEB435"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url
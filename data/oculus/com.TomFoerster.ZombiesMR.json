1363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNEZmg9yZqkQ7kNvwFv-OVC&_nc_oc=Admupz20JL-MPUWEYvMgLMmxFhePghD9PeVLHAI5bFi1hv3eKCUPRccOjf7VoB0aSPs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuO4TqezmrAIWCV1DdmOJvwzFJ5GfUWeBUpJ4Np9RCUlQ&oe=69A19D7E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILV1rHWpK20Q7kNvwE1VHj4&_nc_oc=AdmFEz23Eer-aEZc-oEsv3ajOGJSRXD-7lq2N3W4ljcI6vRh166nrlpntkNw3C8u-Rg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsSkSeka-1b31zsHjcAYIWNRVjhmf0AM0jZEoaxs9TdEA&oe=69A18240"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv8jREO_elIQ7kNvwHi8l_v&_nc_oc=AdkhgUIqgHP11mbIJPD7BctofsLvKyf9N2IuYI71ddi8Bue3brIFHAQZZBRbBCZx_Ig&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuCP9QwNwW9yt-aww-MR2-VdvAHtHD3dN8GXSO-TmH1tw&oe=69A19FB5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQTsvTXbxfIQ7kNvwGKEkIG&_nc_oc=AdmwUhLP1OtY-wNBET2wM9v-VMMJ_pgCskP9DDvPNXE03oPyaafPtwbIVXnDiW1riT8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsfXSVTp_3ZtksUK4v4rkU7WiHXFeeNPG059K9by509hQ&oe=69A1A70D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5I2pq0OpIcQ7kNvwGenjq5&_nc_oc=AdluqM_b9Wu-YSjoiqBJWf1ez9szHfXA62fTzJQ50kOpb4GouZ7ujcqYneubOLKgCUs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs59JpFJJ_V6M79BTpSrioMyEd3xbO6H4mtDWFRZyo3rg&oe=69A18535"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "c
ohc=EgzH85j4jEkQ7kNvwGbJoNA&_nc_oc=Adn1UBx0nfb9zOKnmoXc9pCDZA6h2VTb0UFJnhhXMHHH5_tt4th_DHN2_vK5CrbvHfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuoQwZxuC9j63L9CACh9b8bMKXtc2XST3myhHbAD0tgVg&oe=69A997A4"}, "display_name": "Horror Zombies Mixed Reality", "keywords": [], "long_description": "Immerse yourself in the captivating world of \"Horror Zombies Mixed Reality\" and get ready for an unforgettable experience! \n\nTHEY ARE HERE!\nArm with multiple weapons, including knives, your pistol and a trusty crowbar, as you engage in pulse-pounding battles against the undead.\n\nMIXED REALITY\nDive headfirst into the experience with the innovative Mixed Reality mode, leveraging the cutting-edge passthrough technology of the Meta Quest VR headset, as you fend off zombies in YOUR own home. \n\nHIGHLIGHTS\n* A captivating Mixed Reality world for an unforgettable experience.\n* Battle against zombies using multiple weapons.\n* Improve your skills at the tryout.\n* Multiple accessibility options.\n\n-> More content coming soon!", "short_description": "Immerse yourself in the captivating world of \"Horror Zombies Mixed Reality\" and get ready for an unforgettable experience! \nArm with multiple weapons, including knives, your pistol and a trusty crowbar, as you engage in pulse-pounding battles against the undead.\nDive headfirst into the experience with the innovative Mixed Reality mode, leveraging the cutting-edge passthrough technology of the Meta Quest VR headset, as you fend off zombies in YOUR own home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24366712936305912"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "603621986051944"}, {"status": "PUBLISHED", "id": "1419092542734516"}, {"status": "PUBLISHED", "id": "746796544352036"}, {"status": "PUBLISHED", "id": "719066263896021"}, {"status": "PUBLISHED", "id": "1038347281028975"}, {"status": "PUBLISHED", "id": "906033854697326"}, {"status": "PUBLISHED", "id": "155245770950102"}]}, "baseline_offer": {"id": "603621986051944"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758905400, "status": "PUBLISHED", "id": "603621986051944"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33288470300796753", "version": "1.2.4.2"}, "id": "6637596052997842", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23943098495334027", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33288470300796753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772209873, "id": "34069668542676921", "version": "1.2.5", "version_code": 118, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23943098495334027", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33288470300796753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "6637596052997842"}]}, "change_log": "Changelog\n\n- Fixed a crash that could prevent the game from launching\n- Space setup is now optional before starting a game to prevent issues in special cases\n- Uncollected ammunition is now automatically added to your inventory at the end of a round\n- Fixed layout issues with the tab bar in the Welcome / Help menu\n- Weapons now break crates more reliably\n- Improved performance for body parts severed by katanas or grenades\n- Added a customizable gunshot threshold in the controller settings\n\nAs always, thank you for the great feedback and support, it really helps shape the game. More updates coming soon, get ready.", "created_date": 1768247930, "id": "33288470300796753", "version": "1.2.4.2", "version_code": 116, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23943098495334027", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33288470300796753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1767883182, "id": "33225560363754414", "version": "1.2.4.2", "version_code": 114, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23943098495334027", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33288470300796753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1767882125, "id": "33225358230441294", "version": "1.2.4.2", "version_code": 113, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23943098495334027", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33288470300796753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "6637596052997842"}]}, "change_log": "New Year - New Update!\n\nGameplay & Combat:\n- Broken katanas are no longer added to the belt inventory, reducing clutter\n- Katanas now last longer before breaking\n- Improved katana physics for more natural handling\n- Katana slicing is now more reliable and consistent\n- Katanas have unlimited durability in Training mode\n- Grenades roll less when hitting the ground, making enemy hits more reliable\n- The player belt is now only interactable when looking down, preventing accidental interactions\n\nWorld & Level Improvements:\n- Fixed an issue where crates could spawn outside their intended rooms\n- Improved overall crate spawning behavior\n- Wide doorframes now correctly feature two doors instead of one\n- Fixed visual issues where pipes could intersect with windows or door windows\n\nPerformance & Stability:\n- Upgraded to the latest Meta SDK\n- Level loading has been optimized and stabilized\n- Startup time has been slightly reduced\n- Game installation and download size has been significantly reduced\n\nAudio:\n- Music transitions are now shorter and smoother\n- New, overhauled soundtrack for Classic Mode\n- New music added for Adrenaline Mode\n\nCommunity Thanks:\nSpecial shout-out to \"thebutt\" for the great feedback that helped improve this update! ", "created_date": 1767723702, "id": "33197628129880971", "version": "1.2.4.1", "version_code": 111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
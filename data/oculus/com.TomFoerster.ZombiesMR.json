dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcgsvRfBZEkQ7kNvwG9qxnP&_nc_oc=AdpTVPQoyB8uERMSW8weDZjfY4ozVkx8MA5P4pOSx_q81vj7PINsDg46Jtu1fboKNe0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G02fQZkk_pFHJQ70qAvz_hkyGni331_XNAgytCS-VRQ&oe=69DE427E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_FUTMb_dXAQ7kNvwGMUGWZ&_nc_oc=Adpx6o2U497FIjxoqGwAChsRi13MwX9f0OA5QKtNqBtRoXJzi4CvP6-ociOGtxdflhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lz4DLpOp1oSKN-Mx6WBagpXaUsK-gCZ0qbvVklVyolg&oe=69DE2740"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb5L06Jdb5kQ7kNvwGt7_tR&_nc_oc=Ado5K_EuDXlzX9RJIUteinxkgRNWXZwit84Zl_jmGNJOrs4IeR8JVePSWNvuYyREx2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZvuZJeHMkX5E_A0w7GsW73FmVmT-7L8bSUnoWIC-lwQ&oe=69DE44B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBGRjXqwO_gQ7kNvwHiVEic&_nc_oc=AdrlewZkSulmD7nIX9Cv1fjNzFdkskJFvimo82idOBY7m-Y0eqwqqtBhl9BmY8itADQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38nUI5HtouLPTHDoBb6u9w0S1gYyiDz3Hv4AVez7lpxA&oe=69DE4C0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3qdyt6hLiYQ7kNvwEg4AsJ&_nc_oc=AdqCI82dguao_4rA0BWxOFSKeUyXVhX7K5o7dDNIV_z4DkRBTrv3Xev-LRuHeg8EHg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15usIfcvlzXN_kWqimCBebx5MsPwyEdFN4lq7JAPIrsg&oe=69DE31A2"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["survival", "horror", "shooter", "multiplayer", "horde"], "long_description": "# THEY'VE INVADED YOUR HOME.\nSpatial Zombies turns your real world space into a zombie battleground. The undead break through your walls, destroy your doors, and surround you from every angle - right inside your own living room.\n\n# FIGHT TOGETHER\nTeam up in colocation multiplayer. Stand side by side in the same room and battle zombie hordes together in real time mixed reality coop.\n\n{2852070501652137}\n\n# MULTIROOM COMBAT\nMove freely through your entire home with boundaryless multiroom support. Your real floor plan is the arena.\n\n# MASSIVE WEAPON ARSENAL\nSMGs for crowd control, precision rifles for long range picks, shotgun for close quarters devastation, and a brutal lineup of melee weapons. Every weapon feels different, every playstyle is viable.\n\n{1415550376222051}\n\n# HORROR MODE\nDarker atmosphere, scarier enemies, higher stakes. A true survival horror challenge that will test your nerves.\n\n# FACE THE BOSSES\nTowering boss zombies dwarf the regular undead. These massive enemies demand strategy and every weapon in your arsenal to take down.\n\n{3398592623621911}\n\n# FULL VR LEVELS\nDive into classic VR levels for a traditional zombie apocalypse experience.\n\n\n**FEATURES**\n- Colocation multiplayer coop\n- Boss fights and intense wave based horde survival\n- Huge arsenal: SMGs, rifles, pistols, shotgun, melee weapons\n- Multiroom passthrough combat\n- Horror Mode and full VR levels\n- Regular updates with new content\n\n**Available now in Early Access \u2014 join a growing community of survivors and help shape the future of the game.**", "short_description": "A wave based zombie horde shooter where the undead invade your actual living room! \nThey smash through your walls, destroy your doors, and surround you in mixed reality. Grab SMGs, rifles, pistols, shotgun or go full melee and fight your way through brutal horde survival. \nTeam up with friends in the same room with colocation multiplayer coop, or face it alone. \nTowering boss zombies await. Multiroom passthrough combat. Horror Mode for the brave. How long can you survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34842371222073312"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823901_942136098792299_9148919119898625537_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMcfZhNC9YUQ7kNvwFB0xeS&_nc_oc=Adryb1v4p9XAXHuSMg1lKQxSwLHPTvoEQs2hB9q8y4qruo-TZD4QLM-lupCVr8Dy4yM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HPQd0KHh7F4oLl-POMSyC-ea22AjUi6ftbEyQlsJ7Zw&oe=69DE3DC6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spatial Zombies Pro - Mixed Reality", "platform": "ANDROID_6DOF", "c
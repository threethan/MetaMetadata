1363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dktCunk8QrUQ7kNvwHFN0NQ&_nc_oc=AdngiLUJW2bz46Q_lWT4OdDhaAHLvWZO3LHT_rT6tRF-Dxlbc0GSMGh8Ip9oPncB7W8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsK7rCQkYQAoW7ete371f0Co-ZUgfDb5Nff2ix_gE7iGA&oe=6999B47E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaQLcslmiXwQ7kNvwHaxnWM&_nc_oc=Adk_ffAeTAEmxcnNhnO6HaVtvIo2xh3v3sNMgvJD74y_liGJhv8COSKoh2BLFIuD_D4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZzq89sTqZy0hR_KKy5bU9xy5wxT56yvRJVic6R9Szgw&oe=69999940"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HA7a6SbS-MQ7kNvwFlA7sS&_nc_oc=Adl0yL5wm45Q_019xSpNm6PpQw9BBZy2r-ghbGD4vCNoel4pYXsUIKYQeMxyuiwus4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsVv71hTl_YNxfyOIZlGBcH4WUCwyBRnM-eQnYLu4tyvg&oe=6999B6B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DahHnD5ibzMQ7kNvwHozrzg&_nc_oc=Adkpx4E-SgDysCxHwJ4lrRmYNXA5JRzAoWerzvbnzeINWaAksgHE0MfG5YhrPsKX0oc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuRPwQgMvhb0LUN4FpOEnhcsEiQeASD4KezvF2JL_IPQA&oe=6999BE0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Advl2s65xmcQ7kNvwFMlRfj&_nc_oc=AdkK5PtFZAD05O93y6-0Ps0SiNHnAjg2IpyoLwLckgE88Y7QCcQ29bWTlcE0b2YUxJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9Yo2q-Ic_xh2qS1ZgH953ZqFMawkwNyRwDlM9n1HqkQ&oe=69999C35"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "c
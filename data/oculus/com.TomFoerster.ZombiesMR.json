ank you for the great feedback and support, it really helps shape the game.", "created_date": 1772827691, "id": "34197048969938877", "version": "1.2.5", "version_code": 122, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
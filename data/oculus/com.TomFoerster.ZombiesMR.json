dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6SwBH35ofoQ7kNvwEiZtyM&_nc_oc=AdoYXblBzQWnxu0ZsnQXRGyKnJzfLubHNXej0ZIRoHNvfPmC9quAUPZEXoILNUh1ibw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JPeMXgSa20anXpBTG-MkaSdkY18OoXG24SdPHtzahFw&oe=69D6597E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz2JhXfDlyYQ7kNvwEITn5A&_nc_oc=AdqA19ZGbcChBwfhGSywfqWS0CyEOJKSqmDT48hs3KxUZGEt_xh_ABHJpO9tcERT78w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36davlSCTtshRe5vIsxdpfTBtFEdGaIRrkQQQCdEKAqA&oe=69D63E40"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj91GxyXkvoQ7kNvwGaE3Iv&_nc_oc=AdoVWBadubzWKCE372cTLMPvRkmhCWMbZU44quMJWogTTxulainSWbLLlDX6zG1t-uw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xd_85sH2fK4iVVMc5uJHVzlwKIr4L6WUkekbKCYA0nw&oe=69D65BB5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNTLuZPIsZwQ7kNvwE9twSm&_nc_oc=AdrNeAXk5yvHBoBTZb9SR8AkPlyYtu6zq8GbIXq7ARTHvXM2sS48dBkJB5Tdf3yDDac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08QSYbxoKcvnPGYYxnLFMBfIATD-Pfp3fMcZhYjStSIA&oe=69D6630D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeMFRKzZboMQ7kNvwE_cfnm&_nc_oc=AdqZgo6aYmRrRLHuwOprkNw6MDebkyp-DeHdlEQteXjSjZukjQfVWoLxF4jwqqXOL7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11-WBIquog2Mg7as7VEtD7qaolb-VX-BWGGC2Q3wYdbg&oe=69D648A2"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_we
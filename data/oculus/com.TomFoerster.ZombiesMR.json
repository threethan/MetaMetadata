dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtn1si9TkhQQ7kNvwFIB55p&_nc_oc=AdoeyMFk9pwFE7ogrFk7yDm0eMkFN64w-X63vfsLfUmwg7SFCfa1Qt-7WVWPBgbkzAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfNTnOcb7CjJmHko3bk9-a4XmL5hfI5fOkoos0Zbr8KQ&oe=6AE5EE7E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYvsf_sZAEEQ7kNvwGTfJ0A&_nc_oc=AdpdWI20LZzHOJ38lGOf6arY88lzSYmkppG8bW7pMdTKrD33Ewp6pWSaHiop1aEmEbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZkTq7LE2fw_loYjn-bRDn0vB3N92f_iqAtPzXD6vwuQ&oe=6AE60B80"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WiVBm7HwgUQ7kNvwG2eqUV&_nc_oc=AdpQCO4Sk4qb6qiS-isU4n-ZTZjWS75Z96_onbBZgptdSgwUZwZTUYXT7ZeQx6Szcro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6oD7WN9cPDBO_062lzY8z0L0Um59t0umtoV0FCCE1LQ&oe=6AE5F0B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Og-bH-cKv8Q7kNvwGPkavl&_nc_oc=AdqCOG14TjSN8tMa2yMIm7INjgYkJ6ib5_ruwFylQS_pSvIBvH8jR8iwnkZ-43v_C50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBnlgu1F-KQSvRjiK5_9b3iOTM5s_1lvwTHodwNkZLqA&oe=6AE5F80D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VweIIL8d6EQ7kNvwHbVZL8&_nc_oc=AdqKRjCTauQsVdzj7RMdLK9-hNRLRhjk1wgh7H7x-cuSCfLWBaLfB-WzBZFsxL653Gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORfurK2xCRgq2cemgX9nH-QNWq8VW7vRKhqNyPTHobFA&oe=6AE615E2"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["survival", "horror", "shooter", "multiplayer", "horde"], "long_description": "# THEY'VE INVADED YOUR HOME.\nSpatial Zombies turns your real world space into a zombie battleground. The undead break through your walls, destroy your doors, and surround you from every angle - right inside your own living room.\n\n# FIGHT TOGETHER\nTeam up in colocation multiplayer. Stand side by side in the same room and battle zombie hordes together in real time mixed reality coop.\n\n{2852070501652137}\n\n# MULTIROOM COMBAT\nMove freely through your entire home with boundaryless multiroom support. Your real floor plan is the arena.\n\n# MASSIVE WEAPON ARSENAL\nSMGs for crowd control, precision rifles for long range picks, shotgun for close quarters devastation, and a brutal lineup of melee weapons. Every weapon feels different, every playstyle is viable.\n\n{1415550376222051}\n\n# HORROR MODE\nDarker atmosphere, scarier enemies, higher stakes. A true survival horror challenge that will test your nerves.\n\n# FACE THE BOSSES\nTowering boss zombies dwarf the regular undead. These massive enemies demand strategy and every weapon in your arsenal to take down.\n\n{3398592623621911}\n\n# FULL VR LEVELS\nDive into classic VR levels for a traditional zombie apocalypse experience.\n\n\n**FEATURES**\n- Colocation multiplayer coop\n- Boss fights and intense wave based horde survival\n- Huge arsenal: SMGs, rifles, pistols, shotgun, melee weapons\n- Multiroom passthrough combat\n- Horror Mode and full VR levels\n- Regular updates with new content\n\n**Available now in Early Access \u2014 join a growing community of survivors and help shape the future of the game.**", "short_description": "A wave based zombie horde shooter where the undead invade your actual living room! \nThey smash through your walls, destroy your doors, and surround you in mixed reality. Grab SMGs, rifles, pistols, shotgun or go full melee and fight your way through brutal horde survival. \nTeam up with friends in the same room with colocation multiplayer coop, or face it alone. \nTowering boss zombies await. Multiroom passthrough combat. Horror Mode for the brave. How long can you survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "34941893168787783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_942136098792299_9148919119898625537_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7JTGXL_BnYQ7kNvwHsuTPK&_nc_oc=Adp4AxHFicpGfC2XaxLVFoEZxhVryVn5rIvRjWwYXdK3WkVbzqUk1NmFttPT7TubFRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMStHB0k4OiWMMy1KbsUQa6xPOMtE69G6I6pMQMep1ajQ&oe=6AE5E9C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spatial Zombies Pro - Mixed Reality", "platfo
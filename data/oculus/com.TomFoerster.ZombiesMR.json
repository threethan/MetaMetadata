dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXpXwZdgOIcQ7kNvwHJ5Uzq&_nc_oc=AdotmDd_4asPSdV5lu7F2EQPsGLlP1Oc5VDNL8ohTgoWGEN2GhI0evnSd2cbUboThcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOBc3uGhOade_ucIAfsNEP_WYZ7VvQUkQl3ZeTQUs5Ug&oe=69CFC1FE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqj4QqF1k-0Q7kNvwEbQeZ8&_nc_oc=Adr9Beo3SmVEnLlP7znmV_-A8TE4w5QdU6Uz8QtMtW6JYgrQpiy8_VQvMDSO-AaQBjw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHAIkkOIajExyOXfyioEITcBzzlKkatMuNatScm4Rq2Q&oe=69CFA6C0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHfSQsmaQpAQ7kNvwF38NNj&_nc_oc=Adq-18YPqtNx7XzTKYJQl1xTK1EBKNcecEkq5HWo4dwN8BlKnRTTy1S7AW9anED_Iqw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn3Re4aWWdLSG9QOZe0gQEgVEgcyvSBIyXUM6rdm6N0A&oe=69CFC435"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEJ0lkAReMMQ7kNvwGAa0hs&_nc_oc=AdrNNsvzzM6k-ADC8DvrpOpiEn3gFuKMRa_eXtxMud4dFYGJrm2WNMZ3QHyJ9iGG-YU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afww2Bh53Z0W9lWwinuDRTt_p1ZKo8NXiMOnhSfNEztUBA&oe=69CFCB8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqeFE8EJ01EQ7kNvwFgWto4&_nc_oc=AdrZuTrnYc-UcGHGEU04kqt2hYUuLg1-HaVYdRROwBTeU2_cyOSFrgAISPmVNKsr2Ik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztCiFVrOachYymWTCcf_w39Gb8yhE40_Lnh6o_Co5u_g&oe=69CFB122"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_we
dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Wh3V-kB5gQ7kNvwFFsb5D&_nc_oc=AdoLg5bQ0JbeIvXrOasVb8ecAuWeG6DznkBICDPnWCHWKj0CVnewKxtbGrLexxS41As&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyay2vuwB-8vANUjmFNNFj1d9SzSgrfXJXJqj-4JOMl9Q&oe=69D1137E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqj4QqF1k-0Q7kNvwGTjPva&_nc_oc=Adp8CJ--9Ldtuti80dl2EOMg2tB9TWTw6NOXETE8sV3TImA2pS1YCthfhf15xD0GbpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbeOkTk1Rhh6BCIEsQAWIojQqOCzh5gvWOvXuys6vUMw&oe=69D0F840"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHfSQsmaQpAQ7kNvwGAxDlb&_nc_oc=AdqUkts5byfxVJj56vCTVKL_p2zJj0VI0RphpsyXRSdiOU5adtX4H50mQYrZJMw-ipo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfS4gPYPFZq9buReBdxrJAYVOFcuo4iz6EVJWTQY1c0w&oe=69D115B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEJ0lkAReMMQ7kNvwF5Jq_E&_nc_oc=AdppJAwUbSCv9k6QTQds75yQMk_fQY6OuHrApSA5qZralBWMXID3Xx8QzvLYXj06P4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxtyEbNaZRzt5udeVcx1lXWCNJFL0ye7HbJ0d5GPVlNQ&oe=69D11D0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1453933783096398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1453933786429731_8116484849271227944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqeFE8EJ01EQ7kNvwFgNDZn&_nc_oc=Adp5yt-8giwkfiJL1g95ziFX_WPEWL6sjUvDkKrP2tEiSO25g2wigQcFvMTO75bmQew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLHibhRavu4koeb_kKCi1SYEuh3u2fZF2IB2eaavYE-A&oe=69D102A2"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_we
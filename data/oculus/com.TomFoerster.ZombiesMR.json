dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5zyqCMfh3oQ7kNvwFnKa-M&_nc_oc=AdmkgcyjyFfWwG5hYEl-Vp0Bnt16GcZ-YQhZxu5YkU0Wqffk1eIbgMD4Jy9UVTWFREs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLf0mJtFrOIC_6DGHNAXngmany_aYRzZ5EQ0_m_wbDdA&oe=69BE9E7E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCh-lrs02UYQ7kNvwHoG8-O&_nc_oc=Admnc1-9nlTxGNl9wG_TzqeUGlOt2s4I72yiV6g3Qanr65vhz8fGvyFjtr6qmWGSmI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXOLUVyjHFsihp6V7L1nCuXnYk09xYwc3IPirKLPGczA&oe=69BE8340"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WaLdhgjwgoQ7kNvwE8tzVC&_nc_oc=AdlZx36-c75GFid_2VQTo5wA48Axo59rhTUTWFnb0la0dZ685QjDxz39Nk1k9vh16aE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZR6J5iH-u-AARPO3pDZLlgwUzlA_JUXjWmriws-YWhg&oe=69BEA0B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxv99RNy5SYQ7kNvwEvTk1j&_nc_oc=AdlaaRkNvug2fTCjBmJizl_RrxJdMfypGnUh2wTnycWwEpMvvkM_zkeV-BFKj41R7_s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmAZDRJLE4mplBgJq8hGJgZo47C4bKUsONDr8gIiXBSg&oe=69BEA80D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk7Fdo7m5vcQ7kNvwFzydjO&_nc_oc=AdkEz5ojc9pqgHgp24Kl4hnHjVVhkoX4WHpWPFZDp5wyjDjFqkHT4_8t1HFzaTMxSrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwsXcVU3lVPWOAO2i4RJllpoNyd1_AOAWWbGDq1UINmg&oe=69BE8635"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "
dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ogI2J6gLUcQ7kNvwFXkplL&_nc_oc=AdrB3czTTbDf2c-2u1vq1jm4EF8r3ywLDZF9TePJPSFjYIARzFlJRzJ0EIhSVNto0XA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzelqBCaK8-y5DK2tBOUoWR9pyLZwciA5ov0gcVUakRdA&oe=69C1417E"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCh-lrs02UYQ7kNvwGmK22x&_nc_oc=AdrByGH_sj4RaZBG1AoMPUB--M9ECDYKZkB4smSV0xBpLYWTmAd_IpRL3r9_P94v_nM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxagTQrMfs36i3KVRAhT3bEORcILZASgNOr1hN2YDGxqA&oe=69C12640"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdC7vtlWeloQ7kNvwE1as0o&_nc_oc=Adod98Icbgoo-JC3_KNSHJdbqno1isOAo0d2SikSX1WEpqsiJtJYISB8NrghuKCDYqU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEAOg68BvPpJUl3-Mq_X3q-BPNIbBa3fP_F6rAPBiDcw&oe=69C143B5"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPIyLiqx_R8Q7kNvwFhzzQD&_nc_oc=AdqYGUgv_EhebOhkgaob8p-mllVnPtvQsdYSnJPHRLmKF4iMs04D31PbGpRjcpF7NL4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyoxE1IjdGMH5QoUc4R0MUzBo7zByYrIQQDRZnC0Nc9w&oe=69C14B0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui5mYPJ_ErwQ7kNvwHIWZYD&_nc_oc=AdqgBUkRCzwpHmzMh1FU-UxXnppwEputq4ljF1223DrUT8uPMr75H2aqoWhOd3_swr0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwqU-28kD8Uv7Kc1sZQVJB-TPOjEboTNMyechTukEg14A&oe=69C12935"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "
dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5zyqCMfh3oQ7kNvwEVDpVj&_nc_oc=Adkrsn7_boldyZ6iyztmj5KTeHEJNC3rexliIgLCNkBKrUvRPGnR6C_-Cg_l8NFUd1M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2Vb6Z5V5b__hyErrploCpN8cPA09Ya3Sg-LJ-3SHVsg&oe=69BD4CFE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S27mVy0_MbgQ7kNvwEjvc42&_nc_oc=AdmTHECgS9p2yeK1nmn1KZXWsoAyZmwY8BM7HW9YwqYRF-PZCrdQKW9kxOBpA_B642Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzraJC2dLhqFilpX-VT6W5XPklbDIlchf37YJilk6PCpg&oe=69BD31C0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WaLdhgjwgoQ7kNvwEKg7e_&_nc_oc=AdksD0ugynIv6JvQbdBbGlDInZ1bYiY-1nPIZdktcl16d1T2gGxrGDCv6Tuxm0ZdeZI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8HOfg_-eyrZPCJl-P6eSfzEM1aqlHLtBesUtWGlY1dg&oe=69BD4F35"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxv99RNy5SYQ7kNvwGNEHbG&_nc_oc=AdlZbB6oNBkNR6LUC1ONFZ0ECipf5sDUpYSylOmBCYBQtaatrZRW52YXYgbPj4qj4jU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzClRebNFtH_FQ7cdrdl0Xse97Ob7ZjEC3EIH9iT8dymg&oe=69BD568D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk7Fdo7m5vcQ7kNvwGDmWKM&_nc_oc=AdnJPBgmr5nQA00OXNHVucFq2QuDJfuAK8slNN-ZNr6IOge7jWg2T2woU2xo8qVccF0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwejX-0mg8rTmQD9D7wvxzuKzZgd6LkI49B8k6vq7E4Tw&oe=69BD34B5"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "
dn.com/v/t64.5771-25/499308045_798537929307276_8651958680530971363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Os6B3jyXwQ7kNvwGPjuIe&_nc_oc=AdkXva2tica2rLcgGlp_I_VTlaWNZII2PwYXoAWp_86Zn1IDS9DskaPr1g77J-kNTWc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9L-hepgp1ubRJ-p0SjttKRKj5KfoPjYkS_-yZAoPHew&oe=69BAA9FE"}, {"file_name": "Screenshot1.png", "id": "688465540498073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820836_688465543831406_352115182270638519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S27mVy0_MbgQ7kNvwEHU7Il&_nc_oc=AdkyRfiPGxzQcFy87b7QONYLv2er4Q2B9wwysomJAadaM4cg40bLvz2_eatsWP0remo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxOU91_--Dwizm8xNHYDYs-IAg6SHYc7vMyB9Nn4P5iA&oe=69BA8EC0"}, {"file_name": "Screenshots_3.png", "id": "787540970433204", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_787540973766537_8946748476236305487_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj1nr_EQYmIQ7kNvwF6uqJo&_nc_oc=AdkaplIU3D4ndBlj6yh2K1ZlEQhnpW9Njg-AJuUwQs3fpJ4Ltkz2Z2rfKmU0S04uClg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmCRz8v4X1kJ68oEm0MinMZ-kdomvB-wCNs42Pz1gfUA&oe=69BAAC35"}, {"file_name": "Screenshots_1.png", "id": "724536820643210", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303140_724536823976543_5860653358951322669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZHEIDWj8tkQ7kNvwGp9QbB&_nc_oc=AdkfZYNuwjrp2Jz2e_Ce0-9kMUGVYZWXQ8gORCzZ7oPr3dA9p4591NwZb9_x0hmPwco&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZiNsI1HYzJQBIwjIdFh7ahNj00GsPU590xyJTZscnFQ&oe=69BAB38D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Pro.png", "id": "24905561095771066", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818878_24905561105771065_7214809891333911872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ACrHwVEf40Q7kNvwGhSxnY&_nc_oc=Adnh2h1O6dy7bfhSCRd5PiKbSPeAcVHA0aQj3tvuqbjloefZpnzqnfNb55YlbnHuNfQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyH4QmwL5dZ9lcx1U8URS0WKafw2QAu3Qj7H1QPkoQHQ&oe=69BA91B5"}, "display_name": "Spatial Zombies Pro - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "zombie", "survival"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, precision rifles, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{1933742264071420}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{697527016635555}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{1158455589447771}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace, or simply need a break from their playspace.\n\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels, perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "
uOXhxPU1GrvcBlosGSR6Lpuy4nwoBN8tv4hRuFiYQ&oe=6AAC0B28"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE-dV2WD1lgQ7kNvwG4nmC9&_nc_oc=AdpOhcefjENVNljueIPFc18roPKirXinAiX6zAJvvxzGofcEmwvx4dLvTniB4MZCzSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqaQsm0DrxDCWlNDylspTc7DqXqQj7KtfMPqU9S_5dA&oe=6AAC0ECC"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIJNr41zCY8Q7kNvwH9E0N4&_nc_oc=Adqr0Frl5DAkjcUfQjS8fzK2aPL_qJVD3YvSBYkzlSTMxFRKAbwJNdkdoRHYL-i5jlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEMuPoIeu24Fb_7C2h6Lc1tzVgTvnrP-lCop-Nd6XUhQ&oe=6AABD939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIaPhtLRIbIQ7kNvwEB0ym5&_nc_oc=AdqVuByO4xWg80vEsKx0x0lLf_T_7Ttu90K73PDAOqbKg9aQFMwkEA6EuKz1nJjpO6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjeZwoiZ7TUOzIj1NSVUCl89XQrE87JitDxeSTVEed9w&oe=6AABF740"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3GBDNV1X3oQ7kNvwHrexBM&_nc_oc=AdpipZ9t8D9shfMyns7PAPsv2N12jriws58c14NcGIrjGbvKwy2_fiFi85qx6PvtQCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGp7FjyxU9OD03BACxNpC674wtJIyzsIxxqXQISDnNdw&oe=6AABDA1F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otsW6qDpYkkQ7kNvwFNZzpN&_nc_oc=AdrpuqDmYdQ16J_-o7vyokCVuZVPVfiF6TKGHL5yUvcUxHHzK8E2DmdQpnVHEaS_moM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
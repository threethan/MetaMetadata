k8v4Ej4dDN0ifrgM1-iqyQ2kJVDG5pnL7lQRgWN2w&oe=6AB3F428"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PbFubvGDJMQ7kNvwFxYq_k&_nc_oc=AdoK41Z7rv1fYEGbCT9zAOJjav4poCUfOIF15j45ZSKW4ja7qLtmlwrguBokIMenpPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNnDkWaYfc_r7seP8_fSMFCHhD3ormlUKQqS9ZbtUK_g&oe=6AB3F7CC"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y8qtkonkqAQ7kNvwFe1wGg&_nc_oc=AdrTdAFxalqTrZYVcBa6HBIVMwUWZ6TD8LKB8p5ITDcyjxNo53J96SG8yCK_jS3fQqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9YOvJmPQpfL62Su8ejTfy06vzswNj3Veu-WRuNlqpIA&oe=6AB3C239"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A28ZVxOIja0Q7kNvwFDZbl7&_nc_oc=Adoij_HrMzxtCRtsfCfZsvunWFnbBHwaZQowCKT8o5agl5Xl7-ibwx912AliQHx29jk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAqVm8NitR1JHwNXCjHa3WGh6eD8q-70R_zJG7u3LVyQ&oe=6AB3E040"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6I4vk4LsaIQ7kNvwEqeUBZ&_nc_oc=AdqjBTiCCUeC89dJuydjqYsk3tRFwkyJIUuDZy7uBWk8VDBvzKJLhnYbVsAX3meeWT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_ei5o9jolf-DdIPDhd0lOrfM_FoEdQHTgMmtvgy40nA&oe=6AB3C31F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86mZRz_oOMkQ7kNvwGh1wmy&_nc_oc=Adr_4GgNLC144zwVHDfMbHUY91899XaXIR3Zy3ZUXdwtIqbapBXtNnm3ZBRw9Yv1Yas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
k-h3urhK0wLJdxiz9B_E2cT81Kr6sGhIrLeF1uSMA&oe=6ABFD1A8"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7lWAsSEM9gQ7kNvwFjIHl0&_nc_oc=AdroxXuf0m_RSCGvtG0FsuBLwyASt0iDtXxoo_J223c-dLUaK-lS5qZFtvT9Qqcf6q0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqPRDLl2DAc1PRlmX0LxZj04u-J_hZTfYxmWeE6OYe2Q&oe=6ABFD54C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUdhAp5y7noQ7kNvwEuQNod&_nc_oc=AdrE6tJkRB5s0Y-Np8do6HUJdu2flSKVQvLEk2HorSylcPbZQsLaTvYw8wfP0TPw2ek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu2Rt9ippFR1W_08wDQ7zUZfkNyHMutgfP8ltOKhJLAQ&oe=6ABFD7F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mXq19C5ausQ7kNvwH8321A&_nc_oc=AdpWhFxZdzxv9t29DnGi_Gp4xebMUa4YO-W4IALNKRPwmvok5mPyz3bDR_r1DQSW5jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd6RtnMhlrP-cHzQQk5_ZiUlq7G2afANeQuPUIemst6A&oe=6ABFBDC0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Npi7xA_K8iYQ7kNvwGYJX5_&_nc_oc=AdpY1-ajrSSiYXc7wIPfNRRrZ_mKRZU-3a46L4w_UISVw2zN1b07e1cjv4T1Ub-xU28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDNk85FNwQdjAaRCJjESwznp3-zaFx-gaOeXw5wJCmsA&oe=6ABFD8DF"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMrsRYQ8tfkQ7kNvwE1Zl5F&_nc_oc=Ado4Y7SHUaJmS4SrIuKIYMohy-BbhAMTw95gTigkPGr2Dg2THJ_239NxL3s-f7Ay59U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
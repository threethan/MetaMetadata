be3ku3nHWxgQhhEnCQdBuSbMhle1Odvy3QRgfdMKQ&oe=6AE8B028"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZZc2AqMEVEQ7kNvwHHhJh5&_nc_oc=AdpXx2Jvek4csnVwQ_5k866teQbL-L56BrckGS_bo1Y1APVKwH5egN-LEIsVx7hPdh4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxvmGoQ85i_pUzzFpLvn6ybu2SgJo7gehhvH_k6_u4RQ&oe=6AE8B3CC"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKuGW9ckNEkQ7kNvwGg4IeX&_nc_oc=Adr2-QA8TDlkAc9PMfZ9bFRlpt5XVgx_Qqy5Cw-l071Zi6DUivdYsbHHHMznpTYAioU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy7eVwdbnpKBsNvm8AN_o2n8QissOkgGAd9hEvRNmFHA&oe=6AE8B679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auyxm8fUj9kQ7kNvwHo9ltH&_nc_oc=AdoNsJG2iBiXJg1GZkeHoAZsw3BY5aVHhfwrmWguE6RXIIkx2Xsq_OXzlNHjCD-uSJk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqBglSixdEpEvmm3TDupsjPEwoXRykmNbcLvudfKAqCg&oe=6AE89C40"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L9ZYV6beB4Q7kNvwGWcRwC&_nc_oc=AdrqEonGZ0ocGICGgBEkfpBvp4yqygtGR3MXsIs6JvEkpl-f_-l4ljriOt817dZRqEk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKpkYpOdJL0uK3mxnd0_7mExkDvoKJl8ymOVtRqU9oJQ&oe=6AE8B75F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF9Th0UwvM4Q7kNvwFWZDzQ&_nc_oc=Adqy5-HIUL_gCY1op8CE6yoBKvROe80WCp6t3REW9M2X08QXpSZ8doc0PXdnCvBshLM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
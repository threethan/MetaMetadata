iCRkUq2lXMAmbGFoFNZUQognNgRrw-qTm4kaTQfvg&oe=6AA816A8"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_URKWaZaMUQ7kNvwFQCdJ7&_nc_oc=AdrF0VUaJiMqW5l1w0x9jQfZxyW2f-rs_Q6N_ddF_sgSoZm3-xJEgkubZ5LTa-P_u_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7LJEqL7646G-ybt7HWYwIp2A8d2Q3cE6u1PgXW82izw&oe=6AA81A4C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YUW4WGUZcQQ7kNvwGl79j3&_nc_oc=AdrokIo87paQdvTEg3MC9YhEW7CSiHyT7NBiUHoFrAnOo8O1sV1gI9a2TSE95US3dsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOCYJtlU0G0YPZnFuzYh5omYgbS4B-XLVVGVLn0kwE4Q&oe=6AA7E4B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9kiUfPUk48Q7kNvwGurHFI&_nc_oc=AdpMwZ3cTZ-n2nQXVfBiLIbucAWQeoFw2bnP6wk2LAjZX1d1OoKMrtN3BJFWIoW2d6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaR0TqJdUtpm5FafbG6XCJ0BdUPhWRmQspzmFFZaSLTg&oe=6AA802C0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeqo5Qr2caMQ7kNvwHLxM2K&_nc_oc=AdqSWL8l3_R7QgXL-CXnth0tOCQkCrjFo3yN3x8sjFsSKfZEG2jHCxrAabPAmIKgmgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_hkjv8y_GZe1osN8KcHo6rFHBLfUtYXS5LGi4SAGUoA&oe=6AA7E59F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeVOyGKY_DwQ7kNvwHXJnvu&_nc_oc=AdqfK1ZjFvj17YBn4b96zpH12Wyovlrdqncdp5M0OL2fq_XHE_cM6Bpr3WxSlcnx-cM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
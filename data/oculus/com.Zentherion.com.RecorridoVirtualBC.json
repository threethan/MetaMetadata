9uKJ25cZD4iTfldQ9IapX8kSccxW2n5FvnufxXI4A&oe=6AB15128"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PbFubvGDJMQ7kNvwFdhiS5&_nc_oc=AdoR8h3Y6hA7HsRunMGYt2TgHwEBiYuanJIAmGbiTg9ncNFkJaHFARFaoXthjpXlU5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC1fHq8uSk0Hsnxw8onUnPCJZiavzSX2fT3sgWCDdtCQ&oe=6AB154CC"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC5kbWlWwr8Q7kNvwFomcuf&_nc_oc=AdofhV37LYpP7RxVYuGW55m4jMW1yXeuW0EZb7rbdalcInFJurH1HX4mA2htRZqjuQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy4vGm_wgcrwdk6PgR6bzQQeckGW9hD1D-iQOau-P_7Q&oe=6AB15779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OekGa-chHzgQ7kNvwHaVcUF&_nc_oc=AdoO3m1cWysE_WjJIHvQk7m21V2xB132eY9eeUy6N1EHMxvmpXMnhxVZDzUE2_smNbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEIVDyWkaTTEuVcMJMsXEZBMDuKikqdyW_B8QXHCwh4Q&oe=6AB13D40"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0Zhk845q2IQ7kNvwGblC-y&_nc_oc=AdqzJNgiiowA5Ohhmv9aLOQHV9mI3ghlUoW_Qa0b3EfBydeOYazqUJBjDOkHr8m6vgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg3v6HnrKZC18pKzqVcSXs1Xz4qLfdhfsK2s-LH-kHLg&oe=6AB1585F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I4m4r01nvYQ7kNvwHVHyWp&_nc_oc=AdqvDI0az59ZedlWMTIzWOxdW91Sqgo5O_p8k8RxxGte_AM_XvWQnFOSyWHNDYM2APY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
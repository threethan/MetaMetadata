Zn1JyTCOwJYsQU5D1LOK5CwPKbjQnrcc2KPFCK3Lw&oe=6AEDF628"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3ZcbW5o1kUQ7kNvwGBlbW5&_nc_oc=Adpxy1H-HB3fntwD7lhDyW2PaAOy4Ps3fxGrTfOW59SUvAVgY7jp9ObKz0E08pDBTFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXoy9Acl9AlFCsqzH0gm6KljzzvAqk-4neZVxmb_D6iQ&oe=6AEDF9CC"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePEizMKLpVoQ7kNvwERZAT6&_nc_oc=AdpJhI4a2Lg1RARxap2C3TsBSJD9AGmpa-sqKVMDoYH2KrZgJjX0YkS7oEetNbDnfSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzQxMi1AbrlJNE3a18UWatz6OaNxiCGdsoVCwwkU8TWA&oe=6AEDFC79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCAz0f2NDiAQ7kNvwH8XKV-&_nc_oc=AdpjceMF0OFEnIfTQ4j76W4LTSEtfBgGbYMPI3FNEVMkMGKkqxO7rFFD92jcKt3zsBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS92IjcJ25rgh2SO2e8hx2qeUiaNIXKm7tVhAERWOFLRw&oe=6AEDE240"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STSnnBm_iIgQ7kNvwHNQn1D&_nc_oc=AdpY1_x3ZFs6jeS45Ijf0UWCpTRyIe2tbGoxgaxPLKWoTUo1mQdbyEXG1226dfJaRPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4g0fN45c0iPlEtrvsF86JfYriMP2s8vhpttgfvV9KKg&oe=6AEDFD5F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfGd3-r4togQ7kNvwEl59Zn&_nc_oc=AdoEWs8blVFkCSrwNangjk42--G7rx71SBS4rhXFKJ_VsgLIAF_UheEvBWyIGRe0V0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
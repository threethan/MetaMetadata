zdwP7Fh1IBskekSYIlqJFQzirz6wNq2RcLccPTY-g&oe=6AAAB9A8"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE-dV2WD1lgQ7kNvwFhxXv9&_nc_oc=Adqppfso62fe8PnlcFlVr2OhXqavBXaZbe8I2nJfQ03p5MdVgZDKvL6lrhZsfwTFk2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxy1MOs5yQzHTfHcyfcKH7QpyF90RIDRDFPIAsEeNSAw&oe=6AAABD4C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YUW4WGUZcQQ7kNvwEASIaN&_nc_oc=Adp8yWtnLPlIZN3DdaeVp_L1OnFEH6a-ZAWbvMCyYE0i9zZ234j0JN2Y5LXOT3m-9xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF8rDcEdA1CquHdZfCbXhtPDRYs8XjRmpo9ff635JI0A&oe=6AAA87B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIaPhtLRIbIQ7kNvwHgJlR9&_nc_oc=Adouf29kTFGc_xcwlmUFufAlhXgMuXx-q_UgX3MLRSOU2wQCzz9YKBYuG8vvPt3p3mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5KicdAcCDG-9ab5y1E9Rvaur7XldaDFOGTYBr0IB1fA&oe=6AAAA5C0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeqo5Qr2caMQ7kNvwEt1hxM&_nc_oc=Adr-RYXXzenkvg_nTi5Z5e0PZEoQK4P1fvkrRzfQJyV7LxhTO-ZiD9arPcRwQHyNSWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzV-hyXWCp6CVtwNakTzNuyjRgs5d5sxNX9ccdpc5NBA&oe=6AAA889F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otsW6qDpYkkQ7kNvwFAOL2Z&_nc_oc=AdqBTYH2YOgLyi09jHyKmsou9iOMj6YWmUle5dXjiia4aBWBqSTFE8rmdx4exmUmYuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
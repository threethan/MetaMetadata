ejvd2u3fxveidLqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuHBHEdCpvaSHSYP5MpFUkJjczSMXW8W8sepAJ8lAuSQ&oe=6ABD34F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNUmKx11SL4Q7kNvwFWUEAA&_nc_oc=AdrMIKLC-pV5qYRAKuZD7Mab6aGEWc8AZS5khJ-FPoaDRdJ50noauJzOF5PDk3jfz_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkNleDN14WPkBcZu80Sdf4jmDkBOSVtRBJImCWKEUenw&oe=6ABD1AC0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qWusaeYWKgQ7kNvwHGbZvf&_nc_oc=AdqRSjcih2FCdcjEm-963n__jY1tNFAa9NXZPqZrFK4Wu7v1mPTUeFxD09qw-w7962k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4T4bIRWFFcBxeFVJg0aWaFnI6i6NwmgNppxk0Bz-35Q&oe=6ABD35DF"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy947bThR_IQ7kNvwHlhVAx&_nc_oc=AdoLwpEAPgYT2frW1awwdliWbwHJ8ufBUbE4ymg-F0rQ69b0iWPeuviaufa4Z50mrKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFGBtG09DFc7m8Y_VHEPKu9iyHc1_Hiox9s8ImiNeNug&oe=6ABD2E52"}, {"file_name": "Portada cuadrada RV BC ingles.png", "id": "1620750789404107", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296077_1620750792737440_4907530135690742113_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC77F5iCCcMQ7kNvwGUg13m&_nc_oc=AdqAYgKVKEE-6XQ8ngBZlAalwxXIci5yuI8SnKCEOlYD82tIvNoVKKjs8JMZby8JlsI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsE_W_KnLI_UO7EGhe3Yj9jFOijk5YeuS7yffcTqitrA&oe=6ABD2D5D"}, {"file_name": "icono_app_recized.png", "id": "1387703446135149", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828008_1387703449468482_8864811888996530194_n.png?_nc_cat=101&ccb=1-7&_nc_
BssAzyUnc1L8-NeeIYV9Fczt_aKP2S7OkFbraeCAw&oe=6AC517A8"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUqrhVHtstYQ7kNvwHCOiZ9&_nc_oc=AdoLG8_CWjpX2GNH9fLiqSgaA6mk3B_Pa1VCigXTePKv73BCeRpSkCPGlJFdiJzu9UU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtW5HZs2g3hMOBsVruAHciSK8F-XRIx512rj_SY6g8XQ&oe=6AC51B4C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmjLozhW-toQ7kNvwFRJdW8&_nc_oc=AdrAtPAklly_obZll_KRejmutSpW8whAv-wULegt1nEqXcH8rKzw9fFKzhhLVYtmPdc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2GEkOnr8zNzxw_bJnme7XA3PXtjIJIVNCp_UCJeDbFw&oe=6AC51DF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBxykNwXFqIQ7kNvwGOlN3r&_nc_oc=AdrF4PhXpMR7K01pG2B0VEDi8Tvi-9YeWMLBwGtJK0JBMe9LwDCvPgN1fmGdsxC33OQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHiaT-Qpt7TxA_SIwg3HVZ1-7pLT187ru_ykiU8d3npw&oe=6AC503C0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC5ijl01GmIQ7kNvwHHs1ub&_nc_oc=Adq3nIYx8g-3pYU5clg44gYinNeaS9NO-0vra9SHkik2_xDO6bKOFDoA8wRR15aaII8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPROoYMXBtVzFOHhCGgCbrCcFwMXHjMNx3xk9OTM-yxxQ&oe=6AC51EDF"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXfuB24GjXsQ7kNvwGItaTo&_nc_oc=AdoO8VZ2kq2eSW-awPatfYs22LAJ9kK6QllEWbiw4JF2bigZBcY2NR4wG9szlgQHTng&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
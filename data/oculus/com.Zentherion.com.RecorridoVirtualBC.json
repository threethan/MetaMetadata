zRXBEp0Cb4-wt_OtS5XO4S31Iihl8HvZ_RFFf3M3g&oe=6AE218A8"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rXgWymTs8QQ7kNvwEZ2wfJ&_nc_oc=AdpW_mocfpYXPRiVZzAJAFCZ_O4HyTYL_Gq25AiEmQqWej_8BwELtH-TboTY8fZopl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy1brlsErzb7mOP6_3AyA-I9W75gQ7u9XYHprzr3VVRw&oe=6AE21C4C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl3TL2ilLmgQ7kNvwGq6Zbw&_nc_oc=Adp9xnabNNxZVm4t4ViNK_B7S8xycwsPVqZEVYB4lGf6_9niUjaxYasrjWlTeFNJhlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYktOAH34GTtBWIecmTh5_r6-O9oH9fm8xKvErAiHHIw&oe=6AE1E6B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpNxbtLN4EgQ7kNvwE4EMJz&_nc_oc=Adr05AabTLZuefwym4jLVB5egU4kLWS0REKKMwKTvg55GI6tgJVTbxA9V6KJrXsvqOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcwOvEGeDTkZtvydI8OPo1lgZ2uZ97XA6yfsf9-dQbtA&oe=6AE204C0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlaSriO6mTAQ7kNvwE3OrBR&_nc_oc=AdoHxsyxGeqQWRFxZo-fIezd7r48k-uuR5VYE2MWdcrWqKXOkv0_On4WOUt7Yk7EdnU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiMy8No3TuojrNojQ82eE5dcXh-l-PgAqLY1bl5MxZsA&oe=6AE1E79F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5k2piM-E45AQ7kNvwFwkCMq&_nc_oc=AdpAwha11_fJdhYLVD_lwXpwMW-qO76hg0dgCuYdD5k6gHOtmQrp-y_WgggJUMmcCHw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
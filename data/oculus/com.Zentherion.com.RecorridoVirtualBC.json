5CQTjGsUQiVRjC9GewV7X7CTKNbyw57QwnpQDSWRQ&oe=6AC90C28"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdZ9QSIiq60Q7kNvwGukzxc&_nc_oc=AdpsQ7f9vhr1AM2X7Gkq6yw8rJnB6PZ7PxvIyfEp3s9vnk_D5h7CU44T4fbuN8uwP1U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdRasqS2R2KYNj_JO6cD5s878EuaOVxpj_8NeBbGuXIA&oe=6AC90FCC"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdOOwocrmhoQ7kNvwEzA1Rc&_nc_oc=Adrzd9uF2m4zSme1f0tXvu6FL8TS2YjTvLa9knHKa9FyvjD3UxJ9s3-Y68KjHg7-Dso&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwgbcwxSxfBXWJcpcXfzA7OYCx5po_n_8UoDnBq0HamA&oe=6AC91279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wPx52Y23R8Q7kNvwFPE_dG&_nc_oc=Adr-xVwj_DYeDhI_g3fIDa8pLCr304Q_BQuCK9kWnO3S8q8LH7dNnIapM0jhrLq5BxE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiLKJJ4FhJnsxM3jpz9pweGSW_PrGSIFB1d_0xY55QBQ&oe=6AC8F840"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBIkj9Bl11MQ7kNvwGXetk8&_nc_oc=AdoDkkNANAhfMu9caXqjFsQ4zYeJhXTzOQgEKhv71PRlkZDZOzBQEhHg2CHh_sU2sO4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpiI5lhV1f1mSY_fUFCh0d585XGJGJlbAyAfuGBHpRNg&oe=6AC9135F"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiwCFTZJHqwQ7kNvwGx3vKz&_nc_oc=AdpMc6UkZMMml9YqZXefblWoqXJG2dfq5mK5R6qaQaGb0HW2XFdNzkwhkdpHNzPN5XE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
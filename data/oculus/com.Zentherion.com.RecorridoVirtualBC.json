FNsw&oe=6ABE6B94"}, {"file_name": "btn-presionado.png", "id": "1540835903681600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298248_1540835907014933_2628021419138528923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=026H-dsxeOEQ7kNvwFwuuAP&_nc_oc=AdoCQNkrqHq0dOHgmR-Q5kSR9OuBYHzlJmnfs7MxxfEJZwlrGEUyqxFwC4w9Ih5kRS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf2qr2Ig8w3CXJCoDDz4R_oGyulgY2mrQekpqG1tMtJQ&oe=6ABE589F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "2037312223535819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296077_2037312226869152_2898980262005614576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xzF2f049XsQ7kNvwFL7FNB&_nc_oc=AdpJGHPu3CTT6RfJw09Os7Sdg8M3F5Pg_WqANpmwAvV1JXKcPi-LE3iP9XkeRLXVN6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4STe86Rkv4oNSnP322jmHZFJLkHvFgEA0WzyjjkIisQ&oe=6ABE57D5"}, "display_name": "VR Central Library USAC", "keywords": ["Guatemala", "Education", "VirtualTour", "Library"], "long_description": "# 360\u00b0 Virtual Tour - USAC Central Library\n\nExplore the **Central Library of the Universidad de San Carlos de Guatemala (USAC)** through an immersive virtual reality experience designed for students, faculty, and visitors.\n\nThis application offers an interactive, high-resolution 360\u00b0 video tour that lets you discover in detail each floor of the building, the layout of study areas, and the full range of available library services.\n\n### \ud83c\udf1f Key Features:\n\n* **Guided 360\u00b0 Tour:** View the different floors and real environments of the central library in immersive video.\n* **Informative Audio Narration:** Descriptive audio in Spanish explaining the function and services of each area.\n* **Intuitive Hand Tracking Navigation:** Interact with the UI and select floors naturally using just your hands.\n* **Educational & Institutional Focus:** A tool created to orient the university community and promote modern technologies.", "short_description": "An immersive virtual reality experience offering an interactive 360\u00b0 tour of the Central Library at the University of San Carlos de Guatemala (USAC). Explore its facilities, levels, and services featuring voice-guided navigation and gesture-based interaction via hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1LXZWgEzcrwTSRfgxBGtAx3S_HL5ZnMm3/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zentherion", "support_website_url": null, "website_url": "https://biblioteca.usac.edu.gt/biblioteca2023/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1269006072966699"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312306_1108021315513462_5237737507781769306_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xokwoa5cZhcQ7kNvwGSeG-b&_nc_oc=AdpGbKiGPuLgnNevVjMyU9mDyWATAe1uw5LsfmCYvUTqsxCIQhSjJLjy58Xk9YRI1WM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5D-XIz0ZNB9m7HbR3hIZpkiYymbNYCp9SJik2-HiDLw&oe=6ABE6B0A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
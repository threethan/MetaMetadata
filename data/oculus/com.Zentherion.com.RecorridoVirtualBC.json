6B04634C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63yA-IZCZLwQ7kNvwGpcrDk&_nc_oc=AdoJOhXswgJFP908q2xBJYs_5MaySeiPfWF0B2CU6KaKBa82xzb8CbbL-Ex8t7OFOy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPHeQdpwWg04cvKZx4mlajLpc1ZiMqz8NP98Xk0ATpzg&oe=6B0465F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRFbbWTwn8kQ7kNvwHWrqt2&_nc_oc=AdqMgp4wLygXrz8aPpMLDC929nz4ON0HeeafUJftM3g0DCACDJcqJorGOIznbzezzwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJNw3QGq7e-ICWGIO-pFRdBN-edx617LsVymWbPbV67g&oe=6B048400"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klSH8iAgn20Q7kNvwGprpDU&_nc_oc=AdrsOYTU0tnQ-R7ZHwcI7Ce4N5YE_sWgVEcMs_IGl8mt2oDrluORXR8LVeAiAtKkt5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe_KeAbzV-FNa1nGgfxpwu1EEWTrNbKx355W1WUxA2Fg&oe=6B0466DF"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ujtmLGlqtUQ7kNvwGI0gfD&_nc_oc=AdpK7s-YuGJ8ZxDgK-mGysnGynyYBSJ8oPjFG-SiMp82FE3Yck6H-L00a81qPa-oatk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuL-Dpvu-TxvMo5Y3-FBo2eiJI1kyCLff5ibk1ofr1jA&oe=6B045F52"}, {"file_name": "Portada cuadrada RV BC ingles.png", "id": "1620750789404107", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296077_1620750792737440_4907530135690742113_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoCFm2kY2w8Q7kNvwGxf0Kg&_nc
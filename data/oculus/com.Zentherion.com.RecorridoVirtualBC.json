EaRr35ndAJ_dUXzbTssAz_ziZt2d1YghfyS1jFqkg&oe=6AF9D3A8"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Y6dfptz3zcQ7kNvwEIaHEh&_nc_oc=AdpWSl1-Vg9_L7ZWKpk5feahrsO2qz1VgI9Vp4akmH1HZtAJbmZTUJC5x4svwEi-_gU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToHDd4cWbu8xkSRId_VIe0EN-zztDE2scSWmM3TacZfQ&oe=6AF9D74C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTpKJfjj_p0Q7kNvwFJ-M-W&_nc_oc=AdrnypuL7DTSJnkaYQ9I3SpzMOkfa16ZZmPCf5J8E5ywg-qPYwLU7W4q5PfW9p7PFpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMaI_Mia4MTlchIDUFXtwnGokzUh25IsOeysvrJVkgXQ&oe=6AF9D9F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUvI5vIRpOQQ7kNvwESZ2Ft&_nc_oc=AdqPQNuLtn_xK7ho23Oe8bRJjXdbLl5A4vMZo8NFw2cm_hNaB5EJixCQVrmptYkSrV4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdwpZoz5xrWZr2GPJWM_qOhJcvB1Oaf8o3njbrML7udQ&oe=6AF9BFC0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7mTVzurbccQ7kNvwEHFDX7&_nc_oc=AdpSIpHLU2vt4PZeQBThmTqKYGKFTmbFcduZ0PjY19hpACzLnVYrOz08dJO52uOFXXU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW8UY0MM_kAS_gPtYJ1agrD3Kz3gTZ8va8KqdTJk2I_g&oe=6AF9DADF"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf84ffLm2swQ7kNvwHCqmSP&_nc_oc=AdqAlatQ15fl1zuJgweHMF3j1np1coo5C-N_rmFAKm9UzuBOH-zqABsP_Fkaqx6ZliU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
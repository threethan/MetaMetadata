1-7&_nc_sid=6e7a0a&_nc_ohc=Bi2nSyh43VIQ7kNvwFWhbvj&_nc_oc=AdqtR_ZbILURibMbKr8yJ5YspQ1zM4Zmx2aouWL6hK6ZAIuQRLxv82-OmuuTbAdsorU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsnj6SIT_MIYLA5Dnui_XB_fse_JkJ1_hW9WgE0mLXkw&oe=6AFDB394"}, {"file_name": "btn-presionado.png", "id": "1540835903681600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298248_1540835907014933_2628021419138528923_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSIKxOvjMg0Q7kNvwHD03mc&_nc_oc=Adqotj9OMxF_fJbwI-Nz8tgG8kA6BPq2nZGCJ_8_6m46dF-4OH7l7P_csp0bvrV9-yQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuFy4pZnZYhAhG6C8tIDzuO1ooJgAHbimcE6z64XZm4g&oe=6AFDD8DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "2037312223535819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296077_2037312226869152_2898980262005614576_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u6DH0J0lWIQ7kNvwEXqD_b&_nc_oc=Adr7vS6XYBksKOECK5ggQgG4t8SNzFkOUDZfOOSbw8trCheFLW90NOjOEr4sxDuQ44U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG8SSQOpFA1yYAWesz-FptoO4T0WJRRwmYY7pRNzVaLw&oe=6AFDD815"}, "display_name": "VR Central Library USAC", "keywords": ["Guatemala", "Education", "VirtualTour", "Library"], "long_description": "# 360\u00b0 Virtual Tour - USAC Central Library\n\nExplore the **Central Library of the Universidad de San Carlos de Guatemala (USAC)** through an immersive virtual reality experience designed for students, faculty, and visitors.\n\nThis application offers an interactive, high-resolution 360\u00b0 video tour that lets you discover in detail each floor of the building, the layout of study areas, and the full range of available library services.\n\n### \ud83c\udf1f Key Features:\n\n* **Guided 360\u00b0 Tour:** View the different floors and real environments of the central library in immersive video.\n* **Informative Audio Narration:** Descriptive audio in Spanish explaining the function and services of each area.\n* **Intuitive Hand Tracking Navigation:** Interact with the UI and select floors naturally using just your hands.\n* **Educational & Institutional Focus:** A tool created to orient the university community and promote modern technologies.", "short_description": "An immersive virtual reality experience offering an interactive 360\u00b0 tour of the Central Library at the University of San Carlos de Guatemala (USAC). Explore its facilities, levels, and services featuring voice-guided navigation and gesture-based interaction via hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1LXZWgEzcrwTSRfgxBGtAx3S_HL5ZnMm3/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zentherion", "support_website_url": null, "website_url": "https://biblioteca.usac.edu.gt/biblioteca2023/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1269006072966699"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2177442409766993"}]}, "baseline_offer": {"id": "2177442409766993"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788285240, "status": "PUBLISHED", "id": "2177442409766993"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1216542651546375", "version": "1.0"}, "id": "1044642537926596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1216503364883637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1216542651546375"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1044642537926596"}]}, "change_log": "Recorrido Virtual BC USAC- Versi\u00f3n 1.0.0\n\nBienvenido a RV Biblioteca Central USAC\nUn recorrido virtual e inmersivo dise\u00f1ado para dar a conocer la historia, infraestructura y servicios de la Biblioteca Central de la Universidad de San Carlos de Guatemala, un espacio emblem\u00e1tico con m\u00e1s de 50 a\u00f1os al servicio de la comunidad acad\u00e9mica y la sociedad guatemalteca.\n\nCaracter\u00edsticas Principales:\n* Recorrido Guiado Inmersivo: Explora los distintos niveles de la Biblioteca Central en entornos 360\u00b0 optimizados para Meta Quest 3.\n* Asistente Virtual Dedicado: Un gu\u00eda interactivo te acompa\u00f1a durante todo el recorrido, explic\u00e1ndote las funciones, colecciones y \u00e1reas clave de cada nivel.\n* Experiencia Intuitiva: Cuenta con tutoriales de interacci\u00f3n y narraci\u00f3n de voz clara para facilitar la navegaci\u00f3n a cualquier usuario.\n* Acceso Abierto a la Cultura y Tecnolog\u00eda: Proyecto desarrollado para acercar las nuevas tecnolog\u00edas educativas a estudiantes, investigadores y visitantes desde cualquier lugar.", "created_date": 1785462058, "id": "1216542651546375", "version": "1.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1216542391546401"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
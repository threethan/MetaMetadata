PgG6mWiWvJAMn3tVFvbJCEjijD0vlJOnX49NBafEw&oe=6AC7BAA8"}, {"file_name": "UI-interactuable.png", "id": "1416455846998928", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307495_1416455850332261_6203269103202599089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUqrhVHtstYQ7kNvwEo9A3x&_nc_oc=Adq4JiSQQvqmiBBgmIixpIA6IDxJdq6YNpzqJyTTV0-Nk8LGgqx0qVDvgqIqSM85UFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeSEvF6f9aSkxOjgaUoGNLhiJpntDuf4SzPUQq29ZOcg&oe=6AC7BE4C"}, {"file_name": "btn-presionado.png", "id": "2250744662357008", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499313057_2250744665690341_6978204591135389924_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdOOwocrmhoQ7kNvwHK5Tqo&_nc_oc=Adq1NETYmI2Z6H5i73kkRdS-bd5yGpkwSP3rzmxYyqMeHuAKjbqmSN0g3Y_PTaHDMZc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTYGmvTYlMApiwTsvtH-_DG_gPjRrF9RMbWtn7nK-rOQ&oe=6AC7C0F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada RV BC.png", "id": "1060038923086771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302527_1060038926420104_7518079231440164576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wPx52Y23R8Q7kNvwEoYFxG&_nc_oc=AdpSC4BKe06FY7ikw7ufIrXB3ZRw50XiJgVSYd_8hqpADMb5SDnORFo8_v1MZn8p32I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjo73mo8X2BApuypRhQT66Vef9rJjNAHrY7gWmRo_LKA&oe=6AC7A6C0"}, "display_name": "RV Biblioteca Central USAC", "keywords": ["Guatemala", "Biblioteca", "TourVirtual", "Educacion"], "long_description": "# Tour Virtual 360\u00b0 - Biblioteca Central USAC\n\nExplora la **Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC)** a trav\u00e9s de una experiencia inmersiva en realidad virtual dise\u00f1ada para estudiantes, docentes y visitantes.\n\nEsta aplicaci\u00f3n ofrece un recorrido interactivo en video 360\u00b0 en alta resoluci\u00f3n que te permite conocer a detalle cada nivel del edificio, la distribuci\u00f3n de sus \u00e1reas de estudio y la oferta completa de servicios bibliotecarios disponibles.\n\n### \ud83c\udf1f Caracter\u00edsticas principales:\n\n* **Recorrido Guiado en 360\u00b0:** Visualiza los diferentes niveles y entornos reales de la biblioteca central en video inmersivo.\n* **Narraci\u00f3n Informativa:** Audio descriptivo en espa\u00f1ol que explica las funciones y servicios de cada secci\u00f3n.\n* **Navegaci\u00f3n Intuitiva con Hand Tracking:** Interact\u00faa con la interfaz y selecciona los niveles usando \u00fanicamente tus manos de forma natural.\n* **Enfoque Educativo e Institucional:** Una herramienta dise\u00f1ada para orientar a la comunidad universitaria y acercar las nuevas tecnolog\u00edas.", "short_description": "Experiencia inmersiva en realidad virtual que ofrece un tour 360\u00b0 interactivo por la Biblioteca Central de la Universidad de San Carlos de Guatemala (USAC). Explora sus instalaciones, niveles y servicios con navegaci\u00f3n guiada por voz e interacci\u00f3n gestual mediante Hand Tracking."}, {"images": {"nodes": [{"file_name": "icono_BC_reziced.png", "id": "27047388908269111", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_27047388944935774_6763783997275394869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBIkj9Bl11MQ7kNvwHBy1Ti&_nc_oc=Adp2qupSWBEqva21Nw2gkiH_51BC8AVu71gp9NK4kp_Bv2mM_9DczrdecXtqAzjR_m4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFTF7KJZ-qtjkZhSxaCfhJzp3dG_SkyuHZCcSq5ZUOrw&oe=6AC7C1DF"}, {"file_name": "Portada RV BC Ingles.png", "id": "2339304203268249", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295992_2339304206601582_3112068595879529671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiwCFTZJHqwQ7kNvwGoCMr6&_nc_oc=Adoi9UjWcxdR4Fterx0BzTNoFF-bCN4U5mZ8Da9uTzhD3E7ZhJOlblHB2GEvJPiaWvs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
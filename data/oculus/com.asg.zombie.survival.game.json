2n85N6r-f6wwsYS6bk4Jc07T3CMY1H4xcImPMI9MuCNQ7DMicu70QOOn8kbfo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsVpz_U8JRVRsZa5tx8oe6CGwtHfvPKfnH-eDED-LJVQ&oe=6A8AC43F"}, {"file_name": "f.png", "id": "1486952462883256", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308230_1486952466216589_7038144196732997319_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2ocm96x2gYQ7kNvwGSpmNS&_nc_oc=Adrz6N-RXV8HtYmzpzcwZhKJNKb-WLK87ip70lsrgofXjau5NVAmuFG6miQRnrPXCZw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEvacv8FTTVKzmiCC1KFOrDb10J6U8B4-uvEz_h8xSMw&oe=6A8AF090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v_1.png", "id": "1011068174585131", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623370_1011068181251797_8525591070726300887_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwZyNWOYuUUQ7kNvwEQneKX&_nc_oc=Ado1GZlvYsBd62lR3tjrlX5WJzaHF2KFKQGTwm161pB3KgvdXkuM7ooticsiksWQVNo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDFcXGezZADxYmlgErFK7uXrLw41MrB39_MtejOtIxtg&oe=6A8ACCB8"}, "display_name": "DeadZone Zombie Survival VR", "keywords": ["zombietown", "zombiesurvival", "zombiechoas", "ZombieTownFrenzy", "ZombieHunterSurvival"], "long_description": "Step into a terrifying post-apocalyptic world where survival is your only mission. In DeadZone Zombie Survival VR, experience intense virtual reality combat as you fight through abandoned cities, dark streets, and dangerous dead zones filled with terrifying zombies.\n\nUse powerful weapons, defend yourself against endless waves of the undead, and complete challenging survival missions in a fully immersive VR experience. Every sound, movement, and encounter brings you closer to danger as you explore the ruins of civilization and battle for survival.\n\nScavenge resources, unlock new weapons, and test your courage in realistic action-packed gameplay designed for virtual reality. The apocalypse has arrived \u2014 enter the dead zone and survive if you can.\n\nFeatures\nImmersive VR zombie survival gameplay\nIntense first-person combat action\nMultiple weapons and upgrades\nDangerous missions and zombie waves\nAtmospheric environments and realistic effects\nSmooth controls optimized for VR\nOffline gameplay support\n\nThe dead are everywhere. Can you survive the DeadZone?", "short_description": "Enter a terrifying zombie apocalypse in VR. Fight undead hordes, explore dangerous environments, and survive intense action battles with immersive virtual reality gameplay. Grab your weapons and stay alive in the dead zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/artsidegames/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Side Games", "support_website_url": null, "website_url": "https://sites.google.com/view/artsidegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35733626172918414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499314659_2512023582564230_8424834107446710173_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K--03-tLRDsQ7kNvwF2ffeT&_nc_oc=AdrOQRBYeMS2-Tblpx1UPSKNuGU3poSeA-O3kKnApUKD9VmQjWabFwqBixEjZKXOrqE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9EGeg-tK-iP1gFSMwh2UzZ-KvZs3tKpmj
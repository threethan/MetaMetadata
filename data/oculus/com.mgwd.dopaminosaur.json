5179077914_5444316060805566008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHbwwb7xVgsQ7kNvwG4KiA0&_nc_oc=Ado7KRTNTnnrbhZ-lOwtrhblzzPiUfZF36XqMLZJP6Cs3i93GETQ8ZR793L2FhdckN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgXTkGThzi2V6v2GG6eJ9gl4qsx9HtTnXwlCuzBGDaiw&oe=6B0DCF25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-11-15-22h04m15s403.png", "id": "2719551148498001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_2719551151831334_4586142582949813528_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02p9ezQ4uBUQ7kNvwHg0wxD&_nc_oc=AdpOs5I6CQ3DhIyMpK51OKD-GWB5gSDkE1i0RK2m_8ft-v5InH_nDQMbbkm4nLU_Nlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLg2LJJs7b9tqjFsjN6iTP3InMgkklNiqD6OSkGsn5Wg&oe=6B0DB0FA"}, "display_name": "Dopaminosaur", "keywords": ["brainrot", "minigames", "insane", "satisfying", "dinosaur"], "long_description": "Dopaminosaur isn't one game. It's 30 of them, glued together and fired at your face.\n\nOne non-stop, 35-minute VR ride. No menus. No tutorials. Nothing to read. Every 20 to 120 seconds the game changes, the world changes, your size changes, and sometimes your hands do too.\n\nIn one sitting you will:\n\u2022 upgrade a slingshot into a nuclear rocket\n\u2022 shrink to ant size and get stepped on\n\u2022 get swallowed by a whale and find a disco inside\n\u2022 get interrogated by the developer about your review\n\u2022 fire a chicken, a piano and a cow from a bow\n\u2022 throw rubber wrestlers until they come apart\n\u2022 hit a jackpot and drown in coins\n\u2022 slice the Moon\n\nLook down. Your hands are spiders now. Then hooks. Then fish that bite. Then octopus tentacles. Don't ask.\n\nCartoon low-poly cuts to photoreal cliffs, neon, paper cutouts and dev grey-box, mid-action, with no warning. Every hit lands with sound, particles and rumble in the same frame. Numbers climb from +1 to +1 billion. Every segment ends on a punchline, never a second too late.\n\nYour host is the Dopaminosaur: a T-rex who desperately wants a high five. The arms say no.\n", "short_description": "Put the headset on. Hold on. 30 absurd VR micro-games in one non-stop ride: turn a slingshot into a nuke, shrink to an ant, get swallowed by a whale, slice the Moon. Every minute a new game, a new world and new hands. Hosted by a T-rex who can't reach a high five."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/dopaminosaur", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/dopaminosaur?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1615773349677270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771279_3238874822985345_7379526613327638403_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Lh0AJ2k1ZcQ7kNvwFJf6tY&_nc_oc=AdrZoItKSg1EUPHx8cLZSsBdzyhgTZr_t6HAzsW-ohJ5sGTgghTdOmHFPmt8bnNPRVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRC3mTdhuhb7GHUuan2YubqIEVwFJZx7Up3AIVTlZSkJw&oe=6B0DD0F9"}, "is_concept": false, "is_test": false, "is_trial_o
91824322_1097968616470913_3818485662242075682_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWdbc9g_VF0Q7kNvwHLWkm0&_nc_oc=Adpy3lLZWip3ImbDYTKNMGtTiqcMxRRYskI4gLFMnPDRlcUWkuDN4TdJAN6wPTCGUOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQcQUl_5Ugb9cpCo4iLpjxU4XA__TqxSRkQ0_ip3p1yg&oe=6B0DA23E"}, {"file_name": "03_octopus-fingers_dino-host.png", "id": "2256273815770862", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_2256273819104195_7967822398227843557_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=509nnhdnY-QQ7kNvwE9tM9I&_nc_oc=AdpQVRD_SJDknDtqIfRgMLfL2QnnNGPOqvRQJREnVioa-i85erYTCfVZl8S4kpp-cmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_cwxlopcAFATkEajpsIFQ92h4VGTx4iy7NpqHOLrHXA&oe=6B0D9F20"}, {"file_name": "04_ant-simulator.png", "id": "1671935881277042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823949_1671935884610375_2610586639466497210_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFUE4fdOTb0Q7kNvwEqpjVK&_nc_oc=Adqjb3MwnJKJykFoyLozIkkiTCccPVYG6LpPjgsQLUF0wO6XYrN5qAsifaGAe7ZxEXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqcDBlaal_ixs10gVisjQBA43ffS9ID2G_Z5cQzylQHQ&oe=6B0DCED6"}, {"file_name": "07_fish-hands.png", "id": "1701873728270277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819836_1701873731603610_7940814313308313029_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu7n_y4v6gYQ7kNvwHr2AIR&_nc_oc=AdrIGBvbxWX-gOPsIpRCxneTKp76Jd6J32JqoYExXkJKDRFtvgwM2qB6KrJ0yxR50R0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTc60ueMxliU6utPTkdr5e0-5h3cxIBxSd7490ooh8_TA&oe=6B0DCDEC"}, {"file_name": "01_shooting-range_nuke-duckzilla.png", "id": "2215005175744581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_2215005179077914_5444316060805566008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHbwwb7xVgsQ7kNvwG4KiA0&_nc_oc=Ado7KRTNTnnrbhZ-lOwtrhblzzPiUfZF36XqMLZJP6Cs3i93GETQ8ZR793L2FhdckN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgXTkGThzi2V6v2GG6eJ9gl4qsx9HtTnXwlCuzBGDaiw&oe=6B0DCF25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-11-15-22h04m15s403.png", "id": "2719551148498001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_2719551151831334_4586142582949813528_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02p9ezQ4uBUQ7kNvwHg0wxD&_nc_oc=AdpOs5I6CQ3DhIyMpK51OKD-GWB5gSDkE1i0RK2m_8ft-v5InH_nDQMbbkm4nLU_Nlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLg2LJJs7b9tqjFsjN6iTP3InMgkklNiqD6OSkGsn5Wg&oe=6B0DB0FA"}, "display_name": "Dopaminosaur", "keywords": ["brainrot", "minigames", "insane", "satisfying", "dinosaur"], "long_description": "Dopaminosaur isn't one game. It's 30 of them, glued together and fired at your face.\n\nOne non-stop, 35-minute VR ride. No menus. No tutorials. Nothing to read. Every 20 to 120 seconds the game changes, the world changes, your size changes, and sometimes your hands do too.\n\nIn one sitting you will:\n\u2022 upgrade a slingshot into a nuclear rocket\n\u2022 shrink to ant size and get stepped on\n\u2022 get swallowed by a whale and find a disco inside\n\u2022 get interrogated by the developer about your review\n\u2022 fire a chicken, a piano and a cow from a bow\n\u2022 throw rubber wrestlers until they come apart\n\u2022 hit a jackpot and drown in coins\n\u2022 slice the Moon\n\nLook down. Your hands are spiders now. Then hooks. Then fish that bite. Then octopus tentacles. Don't ask.\n\nCartoon low-poly cuts to photoreal cliffs, neon, paper cutouts and dev grey-box, mid-action, with no warning. Every hit lands with sound, particles and rumble in the same frame. Numbers climb from +1 to +1 billion. Every segment ends on a punchline, never a second too late.\n\nYour host is the Dopaminosaur: a T-rex who desperately wants a high five. The arms say no.\n", "short_description": "Put the headset on. Hold on. 30 absurd VR micro-games in one non-stop ride: turn a slingshot into a nuke, shrink to an ant, get swallowed by a whale, slice the Moon. Every minute a new game, a new world and new hands. Hosted by a T-rex who can't reach a high five."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/dopaminosaur", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/dopaminosaur?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1615773349677270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1457283026377612"}]}, "baseline_offer": {"id": "1457283026377612"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795201620, "status": "PUBLISHED", "id": "1457283026377612"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1618936746027597", "version": "0.1.0"}, "id": "1086527924416229", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppB
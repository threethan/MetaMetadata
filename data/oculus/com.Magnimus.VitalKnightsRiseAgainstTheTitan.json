nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdI1eOXLaNhOvxoQ7eFsXlaN8DbevOcOH-auAzsm4qfA&oe=6B0708EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Demonlord (1).png", "id": "870435171967683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_870435175301016_5336454415265310930_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvxI_gsVQnQQ7kNvwGSA524&_nc_oc=AdpPDsGJuNYDalr49mQ0yYAxaEeeZGtqlD4Z3UkbYXOpCC4HGohIOSLD3684sUrBcHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwPOSmjvWDtdOw89S9lrIEtVpKPHh2JYcet_HnPrWQqQ&oe=6B07215B"}, "display_name": "Vital Knights: Rise Against The Titans", "keywords": ["fitness", "mr", "workout", "fantasy", "adventure"], "long_description": "Vital Knights: Rise Against the Titans is an action-adventure game oriented towards fitness. Imagine combining fitness with fantasy!  \n  \nVital Knights takes you into the world of Ela, the all mother phoenix. Her world is in chaos under the grip of powerful evil. She will need you to save it. The future of her world is in your hands.  \n  \nYour body is your weapon.  \n\nIts your own vitality with which you save the world. Enter into a world ruled by ancient elemental powers. Emerge as its savior. \n\nThe app supports more than 20 different workouts across three different modes. Test your body to its limits. \n\nThe mixed reality design instinctively makes the player use their room space in its entirety. The challenges in game levels adapt to your environment. With compelling visuals and fascinating VFX, Vital Knights will fill your space with fantasy and transform your reality. \n\nFor best experience ensure you have above 8x8 feet of area. Rest assured, the experience will surprise you... and exhaust you!", "short_description": "Vital Knights: Rise Against the Titans is a revolutionary action-adventure game oriented towards fitness. You will fight enemies and explore new worlds from your living room. Most impo
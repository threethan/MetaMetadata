311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmPqHTq4_fUQ7kNvwH0zBf3&_nc_oc=Adre7bckiBSPVVCnmcWfbIHwyYXFufQrldZCdUoAB3CP5gAo_x_eigsJeaKrZRoQyoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPQa5Cni1zClKlvayhZJYHOz3e7PkUd_CR8vD5NxrePQ&oe=6ADF5013"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY4ROQJ_aksQ7kNvwEFLiqg&_nc_oc=Adr8bqPtzIHUqrgprYysnhkgXjtg5mY3lrRCMudpmnMtufx4hXvafhpwTqRPE7OLebo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1Nhybc5u_D6NDEu9PY6emXasfQqVxlsTphkmVwVbqzw&oe=6ADF6CFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-world.se/apps/onevid/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8632549326840403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "176753758676518"}]}, "baseline_offer": {"id": "176753758676518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735582260, "status": "PUBLISHED", "id": "176753758676518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8901500546611945", "version": "1.1.2"}, "id": "743050810636648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5957920727636623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8901500546611945"}, "
8285552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYCI1IQ6s-MQ7kNvwFTvD4r&_nc_oc=AdmahaJTgihCA-9Nfh0Baun1qMZclPegFbFnOxQm7aOOYE48YizJpm_V_fPvrXvtx50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftexc8bBnKy9Fi27ruxJFqUnr3RyU-TJ8Z5q3xnPKhFAQ&oe=69A2CC03"}]}, "id": "561409573165345", "locale": "en_US", "screenshots": [{"file_name": "Onevid-1.png", "id": "2730314460503982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_2730314463837315_6354007526650273336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG8wofb7s7oQ7kNvwFoJ1D_&_nc_oc=Adkxxw-QFzS7uR_Br8XiFra_enpVsdtoOZdRndNKcQUYrhM2vySZ3Dvtsk5CPFnXsXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsilL-OGm5fCj5hIx0Uj8EEsq8xaByi02OLLtZh8HG2Vw&oe=69A2E81A"}, {"file_name": "OneVid-2.png", "id": "1331873018226880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_1331873021560213_5134703935873476956_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PjsshB1V3EQ7kNvwE9wK3E&_nc_oc=Adli8gJGkgh_ZA15yVMyKb-udMNXnCo1P5NcXd5MlEaAjbcvMwUVcdn0oCTtgh0lQqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2vRxNBmo6PkesDa-ZnzACuT-SWS4S-ltalXBF3BcuJQ&oe=69A2EF4B"}, {"file_name": "OneVid-3.png", "id": "9717633708250863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_9717633714917529_690578978189514578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Miz5iITod-0Q7kNvwGwZ6TV&_nc_oc=Adm16lqGmYjt9ZFfa0k-ecRdsDpsb9sJ_Byx1O0m7Mi4vaB_whvwHOYU2PaTk_WkReU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4zLllzGRM1fIvw386ZAkTWrdx0qgaFs5Vz6kFYU07PA&oe=69A2F57C"}, {"file_name": "OneVid-4.png", "id": "1126311188850648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_1126311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a5V4IXN4boQ7kNvwFdn0gQ&_nc_oc=AdlaQuw7XSyb4SOXa0h1OM9UMFJUW4jwIUuzADX3ufTSSltZJJwJm2mXg0tD3hF9dME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBBu_Ct2EBEji350qx-EKZwZfXgHkk2x_5bZR5ljOsBw&oe=69A2E813"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKI5Jctz6BwQ7kNvwG855Au&_nc_oc=AdnWfwX0pAJejQa0juX4BuM3M39Dit3-T5-2SrL3kvWKflJsM_QfH-h2XfA_qv870lQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEkaU_LFQasGWkSNa9ujxERBOwqBU4uqT6iQ5tFM47RQ&oe=69A2CCBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-wo
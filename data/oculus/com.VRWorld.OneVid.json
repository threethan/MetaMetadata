8285552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTps48O-zMUQ7kNvwEKDSdq&_nc_oc=Adk21pTp636O2dXsuHafHe-7Q3VqaZ5OEp81J9cfXwiUpyn3ynQxelDLO1iJEzUp5G4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs1GT7oAkkiOUmoCdaxjbaFvcZ_hWAis9SJ0D9fnEgoyA&oe=699ED783"}]}, "id": "561409573165345", "locale": "en_US", "screenshots": [{"file_name": "Onevid-1.png", "id": "2730314460503982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2730314463837315_6354007526650273336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El2TD9LizzQQ7kNvwHdut14&_nc_oc=Adlivr_65Ap4rzSSK1cA35mDiZb75CLZB1Bf18rkZbGEV8-kDD3Inlv4yUj3F6mtwvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsM0H0wHuqHUwXlmao8ANNSJVG7YbPBcXpyYDdqR7wCJQ&oe=699EF39A"}, {"file_name": "OneVid-2.png", "id": "1331873018226880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1331873021560213_5134703935873476956_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivU-7jYvolYQ7kNvwGU5JU7&_nc_oc=AdmZmtRw_KW5q7Iji2nbobotdAbwf2BJjMJlnA4yV3SkWbc5yeYDZ1ENBLNpdM3WblQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsYCJRIV9d_l76i0mAFFUzdXPdBPosVz_ofUKv4hIT32g&oe=699EFACB"}, {"file_name": "OneVid-3.png", "id": "9717633708250863", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_9717633714917529_690578978189514578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-bbij-BXQwQ7kNvwFruycM&_nc_oc=Adkl9YZJahgJ2f6Zat2-TamSQlR6SN_QwLTUKW98ndW0tkKVBdVomoSwVblQL0JDpL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsCQvILBwMCICmKkNCbrlwY2nwcvQigY5ohcT_kJHVx6w&oe=699F00FC"}, {"file_name": "OneVid-4.png", "id": "1126311188850648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974581_1126311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnhdadbxvPcQ7kNvwGBeNP2&_nc_oc=Adn9QAo5MtDBn6iu09SZN10nkvBukPlfv-zCXsQDfkvCXGAWd4YycmhO7jiALMZyj2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft0Ondrob2p60m3ZSGguCS4aD7P3bdBjoQjWW7SYwHARA&oe=699EF393"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKeXXNIuKMIQ7kNvwGevVZ8&_nc_oc=AdlomoPIlqHK1o2pxUNPfWdwb_uQ-0ojzwdsgplgABIGlw7xD4H25j-KhvjrFQoLpEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftx7iJWOTUX-jsoO2bpdWQhXshrYzQT4ZrBLoTr8lEwqg&oe=699ED83F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-wo
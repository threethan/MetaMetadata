: "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_235573532421118_796284173838285552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZLad4-AEbMQ7kNvwHH3IlN&_nc_oc=AdoCwSBYqxxGj2eaKG81OVvZ3MT0RCZFtzjQtEvNhLVCIQViLK2FanbygHBMAi8gMl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MDcsnCkgML9eWEZjJRIts9XWSKyyC9mo0ua3bNDGQAQ&oe=6A073643"}]}, "id": "561409573165345", "locale": "en_US", "screenshots": [{"file_name": "Onevid-1.png", "id": "2730314460503982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2730314463837315_6354007526650273336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BstADRvk63wQ7kNvwETFdSO&_nc_oc=AdpvR8-iqxbUH2-sNHlFtiIoUNIJFwyyWnqFaDqb0I_o_W4zdrfJHYfh68aM3Z1-ELA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DvPF0ludWcsJJagulj7zk-e7MjvG7UIYwqgP6xOQx_Q&oe=6A071A1A"}, {"file_name": "OneVid-2.png", "id": "1331873018226880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1331873021560213_5134703935873476956_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxHViEoc3CEQ7kNvwEN2YM9&_nc_oc=AdpScrd0oescV-iVuH6U5vBnryaaG8bGBb7E-SgbPs_0EaARnRG7OIh__lsxzU43nDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78e813TKemdC_DE662yrZvlINmqDVyKyWW6CoFukiGdg&oe=6A07214B"}, {"file_name": "OneVid-3.png", "id": "9717633708250863", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974819_9717633714917529_690578978189514578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CathSqmusIwQ7kNvwH3IMvx&_nc_oc=AdpJnO0vXROSFXCVgekzs0nIegbkZ6xP2iKWTdiYeiRosZQ1RV1YmXm2Q0Y9Nllqo0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68plG3v3m4MjroH1Dw7PzLCt5R-CRJzwTIizRK_Sb_qA&oe=6A07277C"}, {"file_name": "OneVid-4.png", "id": "1126311188850648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974581_1126311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF7kEt93rEcQ7kNvwHNyiIl&_nc_oc=AdoPpqXiP-3rK8BaKIg_HbfIvffaEDllVRvMec-aq0sGeqZl4hWkbYS-ttnKVUUGAqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ic7EgRyORtSQrZ6L8ifUOhDD2qzZ48qdisEBZUBQptw&oe=6A071A13"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bwJtWnVNrwQ7kNvwFIw5pl&_nc_oc=Adq8gsoVexzgdVbyzGdy-FB18Fl4cPzAR2fgN7aXrnVVvVruPtH7ErMeViSxsbwm_pI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XlnGpH4Ox0mc8W8TPtUkUVR23ocsOzfJRlCvhO6RY2g&oe=6A0736FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-world.se/apps/onevid/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8632549326840403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "176753758676518"}]}, "baseline_offer": {"id": "176753758676518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735582260, "status": "PUBLISHED", "id": "176753758676518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8901500546611945", "version": "1.1.2"}, "id": "743050810636648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5957920727636623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8901500546611945"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "743050810636648"}]}, "cha
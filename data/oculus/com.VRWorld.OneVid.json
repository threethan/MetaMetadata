: "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_235573532421118_796284173838285552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zftb60_olRgQ7kNvwG9tsRC&_nc_oc=AdpNPS9Vqdyn8uZV6GwHiAH3KtCABVr_IOL6WLe85ckWptwu3ngF_NhHJqoyRHrqOkI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y_367777jnYqxbcmey5r3exUKTu_OTwJ2uuVNRkXtOw&oe=69DF7103"}]}, "id": "561409573165345", "locale": "en_US", "screenshots": [{"file_name": "Onevid-1.png", "id": "2730314460503982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2730314463837315_6354007526650273336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeGBUhibijgQ7kNvwE3gScw&_nc_oc=Adqc6srGD_oDw-FKDzZP0Nau-3lf-4QS2NSrvuWbe1U9rtcrULi1ekuwKUBrQxkVFnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T0HHB0yD3Y7Ficrjja6V4NGk0yZhb1zAHOVquEcRKsQ&oe=69DF8D1A"}, {"file_name": "OneVid-2.png", "id": "1331873018226880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1331873021560213_5134703935873476956_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctsgpMAgz5UQ7kNvwE0XJpe&_nc_oc=AdqAXHoQoeJZQpubWETWKAIplG3VQNNCpopjGPZcFb2k6rzTuNnp7w-08XDwG6raSCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1POEbqc4T_3sO1458DQpq4pR8BIZEeBnKirljtqF6Qvg&oe=69DF944B"}, {"file_name": "OneVid-3.png", "id": "9717633708250863", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_9717633714917529_690578978189514578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vr_acxExX8Q7kNvwEsnoJV&_nc_oc=AdqhTm7TOW6J-y9mVZCtZohdlKhGDckGM1uSWgTWCjLztuE7sD_q3gtLcecYV817hQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13jvh0w3R5RwHTloHWtz7ef-Schc4BthNcYSrGWBkmKA&oe=69DF9A7C"}, {"file_name": "OneVid-4.png", "id": "1126311188850648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974581_1126311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZJhHEkdbpwQ7kNvwFkn7s2&_nc_oc=AdqEzpM7cDZ6XjPpkNPSXuVrI-wQr_A2ovVV9uMZ9AxqFIWUJeJ5Hen8zP6FpfNPLhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x6UC_y-TMcygQf2Km9Anm5mKONPx4dqNpRyhRm5b8Cg&oe=69DF8D13"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvAYpR9FzIkQ7kNvwGVSD5z&_nc_oc=AdpNnWVZJMLClUEy9USJf3D1aSWAiyWnJp9ZJwmb6uCe-2kB_7k7i36h6ZBL1RY2GY4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af162ILKKmZjJTsGdy-0Sku28D-ri_F8EaMH4BEgHD_A3Q&oe=69DF71BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-world.se/apps/onevid/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8632549326840403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "176753758676518"}]}, "baseline_offer": {"id": "176753758676518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735582260, "status": "PUBLISHED", "id": "176753758676518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8901500546611945", "version": "1.1.2"}, "id": "743050810636648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5957920727636623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8901500546611945"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "743050810636648"}]}, "cha
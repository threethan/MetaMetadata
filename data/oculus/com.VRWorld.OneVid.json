: "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_235573532421118_796284173838285552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzbgX2j7GYIQ7kNvwHDQv3N&_nc_oc=Adoqh81NW2mN1OQiv38cOs_9COHQFbWLkYduSSC1zB4Rlwzv_WfvzyjWYZcK7IgIjnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4IShS6PZZcwM06VlL1ow6qpmIyd65lRNJ700UUp7p1w&oe=6A6773C3"}]}, "id": "561409573165345", "locale": "en_US", "screenshots": [{"file_name": "Onevid-1.png", "id": "2730314460503982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2730314463837315_6354007526650273336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pbIYTlatYYQ7kNvwFN6xok&_nc_oc=AdrzLre8_NEVdQGHCICntXpgKhY9Vv4obotumobeN7T-9Fdo4HbZwoyFVn2KW6anQ7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3hgN7Qjzw-TccHMm5JouyyZNGggS54OKdCXL7__dhYg&oe=6A67579A"}, {"file_name": "OneVid-2.png", "id": "1331873018226880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974819_1331873021560213_5134703935873476956_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXzKHppzHGUQ7kNvwFKgEB8&_nc_oc=AdoceBPg0t2VBrpjf3iDuWNJxSOOWiEm3Kh3HFTPBYvpddPGgiuF1hkpULBFi1jt9O0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbfsIcrSqh-IeUcxGOzyFI-1PTEojuLkQZpod4I_f30Q&oe=6A675ECB"}, {"file_name": "OneVid-3.png", "id": "9717633708250863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_9717633714917529_690578978189514578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2foLhlOnN8Q7kNvwGEV2p1&_nc_oc=AdqEuKQq2bfRBki-htcUTfAuw__RjaYg8gfMxe0zCrByu5eijOGPoZUi4sCvEqSkBQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyaNrgjfeavLE-d7ppbdm0DrqoG2U_DhwVrXAMZ76xSw&oe=6A6764FC"}, {"file_name": "OneVid-4.png", "id": "1126311188850648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_1126311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSzydmT59CwQ7kNvwHJarNH&_nc_oc=AdrfrTJi5oLqlJ0Ops60YP0EGsryge0clQtoXDE9lgUUan6txSIiB8IjzEHDlOn3wrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPvZVRvSSahDoKKONCe9kRXUZ5Mse3kPTtS_3QlMukOA&oe=6A675793"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_LzAlX_TakQ7kNvwG_Zym5&_nc_oc=Adryl5_YnJNf_UqImsUYY-XIqKw_StdyrieN43YDCU909Ex2-5VTK-MkHHrC60ZMisI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfero1Aev9Lz8KaWi_mis72GfPK03p9Gw0X_wb5NCklA&oe=6A67747F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-world.se/apps/onevid/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8632549326840403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "176753758676518"}]}, "baseline_offer": {"id": "176753758676518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735582260, "status": "PUBLISHED", "id": "176753758676518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8901500546611945", "version": "1.1.2"}, "id": "743050810636648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5957920727636623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8901500546611945"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "743050810636648"}]}, "cha
8285552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYCI1IQ6s-MQ7kNvwFIYn6C&_nc_oc=AdnySmevsoukD66WcrQ1151WfsoP_Mx6RgSilIEsReu_l2-yOBvCsyouXU6YzzgVu4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2kojlzCtiY_iXfeNBYRj4p0RJUFsdQiYGOtF6bKG8WQ&oe=69A02903"}]}, "id": "561409573165345", "locale": "en_US", "screenshots": [{"file_name": "Onevid-1.png", "id": "2730314460503982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_2730314463837315_6354007526650273336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG8wofb7s7oQ7kNvwFXQeyN&_nc_oc=AdnOwxwl2GpWEWLEX5W9yELH2gpDqOsNlT_KCfQ0aEerrzgXr2OTIY3ojWTQm_wICpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsoCVE1MePj-5I4pNgnLqL_9l6c6CiI-JFYCeOXMzn8lA&oe=69A0451A"}, {"file_name": "OneVid-2.png", "id": "1331873018226880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_1331873021560213_5134703935873476956_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivU-7jYvolYQ7kNvwGO30pT&_nc_oc=AdmRDjwljv3HNtK5m3ggadNIGUHT4SACmCkcQRZ-33SyvS6KakY5VFBWqDnv4SUYsPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuCPsBb2TeCux6f8zjIVU07enrt5AhxZoF3jmBpA9g8g&oe=69A04C4B"}, {"file_name": "OneVid-3.png", "id": "9717633708250863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_9717633714917529_690578978189514578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-bbij-BXQwQ7kNvwFH1VWL&_nc_oc=AdllQ4c3ZGP0P1c12cpxeeI8_5Lh-x8a1Fkfu6wc33csmBejUvmEOcwa4fw1z_imeU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUeEGUzP7RQ1AJtWPMkNYmU4Pfhoh7R5PsRzPcCzrRkA&oe=69A0527C"}, {"file_name": "OneVid-4.png", "id": "1126311188850648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_1126311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnhdadbxvPcQ7kNvwGXzcVg&_nc_oc=AdkdJCQ1EFPfNS2jIC6MQXMi8G-nexlaoqaKdeiF5VGKArSFBtrUIgARqPjyDh8CDS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslWo4qsK1aeGDlKKLtjPNkO_ZQ56EKoQKkU0QXaDE7tA&oe=69A04513"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKI5Jctz6BwQ7kNvwEQxM9O&_nc_oc=Adl54ohsU8Opwf5Qnba-wSrebjvtL0eH5_c56_XpHoA1QhXQbXXcQq8eOYgqUWwvJtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvs1E6huttN5XoTBkhJal3MJbF4FJ0qF4-rfekTnj38WQ&oe=69A029BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-wo
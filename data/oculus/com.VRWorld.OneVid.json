: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295751_235573532421118_796284173838285552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcOtEeLmv0cQ7kNvwG6Asmt&_nc_oc=AdptZswolaEsIOI0NqBqwCLmny5yFr_OtOfIABJ08cCwH2YIiNk1paAVQsHdyYSaUYk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_cKN5L8WsPW_hep3ZymuqM5yrpg6ivoaN5mg5l6LJCQ&oe=6A2042C3"}]}, "id": "561409573165345", "locale": "en_US", "screenshots": [{"file_name": "Onevid-1.png", "id": "2730314460503982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2730314463837315_6354007526650273336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMbhLNK2dggQ7kNvwFeea2I&_nc_oc=AdqI2KSopwIB0Fga5ttxljfPsJozaP1NxngumzHIApNs0msDj386rL-MKgduH2wAgAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fQ35Y7hNWbX1k6U46L0IuWUh8-CoDfEjrEV7cIX3OvA&oe=6A20269A"}, {"file_name": "OneVid-2.png", "id": "1331873018226880", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974819_1331873021560213_5134703935873476956_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baXVSi2_MT4Q7kNvwEMk9xE&_nc_oc=Adqc_JghxHlLB683FGsemf3cmsOKdhB4eudRyf4-bI5iwudrPU-Z_NWaFEWVuYoy0H0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yFFbkZpMRHBNUD4qIzSWJFlTuMkWkwDySVTtls2VZAw&oe=6A202DCB"}, {"file_name": "OneVid-3.png", "id": "9717633708250863", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_9717633714917529_690578978189514578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTPns1j2A40Q7kNvwERn7c4&_nc_oc=AdoSDyg57uP6kCNhdGAPNkLWJx6wWA1_D8WoPWFU_RbgxmC5v7KhEu9NW1PQgCDv00s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68iqbeJK8kdJK1uTytk22QI7J0Qyu7VqmRGryaI0v4Jg&oe=6A2033FC"}, {"file_name": "OneVid-4.png", "id": "1126311188850648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974581_1126311192183981_7073173460860251156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0ieomQdklEQ7kNvwHkZod_&_nc_oc=AdoXKW7EjhuFnxBUAjIsdoVmC8G0-DACEsu3ZV5cO5fpzdpwskEvQYnMBWiMMzGT5vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6912c7bYzkNN5VHLJP1l8Xc76QBR-bRCJTDhHuHBs1Rg&oe=6A202693"}, {"file_name": "OneVid-5.png", "id": "886638276916464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982705_886638280249797_6141826417910489615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOasf3nzBw4Q7kNvwEmqrDK&_nc_oc=Adq5kk5sLfTmcaKoteF9zc8QIuXkHjZLXu9rAmVi-LI9ptGtyOgoxpt0mJvTXTke-js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51gJorQMtdxZQdXRx-pV-FIgxIcO0gCR3BROZRol0q2w&oe=6A20437F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OneVid", "keywords": ["Video", "Player", "360", "Museum", "Convention"], "long_description": "OneVid was built with user experience in mind. No more onboarding!\n\n- No more having to manually restart a video once someone has finished watching.\n- No more having to reset the apps rotation to the viewer.\n\nOneVid was made for scenarios where you need to show off a video to many people, without needing to worry about rewinding and playing the same video over and over again.\n\nOneVid does all of this for you. Sign in to www.vr-world.se/onevid, upload your video and enter your unique video code - simple!\n\nIf you ever need to change video, our easy to use system makes sure to send your new videos to the headset next time they use the app.\n\nUpload multple videos and group headsets together for a seamless experience you have total control over.\n\nFind out more at: www.vr-world.se/onevid", "short_description": "OneVid is a 360 video player that starts and stops the video automatically!\n\nNo more onboarding needed. \n\nNo need for any controllers or input, simply put on the headset and the video starts playing from the beginning. Taking off the headset pauses playback - it's that simple!\n\nPerfect for conventions, fairs, showing off products to potential customers, art galleries, museums and other situations where you want your viewer to see your content without any input."}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://vr-world.se/apps/onevid/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8632549326840403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "176753758676518"}]}, "baseline_offer": {"id": "176753758676518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735582260, "status": "PUBLISHED", "id": "176753758676518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8901500546611945", "version": "1.1.2"}, "id": "743050810636648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5957920727636623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8901500546611945"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "743050810636648"}]}, "cha
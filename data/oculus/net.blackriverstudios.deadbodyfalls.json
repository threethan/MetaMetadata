b=1-7&_nc_sid=6e7a0a&_nc_ohc=8mrRqQelCFQQ7kNvwH9By-Q&_nc_oc=AdlipWggdgyZqld7Iney_74TQfUn5kdQBMPHGvRYO9hoSv5wvsCPNeYTXFKK9HSN3UE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvsu2MSDsmUlysN5YsTDrnYG8FF6WxsSqDik2JVhe_Crg&oe=6999BAAB"}, {"file_name": "migrated_image.png", "id": "658583381568663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xE6v1SkB-H0Q7kNvwGZIcHH&_nc_oc=AdlcZUKUGJ3ky6vT_YOnFn6T9lEZ6BFp-gMbg8dsb2psouh4fmHrKXHTAA8lh5s1jd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGAFZPTrHBVWXOPhiN64VpMWAQek3pCh9hlPgHlf5b4w&oe=6999B46A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will hep you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "NARRATIVE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "312488347351024"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1888960464500856", "version": "1.1.1"}, "id": "162301187770238", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1784608534936050", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1888960464500856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "162301187770238"}]}, "change_log": null, "created_date": 1531842433, "id": "1888960464500856", "version": "1.1.1", "version_code": 69, "release_status": "RELEASED", "status": "APP
20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzUqhivoIQAQ7kNvwHTYxqC&_nc_oc=AdrTM62bdZVNJ2qcmpm8Ekmz9i2m0cMgiDGln3S4L19m7eTJJPsuaKX6hxIqcSOnFVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4i36_gfh91hJ9zAAWO2zLiw4lGfaofagrH4OuZz5KWQ&oe=6B105CEB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDoZDCh9fMwQ7kNvwFJINMt&_nc_oc=AdqZLyUkORFpP2qWbkNLdodqN9v_H4Bc3gADpLYlwSwhdkEI2Butw7JBJDZG3ikBlJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLvPHMvcIPht92_wn760DNOSON29dO-DGXP8doKo2kVQ&oe=6B105F71"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhQ5F7CwXlgQ7kNvwF_N1QI&_nc_oc=AdrETk-eO68cFib5-jygBWx_IkyYJ658e0SWuST2Ji9OsKqlUncg7wtu3yrGAP2ew4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvJ13mvDEoK5rBgAJTWI9Oz1Zu8LNwW8gOmCwaJ2W9dQ&oe=6B104429"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dBQayruxREQ7kNvwGFnJ57&_nc_oc=AdoxZH-MgoOMg32d0c7rlZGAXhfaP6_pTKJkTomtC22_j5ZCJmQsWqdGDTA0F2dS-no&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXExhhxIivh-gYHwkM4my7lIWVdN6l5lt_6yu8iq21IMg&oe=6B1056AA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vkFK1jvx6kQ7kNvwG5ExIe&_nc_oc=AdqHm73xShUdpmnhqr1XhayWRq-8tYqKbZdkuyzYDMQ6TYCfEBiuICcMprsI-wwPOoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUp7grcWn5uwMwEBzmaCMk6PlWTl6aUTG3PXjmhFE-lyA&oe=6B10383A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
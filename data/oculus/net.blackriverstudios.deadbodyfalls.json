_3zIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxq693u6ohiC0SHV6DKf9A4gS6k0BloIZeEuxKEy7nYWg&oe=69CE76AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlObSeKSO-gQ7kNvwF_ektB&_nc_oc=Ado4MG4EvMoLax5FO84QC4REetqhMAqIqPbpGvXsRInENphiu6MIUZFex7ES0gUOfRI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCUwYVfPuPrK2MKzuQkPKLR2D50XWN3Dyfsf8RRpTimg&oe=69CE7931"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4K-1U5M880Q7kNvwFFSfJm&_nc_oc=AdpANqZwM-CX8JIBZf4YwiaiOLrVAH7qMZt0ehN8svzrnMdNGdV6vv1uEZHPubl-HQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2M7mbH_mNDfdLl24S6AO0ji5TtaueTBvy_CDcE4kd9Q&oe=69CE5DE9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ag_r1biHzUQ7kNvwGVngTs&_nc_oc=AdqiaF-lpRxTeK1CFKcPWedKe4BrMwzrXjWDYinicOFx3J4JBqm44V0oHWcy2pPCUhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzcx5_PKI064weiZzvemnUihLgmNB_a5GoRuUis878y4Q&oe=69CE706A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mv9jo1G4JMsQ7kNvwEVCKEG&_nc_oc=Adri52_znWqtEgfbiVssvO0jfRrXd-_ZZ4V8EZiG7jbLFMoerU29DtOVJkbP57r-O4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkIN_25X1OHv2d7eF9oxFa_z7iKbT7XzgKdEztPtIOQg&oe=69CE51FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
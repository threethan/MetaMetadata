nt-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-XWdvtXVoJbQGDFtLQSGGb1WyfGZ0ScUKzQRYK4dNgg&oe=69BD532B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsi-4IU4QckQ7kNvwGUKPJ9&_nc_oc=AdnSr1tqYX9Z949aQy1AX_29uX414HwdN-hrgWkXX34n5uLQt4MykqhifwUDRbkEEvs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytGAcX7oYXN3fmrUnaf9HMhOdlwPSjfHYiE62oqGdw3A&oe=69BD55B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLIXQhsYRksQ7kNvwFDurF3&_nc_oc=AdmZZTu-seID0yV4uDY5dnK_1NmZCUhn9-fDh6wTOXqDAzfdwwi46bpc2Oi6BIIwjNk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUhve0yTUfWeLEBwE07A2zNg92oFlU3S5GzUlxr1zDMA&oe=69BD3A69"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-3dHkbJ32wQ7kNvwGyhEDe&_nc_oc=Adnt_ub8m4PgyupiNoodWLBbFec8d1805ej1HFQ52kbz2aeqHzqqkEt81WrM0Z0j8yo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyO9YbLo2eYcZ0ufOK_dS1Rh3lK5ukDh6blSoubu14Uw&oe=69BD4CEA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqVQE6VhzKAQ7kNvwFnjgEh&_nc_oc=Adk8hV7iw0vBGLuB1DA7VR0M3NjXDRBBmQhZw31yIC9At5jMMogIB3HeyEsk0C2LchM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzdSzJ_yg5HgIoR9jpABhQycBF2wQovI9sAq2j-xFjM6Q&oe=69BD2E7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
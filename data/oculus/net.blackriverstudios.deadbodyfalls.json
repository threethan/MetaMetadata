20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md0WgJY4FZ4Q7kNvwHNzHxk&_nc_oc=AdoEDVJqrNBAIPWt5jRzEK51qamay_pGlDIr8yJJD0Q1vvECqlYjJNqi_qHgyWW5x5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXcNn9d_AsLBmwNaQ2QEb9yUizhpVJgnz7CMGMeIMsXQ&oe=6B0DB9EB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxaTIYR_FzsQ7kNvwHeNaQv&_nc_oc=AdrIQciMPt5Iin70d9Ix8QP22JiRh8n1AWbb2p-wlaII1p_mc_DeVq4jNwLRfhcYK2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTUp1YHBq6PiXmWuWaBJNFnvLQqhEiPF0dQ3uxPzvcwQ&oe=6B0DBC71"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhQ5F7CwXlgQ7kNvwGmP60M&_nc_oc=AdrdPSFyHrcVbfE4igcyEFk_SV6HY7ebe0Iu5GYVi2tf-nk_9ilJoY5Fobta7LOpjiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUI-YU2sPO6ur_2-Tq3yCLfBli9kpW1jI3al9JzXYynA&oe=6B0DA129"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-X3V-Hi0sQQ7kNvwG1uZNG&_nc_oc=AdrY8F7vNyaK9N8PWBJor7UEouMMGqdmJNj4FrBdWH9qY-y3Ioqnhv7nboR8iv19Nns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRD1AckYNw-jMmu8At83VcqRLp9Yzn792rM_HNLX7grVQ&oe=6B0DB3AA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vkFK1jvx6kQ7kNvwHxrV9A&_nc_oc=Ado_Nf40cBj86OFDnoFBKjY1nZTIb1kpPgQzF59wX1Glz_sr8IY-OUjcElO9O_BdZXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVibkIJvMgnHt6lWMugOXQdHHGG1VHI0cZwY8Nt-y6qQ&oe=6B0DCD7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
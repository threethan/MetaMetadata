pjGbU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHKR6SHtVS6J6nFBf9_4u76PSKnH_HV0x0X42R1tNBOA&oe=6AEC8C2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94sHL7qtoqkQ7kNvwH4Y6Pk&_nc_oc=Adq_BJhUz2c4Ev9Iw68PwknfSLc7Vx2EHp6f8FjE76g28C9k1jCy_g0ImqMkaT8E-IM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSccHvJ5lq7qtm8N7qmKVDnSPizhOSCWeBm4T7qGWu1NA&oe=6AEC8EB1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FqBp2lMkTgQ7kNvwEEbrm_&_nc_oc=AdpkFtmLCqpLKI24sDRSQYxz4PGxqLu4BwcJlRos_5gIJlA2zGWE1xZKQwJn3W1fqHo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaSZHrdC3fG-aLMWp3vJ15CRg8PqlLetWOeKBg7BzJ9A&oe=6AECABA9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=975s9NVlgjAQ7kNvwGxFwue&_nc_oc=AdrzvcAtxtthKaSNb7vIA5rtz4UXM59qKmEPBd_QaN_tAbpJkO-xvR8Pnt2oDvMgSNg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUKWUmQdX4f7oGCigWs1CpRQJ-lA4krcrxUPL-u83IcA&oe=6AEC85EA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtBdK58tPo4Q7kNvwHFN8xH&_nc_oc=AdotjAJytoK9HEgj7h899-E5OeUTxSookHzDBPXsTj2DPSOBFMKZwIeuoaz8_pqkdnc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi7RmLDm1BaXcJmtijyEv35neVytymsef7N9KLSUtBLA&oe=6AEC9FBA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
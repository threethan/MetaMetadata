xMQ80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hDrkyuBmBP7w-kJTBmY6Ol1LooJOBhjqfbLMFB3BwOQ&oe=6A0332AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF8aT00drT0Q7kNvwFm7h1t&_nc_oc=Adohz1B3vKoWi4Edu7rQNCR96YzFXuY_ebIxGAsFi0cVYC_WP2wCwPoYZDCqToMB18c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nAqEQpP7VcAWvSLyYku9aOViK3b-TdnoL7OmLTaxmjQ&oe=6A033531"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4wJhLrz8KUQ7kNvwEwU6ze&_nc_oc=AdosWUhPQpcR8x-_ImsIvpRhaEiBx4v7iuCWLfgNEFuTHpEhYOnKVGKBjHfuZGgb-TQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TEAIf4Lzc1s0qgNQqrU72JTL8dykMK45c3AG8Sabyfw&oe=6A0319E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Cuf5Wem_1YQ7kNvwFHMZnQ&_nc_oc=AdohdP0Dc_MBumCh67qUqSVYtb_zy2XsnUjvGFYfpO8o84TmdZEHTF5W_P7p8TuEHNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af633hxY0OXcGFjI_pdV7cfITO26-Qur6YpuNmw0pk9fSg&oe=6A032C6A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUotfS6_ZikQ7kNvwFiepPT&_nc_oc=AdqS9sup6rGasw64fQJaM381RFqkxLzeVTrikrUvxJIzlbkQK7YXXAIldzIUm8YBHjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yBgWRs2e9DvJ19m3tpl8XMuSFSE5_aelH6alNT0jbEg&oe=6A03463A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
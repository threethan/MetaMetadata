JjmQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK60vp90ccEmCUHy9IZjVqjWEnR7W4GhQPiXGT5Jt6vXQ&oe=6A9EC3AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mihkc4eDQ08Q7kNvwEQ8kXh&_nc_oc=AdrOLMDnNBblx4axGggdst_elUlNGv2mlOjcQbwbkBMofzbfB0uldfHit0eLRWQ0f0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAJoUEKpaF06Z1g2jX8gw7kPNBo5SQddXDgcVFINUGmQ&oe=6A9EC631"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gsAj0Ep4wgQ7kNvwFeVLl_&_nc_oc=AdqxTkg2G-Gf5z6g5vKu0pg6ET1Ne1uNybsB_3FUToUBQ8hYMYQqL9Yt-Z_BjkuWXrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBQ4DleEETD7J2fbe4H3uEo8BrArQ5tIb1-1y0GOs4NA&oe=6A9EE329"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avePr1Ag8joQ7kNvwEmM0Gi&_nc_oc=AdoWuDwsp0cZXS0zZzjSc-teIGU5-BNyCEKLOQO_3AHhDDSz6-h1s5vFsvYVQx6phd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKioNxkTbt51DFwq8r3RYGA7kzqp3OByHItcZpR0_9VwA&oe=6A9EBD6A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTs-Sgxtfv8Q7kNvwHZikO9&_nc_oc=AdqGq1G3YmgOiW7RotP8GJ9fpJ0W121luA4OvK8E7ZSY0_I3Z8X22gfjWDYXgBDRbSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKirxckaFkPHkuARo8eDFIRG8z4E0qKVs2IC-gFoql8A&oe=6A9ED73A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
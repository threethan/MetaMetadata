7Rhnc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_TQXE7S2gZ4EsjTU9e9miygiK76SF1RY9AV9m6tRsJw&oe=6AF9BB2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hguFsMOeh-AQ7kNvwEOH6uY&_nc_oc=AdooOeB1wSxm8r2fEVEc57DRPJUYq8Pnzv94klXKkZc_ovcv-PyyTxBsH1Y9ffbo-LY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRB25eaC2b8BCIi1v34XKqSnspmLzkCCo364SjBbrXcw&oe=6AF9BDB1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1cu35868OwQ7kNvwFHTS4g&_nc_oc=AdpB-K7y8ygz8o_mFmrW1uITHaozpF2QSccgM7MjfIsbq7rY6-xEYi-nu4-0hRFqQI4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb1qvSC8Ekkmn-3uF-pHByoDI23fiGtS_5pf59ApS9BA&oe=6AF9DAA9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz1-4DvV-qoQ7kNvwHDiTN7&_nc_oc=AdqWL_3Ogb4l_00zglK-UP4E90sezP0B9RX0lyrjZb-k_pe1tNYOl3TMoFcUlq5Eji8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbK6zzo8I5lx1IwAJCckvkULFcBls-8bQmpaGj1xA8eg&oe=6AF9ED2A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrAvXGSxWXkQ7kNvwFoInQj&_nc_oc=Ado9y1fqI-cbzlZQFsghr6SitlKDFP5PHrjthAUWJgW961ieU2Epgra60v5HLEUZKNM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThVMboIMgBuzSB7hJfLMLlVkdRSqTunj-46BuRNt5Kwg&oe=6AF9CEBA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
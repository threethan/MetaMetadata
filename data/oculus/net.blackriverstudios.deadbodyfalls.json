AbUh8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J_wtpG7h_uWrvxzRtasamGgqWBbMQsakawvT7OJmANQ&oe=6A1AEDAB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxb--6TEPP8Q7kNvwF5g86o&_nc_oc=AdogpfkIBYsMp6EMw82-8PWnLCgu4o87dBd5vSsyt2LyOrc_icnHf8DLi94A1e5UhOQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4doTFqOdR6DBSbxgkOcCSu5zoSMzmFkD4RWn7gh-hU7A&oe=6A1AF031"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gihuIiz2PcMQ7kNvwH5tiZX&_nc_oc=AdqzXvyamlQAWDXXoj9EC6LBm_hx3RRqE55nyoxgzIt_jA_sUUiueimHezY0R_-Au-4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hFb5A1Z_1qEEmKI8ckTInezMjVbqaWNcTeAUqDeP6ZQ&oe=6A1AD4E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfmPSU8VMC4Q7kNvwHRFflf&_nc_oc=Adp0Z8N7VR4EAjKynV9qqvACAsKH0z9r3rRdfRdj3ONnL6ARWORuudimvz7n9t8S15A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d743OswuiOBed-CP5jTGFTW2NU6TzINraUaxYMefs3Q&oe=6A1AE76A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gok3rek-7UcQ7kNvwHhIS61&_nc_oc=Adp38ynh4UnRtS7HaXIuO-IeHLgD0wM2RwT_t6tQyHM-P6t35dYYmPbstctCS3ytfq8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cusxCGJW2pZ2kaXt2Bcv5oXWRNN9O-eTEFLlMEdiLSA&oe=6A1B013A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
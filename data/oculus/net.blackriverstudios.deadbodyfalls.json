20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv3Q0xCLQpoQ7kNvwGoWXLY&_nc_oc=Adq1EMThzqwCNa116rAZc06fQUjwsQhMnj-UiQ9NxhYJ1u38WPALQLQvfe2r9aoUh7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuJrFLbusDLxoTK-c3cpgjN6RmXvXLESlA0pV3z1SJVA&oe=6AFDAFAB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmDxiZkRv3kQ7kNvwHu3V1w&_nc_oc=AdoV0OCR2iOttw_Om1Jh7-e-8N0MqlyTWK9aZrjgUydPzHOMQlYD9aAaxtfCz-6Zyb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNqL9hLh9yELSqf22KDK00oMK0wU-E1ZlVsdLEDUuw2g&oe=6AFDB231"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn_AdStmkzUQ7kNvwFCz0JM&_nc_oc=Adpib1l88PNk0vekc9vZpLhIJuJJpy6rT9h_D8wqM-vzyN-RNvncalJ4Jfw5lFiNWf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSejtNRFl03f3gJQv_arHkhOnLS3GRbECDOiYDnUdarLA&oe=6AFDCF29"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmOiq1PnFqMQ7kNvwEDp40V&_nc_oc=AdreG5WIrLJ_JMfkn7bA6TdUoO5KjpOY1FsFKr8Ld_L3PNX7UiBNsO2F_dWJk7mstmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq49S10YE4ua5QEDSEN-UZRFhibpMnDWDXuJDmM3Kt7Q&oe=6AFDE1AA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tM6328Ffo4Q7kNvwGSt2yV&_nc_oc=AdoBioCGDMCasDkA_M4sd2UWqkBFtLqT-0LQmKKVpaK-P50OsGQTtUvf-5B-rVJRN-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1ivj1F2oATJ3_-W86qiZKA1pUJuUUVmaSwx_PYdTeYg&oe=6AFDC33A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
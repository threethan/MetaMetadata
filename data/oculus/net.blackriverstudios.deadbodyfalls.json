CVMcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e_X-cwmAEdoyoJWy-Qc8V-GPzoVTzbfDTeYY85kjCog&oe=69DCF72B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO8S0lPcNXIQ7kNvwGjxQpN&_nc_oc=AdrYTb7au5A8er1H2OKUTIS6Ptw1haElf804spxJDuGPYPnwYbIkRndDYNVAa4r8cyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W4bLkcTMlhbe8OmZ53ErhleqA24bxLK6KGNkydCiXow&oe=69DCF9B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I852CrnhW10Q7kNvwFKBCsc&_nc_oc=AdoAdKCD9V1UTKFS0BQ7fBHwcb_4xE7SdmypwoZVLwJQl2f48v04q6mTcYGrH4geApg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WvRMATBi3UhQ5VRS1XE0-bcoS_LlOBUB7RqxYWNQ0oQ&oe=69DCDE69"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V116NY2UNJoQ7kNvwHLJPxT&_nc_oc=AdpwQgwkVwFa7q7Wx_09amOnOlnpPF8BV32xQLaf9AHTHfteS85Sp5pmZT2jRq6NmGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D_sEwBZtfFgK8PavkO6R19Ht38yiWw4HRYCiQS1-YxA&oe=69DCF0EA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSKby5cbfdEQ7kNvwEQ9rZq&_nc_oc=AdpF6FJHF_4SZmdYHIxenCOhh-Zopnm7aWhsUKEKI4vjZFazbX2TzNC3s-zfc-wl3KM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UOvZdcV6sgq0IdQV-Es3jrnBPg78Ye-ZHCjMdQuRp_A&oe=69DCD27A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
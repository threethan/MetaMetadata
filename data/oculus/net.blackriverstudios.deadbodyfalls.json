nt-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvQB-k_2fmhhLZPp2TtPkieOP7KA7lH9z9b2g1ns6wdA&oe=69B175AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4vxDMgKbnoQ7kNvwEwmqnE&_nc_oc=AdlojHoTcTAqw5m9_q0RiyDjsLfnRtjuR5jjA54UluXd4R9x4HLLIDB2iVIXeAg0JYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5obpXq63Xno5CxWQnkJSOJhlUs9Ez8tTB16wEpQZMoA&oe=69B17831"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEQkA7-P6WQQ7kNvwFYqCwo&_nc_oc=AdlxF6QEvguLAsY3pmgteAUxnDAcJScVVaZEzBMIIbd8q4fkb5H_wqlcsTTO-fItPB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv5UNNMSb4_ZaHaPVSHIhuFX7KltOfvsZ_TSpcfr-xWA&oe=69B15CE9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCjlu6zqppEQ7kNvwELjDmu&_nc_oc=AdkaOX1WMGzg8eM2TQu5ZxhSpyofss5pyLfsqxp2vUe8r0EsSmjE6TXnBYNrrIEtr_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyacKKPr1XJ3bQuYSsNIUIPdX94unr70g26dvWegasXjw&oe=69B16F6A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2E5THPbcrcQ7kNvwFlghkm&_nc_oc=AdkaJNojxHzqDcSDY6B5fSrKIUj11tR6hFlmaYYDr-Wp2pjrlDg1olXqATj7vlQvM6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyA_pxASi6IPkJ2DVnzFwh0ou4kmcQtTbUtSP4pWRPqyA&oe=69B150FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
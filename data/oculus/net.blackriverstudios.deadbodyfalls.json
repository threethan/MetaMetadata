qcdPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgCPbkkFcJxeiErbm0YauRW14QBiIH6RjBXiLo_2cIYg&oe=6AB921AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn528ytmCoQQ7kNvwF_hj1o&_nc_oc=AdojspWqRG3rh7uOCKaxcElcpftqb4E2-UDXDO9ZuZnLnVnZcxKqxRj8jcr7_wq1jYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKifCeWTO6REc7yA04be9rK4pHe--EPQspJ7JTJghH50A&oe=6AB92431"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iivBfQeAdSwQ7kNvwHD3ZUc&_nc_oc=AdocwxsPHmqyJFej0UekBhBZarAtTxhZxKdP5edZVSt501n8xXWPTKnUX1otz_yox38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrn6IAr1DKUiEaR8evJIxSWKg5ApywAM0nMTS99EmXUg&oe=6AB908E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eSrNbhjcZIQ7kNvwGcC3zW&_nc_oc=AdpkpMPOZ8StJcimPiB8cqv5PJz9trQkzP3PRzrKf6pa4kenmc4xYwMYsjTh7sYp6qM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXBAhHpr_l4HqjjFLHhq3acWahZ-7vNStMMJNONDLDTw&oe=6AB91B6A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmRRkn4V4-EQ7kNvwH-d8Hi&_nc_oc=Adpn7vTjzjqaYKGt_C8ARdw1N8bRaQDUBv8UqSGIA80-yFOH4AhUoxx-Hn4JjLbW42c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8hpTR4peL61ZHjcjnXyX-lm4v7OyFPfHp89qMRbvhvw&oe=6AB9353A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
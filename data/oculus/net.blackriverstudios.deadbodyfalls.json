nt-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHK7K6qC_-TSje0DTYWgPMMSJFg2l8MPxZ0BxNut6JgA&oe=69BC01AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsi-4IU4QckQ7kNvwEI1oYw&_nc_oc=AdnkCYGUwpmzCRHQQw3MeqkqQAFJhDPiDALE8Xc3UkThLwbM2uqFri96FMT5MMCJrFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz86Q7dKkXQyEfFwg6Fr6ilsILGveP2vS3EGNkoDhPk6w&oe=69BC0431"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLIXQhsYRksQ7kNvwHCFErh&_nc_oc=AdlP-9iSRdfhGM-0xOkKfoM7HwLwL3oAsCpiq3tQ6Zc1d4qEQBWGycGgODoeW4omVAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxygwk8kICB6oSzv63q5YvErk_PhiR3v1TWP5CKzcBhrg&oe=69BBE8E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-3dHkbJ32wQ7kNvwFAKx7E&_nc_oc=Adk5grf4O5b5nyHRItdFVT8qgGnAmAaLxTb_zZ3efW36zNxOC5DEx_PhywF0iFgQPG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwarL2eEmAk3hbcpRypD2Vmnx4uv-yeGNFQzpF8D0DWHA&oe=69BBFB6A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVpOjcpxijEQ7kNvwGKptau&_nc_oc=AdnjqeoEN2eiIqQFdInNjAH8H9LF7w4WS8kK0zOxYev5AqktX--yMOaYa_iWvw9yyjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuQl8c9d0A6kMQgBQOp9rLKSMT5Vf4mi57CmtD32fIzw&oe=69BBDCFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
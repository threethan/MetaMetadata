5tKEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ku4dhe2Gy9nJ94LrBCTc9Mpj4TS65h6z9RVqz7k-nrQ&oe=6A0DBEAB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II9bKaPoQu8Q7kNvwERevSi&_nc_oc=AdpofNaUW4ZVhWVe1rUxK0eUSSrCAc90XvWB8oFBpfwRAFRFq9o14dfzda2GYNlHp08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MYmO9coOOrqqrr5sH9aytvL6wvS6vWrN20Mgf0laaoA&oe=6A0DC131"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhozVtxcn_8Q7kNvwE2zejo&_nc_oc=AdqIckbfBYgUr5wvNaMBWk_to0zInB4V3KWBEMLUPvW2KtfKTKUA_HFJBE6O6dFyiF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75QFgSLUDuA975Tx2MB8tAmK8CXvaHVOaD-CmpWk9K5A&oe=6A0DA5E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG9f0-juoU0Q7kNvwGV0XHL&_nc_oc=Adov81sAy--TPDLMUYSaCHAp3jRFgif5nQSN0OtqVMqNYLVcCmy96pRZmN1vA7h2P9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wKQDHU9KZzU-YzevEuBL5U4dBTXKHVhQzcW7MF51U2Q&oe=6A0DB86A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU1TrSzD0qUQ7kNvwEbJ9s0&_nc_oc=Adq21r-ulZ96stTrwNOE2-ja8POowdNjvOaKe06PFxtBLdRIxS88lhXEzzFSTM_Jk2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vZYqGpuc9IUqypSkRU6uvfx4vCoFqj0qQca4SftAk8g&oe=6A0DD23A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
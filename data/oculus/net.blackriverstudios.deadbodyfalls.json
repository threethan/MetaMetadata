20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BobvMDU6GcQ7kNvwH9kltP&_nc_oc=Adr7HBZ2P1vm0B1AgwvQq2iQ17bvDEs2XQkfPWFoMuQ3EC4z_PhgPxB_KcUbYDrFaTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0XEvbtRSvg2dBBb8GGACH0h1TuLA2LdIHfmgUlGSGyw&oe=6B0052AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36-IiOOINfsQ7kNvwF3ejij&_nc_oc=AdpjRb3LFFOWFpKp4up-F84pXJp9Fc8pCmbEeYFzgCRm3u76iraviLkZWwj8Mjxb85I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS21u7WeMtCwW6cP37RBYBqPzkGfAohfnFzrF19qvEB8Q&oe=6B005531"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn_AdStmkzUQ7kNvwG8RMQ8&_nc_oc=Adq0ngP8HtMtG2ab2wdNGqQpRhfohGnT7pbYlMEeR60NFy_vgOIXidsdwBuF-d6hQD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1cboXLbYk2Mr3qCWyruAsRLrkuq5CsBNm4t-Cf9eQfQ&oe=6B007229"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSf-2SqMnIAQ7kNvwH0kGCP&_nc_oc=AdrpKG72y8LmL61tpaWPclq9I3BA9pU35CgY8xQ1pNie3nWlYbf8XvZvYY7G8h3lgh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2xyqW7bTiXAyG5OgZ-ehaWz4Ry6w8j1H5zLHWKMVSzQ&oe=6B0084AA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tM6328Ffo4Q7kNvwFFKtyt&_nc_oc=AdpuSE9DHqK8w3CzLHZ-HaiQtto9FyCrrpUtaO2w5yd1a2mNDdKAj5862VLMLVJZRCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfXuXID5qZgfF4_Wz20QIra_LjL9DJCxMhLdf1UJ1tYQ&oe=6B00663A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
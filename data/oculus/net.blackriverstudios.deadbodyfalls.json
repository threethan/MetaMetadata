oLvJo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER-Qk6tINhR5b8JX6fqmvFp1jTKXL7ScuVA57UBYweqg&oe=6A81C2AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7AwCXBY31IQ7kNvwH3nlk2&_nc_oc=AdoBFugCNzXn12sejNtxr_OG_5ieFY4qgeCs-4huBEgdKbnaJhDuN-8p-Pl-GHB3kDg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgz0C9atoagd4STU-Imn_soUPi2OB6yB6qpeOabKidXQ&oe=6A81C531"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd5lFYMk7KMQ7kNvwEQRM17&_nc_oc=Ado_VuI0PVnDWbdB6ktPAmHHsDKn6um_fzRamy32cJh_N7JTx9_uazvYEcnigO1CVoE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK7BS4wQiVxMiUoCV393-ZE6TUPnWHdZ-p9fTBBUB2fQ&oe=6A81A9E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R051kfi9l98Q7kNvwHgCZLV&_nc_oc=AdpauL_Lzt9DvzeDl88g5hRmz9_LnnPrSnyEd04m8XitWCvGQ3FJmmN_JGw-SlihGtk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmne4H8q1SPnXCSSBCo0oeauIruTW8G7LsmnH4cWul2w&oe=6A81BC6A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc4MKLcnFOAQ7kNvwECRxUy&_nc_oc=AdrO6Moz1EHuB7L2Bx3-QfFd9QZO7n5ccutyaO1MFoqSPtQAiYTqbDXPKZJ9uu5G2kU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE7RL-fBhdTinYnKlBYuprqA5CHLYVfu26ZO0VJXJQRQ&oe=6A819DFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
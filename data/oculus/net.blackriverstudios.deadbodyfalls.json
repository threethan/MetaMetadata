20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv3Q0xCLQpoQ7kNvwGxetbP&_nc_oc=Adpg934TZ_p1waq0-9yCLlwaByx32Xi8b6GJBW9fP-q0uj89K9iWdMwRN-2uIt1QeNs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzBmOpe2DZqqaYacWe2NI3Umyh9rKBIr1YtQnqtuZGCQ&oe=6AFC5E2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmDxiZkRv3kQ7kNvwFw262B&_nc_oc=AdqFGrjcHMYIIqNhYqhAgESx3krFzF7Je20NaIS9HcizZR_iY5goMngT_nzbLWN1H1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMIN8IYIEWQlrHLE6DNVco4pJTUCLcs1nyjOZzd6oWYQ&oe=6AFC60B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_PPUcMw5wkQ7kNvwFAdFOE&_nc_oc=AdpCHaykMr6W3UQMS4NxyJuE4sXLl_AM-G1dQJrcj0M9rgK2AB2dFz9cwfNvNuwdrAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGnEIFNdtJ1dCS_01ECRVkc9JFlL7kZXfg2K9h4WRQwg&oe=6AFC7DA9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmOiq1PnFqMQ7kNvwFfqpnW&_nc_oc=Adrh-3nGNBDeAsF0loblKtTJuYq5qDrC9y7DHdQp1A6s5mY6dq5qJfHDjLDOw5-dbKY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Q2wZ6sJPrz-D-DKyzcBw3n12ISfskuNGYJxA8xqNOQ&oe=6AFC902A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrAvXGSxWXkQ7kNvwH6LyiB&_nc_oc=AdprShLQPGN3oIn5zKW1d3-gGhCmU_1ocsl1IFlIc728p55fQt_saGhk1ayRI2p2pHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmFZQZA6pmT_NUBE901q_wqAzVKD7HEipFXcV1Yq_1dA&oe=6AFC71BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
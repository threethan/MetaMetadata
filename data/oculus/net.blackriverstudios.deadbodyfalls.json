DNi90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1Eu30EKOsr6TJInpw_i-mpE3FK_w6We5STqWiB-YG0w&oe=6A3BE32B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilf7DCyELv0Q7kNvwGLCJOz&_nc_oc=AdoCdsqNSMqgg8ejQak5sfB2t8Tw2JIX3UAe1beWoSIC1AIoqWo8PejLTEIkgOBoyAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qU749CRZ1zH9z6TJwDN9x6yjNPVbSdY80UNUoGOlCeQ&oe=6A3BE5B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtHNrdtnlOgQ7kNvwExs3gH&_nc_oc=Adpma2i7pzmDihsr7Ac9HTHbGBCHQJzoZu0SnbreqOM9dmKytuNkjBUeDaNbRpWglrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UQD-i1eNUWDKafF-nLtxJ2BVx6EC45VgJUuHeavXJwg&oe=6A3BCA69"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AABFuMCYe5wQ7kNvwGE-296&_nc_oc=Adoi6WFeMfWf893hLRnSWO7rTbzVRhmewMkR0g5vH3w9PhZY9UDDba_lqfFdRJLJAf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GaHrQB6qedbXYJn-quqd58kz29HNLJ4_mj0ysI81sMg&oe=6A3BDCEA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_Lsg48NvaUQ7kNvwGREBBy&_nc_oc=AdooKzdZ5n3IgZPLKCyVfhAY-vF-YdJVdepq8EO0OI8hCienffR0qGJWenRhLf8aTik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99uRT-5LFgEkbOSJMNIPOKFXbx_xOd2ZyqHwD2oFQtDw&oe=6A3BF6BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
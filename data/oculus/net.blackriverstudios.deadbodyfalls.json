GXi2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYJXyOVSnWrHsxc3Oy1EPwvzvXju6SCs0NUUWu_T0K0g&oe=6A7736AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdG3qYufmWQQ7kNvwF3xTTH&_nc_oc=Adrjk9KzfjXDOap1cvU79okPXw7_pr2pd76MRGKNvu536LhJ5w6TXyCHbKg7OTWK1bE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDeLyjwM1BlM18dIpdmW1CBqcQYKHVPQcGB9Ohrm3BTw&oe=6A773931"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7adAaJmFhYQ7kNvwHJKttZ&_nc_oc=AdrOEtS45c080-HaJyoXpEyVunMRWJM_1CSVOYDKgeVgrr9IBDrhg02P99zAVD5i7p4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzwqOpy7DvT7jVbfPQNmPHBJlKeD76RqQc8SQtZZYM7Q&oe=6A771DE9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6B7XwsbtwQQ7kNvwERKkYQ&_nc_oc=AdrkIF1jmKsRkC2Vb6rAlhG4NRxyPId5Bk6jnDzRIyrhsSlLYUhkWj5WST20cPGE-oY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2zgTJINz1haD6amwzim1fuz0UREKRVMGYFFGJ0uQMDA&oe=6A77306A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1gGHb6xly8Q7kNvwEsl8qB&_nc_oc=Adpsr_CbkOhMVYZXlZXzkwDveTDWKb70stAE4ftEiwARlhFbgW0khgTZI5JhU1N5i2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXW8LVphinz7uShFIEomaDRo44DmHcSHZzYI6T4LxUMw&oe=6A7711FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md0WgJY4FZ4Q7kNvwH-DH7l&_nc_oc=Adp_keN_YVvIhyWVVuYWqBVMwJhBQ3HUCctUzWxCfOU0G7uLd9bPPGZN5vTzvusWnHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfdkPNqho-RFbXTl2RIrIUvu4nOtZEAVs6unSVZRz0eg&oe=6B0F0B6B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxaTIYR_FzsQ7kNvwExafw3&_nc_oc=AdrxFAH3y1siraYUBi0RcjKMfbicGly9yzGQwRIUz6Omhf4KdNqek6Yb_vT8lM2qvKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhE57RWtO8PpMLq4Ey01ZB_PmRSgI9AtqXrp4n6U6PiQ&oe=6B0F0DF1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhQ5F7CwXlgQ7kNvwH2m1Ki&_nc_oc=Adq0Bu70RoN7pxIJIAagVnbzHUOnmNsXbpXFH6rlJoPpH9asmvX3cs9Mha8u-InQcrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVccfa2FrlxwAIU7gcCuq9ixO7dK4z6wJC9TZvZEdNPYQ&oe=6B0EF2A9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dBQayruxREQ7kNvwGcmPf1&_nc_oc=Adr4sroPdCfhODd2AJP72OJIf2FAwKbmoZNRkYfCCHRVQuSN81PtaawVYpjC8Lg21vc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4MbNGyjZ9OFcfBw6mlJthbQfMD2BFkvg2qVeww28HmQ&oe=6B0F052A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vkFK1jvx6kQ7kNvwHKcBdC&_nc_oc=Adpa0TtyqH9DrqCw1NWh6Zk20oXkVdbLO92oaOCWe7lkUBr_7ubAAfu0k_5FgySG-Uo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVShKOrYEzc_Vw5vjm99ZRLx1wcaWQqKCvJb94wIhs3Cg&oe=6B0F1EFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
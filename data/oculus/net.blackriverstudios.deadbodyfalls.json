_Kwv0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUVImGyjEhNQ5hj2sIGekzK49lkqzabfRY5_A0Kt4amg&oe=6AC7A22B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6SjiNfP1uoQ7kNvwFOHW54&_nc_oc=AdrzRWCPQ4sj-wMWsvkGt-IWlStotj-IDOPE-x1A1_UM16AIvPmEtGPNcOUx3L_pJA0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3123mRsopbJ8gaKUzWNZpe8sfV1DyuIKSv59zfbLehA&oe=6AC7A4B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpJszd7prZUQ7kNvwGR9NAX&_nc_oc=AdpPgjfzZBzGJfmJF2u1P6AgB3nC4HUk7xMbq9RNcsLO0ky9U5gZQmBnnk5K1PbAfAI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTmT7i5LMRbnZtgZUnTYdtBcu-dwzRypX9QhcAJPrFqw&oe=6AC7C1A9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3xjl_X834EQ7kNvwEubODh&_nc_oc=Adpr53dLBwQuOw2bVSRLFOgTl21KcQ3A_DWH4XrvUewm0THySc9tUq4rhIB_4dNBK4M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRaV5FWJIwY58mPTI5sb0VGCJsJoaH-8_koGcW2Le7bA&oe=6AC79BEA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjj3aTUr3P4Q7kNvwGqXnvI&_nc_oc=AdqSixwh1S0S47Vo_lAFHDTqqiVMPGyBtAu2fVoqd-jW23dgoFWYx_f4nfJfxD3i3qs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO24KHx2LOvx_nJWeSug7Q8LzEpeRf2LPG0eu_Whu4roQ&oe=6AC7B5BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
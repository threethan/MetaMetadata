20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRNXIXNiXz4Q7kNvwF9YM0u&_nc_oc=AdpH10Kb-O7CIf8Liykdqvt7NKF0bVDodUyzK-9x3P83QhunM4EKehJ55I5F6VIiu-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTF0Z1np4H9zc1oK3AtduGtBFwNOKgVGAKFqS5i1VnwJA&oe=6B0B16EB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoHnvhmG6ekQ7kNvwFPiXt4&_nc_oc=Adpixdd817aGVUWNuRl_2oqW9gmDKMdnFWJfgOcaXxVhM9Y-6lEBvR2A04Mc3uZJSjc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-5ITCgGCLtOdZ5AkqKt4Gm9jbKKEv8goTx4vpnG3F8g&oe=6B0B1971"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW_utm5UybEQ7kNvwFM_IYb&_nc_oc=AdqMC0eTiAghhWHJQfrSqdAQPpyROPi12N15dlbfhYCNF2fU2iPzc0AGhVL7xIMZ8ME&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTnOELA61ne3ZkpcZCeK7IjmC1dyVoj7Pj86ECm-atJwQ&oe=6B0B3669"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-X3V-Hi0sQQ7kNvwETKZ4g&_nc_oc=Adqhta1UnMrRVJVnApArXz5R9Q7V_1jY1qujSRxn5xdmW9n31T-nrD4J0TSxsKa0IKc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTP2osXU9DyNmX-kSmyNrMYFHkVKqSVB13AZfvqLWeDeQ&oe=6B0B10AA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMq-JlQ0X7YQ7kNvwH-RbDl&_nc_oc=AdovelGMk5JiIytO4872Rbvi482uJyeIuq2LwEX0ZtFb2DPxIokOCo3bsRaOzz9Yt0o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZZavswb-xsjVUT4vufXvRs38A2CRMPd0YGu2JpgbRbQ&oe=6B0B2A7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
nt-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxY9imSBxxIo91ZpJw8MIqV4Nl5jM3S9NNYT-aQ1md-1A&oe=69B0242B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4vxDMgKbnoQ7kNvwHzSVAK&_nc_oc=AdmSsOmUoTUPcwHx9RuvkHpvpO7QNSUsrbbA6qsoCtgqOMa_zDr2h3x_xMco-jLg3mM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOtShgarShz12yEqMSQCnC_rkMgz0ZdQExz-Oq5uEj_g&oe=69B026B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEQkA7-P6WQQ7kNvwH-M195&_nc_oc=Adk-3eobdi5m-aOMW_AQQhnuyUC-Qmla7PpklfqOg5YQFUmzDZ3gL1OjNAijrjC4PW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpPt3qCwWKONJ0ORjnlqHX9BSw5z8IL7bP0_ihQn-DzQ&oe=69B00B69"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCjlu6zqppEQ7kNvwFUvCGn&_nc_oc=AdlgHkjGbQH6Z-O9Ge75U7RfsUSKOWPAB87bziVxTaHezcenNxHsw0TESy-PU86ULq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy31pJCgbFWnBbKELRdlmMfs6y9lKIxfwmmLiN1VxmROw&oe=69B01DEA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gww3bTEFhLsQ7kNvwHvZtYw&_nc_oc=AdkZ1ecZAjpFH-pGOSEJM2ljnLV3-BQv1EKMkcOiqnAJQ6ZjQLgQDkZh_Behlg2z1yU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_JfAQta0LznGwafXhkrxaf37sXfo0nq8BK4tgsihm-w&oe=69AFFF7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
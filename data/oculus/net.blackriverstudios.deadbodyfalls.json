nt-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUCDu2Q0YP3CX-BJnbY6h_EvBlW5i5lMONK0ncdVE94Q&oe=69B80D2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=068tyS7cTPcQ7kNvwEtAAXU&_nc_oc=AdlNH6VS2QPI6azHPc4oyN1rkbLcHOegKWh94dpO9vxpgMFYc6fpfthL4C5VNxArwjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afza78SVLhSAcu7HuMs385m3DVU5PdSa2juzwysO7VtiEA&oe=69B80FB1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opxUvOiFdQwQ7kNvwGmob8z&_nc_oc=AdnR7DhEaWz_povtCD5MF_U6fB_fGHUVA30v-0n_6r4lvL3NskEUwHPpMtZGUcDEOTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPbe3PCRtcfM4-TBRuk5kt7ScUN-aS07slSmygN6a42A&oe=69B7F469"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drx6J2dTS-MQ7kNvwHj88DY&_nc_oc=Adno5qkNxm3bfbJ7Rw7Madmwo2Pxij0etPMTDEIf2TZnAHmn71xc2YmK4C-J2ni5ocE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzbXCVc8AjPFcXQQisqgAop6GTh7uAlCCAnVe34DgAw3g&oe=69B806EA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWTMNRtTNM0Q7kNvwEB1QrM&_nc_oc=Adn12NQOmv9Hv_4HCXsquknS-S0dRBgY3YxOjmiZxXnE1gdiGeDh2FLNIPYYjEmOeoU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyP1OfrWtoKsGi6B1TAiWquHbOBlxBcKFcNvfm2Mq74Ig&oe=69B7E87A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
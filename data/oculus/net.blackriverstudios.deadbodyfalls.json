BFqJw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8igMXUcP8uiZEgReJ-yE0IehShuxWubw-CqBz1HgyXlA&oe=6A296E2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXSZiKHfuaUQ7kNvwHoAS6H&_nc_oc=AdrarJUMqK-k16n3MjJ-ahCLmT4D_KtjAMKq_QVKfJCoRPDE5SoqbRh3tLQJWWSRDjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qxk1FEod3qJ_9PIBLDnqUrSnJKiWDIYUg7io6RtheGQ&oe=6A2970B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAln4RuipK8Q7kNvwGaOHtO&_nc_oc=AdrMZpOnyBvZrzmazcrlNbo4Uf8s5cgXpvd3t5EXxSloKDdZd_vsJv7az7bJnvkntQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CWiHTx_0FXj--z9SMvYUv2ar3Dr9IctUdQUoeEGG6xw&oe=6A295569"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr11zIi6sT4Q7kNvwG1pQdB&_nc_oc=Ado2cIOra98kPB1TeZyIo9cygQw7NCaKnhCzrzewDUUrc_MtDEfkfigoo2HVdmeTZ0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94I8gFR6SVw1BHvx4uY1XF-SCV-tUoTm2oaXPvyqh7YA&oe=6A2967EA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEvkZCc9ZBMQ7kNvwEkmib_&_nc_oc=AdpyuPIqxrHNz-zTeIUYtunRPHAydfX7W-IJYgd5znMWoGm-ebmeFiJM-tcUIEXZ9Vs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TCvYAzpMG1WPTuPe28EClWH5Hm1rVOMRACaNoIeTPSA&oe=6A2981BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
-npUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvQ2cXUWpvotWsIwvAKfAIwcLfkkMf60HwQwSY1PVK1A&oe=6A75E52B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdG3qYufmWQQ7kNvwGZYEIZ&_nc_oc=AdpN8Bdqx8YvK0JiDP_UERU4P8xU9p-rn5lWvY5HozZMZs8MlhJ96gmgiUnAceo7Jds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA9IOrIW-wxTo8xspEmLruTe87FiRvmCUwkPzAxKqjqw&oe=6A75E7B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7adAaJmFhYQ7kNvwFwJY45&_nc_oc=Adq0oLd0r5Yp7-ixmUFwjDnFCxNpPPkYtz6c1dwHZmTxfglXoQmfT4uOFCAJ2PDcZ88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJS0ZDgf4MJ2Gh8a6AIsHVgG_qdkG47n2gip3yJAKcAA&oe=6A75CC69"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6B7XwsbtwQQ7kNvwHZCalc&_nc_oc=AdqyHhOjWpq-UUlNmmZLqWXEUD6kjzku68aZAKAQL-phkyQlZBRrnIwXzXJIQlp_WDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwgWpKOtxOYT6mp2ou-yqe1fn10ZPKZuUEW0uyEISS_A&oe=6A75DEEA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGgghiIP858Q7kNvwEYqfIG&_nc_oc=AdpD6eyT1xAqk9DPDGaI2OoBrGVOPDEXHbCndztvtn_P7jM-A0GA8nGX4DQKstAKncA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhxbPBum11cXO5xshLNbt5OOk_nQcQT6Rtu475cvkauA&oe=6A75F8BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
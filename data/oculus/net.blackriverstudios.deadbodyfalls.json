Uh2JE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BLtbUl5Ue2rqoa7ajQAeptFH18DoROl5FDXhf21Dlqw&oe=6A199C2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnJIJNTk4okQ7kNvwE8X_Ux&_nc_oc=AdplY6fh7vktz4_S6PndIVvBVnYZGjnRUGdU5n4vptnGozNJWhH0J231Tet1vuoMBuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o7RMNaR6Q6KUHPqOiLnjrgIlBmfU5oYHHmxiu4yV-fA&oe=6A199EB1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gihuIiz2PcMQ7kNvwH4QEv2&_nc_oc=AdqY-ySPybajmeAknn8ruJYnDnwOI9amjz-rwCIOmdDlDbbocDkSRwylYocyc17CfxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f90s7hz8S06CHQTV1ygQtyGNrkAJ5Ak6w-MnWBmInSA&oe=6A19BBA9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfmPSU8VMC4Q7kNvwHK8Jow&_nc_oc=AdqmvcagwVQe1DGPDQT5KoAr6OLcIs96O6V0NOexOkzdelHnoCfrpyFMkRkFKcMgLNU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70oRN5XPCHqsdUL-D7Jpj_yt__gxpwW59XAO3vdffjMw&oe=6A1995EA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gok3rek-7UcQ7kNvwEM1eAj&_nc_oc=AdpMlMQ3isYgHi4xNm4jnFMi7dxK-EoMmWOrNEML7xp7A7cyCap7qdl_zbkaB_iaMwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51NkZAn_PiZjQ4F_5gQkJBao00uT26ug3P8xGmJ5URqA&oe=6A19AFBA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
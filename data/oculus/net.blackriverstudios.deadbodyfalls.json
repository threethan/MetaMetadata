nt-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkGUw40yjRFUH2lISGEJo-_XyfesE8N4trL30qOfHONQ&oe=69BEA4AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsi-4IU4QckQ7kNvwHFXl81&_nc_oc=Adl7_4IY1lPg6txzmdtnY-TkINMCa7vVDYhmMzxAVAri3_vxHtnwBpjPm8poXIJAU9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkxfK-qot0YnGCfltEQfr7WMCv6_aUk6CQb1D04w4DSg&oe=69BEA731"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktub_0GGOP4Q7kNvwEs_SL5&_nc_oc=AdnioiJ6bHumMFu6M7sPNJBK74oQoyBvl0kLqYht73JD4BT5UnLr_KtIPSJfrK-mx0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0FzhPthBqtK53xviw8tzhZ5BZF7_o5vmsYnn3r5CF4g&oe=69BE8BE9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6p4UdFqC4oQ7kNvwGjtXG_&_nc_oc=AdkL39JCEd6Q02RUsugyJp3OB5V5Y-xBxta_nRtkdxvryUaewEVqyyi2QQFgUzJaZ5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbaDDIiL82pbAcMP1co2mVAxBHWyB20YwqwNlWCPg6vA&oe=69BE9E6A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqVQE6VhzKAQ7kNvwERnfT_&_nc_oc=AdkMtTofKbeF20Su-Q1Wh9Lm2ItwzRP0cYdnxbD--imx5LOLgOWi_gMVEwon9_gkk-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXtsbMaHUgxAqzZIA953dZ95WYVo50iCV_O6Dj83_Qaw&oe=69BE7FFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
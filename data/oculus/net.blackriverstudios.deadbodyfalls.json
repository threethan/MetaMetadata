68o2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R3JMH5iLwmkHSOBzeXm1zi88qgJFd38tQRv0eyxzsgg&oe=6A0B1BAB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II9bKaPoQu8Q7kNvwFgpkCp&_nc_oc=AdqBO80MitVllcyBlg0C9Gg6OtPmxUtbIJPsC0RFpq5IQe6V8TCQAT4zerTwVrzKSAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58BtYyphtAUyc8sX6wz9tD3OREHqZ04d3SwOvkh4CXgA&oe=6A0B1E31"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDs9LAIjqVcQ7kNvwGnNLOd&_nc_oc=AdpVfw6Qb4o1gLk4AsBo29O61UYM7Tcup-hJL70hI6_s_vKeIq6hZ2TE0lw69hWreLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Whl0ZUWYxZN2saWOWPpz6ppp2KABtYAkNBlKAnriLA&oe=6A0B02E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD6PyjQCzAAQ7kNvwFFPV5S&_nc_oc=Ado5eQRYnOEeDCVcEUoFkLAGVUM55VH6bSTb_33IcU4KQpw-RQzIc1HKja1fKl41mrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c3QAm2UqA_vDZ4nie_xFmifNgiSRUvNIORrMnhUGmnA&oe=6A0B156A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adtVr5H64WUQ7kNvwGeCaWr&_nc_oc=AdrdJxELGvpOp-li-eHlYtVQ82aLdYp0-SIBm6dXBQYXQNgnzqIwFwGDI_C_rvHFgoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tmNTTrxls16HbFFeIsBYZvJLlWxWetNXcnYR9sYl09A&oe=6A0B2F3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
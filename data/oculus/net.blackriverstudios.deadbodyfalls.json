20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2I6xPr-BNAQ7kNvwFNyJ9D&_nc_oc=AdqqIPDU3Ulk1EbYZ7wiHy1oL6o28vLXBFGkLUO4BKpsTZNqkzConllGkbZc1NpvWSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuJIBpTl0QoZ723wmzTKu14i5A9JxwebnV52ozOpNyow&oe=6B05D0EB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JNL4SBjg1YQ7kNvwEaKTf-&_nc_oc=AdrnnVdnFod3tDwQ09VBNFzH3caG6IuyY6sRLpfyJYdx-EpnE5TRPD8umEUS039a7bU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpHdkPRmZ-V2zZX8U_sYogWOPSEX1TdrAF8AuVcRNSeA&oe=6B05D371"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNcL_-Zf4FMQ7kNvwF7ufnd&_nc_oc=AdpQV8rmFk9fd8-oeE4ttMYDnQXh2lfb9T81XJyK-eSv_0dxS6jPdfx0LRToW8jwXtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ6dl5zHomJ9Wgkv4CTLeRQ8P_mmXL5QXbVx8jwjcjLQ&oe=6B05B829"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8akCtd-d9pwQ7kNvwGBtDKt&_nc_oc=Adp9wbDlF-Y_a8_o2hKqI2z5LwlLmYRqraEDIGlMhu12GOD3zGAK5QV78ZSn6iURUnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQnJa1BYikbKSeUhE6aNDKhOJMGUzlP7m9hETMpE9Xdg&oe=6B05CAAA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjYx0xLEr7YQ7kNvwFJUy5d&_nc_oc=Ador-ThyyMqKMjdKYvy67_ZlVIE8Y47fjBn4LPhB0E-EzLXeeHvjIV-X45XI4NHdqis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-UScYYTdxPDBMuOkp1h1q51w3qIyPpImaN11tTm03hA&oe=6B05AC3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
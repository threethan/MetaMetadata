20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md0WgJY4FZ4Q7kNvwGUuxyj&_nc_oc=AdpEFK6j_58DV5XF6Ip28YUiUpOjpKYTJse3F7zhON3LgDAUOySyIwMP5_PGQ8wrzio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiQWU8aljuWjMf6_uknX7o8gj-LCAMuYOgTkps5lfT-g&oe=6B0C686B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxaTIYR_FzsQ7kNvwGWMQs8&_nc_oc=AdoibmMEo4FLOMRE3VoMFln6xxN5S01nUOpL4uuDvwELjf9i17KfeHDXMK4tO2Ky-Ng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLzzr03gqZ_fthm5iA5y5vl6K6CRlql3WPkoHjRxqqfQ&oe=6B0C6AF1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW_utm5UybEQ7kNvwEt50my&_nc_oc=AdqsgcDWGBzqizCyDXkZO5XS0x3pEkkmtROPFS1BWQrJxOd_hcLJ5afxxy3TlQtRo9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTza4rQ_d74W-Ro6DA4Mx1vZveboVdORM4d8z7UYQ3d-g&oe=6B0C4FA9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-X3V-Hi0sQQ7kNvwGP-pWt&_nc_oc=AdrmKAVQBcXaT0lhJdIU54j-gvuI7wP9j6QQGfSxNe4l5_CpXAYiDgYxtK800U4txl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5VHGPSrXLn4_J6z5SJxla4DafNd6lCheGuw4biAwkGw&oe=6B0C622A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMq-JlQ0X7YQ7kNvwHV_mu4&_nc_oc=AdrwskmeSpdkpn5KNfEaZJMPLmInI39pRpFN-5IwYCiRgAv4aUS104X5NL0VMn2tdqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7Tofc_MoDc6ByUIpuFOuAOKIfLoLELgNxrhTaBIoadQ&oe=6B0C7BFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
nt-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsfW5FhSwhU9gTdTJJPSa472gLIyL5XMfhYVUD09eUwlQ&oe=69A83B2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bejc0W4Y_SoQ7kNvwFYQqzN&_nc_oc=Adm5pMTl9jKL93B5psCIWWRO8cC1dfGm2X66RhTfZ6y_KJbesnjaIpNkKvodha9TQkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDLbnTX1dGsInfGqqdkOHNebKM_SPVP-TwSLnVRCEaBA&oe=69A83DB1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM-2ZvpgoDMQ7kNvwGMZc2W&_nc_oc=AdmwtQB9-D-V4s17pdtHt77PcvNoUCq5qqdNOBl0pSJ7PsaZW8neR1hn74Sb5nsfXPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsRBDUWafjaYx5RWRij-d2H4wIpIGlHYntnZZkH5Pnj8g&oe=69A82269"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFuJb2fVf-sQ7kNvwFQ9VWQ&_nc_oc=AdmoPAYKNR5wkDeWGwwQ0_nW3jaO3sWl8lvbZ8Girhg3A7xVVp0m5FVTIrSWcreC1Fw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftOSQjpZ_Eqm5n66svSPBcwNXQPGJyoIUOZAWwqROnqig&oe=69A834EA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hV5f7a3HP7AQ7kNvwFHar0h&_nc_oc=AdmfIl0NAFF6Sqy8ZDD0nYDBNq8DzRJHTCZENrUfm6vFm_V1Jour89Suo-d_uAbHwvU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYfpDFLe2CBdhcIhVtGGNfeKdeimjTppz46VvPsZLabA&oe=69A8167A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
95ItY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqetNdcSXKTP_bIkp67V5rOnRjthNy_570AsUuBg4Dbw&oe=6AA7FE2B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFhI_s-r0hcQ7kNvwEQM6uu&_nc_oc=AdrngJt07iJNFfNSJ_aJrIDgLcdNqNI-5XSWGgaL11dXK3XUtD5fdtiNgrWcA9R4q78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw-OIPmj-AQM95KEJvnSlbsXzTZT1GpJwjEyqq74V8AA&oe=6AA800B1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M0RUuhiCIwQ7kNvwHs4Euf&_nc_oc=AdrX3VUl7T-i4b8pcdGxGhFK4OQx1Ypsh7zzn7BXgRuHiDAaWn7LfoXzTos90UP_AAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKueMcDW3JaPT5qLbjAP050rB5KqqFTgELtPXADNawlEA&oe=6AA7E569"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBDPVVfSv_4Q7kNvwGazt4U&_nc_oc=Adp5ni1LUdpiz5y8SeVFU8wXjUIm6EVR-E4NpQa3Y3fRpXqQDFtLGDEluffPe6c8vBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVQqI9ucBNH2gNJPAWMS2E9slJrSwKD_8fYwyZUoA7ig&oe=6AA7F7EA"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV6_vYNtVIUQ7kNvwFKEGGY&_nc_oc=AdoZOeoRvBqc5BQcJsFXDObFxqMXFORLYsdvEGkXFFb4aRmpM-L0Lp7tzdxd4bfr8iY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2nsJWCfsusojHk5aZdtoamyMg-QVgKFU7Ghu6RauImA&oe=6AA811BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
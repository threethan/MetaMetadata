NZ8Uc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkdvJD5d_EoCHyyAX4R0z49BK8KXgb4cm0C3WBCAC0Aw&oe=6ABE67AB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eMpN4BTWyUQ7kNvwEGfpxC&_nc_oc=AdpNh322oUD50cO_LiRH83wAZEcIy13u7cO7ClVHCTciWpSlG3-vDS737tAF5NyLZpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJne2NoQ1rkCHVqDmfOykRGqXrg7ytYry5khbeJ50FUBw&oe=6ABE6A31"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrpAu5peL7UQ7kNvwGX-sA4&_nc_oc=Ado66YuzDXxyLXoSfvHzOC1XIKwlCnFnHLSG2k0UhjYMDgNc4SxhJ74-S1Hb6jwn2b4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKecQn5gmgSwfpZtgFyv-4jlyrWWfpAXSGSTLI5a8AUIw&oe=6ABE8729"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FKYW9c3MjgQ7kNvwG22WPf&_nc_oc=AdoS94MGxyUmBACL9p6qbjq8W4qII-Mri6825QQiA50HlQJkyd_npz3cDMbSRHWgdms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPhvuWg50RF2sysUP0Fwsp8-Vwv7pyJQ0mNuCz-JPiSg&oe=6ABE616A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suwZKcdvrB8Q7kNvwE1oma0&_nc_oc=Adq6MbBzmiOtAGFuSfqfyPhXzGb8SJ4rdzHFUTxeJ-5bDQBoG0HpJiW-oQ6hBDO5l1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlUZXUK-KAcBupDWekZ1rXlaZ43_Vv6RX7LtWAfLWqmA&oe=6ABE7B3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb"
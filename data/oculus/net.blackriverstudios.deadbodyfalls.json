nt-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrgCaZwXhp_bq7-H1wOACtkOY44Ux3ICK8LH6zKwA14A&oe=69AC2FAB"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKWPHaSRizoQ7kNvwHwGBa1&_nc_oc=AdkaTjiKuPEzKfFzGzQCnPVsnOqKbr1zN_Wssi3JIAzUmEs_NpfI0MrIwVLCrY5AwKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFkEKMjP42_22PQeiHwn4feao14I92-gwG1Wrr9s3mOQ&oe=69AC3231"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1ADDYGK1_sQ7kNvwFoVy76&_nc_oc=Adl2DG3f-opywI1Mf7OnIA16yXI_emCNcM60Ac2yL_KJydH9rJY_gNxzEkA_5B2lUG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyE_rGtnDycJWm9Kxis6RM8da7KIY2p2d7PTUILHBbJow&oe=69AC16E9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paGWXBjyGxwQ7kNvwFTLDjK&_nc_oc=AdkoSABhERvCBXOECqRtsYjjBjLPDalUphiBiwsBb9QhIdGLcwHNcvy0M8aF_XiUuMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzI8BtFTXVao8btWuOuEK_rN16X6DkcH-M555klBHMXLA&oe=69AC296A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWPJtZWY2wwQ7kNvwG_3YJF&_nc_oc=AdnuRhg7UOdR319_OXgTHRC0slewm4yDxMiBeuj1tq0FFYD_KMcOqCLppmuHqDcBIJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZo2F6SltkKhzBWSh325CL--sMis6PUdYkpWedBrzf0A&oe=69AC0AFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
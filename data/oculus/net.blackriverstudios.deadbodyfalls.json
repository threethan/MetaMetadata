20_1687051414722360_5995717020287500288_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2I6xPr-BNAQ7kNvwHVEHvS&_nc_oc=Adp-BTn-q0HfIQFKKbsRq2AdbNNlzG0CVfkUTXLEIqWeM4MYyRo8ji7dLvvrqcyWL1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkgsVtkQdQJmATpVX6eOgfLrFuUxiE6RDoLeCT2rJK7Q&oe=6B07226B"}, {"file_name": "migrated_image.png", "id": "1289276431460726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504728_2152846088300303_1560288423804141568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JNL4SBjg1YQ7kNvwGAhgQz&_nc_oc=AdrKINNQyqUBpmmRacjWWLRVtJWyc7MmC1sfQIRuwCh-LJragI05lVnVxr6ihe1n-x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVsoVFpPvGcj5mYsxmwbgoJPvZETvZ8ryhZ8c-kkpLjw&oe=6B0724F1"}, {"file_name": "migrated_image.png", "id": "595226764538253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_269312860278220_6549514553019858944_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNcL_-Zf4FMQ7kNvwFkZF4W&_nc_oc=Adp3aUzYU4LWTWEubYSVEo65ibmY3MLOQierpr_iw-HiJ3nxZSqVZHeRPObA77R8DaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY5hE5tcWQQdLqWqqN89HOr5niu6AsJdM0I7DIKZAwLg&oe=6B0709A9"}, {"file_name": "migrated_image.png", "id": "572925363316719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482172_2099528280328217_2250408218511540224_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b0Z0Vkb3kcQ7kNvwEUu972&_nc_oc=AdpKlYzk7G2e6TpmIXtAQQvj8xlyhfoQ6xNad819Wq0-Aqqbr3EiWU05I-oGdYzDf3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBilASyzh8Rsa8ktKjRtSa9qxwV07Y9vGoQ1h5JIDCPw&oe=6B071C2A"}, {"file_name": "migrated_image.png", "id": "519699495644206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1529335267193858_9096715182167556096_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjYx0xLEr7YQ7kNvwHfP9ij&_nc_oc=Adq2R9yAllA8fcgi42tkZF83qOAAWXYF94xfJlvXTNPFyKIDPtNyfzr0yBaB8oC6d3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQazdcInlxd7dhQzgOEkHRKi54ovIf8_5IEuoNrzp18YQ&oe=6B06FDBA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Body Falls", "keywords": ["mistery", "atmospheric", "horror", "thriller", "narrative"], "long_description": "From the creators of Angest, the story-driven VR Game.\n\nDead Body Falls\nA disturbing event in a hotel, viewed by multiple perspectives. When no one is lying, what is the truth?\n\nPlay through the perspective of a guest, a night-watcher and a stranger, and try to understand what is happening in this strange hotel. As you progress across the halls and corridors, you will find signs that will help you create your own understanding of what happened.\n\n- MULTIPLE PERSPECTIVES - Strong storytelling experience lived from multiple views, each one retelling their own understanding of the same night\n- ENVIRONMENTAL STORYTELLING - Walk across an architectural hotel beautifully crafted and unravel the secrets that lie in it\n- IMMERSIVE EXPLORATION - Atmospheric scenes that will guide you through the event and help you cross the veil of truth\n\nDead Body Falls is a story-driven game that will keep you wondering: what actually happened that night in the hotel?", "short_description": "A disturbing event in a hotel, reenacted by multiple perspectives. When no one is lying, what is the truth?\nDead Body Falls is a story-driven game that will keep you wondering - what actually happened that night in the hotel?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://www.blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTA
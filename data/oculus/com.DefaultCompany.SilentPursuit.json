gy5TQ586yi5o8LJQZfJnzc1Udkb_PFLimLAYh_DO_g&oe=6AEC9502"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-53-24.png", "id": "1224370182919151", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618103_1224370186252484_254689727750453898_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFALHieXEioQ7kNvwH6S2wU&_nc_oc=AdrDt5EmdidpO4eY-Pw950Ypye6u4O2ktHlvhPBBwOJjfg136WzI0D67ZBH98JsafqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHebzWQYtsRRVu0TIrM34zWfadigU8ub3BSsrkQUws-g&oe=6AEC96B3"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-52-35.png", "id": "1387889559371654", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618499_1387889562704987_6544181124392935112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx9pykh07mIQ7kNvwFM4zE6&_nc_oc=AdrmkCx5bFf_zotZSS_qGm_n2y9fI05R7n2TDrPiH1iNtnfa3QXAufvj97W4-f6eChM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS55l16OfWFm7qWo6eT45BshdXT4TXNdBBFMnA5cbgdg&oe=6AECA73F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Pursuit", "keywords": ["Horror", "VR", "Action", "Adventure", "Platformer"], "long_description": "Step into a thrilling, horror-filled world inspired by Gorilla Tag. In this intense VR experience, you must navigate eerie environments, using all your agility and wits to stay one step ahead of terrifying monsters. Your objective is to survive the night by avoiding detection and outsmarting your monstrous pursuers.\n\nWith immersive graphics and chilling soundscapes, every shadow conceals potential danger. Can you remain unseen and outmaneuver the horrors lurking around every corner? \"Silent Pursuit\" will challenge your courage and stealth like never before. The monsters are watching\u2014can you evade their gaze?", "short_description": "You are investigating a mysterious facility. What are you seeking? Why are you there? Discover the answers in Silent Pursuit!"}]}, "developer_name": "DINKER00 Studios", "devel
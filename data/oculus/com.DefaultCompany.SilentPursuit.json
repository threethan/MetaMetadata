6qUxWw&oe=69B53AC2"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-53-24.png", "id": "1224370182919151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_1224370186252484_254689727750453898_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1k6QUeX_PHsQ7kNvwFBni2a&_nc_oc=Admytpeebwzn1pSVu5DD4cAKlcVJlX7YdND7CbZZVGpMuFAJtH3lNFwtbS3aRXczyVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-QT9x95BVmZKjICopxPjsi2-t8-9a7a1msKHLWohOWA&oe=69B53C73"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-52-35.png", "id": "1387889559371654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1387889562704987_6544181124392935112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecq13sPP7tkQ7kNvwEU2Kji&_nc_oc=AdkXO0yoi-fzW4XfxkVIlTLSSoejyA2egEsVs1Q2tMU5wlrxFgLC2-UIEHFaGibMETI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1YhG307a--l97D9K4kVqY8dFdBtV5-adcaPdsAPzNLA&oe=69B54CFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Pursuit", "keywords": ["Horror", "VR", "Action", "Adventure", "Platformer"], "long_description": "Step into a thrilling, horror-filled world inspired by Gorilla Tag. In this intense VR experience, you must navigate eerie environments, using all your agility and wits to stay one step ahead of terrifying monsters. Your objective is to survive the night by avoiding detection and outsmarting your monstrous pursuers.\n\nWith immersive graphics and chilling soundscapes, every shadow conceals potential danger. Can you remain unseen and outmaneuver the horrors lurking around every corner? \"Silent Pursuit\" will challenge your courage and stealth like never before. The monsters are watching\u2014can you evade their gaze?", "short_description": "You are investigating a mysterious facility. What are you seeking? Why are you there? Discover the answers in Silent Pursuit!"}]}, "developer_name": "DINKER00 Studios", "developer_privacy_policy_url": "https://dinker00s
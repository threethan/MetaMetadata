cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhNoqH1zwUYQ7kNvwHx8eBb&_nc_oc=Adry7mu9haSyZtERbpS6AAwFnT-u2E_YDJFGD9q_8OUy1rkZqJ6r2rVpkMrUHIioiNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcA-HKnJVX2HUYXqGOOh1FN8GlNGRhR2WOoC5oqrqHDA&oe=6B106313"}, {"file_name": "SampleScene_Custom..._20.01.2025_17-22-07.png", "id": "1289986162051788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391974_1289986165385121_9057546664651380318_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nm6HhvokzhAQ7kNvwE-wykr&_nc_oc=AdqzmzIy_Ui6Um9Lb1R87nEzD9jYWBrwbjDDL38HNpFpfLj8adqz3OOzyvldVPvlk5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCqOLzGJW91jCKiGBEk_vMVOGwJ7ZXySu08tsCcueejQ&oe=6B1054BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Pursuit", "keywords": ["Horror", "Game", "VR", "Action", "Games"], "long_description": "Step into a thrilling, horror-filled world inspired by Gorilla Tag. In this intense VR experience, you must navigate eerie environments, using all your agility and wits to stay one step ahead of terrifying monsters. Your objective is to survive the night by avoiding detection and outsmarting your monstrous pursuers.\n\nWith immersive graphics and chilling soundscapes, every shadow conceals potential danger. Can you remain unseen and outmaneuver the horrors lurking around every corner? \"Silent Pursuit\" will challenge your courage and stealth like never before. The monsters are watching\u2014can you evade their gaze?", "short_description": "You are investigating a mysterious facility. What are you seeking? Why are you there? Discover the answers in Silent Pursuit!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dinkeroostudios.wixsite.com/silent-pursuit", "developer_terms_of_service_url": null, "publisher_name": "Dinker00", "support_website_url": null, "website_url": "https://dinkeroostudios.wixsite.com/dinkeroo-studios", "categor
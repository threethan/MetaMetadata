oB38vGV6SJU84UWpCyUdPyFj0e46oVcpLm3ZHEDdog&oe=69DFA302"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-53-24.png", "id": "1224370182919151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618103_1224370186252484_254689727750453898_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD44K2kAZL8Q7kNvwHQPDdn&_nc_oc=AdozSVGJ9Pt2mcW_uVOrS147wLjycCcNBe8v4MNuAMlyx2lP3chNA-6HykjJbn7P2ng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_xNnOAJkbFIbCw6CN8gawYflfkZ6HMylPepfU08ngMA&oe=69DF6C73"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-52-35.png", "id": "1387889559371654", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_1387889562704987_6544181124392935112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCyuZDHnyeYQ7kNvwE-AlRG&_nc_oc=AdqQf_RZ5XYEkR7i-cmEc5Xp2_T8KzLJ6IFPB8rLOoZVpXfjb4EazHiS0jfNqCs_HSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eWyqgy0q0TT4wh6iYQH0e-8Sz6tEZVQpsWaspeNoRbQ&oe=69DF7CFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Pursuit", "keywords": ["Horror", "VR", "Action", "Adventure", "Platformer"], "long_description": "Step into a thrilling, horror-filled world inspired by Gorilla Tag. In this intense VR experience, you must navigate eerie environments, using all your agility and wits to stay one step ahead of terrifying monsters. Your objective is to survive the night by avoiding detection and outsmarting your monstrous pursuers.\n\nWith immersive graphics and chilling soundscapes, every shadow conceals potential danger. Can you remain unseen and outmaneuver the horrors lurking around every corner? \"Silent Pursuit\" will challenge your courage and stealth like never before. The monsters are watching\u2014can you evade their gaze?", "short_description": "You are investigating a mysterious facility. What are you seeking? Why are you there? Discover the answers in Silent Pursuit!"}]}, "developer_name": "DINKER00 Studios", "devel
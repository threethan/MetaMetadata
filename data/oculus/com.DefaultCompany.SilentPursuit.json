OjDn1Q&oe=69B92F42"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-53-24.png", "id": "1224370182919151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618103_1224370186252484_254689727750453898_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIzyach6ywAQ7kNvwH8ilPK&_nc_oc=AdnbVYUS8RE9BIkON7eTodZ9YgCajN1tRvI0WczDS5lxnILjBwqIs8DEkbKQtvp1Qxk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYmSSU_DSIpZGktqBbS8wCCzr7kc48q9NIcHevLILbiw&oe=69B930F3"}, {"file_name": "Main Scene_Custom..._22.12.2025_17-52-35.png", "id": "1387889559371654", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_1387889562704987_6544181124392935112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_MtB7urpv0Q7kNvwEt5Bdl&_nc_oc=AdnROHTzOwy5SY-zJFavp1L6shOuXJGQcsXb1O1vTz7JnQghhKmeAICvaa63Rq2Zcvg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxu6UkE-pc22kkOQcgGSw6sTiWTotfyKq0aXreaC1jn6g&oe=69B9417F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Pursuit", "keywords": ["Horror", "VR", "Action", "Adventure", "Platformer"], "long_description": "Step into a thrilling, horror-filled world inspired by Gorilla Tag. In this intense VR experience, you must navigate eerie environments, using all your agility and wits to stay one step ahead of terrifying monsters. Your objective is to survive the night by avoiding detection and outsmarting your monstrous pursuers.\n\nWith immersive graphics and chilling soundscapes, every shadow conceals potential danger. Can you remain unseen and outmaneuver the horrors lurking around every corner? \"Silent Pursuit\" will challenge your courage and stealth like never before. The monsters are watching\u2014can you evade their gaze?", "short_description": "You are investigating a mysterious facility. What are you seeking? Why are you there? Discover the answers in Silent Pursuit!"}]}, "developer_name": "DINKER00 Studios", "developer_privacy_policy_url": "https://dinker00s
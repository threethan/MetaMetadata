t64.5771-25/491819323_1085905376814026_2959693815756855044_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mbtHVTZTJUQ7kNvwGOz95A&_nc_oc=AdqVjGyfDjXzVwIt0h8asdsrovY5d8qTXCeQAUk46bZx1tv7gxG8vrxy8bHWad9o65A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP7GdEqciUEbJgz1UrxEvukavuN33U_1VHZpl_pCRl7Q&oe=6AE0ADD6"}, {"file_name": "1.png", "id": "1213275470645268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_1213275473978601_6458080905864717721_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWjo-X09RrAQ7kNvwGQ2cRe&_nc_oc=AdpNVoJclMbzmFKyFBOQhoTUpPiqxx4ckNqyUr7rQeDSprzm5nEqSI8BVjTDwnl-AKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUg4-wXiuFqgVBE8BZNg7VJgC6mQqZjxctEaQQS_ipmQ&oe=6AE0C56A"}, {"file_name": "4.png", "id": "776046232140416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824741_776046242140415_8520273323928516771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2BBt-bmqoIQ7kNvwHNKGn2&_nc_oc=AdrsBSXmOgQd9nztryxWJ137nf-XSk6kbuXdN3a9LfgnUHd1rVDXD54oNvNu3AuKa8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH42fM-r_3D8xiUVx6WaBGaad4TJa3-gMf1Uf9iGb16Q&oe=6AE0B81A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highway Police Escape: Car Racing Game", "keywords": ["Police", "Car", "Escape", "Chase", "Racing"], "long_description": "Hit the highway, floor the accelerator, and don\u2019t let the cops catch you.\nHighway Police Escape: Car Racing Game is a fast and simple police chase racer where every move can be your last.\n\nDrive at high speed on a busy highway while police cars try to ram, block, and corner you. Weave through traffic, avoid sudden roadblocks, and time your lane changes to stay in the race. Your mission is clear: escape the chase and survive as long as you can.\n\nThis is a casual, pick-up-and-play racing game with no complicated systems \u2013 just pure highway escape fun. Short runs, quick restarts, and easy controls make it perfect for players who want instant action and high-speed thrills.\n\nCan you outsmart the patrol cars and make it through the traffic without getting busted?\n\n# Features\n\n* **Highway police chase racing** \u2013 Experience nonstop tension as the police close in.\n* **Simple, intuitive controls** \u2013 Easy to learn, fun to master.\n* **Traffic dodge gameplay** \u2013 Avoid cars, trucks, and sudden obstacles at high speed.\n* **Progressive challenge** \u2013 Chases get faster and more intense the longer you survive.\n* **Quick restart system** \u2013 Get caught or crash? Jump back into a new chase in seconds.\n\nStart your engine, hit the highway, and prove you\u2019re the fastest escape driver in\nHighway Police Escape: Car Racing Game.", "short_description": "Race, dodge, and escape on the highway in Highway Police Escape: Car Racing Game! Speed through traffic, avoid police cars, and survive intense chases with simple controls and fast-paced levels. How long can you stay ahead of the sirens without crashing?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], 
meBv1mSyGV-FNQrKn5tGCPJI-wFogfGv3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMangyW4muog3xjn5jxm9FMnq1d6oToBLPDNFtmTtueFQ&oe=6AE09FEE"}, {"file_name": "1.png", "id": "1093385273662671", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596061819_1093385276996004_5665066038336787133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CPYfyMKH7kQ7kNvwHrewHc&_nc_oc=AdpBssmIZBfHBqV4ndEouVF1RxyOdCrWKcV1uDKYbxQ3Icw9-MchcRWTY02yCk0eoqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBKBYD7_66Xk7UAxRZr3otduWVo-zAXCMm7JunJnc1aw&oe=6AE0A445"}, {"file_name": "2.png", "id": "1094420276841678", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646448363_1094420280175011_2226638571401387923_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDqHb5UCbUgQ7kNvwHKC88J&_nc_oc=AdrmTz95w5uwlJuzX2plHYBVv-8s4TQTot35SoY8sx7_-0nA9CgfE6Ln_3ZvB5metbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Et1uUJkpr3z7mmV7SOFi0piG4tIOpVv7IxJoo3EfTQ&oe=6AE0C7DA"}, {"file_name": "4.png", "id": "1114326314335651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595129854_1114326317668984_5319288627154961246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I1MBZNVoIwQ7kNvwGxKgLK&_nc_oc=AdoEkVkz9PFYPI20t4Xtc1NMiBD8tmWN5xZHUr4atvixrdGLVtOJeYNTuKWmUZsfIKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi3atpVLiriGD0pGmLoDrar6UNxRCOHTj6h4tk9MLJIQ&oe=6AE0A029"}, {"file_name": "5.png", "id": "1169864198898384", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/654969972_1169864202231717_8598029563318944258_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Pj10Pqt6N0Q7kNvwHtnwTw&_nc_oc=AdoC8ucTSW4zeOfoD46YIq6CHadvK39QqIgrn0sFr4SYqhFLX7m7KEyfJd6RqjLK12Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOigB2uZ-7y9IAlDTVGya85tVHr0MFrg1RCS_Y6XZKmoQ&oe=6AE0C409"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Police Car Escape: Car Racing Game", "keywords": ["Police", "Car", "Escape", "Chase", "Racing"], "long_description": "Hit the highway, floor the accelerator, and don\u2019t let the cops catch you.\nPolice Car Escape: Car Racing Game is a fast and simple police chase racer where every move can be your last.\n\nDrive at high speed on a busy highway while police cars try to ram, block, and corner you. Weave through traffic, avoid sudden roadblocks, and time your lane changes to stay in the race. Your mission is clear: escape the chase and survive as long as you can.\n\nThis is a casual, pick-up-and-play racing game with no complicated systems \u2013 just pure highway escape fun. Short runs, quick restarts, and easy controls make it perfect for players who want instant action and high-speed thrills.\n\nCan you outsmart the patrol cars and make it through the traffic without getting busted?\n\n# Features\n\n* **Police car chase racing** \u2013 Experience nonstop tension as the police close in.\n* **Simple, intuitive controls** \u2013 Easy to learn, fun to master.\n* **Traffic dodge gameplay** \u2013 Avoid cars, trucks, and sudden obstacles at high speed.\n* **Progressive challenge** \u2013 Chases get faster and more intense the longer you survive.\n* **Quick restart system** \u2013 Get caught or crash? Jump back into a new chase in seconds.\n\nStart your engine, hit the highway, and prove you\u2019re the fastest escape driver in\nPolice Car Escape: Car Racing Game.", "short_description": "Race, dodge, and escape on the highway in Police Car Escape: Car Racing Game! Speed through traffic, avoid police cars, and survive intense chases with simple controls and fast-paced levels. How long can you stay ahead of the sirens without crashing?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28594709633484688"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/765553549_2261623761077251_8670524404171171903_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqLJI88kU1YQ7kNvwEJzYdf&_nc_oc=Adr2uCn6JGBeiQfwFrDaarqTYR_RK6kgCdUTXEnM8mDzJVTtStwCZMe82sbRJiWUtXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiQEuSxXq-upj5Q-oidg9oiIrqklrRUPf3EbSj4TB7SA&oe=6AE0A79E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Police Car Escape: Car Racing Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1763474040, "lastRevision": {"nodes": [{"id": "24946975784924776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24946975751591446", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "12078
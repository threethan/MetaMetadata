RIKNhj5X8oWyqEgnV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGLSwjv99ZrIRe_ao8q9bGDkq7RKbb3L1kNrbMezE5_A&oe=6AF09210"}, {"file_name": "screenshot_03_ciudad_noche_figura_2560x1440.png", "id": "1869880797506809", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292779_1869880800840142_7683187278823514914_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AYUOFNWIU4Q7kNvwGJlDao&_nc_oc=Adr8b1-SCTcsVUjqbB_094GF-7Sa82JcmDyYvJP7jPa8dDb4BDByYWo-ToAlaCAV-Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI4dzsp0XdXWKzQ3pxkdP7eJWUCAtWsF4RX8a-q5D-9g&oe=6AF0A2C1"}, {"file_name": "screenshot_04_ciudad_palmeras_2560x1440.png", "id": "1563399045252248", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302348_1563399048585581_7582910649933236960_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4g_kp1quD8Q7kNvwFlB4eP&_nc_oc=AdqvaNUergkju3xa6feNp4HKJlamTeHpyhRFhC9cczcNjlCDTwe7pEeXYsfwMw--RGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-6eRZdxl485gX6hijhSpYw-cVRez2DMg1JKzRzQzDgw&oe=6AF0815D"}, {"file_name": "screenshot_05_menu_principal_2560x1440.png", "id": "2296259801182997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654867655_2296259804516330_1324167235342103903_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIZuYH11Al0Q7kNvwGRhoZH&_nc_oc=Adr3xQFhqHyOE2oslsfgQ-LMSCUrFmtp-CM3ro12p9k3E5_0tYy6jY92a1byji-aTp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMxqWD15CMj_neB9sqj9dxLHHMAURPyG5_QkDuLYLPkA&oe=6AF09BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2783492345362874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_2783492348696207_3684296254015870910_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAXBTQ-bb9MQ7kNvwFOqf7X&_nc_oc=Ado4pUSGjY5VmqumtpHUVDbEmtb4zJD7zKHHADWzNgKegk81ebpfFHRoixMTT4l3mBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-vm067mus4dRMqHYIkAUOZ7t3SUBa68qwsryfvIR-9A&oe=6AF09ACF"}, "display_name": "Smoke Reset VR", "keywords": ["smoke", "quit", "habits"], "long_description": "SmokeReset is a calm, guided wellness experience designed to support you while\nyou quit smoking.\n\nPut the headset on, sit back, and let the session do the work. Every session\ncombines soothing music with binaural tones, spoken affirmations, guided\nbreathing and slow, hypnotic visuals \u2014 a ritual you can keep, day after day,\nwithout effort or willpower battles.\n\n\nTHE 4-WEEK PLAN\n\nYour plan gives you two sessions a day for four weeks:\n\n\u2022 Day session (about 20 minutes) \u2014 to reset your associations with cigarettes:\n  the coffee, the break, the stress, the company.\n\u2022 Night session (about 20 minutes) \u2014 calmer and darker, designed to carry you\n  gently into sleep.\n\nA calendar tracks every session, your streak, your compliance and the minutes\nyou have invested in yourself. Consistency is what does the work, and seeing it\ngrow is what keeps you going.\n\n\nSOS BOOSTER \u2014 FOR THE MOMENT THE CRAVING HITS\n\nA craving lasts three to five minutes. The SOS Booster lasts exactly five.\nWhenever the urge arrives, launch it and let it pass with you: guided 4-6\nbreathing, a voice that reminds you why you started, and visuals that hold your\nattention until the wave breaks.\n\n\nWHAT A SESSION FEELS LIKE\n\n\u2022 Randomly chosen environments: a summer forest, an autumn forest, a night city,\n  a beach at sunset, or a calm field of lights in the dark.\n\u2022 A gentle walk through the scenery while the therapy unfolds around you.\n\u2022 A living sculpture of liquid metal that breathes with you, guiding your rhythm.\n", "short_description": "Guided relaxation for quitting smoking: 20-minute day and night sessions,\n5-minute SOS boosters for cravings, and a 4-week plan that tracks your streak.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/aede69f3-6e54-461d-88ac-86f2c02637d5", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel mIER Y tERAN aLMAZAN", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/aede69f3-6e54-461d-88ac-86f2c02637d5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1107789785020457"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303976_1597567751893480_2316781723485338613_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRKucBTbtRUQ7kNvwEPkF3u&_nc_oc=AdrlqXAbLl1eYfG88TuLZcq44Wu58oddQ-yHM-osMFWorN55nG3qrY79jCzmpEjEZ7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS9ao9BpLDvUvfyID1tKI-80KXc8syrc5M2y8brYWn1Q&oe=6AF08272"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Smoke Reset VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1786552800, "lastRevision": {"nodes": [{"id": "1094169873049115", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1094169859715783", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "27820124541015567"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1730968697949443", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Smoke Reset VR", "keywords": ["smoke", "quit", "habits"], "long_description": "SmokeReset es una experiencia de bienestar, tranquila y guiada, pensada para\nacompa\u00f1arte mientras dejas de fumar.\n\nPonte el visor, si\u00e9ntate y deja que la sesi\u00f3n trabaje. Cada sesi\u00f3n combina\nm\u00fasica serena con tonos binaurales, afirmaciones habladas, respiraci\u00f3n guiada y\nvisuales lentos e hipn\u00f3ticos: un ritual que puedes sostener d\u00eda tras d\u00eda, sin\npeleas de fuerza de voluntad.\n\n\nEL PLAN DE 4 SEMANAS\n\nTu plan son dos sesiones al d\u00eda durante cuatro semanas:\n\n\u2022 Sesi\u00f3n de d\u00eda (unos 20 minutos) \u2014 para romper las asociaciones que atan el\n  cigarro a tus momentos: el caf\u00e9, el descanso, el estr\u00e9s, la compa\u00f1\u00eda.\n\u2022 Sesi\u00f3n de noche (unos 20 minutos) \u2014 m\u00e1s oscura y m\u00e1s calmada, pensada para\n  acompa\u00f1arte suavemente hasta el sue\u00f1o.\n\nUn calendario registra cada sesi\u00f3n, tu racha, tu cumplimiento y los minutos que\nte has dedicado. La constancia es la que hace el trabajo, y verla crecer es lo\nque sostiene las ganas.\n\n\nREFUERZO SOS \u2014 PARA EL MOMENTO DEL ANTOJO\n\nUn antojo dura de tres a cinco minutos. El Refuerzo SOS dura exactamente cinco.\nCuando llegue la urgencia, l\u00e1nzalo y d\u00e9jala pasar acompa\u00f1ado: respiraci\u00f3n guiada\n4-6, una voz que te recuerda por qu\u00e9 empezaste y visuales que sostienen tu\natenci\u00f3n hasta que la ola rompe.\n\n\nC\u00d3MO SE SIENTE UNA SESI\u00d3N\n\n\u2022 Escenarios elegidos al azar: un bosque de verano, un bosque de oto\u00f1o, una\n  ciudad de noche, una playa al atardecer o un campo de luces en la oscuridad.\n\u2022 Un paseo suave por el escenario mientras la terapia sucede a tu alrededor.\n\u2022 Una escultura", "short_description": "Relajaci\u00f3n guiada para dejar de fumar: sesiones de d\u00eda y noche de 20 minutos,\nrefuerzos SOS de 5 minutos y un plan de 4 semanas que registra tu constancia.\n"}, {"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "1686987379024760", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646448363_1686987382358093_7073116750428546228_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLzVmHcQEHoQ7kNvwHLwWuo&_nc_oc=AdrSapUsWAyeTuxgnzf3pbxUFAeotDLrOld4siu0ZTad9bx7emWwvJLGJUs3id2Fj-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkkp40HKWMOJWlcCyV0ZD5ms6JvnE8m75JZgP3Sh7xBg&oe=6AF086D6"}, {"file_name": "cover_square_1440x1440.png", "id": "1597567748560147", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303976_1597567751893480_2316781723485338613_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRKucBTbtRUQ7kNvwEPkF3u&_nc_oc=AdrlqXAbLl1eYfG88TuLZcq44Wu58oddQ-yHM-osMFWorN55nG3qrY79jCzmpEjEZ7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6VsHMo2CfnJ7Bd04qtp9wqIcM7gZeRuHB4jnBqKxQFg&oe=6AF08272"}, {"file_name": "icon_512x512.png", "id": "1347120757635966", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296209_1347120760969299_7856789009988354624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNgpaaAl_NIQ7kNvwGjlpjw&_nc_oc=AdpMsn0aPUNqh639s0RRZe8Rr9_luL2OfSjQUiVSwz2xPz9Dgep9Yf0AupITmHBdjdI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM1ABmvIMsynHRMBRI7MxKgLp2HZzA-VYDPVRM8BkgIg&oe=6AF0AA2D"}, {"file_name": "cover_landscape_2560x1440.png", "id": "1063100372825686", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299922_1063100376159019_2716105565189049132_n.png?_nc_cat=108&ccb=1-7
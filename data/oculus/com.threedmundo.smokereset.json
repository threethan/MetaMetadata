d": "1090405800092189"}]}, "id": "1564227115108028"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1089830723483030"}]}, "id": "975129688874092"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1089632290169540"}]}, "id": "2199905670808037"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1080980721034697"}]}, "id": "1918693155460819"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1078277797971656"}]}, "id": "1540912091157854"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8659496074075907"}]}, "id": "756067645443626"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "5891786154170029"}]}, "id": "1030126614306267"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1094169859715783", "release_date": 1786552800, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1102114292254673"}, "id": "1418120273522636"}]}}, "binary": null, "live_binary": null, "created_date": 1786863381, "id": "1107725135026922", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1107789785020457"}, "release_status": "RELEASED", "id": "1094169859715783"}, "id": "1107789785020457", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1094169859715783", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "27820124541015567"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1662852248118319", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Smoke Reset VR", "keywords": ["smoke", "quit", "habits"], "long_description": "SmokeReset es una experiencia de bienestar, tranquila y guiada, pensada para\nacompa\u00f1arte mientras dejas de fumar.\n\nPonte el visor, si\u00e9ntate y deja que la sesi\u00f3n trabaje. Cada sesi\u00f3n combina\nm\u00fasica serena con tonos binaurales, afirmaciones habladas, respiraci\u00f3n guiada y\nvisuales lentos e hipn\u00f3ticos: un ritual que puedes sostener d\u00eda tras d\u00eda, sin\npeleas de fuerza de voluntad.\n\n\nEL PLAN DE 4 SEMANAS\n\nTu plan son dos sesiones al d\u00eda durante cuatro semanas:\n\n\u2022 Sesi\u00f3n de d\u00eda (unos 20 minutos) \u2014 para romper las asociaciones que atan el\n  cigarro a tus momentos: el caf\u00e9, el descanso, el estr\u00e9s, la compa\u00f1\u00eda.\n\u2022 Sesi\u00f3n de noche (unos 20 minutos) \u2014 m\u00e1s oscura y m\u00e1s calmada, pensada para\n  acompa\u00f1arte suavemente hasta el sue\u00f1o.\n\nUn calendario registra cada sesi\u00f3n, tu racha, tu cumplimiento y los minutos que\nte has dedicado. La constancia es la que hace el trabajo, y verla crecer es lo\nque sostiene las ganas.\n\n\nREFUERZO SOS \u2014 PARA EL MOMENTO DEL ANTOJO\n\nUn antojo dura de tres a cinco minutos. El Refuerzo SOS dura exactamente cinco.\nCuando llegue la urgencia, l\u00e1nzalo y d\u00e9jala pasar acompa\u00f1ado: respiraci\u00f3n guiada\n4-6, una voz que te recuerda por qu\u00e9 empezaste y visuales que sostienen tu\natenci\u00f3n hasta que la ola rompe.\n\n\nC\u00d3MO SE SIENTE UNA SESI\u00d3N\n\n\u2022 Escenarios elegidos al azar: un bosque de verano, un bosque de oto\u00f1o, una\n  ciudad de noche, una playa al atardecer o un campo de luces en la oscuridad.\n\u2022 Un paseo suave por el escenario mientras la terapia sucede a tu alrededor.\n\u2022 Una escultura", "short_description": "Relajaci\u00f3n guiada para dejar de fumar: sesiones de d\u00eda y noche de 20 minutos,\nrefuerzos SOS de 5 minutos y un plan de 4 semanas que registra tu constancia.\n"}, {"images": {"nodes": [{"file_name": "2_libre_de_humo_equirect_6000x3000.png", "id": "1854221552215132", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301196_1854221555548465_3618919506461468615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJqzat1yDm0Q7kNvwGJMrha&_nc_oc=Adp5g4RwWu8v8VH4ICNmhdOH0rvOlJezl1RVqd5vQYN1Ep3nDHm57wZlhKJVBLlE0j0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrwCQkU6lq9V2b4kZ4flHIZ-OKTezxRtbaWOREtEqP7A&oe=6AF0A6D9"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1686987379024760", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646448363_1686987382358093_7073116750428546228_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLzVmHcQEHoQ7kNvwHLwWuo&_nc_oc=AdrSapUsWAyeTuxgnzf3pbxUFAeotDLrOld4siu0ZTad9bx7emWwvJLGJUs3id2Fj-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkkp40HKWMOJWlcCyV0ZD5ms6JvnE8m75JZgP3Sh7xBg&oe=6AF086D6"}, {"file_name": "cover_square_1440x1440.png", "id": "1597567748560147", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303976_1597567751893480_2316781723485338613_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRKucBTbtRUQ7kNvwEPkF3u&_nc_oc=AdrlqXAbLl1eYfG88TuLZcq44Wu58oddQ-yHM-osMFWorN55nG3qrY79jCzmpEjEZ7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6VsHMo2CfnJ7Bd04qtp9wqIcM7gZeRuHB4jnBqKxQFg&oe=6AF08272"}, {"file_name": "icon_512x512.png", "id": "1347120757635966", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296209_1347120760969299_7856789009988354624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNgpaaAl_NIQ7kNvwGjlpjw&_nc_oc=AdpMsn0aPUNqh639s0R
c=Adr8b1-SCTcsVUjqbB_094GF-7Sa82JcmDyYvJP7jPa8dDb4BDByYWo-ToAlaCAV-Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI4dzsp0XdXWKzQ3pxkdP7eJWUCAtWsF4RX8a-q5D-9g&oe=6AF0A2C1"}, {"file_name": "screenshot_04_ciudad_palmeras_2560x1440.png", "id": "1563399045252248", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302348_1563399048585581_7582910649933236960_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4g_kp1quD8Q7kNvwFlB4eP&_nc_oc=AdqvaNUergkju3xa6feNp4HKJlamTeHpyhRFhC9cczcNjlCDTwe7pEeXYsfwMw--RGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-6eRZdxl485gX6hijhSpYw-cVRez2DMg1JKzRzQzDgw&oe=6AF0815D"}, {"file_name": "screenshot_05_menu_principal_2560x1440.png", "id": "2296259801182997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654867655_2296259804516330_1324167235342103903_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIZuYH11Al0Q7kNvwGRhoZH&_nc_oc=Adr3xQFhqHyOE2oslsfgQ-LMSCUrFmtp-CM3ro12p9k3E5_0tYy6jY92a1byji-aTp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMxqWD15CMj_neB9sqj9dxLHHMAURPyG5_QkDuLYLPkA&oe=6AF09BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2783492345362874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_2783492348696207_3684296254015870910_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAXBTQ-bb9MQ7kNvwFOqf7X&_nc_oc=Ado4pUSGjY5VmqumtpHUVDbEmtb4zJD7zKHHADWzNgKegk81ebpfFHRoixMTT4l3mBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-vm067mus4dRMqHYIkAUOZ7t3SUBa68qwsryfvIR-9A&oe=6AF09ACF"}, "display_name": "Smoke Reset VR", "keywords": ["smoke", "quit", "habits"], "long_description": "SmokeReset is a calm, guided wellness experience designed to support you while\nyou quit smoking.\n\nPut the headset on, sit back, and let the session do the work. Every session\ncombines soothing music with binaural tones, spoken affirmations, guided\nbreathing and slow, hypnotic visuals \u2014 a ritual you can keep, day after day,\nwithout effort or willpower battles.\n\n\nTHE 4-WEEK PLAN\n\nYour plan gives you two sessions a day for four weeks:\n\n\u2022 Day session (about 20 minutes) \u2014 to reset your associations with cigarettes:\n  the coffee, the break, the stress, the company.\n\u2022 Night session (about 20 minutes) \u2014 calmer and darker, designed to carry you\n  gently into sleep.\n\nA calendar tracks every session, your streak, your compliance and the minutes\nyou have invested in yourself. Consistency is what does the work, and seeing it\ngrow is what keeps you going.\n\n\nSOS BOOSTER \u2014 FOR THE MOMENT THE CRAVING HITS\n\nA craving lasts three to five minutes. The SOS Booster lasts exactly five.\nWhenever the urge arrives, launch it and let it pass with you: guided 4-6\nbreathing, a voice that reminds you why you started, and visuals that hold your\nattention until the wave breaks.\n\n\nWHAT A SESSION FEELS LIKE\n\n\u2022 Randomly chosen environments: a summer forest, an autumn forest, a night city,\n  a beach at sunset, or a calm field of lights in the dark.\n\u2022 A gentle walk through the scenery while the therapy unfolds around you.\n\u2022 A living sculpture of liquid metal that breathes with you, guiding your rhythm.\n", "short_description": "Guided relaxation for quitting smoking: 20-minute day and night sessions,\n5-minute SOS boosters for cravings, and a 4-week plan that tracks your streak.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/aede69f3-6e54-461d-88ac-86f2c02637d5", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel mIER Y tERAN aLMAZAN", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/aede69f3-6e54-461d-88ac-86f2c02637d5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_
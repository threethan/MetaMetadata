a0a&_nc_ohc=zYJZ82czuVQQ7kNvwEnDa1H&_nc_oc=AdrhwXeiW8ER3sFgSfs_gmw7CaNTAS91WGzGbMjAdkKoEVyGbxhbQimQpMLeYTP5rXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIARhkSAq4_DTV9ia1LvXl9aFxrMwpXuAyl-blwMRkPw&oe=6B0DB739"}, "display_name": "Dem-Con Materials Recovery Facility Virtual Tour", "keywords": ["recycling", "environment", "green", "education", "waste"], "long_description": "Take an incredible virtual tour of Dem-Con's high-tech recycling facility in Shakopee, Minnesota! Follow the items you recycle beyond the curb, and learn about the amazing machines that help transform them into exciting new products.\n\nRide across the Tipping Floor atop a front-end loader! Watch a brainy robot plucking cartons at lightning speed! Listen to the thunderous shatter deep inside the Glass Breaker Screen!\n\nDem-Con believes everyone should have the opportunity to see how solid waste is managed. Understanding how recyclables are sorted helps each of us to become better recyclers, which helps make the world a greener place.\n\nA fascinating educational experience for all ages.", "short_description": "Take an incredible virtual tour of Dem-Con's high-tech recycling facility in Shakopee, Minnesota! Follow the items you recycle beyond the curb, and learn about the amazing machines that help transform them into exciting new products.\n\nRide across the Tipping Floor atop a front-end loader! Watch a brainy robot plucking cartons at lightning speed! Listen to the thunderous shatter deep inside the Glass Breaker Screen!\n\nA fascinating educational experience for all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "http://greengrades.com/", "developer_terms_of_service_url": "http://greengrades.com/", "publisher_name": "Sunstone Creative Group", "support_website_url": null, "website_url": "http://greengrades.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external
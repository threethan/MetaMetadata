4968401756562_2429174088005463087_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf54AiAx348Q7kNvwHG7dv8&_nc_oc=Adp4oBwGSV2n3gbKpEjIMcLyfFYlMm1rSz9ieHBc5kEmEjwdaplHLpbRNMDTCZerMkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FSh4fbg5P0yDe8zWaKM2qMwsr35vJ87JOme0j_rnFcg&oe=6A1EE81A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_25601440.png", "id": "1118399528653253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031485_1118399531986586_4166125520669467315_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENF865nDc4MQ7kNvwHXCWhj&_nc_oc=AdrYapBpc1P4TSL7i3L-qc1Uzg0tJCme3O7id-qARVaONNf5OKN77dy9Y1ejGwr8-4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kjmWMEKngixackzGCF6zupDIqd-T8p4JCIucu-bGNyA&oe=6A1EED2B"}, "display_name": "HorseRider DEMO", "keywords": [], "long_description": "Prancing through the vast Central Continent, through the blockade of undead hordes, bandits and rebels, helping the lords deliver letters, supplies or legendary weapons as fast as possible!\n\nWhether it's low shrubs, dry deserts, vast meadows, or rugged mountains, mount a different legendary horse and set out on a journey with your friends. Visit a cliff fortress in a confrontation, a fortified fortress on a steppe, a grand town at the confluence of rivers, or experience an adventure to and from the Dragon's Lair and become a hero on horseback.", "short_description": "Prancing through the vast Central Continent, through the blockade of undead hordes, bandits and rebels, helping the lords deliver letters, supplies or legendary weapons as fast as possible!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.monduz.com/hrPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Monduz Games", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100088044019561", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
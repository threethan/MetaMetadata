4968401756562_2429174088005463087_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSMp3Xw_dQsQ7kNvwH0yowc&_nc_oc=AdoqXYCE2MNvmqUtyuiFQT7oLxUm05RnSCL0TSluTCdZvhKzlgCniX3VpiBUGN8w1kY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpc9c238895kTEhe4r0brrIGmlttf3dynEVjq1Vz_5ww&oe=6A6CB09A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_25601440.png", "id": "1118399528653253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031485_1118399531986586_4166125520669467315_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpdY8dqodngQ7kNvwEG1lCJ&_nc_oc=Adq9C6vIUXTf7fR7jjCHbjWOXdKvpoOylVRoXYWpEJyMrLqKPVlO1pvfOmwx4df3j1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvbX00DovPZjCkKYeTlYYxYaHUkq7tBp02c7wSlcjg1w&oe=6A6CB5AB"}, "display_name": "HorseRider DEMO", "keywords": [], "long_description": "Prancing through the vast Central Continent, through the blockade of undead hordes, bandits and rebels, helping the lords deliver letters, supplies or legendary weapons as fast as possible!\n\nWhether it's low shrubs, dry deserts, vast meadows, or rugged mountains, mount a different legendary horse and set out on a journey with your friends. Visit a cliff fortress in a confrontation, a fortified fortress on a steppe, a grand town at the confluence of rivers, or experience an adventure to and from the Dragon's Lair and become a hero on horseback.", "short_description": "Prancing through the vast Central Continent, through the blockade of undead hordes, bandits and rebels, helping the lords deliver letters, supplies or legendary weapons as fast as possible!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.monduz.com/hrPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Monduz Games", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100088044019561", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
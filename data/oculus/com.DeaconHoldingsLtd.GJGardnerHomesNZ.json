r2UibtWaI6qTgalHHLz8H1VvB6ug9bgjz9HNVCMEonjiWOvoXCCsu1R7E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CQvK4iClO6k8fsfjHCP1U0KouSxUwroXN7zFdjUe1Gg&oe=6A2C29A3"}, {"file_name": "3.png", "id": "1507113716799713", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575360_1507113723466379_6220800982691656058_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uwvde6bV9kwQ7kNvwE9ivZg&_nc_oc=Ado0m_fWuGFa0EikPZCjZu3SfDS61ILfLVdoQ37B4R1-NfkFPvOxb433yBM_FHd_HbI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aeX15PqGLOZkRUXYX7Q7K5F4aabV2eJDrvIATjTw5Uw&oe=6A2C2D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image.png", "id": "471999365380605", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294241_471999368713938_1589440468633063561_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTFGdMmmmRoQ7kNvwFFanCC&_nc_oc=AdqzDmiQycKcyTMBz9k01gb8kSczcPz30WEQRReQ358TpIhlPHkx4yhcUoBH6qWArj0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uSQUVaySBwT6NlqLknNnW62URx6Jt9UFOhyFWb4Ew6w&oe=6A2C1F75"}, "display_name": "G.J. Gardner Homes NZ", "keywords": [], "long_description": "At G.J. Gardner Homes NZ, we're transforming the traditional approach to selling off-the-plan properties, advancing beyond the usual brochures, photo renders, and display suites. Our innovative G.J. Gardner Homes NZ app introduces a pioneering solution, enabling the exploration of future projects through high-fidelity Virtual Reality and Augmented Reality. This state-of-the-art app, accessible via VR headsets or smart devices, provides a fully mobile, multi-user, and collaborative experience. Designed with a user-friendly interface, the app enhances your sales process by allowing real-time interactions and detailed presentations during virtual property tours.", "short_description": "The G.J. Gardner Homes NZ app offers an immersive Virtual Reality experience for previewing upcoming projects with remarkable clarity. This app enables you to conduct virtual tours of properties that are still in development. While in VR, you have the capability to interact with potential buyers in real-time, guiding them through the property and providing detailed explanations of the features they're viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gjgardner.co.nz/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Deacon Holdings Ltd", "support_website_url": null, "website_url": "https://www.gjgardner.co.nz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6905623469541206"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "323712323969938"}]}, "baseline_offer": {"id": "323712323969938"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719361231, "status": "PUBLISHED", "id": "323712323969938"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25778165275193741", "version": "7.0.001"}, "id": "730161749040116", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6220021018101458", "is_conc
71-25/491823286_25343415865289712_8010599026673476838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9ZjNi2IJxwQ7kNvwGXuhby&_nc_oc=AdrCPflqIk04NVxaq5DQj4-Fh0HWpIidp8icNvQ6Azzg3-ZscWPWTq4UIsTOhBJs6A4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3ByHIg2P5jhYplciOqto6eQh5TlugCPG8xwT4oMe_Xg&oe=6A649E23"}, {"file_name": "Shot_20251204_084406_889.png", "id": "1994232241397148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1994232244730481_3226969379327950226_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjufiBnFWR4Q7kNvwFmETge&_nc_oc=AdrnIKuOq5ddNb6PzApMt-AoCQN9AwB4S_AHziPOBUweIHlBsz2VSgwZ6AEcUq5kiIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ9oDNhaZ89leNkGs8sQBiluBm5t7ZevhHI1iLBoUgYQ&oe=6A64D275"}, {"file_name": "Shot_20251204_084657_540.png", "id": "1960840148108563", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_1960840151441896_83495383831585364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I26ji3JuAWQQ7kNvwGzxufV&_nc_oc=AdqzC9pSz5yQrokQhzrFhkZTFK4d3pc-y_aAAX9O-klzXNP9H3LmW70LF_Nioo1M0kE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAElgDfF9M-Q9_GDGiL2v_P1QwVhICEmXR7xXS3IVGhwQ&oe=6A64B449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2389346541518064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_2389346544851397_4714244575077333914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjfWTGQS8YcQ7kNvwE2K59_&_nc_oc=AdqP0Mi-_rmt6l9eG_Grv8C1oUD1E2KAjak-gn_Wn_sjlPAPMvb1rtkbfonqe2So1TM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADVMRlAp6PdaBpmDwdUZtGQEC1q8_C-5-ar85kim_qXg&oe=6A64A858"}, "display_name": "Space Royale", "keywords": ["SciFi", "Multiplayer", "RTS", "ActionStrategy", "DeckBuilding"], "long_description": "# Space Royale is a Sci Fi Action RTS where you build decks, deploy units with your hands, and crush opponents in fast Multiplayer duels.\n\nDefeat aliens invasion in Singleplayer Campaign!\n\nChallenge your friends in Multiplayer Battles!\n\nBuild your unique deck and be invincible in battles!\n\nIn **Expansion**, you don\u2019t just control the fight \u2014 you step into it. Matches are short, high stakes, and packed with tactical choices. Every duel is a chance to outthink and outplay your opponent.\n\nBuild a custom deck of units ranging from cheap swarmers to devastating siege beasts. Deploy them onto the battlefield with your own hands, creating a tactile, hands on strategy experience that makes every match unique. Outsmart rivals, time your moves, and destroy the enemy\u2019s Command Tower before they destroy yours.\n\n# Core Features\n\n- **Deck Building Strategy** \u2014 craft unique armies and define your playstyle\n- **Fast Duels** \u2014 short, high intensity battles built for replayability\n- **Hands On Control** \u2014 summon and command units directly with your hands\n- **Unique Arenas** \u2014 Sci Fi maps with distinct layouts and challenges\n- **Solo and Multiplayer** \u2014 test your skills against AI or clash with real players online\n\n**Expansion blends the tactical depth of RTS with the thrill of Action Strategy, all set in a Sci Fi universe where victory is in your hands.**\n", "short_description": "Sci-Fi VR Action RTS \u2013 Singleplayer Campaign, Multiplayer with friends, Deck-Build, Hand-Deploy, Dominate the Cosmos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.expansion-vr.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Plazma Studio", "support_website_url": null, "website_url": "https://www.expansion-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "ADVENTURE", "SPACE_UNIVERSE"], "has_i
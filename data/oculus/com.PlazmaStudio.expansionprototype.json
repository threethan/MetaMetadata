71-25/491823286_25343415865289712_8010599026673476838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pivo7uC56CoQ7kNvwEUryPx&_nc_oc=AdozOltiP6vHW4VDWS9ZIGuhg_LI3rZlkDUFC42qdIc0NUqAGXZ08XUWMtDajLQhP1s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T2ORdxkCheZl4CJN6UMUYI0doWntJR95fTn9jvE4OUw&oe=6A2C25E3"}, {"file_name": "Shot_20251204_084406_889.png", "id": "1994232241397148", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820855_1994232244730481_3226969379327950226_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXcsPWC3IgkQ7kNvwEI0V0H&_nc_oc=Adp9NAVaR2EiT9j-haRCs1PuVlfgqX2uejOW9BwFVvdyWtl4ApiHZGSdwbse3-cpKc4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87FFD0Kf7w4TsJ_Jmx0pwBrYLu317jGQ4KudGeesYZxQ&oe=6A2C21F5"}, {"file_name": "Shot_20251204_084657_540.png", "id": "1960840148108563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827601_1960840151441896_83495383831585364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VN_pntOzx4Q7kNvwHhMTq4&_nc_oc=AdpdlsEswDI1yJlQUZX3Klz8Kj--YBQgy0PKvlkEiM2GSZvtIFcAEEEJwagnQicqLQY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XJ67Chp_TFmPum0zDST_iMQNNS5VArk3ZBHg8ZdVaJg&oe=6A2C03C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2389346541518064", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821682_2389346544851397_4714244575077333914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTdaFYC0XGkQ7kNvwGlbsFg&_nc_oc=Adoa7V8MjScV-FePBm4uwGDKZ8ua5SZAbfK4sDOq799So96q2mAshtQqP5K_qafr56c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xtcVNeu9qutGqkQAtTSKmQiUFxD8OuPUTfy5rnW6CwQ&oe=6A2C3018"}, "display_name": "Space Royale", "keywords": ["SciFi", "Multiplayer", "RTS", "ActionStrategy", "DeckBuilding"], "long_description": "# Space Royale is a Sci Fi Action RTS where you build decks, deploy units with your hands, and crush opponents in fast Multiplayer duels.\n\nDefeat aliens invasion in Singleplayer Campaign!\n\nChallenge your friends in Multiplayer Battles!\n\nBuild your unique deck and be invincible in battles!\n\nIn **Expansion**, you don\u2019t just control the fight \u2014 you step into it. Matches are short, high stakes, and packed with tactical choices. Every duel is a chance to outthink and outplay your opponent.\n\nBuild a custom deck of units ranging from cheap swarmers to devastating siege beasts. Deploy them onto the battlefield with your own hands, creating a tactile, hands on strategy experience that makes every match unique. Outsmart rivals, time your moves, and destroy the enemy\u2019s Command Tower before they destroy yours.\n\n# Core Features\n\n- **Deck Building Strategy** \u2014 craft unique armies and define your playstyle\n- **Fast Duels** \u2014 short, high intensity battles built for replayability\n- **Hands On Control** \u2014 summon and command units directly with your hands\n- **Unique Arenas** \u2014 Sci Fi maps with distinct layouts and challenges\n- **Solo and Multiplayer** \u2014 test your skills against AI or clash with real players online\n\n**Expansion blends the tactical depth of RTS with the thrill of Action Strategy, all set in a Sci Fi universe where victory is in your hands.**\n", "short_description": "Sci-Fi VR Action RTS \u2013 Singleplayer Campaign, Multiplayer with friends, Deck-Build, Hand-Deploy, Dominate the Cosmos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.expansion-vr.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Plazma Studio", "support_website_url": null, "website_url": "https://www.expansion-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "ADVENTURE", "SPACE_UNIVERSE"], "has_i
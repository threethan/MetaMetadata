ame": "logo_new.png", "id": "825084610047425", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309561_825084616714091_2546572794948739306_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUx93I9A5EIQ7kNvwGFbKuy&_nc_oc=AdmFrF467--BNGGP3nTDyTRpvEwVLW4elacojQIbFpXWQcOLi05XLrho8fZJLaSetJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8ZYzDp7bHbEMfyDJVtyIQqa-vOMOBbBXHsxhODFYZcA&oe=69A04282"}]}, "id": "1979033826052878", "locale": "en_US", "screenshots": [{"file_name": "Shot_20251204_084739_756.png", "id": "2512388552495173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_2512388555828506_6793122267483577934_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svO8JV_OwKAQ7kNvwGznVmJ&_nc_oc=AdkYsJqBaAf_pATfM4nJYTyyZSHUhGARnwsScVLLDrDXI7cX0k-waGdmvYbxm7bnIzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHslZW8Z5mm0ajUxCG6Xid81zQAtHLihPeGLPaeP1dZQ&oe=69A0479E"}, {"file_name": "Shot_20251204_084905_336.png", "id": "1548145916391195", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1548145919724528_6635316111747011428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7ZnN7mqdX4Q7kNvwEm5ZZC&_nc_oc=Adml9b1EahE3WVpKHRgfLcDL-XPh9A2rhmQtBifEetBHZud_iOXWszSnC3y9QGL_wT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLrtDyPhk4QeClgOCizmiMc7002NagU35tCql2ivF94g&oe=69A04A4B"}, {"file_name": "Shot_20251204_084523_886.png", "id": "25343415851956380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_25343415865289712_8010599026673476838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a23uRSAmR1AQ7kNvwGcPEHC&_nc_oc=AdmeGm3se7gWq5YxCzaR2XeQLy7naFUywmbrb1GrYRnDsfCzkvs4zapY0OWXZVICSF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvvmrZSVYxZQMmPa-s6Y2TeAxB9z_m6QbWzLRdD0loxAQ&oe=69A02EA3"}, {"file_name": "Shot_20251204_084406_889.png", "id": "1994232241397148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1994232244730481_3226969379327950226_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwucrUB80bIQ7kNvwGzCCY3&_nc_oc=AdkH3srcnSzbGILMz-s5EQJMcSujF8ygUa2BoP_81WQRNwzaVmV9d4HdnV2u1FSjObk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPF0VQ1JgWJ-wW78j3tnRLlHUAlKCAq5SLFtcXg9v6_Q&oe=69A02AB5"}, {"file_name": "Shot_20251204_084657_540.png", "id": "1960840148108563", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_1960840151441896_83495383831585364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akhLvwMBULUQ7kNvwGwZuuB&_nc_oc=Adn2hVG6JRdnQTZl2gNO273GtVaZEN-MIAJLGoQ-wtxdr0zz85fQHv2Rz1yQizMYuvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu20LW21S6rF-hqqjE5xtVU9GPQ_qVhem4OoKf2ovCHuw&oe=69A044C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2389346541518064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_2389346544851397_4714244575077333914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4XFMYdSMRcQ7kNvwF61B6z&_nc_oc=AdkxNs_bfjsHAqmMjHzHziMOd-jpGGK6gfFxUhQzrWikKN6bwGP7T0GRgU73LZgx-lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftwL3Xezjt0pcFSu4p4t_LF1faUlNs4eDzIRHsgAcnjkg&oe=69A038D8"}, "display_name": "Expansion RTS", "keywords": ["SciFi", "Multiplayer", "RTS", "ActionStrategy", "DeckBuilding"], "long_description": "# Expansion is a Sci Fi Action RTS where you build decks, deploy units with your hands, and crush opponents in fast Multiplayer duels.\n\nDefeat aliens invasion in Singleplayer Campaign!\n\nChallenge your friends in Multiplayer Battles!\n\nBuild your unique deck and be invincible in battles!\n\nIn **Expansion**, you don\u2019t just control the fight \u2014 you step into it. Matches are short, high stakes, and packed with tactical choices. Every duel is a chance to outthink and outplay your opponent.\n\nBuild a custom deck of units ranging from cheap swarmers to devastating siege beasts. Deploy them onto the battlefield with your own hands, creating a tactile, hands on strategy experience that makes every match unique. Outsmart rivals, time your moves, and destroy the enemy\u2019s Command Tower before they destroy yours.\n\n# Core Features\n\n- **Deck Building Strategy** \u2014 craft unique armies and define your playstyle\n- **Fast Duels** \u2014 short, high intensity battles built for replayability\n- **Hands On Control** \u2014 summon and command units directly with your hands\n- **Unique Arenas** \u2014 Sci Fi maps with distinct layouts and challenges\n- **Solo and Multiplayer** \u2014 test your skills against AI or clash with real players online\n\n**Expansion blends the tactical depth of RTS with the thrill of Action Strategy, all set in a Sci Fi universe where victory is in your hands.**\n", "short_description": "Sci-Fi VR Action RTS \u2013 Singleplayer Campaign, Multiplayer with friends, Deck-Build, Hand-Deploy, Dominate the Cosmos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.expansion-vr.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Plazma Studio", "support_website_url": null, "website_url": "https://www.expansion-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "ADVENTURE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "ru", "es", "uk", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25730134379915155"}, "review_messages": []}]}
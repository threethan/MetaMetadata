481_3226969379327950226_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwucrUB80bIQ7kNvwFvYia-&_nc_oc=AdnSeNLB6scCYnJEUXC0upw4r_dghf1zTC9KSHg1FbSF6IsB19iFzUpIUskMxYBEuXY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftg5jcAGOQQpZ0W82PRD-QZ2dAsau0YCkxpfRSlAF7CFA&oe=69A17C35"}, {"file_name": "Shot_20251204_084657_540.png", "id": "1960840148108563", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491827601_1960840151441896_83495383831585364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akhLvwMBULUQ7kNvwGIkbet&_nc_oc=Adnng-rTReC0_IYpoPh26nHLdiT5dxNLxplJnp3-t9_qH1iaxdM-7pWGUHIyoRe6zP0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsPTa9U1bgkv3U5WnSIp454UeAvS3TnsH6WN5l_5h9xlw&oe=69A19649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2389346541518064", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821682_2389346544851397_4714244575077333914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMAJz5EGom0Q7kNvwHyvLZD&_nc_oc=AdkekLUrhAeNDLedtOzFeDcD1m-Bu3q5uz7oMrv6yps1H0x7Qu22Qllwl2zIuQXsjJ0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afub0cjKnDeeX_oJc13MPkgoqoxFP9inkSoHJjKLA4xjMg&oe=69A18A58"}, "display_name": "Expansion RTS", "keywords": ["SciFi", "Multiplayer", "RTS", "ActionStrategy", "DeckBuilding"], "long_description": "# Expansion is a Sci Fi Action RTS where you build decks, deploy units with your hands, and crush opponents in fast Multiplayer duels.\n\nDefeat aliens invasion in Singleplayer Campaign!\n\nChallenge your friends in Multiplayer Battles!\n\nBuild your unique deck and be invincible in battles!\n\nIn **Expansion**, you don\u2019t just control the fight \u2014 you step into it. Matches are short, high stakes, and packed with tactical choices. Every duel is a chance to outthink and outplay your opponent.\n\nBuild a custom deck of units ranging from cheap swarmers to devastating siege beasts. Deploy them onto the battlefield with your own hands, creating a tactile, hands on strategy experience that makes every match unique. Outsmart rivals, time your moves, and destroy the enemy\u2019s Command Tower before they destroy yours.\n\n# Core Features\n\n- **Deck Building Strategy** \u2014 craft unique armies and define your playstyle\n- **Fast Duels** \u2014 short, high intensity battles built for replayability\n- **Hands On Control** \u2014 summon and command units directly with your hands\n- **Unique Arenas** \u2014 Sci Fi maps with distinct layouts and challenges\n- **Solo and Multiplayer** \u2014 test your skills against AI or clash with real players online\n\n**Expansion blends the tactical depth of RTS with the thrill of Action Strategy, all set in a Sci Fi universe where victory is in your hands.**\n", "short_description": "Sci-Fi VR Action RTS \u2013 Singleplayer Campaign, Multiplayer with friends, Deck-Build, Hand-Deploy, Dominate the Cosmos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.expansion-vr.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Plazma Studio", "support_website_url": null, "website_url": "https://www.expansion-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "ADVENTURE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "ru", "es", "uk", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25730134379915155"}, "review_messages": []}]}
ame": "logo_new.png", "id": "825084610047425", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309561_825084616714091_2546572794948739306_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkQoSkN_92sQ7kNvwHaOPnh&_nc_oc=AdlNpkSlndb4AaUUJMKoRMMq7ayA0_G719IbVCUqdxr82a06Gfp1Z2xsZ4eBZ4rw9wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuzMnHHirgNrXT7WTTO7a-xiwjADJQrzoCiiTfldpI3tA&oe=699D9F82"}]}, "id": "1979033826052878", "locale": "en_US", "screenshots": [{"file_name": "Shot_20251204_084739_756.png", "id": "2512388552495173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_2512388555828506_6793122267483577934_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svO8JV_OwKAQ7kNvwG3b-7j&_nc_oc=AdknEFmmLRDuegP1Wof9UzPpYoQ5NJvM_JGM9mUsNTMVT_R_Gm7LOn9FqKeNAIcTeD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrbPUJt5t5cb8BCrf7T8ZhXG0sXR4MBbCPdd8Z8WV9nw&oe=699DA49E"}, {"file_name": "Shot_20251204_084905_336.png", "id": "1548145916391195", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1548145919724528_6635316111747011428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7ZnN7mqdX4Q7kNvwHa50LG&_nc_oc=Adl48Ku8Utgzpo7HPTM5j0QFdPHqpy-8xcnPCxSf7MVxch2tVikUa1i8xmxfjwe6Q3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuU4dXgwJqSwb0s895U7kNIfbGTNEw3Uyw-03a-ibJpvA&oe=699DA74B"}, {"file_name": "Shot_20251204_084523_886.png", "id": "25343415851956380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_25343415865289712_8010599026673476838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN0kB0I1jc4Q7kNvwF5J2dc&_nc_oc=Adn9cCu48aO-6oxerbGEiabY4R5hfSqR1ixcvmtznAC_A-VjEIzzxgmdFIDb9mQ2zW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afut7SSpLe36D3NcFlbrCXP-4pZz14G8A_EpRegob1y36A&oe=699D8BA3"}, {"file_name": "Shot_20251204_084406_889.png", "id": "1994232241397148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1994232244730481_3226969379327950226_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeVGTWYSleIQ7kNvwHXdPsW&_nc_oc=Adkz1no8946Gkfzs5ybEH4TnhUa0MbCHp1NFrShaemn9ajPdcItbhyib63C2qPgjZjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtQK5-U2_gRC6zCuUZr6e2qyv3yXJLByMwF_Za7pABQg&oe=699D87B5"}, {"file_name": "Shot_20251204_084657_540.png", "id": "1960840148108563", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_1960840151441896_83495383831585364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYvkAXk0KCcQ7kNvwGOYsb9&_nc_oc=AdmMABdZxPJTS9b2pvGuqTIZENmOqy9NwKr27Hj9kQhsCQxeFKM4Hd6eOFCnMhiYoIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmtpxOnCWA3uxWFYMkyNhbGdUX9ekp5u1oM6SuSlOJYw&oe=699DA1C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2389346541518064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_2389346544851397_4714244575077333914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4XFMYdSMRcQ7kNvwF8fiqY&_nc_oc=Adny1qIDNy-sL1nXUY2fQRuhaKGQZkAOPc2b9HovXNkD0DIDf0F8kZySwcSGd6Poz-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsid0cQY36Kib2WTFf-8KV9mgqkdzHcSBkMex9Jx--70Q&oe=699D95D8"}, "display_name": "Expansion RTS", "keywords": ["SciFi", "Multiplayer", "RTS", "ActionStrategy", "DeckBuilding"], "long_description": "# Expansion is a Sci Fi Action RTS where you build decks, deploy units with your hands, and crush opponents in fast Multiplayer duels.\n\nDefeat aliens invasion in Singleplayer Campaign!\n\nChallenge your friends in Multiplayer Battles!\n\nBuild your unique deck and be invincible in battles!\n\nIn **Expansion**, you don\u2019t just control the fight \u2014 you step into it. Matches are short, high stakes, and packed with tactical choices. Every duel is a chance to outthink and outplay your opponent.\n\nBuild a custom deck of units ranging from cheap swarmers to devastating siege beasts. Deploy them onto the battlefield with your own hands, creating a tactile, hands on strategy experience that makes every match unique. Outsmart rivals, time your moves, and destroy the enemy\u2019s Command Tower before they destroy yours.\n\n# Core Features\n\n- **Deck Building Strategy** \u2014 craft unique armies and define your playstyle\n- **Fast Duels** \u2014 short, high intensity battles built for replayability\n- **Hands On Control** \u2014 summon and command units directly with your hands\n- **Unique Arenas** \u2014 Sci Fi maps with distinct layouts and challenges\n- **Solo and Multiplayer** \u2014 test your skills against AI or clash with real players online\n\n**Expansion blends the tactical depth of RTS with the thrill of Action Strategy, all set in a Sci Fi universe where victory is in your hands.**\n", "short_description": "Sci-Fi VR Action RTS \u2013 Singleplayer Campaign, Multiplayer with friends, Deck-Build, Hand-Deploy, Dominate the Cosmos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.expansion-vr.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Plazma Studio", "support_website_url": null, "website_url": "https://www.expansion-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "ADVENTURE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "ru", "es", "uk", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25730134379915155"}, "review_messages": []}]}
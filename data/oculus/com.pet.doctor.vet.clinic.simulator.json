GjCQay&_nc_oc=Adq0ycVrCbNQohMHMy_xngv0Kjs-W-WclOZkz452dhEmrhxpFEcfT_OHPDTLdtY4Bh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCwuYfgFF_Zu7kJXKyH68zNtb0RRb_UyIlS3Eph_hqSg&oe=6AFC7ED1"}, {"file_name": "screen_2560x1440_2026-09-27_17-46-33.png", "id": "1706961040406858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_1706961047073524_1617405068434134068_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8AiYubAVcEQ7kNvwFjKa3V&_nc_oc=AdqES5bL4L7rOF-4epF7NopyPM9U0k4Ny9uSIsAaVQLasRi_qsNLBdB0t5EqMeViUoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzHnZfDLeSFjj34epZUxtR74QA1aX9MKl-pQg7WGFuag&oe=6AFC6DD5"}, {"file_name": "screen_2560x1440_2026-09-27_18-01-52.png", "id": "1462497622462285", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1462497625795618_508787092532224677_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCyrWJrBrEsQ7kNvwG6ItOC&_nc_oc=AdquM0pI-rEbQrR8OFx4Twv-0p7HSX6oF6qqlir4_hYZ3BbEH6b9MMouhsGbRf_-1Sk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6Z6ETFY0BU1hK7dK5KF1oXlo_3TqCtURzWPevPsh3Ag&oe=6AFC8FAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pet Doctor: Vet Clinic Simulator", "keywords": ["Doctor", "Clinic", "Care", "Simulator", "Hospital"], "long_description": "Step into your own veterinary clinic and become a real Pet Doctor in VR!\n\nTreat adorable animals, discover what is wrong with them, and help your patients get healthy again. Pet Doctor: Vet Clinic Simulator combines pet care, animal treatment, clinic management, and satisfying simulation gameplay in an interactive veterinary experience.\n\nExamine your patients and take care of different animal needs as you work through a variety of cases. Diagnose problems, choose the right treatment, use your medical equipment, and make your furry patients feel better.\n\n\ud83c\udfe5 RUN YOUR VET CLINIC\nBuild your career as an animal doctor and take care of your growing clinic.\n\n\ud83d\udc36 CARE FOR PETS\nLook after adorable animals and help them recover from different illnesses and conditions.\n\n\ud83e\ude7a EXAMINE & DIAGNOSE\nInspect your patients, identify their problems, and decide how they should be treated.\n\n\ud83d\udc89 TREAT & HEAL\nUse veterinary tools and treatments to care for sick and injured pets.\n\n\u2b50 GROW YOUR CLINIC\nProgress through cases, improve your clinic, and take on new challenges as your veterinary career grows.\n\nWhether you love pets, animal games, doctor simulators, or relaxing simulation experiences, Pet Doctor: Vet Clinic Simulator lets you experience the rewarding world of pet care from inside your own virtual clinic.\n\nBecome the animal doctor your patients need and help every pet leave your clinic happy and healthy!", "short_description": "Become a pet doctor and run your own vet clinic! Examine adorable animals, diagnose problems, perform treatments, care for sick pets, and grow your animal hospital in this fun VR pet care simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interact
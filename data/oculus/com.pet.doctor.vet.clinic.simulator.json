HDrk-n3lQgxeLMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS0pwLwFovDqOwQbmjue-UTdmyoGkrBNC21ZRzIRp-cA&oe=6AFC93EA"}, {"file_name": "SS1.png", "id": "1399095058998052", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673652249_1399095062331385_7639121786587926320_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWkkonW0ebMQ7kNvwH-cGyg&_nc_oc=Adpmwftrehexyac6yJ18PQu-c_6aIfK6oOBFw5184Tl-hsKeFMBcU5NVASASI73-550&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo_iRi3lf4Zh8m2sUHFCpi8c2mlbBVKwZDYhLE5aveZg&oe=6AFC90B8"}, {"file_name": "SS3.png", "id": "1414955364088916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673558985_1414955367422249_4471166406724042645_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpxxv9jlZLIQ7kNvwFIT9ay&_nc_oc=Ado0Fuc1TmYjnJM9dnIn_fkw9c3no-TMmdfkF_GEOHLNlAn-AUv_qHdH8DXEaxMTFwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSn8bpVtP5Gxd4ql4w6oVBeslwAABPAHm3WMk0_5Nzrg&oe=6AFC8048"}, {"file_name": "SS7.png", "id": "3336340593220440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/613094043_3336340596553773_3349493502724195237_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYj1njCCVAYQ7kNvwEIImvQ&_nc_oc=Adqwti_IqLI8G_rj4WcJJeteNprx6qg7Vweexu8QRbxvurvBKo9U53ojauroW6jmQe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHKqdY-zQiR_TwFbpKGRiRbIejeSmXUAykJXwK_UQSwg&oe=6AFC658D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pet Doctor: Vet Clinic Simulator", "keywords": ["Doctor", "Clinic", "Care", "Simulator", "Hospital"], "long_description": "Step into your own veterinary clinic and become a real Pet Doctor in VR!\n\nTreat adorable animals, discover what is wrong with them, and help your patients get healthy again. Pet Doctor: Vet Clinic Simulator combines pet care, animal treatment, clinic management, and satisfying simulation gameplay in an interactive veterinary experience.\n\nExamine your patients and take care of different animal needs as you work through a variety of cases. Diagnose problems, choose the right treatment, use your medical equipment, and make your furry patients feel better.\n\n\ud83c\udfe5 RUN YOUR VET CLINIC\nBuild your career as an animal doctor and take care of your growing clinic.\n\n\ud83d\udc36 CARE FOR PETS\nLook after adorable animals and help them recover from different illnesses and conditions.\n\n\ud83e\ude7a EXAMINE & DIAGNOSE\nInspect your patients, identify their problems, and decide how they should be treated.\n\n\ud83d\udc89 TREAT & HEAL\nUse veterinary tools and treatments to care for sick and injured pets.\n\n\u2b50 GROW YOUR CLINIC\nProgress through cases, improve your clinic, and take on new challenges as your veterinary career grows.\n\nWhether you love pets, animal games, doctor simulators, or relaxing simulation experiences, Pet Doctor: Vet Clinic Simulator lets you experience the rewarding world of pet care from inside your own virtual clinic.\n\nBecome the animal doctor your patients need and help every pet leave your clinic happy and healthy!", "short_description": "Become a pet doctor and run your own vet clinic! Examine adorable animals, diagnose problems, perform treatments, care for sick pets, and grow your animal hospital in this fun VR pet care simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
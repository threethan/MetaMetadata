065684_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68WLPftujxYQ7kNvwGkAtnK&_nc_oc=Adr6F5P1H5SbU-syTw7Fk5nY4t6XceBne0MuWTcY-Ic0-Cls55i5cWDZZ6wHFkNz5BI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSE6rV0QcRpe5GbifB4DTfEgDOnbR4Dfp3VDVuWSJKIA&oe=6B084D62"}, {"file_name": "StarGait_Screenshot_B.png", "id": "1935890210625135", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499626684_1935890213958468_7443898591645247758_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEoXJnjgHCwQ7kNvwGRXtJ9&_nc_oc=AdrXUb4g-Sw7uwb1gSqcfcRzAl7r-hP5V-u79nGr532IOo48jeMoxEyS1eHDvZ788xs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4HSCj3CbDsgu7kZn_WW4Lq0p5UR475flCOZkdnDD30g&oe=6B08750F"}, {"file_name": "StarGait_Screenshot_D.png", "id": "917075207763424", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619187_917075211096757_2719444156728251732_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l36_sFAl0WsQ7kNvwHndhJL&_nc_oc=AdrszJHGwP5IqMCF8ncAR4IhmPLJat92uBYTXTl1wcVSt1E-vq5k49yRcDzciqGkV24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhs4trmcDFaKBbBr5as_S8jPCxwZ3gAHMDNEA5DP6v-A&oe=6B086983"}, {"file_name": "StarGait_Screenshot_C.png", "id": "1274186298186966", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595112037_1274186301520299_6706991481999436030_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKJB0FtKBsQQ7kNvwFYnTnk&_nc_oc=Adqm2r5LH0CTS_YrS0DLPOKxddXSQUO22q3voBp6jpfsNfjh9QCjYjlUnJz1_ii57Ds&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw-A9V80dZ0E28GMkJ2cQYjoTvWbFpEjjHNGuNZoLkVQ&oe=6B08615F"}, {"file_name": "StarGait_Screenshot_A.png", "id": "1489952425899852", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619159_1489952429233185_6241787071916028705_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry5jjVJANk4Q7kNvwEVGCqU&_nc_oc=AdrczHHH-VJfkef99N6Bkdh1d-FHYrZiVoICa7o6paHP2KlUkBr1zuSVhuRASMjhfks&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwVuliyeBWFcqgnC343M5f0VJa1PtLJl_DVVJHkQ51-A&oe=6B086987"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StarGait", "keywords": ["Walking", "Gait", "Exercise", "Active", "Steps"], "long_description": "Transform your surroundings into an interactive space adventure with StarGait, an augmented reality experience that encourages walking, balance, coordination, and full-body movement.\n\nUsing passthrough augmented reality, StarGait overlays pathways, targets, and interactive challenges into your real environment, allowing you to move naturally while staying aware of your surroundings. Walk, turn, swing your arms, carry objects, shift your weight, and react to visual cues through a variety of engaging activities inspired by functional movement.\n\nExplore multiple experiences including:\n- Moon Walk: Follow guided pathways.\n- Stargaze Stroll: Add head turns while collecting targets.\n- Stellar Swing: Coordinate natural arm swings with walking.\n- Cosmic Balance: Carry and sort objects while staying balanced.\n- Astro Bop: Combine walking with cognitive challenges.\n- Ship Shift: Practice side-to-side weight shifting.\n- Spacescape: Freely explore, reach, turn, and interact with planets and space objects.\n\nCustomize your experience with adjustable walking distances, stride lengths, activity duration, and challenge levels to match your goals. Hand tracking and controller support make getting started quick and intuitive.\n\nStarGait supports wellness and rehabilitation by promoting engaging, active movement, but is not intended to diagnose, treat, cure, or prevent medical conditions.\n", "short_description": "Improve your walking, balance, and coordination through immersive augmented reality exercises. Step, turn, swing your arms, carry objects, and complete interactive challenges as your real environment transforms into an engaging space-themed training experience. Designed to encourage natural movement while making every session fun and rewarding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avrwell.com/privacy-policy-avrwell", "developer_terms_of_service_url": "https://avrwell.com/terms", "publisher_name": "AVRwell Inc.", "support_website_url": null, "website_url": "https://avrwell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25936229622673475"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620817_1502209637919716_3914995937470332164_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_yWsFJt-I8Q7kNvwHD9fLI&_nc_oc=AdotRx_31tslf47As4aHptJoE6bqsJLNJxraxRDFI8lGKN-MTcZP32ZxyPATv0lRdwU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD7CCPN4d0rwfaVFW0eX2xwWRJlX1juOTJmMSXEFhyow&oe=6B086645"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGait", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1795043880, "
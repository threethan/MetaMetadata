ePnkVPird_1ub_drhVjRUjv3f_wvuvnXvGtmwAg&oe=6B0B416A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SLOTCAR-STOREART-RENDER_16_9.png", "id": "1134364531368261", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982593_1134364534701594_8214499421405155810_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ9rgk2sSvUQ7kNvwEFI2c5&_nc_oc=AdrgBas8HaQZGxU-r-RuLOA2mqRVy88CzRFxeS3njA_IxGbVIYTa_FHRXI9K4L2_t64&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRK7vKZZt956uHhO9-zuWua0sIH36UZr5NzuR-pCjqEZQ&oe=6B0B28B3"}, "display_name": "Slot Car VR", "keywords": ["Racing", "Multiplayer", "Build", "driving", "track"], "long_description": "# Slot Car VR - Mixed Reality Racing\n\nSlot Car VR is a sandbox building and racing game, that allows you to transform your home into the ultimate racing track for you and others to enjoy. \n\nBringing back the nostalgia and joy of slot car racing in your home, but this time it's even better! \n\nWith limitless track and the ability to save, upload and race tracks with the community, your imagination is your only limitation!  \n\n\n# CREATE\nIntuitive track building tools allow you to create custom circuits with simple gestures. Full controller and hand tracking supported.\n{1612096492730650}\n\n# CUSTOMIZE\nWhether you are looking to recreate your favourite Formula One / NASCAR track, or craft something completely out of the ordinary; extensive libraries of props, special track pieces and structural items let you compliment any build with your desired look and feel.\n{1090530452623738}\n\n# COLLABORATE\nCo-located and global multiplayer. Play with others in your home, or race and build with friends at theirs.\n{599361962515393}\n\n# CHALLENGE\nWin medals on global tracks. Beat the author and other players times to top the global leaderboards.\n{1388380212145905}\n\nAvailable for Quest 3s, 3, 2 and Pro\n", "short_description": "CREATE | CUSTOMIZE | COLLABORATE | CHALLENGE\n\nCreate the ultimate racing track in your home with mixed reality. Build and race with friends or challenge online for medals, trophies and a spot on the global leaderboards.\n\nBringing back the nostalgia and joy of slot car racing in your home, but this time it's even better! "}]}, "developer_name": "Sandford Tech", "developer_privacy_policy_url": "https://sandfordtech.com/slot-car-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sandford Tech", "support_website_url": null, "website_url": "https://sandfordtech.com/slot-car-vr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8387594884696493"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75294245_1070116611262233_1316399408803723461_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6YkAZkJW0gQ7kNvwFwvRQ1&_nc_oc=AdqTR7FEuEv8BZbFb1x3LoOsS-vfBtgXZaWrc0oUTjyRU_sy-Z5YzWe8gdd-H6gcpLs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6TpscryBhy02jy93FWtpP_ZFHxQBPV0oyK0-whxwGsg&oe=6B0B430E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Slot Car VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326
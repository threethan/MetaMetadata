s://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828050_1155389763839321_5531636638416829488_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6uV-qcnDEgQ7kNvwGcnFEd&_nc_oc=Adr04IgI-17z-9DH174XxGuiiDJb_jSlnLpu93aByXljbCA4OXYtkwuN3lPSCVM-x-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwveXlmHppxpOJD8W-DrAWYEEnutqG4swn3aIrEDnjVQ&oe=6B0DB242"}, {"file_name": "month_2560x1440.png", "id": "1772639580692582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_1772639584025915_8435140402380639825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1bU9_UROTsQ7kNvwHmfugW&_nc_oc=AdopKFCrs6W0qh66W1N6ggXfDztLjncB7ESoKch6o0iEpS1aBQbSfPIB_T49pibPMTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgLtialQM9qZBOp6BY1IJetxkIV1OgNMkARJFapNwg1w&oe=6B0DA979"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calendar", "keywords": ["calendar", "schedule", "planner", "events"], "long_description": "Calendar is a clean, focused calendar app for Meta Quest, built on the Meta Spatial SDK. It keeps all of your Google Calendar events in one place and stays usable even when you're offline.\n\nMain features:\n  Syncs events and calendars with Google Calendar using secure OAuth 2.0 sign-in\n  Four views to match how you plan: Month, Week, Day, and Agenda\n  Create, edit, and delete events directly from the app\n  Search and filter your events, plus a quick-add action\n  Offline-first: events are cached on the device and available after the first sync\n  Recurring events with full RRule support\n  Reminders, multi-calendar color coding, and calendar filtering\n  Native dark Horizon UI with controller, hand-tracking, and keyboard support\n\nCalendar is a lightweight, privacy-conscious client for your own Google account. No ads, no clutter \u2014 just your schedule, wherever you are.", "short_description": "A clean, fast calendar for Meta Quest that syncs with Google Calendar. View your schedule in Month, Week, Day, or Agenda views \u2014 online or offline."}]}, "developer_name": "Savva", "developer_privacy_policy_url": "https://savvazaicev.github.io/calendar-legal/privacy.html", "developer_terms_of_service_url": "https://savvazaicev.github.io/calendar-legal/terms.html", "publisher_name": "Savva", "support_website_url": null, "website_url": "https://savvazaicev.github.io/calendar-legal/landing.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1490179244170459"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1586482229919245"}]}, "baseline_offer": {"id": "1586482229919245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794504600, "status": "PUBLISHED", "id": "1586482229919245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1511006115421105", "version": "1.0"}, "id": "1004614622680750", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1481607568360960", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "151100611542110
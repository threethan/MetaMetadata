e5Vbo0hLitTbMHYGW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5zqq5ZW4eMZXReJe9Zlog0NwtIjUc8yUcbeudobUvYQ&oe=6B05C942"}, {"file_name": "month_2560x1440.png", "id": "1772639580692582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1772639584025915_8435140402380639825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Bd76y2sZigQ7kNvwHyIKzj&_nc_oc=AdoQS3d4Se4VPzIV4MI3LzQU-6g9Ri1ARfDmoatUsCT72g8nMbYc06hvjLzGlU-6TLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlVf5H1IbAMuVOhaHQbbbK2G9wRC2RWwDehbgTXEQqQQ&oe=6B05C079"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calendar", "keywords": ["calendar", "schedule", "planner", "events"], "long_description": "Calendar is a clean, focused calendar app for Meta Quest, built on the Meta Spatial SDK. It keeps all of your Google Calendar events in one place and stays usable even when you're offline.\n\nMain features:\n  Syncs events and calendars with Google Calendar using secure OAuth 2.0 sign-in\n  Four views to match how you plan: Month, Week, Day, and Agenda\n  Create, edit, and delete events directly from the app\n  Search and filter your events, plus a quick-add action\n  Offline-first: events are cached on the device and available after the first sync\n  Recurring events with full RRule support\n  Reminders, multi-calendar color coding, and calendar filtering\n  Native dark Horizon UI with controller, hand-tracking, and keyboard support\n\nCalendar is a lightweight, privacy-conscious client for your own Google account. No ads, no clutter \u2014 just your schedule, wherever you are.", "short_description": "A clean, fast calendar for Meta Quest that syncs with Google Calendar. View your schedule in Month, Week, Day, or Agenda views \u2014 online or offline."}]}, "developer_name": "Savva", "developer_privacy_policy_url": "https://savvazaicev.github.io/calendar-legal/privacy.html", "developer_terms_of_serv
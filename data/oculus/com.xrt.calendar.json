en_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3eRF_2dg_gQ7kNvwF65akM&_nc_oc=AdoSKhIBW0jgMEnRB2SSM1hXuHyQlFgHoBr25iwAD3NIFZMRSUZcupgrH3pmuYkCwa0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOYF6_BmYQGnLRe31Tw5epya9Z5qUMDJ_jcr33jE5CXQ&oe=6B09BDC2"}, {"file_name": "month_2560x1440.png", "id": "1772639580692582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1772639584025915_8435140402380639825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFmE42gBZqcQ7kNvwHuImWM&_nc_oc=AdraA8cQTZok13bqZAEVkjlFgu-7O400sEHgTO4mdf9h_FLbIMdcTIpUZ2khijDVsD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLnvYpDjPEM1_3SzFvr-ZG0xzP3gkvaFMfPHyrY0b1jQ&oe=6B09B4F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calendar", "keywords": ["calendar", "schedule", "planner", "events"], "long_description": "Calendar is a clean, focused calendar app for Meta Quest, built on the Meta Spatial SDK. It keeps all of your Google Calendar events in one place and stays usable even when you're offline.\n\nMain features:\n  Syncs events and calendars with Google Calendar using secure OAuth 2.0 sign-in\n  Four views to match how you plan: Month, Week, Day, and Agenda\n  Create, edit, and delete events directly from the app\n  Search and filter your events, plus a quick-add action\n  Offline-first: events are cached on the device and available after the first sync\n  Recurring events with full RRule support\n  Reminders, multi-calendar color coding, and calendar filtering\n  Native dark Horizon UI with controller, hand-tracking, and keyboard support\n\nCalendar is a lightweight, privacy-conscious client for your own Google account. No ads, no clutter \u2014 just your schedule, wherever you are.", "short_description": "A clean, fast calendar for Meta Quest that syncs with Google Calendar. View your schedule in Month, Week, Day, or Agenda views \u2014 online or offline."}]}, "developer_name": "
0f&oh=00_AQQRf-kEVAsj1fSoGzkEcNi1HSsXLj59WZO3meZc53rAHQ&oe=6B05BFB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The State of Global Peace \u2013 Sundance Preview", "keywords": [], "long_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly. It highlights the evolving nature of armed conflict and violence and sheds light on major trends related to global peace and security today, including rising inequality, militarization, the loss of biodiversity, and the impact of climate change. This innovative VR experience is launched on the occasion of the UN\u2019s 75th anniversary and the Nelson Mandela Decade of Peace.\n", "short_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://futuringpeace.org/about.html", "developer_terms_of_service_url": null, "publisher_name": "UN DPPA Innovation Cell", "support_website_url": null, "website_url": "https://futuringpeace.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
972827790386", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569439_437972831123719_6498329696641147006_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LZiUAUXh-8Q7kNvwGOSmLP&_nc_oc=Adr5S5artMOpMTc7HUjvHNTxEEAJTYrh4FSwZ2gIvDagemaqJQ1NSz07MsjetjbsCmk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV2HJSQ6EwCC_hdcPWE8V1SkUrYSz4d_gpQ2Xpl0SIWA&oe=6A858393"}, {"file_name": "biodiversity-screenshot.png", "id": "3102758833294064", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974862_3102758836627397_4220601880517916685_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCPmC6N5j9QQ7kNvwFIyDSE&_nc_oc=AdoDr3allxpCtfOozOXtbK97DmIvrlT7UFpbXJ2AILOwQkAhhZiE-5Fe-yduEurwtVs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfrq-vvsLa6l-ayl44e4R34k_cNea6cskOHPXWf-UvVw&oe=6A85A5F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The State of Global Peace \u2013 Sundance Preview", "keywords": [], "long_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly. It highlights the evolving nature of armed conflict and violence and sheds light on major trends related to global peace and security today, including rising inequality, militarization, the loss of biodiversity, and the impact of climate change. This innovative VR experience is launched on the occasion of the UN\u2019s 75th anniversary and the Nelson Mandela Decade of Peace.\n", "short_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://futuringpeace.org/about.html", "developer_terms_of_service_url": nul
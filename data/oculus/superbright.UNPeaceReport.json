1_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhuwuGcVgeAQ7kNvwE59k2F&_nc_oc=Adnp_VejzoaA_kWSiKULX-srDjC-YumEfep73Dgg6CxMDCnXxyc73YjFES1m5h2KXio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFiaA_s3pl3BKrcFcKFYVXl5kOsYzr2C396MnuCFrVaw&oe=69A6EB99"}, {"file_name": "The State of Global Peace Still 3.png", "id": "1167851313743744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_1167851317077077_3768104753563780162_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPIWt5Kr-rEQ7kNvwHp71m4&_nc_oc=Adl_ieU1oXGpIOZJ1mKQ8wJHa94vXYE1HpGpWUppO8US6XuE3yxT-f9oGySbCSnYj4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpsxLCKhjWoM60BKKh4a4UQ-U985BUPmuacr83bJtu2Q&oe=69A6E33D"}, {"file_name": "The State of Global Peace Still 2 (1).png", "id": "437972827790386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569439_437972831123719_6498329696641147006_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05YReUgCVSQQ7kNvwELmWAx&_nc_oc=Adki3pDzt-vLBhMKetETEjU3zeEXhvceEv5K6DZi-RYMuJMjAjDlRu9LKuqTQBX753M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZ-hhZdgA7aqMjN7zUyzPsVT6-9fSF6rEAK5pJT73aiw&oe=69A6EE53"}, {"file_name": "biodiversity-screenshot.png", "id": "3102758833294064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974862_3102758836627397_4220601880517916685_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRJqRk6V3HoQ7kNvwHu0xc1&_nc_oc=AdndbuEXEmTEx6OwZB3FiGv3C0kmHw4i7P9fVmaNjRKGF1DWclaS4jAKf5fz3FfKZcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwbzgiVk0u0ngmHSSqLswp_N6fxPJX0btc5jMnh1ePTg&oe=69A6D870"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The State of Global Peace \u2013 Sundance Preview", "keywords": [], "long_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly. It highlights the evolving nature of armed conflict and violence and sheds light on major trends related to global peace and security today, including rising inequality, militarization, the loss of biodiversity, and the impact of climate change. This innovative VR experience is launched on the occasion of the UN\u2019s 75th anniversary and the Nelson Mandela Decade of Peace.\n", "short_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://futuringpeace.org/about.html", "developer_terms_of_service_url": null, "publisher_name": "UN DPPA Innovation Cell", "support_website_url": null, "website_url": "https://futuringpeace.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3260663334220175"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982652_499012391343477_1797058209060905543_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4Hu1nE4t4EQ7kNvwFHwqC-&_nc_oc=AdkfqfOESd6w_nGe0fw59Mzp4SFiYKXJXi6FFDlQPHafnJLDdhMbUeI93kpxcbvBEqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvml02QoPlgGeYaa0XB9bK66
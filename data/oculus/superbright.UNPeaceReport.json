dx51okTG4T84rhyS-Pziwd-BERKHmzMYw&oe=69F0C253"}, {"file_name": "biodiversity-screenshot.png", "id": "3102758833294064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974862_3102758836627397_4220601880517916685_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ju51qpvic4Q7kNvwETecOC&_nc_oc=AdrUvFEJBhrYN_RVfCe36WkeuiQZcQB6W-BlpOIugcqLe6d82tRhyg-45j9Ly9bOKLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1_Kqeeol-xsRaEtQWwYDyCqM8LcJ6Smhw1bSCYNMKC2g&oe=69F0AC70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The State of Global Peace \u2013 Sundance Preview", "keywords": [], "long_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly. It highlights the evolving nature of armed conflict and violence and sheds light on major trends related to global peace and security today, including rising inequality, militarization, the loss of biodiversity, and the impact of climate change. This innovative VR experience is launched on the occasion of the UN\u2019s 75th anniversary and the Nelson Mandela Decade of Peace.\n", "short_description": "This Virtual Reality (VR) experience tells the story about the global state of peace. It is the first-ever immersive experience based on an official report from the United Nations Secretary-General to the General Assembly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://futuringpeace.org/about.html", "developer_terms_of_service_url": null, "publisher_name": "UN DPPA Innovation Cell", "support_website_url": null, "website_url": "https://futuringpeace.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT
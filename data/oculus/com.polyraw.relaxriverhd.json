3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnb2OEexnPPzfml43_wp_oIhumfxC6kMOfP-niADb4Qg&oe=6AA40AB6"}, {"file_name": "1_11162687_1028054513963585_909227512658132992_n.png", "id": "3662056260731290", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75297582_3662056267397956_2579039700190647306_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfEBejndqiAQ7kNvwGRtmG3&_nc_oc=AdrDv3t_X3maBxUhiYzoutpWGmhaHQsLQ1Y1PIHR0NuT2-lIixrpxwOZtY_6SkD4K4k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM4eBFAiFBVnR5R4juEneq_ADoL2MHT8c1CQAAtedjwQ&oe=6AA419FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vd_cover38974740_2141300009271001_7119921621934014464_n.png", "id": "375114225253145", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001670_375114228586478_5172498033965709284_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd9n4gId2igQ7kNvwExb96h&_nc_oc=AdqY7qZutEj41L9yExOVYrEe70KpRY1uweQIacvpYr3fwzyQwGxpcR9IfCjwMPVjuBo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXU8Fgna1PO9qYfDbhXQA5RbDhiJCjumVK4eNVsSv3bw&oe=6AA41571"}, "display_name": "Relax River HD", "keywords": ["relax", "river", "boat", "journey", "tour"], "long_description": "Relax and immerse yourself in a virtual reality tour, as you ride a boat along a stunning river, surrounded by lush nature and majestic mountain vistas while discovering incredible creatures. This tour is fully automated, requiring no settings or configurations; simply sit back and enjoy the journey.\n\nA small rowboat gently glides across a tranquil river, meandering through a serene path surrounded by majestic mountains and lush forests. The rhythmic strokes of the oars create a soothing harmony, while the stillness of the water mirrors the tranquility of the surroundings. Nature's symphony of chirping birds and rustling leaves accompanies this idyllic journey, where the world slows down, and peace reigns.", "short_description": "Relax yourself in a virtual reality tour across a gentle mountain river."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6846493315474494"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982686_246833101801987_5288055462494709086_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uO1FJMB0GAQ7kNvwEAgnad&_nc_oc=AdouGM27RU0nlomJ0wPo1ACs3khD4o-a1MNAZGbwqIudCZvykrdVdPjUbXHT8lFKTNE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe14N2ka6kdppoacgrjD-bCK8l5hGt3XWWXpnoP-qPYQ&oe=6AA3FC8B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Relax River HD", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1709931180, "lastRevision": {"nodes": [{"id": "5537939706329868", "release_type": "SCHEDULED", "administration_status": "APPROVED"
3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI78tlv4yv0ANLVUQ9O67DTyG6YjXExivtuDb3xqHOcjA&oe=6AAE96B6"}, {"file_name": "1_11162687_1028054513963585_909227512658132992_n.png", "id": "3662056260731290", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75297582_3662056267397956_2579039700190647306_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmCHjWVWv1AQ7kNvwGyaHon&_nc_oc=AdpnPSDxVXm2jd_rLZZ-w9EL-LwBHf_IelY14kTUFmM-oBu2X_U7EHBPM00qbNJy410&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQE3nZ_tP8hiPLX9SuHdRnrkQZhdkW6LhyqTVLwWIjog&oe=6AAEA5FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vd_cover38974740_2141300009271001_7119921621934014464_n.png", "id": "375114225253145", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001670_375114228586478_5172498033965709284_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nmIZGETf9UQ7kNvwFE4Hw_&_nc_oc=AdoS9GCnwOEfzznfeM86NG3JQGxghvd5Y85gsPWwz9VIeeLadwPmcLN-DVO8VIJlLLo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInojWTqxUTvtFuYtF34U2Abq7XEvJ6OrdOJMExiTNMaw&oe=6AAEA171"}, "display_name": "Relax River HD", "keywords": ["relax", "river", "boat", "journey", "tour"], "long_description": "Relax and immerse yourself in a virtual reality tour, as you ride a boat along a stunning river, surrounded by lush nature and majestic mountain vistas while discovering incredible creatures. This tour is fully automated, requiring no settings or configurations; simply sit back and enjoy the journey.\n\nA small rowboat gently glides across a tranquil river, meandering through a serene path surrounded by majestic mountains and lush forests. The rhythmic strokes of the oars create a soothing harmony, while the stillness of the water mirrors the tranquility of the surroundings. Nature's symphony of chirping birds and rustling leaves accompanies this idyllic journey, where the world slows down, and peace reigns.", "short_description": "Relax yourself in a virtual reality tour across a gentle mountain river."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6846493315474494"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982686_246833101801987_5288055462494709086_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca9X0LmdofcQ7kNvwHvGY6Y&_nc_oc=AdqM_eOIzlC_Z3Btuzsj5IxkS2oQiYYb1MTt-3JVWytPTXivIBVR1yF7GFhsDW1ZCmk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQyoA6MwKe4uT37avrfXFKNlBOQy6zIovhsP0YUz3p4g&oe=6AAE888B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Relax River HD", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1709931180, "lastRevision": {"nodes": [{"id": "5537939706329868", "release_type": "SCHEDULED", "administration_status": "APPROVED"
-3.oculuscdn.com/v/t64.5771-25/75297582_3662056267397956_2579039700190647306_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWw0zZdl9TAQ7kNvwHC7Cuu&_nc_oc=Adq4pLfrg2PuSnnCGAJJxhoAuSIHgZ8R_fdhjTRiJRBTqZ-fHzYz8w6ulIYKB-ARB2s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af822Ke1Q2znsN4zY7PZRy1qZnY6l_NH6jcub5KN_L7GEg&oe=6A3D44FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vd_cover38974740_2141300009271001_7119921621934014464_n.png", "id": "375114225253145", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001670_375114228586478_5172498033965709284_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6QRpVjKkzQQ7kNvwHQ7-oM&_nc_oc=AdqF-m2B3fgDVY9EEYFXCxEjFrhTan-D-RB70yi8bUr9HT0cT7fJ9sLg68P_tuFk_YQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m08kP76JvcPTcFc4MApSf8ZrPazNuzj3EpvKPCpG1lA&oe=6A3D4071"}, "display_name": "Relax River HD", "keywords": [], "long_description": "Relax and immerse yourself in a virtual reality tour, as you ride a boat along a stunning river, surrounded by lush nature and majestic mountain vistas while discovering incredible creatures. This tour is fully automated, requiring no settings or configurations; simply sit back and enjoy the journey.\n\nA small rowboat gently glides across a tranquil river, meandering through a serene path surrounded by majestic mountains and lush forests. The rhythmic strokes of the oars create a soothing harmony, while the stillness of the water mirrors the tranquility of the surroundings. Nature's symphony of chirping birds and rustling leaves accompanies this idyllic journey, where the world slows down, and peace reigns.", "short_description": "Relax yourself in a virtual reality tour across a gentle mountain river"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "w
-1.oculuscdn.com/v/t64.5771-25/75297582_3662056267397956_2579039700190647306_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CIVFDM1P9wQ7kNvwHuqup_&_nc_oc=Ado-RhJOG8R1-wvkBHxh90uhf1dT2JEXQo8CDMB7YFDl418nA8L-mZ5jP02CBfaErec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWQOxkaQDLiMDrezuLJb9yduU6kvVTClLs9V0jt0OdOQ&oe=6AEDEDFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vd_cover38974740_2141300009271001_7119921621934014464_n.png", "id": "375114225253145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_375114228586478_5172498033965709284_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAQGspv9toAQ7kNvwHAKRrF&_nc_oc=AdrZ_UpmCfwegScbnNLSIyEnHWUH2IaN_USdDQNFWJlRiykYuBiZiZcNJTXwzudDiLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRqT3DtE4ZhdT73OPBq3kYhsQogR_np2E5-AgAc_CshA&oe=6AEDE971"}, "display_name": "Relax River HD", "keywords": [], "long_description": "Relax and immerse yourself in a virtual reality tour, as you ride a boat along a stunning river, surrounded by lush nature and majestic mountain vistas while discovering incredible creatures. This tour is fully automated, requiring no settings or configurations; simply sit back and enjoy the journey.\n\nA small rowboat gently glides across a tranquil river, meandering through a serene path surrounded by majestic mountains and lush forests. The rhythmic strokes of the oars create a soothing harmony, while the stillness of the water mirrors the tranquility of the surroundings. Nature's symphony of chirping birds and rustling leaves accompanies this idyllic journey, where the world slows down, and peace reigns.", "short_description": "Relax yourself in a virtual reality tour across a gentle mountain river"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "w
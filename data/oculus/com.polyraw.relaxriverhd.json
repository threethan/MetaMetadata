-2.oculuscdn.com/v/t64.5771-25/75297582_3662056267397956_2579039700190647306_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQToX9plbXsQ7kNvwGETewa&_nc_oc=AdqaZCc1VROQZVz-OpGxUzK5Uzsuf9nBNPctRQ9ezfAtkdn_9_RkaK_9lqAkzOvrDJo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Mhu3_s8piUESGxo7sHksPBPgyhHI4bsnY-gHiI14nwg&oe=69F370FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vd_cover38974740_2141300009271001_7119921621934014464_n.png", "id": "375114225253145", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001670_375114228586478_5172498033965709284_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf3wvHY2nQIQ7kNvwHGmm3p&_nc_oc=AdoTGf9Vqm_x4Iq2gWFzrLAK0ZeyM19dse6tWGm1cjpaiVfiyBSGUi8_PBqaBfYCsG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cyF3BvTwBCogReSJ4XplIoBUpYs2FFXr-huTvWSNeuQ&oe=69F36C71"}, "display_name": "Relax River HD", "keywords": [], "long_description": "Relax and immerse yourself in a virtual reality tour, as you ride a boat along a stunning river, surrounded by lush nature and majestic mountain vistas while discovering incredible creatures. This tour is fully automated, requiring no settings or configurations; simply sit back and enjoy the journey.\n\nA small rowboat gently glides across a tranquil river, meandering through a serene path surrounded by majestic mountains and lush forests. The rhythmic strokes of the oars create a soothing harmony, while the stillness of the water mirrors the tranquility of the surroundings. Nature's symphony of chirping birds and rustling leaves accompanies this idyllic journey, where the world slows down, and peace reigns.", "short_description": "Relax yourself in a virtual reality tour across a gentle mountain river"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "w
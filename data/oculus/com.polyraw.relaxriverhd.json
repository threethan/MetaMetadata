-3.oculuscdn.com/v/t64.5771-25/75297582_3662056267397956_2579039700190647306_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dESwJoGp-VkQ7kNvwE3EV3Q&_nc_oc=Adq_xItFzVYaP8MMOWvhwCobGPoHzGWEA4XyuMnB8xA-aPrPgDx-WZzs9cbpGY0oIcw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5vVKfX3cV-T-DwWsiVUECc20HNPTO0yA-1wBUi8b2UQ&oe=6AE8A7FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vd_cover38974740_2141300009271001_7119921621934014464_n.png", "id": "375114225253145", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001670_375114228586478_5172498033965709284_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrBugOiYURkQ7kNvwFmTDdT&_nc_oc=Adr4GqTAgOvD7khDcuIxtaIQsR6Qp5DuAAUUvabBn7jqktDL6mAjgKHnhPvLKlHNWW0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ88lUoV_lM6vOvOrzcsd94q3jaD4XuMiO-uw54cElD7A&oe=6AE8A371"}, "display_name": "Relax River HD", "keywords": [], "long_description": "Relax and immerse yourself in a virtual reality tour, as you ride a boat along a stunning river, surrounded by lush nature and majestic mountain vistas while discovering incredible creatures. This tour is fully automated, requiring no settings or configurations; simply sit back and enjoy the journey.\n\nA small rowboat gently glides across a tranquil river, meandering through a serene path surrounded by majestic mountains and lush forests. The rhythmic strokes of the oars create a soothing harmony, while the stillness of the water mirrors the tranquility of the surroundings. Nature's symphony of chirping birds and rustling leaves accompanies this idyllic journey, where the world slows down, and peace reigns.", "short_description": "Relax yourself in a virtual reality tour across a gentle mountain river"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "w
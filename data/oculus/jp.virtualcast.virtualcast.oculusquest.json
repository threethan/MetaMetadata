1579.png", "id": "2586911461548504", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221322_2586911464881837_2317906083128182834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2Bz4_SLzowQ7kNvwHws80Q&_nc_oc=Ado0Xc1he9vKNnhTsc1Ld_uCNiyKFIY-gzPcwriMnv57elO4zBJ8XZA4olsa9C7ljs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIUKUbgzON_Tab4XzLdrVfEjLCd_2lbE6vGUDMbDkiQA&oe=6A4A8105"}, {"file_name": "38982537_255477708871293_4195561811237404672_n.png", "id": "585809932345254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035416_585809935678587_5678494201805036808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Vk0Wj_GfMQ7kNvwF4FsJr&_nc_oc=AdpB8x-SN_BjkSOFPNmFesZr5P724ZMS7KuV53H5ai268zsZdBdhck7JtuEPX5kyyHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXiBxswQhbN3xhja8odxE3CgYHgZ1YIs0ABjXcS9uudg&oe=6A4A73EF"}, {"file_name": "2020061219482161-1-1.png", "id": "1003769506761327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982587_1003769510094660_9085268676187145652_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsgIbcMo2DwQ7kNvwE3tByz&_nc_oc=AdqKdjaXylMahsSfCkBthuuwcgYPiwMNbc5yNVzWqiYHAzVZ6N1aB-aoLaNAMlG0g4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT6EBXgvVq-eoVgOojFoyDKdJ-JnYyPQ7Yr2rbNJCEWw&oe=6A4A7B32"}, {"file_name": "2020061220160677.png", "id": "299889117723589", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_299889121056922_4441237668315007385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e57IYMxR1ZgQ7kNvwGtyCtI&_nc_oc=AdoUe_5tpLhkNUqW_ne9RLYsFGEX7y5Oap5Pj-dJUiSpAXG1ce1BafVlHiJxphszS7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2WJ35q71iK0DmjcCBn38N-_iuASE1Q2kQA8crjj5FOQ&oe=6A4A6A7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 (54).png", "id": "367457634640007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974510_367457637973340_449215919765970591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YB-x8No0GnsQ7kNvwFAnMGs&_nc_oc=AdrTND_JDd4Yz-Thzn9MsSznWgGFjCmu2ww7wX2KFym1DNflDCbLMsMMUHcjWcA4CnE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa-O3UBwkMqKTW8FTZGFcPmN2rL5qJrOwOOPOdWc_Eyg&oe=6A4A6B60"}, "display_name": "VirtualCast", "keywords": ["VRChat", "VTuber", "Metaverse", "Avatar", "Anime"], "long_description": "VirtualCast is a VR live communication service that enables you to be a virtual character and communicate with others in a VR studio.\n\nYou can spawn various items, have fun, switch between spaces and gather with your friends. \nYou can take photos and share them.\n\nYou can literally get in touch with each other.\nFind your new self in a new world. Experience the next generation of VR live communication.\n\n\nWhat's possible in the world of VirtualCast?\n\nGather from around the world in a single virtual space and communicate with each other as virtual characters.\nVarious items are available to help you break the ice, socialize and enjoy.\n\nYou can have fun selfie-ing all by yourself or join one of the official studios to meet and communicate with new people.\nOfficial Studios are changed periodically: some studios have games while others have shows going on.\n\nChange your avatar and experience a fresh new life!", "short_description": "VirtualCast is a VR live communication service that enables you to be a virtual character and communicate with others in a VR studio. \n\nYou can spawn various items, have fun, switch between spaces and gather with your friends.\nYou can take photos and share them.\n\nYou can get in touch with each other and play games.\nFind your new self in a new world. Experience the next generation of VR live communication."}, {"images": {"nodes": []}, "id": "574756676746999", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VirtualCast", "keywords": ["VRChat", "VTuber", "Metaverse", "Avatar", "Anime"], "long_description": "\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30b9\u30c8\u306f\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u306a\u3063\u3066VR\u7a7a\u9593\u306e\u30b9\u30bf\u30b8\u30aa\u3067\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306b\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3067\u304d\u308bVR\u30e9\u30a4\u30d6\u30fb\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u30b5\u30fc\u30d3\u30b9\u3067\u3059\u3002\n\n\u3055\u307e\u3056\u307e\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u7a7a\u9593\u306b\u547c\u3073\u51fa\u3057\u3001\u697d\u3057\u307f\u3001\u7a7a\u9593\u3092\u5207\u66ff\u3048\u3001\u305d\u3057\u3066\u96c6\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30a2\u30a4\u30c6\u30e0\u3068\u3057\u3066\u30ab\u30e1\u30e9\u3092\u53d6\u308a\u51fa\u305b\u3070\u30b9\u30bf\u30b8\u30aa\u3067\u5199\u771f\u3092\u64ae\u308a\u3001\u30b7\u30a7\u30a2\u3059\u308b\u3053\u3068\u3082\u53ef\u80fd\u3067\u3059\u3002\n\nVR\u7a7a\u9593\u3067\u53cb\u4eba\u3068\u3075\u308c\u3042\u3044\u3001\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3080\u3002\u8a9e\u3089\u3044\u3001\u4e00\u7dd2\u306b\u5199\u771f\u3092\u64ae\u308a\u3001\u30b7\u30a7\u30a2\u3059\u308b\u3002\n\u3044\u3064\u3082\u3068\u9055\u3046\u81ea\u5206\u306b\u306a\u3063\u3066\u3001\u3044\u3064\u3082\u3068\u9055\u3046\u7a7a\u9593\u3067\u3002\u65b0\u4e16\u4ee3\u306eVR\u30e9\u30a4\u30d6\u30fb\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\u3002\n\n\n\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30b9\u30c8\u306e\u4e16\u754c\u3067\u3067\u304d\u308b\u3053\u3068\u3002\n\n\u4e16\u754c\u4e2d\u3069\u3053\u304b\u3089\u3067\u3082\u540c\u3058VR\u7a7a\u9593\u306b\u96c6\u307e\u308a\u3001\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u306a\u3063\u3066\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30b3\u3
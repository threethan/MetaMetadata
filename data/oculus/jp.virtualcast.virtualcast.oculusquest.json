1579.png", "id": "2586911461548504", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75221322_2586911464881837_2317906083128182834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOSsfyL_H_QQ7kNvwFkHfML&_nc_oc=AdpYA4vM0_mS3kBWSmL2AGlU8C82UbRynRIxx4vDr-vguYD5mbNynAGboBec3g8Y_TE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFHeHWJALIJ6d9xyM9F9PY7gx3_KYhsZdHFwxCpPuKHQ&oe=6AA14BC5"}, {"file_name": "38982537_255477708871293_4195561811237404672_n.png", "id": "585809932345254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035416_585809935678587_5678494201805036808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywz0b0wG1HQQ7kNvwGrrEVj&_nc_oc=AdpxyJscdv3854Xnjzy82jmZia1tbBsQaIzggH3kt1obpiVmBmg4czC5iuGfVNeNg8g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2bq9Dl8UheJ83ABzqMw2z3zmOHd262PrCRp17jwOsTw&oe=6AA176EF"}, {"file_name": "2020061219482161-1-1.png", "id": "1003769506761327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982587_1003769510094660_9085268676187145652_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpE4AErs1PQQ7kNvwHeX3zL&_nc_oc=AdqcEve89rE73HRlLuTJGh55IyWhV06bEy4RZj2bxh_PXS1pnS-bdHZ5tA1JI8q1PwI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjQCy7VaM2olxg3-v1LSBu-KRFqdnHYIT4ovbHnaNFKA&oe=6AA17E32"}, {"file_name": "2020061220160677.png", "id": "299889117723589", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974758_299889121056922_4441237668315007385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smtLFsJdS2gQ7kNvwGmNy-l&_nc_oc=AdoJYkTF3jzeTOcqFYFI_CsI5fUcGkGPbOllznDEZs5M40_oW2lxbsZOJ9alyE5nmbo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5EjygBTRDK3NlvtvdhVDeyGVuaBk0qpo4Eok26YIOuw&oe=6AA16D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 (54).png", "id": "367457634640007", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974510_367457637973340_449215919765970591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFGU2cNhqEkQ7kNvwEkqVge&_nc_oc=AdqJzoUvie23s2fpQ2fWcuuwmmDwLB7Fp6jC693g23AAJjjstgfjtmLTyfjTA8nMJoM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSU9pYpktNtp_OnPayWktPc3VrflKRC22EjbGQjsfUhA&oe=6AA16E60"}, "display_name": "VirtualCast", "keywords": ["VRChat", "VTuber", "Metaverse", "Avatar", "Anime"], "long_description": "VirtualCast is a VR live communication service that enables you to be a virtual character and communicate with others in a VR studio.\n\nYou can spawn various items, have fun, switch between spaces and gather with your friends. \nYou can take photos and share them.\n\nYou can literally get in touch with each other.\nFind your new self in a new world. Experience the next generation of VR live communication.\n\n\nWhat's possible in the world of VirtualCast?\n\nGather from around the world in a single virtual space and communicate with each other as virtual characters.\nVarious items are available to help you break the ice, socialize and enjoy.\n\nYou can have fun selfie-ing all by yourself or join one of the official studios to meet and communicate with new people.\nOfficial Studios are changed periodically: some studios have games while others have shows going on.\n\nChange your avatar and experience a fresh new life!", "short_description": "VirtualCast is a VR live communication service that enables you to be a virtual character and communicate with others in a VR studio. \n\nYou can spawn various items, have fun, switch between spaces and gather with your friends.\nYou can take photos and share them.\n\nYou can get in touch with each other and play games.\nFind your new self in a new world. Experience the next generation of VR live communication."}, {"images": {"nodes": []}, "id": "574756676746999", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VirtualCast", "keywords": ["VRChat", "VTuber", "Metaverse", "Avatar", "Anime"], "long_description": "\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30b9\u30c8\u306f\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u306a\u3063\u3066VR\u7a7a\u9593\u306e\u30b9\u30bf\u30b8\u30aa\u3067\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306b\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3067\u304d\u308bVR\u30e9\u30a4\u30d6\u30fb\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u30b5\u30fc\u30d3\u30b9\u3067\u3059\u3002\n\n\u3055\u307e\u3056\u307e\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u7a7a\u9593\u306b\u547c\u3073\u51fa\u3057\u3001\u697d\u3057\u307f\u3001\u7a7a\u9593\u3092\u5207\u66ff\u3048\u3001\u305d\u3057\u3066\u96c6\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30a2\u30a4\u30c6\u30e0\u3068\u3057\u3066\u30ab\u30e1\u30e9\u3092\u53d6\u308a\u51fa\u305b\u3070\u30b9\u30bf\u30b8\u30aa\u3067\u5199\u771f\u3092\u64ae\u308a\u3001\u30b7\u30a7\u30a2\u3059\u308b\u3053\u3068\u3082\u53ef\u80fd\u3067\u3059\u3002\n\nVR\u7a7a\u9593\u3067\u53cb\u4eba\u3068\u3075\u308c\u3042\u3044\u3001\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3080\u3002\u8a9e\u3089\u3044\u3001\u4e00\u7dd2\u306b\u5199\u771f\u3092\u64ae\u308a\u3001\u30b7\u30a7\u30a2\u3059\u308b\u3002\n\u3044\u3064\u3082\u3068\u9055\u3046\u81ea\u5206\u306b\u306a\u3063\u3066\u3001\u3044\u3064\u3082\u3068\u9055\u3046\u7a7a\u9593\u3067\u3002\u65b0\u4e16\u4ee3\u306eVR\u30e9\u30a4\u30d6\u30fb\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\u3002\n\n\n\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30b9\u30c8\u306e\u4e16\u754c\u3067\u3067\u304d\u308b\u3053\u3068\u3002\n\n\u4e16\u754c\u4e2d\u3069\u3053\u304b\u3089\u3067\u3082\u540c\u3058VR\u7a7a\u9593\u306b\u96c6\u307e\u308a\u3001\u30d0\u30fc\u30c1\u30e3\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u306a\u3063\u3066\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30b3\u3
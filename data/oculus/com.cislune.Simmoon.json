&_nc_oc=Adm-u2fikBAY5-Lz1AJCd2OcaaNcowLlfRBHL4mS9DP6mQJbPK7ehuKKvarnk-QiFPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvuTeaPB7qRciZ1E-sQ0A2A9cRJlx6y3YE42pLvVGtheA&oe=699EDE85"}, {"file_name": "simmoon-meta-moonview.png", "id": "1739235400277867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1739235403611200_7868188044197899477_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgX_QlWhxXAQ7kNvwEH8151&_nc_oc=AdkmuCqXimAqMVluBSNy2eNQ2GDiFPxA8DUJz5eYj9D8wYruZrJzoJvmEeMz7q2XDZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftOE4uWFTYIrQCWGfykRTepDazuanhhlFoFEI1wjva9wg&oe=699EEE00"}, {"file_name": "simmoon-meta-roverview.png", "id": "1804829626982265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393841_1804829630315598_2601101010256390470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lBloigDw7MQ7kNvwE4I6J2&_nc_oc=AdndOe3bw9TlTxRwB3uIBHujM5hgZqya_hJVbQPUtFUQbgzTD7CVbbYohdK8joxLB54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs_3UtUvVHm6vv761hbI30jhTS51B_vSHALIi1j9DnGhA&oe=699EF26A"}, {"file_name": "simmoon-meta-baseview.png", "id": "530557563390877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391982_530557566724210_9158394380391055027_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdgASryxnWUQ7kNvwEHdOXN&_nc_oc=Adkpe-3AiG0qKF-jvxoLFxep36gVAM4OLF6f0A45-60wQJ87IxkNkqsKVHEBXKc30Og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvifwDegBxvBvTX2jhzTiSiiDaIC0Cxb9Q2qNE3fJffuA&oe=699EFED8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimMoon", "keywords": [], "long_description": "Explore the Moon Like Never Before with SimMoon!\n\nEmbark on an extraordinary journey to the lunar South Pole with SimMoon, the ultimate immersive lunar exploration experience. Step into the boots of an astronaut and traverse the moon's enigmatic surface in stunning photo-realistic quality.\n\nKey Features:\n\nImmersive Lunar Environment: Experience the breathtaking landscapes of the Moon's South Pole, rendered in astonishing detail.\nApollo Rover Adventure: Take control of a meticulously recreated Apollo lunar rover and drive across the moon's challenging terrain.\nRealistic Physics: Feel the unique 1/6th gravity of the Moon and discover what it's like to walk and drive in this new frontier.\nDynamic Day/Night Cycle: Witness the sun's movement across the lunar sky, accurately simulated for an authentic experience.\nEducational and Fun: Learn about the lunar environment and space exploration in an interactive", "short_description": "Dive into the lunar adventure with SimMoon! Explore the South Pole of the Moon, drive the Apollo Rover, and experience the realism of space like never before."}]}, "developer_name": "Cislune Inc.", "developer_privacy_policy_url": "https://cislune.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cislune Inc.", "support_website_url": null, "website_url": "http://www.cislune.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9071191376342625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_630710083080886_2576534819683677669_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtjDpk0UXnQQ7kNvwGHxWf0&_nc_oc=AdkrtDD9o-1ALayYf
&_nc_oc=Adn4I5Y45-KP3qBauJL9yJmPDAvg0aYmAgzWpJGLhPP_A-M0L0K2G8aDaymodsveVVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhJo9GFiyVsvRKwHHZrTk7Qp_-A4pKosjV_Bbg8qen_g&oe=69A03005"}, {"file_name": "simmoon-meta-moonview.png", "id": "1739235400277867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1739235403611200_7868188044197899477_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt4o9a7cbakQ7kNvwEgGcfa&_nc_oc=AdmebhUU99r2M8zxEcm1aJA32UhEj-_lyyf4NtrN9vGSEY1CClcWRfi8ErpAnKb56Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-v84IgNbQhzPBXHJNxPmpEMWAXmwuOqU_JNIv_aBb9w&oe=69A03F80"}, {"file_name": "simmoon-meta-roverview.png", "id": "1804829626982265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393841_1804829630315598_2601101010256390470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lBloigDw7MQ7kNvwEVYxza&_nc_oc=Adk2kW69pJoZ7_eqmun7AOEJ5-6aYfjEa-9GOKuIUPDoDILagit71ZTH5t6qI8A2VzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvpx3ALR_Eh-qaqiJccjPZXhw8vq02q7iMRCFfg9W4JBA&oe=69A043EA"}, {"file_name": "simmoon-meta-baseview.png", "id": "530557563390877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391982_530557566724210_9158394380391055027_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdgASryxnWUQ7kNvwHVB3Hx&_nc_oc=Adki0wBYQ3Xkm4bSXbLbQ7pLRLZO7Wydhmp0M_vxAvvtZV3SRhoXPZZvbcuUVx3AzvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvIWVEw4Rb8QG9Pb_SjMKhOOSLcj8bfZFeh8xiRmb9WRw&oe=69A05058"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimMoon", "keywords": [], "long_description": "Explore the Moon Like Never Before with SimMoon!\n\nEmbark on an extraordinary journey to the lunar South Pole with SimMoon, the ultimate immersive lunar exploration experience. Step into the boots of an astronaut and traverse the moon's enigmatic surface in stunning photo-realistic quality.\n\nKey Features:\n\nImmersive Lunar Environment: Experience the breathtaking landscapes of the Moon's South Pole, rendered in astonishing detail.\nApollo Rover Adventure: Take control of a meticulously recreated Apollo lunar rover and drive across the moon's challenging terrain.\nRealistic Physics: Feel the unique 1/6th gravity of the Moon and discover what it's like to walk and drive in this new frontier.\nDynamic Day/Night Cycle: Witness the sun's movement across the lunar sky, accurately simulated for an authentic experience.\nEducational and Fun: Learn about the lunar environment and space exploration in an interactive", "short_description": "Dive into the lunar adventure with SimMoon! Explore the South Pole of the Moon, drive the Apollo Rover, and experience the realism of space like never before."}]}, "developer_name": "Cislune Inc.", "developer_privacy_policy_url": "https://cislune.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cislune Inc.", "support_website_url": null, "website_url": "http://www.cislune.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9071191376342625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_630710083080886_2576534819683677669_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq_bh6LcWp4Q7kNvwFL1YiP&_nc_oc=AdkIpZ-D-Sz3766tC
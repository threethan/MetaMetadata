&_nc_oc=Adq7z42DIJJcsQIVIUqzv2ufvBnDJccJ9TEcFKMsRvrgTqC6rGGQHax_qZWYqPUUF2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af110qHVH4lzUCWlGZK4t1rMXvm2Z_F-zhKaEGjJlkvfhw&oe=69F09B85"}, {"file_name": "simmoon-meta-moonview.png", "id": "1739235400277867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391911_1739235403611200_7868188044197899477_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLUatP3XXIcQ7kNvwHIalBF&_nc_oc=AdpQ4qMG1oFA-OUUgZdKCItPM_aCijSXIZ7K3gXSjn1St1xdItx_RAQ-GPKHXLA_xkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0MUTFvivXzcTAQyTH-zJeDcsIezH2d-THT_Dx74_s_gA&oe=69F0AB00"}, {"file_name": "simmoon-meta-roverview.png", "id": "1804829626982265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393841_1804829630315598_2601101010256390470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXqktC2g4_QQ7kNvwGW_hK6&_nc_oc=AdoXpC8Rtd9PhsIh4tCYSsZ94WZqM4RQhs91D5gc59THiU_vKdeKU-CKaoWqAKJVZ_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2-F1rpj73BH9pSnQDOYfKFd_J0EVgQQfBS8veaXIQh6A&oe=69F0AF6A"}, {"file_name": "simmoon-meta-baseview.png", "id": "530557563390877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391982_530557566724210_9158394380391055027_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOUsY54vF9UQ7kNvwHBYkCh&_nc_oc=AdpHuFZ7iJkZlgeWB7enPwMLuJbVsTKIh0dyNVzYdG7XPd8UrghoczfhiR0pvYVfCaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3U7IwtF64bcEI6UFhiCkU_iua9w_YV5u2cPEEQrwsFlA&oe=69F0BBD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimMoon", "keywords": [], "long_description": "Explore the Moon Like Never Before with SimMoon!\n\nEmbark on an extraordinary journey to the lunar South Pole with SimMoon, the ultimate immersive lunar exploration experience. Step into the boots of an astronaut and traverse the moon's enigmatic surface in stunning photo-realistic quality.\n\nKey Features:\n\nImmersive Lunar Environment: Experience the breathtaking landscapes of the Moon's South Pole, rendered in astonishing detail.\nApollo Rover Adventure: Take control of a meticulously recreated Apollo lunar rover and drive across the moon's challenging terrain.\nRealistic Physics: Feel the unique 1/6th gravity of the Moon and discover what it's like to walk and drive in this new frontier.\nDynamic Day/Night Cycle: Witness the sun's movement across the lunar sky, accurately simulated for an authentic experience.\nEducational and Fun: Learn about the lunar environment and space exploration in an interactive", "short_description": "Dive into the lunar adventure with SimMoon! Explore the South Pole of the Moon, drive the Apollo Rover, and experience the realism of space like never before."}]}, "developer_name": "Cislune Inc.", "developer_privacy_policy_url": "https://cislune.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cislune Inc.", "support_website_url": null, "website_url": "http://www.cislune.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9071191376342625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_630710083080886_2576534819683677669_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMNuTeFr07cQ7kNvwG5_vg7&_nc_oc=Adr3dFsBRvJ46hV4z
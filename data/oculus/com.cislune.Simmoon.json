ar Environment: Experience the breathtaking landscapes of the Moon's South Pole, rendered in astonishing detail.\nApollo Rover Adventure: Take control of a meticulously recreated Apollo lunar rover and drive across the moon's challenging terrain.\nRealistic Physics: Feel the unique 1/6th gravity of the Moon and discover what it's like to walk and drive in this new frontier.\nDynamic Day/Night Cycle: Witness the sun's movement across the lunar sky, accurately simulated for an authentic experience.\nEducational and Fun: Learn about the lunar environment and space exploration in an interactive", "short_description": "Dive into the lunar adventure with SimMoon! Explore the South Pole of the Moon, drive the Apollo Rover, and experience the realism of space like never before."}]}, "developer_name": "Cislune Inc.", "developer_privacy_policy_url": "https://cislune.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cislune Inc.", "support_website_url": null, "website_url": "http://www.cislune.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9071191376342625"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "645315171322799"}]}, "baseline_offer": {"id": "645315171322799"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742838240, "status
05926158324_4639281490403867975_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zanZ0oToTQQ7kNvwHFV9hb&_nc_oc=AdppaP0vAg59qNlornZs0qOYjOj5dbeYbHOZuvw2nnMMaQ2buqNYP-UAiiicaWxewSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDe7k0aw90NRvJe-oHSfnH65kRs3kBMxlO0Ou0okaE1Q&oe=6AB54345"}, {"file_name": "simmoon-meta-moonview.png", "id": "1739235400277867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391911_1739235403611200_7868188044197899477_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DbnETRdzsMQ7kNvwEcPQOA&_nc_oc=AdolT5C8CblGelSKhPKnx_QUW6zQ1Z8_eAOachmZvU87Ys9lHg5l2fn9YA7i_ezQhsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_gV8yH__AMTtaUBnVuIILBgVLa9FiI-YLAbWQL4uUDQ&oe=6AB51A80"}, {"file_name": "simmoon-meta-roverview.png", "id": "1804829626982265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393841_1804829630315598_2601101010256390470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfKl6MdsdioQ7kNvwG-F5BW&_nc_oc=Adrvcj4X-vnaUkxUEWcv5YlW8ePYIEpBt_8R-kYhwHBpTYw5ehePCcfXMFWXTBkoHk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzNqx1OleHJFu7mt_sUCvLClrj9PeKBfzPHx654Ey7bg&oe=6AB51EEA"}, {"file_name": "simmoon-meta-baseview.png", "id": "530557563390877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391982_530557566724210_9158394380391055027_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQMlujpJXzwQ7kNvwGgRcBC&_nc_oc=Adou582i3f9TuZI3VMBvDNZxoDD8bs7_hPS52c4zEMGUufeOyM_kNHfiytU-hStJ3wM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM-tY_gXtVXsX1vTqKx0M1KkPQ7yXCN3ohYqWkJ4ovhg&oe=6AB52B58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimMoon", "keywords": [], "long_description": "Explore the Moon Like Never Before with SimMoon!\n\nEmbark on an extraordinary journey to the lunar South Pole with SimMoon, the ultimate immersive lunar exploration experience. Step into the boots of an astronaut and traverse the moon's enigmatic surface in stunning photo-realistic quality.\n\nKey Features:\n\nImmersive Lunar Environment: Experience the breathtaking landscapes of the Moon's South Pole, rendered in astonishing detail.\nApollo Rover Adventure: Take control of a meticulously recreated Apollo lunar rover and drive across the moon's challenging terrain.\nRealistic Physics: Feel the unique 1/6th gravity of the Moon and discover what it's like to walk and drive in this new frontier.\nDynamic Day/Night Cycle: Witness the sun's movement across the lunar sky, accurately simulated for an authentic experience.\nEducational and Fun: Learn about the lunar environment and space exploration in an interactive", "short_description": "Dive into the lunar adventure with SimMoon! Explore the South Pole of the Moon, drive the Apollo Rover, and experience the realism of space like never before."}]}, "developer_name": "Cislune Inc.", "developer_privacy_policy_url": "https://cislune.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cislune Inc.", "support_website_url": null, "website_url": "http://www.cislune.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9071191376342625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/47339193
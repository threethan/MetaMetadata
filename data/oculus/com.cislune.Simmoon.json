, {"file_name": "simmoon-meta-roverview.png", "id": "1804829626982265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393841_1804829630315598_2601101010256390470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hs8_uUPE30Q7kNvwEnYAbZ&_nc_oc=AdpM0c8Sih6OSDxUEPtO7kXSKjpDftTEWXB8fH_jySMA_7CiU3HiC01PMnDQf4YIJJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmzdYxxlfcz9_8S_zFyjj7E_DmBJ4KOYd62FyywlL16A&oe=6A98562A"}, {"file_name": "simmoon-meta-baseview.png", "id": "530557563390877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391982_530557566724210_9158394380391055027_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwklmCRosVgQ7kNvwGVjzQx&_nc_oc=Ado3ZiMBzKGXWab7IDpMeJypMMjcG-dx2ofAHVehgzhk0DGcJkQHakEAx-93wFVmnao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxfmY0fuDqmRBAP4_FDqf4LW3zS9xPzD_6q5-OXx6NUA&oe=6A986298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimMoon", "keywords": [], "long_description": "Explore the Moon Like Never Before with SimMoon!\n\nEmbark on an extraordinary journey to the lunar South Pole with SimMoon, the ultimate immersive lunar exploration experience. Step into the boots of an astronaut and traverse the moon's enigmatic surface in stunning photo-realistic quality.\n\nKey Features:\n\nImmersive Lunar Environment: Experience the breathtaking landscapes of the Moon's South Pole, rendered in astonishing detail.\nApollo Rover Adventure: Take control of a meticulously recreated Apollo lunar rover and drive across the moon's challenging terrain.\nRealistic Physics: Feel the unique 1/6th gravity of the Moon and discover what it's like to walk and drive in this new frontier.\nDynamic Day/Night Cycle: Witness the sun's movement across the lunar sky, accurately simulated for an authentic experience.\nEducational and Fun: Learn about the lunar environment and space exploration in an interactive", "short_description": "Dive into the lunar adventure with SimMoon! Explore the South Pole of the Moon, drive the Apollo Rover, and experience the realism of space like never before."}]}, "developer_name": "Cislune Inc.", "developer_privacy_policy_url": "https://cislune.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cislune Inc.", "support_website_url": null, "website_url": "http://www.cislune.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9071191376342625"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "645315171322799"}]}, "baseline_offer": {"id": "645315171322799"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742838240, "status": "PUBLISHED", "id": "645315171322799"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9910767702384984", "version": "1.2.1"}, "id": "243833348667711", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6813933945401724", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9910767702384984"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": 
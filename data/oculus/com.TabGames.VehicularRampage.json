1825068_1386049929511564_5096365146808097018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjeKipil74IQ7kNvwGyla6l&_nc_oc=Adq-zvahdbPmvOVaFloji25Y_CVt9SBhUrM0Lg1faQPI5I5ghigaxPB9Tx2_qoAyoGk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iiuNcTT5M51UHzJT7fajgbhdKcgW7oVWLMHxcIHGOAg&oe=6A230146"}, "display_name": "Vehicular Rampage", "keywords": [], "long_description": "Strap in, start your engine, and prepare for the ride of your life!\n\nRip through the city and destroy anything that gets through your way.\n\nComplete your goals before the time runs out and hit pedestrians to extend your time.\n\nRevel in the retro-inspired graphics.\n\nEnjoy smooth, high quality driving controls and physics!\n\nWhat are you waiting for? Get out there and start your rampage!", "short_description": "A retro-inspired action packed driving game that's not meant for the faint of heart."}]}, "developer_name": "Tab Games", "developer_privacy_policy_url": "http://tabgamesvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tab Games", "support_website_url": null, "website_url": "http://TabGamesVR.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9953646964683063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771
XhbzoUS6EKsf-Q_lHrgPbU5IHHhbhJqLF_EWV7yiqQQQpxTriqWxJBbzB3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93XtdhZkTWGWU9i-03AGhCBRtV-XFuPrIkD5D130wXFA&oe=6A3EA397"}, {"file_name": "hq720 (8).png", "id": "2330456964110985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507840145_2330456967444318_9153971983663361517_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIbfeBrn2KwQ7kNvwH9ZN1L&_nc_oc=AdqPZbQfCWPxIaTo5Yll9ufzNSfcaz5wp66iT-joLCOxAUOH49Vi5E78qOnZVv2A8zc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K0bs9mFFi1mRbWQKcnvyFRI45fB0WC1xs3nzC04NK6w&oe=6A3E84C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rec Room", "keywords": ["Rec", "Room"], "long_description": "Build Games & More \n\nJump into an immersive social experience where you can create alongside friends from around the globe. Collaborate on your own games and design unique hangout spaces, all with easy-to-use tools! Creation in Rec Room is real-time, which means you can work together seamlessly to bring your ideas to life. \n\nPublish & Play \u2013 Instantly\n\nPress \u2018Publish\u2019 and watch your creations go live across all devices, from VR to mobile - instantly available for a global audience to enjoy. Make an action-packed multiplayer PVP game, a spooky horror escape room, or just a chill place to hangout with friends.\n\nExpress Your Creativity With No Limits\n\nFrom designing your avatar\u2019s perfect outfit to customizing your own dorm room to 3D modeling and building entire games, there\u2019s no limit to what you can create. Use Rec Room\u2019s powerful in-game tools to bring your dream project to life. Level up your creation skills with simple tutorials so that you can create anything you want!\n\nCreate Anytime, Anywhere \n\nRec Room gives you seamless cross-platform building \u2014 no pro skills or external software needed! Full voice-chat and cross-play make creating and playing with friends on different devices a breeze.  \n\nFind Your Audience & Earn Rewards!\n\nShowcase your work, monetize your creations, and grow a fanbase! Whether you're designing games, founding a club, hosting live events, or just hanging out with friends - Rec Room gives you the tools to turn creativity into endless possibilities.", "short_description": "Build Games & More \n\nJump into an immersive social experience where you can create alongside friends from around the globe. Collaborate on your own games and design unique hangout spaces, all with easy-to-use tools! Creation in Rec Room is real-time, which means you can work together seamlessly to bring your ideas to life. "}]}, "developer_name": "Rec Room Development", "developer_privacy_policy_url": "https://sites.google.com/another-axiom.com/recroom/policy", "developer_terms_of_service_url": null, "publisher_name": "Rec Room Development", "support_website_url": null, "website_url": "https://sites.google.com/another-axiom.com/recroom/web", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1148578625009678"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_2777069302670821_8851815538451713155_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6PPGozW0b0Q7kNvwFKxsE0&_nc_oc=AdqYyNIlGuwBAdTegsAqBrE6_gTgZSJBDOUBq3hCKU-F9j8Xu
6e7a0a&_nc_ohc=jp9uj9jt85gQ7kNvwEv_zpc&_nc_oc=AdoG9O0r3GB8I-qtp6C04FpkdN4rOwoj7Tdlk3QXyONX94_WR9G6issx4cEbxJYFGIw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHRUSNyY4piw1-c7-4_H54r13ZbPKW3Fsk2jzsC5F-ow&oe=6A8EDE8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1808371306198766", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569479_1808371309532099_2028891221452154036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKYtCsvE8UQQ7kNvwEsWECP&_nc_oc=AdoVWlB5DFPNCKmsRNLIZdAhUllcvUbw2P_LIO_4x8dhRZ1NTtuC7wkt1QJJVXRClgQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAngxln3-L9IgWdmuwMXqK9AsDfPx3PXuQPQDzilnymQ&oe=6A8EF2EC"}, "display_name": "Eyeliens & Heroes", "keywords": [], "long_description": "In an unspecified future, the cute and bored aliens decide to enjoy their time in the most ancient game ever: the fight!\nThanks to their advanced technologies they not only create an innovative arena but choose, through a careful selection, characters who have distinguished themselves for their peculiar characteristics throughout the history of the Worlds.\n\nThis is how our extraterrestrials, thanks to capsules that allow the opening of space-time portals, captured our future fighters just one step away from the apex of their life.\n\nThe unsuspecting characters will thus find themselves facing each other on moving platforms, using different weapons and objects. Anything could be useful!\nThe platforms, full of equipment, move closer to each other, until they touch. At that point each weapon is no longer useful, you can only count on the strength of your fists and your agility.\n\nThanks to the experience, the fighters will also be able to unlock different skills, which when needed could turn the tide of the duel.\n\nAre you ready to fight alongside our heroes?", "short_description": "In an unspecified future, the cute and bored aliens decide to enjoy their time in the most ancient game ever: the fight!\nThanks to their advanced technologies they not only create an innovative arena but choose, through a careful selection, characters who have distinguished themselves for their peculiar characteristics throughout the history of the Worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eyeliensheroes.com/documents/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Floaty S.r.l.", "support_website_url": null, "website_url": "https://www.eyeliensheroes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1202440767056472"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6367644113340708", "version": "1.1"}, "id": "631976834523628", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4458297210942084", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6367644113340708"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_na
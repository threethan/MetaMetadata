e=6AE606B8"}, "display_name": "Notarangelo Showroom", "keywords": [], "long_description": "Welcome to an exciting VR experience that takes us back to the 1970s, immersing us in a magical darkroom. The art of photography comes to life as we explore timeless images and listen to the tale of a young man and his friend Mimi. This sensory journey includes the mystical atmosphere of the red light bulb and the smell of Tuscan cigars. The photographs depict ordinary people, considered heroes by the young man's father, who wanted to preserve their memory. The experience invites us to reflect on modernity and rediscover our roots. The images tell a story without the need for words, inviting us into an authentic and meaningful world.", "short_description": "Welcome to the VR exhibition celebrating the timeless photographs of a bygone era. This experience will take you into the heart of the 1970s, into a fascinating and mysterious darkroom where the art of photography comes to life. Experience the magical atmosphere and the smell of cigars as you explore images of ordinary people who were true heroes of their time. A journey into the past that rediscovers the beauty and humanity of a forgotten era."}]}, "developer_name": "Just Pixel", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/95019998/legal", "developer_terms_of_service_url": null, "publisher_name": "Just Pixel", "support_website_url": "https://justpixel.it/contattaci/", "website_url": "https://justpixel.it/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_de
44Eg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS55i7l3pmHSZEJlCVG5Z_9eTAVuYZ9ro1-mES0wfiXw&oe=6AE606FF"}, {"file_name": "4.png", "id": "828691058730678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031434_828691062064011_435870329456212106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s83vm7wCPMQ7kNvwHiDOa7&_nc_oc=AdplMnHGzltq45HC6W4xzIEwJTQI1wqQ_Bg44pxRZC9RcTC1wHnoaRJqMOixtlx1N80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaw2oIMNQhCRglAhouSh34RInZnbfAvgVUUcVqMeY_9A&oe=6AE5EFAC"}, {"file_name": "5.png", "id": "2097375600602782", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974558_2097375603936115_8945881376113275738_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOsOgMQlAWgQ7kNvwHm4jUw&_nc_oc=AdrwcJ-ZcVCwrjLKi9UNCiOwA0w6LVT4F8a_ymH97STKmOOiOfj2dJSve9G91OLyrTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuLu2hheK6Hrh9IjokMWIHxMyTw1YnX657_1iT9tzoIA&oe=6AE603F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "7054635507882688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_7054635517882687_2341245725745953170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa7FUCPDpYQQ7kNvwEZDqeZ&_nc_oc=AdrNVVUWqsLMrBxZaW4il6j8ePIeGcQo9CnyFnYQXbGtScIa1t_5KoYhDb4EjdGl7Oc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqr-mqUUZrcRIlYSpWpXJDCvrJh18V-YqPEz3WhRWxdA&oe=6AE5E46E"}, "display_name": "Mostra Notarangelo", "keywords": [], "long_description": "Benvenuti in un'emozionante esperienza VR che ci porta negli anni Settanta, immergendoci in una camera oscura magica. L'arte della fotografia prende vita mentre esploriamo immagini intramontabili e ascoltiamo il racconto di un giovane e del suo amico Mim\u00ec. Questo viaggio sensoriale include l'atmosfera mistica della lampadina rossa e l'odore dei sigari toscani. Le fotografie ritraggono persone comuni, considerate eroi dal padre del giovane, che voleva preservarne la memoria. L'esperienza ci invita a riflettere sulla modernit\u00e0 e a riscoprire le nostre radici. Le immagini raccontano una storia senza bisogno di parole, invitandoci in un mondo autentico e significativo.", "short_description": "Benvenuti nella mostra VR che celebra le fotografie intramontabili di un'epoca passata. Questa esperienza vi porter\u00e0 nel cuore degli anni Settanta, in una camera oscura affascinante e misteriosa, dove l'arte della fotografia prende vita. Sperimentate l'atmosfera magica e l'odore dei sigari mentre esplorate immagini di persone comuni che erano veri eroi del loro tempo. Un viaggio nel passato che riscopre la bellezza e l'umanit\u00e0 di un'era dimenticata."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "1622178505274658", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982623_1622178508607991_8217246024349958915_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib2kUwREozkQ7kNvwG4tiXf&_nc_oc=AdqACtM3ODz8svF9M5-u0JpD3oWD1aFOh5eSMpoqa7P6P3CNZicRbYamNQY59eNgQ8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtj8j0yLTu9TJC05D91AghWOu-Z0sva-b5Ilou-cfIiw&oe=6AE60406"}, {"file_name": "Landscape Portrait.png", "id": "1351058739144063", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974482_1351058742477396_4954803637879338110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sbqwybGat4Q7kNvwH5YM5q&_nc_oc=AdogQUcWqlQVx2UqW6m374xTFZZQeY42HMPfAsOmqhIUsUKIAs-DzIthiLgD-nrMOZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzkvUZCKfSMEaYbpcFG_zmHCgx0X6057reZk5BN-SwGA&oe=6AE5FBD7"}, {"file_name": "Landscape Square.png", "id": "986429155749648", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974746_986429159082981_8873017877306864150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW97RBuBReEQ7kNvwHaJiqN&
151364995_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAXRfzsPF5YQ7kNvwFO5GaN&_nc_oc=Adp12Q2MND6uI3TZorJqzjYmsLjcKOdu_koZdebwpYog8lODpWyycwU0L9yOL2lo1TI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyk1X0PssluUoWZWzC1G7qAMpNMpd5NjoKs77Nzymf8w&oe=6AE5E1C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "297266426401693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982548_297266429735026_5512734219726182983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewiZ6XE6U5IQ7kNvwFkzIbV&_nc_oc=AdpZQSebLlFCkRoveDaopxV_Igx5oSNC1gM914gyo6K5iXgQLc-mNWQsJwP5QizSKeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX_qsoWV-NnWZLqTADnmyZ2rvpXcUkG1qib4JD4V2ipg&oe=6AE616F4"}, "display_name": "Notarangelo Showroom", "keywords": [], "long_description": "Welcome to an exciting VR experience that takes us back to the 1970s, immersing us in a magical darkroom. The art of photography comes to life as we explore timeless images and listen to the tale of a young man and his friend Mimi. This sensory journey includes the mystical atmosphere of the red light bulb and the smell of Tuscan cigars. The photographs depict ordinary people, considered heroes by the young man's father, who wanted to preserve their memory. The experience invites us to reflect on modernity and rediscover our roots. The images tell a story without the need for words, inviting us into an authentic and meaningful world.", "short_description": "Welcome to the VR exhibition celebrating the timeless photographs of a bygone era. This experience will take you into the heart of the 1970s, into a fascinating and mysterious darkroom where the art of photography comes to life. Experience the magical atmosphere and the smell of cigars as you explore images of ordinary people who were true heroes of their time. A journey into the past that rediscovers the beauty and humanity of a forgotten era."}, {"images": {"nodes": [{"file_name": "Landscape Square.png", "id": "3657038344622374", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_3657038347955707_4978832407985187771_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CtArE_gRuQQ7kNvwGNv3yx&_nc_oc=AdrmYjNHWkXaueo0PlkAt-1ygP9TveEixN-WuB3GhDbXMm1n1sD3JYADWob7qNeSObA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIegFvdh5zZj-dhltMCVhEFiH8ELx-JikeRQ3Q3TApZg&oe=6AE5E1E0"}, {"file_name": "Landscape.png", "id": "1362294358022884", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974893_1362294364689550_3476673786913460054_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70YN6j03L8IQ7kNvwFkSiK8&_nc_oc=AdrLk-jw2jr9SgoOuD5ORKQUKfLLn5dDUynXImaNXPl4u_RuLPhEf-Bijfd6Vr2V8mA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQUlB017xZj5FMKODajgtv17sK0SA-bDSvnGluy68xvQ&oe=6AE5DFBA"}, {"file_name": "Hero Cover.png", "id": "833111555269095", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974715_833111558602428_8232588114279206844_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlxO-VMv2Z4Q7kNvwFScT39&_nc_oc=Ado4yd1RSA4PYAm1fceBN9woQG8piAkAvDxo4srE238uYGXUQczQfxosD3C-SIb1dY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfWXwfxjo0u4UxaI9DsmUbqZK98iOZ7Qeyv_7htlqz6g&oe=6AE5EFE3"}, {"file_name": "Logo.png", "id": "743168264313029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974811_743168267646362_6617391042491672995_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6_l1PLZkuAQ7kNvwGcyl71&_nc_oc=AdpTQkDJtOnLBZyoeASHlmL_maXLjdQQylFxISXnIqqw7QWp3kYs1MjuAys8WBEwLQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5c1rES5-d0jxKDQWr2TP4c3xm7QHPIThOZY8Ut4OVyA&oe=6AE5FF9E"}, {"file_name": "Icon.png", "id": "682994547094810", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad
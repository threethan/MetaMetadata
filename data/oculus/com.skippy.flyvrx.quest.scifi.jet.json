_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uOFIl6g4tMmEBK-ug-P0-EyZ7CKhMtYXMGiRggLSGPg&oe=6A0EF4F2"}, {"file_name": "06 copy.png", "id": "1149517393494681", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393984_1149517396828014_1938435541781921551_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcZNq9Zpf2gQ7kNvwGlGIYj&_nc_oc=AdqXlVQzG78bcpixPvMw_yYFeFi_BUi7hkXVMoUUw1t8Iy0UZ6VQc4-lHJDqlFG7vFk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cOgy9LQaYPDzJt4rMVB18RjnZs3Cur5X1OH0PTIVfEQ&oe=6A0F1E0C"}, {"file_name": "03 copy.png", "id": "522338323673302", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391883_522338327006635_27436933138728464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xL_Ujq1HqF4Q7kNvwEehp6K&_nc_oc=AdowsfegdpGLmbtE41gJ1WsiRLSPVjF3V7lxjoJQ-eGD5Hjv1qDeEZw42ZPV0T6cOyQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O_QD0AqiHjozymo7lZHHJzCSFZLuX57CEM92DVZiZrA&oe=6A0F2BC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473393984_1149517396828014_1938435541781921551_n.png", "id": "595803140166113", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393320_595803146832779_2833829262636130652_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7T7ISkHf-cQ7kNvwEcw5UV&_nc_oc=AdrBDZsA0WxkQS9CldNMp5gL1rccBdGOMMa-krOfnlazRphYyDrRXJFua9Lw3nAVnQM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43HqrHX3LoCx7j2TtCqt7vvf8BSbNHgAI8mOxMenwuwA&oe=6A0EFA14"}, "display_name": "FlyVRX - SciFi Mars Battle", "keywords": ["Scifi", "future", "space", "flying", "shooting"], "long_description": "\nAn Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones.\n\nDog-fight, survival and missions modes let you select different type of combat modes and action.\n\nFeatures:\n- Easy and smooth grab controls & navigation.\n- Realistic Graphics and Environments\n- realistic Mars terrain and enemy targets\n- Missions, Survival, and Dog-Fight Mode\n- Cockpit Pilot Grab Stick and Throttle control \n- Machine-gun and Missile fire\n- Multiplayer with voice (coming soon)\n\nHow to Play:\n- Right Controller Hand: Grab/Hold Stick for Jet Movement/turn\n- Left Controller Hand: Grab/Hold side Throttle for Speed\n- Right Controller Trigger: Bullet Machine Gun Fire\n- Right Controller \u201cA\u201d Button: Missile Fire", "short_description": "An Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28599831789664215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982593_380963214330874_4298207078977596322_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWnAbfvDvswQ7kNvwGhhN6V&_nc_oc=Adqa0KGmV0T_0OXcHHRZRKveaO
06 copy.png", "id": "1149517393494681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393984_1149517396828014_1938435541781921551_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjLdCSWxKoAQ7kNvwHFhEsz&_nc_oc=Adm7N3BH6kubmgKskA360flVrK-8I2CIAdYhZJzVifcOj5X09Gjt1i-9dlmRbaMYL9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsvVi1A8MxMFZV_1FPlGuZnbcMSAX4aepHKeyG_Z8L8EQ&oe=699ED64C"}, {"file_name": "03 copy.png", "id": "522338323673302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_522338327006635_27436933138728464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6vDB-aGXy8Q7kNvwGaK_Hf&_nc_oc=Adk_EJcm4TneuSi4ws-OOOTgTyHdDZabN3qOiFqpMpagjqtUz_Cs7NZsXHpIrPskDoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft8dbI-NDnEHeNbhkt-jOAWes-5Rcf8S8dhy-hUjuEZUw&oe=699EE403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473393984_1149517396828014_1938435541781921551_n.png", "id": "595803140166113", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393320_595803146832779_2833829262636130652_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIcWTpLdqecQ7kNvwGWSP38&_nc_oc=AdmruETIJoSEPO3JrYS_TY5ukKBRicm2R1lEDvNPpNWCIdMAMMP3zGuiZHaelORJp0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs6jwMwcKhZ-NVxAFBujcxBsdwrQ9uwFdezMk7Q38ju0w&oe=699EEA94"}, "display_name": "FlyVRX - SciFi Mars Battle", "keywords": ["Scifi", "future", "space", "flying", "shooting"], "long_description": "\nAn Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones.\n\nDog-fight, survival and missions modes let you select different type of combat modes and action.\n\nFeatures:\n- Easy and smooth grab controls & navigation.\n- Realistic Graphics and Environments\n- realistic Mars terrain and enemy targets\n- Missions, Survival, and Dog-Fight Mode\n- Cockpit Pilot Grab Stick and Throttle control \n- Machine-gun and Missile fire\n- Multiplayer with voice (coming soon)\n\nHow to Play:\n- Right Controller Hand: Grab/Hold Stick for Jet Movement/turn\n- Left Controller Hand: Grab/Hold side Throttle for Speed\n- Right Controller Trigger: Bullet Machine Gun Fire\n- Right Controller \u201cA\u201d Button: Missile Fire", "short_description": "An Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28599831789664215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982593_380963214330874_4298207078977596322_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsXP1lOcXo4Q7kNvwH-BMyD&_nc_oc=AdnDVcWR4s8U5FE0tPCEnVc_3ywo-nNv1pGYMivsz4OlgGr-NuBiSZVflS7H2ersKwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsnvg6lrPH6cUEFdHREiFpoYZ5PSEQZIFxbsf-Sg8oGQA&oe=699EE8E9"}, "is_concept":
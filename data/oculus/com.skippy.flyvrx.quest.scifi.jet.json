e7a0a&_nc_ohc=VJtAP59EgwUQ7kNvwFAGVvp&_nc_oc=Adoun0k6OIe-qQOrSYMymx7bcYAzjiSXJx-Vit3nr4CyX-CdfU9ok-7xVfI8c332PKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX54Mi3do13uageqsqiVSUJwAUGM8oY7fg9fvGHPD9OQ&oe=6AAABE32"}, {"file_name": "06 copy.png", "id": "1149517393494681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393984_1149517396828014_1938435541781921551_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfk-YJU4d14Q7kNvwE7X5UB&_nc_oc=AdqDkQIR7Her3qFRR1NwRN6QZ4g9fHJzKbWTBDqtzvIOBgjzxj8BBdL46mzELxs3EK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVfapCRHuDdDVxkk55SJc1UpC8_IlX7eIVqmJh2BLLzw&oe=6AAAAF0C"}, {"file_name": "03 copy.png", "id": "522338323673302", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_522338327006635_27436933138728464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCyet3y5JecQ7kNvwHrtGrc&_nc_oc=AdoKKyl7Lvjnf0_n_6RUgBytxFPwHLyTCu28dA2KN_Y_m1KseAdfUOJeLs4GciGAUbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ54dZx2Y5Vg-cWoI7-jcIbGmCKJq2JX_yYFhkBSkb8sw&oe=6AAABCC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473393984_1149517396828014_1938435541781921551_n.png", "id": "595803140166113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393320_595803146832779_2833829262636130652_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHzykZgrvaYQ7kNvwFDa2cr&_nc_oc=AdozIOF5nD5y1-K1d2sQYQPWqUiVUgcBVCobqhWmyCnF1awI1YjzGG5ZRrPySdVy_kU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAC38E_RV94k08inxfhf3Sev13OndqwY4F7bh2haAKCQ&oe=6AAA8B14"}, "display_name": "FlyVRX - SciFi Mars Battle", "keywords": ["Scifi", "future", "space", "flying", "shooting"], "long_description": "\nAn Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones.\n\nDog-fight, survival and missions modes let you select different type of combat modes and action.\n\nFeatures:\n- Easy and smooth grab controls & navigation.\n- Realistic Graphics and Environments\n- realistic Mars terrain and enemy targets\n- Missions, Survival, and Dog-Fight Mode\n- Cockpit Pilot Grab Stick and Throttle control \n- Machine-gun and Missile fire\n- Multiplayer with voice (coming soon)\n\nHow to Play:\n- Right Controller Hand: Grab/Hold Stick for Jet Movement/turn\n- Left Controller Hand: Grab/Hold side Throttle for Speed\n- Right Controller Trigger: Bullet Machine Gun Fire\n- Right Controller \u201cA\u201d Button: Missile Fire", "short_description": "An Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28599831789664215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982593_380963214330874_4298207078977596322_n.
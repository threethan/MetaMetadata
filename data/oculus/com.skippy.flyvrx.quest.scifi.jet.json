uluscdn.com/v/t64.5771-25/38982461_900922901641724_3428286811163912867_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npN2qCRKkyoQ7kNvwGOreOE&_nc_oc=AdrU1K0qeTUOFLmT1C2M7zl12uYBwnV6G9xaq8eUapG94STU1PlcNmDhQkyns9cIs5U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3l0TkLwZfYvMKn41RXuBBxs7VzbI-77DTx90__hQgnfw&oe=69F208E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlyVRX - SciFi Flying Mars Battle", "keywords": [], "long_description": "\nAn Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a\na SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones.\n\nDog-fight, survival and missions modes let you select different type of combat modes and action.\n\nFeatures:\n- Easy and smooth grab controls & navigation.\n- Realistic Graphics and Environments\n- realistic Mars terrain and enemy targets\n- Missions, Survival, and Dog-Fight Mode\n- Cockpit Pilot Grab Stick and Throttle control \n- Machine-gun and Missile fire\n- Multiplayer with voice (coming soon)\n\nHow to Play:\n- Right Controller Hand: Grab/Hold Stick for Jet Movement/turn\n- Left Controller Hand: Grab/Hold side Throttle for Speed\n- Right Controller Trigger: Bullet Machine Gun Fire\n- Right Controller \u201cA\u201d Button: Missile Fire", "short_description": "An Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a\na SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [
GCJKc1hprhQDDDrFpA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gZ5gQ0GQIu0wuDY1s28fN4ZByndP5MUec0yXwFGu2tw&oe=6A11C249"}, {"file_name": "2.png", "id": "900922898308391", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982461_900922901641724_3428286811163912867_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SlNoONAtsIQ7kNvwG09JAW&_nc_oc=AdoSgmoQ7BZ9Waurzjv7SuEBsh6gClaAxgLpRvs_9ptAOu7t7P5QLR0ofJYzOsUvfow&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DId_oYNgtHE_2HRNICJhzYf7z4dkkzmnAL9kBOvRlYg&oe=6A11ACE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlyVRX - SciFi Flying Mars Battle", "keywords": [], "long_description": "\nAn Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a\na SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones.\n\nDog-fight, survival and missions modes let you select different type of combat modes and action.\n\nFeatures:\n- Easy and smooth grab controls & navigation.\n- Realistic Graphics and Environments\n- realistic Mars terrain and enemy targets\n- Missions, Survival, and Dog-Fight Mode\n- Cockpit Pilot Grab Stick and Throttle control \n- Machine-gun and Missile fire\n- Multiplayer with voice (coming soon)\n\nHow to Play:\n- Right Controller Hand: Grab/Hold Stick for Jet Movement/turn\n- Left Controller Hand: Grab/Hold side Throttle for Speed\n- Right Controller Trigger: Bullet Machine Gun Fire\n- Right Controller \u201cA\u201d Button: Missile Fire", "short_description": "An Action Arcade style SciFi Flight Simulation that puts in direct thrilling combat action on Mars. As a\na SciFi Jet pilot fly over Mars terrain and in space cities to engage with fast enemy jets and drones."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Ap
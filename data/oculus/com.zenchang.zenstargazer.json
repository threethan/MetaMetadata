7a7a\u3092\u898b\u4e0a\u3052\u3088\u3046\u3002\u6307\u305b\u3070\u661f\u30fb\u60d1\u661f\u30fb\u6df1\u7a7a\u306e\u89e3\u8aac\u3002\u6642\u523b\u3068\u89b3\u6e2c\u5730\u3092\u5909\u3048\u3001\u6d41\u661f\u7fa4\u3084\u98df\u3082\u8ffd\u3048\u308b\u3002\u5de6\u624b\u306e\u60c5\u5831\u30d1\u30c3\u30c9\u3067\u64cd\u4f5c\u3002\u7e41\u4f53\u5b57\u4e2d\u56fd\u8a9e\uff0f\u82f1\u8a9e\uff0f\u65e5\u672c\u8a9e\u5bfe\u5fdc\u3002"}, {"images": {"nodes": []}, "id": "1571466187152385", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Stargazer", "keywords": ["\u89c0\u661f", "\u5929\u6587", "\u661f\u5ea7", "\u6d41\u661f\u96e8", "\u65e5\u98df"], "long_description": "Zen Stargazer \u662f\u7d66 Meta Quest \u7684\u6df7\u5408\u5be6\u5883\u89c0\u661f\u9ad4\u9a57\u3002\u4f60\u5750\u5728\u771f\u5be6\u623f\u9593\u6c99\u767c\u4e0a\uff0c\u62ac\u982d\u5c31\u662f\u4f9d\u89c0\u6e2c\u6642\u9593\u8207\u5730\u9ede\u8a08\u7b97\u7684\u661f\u7a7a\u3002\n\n\u3010\u6307\u661f\u5373\u5b78\u3011\n\u7528\u53f3\u624b\u63a7\u5236\u5668\u6307\u5929\u7a7a\uff1a\u6046\u661f\u3001\u884c\u661f\u3001\u661f\u96f2\u8207\u661f\u7cfb\u6703\u6d6e\u51fa\u540d\u7a31\u8207\u89e3\u8aaa\u3002\u5728\u4eae\u661f\u65c1\u7684\u77e5\u8b58\u5361\u5e6b\u4f60\u5feb\u901f\u8a8d\u8b58\u591c\u7a7a\u8def\u6a19\u3002\n\n\u3010\u6642\u9593\u8207\u5730\u9ede\u3011\n\u5207\u63db\u300c\u73fe\u5728\u300d\u6216\u9396\u5b9a\u89c0\u6e2c\u6642\u523b\uff1b\u5728\u4e16\u754c\u5730\u5716\u9078\u57ce\u5e02\uff0c\u77ac\u9593\u6539\u5beb\u4f60\u982d\u9802\u7684\u5929\u7a7a\u3002\u9069\u5408\u9810\u7df4\u6d41\u661f\u96e8\u6975\u5927\u591c\uff0c\u6216\u56de\u770b\u67d0\u4e00\u5834\u98df\u8c61\u3002\n\n\u3010\u661f\u5ea7\u8207\u6df1\u7a7a\u3011\n\u958b\u555f\u661f\u5ea7\u7dda\u3001\u9ec3\u9053\u8207\u7cbe\u9078\u6df1\u7a7a\u5929\u9ad4\uff0c\u8b93\u7d50\u69cb\u66f4\u6e05\u695a\u3002\u90e8\u5206\u76ee\u6a19\u9644\u516c\u958b\u9818\u57df\u5929\u6587\u5f71\u50cf\uff0c\u65b9\u4fbf\u5c0d\u7167\u4f60\u5728\u5929\u7a7a\u4e2d\u770b\u5230\u7684\u4f4d\u7f6e\u3002\n\n\u3010\u884c\u661f\u8207\u6708\u4eae\u3011\n\u8fd1\u89c0\u884c\u661f\u76f8\u4f4d\u8207\u885b\u661f\u6392\u5217\uff08\u793a\u610f\uff09\uff0c\u6708\u4eae\u7167\u660e\u8207\u6708\u9f61\u4e00\u76ee\u4e86\u7136\u3002\u6307\u5411\u4e8b\u4ef6\u9215\uff0c\u5373\u53ef\u8df3\u5230\u4e0a\u4e00\u5834\uff0f\u4e0b\u4e00\u5834\u76f8\u95dc\u5929\u8c61\u9032\u884c\u89c0\u5bdf\u3002\n\n\u3010\u6d41\u661f\u96e8\u8207\u4e8b\u4ef6\u7c3f\u3011\n\u76ee\u9304\u5217\u51fa\u7d93\u5178\u6d41\u661f\u96e8\u8207\u91cd\u8981\u5929\u8c61\u3002\u9ede\u9032\u8aaa\u660e\u53ef\u4e86\u89e3\u7279\u8272\uff0c\u4e26\u5b78\u5230\uff1a\u591a\u6578\u6d41\u661f\u96e8\u5176\u5be6\u662f\u5f57\u661f\uff08\u6216\u6bcd\u9ad4\uff09\u7559\u4e0b\u7684\u5875\u7c92\u9032\u5165\u5927\u6c23\u9020\u6210\u7684\u3002\n\n\u3010\u5be6\u666f\u8207\u5168\u5929\u7403\u3011\n\u7528\u5de6\u6416\u687f\u8abf\u6574\u300c\u5be6\u666f\u9732\u51fa\u300d\u9ad8\u5ea6\uff0c\u8b93\u661f\u7a7a\u8207\u623f\u9593\u4ea4\u63a5\u66f4\u81ea\u7136\uff1b\u518d\u5f80\u4e0b\u53ef\u9032\u5165\u5168\u5929\u7403\uff0f\u5b87\u5b99\u8996\u89d2\u3002\u4e5f\u80fd\u8f38\u51fa 360\u00b0 \u661f\u7a7a\u5716\u5206\u4eab\u3002\n\n\u3010\u591a\u8a9e\u7cfb\u3011\n\u4ecb\u9762\u8207\u4e3b\u8981\u5167\u5bb9\u652f\u63f4\u7e41\u9ad4\u4e2d\u6587\u3001English\u3001\u65e5\u672c\u8a9e\uff0c\u53ef\u5728\u8cc7\u8a0a\u5e73\u677f\u5e95\u90e8\u96a8\u6642\u5207\u63db\u3002\n\n\u8acb\u5728\u5b89\u5168\u7684\u904a\u6232\u7a7a\u9593\u4f7f\u7528\uff0c\u4e26\u9075\u5b88\u7576\u5730\u591c\u9593\u89c0\u6e2c\u8207\u96b1\u79c1\u898f\u7bc4\u3002\u672c\u61c9\u7528\u4ee5\u6559\u80b2\u8207\u6b23\u8cde\u70ba\u4e3b\uff0c\u661f\u66c6\u8207\u98df\u8c61\u70ba\u8fd1\u4f3c\u793a\u610f\uff0c\u5c08\u696d\u89c0\u6e2c\u8acb\u53e6\u53c3\u8003\u5929\u6587\u5e74\u66c6\u3002\n", "short_description": "Zen Stargazer \u628a\u771f\u5be6\u591c\u7a7a\u5e36\u9032\u4f60\u5bb6\uff1a\u6df7\u5408\u5be6\u5883\u661f\u7a7a\u3001\u6307\u661f\u89e3\u8aaa\u3
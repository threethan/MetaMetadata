8\u30a4\u30d9\u30f3\u30c8\u5e33\n\u5b9a\u756a\u306e\u6d41\u661f\u7fa4\u3084\u4e3b\u306a\u5929\u8c61\u3092\u4e00\u89a7\u3002\u898b\u3048\u65b9\u306b\u52a0\u3048\u3001\u591a\u304f\u306e\u6d41\u661f\u7fa4\u304c\u6bcd\u5929\u4f53\u306e\u5875\u304c\u5927\u6c17\u306b\u98db\u3073\u8fbc\u3080\u3053\u3068\u3067\u8d77\u304d\u308b\u3053\u3068\u306b\u3082\u89e6\u308c\u307e\u3059\u3002\n\n\u5b9f\u666f\u30fb\u4eee\u60f3\u30b7\u30fc\u30f3\u30fb\u5168\u5929\u7403\n\u5de6\u30b9\u30c6\u30a3\u30c3\u30af\u4e0a\u4e0b\u3067\u9732\u51fa\u9ad8\u3055\u3092\u8abf\u6574\u3057\u3001\u661f\u7a7a\u3068\u74b0\u5883\u306e\u5883\u76ee\u3092\u6574\u3048\u3089\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u4e0b\u3052\u308b\u3068\u5168\u5929\u7403\uff0f\u5b87\u5b99\u8996\u70b9\u3078\u3002\u5de6\u53f3\u3067\u30b7\u30fc\u30f3\u5207\u66ff\uff1a\u30d1\u30b9\u30b9\u30eb\u30fc\u3001\u307e\u305f\u306f\u4eee\u60f3\u773a\u671b\uff08\u9ad8\u5c71\u306e\u6e56\u30fb\u30ea\u30d3\u30f3\u30b0\u591c\u666f\u30fb\u7802\u6f20\u30fb\u96ea\u306e\u65c5\u9928\u30fb\u30b9\u30ab\u30a4\u30d0\u30fc\uff09\u3002\u30b9\u30ab\u30a4\u30d0\u30fc\u3067\u306f\u30b7\u30fc\u30f3\u3092\u304f\u308a\u629c\u304b\u305a\u3001\u661f\u3092\u91cd\u306d\u3066\u8868\u793a\u3002360\u00b0\u661f\u7a7a\u753b\u50cf\u306e\u66f8\u304d\u51fa\u3057\u306b\u3082\u5bfe\u5fdc\u3002\n\n\u591a\u8a00\u8a9e\nUI\u3068\u4e3b\u306a\u5185\u5bb9\u306f\u7e41\u4f53\u5b57\u4e2d\u56fd\u8a9e\u30fb\u82f1\u8a9e\u30fb\u65e5\u672c\u8a9e\u3002\u60c5\u5831\u30d1\u30c3\u30c9\u4e0b\u90e8\u3067\u3044\u3064\u3067\u3082\u5207\u308a\u66ff\u3048\u3067\u304d\u307e\u3059\u3002\n\n\u5b89\u5168\u306a\u30d7\u30ec\u30a4\u30a8\u30ea\u30a2\u3067\u304a\u4f7f\u3044\u304f\u3060\u3055\u3044\u3002OS\u304c\u6975\u7aef\u306b\u53e4\u3044\u5834\u5408\u306f\u8d77\u52d5\u3067\u304d\u306a\u3044\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u6559\u80b2\u30fb\u9451\u8cde\u5411\u3051\u306e\u8fd1\u4f3c\u8868\u793a\u3067\u3042\u308a\u3001\u5c02\u9580\u7684\u306a\u89b3\u6e2c\u306f\u5929\u6587\u5e74\u9451\u7b49\u3092
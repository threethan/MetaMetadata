": "s1.png", "id": "27277890455219981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622192_27277890461886647_6144819890961258044_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNGiovhuQJkQ7kNvwH1inCc&_nc_oc=Ado0EYRbjUB_eN6ToLw-T2NpCbiVhmWrfJ5Lb6-lnzGq2BB71AQbhOnEUt-aNR0eE24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV5CCmWV23k2ieJYmo8KyqgAHmYXg97-SDpdFnhAH2pA&oe=6ADE084A"}, {"file_name": "s2.png", "id": "1740338053754995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622192_1740338057088328_5743502730219685720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsgvZHv3fpEQ7kNvwFvPUXq&_nc_oc=AdorULC94dWn27fFJ706tvP5-1DIPApE0vF1K0UO1UpMozgyq7j8ByuVTj1GF6gFjDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEU5ultvfML4bjL1EnM9cVcQz_x8KqQDjhMdxeibub6A&oe=6ADE0DE4"}, {"file_name": "s3.png", "id": "27598478763164402", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623565_27598478766497735_7172931464418295918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEPClVxY_XUQ7kNvwHDx3yj&_nc_oc=Ado_VEyTFtIj3wYGiKE0iDKJbs6310vKI1n7UJg1MEYifVQKC_K9q5dHcB7zkWJaGLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSX31p1jgqY7tBIsWRq8fqM_1fGD690jhBlQsiFgcNMw&oe=6ADE1A22"}, {"file_name": "s4.png", "id": "1386180180309827", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620316_1386180183643160_806940499244554692_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BVYjJfH1cYQ7kNvwHVm5yY&_nc_oc=AdrdSRLlUSA9igwNC47BSmURN6JXUZkZosIkDP6I3IWCYGA-1mBO4QRsXlisQTLNEiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-YHTs7tXYm_2Ipa4JjlUAuDAey7KQ_AVBC__XIWYocA&oe=6ADE2708"}, {"file_name": "s5.png", "id": "1606231204345103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593942860_1606231207678436_4288968465108539005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svOI7gbnC2cQ7kNvwHzw9K2&_nc_oc=AdpoPuFjSiJVl7nrNszSvZQcifGGwdSh3sBQ1nCyEwuiYC0x11l3cdm-Y6BpYbFoIio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJsyHwJsBgfMoXrC8kHyk13UnBaVWgIq2ljje5JJvJYA&oe=6ADDFED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "star_cover.png", "id": "28725425130416810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623512_28725425140416809_5513349611134248212_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJeN12s1rpoQ7kNvwE7ETsT&_nc_oc=Adqho99lAb634lBFAvgjo5lyQhkWTGTV3YE-mIFLR5QesgMKdVeLwJJwyZ4C7d8hl_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM83sA5jh9jdfRwYnxevF9fpvXhiu06doLBGnRN_TL4zA&oe=6ADE0480"}, "display_name": "Zen Stargazer", "keywords": ["astronomy", "stargazing", "stars", "planets", "constellations"], "long_description": "Zen Stargazer is a mixed-reality stargazing experience for Meta Quest. Your room stays real; the sky above follows your chosen time and location.\n\nPOINT TO LEARN\nAim the right controller at the sky to identify stars, planets, nebulae, and galaxies\u2014with short educational notes for bright landmarks.\n\nTIME & PLACE\nFollow live \u201cnow,\u201d or lock a custom observing time. Pick a city on the world map and the sky updates instantly\u2014great for rehearsing a meteor peak or revisiting an eclipse night.\n\nCONSTELLATIONS & DEEP SKY\nToggle constellation lines, the ecliptic, and selected deep-sky objects. Some targets include public-domain astronomy imagery for context.\n\nPLANETS & MOON\nExplore planet phases and moon illumination with a telescope-style view. Jump chips help you hop to previous or next related sky events.\n\nMETEOR SHOWERS & EVENT BOOK\nBrowse classic showers and key sky events. Shower notes explain what you\u2019ll see\u2014and that most showers are dust from a parent body (often a comet) entering Earth\u2019s atmosphere.\n\nPASSTHROUGH & FULL SKY\nUse the left stick to adjust how much real-world passthrough is revealed under the virtual sky; push further for a full-sphere / space view. Export a 360\u00b0 sky still to share.\n\nLANGUAGES\nUI and core content support Traditional Chinese, English, and Japanese\u2014switch anytime from the info pad.\n\nUse in a clear guardian boundary. Zen Stargazer is for learning and wonder; ephemerides are educational approximations\u2014not a substitute for professional almanacs.", "short_description": "Look up in mixed reality on Meta Quest. Point to learn stars, planets, and deep-sky objects. Scrub time, choose your observing site, follow meteor showers and eclipses. A left-hand info pad keeps the sky in reach\u2014\u7e41\u4e2d / English / \u65e5\u672c\u8a9e."}]}, "developer_name": "Zen Chang", "developer_privacy_policy_url": "https://www.zenchang.com/2026/09/privacy-policy-zen-stargazer.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Chang", "support_website_url": null, "website_url": "https://www.zenchang.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1880895619984995"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1613499547114316"}, {"status": "PUBLISHED", "id": "2102467110387075"}]}, "baseline_offer": {"id": "2102467110387075"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1613499547114316"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "
.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJMnAoFKd-IQ7kNvwGZRRk0&_nc_oc=AdprvmsUyqRAhdTBTDxhQfhAgKLkGXpK0Z5Fye6Z-LxSNhq_mIfzu8DRvcj7wm6Ti4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOiYLBbzH5Brnsaze7X59bR-YkXdD5iwUotimyTt0X-w&oe=6AAFE964"}, {"file_name": "s3.png", "id": "27598478763164402", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623565_27598478766497735_7172931464418295918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olio6YvsdrgQ7kNvwHx-6lU&_nc_oc=Adpk2Ti-18KNM3LYANlBoyXDieU1ZYMLtpW8vskfgeoAD3Aqhel_-J1K8wPBPy6C-is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6IvpGVq3Xbew4QZn5vDxz0GpJxlCjUvLASAjTZEDQ7A&oe=6AAFF5A2"}, {"file_name": "s4.png", "id": "1386180180309827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_1386180183643160_806940499244554692_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzMQMPWRQgoQ7kNvwE86KuM&_nc_oc=AdpItwc1gXf8KVsd-J_D7KWqO9FQYSl3wJJdxz_oredO7FxGaUIQCNitfiGpLaa27A8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM2MeR5oTZQHfZprQs95mZCcQYphfY-7Z98mvMK2bwLw&oe=6AB00288"}, {"file_name": "s5.png", "id": "1606231204345103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593942860_1606231207678436_4288968465108539005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmWgJeeFR1QQ7kNvwG5DhSl&_nc_oc=Adqum2lLQjrRprq2JiKx52-IPRCW-iNHBXkFz7ppXiBJ47wxbsS8vvnQ6VzBtxHhQk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4JfdPEfNWr_y8dN8ZYaMo3Xk3uY-WOQpBIushKSwNbg&oe=6AAFDA55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "star_cover.png", "id": "28725425130416810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623512_28725425140416809_5513349611134248212_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn8qmbwjFzEQ7kNvwEoStcQ&_nc_oc=AdowNxTEYsGQZ0w4y4bw-wjVk48IxAdrM88AIFwGZJ1IHC7YZnHBrDwxY1ZTE5idOYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKznI5u-8OkIxjOt3UZkIB0Kgqwp9-2O8pKzSVD-JdX7Q&oe=6AAFE000"}, "display_name": "Zen Stargazer", "keywords": ["astronomy", "stargazing", "stars", "planets", "constellations"], "long_description": "Zen Stargazer is a mixed-reality stargazing experience for Meta Quest. Your room stays real; the sky above follows your chosen time and location.\n\nPOINT TO LEARN\nAim the right controller at the sky to identify stars, planets, nebulae, and galaxies\u2014with short educational notes for bright landmarks.\n\nTIME & PLACE\nFollow live \u201cnow,\u201d or lock a custom observing time. Pick a city on the world map and the sky updates instantly\u2014great for rehearsing a meteor peak or revisiting an eclipse night.\n\nCONSTELLATIONS & DEEP SKY\nToggle constellation lines, the ecliptic, and selected deep-sky objects. Some targets include public-domain astronomy imagery for context.\n\nPLANETS & MOON\nExplore planet phases and moon illumination with a telescope-style view. Jump chips help you hop to previous or next related sky events.\n\nMETEOR SHOWERS & EVENT BOOK\nBrowse classic showers and key sky events. Shower notes explain what you\u2019ll see\u2014and that most showers are dust from a parent body (often a comet) entering Earth\u2019s atmosphere.\n\nPASSTHROUGH & FULL SKY\nUse the left stick to adjust how much real-world passthrough is revealed under the virtual sky; push further for a full-sphere / space view. Export a 360\u00b0 sky still to share.\n\nLANGUAGES\nUI and core content support Traditional Chinese, English, and Japanese\u2014switch anytime from the info pad.\n\nUse in a clear guardian boundary. Zen Stargazer is for learning and wonder; ephemerides are educational approximations\u2014not a substitute for professional almanacs.", "short_description": "Look up in mixed reality on Meta Quest. Point to learn stars, planets, and deep-sky objects. Scrub time, choose your observing site, follow meteor showers and eclipses. A left-hand info pad keeps the sky in reach\u2014\u7e41\u4e2d / English / \u65e5\u672c\u8a9e."}]}, "developer_name": "Zen Chang", "developer_privacy_policy_url": "https://www.zenchang.com/2026/09/privacy-policy-zen-stargazer.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Chang", "support_website_url": null, "website_url": "https://www.zenchang.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1880895619984995"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499627379_1135603582374314_981033053078344399_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSs_WArqMpcQ7kNvwG3J7ec&_nc_oc=Adp4WxIyUJJtl2vu3UKhhAYgCq_tIMxpS1XVjgESXf9NxLnuBjqO-LqQGLL6VQMgsJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0AMOuFe_8GM_OaN61hZ68Qh61z5F0w5Ll6xuQxNSfzQ&oe=6AAFF4D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Stargazer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1789137300, "lastRevision": {"nodes": [{"id": "1880895623318328", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "188089561331832
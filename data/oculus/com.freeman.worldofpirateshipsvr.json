3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvG0MbpihON9F_9gxGdsignm_7Nolu5hLcWf9R-TlGqQ&oe=69A2E892"}, {"file_name": "migrated_image.png", "id": "579086999621601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162711_1333027490109621_660558634320658432_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvVnYXwWwnEQ7kNvwF32hfR&_nc_oc=AdlqMMgFV_ySQLwzgTfAarVIwFvmzLQwdv6XFUmGzVbc5xr5tdSwlta96EJeArqgh-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNS4KhXGGeHBhcKArj_TbG1QW9XhcLH5XFY1HK3ovi1w&oe=69A2F2D7"}, {"file_name": "migrated_image.png", "id": "223532215697533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_1868061243516895_3926227663395487744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wayyk5NqM04Q7kNvwE6op3J&_nc_oc=AdnTRjNI6hREbrDgTS26EZ4Xq-2634oK1eXSsH_jyxi-IZ9o_hrB-O2YDT1QFsSUD-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfszuPQg5WDhD6sTVJF1D46Uwd2wOUlBbMiOXmwdQ6LJ9g&oe=69A2EC87"}, {"file_name": "migrated_image.png", "id": "202235014431637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162812_227276104426861_1479288248294440960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfhTM_3C3NkQ7kNvwFmab4l&_nc_oc=AdmfL4CA_KhKOH7X_tkGpsxXCzhNIqS8KgZFK38I2paD2iF4n5nKT6oiJR7aYIl4yx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftg4XpsabFgwJS3uR7qkXhaVWDG2iUZAeJ0lkhDExjPpg&oe=69A2DFD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Of Pirate Ships", "keywords": ["Pirate", "Ship", "Warship", "Sea", "Battle"], "long_description": "World Of Pirate Ships is a classical, free for all, death-match, multiplayer only, game for 10 players (ships) per map. The goal is to destroy, as many as you can, enemy ships . Each round is 10 minutes long after which map changes. For every hit with your cannon you get gold. If you hit bigger ship, you'll get more gold. You can spend it on upgrades or new ships. Controls are very simple. Just tap and hold on the water to set new direction for the ship, tap to shoot, swipe down and up to change cannons.\n\nGood luck captain!", "short_description": "Immerse yourself into the world of large scale sea battles with pirate warships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simeunovicn13.wixsite.com/catchygames", "developer_terms_of_service_url": "https://simeunovicn13.wixsite.com/catchygames", "publisher_name": "Catchy Games", "support_website_url": null, "website_url": "https://simeunovicn13.wixsite.com/catchygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "493385415490762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162695_1663921180288142_5109387502997733376_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii8g9XiBSEoQ7kNvwEV52LO&_nc_oc=AdmpMN2Y4yA1dzwrXqSdrMoE55oh0GXsF-FneS7Hwf8Ngqq7VEiwfxSLibkmxsmTHuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1aMhjJobH8IMBlmNt7E3DZ3DQQwms2HsCoCgLeBT-nQ&oe=69A2FCDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "World Of Pirate Ships", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1496851267, "lastRevision": {"nodes": [{"id": "1691185314510689", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1491256844278639", "is_first_party": false, "
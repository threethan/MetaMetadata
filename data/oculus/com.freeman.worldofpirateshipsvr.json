wPedB_jrMQ7kNvwHvoMyp&_nc_oc=AdoGJlSUl3HWSpk2fLs_m4ES7yZ4Rl0M81avu63PT0A_yXIHb5HzEvT_kXbByFkXnW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YYgLBNI9zefk5YD4c8xVqS-Lc0Lw1MsFngtSsZNkAnA&oe=6A202712"}, {"file_name": "migrated_image.png", "id": "579086999621601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162711_1333027490109621_660558634320658432_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGB8wPBXiukQ7kNvwEHuhcG&_nc_oc=AdpiDq3jlEILu8ydBDPgFwmtxuG3g-Mpwe7B2OJfc3uLB2N12MvZqCiyUs3nuwj99Vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6idwSgunWqvMEt2cM3hbkNubmbFNshAi2b-5aZIr4xPA&oe=6A203157"}, {"file_name": "migrated_image.png", "id": "223532215697533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1868061243516895_3926227663395487744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5zHoYzFAJQQ7kNvwGLCyKT&_nc_oc=AdrizBLWG6FV-j0JPMQ2LAsV6ez2aIu4Lzfc5Nz9g3glmfTUZ8Y0bRXDqaYksXp1B-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CknPo6plggjzwp3JYNl1YjDc8VP6BMgltDmjQyN8EEg&oe=6A202B07"}, {"file_name": "migrated_image.png", "id": "202235014431637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162812_227276104426861_1479288248294440960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxppzDztPtYQ7kNvwEaGeqr&_nc_oc=Adq-QRIf1dTTmc3w0DW93hL-PgOHecYIpIX2uYIKdQhmRmPLvX-bnB58kwj-9XWzIvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MDVfSjbjsI1OBRPnB2uo7HT7L_BKCAlMwl_sXfUeCKg&oe=6A201E52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Of Pirate Ships", "keywords": ["Pirate", "Ship", "Warship", "Sea", "Battle"], "long_description": "World Of Pirate Ships is a classical, free for all, death-match, multiplayer only, game for 10 players (ships) per map. The goal is to destroy, as many as you can, enemy ships . Each round is 10 minutes long after which map changes. For every hit with your cannon you get gold. If you hit bigger ship, you'll get more gold. You can spend it on upgrades or new ships. Controls are very simple. Just tap and hold on the water to set new direction for the ship, tap to shoot, swipe down and up to change cannons.\n\nGood luck captain!", "short_description": "Immerse yourself into the world of large scale sea battles with pirate warships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simeunovicn13.wixsite.com/catchygames", "developer_terms_of_service_url": "https://simeunovicn13.wixsite.com/catchygames", "publisher_name": "Catchy Games", "support_website_url": null, "website_url": "https://simeunovicn13.wixsite.com/catchygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "493385415490762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162695_1663921180288142_5109387502997733376_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0-sjpD7qS8Q7kNvwEtOy2g&_nc_oc=AdrzKiJ2uBXnaTYKLGESf8dR0ct051HicWTFY1RHilqYXPk4sZGsaIw8NCIclnH0oO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af428SwLy9Je58JENZmqQf4VVpAlmbgFO14ysCwMLNZ3Tg&oe=6A203B5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "World Of Pirate Ships", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1496851267, "lastRevision": {"nodes": [{"id": "1691185314510689", "release_
 get gold. If you hit bigger ship, you'll get more gold. You can spend it on upgrades or new ships. Controls are very simple. Just tap and hold on the water to set new direction for the ship, tap to shoot, swipe down and up to change cannons.\n\nGood luck captain!", "short_description": "Immerse yourself into the world of large scale sea battles with pirate warships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simeunovicn13.wixsite.com/catchygames", "developer_terms_of_service_url": "https://simeunovicn13.wixsite.com/catchygames", "publisher_name": "Catchy Games", "support_website_url": null, "website_url": "https://simeunovicn13.wixsite.com/catchygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "493385415490762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162695_1663921180288142_5109387502997733376_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiJLE69RWDEQ7kNvwFGaH-3&_nc_oc=AdpgNys5_fPh9UjuqBhc-OL0nai51D0BJ_vBWSOCp5_g9BPmkY6RG8YHNC9vW0SzO1E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gg04St0C_Q1cwCS-i86D46WdrLSeA4jn67c6kHXEC1A&oe=6A36A4DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "World Of Pirate Ships", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1496851267, "lastRevision": {"nodes": [{"id": "1691185314510689", "re
6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DBnTltKYNsQ7kNvwGgssun&_nc_oc=AdqH7_kOEi3RsQnCQUxBpMhgM7YRRItcvPEk1UqmcHG7GwtrQUmGSYVtkX3wgvPoBHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReKr5gq1jwFcuvTunAMEk7GOBOBgwcG3gYF_zQjhbFrw&oe=6B09B40C"}, {"file_name": "canais - meta v2.png", "id": "851871534511956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305194_851871537845289_7085838574884503484_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ly4TLWegYIQ7kNvwG0s_NJ&_nc_oc=Adpb5R0N3SU-EASOSOYDEu0b1z25lC_qVAnEnXpkNQxTpV5HqnpLCbzkyvlPKpe7XBo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0E1aXy60uDQRWz3R-kus-sA75cZOi-X85kofAOVFTTQ&oe=6B09A422"}, {"file_name": "filmes - meta v2.png", "id": "1540527390340509", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308103_1540527393673842_8006608287092864881_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Bt3Jq83KFoQ7kNvwH9K8_o&_nc_oc=Adp9agbHfD1BD107VsjXQpE7svClKrm1p11Xmyd11JJrzRqSH_pWze5Dx07y1Cnude0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnYz2RIrcID2vNCRLG-gTTs-ViWDc4avsL4ZCDpBfDFA&oe=6B09CAA1"}, {"file_name": "series - meta v2.png", "id": "1538451210751013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307339_1538451214084346_2473427039894571473_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d44Eo7Hc3KsQ7kNvwG4qU6E&_nc_oc=AdoEJ4ggBgTSU01xYl_3JWIVy9fOgjZirmBM79ym5KvrMqmyTyoie_pJ5IwGHgk2dT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5bq-5SqJgPtLvWI0dmBRvbrlBAXEkeobEJyWzJYD28g&oe=6B09A670"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IPTV Smart Cast", "keywords": ["IPTV", "Streaming", "Movies", "Series", "TV"], "long_description": "Elevate your streaming experience. **IPTV Smart Cast** combines an elegant interface with advanced tools to ensure the best playback, free from buffering in your virtual theater.\n\n### Exclusive Features:\n\n* **\ud83d\udcfa Chromecast Support:** Watch Movies/Series on the big screen! Cast VOD content to your Chromecast with a single click.\n* **\ud83d\ude80 Maximum Performance:** Unleash full power with Hardware Acceleration decoding, ensuring smooth playback at high resolutions.\n* **\ud83d\udee1\ufe0f Built-in DNS Switcher:** Is your ISP throttling? Change DNS settings in-app (Google, Cloudflare, AdGuard) to improve connectivity.\n* **\ud83c\udfac Premium VOD Experience:** Organize your library with official posters, detailed synopses, and cast info.\n* **\u23ef\ufe0f Resume Playback:** Started a movie and had to leave? The app remembers exactly where you left off.\n\n### Essential Features:\n\n* **Xtream Codes Connection:** Fast login using only URL, Username, and Password.\n* **Electronic Program Guide (EPG):** View real-time scheduling for every channel.\n* **Favorites Manager:** Create your custom list of preferred channels.\n* **Modern Interface:** User-centric design optimized for a seamless experience.\n\n> **Disclaimer:**\n**IPTV Smart Cast IS A MEDIA PLAYER AND DOES NOT PROVIDE CONTENT. Users need access credentials (User/Pass/URL) compatible with Xtream Codes API, and are responsible for content used.**", "short_description": "The ultimate player for Meta Quest. Xtream Codes support, VOD Casting to Chromecast, native DNS Switcher, EPG, and Hardware Acceleration. (No playlists included)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1ngJS-sf_9yk6shAJv9Dyu9Yrs2dRwlVB/view?usp=drivesdk", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/IPTV-Smart-Cast-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
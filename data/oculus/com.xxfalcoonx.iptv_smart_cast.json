ss=7f20f&oh=00_AQRDVt7102LW8V34gWsyGz5v8OaAF4Iq8J7qkihExgNkSA&oe=6AECB30C"}, {"file_name": "canais - meta v2.png", "id": "851871534511956", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305194_851871537845289_7085838574884503484_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrgHZKLdcs0Q7kNvwFkWtuC&_nc_oc=Adqe-Lt00wU67_apH-2_3Z4uYFzKtwufGg8DnTVcP9_qdt31-lBmpphubFRE-SgqbHk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoMqMEAD9v7J9tJmD6bdLgCSfM7Ot_uvPpCzTTt5bPeg&oe=6AECA322"}, {"file_name": "filmes - meta v2.png", "id": "1540527390340509", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308103_1540527393673842_8006608287092864881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVmYrm-AEyIQ7kNvwG2UIU5&_nc_oc=AdpImWqmFjMtMUrmWROY3FNJ0dntruyIZ2mZ_k6H8uNSkdcy527WakGllJOli7tCPeU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlj7jd9RjNFPC-x9PRcfLEmAI-dlSq1fUIxQM9lXD8lw&oe=6AEC9161"}, {"file_name": "series - meta v2.png", "id": "1538451210751013", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307339_1538451214084346_2473427039894571473_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDNnIUGdf5gQ7kNvwG1TZRh&_nc_oc=AdqBA_7PLHAeNjzYIPMZnpoUVA8ATJu2Knu0A8tZh77lIJWurXoIirqD55tAyFPxA_0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB7QxAJqARxOEOdR7GR_-nL4wbdVuK1qLGBrXVkcqQDg&oe=6AECA570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IPTV Smart Cast", "keywords": ["IPTV", "Streaming", "Movies", "Series", "TV"], "long_description": "Elevate your streaming experience. **IPTV Smart Cast** combines an elegant interface with advanced tools to ensure the best playback, free from buffering in your virtual theater.\n\n### Exclusive Features:\n\n* **\ud83d\udcfa Chromecast Support:** Watch Movies/Series on the big screen! Cast VOD content to your Chromecast with a single click.\n* **\ud83d\ude80 Maximum Performance:** Unleash full power with Hardware Acceleration decoding, ensuring smooth playback at high resolutions.\n* **\ud83d\udee1\ufe0f Built-in DNS Switcher:** Is your ISP throttling? Change DNS settings in-app (Google, Cloudflare, AdGuard) to improve connectivity.\n* **\ud83c\udfac Premium VOD Experience:** Organize your library with official posters, detailed synopses, and cast info.\n* **\u23ef\ufe0f Resume Playback:** Started a movie and had to leave? The app remembers exactly where you left off.\n\n### Essential Features:\n\n* **Xtream Codes Connection:** Fast login using only URL, Username, and Password.\n* **Electronic Program Guide (EPG):** View real-time scheduling for every channel.\n* **Favorites Manager:** Create your custom list of preferred channels.\n* **Modern Interface:** User-centric design optimized for a seamless experience.\n\n> **Disclaimer:**\n**IPTV Smart Cast IS A MEDIA PLAYER AND DOES NOT PROVIDE CONTENT. Users need access credentials (User/Pass/URL) compatible with Xtream Codes API, and are responsible for content used.**", "short_description": "The ultimate player for Meta Quest. Xtream Codes support, VOD Casting to Chromecast, native DNS Switcher, EPG, and Hardware Acceleration. (No playlists included)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1ngJS-sf_9yk6shAJv9Dyu9Yrs2dRwlVB/view?usp=drivesdk", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/IPTV-Smart-Cast-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
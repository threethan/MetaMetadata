6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVjzmUCgjQsQ7kNvwExMFAT&_nc_oc=AdoU0hge2nhbYQCuOQoa0BGRSz6PZeqrMQkXctkdEr50eUSaYrX0AqukWC4st5De1GA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOKcNrIJiC6cKCimkZEO9NLK0feJiaGRj5tq9bSOHrPQ&oe=6B031C8C"}, {"file_name": "canais - meta v2.png", "id": "851871534511956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305194_851871537845289_7085838574884503484_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY0L9yQgkjEQ7kNvwFdlS8W&_nc_oc=Ado8RwlSFdH1eS8Z8k1YYs9WrGdJc4B_jz6_jdlwuW3uJm51gguVA_oUzhEp_WD89l0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX0EAa7Sx9_TEGrjAbveZcSCVzRwFEYKgUf8h3z1Ox2A&oe=6B030CA2"}, {"file_name": "filmes - meta v2.png", "id": "1540527390340509", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308103_1540527393673842_8006608287092864881_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE9jueaUF7YQ7kNvwEXlf_u&_nc_oc=AdrK2JhwzDjSAf3r-NG2MYeBitnDCLJxOLaRAojVA3dfPCYjJGMV9WNB4vN8mCOQreU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5nP1BuP7mtCBUMDsNPlem6vY2erkeRssIvepnksL4og&oe=6B033321"}, {"file_name": "series - meta v2.png", "id": "1538451210751013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307339_1538451214084346_2473427039894571473_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWxL3aKbJT8Q7kNvwHVyqkt&_nc_oc=Adr0VkVXGYXhy4kCw3eO_wvsfCA34G-OdcqrHi3qetShkJMkEnEh1AmMNx5fjyKs-l4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZFfdaDDRvuzFZvYXcFuma_IpwSvYPanURsfn41Sdrjw&oe=6B030EF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IPTV Smart Cast", "keywords": ["IPTV", "Streaming", "Movies", "Series", "TV"], "long_description": "Elevate your streaming experience. **IPTV Smart Cast** combines an elegant interface with advanced tools to ensure the best playback, free from buffering in your virtual theater.\n\n### Exclusive Features:\n\n* **\ud83d\udcfa Chromecast Support:** Watch Movies/Series on the big screen! Cast VOD content to your Chromecast with a single click.\n* **\ud83d\ude80 Maximum Performance:** Unleash full power with Hardware Acceleration decoding, ensuring smooth playback at high resolutions.\n* **\ud83d\udee1\ufe0f Built-in DNS Switcher:** Is your ISP throttling? Change DNS settings in-app (Google, Cloudflare, AdGuard) to improve connectivity.\n* **\ud83c\udfac Premium VOD Experience:** Organize your library with official posters, detailed synopses, and cast info.\n* **\u23ef\ufe0f Resume Playback:** Started a movie and had to leave? The app remembers exactly where you left off.\n\n### Essential Features:\n\n* **Xtream Codes Connection:** Fast login using only URL, Username, and Password.\n* **Electronic Program Guide (EPG):** View real-time scheduling for every channel.\n* **Favorites Manager:** Create your custom list of preferred channels.\n* **Modern Interface:** User-centric design optimized for a seamless experience.\n\n> **Disclaimer:**\n**IPTV Smart Cast IS A MEDIA PLAYER AND DOES NOT PROVIDE CONTENT. Users need access credentials (User/Pass/URL) compatible with Xtream Codes API, and are responsible for content used.**", "short_description": "The ultimate player for Meta Quest. Xtream Codes support, VOD Casting to Chromecast, native DNS Switcher, EPG, and Hardware Acceleration. (No playlists included)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1ngJS-sf_9yk6shAJv9Dyu9Yrs2dRwlVB/view?usp=drivesdk", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/IPTV-Smart-Cast-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
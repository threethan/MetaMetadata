838574884503484_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4WKSy1YVLgQ7kNvwFxbsYe&_nc_oc=AdmOiHbNeXe2_g7lj2x9eWqtk2u15eOU7lIVN-SWjZrO-BAls5qKDDCnAnFDa8crE0k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftd2a7WFCmWpryQaKsqDdQ2AJluLKPqJqAFj691TC2kYg&oe=69A576E2"}, {"file_name": "filmes - meta v2.png", "id": "1540527390340509", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308103_1540527393673842_8006608287092864881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oZUbmW7xWsQ7kNvwEy3TmP&_nc_oc=AdkDk_e2kb5uliBKQzI480CiAyjX-Nd06NaA-U8EbPWiL9REsFeB1Nun2Y7sHZa70U8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs-DqN53cImeF56Nnr_99_X-ZPbFDzStNR1n9nGPGi3QA&oe=69A59D61"}, {"file_name": "series - meta v2.png", "id": "1538451210751013", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307339_1538451214084346_2473427039894571473_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8llfxS3V31EQ7kNvwHY8mtO&_nc_oc=Adls_5x9YoAvQ_fe5CQJ2yzgpNcAbpPL2P_k6Hdu6H84EDAqx2B3MXzSiHyu70xyawI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvBn2l9PYRYwPey4fmjTFf2TZaGFFEngzkj_kpFi8-J2Q&oe=69A57930"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IPTV Smart Cast", "keywords": ["IPTV", "Streaming", "Movies", "Series", "TV"], "long_description": "Elevate your streaming experience. **IPTV Smart Cast** combines an elegant interface with advanced tools to ensure the best playback, free from buffering in your virtual theater.\n\n### Exclusive Features:\n\n* **\ud83d\udcfa Chromecast Support:** Watch Movies/Series on the big screen! Cast VOD content to your Chromecast with a single click.\n* **\ud83d\ude80 Maximum Performance:** Unleash full power with Hardware Acceleration decoding, ensuring smooth playback at high resolutions.\n* **\ud83d\udee1\ufe0f Built-in DNS Switcher:** Is your ISP throttling? Change DNS settings in-app (Google, Cloudflare, AdGuard) to improve connectivity.\n* **\ud83c\udfac Premium VOD Experience:** Organize your library with official posters, detailed synopses, and cast info.\n* **\u23ef\ufe0f Resume Playback:** Started a movie and had to leave? The app remembers exactly where you left off.\n\n### Essential Features:\n\n* **Xtream Codes Connection:** Fast login using only URL, Username, and Password.\n* **Electronic Program Guide (EPG):** View real-time scheduling for every channel.\n* **Favorites Manager:** Create your custom list of preferred channels.\n* **Modern Interface:** User-centric design optimized for a seamless experience.\n\n> **Disclaimer:**\n**IPTV Smart Cast IS A MEDIA PLAYER AND DOES NOT PROVIDE CONTENT. Users need access credentials (User/Pass/URL) compatible with Xtream Codes API, and are responsible for content used.**", "short_description": "The ultimate player for Meta Quest. Xtream Codes support, VOD Casting to Chromecast, native DNS Switcher, EPG, and Hardware Acceleration. (No playlists included)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1ngJS-sf_9yk6shAJv9Dyu9Yrs2dRwlVB/view?usp=drivesdk", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/IPTV-Smart-Cast-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26640004655589351"}}]
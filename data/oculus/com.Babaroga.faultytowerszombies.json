735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch4_iyAR83IQ7kNvwFV62yE&_nc_oc=AdrKh9K5Gxnb4F72ScnW9-rA39WESwf7UDuHYr-CGnDnJdjw2H_BbPWRq4H8iZ1mkiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChmodZPZQwcxwD6BYW26mkbG_BEZrAnrdXR3KbjoJ9YQ&oe=6A4A7234"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6qZnXGfdEUQ7kNvwGDNIHx&_nc_oc=AdpgzBSytd6ksmkfy0CTXYnLSetJiBqzmp9AQYcFcANjfYL8QcKNgW9uWAdA8Ymp1eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW9QruVKu9_Xne-sRHyq8q7orAC926YB14-edWfkuemQ&oe=6A4A54B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixKy8oLRyeEQ7kNvwHi9Mk8&_nc_oc=Ado4_85qRcaTGTs8at0Va4J4gmr44znirq_UgANNa1yyC8QOYV7wCROw6q-oX5Ipjdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDmcYTPl54DnvPp7heEiN3VDenMPbpDGUqZ_PN7nHw7g&oe=6A4A8434"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
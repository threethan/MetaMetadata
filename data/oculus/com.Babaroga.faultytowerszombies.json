735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuG6PBsrSrYQ7kNvwExWSJp&_nc_oc=AdpuP4_h0Ip5zOekw4X4bQ_cMWbX11JuS0exI39wjFQ4eAy8ILpisrTI3PW9bniCEJI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1WJeu6nJUPMQK8tzR_aV96_20_LWPArQEj-R5MwbKew&oe=69C7B574"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h13_u2ydTfgQ7kNvwGqTjLf&_nc_oc=Adoqku6FTgr9NTBzVGOcr6BDb-glj_J37X9GafJ15KP10xrgdl4hn-d196dfO1jxDoM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjZE3d_WoFxycPiwnKlpQt1KKg5i_zCtXNuPZb1E9HwA&oe=69C7D037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7HAAnlU0T8Q7kNvwESSFEd&_nc_oc=AdopARca-J1VQEh49pi0MoT-_A9lhOb8hL0Dv6HLauPG7_vGkrBxCBALROfqiNdVBHQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiiDhI3t8L9stglnK9WKphBDVejLQGPXXbpoRE884E7Q&oe=69C7C774"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
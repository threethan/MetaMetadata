735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZVUb8hCPnwQ7kNvwHEB5Hy&_nc_oc=Adpxqx7JsKRn4DbT6m_qCzAtGt-aa8b230wLg4DJahKV3NvqVR-AJcbplY7qPgBE33w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GW54-nzLakrM50UA-qHAkalEbTAD_9lWNwJSRtg7s0A&oe=6A2193B4"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzMK_Lm6Q-QQ7kNvwG4WtiA&_nc_oc=AdqWNsIhhO0KCHPKh94maaXB62oLSYAHTb4ERwunM6VRUjNYqm_jainl5DQMUqDuZW4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PdMdfMxT-GdnmF3h8lNpbz7kRKC_gY8sGZUyJ4fRATQ&oe=6A217637"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J96pnRjO1OoQ7kNvwES0DBy&_nc_oc=Adp7Q0yJmysXXbNDj_DcH4LLdUjPr_Td-kh_yfXdPzmeHeZ-m9jdAY9ak3OG7jWHr48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AWEfLdzSp5AugMRJsQHopJDVoZVkXafJVSyHuAu-QgA&oe=6A21A5B4"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
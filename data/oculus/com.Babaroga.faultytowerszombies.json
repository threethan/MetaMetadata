SR8743V_097WGnKhyzLDGYl5i_QLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z6da-KFTV6VtboX7VTEcGdeozM4gFCPdIm1_02bhijA&oe=69E392AC"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["zombie", "escape", "puzzle", "tower", "jenga"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape."}]}, "developer_name": "Babaroga, LLC.", "developer_privacy_policy_url": "https://www.babaroga.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Babaroga, LLC", "support_website_url": null, "website_url": "http://babaroga.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25
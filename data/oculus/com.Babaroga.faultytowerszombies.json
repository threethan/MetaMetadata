railer_thumbnail": {"file_name": "OculusRift_CoverImage.png", "id": "1449009752638580", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982447_1449009755971913_7234243612852457388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWcWCkvdekUQ7kNvwHJBHYv&_nc_oc=AdrNVjODCYRtDinP4mFnHg0cOqZ1vzgHRqcRkiKWetGryKgFMedg0PrxBPrLaVnBR6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPJ8ExiLWIH-5pCoAcn4aftoTa1hQe_nVz_uXbbB98uw&oe=6B05D4EC"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["zombie", "escape", "puzzle", "tower", "jenga"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape."}]}, "developer_name": "Babaroga, LLC.", "developer_privacy_policy_url": "https://www.babaroga.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Babaroga, LLC", "support_website_url": null, "website_url": "http://babaroga.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_conne
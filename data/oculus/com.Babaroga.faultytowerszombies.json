735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vusVrzOQ0eIQ7kNvwEPGgGf&_nc_oc=AdoGw_N-VSG3HSK2ez9cRZNrdOFiKJEyMHbL3VFpF77o5VNmG92Sxt-66WS2IQ9Stbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfgX9RU5nvExmYUjaxSghJEOa_28-s4Rd9IryAB1LwmQ&oe=6A6DD274"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ertqA5eGWEsQ7kNvwGLe2q0&_nc_oc=AdolC9MOqEFE5U-2mDpWT5uEaArzEO92QlhGN7rCjlU2vsguZS990zGL8nYk3t3xMzI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI-O1dbdrQBPhtVf1IWFYl9sgGa9RamIoH7dvExtxvQQ&oe=6A6DED37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znZiB3-RGSgQ7kNvwFrVKxq&_nc_oc=AdreMNCOd35X2nPo5SjvhwAdINRentA8hFV_RZJoHjWyL0wwh8pBI6x13yvPwHFRYNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBliKikPzjO3hQkpj69U4o0DV4nFEWCAtHVmJDINhIf5w&oe=6A6DE474"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oz0VI6FJuAwQ7kNvwHfEwEO&_nc_oc=AdrburXgIqdLzU4G6yWk7TJ1vGhURpbutW8A6uXzNamRI8R3WWbacpDA2fMHeeV348g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I3t15Io9GVQlIoiDnfh3OC7V5e3rDgcMzRaaDO6HS_g&oe=6A3FE634"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV3o52ylOVsQ7kNvwEhPioI&_nc_oc=Adp0I4xyw_YzIgX1R0dYrHvX-TMnsXECB8NyrCUl7efIEXzFJ630peETnyk47r-Cdig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ofkzSR9sq5wfWTJKoqfHkuqZvoz2gqggr8WPeqLM6yg&oe=6A3FC8B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVP0fNQXN_sQ7kNvwHZsRMz&_nc_oc=AdqK0fhWeJ7ZyWUViDVBNn2ilk5vU9cVK6o4jIt_qFKxUyKRm693Sukmio9CoQMhM1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nfNJxKdpmiWBCE06NGnNTnh3PGPznbEDJx4J11CE2mw&oe=6A3FBFF4"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
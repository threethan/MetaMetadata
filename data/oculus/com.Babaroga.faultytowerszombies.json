 very hungry and very still. There is a limited amount of time within which the player can escape."}]}, "developer_name": "Babaroga, LLC.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Babaroga, LLC", "support_website_url": null, "website_url": "http://babaroga.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1483342132060964"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2153284301632931"}, {"status": "PUBLISHED", "id": "276501523255891"}, {"status": "PUBLISHED", "id": "3052883784727100"}, {"status": "PUBLISHED", "id": "3686103971416676"}, {"status": "PUBLISHED", "id": "460669811198380"}, {"status": "PUBLISHED", "id": "425503495032137"}, {"status": "PUBLISHED", "id": "2582974221807572"}, {"status": "PUBLISHED", "id": "890480244680723"}, {"status": "PUBLISHED", "id": "920387571631676"}]}, "baseline_offer": {"id": "276501523255891"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1575262800, "status": "PUBLISHED", "id": "2153284301632931"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3388410664534787", "version": "1.0"}, "id": "405710726678650", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "A
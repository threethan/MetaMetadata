735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO2VDZ3avF4Q7kNvwGXy4eY&_nc_oc=AdoYvzRSl3xjEGZm_uDt2R4sk87bKuhQqBsPgfi2ripyOm_T91J0JRXSU_qotaCb3hM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PrFpYkxVvxVAQCm35qY5yucUZewVqpGpDJbb9FIozAA&oe=69F4C0B4"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TccqsuP7fs8Q7kNvwECoIy2&_nc_oc=AdqLfvmAT4evbicqLw96nKsdCTpSwlp4ZoEnuMBGpyD0wZF-2-TVn3ixTiILJaXUqfg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cYDMezzXNxZOBVxihBa_Fw_i4wKVWuUip_QOZhCqGhg&oe=69F4A337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fY6czKRbpUQ7kNvwHE3-gm&_nc_oc=Adoql1ZOecVRwKCYj14BaQ8QU3fw7AtVe_czIRii5BOkPrD0XX0R8Enlzl35E0SwDGc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3l4Lb8mAhtGkUWq5JlmUTRe1oFi3GagdwizKEdlxHVoA&oe=69F49A74"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
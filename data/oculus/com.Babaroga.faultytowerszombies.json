735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFYcCP2hvE0Q7kNvwHRzpGn&_nc_oc=AdpNxhepTWl13B3I58ypLYOI0jxsCrTLL_E8D9AkuCOT29Po8Pj-KeFJ8yDD6L0nHtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdE85gfhmuNRvDyfrkR1X0gJfAbGpACv37poNDYIY9rg&oe=6A998C34"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OksitbndhQ0Q7kNvwGw8KuG&_nc_oc=Ado4eKOUU4fb0h18lDCWo37rCwc62tFMHtqmjN2LbvZ_cAHm7IGmTkIJgMT9reIWwN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZg-3He_6XjenvQp7NkthWF5WRTF-ogNx87Cmd_f9ZPw&oe=6A996EB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLYVAP53xH4Q7kNvwFy6UZV&_nc_oc=Adq4en8MxviYSg5OAzanhsut8SZ5zhVtNoK-1BaG3O-YhAqDXTqlR-HZoasiMioXSbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISHrpPQEQTD8wNBfYehtMZjB92P_KowdS6uf6cW_iAtA&oe=6A999E34"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56wksvETh8gQ7kNvwFNQIRb&_nc_oc=AdrE6slp78JuBtluZdoBFzqiUi27yBI2YWbEwJsqB6B9C3mpsOoIjCbRK4J37G7geYM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OtR0oKDK5faB2uVgSbaEycM8kbcAUGK1vVy-DEJ5EhA&oe=6A32B734"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9e414MzSbTYQ7kNvwEC7899&_nc_oc=AdpGg6zd1sy-OA1EE9qhSgb4PXN-a7YGk5tR83n0xq-1ehndtHuhkfxUMzKJKRV8A4Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xlrkcBrnzaZtJF6ibBrev85AWi7pM54E8hrhDYnMhMg&oe=6A3299B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6kUHdlzK20Q7kNvwHZa4PX&_nc_oc=AdrS39YVAxzXKX5pXKy6mLJX_F0dym2YGDbnbOsNjQEwJo3fm261dVt1STNzatatnL4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90jxGNWKDPMWtOyVsMgHGMoQmevRx_nik5MS-CGAMDmg&oe=6A32C934"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
735560819446906880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDHXEpeXj_kQ7kNvwFdBrq1&_nc_oc=Adq6G29rBF8p2Qpfei-3n1dM8vZ1fKHnPaWo2_7u7zuTtsgmTr-ZCIJwJUCSf9Cdp64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BXRYLydMBajLVdqlNM92_AMdoZeHhjKSSkh9WVqJ17g&oe=6A3AA034"}, {"file_name": "migrated_image.png", "id": "213755543067527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035415_456067701846622_4892713270567239680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDZSf_0l__MQ7kNvwEN-iwx&_nc_oc=AdrIiDnDtM1zn4chCUNTRRorjvZ3sMI8j0drFWXlxkh5QwnxKaUhoSao1prQqNrNEic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R-mbYE0YgxkEe4ClNbHkXe6jSKqg770akLa_bclR2QQ&oe=6A3ABAF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AOVEEi", "id": "613796059105819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_613796062439152_7481200685891977216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sWoH6_jw-IQ7kNvwFhXDg0&_nc_oc=AdqyJSo3tJwKmUBTGgUKlmmSF14W9lmEF_TvV_ObHn-KLK7eTta615-HT7hCzuLgr54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2XPaeskxsuehwrAEmAicODsq3uv6YJ1brfbBuSHLD7g&oe=6A3AB234"}, "display_name": "\u00a1Zombies! : Faulty Towers", "keywords": ["unstable", "tower", "zombie", "puzzle", "ball"], "long_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill to get to the heliport and certain escape. The only problem is, the zombies are everywhere, they appear to be very hungry and very still. There is a limited amount of time within which the player can escape. The price of admission is Zombie's heads. Collect all or most zombies and you will make it out of town on a chopper.", "short_description": "\u00a1Zombies! put you in the middle of the action as you try to escape the unstable zombie world. Players must use a combination of wits and skill t
7&_nc_sid=6e7a0a&_nc_ohc=bd507tBxrKUQ7kNvwE49_d-&_nc_oc=AdqMAEXXd8YdYuEJ6uZMwhBfOIvDh3z4VcDyyKrc2zRpCfKgABBpBPb1x8iPTu6Wh28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwmrXjkad1L7m1LCRfnfsW0DhRdhLH_IDT57MIQTMDVg&oe=6B0C701A"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "Hands", "Learn", "Lesson"], "long_description": "Learn piano with your own hands , no controllers, no instrument required.\n\nSpatial Piano uses your Meta headset's passthrough to place a full, responsive grand piano right in your room. See your real hands land on holographic keys and hear rich, authentic piano sound respond to every note.\n\nStart with 12 guided lessons and 6 songs, completely free. Our teach-by-doing system gets you playing your first real note in seconds, glowing keys guide you, and there's no wrong way to begin. Whether you're a total beginner or picking piano back up after years away, Spatial Piano meets you where you are.\n\nNo wires. No physical instrument. No experience needed. Just your hands, your space, and music.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
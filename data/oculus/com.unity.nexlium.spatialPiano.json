25/491822550_1326881058719271_1692095368466279321_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMGrmmKX6w8Q7kNvwHhcfP_&_nc_oc=AdoRxWVFST5z6AXeWjI3E4_gAefzhRBzPmcZslmOWP4vZAe642NQKyM1Uw_dAkUZvpA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Geoxs9nfTz0VEsq2BNCBOek38PXUDV3vU5uW8I96qA&oe=6B08691C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMbangg1c4YQ7kNvwEgyrN5&_nc_oc=AdrAMJH0uXF7yWapDT-A5GLPCAtza25mboFigQMFR1ztD65a3DWKq1lPXvD7SAF_YRY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ-VnomDKhZvYSKTSPcs4p-cCm67q-vNaGcXxM1RHofg&oe=6B0866F4"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "com
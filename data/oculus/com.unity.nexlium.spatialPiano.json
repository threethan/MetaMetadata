Ho1_4s29dcWMvtD5zt-aTLosTx2_F_AqkB0HtLtLkhM998&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo8_uePOjwnaMY86YjqiCTzwHkFLQf5qvt6R9olhoe4w&oe=6A83095C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Coverartlandscape (1).png", "id": "1368337718114519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1368337724781185_209057215749492360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmCVTZBppEoQ7kNvwEfpVIT&_nc_oc=Ado61KCgUb-RbOhn1S7rubtZzx3lDD4UhGufNMRxRw97wiyK1JwVNaeU-kpjMQiN73w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDXY0AXxkT4YG7qzOpWHb7qOBOvl8aC8j2N-YCygFqKw&oe=6A82E39A"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "ex
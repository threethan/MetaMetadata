QJRsbw8cp41AHrwnbGXOWXrhOrqBma94SHFft2D5Vwjhw&oe=6AABFF3A"}, {"file_name": "55.png", "id": "1326881055385938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1326881058719271_1692095368466279321_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmPLtWwy0V8Q7kNvwHhJ3Dq&_nc_oc=AdoKRXVt8ZeTFcH5TGRXHLvhD3MeoXEq24AFfXP-8_mIetJ26Rc9GsDDDYVuITVwjQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_ohv8j0YI6CmzH5qwzeikcgvNdqxzv0qdPRyC04l0wA&oe=6AABE7DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WvGEPI8a4cQ7kNvwFpHuJG&_nc_oc=AdqRk2Zn4NkCFssyAhrvBzQqoJw65zWR0X38a49m8PypouA7-3bu3qPxqfHAErppqik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx2AJ_VBDU1jH0wHfQygwlGMr-WbxNfJuiRt5Bp9HGxw&oe=6AABE5B4"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website
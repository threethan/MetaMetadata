m&_nc_ss=7f20f&oh=00_AQLVPRpbq9EvUW_YcbShr7HKRQA5C4UDXwsaxah-z_8cXg&oe=6AAEA23A"}, {"file_name": "55.png", "id": "1326881055385938", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822550_1326881058719271_1692095368466279321_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmPLtWwy0V8Q7kNvwHnWYVb&_nc_oc=Adq542hPjlKoI1j4SUrLxqgvI1iiqhvDFXyMbmtmgR78wS18dKVFRG0_REMPMc1Ie1M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp5FS5QQcZohEIOCUliF_glJ-Svf4lfBcUyxiQG90gzg&oe=6AAE8ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj1g_QneyMUQ7kNvwHN9fn-&_nc_oc=AdrsE6QDzwIBznwIIPeIU7P9qzE67x2o1ZRMyi9g-JNsBvEhbHpN-ofNMGAZiHMEF2U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu56CqtO5VGYFM_usJiEx-DqAf8e8wosfJi3qNHiuqUg&oe=6AAE88B4"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Nexl
hPhHL149YiNmXVl-cgST8SgpJaqOqX6woQR7Z5j10g&oe=6A8C43DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsYmH_6W7KUQ7kNvwGG6FEi&_nc_oc=AdpS-4Him-EdRMMPPPibFiVClaFz4YbzYA2Mg58QnWwdoU7SRAv0hVbQaQ54njolwEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq468zODgVkmnjnxPZZ8ZyKBJ9AhpL9SsPZI4ewOrgtA&oe=6A8C41B4"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
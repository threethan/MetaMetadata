QKOGS_l5Cid5E11_5rTMdSpdKZA259i1eauRcIO2CiJEw&oe=6AAFF3BA"}, {"file_name": "55.png", "id": "1326881055385938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_1326881058719271_1692095368466279321_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJcUfznhsQwQ7kNvwEjR_j4&_nc_oc=AdpfjX_nAIbwyhwFD0zaTrz6IpCww8w9vdY7js9dhkfjDt_U6l4WUMsZ01WIDKaRcnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_6d9FrvWAtEuzoMwadw-P2c3I5y8G7o9xGXlWQA0aFA&oe=6AAFDC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj1g_QneyMUQ7kNvwEA8SL1&_nc_oc=AdpwP_3cMCO72mEYhCQpWI0salAykdZI67C05OhrV5FDg2On3B2q-uOwqRyXxOsyLXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbEpAkwonId6lo9IHzbyG3XvWTKjR23GvkbnLcZj2Bvg&oe=6AAFDA34"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website
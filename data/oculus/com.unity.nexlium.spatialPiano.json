hV9GVlApgBV2-QsCmRi76HUn9N8zlWKluu52XAm07Q&oe=6A90385C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HoymNM8NA4Q7kNvwEGo72D&_nc_oc=Ado_yCqWR2MdN1EJbGYDw1uAUE1O4FcUafzbY58z9TNZXXjWAGMIighuAidCShExyUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDtjW_Klhqolt4E8o2_W8rYBloVfwpjZu5BnQODpQEpA&oe=6A903634"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
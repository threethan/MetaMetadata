-25/593723055_2048285459124903_5002414131103378894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psZfXVxMaUIQ7kNvwE72StR&_nc_oc=AdoYT_iEhWs3oKV9IPjb3VWHxyrQsvKmPKttLs2g0cQwekgR0jHWTrFDGDWiWl1vPdo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdu0wiFH43jVKTbWzuq9oDQiGV7O0PSZfel1WNxm10fg&oe=6A86EB5A"}, {"file_name": "3.png", "id": "1611239417084937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311585_1611239423751603_8492012975786961083_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LpRUYorKu0Q7kNvwFneHCV&_nc_oc=AdpZU5MxYnMd9STq_9KEDd3hf_Wb8VqFBpINE9ATUHyZmt_fGpQCc6aLiidETUeDllA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFUlNVCIu14o4D_EHCL3Kw7LuFES4hca5Ozzdvxq7LtA&oe=6A86E801"}, {"file_name": "4.png", "id": "1717717022773840", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312332_1717717029440506_7601891450149318676_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J951QM_s6AQ7kNvwGIsqT_&_nc_oc=Adol0Gw3b9waK36tffo_rSpJR-l_S4QqBTvEfGo7xydLHMz1TL7fmDSdysJVq1ikZe4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVwk2ryOzvHdCQzIU8pcxriZFjn4JvTs4HrV5tggHP4w&oe=6A86D630"}, {"file_name": "5.png", "id": "1056933573475381", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314351_1056933576808714_2544394286390641490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U93txX827wQ7kNvwGMLsM2&_nc_oc=Adp_J_SyrLc3xmoDWjU2uFEnyhLqLsULKIpIw1yitj72FjH0OL_-PZq1h_P6w-xhKxs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAjsMV7yXwRf-sGqN0NH9jsO2qDA3gPOb6SdeREXeJeA&oe=6A86F6D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Coverartlandscape (1).png", "id": "1368337718114519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_1368337724781185_209057215749492360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B_4KM2JIScQ7kNvwEEBaTS&_nc_oc=AdqLurBZmuS97kp7vc_O9BhS8zn_DX6tsGSACB1QY0EHFrXog_S0FilkZfNIfC_GpdM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYJGZx8Je4-JCPOSXNgV7cPrFxZAz98Ix7jweXg2c8ow&oe=6A86D81A"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Learn piano with your own hands , no controllers, no instrument required.\n\nSpatial Piano uses your Meta headset's passthrough to place a full, responsive grand piano right in your room. See your real hands land on holographic keys and hear rich, authentic piano sound respond to every note.\n\nStart with 12 guided lessons and 6 songs, completely free. Our teach-by-doing system gets you playing your first real note in seconds, glowing keys guide you, and there's no wrong way to begin. Whether you're a total beginner or picking piano back up after years away, Spatial Piano meets you where you are.\n\nNo wires. No physical instrument. No experience needed. Just your hands, your space, and music.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "sup
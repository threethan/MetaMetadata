25/491822550_1326881058719271_1692095368466279321_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdO5_mxdxfcQ7kNvwGgnpWc&_nc_oc=Adp3psPnrNaIfR1rc57TeKVIwLZvVbGIl7XwCMfkQrYVxuo0gFCDeXhMZxuhyLK0lAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIvlHEdUh5mqLqCuJ-cyOUwrzHNVyktTyOU18gytE3qw&oe=6B0DAF1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE5xIhk8YBwQ7kNvwEqIbdK&_nc_oc=Adqx4t3XHes_xCLpuBKbNcIuJqBSkZIKtsBd1Xq-XhFwlAQTkOeOLsmyMj9TMldG_Zc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREIdYtFEZrxcqOzS6IVdFaEyR8mj5iNM_HoZrr7PtCwg&oe=6B0DACF4"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "com
g8Pjv46exnWqC7WqUJHPAz0De5ZKZfqUPEq-40UkLmWNn7yS2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX5rVWk0V6CRPz0RVIQqz3tPe5VCKFzrkTva97HNLPuA&oe=6AAA8F51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Coverartlandscape (1).png", "id": "1368337718114519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1368337724781185_209057215749492360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XHrPTYyjwUQ7kNvwHKrFL0&_nc_oc=AdqoF7j3kWUxCbupAM-zrSp2EyCBPvg7G4ZafqZQwdWa9rcPl-GXNgr6qaHS7mwR7_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3u5ppTNYvtJEMWdQvXdzljACxpkzB5X88q-YZKClkEg&oe=6AAAA8DA"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "Hands", "Learn", "Lesson"], "long_description": "Learn piano with your own hands , no controllers, no instrument required.\n\nSpatial Piano uses your Meta headset's passthrough to place a full, responsive grand piano right in your room. See your real hands land on holographic keys and hear rich, authentic piano sound respond to every note.\n\nStart with 12 guided lessons and 6 songs, completely free. Our teach-by-doing system gets you playing your first real note in seconds, glowing keys guide you, and there's no wrong way to begin. Whether you're a total beginner or picking piano back up after years away, Spatial Piano meets you where you are.\n\nNo wires. No physical instrument. No experience needed. Just your hands, your space, and music.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category"
QKx9c_b6D4m-5gO2FOOOvjzRaS83Mp2KHR5qn9WF02ldg&oe=6AAAADBA"}, {"file_name": "55.png", "id": "1326881055385938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_1326881058719271_1692095368466279321_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SnJKHJycuYQ7kNvwH2ss1n&_nc_oc=AdqsxkrjTazbCvK2F_AZSJRSXfPBlMKiJKIq3Orn8fLMSE2xtEtxoXMdfTrBEobT06w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjo6u3NEghzy_u4HUprPgax-CyKV7_7x5I35ZpEOwx-Q&oe=6AAA965C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WvGEPI8a4cQ7kNvwFB-oee&_nc_oc=Adph3RWQfm4L0Wo4Pq7s6vE24cI6XRLV3YFuYmpW_kSqbGVGwh-Nz9X7rb6ggxwGTTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9RRLzX4AgKih9z7sA0mII29_1zIA4f_1W6woWgY04Gw&oe=6AAA9434"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website
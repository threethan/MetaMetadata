822327_840238228410445_694562860388060353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulTr5M3T1N0Q7kNvwHIm24j&_nc_oc=AdqcAK3XfbCn_S6yC4dyf-O2D4b3xFlOD6_YN-WOEDTmaUnvrNI2H2sA20h9U3-Q8WY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGiC2VxrrlL0DBrvxeWKU8lK30p1paSVpXpMCqC9Zmdw&oe=6A58E996"}, {"file_name": "44.png", "id": "1848817329053362", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818885_1848817332386695_8470963990795778649_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8e4VI_AptIQ7kNvwFlVpQK&_nc_oc=AdpHFdkQX_v0xdiRqfhgP0PpqqQGwbpejIQ0nSY0GAcYGevDvj7KmhUL-exxvtvAjMo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBKm7CbqvwNmY6BTg5kSmTj9E1IxzzxA8v6ne0OVHxMw&oe=6A58F0BA"}, {"file_name": "55.png", "id": "1326881055385938", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822550_1326881058719271_1692095368466279321_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LKmTx2f2pEQ7kNvwH2mCSw&_nc_oc=AdpbgI36lQQ-jcQvQPU1UMhndwoa1TslKqmYdc9V--dgjj7ImVP2ECigRVUULHTDFek&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZbKkbPRy52QItzBc_ZJ9LU1UOIDH6V0oY9PCoXkFFZw&oe=6A58D95C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover (1).png", "id": "1823296655246729", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818852_1823296661913395_6126200548059607171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eXGFHqezFwQ7kNvwFHZsRr&_nc_oc=AdrOVkfQ5EtkPUpGzpwM7YG1k82R_1ggHB4F09_dn-76qdpHGBtJ89bvdjlzO_jfty4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcdXbHW23iNh5rbs9d2OdYAoyr14qolWiUjz8imiRALQ&oe=6A58D734"}, "display_name": "Spatial Piano", "keywords": ["Piano", "Music", "VRPiano", "Hands", "Spatial"], "long_description": "Step into the future of music with Spatial Piano, the immersive app that transforms any room into your personal concert stage. Using the advanced passthrough of your Meta headset, we place a elegant, responsive piano directly into your real-world environment. See your own hands play across the holographic keys, producing rich, authentic grand piano sounds.\n\nThis is the simplest and most intuitive way to connect with music. No controllers, no wires, no physical instrument needed, just the power of your hands and the space around you.", "short_description": "Spatial Piano: Play a virtual piano with your bare hands, anchored perfectly in your real room. The simplest way to make music in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thisisabdullah.github.io/", "developer_terms_of_service_url": null, "publisher_name": "NexliumXR", "support_website_url": null, "website_url": "https://nexlium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32402079376103643"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1501574217724158"}]}, "baseline_offer": {"id": "1501574217724158"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763486220, "status": "PUBLISHED", "id": "1501574217724158"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32710815865229991", "version": "1.0.0"}, "id": "1163433942326486", "channel_name": "LIVE"}]}, "is_for_ocul
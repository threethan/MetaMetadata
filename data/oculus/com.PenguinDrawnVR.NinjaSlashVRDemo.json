Jgv4FjbzsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTagt_BQ9TyQ7cjwGP8OHSkKzRjntlfn9_YxPTQ0lBHFg&oe=6AFDC490"}, {"file_name": "03_Energy_Bow_Combat.png", "id": "1541820531011119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622334_1541820534344452_4605951012105867404_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNKk21WGofMQ7kNvwGlgJYo&_nc_oc=Adqf8OBg2GtFESvfY_NEJX6Yu23fAJFfJ1A6uyBttWizk9bM3wx41rfm_g9cfwqW5ig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPTa_ki9VuHC2UBew5FDa2hl-xo8p-NaEaf91sYzE-_A&oe=6AFDCE9A"}, {"file_name": "06_Blade_Clash_Sparks.png", "id": "1331849842497143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1331849845830476_6883584088752693671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeH_Bo0GFeAQ7kNvwGZu8TR&_nc_oc=Adq6a3lfzGvMSoq5Pv1PRTjnO7OkfCuhwtlaxhx7b-eprIFgS5cheOlEBdHW77Uoqbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP2x5EsrqA1ZqrWU1UHX3yz2yLGZcU3nCAN8QsEpb6qw&oe=6AFDD18E"}, {"file_name": "04_Two_Enemy_Arena.png", "id": "1474459264450112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620860_1474459267783445_4825951152730614903_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45_lxNOiKAEQ7kNvwHAoe24&_nc_oc=AdqYLBERTCd1SZyQ79j8l2rPvnJe9fIBaR8Boy66JIojuwiaBLulu5a0P6W63J4QEHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhbPIOXAwgYBXsHAtd_K8wc5hB2Rs1tft-lc1fKOWQaQ&oe=6AFDC787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NinjaSlashVR_Universal_Basic_Asset_2560x1440.png", "id": "1287518843259033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622334_1287518846592366_3814848564270201524_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Vdbof_OSRAQ7kNvwGSjJTx&_nc_oc=Adr-JDq6BbprmoTKpjiK4DNRC6JXV7txiF8a4o0Nxlx44Pc4Et0jm3KCviG3I5tdgR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr63aJiUF5S8sv4b_fyCdQN5PeuEpq7VCj5zYa3A0wrA&oe=6AFDD934"}, "display_name": "Ninja Slash VR Demo", "keywords": [], "long_description": "**Become the blade in Ninja Slash VR, a physics-driven action game built around fast, skill-based sword combat.**\n\n**MASTER PHYSICS-DRIVEN SWORD COMBAT**\n\nSwing, block, stab, and parry using natural VR movements. Your speed, angle, timing, and attack direction determine the result of every clash.\n\n{26040648548967048}\n\n**PERFORM PRECISE PARRIES**\n\nBlocking alone is not enough. Match the direction of an incoming strike and counter it with force to stagger your opponent and create an opening.\n\n{1560641895763836}\n\n\n**SLICE ENEMIES APART**\nTarget specific body parts and armor sections with location-based damage and physical dismemberment. \n\n{1592057919282850}\n\n**MOVE LIKE A CYBER NINJA**\n\nRun, climb, grapple, jump, and use vertical environments to control the battlefield. Close the distance quickly or escape before enemies can surround you.\n{1000893849242001}\n\n\n**CONTROL TIME**\n\nActivate Bullet Time during critical moments to slow enemy attacks and sharpen your reactions. Dodge projectiles, analyze threats, reposition your blade, and perform precise multi-hit combinations while the world moves in slow motion.\n\n{4361927100737258}\n\nEvery block is physical. Every parry requires timing. Every cut is determined by your own movement.\n\n**Draw your blade. Slow down time. Survive the arena. Become the cyber ninja they were built to fear.**", "short_description": "Become a cyber ninja in a physics-driven VR action game. Master the blade, parry deadly attacks, slice through enemies, and fight your way across a futuristic battlefield.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddbug.github.io/ninja-slash-vr-demo/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Penguin Drawn Studio", "support_website_url": "h
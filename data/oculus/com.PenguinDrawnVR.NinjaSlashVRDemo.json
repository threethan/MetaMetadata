v3w3WEP6aM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg3wrH69zziV709czuR6yU4mKV4ZG7szkLF_nMSZGMRQ&oe=6B030A90"}, {"file_name": "03_Energy_Bow_Combat.png", "id": "1541820531011119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1541820534344452_4605951012105867404_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XqCcUvVCsUQ7kNvwE8BVbq&_nc_oc=Adp6t8wIIpSvF4keAA5V63NOGzNZh3UF1OpNxt3TwQBHefaTQx53HdU0Pj04Y2pyrWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsc9FRZDZ168ZI6rZobuIFQmjggbTnYYQ4gzLzqeMOCQ&oe=6B03149A"}, {"file_name": "06_Blade_Clash_Sparks.png", "id": "1331849842497143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1331849845830476_6883584088752693671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rc2LVHqjYwQ7kNvwFKN5Sh&_nc_oc=AdqrE_UcSo7bKDD5oiPNgQUjJlHbq3lesevl0Add3Kaz0dSiwswAPT0o7rWk9_LgESs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToom3_YpavPoxw2jPlcPLdtARZ0n7GRKcQo-27jBScLA&oe=6B03178E"}, {"file_name": "04_Two_Enemy_Arena.png", "id": "1474459264450112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_1474459267783445_4825951152730614903_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CNz-nxiIP0Q7kNvwFeR4lL&_nc_oc=AdqBiOBtJ1jGtnF4VlkhRfADWWTfKYqWOzXWgPmOfMBZ0sOG-C37nDzYaUSUz90_WUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3JzU11bm4yWdehJdq5Q0OoLrTzAD6Ik4MgAyXY5UnUQ&oe=6B030D87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NinjaSlashVR_Universal_Basic_Asset_2560x1440.png", "id": "1287518843259033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1287518846592366_3814848564270201524_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD1a1EvU9W0Q7kNvwE_GvmI&_nc_oc=AdqPToLclTA9p_3QfKbXYHHXaB0HvCdVvhmBg30Un8QdF0BserI26AWDQ_BEdElH33Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREJsUZGqsVhx7L-v4z2j3RbkkUMdyq090CdFfn_6e32Q&oe=6B031F34"}, "display_name": "Ninja Slash VR Demo", "keywords": [], "long_description": "**Become the blade in Ninja Slash VR, a physics-driven action game built around fast, skill-based sword combat.**\n\n**MASTER PHYSICS-DRIVEN SWORD COMBAT**\n\nSwing, block, stab, and parry using natural VR movements. Your speed, angle, timing, and attack direction determine the result of every clash.\n\n{26040648548967048}\n\n**PERFORM PRECISE PARRIES**\n\nBlocking alone is not enough. Match the direction of an incoming strike and counter it with force to stagger your opponent and create an opening.\n\n{1560641895763836}\n\n\n**SLICE ENEMIES APART**\nTarget specific body parts and armor sections with location-based damage and physical dismemberment. \n\n{1592057919282850}\n\n**MOVE LIKE A CYBER NINJA**\n\nRun, climb, grapple, jump, and use vertical environments to control the battlefield. Close the distance quickly or escape before enemies can surround you.\n{1000893849242001}\n\n\n**CONTROL TIME**\n\nActivate Bullet Time during critical moments to slow enemy attacks and sharpen your reactions. Dodge projectiles, analyze threats, reposition your blade, and perform precise multi-hit combinations while the world moves in slow motion.\n\n{4361927100737258}\n\nEvery block is physical. Every parry requires timing. Every cut is determined by your own movement.\n\n**Draw your blade. Slow down time. Survive the arena. Become the cyber ninja they were built to fear.**", "short_description": "Become a cyber ninja in a physics-driven VR action game. Master the blade, parry deadly attacks, slice through enemies, and fight your way across a futuristic battlefield.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddbug.github.io/ninja-slash-vr-demo/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Penguin Drawn Studio", "support_website_url": "h
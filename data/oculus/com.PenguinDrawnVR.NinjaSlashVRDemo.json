less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIPfK_EGYMQQ7kNvwFuJukg&_nc_oc=AdodQ23g3a36SwfCyb4xPcWPsbMTtAys9A62FxefhSIpIj6o39Q-NsnhYC7w9-K-y7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbMbvuKEwgO4I4tvH0KISAnVONr9TWQmo1yBCNeUrFwQ&oe=6B0C7D50"}, {"file_name": "03_Energy_Bow_Combat.png", "id": "1541820531011119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622334_1541820534344452_4605951012105867404_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJCsKp4RpTIQ7kNvwEgIHoB&_nc_oc=Adq2t6I6Vaa-Dp1LHs1wsRADbw9fCK6RDXbx0-arZQWt5Kk7NoA8xqDf8dJFDJrBpLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-vla34jDBr_dtbtL6iC-ZhhrqSyBcZjn7k8dYiwpX8Q&oe=6B0C4F1A"}, {"file_name": "06_Blade_Clash_Sparks.png", "id": "1331849842497143", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1331849845830476_6883584088752693671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sLc2gZW0gkQ7kNvwFDuUHE&_nc_oc=AdpBHTM3fl6dUoS4yKGXZFNr1VSIGkFMQ0g0xMRFR3O_UQ7zjZB2Brz8UH5D5N6YVfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTl_IZAFW9EvXno1qt1z-QHaiRSaikBB9q9Z7Xf14B_Mg&oe=6B0C520E"}, {"file_name": "04_Two_Enemy_Arena.png", "id": "1474459264450112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620860_1474459267783445_4825951152730614903_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6Rxt4m5E8QQ7kNvwHxDqfS&_nc_oc=AdopTMpFcHT6xTM_XrJzvuWmMb1STKn1PJL0ua86atTg0x87q8JrlXlSbOxveG31SOQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGZn1rIC2tnnR-KbyCSLVO8Gz1CoLCFFYuKCQY2C8L-g&oe=6B0C8047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NinjaSlashVR_Universal_Basic_Asset_2560x1440.png", "id": "1287518843259033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622334_1287518846592366_3814848564270201524_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgFfwUaGvu0Q7kNvwHUAGKI&_nc_oc=AdqPFW3ivtz8r7f0hB7hElHgS39lCEnma-Sma4tJCC_iXkLy97AhBBjx1ak4S98UaeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWscPOGeWgpvxW8VeBUo91KXJZP1smwxjQghKwo0kUJA&oe=6B0C59B4"}, "display_name": "Ninja Slash VR Demo", "keywords": [], "long_description": "**Become the blade in Ninja Slash VR, a physics-driven action game built around fast, skill-based sword combat.**\n\n**MASTER PHYSICS-DRIVEN SWORD COMBAT**\n\nSwing, block, stab, and parry using natural VR movements. Your speed, angle, timing, and attack direction determine the result of every clash.\n\n{26040648548967048}\n\n**PERFORM PRECISE PARRIES**\n\nBlocking alone is not enough. Match the direction of an incoming strike and counter it with force to stagger your opponent and create an opening.\n\n{1560641895763836}\n\n\n**SLICE ENEMIES APART**\nTarget specific body parts and armor sections with location-based damage and physical dismemberment. \n\n{1592057919282850}\n\n**MOVE LIKE A CYBER NINJA**\n\nRun, climb, grapple, jump, and use vertical environments to control the battlefield. Close the distance quickly or escape before enemies can surround you.\n{1000893849242001}\n\n\n**CONTROL TIME**\n\nActivate Bullet Time during critical moments to slow enemy attacks and sharpen your reactions. Dodge projectiles, analyze threats, reposition your blade, and perform precise multi-hit combinations while the world moves in slow motion.\n\n{4361927100737258}\n\nEvery block is physical. Every parry requires timing. Every cut is determined by your own movement.\n\n**Draw your blade. Slow down time. Survive the arena. Become the cyber ninja they were built to fear.**", "short_description": "Become a cyber ninja in a physics-driven VR action game. Master the blade, parry deadly attacks, slice through enemies, and fight your way across a futuristic battlefield.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddbug.github.io/ninja-slash-vr-demo/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Penguin Drawn Studio", "support_website_url": "https://github.com/ddbug/ninja-slash-vr-demo/issues", "website_url": "https://ddbug.github.io/ninja-slash-vr-demo/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1721250729223620"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1387348080161001"}, {"status": "PUBLISHED", "id": "1736471240854888"}]}, "baseline_offer": {"id": "1387348080161001"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784390700, "status": "PUBLISHED", "id": "1387348080161001"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1722092622472764", "version": "1.02"}, "id": "1625106129033109", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1721250719223621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1722092622472764"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1625106129033109"}]}, "change_log": null, "created_date": 1784048366, "id": "1722092622472764", "version
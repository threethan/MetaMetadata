Z8DL-e_p4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6ghdAzTOm3NP8JnQvCjsj3SpD1x0kI4tZVzE-8Y_CBw&oe=6B045C10"}, {"file_name": "03_Energy_Bow_Combat.png", "id": "1541820531011119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622334_1541820534344452_4605951012105867404_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XqCcUvVCsUQ7kNvwHsQcGd&_nc_oc=AdofJ5ja8KtpNKY76_U-Dva718EcXfukSsLKN9uVsYsV_MzYK1resy8lhvJ8HsY5BVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDUNALik28Z2oUqub9ib9ikG811pQau-_7ZTnAz2_qfQ&oe=6B04661A"}, {"file_name": "06_Blade_Clash_Sparks.png", "id": "1331849842497143", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1331849845830476_6883584088752693671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rc2LVHqjYwQ7kNvwHhLXQM&_nc_oc=AdqoT9BFw8ZZ9rxpvsy9RmyvJRP9oCIQpTfTFPSXuFp_v1FacPT25S4uBrhRVzsc4gU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMgh65yFUZesS1kRlsy4SjpuRxecUTRLUtwcVuMjl7Qw&oe=6B04690E"}, {"file_name": "04_Two_Enemy_Arena.png", "id": "1474459264450112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620860_1474459267783445_4825951152730614903_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CNz-nxiIP0Q7kNvwFcYdUE&_nc_oc=AdpPman2BQ6O1pC-Osqz9LZ_YsiQ8SRmClYOjEXWW0dNRrRXXtSOT9wPZVBhlUt8dWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ06D6zGuOp4iwDecVmxHTuhYfeyr4leNU1Cl4K9hLYg&oe=6B045F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NinjaSlashVR_Universal_Basic_Asset_2560x1440.png", "id": "1287518843259033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622334_1287518846592366_3814848564270201524_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD1a1EvU9W0Q7kNvwEWwJKH&_nc_oc=AdrMq7-pT7r3IXnyZ4RnpDe-liq1UZxYszlosNEc3uGeCrSb3IMddM1SrPCE9JoXWBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJxrkKMDzIdSTLYsOVw8uqXPf5S5wHbH3Hyo-CEMP0fA&oe=6B0470B4"}, "display_name": "Ninja Slash VR Demo", "keywords": [], "long_description": "**Become the blade in Ninja Slash VR, a physics-driven action game built around fast, skill-based sword combat.**\n\n**MASTER PHYSICS-DRIVEN SWORD COMBAT**\n\nSwing, block, stab, and parry using natural VR movements. Your speed, angle, timing, and attack direction determine the result of every clash.\n\n{26040648548967048}\n\n**PERFORM PRECISE PARRIES**\n\nBlocking alone is not enough. Match the direction of an incoming strike and counter it with force to stagger your opponent and create an opening.\n\n{1560641895763836}\n\n\n**SLICE ENEMIES APART**\nTarget specific body parts and armor sections with location-based damage and physical dismemberment. \n\n{1592057919282850}\n\n**MOVE LIKE A CYBER NINJA**\n\nRun, climb, grapple, jump, and use vertical environments to control the battlefield. Close the distance quickly or escape before enemies can surround you.\n{1000893849242001}\n\n\n**CONTROL TIME**\n\nActivate Bullet Time during critical moments to slow enemy attacks and sharpen your reactions. Dodge projectiles, analyze threats, reposition your blade, and perform precise multi-hit combinations while the world moves in slow motion.\n\n{4361927100737258}\n\nEvery block is physical. Every parry requires timing. Every cut is determined by your own movement.\n\n**Draw your blade. Slow down time. Survive the arena. Become the cyber ninja they were built to fear.**", "short_description": "Become a cyber ninja in a physics-driven VR action game. Master the blade, parry deadly attacks, slice through enemies, and fight your way across a futuristic battlefield.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddbug.github.io/ninja-slash-vr-demo/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Penguin Drawn Studio", "support_website_url": "h
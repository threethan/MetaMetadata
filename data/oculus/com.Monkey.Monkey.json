pGgdfL5_4OeYQw2vWdddT3-sVwrRFWqe2-m3khMEXP5l0x5GmV9q6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOaMIBPedARzSunmRXDDpoXOoFxvCBbMw-D8uEFZrOiA&oe=6B032ADC"}, {"file_name": "screenshot2.png", "id": "815415908327353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596061819_815415914994019_2305204255220031895_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TetyXzD4PkEQ7kNvwE_BHib&_nc_oc=AdoosfYtFTu3c5vr_skYEHeqOMxbM7dt2aHEnltpNfvwLg4YzzmGzNLc6OXMghyWiBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0ZlMIYgtlBipimdC3vpqf215Juql0mLN5jBUxXgIYcQ&oe=6B03039D"}, {"file_name": "screenshot5.png", "id": "1921625755184553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604310912_1921625758517886_3273142077673459678_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFybKgifMT4Q7kNvwF0YO_G&_nc_oc=AdpXcqvzHGKRZAMAzvkeV5JDA0F3rQFeOrZ8pm7AYzKlFLdehl0pqUA1ykENc4oJsvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ17NQ8giQBFWe3CexwqrZisBR-coRZ8SukEr6wde0-1Q&oe=6B032D5B"}, {"file_name": "screenshot4.png", "id": "1058272450521615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673525341_1058272453854948_7648559124639405385_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9x6lu7OoMsQ7kNvwGmPC9D&_nc_oc=Adp7gbIRutegFzvpG4dXlBcv7iUcnAgMswk3DuKHmPt9B36In0tB65AmoDlHgrPPNNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Gpx58KEBr8_KjgETMbk5_imU6AgCepT7PaB8o_kCeg&oe=6B03319C"}, {"file_name": "screenshot3.png", "id": "891175487102995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604328314_891175490436328_2461997381960680987_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5IktjubzaUQ7kNvwG_Pkyq&_nc_oc=Adoh0_DH7FPUCo_sdvHBkiSaTZiCnoRfFpEurAu0kxHOJpWCPMldt4DJ2buZdIOwXrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoySgJ-Pbu6TOjkMdyAIuQPjPBijy16DLYwSTnEgKScA&oe=6B030C09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey", "keywords": ["tag", "arcade", "gamemodes", "fun", "locomotion"], "long_description": "Welcome to MONKEY! Monkey is a VR Social hangout game where you use both of your hands to move around, no legs, no buttons, just movement with your controllers! Inside of monkey you can play plenty of gamemodes such as casual, infection, and hunt!\n\nYou can also go buy cosmetics inside of the shop and customize your character with over 500 BILLION different combinations (thats almost the size of the world!) and freely customize your avatar!\n{1590887115767882}\n\nInside the game, you can play Infection Tag. It is similar to regular tag, but instead of only one player being tagged, the infection spreads throughout the entire lobby. One player starts as the infected tagger, and whenever they tag someone, that player becomes infected too and can help tag the remaining players.\n\nAs more players become infected, it gets harder for the survivors to escape. The round continues until the last uninfected player is tagged. Once everyone has been infected, the round ends and a new one can begin.\n\n\nMore gamemodes are coming shortly!", "short_description": "Inside of monkey you can play gamemodes and have fun with other players and have unlimited potential with customizing your avatar!"}]}, "developer_name": "Two Armed Baboons", "developer_privacy_policy_url": "https://twoarmedbaboons.games/Monkey/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Two Armed Baboons, LLC.", "support_website_url": null, "website_url": "https://twoarmedbaboons.games/Monkey/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres":
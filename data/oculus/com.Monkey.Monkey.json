0031895_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJZ1H6vjZrIQ7kNvwGdwNpJ&_nc_oc=Adq-2BBm3JGoNYrV-AzSVcF5jYF-qNWOtP3quAWWv0QaYH3apHc2T3VnLTEm8nfKH84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXYZmf6l5D0dgQdTuc57sraHiRpkt63uyHqYnAwiph1Q&oe=6ADE199D"}, {"file_name": "screenshot5.png", "id": "1921625755184553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604310912_1921625758517886_3273142077673459678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b-_4DXRLv0Q7kNvwGq5fQo&_nc_oc=AdqJreG8zbXSxIuvDbUme4WFpLa4Lg7S8bE09C7fJ4XPXY-NVuf_QiYfckr82Lc-Q_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX8J6rxgu0xnClT3Vbe-nQcxRA1zeWUzRDAR2evLgAoQ&oe=6ADE0B1B"}, {"file_name": "screenshot4.png", "id": "1058272450521615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673525341_1058272453854948_7648559124639405385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OrTdzmYfK4Q7kNvwHjVw0D&_nc_oc=AdpNiN2M4KYsS3TvktmDcspnXDZP2AgdS16Jtw29X5-3k2KW7cwiqi0vCmSKNCGfYT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHJuADdEdfHJloqYlDjNbR5Z73HndTw3NOFlFfjWv6Yg&oe=6ADE0F5C"}, {"file_name": "screenshot3.png", "id": "891175487102995", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604328314_891175490436328_2461997381960680987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jelaS7iyqC0Q7kNvwFpFvhj&_nc_oc=AdpelKGaxTsC-I0e5UwMLpsag4WElf7oI-L82GDGniqkOLFDS3CZAA9QdgyxoD8A4dI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMNkZXQWci4InYESedl0DBW-W8oGhdRHD2oJ7IbGUgRg&oe=6ADE2209"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey", "keywords": ["tag", "arcade", "gamemodes", "fun", "locomotion"], "long_description": "Welcome to MONKEY! Monkey is a VR Social hangout game where you use both of your hands to move around, no legs, no buttons, just movement with your controllers! Inside of monkey you can play plenty of gamemodes such as casual, infection, and hunt!\n\nYou can also go buy cosmetics inside of the shop and customize your character with over 500 BILLION different combinations (thats almost the size of the world!) and freely customize your avatar!\n{1590887115767882}\n\nInside the game, you can play Infection Tag. It is similar to regular tag, but instead of only one player being tagged, the infection spreads throughout the entire lobby. One player starts as the infected tagger, and whenever they tag someone, that player becomes infected too and can help tag the remaining players.\n\nAs more players become infected, it gets harder for the survivors to escape. The round continues until the last uninfected player is tagged. Once everyone has been infected, the round ends and a new one can begin.\n\n\nMore gamemodes are coming shortly!", "short_description": "Inside of monkey you can play gamemodes and have fun with other players and have unlimited potential with customizing your avatar!"}]}, "developer_name": "Two Armed Baboons", "developer_privacy_policy_url": "https://twoarmedbaboons.games/Monkey/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Two Armed Baboons, LLC.", "support_website_url": null, "website_url": "https://twoarmedbaboons.games/Monkey/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29053339497600210"}, "review_messages": []}]}, "cover_
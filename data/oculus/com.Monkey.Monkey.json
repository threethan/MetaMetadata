0031895_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNCmCFmUuykQ7kNvwHU3UOh&_nc_oc=Adrk1yKCPPDWbOL-7UCWDsqtcX7M2SXgfM1njAmSCoJmf_jkt02I6getua1ChzD0mwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuU_1jsbMvbaHOxVVT6pyGXM8D5nT9lkBI99dP1qb7wg&oe=6ACCF61D"}, {"file_name": "screenshot5.png", "id": "1921625755184553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604310912_1921625758517886_3273142077673459678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BzihPbQ78gQ7kNvwHbSpnT&_nc_oc=Adq7Vu_6vHsxpXk_faIgQx2jjrqMOSc8DYZFRJqcT5S7zWlJ4ug6BDaGMPGMKegpOoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-Mvyyxrqr-Hoeua7uSTnDZRDlDONZoG1Y-qvddJhxig&oe=6ACCE79B"}, {"file_name": "screenshot4.png", "id": "1058272450521615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673525341_1058272453854948_7648559124639405385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMy6SvGIcnAQ7kNvwH0sEjH&_nc_oc=Ado7Sa9iPQhHDEZnSYoDLtRwqKIhpL0nzdTWbRc30OwPd5zPSElMQ77W5P1UgaZRRIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN02D0I-84B0Twpn2M5PuypsZs7Jvu5E_cH3B-gJl5Wg&oe=6ACCEBDC"}, {"file_name": "screenshot3.png", "id": "891175487102995", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604328314_891175490436328_2461997381960680987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYzoNgduvykQ7kNvwEJ6rtk&_nc_oc=AdrMzjA6q54xQFzxRztPpShOt7wFeMw1poPvi8njK1UFlLpZVSMl0nOM_aJbpfyzPyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTk-tmvteD_MJs8XXC4aLvIR1ujtmbMkXCMaZoHqXmCA&oe=6ACCFE89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey", "keywords": ["tag", "arcade", "gamemodes", "fun", "locomotion"], "long_description": "Welcome to MONKEY! Monkey is a VR Social hangout game where you use both of your hands to move around, no legs, no buttons, just movement with your controllers! Inside of monkey you can play plenty of gamemodes such as casual, infection, and hunt!\n\nYou can also go buy cosmetics inside of the shop and customize your character with over 500 BILLION different combinations (thats almost the size of the world!) and freely customize your avatar!\n{1590887115767882}\n\nInside the game, you can play Infection Tag. It is similar to regular tag, but instead of only one player being tagged, the infection spreads throughout the entire lobby. One player starts as the infected tagger, and whenever they tag someone, that player becomes infected too and can help tag the remaining players.\n\nAs more players become infected, it gets harder for the survivors to escape. The round continues until the last uninfected player is tagged. Once everyone has been infected, the round ends and a new one can begin.\n\n\nMore gamemodes are coming shortly!", "short_description": "Inside of monkey you can play gamemodes and have fun with other players and have unlimited potential with customizing your avatar!"}]}, "developer_name": "Two Armed Baboons", "developer_privacy_policy_url": "https://twoarmedbaboons.games/Monkey/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Two Armed Baboons, LLC.", "support_website_url": null, "website_url": "https://twoarmedbaboons.games/Monkey/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29053339497600210"}, "review_messages": []}]}, "cover_
ZjeZ64napWftpoPHfplhC0-dfkqcW9Udzan41o-ic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYRuDHi9W52kxgCoyeBhFV9hmobBBmP__M_0TSqgAV4A&oe=6AFC934E"}, {"file_name": "18.png", "id": "799020526543523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_799020529876856_4747731658628736245_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0sBgBelmnMQ7kNvwEOHGqK&_nc_oc=AdpoiGUS6gvHuSzACIX2jxW_1eI5Z2UVOycpLfQFCNc1uHkrjxudlJCIazUoKIDwUe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTetjn9Dkf_cht-Lf6T4AhW2BzgjNYKigoddgmFL2FfPg&oe=6AFC90F4"}, {"file_name": "16.png", "id": "1451985013119307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618254_1451985016452640_4886594853651906995_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEHGcd_eGZEQ7kNvwGX89HO&_nc_oc=Adoi1tSnGnqeLgXn9KRTSc_1s8XfPe6vrhgBQd6ZbbNOxUHCoY9pJmgMIcXYrvePYhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLPmSoEN4WAJ1fC4C3i7Mf8Upk4H_9k8o1_s4MQ3Q2CA&oe=6AFC809E"}, {"file_name": "13.png", "id": "1604811060667218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_1604811064000551_5902672207163640581_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=iH-SiMShtQ8Q7kNvwFdTBm1&_nc_oc=AdpmFkhfUohTXNaz0H3W_DMN_LHxFTRctSergQdKw2HkzNroA_6FwOf-3NEDa4MHV_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQWPYvnmlxD9Hj8V__z5QbKq5g43K8yFmGvSF_HNIQ6Q&oe=6AFC6A5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apocalypse Zombie: Last Stand", "keywords": ["Zombie", "Apocalypse", "Shooter", "Last", "Survival"], "long_description": "Apocalypse Zombie: Last Stand\n\nThe world has fallen. Civilization is gone.\nAll that remains is one last fortress\u2026 and you.\n\nApocalypse Zombie: Last Stand is a high-intensity VR zombie shooter set in a brutal post-apocalyptic world where survival means holding the line against endless hordes of the undead.\n\nYou stand at the final defensive position. Zombies come from all directions. There is no escape \u2014 only the last stand.\n\n\ud83e\udddf\u200d\u2642\ufe0f SURVIVE THE APOCALYPSE\n\nWaves of zombies will relentlessly attack your fortress. Each wave grows stronger, faster, and more aggressive. Your goal is simple but unforgiving: survive as long as possible.\n\nEvery second matters. Every shot counts.\n\n\ud83d\udd2b TRUE VR SHOOTER COMBAT\n\nPhysically aim, reload, and fire using full VR controls\n\nFeel the intensity of close-quarters zombie combat\n\nFast, responsive gunplay designed for immersion and comfort\n\nThis is not just shooting \u2014 it\u2019s fighting for survival.\n\n\ud83e\uddf1 DEFEND THE LAST FORTRESS\n\nThe environment is a post-apocalyptic stronghold, built as humanity\u2019s final defense.\nHold chokepoints, control lanes, and adapt your tactics as the undead overwhelm your position.\n\nIf the fortress falls, humanity falls with it.\n\n\u26a1 FEATURES\n\nImmersive VR zombie shooter gameplay\n\nEndless wave survival mode\n\nIncreasing difficulty and enemy variety\n\nPost-apocalyptic fortress setting\n\nDesigned for intense, replayable sessions\n\nOptimized for smooth VR performance\n\n\u2620\ufe0f HOW LONG CAN YOU LAST?\n\nThere is no victory screen.\nThere is no rescue c", "short_description": "Defend the final fortress in a post-apocalyptic world overrun by zombies. Survive the last stand in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamvrplay.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DreamVRPlay", "support_website_url": null, "website_url": "https://dreamvrplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644
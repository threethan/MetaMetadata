_1100044888833559_7196966887753693025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eytEKae7zoQ7kNvwHuMz1r&_nc_oc=AdoHSq1RJejhIazojvifMeXpGfuFASC9xMP84jzH4xKdTqF366chTwz1-51lgf10WnE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI545qfUrn_tfR0B5vskH2VZom_BQjldsfL1mwH41ns4w&oe=6AA3FADD"}, {"file_name": "Screen-2.png", "id": "2238494793235302", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391859_2238494796568635_8038007329700109051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiEWiiYe7okQ7kNvwH2gdHX&_nc_oc=AdqOuG2Hi8o6fYA5vYaHhhNzVAps4HLw8sTNr4ps-JZ4ig3tJDpQ1E5KXFYgMe6kc-s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS89yMiR1AuU7kb3bCMEvwpPgoxh10az5ITuBrUwX_Wg&oe=6AA40EFA"}, {"file_name": "Screen-0.png", "id": "1203563258000101", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391845_1203563261333434_406678165749710570_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71whjEgPymMQ7kNvwE3gpBC&_nc_oc=AdqcYgNwl8Z3pdwx17zlEaXsOPQWhPxjeQf_c0eRWGNlo-V8J4UV6JpTcVRt1DaNJqM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFh0zrDfQ03dRe5QgM-WgIHRxS8VW_fHm6c-KSY1hWNg&oe=6AA41CBF"}, {"file_name": "Screen-3.png", "id": "1648490399120100", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391787_1648490409120099_6901330346743583530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iPxI9WctqkQ7kNvwGEOkH5&_nc_oc=AdrzX7YvCKqa3hFs9QEdbu4zUsbeJa4PAOeu-wxdWn2afvcePIxT9ZgCam0qTcPIYS0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK3O3yky92tVmbWs6WsBShmR70Ccv9vuoAKSZhCobetw&oe=6AA41CA2"}, {"file_name": "Screen-4.png", "id": "1055313743304344", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391787_1055313746637677_7957820831233323218_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2rV-jTn8UYQ7kNvwHoT23e&_nc_oc=AdprcM8sPXtBHMza4H48aluEUZNS2zCa0rC00phFMb0tHvr17Bo7FfGu0kdbVc4zBQQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzsOEDEaG8mOocnHyexzLkRpB7mAG_9joQiFNdCIGkWg&oe=6AA3F6F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1210932463897875", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393659_1210932473897874_8971242551591314829_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEokvcNSlhcQ7kNvwFm4fKu&_nc_oc=AdpOYH2rMmGMbNuKpCUlHKKRi60fJiCvQk3vOp3_6uuwzuV-S59zKSa175dhLHDSTlc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLidCEALYO2VER1FrBSUduBhakERvgSC5pXiLIt_f66BQ&oe=6AA40341"}, "display_name": "Helping Hand", "keywords": [], "long_description": "# Helping Hand\n\nUna experiencia inmersiva de Realidad Virtual que te desafiara con puzles, tensi\u00f3n y una criatura que proteger.\n\n\n\n# Una aventura emocionante que te mantendr\u00e1 en vilo\n\nEn Helping Hand te encuentras atrapado en una casa infestada por entidades oscuras. Pero no est\u00e1s solo. Una extra\u00f1a criatura reci\u00e9n nacida necesita tu ayuda para sobrevivir. \u00bfCual es tu misi\u00f3n? Colaborar entre s\u00ed, resolver puzles y encontrar la manera de escapar antes de que las sombras que acechan la casa los capture.\n\n\n\n# Resuelve puzles e interact\u00faa con el entorno\n\nExplora abitaciones misteriosas, manipula objetos y usa el entorno a tu favor para superar obst\u00e1culos y peligros. Cada puzle est\u00e1 dise\u00f1ado para aprovechar al m\u00e1ximo la realidad virtual, ofreciendo una experiencia altamente inmersiva y realista.\n\n\n\n# Protege a un compa\u00f1ero \u00fanico\n\nLa peque\u00f1a criatura a tu lado es m\u00e1s que un simple compa\u00f1ero de viaje\u2014es un elemento vital del juego. Comun\u00edcate con ella, comprende sus necesidades y combinen sus habilidades para sobrevivir. Pero ten cuidado... si cae en las manos equivocadas, se acab\u00f3 la partida.\n\n\n\n# Escapa de las sombras que te acechan\n\nNo est\u00e1s solo en esta casa. Algo maligno acecha en la oscuridad, observ\u00e1ndote. Deber\u00e1s moverte con cuidado, permanecer en silencio y encontrar la manera de esquivar a las criaturas que te persiguen.", "short_description": "Helping Hand es un juego de plataformas y puzles en VR donde el jugador debe salvar una criatura recien nacida de una casa infestada por presencias oscuras. Colabora con la criatura, resuelvan los puzles y escapen de los monstruos que lo persiguen en una aventura que te dejar\u00e1 sin aliento."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/eruptingmoka/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Meta Oculus Store", "support_website_url": null, "website_url": "https://sites.google.com/view/eruptingmoka/main", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "es", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9600282213340517"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "801706999631731"}, {"status": "PUBLISHED", "id": "3215803375286837"}, {"status": "PUBLISHED", "id": "937668805424857"}, {"status": "PUBLISHED", "id": "1428367255464118"}, {"status": "PUBLISHED", "id": "1096791942331862"}, {"status": "PUBLISHED", "id": "1623207328648455"}, {"status": "PUBLISHED", "id": "1128247342579616"}, {"status": "PUBLISHED", "id": 
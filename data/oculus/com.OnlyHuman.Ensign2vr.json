uluscdn.com&_nc_ss=7f20f&oh=00_AQIdXB5Q6gOd41KzPzEZEMMuL6d23Q-0dmcZ2tqR-xISzA&oe=6AA6B725"}, {"file_name": "Screenshot3.png", "id": "158602842771021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_158602846104354_4308534804675945287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caR_lSoHjCYQ7kNvwHL2EwP&_nc_oc=Adqcu5ndudZh4kbXNW-KpF4HwVTdelr6RMOCe9wzJYCwnAjjd9TS-mkvgLwiOOCN0ew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtmBVXptQZElDa6Guj9KqP32wC_hpk9uFEEq1sBDSeOA&oe=6AA6A33D"}, {"file_name": "Screenshot5.png", "id": "854546608426107", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031468_854546611759440_8059704989030342245_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OW8zAiRQGbMQ7kNvwGOw0ZQ&_nc_oc=Adp7QNVhA4BRdqlUFyaq-Iz-m5xjwbPb77rIgv2RjiA8c4pEWdB8Ms8Wwrayh2lh3VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6Wch0nJWX6SynYi3EFZSYraQ2biC3hcfdhiRxVhiZCQ&oe=6AA6C3FF"}, {"file_name": "Screenshot2.png", "id": "120463376691687", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_120463380025020_3766637278220880444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcqEQ5a0_88Q7kNvwE6c9DE&_nc_oc=Adq-s0Yb6-CB2LBnRPlHc1_tS03z9S3kWYRB1VNHYqlfU4vsmuyyBsQ7NhNUl_FY31A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4A253_V6HjsckenXtbbvZMIJcONJ9eiX-53ERLUQ2jw&oe=6AA698EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerScreenshot.png", "id": "3465163723593541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_3465163730260207_1427127429038847667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fA8fB404uxYQ7kNvwH44T9u&_nc_oc=AdqwKRH8oAbUH0Pmgrx-zKE7KpyZoFf5jGMeHvSEvWidYoqSPXOk9hKi4keFWT0_jm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWQGTPXR1cXCjb1stlCwqSA0siCLKyEt5xq7aXa1TNig&oe=6AA6C679"}, "display_name": "Symphony of Stars", "keywords": [], "long_description": "Play Symphony of Stars how you like! Fly around gazing at the stars and planets, or engage in combat, take over planets and build your faction's empire! If you choose the later, you'll need to use a bit of strategy as there are other factions vying for control of the system in the game. Build up resources, and properly leave planets defended before moving on the attack.\n\nFeatures:\n-3 Different playable factions, each with their own style of ship\n-Randomly generated maps, each game is different!\n-AI Difficulty levels, and team settings. Up the AI difficulty and try to take them down with a friend if you'd like!\n-Online multiplayer, play with up to 9 other humans or hone your skills against the AI!", "short_description": "Either enjoy the sights of a randomly generated system or conquer territory and build defenses, your call."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": null, "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635367961132030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974517_222403809692989_1333789486330951
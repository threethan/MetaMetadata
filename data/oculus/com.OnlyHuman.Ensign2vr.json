uluscdn.com&_nc_ss=7f20f&oh=00_Af4P_N0pRbe-xZ0Nlr0WuWYs5M1JPOxz4fOzQViQc0gENw&oe=6A09D4A5"}, {"file_name": "Screenshot3.png", "id": "158602842771021", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031440_158602846104354_4308534804675945287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3WpWBdpc0oQ7kNvwFY4eU9&_nc_oc=AdrW5Nz0FBHe6SRl7eUljhljk0HcZaf3qlLx78XNvn2R2NPVcliwQ4P6BGfBd_Wmtd4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af661whLIHJqcoV1VLpFLI9lpAUBxoAJvC67EkN47dfZXA&oe=6A09C0BD"}, {"file_name": "Screenshot5.png", "id": "854546608426107", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031468_854546611759440_8059704989030342245_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTgqvpVfPYkQ7kNvwGf0O0S&_nc_oc=AdpsXnqrBPGv1nWPDucVYzepkJprkTkrY5FxE-xlp3EkkDNWQpvOV7Gb_o9ALbtx52o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HOu1gMDa-H5L11wwfJfF4yqdvIE5LY4u0AoKs4RFvtg&oe=6A09E17F"}, {"file_name": "Screenshot2.png", "id": "120463376691687", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974844_120463380025020_3766637278220880444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgUT88CH_4AQ7kNvwFDqmSF&_nc_oc=Adp88qI2eLnkrPKYeqgmSEG7L_h1Cgx-v7LmrsE5sxukbvSi0Kg_vlrIx-UbH-jGhS8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FICQpdlqudeg9rIpXWW3gDP1U_W67MFg8NuJ6vNHQDg&oe=6A09B66C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerScreenshot.png", "id": "3465163723593541", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974887_3465163730260207_1427127429038847667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcuN7544YrsQ7kNvwGfDKTn&_nc_oc=AdqeyUN1-KC2Z2iwhYlkXg_bcNLGqcBSrnjuR64_S2RcSrLB79vHhByW3KqcX6M4M7o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w98goW_5Z1nQoa24e_4jTOecG0CG8xFDUQynGogvsiQ&oe=6A09E3F9"}, "display_name": "Symphony of Stars", "keywords": [], "long_description": "Play Symphony of Stars how you like! Fly around gazing at the stars and planets, or engage in combat, take over planets and build your faction's empire! If you choose the later, you'll need to use a bit of strategy as there are other factions vying for control of the system in the game. Build up resources, and properly leave planets defended before moving on the attack.\n\nFeatures:\n-3 Different playable factions, each with their own style of ship\n-Randomly generated maps, each game is different!\n-AI Difficulty levels, and team settings. Up the AI difficulty and try to take them down with a friend if you'd like!\n-Online multiplayer, play with up to 9 other humans or hone your skills against the AI!", "short_description": "Either enjoy the sights of a randomly generated system or conquer territory and build defenses, your call."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": null, "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635367961132030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974517_222403809692989_1333789486330951
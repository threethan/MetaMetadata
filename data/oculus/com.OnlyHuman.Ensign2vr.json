YlHJRSiWUcbZubB8k2_LTPH1tIInQvaNS5z90cPBw&oe=69A99725"}, {"file_name": "Screenshot3.png", "id": "158602842771021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_158602846104354_4308534804675945287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRAYF-5IlB0Q7kNvwEtisX-&_nc_oc=AdnFVfxWJFuCtlss0cqGUiO_EHq142ZSH4YOm6twjIVzV98cMhi4G7DbK8pkOGKtFTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfteDkjqF9qnTzrlTaJn7CLRXzaeSWw4VR-bZglF0_KpCw&oe=69A9833D"}, {"file_name": "Screenshot5.png", "id": "854546608426107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031468_854546611759440_8059704989030342245_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8NbExeyYGUQ7kNvwH6lPcw&_nc_oc=AdlQ3NjtzV9A9aX08bk6T92I04cccemvW9nGSnOo1776Ncyoq5vTJdLpd_6YdDt_jtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuTMVb86u9kLezJblf1xvbBdiIvK6u06KD47PXux3aPGQ&oe=69A96BBF"}, {"file_name": "Screenshot2.png", "id": "120463376691687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974844_120463380025020_3766637278220880444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP8rdP33XeMQ7kNvwFQXGV6&_nc_oc=AdkieCcP5TNi7ypuCgXkhefZcq2p0l4nvvVouNgUeXT7CL1dI3Xnyo-sBOhhFPh8X04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft_NdvHLHe0NJNSWdScxzHUNzf08cy6FfY-tIRg64th_A&oe=69A978EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerScreenshot.png", "id": "3465163723593541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_3465163730260207_1427127429038847667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsdmS5BPcQwQ7kNvwGnnqW7&_nc_oc=AdkgzNs-F5rEFzD1mVBpeh-A3L4C19xOqourGoVqtKhM5Johp1PYnV6Tzn2pqLv0Hmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs1Aq3LZEAECY2H7uTcTC0kJTLF6kkm_GO_u5wEBeCtQw&oe=69A96E39"}, "display_name": "Symphony of Stars", "keywords": [], "long_description": "Play Symphony of Stars how you like! Fly around gazing at the stars and planets, or engage in combat, take over planets and build your faction's empire! If you choose the later, you'll need to use a bit of strategy as there are other factions vying for control of the system in the game. Build up resources, and properly leave planets defended before moving on the attack.\n\nFeatures:\n-3 Different playable factions, each with their own style of ship\n-Randomly generated maps, each game is different!\n-AI Difficulty levels, and team settings. Up the AI difficulty and try to take them down with a friend if you'd like!\n-Online multiplayer, play with up to 9 other humans or hone your skills against the AI!", "short_description": "Either enjoy the sights of a randomly generated system or conquer territory and build defenses, your call."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": null, "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635367961132030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_222403809692989_1333789486330951429_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_
uluscdn.com&_nc_ss=7f20f&oh=00_Af8gf_jZSJjNZ0TY5j-Tat1lOh6nCQUa3fiQ16HXb-39Uw&oe=6A3E90A5"}, {"file_name": "Screenshot3.png", "id": "158602842771021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031440_158602846104354_4308534804675945287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdqCKYxqzHEQ7kNvwGnTUfG&_nc_oc=AdqY-ftMK2sgQefLqSCZYRYWCE5H_sA95kmEMFpgftRSPs_zWx2v3VP3XVyUBqS4cMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8shV4QxGjremAmivFIwTDsbaO7-AcpLFSjHq_hSPq6Nw&oe=6A3E7CBD"}, {"file_name": "Screenshot5.png", "id": "854546608426107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031468_854546611759440_8059704989030342245_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuFEL_4DhBoQ7kNvwE6hgx4&_nc_oc=AdpyhM9NfUQanoSJyDwooy_jkNCkg0_Sgi01N9AdtYQlo1QAjRPfoR9V6Nt8WjKNsMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZXBHcoAyqMDC2WcOcqoUrB0VWcwJtsgiMcBRGmUKP6Q&oe=6A3E9D7F"}, {"file_name": "Screenshot2.png", "id": "120463376691687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_120463380025020_3766637278220880444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1DRiF-okhwQ7kNvwFLtj8a&_nc_oc=AdoMfeHAlIIzIRo9IrGpQo6LgzNENT-6z6DY6O_EsGwvGO7CYrD-8I8qbjv5OsAbKGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_BRNVgNp5thR59GmH9cI5iBcRaKc6JYwQiBR4SoQ_-w&oe=6A3EAAAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerScreenshot.png", "id": "3465163723593541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_3465163730260207_1427127429038847667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGSdN3w6nUoQ7kNvwHpCWtI&_nc_oc=AdofRFhKmknZuzI7-A2LIAFtXGUFfxwEhGgRNAkJRdb7jPjAJTM5H3iODH95t2F850Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ptvncJlLkU_sqGj4z4bA5ZPxp6oKmsuB_uxm99Wnv0Q&oe=6A3E9FF9"}, "display_name": "Symphony of Stars", "keywords": [], "long_description": "Play Symphony of Stars how you like! Fly around gazing at the stars and planets, or engage in combat, take over planets and build your faction's empire! If you choose the later, you'll need to use a bit of strategy as there are other factions vying for control of the system in the game. Build up resources, and properly leave planets defended before moving on the attack.\n\nFeatures:\n-3 Different playable factions, each with their own style of ship\n-Randomly generated maps, each game is different!\n-AI Difficulty levels, and team settings. Up the AI difficulty and try to take them down with a friend if you'd like!\n-Online multiplayer, play with up to 9 other humans or hone your skills against the AI!", "short_description": "Either enjoy the sights of a randomly generated system or conquer territory and build defenses, your call."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": null, "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635367961132030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_222403809692989_1333789486330951
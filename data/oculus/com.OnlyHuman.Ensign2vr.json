uluscdn.com&_nc_ss=7a30f&oh=00_Af2-vVyIEGWYd0zCEu8xYi4Cxp4EXxgj_8LIDzVMaJ40og&oe=69D7BBA5"}, {"file_name": "Screenshot3.png", "id": "158602842771021", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031440_158602846104354_4308534804675945287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HqBR7cbUPEQ7kNvwFpaWLP&_nc_oc=AdrWvbR6d0FKH0EneqrzmZHTCWavHcxeq0Y3vr7b0hVHtCyuK_O8OBLfrLy9Oxf4f_k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af301f4pK2fK3Er2dMX4wo-Z4Mq2RcnDPbCkEF225-t0xQ&oe=69D7A7BD"}, {"file_name": "Screenshot5.png", "id": "854546608426107", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031468_854546611759440_8059704989030342245_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAm74PQ2DaUQ7kNvwHSWj6v&_nc_oc=AdoiWLb1ExKkXNV3s5GWyZ45X8m4Fc8JuJ5X9s1XKCkKUfmgBRFCMViZnxnlSABVzAo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m9Pq4WVYyFOdDNo3AYgeNRvMj5_uL4Wx1o-aMIba78Q&oe=69D7903F"}, {"file_name": "Screenshot2.png", "id": "120463376691687", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974844_120463380025020_3766637278220880444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aozdVBSQ1C4Q7kNvwFVBjR_&_nc_oc=Adp6_W6kmuIiLk5S4ePAbjOV2o89bTq4SqAvQ2V8JX_ZYPVOV0dvpYCyygr60DOPAbk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TzVDrij9bIL3efwB-xttwDTPpiNK5zEwYoAmC13ZctA&oe=69D79D6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerScreenshot.png", "id": "3465163723593541", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974887_3465163730260207_1427127429038847667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyUnd_O7zyoQ7kNvwGNmQqV&_nc_oc=AdrZ7jQsGWhP3g2fo3ej4ypewG6fLC6m7kyikEgHwaGMvLxOh5bZNSGYt6UCIwY6VvY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i-YmQ-_q77vp4jGcu042nmjLVh2ZiB_7OzIft82_zQg&oe=69D792B9"}, "display_name": "Symphony of Stars", "keywords": [], "long_description": "Play Symphony of Stars how you like! Fly around gazing at the stars and planets, or engage in combat, take over planets and build your faction's empire! If you choose the later, you'll need to use a bit of strategy as there are other factions vying for control of the system in the game. Build up resources, and properly leave planets defended before moving on the attack.\n\nFeatures:\n-3 Different playable factions, each with their own style of ship\n-Randomly generated maps, each game is different!\n-AI Difficulty levels, and team settings. Up the AI difficulty and try to take them down with a friend if you'd like!\n-Online multiplayer, play with up to 9 other humans or hone your skills against the AI!", "short_description": "Either enjoy the sights of a randomly generated system or conquer territory and build defenses, your call."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": null, "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635367961132030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974517_222403809692989_1333789486330951
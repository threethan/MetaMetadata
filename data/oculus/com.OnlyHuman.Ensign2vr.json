uluscdn.com&_nc_ss=7f20f&oh=00_AQIw06IU7Kr7Kg5Y5YLtlq1wUzlXAfo9oKMF1oIwcaKoDA&oe=6ABE7225"}, {"file_name": "Screenshot3.png", "id": "158602842771021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031440_158602846104354_4308534804675945287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsvU7Xa-iz4Q7kNvwEptRgv&_nc_oc=Adqu0R0NMKgSGnkk0vsBjRrhIix5YV5i3V1ryXuVNvZIso1FL7KItu-j9UMVPDsqhzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdCFBp0rrfpiMH15rwukSiF3s4YCkSNvn1Si8awo7dDA&oe=6ABE5E3D"}, {"file_name": "Screenshot5.png", "id": "854546608426107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031468_854546611759440_8059704989030342245_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_8dB2tBEvQQ7kNvwF9gB4j&_nc_oc=AdpS1SgJJ93Vkdv3-Zqrz3DAANEIxaULenZ4VSBV2edcb4NDgijEgf_9ariM1RafgzU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-Zq4yJLL4FRGM1U1V9RAvBdVZ42OWhL4gAQzYyeLYXw&oe=6ABE7EFF"}, {"file_name": "Screenshot2.png", "id": "120463376691687", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974844_120463380025020_3766637278220880444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiOYk6sewuAQ7kNvwFOi1Sx&_nc_oc=AdomovokvBnSvaDQJRYXl4sAMOXN4p_i6j4UDbdObVbrCKWe4AOFsUFNaZhMqjBewgw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxjPiw96HUmWYBmEwC_a0bkIf5SpoSHAlXzmEImO5l4g&oe=6ABE8C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerScreenshot.png", "id": "3465163723593541", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974887_3465163730260207_1427127429038847667_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMK7vrG5N1wQ7kNvwH1vZFD&_nc_oc=AdoDYDXCD5nU2SXDPR-3HFM8H46xggls3SpadbTw33UQUENEX2UAsXFy538lly-PohQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJczYY657eANdDEW5PXg4707QZS-MOvErmxefLFtDoYOA&oe=6ABE8179"}, "display_name": "Symphony of Stars", "keywords": [], "long_description": "Play Symphony of Stars how you like! Fly around gazing at the stars and planets, or engage in combat, take over planets and build your faction's empire! If you choose the later, you'll need to use a bit of strategy as there are other factions vying for control of the system in the game. Build up resources, and properly leave planets defended before moving on the attack.\n\nFeatures:\n-3 Different playable factions, each with their own style of ship\n-Randomly generated maps, each game is different!\n-AI Difficulty levels, and team settings. Up the AI difficulty and try to take them down with a friend if you'd like!\n-Online multiplayer, play with up to 9 other humans or hone your skills against the AI!", "short_description": "Either enjoy the sights of a randomly generated system or conquer territory and build defenses, your call."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": null, "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635367961132030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_222403809692989_1333789486330951
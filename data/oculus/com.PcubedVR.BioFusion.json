1_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlgA-Kqa2b4Q7kNvwHcWqMN&_nc_oc=AdmK924sJ7UUU6zqj0xKorrSbmnI4WSkuIbI3DBSBZ5N__4eeIiXPTwQYgY15n5FFiE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afwdi01zG2DSTLRLY8tfPHsCkKZ8lbx_Y6bpQMOKC02DpA&oe=69AAE1F7"}]}, "id": "1623954815054353", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "2323885224471824", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031509_2323885227805157_3849159972907396116_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzbbC2XAUMkQ7kNvwE0sF5k&_nc_oc=AdkVLnrQjSNfp73veRpN7oJsb5XCJUaaUIqJjYOLdt1cgzoMN1_OWueYX85bxbpPWyM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afxyj3Fgc4gD8sWUzR6PPW8fd8PGMxDeOFMptklesX_5MQ&oe=69AAB96B"}, {"file_name": "Screenshot4.png", "id": "711052261242323", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031482_711052264575656_145906962000979868_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qj25ae1yyMQ7kNvwEfQsxF&_nc_oc=AdlzR3uhLVfKz85tSq1jkYnJTXYCGsZbT7cUetbxEBHH4IC_UWOppPmDuNSAxGxKQA8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzotiDYHjaXAn13l5JXRjfTFBGEnvXlFrkYtPHntrhbZA&oe=69AAC387"}, {"file_name": "Screenshot1.png", "id": "1195386941453823", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984465_1195386944787156_2729726899463288967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTTxgR_3C9gQ7kNvwFdqfCx&_nc_oc=AdlgGTmAlkwH4u6E-s1wbphFGSwDT9ueX4xfgg6NrZTuiZqSTATfLaLgBtoT_Gq7n5Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afwc4oB4GekzHHLfKZfN9FKf0IliD4RV9K4rJ-uo2ZFoAw&oe=69AAB871"}, {"file_name": "Screenshot3.png", "id": "2132324853766784", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75221325_2132324857100117_5480907344673957562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U23ge9-IQuIQ7kNvwE47NxE&_nc_oc=AdkMCcWAUuvXxs55sHkWDSHUzMbhGi7JWxvalRVcRdKZGJ5EL6dZ0TPn748GrZeJvu8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx16A6wTbNNPFxwJlD9rE1cADsfPo-_IvmV8oyE1yZj3w&oe=69AAB3F7"}, {"file_name": "Screenshot5.png", "id": "1072943187118954", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/227815879_1072943193785620_2091196681815594690_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5Lh8jjkq5sQ7kNvwH3KF9c&_nc_oc=Adk4mnrM_2Gt-CiAZuQ1xo5-9EZcyUvqO84-QEUvtTRCgh5Emt2RUY0o9mEeJmzBtYc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzaEhKY5lY8wc1g9RKIhO4D9V-D1lPRs4kw1LajxEYCyQ&oe=69AAD558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1587891288717694", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035357_1587891292051027_1243733606799763185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hc85bDHel2gQ7kNvwFUdwcS&_nc_oc=AdlfNmSQEMdrvyd0wB90eaKLUVg1Hy0geWRf6f0CZDG-k_5k3sdIurCn1hAE5HatJmc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afxw4TRPtnNdvd8jnnZbCS7McUFyL5TfX-cENhdZZk3u-g&oe=69AAC4BF"}, "display_name": "BioFusion", "keywords": [], "long_description": "BioFusion is a VR co-op multiplayer, PvE, first-person shooter, tower defense game. You play as a Soldier or a Strategist. As a Soldier, you grapple, shoot, throw grenades from the ground, air, or on a hovercraft. As a Strategist, you build walls, towers, traps, wielding a bow and a saber. You collect DNA buffs along the way to specialize your hero. Together you defend the Spores of Evolution from hordes of the evil HW corporation. With multiple heroes and new game mechanics not seen before in a VR action-tower defense game. Locomotion options include smooth, teleport, head-based, controller-based, arm-swing, and more. Comfort features include Vignette, Teleport, Snap turning, Arm swing locomotion.\n\nFeatures:\nPlay with up to 3 friends\n2 playable heroes: Soldier and Strategist\n7 scenes: Tutorial, Hangar, Orchard, City, River, Underground River, and Forest\n3 difficulties: Easy, Normal, and Hard\n14 DNA buffs to collect, evolve, and install\nGameplay length: 20+ hours\n9 enemy types\nA dozen weapons\nMore than a dozen traps and towers\n4 comfort features: Vignette, Teleport, Snap turning, Arm swing locomotion\n8 modes of locomotion: Grappling, Climbing, Hang Gliding, Hovercraft, Driving a boat, Arm swing, Teleport, and the standard thumbstick-based movement\n", "short_description": "BioFusion is a VR co-op multiplayer, PvE, first-person-shooter, tower defense game. Swing on a grappling hook, ride a hovercraft, throw grenades, collect buffs, build towers and traps. Do what you must to keep the mutants from the Spores of Evolution."}]}, "developer_name": "Pcubed Virtual Reality", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hrPHPlXXVEOqMv24BhztmN323UY52yLpX91PJxOyhv4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pcubed Virtual Reality", "support_website_url": null, "website_url": "https://www.facebook.com/BioFusionVR", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "26544866055127114"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "8624921037535906"}]}, "baseline_offer": {"id": "8624921037535906"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730185560, "status": "PUBLISHED", "id": "8624921037535906"}]}, "liveChannel": {"nodes": [{"latest_support
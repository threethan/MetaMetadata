t=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR2zEQayMQOqcVgWTIeNnBpA6uvW9GOaZqzS9yMIW7nA&oe=6AE35FB7"}, {"file_name": "Screenshot5.png", "id": "1072943187118954", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/227815879_1072943193785620_2091196681815594690_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quvshPBvqDYQ7kNvwE-lNJs&_nc_oc=AdpYaoO8jMaXicRdj7ounnVn_SPronXZRFF2HNrSw1mIin3uYt8vsSsM2hKMLdnZVX0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPucWaLZ0kqZclxOwC-hf01kE7H60u_WMzkG78fqse4Vg&oe=6AE348D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1587891288717694", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035357_1587891292051027_1243733606799763185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIf5wUTWIUAQ7kNvwFu-keS&_nc_oc=AdpfjmBvlCs9AFp0xctAVKQPHb245Z83jSdZ4ju0tIWVWqg0IeDSQJqqAgjPaPnYL84&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1cEQqln1ojKVFLyDAGTd5EaYCyiireAVPZ_G6rAE9SQ&oe=6AE3383F"}, "display_name": "BioFusion", "keywords": [], "long_description": "BioFusion is a VR co-op multiplayer, PvE, first-person shooter, tower defense game. You play as a Soldier or a Strategist. As a Soldier, you grapple, shoot, throw grenades from the ground, air, or on a hovercraft. As a Strategist, you build walls, towers, traps, wielding a bow and a saber. You collect DNA buffs along the way to specialize your hero. Together you defend the Spores of Evolution from hordes of the evil HW corporation. With multiple heroes and new game mechanics not seen before in a VR action-tower defense game. Locomotion options include smooth, teleport, head-based, controller-based, arm-swing, and more. Comfort features include Vignette, Teleport, Snap turning, Arm swing locomotion.\n\nFeatures:\nPlay with up to 3 friends\n2 playable heroes: Soldier and Strategist\n7 scenes: Tutorial, Hangar, Orchard, City, River, Underground River, and Forest\n3 difficulties: Easy, Normal, and Hard\n14 DNA buffs to collect, evolve, and install\nGameplay length: 20+ hours\n9 enemy types\nA dozen weapons\nMore than a dozen traps and towers\n4 comfort features: Vignette, Teleport, Snap turning, Arm swing locomotion\n8 modes of locomotion: Grappling, Climbing, Hang Gliding, Hovercraft, Driving a boat, Arm swing, Teleport, and the standard thumbstick-based movement\n", "short_description": "BioFusion is a VR co-op multiplayer, PvE, first-person-shooter, tower defense game. Swing on a grappling hook, ride a hovercraft, throw grenades, collect buffs, build towers and traps. Do what you must to keep the mutants from the Spores of Evolution."}]}, "developer_name": "Pcubed Virtual Reality", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hrPHPlXXVEOqMv24BhztmN323UY52yLpX91PJxOyhv4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pcubed Virtual Reality", "support_website_url": null, "website_url": "https://www.facebook.com/BioFusionVR", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "26544866055127114"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "301368768
{"file_name": "ScreenShot6.png", "id": "751917940209552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574724_751917943542885_3806754222038399568_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG3WjRB_Z1kQ7kNvwHXR_jo&_nc_oc=AdrNmGETFMZAwxiELK5uZ7QhMYU6HfGfzwsVp4ZnqA1usF8_igtBRBk92gWMZGjcKCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaVayX5l-i0RZTE_2R5cKyY8uI--ClMxTdRKIMGzHkRQ&oe=6B06FF4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84\uc774\ubbf8\uc9c03_2560_1440.png", "id": "2297397257136962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86621370_2297397260470295_7834540359335135189_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMkxJ-BU5uYQ7kNvwGzlDf1&_nc_oc=AdrCb7YGFkB_3h1EHsknl1aFOvBGkIYDq7wCnf49_MVJ0ikS5gDg3jZeBhdvDVwZHVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhmwYvSU3sGNcKdjUvA2daX5kla26f2QEsc4YPwqSZ2Q&oe=6B07152B"}, "display_name": "Smart Healthcare", "keywords": [], "long_description": "\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740, NIPA(\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0)\uac00 \n2023\ub144 \uac1c\ubc1c\ud55c \uc2e4\uac10 \uad50\uc721 \ucf58\ud150\uce20 VR \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4.\n\n2019\ub144\ubd80\ud130 NIPA\ub294 4\ucc28 \uc0b0\uc5c5\ud601\uba85 \uc2dc\ub300\ub97c \ub300\ube44\ud574 \ubbf8\ub798 \uc9c1\uc5c5 \ud658\uacbd \ubcc0\ud654\ub97c \ubc18\uc601\ud55c \n\uccb4\uacc4\uc801\uc778 \uc9c4\ub85c \uccb4\ud5d8 \uad50\uc721 \ud504\ub85c\uadf8\ub7a8\ub4e4\uc744 \uac1c\ubc1c\ud574 \uc654\uc2b5\ub2c8\ub2e4.\n2023\ub144\uc5d0\ub294 <2035\ub144 \uc2a4\ub9c8\ud2b8\uadf8\ub9b0\uc2dc\ud2f0>\ub97c \ubc30\uacbd\uc73c\ub85c \ubbf8\ub798\uc758 \uc720\ub9dd\ud55c \uc0b0\uc5c5\uacfc \uc9c1\uc5c5 \ubd84\uc57c\uc758 \uad6c\uccb4\uc801\uc778 \uc9c4\ub85c \uc8fc\uc81c \ubc1c\uad74\uc744 \uc704\ud55c \uccad\uc18c\ub144 \ub300\uc0c1 \ucf58\ud150\uce20\ub4e4\uc774 \uac1c\ubc1c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \n\n\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740 \uccad\uc18c\ub144 \ub300\uc0c1\uc73c\ub85c, \u2018\ubbf8\ub798\uc758 \uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4\u2019\ub97c \uc18c\uc7ac\ub85c \uc81c\uc791\ub418\uc5c8\uc73c\uba70,\n \n1) \ubbf8\ub798\uc758 \uc2a4\ub9c8\ud2b8 \ud648\uc5d0\uc11c\uc758 \uc6b0\ub9ac\uc758 \uc77c\uc0c1\n2) \ub9de\ucda4\ud615 \ud5ec\uc2a4\ucf00\uc5b4 \uc11c\ube44\uc2a4 \uccb4\ud5d8\n3) \uc2a4\ub9c8\ud2b8 \ud648\uc758 ICT \uae30\uc220 \uccb4\ud5d8\n\n\uc774 \ubc18\uc601\ub41c \uacf5\uac04\uc5d0\uc11c \u2018\uac1c\uc778 \ub9de\ucda4\ud615 \ud5ec\uc2a4\ucf00\uc5b4 \uc11c\ube44\uc2a4\u2019\ub97c \uacbd\ud5d8\ud574 \ubcf4\uace0, \uc774\ub97c \ud1a0\ub300\ub85c \u2018\uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4\u2019\uc5d0 \ub300\ud55c \uc804\ub9dd\uacfc \ubbf8\ub798\uc758 \uc9c4\ub85c \ud0d0\uc0c9\uc73c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\ub3c4\ub85d \uac1c\ubc1c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.  \n \n\uc790\uc2e0\uc774 \uafb8\ubbfc \uce90\ub9ad\ud130\ub85c \uba54\ud0c0\ubc84\uc2a4\ub97c \ud0d0\ud5d8\ud558\ub294 \ubab0\uc785\uc801\uc778 \uccb4\ud5d8\uc740, \n\ubbf8\ub798\uc758 \uc720\ub9dd\ud55c \uc0b0\uc5c5\uad70\uc73c\ub85c\uc368 - \u2018\uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4\u2019 \uc5f0\uacc4 \uc9c1\uc5c5\uad70\uc5d0 \uc880 \ub354 \uad00\uc2ec\uc744 \ub450\ub294\ub370 \uae30\uc5ec\ud560 \uac83\uc774\ub77c \ubbff\uc2b5\ub2c8\ub2e4.\n\uc218\uc900 \ub192\uac8c \uad6c\ud604\ub41c \ubbf8\ub798\uc758 \uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4, VR\ub85c \uacbd\ud5d8\ud558\uc138\uc694.\n\nstep 0 \uccb4\ud615\uce21\uc815\nstep 1 \ud29c\ud1a0\ub9ac\uc5bc\nstep 2 \uce90\ub9ad\ud130 \uc120\ud0dd\nstep 3 \ub370\uc77c\ub9ac \uc9c4\ub2e8\nstep 4 \ub9de\ucda4\ud615 \uc2dd\ub2e8 \ub9cc\ub4e4\uae30\nstep 5 \ub9de\ucda4\ud615 \uc6b4\ub3d9 \uccb4\ud5d8\ud558\uae30\nstep 6 \ub9de\ucda4\ud615 \uc218\uba74 \uad00\ub9ac \uccb4\ud5d8\ud558\uae30\nstep 7 \uac74\uac15\ud55c \ubab8\uacfc \ub9c8\uc74c \ub2e4\uc9d0\ud558\uae30\n\n* \ubcf8 VR \ucf58\ud150\uce20\uac00 \ub9e4\ub825\uc801\uc774\uc5c8\ub2e4\uba74, NIPA(\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0)\uc5d0 \ubb38\uc758\ud558\uc138\uc694. \n<\ucc3e\uc544\uac00\ub294 \ub9de\ucda4\ud615 \uc2e4\uac10 \uad50\uc721 \uc9c4\ub85c \uccb4\ud5d8 \ud504\ub85c\uadf8\ub7a8>\uc774 \ub2f9\uc2e0\uc744, \n\ub2f9\uc2e0\uc758 \uccad\uc18c\ub144\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. ", "short_description": " \ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740, NIPA(\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0)\uac00 2023\ub144 \uac1c\ubc1c\ud55c \uc2e4\uac10 \uad50\uc721 \ucf58\ud150\uce20 VR \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4.\n\uac1c\uc778 \ub9de\ucda4\ud615 \ud5ec\uc2a4\ucf00\uc5b4 \uc11c\ube44\uc2a4\u2019\ub97c \uacbd\ud5d8\ud574 \ubcf4\uace0, \uc774\ub97c \ud1a0\ub300\ub85c \u2018\uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4\u2019\uc5d0 \ub300\ud55c \uc804\ub9dd\uacfc \ubbf8\ub798\uc758 \uc9c4\ub85c \ud0d0\uc0c9\uc73c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\ub3c4\ub85d \uac1c\ubc1c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://coin7.co.kr/privacy/HealthcareVR/PrivatePolicy.html", "developer_terms_of_service_url": null, "publisher_name": "NIPA(\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0)", "support_website_url": null, "website_url": "https://www.nipa.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
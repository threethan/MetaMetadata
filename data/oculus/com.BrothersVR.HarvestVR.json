goal is to release regular content updates, new mechanics, and tweaks to existing systems based on community feedback and discussions, so we would love for you to join us on our discord and help us shape this game!\n\nhttps://discord.gg/mM2UsAF\n\nFeatures\nEnjoy the countryside.\nGrow more than 15 different kinds of plants.\nSell vegetables to gain money and buy new tools.\nWork hard or hardly work.\nSave the game inside your house.\nDo some fishing.\nDo some mining.\nDo some cooking.\nPlay with real time OR play with a faster simulated time.\nUnlock items for your house or the farm!\nClimb some trees and pick some apples.", "short_description": "To the fields and beyond!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://brothersonline.gitlab.io/oculus-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brothers", "support_website_url": null, "website_url": "https://sidequestvr.com/app/1014/harvest-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8819847288068386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_404245000673413_8531073488048082605_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mvrr8CV6RuwQ7kNvwFKLze6&_nc_oc=AdpbrNx39_AJC3rqwPy1FYPqG2jGWJxV7aORSpfrV5AHC_NhoAUVNEwxT9P5hhdVsHY&_nc_zt=3&_n
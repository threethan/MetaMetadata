2-3.oculuscdn.com/v/t64.5771-25/75272209_436980627351613_3807760243494673014_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOxhP3hSGAQQ7kNvwGiAPe0&_nc_oc=Adq5bZWInaSY6GyE_VdeClHJHaJxzedGzlDlTvxEoT54svGS47zNzNXRlqLAEmSr98U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IOG6UcBejF8vssA4fLyYHyPCVy1uzaWeKiy7Zjoz9kw&oe=6A11B893"}, {"file_name": "screenshot1.png", "id": "496338391350165", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75340714_496338394683498_3778694375708730720_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU_9dxs4syAQ7kNvwHWB2Kb&_nc_oc=Adrj3hps9smy9k7stxXXaYQ91ebRRjwG5wIUebJmkPf5BwE-lcm0wqRiVVt-f-VfD5s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DYzBpljfgZQb1juQSf1VckZUqZTFOr0MC_6cxefAkiQ&oe=6A119E5B"}, {"file_name": "screenshot2.png", "id": "177327850396933", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75203627_177327853730266_3685753844176577487_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCE_sef4G-UQ7kNvwFwIJPC&_nc_oc=AdqYiN2Y-VlWwsoxiMWQysQ7U8M_aHa1uw0ayQn9Dyiuo3k9pEvTbPzk2um5sSH_OJU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JHOQM-DZy23MblxNDgGaPEDfOF4Vs0PakVACqZ_wAbw&oe=6A11A5FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974670_324097625384527_7952002618746171551_n.png", "id": "1137085056750302", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75222943_1137085060083635_2596374840528329208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTkaa_rpcNsQ7kNvwEoq84i&_nc_oc=AdrqtXOPpOSXQCY2Xo9qzFPEzvvxmjyiS3ZqAfTfn4alporPog113r-YB-rbXDJk_6k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q5PhaYhmyVvnZLtLr5fpw78T4WHMJ5O-bdRzD1tu5ZA&oe=6A11A554"}, "display_name": "Harvest VR", "keywords": [], "long_description": "It's a beautiful day out here in the countryside. Might as well enjoy it doing your job. Grow some plants, sell some veggies, or head to town to buy some new tools for the farm.\n\nOur goal is to release regular content updates, new mechanics, and tweaks to existing systems based on community feedback and discussions, so we would love for you to join us on our discord and help us shape this game!\n\nhttps://discord.gg/mM2UsAF\n\nFeatures\nEnjoy the countryside.\nGrow more than 15 different kinds of plants.\nSell vegetables to gain money and buy new tools.\nWork hard or hardly work.\nSave the game inside your house.\nDo some fishing.\nDo some mining.\nDo some cooking.\nPlay with real time OR play with a faster simulated time.\nUnlock items for your house or the farm!\nClimb some trees and pick some apples.", "short_description": "To the fields and beyond!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://brothersonline.gitlab.io/oculus-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brothers", "support_website_url": null, "website_url": "https://sidequestvr.com/app/1014/harvest-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8819847288068386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75363517_404245000673413_8531073488048082605_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPb723WPI9kQ7kNvwFER0h8&_nc_oc=AdpuK6f4CBALyz-rFGcetbyqCt-PdlEQhPlc-z53g_CYKrEh7alzXJzQYCcU-YPzzfk&_nc
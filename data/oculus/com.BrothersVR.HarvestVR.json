dn.com/v/t64.5771-25/75203627_177327853730266_3685753844176577487_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5SQiVt6SsgQ7kNvwEUfFkk&_nc_oc=AdpHPDga0QqNxtvI2COncTg3J6OLL54K8puWlurZlgZikTuC10pxr0HYd7T8DNmBp5Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSyfQJqyV_HXDx9U__iiddJqm0km8MJ1JBA7wCwzsCWw&oe=6AE8C2BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974670_324097625384527_7952002618746171551_n.png", "id": "1137085056750302", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222943_1137085060083635_2596374840528329208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6DKt4UKxuAQ7kNvwHMhHaI&_nc_oc=AdoQ7q9abPXr5ftLB2UfZnKKWkYPiiP8XVHAYV2gannORGkLd4miTx4vJbzbwVG9dGE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd7-qkwupzMRWfVENsa0mOA2iDvsR8rf23e_lAgkFfTg&oe=6AE8C214"}, "display_name": "Harvest VR", "keywords": [], "long_description": "It's a beautiful day out here in the countryside. Might as well enjoy it doing your job. Grow some plants, sell some veggies, or head to town to buy some new tools for the farm.\n\nOur goal is to release regular content updates, new mechanics, and tweaks to existing systems based on community feedback and discussions, so we would love for you to join us on our discord and help us shape this game!\n\nhttps://discord.gg/mM2UsAF\n\nFeatures\nEnjoy the countryside.\nGrow 8 different kinds of plants.\nSell vegetables to gain money and buy new tools.\nWork hard or hardly work.\nSave the game inside your house.\nDo some fishing.\nUnlock items for your house or the farm!\nClimb some trees and pick some apples.", "short_description": "To the fields and beyond!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://brothersonline.gitlab.io/oculus-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brothers", "support_website_url": null, "website_url": "https://sidequestvr.com/app/1014/harvest-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "513850357091534"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1504685516589289"}]}, "baseline_offer": {"id": "1504685516589289"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1615400400, "status": "PUBLISHED", "id": "1504685516589289"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27009714168655087", "version": "1.4"}, "id": "899340697274201", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3782210318498800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27009714168655087"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "899340697274201"}]}, "change_log": "Complete changelog\n\n## Highlights\n\nReturn of the old mine!\nSome of you might remember the old mine which was in the game WAY back when the mine wasn't random generated yet. I felt it was too awesome to leave out of the game, so I repurposed it.\n\nBuild mode rework.\nRebuild build-mode from the ground up so decorations can be placed anywhere you like! (even outside of your house).\n\nDialogue system rework.\nChat system Rework:\nAll chat dialogues are now graph based for way easier adding dialoging + allowing for chat branching.\n\nQuest system rework.\nThe quest system had a complete overhaul. It's now completely NPC independent so way more flexible. I've also included hints per quest step so you can easily see what to do. Quests UI now also show detail pages\n\nNPC system rework.\nTook some time to merge the new NPC interaction system from the animals with the old interaction system of the villagers. That means contracts, quests, chats, are all in the new interaction system now. It also means villagers can now follow.\nFollow now works across scenes. So you can bring your pets & friends everywhere!\n- Animals now now be placed anywhere you like. no longer have a max count.\n- Animals and Villagers have now been unified to NPCs.\n\n## New features.\n\n- Reworked build system for flexibility.\n- Reworked quest system for flexibility.\n- Reworked dialogue system for flexibility.\n- Reworked NPC system for flexibility.\n- Villagers can now speak harvestish!\n- Villagers now move around when idle.\n- Villagers have new animations due to new rig.\n- Added new tool tier: Adamant.\n- Added new tool tier: Diamond.\n- Added new mine vein: Adamant.\n- Added new recipes: Adamant tools.\n- Added new recipes: Diamond tools.\n- Added new NPC action: follow\n- Added new NPC action: gift\n- Added 10 new quests.\n- Added 10 new contracts.\n- Added additional dialogue options for: Every NPC\n- Added new placeables: all current home decorations. So yes, they can be placed anywhere!\n- Added new placeables: all current animal plateaus. So yes, you can house them anywhere!\n- Added new placeable: Beehive.\n- Added new placeable: Vending machine.\n- Added new placeable: Sheep Shed.\n- Added new placeable: Watering.\n- Added new placeable: Chair wobbly.\n- Added new placeable: Low table.\n- Added new placeable: Home cabinet.\n- Added new placeable: TV Stand\n- Added new placeable: Wooden Stool.\n- Added new placeable: Storage chest.\n- Added new animal: pug (dog).\n- Added new animal: horse.\n- Readded level: The old mine as part of an epic quest.\n- Updated game splash image with the new logo.\n- Quest UI now shows a hint what to do at the current moment in the quest.\n\nSome bug fixes.\n\n- Fixed UI cursor.\n- Fixed the item saver (objects held during location leave will spawn underneath you again).\n", "created_date": 1779802765, "id": "27009714168655087", "version": "1.4", "version_code": 65, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3782210318498800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27009714168655087"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "899340697274201"}]}, "change_log": "# Harvest 1.4.0 - Complete changelog\n\n## Highlights\n\nReturn of the old mine!\nSome of you might remember the old mine which was in the game WAY back when the mine wasn't random generated yet. I felt it was too awesome to leave out of the game, so I repurposed it.\n\nBuild mode rework.\nRebuild build-mode from the ground up so decorations can be placed anywhere you like! (even outside of your house).\n\nDialogue system rework.\nChat system Rework:\nAll chat dialogues are now graph based for way easier adding dialoging + allowing for chat branching.\n\nQuest system rework.\nThe quest system had a complete overhaul. It's now completely NPC independent so way more flexible. I've also included hints per quest step so you can easily see what to do. Quests UI now also show detail pages\n\nNPC system rework.\nTook some time to merge the new NPC interaction system from the animals with the old interaction system of the villagers. That means contracts, quests, chats, are all in the new interaction system now. It also means villagers can now follow.\nFollow now works across scenes. So you can bring your pets & friends everywhere!\n- Animals now now be placed anywhere you like. no longer have a max count.\n- Animals and Villagers have now been unified to NPCs.\n\n## New features.\n\n- Reworked build system for flexibility.\n- Reworked quest system for flexibility.\n- Reworked dialogue system for flexibility.\n- Reworked NPC system for flexibility.\n- Villagers can now speak harvestish!\n- Villagers now move around when idle.\n- Villagers have new animations due to new rig.\n- Added new tool tier: Adamant.\n- Added new tool tier: Diamond.\n- Added new mine vein: Adamant.\n- Added new recipes: Adamant tools.\n- Added new recipes: Diamond tools.\n- Added new NPC action: follow\n- Added new NPC action: gift\n- Added 10 new quests.\n- Added 10 new contracts.\n- Added additional dialogue options for: Every NPC\n- Added new placeables: all current home decorations. So yes, they can be placed anywhere!\n- Added new placeables: all current animal plateaus. So yes, you can house them anywhere!\n- Added new placeable: Beehive.\n- Added new placeable: Vending machine.\n- Added new placeable: Sheep Shed.\n- Added new placeable: Watering.\n- Added new placeable: Chair wobbly.\n- Added new placeable: Low table.\n- Added new placeable: Home cabinet.\n- Added new placeable: TV Stand\n- Added new placeable: Wooden Stool.\n- Added new placeable: Storage chest.\n- Added new animal: pug (dog).\n- Added new animal: horse.\n- Readded level: The old mine as part of an epic quest.\n- Updated game splash image with the new logo.\n- Quest UI now shows a hint what to do at the current moment in the quest.\n\nSome bug fixes.\n\n- Fixed UI cursor.\n- Fixed the item saver (objects held during location leave will spawn underneath you again).\n", "created_date": 1779367413, "id": "26955545770738594", "version": "1.4", "version_code": 64, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3782210318498800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27009714168655087"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779139225, "id": "26923196977306807", "version": "1.4", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3782210318498800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27009714168655087"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779015237, "id": "26905194369107068", "version": "1.4", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3782210318498800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27009714168655087"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777486202, "id": "26693616306931543", "version": "1.4", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
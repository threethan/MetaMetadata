4_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9hs1z_SsO0Q7kNvwG6WjLh&_nc_oc=AdqVir5uAwL1Ba4Wc3VAZuOaMhusBtR-ima-PkanNqC2j1AnSQW2wjSUtrZq_ozbCNc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXtLxBw0upP18ghn3j5YkgNT7AjBbcEiNpOw4zu6YJuA&oe=6AE89D13"}, {"file_name": "screenshot1.png", "id": "496338391350165", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340714_496338394683498_3778694375708730720_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o9uW_s5O0sQ7kNvwEiDNph&_nc_oc=Adr-JwJraS_ZLc5VkGO6UW_k0KEBIi0NZ-13fa8w3yqzeF8Rrt53kj88PovwbfM6raw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR30g668ldn8E8JYLRrx7hJCugFGR4jv9oDMBz4iU247A&oe=6AE8BB1B"}, {"file_name": "screenshot2.png", "id": "177327850396933", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75203627_177327853730266_3685753844176577487_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5SQiVt6SsgQ7kNvwEUfFkk&_nc_oc=AdpHPDga0QqNxtvI2COncTg3J6OLL54K8puWlurZlgZikTuC10pxr0HYd7T8DNmBp5Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSyfQJqyV_HXDx9U__iiddJqm0km8MJ1JBA7wCwzsCWw&oe=6AE8C2BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974670_324097625384527_7952002618746171551_n.png", "id": "1137085056750302", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222943_1137085060083635_2596374840528329208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6DKt4UKxuAQ7kNvwHMhHaI&_nc_oc=AdoQ7q9abPXr5ftLB2UfZnKKWkYPiiP8XVHAYV2gannORGkLd4miTx4vJbzbwVG9dGE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd7-qkwupzMRWfVENsa0mOA2iDvsR8rf23e_lAgkFfTg&oe=6AE8C214"}, "display_name": "Harvest VR", "keywords": [], "long_description": "It's a beautiful day out here in the countryside. Might as well enjoy it doing your job. Grow some plants, sell some veggies, or head to town to buy some new tools for the farm.\n\nOur goal is to release regular content updates, new mechanics, and tweaks to existing systems based on community feedback and discussions, so we would love for you to join us on our discord and help us shape this game!\n\nhttps://discord.gg/mM2UsAF\n\nFeatures\nEnjoy the countryside.\nGrow more than 15 different kinds of plants.\nSell vegetables to gain money and buy new tools.\nWork hard or hardly work.\nSave the game inside your house.\nDo some fishing.\nDo some mining.\nDo some cooking.\nPlay with real time OR play with a faster simulated time.\nUnlock items for your house or the farm!\nClimb some trees and pick some apples.", "short_description": "To the fields and beyond!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://brothersonline.gitlab.io/oculus-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brothers", "support_website_url": null, "website_url": "https://sidequestvr.com/app/1014/harvest-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26693174740309033"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_404245000673413_8531073488048082605_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ynmUn1UDC0Q7kNvwHERY2A&_nc_oc=AdowBdF5DO614GfklSD6Kboz-Q4gLRL5LvBxJ1MzRV-QM91JUR-sT4CN1XC9usRSFnI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfVqcPFeZIZ5
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujgl4GDFA4wQ7kNvwGloZoI&_nc_oc=AdqjvlwA_VvmXCWrWSD9mM5JtkQRXPJuC5z_82JyCgFY52Tum4qDk-LMKbhYewM-CWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcN3vdOqUZ-OTaCv7jQgIwCAzH60v3O7EYcsqRYVlVrQ&oe=6A92C9F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVahVjkylKsQ7kNvwHU13bT&_nc_oc=Ado5rwaf6_w32ivle45Me6KQonfMV2UQCTQyBMGqaZJiDRgQyneVpfSPem0L3gBuBk8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG96OR5-9FfuOkiGinG1tjzHzG7wRfSbSzK8-DQuRPMVw&oe=6A92A9CE"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIdb5GazQ0sQ7kNvwGw97jZ&_nc_oc=AdrufJ08RdZHwajehQPJuayovnPMY_oIAWMKF-vSRsNYl2XlK32cQAJhAx1puXM-7aM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgHbKSCt4WaXWoQuD4FkeXzlqX09kbrqtu7XqAhYw61w&oe=6A92CABE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEQqUc01WKAQ7kNvwHW7Db9&_nc_oc=AdpsGv-1Itxzbliozxej-FbXM2EH5SUM2qVbMxtU9ThacvwvExisYwW6N8sypoVMFRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGae2SmSHNGE3wgCD-E26Xj0zKSuUy9p232AgTWGiovcg&oe=6A92B759"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev_SmvYDOBQQ7kNvwGso5E_&_nc_oc=AdqTh_bG5ANbKFMrR2_arSwF5JO-WtmnnagW9-7953c2CKbZlVmnxs1k7STiRJb2b1s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBo96HZFL3e0VpPkjFocaDmcAKsZRloFi4gczbMeXabg&oe=6A92DF04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
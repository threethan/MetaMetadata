6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bua_DRWGRcQ7kNvwH6Lgqb&_nc_oc=Adq9HGLevQTAOlsOUUGCmJaZdhyTIX6oZJLu8vz99GvY1zv3eRqKdPCQkYUsLU_aoFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCmzJBqwy5ZIruUrhDjMpaxZUV88xBPWIJmXTJ5-wL2A&oe=6AC7BE34"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN7novOeb9IQ7kNvwFrbeZ2&_nc_oc=AdqVQ1SVpB_Jzun8go8Siv_HchLt_waZydGRq5mX7Q1Yu-TCIB9KRE0rMl9OTDgXfM0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpyqnDScx-e3lm_lMW17TUJN86Z-d4sWOamc9eIagglQ&oe=6AC79E0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCo-79I996QQ7kNvwGWuPyh&_nc_oc=Ado_kB2ddkNd7JBM2hARX-WJQ0tqYhCNpOsRVZ7AAScGlbHU-j2KwC9zFUT_kZaCAOc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUMw9pCFytGk82DjJXcwSsqm5SexrY6L162uwX2YXeYg&oe=6AC7BEFE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NslxuP7vsUQ7kNvwGQyjNf&_nc_oc=AdpuGpAWyDGdJiqdxs0-vLy1kAsENiCR5Sl9yUn1ccpwL6VXEVUXgd7s8xre7WVlyaE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpe4aqxPfeOqFEj5T-aBYwM4Tgs2k4nptk29xHpy_-MQ&oe=6AC7AB99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_25UHhTF0AQ7kNvwFaiUbG&_nc_oc=AdpYezLxsU677PTdw5K1CNuD6VYLd56FGwgQdEO-RHlv9X_KD_CmruIZCQg1tCd29so&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-SDDl5acjSYnJw3wk_IBwWlWRAdD5B6OE9UpvqGG9Sg&oe=6AC79B04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
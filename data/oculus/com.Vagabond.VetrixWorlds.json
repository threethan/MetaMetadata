6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG96KQoH3KgQ7kNvwHqfx27&_nc_oc=AdqP5ktm7SekTRGNBnREyldGkBdpdYNeBTOkZxkCwZG6kSeQZMp2qj9Eq6jR5GA4vKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWWQJlByq5CSbZfl8KnRbWfdpPMhwJeaXr7p0zj5RnxA&oe=6AEB56B4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OfT-MJQC5gQ7kNvwF_9SSW&_nc_oc=Adqb4DG2khrpxLgZVzvMLG5EPlDHsnjP6VyPhOh8IP2CslrM8YWMCjthAcaIaeMzv5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDOlnLT73XgYE7TFUUGegL38qm68LX7dW0GbkrItnorw&oe=6AEB368E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ViDCC4Q4twQ7kNvwFH7wCG&_nc_oc=AdqRfOTp7oQ9jSALjJ-1cPtloZBhreBxFTk2FblaY8JFkgYhD2FhQPy5O3UQUHZniyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVpfD3OpwQSAQ2mvcyneeMyhfLAVLqTKHlEekK0GkISA&oe=6AEB577E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n82FZFJ2P-IQ7kNvwHFtpz5&_nc_oc=AdpHmhfBrQwL-aYl_WVOev0BE1aKpjmrVW6mzn11fjQd9p0SCV3FKk-ByzImDZhvrHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4tu-NT1CQJ0x1T8V4afqZxhat7YI9m2kUfU3aB0lAcg&oe=6AEB4419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6pzmWmYfQ8Q7kNvwEFhQmW&_nc_oc=AdrUVS8C5fFfy4mLIb2nXC5uICkxrR0EoJByCu2bq5CQ30JuO9DuljASfydikwJ21gE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtkk9TVokNsTHPn9MWHGqALiudhqhs9lxDc9v0QNIqLw&oe=6AEB3384"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
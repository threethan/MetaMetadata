6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsLpW0B2xYcQ7kNvwGm12V1&_nc_oc=AdrrJmMsRsUCNBErMH5T4Bp0IrW7aAYv5N_f8JpjV_rEoQpgucspNUy3IEfbtibdpXQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODl9Ufc-qLsFWQO_BYYKQKy8dZQ7sp_yrj2VsIUcqBiQ&oe=6AD0F8B4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh-7KsottyMQ7kNvwHIoN5k&_nc_oc=AdodPqxSImyHi63XCvzf_V_2pDzOYQX0aKgJ8-YjDPfb04lbXl_Lp08EpswRhuzisu0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHq91iiyDBkUAfbsOPm4XmxhpoJpEyEOzii0ZyoZ9fLw&oe=6AD0D88E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNnEDvJT6nUQ7kNvwGf9TjH&_nc_oc=AdpKmC25iZpPWaMdtrgVKsVhWXHXJBq10sVLM2zJ2DS1plm6SJvVOCmzeUb0gcos21o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMznSc0I9UskHlJI99jVTGLyj9-yjtcfG0_A17p-OaM_g&oe=6AD0F97E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiaeeBip-vEQ7kNvwHabuu7&_nc_oc=AdpB7PJZlEOBIbteif5fznLJTa8fx8TUt_c7z_P9lqA2W-qHzRSyBAHzltqymYSFzt8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTGkUT2nUN-p5xjMHMUwMa6TxLKS9UkGEpLQvbyusP0w&oe=6AD0E619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfDIE51yA24Q7kNvwHaZmUc&_nc_oc=AdpaYvLl1Xa_fEg4_kcgJk833G7OnxNxlXpkS0YeG6dhTfyr3f74U9xD33xfROWxv1w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmhtWY_k7BAUUKviGBGfM-f1jn0NqYM9BVgVjbSdoHzw&oe=6AD0D584"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alRZDSS8_o4Q7kNvwHczzTm&_nc_oc=AdpC8SwnHUn1bNOuGHZBjuFaV5c10mBdtXIdZvfXMwa4TO2UZCpe5gHYw88QbO-Kj7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PlN8EXAKydkgaWuCGyP_8_zDA072fdqG83whi-6pSsA&oe=69F9DBF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMBMc3CoQn8Q7kNvwGlgc8O&_nc_oc=AdqdZOtph8xjzf5m7IpKSR59qDlXW_u14juCVvW_qSLv1cP4JlA_Bavm-t5T2BxpyfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oKbx9q3HIMkZjnBKBMf3yf6BVlqNWFO2RtdtGxNfTsg&oe=69F9F40E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSwSd3vEMI4Q7kNvwEnpIco&_nc_oc=AdpSgINu0dxk6GSnJU9KS4rco7xu5wZZVCGfEvcH6L1y6HCerIN5SRMGnlJ0Dsd9XIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_fSqyVjJSBiwBH4-zUzfc1Ofu3pUpTXJJe-Yy1016XA&oe=69F9DCBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41cJvM92-GsQ7kNvwH6ccQi&_nc_oc=AdrtxO0l-kUfp0EiM-OZpBqZXf6Z7B5JpmMNj2nXFpSVWkprKeqAtYeg3H9xDCmYpZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67P5PZKnomPJWw3-BOkxcpnXj1efrLwIO3nPPfEioRlQ&oe=69FA0199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQjTs9P_TfcQ7kNvwGmVRjm&_nc_oc=AdqO9joupmgVia9WSjnsOraISalAfs4DK7CaaY-tm4rHpF5pIER_GUWTFknQ43c4rjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UV3Y_d8d-hXFHXV25LBImhtZfwVd1RTOzdcobGQbjSA&oe=69F9F104"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
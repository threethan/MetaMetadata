6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGe4R07UfLUQ7kNvwFrAlmk&_nc_oc=Adoe9-n6lUuRtEH9n7GoshlijTrtjoSdCTRdTkLi-lwrnqxF63jc5j5QxjP8K9lB4XQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0PK1o2SX28OJHf7A3oqsbA60ddNsn-lvaYkBMNfH2RA&oe=6AA69074"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut9ubli08usQ7kNvwGA43rO&_nc_oc=Adoho9OraaoBU93ZuBfzk0R3O2yBrmN_VXe-zY6l161EjhQrZrINcKfaoHb5gU8N93o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMlKbqoQ_Y9qm8Sv0MdVcCraYyFZx3SvTG8RYkGjQC6g&oe=6AA6A88E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2Kvxs6_pDUQ7kNvwEqbtNl&_nc_oc=AdqDmTelkZMZhVSsAaNRaNUX_vcI25yOZoJaZhf1LzHRZ6kiMdf4xgkVMtrWdOYJPLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2rpAB6EEn0d3XeKJZOpuR_z751qvQ8E4xxI1lIi0GFg&oe=6AA6913E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugkK7VckG3AQ7kNvwHppdyr&_nc_oc=AdqojGwyBeGQMW82bvVaZf4KtyLFV-ixV8mW-ccauBLzcCGRXgJ3drCubBGqhb7qXm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOBqQHOoALW1BcWVj6iqp7IbtncLoRAznKzUZChIwRQw&oe=6AA6B619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bXzCgCcWfkQ7kNvwHCQ5ij&_nc_oc=AdoeWgMhoBUiBipZCue-7SoRw2Y3yncMcUvREfPuCF5dIA_yhLDS6is_1cAcVbWDPVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPhiTLlNE3ItpQX721H63T3T-vlrGhy5bjpWZHMt_bLg&oe=6AA6A584"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
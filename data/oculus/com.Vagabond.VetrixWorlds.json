60_407696332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKWfKKKv0zsQ7kNvwEfE0fA&_nc_oc=Adr7YxjYR1ifQEpfZjBiVgTl64WBW1X4jbUoivuij8eVjJUVKk7TRdZE2s3Ll_2zY6Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQeNNrw6Uv9JpZyFOfpouclRLRQDgrCc6gy-APAh_G_g&oe=6A7DB1F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bivc413-ExAQ7kNvwFu3396&_nc_oc=AdqALSCiAPNWJBjSnEWkcHUvNuy0OSoXKhzYEK-Am5KKwn2xbFC-CGDN68EZL-iVrHE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWLUs5i3LkTdkBlXzc5byaUMa-F0lascb55c7jQz_DPw&oe=6A7DCA0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgX5qeH-zrgQ7kNvwGIASH2&_nc_oc=AdqiAd0mnm_wrcc7ntGc7MvHozElc2RW97irvrs2gds7Gd1GDiY9wHjPN69a3wGc40s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMOo2U4opHN-g5zcF01MKtbW4t5B6FA-5PHVJzLhRhgg&oe=6A7DB2BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu1XXObZL5gQ7kNvwE8Ud6I&_nc_oc=AdqAXP45zL_wekoCKM5n-WIn1Of6JxX_CjaPs2qQAckDXAEZFH1fgn-vBmV7XSMQUrw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTXPYtyt5a_x5eZ0Kw44EIe1coDZf1dWEEURqJqVcbjg&oe=6A7D9F59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbX2fulsaRwQ7kNvwG1d4C1&_nc_oc=AdrPr9cEKPmw--nq3VZ80c0Y6McWpE963ucrh_nShi2e6wkipg5H7EewKpLDQO6xdz4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3bFRjTCa5nokjrwKA6dX1DR4zEwdiGpynXZvL2pLWDw&oe=6A7DC704"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscrip
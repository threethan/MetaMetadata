6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BXNg-JmCkkQ7kNvwHGWVvm&_nc_oc=Adoc7Xw6uBeywS37VlVc8DR48EgP0xdqYhocm85u9zVj2-lDxVGkhXhVUlbwlzkfzrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fS5_MtrDaAMI6vtAcwTRuedIsbtw7cX1T8045RBxHmw&oe=6A2ED034"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10mttfnepP8Q7kNvwHCpTht&_nc_oc=AdpMH8VhN-kGatjW_iwcJt5vutm8RAPKGHD4KqVvxbYnQDKaWwNPZl9-Mcru9mZRosc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kLCXWYKNl9KEhrjGz5yJig3dvWMSv2u_dVOVm2cB7sA&oe=6A2EB00E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUoktXq-otYQ7kNvwGXPIAX&_nc_oc=AdpTUX-IEaJAcnDjrSKuvzzaeTtfMOAyw9m5e0cvzjQWp6jyEgwoJK_5lm6uL-OzbSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QN3f5XsqAVxFmFpdxjUqawmLwKVjbqP_l4RrCnVrKjw&oe=6A2ED0FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9wNOo16aQIQ7kNvwEXkMS0&_nc_oc=AdoGBtEQD2dE9tclyheBkUdKW7BK0_tg5op6q-JW3kMoIBogGUgGmaFRWDyd2Hm7I8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a7G0W7rVWK9TJw02rnc5qy7CogvE8VodZYpj89djwDA&oe=6A2EBD99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaNqex-L7FMQ7kNvwH-F_6i&_nc_oc=AdrBQhXYuXNFRFK0TQE42L8EUa4Mphi5HCLLYygevYBCQiP38XKzptvRdi-mKZ5IXfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kridJR4kkq5bcySbOy2MViBgoPp1u8Z2Xhka2uqfu-A&oe=6A2EAD04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
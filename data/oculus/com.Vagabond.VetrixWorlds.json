6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKWfKKKv0zsQ7kNvwGoTSJN&_nc_oc=AdoNvWMCbwZbwKXKwwq47rTuRhTIym2XzMn_GPOR6gDyyZl2VV01gOLi33TRqmgsw9A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaHxRYVUg1tQ9FZAA6y6mI-i_tk52k-nKMfwzsggzKqw&oe=6A8054F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAMj45cN3vEQ7kNvwF_4_Yv&_nc_oc=AdoDXzn7nA4qSC8MHCwr0aEc9qQ0rtLNBT10oLxIXNy4EkCqGMEz6i5RNhEd1mGQdYw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuno28HejZtHeqkZEqvx1MSvstXnk4H_N3nJCDABDhQA&oe=6A806D0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okFUx5ncISAQ7kNvwERidEV&_nc_oc=AdpCcX4GmYD9uHYHS_pskgLt76OGoxUqeNGGN7pqAQjFiRRQ_tyca-DQHGR8tcmBe8I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6OmTUvwcgpZ6HUtGJPEP1T6XeUUJT52o5aIEhleZxqQ&oe=6A8055BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mH7KS9dIrIQ7kNvwHD6KOO&_nc_oc=AdrvjOU03_8WhWrQpOgNgG4B9nFlY9tLQR4MIbaI_zxwRuvEYGE-PP5cfrHCtR67Exs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp25br3wFKRoXd9X4OfCT7m1IeEXHkJlllaW4FfKwc9Q&oe=6A804259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbX2fulsaRwQ7kNvwEqR_EW&_nc_oc=AdoPvTvRGgJ2pX7hNST-kx5KEWTtSjsC1ty5jZONNEsPQUieLRBVwOmG3YtBuaaEIDw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOL_5KQ_wCIhfj5xENTdo8NiO8syxpB26abxd0TNbPBw&oe=6A806A04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
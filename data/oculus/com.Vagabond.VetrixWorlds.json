6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrX7V87aClsQ7kNvwGsZacR&_nc_oc=Adq8lyvmPeSOyv253MGCShJAQce2SuoMEHH1xM43WSMfWmFPezI7L77whoPbRw8CBx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G_zA0qO6g3-JcjBxYEjdRNAopro1m0j5Y9VwORSsiEQ&oe=6A4296B4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-Md07N7hrkQ7kNvwGoUdR5&_nc_oc=AdoGKU_vG6UforAAwSu83CPNU1faR0_FsqrkPk0hWLo_98UBiklwxBFSL0g6vS4yNAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9koD2zR5ssUi6cjoIXZ30eVrDKv-BwxJj6TjKZWrNzw&oe=6A42768E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh2U8rFNkTAQ7kNvwGCZZVk&_nc_oc=Adqqy06QXNxgQFACsRBQAgiyG4bHJaRrMx03TYmwYaoQ7A9qtpiLLgpuzYjCtiWfRxM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AGZREjfBaUYjKvcrIyf24seDPdKo-m6dwOkgHEe9PpQ&oe=6A42977E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQhuOHSekr0Q7kNvwE_FuMS&_nc_oc=AdqpIgQ2hw5RV0DijMfbJYA1XxWpVO6jBgSvQYjtpceKAshM5hjtqAS6NOrmpbLtCG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OJsjoUOHqRTi2ZDFb9g3y0T0ZHhvrzA2OaozbrlZ5Fw&oe=6A428419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zkE5LF37oEQ7kNvwHaM_Ic&_nc_oc=Adrzt7AXYHQtYbN5JCXMDNl4eKY-tStRgvkulDhbkZZJ1W0Nzb7o3twqm8ZBTj21nM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eu62QPxoxv3ID2H3nQfrkAAnZrkGMkd_e3vy7_051BA&oe=6A427384"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
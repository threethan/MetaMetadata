6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9uwyNvex5YQ7kNvwEWaZV6&_nc_oc=AdrUYcJAiV9PXdIAzt83FDWbL8UD4kQp-aUjEmuloO4X_cMTQwla0OOMMKeumyhd6pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCnV9G_T5qtOXqQc8Iq_HkLjkA3eKDVhQUPcYwj-ySwQ&oe=6ACA6134"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN7novOeb9IQ7kNvwFB20zd&_nc_oc=Adq1ghbTE5D7atLjJoX-Nmq3xG7yjBNtkQaxgexiVHcJVYDjuV01qL6u90FEcaoNYVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0kfesIU81cfOshGKxpPljkd_itJyLi4I1SZ6Os6mG4g&oe=6ACA794E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCo-79I996QQ7kNvwEIqYtf&_nc_oc=AdrSmTdbj0-J4u69JvtEFtFUsN_bj6HLB42ZOIVB-08ftTpjPMhoBGxhVg8Gm3qVfCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGYgzgYv3fUoM63r9wUwMHTJ59kPs1pTChrWCIrNdBmw&oe=6ACA61FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik3Hc8Z9G5gQ7kNvwEQ37cm&_nc_oc=AdpeZ4BUj-qzzIq10fb3XGvYu1lkjFus7hkdOR_j1JT8jvR1uaQvz3hNKHm23zs9v9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeGzq-B-CszYFDZG_P0Ne-vCog-P2lm2gCt3POEhFUiw&oe=6ACA4E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc12dd5cFiIQ7kNvwEiYu7Y&_nc_oc=AdqcCkyUSFTPl1jeTbaJTPdwKXAQsh0JjuuVe-szjSJSSmWdsCwuhyYrUmvZhc8CI48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYLkqGoR1lmhRDN2HaPbKKA1xcx0Dd1qMjsyhsM0v4bQ&oe=6ACA7644"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
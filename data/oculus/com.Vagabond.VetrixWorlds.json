6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FjgBjyCfPsQ7kNvwFl6kHF&_nc_oc=Adq1gOvDMJJZxRxg0IsOL9JykjDM-VPA86kxUJNl0LvOAuavPG8xpwF8szF4AlC7Lf8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdPvnH2mxbhrBHeFjN5IMbHdDO6CY7wbKJnXiwLTOyBg&oe=6ADCD634"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWujxnuWTDsQ7kNvwF0MJ-N&_nc_oc=Adr5HmqR-S1vnrwhlKjdiaYK1Muzv-2r-KgDQ4g2zDW8Ut7GkwM33WW_1tF7uPDPcFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNknIZ_79fyqKBjdS1nuAwR5Qrn5yxNgmVWEC_7vICkxA&oe=6ADCB60E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzTK5_JBQQMQ7kNvwEJBUnR&_nc_oc=AdoRBHhh7-xVuYyKjPIoDdgOLP7bfzlyVz5Gy9YdlVFv2elmEOx1Pu2B02gG0DKQmnE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1D5y1lBG0WUhvqL2scXPvAbc9O2OHvbEne-Sjye6fSA&oe=6ADCD6FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9feFryildS4Q7kNvwGGZqgP&_nc_oc=Adq0hT-tWrvMu3ZttPWg6EMwDGL8EYvL2fSG8Kg_c4YaOno3Q6dFFJgMYBWqAnYV448&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5wkhAIZVl5pyvbK-sf74eQ9rieC0Xa_oH9jAmpxDL2Q&oe=6ADCC399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17Gy1RJh-1oQ7kNvwEwFCnt&_nc_oc=AdoqRzYtGmIi5qDCGe84tQBf4oY5t43VyRupqIecMtbzS4hkoX3ZlldAQY9rjdsuD9A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOUKZwLOjRhHBm8qSFw6OTcrkjGSK8FEwV760p8a-z2Q&oe=6ADCB304"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
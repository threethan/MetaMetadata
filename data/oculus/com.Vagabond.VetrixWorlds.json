6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCaEnRDHCH0Q7kNvwFCO0SR&_nc_oc=AdoJtw2iNLj5Ax820xownm1dE1Kdij-qt6Ns3mb1giqkKeYWSIIafaLNFbzc3zNzfH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pIzKytaX0xM_qkFSvj74W4-FAVEOw33rrfSVQZCJpVA&oe=69EDFE74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5wC0LJxFYcQ7kNvwEvH3-m&_nc_oc=AdpKJZSy01XC9kN-e9SNgIY-jjz9qCXrD5O3xGMRR4Tq_LiRX_pgCC2p6sh3lhhnFk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E6-2U2TvYz9J3U8KAnW59lbz6XSvux2Y5wFmCcA3asA&oe=69EE168E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF8KzHbmt9QQ7kNvwH_w77c&_nc_oc=Adqk4lOmMs8Et97mND7AaJ1GBHRT9Hws6hNLUq0qGq-MZ280R9gKLUcy--MyHgnEQ6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sm_Qf_fpmf9v_Ktuxa9ExSwKhJQJmWHga0kn-Bwt3yw&oe=69EDFF3E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl3_H9aHfG0Q7kNvwGtgh7Y&_nc_oc=AdrdbvkXDVm_A431AuA6z0RuWOMbua41GdQyANcozjU_uIpxjV6FSr4YAXLTM1UaUKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vlmU1U68b3xIkOYKJcxW9yyr-R891cXKivQfu4MLIog&oe=69EE2419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFd9ab8Z9ksQ7kNvwH7Vt03&_nc_oc=AdotjUJjzLsZc3uFjkMFQCBMsKnMOERjoJqwzmS01QWyKzH_TMotkmx5i8sSKnHjNRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J2xeZGgl6yGcmXOhVbbAbQ-nNxhfe3dG9PZTRwjWOzQ&oe=69EE1384"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
.png", "id": "739133907770837", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974837_739133911104170_7617710470635526969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b63xELPVy04Q7kNvwFBbZpg&_nc_oc=AdnwUhqD-I-5lpMfRWwlTn4B659XYddQY78LKcf_u7CKSa8YuFuwSMKEnbB8CdLJAMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPxgtNyzTEgXbqUqF3uKOcyMkAt_HmOw6vJjd5QcXjyw&oe=69A6DB2D"}, {"file_name": "Oculus_VW_HeroBanner.png", "id": "688028616062617", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036620_688028619395950_1985802417219348746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZOX2pgdTaYQ7kNvwFvLu1C&_nc_oc=Adni-syBUrjEWHX9DxlxkF-HByvqmCGvwR6GGhRKuR7rcTuROzRzVZ0CujR6r7Aq-nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7nj2T64RBu6UENiWzsMGE-8jIPOvKImXpFkvdsPiCrA&oe=69A6E28E"}]}, "id": "794911891438300", "locale": "en_US", "screenshots": [{"file_name": "VW_screenshot_temp4.png", "id": "948472802803322", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262743_948472806136655_1270747314791858662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik-s0jHmkyMQ7kNvwG4GLdC&_nc_oc=Adk3zhHXcU21qAdOVxwRbUC6bZjNW6WA8t_TsxGiutyQh_r76rMj6OsblnFjUkNtLHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1twkjxoUEuVfnP9SvghOnt4BMwYYj-47unNH7R9DUHQ&oe=69A6C380"}, {"file_name": "VW_screenshot_temp2.png", "id": "1582369552281532", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/227922350_1582369555614865_1899699214735756909_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4S0Wh3MsqAQ7kNvwF50GAy&_nc_oc=AdnFMNAsuF7jGOnqSGeiuC2du5whzzX5KW01yebpsiz6mv53Jyr-sjLT3BNwe6iDUpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftT2Uv8FxSJTAolb6kwf72__nXdlzOmsNlRWnQmYwBTYA&oe=69A6F0A3"}, {"file_name": "VW_screenshot_temp5.png", "id": "1245661962829542", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241698_1245661966162875_6985703041342953357_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GceCAfH3t9oQ7kNvwHJa5I-&_nc_oc=AdlQvAV5Ldc88mmvkymGxLM8rYp2vHJ5BlWogRV6i4SUpj61Ai7vpSyi-klS8VFy354&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afut5f5jFB4vdEk4qW-I2L1xvk4Iky_Z0Aay2ivSUIugOQ&oe=69A6DCEB"}, {"file_name": "VW_screenshot_temp6.png", "id": "2025116907836913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035428_2025116911170246_3036272620708416820_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI_btQd8Q4EQ7kNvwHbZhCz&_nc_oc=AdlvlLVryransJryKUejIlfSiFgdA_yv_6LyJtM-CRNsFbxhycWfXvECn_3wgUue3qw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftHGevSTnAYvzIEyUo8kTMlRoObg81wzOKOh-3gXY_Ymw&oe=69A6BF09"}, {"file_name": "VW_screenshot_temp1.png", "id": "922100838781797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262743_922100842115130_1494675787326037957_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ua6KT9w9dnIQ7kNvwFpp52d&_nc_oc=Adn9ONTxtykHCWeu8ow0xrTKPLXQMOe5SKtjefu9M1tr0EQTThos2gOU69_eZvQ1X3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvuHXS-a-9TyqTSBidhUo_wRMRqAbfQdbwjidtecC_zQ&oe=69A6D382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1132197920894592"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "779620506842245"}]}, "baseline_offer": {"id": "779620506842245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729221000, "status": "PUBLISHED", "id": "779620506842245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6590666637707862", "version": "1.12"}, "id": "690620555
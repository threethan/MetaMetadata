6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhhdjvFGl1UQ7kNvwH2UrVF&_nc_oc=Ado8RGz-pznJ1eXSp-Q7fnj6bRCyLFFLfr3mK-4qnH9j_9PVkamt1nprKVPmtc0EX1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M4u_XVaJzV3ZrEWyQiognHifFlKzgxtf0AAGB8FjJPQ&oe=69D24EF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vyC-vDdw1oQ7kNvwFhlfis&_nc_oc=AdrkIoV_AIePKtARMuJQ-EP6r3UHUWIP39a4k1yA8BX1VhJO5m4m5qddUdlCvw5HDd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZXyaHV0siSlE1ize0YKDAJuc2Fz9OnNgFjucO73pPRQ&oe=69D2670E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHlN4gXKaSAQ7kNvwHIzyJT&_nc_oc=AdrMYKg1J4zESM98-DBuPQ3HHesHlV8bAwwuh0hNWSH91iut5xpAUZiMBw8pwHB6eMw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06E5dknu3bM6doCUJnvs0D3PS8fysv2QVhDsXMoyAGtA&oe=69D24FBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ECmiRfuvnsQ7kNvwFNVf4s&_nc_oc=AdrbXyOf-uWYx0xaBRWHzghWTN7r-a5u_eLOuab_xr2XpZ241GeYVYrOBornZXac8oU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cKLTRiUwG0JW-03eNCiAc3cRsnG3pQ-REcuFFGRfASQ&oe=69D27499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maoq5aN-RbsQ7kNvwEr3mv8&_nc_oc=Adp8p2xKzksYFE8tL6_0hddbG_7XNsOj0ff-4cRnqRPrxvDzW3h5aIN3KYjPSOfFcwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0drsf54HLjXoYUt6m3ybaTXXQcEEOIT6lTO3Kdh7Hz_g&oe=69D26404"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrX7V87aClsQ7kNvwHbCZ5K&_nc_oc=AdrtbSvE2RHIl-O_1y7n0GTiMba-2WWTXvp5u1wfaZTiFyKHAA_fcP96q9pehzWwYjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mYvYHAjq2VIGFIp_2AYdm66IEiFuchs_bT8M2nLpxmw&oe=6A450174"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt88vbzkml0Q7kNvwHmCXsm&_nc_oc=Adq5VzRJSpLv2Vd2A1QFY4bQgAjDekJj7bluMYZjwWLTp15h7ZuwHfEtbMNJFP-RJRI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PkhcxcUK9Zfa_Gq7SW38GyX40_s8Sn_j5RjJragajXA&oe=6A45198E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwebySf1zkUQ7kNvwFcv1Yp&_nc_oc=AdobOU2WvEOMt5CmNexlrwO-h8ajbfPU794_zotSY-dnA0PQMwKLm2NoxPKCIowT7W4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ztkv1xHCAiCrCZYeQyzK5qyDgHrx3BzdKHlRuDdKdjw&oe=6A45023E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPWQwSuhZrgQ7kNvwGUO_PK&_nc_oc=Adqx1yFRSUn0MLHrpqN5xSRDv7pYX5LYgBCyTTFZAHHBgK6MGAtNxrKzLmXRvKAZYDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mLZogf7eceWy06BDrA6xldlVeI-Z1IHnaJsU6G_yT8Q&oe=6A452719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zkE5LF37oEQ7kNvwFHUx8y&_nc_oc=AdpqQTeoXM9PNLwLJ2gddb_-5QdST69YkgqwDSJ1B2352By4aKCJRWsBdYlSGtgPHaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98y4KRzKN8YbonO3CTYDOqe1oHoWfIfz6rqJU8bJrB3Q&oe=6A451684"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
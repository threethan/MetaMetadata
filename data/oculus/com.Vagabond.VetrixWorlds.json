60_407696332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lpdwow7H_f8Q7kNvwEpfR4P&_nc_oc=AdqOWc38QbPYaHIDSrpg6o43HRXQ1ueNyvoSajeqpuQGdfc8NxauHoFM3tYuLd_bwjc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dRtVZ4bpsLPi6sGX3XsbrE3KpscBIbo3l6mHyarShfQ&oe=6A468B34"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt88vbzkml0Q7kNvwGHu6Co&_nc_oc=Ado4wPsZJV4jnJqgbOdH_9MwoPDjrpnw8n5vKXrzPz_SWZfwdnJmKfrslpfPICfUe40&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mX2AgehrQoVJtGGO1zaJ9wKuaJyT534xBXufS9VWtkQ&oe=6A466B0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwebySf1zkUQ7kNvwG4dMxE&_nc_oc=AdrFPJgTH4G6N7Qv8BQw-lkX4xmDpkKUeV7GjmE016iYnYX2KS_vOT1BOBOG_xId7hM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2ddpBFknJM5LB0QBiNOkimPTv9V1bw5G-ApCQYrpv5A&oe=6A468BFE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPWQwSuhZrgQ7kNvwGgJDcc&_nc_oc=AdpbZISOLnVsthH4qBxYA4b1ibHqFQO2OBQVK0OJz9vAvm2Eyx1tkOtP-T7GJx_Ua1U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WNMFmPJFXt9UPi-XZIC-tJidl04jPIt_OZhyOjhxHZg&oe=6A467899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtAsrnxA-FkQ7kNvwHz-Xqo&_nc_oc=AdpaP8ezSOj1teobJ5rbWpbVTVKblOHMBN36NKPuV4XKWKyhHn7kdlMLUckENucEff0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95rWoFSB40KdO0zDb-GiBobvFHYGlQw2X7_MwBcJSXJw&oe=6A466804"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscrip
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op0sSi3KuHMQ7kNvwG3cTKF&_nc_oc=AdrhlyOVx5bezC6h546ZBybuaAlZhkA6tDGZ0TaqnhggSHivDgH36djax3BrN5kuFlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS77FRdXoAlwK0pXRTcl3Weeszh0yXCEXCQZFKmvFZ6mQ&oe=6AE76234"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4HWzcUpK3MQ7kNvwGWlrFb&_nc_oc=AdrFvSrHCoQg2H0gjloUko9CY0cUmi9Eg2_7GI3oT4G34n3n56Up7DWp0D3WnIOhcxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Kr_9lToZp6Pe5o8A4O0SBPTlKiwk8pqtBh8Ko4ebeg&oe=6AE7420E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xNmA39fr4UQ7kNvwHRO_yh&_nc_oc=AdrI1u1-frZh8XYNKV51jtU1k--cdIIIg2pFbyGFade8h94yLC9jUp5YF4Ms861pAa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV5D0uS2cfruQUUqp3bi13vZ4vPzV9kJ3MLQaJ2TuHyA&oe=6AE762FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_0QQow8ooYQ7kNvwGv1jvj&_nc_oc=Adq7uAgpruOsXE-PqXn-XKXRQ66j42VuD5yvJAYY7KT3td27E1GZRYDwE_UL8duZbXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2teM_53aR77l-u3CH8qPJ_PiWvy9c7o-Hm0n_PdBI2w&oe=6AE74F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6npbIz_IQ4Q7kNvwG41AVZ&_nc_oc=AdpzHPzaMExfAL-LoM05qEZZ7yS3DAe6zFWGyjSHfFfPBgYI6ZFCnEaTRppzN54OSBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeIiCAOnOzxt7QlymFBIM0ku7ryc2HEB0akN_n1RHF7A&oe=6AE73F04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
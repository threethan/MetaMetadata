6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHtOYYCBEzMQ7kNvwHX2G7o&_nc_oc=AdrhcUVe3eORHPceBOrlDcp8cd-DxdUPmb5f8Nt5m_PqBx7mTcdX2ZFMHW4Eo-hZHng&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvvdBQ1is1a9a3HRxOfJMt9tW7dV39asdStUWziFg9Hw&oe=6A972EF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6dINVXU4eMQ7kNvwF3g3aE&_nc_oc=AdpSTUomZwf5Hnl_XAhmnvYY7bDWQ43US9C3F6qRhHUcQvBxn4ApGuVi0il-WHEubjo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc9IaSPsPXAy_hch_YV9iLpzNy3raZLhuFxj6ecHqWJw&oe=6A97470E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JNmXBzQB8MQ7kNvwG2rzCq&_nc_oc=AdrW7VbM50kp4SvRyYdoMSvqP6H0U_qDopfu54GZOF5bu9ucO8ycTeLjvhLkQvN-S5w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDqVi-DZrpsm9sGiBzXS-n543MODQXkGDUu03_ZeYROg&oe=6A972FBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgCyet7_LpYQ7kNvwGBnYb7&_nc_oc=Adpd8PrVI8rEAgxQ7zyvozpxvBDiklbhYe-twRZFkbAKkB_UyWO0PTe_hkCyIpIVNwg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETufhLn-mWM1287kx0cgAdIyEpzQBWKa5lRzQJMB1RKg&oe=6A971C59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN4t37sQ_xgQ7kNvwHhvj4m&_nc_oc=AdrCLxOf_tbQJp24rEHImv6ngNVplQER0GUqjeWreKEnjJO0zYqfzQGU1iMdTw9DEpk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD41-850ZTff9EOX5KShcOl8YHBAL7S904ckurNT1iYg&oe=6A974404"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BXNg-JmCkkQ7kNvwHzdBcS&_nc_oc=AdqqVlpknbnMorz__u7BjCj8jlO1IkB6-oF_h08UZsQ_IKlrvIBJ2nwhyENIdQmc8lU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_95CwquQs_ylqCsPOECGFAi-ONQjvl3EljYr8WgBTv8w&oe=6A317334"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaY2A99UnYcQ7kNvwFASrSb&_nc_oc=AdqB2mo_SobnzTODVtAw8bdhASKQcfK9NnG0kfkh56J_UbVXu6rDma1FUm-e1lKACl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BGxJLPAs-CVrruwmbG0SHOR9LQDnr4IAh1NBiPuXO6g&oe=6A31530E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9U3P523BvoQ7kNvwE6lBug&_nc_oc=AdokHBhM1qoKtEDshmj5EivIu_iGM_EH9acRV0m4q2UJ0xjJdsZsTNa5G6bmAhXQ84g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XcOJtSklASSfsiqrw7L4XVOg4ug74YO9mwmoqIkwmUw&oe=6A3173FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHNW857pBc4Q7kNvwGxRvJp&_nc_oc=AdrlSR3JC5hdC_SZk7HC9fkoBxI9vHxvi_9_uawBMPc681v_omMG68wbIoyNmUD886I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iCnQb0EYwMc3tTBT-u_NsHEnb0XqeNfiZeKEX-s-8gQ&oe=6A316099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaNqex-L7FMQ7kNvwHaXKVP&_nc_oc=AdoZGVCoxXJqh3ygplruf2TdcCFmfkXTAN7_zrWHJZshrq8S-IPCwnO4B_2e4KAqPjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uEnpwQVIFcz_7hMsLis9X30BdgnaityiR9YsUPefavw&oe=6A315004"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
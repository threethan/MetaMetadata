6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujgl4GDFA4wQ7kNvwHD3Zmq&_nc_oc=AdoHDDHX064bpHTrkU7rf2JQ8XDzxstHjN8qFEcU9teSs9qajNVaoQlT24cILZpR-Sk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa8dMVlboUrYvnDc_eHzfJ2WGxwHBmMi48MYK8JISBdA&oe=6A941B74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6dINVXU4eMQ7kNvwG7MFHr&_nc_oc=Adr4XPdM9DhixExny8F9stlPCKK5TaihH-wf8vOkW1e2t7FJQUxMtrLmmxhsyr_iKTQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7joaZCBps_6Bwbtwh2DLzGM-euyPwocWF396vS4rKGg&oe=6A93FB4E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JNmXBzQB8MQ7kNvwGygFk5&_nc_oc=Adq-vS2GyZNgZm_hXJb0nGqpvob7zHkpz3tjc99jHl5OmZaK04ribsBJsQUl2DFKzDA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOegqkNn8LHt1NnD3-vvKcDPf-Co_aw5zoZSJKJkBY8Q&oe=6A941C3E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEQqUc01WKAQ7kNvwHkPQMs&_nc_oc=AdqPnFkycBGV3hUzu7F5K2i9MPdxIGPFtisEbBQA89VYIRQo_xClwhoWNMtrtJUIFYs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUYtdx4hfZ84dv9K-4yZl51JjhykkAqhbQuvfSQ12Tnw&oe=6A9408D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev_SmvYDOBQQ7kNvwFSml0b&_nc_oc=AdpvgYXk71cwuMqD8m4WiBQchLyMvx4yf46LYxlpbPiCcWZWkf837TKc9SAUXzmbHm4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9BAkBKtdVdfrIobqPV8AK-cdGpblaOx9LkVd6ZSuFbw&oe=6A943084"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHZvPGU1WyIQ7kNvwGJBrG7&_nc_oc=AdrLKLqfFuPzxR4mmZlf5sZS3im7maFm_P7ZPvSy6A_gHYpHZrlUyEOKtgf0vVvB7LE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq6jAPLGfU9iaEG4WhTqtMTOkMHUJOQPqQg9O0QXO-vQ&oe=6A9EA774"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eDXVxzNYGgQ7kNvwHkYkUs&_nc_oc=AdpTDV1YHOyVPBqZ4IxpBbhzlCqniXIy-2E_Ils97gu9r28zRgh_QFteKQmjkMM95JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6VZ6Nbw1zdLZ-nVEY38UD52L_dr3hL3IvJsGtOKf0Iw&oe=6A9EBF8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIg8YeiY0PcQ7kNvwHm-ESn&_nc_oc=AdrZMeHUiAj1Ako-K05wCHEpkyfjuD6RV5DyukTW2GsyQyOpOfkN9Ztmal2YfsAJUA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3l1Nmxv9qdXO9qRr4by_coG1z8gk_IZlhmA0StMwh-g&oe=6A9EA83E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BaT0DlpWBYQ7kNvwHnQWSv&_nc_oc=Ado_e-N1IQiaq8u0eN7EsV-Ie66-k6tzxhKtN_a0Yzy5yRA3V5XyBH1Ro3j321Bv6SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSrhFuak_17R3gpYw-9iFfn00t3Dx3AczV3wnxb5TLWw&oe=6A9ECD19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm9Kwyua5OoQ7kNvwG4v19L&_nc_oc=Adr2pwPAqc2u_2-tI6KhnIgfOaLFXxrRnRzbobcXaf3X19rBfn8hPCXu271epTM4XfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDuLdKMA_hWl9K61r22gh1gkSopZXe2SL2LSXXz4zKiA&oe=6A9EBC84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
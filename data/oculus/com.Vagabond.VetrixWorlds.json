6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FjgBjyCfPsQ7kNvwFat-Y6&_nc_oc=AdqO-3U4wbNM-SLHCJM0JqoCQOi4F2agspcx3M-hAA1IDvF2bVIvVHFZG32sXt37MBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkx3_gSDaPFCZyL3RP1uRxKt0blZvR58jXMjkKwWnDOQ&oe=6ADF7934"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLg6YO0M8pQQ7kNvwEhd_B9&_nc_oc=AdqP9c_ZK63ShlcxIv_CXrcDTOm8tJOl0J72dNWcllT8XCJpD4LDTYrZIx5Xnzr2jtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVYqvMP1Pio-12nkuEGPckAs8kzPJfrp2RH2ud1lDCuQ&oe=6ADF590E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z-ViReOU_0Q7kNvwERP61x&_nc_oc=AdpiyiVfLXJqEY675KAbJuhWpPVM23rtpepcxkyDIJrPbg-0j_g3tnLhVdVCKaNq8Ho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDXcTRfZRKFnZk7_CjNJ8CwLgJ0oV0A2ix6xdX3KsYcQ&oe=6ADF79FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG7Nd1OIdRYQ7kNvwEySNWc&_nc_oc=AdqNHlcJ2__ksVu2lsvlhVi5rUan8JxOkXsGFo5YOyKP7vuc2DmaemuLP0TefHB40h8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCVNkHzM5OVQvWw2RvJZsVbv7VU-OSZ8iwzlaMCO_Bvw&oe=6ADF6699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17Gy1RJh-1oQ7kNvwFsQSH9&_nc_oc=Adq98lk4G_8oX_LlEWt4-4lEopFXCiMqJ_6Y15WfuPCDfkH4vN-d_EDEd85uNmoJHUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMES6xlHNtCFUlUwnTiVKR1HmFyfbWvhlP18aHHdwjohA&oe=6ADF5604"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
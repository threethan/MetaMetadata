6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV7dZwKpag8Q7kNvwEVvWqY&_nc_oc=AdrQ-6ZW67mMj84jhW7uk86JNjjBj1_LH9qEFcrRoWXvopLhkLLJOTFl9N7cxrXzlfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRMnZKRpYCqG_fxEP_eEwvGQd_Uf2M9xe1MOc3ub5BuA&oe=6AF1EE34"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWteaJfSq2EQ7kNvwGkqeg-&_nc_oc=AdqpqxHtfXpaXtvZ6ujZ6nKT8NFbhs6jp2ESEmxDqzyXB1m-hfoum3tbB5tnZbv5QA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCzT_BpH_aX99lewlyiwl9rXxNH5SF8qBOvf75Tshjqg&oe=6AF2064E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coTgILb_5bwQ7kNvwFqiFGo&_nc_oc=Adrl8BQ3AL9UiOt6PTDYpe-7TuhUzpnxKb1ku_jIrhgRfhPMc2p_25zGfl2Unt0hiFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqEfKGI-FwNbiKc-XpNYdT-7GhetiA4DR_k-RYLZb-Vg&oe=6AF1EEFE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sEYkU-Ya90Q7kNvwHBOQJ3&_nc_oc=AdqJ90LgbRNozC4L4SAzRW9G5t_lRpXKux0sQLNLVIMy915deMt-rMbTSMJ9geKbRWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpXWAQJCuimSiSUrllcuHJ593_p-iqWEx-hKOlSQntng&oe=6AF1DB99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaUi29NodswQ7kNvwHzEDxS&_nc_oc=Adr0v7-zKLh74rO-2fUbc8cfc_N77_jC-dQA1m8cebj22sJD3qfZSOQTVLEJFsMyHiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2YNkOMk9Sn1CwEQ9oWQbxdVcjXNcnNd8EUd3FYqYwIg&oe=6AF20344"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
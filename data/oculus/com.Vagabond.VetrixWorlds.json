27XlLpdiv-qftrj5FeVcR26rQ&oe=69B41FA3"}, {"file_name": "VW_screenshot_temp5.png", "id": "1245661962829542", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241698_1245661966162875_6985703041342953357_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUcNCAGDi80Q7kNvwFewyOr&_nc_oc=AdlBkuLRUpkivleZKwLuF4je9Lh87_f8ZyOPtsyz5eTX8wZ6PtqedqLoFK6r5v3g5oE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzD2jW_bLioMibG4Tu6mCYInZk36op0phiDszASxXfng&oe=69B40BEB"}, {"file_name": "VW_screenshot_temp6.png", "id": "2025116907836913", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035428_2025116911170246_3036272620708416820_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNuLRunlxhQQ7kNvwEynj_L&_nc_oc=Adl9_8aNLigSf7J6PrUyRFGK0NckZ-yq5Hqr_Fn_7JV7KdPg4lH-1HhzfzzxwmO0CiU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0MBQX7CLhhsdmSL6PeZZnzvXWfRI-vAljXHzVLSI_jw&oe=69B3EE09"}, {"file_name": "VW_screenshot_temp1.png", "id": "922100838781797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262743_922100842115130_1494675787326037957_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfmqMLHV2hEQ7kNvwEwcoNy&_nc_oc=AdmwMg5U3Dbz246a8kg7fNQKTOgX2k2Wx7u2FHjx-5MVg9vhfjuiQdfQ9n26XSXvO6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOg0psdOkd5DvjV6DmJ106KEmndDmcmOLY0d8OsPykzA&oe=69B40282"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1132197920894592"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "779620506842245"}]}, "baseline_offer": {"id": "779620506842245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729221000, "st
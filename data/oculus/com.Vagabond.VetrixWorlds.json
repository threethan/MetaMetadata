60_407696332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aY-N--voxVIQ7kNvwE4iXkQ&_nc_oc=AdqEBThi3t8uNrpu-pCw-XBv3UAkgS7O0jsepuOdMVBiFLqv_lj7U_H0xO71nYgjCgw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-38BZdYjQuQMVIqXo62xsMau8fkJ4hjrryDZSQXIS52g&oe=6A36B934"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25VJFSM1ETQQ7kNvwHKOySP&_nc_oc=AdqVoAFApfPqLXAC9YLLBYHMWlGp-C1_DZ2OyIeheyecDrqzYeeLOE2kB752hdjncQQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BEAt02NG9Efv7IPaPbpW9eATRxqZuY96IqVC98ULbFQ&oe=6A36990E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siulyIMLpPQQ7kNvwGDSDTn&_nc_oc=AdruWywryysLyzrsGrEzoMAHxQXw7oyOKX1-eKFeMZ9pMscp6toKf5JSKlILepAVS2c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MaguhfL-7I4du4sU74OdZzL-sOrdHr8-G1QVNirVPdg&oe=6A36B9FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXp8pt0OQAwQ7kNvwE9cT7G&_nc_oc=AdpAkJg8d7YgoyBgOFVOgVkYxv7y40ZzRv7Yx7hKJDsoz5NMH_OI3k32l84lAQH2nJE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9knJLGtcGYNYBjPBIYOQpbSN4JC_VHOCarCreu9qBL-w&oe=6A36A699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2__hVrcYXIQ7kNvwE0Hm1n&_nc_oc=AdoreCfmHAHt8h-WehVbgrh4LvEnmwXoyxCw3cIvrvVmjRtz_F_CNvsw8jvvSrUgqXw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x84VBm4bnpBRkmuRyWpUXUj8Od0voFwQKIdkq6wHv5A&oe=6A369604"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscrip
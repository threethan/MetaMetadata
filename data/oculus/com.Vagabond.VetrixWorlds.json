6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6GRMYVmfRQQ7kNvwEgRvI1&_nc_oc=AdprgfZ7tDjK6No1w19qZ0EgAWFQvkANE0s_NAsHMaW7UOeXUsHE6UU2NjLGTtZkru0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbhMaKUiOEnABsqC3eKS7ZM5peLSJGWtDVoQeAmsQj2w&oe=6AB2A634"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWmyyZZbHDgQ7kNvwEGYaZM&_nc_oc=Ado3Nx9BPUfsnWcuP9t8kGTf0tCAl4H1UlfW6-i2ulSXE6hgMPuMFbvc4RO1fIC4JUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1T-pHvwxAVBR6LevlaqvsKrU6Y0wH72psXomQv2aSLQ&oe=6AB2860E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2075mfKwgKYQ7kNvwHTQJkD&_nc_oc=AdqN9DUiDmYP-sJgOkt0YWTWa1A1d88Q8m0dzCWxRgD5ErERy3DlIxFJnkrXIoSMAhU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK876nQEPvQFksy7qYiOO9PQjmPSM9GRlPc5XMAo87IYw&oe=6AB2A6FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMJt_vF2w18Q7kNvwHEM-_3&_nc_oc=AdrA45kO7kzJeb9ZyXuQEotx1_4QAYvi2jPbRyvclfeZfId7uXPw_uQhf6aYZWkXHWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPbCnpTRnBN70U7xiZY-iwX_10LUT_a3jehNCjUoGdjg&oe=6AB29399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfZlimCo-mMQ7kNvwGJiOS_&_nc_oc=Adrvyqaipg6YpIg_NdLI1wpHOxy-dhZlbDeao6he5TuLTigfhkjsl5szJO8MjTfo5G4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV1USM8BxZsD_EPDr3MCxqhbdblUbJJKqJD9vqnoiBuA&oe=6AB28304"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
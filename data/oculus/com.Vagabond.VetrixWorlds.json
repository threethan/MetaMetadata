6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbdlmt0WJFgQ7kNvwHHulXX&_nc_oc=AdpRsTalpZRxS0scb7QlpC2xAhRFrOI6-Uud2I8iDTwKzpAhDHjkTtKDENZqvJmSRWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISBaWYVAjF6LMLo0_5ur_d5B_TD_N_DyHO6tQoaQjlgQ&oe=6AB69AB4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSqIFOF4SiEQ7kNvwGTS4hO&_nc_oc=Ado8np-XuiNoAHpRmWKD3gwdVtvZwADb2vUETcxecD5CBV9bu_3P9zETSRcznP-PjEQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYuQWqpbCOmdVYYz-KtQsdqALVkNTbhLq2DLF_c0k-5Q&oe=6AB67A8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvl4loAHCToQ7kNvwFekgrN&_nc_oc=AdrH5DkHgPViOo0u1U56SPzVevhU6Hmt6CfYc836iZuuil2mkK_lVboa_s_v5ag2gtI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSgEa3ho3FX6HaMOFZy6dSOjJXXZ5xIKQ3G9OaNKjhRA&oe=6AB69B7E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Pgtj9dojskQ7kNvwE5rJqz&_nc_oc=AdqM7jgyvRkUTSwsUb2Qg7GPHY6GW-jtb0TlsHNL5muBsyJt0t0yCEDjTBpktFUOVvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxDKsvVi6TcgRrIpjXfDsWwxAJbc1gsuStEJU3egKMvg&oe=6AB68819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjfiyrFx_kUQ7kNvwFOMqx6&_nc_oc=AdrUNcurMp3dolq0igGfXhhetCjvUb_DGSUVPAkzTJ_TM-UsKC8hthKxAH1NG_N52WE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9PXeLmEr-iuh6IQ3J3k1A_BGd9s8jNYpGbnJMMDm8Cw&oe=6AB67784"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
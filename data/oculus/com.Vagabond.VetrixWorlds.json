6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOIArCGiK90Q7kNvwGt1cP8&_nc_oc=AdrBuO6qh-w-2G6dggfDdAgbdjM50iHB4MlAFXplm4GkkJ-h0cvyih8KA3L47PksV7Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4plH7u9mQlh0OhxRGqRumQfkxbx_22AojXWYZo-_EwfQ&oe=6A1B09B4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbdpood4K6cQ7kNvwF8cxOy&_nc_oc=AdpmeYvtASx_yImbE2wi76C7mtJUCg4Gu1AhfBRGGYlQJZwCnDKO_2KT0O9h4UPVKTk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jeoUZoaE0vZk_TDW3TPICmVyWkuFMCFoPew9Ph2hqDw&oe=6A1AE98E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LkBpM51yQMQ7kNvwHqWurB&_nc_oc=Adpw6ROSixcSUMq4TIF2hSdluNj-vLxsRfc6OpQ1cqCSmKne9rFEmFiHd3jAV_L4NKU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RkuILfB1NoXJ0drSGBBKC6t5wac6bFETQTI2ESqi9RA&oe=6A1B0A7E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIa90IDSISAQ7kNvwEhom_Z&_nc_oc=AdpvwZG7hU02NYFYeRaiNDScEIBIJK2pCoRfyfwr7lpqButPrGRx3EkFDIm5ttOQ7yk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P5lkNIb88MkiviAuK54aMkU7L7gH8WIk5R8nSNpjxRw&oe=6A1AF719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5udquyAQiM0Q7kNvwFx3pgj&_nc_oc=AdrU0V5KlPON2OSJT0IjZ-Mh_mdk3aFhez-m9wQlq8Ozu02sdizYoy32wFUAYSYrxrU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uXPJnI8COJvS7VgFWrP-ph3qUr4fgdEM36PJXw0a5jw&oe=6A1AE684"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
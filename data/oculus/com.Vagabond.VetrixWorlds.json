6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZhUgLUqm9QQ7kNvwE9izUg&_nc_oc=AdryRob95f1copHXnVs0CyvCMk12t5MA8PnNjIxgA9QaDMgtjLTPkpTWY-gSdfRP4sc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUp_uEkVGl4WZtYtZnW0SFdIVwYhnQQ_7JkqvZEqe4_w&oe=6A58C7F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIOphtWV98IQ7kNvwEVm65o&_nc_oc=Adoezn10skvvd8rCcO-U173dWBOS42KcrD8nukbplcrM7XiuWAPBQVKVQlpu5oAh-qc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQaOZ2rdQb6rVKaBNXwYRf_pGAz7ig7yV1rdg13G0nCg&oe=6A58E00E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhfDTBHrLwYQ7kNvwGSiyHK&_nc_oc=AdpWj3m4WqFjuLpPkZ1z29KuGeQBXlIZW3bSAdLUwYJ8h6qnYX-Gpq6t4myxUXBWWlg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO1V4NVA3cv88nZL38xLW00NsnExjtzHMX5jFZ3OwMDQ&oe=6A58C8BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edr_1vMkdGUQ7kNvwEmqHvR&_nc_oc=AdofUdNwTk4FuY5XdksuMmr76-oURYqEyfhxu60NAw__5-1GW7HK_zRQ4wC8oQ00B4s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2vQAf7Nc-oC2MhsTQw8jA0u9EaurYLPRV1dXliXipqw&oe=6A58ED99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohSanQkvDvgQ7kNvwF8ZQdd&_nc_oc=Ado0P3UHq9NsPA6FEQFtmZ2uLqIsRuX7HZdFirz-2WaulgOtznKI5UZxDYcD6AUlZXE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx39dYqFg7IfuTv45Vqr764ynds83Sp4gw3N6cAucu9w&oe=6A58DD04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
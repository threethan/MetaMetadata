_407696332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srv9oI2YWLkQ7kNvwEI8bat&_nc_oc=Adq4XdMWOJs0LAcB11w3nkD_iMUJ5oOLX9D6rNcPJssOQMyBwAt0oYFl0BOiAzpZff8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhg1lx32ZTtpRPYIV8Yh_ynC_jUcNJ6FnbRfP-XEAN3A&oe=6A8D83F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBh15AHrefIQ7kNvwHrOXtw&_nc_oc=AdrsTGrdeai1NGZenC8yTrDNLwytWw-ooweYCwYnslIZqW7wt6PB4KrKK5eF_05ckbY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYqcSpMnsjHbkw2_BC246LBARLbdxENKdaCjdpjvqsow&oe=6A8D9C0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdEQtFRS6h0Q7kNvwFCRmBp&_nc_oc=AdqaH4RhS1Q__n9lwOTdsDYyoO3S97bKbSLQPLNyl8q2j9mjLP9EFCVrZQ54QIfzeI8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBSwTuFlK-DuVWeN-SI81IcqnjoydBQWuQm-L73runNg&oe=6A8D84BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNJ4NPBxx5kQ7kNvwFfAy5y&_nc_oc=AdqfnRj_TALVKlUBV0q1kOm7FeVsGIauVm1lkmBtu8EY1Ee4MVCmxAaGcYEAtB-G25g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDlDzXWAIeklMC25m1sY8c5Pb2_KJrp92edSWxf3r5Yw&oe=6A8D7159"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNdAWnfgaSUQ7kNvwFdLPKB&_nc_oc=Ado-vbhCdpe1Am_a8iyflAjTaWZHsggG3XwCOGuq-Oq8fT_f0uUAvCzrtExIaXl5wIk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHicAJ2J86_T49l06FP7gP9Dc4xQhxeMuJAdjHoeSJAmg&oe=6A8D9904"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subs
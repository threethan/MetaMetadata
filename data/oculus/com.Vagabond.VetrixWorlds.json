6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cP1qmOcXfYQ7kNvwHJi-Lc&_nc_oc=Ado1MD9t6ANT0pVEMyOob-jqjWQkgkBllZkjPH2T0K30a8DpCnTWfvVxJDV6ISjX4Y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcRwPwaKv_vfDWhFci1h2agV5-vStrxHwlKKM-47DaVw&oe=6A4A7FB4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFcAYfm7QAwQ7kNvwEubDoB&_nc_oc=AdrV8_vfhQf0OEmuOEhoxk62O30z3WHwXypoYR6QoynuVN2hs3daUOVpq1WQK1NWxSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4ePllBH-lRxFPFdgNl8Tg_Q7nl27jzrGieLHAfPIibA&oe=6A4A5F8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wCxXjGDQOIQ7kNvwGn7bHh&_nc_oc=AdpdvZtVo15kLa-qpvQ1KbB8u9a2dpLixVPo7J1hhlCy_Lv6-O8GXCBrG2fXHxCT32k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6mpAsod1px1F2kv6o52tuVrS9mC6D75_E6dPmEUklug&oe=6A4A807E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWQwaBuQHRcQ7kNvwG-X3-L&_nc_oc=AdoHO9U9fUdsbWPZe09RybywefifmoWwKhOGFUOWk4c-aUSKzcydqHbOcPXFbnhAjhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUMQ6jqgWIQdJuvLv913Jr5MbyoRtLYwUTc7cFCQQTFA&oe=6A4A6D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUPC1qHs4McQ7kNvwF10LVO&_nc_oc=AdrMQHdtHfA9mfq1_C_8gqveVBqFAe2G44JlnOBZJtAxO0xSxsaXtN1zjbOWdHGofec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1WW66c-gHpbK3zdAgHtbPd4PeDYzIKk0-nOtfE54MTA&oe=6A4A5C84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
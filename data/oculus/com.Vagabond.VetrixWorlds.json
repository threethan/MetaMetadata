60_407696332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwYL5JSMTBIQ7kNvwEf70o7&_nc_oc=AdrYg7FpqGf24Q6paSJVwaxpX_AdMTBlFFpyOMNC7OdbP8b-7M_tKUiPQu92HTelN4g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIxrnkd_DXrEnkXQOP6U2rEw-Seh_gWbEMQ02EznOjJw&oe=6AA425B4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut9ubli08usQ7kNvwFvteKy&_nc_oc=AdpcuDxVwuxSwJgK8kOONgoNJ5E1J1mDADmAHPT4S4fgF1ZQkWz9mhN1LhTP-UmjuI4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJLo_HdkTzZizoElVNPNvXWriWRbWkvgxbQp2PhFlAGw&oe=6AA4058E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2Kvxs6_pDUQ7kNvwFap73P&_nc_oc=AdrN9nwIShVnGEyJKUrJKPeEu7CCJTPKpib6NmlUke3_tH3nkC4cUtgw9TG6GuR5BCo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0tdBgixcOLpS1KJjvVFE-vRkOQBbd80KxB9WaqhYeCw&oe=6AA4267E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFfsqXPmMo4Q7kNvwEVJAqZ&_nc_oc=Ado1S98uSbxD1PHumxyARxQdjaehyQZYn0kiJjFVhLQ8-Tff3XyLI_IMHiYXL-uMF58&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnak1GEkxkJPl0niCDFaAFq1zWS9h5SCr11e_04tY3wQ&oe=6AA41319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0sxGrtS-mQQ7kNvwGEeOHO&_nc_oc=Adr4eoI13Fl26CHsFkmh2FBagA8GE_cyr4gcxYlOs0rHpynllYmAPASSZ2l5jETJGwQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_h3f-Y5n0xCtJHXpYEB5TkL6SIQL_VBGsv6QfbhWwhg&oe=6AA40284"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscrip
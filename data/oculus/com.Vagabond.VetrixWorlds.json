6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MyVWXpUBXMQ7kNvwFvngnB&_nc_oc=AdrvLqKv4NoVJ5f5JEn-GszxZVIHlxoPfusW1weIRcfN0Gwx6n2lr2GmevCI-iU37vY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y9qzZpLEAlUO27ksldyN04d2mzw-zk-s8DwUrJPiFnw&oe=6A0C8934"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lDbD76DeAQ7kNvwFDta63&_nc_oc=Adoqiq2SahtD81MDKG22DYJTOmVJ_Wq-BIlGBm9lXkwfGQ5y1jXYCQgRN2K2FfR6yIA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vXPVx_VUw-0ZD5BrlC8BT6Rv7gG4yICHNRU5meS6c4A&oe=6A0C690E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krKCRDMT8mYQ7kNvwFpYeh8&_nc_oc=Adpa36zswEu9_3djhjSFIgiBtH1mK5tiTD1XGwYuYAJOsoeD7ejSQ1k8-mrM3fqsdhw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZbSK7bYji78fC7YwIRbN8Yh3hZggI0Z_toKDmcWPIAA&oe=6A0C89FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYqiWQvCf8sQ7kNvwExb9H7&_nc_oc=AdqXvNPRIDZnwXtHN_TgiZB4mfQjke-GMBTGZY3-xIcFTUneNJiq8NxdzvcWc0l06is&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78_SyaN-HKmLntZG7arxvxTRvk2d587cT1TLldO8Npsw&oe=6A0C7699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvr5OoO-12IQ7kNvwFYBtIT&_nc_oc=AdqsIOKn3YShpgfqlSZFBczLwZiwIX5Kr3Hde-_2gZewykHGIQPDa17j1UIGqvFO7AA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nyRhmeK2iE9XDgOv3yaMsl0i11dQ-GYJimGzMO14GCg&oe=6A0C6604"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srv9oI2YWLkQ7kNvwGbyoMm&_nc_oc=AdpkQtxB5xSD3xjdD9PdPfbs5eG2acYbmza3A4ZN_xaUPNFli5arWHCZxBg3r_1Wuew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkAl8swl9yqnUk57yd4oZnLk5mLAAD3oKk4WvM35EZcg&oe=6A9026F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVahVjkylKsQ7kNvwFtYr47&_nc_oc=AdrFK_HS6mNSGbleA7a2p0SPjPIz3-5i_xd_sCHkOO42ExxxZLV1xiLNEK1fYFxda3A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6EmfEqFenhlfyowx9-tGmMEe3vyFIYHJ4hwRMmjfIVg&oe=6A903F0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIdb5GazQ0sQ7kNvwG0cqle&_nc_oc=AdqJskeBS5SDIsG0eE6eeYYC8oso1PYLNC60S9WRmyigAsJX6_e1czRxVnJ0TjasK2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6elW99Zvc4ODKPLFWIn490exmcQxMRz964VETFcc6ow&oe=6A9027BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eVMmUYGlb4Q7kNvwEbXQ4d&_nc_oc=AdqXPGuZxAM8iYuSqqWhSTRB8hHmRgm7NCJHSCcWEokBjOGYXogbRD9HksdraTcX9iY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfepj9CpPMSKCdeq6hzB8OqnGZO1Ci9rmK7_wWNhYqOg&oe=6A901459"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNdAWnfgaSUQ7kNvwER633O&_nc_oc=Adr8oKFrFRlR8SAhHc-7pUgFxn2mi6WllSgAScnLvtsQxaAnk4YtgByP5wbG1n1NuC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-D2pTcAMrM4CMIKek7QKsKNFGQMt2-9vEIfkFcyFyHA&oe=6A903C04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
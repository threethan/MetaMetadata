_407696332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjJS12-9bAsQ7kNvwGLY1bD&_nc_oc=AdrhFUHJKO7aDIUY7Nmd2sg8ahiC2IO8QXgDJAYCbsjBsGFEOXA1d1k5CqlJsseNwPA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLmUljtpbABMT4oLtD-GvcKqTtOUb2AoqalaL47CAdeg&oe=6A859AF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bUg5JgICWQQ7kNvwH0QhcB&_nc_oc=AdpPp4wKrdO34pkvlY_92ga4c3jmuo-Timv3zh2Du_2X42ogaK3CNhIGZoOoUI-Uojs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFixiRJey2ICjUhGPVaEQe6xUF3h2HpR8PFSYWoVrj1sw&oe=6A857ACE"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEzFc3J4rowQ7kNvwEh3urh&_nc_oc=AdoR1YwZiXXFr3-oTGOwsewG6M-SqT_J7ESbzXJkfUuVHh9At0jf9vAtNYC-4OsK6U4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_cuj8v_kejF6E-crmkW8EW7LLmg6OWjbhAbhpUKZ_7Q&oe=6A859BBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i73-QDIrvAQ7kNvwFjgtcV&_nc_oc=AdpL3hhrrfM4PdMFi0BXh7rEBw3Q32_WIN1bNqZRr6Gr2JpimE0eVDHTCYbePjdiwgM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtPf0TWnUF3TYGE4N2mwj4cTt9_BtivRMBO-o-GefYRg&oe=6A858859"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkznq65vVSYQ7kNvwEKS0Dr&_nc_oc=AdrfWX1OYBNzOFwGerW00GvPASKLXV0UC7zk9zI89Nwxh4yXlRIPgES_W66fL7A6B44&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFijFxCi9h5uMQnn5pN2SukvUzAE555vYtBPoBlO3pclw&oe=6A85B004"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subs
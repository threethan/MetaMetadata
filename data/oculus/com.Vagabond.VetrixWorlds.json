6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hebRo6b-7ykQ7kNvwGft1lh&_nc_oc=AdpMVZiDtjEDV9ux4ZQYZqSjUFzIhbrEXLABofJ4Ga3qMxWaJKvP734RiNYvutC0BFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUYYSRGzbhGt5EAk0LH-xMYQEiU_6CsA5oMhmGXuA-Kg&oe=6A771A74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLpGIl7VYoYQ7kNvwGP9RXm&_nc_oc=AdrlmZBhd4ZR1MbiAr1v6iVRbh76DnqyqRbzIfoNgmsoSoAKRGzUz89gj_oU1D5dFdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMRtl5QyEUhtoI4bC2S91oH3jGLCUxR3gSbo-f3JGHPg&oe=6A77328E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c368gR-Du0sQ7kNvwFrZFt3&_nc_oc=AdrL6LxynWJu6XLC4G5Jvvo3GT1szYckeelUuuIx2QHCvdmhc8pruwUO2297yww2fwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETL0w1hShlohOR2OY-J6aGc99W6lw3xextUQ19moiY9w&oe=6A771B3E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5_sCPxDUrgQ7kNvwFQ8Fst&_nc_oc=Adr85zHTxAqAiVX6ro_-uXFVTPJLQSGi65RpmqG8IOPMs4tH-xpDZ_gPimcfZXnWN-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbLLEbyyZsFZoQSoGps_jIAIAXo2pYORoh-2llk8e2Dw&oe=6A774019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zrjr9z6Qha8Q7kNvwE07l9B&_nc_oc=Adqbe8-33-FgQaXvasa15oJRYdolpydn3tznBRuPfsQIopEn_2tyMjG_oscsn-OVJ6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDIwYDjL9kTaZjaiOCg5_CS7U4pXb4uG3jeQoloPOeEg&oe=6A772F84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
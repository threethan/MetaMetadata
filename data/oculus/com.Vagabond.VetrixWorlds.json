6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egoJRh0hbbEQ7kNvwFMor3D&_nc_oc=AdoE48kxENP_Ioiwee4es7om5KBf9AHgE9d-xlVigvVgVpIHH6meTvEW8bDunruyejE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SErl14bmCmuyTdPWOfM59flRwwTEzO0cEYw2GQ_-uPA&oe=6A031674"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH5KDPjyLDYQ7kNvwFp5K82&_nc_oc=Adrels0sU5nCBhxd9HEoo7ReDbjvUIJNSb_GR5qxWFLLSq175osaLu6sCGBLJ9rSYzs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PvpnEyxhQ0Vlg-poniu2TIS2qiuUaZaj__gBFL-3MDw&oe=6A032E8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v4kvg4R7KoQ7kNvwG85HJr&_nc_oc=AdqkPDLYo-SzSJnX60Y2cQxPT5ukoqd-dcXZBZQ2qKrm_U5_XmQC_stjk_A3okgd1eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K_Detg0TA60OFDpqlUNc3ib5mOE8cG8kSxyBJNYVJrQ&oe=6A03173E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpRzViYO-zYQ7kNvwHoPRaD&_nc_oc=Adrp4SutWtVdpYIYf0IMPTr92_rNg9k1qNg-zQqKEaY5qkIgINWPDJDj9u619B23fyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44HvCg74vJyKb_dJQ9SywrNsVXAmSzjGh561psCuBaKw&oe=6A033C19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWEYgxUZQ5EQ7kNvwGiUMJr&_nc_oc=Adpxc_1LUp5c5-GG6UWqifzseMpWRjHygniVCn78uvMhwqgQNKnDsARGxA7aXRGtesU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dqG8l44rnWQE2nnZ6OAOuUO4g_OBTGTbUUCVl1qDR3A&oe=6A032B84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
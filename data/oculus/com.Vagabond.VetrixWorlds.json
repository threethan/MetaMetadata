6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bbnL8M3J7AQ7kNvwHPOB-Z&_nc_oc=AdqFqJH3-A0c0AopgW6Wepv1lV0ijXRab7boxBgsbI2XLan5cAieX8mRgxYBaatjPYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKyMGzL-AwfBXnQIjNwPBg1T9sBC5SWOdTH7s6uObPHA&oe=69C91474"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqFa03QDM5YQ7kNvwFWKiAR&_nc_oc=AdrGNe6VnndTmt1ajjfy6P8LBsq83mkbzYlIhBBgCkeSZu5OtdXIcDuxlfCTutGBu8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynBSfGOJ6tlTnboX89wLrAj75e-jL6saQbD1TcJsNpNw&oe=69C92C8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN8_pVQ6gwsQ7kNvwF1PQjN&_nc_oc=AdrK9bo1T4PWg9zOdz2TWLGA5XNnYCSNR74-3YI3mLDKwPDFgN0CORiRmUQEPZ4aFBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIax9w8O-7BfFHJ_Mr1qa25C1QeWKHXw-wPzKKW9iOtQ&oe=69C9153E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUvNRRGbT2oQ7kNvwFAF6Q0&_nc_oc=AdrmRy5cVJ5nTbnqWWHkmwLs57WKFSvgO-1huFT3Ojtu2W-psOD2bMpH5PA0ddUZi6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzF2r3DsL2demYatZKgrcMqZgVoPZa-aYwiPAD7Dj80Q&oe=69C93A19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrAlZ0UcgFgQ7kNvwHS7eUj&_nc_oc=AdoFZjMOIZYiE8LwwOBMfcawDhDqtjAPHffOR4QzlK6TqJKSJRQcBL7xvn9yWJ1gd5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx61MbzAjD8yDXJK3sIe5mSkDmZeSeqhVq1J3DQXfrKXA&oe=69C92984"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PewrWVdvOMQ7kNvwEKgBPd&_nc_oc=AdrX5uA4ORPXd7oIavA1vpbU7EqVTiMQd9LgrU4jNK_ZfY9-pqsAX4tjzCgHXKaFt9Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HWCfOuWXnxvEPdwYIgpJ6C-OZPbfHNXAnOiUvyIXQwg&oe=69FDD074"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V_1vH3-sCUQ7kNvwEDoDvl&_nc_oc=AdpC4xSyLvbkgZdDPti8n7hblYmQs4LkmYsjHt-J_LJ1cv_QRa4fA7t-ycZMmqk6NVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v3WlSoSf0hsB2ldeRiynN0xjIKvSe2ArM9eCbl4slsw&oe=69FDE88E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtlgiKWEybsQ7kNvwEk8VwJ&_nc_oc=AdrgGrFwPkfSmFY3t0623sSFHm87OrTUOcjTugPR-5HBa7AP0QZsdTJyGx9fR-YAb7c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54jVGMO4VY7ptJnF9SVKE1I7VF8-IOf73uX_6gd_p5tw&oe=69FDD13E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMlab6rc9FEQ7kNvwGlEf2w&_nc_oc=AdpuKU8Jc5G-1qP8DuB0vJJUBK0kM09tPslMVRcpmqj3nf7v6yYjeKEOnROXxL7wDno&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C7xDWK1V_6uhsIDjv4_vcuDni2AibxL74-JMu4gHInA&oe=69FDF619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOBs4I8MvU0Q7kNvwFOZ_2_&_nc_oc=AdrfcPrZR-rP7Y3NXcCxmTBKuiB871cMDdcRHrElcINK-HqNgUTSmOcApWowMsuHlS0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PMq_5gnbmd4kkVaSbE_wDXnoU2_CJ83xc4q4fbBX9uw&oe=69FDE584"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
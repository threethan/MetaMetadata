6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lWbdaiwiqcQ7kNvwFJgaQY&_nc_oc=AdqZdDGe7-W-gagsnyPkT_Qm1arR8Kl4VxshUHPMNpb2FHpQNjh7A3nRlSlF59P7kbQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FA1veHBEpsKCYy6ZNXC5Cc9J2e9871UtB3iJBiJvBvQ&oe=69E61574"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJw4OAJvf8oQ7kNvwFm0kBs&_nc_oc=Adq4LqwkV7NeQ1aM80gSD9Bt3XtdDncQe2I_5JAviFl2shOF_GudJXoTfHNfG9b9J30&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kV1CaeMYmSGkAuqObloz3Nx8p93TyO5jWMWTuKp0b3g&oe=69E62D8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REUCIvqGZlYQ7kNvwEzQQjY&_nc_oc=AdrfgwGtsfrAiNSptFrNwjeNCha2tnqAsxX1xyIcccpFqlRsJOvDqwfnu46z6_ORV4Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jiEc3Rgm6_2YTuFLRIlg1ds4D3dcVWwY4Rg6zbptMFw&oe=69E6163E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmBExld5ecgQ7kNvwEq-UQF&_nc_oc=AdrU-gNSn3UMS2hNP1Tv8ZMruzYB258BPY5B7PiCVtOCEDiBs60d4xs7GoBn70yf74g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sFIPT00RnMCWQKYEiqta7M1thb1__Ubta0EK6QJlqDw&oe=69E63B19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK_ooqkYa6QQ7kNvwGkfudY&_nc_oc=Ado3z7zENp8_QzCdt2frtCQJxf4zmLpg5h2_c-Jd5iHi7VzK_1LxLZ-YqYJdzEUM8wA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l8CNGydMc6g_JeTf6-3zDqbTgeyDHPzHj5vuUGnlt0Q&oe=69E62A84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
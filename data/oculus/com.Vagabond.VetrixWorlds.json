6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhhdjvFGl1UQ7kNvwER_hWy&_nc_oc=AdrAVO3Kp2js49gnUWOIpQCePUPD4CduL2QX1xTtaklIx3lH8df2qoxcN-Qrg-XYf48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJxhTl6Z0-4P_sGZ5I8ZTw6DgaPyPoByPC24yzVPI7RA&oe=69CFABF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhXjzhFCfDcQ7kNvwEpA3NV&_nc_oc=AdpppjYs6a2Y08fn4jdO5aao2-btiRfuMY0qbbWZwQkp3hpevo88P5H2CNQBvxqXW1s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvJI5bJXTaw2aEzG3rfbESyruil6A2oKeREVuvXdJgWw&oe=69CFC40E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlBBFkPHZPUQ7kNvwGMKUH3&_nc_oc=Adp3zQ4kVeIco5vRP_ftPOySjfHXy2vI3cbA5dSY_vWQyTK0KwjMpJfb_7UFRrhrGC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEfdbKKhZ4v3lW6o8lVPnV8FEXA2zFyeZ9rEHqebiqfA&oe=69CFACBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wNgwBTx0T4Q7kNvwHCCWJV&_nc_oc=Adr1MAqQHrfXR34zHDWVi4CEmItORe1WOsWgNMc8fU2v0NI1xaWeKN5g9YEkVKPFnz0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWSp84fyFGXrkGhNWlYNGJNmfDwAv-15XxSZOSV2UUUA&oe=69CFD199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maoq5aN-RbsQ7kNvwFsugnW&_nc_oc=AdoWgzlqsP1dw02fDLTn64h1nytCkiIXhBgKFojb4WMSPi3nh_fmcbPLuRFNerxvu0g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGtz_Rdbp4vx4pLLcBLk9giEooHfCMKHaophCZ0hGRag&oe=69CFC104"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
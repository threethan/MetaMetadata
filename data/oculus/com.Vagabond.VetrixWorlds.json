6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjl-ZVI815AQ7kNvwGhvFJg&_nc_oc=AdrPYCpvX955_qbZRzV8ABvSQq5AtKIfNC1uRX5Jt0vKENf5EjMCfR19K2wR2MtRzTw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z6Q0aPm0EQ-ZvSoxBnmrat4dSA4-F53agIZs7-Vf4hA&oe=69E766F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJw4OAJvf8oQ7kNvwGb5hT8&_nc_oc=AdoO0vBtemdxlSGF6qgKIqQJITyus0PnUlgSdIFBEDns3mxAFtjdO9B_9sDyYFaoAd0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3znWmmgAHIF5IwA7sVCWoe9tUFVjzGcqaw_uCs9hsmPw&oe=69E77F0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REUCIvqGZlYQ7kNvwHGQtcA&_nc_oc=AdqqITwYE20u-w8PYwHN1d9U90q3FzaDBPyKTsoSoP91p_tNOl8OVRvxXXgByG1Dpj0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O4PFih4FzRic0kTUDTvj1a7UxqseRtrXSqNabLdeoCw&oe=69E767BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmBExld5ecgQ7kNvwHT8olG&_nc_oc=AdrLFu3JzL5wGCt8QmP5V9WcWyeHqbrR1pYZWQahpyXSwxbRIhvhd6MIBu1DH0LgfpU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MTHCGuX1xfofksJm3JffB2BZj-XJ9jx3HKMhfPcJ7CA&oe=69E78C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9C6YLFg6JcQ7kNvwGd7u2T&_nc_oc=Adr9URJ0vDL3WXmJeZUB16jDKd9rnWXckqQnEfKA9y8IPF__7CYvoXglckQBym1T0Hc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ixc2w-gefxY2JSRn9xys9W2FRDEtBJPcXxopVwWsPrQ&oe=69E77C04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
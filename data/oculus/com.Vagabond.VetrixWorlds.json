6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGRRKskARnwQ7kNvwG_dnd-&_nc_oc=AdrycyARkB5u4Fq4MbVE6mpYTK8TsUdLc_gqdrrfYWdeLlHhmxXjr0A_nrBGjobLtD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALNgTiqBopWxrlIBstnAGyxZAe9PgpaBQ0rcoXK9Jetg&oe=6A5381F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIO4VyHRLjkQ7kNvwHRMlVf&_nc_oc=Adpe8VCNHKgH-usw6t8RV9vXtkT5-M7248-m5IRtDFztDajGkGwFZiCT1BquG_kFFbc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYuiQP3JaL_ftwKJ2PwcZPKnrdWlwcryd5uwtnOeaZLA&oe=6A539A0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIaj4T_GMtkQ7kNvwEWCA29&_nc_oc=AdqQKdV78FpQLnH1EARr-SzROVwUbswz_HvjN-CEOwMWqu4Azt3h0gNz_blcM3b3l7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCD4qlQlfJ7qpP2Z3HGP96LJY1LY4Tql6Z8etig4ZbUQ&oe=6A5382BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7A3fOgtpb0Q7kNvwHu3tWl&_nc_oc=Adr6EIbtdPQk7Ha_7g2K1P3-nwTgCxVauY5NSPuZWy72Xh6Fise3_K_izmjd53OJbYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK1pdf5GVrSh8tGez92d4MbbC1EOtMqIL9UdFTqNmg5g&oe=6A53A799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vausd1YKH1MQ7kNvwFHtPkx&_nc_oc=AdqKfWkCw3I9q95lFhiHd79E8jtcGalGc4Sr7a8hY0Gw6LiWdW-dU55qVWKKFm0cm8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWzSm6UuL-HqReMNgVT9kbXYqxFykAH40pH0e4dN0lhw&oe=6A539704"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
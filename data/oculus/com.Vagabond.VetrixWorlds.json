6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWRKpqA2zUsQ7kNvwF5CLvD&_nc_oc=AdrVkaSPVA9OXKaZTeC3wvPW9L4Yb4jBRViZKt_F6CLtdGR_5168jqE7C8qKzuPhFy8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pDkGi6ZZwc6xtPV95tYn-1Ch7zfOob5X5ymiHOK1eNw&oe=69E220F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mo_2wwIYt0Q7kNvwHqwXl3&_nc_oc=Adq16wsSEMvEe-d6Z_94fxXz-cV8kPevM5zbqHH50PXHnvf4VRLlnCBMeOnO4YKIF6w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qvgbvYQWRaYn2wCYxhicXB4xN3pLW4BuZlx7FS4nTOA&oe=69E2390E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXymlhwvFBcQ7kNvwGHH2oT&_nc_oc=Adq5_bRFwEjdGSc4fDuSnvmFQS2d7R1OS37qRaP603qifmfGi_O_OMUR6K3V_d0xMBI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W2uUxqR8LDkrYQ3NtZJAriSBpLv994L1tt6G7xjtX1g&oe=69E221BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4YPTRPN5W0Q7kNvwFfgtZz&_nc_oc=AdoHIJCJbgPnzbFXizi5jb7uommlf383JKDeXOG0EFLKaqjvGyIJiNZoZ1aHsbZerNE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34pwO0ORfwRSZVinm6nVn6Ttj6Ugc9wVopDP2eTVrCmg&oe=69E24699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYB8eSrcULUQ7kNvwF6w0ug&_nc_oc=AdrgmtRwvGDUwdOZVi1S5Y16X0I5F5iLPMdx4O7i72kp_gg2lvR1p8HHvlLQFPLvNN8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d3pHalKLdy_TaTjs5KyBaXbNhecNmVPvXItiRtqEP4A&oe=69E23604"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
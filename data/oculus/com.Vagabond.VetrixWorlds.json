6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUrM_HBBQ_kQ7kNvwEPu7Qn&_nc_oc=AdpqHzzvknVrREmJ-G1Ir4vmTuTbWkDaknQNR8wV09GivymklbKnryNCgi6Hy8Fvs4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t4bokXikEuIp_UXaCbgtVRPVFrysLi_imWLcHUVYVMQ&oe=69D3A074"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vyC-vDdw1oQ7kNvwFCU1U2&_nc_oc=Adr5NHgfOvKRx-ExQUswPycvUdkLWUCr4T0V3himVaCD8D8isyGpriVl3-MLOhaJ4nM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wmEI8KuWK29sOq9gX3Yk5EMWiffhTslargyjGOAby4w&oe=69D3B88E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHlN4gXKaSAQ7kNvwE0zSnD&_nc_oc=AdrcV4dVrCdIrSjcJ3NjhIXjq3xhPniaZQBUVq_EDUwlVLB9x_3fVemmx1OyucmyuEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GtCFEnRqPhdF2xjrt8TAbXa3rRLtqyNTsQJufZjRmTw&oe=69D3A13E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ECmiRfuvnsQ7kNvwHoA9_t&_nc_oc=AdorR7ck8PTXNyhCLjakmZkv8r5Lsb3LtWb26_bgA5rzE1sxzuu7rrNvme2q3S_-HCw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rayI1Z4i2TfJds9umtgxU1WJwjQmT3LsvSmtsyo3dWw&oe=69D3C619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-kgxH0GX3EQ7kNvwFeZPrb&_nc_oc=AdpLJP88330gAwvCqjIGVpgy9RPVphXD29qGLqNOLjcnxN8Xj96bpDEHZ0XCJExUxx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pHOhwaLnNXh99tZrtwPq0eMUnxJ9lhv0PcckuiTgWfg&oe=69D3B584"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbJcINvF9yMQ7kNvwFp9Rr5&_nc_oc=AdoRKSgcRTStGxvU5sdl2R8cBpKWdFrkuccwCdUsiQpWvWGZnlMPOuDu3ABeO2y11fs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy6cX6vSKRLyYaF31vGUJoqYv0BXD1C_NkKAW1xIVgzA&oe=6AE21C34"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLg6YO0M8pQQ7kNvwEYqvP0&_nc_oc=Adrk6EwAwHiOP6GqnO3CZCf5ouUhg1B6DFMMlVFTdNJZs65ibrgFFElEywHWQ3giNFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP768Vzp5YHeHBLsUK7vkCxLhPSsg8qYL1QRrj0P9wSCw&oe=6AE1FC0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z-ViReOU_0Q7kNvwETDN4x&_nc_oc=Adr3pjvLtr6JxP1DhAgtWDF2svkL4T-HY_RDELMPsxdRGxOgzOYkeB_ZbNbH2bxwT-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOROB6lrgIXrCsXRYvUaGSRpOT_Up_4KO67nZmeEtIuWg&oe=6AE21CFE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzrlN_7vpxMQ7kNvwGILP6u&_nc_oc=Adq7nRkfTOdq7g3AyGVnkuPgFxnOSx-FBEC2YtFM4VDBMBEpPKQL9QXAOvpvBcwwZto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXhO8EuoPeMkkziZ8mxSPXchjA39thlAeZgpYpZp8KnQ&oe=6AE20999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfzC3WgqksMQ7kNvwEsH2tN&_nc_oc=AdpHdYJDu2v3q9RkcZXHUho9BBJBIwzORclYN9EqWBv-jaGU2sQ-vCkUjEBn3pfcxF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdiGBqtZElw4X9dlEHBa0sxYqRL0cf8bfJp_fViStpLQ&oe=6AE1F904"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsLpW0B2xYcQ7kNvwFW-PDE&_nc_oc=AdppIpMdHHw6UxIZKX0uEvu0QQQBJ1eR-y1UGCIaszNkoQ-_SyS5CD_h2S4BML8IOzI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqRWfaQGQA8SFVQyYIN8H-Oyx-AuYAQDfyJv4eBmMQFw&oe=6AD39BB4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pl4nDsYenEQ7kNvwGepklm&_nc_oc=AdoeK7Rcp1MJZ2sOOeDQUtVOTXhsUunwD2JVzm5i0iZKE5xt9DLf8FT0TBF-jCm5RbA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx4zzRlhqc4zWxoRYGXGCRkVWSvxffSOreAtBJKgGIog&oe=6AD3B3CE"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VthJppe2N04Q7kNvwGhg4RK&_nc_oc=Adrm2qHhq3p7lPBFAmM7Qnt-gRRPU9R6ZIgjPWGY5Ul3_XXyYQlMukCbqRo7lw8IGHw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyXJqN--z1FZkS-VMK3Flo8qMl_DzL7zleCr0_hQ6adw&oe=6AD39C7E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qMsYXv1jKcQ7kNvwFHmx0M&_nc_oc=Adot_28L50jDVQX_ihFyfHYkteVyO_vHiyq9rEwBIFxDkBTw1jjHPpOfXRwDptDdOVQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXwBnlXqe0zkOaSQ_6FAmZqndhQLY9WXiWv9w3yS9c-g&oe=6AD38919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfDIE51yA24Q7kNvwFQSIpm&_nc_oc=Adop2Bqg_9haal3B9yCBtei3oAN3xTcweLXSPqAyH3MfNuqfK-CjNGTqI6JsK0GnB2Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_r4y7rtGqnGCnP7M55931X4X1SeqKTPdvsv5Mg7b_0g&oe=6AD3B0C4"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
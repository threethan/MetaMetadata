6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjJS12-9bAsQ7kNvwEkmpXA&_nc_oc=AdqI65ibyahtV9qcwj6WUb-rKGNzuh9XeKG1mzOi8c-auC051jafKf5ibyM0JHTmaZk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAS3Mhm2-mELq9Z4lbWlTzBY5sPJQ61RHhZZW1KEPiaQ&oe=6A883DF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTIF3kzxQr8Q7kNvwFRcZv8&_nc_oc=AdqxwhpnD3xr3WOwXx3HEQ9AxNQeqJ3wF_Y1eRaBYsBs5f445DVaHH97K8sOovZJ8v4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5v_L_0E1nS3ge7C4D2m_SdtBpPlbNtOJbptAe7dSLQw&oe=6A881DCE"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtq2-0zF26IQ7kNvwGbighb&_nc_oc=AdqpAJ4qBNP2qpc56AtNAGA99biN_bUwo6UWjNVcS68GNGWEHVv_7elC6uXDM92Mdb4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYug2c_IUXRxiuiSguzSrJH9xtKaamv8boGSPjAnnbGQ&oe=6A883EBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJeCbiVz7GkQ7kNvwFEDZ-H&_nc_oc=AdoTp_t9aI0266yFtV9zwIq8nnQZGQoXmPuhhZjROaSjEjnMRwyGG2Yjitm8Bz6LTGA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENji21yzqTRVsY1a1PfaCEZcAOIVWY2P-N33QKkUodUQ&oe=6A882B59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkznq65vVSYQ7kNvwH-IzqR&_nc_oc=Adoys9g3yzt9IFmn7vTXB-dkSFwYHBl5KxdK9oZjI5rpa7GzhTdHxCV_8GXGrXgf2I4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkvJWt0elD-2ebYqfRqrUXad2Ku81BG1pTwfzZfr-niA&oe=6A885304"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
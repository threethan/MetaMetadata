6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8chHtYKrtwQ7kNvwEqlZA8&_nc_oc=AdoCWe2gnnKXvcNUs-084VPM-pl6TeAsxv-Pz679TRyvTGLNXhPW9UoAjycrc57fm5o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xetG0cmusImpoiUM5tgR9N9wSQBYdmazfbZlQmORwtw&oe=6A09ADF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lDbD76DeAQ7kNvwF0rb-s&_nc_oc=AdpJPfqN4qwGsuoV6DCu2cRspgAG6OAGpJ-ZB1E1RSYrhhHWEttSuHQc-HgcIVn1yQQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x_rkg3wSRPJAbf7C0nY7Vdt54-rihRFS9k_MlsW-Yjg&oe=6A09C60E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krKCRDMT8mYQ7kNvwFKf2pl&_nc_oc=AdoV0qC3kiTsVeGpnb6hvJAKbbU79Rb2SA1zp-aI-2NriK6AxSrtH6LhVMKstBt8kaI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M66sCcWIWyr_4o7QtWfQ28bRcYa55hjJux7_3Cm63Eg&oe=6A09AEBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnt-vIEh784Q7kNvwHF5wxh&_nc_oc=Adovj_W17xY9JVIZaY94Z-7YqEyXFVjmHNICX4JLNkZSAY3B89TgH9a-q1-uaiLm8co&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P17VADOsLj1QNjaqMSgL6D13s7LXbF2Lcb88L1zslNA&oe=6A09D399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ4uQb2OQXUQ7kNvwGTkmRd&_nc_oc=Adqiz2rFrtx-SVW4eX0djiLYpofASzOd1-5TQpqtzGxMt3217w55v4DHl5hyZS1ho14&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UskPNhR9Ia59g0fD9_a1i2bJC3_frMVIzMYhwyulWxw&oe=6A09C304"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDUK47YcjSEQ7kNvwHmn9cS&_nc_oc=Adqn_GtbHzqwgh7P-0cN7Igh54PgXfnQ2UFTuxeAipYYNpl0WF-tREDEgwB2LVzIsYQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-luy8ggYnkvOXSZc-SGvQe2RY3LE1JYxKARWvL7cEwmw&oe=6A21A134"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GulUP8pOTIQ7kNvwG_uP9B&_nc_oc=AdpvlGyXWXU-27kxqhmw_pGDJw1ldNXQ2j3AfYymXXyPAfB1GPs_FbN7zUemhe8D070&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B3SX9rJQLy0djpkKcermxJZ__4onzv50Uldu9_V6uTA&oe=6A21810E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-YFcfYsMhoQ7kNvwHk-iji&_nc_oc=AdpfV-5aIBdU7CENpP4ikxMMTkhUCqy_WgQ2LscQsBj-EXRQmjrk9AUnHvsVlbaAw_g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81GM1EoO5lUyK-JSyLs-Gh7-YgaFeUB8ptoa8YCPGxWQ&oe=6A21A1FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aeMKPO_zlwQ7kNvwHmrfTk&_nc_oc=AdpUN2r7r1PMxNmQgQSEKDuHD7hiNAwgYURiXNbJTW7mFVb8zFQ7IIv-1pZGZIxLCnc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tbIXTFyArL15QOSxM3880rzUjhIEMUC5Qe9L3QZZgbA&oe=6A218E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARy69BjuaywQ7kNvwG0Nq25&_nc_oc=AdqmmhXEuZGTwBjp8LimMDYc8txQuL0RataVialZgTC6imgPNF-qQO2QV9-IaoCPBAY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TXBCbiu26agiu3-nYlI--pOYsNAPdGZvhnXxHdPtCVw&oe=6A217E04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bdb2KtH6KjEQ7kNvwGpipsQ&_nc_oc=AdqT4dyIk9k42pRfMOxUXyDNQWUQmNW3A2C1RfSNmbhWB4dJNxG88vvTSTsKskxqkYw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aaDFppFaLcKKD5eY6RCrH3InbtVD-DCAwMhYpoU0JkQ&oe=69F34474"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4R4QgKgXt8Q7kNvwHbu1xR&_nc_oc=AdoiD3P8oMbDxQef9ASzkIVBU_rcUmaD56YaPDCcXLwNFl3czUJdiRcuixnXB-s9dAw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3u-elw6c3MAXWzxMIRtwQpbs2JfHTrmPFvWj8UWS8rQA&oe=69F35C8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b8LDFR69RMQ7kNvwHkoZmp&_nc_oc=Ado7-XsxyMLdoFBJuC2vhWB_VQJoppLJm14xab0hZUzKAZdSIQ5ZY_dc-DYQFltPjDI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36G1dT956PrUWdRPrQ9U58vu08fiUHdHNy6w2YomjcKA&oe=69F3453E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5la0R2s7ewQ7kNvwEMaR__&_nc_oc=AdrPMxoxkpyM0VCoqBXIscPkQxcADXg-hBSDwGhltCr4Mf5ODJy2Ex5TeVhdktIRH_A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2R4bgBIG4Iikbwj5Fwjze6AnXEOmnew8N19ojR4We2OA&oe=69F36A19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wId54oDLrG4Q7kNvwG1InMY&_nc_oc=AdoZwputq0IiKcb3thtMEqWnzdQAOnsZ4HSNPK4Ladr9CnTfwf3pwhosPb1q5opYJGU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SIcwz2n48NbzSEbPBUGXlPbciwkD6FeRjQtV9Lk3CQw&oe=69F35984"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
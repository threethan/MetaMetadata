6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hebRo6b-7ykQ7kNvwHwxxpd&_nc_oc=AdqVmDQ6AGLtNbsLpO2Hu-VXlR8EwJLapX5NY6XbUmWz5pN-R4rUAcJVKyp40Vju5Ak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELaKVka8MmIpwXd_jSlYgEMvtCmbgMOoL-d6tlPHmIHQ&oe=6A75C8F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLpGIl7VYoYQ7kNvwF9ZG6B&_nc_oc=AdqDMVtWePOu2W7Ju4Gtv6-hON_FAEndeLqJWRX1gnT_PXDMWUTQftAgbEiKXSev9Tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF-grkzUJ9eTmti8CxLtKS_pu4rVXlHiHY2T20X4MI4A&oe=6A75E10E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c368gR-Du0sQ7kNvwHSOVHe&_nc_oc=AdrKaAmaXeSo3fJ7M27BAJqEaeC22IJ_hgjFhvuH8NZ4e5slAdLk7oJRXY4T8TgfY1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsFFw2DeINWsD68pshUN8K6yCc0uxVFAyFbbzsBxK67Q&oe=6A75C9BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VsF4DPk9BQQ7kNvwHvGWlU&_nc_oc=AdrHn_u_gfKnOQLk9i5Ps6Zyq_JufZiKvWeCbqvrC_379oCvhtO6n_IskhWUBwT9pkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpQBGCxtfrmG8RYsTuPpW-3yTYFXNndywK12-QaaBPEg&oe=6A75EE99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zrjr9z6Qha8Q7kNvwFOMTMI&_nc_oc=AdrilCVgSDvosyjsK1A4i8YgWLPQZ7_vU0eUP-ZIlCFynbuKQzhvu-bRJkfHWoB3avs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbwFubiYGK1rc7YFHVpVV3uIHLdp9VFWfWh0VMbLSRWQ&oe=6A75DE04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
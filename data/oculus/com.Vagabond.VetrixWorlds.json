6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHCTQwdBHjMQ7kNvwG5YC57&_nc_oc=Adogh1pbFQfaUowwIbvrTNQNspXWoo2xkrFNdwrBI3JVC8yS8yLW1XFw91cql6a1fps&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af359LjzliI4H9vdHDLA-0bvCBYSGcZQMPh4Y0f_yYX_bg&oe=69D794F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfqn8wdNJckQ7kNvwHJy85o&_nc_oc=AdrhV0T8NBrbFKZjja0wq3vW9QrwqbvGj2mfRWMjlxxxIAFsfHjfxOhb7hqOwjIDQLs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zvtCTcu4pzz0yR15Mz1eWkAI4IWvfiShm3DLxRVUaOg&oe=69D7AD0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv63LdTgXNgQ7kNvwEMjkrS&_nc_oc=Adodqqr2152IfA8GW_KH0wufTkExZigrZBnseAggiFpnvIvPYZZ04XxL0-oI-jWIJsg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hYQUT5Wfjc7yUoMks3ElJISJ93FG2jWVxtKb_9t7PAA&oe=69D795BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9CyWiM0sHMQ7kNvwEKlA9O&_nc_oc=Adpf1IeediZsPUgF37FmBVGgDjJLFyP0GmxlMY7XFP0Y37_Zou_Vw0Gp2QuDJaTcgmE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C6u_3ff0k6H_vbb-FqjoSbvRbZEkvFNLQ74P-Yp56qQ&oe=69D7BA99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9oioTEP2j8Q7kNvwGxl3GK&_nc_oc=AdorDDQ4qfOP5_uBj6WofQZPPO0NSHvEeCDf4QsMnl5BR6aBVnw0k97vK10g18LipFk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3513n93eO8Bin7jzEmYVdELVZEM9WytsumD7zAfZZxvw&oe=69D7AA04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
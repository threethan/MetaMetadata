6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PewrWVdvOMQ7kNvwGr0jvB&_nc_oc=AdoGn92u8dccPW_im4ZCsTJDCjfG-uJ0jh_eWSCiEhlJRgYncn6llGlC5Fa5Gau_-j4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l8v-CP9UwiJWNEF44yC0YGshj1RmO1CfXTOtT95AizQ&oe=69FB2D74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMBMc3CoQn8Q7kNvwE8nwv1&_nc_oc=AdrdEh8bWgV4P-6n3nOgETnLGilzDRBnxtVslaPc7HcdTXiZVljDbeagTVA0-0cURHE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U-1Rdfuu6vE_yRD_dloi-mrXniq48R0ZbDmqKbHz7Cg&oe=69FB458E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSwSd3vEMI4Q7kNvwEzFABq&_nc_oc=Adr2aLsx_hkDSPfscclGrl0nyajuAUhWUXsLq4dGs4gdEGcTWe9HmPZychWa5MzqSK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gzgiUwbG9Uiw00QSen8GfynUg-o2OxoNzhWBY_HWHJQ&oe=69FB2E3E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41cJvM92-GsQ7kNvwHgOXIw&_nc_oc=AdrmFJpjRVi-QE0WbRYu89E4anXnhi4TuDkrpfTpdzKGpfotb5mOQZ9Ig_t4pNOxOjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yih6BtPRDQta6fLyAQ72Z1iMYXTKrUGdZ_SaPEe5PmA&oe=69FB5319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOBs4I8MvU0Q7kNvwFVMU__&_nc_oc=Adq6A1wPkvTi3Kf4jWcXEEx6ZauAVwNsd59_B3mbNQ09W98-1xV3dDzxP6X748N0HfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Eec_nX9DC6ObJZWQaRi_Iwl0W29XyaqYV56aI6H9pQA&oe=69FB4284"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
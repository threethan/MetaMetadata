6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaJIv9K93U8Q7kNvwFDrHzo&_nc_oc=Ado_NyMjP5MB2h1r89n6kI2xatmnAOOSZzB4XQrCB9vy2XvCysubGptMo1G5q2E2eCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Kak7rDuueb5LzIlKJRKH2mhHlWqQD7p471yfnDgRkSw&oe=6A341634"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaY2A99UnYcQ7kNvwET1rK0&_nc_oc=AdpFcr7-qIGT3gSDnQ7k8GufvCExU0FjcN4EofID6-lHFW8NzTx3Qy1mEKbkb2qUL8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HHnKopOv9kmPt6NLK9ZGFKArqHNd5VvmTmJ6cH6wuuA&oe=6A33F60E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9U3P523BvoQ7kNvwHUif3X&_nc_oc=AdrSKM3RMNetho2Zspb2mhHGUfJE9sDfpHjmAaWkW8b19Af0K2fzEpXUR4_QDS7ytag&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ynhStb9nUupCNeJSMF9j7_8C9Zxbgi_DDQN6g9f7sZQ&oe=6A3416FE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXp8pt0OQAwQ7kNvwGD2_q7&_nc_oc=Adp3xg5oDIXn87FmGcrAIWKApCf7MO4qTdKivGS755tYFMDdTJQoS592ghUEuPvQlNU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZsZ39CV1F1dcLmZnOnN_2y8GZp1KRQioIg_kK8P3YKg&oe=6A340399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq7WKIUEf1cQ7kNvwEg07NF&_nc_oc=AdqPsPx1ocBlNbFFhIkiAhmUSWtVSvbEavlmVk9mVL0MuD0o2KXgVLfksTZG6Yc6Be8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RO1yPISpzle6tWfc1ThIQMb3RnosIABNzjQFQB7BOgw&oe=6A33F304"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
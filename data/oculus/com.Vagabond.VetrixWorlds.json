6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaJIv9K93U8Q7kNvwH3mR7n&_nc_oc=Ado9w2tAi9n8wDUBZaIT1x9TPxhHGWDnOFlIivkWrW8sQk7HAkGUMAQo7kWuBUPTXo4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KSLJ2HWQnjfrqfUCkVFlLvMYMHnU2kH6QLHnS7HVNaA&oe=6A32C4B4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaY2A99UnYcQ7kNvwFvDP7G&_nc_oc=AdoggxZlIofnNum1ZewsisbTPpCDuzEg48boQSyW6CepvvHnqHrRgoq3BFQ5D-vEHd0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i8tPAexsxb8K7rtSZnrTBfvE8e_rP5fdqvHIFlcHpUg&oe=6A32A48E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9U3P523BvoQ7kNvwEpQwvv&_nc_oc=Ado7I_v8W2aR-jz5rtuo8r9V08-miYZY1L__HRgI6qx7QlBPDdTyW7XG9JKJnxyBqow&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YNPBmyAMi28_QA0Zk2Qlot25rn3HKyRFCyEM1nMWufw&oe=6A32C57E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHNW857pBc4Q7kNvwH43ouz&_nc_oc=AdqGLdM1I30FoLL2qfmhfxdWQlSH0RRWpzKfMGX3ONlTCK9LloTfK79GouUS9hEQzvU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kwM0_5R6qhcUfyDKp3GPijDJafBgV_wu3owq-cw79mw&oe=6A32B219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq7WKIUEf1cQ7kNvwEuD0To&_nc_oc=Adq3876rr5GMCN8zRd5KrgTIXDco2_NaI6Hl4FAMfifTmz1nrUwXU9gO_Jz_k_4nu0s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T-N2gedN7N0Gs1GNE7GMA8qWEOeTqF1BFw6z159ko3w&oe=6A32A184"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
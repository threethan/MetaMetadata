6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbJcINvF9yMQ7kNvwHa6vmq&_nc_oc=AdqiVGiG8arJHeCfgvpl84XckIIpHtwT7U4UFgbeqvqxVvK5EEAWOUQMG8pmRP9iOjc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy8vhBHDqxO_yrEdvn8Hk5mq6sijZ5bm9GrEg3VIip7Q&oe=6AE36DB4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaJ3sRTk384Q7kNvwGToPac&_nc_oc=Adqvb6QGEhMyY-OK6bhXIOj-z4KVu9v_fPsvBPbjMUFdSmpAX5gn3J8WswZOHX__1Ik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3c37t_cEx2Oew4ExdGc265dZIT2i5JOLcqmRWJuPv7g&oe=6AE34D8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Pa3y0VeEbQQ7kNvwFmOLVY&_nc_oc=Adok3iPpAbaPuRUPiK7BMYfeWJq8TieqnDBEzKrUVDHgj0nmIg9wb6QhumeKqCDlzuk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB_f0xwA_81uBHwyqBbt6EKY1ZIflMbHuvQNFOSRNy7g&oe=6AE36E7E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzrlN_7vpxMQ7kNvwGywX67&_nc_oc=Adpcg-dgbx5AwcsqlLc1EA4EpXzTwD5vdH3MWvRHi8vGJkfXPMnh_tW6n3XRddJ3inI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4qhOQJRip2zQFik9oXQ_ymgUF6Jb1YOsz9iR63XwhzA&oe=6AE35B19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfzC3WgqksMQ7kNvwG-2Ocs&_nc_oc=AdomzyxJn5HE-hcNXeA8gNO_aMUFFxGvzjSGC3ad354sdUWKVtQmnuEr4eLX6xmc7XE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvAW1c4Fth881lpiOCu0C2HXqdIe6MPe1c1qs8xRhaNg&oe=6AE34A84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkf4IEJSR7sQ7kNvwFGWo1S&_nc_oc=Adod0soO6ISLk7hehloPJrytHj5dy0H3C1ur1k1_Ql6rZuO-jPCrzVSiJfdzIQw5MaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QGr6A-Os4Nqexq8B0kHEsgXov0aOFEr6Ww6AvOTyzXA&oe=6A007374"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V_1vH3-sCUQ7kNvwEHw7j8&_nc_oc=AdpIjAv60uWSiuCUywfZolF6dWStp8ub5JFHk0BQ2Oh92T9XkGE_vT_ZngABpqYvGdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d_QWXcisCYichP_PX6hxJJF8MQkfpV1k9s0nmsIZtuA&oe=6A008B8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtlgiKWEybsQ7kNvwF2025o&_nc_oc=AdoUau2zeUJaidr5f_V0GfPQKG-nH5aFkaxxwlGg2O2He4Xm-0Hhs9g0pooZxUltuTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I6FsXXn_8D4JDqkKYwROX2e-z0bsVluZKEWOekWDHag&oe=6A00743E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpRzViYO-zYQ7kNvwEyt-Jn&_nc_oc=AdoZrnAB-o5siTP4i0MTN2nRTbSomLxN084WXQCd_xkoTOXQhDgoPCnADEU9D-ebjRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xfDpx2Z1gWoUnd1EEC0qH9xvqiBp0Z_4pdPxC56GvTg&oe=6A009919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13KB0g2lDggQ7kNvwHj0qkH&_nc_oc=AdqSzSjH5vmdcp5NEPr1RKEPmafjNmGsWxVZpzEpyH2Y20E9F3V6nxfCSlY4Jif5LnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jmy6CROb3W71T5msmB7YRFp5KP9BFBKYqgkKSOsDsjw&oe=6A008884"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mz2TELCJ98Q7kNvwFVcBZw&_nc_oc=Adots9I7BychfhnalXbmDDKi343XJN_dtOqJjlQRO0XCyqTKUhv9Tv5w2HqQNHxaqck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V145bnG_gsCXSBUdscZgyWrdaF6-uEh3_mzOZDFzHfQ&oe=6A2ADBB4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x18STcCCGGcQ7kNvwEA2Db7&_nc_oc=Adof-rjm1J65yB38tBxQ6-FuFiQvpSS-Y4JzX_80VIOF3LJBxnXH6GywwDatcgcZHDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kzc2sdr_yQmZzhe3tEjySmw6vgCUC4SpZAm3nqwClmw&oe=6A2ABB8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrVx69sY-u4Q7kNvwEEXhba&_nc_oc=AdowLcENBcX0OIvDzS13p6mnMwfq11ss5qCAsPhOw27YK_bIAcc-zF3Gvm9pb7FjikA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s8nqEpARMcm77a3dCWLoTcdtjCWcDEi-WKwUlbBIqzQ&oe=6A2ADC7E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8s6H8kgJ-AQ7kNvwEX8lDO&_nc_oc=Adq-ndkVq7ofZD9yd1V4cJox7_UF6SAm8It1cy8ZHXHhqfwKEcvWBo97JIxvGgmWQ-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S0NoQSTyJwsDsBWU9_m2edTEe2nKhv_JZabtwiYAzFA&oe=6A2AC919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW-MsHel-_wQ7kNvwHjfLrX&_nc_oc=Adrt5d3vASb5C04OAh31p_3u120JXXeBxnp0eqHKGQsX7aUH6QjW42GN4jvyTyW65-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hECIClhRcoG4F1_Npme0Edgm8NVp1XYlLmD2cigcRfg&oe=6A2AB884"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
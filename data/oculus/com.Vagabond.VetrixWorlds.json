6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkAj2o4Qi6UQ7kNvwFhhj5a&_nc_oc=AdqGXlRflGi9q59T9sE1C0UHnshNwhfOqV8ghf9WnoEmGnXUy16aJ8-jzf0aC78cvyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bnE3IJmn0_QMg8zUR7hbMslcQQ57vlJ87okJl2eGD_Q&oe=6A3D50B4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swF0FjVT3iEQ7kNvwFzl12n&_nc_oc=AdqvRBFscbgAXJCkBTaPwxmyrzOiakGwdfaPYeQO73UMWPFfhsrmqgjrQykHebwiFy8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g-6KEIHHorif376KrNnGbQYOBPe3-9h9z4WxpeHtwrA&oe=6A3D308E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZEfkX-ejjQQ7kNvwG-Clg-&_nc_oc=AdoWM-OvO9QkzL7YHoHDlhkFeIcrLA5-oPhMhB44pePPh4hHbpISpXW5o2EWvy-Ynec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fgn82OWjFjhmGIuYwF5hjpzX_Fc-z9djfzjClTIL2gw&oe=6A3D517E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4MGGEQIqzMQ7kNvwG97DvD&_nc_oc=AdpHUdBaYt-rjkvLedNgf69aZzGJ__UxbXJ22np6t8GNRoPjYXz5CvplhjMaeo62wEc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af884UUoavY9ZT7kbV1FUTpCAQtXLgz5apGPVBEyB5WL0A&oe=6A3D3E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTzzHZmC5FEQ7kNvwHuZA1A&_nc_oc=AdpwaNa-AZ8cPWFehREb4kUkQW4hrEf35aG-ygHtoNNo_W0U_6M5piWR52as93dnViw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lDLsbajdkNWMwtzhDIoJNpmOtg1P25HKEpqtOAXssQA&oe=6A3D2D84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
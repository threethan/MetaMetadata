6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mz2TELCJ98Q7kNvwFZMaFE&_nc_oc=AdqM-JaLJcE_1oXbtboNqy9_nZNd9cKQEuXp-PhCPczUJJPq4jCCgS9-F2aNl0TR6Tw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZD_vTlMOIPH_dwQKctHARq6fr0rjjC_JuoI2l2gBjUw&oe=6A2C2D34"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x18STcCCGGcQ7kNvwHTQf-f&_nc_oc=AdoU7CulNtrYEOH0MXiJ-cGMd3fRnET3y5g3TsfvHhMp7GnyYvBuKg5EUgDKX3Ug8lI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ofPIfFnAp3oRsdYdLEIImiaSE_SWc8NfFU1oQx9an2w&oe=6A2C0D0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrVx69sY-u4Q7kNvwEgltL4&_nc_oc=AdpZikdVi1KEzirYdWzDl1l8pTPoLWb9V8CvTRaBjhx4BmXfTGhLfrpdbjo4riO9GA0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q79ndwJz3ntu4_btDNNPE1MKTvnI99kmFMCP5C3iIag&oe=6A2C2DFE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9wNOo16aQIQ7kNvwGtkq0r&_nc_oc=Adrf-S9uX2bM8d42iZdtA8Mef0uBVj00lYQZTlX9EMsKQbSnq5iYV4FXME1dbVhrWVY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u1x5OqRyX2L5RTrnpsiW_vr64yYRl8kHD9BmRsVEt9g&oe=6A2C1A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW-MsHel-_wQ7kNvwFoC__O&_nc_oc=AdpNs9YTmHdpUX3rnGL9l1-GI1vfe6rfHynCSWAvftzFAc9uLzKTmID2wAe6x9_Su3I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bjRSoVepTOcB_6sfcjYNfgvc2-cyB2sFd-wX42kec0Q&oe=6A2C0A04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLKCNvprCtwQ7kNvwHVOhiQ&_nc_oc=Adq8hxX4OdhWwFnDijZq7zYg0y8NEiIOa3sHInQhUyF5aJl9zqIofaPyjY5d_MMTKnI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdrmb2W7kWOJfKp7p0-Ro_HQHkjuKBibXwBp4g1mecyA&oe=69C51FF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asbYMAUyjIEQ7kNvwGTAACr&_nc_oc=Adq05EmaiTqutMbxoJQ2PNwMuHns9PZ4vuyr0S1EEr71xuqR1OjCkvnaIxoWAfgGWZ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwARNxcuM-uJqukLaiFp6QUynmB_hn3XS3dnOzfX8Ui4Q&oe=69C5380E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnBrLOq08YEQ7kNvwF4wjas&_nc_oc=AdplGWJAfieQkDYZirdvmKXlsNGJZ61huuiQsD-bcd89yvRGG5K_nIVByvUyQQCpa7M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGKSepni2TdH_iYLQdpxAPurNyyVqfQvJt745-OivHDA&oe=69C520BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYDiJx4hb58Q7kNvwGI0IlJ&_nc_oc=AdpIiFPd2SOq7zE1W4f3tWPd3imShkvEdQtezE8i5iw2j8Jl1RhfaAtXichf83M6Mhk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwLDGLQlclyJ9w2fT4_TLMxzx8iLtUktWZqg2Cuv2D2Q&oe=69C54599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vegIQ6arFVMQ7kNvwHaSz-L&_nc_oc=Adp-JZd5PoWX21z0nGJA7IheacUsdaDSLK7n8yOsD9ssd5jRTPzhANZ0Lyx9qYQ-xHE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzZqW7R66EoYmBoozW6O0wrqzjW0dDRQFylK_jciFAww&oe=69C53504"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
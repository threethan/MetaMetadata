6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cv3pOA8lH2MQ7kNvwGo3_Vr&_nc_oc=Ado9DfL7svukVouQeXkDTlHvvfBefIeQ4QovkE89_HWhHZH5xTbJp2wxANGKvgm2R8g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hiqC0mAnl-4FrWcUnXazKES9ZLavR721J5ervPFfGzg&oe=6A16DCF4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP054mTC5NIQ7kNvwHI6Frt&_nc_oc=AdoENY1l9lsQdK5OT4iyX2RQQQGHqTZnYmNwviRVTI2qv0lN-w7iSipwgEim7X-XhH0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SAYK-cMvIzXYo6wOSW1p1KWvYbj4ZzXOLv7zW-xpJWg&oe=6A16F50E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCwnV7-tsvAQ7kNvwGgdJdf&_nc_oc=AdrRP0HKHCL5ZBvcFw1WM1wrdm7cZLy_rMa2hWX3gKZT1yDMMoz-F0Vg5SeNiAHt_0A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64Cl0QNDU1-BN1wASbUnty1tX_qmcwI27r88sGEwunRw&oe=6A16DDBE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpQgAcyOCjcQ7kNvwGanehA&_nc_oc=AdotWdo2yRcyuioBKa666J2EYYmGhV_RgqlFXPXktce46Qhv79pvwSBCjbNw8Nb270c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ps1G8VMlra_5TN9jdWWGVWsobMLfRNmLO4Y5ToSuHvw&oe=6A170299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY1x2xf08zQQ7kNvwHdZ5dB&_nc_oc=AdpXE1Ll-72s2_nXkf3LQB7vDG__nW8Nc3tsaBYnfsLnWdFboUOTMkCxoVp3VyGvvJ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IgjFltR6k7jD2iN9bhE5BOmrMe4ZZMbqYA6nv5X1KOw&oe=6A16F204"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
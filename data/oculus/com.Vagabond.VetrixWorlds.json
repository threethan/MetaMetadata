6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MyVWXpUBXMQ7kNvwGKY2mD&_nc_oc=Adr4RDik8pakqjoMBjkP8DCg28vfctsf7jlSH91gW_4rVCWh7lKsSal_knIdo8WBebA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62HAJwNLv4NGdpFrGXYpOzQJUUrw8gxrx8P1CWsyYpZA&oe=6A0AFF74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lDbD76DeAQ7kNvwFuA4EG&_nc_oc=AdpjeUgOwT7sU9sSSDU3arpbGhRp2XqWx2SgORP8GHpi-TLELkwbzsM6_wszxkUHMNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iYwOystQmaE9QlBXuBYAui0MI7JgdKm7cMObTDW5A4w&oe=6A0B178E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krKCRDMT8mYQ7kNvwHEsNkQ&_nc_oc=AdrkzKa_cDxmws0ER5fSjxB1XXdxDuFvnHNQv12r2Skpxpu_tQ1oYkliBbJdeX-FDkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qQyefooKcLMjPAmELLnU2A0MlzkDNsDGav4Jj3LKJPQ&oe=6A0B003E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnt-vIEh784Q7kNvwHkH4X-&_nc_oc=Adq5xpTKhavD5Tm7wVDvYpVAhwZlx7By-H6M3JrlPmAWj0NBdkEF5JDBzzHKrDky4q8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xWaqXqu0IrG3a2jyECQwWydVmXi-N9YVA71e20vE4ng&oe=6A0B2519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvr5OoO-12IQ7kNvwE9EKxR&_nc_oc=Adp5uThHAIYgVEsouiA7CffIiGa_e3OLwJTJ5zLXrA3CcbUImtIUj4WuAB_bRSOQ5iE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QJ1O1NU5UTTbEKyp47xBQzA0rawWiq_hvizyPHQabvA&oe=6A0B1484"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
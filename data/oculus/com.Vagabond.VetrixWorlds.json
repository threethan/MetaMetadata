6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWRKpqA2zUsQ7kNvwFCt7M2&_nc_oc=AdoOMwwb58eXiRY5WqSxTmX9ecFIuEThqmT_bEG6ibse3JSIYfpEqOTIYojdiddATsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qc3Oqwe7bh58FqTL_ad5oPj8tw_p4wqriJWogBTrsjA&oe=69E0CF74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlZOgKGtJn4Q7kNvwEZb204&_nc_oc=AdoV9e80XPftMbbVvBXNlwrK1Jh36lITZjR3cvUtE7FPbnGfKr7KuTifkE11PR9cL04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29p9H-hrA982o8MlVKVwV_l05_IMLJENOplqWJy9IvDQ&oe=69E0E78E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRD08KPuuMwQ7kNvwFi90kn&_nc_oc=Adr-lbe6Ofz_4m9mc_mHO3QCUX83awI6KuPjRxzsXDmw91g2hj2xCmpyAjxSDly_MPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vH3TMWnGdL5AlXP2UKkdSTRNnG01twPiJisT0w8jbBQ&oe=69E0D03E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4YPTRPN5W0Q7kNvwEQozLO&_nc_oc=AdqVoguWp9koDxSkMxonSqFTvGJ_SiQoPEGc9D63DzcTmklTg5luwbT1qLjMz2dxA7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DfN1Iy1d-Mh7sxr2vhbIoIu3X1FLfgy91keSDdVTvgQ&oe=69E0F519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYB8eSrcULUQ7kNvwHoo-Vi&_nc_oc=AdqimYmg4wDYv65bgqT8rWLkkCvmqiQ5H0tN9blxKZAgMMAhNPRKCzaiYUAtFSgt55E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08NJPKRbctwco3L8ZOpzph4yMIa75wI8QV9SFWI_7sIw&oe=69E0E484"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
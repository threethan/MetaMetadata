6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3L1vdCU7qkQ7kNvwFhZHMh&_nc_oc=AdrLWvWs8cJ0hAb-EBmV7x2_gzHhWMHig96Tl0hcOSWIwiczqyWgmIrmtHVscDK6OIo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ApEHVlIjAQesdgtk2vVXcNdhEcM71e6HKwmTne1tHKA&oe=6A107DB4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GVjuGOEWlgQ7kNvwGR37lf&_nc_oc=AdpuRRQ1Hhvm1jnSa5Mfp2AtNO1cfD-P9nitC5MKU06oBMFbwlBXtIjIMD-lbLAA_6M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WhiJHc_Ij-wt28JPW04ns_9fRSSbRu0RbR5DUQkeKPg&oe=6A105D8E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wbGdLdqAf8Q7kNvwF-g1qv&_nc_oc=AdqR-i5g3l2tOrs4T1HqGzxutmZ-ZNaBDj5AE_ssUOtTgkS6Q9vjUMGZcUGXMc5avBk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BxwvEL0cYAAIeD2R001MOsdz1sRMIId0xPuCjFMWrMg&oe=6A107E7E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD45OCGon8wQ7kNvwEv7-ZC&_nc_oc=Adpksb_VSMM8cxukHgm4AMvQYMtZqxwUkoJK74QGyXrVsMXEq3v5rV7VKWqlwlPf7To&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EZrjmivZ7ahf63NjFseP_-gIe8TuuwcVWRxCDzcczSw&oe=6A106B19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HMEsu_jjqMQ7kNvwHzIMzg&_nc_oc=AdpQUY9rs9OLeyIAhjh0FDAoCzge_KqdS41JGOake8ctU-Mv1bbfpxGOpAD3AaxTOgQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49ucdOYcU9cyL_0kb6Y7BN7L3GhE6ET3vufXc0F3dTfw&oe=6A105A84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
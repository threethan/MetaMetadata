6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bbnL8M3J7AQ7kNvwHHm2Qt&_nc_oc=AdqgvODSHTC7VXgGHKHmdKo1fxi-iVrmB8c2xDEB-svO0MWV4EGGpBR9XZiiC2IQ6d8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0dj1rl4Li4OGweLWUz908djrUcgKzFJs_YG8LPwQHqg&oe=69CA65F4"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-HhydcBVQkQ7kNvwF8Xn2e&_nc_oc=AdpLRKBuQvLXUq9hL-5E9tKAIOLPgSUVhCvMAs4Jye7I-WcOPxH8SXSOPDf7XSTuGyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxhw7V64nrS4GGWfgL7y05l6ZI8OkQOFxeIGD2sCH5MYg&oe=69CA7E0E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MDOHHu5LD4Q7kNvwEH_4fR&_nc_oc=AdpACyE4IVysd0rTY0Zv1rHWbmyi7oLOSHWXUZspC4zHUBPark5t6eNF_oIur_0aCNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxq2X8Jo0eFNjwmwXzi77GljoF2TJiF0z7Pl940r2Iijg&oe=69CA66BE"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUvNRRGbT2oQ7kNvwEJfbs_&_nc_oc=AdrGqfRYyCabQii8yzIwXIrDiqoCeLFEdqlQNEYgh0geK5ouF0srY_bYUdcaGyadjvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5YvVRTeFWgIPKec55RTcs-UGxXIFZfTvYYZgdAkxQyQ&oe=69CA8B99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrAlZ0UcgFgQ7kNvwFsa_IY&_nc_oc=Adrb6wIr0SA6sJJ2i7x5yafi5yLa7QsdBAZQd4Y3FgL6-xyL-4GjgK0c6jdyarN7cbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxohGZnZebSUW2vrWX4SghWlzeqj_8lVTBvB2zmISBnlA&oe=69CA7B04"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
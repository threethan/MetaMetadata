6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cP1qmOcXfYQ7kNvwHLa5lP&_nc_oc=Ado0JZoqbfWOFqI9wiIpoqxjm89S4XO8yTAl1HbfmXFgQ9ZHhxLbGbH9vSMItAEWtMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6EjRoQ3CxvqyQm13SB8JsSTX4zkuCvAgjPf7fHAXFzQ&oe=6A4CEA74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmcPxzRHflgQ7kNvwFNb9Bl&_nc_oc=AdrB9x5xZwFLT2rnIc3Q5mBxQpFPZfm87MrMYzHYkVajs3oal_emAZInodMeoCPKA6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLNvLBNHl4zLt7OFXX5hxwsc2aTc7dynpRbSmJlzeCdQ&oe=6A4D028E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1h1e5b2Mu4Q7kNvwGDbuRr&_nc_oc=AdrMjsC4gY1GQqMVWLEJjUinLoJYQb2j4pBIQuBK4pbaEhAsULfD-cYBRxm7iyypXXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFNBRV5gY073-RZWcS3VcBWlvamaQB-nWmkhYdSl0vYg&oe=6A4CEB3E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMTjfuT3sd4Q7kNvwFIuYNj&_nc_oc=AdqQno0Al_jEZwIrzp8dqIXsGa-djqJ1THHCYULcl80lzjrnDFawxTne2spHKwfS4po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSIEy9wSTJ4a8ypb7FRTCDsW2WUuU_hI7BWPgXx7FjRA&oe=6A4D1019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUPC1qHs4McQ7kNvwFJHBox&_nc_oc=Adr-1miGYvMiL2DX_88I73Lhvj7gQRoGzklIJY4_4y1R8p-6Px14osueRgsQThifJeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtyTkojKtkzB-VT8sapV6WS7lztKPr3mlPey4t0TmSIg&oe=6A4CFF84"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
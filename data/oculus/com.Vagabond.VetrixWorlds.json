6332220002_215622283749796528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCaEnRDHCH0Q7kNvwFrSp8n&_nc_oc=AdqLvVAoovuHfAYnV2bDiJc6LPypuK0jGG97REhEb09SHUkVbhnlGX1zIRHekLcc2TM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UVze1ihhhT17j5KxW1nZ1IuAWx-yz-id_20rj4tziag&oe=69EB5B74"}, {"file_name": "VW_screenshot2.png", "id": "522656790398684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_522656793732017_4468541802177820084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvBmUpNiGdEQ7kNvwFPc5zw&_nc_oc=AdrWw0c1tktrhf1-d-A1fK6fE6BAXj9WgupnAvZh4Yc2CcEb1e9h_HvCkiFWBycM8lM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JA4WHq5Uw17bx1_t7JzswHDy8pM-zKXsQo_W6eFX-MA&oe=69EB738E"}, {"file_name": "VW_screenshot8.png", "id": "527497749914837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_527497753248170_6585690017656555726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A289dfG6raIQ7kNvwFp2wrO&_nc_oc=Adq6SQpsY5M2O0XiR858d8-nCjO59Wuja3BFYWN8-JOt3gtx0JsFEaYxgx44vKq0f64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1de2nNwiD9jI7OKliIw_fdNHwe-MtM6VBWmasQuHgF2g&oe=69EB5C3E"}, {"file_name": "VW_screenshot5.png", "id": "436082769501177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75294241_436082772834510_7430555417811910088_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACqe1vf48W4Q7kNvwH7Gd-c&_nc_oc=Adqrr5HueyyHFo_WnWA54U9bgvqDeTa_7Rupo7hO92fgWdWm5jAOXjebeEsnQxyZXR4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b6oHJC1XohTWyQDVL_4kTBWaKD9yens27MNm1DKMqqg&oe=69EB8119"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_VW_StoreCover_Landscape.png", "id": "1060484878715057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974835_1060484882048390_819985010514874649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFd9ab8Z9ksQ7kNvwFn7MAu&_nc_oc=AdoCOSProZq6ve7hEyLh0KmeK4ufKQk3G4IPlkOxqaO75aeZTyeorZujLasAPqtf0Es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G948jPYAftoS1GGUnyIwOk4Mx6wG-quu3po-MPPh5Vg&oe=69EB7084"}, "display_name": "Vetrix Worlds", "keywords": [], "long_description": " Vetrix Worlds is a puzzle game inspired by Tetris but with its own original mechanics built for Virtual Reality.\nChallenge your dexterity and planning skills to Master the Art of block piling!\n\nSpecial Shape Types\nAdapt your strategy to our new shape types; the Ephemere and the Resistant.\n\nPower-Ups\nNeed a little help? We got you covered with our brand new Power-Ups; the Trash, and the Holder!\n\nCo-op Multiplayer\nShare a puzzle with a friend! Double the fun, but double the challenge!\n\nCompetitive Multiplayer\nWhen it's time to show your skills!\n\nCampaign mode\nBecome the Vetrix Worlds champion by completing many challenges all across the world!\n\nFour Arcade modes\nTime Attack - Reach the target score as fast as possible.\nHigh Score - Reach the highest score possible in 5 minutes.\nSurvival mode - Play as long as you can.\nFree mode \u2013 No time constraints, just relax and enjoy the ride.\n\nOnline Leaderboards\nYour friends should know who's the best!", "short_description": "The critically acclaimed Tetris-inspired VR Puzzle game is back with a feature-packed sequel!\nEnjoy the game alone with our Arcade and Campaign modes, or get social with our all-new Co-op and Competitive Multiplayer Online modes.\nTime to scratch that OCD itch of yours!"}]}, "developer_name": "Vagabond", "developer_privacy_policy_url": "https://vagabond.games/PrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://vagabond.games/", "website_url": "https://vagabond.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_typ
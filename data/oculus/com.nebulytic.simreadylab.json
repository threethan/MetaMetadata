tivity", "forces"], "long_description": "Bring a library of NVIDIA SimReady objects into your space. Browse tools, equipment and everyday objects, inspect their geometry and switch between visual styles such as real colour, wireframe, exploded view and X-ray.\n\nUse the physics sandbox to place, move and experiment with objects. Explore supported hinges, wheels and sliding parts where joint information is available. Performance and interactions vary with the complexity of the model.\n\nThe library uses NVIDIA SimReady assets under CC BY 4.0. This independent experience is presented by Nebulytic.", "short_description": "Explore thousands of SimReady objects in mixed reality. Inspect their parts, change visual styles and experiment with physics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/object-lab/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/object-lab/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/object-lab/support.html", "website_url": "https://nebulytic.com/apps/object-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1403638849498801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_2352453481826120_490203939894232622_n.png?stp=dst
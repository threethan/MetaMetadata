.png", "id": "2185411199067401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_2185411202400734_6542512215873545608_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9W94IB60nN4Q7kNvwFfb-2n&_nc_oc=AdqUCA5Q8qrk2AILqlf6rDQMUViiiRGybMmHGZkPKBzjGeE1lyEEUWHjm3bAaWdVY4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrBTGu69571SUwQRfiQzUoGPLNEK-SCd7DDr5vWJXP9w&oe=6B0C64B8"}, {"file_name": "store-1-real-colour.png", "id": "2312726939651890", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_2312726942985223_3330475045304033029_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em7MyhsTAjcQ7kNvwFeP1lZ&_nc_oc=AdpqDnhfAtu-SENMB80_y5JgLOLQF7PhAsMpgMQ1E9jRHfMP60P5iK9LSNaNAzUrs64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQihyJTGj8egpi8Z_hHlVdbJYNxL-nOH8B33l1x2RlFow&oe=6B0C6FD6"}, {"file_name": "store-4-xray.png", "id": "1123171596768426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1123171600101759_1436358621187677422_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fv4xhl9d4oQ7kNvwGJw4eC&_nc_oc=AdpVS1cu5ROkJfLbAUdrdbdoVM3jSNT9shfF8pa4X6H1CQDfLvmWBYCIFiHhjVxvUwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5iDNYfS5Ovzsdff8UyI6j7sAth5YZaFW3eQczLpwjSg&oe=6B0C666A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2194811094444757", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_2194811104444756_6519112008425769586_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrNmclLc-cEQ7kNvwFMUnkT&_nc_oc=AdqespB9prd-S06oG8oL8gn8DPQZ_hRS6DU2bcKdj9RhsC8XBulATvaowN1JOgpNGZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrza0iwIzb3Me5oebvDB96VPa9B0_b4s-glkYGhOjWhg&oe=6B0C7DD8"}, "display_name": "ObjectLab", "keywords": ["simulation", "physics", "objects", "interactivity", "forces"], "long_description": "Bring a library of NVIDIA SimReady objects into your space. Browse tools, equipment and everyday objects, inspect their geometry and switch between visual styles such as real colour, wireframe, exploded view and X-ray.\n\nUse the physics sandbox to place, move and experiment with objects. Explore supported hinges, wheels and sliding parts where joint information is available. Performance and interactions vary with the complexity of the model.\n\nThe library uses NVIDIA SimReady assets under CC BY 4.0. This independent experience is presented by Nebulytic.", "short_description": "Explore thousands of SimReady objects in mixed reality. Inspect their parts, change visual styles and experiment with physics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/object-lab/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/object-lab/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/object-lab/support.html", "website_url": "https://nebulytic.com/apps/object-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1403638849498801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_2352453481826120_490203939894232622_n.png?stp=dst
f20f&oh=00_AQRaS3_WcCcdqbh2NlhAD03OEfrd-PuCWqopPOC95n5Wmg&oe=6AF89E38"}, {"file_name": "store-1-real-colour.png", "id": "2312726939651890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_2312726942985223_3330475045304033029_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrpAi8VQ_bYQ7kNvwHx8OPF&_nc_oc=Adr2mZInzAkiZ2rVtf4HpHERjDv858OFGK1XjWfrQvJ3HM3XlY1c2FhiepwBsMvmcAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCGzpdznAzh44wf6LsqTHIaR2-ttrHZ8-pxhNZBGL1vQ&oe=6AF8A956"}, {"file_name": "store-4-xray.png", "id": "1123171596768426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1123171600101759_1436358621187677422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUTz60red3IQ7kNvwEPr0E_&_nc_oc=AdrO_2JZtAXrIFron_Vjd_dOgpYBO4u6ad6BibVmPqbM_zQBDDtKGHtgeHIobYfebww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNoVe_R7NU-b4l8wJjhKkVaGmxf3NGe6JNeIFW_8Whdw&oe=6AF89FEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2194811094444757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2194811104444756_6519112008425769586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwSqAAsmjt0Q7kNvwFPDuYb&_nc_oc=Adra_2ZAxAnEK6V-OMlBOHmqKUwqWub-Pvdx4BrzJuOi-Ry5KjV3yhDBSHuXPM8ruq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQppaUhkhANZ1q-XQP9XgAx8RtVTl76IMxLaR_4icZp0Q&oe=6AF87F18"}, "display_name": "ObjectLab", "keywords": ["simulation", "physics", "objects", "interactivity", "forces"], "long_description": "Bring a library of NVIDIA SimReady objects into your space. Browse tools, equipment and everyday objects, inspect their geometry and switch between visual styles such as real colour, wireframe, exploded view and X-ray.\n\nUse the physics sandbox to place, move and experiment with objects. Explore supported hinges, wheels and sliding parts where joint information is available. Performance and interactions vary with the complexity of the model.\n\nThe library uses NVIDIA SimReady assets under CC BY 4.0. This independent experience is presented by Nebulytic.", "short_description": "Explore thousands of SimReady objects in mixed reality. Inspect their parts, change visual styles and experiment with physics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/object-lab/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/object-lab/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/object-lab/support.html", "website_url": "https://nebulytic.com/apps/object-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1403638849498801"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1124393063502971"}]}, "baseline_offer": {"id": "1124393063502971"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793392380, "status": "PUBLISHED", "id": "1124393063502971"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1428748746987811", "version": "1.0.20"}, "id": "2416214928916043", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1403638822832137", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1428748746987811"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2416214928916043"}]}, "change_log": "\u201c+ Add .glb\u201d file picker.\r\n\u201cAll real\u201d and \u201cAll fit\u201d buttons.\r\nHollow cups and mugs.\r\nAn own-colour hologram look.\r\nBetter grabbing.", "created_date": 1794090113, "id": "1428748746987811", "version": "1.0.20", "version_code": 120, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 4}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1403638822832137", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1428748746987811"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2416214928916043"}]}, "change_log": "ObjectLab 1.0.18\n\nFIXED\n- One press no longer adds two copies of an object.\n- Exploded view: Push together puts every part back in its own place. Parts you took out return with the first press, and at 0 % the object is exactly as it was, even after physics moved its parts.\n- Objects open up by a similar distance in the exploded view.\n- The full model library (4.4 GB) now installs with the app.\n\nCHANGED\n- For Quest 3 and Quest 3S.\n\nSTILL HERE\n- Take parts out of the exploded view by hand, Tracer trails, menus that tilt to face you.\n\nModels: SimReady Assets, CC BY 4.0, modified. Not endorsed by NVIDIA.", "created_date": 1793493185, "id": "1410803802115639", "version": "1.0.18", "version_code": 118, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results
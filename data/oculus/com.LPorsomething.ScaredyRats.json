dP8G7MQQ7kNvwFSNSUI&_nc_oc=AdqcnHkGQj376xnn1Xzv52ci-pWVg9HeLcqS6HCYJBmlOGLarAqE9ygxeo6AZi7f1lU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mvvfT59U4lfa10cloUGe9gTkumtxI74A2q7LXbmCnXA&oe=69F1EF14"}, {"file_name": "SampleScene_Custom..._30.11.2024_10-49-22.png", "id": "933279048737573", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982690_933279052070906_7458100200349665052_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntr3TwaliEcQ7kNvwEEIiyw&_nc_oc=AdrjfVJmPOS7L1tq38O6nLG7TgAYZQCc0sXiqFrX31VBN57M2ld2fDDvNs0Qu2b-Msw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2-ndsnj9lSgvVk8RR8XZ0R8RiVERJrPBF7O64k6knERg&oe=69F1F6B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "untitled.png", "id": "1266738567695372", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294245_1266738571028705_2700037078267694013_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRaM72y4YFoQ7kNvwH84doU&_nc_oc=Adqj7Ikit9m_msnX73fiHezxUQqsXqO74lUp3m0rgFHiGaoa-75DjM-jAtX5QW6RAsI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1_lMEgBgUQkNFiC-4hHD0-8FsI42GBgueRbgdHneOogA&oe=69F1F924"}, "display_name": "Scaredy Rat", "keywords": ["Horror", "Puzzle", "Rat", "Game", "Scary"], "long_description": "The rats have dug a hole in the ground in search of riches, but they find something much more peculiar.\n\nStand in the face of death and explore these frightful cave systems crafted to bring out the strongest fears among the rats. Move forward in the zones by solving puzzles that have stumped the rats for centuries.\n\nLegend says every rat that goes into the pit never comes out.\nWill you break the cycle and conquer the caves?\n\nfind out", "short_description": "The rats have dug a hole in the ground in search of riches, but they find something much more peculiar.\n\nExplore many dark corridors and luminous cave systems, and solve the puzzles to become a survivor. Many creatures will try to stop you, and because of them, you are really never safe in the caves.\n\nTest your fear, and make it out alive.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scaredyrat/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LPorsomething", "support_website_url": null, "website_url": "https://sites.google.com/view/scaredyrat/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8995807467117653"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "889272296627665"}]}, "baseline_offer": {"id": "889272296627665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733693820, "status": "PUBLISHED", "id": "889272296627665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26425062437098886", "version": "3.3"}, "id": "1524310668280038", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8957228857642181", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26425062437098886"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", 
content-atl3-1.oculuscdn.com/v/t64.5771-25/75240098_818952763677292_337638963599190306_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoFtnkgYZi4Q7kNvwEXYSLO&_nc_oc=Adq3BAgwGVphy880I43DCHjdRKYVPGodaF0HoqlZmHNOTzZW8RdfmpYBaGOJurg9DhE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ElYRD68nBKLZQsSXj_Q4_oRXDVHgIxUqNVFIYMNndOA&oe=69F1F6F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (2).png", "id": "1300838367963911", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974838_1300838371297244_1125909428722011491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_NfuyWSiWoQ7kNvwGHmKbx&_nc_oc=AdreYEjREhYPrRN75ipma7rOExmj5ImV25uKGIhL3IwD4YdO0-V6T3UcHMm8xgY18W0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af26BHjoMfXvGPv_kJG5GyUmNl2EQbd2u3ASd4c0N35yKw&oe=69F208CA"}, "display_name": "Interaction World Cube", "keywords": [], "long_description": "Cube control: Players can grab, move, rotate, and arrange cube blocks in 3D space, creating countless creative possibilities.\nFree movement: Explore the virtual world by moving freely in space, allowing players to approach every angle of the environment.\nDiverse worlds: Each world in the application has its own theme and challenges, ranging from simple to complex environments.\nEnvironmental interaction: Cube blocks can interact with elements in the environment, creating interesting effects and outcomes.\nIn-app purchases (IAP): Players can unlock additional new worlds through the in-app purchase system, expanding their gaming experience and exploration.\nVivid graphics: Sharp 3D images and bright colors create an engaging and vibrant VR world.", "short_description": "Interaction World Cube is an innovative and interactive virtual reality (VR) application designed to provide a unique experience for VR headset users. In this virtual world, players explore and interact with the environment by controlling various cube blocks."}]}, "developer_name": null, "develope
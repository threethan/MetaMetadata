-2.oculuscdn.com/v/t64.5771-25/39036671_3561205507252853_3641049664666468352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gms659pGAugQ7kNvwFXa_xx&_nc_oc=Adm2g5lvWeixoy4bFm789QvQ1i1AIjnvvBNIKhyejneLLc5z0xspf1AgrhyQuApiwGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvzKusR4LQtTOFr70KssRXHS7PuFcTnIxmlzVOaf1u8Fg&oe=69A02D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/hoi3NY", "id": "199802628087036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974694_199802631420369_6579195177921937408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5pZtdQ_ne0Q7kNvwF1Hm2d&_nc_oc=AdnHhGVSAXaG9AvPVqAzkVT8-_meJdJx4Evfdzna9FfZPnHOkKIJZF0K0VB6Bsa-fY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWt8nG2vgF5rB4Ek-EB-ydsQGpRDtYOWdzbg4Ad0rlnA&oe=69A02D66"}, "display_name": "Rising Evil ULTIMATE", "keywords": ["rising", "evil", "horror", "game", "escape"], "long_description": "ATTENTION: If you have any heart or epilepsy problems do not play this evil game!\nYou woke up in a room, alone, beat your nightmares and try to find a way out. \nBut be warned, something is watching you... \nIt features amazing 3D high end graphics and a stunning haunted horror atmosphere. \nRealistic 3D spatial sound will provide the ultimate thrilling experience. \n\nNew Features coming soon! (Tell us what you would like to play, we love feedback) \nPlease vote for our app so that we will be adding more VR apps. If you are experiencing any bugs feel free to contact us, we're still learning.", "short_description": "You woke up in a room, alone, beat your nightmares and try to find a way out. But be warned, something is watching you..."}]}, "developer_name": "Tom F\u00f6rster", "developer_privacy_policy_url": "http://www.forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom F\u00f6rster", "support_website_url": null, "website_url": "http://www.forstech.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FE
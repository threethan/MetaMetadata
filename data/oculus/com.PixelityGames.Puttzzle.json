944_665571028464795_3967012109877024291_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44zuoGothUQQ7kNvwESZTnL&_nc_oc=Adqj4-VeuN5YVo7taKWoDDbmx9Jt3_rR_TGdAmd9cjgYtiqe-ZRDW9-LYdscUFEFHAo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQySGIPupYyxfv5XdxRDvMinJDl7oWXat_zu-OrQRgwfQ&oe=6AFC752A"}, "display_name": "PUTTZZLE", "keywords": [], "long_description": "You have only one objective in this game:  Putt your ball into the hole. \nIn order to do so, you will be given two items in this game: a hammer and a heavy ball.\n\nJust putt the ball into the hole to complete each stage. \n-Try to avoid various terrain and obstacles.\n-Try using any method to complete the stage with the number of given opportunities.\n \n[Intuitive controls]\nPUTTZZLE is simple. Just putt the ball into the hole by any means. \n\n[Entertainment from simplicity]\nJust focus on putting the ball into the target.\nCalculate the number of cases to solve each stage. \n\n[Increasing difficulty level]\n[PUTTZLE] is like a puzzle. You will experience more complicated stages as you finish each stage with even more obstacles. \nYou can even utilize obstacles or avoid them to finish the stage.", "short_description": "PUTT YOUR BALL IN IT! "}]}, "developer_name": "Pixelity Gamelab", "developer_privacy_policy_url": "https://pixelitygames.com/privacy-policy/?lang=en", "developer_terms_of_service_url": "https://pixelitygames.com/terms-of-service/", "publisher_name": "Pixelity Games Inc.", "support_website_url": null, "website_url": "https://pixelitygames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "r
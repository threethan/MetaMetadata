iyUyXQjgzI2_xSqgOYxOwRFY1oxWzEAsEwlWBypRbLWJndzGZXwbJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlcEf3sICEeevWmwKBgXDjgVDFeue9KYNY0repG5A1zw&oe=6AB3C400"}, {"file_name": "OUTBLAST_5_13_40_23.png", "id": "1668966380896325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1668966384229658_7536260462442191103_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWO8GW-xUfIQ7kNvwFkbUoo&_nc_oc=AdoZLiPN1w5BJNt9uMkFcjvh3ZiZ7_wbvRR5yCqkx-Z1qA13IZVgc3ReaKxeNy3i_j4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxLbaOPyG5ntKPfjToq9MJXytu-ZCQt7MU5lRzOMwaEw&oe=6AB3CC0E"}, {"file_name": "OUTBLAST_5_13_43_19.png", "id": "980629004772351", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828050_980629008105684_375090742298649022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AhOkyxm460Q7kNvwH_nb4x&_nc_oc=AdpWdB0hNYqzOTINEKrBI1KSPS1yOxvj6rFG0gBLlB27BBFbQPLQv9vwkasU5KMxiFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3JVskCMkdCeR_JafUP8BvLbexRGegPYYK9gyzuKLU2w&oe=6AB3D4EF"}, {"file_name": "OUTBLAST_5_13_55_1.png", "id": "948597881287300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819859_948597884620633_1958079223181317642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb5_6cX2dysQ7kNvwEcvDBv&_nc_oc=AdrWQNoaIMRzCQe8vvH5FX-AvIK9IUg5ZnV-5XwvB-pGxMBHlUqzHsOSuAhzIEcZkNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJrvBudijX6aMQzPeU5Sg_7AM8Fds1dsRK-jyCPI3fJA&oe=6AB3C84E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2210019683121602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_2210019686454935_1208404979445072694_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oG3slUidCsQ7kNvwGhPncq&_nc_oc=AdqprCDxDivKbiXvLahGmHYEim8Rx-NFfmEpuyY16RhtPMp4QyrM2IhYYUpCusOwMnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkoz3XX6-BWLjl-vSt00j0CPKwzxLWG8OaqFmC_Nor1Q&oe=6AB3EADD"}, "display_name": "OUTBLAST", "keywords": ["Arcade", "Shooter", "scifi", "cyberpunk", "BulletHell"], "long_description": "- \"A fun and challenging throwback to the arcade shooters of old.\" - UploadVR\n- \"Reinvents the classic shoot 'em up for virtual reality.\" - NGP Noticias\n- \"A fast and competitive arcade action experience.\" - OneDigital\n\n{985083301075524}\n\n**Blast, bomb and boost,** through a neon cyber warzone in this fast-paced VR arcade shooter. **Destroy** infected constructs, **collect** data particles, **defeat** colossal bosses and **purge** the system before total collapse.\n\n{1675052323617295}\n\nA rogue AI known as Typhon is corrupting the planetary Core. As **Interceptor C11-28**, you're humanity's last defence.\n\n**Easy to learn. Impossible to master.**\n\n{1021461550321098}\n\n# FIVE DISTRICTS. FIVE EPIC BOSSES.\nBattle through **five unique districts**, each ending in a colossal multi-stage boss fight, culminating in the final showdown with Typhon.\n\n# FEATURES\n\n- **Fast-paced** VR arcade combat\n- Five unique districts and **epic boss encounters**\n- **Upgrade** your weapons, boosts and special abilities\n- **Global** online leaderboards\n- Varied enemy waves for **endless replayability**\n- **Easy to pick up**, difficult to master\n- **Designed exclusively** for virtual reality\n\n{1510865547082885}\n\n# GLOBAL LEADERBOARDS\nCompete worldwide, improve every run and climb the rankings.\n\nPerfect for fans of arcade shooters, bullet hell, SHMUPs, space shooters, boss battles and high-score leaderboard chasing.\n\n{1556649555889933} \n\nA portion of Rhino Rock Studios' profits funds conservation projects worldwide, so every run helps real-world change.", "short_description": "A rogue virus called Typhon is consuming Perseon-6. As Interceptor C11-28, boost, blast and bomb through five corrupted districts, defeat colossal bosses, collect upgrades and purge the Core before it's too late. Climb the global leaderboards in this fast, frantic VR arcade shooter. Easy to learn. Impossible to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rhinorockstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rhino Rock Studios", "support_website_url": null, "website_url": "https://www.rhinorockstudios.com/outblast", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27455593584072607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_1854527281892133_7656340511042141603_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0pHMWPZWGIQ7kNvwHnCHoA&_nc_oc=Ado4xZ6EzQhn39nOa8DltmXLfDxEveSDUjbghEgDixYCLGtSJoAxvWgPGk4X504xk1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCX8OGQ5RJkH3EGEqzWSuzyWAeay0k228SnVRpZdC4jQ&oe=6AB3E0FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OUTBLAST", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1781793000, "lastRevision": {"nodes": [{"id": "2643051413
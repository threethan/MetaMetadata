rasdsfi3zPbKERUTuRYkJ-TJwWeNVJaZ1C0ahvEuYTb4XxZUFtoyZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4p2QImB19bF0Gy69zJOI82k1Ft-KTlvnsYXEWDQ9gFQ&oe=6AF0A140"}, {"file_name": "OUTBLAST_5_13_40_23.png", "id": "1668966380896325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819281_1668966384229658_7536260462442191103_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_SH59GfDIcQ7kNvwHxxhqd&_nc_oc=AdrkmB6VNCQRIWyJavzjgBtt0RQqK4OcNqExJzCc3jbvKnn_zoLiYWjphf_gvDIDoHM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtEDvnM4WdexKlBJDZTln9I2zDjo1C7bRRX80w2vrQfA&oe=6AF0A94E"}, {"file_name": "OUTBLAST_5_13_43_19.png", "id": "980629004772351", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828050_980629008105684_375090742298649022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i232kTUo6gMQ7kNvwFsfAuq&_nc_oc=AdpLIaxI0ePgz94EuBtJLjc5DPlnI6AD-vUE3t5WICaAedEBJ6hdlYu0ntI8b0FNbP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnWRE0hl1OoCL-2UjezweIDQqsl5evqi8beOo_h8dL5w&oe=6AF0B22F"}, {"file_name": "OUTBLAST_5_13_55_1.png", "id": "948597881287300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_948597884620633_1958079223181317642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHD3QxgjTJ8Q7kNvwG9npm_&_nc_oc=AdpiJcWUjexX02w2yBfolA3ILTWEiDDIuDz6d7h5xW9DobM_ASVhN0jAPe6OrEPGUjg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRCtuS79Dtyl0mERpzYHc8RjykitfsA7AM0MRdyhLIkg&oe=6AF0A58E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2210019683121602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_2210019686454935_1208404979445072694_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHIVZi08F5sQ7kNvwHGuZeE&_nc_oc=AdqDkbVEIcuxZSQKu-gO0m7fz4oPml2K3ynylQSvDRUrQHkuaDI5PbgGhVbsL0bmy00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSck-siSqCrpwaa-mYqb7q1-kv0hZOR3txAEYC-yIL1tA&oe=6AF08FDD"}, "display_name": "OUTBLAST", "keywords": ["shmup", "twinstick", "retro", "leaderboard", "bullethell"], "long_description": "**\ud83d\udd25 NEW IN 1.5: INFINITE MODE**\n\nRace the clock against ever-angrier waves. Kill fast to survive and climb a new leaderboard. Plus a redesigned ship and refreshed visuals.\n\n- \"A fun and challenging throwback to the arcade shooters of old.\" - UploadVR\n- \"Reinvents the classic shoot 'em up for virtual reality.\" - NGP Noticias\n- \"A fast and competitive arcade action experience.\" - OneDigital\n\n{985083301075524}\n\n**Blast, bomb and boost** through a neon warzone in this **twin-stick arcade shmup** built for VR. Destroy infected constructs, defeat colossal bosses and purge the system before total collapse.\n\n{1675052323617295}\nRogue AI Typhon is corrupting the Core. As **Interceptor C11-28**, you're humanity's last defence.\n\n{1021461550321098}\n\n# FIVE DISTRICTS. FIVE BOSSES.\nFight through five districts, each ending in a multi-stage boss battle, building to the final showdown with Typhon.\n\n# FEATURES\n\n- 360\u00b0 VR arcade combat\n- **NEW:** Infinite Mode\n- Upgrade weapons, boosts and abilities\n- Arcade Mode and Stage Select\n- Global leaderboards\n- Seated twin-stick controls\n\n{1510865547082885}\n# GLOBAL LEADERBOARDS\nClimb the global rankings across every mode and district. Perfect for fans of shmups, bullet hell and high-score chasing.\n\nPerfect for fans of **arcade shooters**, **bullet hell**, **shmups**, **twin-stick shooters**, **space shooters**, **boss battles** and high-score chasing.\n{1556649555889933} \nA portion of Rhino Rock Studios' profits funds conservation worldwide, so every run helps real-world change.", "short_description": "Twin-stick arcade shmup built for VR. Boost, blast and bomb through 360\u00b0 neon battlefields, take down five mythological titans (Hydra, Gorgon, Minotaur, Siren and Typhon), upgrade your ship and fight for the top of the global leaderboards. Play seated, pick it up in seconds, then chase the perfect run."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rhinorockstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rhino Rock Studios", "support_website_url": null, "website_url": "https://www.rhinorockstudios.com/outblast", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28921392017492749"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_1854527281892133_7656340511042141603_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbto7IkggBwQ7kNvwEBzJ8q&_nc_oc=Adqoby_2uNk9uUBvyvKkRuYPXt-bdB16i6H0KQoK-K26378PMIGG-uwd8EUuY0QYclo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaXWuP6dT60p21D7iMC7hEUeS3gCQlECX4zDcVM8ishw&oe=6AF085FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OUTBLAST", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1781793000, "lastRevision": {"nodes": [{"id": "26430514133247229", "rele
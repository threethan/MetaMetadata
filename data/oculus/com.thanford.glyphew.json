1-7&_nc_sid=6e7a0a&_nc_ohc=nNNDT3l8FOUQ7kNvwFvJLKa&_nc_oc=Adr7kaIwMvhKNYOEWNH7xDV5ln4QDd3x06kWsWzEfDnFdBBZeb5Q7Kj2d7FIZpg43Zk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMflbLEP5filGqrsFd9xJJz8iVNncPqblBqP3oUjsu9ug&oe=6AE6079B"}, {"file_name": "screenshot-05-homepage-catalog.png", "id": "2101019383808989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622334_2101019387142322_92877652893472671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX-nFSC3lnsQ7kNvwHgG_rT&_nc_oc=AdpxSuVomX7laIqVTdeP-VsEjDbbILoIGkE0B8yEw6yDWkoZYVPSPAgVt4USJN0yW7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaSjxyKtfx3q1lthnbsc5ujgFS_kW0_GWiRUMB_-PgnQ&oe=6AE60E71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1560758342377182", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_1560758345710515_8451592374464357551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5_kcJAbqOwQ7kNvwHm6zHy&_nc_oc=Adq7o7BYf7TLAJMmnjB7TMhM9CcwncM1PCB4Tc8rYWWRDqXfNCF7blT9o6jdIX1ED-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgBTQE_mVMDutq0Y_C3sCR6i4sXHP1g-ByfVJQIPM9qg&oe=6AE5FE05"}, "display_name": "Glyphew", "keywords": ["browser", "vr", "combo", "video", "utility"], "long_description": "**Pointing at the web in VR is exhausting.** Raise your arm, aim a ray, hold it steady, click \u2014 over and over, for every link, tab, and button. Glyphew\n  throws that out.\n\n  Glyphew is a VR browser built around **combo gestures** instead of pointer-aiming. Hold grip to arm a combo, flick the joystick along a short path, release\n  to fire. Go back, open a tab, close a tab, jump to the URL bar, cycle tabs \u2014 each is a quick flick you can do with your hands resting in your lap. No ray.\n  No arm fatigue. No fighting a trembling laser pointer.\n\n  ---\n  \n  **A real browser underneath**\n  Tabs, bookmarks, scrolling, history, and a clean home screen of your favorite sites.\n\n  **VR video \u2014 zero setup**\n  Point Glyphew at a 360, 180/VR180, fisheye, or stereo clip and it auto-detects the format and drops you straight into the immersive view. No menus to dig\n  through.\n\n  **Made to fit your hands**\n  Every combo is rebindable, so the gestures become muscle memory that fits *you*. Both controllers work \u2014 combos fire from either side.\n\n  ---\n\n  If you live in VR \u2014 Workrooms, desktop replacement, daily headset use \u2014 and the browser is your bottleneck, Glyphew is built for you.\n\n  **Smooth like combos.**\n", "short_description": "Browse at the speed of thought. Glyphew replaces VR pointer-aiming with grip+joystick combo gestures \u2014 flick a path, fire the action. Tabs, bookmarks, scrolling, VR video (360/180/fisheye auto-detect), all without raising your arm. Smooth like combos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thanford.com/privacy", "developer_terms_of_service_url": "https://thanford.com/terms", "publisher_name": "Thanford", "support_website_url": null, "website_url": "https://thanford.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1250331118155880"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1400521705247330_8697920400477399207_
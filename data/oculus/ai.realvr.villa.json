": "en_US", "screenshots": [{"file_name": "screenshot_1_2560x1440.png", "id": "411062497041353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035305_411062500374686_8919495457939342552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpdL6NnLkM0Q7kNvwFfGcWR&_nc_oc=AdpMAnR-BzduayJ7GzCKGSS0n7LA7HHZ2Su2xOcKkXinHBiPMzNACYTuoBucEDx7imo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3M6yoOB-loAfZCPlzctikvkDmD7tSRpLKEFtit6wO9uQ&oe=69F0AEAC"}, {"file_name": "screenshot_2_2560x1440.png", "id": "2542652509371965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569425_2542652512705298_8406153352649699415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyKMbiaWhgcQ7kNvwGCH9f2&_nc_oc=Adp0_03BskbZ3ZU3ix49c1J3hxe2hasn1_mZxvfQ7SYLmJyC9iKooT7uSPMnfqZ9fxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1DPO6kNcMMLnf5Bn85_MkoHjrxFKYrSDjOQbajnFXfsA&oe=69F0C984"}, {"file_name": "screenshot_3_2560x1440.png", "id": "837285150334022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031391_837285153667355_5583694166526638160_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gXG5P9GYHgQ7kNvwHhU79D&_nc_oc=Adp24fVVyx_0fG4u0dJRVaU4zrwMKynN2fPTiR_aJL-WQUjKAEQ_mVN7_rcX5boPzlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0xjZ5Qu4_3NW4r2_ezH3jxmjMJ9-b6l2vMouQP2Lwpjw&oe=69F0A983"}, {"file_name": "screenshot_4_2560x1440.png", "id": "493746818307559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974557_493746821640892_1812030317833676803_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3vuiNVfxVEQ7kNvwHSBg1w&_nc_oc=Ado1JrBgKSZ5lzM7xoBer6IJKQL1tH2RohD4_LZ3gvB280-UZJK8LuJqRGP8mx3WFCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3GG4hJnCUwgN2g1lK2Mr6lumPuYhlCk4Y3u_XHr0YEKg&oe=69F0A935"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1114552522343560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1114552525676893_1677870913491985454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avmj2VNh6zMQ7kNvwG1q59W&_nc_oc=AdpB-6bqZzxl8-9mosjgGwSlnFMnM0gkDp_ZrnVCPWPgp3TDGGgvIL3PTAQwS2vdnKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1YX7C69v28SLEsZAYgwLzR0fMrATcz5N8bwt1-6A8hHA&oe=69F0A8C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "be a superhuman cover image.png", "id": "942148429692825", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974499_942148433026158_7347930193473508401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmqmCBBqxOIQ7kNvwEJ2vc-&_nc_oc=AdrhZHlU30q3Ey007CsN7iU0QY6ujOezMIWGbOLnmQ3JUIcLZh9tntQ7Jfy32VpzlI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2A7F5LRSPc7P5Oxikg2C9jph7bJKeusX1aJ6CCshE5Ew&oe=69F0B954"}, "display_name": "Villa", "keywords": ["among", "team", "fly", "social", "design"], "long_description": "* Standups, roadmapping, happy hours, board meetings, design, 1:1s, and offsites that are out of this world and far better than IRL\n* A creativity platform, much like Zoom + Slack in 3D. Our focus is teams, giving tech professionals superpowers to be their best\n* The answer to \u2018videoconference fatigue\u2019 by putting you in thrilling immersive meeting experiences, giving you the tools to interact, co-invent and play\n* A meeting in VR is multiples more effective than IRL meetings with massive screens, and activities that defy physics like drawing in the air\n* Launched with multiple locations around the world. At the heart of each such micro-universe is your Villa, always the same, and always unique as you personalize it to reflect your team and org\u2019s personality and identity\n* Boost in culture, the glue that holds everyone to a common mission which is tricky in remote\n* Improved camaraderie and positive workplace feelings\n* Big CapEx and OpEx savings to your company relative to IRL meetings", "short_description": "Villa is a VR platform for team collaboration in thrilling immersive environments. For teams of up to 15 simultaneous members per villa. Villas interconnect (feature coming soon) for company wide simultaneous users, giving every team in an organization, from engineering, through product, finance, sales, marketing, partnerships C-Suite and Board professionals, a common space in VR. Come experience standups, strategy, design, roadmapping, 1:1s, offsites and board meetings that are better than IRL!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.villa.rocks/privacy", "developer_terms_of_service_url": "https://app.villa.rocks/terms", "publisher_name": "RealVR", "support_website_url": "https://www.villa.rocks/contact", "website_url": "https://www.villa.rocks/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "670597184250795"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1259603639140355"}, {"status": "PUBLISHED", "id": "984029689011022"}, {"status": "PUBLISHED", "id": "827626048717582"}, {"status": "PUBLISHED", "id": "788089972496130"}]}, "baseline_offer": {"id": "1259603639140355"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751481720, "status": "PUBLISHED", "id": "1259603639140355"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32720960170852559", "version": "1.9.0"}, "id": "81404557938795
": "en_US", "screenshots": [{"file_name": "screenshot_1_2560x1440.png", "id": "411062497041353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035305_411062500374686_8919495457939342552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fusl3fUKYswQ7kNvwG1zCdh&_nc_oc=AdkhwC1mTprcarogDOw3ZqqXcU0MPib1MfEh1AmometsfTAlytYfgzj71ZKpYbRO370&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfspZA9rVQ0zBrsSf2v0x_aiexqkbRTMQzsxehmFgzSbQg&oe=69A5892C"}, {"file_name": "screenshot_2_2560x1440.png", "id": "2542652509371965", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569425_2542652512705298_8406153352649699415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFbm79pcEMoQ7kNvwHG1WOL&_nc_oc=AdkTgHDwhNV-7pqeZJLGIu6o3wPewx_7OIViMu9eka7zpGQBeww0n9rlajwOC5lVd20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft3qsPjFah8uolYzjp-VIXVILDuj80BAsAK1vbJhEjMWQ&oe=69A56BC4"}, {"file_name": "screenshot_3_2560x1440.png", "id": "837285150334022", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031391_837285153667355_5583694166526638160_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTGir98y9QkQ7kNvwE-7bt_&_nc_oc=Adnbn2W3iOfyKtiXfkDfcSQ5H43i-QQ1j8bCUpFwGEWjEq6rXHC1ACta1H7-So11iEo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfttHBpVteyYKmOv-0iv8jaxYVaxDiLeKeCa-TqkX_XevA&oe=69A58403"}, {"file_name": "screenshot_4_2560x1440.png", "id": "493746818307559", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_493746821640892_1812030317833676803_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EogVimVD40oQ7kNvwEWzFNQ&_nc_oc=AdleVKo1uiCymISA0N1Z69rT5hAKLsKErhvmIcatyv_gt56cqum5iQl-i67mbYnmGSQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftfrRw9fEtvFdGP3Z57ETvpraS-7Y7-OaPj7xlpM-hBIQ&oe=69A583B5"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1114552522343560", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974453_1114552525676893_1677870913491985454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqcAWeBK3X8Q7kNvwGUhBtl&_nc_oc=AdlqlkeKxqdYPlAlVjc-YBGbhkqdrUmiYj10OAdXUYmOMRcJtzsY_caGDR8w8nM8vxE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftyJhUpCIClVVhz3P6FCQsy8yYzP_lN_FuR_y-rYmNdIQ&oe=69A58347"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "be a superhuman cover image.png", "id": "942148429692825", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974499_942148433026158_7347930193473508401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujVL8becsdEQ7kNvwE9D3BF&_nc_oc=Adkm7Xd2Vj-HOkNuh7WI33oy9LB7kvsave2Pf_2gLtZ0jqNHO3tLJiznAILuUR8olx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuCBgqk9RtBvAajzcfrJz5IF_DkVCJ212crKfMP_iP5QQ&oe=69A593D4"}, "display_name": "Villa", "keywords": ["among", "team", "fly", "social", "design"], "long_description": "* Standups, roadmapping, happy hours, board meetings, design, 1:1s, and offsites that are out of this world and far better than IRL\n* A creativity platform, much like Zoom + Slack in 3D. Our focus is teams, giving tech professionals superpowers to be their best\n* The answer to \u2018videoconference fatigue\u2019 by putting you in thrilling immersive meeting experiences, giving you the tools to interact, co-invent and play\n* A meeting in VR is multiples more effective than IRL meetings with massive screens, and activities that defy physics like drawing in the air\n* Launched with multiple locations around the world. At the heart of each such micro-universe is your Villa, always the same, and always unique as you personalize it to reflect your team and org\u2019s personality and identity\n* Boost in culture, the glue that holds everyone to a common mission which is tricky in remote\n* Improved camaraderie and positive workplace feelings\n* Big CapEx and OpEx savings to your company relative to IRL meetings", "short_description": "Villa is a VR platform for team collaboration in thrilling immersive environments. For teams of up to 15 simultaneous members per villa. Villas interconnect (feature coming soon) for company wide simultaneous users, giving every team in an organization, from engineering, through product, finance, sales, marketing, partnerships C-Suite and Board professionals, a common space in VR. Come experience standups, strategy, design, roadmapping, 1:1s, offsites and board meetings that are better than IRL!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.villa.rocks/privacy", "developer_terms_of_service_url": "https://app.villa.rocks/terms", "publisher_name": "RealVR", "support_website_url": "https://www.villa.rocks/contact", "website_url": "https://www.villa.rocks/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "670597184250795"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1259603639140355"}, {"status": "PUBLISHED", "id": "984029689011022"}, {"status": "PUBLISHED", "id": "827626048717582"}, {"status": "PUBLISHED", "id": "788089972496130"}]}, "baseline_offer": {"id": "1259603639140355"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751481720, "status": "PUBLISHED", "id": "1259603639140355"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32720960170852559", "version": "1.9.0"}, "id": "81404557938795
": "en_US", "screenshots": [{"file_name": "screenshot_1_2560x1440.png", "id": "411062497041353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035305_411062500374686_8919495457939342552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyVMirG-QOYQ7kNvwFruxoZ&_nc_oc=AdmLSQ4b2Nb9zJJa_RX7RAinHdUhpePKGpptH-uATwasKcmxg0FO6aQOBa-tcw62gt0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afta0VZ_pnMIHn3XA3Kljb9RKEeKznq9CWV18Pnw7dWgFA&oe=699EF1AC"}, {"file_name": "screenshot_2_2560x1440.png", "id": "2542652509371965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569425_2542652512705298_8406153352649699415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDUTA8X9T8QQ7kNvwGsoQIE&_nc_oc=AdkLrh9rQ_0Zd8Z2WXQfDipAinBtinLzr_SFToX55whXo4Hf6nJ9jiDfFq1I2cDnyT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftOJJZG5C0aZdK1g5LRDEVm6IR9C_KYKhHBgZoe8c9T_g&oe=699ED444"}, {"file_name": "screenshot_3_2560x1440.png", "id": "837285150334022", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_837285153667355_5583694166526638160_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR-mBPDSJEMQ7kNvwGYJ94M&_nc_oc=AdmAo3ZbS2lSUUWYajosZyyL3u6LHYyPDieVYm_fB5pXQ3soQwijC9I9TIVBoJFwRLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuyTdV3fOWQmJFVZWhZyKf0KVuXis-USjdfvqvggl4Uag&oe=699EEC83"}, {"file_name": "screenshot_4_2560x1440.png", "id": "493746818307559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_493746821640892_1812030317833676803_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRuEhGrXezkQ7kNvwERP13o&_nc_oc=AdkBZITm9-Mnb-7vnZ779AC-lwhRPrCVmplM5S42QkPxcnq-sYfmCJ7bxdHW-qI2V1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsSBxStVuHIPQBmnmJwcBkQg6r_BM06Ud_f-35c-j2TOQ&oe=699EEC35"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1114552522343560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_1114552525676893_1677870913491985454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFfREKzb51QQ7kNvwFqzd63&_nc_oc=AdmCoUVcGgEGaxPpjtOPkjpQhUSZpFzYvDCebDTyRlCVaMK-hXlr0VCw8SimVqVu8f4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft9CjSvrNQthOvOC_0aASBnJcHHDgrXSwnyBc27Fs9DEw&oe=699EEBC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "be a superhuman cover image.png", "id": "942148429692825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974499_942148433026158_7347930193473508401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j6vtbeWj8wQ7kNvwHj29ay&_nc_oc=AdnDG0w3gOCysYgr7BcplFmZYnfAWyd1MkJln7LC9BCXzGAUfBWkOJ8PkmNlrqEG41c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNEY6AIXkQ56uGzB93hch7zHwWJdF7dCltP_8w_mE7wg&oe=699EFC54"}, "display_name": "Villa", "keywords": ["among", "team", "fly", "social", "design"], "long_description": "* Standups, roadmapping, happy hours, board meetings, design, 1:1s, and offsites that are out of this world and far better than IRL\n* A creativity platform, much like Zoom + Slack in 3D. Our focus is teams, giving tech professionals superpowers to be their best\n* The answer to \u2018videoconference fatigue\u2019 by putting you in thrilling immersive meeting experiences, giving you the tools to interact, co-invent and play\n* A meeting in VR is multiples more effective than IRL meetings with massive screens, and activities that defy physics like drawing in the air\n* Launched with multiple locations around the world. At the heart of each such micro-universe is your Villa, always the same, and always unique as you personalize it to reflect your team and org\u2019s personality and identity\n* Boost in culture, the glue that holds everyone to a common mission which is tricky in remote\n* Improved camaraderie and positive workplace feelings\n* Big CapEx and OpEx savings to your company relative to IRL meetings", "short_description": "Villa is a VR platform for team collaboration in thrilling immersive environments. For teams of up to 15 simultaneous members per villa. Villas interconnect (feature coming soon) for company wide simultaneous users, giving every team in an organization, from engineering, through product, finance, sales, marketing, partnerships C-Suite and Board professionals, a common space in VR. Come experience standups, strategy, design, roadmapping, 1:1s, offsites and board meetings that are better than IRL!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.villa.rocks/privacy", "developer_terms_of_service_url": "https://app.villa.rocks/terms", "publisher_name": "RealVR", "support_website_url": "https://www.villa.rocks/contact", "website_url": "https://www.villa.rocks/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "670597184250795"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1259603639140355"}, {"status": "PUBLISHED", "id": "984029689011022"}, {"status": "PUBLISHED", "id": "827626048717582"}, {"status": "PUBLISHED", "id": "788089972496130"}]}, "baseline_offer": {"id": "1259603639140355"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751481720, "status": "PUBLISHED", "id": "1259603639140355"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32720960170852559", "version": "1.9.0"}, "id": "81404557938795
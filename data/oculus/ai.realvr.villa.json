=6e7a0a&_nc_ohc=k_43UaAiDwUQ7kNvwF8y8Di&_nc_oc=Adr4UVXRgWNmTaT3v5ZNFQU5H7GFeuLAHt_NHDUzs0ZCv2rpi_u7E18dI8BB2dznFNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV1Bbm9upDxZVs82rESBxTxWPn0m4XwqF0_1A2ScMwHQ&oe=6AFC81F5"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1114552522343560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_1114552525676893_1677870913491985454_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8hq8OH1L0MQ7kNvwF_4Jw6&_nc_oc=AdoIs_LDl4OHnW5aORVb1X0A8S6_hXGhp-AQvjWCqPU8W6cNoTtD_4Gj7soOz4y3evE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQIOuxjzpjUqRHn_R-u8KI1vU_h-SR1ytejohHlC8sCA&oe=6AFC8187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "be a superhuman cover image.png", "id": "942148429692825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_942148433026158_7347930193473508401_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idC-dU6sLB4Q7kNvwEnm7Ub&_nc_oc=AdrOPg4v-c9vnzaNTsV274kQoAXdSazLA7X8HOy-j_C3v8jA0KSk-ssPY1fkEi59k8A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB_5lyI-Fjtp-HxexOI1INEIi9ZkYyWhrOfueWDszGjg&oe=6AFC9214"}, "display_name": "Villa", "keywords": ["among", "team", "fly", "social", "design"], "long_description": "* Standups, roadmapping, happy hours, board meetings, design, 1:1s, and offsites that are out of this world and far better than IRL\n* A creativity platform, much like Zoom + Slack in 3D. Our focus is teams, giving tech professionals superpowers to be their best\n* The answer to \u2018videoconference fatigue\u2019 by putting you in thrilling immersive meeting experiences, giving you the tools to interact, co-invent and play\n* A meeting in VR is multiples more effective than IRL meetings with massive screens, and activities that defy physics like drawing in the air\n* Launched with multiple locations around the world. At the heart of each such micro-universe is your Villa, always the same, and always unique as you personalize it to reflect your team and org\u2019s personality and identity\n* Boost in culture, the glue that holds everyone to a common mission which is tricky in remote\n* Improved camaraderie and positive workplace feelings\n* Big CapEx and OpEx savings to your company relative to IRL meetings", "short_description": "Villa is a VR platform for team collaboration in thrilling immersive environments. For teams of up to 15 simultaneous members per villa. Villas interconnect (feature coming soon) for company wide simultaneous users, giving every team in an organization, from engineering, through product, finance, sales, marketing, partnerships C-Suite and Board professionals, a common space in VR. Come experience standups, strategy, design, roadmapping, 1:1s, offsites and board meetings that are better than IRL!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.villa.rocks/privacy", "developer_terms_of_service_url": "https://app.villa.rocks/terms", "publisher_name": "RealVR", "support_website_url": "https://www.villa.rocks/contact", "website_url": "https://www.villa.rocks/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "670597184250795"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED
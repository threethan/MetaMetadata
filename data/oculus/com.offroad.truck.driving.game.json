0m3g&oe=69C53C16"}, {"file_name": "offroadTruck_2560_1440.png", "id": "706048382056665", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828799_706048385389998_4765144938683672468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewlbNSpkVXcQ7kNvwFB0rC1&_nc_oc=Adry6IKuDljwSGbJ-nHEa6A7TpX2ib78O7I2bglBWi0PV-sPLEsA-00Aq9ZJXHjgzUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2ndHq5wAKHtgW2oN7ARcRufFdcYiPLIDb3WuyjxmMzA&oe=69C53156"}, {"file_name": "offroad_2560_1440.png", "id": "641443405573882", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310717_641443408907215_1285205295935202012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXxiPgFos1QQ7kNvwEtqUSQ&_nc_oc=AdqXVos2GDtrDcJ2kQVM-HYgj4bFb3WPYC8AoCxuwxnpjCKb66yeeuvO17zIUhUoxvM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFn7CS4uTMZjQQ-nekIGyk9Ooc-np9CxTtF_N1iLQdyQ&oe=69C5387B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OffRoad Truck Simulator : Driving Game", "keywords": ["offroad", "truckdriving", "simulator", "driver", "driving"], "long_description": "Get ready for the ultimate Off Road challenge in Offroad Truck Simulator! Take control of heavy-duty trucks and explore rugged landscapes filled with steep hills, muddy paths, and dangerous bridges. Experience a realistic driving simulator with truck physics that pushes your driving skills to the limit.\nNavigate tricky terrain, transport valuable cargo, and avoid tipping over in challenging missions. Unlock a variety of powerful trucks, each with unique handling. \nWhether you're a casual player or a simulation enthusiast, this game offers thrilling adventure and immersive gameplay for all skill levels.\nKey Features:\n- Realistic truck physics and controls\n- Challenging offroad environments\n- Exploration missions\n- Multiple trucks to unlock\n\nDo you have what it takes to master the wilderness? Start your engine and find out!\n", "short_description": "Take 
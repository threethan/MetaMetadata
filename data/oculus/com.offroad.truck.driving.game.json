22930715521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823447_1436322934048854_2712643702444115345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDZ8joJRPzsQ7kNvwEZBgx2&_nc_oc=AdqfE6jq77-yxmK_ogQcH7RaaO9WCrVQIUZTGT4TbdtYYvbQQ4QKotcb1tPRmtwfKoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMay5SiY_0GJbe4S-ev1lF3q0dPRBsPwFNmuQIT16HtWw&oe=6AC65096"}, {"file_name": "offroadTruck_2560_1440.png", "id": "706048382056665", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828799_706048385389998_4765144938683672468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzfCgcYcWnoQ7kNvwGCGhH0&_nc_oc=AdqU5n-ieAvO9KGQncKX8zvlM6F2lHA2DZIKDGw1CONXbUZLt6ExEiwx6fIMG9LuA60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe8f4wlldL55tug0HbHjnV13qe-2lztqsLKFBM0yS8zA&oe=6AC645D6"}, {"file_name": "offroad_2560_1440.png", "id": "641443405573882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310717_641443408907215_1285205295935202012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBU0x3BBEU0Q7kNvwFwDytu&_nc_oc=Adp9l3KeJMuFCm9lasetw-y2gr9ISLS62GH8JZ8NB89-RV9g9aPMdUJAR8ECV_px_kw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxv90XoBh4_z0YmWA0LonjCKRxViaMYTdSxEANGe8d0Q&oe=6AC64CFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OffRoad Truck Simulator : Driving Game", "keywords": ["offroad", "truckdriving", "simulator", "driver", "driving"], "long_description": "Get ready for the ultimate Off Road challenge in Offroad Truck Simulator! Take control of heavy-duty trucks and explore rugged landscapes filled with steep hills, muddy paths, and dangerous bridges. Experience a realistic driving simulator with truck physics that pushes your driving skills to the limit.\nNavigate tricky terrain, transport valuable cargo, and avoid tipping over in challenging missions. Unlock a variety of powerful trucks, each with unique handling. \nWhether you're a casual player or a simulation enthusiast, this game offers thrilling adventure and immersive gameplay for all skill levels.\nKey Features:\n- Realistic truck physics and controls\n- Challenging offroad environments\n- Exploration missions\n- Multiple trucks to unlock\n\nDo you have what it takes to master the wilderness? Start your engine and find out!\n", "short_description": "Take on the wildest roads in Offroad Truck Simulator! Drive powerful trucks through rugged terrain, muddy tracks, steep hills, and narrow bridges. Deliver cargo safely while mastering extreme off road conditions. Realistic physics and multiple trucks to unlock. Can you conquer the wilderness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9962779247144557"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1539278044912467"}, {"status": "PUBLISHED", "id": "892113176989369"}, {"status": "PUBLISHED", "id": "2407809366295575"}, {"status": "PUBLISHED", "id": "977754967956393"}, {"status": "PUBLISHED", "id": "2391584814683099"}, {"status": "PUBLISHED", "id": "1458877125874398"}, {"status"
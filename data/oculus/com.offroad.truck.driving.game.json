595983751837_3893573412612980405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGYLmi7TIF0Q7kNvwGm1b6d&_nc_oc=Adoo8XQ1sYDh84ymmPZC6C9uBFQBW8H4RuQ8kTxvfhXj_7OKAwR8y929BvddmGaupoQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NNWtnrsVHBWUmv63gD7DLJsnQY-lY9ok621Plsd9jrQ&oe=6A24496B"}, {"file_name": "offroadSimulator_2560_1440.png", "id": "1436322930715521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823447_1436322934048854_2712643702444115345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZ6XF3TqSkcQ7kNvwEbEtvX&_nc_oc=AdoTaKX0WTAuFNZ7l-AdbsKaJ3kPsP1TX9hmZVVC9qVnPAPb-LI4oM8r77ebdByzJHc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1F_dYxGfsBc72QeIo70llveG4KeKOQLWM7ck4xaoZnA&oe=6A242816"}, {"file_name": "offroadTruck_2560_1440.png", "id": "706048382056665", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828799_706048385389998_4765144938683672468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFyeZ1DQwdsQ7kNvwH7Hqgs&_nc_oc=Adoh3V7q9ieirp22WPR4FWhV0q_Cbdc865ECpPXj0MgW8X6qyCln3bin88njRXJhPjs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wlhb39Ki7gXTr99H8RWFfi8SJMg6lT3qkOnulorlSZw&oe=6A241D56"}, {"file_name": "offroad_2560_1440.png", "id": "641443405573882", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310717_641443408907215_1285205295935202012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_tZz855JbAQ7kNvwEf6hJ2&_nc_oc=AdpvGZ_8ZzJuG_yS8gpwIy404jxe0t8CHRuif3xyERQ82PVqtAfLGhZR_EZEW5nMjWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pQa173-G_WdJ7pKYgzEojnNsdOd2uG-Mknlje8FOKmg&oe=6A24247B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OffRoad Truck Simulator : Driving Game", "keywords": ["offroad", "truckdriving", "simulator", "driver", "driving"], "long_description": "Get ready for the ultimate Off Road challenge in Offroad Truck Simulator! Take control of heavy-duty trucks and explore rugged landscapes filled with steep hills, muddy paths, and dangerous bridges. Experience a realistic driving simulator with truck physics that pushes your driving skills to the limit.\nNavigate tricky terrain, transport valuable cargo, and avoid tipping over in challenging missions. Unlock a variety of powerful trucks, each with unique handling. \nWhether you're a casual player or a simulation enthusiast, this game offers thrilling adventure and immersive gameplay for all skill levels.\nKey Features:\n- Realistic truck physics and controls\n- Challenging offroad environments\n- Exploration missions\n- Multiple trucks to unlock\n\nDo you have what it takes to master the wilderness? Start your engine and find out!\n", "short_description": "Take on the wildest roads in Offroad Truck Simulator! Drive powerful trucks through rugged terrain, muddy tracks, steep hills, and narrow bridges. Deliver cargo safely while mastering extreme off road conditions. Realistic physics and multiple trucks to unlock. Can you conquer the wilderness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE
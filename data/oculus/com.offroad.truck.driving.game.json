22930715521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823447_1436322934048854_2712643702444115345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDZ8joJRPzsQ7kNvwGnl7QF&_nc_oc=Ado-tVLiA8DDJiZFh3PAuNMtcUWctfQFXpPvEHla4ve8XjCbVElHAC1nePKE4oH3nHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcsXkMfR6VLjFYm5KxFWzHMsAnrXaDFNPKGrUxBfgzQw&oe=6AC3AD96"}, {"file_name": "offroadTruck_2560_1440.png", "id": "706048382056665", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828799_706048385389998_4765144938683672468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzfCgcYcWnoQ7kNvwHUJO04&_nc_oc=AdrO0qq4pr-Yyow-qxz9lqrfwzPewl9pxN1OD1n4NSSzFVW01x1AwLnPDc7wgiV6aYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfW94kuGCLol5putdjWWTX4QNRtEiuncN6JQiRomhQuA&oe=6AC3DB16"}, {"file_name": "offroad_2560_1440.png", "id": "641443405573882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310717_641443408907215_1285205295935202012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASXLbgyPdrYQ7kNvwFCTwp4&_nc_oc=AdoSC0tD9xpohYnAPU0JqVrAcI2ARiPa6LMA3y99G-D4Y-RYr_uYnguo3671gRpj0D4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB4dGOypIqdPIjb8Z5b8JQPpCVoRk4ivTaSK0240taOQ&oe=6AC3A9FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OffRoad Truck Simulator : Driving Game", "keywords": ["offroad", "truckdriving", "simulator", "driver", "driving"], "long_description": "Get ready for the ultimate Off Road challenge in Offroad Truck Simulator! Take control of heavy-duty trucks and explore rugged landscapes filled with steep hills, muddy paths, and dangerous bridges. Experience a realistic driving simulator with truck physics that pushes your driving skills to the limit.\nNavigate tricky terrain, transport valuable cargo, and avoid tipping over in challenging missions. Unlock a variety of powerful trucks, each with unique handling. \nWhether you're a casual player or a simulation enthusiast, this game offers thrilling adventure and immersive gameplay for all skill levels.\nKey Features:\n- Realistic truck physics and controls\n- Challenging offroad environments\n- Exploration missions\n- Multiple trucks to unlock\n\nDo you have what it takes to master the wilderness? Start your engine and find out!\n", "short_description": "Take on the wildest roads in Offroad Truck Simulator! Drive powerful trucks through rugged terrain, muddy tracks, steep hills, and narrow bridges. Deliver cargo safely while mastering extreme off road conditions. Realistic physics and multiple trucks to unlock. Can you conquer the wilderness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9962779247144557"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1539278044912467"}, {"status": "PUBLISHED", "id": "892113176989369"}, {"status": "PUBLISHED", "id": "2407809366295575"}, {"status": "PUBLISHED", "id": "977754967956393"}, {"status": "PUBLISHED", "id": "2391584814683099"}, {"status": "PUBLISHED", "id": "1458877125874398"}, {"status"
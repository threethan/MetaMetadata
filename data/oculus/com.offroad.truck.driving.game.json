uckTruck_2560_1440.png", "id": "1476595980418504", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307444_1476595983751837_3893573412612980405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duuO4xIRMj4Q7kNvwGigUFq&_nc_oc=AdrcwehDzgN-59ND5E3Y1SJSxhQqsGzCcgmKkXt5Cdg2fT97O4N1DGJwA111-azHfB0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyUyO5rdm_fR1AsrAb6HkhpgZZxHQvIqnhIuZEest5uA&oe=6AAD2D2B"}, {"file_name": "offroadSimulator_2560_1440.png", "id": "1436322930715521", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823447_1436322934048854_2712643702444115345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm8DalrZmp0Q7kNvwHsn00U&_nc_oc=AdrEnTTw_sjTNWFvtn_V_CD_xSTUNEO8MwEF3QwXaUOEfPXl9s6etoGTKS9z8HCDv04&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh2g2xgJcd4szmz8VW8tbu9moAv7WD8Zbzcp3w0wYVuQ&oe=6AAD4416"}, {"file_name": "offroadTruck_2560_1440.png", "id": "706048382056665", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828799_706048385389998_4765144938683672468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9ST7fZeVGQQ7kNvwFTwiIn&_nc_oc=AdoknLdlELg8UMl2FqJ2ICz_rpWu7GnqtHO8dbHxx5Vd0UgN_jsnDSgm4AF85fypoOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjWiE0gZQ85tVMnVgkc9yRl8A5SFGsZta8QhY5bNZspQ&oe=6AAD3956"}, {"file_name": "offroad_2560_1440.png", "id": "641443405573882", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310717_641443408907215_1285205295935202012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDQQXs5mBIEQ7kNvwHRwTER&_nc_oc=AdrIIXU2ymEnZsiiy9vqqNAytIfV-8cDlLdcq97eDbsJoH7ST1IsP7foWvDUCFiUfqE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2HQ1TpOasqqusvyLp3Zba_Sbomoo6MIsP3ztwt0p3oA&oe=6AAD407B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OffRoad Truck Simulator : Driving Game", "keywords": ["offroad", "truckdriving", "simulator", "driver", "driving"], "long_description": "Get ready for the ultimate Off Road challenge in Offroad Truck Simulator! Take control of heavy-duty trucks and explore rugged landscapes filled with steep hills, muddy paths, and dangerous bridges. Experience a realistic driving simulator with truck physics that pushes your driving skills to the limit.\nNavigate tricky terrain, transport valuable cargo, and avoid tipping over in challenging missions. Unlock a variety of powerful trucks, each with unique handling. \nWhether you're a casual player or a simulation enthusiast, this game offers thrilling adventure and immersive gameplay for all skill levels.\nKey Features:\n- Realistic truck physics and controls\n- Challenging offroad environments\n- Exploration missions\n- Multiple trucks to unlock\n\nDo you have what it takes to master the wilderness? Start your engine and find out!\n", "short_description": "Take on the wildest roads in Offroad Truck Simulator! Drive powerful trucks through rugged terrain, muddy tracks, steep hills, and narrow bridges. Deliver cargo safely while mastering extreme off road conditions. Realistic physics and multiple trucks to unlock. Can you conquer the wilderness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
Adr3dnYiLZMbTjRSZBTfdk0yeIRsJUsM1b_ZUs32YwYWOshpchq7r-126DlAy2y1Z7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLDttRU13zUa1XsDsDZi4iCo9ZjLKYl11-pJaQBCiXwQ&oe=6AFDE43B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OffRoad Truck Simulator : Driving Game", "keywords": ["offroad", "truckdriving", "simulator", "driver", "driving"], "long_description": "Get ready for the ultimate Off Road challenge in Offroad Truck Simulator! Take control of heavy-duty trucks and explore rugged landscapes filled with steep hills, muddy paths, and dangerous bridges. Experience a realistic driving simulator with truck physics that pushes your driving skills to the limit.\nNavigate tricky terrain, transport valuable cargo, and avoid tipping over in challenging missions. Unlock a variety of powerful trucks, each with unique handling. \nWhether you're a casual player or a simulation enthusiast, this game offers thrilling adventure and immersive gameplay for all skill levels.\nKey Features:\n- Realistic truck physics and controls\n- Challenging offroad environments\n- Exploration missions\n- Multiple trucks to unlock\n\nDo you have what it takes to master the wilderness? Start your engine and find out!\n", "short_description": "Take on the wildest roads in Offroad Truck Simulator! Drive powerful trucks through rugged terrain, muddy tracks, steep hills, and narrow bridges. Deliver cargo safely while mastering extreme off road conditions. Realistic physics and multiple trucks to unlock. Can you conquer the wilderness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
4.5771-25/39003229_1525322358108832_14384170365003610_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-XUxdu6h_8Q7kNvwEWZdiH&_nc_oc=AdlHWvOJ-YXwO0iqiTqyxKez6ELRsFA4AS70sWC-IKaA7R9mcEfpDLp9r9IgvoV5exs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvbxuF5zYpwi3fUzxyC8Kz-KT-gsy3ODswdG0zDB3OpvQ&oe=699D92E4"}, {"file_name": "ApplicationFrameHost_GrwUtWZcoL.png", "id": "533557679470535", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974646_533557682803868_8555966524809842029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Lv-6jFgw6sQ7kNvwE51ElA&_nc_oc=AdnpxerYrqBtyD1Sw-xhyfM17m-KCTk7SASzRGQjsgkSOhsk20AqG1BwxwWB9AJbUS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzEZ3UVTvjiSDKdj95Vw2wsLr7YJATXQBdkWRi8NWDZg&oe=699D8495"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Acid Base Indicator_Landscape.png", "id": "1115395179599212", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982681_1115395182932545_1230410766364332325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDkzwPqGg1IQ7kNvwEJwMEx&_nc_oc=AdnZIwQjZ-UHMRJg6Q6vY_VHkmzSPa2UBAhZqDeJGGj1XLmxcfRv_qBwoznovaRFVg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsTXv0X9gdh_UJoXfyIZmBE30XuamllbcxQ3Q8yr3Gq7A&oe=699D994D"}, "display_name": "Acid Base Indicator Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "acid", "science", "contentsda"], "long_description": "1. add 3 ml of dilute hydrochloric acid solution in 3 12-groove rows on the first row of the test paper.\n2. add 3 ml of acetic acid solution to the second row of the test paper in three 12-groove rows.\n3. add 3 ml of sodium hydroxide solution in 3 12-groove rows on the third row of the test paper.\n4. on the fourth row of the lab sheet, add 3 ml of the ammoniacal solution in three 12-groove rows.\n5. add 3 ml of distilled water to the first row of the second sheet of lab paper in three 12-groove rows.\n6. Add BTB solution in the first horizontal row and observe the change.\n7. add methylene glycol solution to the second row and observe the change.\n8. observe the change after adding phenolphthalein solution to the third row.\n9. observe the reaction of the acid and base\nLearn how the color changes depending on the acidity of the substance.", "short_description": "Dive into the colorful world of acids and bases. This experiment uses natural indicators to reveal the pH levels of various substances, showcasing the fascinating changes in color that occur when acids and bases interact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9045251115487930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974696_924921089377706_2982661725358912360_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1quFiQHHW-4Q7kNvwFAKgK5&_nc_oc=AdmtVl2x34ncZiARLHL2KK_2hqqUW5AShFWJ3k7eMzxQkeyuOk_BQqZSG0JGP3RSZM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSDl7Kb1gn0fQTCqZX1EMTZXwwsUaQmolHYqoO_v91FQ&oe=699D8FD8"}, "is_concept": false, "is_test
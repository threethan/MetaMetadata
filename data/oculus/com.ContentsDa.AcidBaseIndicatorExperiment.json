656", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75572751_8561766417205322_2600822413782377862_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF4GcZnuSbMQ7kNvwHn6rlM&_nc_oc=AdlpoGUUzatB7hw8JiO8K-04vYRx3iMmftmUZ54F2bhtBhunFNczBshfiY2hfd9TwoI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvv6EI42dp6eqOUxlEB7HbYVqnE_pXdpbuMwYSVIK9fXQ&oe=69A191A7"}, {"file_name": "ApplicationFrameHost_0WkvJqnikN.png", "id": "1525322354775499", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003229_1525322358108832_14384170365003610_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEKcjLN5aGYQ7kNvwHfEkld&_nc_oc=AdloHp5qbDws_Y-beHWn29nn4nfG1EJ6GD_WcDHHotST6D5gG45uzo5lgBu9CK44KpY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv1RtqzSJpMFejX_irCu-edgejuHx6efhYjpZVraeuUgQ&oe=69A18764"}, {"file_name": "ApplicationFrameHost_GrwUtWZcoL.png", "id": "533557679470535", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974646_533557682803868_8555966524809842029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuvcA1nBLN8Q7kNvwEg9gia&_nc_oc=AdkGakiknAKFxUJOzolc1wxkzacPgEo4V2dWxJzYEfQ6zFEnzjlTq4ZZUJqeUL7BI_U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftrYRuzFokM88ylO8aC25VpspfiOth1QX4wb0Hvh_tNPg&oe=69A17915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Acid Base Indicator_Landscape.png", "id": "1115395179599212", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982681_1115395182932545_1230410766364332325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAki16zUKXIQ7kNvwGW6Zaw&_nc_oc=AdkIMCq8yw63SpYUlHFh0aiZtv-9mt5K2gLwBL6tVCIu77gfs2eX4yDZTklsZLZFwNU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftpN8C1eEnnnjel3cRS77Cmlv3pfeQNHnav_MI_mH6Fzg&oe=69A18DCD"}, "display_name": "Acid Base Indicator Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "acid", "science", "contentsda"], "long_description": "1. add 3 ml of dilute hydrochloric acid solution in 3 12-groove rows on the first row of the test paper.\n2. add 3 ml of acetic acid solution to the second row of the test paper in three 12-groove rows.\n3. add 3 ml of sodium hydroxide solution in 3 12-groove rows on the third row of the test paper.\n4. on the fourth row of the lab sheet, add 3 ml of the ammoniacal solution in three 12-groove rows.\n5. add 3 ml of distilled water to the first row of the second sheet of lab paper in three 12-groove rows.\n6. Add BTB solution in the first horizontal row and observe the change.\n7. add methylene glycol solution to the second row and observe the change.\n8. observe the change after adding phenolphthalein solution to the third row.\n9. observe the reaction of the acid and base\nLearn how the color changes depending on the acidity of the substance.", "short_description": "Dive into the colorful world of acids and bases. This experiment uses natural indicators to reveal the pH levels of various substances, showcasing the fascinating changes in color that occur when acids and bases interact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
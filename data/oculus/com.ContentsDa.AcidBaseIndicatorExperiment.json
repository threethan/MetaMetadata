656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_8561766417205322_2600822413782377862_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COswbKisX38Q7kNvwH4nCDc&_nc_oc=AdkIV44sSdiAlc3nqb-r5lh1j0Bp-EtcvjWC4mwZV9on3RO9BBigRq_2vuLZyx2N5lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afua7Ct9qE4xYhIaLl-bdQbQgDNNQKr9edZvkv27MPP4PQ&oe=699EEEA7"}, {"file_name": "ApplicationFrameHost_0WkvJqnikN.png", "id": "1525322354775499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003229_1525322358108832_14384170365003610_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-XUxdu6h_8Q7kNvwH_9x4N&_nc_oc=AdnLfwMxo18C1qYPWJex1zcifRl4fD9sJoRNh2GcmOILlsPlfWZjzfV6mJ3g-cmlfkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu693GQDRon-nguyVl5qbY-uSMJG6SZt1nMJHTljG9www&oe=699EE464"}, {"file_name": "ApplicationFrameHost_GrwUtWZcoL.png", "id": "533557679470535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974646_533557682803868_8555966524809842029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Lv-6jFgw6sQ7kNvwG411ux&_nc_oc=Admrgvm_mleREK5rI5ThLG7tk0Q7_HqnccXCc3x0yNPcJmOFKcJ4ZItCfmsaDWmpIkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftbdywXcjT6WnM88mMylglKRytYvQzoDUrFqPgvvg5V2Q&oe=699ED615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Acid Base Indicator_Landscape.png", "id": "1115395179599212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1115395182932545_1230410766364332325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAki16zUKXIQ7kNvwER-KAt&_nc_oc=AdnUGA7KQcd0EgIVWK6HS507tCM-nTxo9irnH9z1U8u-YjjSlXQIkg8ITmhF1RVv71Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuZYtTsyAPLQeho-2Nw5Fl4D39gp5bBGZ8X9gljMSalZA&oe=699EEACD"}, "display_name": "Acid Base Indicator Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "acid", "science", "contentsda"], "long_description": "1. add 3 ml of dilute hydrochloric acid solution in 3 12-groove rows on the first row of the test paper.\n2. add 3 ml of acetic acid solution to the second row of the test paper in three 12-groove rows.\n3. add 3 ml of sodium hydroxide solution in 3 12-groove rows on the third row of the test paper.\n4. on the fourth row of the lab sheet, add 3 ml of the ammoniacal solution in three 12-groove rows.\n5. add 3 ml of distilled water to the first row of the second sheet of lab paper in three 12-groove rows.\n6. Add BTB solution in the first horizontal row and observe the change.\n7. add methylene glycol solution to the second row and observe the change.\n8. observe the change after adding phenolphthalein solution to the third row.\n9. observe the reaction of the acid and base\nLearn how the color changes depending on the acidity of the substance.", "short_description": "Dive into the colorful world of acids and bases. This experiment uses natural indicators to reveal the pH levels of various substances, showcasing the fascinating changes in color that occur when acids and bases interact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
ps0Bpl7zB8E2hYmoYHSzHx_oxP5SSrBgRCsgVFEMtw&oe=6AFC6AF5"}, {"file_name": "UI_stats_screenshot.png", "id": "420778252545260", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974448_420778255878593_1883363340264955550_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVvGTwLwd-kQ7kNvwFQyvJR&_nc_oc=AdpqHiGpBJGGZYI0LGOlNw_nU0P7x6WuqHZrp_EwQO6Ja-JN388Jip17xpfzookuzN8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsNBmyqxLNvnUonstFd8s5wZWLvh2XyKB_V0-DSZYHMw&oe=6AFC902B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "426207355372873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031326_426207358706206_2015243860219794815_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxwrXYTrhhIQ7kNvwEnOv6k&_nc_oc=AdqyKbapDjPzXDjPvVmBI2bR2HhHnf0VXLgolxp4IPLXs9edVb5_ZpjKFrlhpDmA2X8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL7m7YZ3qXIhyuDvT1SOVEbZY1RKvh01Mdps_vt9d0Ng&oe=6AFC65B2"}, "display_name": "ENHANCE", "keywords": [], "long_description": "ENHANCE VR offers a daily brain training workout of short, fun, and intense games designed by neuroscientists to test and train your cognitive skills, including:\n\n1. Memory\n2. Attention\n3. Flexibility\n4. Problem solving\n5. Motor control\n6. Spatial orientation\n7. Information Processing\n\nPlay daily, or as frequently you can, and track your progress over time with reporting tools that let you know how your quality of sleep and moods affect your cognitive performance.\n\nStart working out your brain today!\n\nDisclaimer: as part of the registration process, we collect personal and demographic data that is in no shape or form used other than for research purposes. Our data collection policy is strictly compliant to GDPR and HIPAA privacy and security regulations, in which your personal data is anonymized and kept secure.\n\nEnhance Version History: https://website.virtuleap.dev/changelog", "short_description": "ENHANCE VR offers a daily brain training workout of short and fun games designed by neuroscientists to test and train your cognitive skills."}]}, "developer_name": "Virtuleap", "developer_privacy_policy_url": "https://website.virtuleap.dev/privacy.html", "developer_terms_of_service_url": "https://website.virtuleap.dev/terms.html", "publisher_name": "Virtuleap", "support_website_url": "https://virtuleap.com/support.html", "website_url": "http://www.virtuleap.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "223394409992198"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905145535230049"}, {"status": "PUBLISHED", "id": "365201924674906"}]}, "baseline_offer": {"id": "905145535230049"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770197520, "status": "PUBLISHED", "id": "905145535230049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24500838419535420", "version": "2.10.0.0"}, "id": "735684397380680", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3696764747036091", "is_concept": false, "latest
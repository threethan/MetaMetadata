c_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VhZMCciSWBP95_Jm661FNr8gwVc47YgDeqGivKgIEaQ&oe=6A0C79AC"}, {"file_name": "Pete_Poopasafdsfgfd_cropped.png", "id": "1413961223766676", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298137_1413961227100009_7719079578671397293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDiJP6FCPUYQ7kNvwHjGy_z&_nc_oc=Ado7pwI_FVBkX2eZJdQMJ2bdI7msythNBKbT453Lt1aRgyhDn-oZy5jYBZ9Ypj84pHw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o47apEZ7R_cWR7CBljw_j-FtoFqp3JcKBNaUwvwrCXA&oe=6A0C6662"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Pete Tag.png", "id": "1503140988487992", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820387_1503140991821325_2355751576729764525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGRAn_uhF-YQ7kNvwFdggHW&_nc_oc=AdrtQKDAcLD7c1TnjBXhYyjI4C7v47pFF0nUhOMqibnB1mjJ6BNC_v-n-cb0_1b4yUY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sS9X24nguMICT28_QgAx2kVTExrG2YcNPCP4WvzouiA&oe=6A0C8094"}, "display_name": "Pete Tag", "keywords": ["Adventure", "Gorilla", "Tag", "Fangame", "Multiplayer"], "long_description": "Pete Tag is a fast-paced, social VR experience inspired by Gorilla Tag, built for players who love movement, customization, and hanging out with friends. Swing, climb, and run your way through a wide variety of unique maps, each designed for fun exploration, competitive play, and casual chilling.\n\nCustomize your gorilla with a growing collection of fun and creative cosmetics to stand out while you play. Jump into multiple exciting game modes that keep gameplay fresh, whether you\u2019re competing, practicing movement, or just messing around with friends.\n\nPete Tag is all about community, freedom of movement, and fun. Whether you\u2019re looking to grind cosmetics, explore new environments, or simply hang out and meet other players, Pete Tag offers an energetic and welcoming VR experience made for endless replayability.", "short_description": "Pete Tag is a fast-paced Gorilla Tag fangame where you can hang out in tons of unique maps, unlock fun cosmetics, and jump into exciting game modes with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://site-0xyqqdf1m.godaddysites.com/", "developer_terms_of_service_url": null, "publisher_name": "Beezyy", "support_website_url": null, "website_url": "https://site-0xyqqdf1m.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25305102772521949"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1502798854974793"}]}, "baseline_offer": {"id": "1502798854974793"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769878800, "status": "PUBLISHED", "id": "1502798854974793"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25377839471914945", "version": "15"}, "id": "896150029638408", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25259409890424571", "is_concept": false, "latest_released_binary": {"__typ
g", "id": "1521790215581995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299876_1521790218915328_3971059481592741364_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cellMQZ2Bp0Q7kNvwEQKEYT&_nc_oc=AdpPXG--F5IuYE4DOfGk4HUx9HA5hbgNJApoJCYsC6MD3AjokDiPmwS3Bpic08OKpPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gJ3mDIr9adf4dF1LT81HlL-evSt-E5s5f7NBs8XXJmA&oe=6A2AB24C"}, {"file_name": "Pete_Night_2560x1440.png", "id": "1587181452516041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300575_1587181455849374_9061219956553757483_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlJwp-152Y4Q7kNvwFtJaPJ&_nc_oc=AdrHkn5Y540PMZQ8MojNd-3fruPzjNWXfT4AJ__JHHXa4Ji3HM-uocMu1qk4SCP9yVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_6idIuELpMxU37zzvUxLkJJapj8dzfHD-y7BnCILR-g&oe=6A2ACC2C"}, {"file_name": "Pete_Poopasafdsfgfd_cropped.png", "id": "1413961223766676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298137_1413961227100009_7719079578671397293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAXvXkIFALMQ7kNvwHo-RE3&_nc_oc=Adq5nBAdx3ruUgwlWxowp9KbrVuJCYT_oO2Qo7-1seCcrlLtMN3xzn1E_Yrms8_oAkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jxKSRWd6HllXjgvKKkAJNwJ5QFrXDKW-T7ksGupnb3w&oe=6A2AB8E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Pete Tag.png", "id": "1503140988487992", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820387_1503140991821325_2355751576729764525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eD_C608M-gkQ7kNvwGGH-I5&_nc_oc=AdoY0uypVHJVjtIAS1nqcjOVx0fdU_vjB4GZgY7Md2GbmOaceVgMUoozbvEhhaZiKzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dX9SexAxt1E-Mf6ZxHlZmDa2hkwlVlyP5RraAbm7vPA&oe=6A2AD314"}, "display_name": "Pete Tag", "keywords": ["Adventure", "Gorilla", "Tag", "Fangame", "Multiplayer"], "long_description": "Pete Tag is a fast-paced, social VR experience inspired by Gorilla Tag, built for players who love movement, customization, and hanging out with friends. Swing, climb, and run your way through a wide variety of unique maps, each designed for fun exploration, competitive play, and casual chilling.\n\nCustomize your gorilla with a growing collection of fun and creative cosmetics to stand out while you play. Jump into multiple exciting game modes that keep gameplay fresh, whether you\u2019re competing, practicing movement, or just messing around with friends.\n\nPete Tag is all about community, freedom of movement, and fun. Whether you\u2019re looking to grind cosmetics, explore new environments, or simply hang out and meet other players, Pete Tag offers an energetic and welcoming VR experience made for endless replayability.", "short_description": "Pete Tag is a fast-paced Gorilla Tag fangame where you can hang out in tons of unique maps, unlock fun cosmetics, and jump into exciting game modes with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://site-0xyqqdf1m.godaddysites.com/", "developer_terms_of_service_url": null, "publisher_name": "Beezyy", "support_website_url": null, "website_url": "https://site-0xyqqdf1m.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25305102772521949"}, "review_messages":
g", "id": "1521790215581995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299876_1521790218915328_3971059481592741364_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9YHfRcJ0QEQ7kNvwEkSaa2&_nc_oc=AdoIb6td8UdHb7f5vg5Bitl4hcdjdW0qmcCQ0J8zyAS2JuJYbTvVufOAntsYcb1HTrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjAJPcbbGoWsA7-cJQQDOlw-EASYOsfHxMo9CC5tUESg&oe=6AB12B4C"}, {"file_name": "Pete_Night_2560x1440.png", "id": "1587181452516041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300575_1587181455849374_9061219956553757483_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH3NL7ouH70Q7kNvwH_LIXL&_nc_oc=Adqby_LRA7QigVFe5qxvMBUHhGcB-ZjthlADAwUSemkGdE5kSgtBd8DKfMYMRa6-BcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvV1K-sWctqOW8IGSI1VHgnlge6EvqMe78GhOC1_Uvxg&oe=6AB1452C"}, {"file_name": "Pete_Poopasafdsfgfd_cropped.png", "id": "1413961223766676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298137_1413961227100009_7719079578671397293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ6R_0YAVlcQ7kNvwFPdToa&_nc_oc=AdrYgsdKI1uq13bMBnbVmYaTdzF0GpUwr7dWbPqsJBnZJGlOw8etKKD4_CAzT9w_5f0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZSI0dkfMbWJps9eL2tH21CNdsJ_5GdCU30IeUcjlhmA&oe=6AB131E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Pete Tag.png", "id": "1503140988487992", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820387_1503140991821325_2355751576729764525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcHmJTr5UWYQ7kNvwE9C2a4&_nc_oc=AdoV7MWIZAlTdEzl8IlaCQ-nQHN2b0P9F-T_ZyfF3f2dT5LQx9GeRKPTea5RQh86Rq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp3ReKDkNRZdJULYqz3Ym91P_sA2ZmViZBD-6KvjhxvQ&oe=6AB14C14"}, "display_name": "Pete Tag", "keywords": ["Adventure", "Gorilla", "Tag", "Fangame", "Multiplayer"], "long_description": "Pete Tag is a fast-paced, social VR experience inspired by Gorilla Tag, built for players who love movement, customization, and hanging out with friends. Swing, climb, and run your way through a wide variety of unique maps, each designed for fun exploration, competitive play, and casual chilling.\n\nCustomize your gorilla with a growing collection of fun and creative cosmetics to stand out while you play. Jump into multiple exciting game modes that keep gameplay fresh, whether you\u2019re competing, practicing movement, or just messing around with friends.\n\nPete Tag is all about community, freedom of movement, and fun. Whether you\u2019re looking to grind cosmetics, explore new environments, or simply hang out and meet other players, Pete Tag offers an energetic and welcoming VR experience made for endless replayability.", "short_description": "Pete Tag is a fast-paced Gorilla Tag fangame where you can hang out in tons of unique maps, unlock fun cosmetics, and jump into exciting game modes with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://site-0xyqqdf1m.godaddysites.com/", "developer_terms_of_service_url": null, "publisher_name": "Beezyy", "support_website_url": null, "website_url": "https://site-0xyqqdf1m.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25305102772521949"}, "review_messages":
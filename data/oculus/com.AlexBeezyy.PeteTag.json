1592741364_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARlejQutmQQQ7kNvwH2hLzw&_nc_oc=Adofx75VDj63-WHrinmR9deTK19zdJZQCQiegh5gcR-o337YKJVPRLHygc-_S5LK4CM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH9IiB985AaSW02cy9TQb45Rg0zZPgaz-K08LBqhQBTA&oe=69CBC64C"}, {"file_name": "Pete_Night_2560x1440.png", "id": "1587181452516041", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300575_1587181455849374_9061219956553757483_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO4_kBuPMXoQ7kNvwG9_ql3&_nc_oc=AdolxFSJGIhjxHWVWBenSi-6r0mCBvF-GWrSNXXiMeF6Qh-u6wMTbo_oj2sQjsWw0ZQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-4eGodXaBVmCVmIWN1Ro803EtJCwSUwRaJDbbK5pWTw&oe=69CBA7EC"}, {"file_name": "Pete_Poopasafdsfgfd_cropped.png", "id": "1413961223766676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298137_1413961227100009_7719079578671397293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRHkv6Pc0TIQ7kNvwHrxjJv&_nc_oc=AdrWU1c31BXxHWoMDfLHIzrwQeanUWIxvBhJ5aildaiZmY306ZqvCPLB50r-kutZDbM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0pwJ4c4ZKGcLB25_Vc5LrLH9lET4koBvM0ZzhSXootQ&oe=69CBCCE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Pete Tag.png", "id": "1503140988487992", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820387_1503140991821325_2355751576729764525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2td-eT3etogQ7kNvwHvAQ1f&_nc_oc=AdpPgLiyPVpHeHNG4EbZdcY8geDaDaV0FK2bkAY8hxzZl4uzZtN5BhRvKaUE3H_ZPBw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoZJNY9-Sy1F30ZTtE37V0pEDi3CkpS-9IR4CvK3XAAg&oe=69CBAED4"}, "display_name": "Pete Tag", "keywords": ["Adventure", "Gorilla", "Tag", "Fangame", "Multiplayer"], "long_description": "Pete Tag is a fast-paced, social VR experience inspired by Gorilla Tag, built for players who love movement, customization, and hanging out with friends. Swing, climb, and run your way through a wide variety of unique maps, each designed for fun exploration, competitive play, and casual chilling.\n\nCustomize your gorilla with a growing collection of fun and creative cosmetics to stand out while you play. Jump into multiple exciting game modes that keep gameplay fresh, whether you\u2019re competing, practicing movement, or just messing around with friends.\n\nPete Tag is all about community, freedom of movement, and fun. Whether you\u2019re looking to grind cosmetics, explore new environments, or simply hang out and meet other players, Pete Tag offers an energetic and welcoming VR experience made for endless replayability.", "short_description": "Pete Tag is a fast-paced Gorilla Tag fangame where you can hang out in tons of unique maps, unlock fun cosmetics, and jump into exciting game modes with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://site-0xyqqdf1m.godaddysites.com/", "developer_terms_of_service_url": null, "publisher_name": "Beezyy", "support_website_url": null, "website_url": "https://site-0xyqqdf1m.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25305102772521949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_2689614658084773_32666515
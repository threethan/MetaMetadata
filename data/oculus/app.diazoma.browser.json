ps://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303471_1041791948870721_8924933523938005446_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5ZJSTAmGPYQ7kNvwGr5nzT&_nc_oc=AdotxOv0EVgfGGW81G_Vr7hgRTWbe94Q1TSPKw1Ryrx-aVTKYq-BHXFRBksaAwB5TYI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8jeN10N4PoWijthxng43Q6i_ezzyczGs1KxSU4tL4kQ&oe=6AE36C91"}]}, "id": "3821020318045493", "locale": "en_US", "screenshots": [{"file_name": "4-picture-details.png", "id": "3673852002781427", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_3673852006114760_6771508430449736690_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnomAN2TBywQ7kNvwHaFl7J&_nc_oc=AdpX6uh9obSG1rV7fOtu1VeQpFEanYtyjr3iYfc9yxRDAyPyZpZTHOe27-elMFtb48g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCavdrVMg8aVZ4DvvGYIzPzLJwl9prZHk6YqcRYHBRrg&oe=6AE36732"}, {"file_name": "5-picture-close.png", "id": "1802484267685421", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673536876_1802484271018754_1658534160335870779_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSMaUTsRVUIQ7kNvwGp2hxu&_nc_oc=AdpeWlFUDbFXaSKkB_U91W2ygaO9QKB4UhpAEzYCNVxQQXv0bLqaYexEm5CSMCpjtJk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd3vf8n7ih32qx_QsoL_2aKs2DgE1bCqs3bIuc2wANnw&oe=6AE34D32"}, {"file_name": "3-wall-nasa.png", "id": "1420018033016450", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830441_1420018036349783_1675330097722202830_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0ATk8UYroIQ7kNvwHKOcZ8&_nc_oc=AdqrcQatBZqZt1q7Qm4npAhwdSUvCiEhzEaxXR1FwmK720ivMHrfktJj0MwrLlH_9Fs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8sOp6iUfl4epdieYWpwDjIRaTfeDHeQ5rSl2b73aggQ&oe=6AE3429B"}, {"file_name": "2-wall.png", "id": "2357786474993442", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673759338_2357786478326775_8905473956794526439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARJXI1zlD90Q7kNvwF2CHh-&_nc_oc=AdqTkxNyZ7m9G1n5FHhHZTMGpz9HR3iKlHelTC3KFImIP0HzLN9a33Q2h8eNXamHzxg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjStuvlFKvDYm5T6WU6diL9Iq7BFKup0ChtpHLkLMfKg&oe=6AE3566C"}, {"file_name": "1-start-page.png", "id": "1634313214998375", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831299_1634313218331708_107591231116990736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXqNxkIg2uAQ7kNvwHDpFBJ&_nc_oc=AdrAzOSjN-OAOqw6R2pdZKrbLATg6pUqWfWUrfkqd_P_qQl4kL8oSlM2F597InOosqI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_RN0oTQhOKXpZVwA2QsljE-NLczlqti46WSyM-h3k3g&oe=6AE36BD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Diazoma Browser", "keywords": [], "long_description": "Diazoma Browser is a web browser for Meta Quest with one more button: it turns a page full of pictures into a curved wall you stand in front of, look around and open, with your controllers or your hands.\n\nBrowse as usual. When a page has a wall, the Diazoma button appears in the address bar. Press it and the pictures of the page, the museum collection or the archive come up around you in VR. Pull the trigger on a picture to open it.\n\nWalls come from three places:\n- Sites that publish their own wall or a Diazoma manifest.\n- Recipes: small signed descriptions of where a site keeps its pictures. The core list covers Wikimedia Commons, NASA Images, the Cleveland Museum of Art, the Art Institute of Chicago, iNaturalist, Wellcome Collection and hundreds of other collections, and it updates without a new version of the browser.\n- The page itself: any page with a list of pictures and links can be opened as a wall.\n\nA site that asks for no wall gets none. Diazoma never gets around a login or a paywall.\n\nPrivacy: the browser sends no usage statistics and no crash reports. Finding a wall for a page happens on the headset; the page address is not sent anywhere.\n\nDiazoma Browser is built on Wolvic, the open source XR browser by Igalia, with the Chromium engine. The browser is open source under the Mozilla Public License 2.0; its source code is at github.com/escapeboy/wolvic.", "short_description": "A web browser that opens museums, archives and galleries as a wall of pictures around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://diazoma.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nikola Katsarov", "support_website_url": "https://diazoma.app/docs/browser/", "website_url": "https://diazoma.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1125377006621523"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308026_28152650971079800_263326341863333909_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzNQn8yOlTIQ7kNvwHSo1Kd&_nc_oc=AdoxWcV0MkUhdeTkJPJa3sKE6XyCCOp-tjPw5bgftuVMj4mZfW9z4HmccqQcveDL8Qc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHshkHBXJbFBwaPkU9qqACd9H4SssJtTYXw0afsegeyg&oe=6AE35D53"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Diazoma Browser", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "M
3-wall-nasa.png", "id": "1420018033016450", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830441_1420018036349783_1675330097722202830_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0ATk8UYroIQ7kNvwHKOcZ8&_nc_oc=AdqrcQatBZqZt1q7Qm4npAhwdSUvCiEhzEaxXR1FwmK720ivMHrfktJj0MwrLlH_9Fs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8sOp6iUfl4epdieYWpwDjIRaTfeDHeQ5rSl2b73aggQ&oe=6AE3429B"}, {"file_name": "2-wall.png", "id": "2357786474993442", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673759338_2357786478326775_8905473956794526439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARJXI1zlD90Q7kNvwF2CHh-&_nc_oc=AdqTkxNyZ7m9G1n5FHhHZTMGpz9HR3iKlHelTC3KFImIP0HzLN9a33Q2h8eNXamHzxg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjStuvlFKvDYm5T6WU6diL9Iq7BFKup0ChtpHLkLMfKg&oe=6AE3566C"}, {"file_name": "1-start-page.png", "id": "1634313214998375", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831299_1634313218331708_107591231116990736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXqNxkIg2uAQ7kNvwHDpFBJ&_nc_oc=AdrAzOSjN-OAOqw6R2pdZKrbLATg6pUqWfWUrfkqd_P_qQl4kL8oSlM2F597InOosqI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_RN0oTQhOKXpZVwA2QsljE-NLczlqti46WSyM-h3k3g&oe=6AE36BD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Diazoma Browser", "keywords": [], "long_description": "Diazoma Browser is a web browser for Meta Quest with one more button: it turns a page full of pictures into a curved wall you stand in front of, look around and open, with your controllers or your hands.\n\nBrowse as usual. When a page has a wall, the Diazoma button appears in the address bar. Press it and the pictures of the page, the museum collection or the archive come up around you in VR. Pull the trigger on a picture to open it.\n\nWalls come from three places:\n- Sites that publish their own wall or a Diazoma manifest.\n- Recipes: small signed descriptions of where a site keeps its pictures. The core list covers Wikimedia Commons, NASA Images, the Cleveland Museum of Art, the Art Institute of Chicago, iNaturalist, Wellcome Collection and hundreds of other collections, and it updates without a new version of the browser.\n- The page itself: any page with a list of pictures and links can be opened as a wall.\n\nA site that asks for no wall gets none. Diazoma never gets around a login or a paywall.\n\nPrivacy: the browser sends no usage statistics and no crash reports. Finding a wall for a page happens on the headset; the page address is not sent anywhere.\n\nDiazoma Browser is built on Wolvic, the open source XR browser by Igalia, with the Chromium engine. The browser is open source under the Mozilla Public License 2.0; its source code is at github.com/escapeboy/wolvic.", "short_description": "A web browser that opens museums, archives and galleries as a wall of pictures around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://diazoma.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nikola Katsarov", "support_website_url": "https://diazoma.app/docs/browser/", "website_url": "https://diazoma.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1125377006621523"}}]}, "scheduled_offers": {"count": 1, "
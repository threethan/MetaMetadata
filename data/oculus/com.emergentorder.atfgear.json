ile_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lP6VQclp7wQ7kNvwHjkkft&_nc_oc=Adkcsl1nt4qmg5FoJIC4ZD5ZW63PlbnmtjnLjBi-pOKlFp7OweE_JJ22Bb5D2aKUzr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvzZXa-ctmAe6HjS5SsdRdpvlBP3MX_Oi7VdfBQYz5jEw&oe=69A41F30"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OQV0XDDiR4Q7kNvwFmxBYv&_nc_oc=AdnxLFy6Vj4BI03PQjDx8wvVX4yJEccMImNkJFz3_9tvY000xBLe9MiL2r-BAWbGCRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu4ncU9Pb3l2Aq_kPWRji1AaIZNvvB0HJyIeUZiQqYcJQ&oe=69A4443A"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DSPSUxH_qEQ7kNvwEK_TA9&_nc_oc=Adl-Xtv1wpSTifrd-Uf8Gs_PNts2F_04jIj96Fs0Echbn_e9294kqCJXT2LGQSK0qHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv5dUyRQOYAIe5gVb6XgdpVJwy-dGDbAygfQjTkndkYMg&oe=69A4409C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsVKhQDFOJMQ7kNvwGc6GT_&_nc_oc=AdnyvgLkBsU5QrFsJQNiN98eXK6Pw2DaJ5LCNdlqY-qnCesdSsqRzkhlhg4YrDsTBmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftkn7QS9FqKcGPhilqcro8b0EZSlOlizn_OxznaMG4YlA&oe=69A44832"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9PFaEBgLcMQ7kNvwHDINYg&_nc_oc=AdlbHC7A-SB__jt-559otbxmg-RrchnqtKL_nzvR4OwYrmsO1zzXJj6P4vM8ff65grM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculu
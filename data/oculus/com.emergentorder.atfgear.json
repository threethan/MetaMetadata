7dbl1BOuOMQQ7kNvwHyuwVY&_nc_oc=Adr8tYs88v1oBQ3lkYfcIvRzTsTedf19nehYU53xDgAL7SIjyKUys4S3lXvDu_Iqsms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa9_EfvAgO2py0AJBeFKIciBZ2VXAtZZFw_NxjX_OXGw&oe=6AFDB132"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
&_nc_ss=8&oh=00_Afyn4MiXWyFGzM4Fn2xVL2PdD2h9GvXhg01paLluJtiWOg&oe=69AC280B"}, {"file_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scAcHHSUGZ4Q7kNvwHnkmn3&_nc_oc=AdkWK3MbTLfQYZpUI0zn172jcHb3Qcpe2CGZPmHE2YneA_--o6g3vFkPNHX26iTvfSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzooPbulLFjCSCk1PAiexoe7dIr3_cE1BXby-ZT9QeOAg&oe=69AC0830"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdQyx4q0lAEQ7kNvwGGfOU0&_nc_oc=AdlJum2uWXS3oj6xw8d7YD6OYnG-shxYdbMu3GvOopE6Wx1-TTBch2T4FJ6yUHzrtUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afysj01Ndoi785QgP0LNXiHgufzwqdkc0wtNuEZt25VBxw&oe=69AC2D3A"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG76EzT5tOwQ7kNvwE0f0ll&_nc_oc=AdmkQWEWEh62oGubL3Hkf6GyL4tQTM4KSvsMZsAiYirLy9HXelcmPEnDKM1iwwGpFBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXKj9Lz6HDltlgVO1fw2LZrKgZFDpm3CjxgGALyFUsgA&oe=69AC299C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3Uxujz9G_sQ7kNvwEBfgK1&_nc_oc=AdkHGkhyaYWxNjBq6qX-nbPBkv2b_37nCW4JxO7K8ZxZPsOkrGdWviJFxRBwOEBMkg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4S-OJW2k1Th1tFmJ_Oi_yL2rd8KTAmkmDW_BrmP2IwQ&oe=69AC3132"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMp8CnYQIKYQ7kNvwEM
ile_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLmv2b5a7jYQ7kNvwGWH8fr&_nc_oc=AdlFn4Nu3wLq2AAmw2QZkPq1LvdleyweV1u6GiXzKRcMVkkhPwBrdHw2DpfQXQBuO6o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuVn_pIjUVxOSIgIPUXiC6IoQg1ZNErB9TN0nL7aoCIGA&oe=69A17C30"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBZWZ4E_xhgQ7kNvwHkPjN8&_nc_oc=Adku1o65p4cvImkNI9auP9MARcDwPxuz7eDTub3DksKEdyLspTSB4E9dD-SYLXNkDfw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvfZUbsIg-mv5Oq_40toQfrs1fEuZ5laL6fuDq1-ocovQ&oe=69A1A13A"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DSPSUxH_qEQ7kNvwFflDsM&_nc_oc=AdmEvG20iSOmEnVL48suZjUqtGwtz61_5oUUtUs3pk964jaQctv7qWLX7kpMsEdA3wQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftQTW-brVfzbWVFJ2rSmrta9eib7NPgUfuh4ScsXJP3jw&oe=69A19D9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsVKhQDFOJMQ7kNvwEnL3y8&_nc_oc=AdnMJ5VlA7-BcnLP1CiyR2pmwAPrLiyh4RJO1T7Igx5ZIrk3wPp7J75y9NMCim9rAhc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsflHpCD00AXOqdyB2pnfT__oRkLFXywbFFXUc2gajL9A&oe=69A1A532"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb--GaqTFwkQ7kNvwGhqxpv&_nc_oc=AdmjATlLuE74ZkYvlSCYS34Re8sXqRiFjHeq1nDGsiQ3FyxSHteWCXQd9YOKtPGH0XA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculu
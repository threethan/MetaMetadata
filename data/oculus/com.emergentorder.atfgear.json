&_nc_ss=8&oh=00_Afyz9TAbfCDpV0HtMGavxUYuabC9UXff18lVIHVb45CT_Q&oe=69AD798B"}, {"file_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scAcHHSUGZ4Q7kNvwFtLlwu&_nc_oc=AdnvUrTHgPLfiw3Qmc64Q7dUQMDDsJlanBYaRgcYU56xvkCMA0IIQWAmUhFdXhI6-1k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdWrioWgnaKHbRW8_tXVNFV-ps8sie8uM5-vFdSSMPeg&oe=69AD59B0"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdQyx4q0lAEQ7kNvwFanDq4&_nc_oc=AdloGNkmCVFplybdoZvnD3FXRRj6mY1STsBR0XjW3PXHtkbry_khyZwkPQeHqgBTaOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy81itQ7BWbAI50gFR9fijKpQzGVm8fwyZ9reUu2yisuw&oe=69AD7EBA"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei70Ot3Xn5MQ7kNvwF1oYIh&_nc_oc=AdkYHTlFd4liJ7ca_k7uyWu7WctohfbzRhXb-E6z911n5gYI6bAd--7gfTtZ-WNz7lQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHFP1gpCqU1t-EHwQWeGhnXJJVDZay-B2wy_dy7O_U3A&oe=69AD7B1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w65bjxN7IPwQ7kNvwFq1ecV&_nc_oc=Adn9PUyURlceV91CMBozqp2Ip7f9esJNuLKJH857x4EQndxXQ8-QSSIS7eZgfVSpe0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1AIfbkeE3UBUAmI2VyW5diAMIHNgy9UalC70s28bERw&oe=69AD82B2"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMp8CnYQIKYQ7kNvwFI
&_nc_ss=8&oh=00_AfyEp1o102893SDmc-ZodP1yNl0hPVOh2ab9XnYLtBQgPA&oe=69B01C8B"}, {"file_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlb-xaYamrYQ7kNvwHEsG8R&_nc_oc=AdmDidyxoKmRDaTjoNtk6LPiiWEMkYyoiWBA0H9TJ06TEMVnGLbWlGpVR_KXVQvt7_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQDFEezRlFDvTDWIVaVM7-zk9HWLPGWqPb_ou7KeB1mQ&oe=69AFFCB0"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myeFvux-yN8Q7kNvwHsXcf1&_nc_oc=AdkyWj9YVnilpaOj1sd1L6W7ZUspKs4mQ2GQMqGHA6dAFMYu0yPBpcfO9_hBRJlGs8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjHuV0iYOkoshqcHoOcEgEHEaovs3a93pg-TWy6XjtjQ&oe=69B021BA"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei70Ot3Xn5MQ7kNvwHgyG9u&_nc_oc=AdniCyDtqF_wR0Z8or3pcHJzbKmncVQ4cQqiNPOaXkKceOzoX6u-OSjKP87NjqznXwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzru_FRCjvSCxQuK4Z1nVmHJ6TNiwE_4lEWk_tP-sEhLA&oe=69B01E1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w65bjxN7IPwQ7kNvwFLITjF&_nc_oc=AdlAeqzp3I-jSUlRmwiGYwjRlzXZub6AmaY4msQyf-w8xKi3IIALmOiz55FgD5RTnpA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGLSgsyr2OOKbTuRuyQQIo6WAbIHoumLrNc5E8S0Antw&oe=69B025B2"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5pG9r1MkawQ7kNvwE0
ile_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lP6VQclp7wQ7kNvwGpwKw5&_nc_oc=Adni4OaggFT0uyv5QZbmwYbkdF_SeiZ1G-E1heP2C_xu5eAn1BRMhSXsjYpSptGNssY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvKHyE0MhAfWAIwzjU5ytgVQpvSppuYI3eAvErRUJ2O2A&oe=69A570B0"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OQV0XDDiR4Q7kNvwG94Ilt&_nc_oc=Adlz91k-MoIgSstA1SwDVW8CQs8I7xzibk_mOp2RFvWTC4C4PShABlET4I-9ii-hqG4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftC_FvhVZwpL_sf7tp_CYzTP8gXRuLIj1FUFu9IXrnF4g&oe=69A595BA"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXuig6ILLrYQ7kNvwFeJlI_&_nc_oc=AdnQ6upmWyjEF2MTWYwnO3R3LvGq-Cdscd2UFZG6JtQL2AoBCGGq1p28hYapnDAw2UU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuEhw5a3JEQ9E3FOzCwVPOLCmoC8smtAnlu0NjYP3v1tw&oe=69A5921C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8OTPL_ASlIQ7kNvwEL7-GI&_nc_oc=AdlGVKgkV22wRklDACDUNPlq1T_kG_zH16v5CIIKbVcXCFBjerWb1NXWVgBBMMai7fM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsZ5xlPEFQQZodM0tz8N9utNttlbJIvmYc7g2bX_uPeWA&oe=69A599B2"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9PFaEBgLcMQ7kNvwGcZB_l&_nc_oc=Adm_Ty1rUpZX6HHVo9fHNa9CB0ei_JCOuWk5NV4U17qvXPGflluLTIEvbK-FMqtCPHw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculu
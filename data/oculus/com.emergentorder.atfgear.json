&_nc_ss=8&oh=00_AfzBjdp7ssftFUdOiOl3-xK57thKaTOcWvcaeKGhgnL_Sg&oe=69B2BF8B"}, {"file_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzAZMTRy9xUQ7kNvwFdpNJY&_nc_oc=Adm12vFJiW09CenYdnJ6qt5W81UQrju9zqYgKYYcDggGnmkDztAwVjb2qxVfP5ULY0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxmf5NzWo5L9iTZxXXjtgBR8vSM7PRJFZJ8tNlbb_5b8w&oe=69B29FB0"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myeFvux-yN8Q7kNvwGA2k5t&_nc_oc=AdkmjL_p8fqhZHCTYYR3-u9Sarkzr6CN6iGW9-BC0uewS5ZYdLsP3ZWcalU_RIgry_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi54K4__qma1zAvyKkktsQAAX8HxtmBYZldfj-Qyl6-w&oe=69B2C4BA"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4JC-xGw8PAQ7kNvwGAhud8&_nc_oc=Adkb_HOhNp9hYHkcaAeOdQI0_PI_bAt5Ie3VocUtSQH3fOOXhFCbUrgtDyDjAGugVyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-z9EClcJzohX0UA1KqlVehpivGKUFroK0bgKa4j1Yuw&oe=69B2C11C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSJVUbGxkN4Q7kNvwFPzVb5&_nc_oc=AdnOs7eNfifb5ZDnVQodw_g3J-YdQwJ5UMoNbf9CfBy3nC9hX50iwwyZe8lAZkN4JKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxvm5-YN3AcCGUNXbJqBMmwtpvmqRievQBuCcCpAlwFUA&oe=69B2C8B2"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5pG9r1MkawQ7kNvwE7
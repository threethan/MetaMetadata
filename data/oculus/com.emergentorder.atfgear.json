ile_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynSFR_5Y9h4Q7kNvwFiZ4fa&_nc_oc=Adr6Te5LT8XvDyrcKO-jaPxCOVr43yvHl_NMwT7eBTt5skvZd8EK-oEgGYiGqinqC0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0AiFP4OAQNTEfVgQGZtJTaIqEeL9SPtbf44vW3fx_Iyw&oe=69F0CE70"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTOGNtXSWlgQ7kNvwEcB87q&_nc_oc=AdoRPTT4PhgGZf23amuN-h0d6keZvyHouWJl1ARMA-Thri68wSoHbc6GcRjOtAkbf4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0jqCan3iNLEa-vOEboqZqWJmnyhdEhWY_-DRhP8-Uupg&oe=69F0BB3A"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUtYTQcSpREQ7kNvwE0t-6M&_nc_oc=Adr-4ZaKu-GedNFWAMCbj7UohW5hWYNJ_XvCyjAp_IO9rDRvy3xz28EGEDJuDFMnCWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2-fmPY-XAN-W0OG0M_W5MGBRt8sJ5KKfZJ99rXzuReNw&oe=69F0B79C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDGWQfkK21MQ7kNvwHLqgQ3&_nc_oc=AdpQ6hodJBmjzUd7wS7zn6uXH0L1JHDmtXMWjX-KcE4_rkYiJ_mLopslZLp9TZg2y6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Za2CbJWrls6V6VxNEmRgH7KonX71KokfGIV1IjNuiAg&oe=69F0BF32"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XnTXnQ1vV0Q7kNvwESVAph&_nc_oc=AdpY8T006S-aAWIkgCoFOsskupX2yyU5LLtrXJZG4s87d8lfjFByrta2ZY4GLanL0Lk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculu
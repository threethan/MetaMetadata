ile_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DelHdY3Qd28Q7kNvwFDqIaw&_nc_oc=AdmyKtQevBgCG_9JxxDfVZtM63_qG-a19pUcSHZhfoc5-oIsdEd_sD8pZhwaZgaMXpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfscbL4fe_Y3Uoi53DQYBBpMBei47kz-yuUm-8cU_jWlqA&oe=699AE4B0"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86mxZ-oFs94Q7kNvwE5JCsl&_nc_oc=AdlOIDbFor0ZQTO2cRUUQcK_4Fa3-QyXwL2TPBz029LT4hs3j5D7LpP9F78nvcMAEIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvu4uXnraBoIpcazJPz1xNZ-5V25Mhl72erSlwbmqEbTA&oe=699B09BA"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpaUg7He4-EQ7kNvwGDna87&_nc_oc=Adk1HSAEG5XhdZFxtNyTIpO5xBCLAXiA64h_YQUI1OmPqLaakX-HSt-ylW33uJi8f5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftpN0biZIjiB4pMvpgmNzVx0mF2IHL69CjRgvSLNAx1Hw&oe=699B061C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezB_befPAlcQ7kNvwG16xpe&_nc_oc=Admf-FIIMRZH8c2Hg_aVqu4A6Aodkish_tPco4yDP5cvZAw9wPIiq2VHC-F5Ke4INVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsM6bUMe8Qz4M040HgicgLTBBAwafLAXaNfg277_IAzxA&oe=699B0DB2"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGBXj6rrM64Q7kNvwHCd63Y&_nc_oc=AdmuZczHhS6PYBxcolGPyjaamxBDWyKKQSqM1h8Uj1dsNuPKO5_D9po6U6New9j5H_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculu
ile_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLmv2b5a7jYQ7kNvwGIGab2&_nc_oc=AdleR4ap2DWhL5Qm3AMb_mxME6jLvTIIEKoONdMi5MyuTiNZdBYSeGmHrWg6PS49DBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvoW0_qADx3BjHn1gbZWsNm1ao51EGdDDQWQ8YwPHykHw&oe=699ED930"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp_G9Cc48IMQ7kNvwHgch22&_nc_oc=AdmuIKu-W-bxctH1IbYEcr6z60wtH8VRYeegiSJs6c-EGmwJYH1duHt35LwJodLQJ0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvhqsfFVZbIAdCt4wDthy2qW1h2EXTiQX9fP-Lq5R7prA&oe=699EFE3A"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKE2qIXzcjoQ7kNvwH3xBjP&_nc_oc=Adng-cZobdJiHgUfZ-qX7CXNm7bzJEVaF1cNiUb_aTX4munBN-BLk-CWs-PeahbdLds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuNQxuxBMi-mlYG5Wtkx8PtDqCwxU1Y4sKFVYogk31qpQ&oe=699EFA9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpo-VQILVyIQ7kNvwHiL64r&_nc_oc=Adlmm3IGOgkpGlilUDh--tAuzRaIpvGbCbpFomib-wtZiq8e8PUpj9ahLI18xa43O5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsUEXwZSel8Tog-05qZTLx8P9PBlqH8ohu7L_aKdDnxwA&oe=699F0232"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf3BPK0sOv4Q7kNvwHs2VZv&_nc_oc=AdkyuAHdSMZ8hP3Igq99pvhg8wLLbXkAiFY_BHw7-RKUsjm4OOebKlzuO3G-uJpH08E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculu
ile_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqReVLtGLA8Q7kNvwG2Y80I&_nc_oc=AdnhJSkiTMw7la2JElC7GopGtN7ml3IdcYorLKPR0qDL0pQEkD5sAMJe-J5oIaa73t0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZXtH0sLFHjjAGDS0Ud6f7ccvziPWZ8xfaFnK7BWGi0Q&oe=69A6C230"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OQV0XDDiR4Q7kNvwHxsZJG&_nc_oc=AdkQoLeO8bdgL9jOUsIBHrM3pZWHXujc9oDduzRpUIbPANfvfLgM7NqichKpWapMdu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftbxwyW8qzfo9vx042bDawxSo6a7MZOG2G4pdgEUgeOtQ&oe=69A6E73A"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXuig6ILLrYQ7kNvwF-eAuX&_nc_oc=Admcg8dBUh1kgsyoD_baAHqsdvrUMtadgFfFnvzv7ue-3i0sK-UxMvkUUmZCAslYCPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBuKJ_Diqy2oSs099KP4jOnM-wQ9odTQ-qR7xOkzfuyw&oe=69A6E39C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8OTPL_ASlIQ7kNvwHV6SsT&_nc_oc=Adn_wpaB1UL9HiCFpqOTymwYYZbB0WKtbiR027RTWHBG_FVOldFkxk_a85ABHRYHIhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiuzYbQ-evGn_6FCe306rZvv6-CSP8bBOMpdr4492gpA&oe=69A6EB32"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9PFaEBgLcMQ7kNvwFx9Fd_&_nc_oc=AdltZ7YDt6c4I9-TiqtD1GSobflWLfkNplSFbBhrPdG79T6Brj8tlmy-GmTF3inn8UI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculu
&_nc_ss=8&oh=00_AftPZKC5Q2Ts4dJru-pDNxtkJPL3snWLdnEm27U2zjM9eg&oe=69A8338B"}, {"file_name": "migrated_image.png", "id": "3009490132435980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410472_1674980509496220_823431702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqReVLtGLA8Q7kNvwFnr_QC&_nc_oc=AdlUok53JwyTUIRk_c-dKmZgDxpHfZnP35JmP3lWTMPN_KwqKRD07dAzafzA0isMRjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftMRhsNbzel6BJpHapmTtsD7BLXIZGXBm-gpjnHf8Kong&oe=69A813B0"}, {"file_name": "migrated_image.png", "id": "632653994183019", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386320_1598762223763914_435437841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8KwuOe3GgYQ7kNvwHsNnD2&_nc_oc=Adm5QInmfY8KcWUmEW1napsc2LN3PmCv2CU2vXUoXoV5M6Y16S4XPbSUm07qvXhejyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsuBD-qiihVj0CKPZtYj4k3-kECkZ_8egPSs9FBwiHVew&oe=69A838BA"}, {"file_name": "migrated_image.png", "id": "540649460180625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162822_564878257031270_2143839424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXuig6ILLrYQ7kNvwEdbzMN&_nc_oc=Adn5dOpAXDyRYOcxwESz_sdPxzynijgdTqICyKf4ArMoxcKOfVdW6vuGKoMXlgba2IY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft4WdlKh_inOmAk5fQSO8anZ5SCIkIn0yYkRpZroGAIIg&oe=69A8351C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "284509491931159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386359_284509495264492_691678239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8OTPL_ASlIQ7kNvwE-42GT&_nc_oc=AdnSl1y6Jz6V9TEbMaK292ZG795R_o0ysSKvq5SZg3gNPEZN5dV80RSVyVxlNI39rOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFEcSqMqRWI-IRQMW1Q6In3K0O6amNsY6h7i1MPV4X1A&oe=69A83CB2"}, "display_name": "At the Fork VR", "keywords": ["animals", "farms", "video"], "long_description": "Download At the Fork VR and experience a unique 360-degree tour of the farms and enclosures featured in the critically-acclaimed documentary film AT THE FORK.\n\nChoose to tour the world of animal farming with filmmaker Lisa Versaci, or explore on your own and visit the farms and enclosures that chickens, pigs, and cows call home. \n\nAT THE FORK- In theaters July 2016. \n\nStarring: John Papola, Lisa Versaci, Dr. Temple Grandin, Wayne Pacelle - CEO Humane Society of the United States, Terry Branstad - Governor of Iowa, John Mackey - co-CEO and co-founder Whole Foods Market, Mark Bittman \u2013 author and former New York Times columnist.\n\nFilmmaker and omnivore John Papola, together with his vegetarian wife Lisa, offers up a timely, unbiased look at how farm animals are raised for our consumption.\n\nVisit www.AtTheForkFilm.com to learn more.", "short_description": "Experience animal farming in 360-degree virtual reality with At the Fork VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://emergentorder.com/", "developer_terms_of_service_url": "http://emergentorder.com/", "publisher_name": "Emergent Order", "support_website_url": null, "website_url": "http://attheforkfilm.com/app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "486427632951158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386282_1770890926510966_700213528_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZkNxCvvBJkQ7kNvwHm
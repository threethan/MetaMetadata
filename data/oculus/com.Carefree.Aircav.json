"keywords": ["helicopter", "military", "war", "shooting", "retro"], "long_description": "Lock and load! Prepare for non-stop arcade shooting action in Air Cav! \n\nTake to the gunner seat of an attack helicopter and test your skills against enemy infantry, armored vehicles, and air units!\n\nAir Cav is an arcade virtual reality shooting experience that places players in the role of a helicopter door gunner during intense combat scenarios!\nPlayers must use their reflexes to fend off ground and aerial threats while completing their mission objectives.\n\n- Air Cav works with hand tracking and controllers!\n- Single-player arcade action!\n", "short_description": "Lock and load! Prepare for non-stop arcade shooting action in Air Cav! \n\nTake to the gunner seat of an attack helicopter and test your skills against enemy infantry, armored vehicles, and air units!\n\nAir Cav is an arcade virtual reality shooting experience that places players in the role of a helicopter door gunner during intense combat scenarios!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://carefreesoftware.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Carefree Sofrware", "support_website_url": null, "website_url": "https://www.carefreesoftware.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8527244210647575"}
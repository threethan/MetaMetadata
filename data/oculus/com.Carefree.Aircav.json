l": {"file_name": "AirCav_CoverLandscape.png", "id": "1315818315968365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269596_1315818319301698_3356351268899899507_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xV7d_b4uh0Q7kNvwFh39Mu&_nc_oc=Adr7x2SPbgQWWr9H-yp6A09IBa8wlLyK2QTbs358NcxCuiWlKD7eTZ6_I5SwdNRPwFA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKxqDFORrCHVQFa0Syva1ieGTngmZ0Z6wXcc4K9_GBmQ&oe=6AFB4A19"}, "display_name": "Air Cav", "keywords": ["helicopter", "military", "war", "shooting", "retro"], "long_description": "Lock and load! Prepare for non-stop arcade shooting action in Air Cav! \n\nTake to the gunner seat of an attack helicopter and test your skills against enemy infantry, armored vehicles, and air units!\n\nAir Cav is an arcade virtual reality shooting experience that places players in the role of a helicopter door gunner during intense combat scenarios!\nPlayers must use their reflexes to fend off ground and aerial threats while completing their mission objectives.\n\n- Air Cav works with hand tracking and controllers!\n- Single-player arcade action!\n", "short_description": "Lock and load! Prepare for non-stop arcade shooting action in Air Cav! \n\nTake to the gunner seat of an attack helicopter and test your skills against enemy infantry, armored vehicles, and air units!\n\nAir Cav is an arcade virtual reality shooting experience that places players in the role of a helicopter door gunner during intense combat scenarios!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://carefreesoftware.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Carefree Sofrware", "support_website_url": null, "website_url": "https://www.carefreesoftware.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id
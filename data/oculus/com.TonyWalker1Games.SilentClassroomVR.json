.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bppVAxbKBZkQ7kNvwEDKXjR&_nc_oc=AdmKUHze947vQltWHAEg9aWRibVlk4Cw-5VxfAaFo181c4Q6JLqw11eS4nHa1kd9TMs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuoiYa6yyAL71-u1HnMXErbkq4Ng0kxvukMzbB7SQa16g&oe=69A19F22"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1exjZGY5zf4Q7kNvwEwX83y&_nc_oc=AdnBkO5znMpOIY5oJNaoAuE7eVgtDIjZA7krQDXknCoFd3gEH4agfOo4t-a-n1qAPXo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftabAcf2daWEuB_azq2-DOygUJlx4cHN8FKOtgWNPRP4w&oe=69A1992F"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtlaaQpW_xMQ7kNvwHkezlw&_nc_oc=AdkIFKZZ-zweN7mZGFgbXKg3JcyrA1i3HHTjwr4hRchIJTYBqIpF6ZXSNpivvw_yKHM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvS8wvp1qxt_CFR6pDUMMfmtOKszKDGu-lOeSJqG2PGOQ&oe=69A176D1"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1LgqWuZ2VcQ7kNvwEuoRp6&_nc_oc=AdnXF6lNmo3Z7fe73JPf5lKow-jwTUWDwBY2Fy-MHahyhxL3dlzVHBLftfTziL-xygs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvSUJ20WntdfhBI9zq7ii-zjO5LUHx_-QJ85yUUphm4AA&oe=69A1ABB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu3xhbYQ6r0Q7kNvwHrfEje&_nc_oc=Adn8FZ7cN-Vc1vmtrANxwo1KAqrZwpMvjTYwQI5nn0fNgXdgJ_NIxNfj0JfyLHT7NRE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfstDlUumLXGcMo72RXrwdaydgKcCxv6CT8A1ZCHCAzu5g&oe=69A1943A"}, "is_concept": false, "is_t
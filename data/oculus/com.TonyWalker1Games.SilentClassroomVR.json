": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gR_vAAOVo7MQ7kNvwGy9SgB&_nc_oc=Adq4rWI4NdZvujU_iMuyQ0h3AoGz1u50xIBjAR8Rm2-oaZg7-CjawXtRtUyr43XLnyM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sAL9hQ0EWidk2WTz7O9ZMDDFtrRfZAew8e8Jfneen3w&oe=6A1AE922"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5h-HWD1on8Q7kNvwHK8hpp&_nc_oc=AdpUiBN6GWS3EsEHxobRD3vEETbjkKL7wfCfHN4FzCZh-UdcJnvesKKf3_5VKYrsoGk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wM52xrtubCw-MSaCpVOZZoFSwRIKn-Tkr1bMWJJXZ0A&oe=6A1AE32F"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAfKiW2Pgs4Q7kNvwEDTSnF&_nc_oc=Adr-giXOSZgbgVl72DSyWqFVOEUvxYnnP_ScxJU4nLBEezpkpj-eKi8K9oJ0Il-Ti80&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y8ofsxzjBWwgW_4k8Pi7DD0VEZehbhaTvhTg02xMLWA&oe=6A1AF911"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj6cZnBg1WUQ7kNvwGunggq&_nc_oc=AdqPQ5mCl_CLpGXvxs0hqq3y1arkcj9HKNBLm0PVDmtLs-2k1-MrRHVedWGEBHWgvmw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CFrvBnhGKWU0N-RdN3vWnZRoSDbjB8S7WvQ14gp5TXg&oe=6A1AF5B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl1HAzTvCzMQ7kNvwHEL8rE&_nc_oc=Adq88LxP0zkltkfi_jlAXo-aqd8O2Lo5DvG23KbXgUSOpwfZM212
": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3L9hAFg0HUQ7kNvwH42dZ4&_nc_oc=AdrO5H1s_YPOyQZCbOk1Z5hzqgyfbtYjL3R4qsnJ_qxrGV__wxD8hq8PW40N7-vrOK4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOUDZWL4mV9nu9-1AS_7oiuuYMXkPza6RXqrbQHDRTlA&oe=6A943322"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWkrsB0o_BIQ7kNvwFurwww&_nc_oc=AdqpviCoKJTbSawQ_ELyK-hY5z04Bmst0K2eEYItQo1H51IZXPEwK1WhviXlVmr93B0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX4S9xTPqnJihyhbVh2kTx3iqsm090aw7REOVwL0W6IQ&oe=6A942D2F"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDKwHpQREnMQ7kNvwEqvqXm&_nc_oc=Adpt7FWpaSW_lSHRumxpI8ZTe0AUP48f-5x-PPCtHHu9069CUXiBEhAw_AlNJuc03OA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElN0v0X1g49I3xwwgXyj8nGDjBd_aMChrnxsNkt_mrJg&oe=6A940AD1"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lolr5PKbwqAQ7kNvwFU1lfn&_nc_oc=AdpcxyL3MI7ArHI_zrnRaXEztymqw_GthlVe3LnwGeEwdaNWYFeRWIHchfDNuXzSO30&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyHA_NjtCdr4cO8MTwU-Qs2MOve89ZYN9_DbBUe-Y0GA&oe=6A940773"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAcxKyl75k4Q7kNvwHbQWAe&_nc_oc=AdqF0aRfJ-fcdJ8U9w8Y8ov0t1pkrSGCfngcWQ-TzKr3TbqlzfPs
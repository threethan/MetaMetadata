3", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNo5yyyszo0Q7kNvwGrqw-x&_nc_oc=AdoI-OMIJIQyYSQVPLbtCAbEC8aDL8_XzBTYe_OP8RJFk-vhRhwbGg_QQycZHvKQTXw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBysXM8lslX_mChl2C1-1XXfBGjPTsQ8TvMki4EzRXOQ&oe=6A8EED22"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SShORoxVbfEQ7kNvwHD-iFB&_nc_oc=Adp6cyoADQyi1SMS1-dV5v4D7jgGqpt71H8QYx8A0ane2s7ECt5GTTsPq_t9tuiyqRQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9k6_Exb18YUBau3puYujX3gWGOsdUC18mOb49IRcveA&oe=6A8EE72F"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn18H5zxSdoQ7kNvwH5G5LF&_nc_oc=AdqgiF58Ddzgg25HI-kS8pzewats1BQafDwMZFJWhzeRAk0hZHEmWOPTJgrN3V1mG6g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2YBtwbtfq1uA94hLPmJJ-NbIFZCehRHOWNd1RPn4JUA&oe=6A8EC4D1"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H5NFiGIV24Q7kNvwEgPEEP&_nc_oc=AdpSp1_KALLNQAwt33y-m0a75bUQ-zmfBeJxI8Tx4pbZPLRog_tFO9HKf3EH7zlL5z4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5q-20LDpXMsaSY0ZB-2-9Kz8CF5whO3A09VbbGC4vDg&oe=6A8EC173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZADisIdW8RkQ7kNvwE-V7uW&_nc_oc=AdrS8-7ZeFg2i-E6LER3cYSkza3XVUrzutsaB7U
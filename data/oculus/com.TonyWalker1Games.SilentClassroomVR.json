": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1Iazkwpq2AQ7kNvwHgTrqb&_nc_oc=AdosI1CySAutZXpegngNpj9nXwHnbizpelpr_ORMdlmzsgAzMru1muF-V8wKiez1XE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AQrgYrfJvSMEVJmWcqxeXiV3YLtqbLjZYpGhv_uU5XA&oe=69DA4FA2"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwWPCqP-1fMQ7kNvwHlI2GN&_nc_oc=AdrkQqzzfoFhV6W1MvWG5oXXa1LgBGU6kYWjq6W9iINyg6TIdcdJD8CfXmFvO1T_jM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yyfwwKb-_tk3J9MYrxlCtxR195yXRvQpKVLKfKziAHA&oe=69DA49AF"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3RqW-dnfWMQ7kNvwFHqTWT&_nc_oc=Ado2C7HSOUY8Kp1BzljJvDJwdc0nG1Ab9sQ5BBN9mwgfYojtXUsAMmCJXmkLjkWNlAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af168f6uucYUyZ799PDTI2QU3C0G6VjJGVPuwiReuI8xMg&oe=69DA5F91"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuO_KfvXkYEQ7kNvwFekTOb&_nc_oc=Adrigw3dABWwHVzS0XVhWHMZgdRemto1Or7VUfMwxoBJkoo8KX-oHAHSmM7iHeF3AEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_5bfr4fZBpq9kG9Qmnqq1F4hHquVIZWGg8e0rERskpA&oe=69DA5C33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IPM8JMnqTsQ7kNvwGNJfFe&_nc_oc=AdrBr4e57TVxVRvraduIbkUWTf0iG4TvxDX0Zl9wLgh0Puvb6Rj5
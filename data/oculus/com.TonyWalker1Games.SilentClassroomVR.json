": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3ziUR_SW7sQ7kNvwExfpNz&_nc_oc=Adq4ADvVTXLtXAb097K0-boWCIZYctYIZJpc91y6Y9fpOBOBFzp8AbkcXTfzHJlWmsA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fW8V0M1Dqyvv2sfeNX3iPBUPs6u9ANZ4OSHa8zw91qA&oe=6A33F5A2"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOjsybqFAiYQ7kNvwFOYOL_&_nc_oc=AdolC7DzNYOCgocaU83nMgwuIiDMLInADWgigYF7M3qXu8xQqGhO2KPdepspiqNHwrg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nha6cGOD3kjT83CPzodNomEA9dzEccQvNTOPTsZhKfA&oe=6A33EFAF"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_Y5QB5rd_kQ7kNvwHRpv7J&_nc_oc=AdqMRoRqHYAG_T2dto1uaQW_kFkWZdrgR5mUXGKQXHA0Qg3FDn2iBwzxMJNNQ46nkcU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93vgu4gACLsoZ2ug__H-X3oZZpksb2b7I6f60cfKUcfw&oe=6A340591"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wzyDTHpWMYQ7kNvwFE8OkF&_nc_oc=AdoJ0jnm3W-vKJpmG2tXXe3aXkjG3j9DjhBmjGa7FoE4KOU4uB_Nd3YvCd82Xo-Unt0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af916_tmFfl9eC88yPe3DPSPDxarUjFsTy4JsrAkHgOSYA&oe=6A340233"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DISA5tXcp6QQ7kNvwFVLorY&_nc_oc=Adr1yslQNgGv30R73VRH_SlTVBcTGfhp6GKOMg9LiJUJ8XKpdAnN
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGVtTduU08eWg__p_ROf0Pp6g0UJuqjg7wHXABcLubzA&oe=6A622A11"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHHkmhKAkJIQ7kNvwEWANaI&_nc_oc=AdrGsSgWPp-y1lXc5m_3rYKSu23OZ9CKa2vuN6Yte2dNI_crknLjO5mKLJ5qiB4YIx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPLOsXGK6jcT3a-KQCokm1pssWYeFRYCrjxQEqysQg4w&oe=6A6226B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHoikwspwH8Q7kNvwEz7oCZ&_nc_oc=AdpN1ubpYLi4Vg9VYqWp92GGljSuLCPWZyzfD3KLJQ6sN2J0PK0YSNLSeHcj0btSpR8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wM4axr1ipZDXN236zee0nP4DtsyQffCy6MBfnvdoLGg&oe=69F5FF22"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hH9IT5xXwQQ7kNvwFj0275&_nc_oc=Adqe5JxRUWrMbDyhcxKBKn_swoVWtWzp9-IAy9C0WAv7f6Ds7NSNk4Q98jdTECBcqBE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1n1AbEVXXhqx2Fho0Kjh9bZ4i2-laDLgP8iO_hly5zzw&oe=69F5F92F"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4ku1kLjPdcQ7kNvwHnif5v&_nc_oc=Adoygr0m3OMmttMMzmc7iU-0Rprv1LMvhYd9Hp8Llx_nHRCgOUV5i137IXvzcWvyF9A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28gMH8RNfrBw7gcpULtd7EjAy7TqcCHETGYZ3cRXD64g&oe=69F60F11"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZW9u4RO_q8Q7kNvwHKPzhi&_nc_oc=AdovhGbJHrll8o_a5Xr3u7M0YJsrCP_Sf7QsXaDxLWmSevXzDlEe0QaRjOZJRDn7-U0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MITzV7YcXb5CjI7T6HN_QlzEKZDXHT0-zjw8mXDgi-A&oe=69F60BB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e1CX3FPvJoQ7kNvwEfWwjW&_nc_oc=AdpbX9ltaVwZjSHWz7tspEeJYWgwzsufmWvvZfjlC9eC80jgap9S
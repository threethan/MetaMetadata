uscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SsTI8ytCbcQ7kNvwG_GgtA&_nc_oc=AdldaUmjH36A1dlsq-e6rXfC-gBxAdVvqFR6_lLFE5zkG58tUNr9kgocKMZT5hE4YUQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyzds8je5JnsMUpxK2qpwNkc7RZcchlIG8SI2Gyn55dyA&oe=69B2C2A2"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRj6d9EeQfIQ7kNvwHX4MOI&_nc_oc=AdkE7EMWrwzD2RFhQdaz68Huby_fWwpMQ0C2fLjmkYxq62-g4pOTeAhcpdI6MNt4Mho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwND5wSlJ7drakNlOSmS5n7mgSx24GxPPAm8IO_eHNgYw&oe=69B2BCAF"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtJzoBx5i-kQ7kNvwEU32VP&_nc_oc=Adk6gSAfu1rEi4fIjnBbrjian6HPqPJ3cVuNBK7fxXB0JLVEoal1IJemVuYTgx56MlA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEgn2BY-duRp39v7kEm32V2wMgMgeDGOsoOHuXgi_2wg&oe=69B29A51"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_A6t36USVEQ7kNvwF3UnNy&_nc_oc=Adk2P4dZ2a3JbjWbAJR2R1f8ioRD02dUsdbEpFQs8lPcP3Bgxh50LVHEzvXZmwwDpMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnWx_f6nzD0_37WyC22ICBB6KVJPl2GcofrLGpC0zHOg&oe=69B2CF33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HMUI9aHXG4Q7kNvwGfvBTM&_nc_oc=Adk2qREFmxNpnNFx0GxLxudMT0hyz0kdl4hNPDlVRMq71rP5DDYeQDZfUeLYcF0SeDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.
": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1025544559450046_2677999674249962448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3ziUR_SW7sQ7kNvwGH0l51&_nc_oc=AdqxLfHJLBl9lzOajUpN81vWAGnfiZwq1Aqdk1ZsUTJhNvHswhRbQFeZU2rK22Fs9QM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7eeB4MTAiNVcVBiuXbhlpTZ2PihzP-9HiEhk7BAompw&oe=6A32A422"}, {"file_name": "2360 x 1440_4.png", "id": "9273809236046283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393859_9273809239379616_2620264749314342791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOjsybqFAiYQ7kNvwHt2l8H&_nc_oc=AdolQ3w3fKIH7sH7pwabjsK2if2iaDt8n6PgWtcilyLgvMc15CtCKfvUK4JI_jsaBaw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vtik8IhPHTr93lOCTFqGC4OOmWyo56mmsUacI4RpE6w&oe=6A329E2F"}, {"file_name": "2360 x 1440_3.png", "id": "1078439320965502", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393941_1078439324298835_708805978502554255_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_Y5QB5rd_kQ7kNvwG9vsHp&_nc_oc=Adr4PMWHm22MoQ2IGPmKQK2qwHDVoM-JVoqs8ktlyRHpsMoCBE23FhGdZPVDfX1a-DY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0zPqut2qX5XG8WEesQNwTWJBl9mCX5JzEJbmbNrN9vQ&oe=6A32B411"}, {"file_name": "2360 x 1440.png", "id": "954102246848963", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391986_954102250182296_2281068713792418162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wzyDTHpWMYQ7kNvwGW9owu&_nc_oc=AdrhPn58ktV-1Dq-WF8MuG4HTKhCvIcmP2vE7hBvuAKH5FJD4_9P2NInB7pgcziAoiQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8iqIJxPnxvk0hzD0WFyZ_0qBDZhVffOkrCeIFZg97sg&oe=6A32B0B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silent Classroom ASL VR", "keywords": ["ASL", "Silent", "Classroom", "Serious", "Game"], "long_description": "The Silent Classroom is a VR serious game designed to enhance ASL learning through immersive interaction. Set in a virtual ASL classroom, players engage with hand-tracking technology to sign alphabets, reinforcing their finger spelling skills in a fun and educational way. The game introduces a storytelling element, guiding players through the history of ASL and figures like Irving King Jordan, making learning more meaningful. By bridging the gap between classroom instruction and independent practice, The Silent Classroom offers an innovative tool for students to improve their signing abilities in an engaging virtual environment.", "short_description": "This is an American Sign Language Serious Game that helps students to practice their finger spelling an immersive environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/AnthonyAcheampong/Silent-Classroom01/blob/16baa7379abf93df15f356561520298ddcdf8618/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Tony Walker", "support_website_url": null, "website_url": "https://tonywalker1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9293589494028074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391917_1193997769095678_3838509662883035785_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBuMQi83rWoQ7kNvwG5TpiC&_nc_oc=Ado5-k_742vu3iBDnqs6je-ckNeOI52iEixmgv9AYQXSjkvzbgxQ
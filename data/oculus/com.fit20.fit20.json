vVf2Nss--AQ7kNvwGyPVKO&_nc_oc=Adl9cS0SiWBvrdG3yo6vS30LgRl8PMV2op5h6wMCpd3P6sj2JV56L56MJdZpwbVKF2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCVKHw8TQ-aG4OmFCFTZZE9Uf9-U9_fOtgwq3H99uaVw&oe=69A6DD2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Train Your Brain", "keywords": [], "long_description": "Elevate Your Brain \n\nWe Train Your Brain offers an advanced cognitive training experience designed to strengthen the mental skills that power performance\u2014at school, at work, in sports, and in everyday life. Built with cutting-edge technology, the program goes beyond simple exercises. It targets the foundational brain functions that help you stay sharp, react quickly, and think clearly under pressure. \n\nWith just a few sessions, you\u2019ll begin developing critical cognitive abilities like focus, memory, decision-making, and reaction time. Whether you want a mental edge in competitive environments or better brain function for daily tasks, We Train Your Brain delivers the training to help you reach your potential. ", "short_description": "Elevate Your Brain \n\nWe Train Your Brain offers an advanced cognitive training experience designed to strengthen the mental skills that power performance\u2014at school, at work, in sports, and in everyday life. Built with cutting-edge technology, the program goes beyond simple exercises. It targets the foundational brain functions that help you stay sharp, react quickly, and think clearly under pressure."}]}, "developer_name": "Mastermind Cognitive Training", "developer_privacy_policy_url": "https://app.wetrainyourbrain.com/standalone/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://app.wetrainyourbrain.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "con
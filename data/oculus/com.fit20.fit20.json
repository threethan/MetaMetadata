", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499624074_1770160273858518_7513512401279240722_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUa-9dDukQ8Q7kNvwH0DRI-&_nc_oc=AdoE-awrxr8FHJkf9xDA1fKrOImDPQjoinLolY-yCrT9cNuO2VZqrpsJyK0_m4kg3k4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qoFALZHcxOMNnKV17Zq0VEJAKoprPHVDmFke4OSsR9w&oe=6A3933AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Train Your Brain", "keywords": [], "long_description": "Elevate Your Brain \n\nWe Train Your Brain offers an advanced cognitive training experience designed to strengthen the mental skills that power performance\u2014at school, at work, in sports, and in everyday life. Built with cutting-edge technology, the program goes beyond simple exercises. It targets the foundational brain functions that help you stay sharp, react quickly, and think clearly under pressure. \n\nWith just a few sessions, you\u2019ll begin developing critical cognitive abilities like focus, memory, decision-making, and reaction time. Whether you want a mental edge in competitive environments or better brain function for daily tasks, We Train Your Brain delivers the training to help you reach your potential. ", "short_description": "Elevate Your Brain \n\nWe Train Your Brain offers an advanced cognitive training experience designed to strengthen the mental skills that power performance\u2014at school, at work, in sports, and in everyday life. Built with cutting-edge technology, the program goes beyond simple exercises. It targets the foundational brain functions that help you stay sharp, react quickly, and think clearly under pressure."}]}, "developer_name": "Mastermind Cognitive Training", "developer_privacy_policy_url": "https://app.wetrainyourbrain.com/standalone/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://app.wetrainyourbrain.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9790089471108989"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4382441678752050"}, {"status": "PUBLISHED", "id": "730831352790910"}]}, "baseline_offer": {"id": "4382441678752050"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758662400, "status": "PUBLISHED", "id": "4382441678752050"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26278006648557344", "version": "2.2.7"}, "id": "1655827095138156", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9712599518857985", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26278006648557344"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1655827095138156"}]}, "change_log": null, "created_date": 1776723603, "id": "26278006648557344", "version": "2.2.7", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary
nail": null, "display_name": "Star Phoenix", "keywords": ["Space", "Scifi", "Interactive"], "long_description": "On board a damaged ship, travel down to the engineering level to find missing components and survive the dynamically generated maps and attempt to survive and start on the road to fix the ship.\n\nThere are no instructions for this game apart from the controls list so you will have to try and figure out how to complete the game on your own, through trial and error, whilst trying to survive... \n\nStar Phoenix uses the Unreal\u00ae Engine. Unreal\u00ae is a trademark or registered trademark of Epic Games, Inc. in the United States of America and elsewhere.\u201d and \u201cUnreal\u00ae Engine, Copyright 1998 \u2013 2016, Epic Games, Inc. All rights reserved.", "short_description": "You are stuck on a dark level of a ship in the depths of space.  Are you brave enough to figure out how return the missing components and escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.blazargames.com/Star_Phoenix/EULA.html", "developer_terms_of_service_url": "http://www.blazargames.com/Star_Phoenix/EULA.html", "publisher_name": "Blazar Games", "support_website_url": null, "website_url": "http://www.blazargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "427737515804149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12533901_1853756911572101_6335330899109871616_n.
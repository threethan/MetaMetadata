h an eerie forest full of poor souless zombies that have acquired Wendigo Syndrome from eating human flesh. However these unfortunate people did not do this willingly, they were forced to do this by the Wendigo within the forest. Attempt to find your way out of the woods by finding the items requested and offering them to the lost spirit in front of the church."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "271175092438884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974649_707575591262315_5281016639645176559_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrW9CTDnqyQQ7kNvwGHbtxC&_nc_oc=Adqu4RPIa4RXPqzYidacAeZQBkPxBU_4armZKMroSxCPfCWXhBQnJ7DFlpzsIBojWT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS87u3rKJEELBB0IcM6Ew8_mwDiuskoubhY4xTQQEWU9g&oe=6AFC84EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wendigo Forest", "platform": "ANDROID_6DOF", "context_category": {"context_category"
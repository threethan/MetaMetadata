6721734469462_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MleApV91D1oQ7kNvwGlCxi4&_nc_oc=AdlfrOvxq94w_SK3TbUeoD8UpPb6R93o0JwoJMIg6mI5zwkwBEjOMmOV6T-mmfJQlE0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftnc6NmCyrIsVHV-rCCDIRZUPGKIZrTtCygBYXJmICJaA&oe=69A191B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "1031698197849644", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982470_1031698201182977_7652636287824336952_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqWnAfnh1AEQ7kNvwE4Pi6N&_nc_oc=AdmMWS9hEKoq8kcoI4XIDM3NajHY-ckPPvEyDlY-txvwvqmNIoivuWKSzL4pRt9MxCo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvkOXJSFMMyJriTUh-AUMeAq2zultjlIHJJgg2JNJ3Bhw&oe=69A18955"}, "display_name": "Wendigo Forest", "keywords": [], "long_description": "Wendigo Forest is a single player horror game where you venture through an eerie forest full of poor souless zombies that have acquired Wendigo Syndrome from eating human flesh. However these unfortunate people did not do this willingly, they were forced to do this by the Wendigo within the forest. Attempt to find your way out of the woods by finding the items requested and offering them to the lost spirit in front of the church.", "short_description": "Wendigo Forest is a single player horror game where you venture through an eerie forest full of poor souless zombies that have acquired Wendigo Syndrome from eating human flesh. However these unfortunate people did not do this willingly, they were forced to do this by the Wendigo within the forest. Attempt to find your way out of the woods by finding the items requested and offering them to the lost spirit in front of the church."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "271175092438884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974649_707575591262315_5281016639645176559_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeUq8FGUSSkQ7kNvwHd_Dy7&_nc_oc=AdkxLfNsZePLxYtiqyewJym6WzPF7ccr4fWmkBB8VsxpJgzg41P-xupgzig30LTl5gw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuslEw4G9E2Wd2dg2FLYrveXHAV2pLqfQ6AZaJPZg__Aw&oe=69A1922E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wendigo Forest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1694103099, "lastRevision": {"nodes": [{"id": "7622596147797818", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7622596137797819", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1800622357056488"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "TheHaze_Icon.png", "id": "24
le_name": "sc3.png", "id": "1648760400054694", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596168449_1648760403388027_7441100818626408307_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyq6zpZ7DGcQ7kNvwEV-abn&_nc_oc=AdqwJVo3yACIWHThs5TLpoQFixcxHSfqx5mZ3q1mTP9w9oAESBHcI25ZAnQyWr9Awno&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8MJmZkJUG8H0MO2z9-dKhw3s1j3gMKoMCo17GVvnlRQ&oe=6AFC81D9"}, {"file_name": "sc2.png", "id": "1854704315944360", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1854704319277693_1767078133469211060_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa1OmcwTY_UQ7kNvwHgfZ1T&_nc_oc=AdpZcM62DsflF74NAEDVnqU5xDb30KHvpMAuOoj2C1UuRxEw8a3nZDVi0xP6E0fbDzQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcrWmzP-yX8SunxVCb_6GJqI1KiI-OrJUOZ1gXXToL8Q&oe=6AFC7EC1"}, {"file_name": "sc4.png", "id": "1589410416556624", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673819499_1589410419889957_8208686650705444174_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_IPkZbOmzwQ7kNvwEVjfId&_nc_oc=AdqekMIDonf-xKP8BGncLWCG1x3iXibKxVTlBOp6bbzI2gf-ktpBZxnvZmPRY2eMRP4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaeUAudaKydzABz2D2eNAQJesqWrrcebzMHyRD3PrDPA&oe=6AFC8C2D"}, {"file_name": "sc1.png", "id": "1116156751418534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_1116156754751867_265412713505075430_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4h3ElQcgHcQ7kNvwFxdMEA&_nc_oc=AdqBaLF1jEE1kylsxA7jHFGrqzk9vC1g-5djJCl9b6UkjA_0nQt2G3Cy0CYYG4ja7a0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKxoBMKvpRn6-dWijVa1_zILGmD6eU6eqfn7kV7n9EPw&oe=6AFC8DB4"}, {"file_name": "sc5.png", "id": "1650590766606513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1650590769939846_6204835561084670148_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6xHEkwsA4Q7kNvwE047FD&_nc_oc=AdpvLQFCyIdtkjbsZBuTPzPm0nCqfuQpbH1zPUPWW920pYkqZfsIuIToIzK3PYPBbps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQNb89JrfWCzNJcI3vntPFqSgZ3Ia9WHcltHArM_pd-g&oe=6AFC7DE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1450465620548162", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596068480_1450465623881495_1573204406425262705_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFNE0x1c66YQ7kNvwEoXxdb&_nc_oc=AdrH0-4sEYo4Q38BjuqPkEvge9T8SFDHX5axRsaH2D5kMmf5cqEJ0H391fTOlsjoOQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6stTf-iSaOaUA7vUGla-t2dJOjT5j0PismIZu3SnFzQ&oe=6AFC830B"}, "display_name": "FaceZap: 3D World", "keywords": ["puzzle", "blocks", "jelly", "mixedreality", "casual"], "long_description": "A puzzle you can reach out and pick up. FaceZap: 3D World brings colorful block puzzles into your space. Use two controllers to grab and turn jelly-like pieces. Place them carefully on the board, or line up a gentle throw. Complete rows and columns, collect ZAP energy and clear space with a well-timed blast. Meet expressive little faces inside glossy, liquid-filled blocks. Look at them up close and watch them react as you prepare a line-clearing move. Choose Classic, Endless or Daily Challenge. In Endless mode, the environment gradually changes as your score climbs, with flowing lights and new colors. Animated backgrounds can be switched off in Settings. Play in an immersive VR environment or bring the puzzle into your room with mixed reality. Move around the board and discover a familiar puzzle from a new angle. Single-player. Two tracked controllers. English and Turkish language support.", "short_description": "Step inside a colorful 3D block puzzle. Grab jelly-like pieces with your controllers, place or gently toss them onto the board, complete rows and columns, and charge your ZAP. Play in VR or mixed reality, with Classic, Endless and Daily Challenge modes."}, {"images": {"nodes": []}, "id": "1149955997978582", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap: 3D World", "keywords": ["bulmaca", "blok", "jel", "karmager\u00e7eklik", "rahatlat\u0131c\u0131"], "long_description": "Uzan\u0131p eline alabilece\u011fin bir bulmaca. FaceZap: 3D World, renkli blok bulmacalar\u0131n\u0131 \u00fc\u00e7 boyutlu oyun alan\u0131na ta\u015f\u0131yor. \u0130ki kontrolc\u00fcyle jel g\u00f6r\u00fcn\u00fcml\u00fc ta\u015flar\u0131 tut ve \u00e7evir. Tahtaya dikkatle yerle\u015ftir ya da ni\u015fan al\u0131p hafif\u00e7e f\u0131rlat. Sat\u0131r ve s\u00fctunlar\u0131 tamamla, ZAP enerjisi topla ve do\u011fru anda kullanarak yer a\u00e7. Parlak, i\u00e7i s\u0131v\u0131 dolu ta\u015flar\u0131n sevimli y\u00fczleriyle tan\u0131\u015f. Onlar\u0131 yak\u0131ndan incele; bir sat\u0131r\u0131 tamamlamaya haz\u0131rlan\u0131rken verdikleri tepkileri izle. Klasik, Sonsuz veya G\u00fcnl\u00fck M\u00fccadele modunu se\u00e7. Sonsuz modda puan\u0131n y\u00fckseldik\u00e7e ortam, akan \u0131\u015f\u0131klar ve yeni renklerle yava\u015f yava\u015f de\u011fi\u015fir. Hareketli arka planlar\u0131 Ayarlar'dan kapatabilirsin. VR d\u00fcnyas\u0131na dal veya karma ger\u00e7eklikle bulmacay\u0131 odana getir. Tahtan\u0131n \u00e7evresinde hareket et, tan\u0131d\u0131k bir bulmacay\u0131 farkl\u0131 a\u00e7\u0131lardan ke\u015ffet. Tek oyunculu. \u0130ki takip edilen kontrolc\u00fcyle oynan\u0131r. \u0130ngilizce ve T\u00fcrk\u00e7e dil deste\u011fi.", "short_description": "Renkli bir 3D blok bulmacas\u0131n\u0131n i\u00e7ine ad\u0131m at. Jel g\u00f6r\u00fcn\u00fcml\u00fc ta\u015flar\u0131 kontrolc\u00fclerinle tut, tahtaya yerle\u015ftir veya hafif\u00e7e f\u0131rlat. Sat\u0131r ve s\u00fctunlar\u0131 tamamla, ZAP enerjisi biriktir. Klasik, Sonsuz ve G\u00fcnl\u00fck M\u00fccadele modlar\u0131n\u0131 VR veya karma ger\u00e7eklikte oyna."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardmedya.com/facezap/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Wizard Medya - AEY", "support_website_url": null, "website_url": "https://wizardmedya.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1377793962091009"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1100611916190453"}, {"status": "PUBLISHED", "id": "1480074587369088"}]}, "baseline_offer": {"id": "1480074587369088"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794513600, "status": "PUBLISHED", "id": "1100611916190453"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1374829235720815", "version": "0.6.1-world"}, "id": "898339329941587", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1374490409088031", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374829235720815"}, "release_status": "RELEASED"}, "binary_release_chan
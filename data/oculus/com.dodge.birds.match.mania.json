dnyrnDnskyvXT4VfWLMLkWy25ajEHSbO1UgnEg1cP0xmC1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTqZGkq8ArEfGy_xBFPLkMulkclQt8SDgXuIIYgsVq_g&oe=6ABFB24F"}, {"file_name": "3.png", "id": "1849839542992739", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1849839546326072_4035769355140820369_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjrTUYZS-lYQ7kNvwFDqcnM&_nc_oc=AdqjIvaYzECZmKSEr-i2putF-1unwmnMim7Dum1b0OyfOXHsuG1cy0pz-Jr7dt8NxGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzNZwMU58UxW4Bbn7tAISA_sK0aPDm7VXkq4HOi7inoQ&oe=6ABFB0CD"}, {"file_name": "2.png", "id": "1767244957967222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585819904_1767244961300555_7554718931845842271_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtRjw3C2qEYQ7kNvwEF805O&_nc_oc=AdrRRjkW-Bz8-qy7zxvm8WNTwugiAyVAYm1F1j1uUsqIsHLL8x8QNAeTcGIawq9xkr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuxNuruh5AckNRggNLIz5xYEsFpaQggw8lwUJwoL78bg&oe=6ABFD7EB"}, {"file_name": "4.png", "id": "1189718949948137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1189718953281470_378474496700656237_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSDTL22Xhh4Q7kNvwFpn6KK&_nc_oc=Ado55CA_inih58pbTXkS1bW9G-Pse5JPDvFXIyyRC8HTKBnBkpmzMZU0ypPlzmr5I0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeWbCEhc7patU7jqJyKiUaZzoGy7A97Y3wY1XqcAp-iw&oe=6ABFBCF1"}, {"file_name": "5.png", "id": "1705557430462317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1705557437128983_2892223783731412237_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpAH6LcJdBAQ7kNvwEWb81f&_nc_oc=AdqCzHw_MjIBnjcTOk5zkLQmiihz_2z1WslYiOKvxT1j_O0fRT0iESAoVoZagvXjWVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVY-H5tVWjHpuCjWe01ETPPYqz2r6Xh8bWZ_h6mfv9OQ&oe=6ABFA885"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Feather Dodge", "keywords": ["dodge", "birds", "angry", "fly", "horizon"], "long_description": "Take Flight and Dodge the Flock in the Ultimate VR Reflex Challenge!\n\nSpread your wings and prepare for a high-speed airborne adventure in Feather Dodge! In this vibrant, fast-paced VR arcade experience, you control a swift little bird soaring through a dense, beautiful pine forest. Your mission is simple but intense: survive the incoming rush of eccentric, colorful birds flying straight your way!\n\nThe sky gets crowded quickly as a massive variety of round, stylized feathered rivals zoom past. Use your VR controllers to seamlessly weave left, right, up, and down to avoid sudden mid-air collisions. As the timer ticks up, the speed increases and the patterns become trickier, pushing your hand-eye coordination and spatial awareness to the absolute limit.\n\nHow long can you rule the forest canopy before the chaos catches up to you?\n\nKey Features:\nIntuitive VR Controls: Seamlessly guide your bird's flight path using your VR controllers for sharp, precise, and responsive dodging mechanics.\n\nFast-Paced Arcade Thrills: Experience a continuous wave of unpredictable incoming traffic that tests your reaction speed with every second.\n\nVibrant Stylized Visuals: Fly through a beautifully animated 3D forest environment filled with lush greenery, towering trees, and a colorful cast of expressive avian characters.\n\nDynamic High-Score Tracking: Watch your survival time climb in real-time, push past your limits, and try to break your personal record on every run.", "short_description": "Take flight and test your reflexes! Navigate a swift bird through a dense, endless forest, dodging incoming waves of colorful feathered rivals in this fast-paced VR arcade challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomanawan89.wixsite.com/brokenengineers", "developer_terms_of_service_url": null, "publisher_name": "Broken Engineers", "support_website_url": null, "website_url": "https:/
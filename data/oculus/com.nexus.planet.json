baSZ6vFIKDXIXQnZSk8MyHNZtzPh4V3L22g8rq7gNBhd5N61mD4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQsXO4DcH9AQOQcKHn6PrbQL1FsOWSVRcqHrYd-SLjfg&oe=6B006D1C"}]}, "id": "1565250448147128", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_4.png", "id": "1560118502398983", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgL-JXiCT3oQ7kNvwHSbHnp&_nc_oc=AdpHf0eBsgksIP2h9uPcG3B9cMYkaBjO6GVdCHN3UG3QrHzCeHtVNYsa7itoC2eenZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaXpKAl4Pj6PJM9S8hkiu3jMoy4bt7xNcz7Avyw-n3ig&oe=6B007376"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvHPNLh0_EIQ7kNvwFf7qSG&_nc_oc=AdpOoI9zvNeUPybSSccFYL3fXH5jt4q8mPNrP5jnaNAeSse3HBC8rmbtObxG65srTCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFHioGUYgMSLPpAaTCox2zOk14o-UUNINR6q1wrw_qjQ&oe=6B0058E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEyp-cCVwp8Q7kNvwHX5N3c&_nc_oc=AdqUVUDumUdacEWVQr485slOEx1wYK8DVWcXLo7k7VxAE0EnrG-DNymKvDZFx1nNlFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtElv0avKss2W1WVvPpIGGeCL5IV728OUk56qkJkxUoA&oe=6B0087C1"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WommSA86rAQ7kNvwHACqxO&_nc_oc=AdqdgFG6Xd7SKXms-omli_UtuutLOIAoKQ8RVJ1QdP7QDgFk6qKdg6HO_wq0Y1aXehY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYtTiqgM_XDVakFW-qzBNo9aUnLfl4WR3WDWjaq9Qlkw&oe=6B0066CF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7Z4ZQI9SOwQ7kNvwFKRNH-&_nc_oc=Adp81FBQLPuTMT0mVPCu4h39vJhqyyQEaoc8wUrDz0GAU0SDekEAh-FVdX1jjkvp-hs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfbv1PCdem46eDU8ReZ_TOdMjRqLOhOVY9qUor5V3cdA&oe=6B0055BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nexusplanet.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "HumAi LLC", "support_website_url": "https://www.nexusplanet.app/", "website_url": "https://www.nexusplanet.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28379475395027772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_2585128668619479_8684352116579744102_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgUiyeygvAUQ7kNvwF7GCSC&_nc_oc=Ado6Ok1sKxFC1BQP9zrhtJ8BdSMERpNcZkLXkpyBKoVbSvMJzZ3gV215U-2hU6i9C9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNed_Xbs2GprH3WskZ0KATKlCXnXzDVC353ayAPnIwLg&oe=6B006BAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
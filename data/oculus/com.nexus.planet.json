.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjJBW27Yr9kQ7kNvwEdyCEU&_nc_oc=AdqAMj6F4C0YtcW70MIf5G4AOaahttKfuR2Yr4i97t9s99p7WF_ptC-2bm9KfAlVgaw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjBPynNAHHkIt5tRFutV2kPIquYq53GMLJoeWSsdfw2A&oe=6A71D936"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm5pw2NQQ18Q7kNvwF9LU6g&_nc_oc=AdoRf-eP765z4-3FYqm5QjOiv58rE7y8XyrwcV25zWdLCYSrj6nsBcVxtxUIOqh5R6o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5_nmxOW709-A3pH6NDAiqT6h1oBDxbZQU_atE1aVNbg&oe=6A71F6E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEpo9qau2dgQ7kNvwHqomXb&_nc_oc=Adp7JDWe0-bjXvMXTsiPBNiIXomST0fPe-M5PtaNkfLVTBh5jS9a9679h8vwIQoF5os&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAuf6THSU7LejfyV0LAGXvTwtGwbwyvf4kIhpZBZ6sxw&oe=6A71ED81"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xn5gNLDPlMQ7kNvwE2pj33&_nc_oc=Ado1id45_WK6FkV4gYo-8uC_gR9hrUmSJRHswqprv9Bpzbrf9wAesGNs23PSP_oVSt8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGgISVHeTS688vU7FE8KtBiAB6P_Z4TDEzLhk7rZJsCw&oe=6A7204CF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcAPJ1ps5VAQ7kNvwHPX9W6&_nc_oc=AdomvCOwbUQ_muBxqmmhT62ZteU4bP0z2Q3jJXx2OXx2Ua7ntw6Qzy8-IlSY6-oQ9OY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkBHsZAGFSvTSt1jMDAS0xIa06X4YaHj-22TSCaWOMdg&oe=6A71F3BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-jJwDyCDRcQ7kNvwHlw9s3&_nc_oc=AdrO0Lsmwno4MzRYgFyBtbGX6wrOgU1OtvnF-vgGYghLYrPn4BBRxhrcIk6mjzeJQZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p0IXgssUFnUUgq4eF0t7EeZIE8rNz5HWKwlqO7W_JAw&oe=6A086136"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuL7A0JwN18Q7kNvwGuuGyu&_nc_oc=AdpJEbliiIfEwdQAo924bXzf4XItH9En5gPKUMJNfxyU7V03o9HTU7Klkq7HoQ3OMv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tJ-8R5VE3LJmir1SXGAFe2HgLzRvPC2SrtaZm26X53A&oe=6A087EE1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9naC7VvT-ggQ7kNvwHAAIcz&_nc_oc=Ado5n4y1tfOonUOc5Q4Abvgmbi5b3_IQUdNXEdb9Uj6epAuM6nPDFUB4vlEwLHdHq9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G14WnRIfb64QcxRdoHZVNSwGoe76Cx0FOhEqfTinrdg&oe=6A087581"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaBHGunpSuwQ7kNvwG3zpj6&_nc_oc=AdpeQ4PDHL3Elw7oAyMKB4cXJvv35e5YU6pOt782V3Z2OMWD4S2wDr9vediuN2W20kI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nl_vzqyqANf37V_6hsQHKigkn8VOvIIlqY1aHsPINXg&oe=6A088CCF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=625twHz_F9MQ7kNvwFg10Qe&_nc_oc=Adp4-QPC0B6C8X9CRnCHw6aCuiH_8HE3pY979T6uSIQH9SbhWu9Dl5JT-mLR7qoT-rA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TRQrkk1Z1GGjZJ4r6XRn50GrlWbF4pCf57hb3UhEMxQ&oe=6A087BBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
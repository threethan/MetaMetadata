.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNXVisSCoTwQ7kNvwF4WYQ2&_nc_oc=AdpHFldkvjWlLNi9sCgBm3lulCZNETXhev0l3TW-1F2nBIu03swZEzKLdl4tNpR-P9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lZuY8ie_E5UtKm5Hh8A9TSjJhzJdwD9ts0N4uAZ0CBA&oe=6A1476F6"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Moei4xo-WfIQ7kNvwHR_fSx&_nc_oc=Adpub5SgEb4zLwGM3vpkIHyzvAVS4BsnINzTpK0BAsp24GyfQyxRSk65MSDWZK6XMco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w-g5nhDUcLkbNeyDZ4gzMQ4K1UTP-g5vbseGypwwcwg&oe=6A145C61"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0vRhXi4ZVoQ7kNvwFbSbR6&_nc_oc=Adr0yiIOtPRifDZPiGjfMJn9QsEG4wxs16akMdeUU_YMw-h1txEmyI4qRVzklnox3BU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u1LXMLk3iBwm9Q5CNN_ISRuWR8EyCtOlDsET7RMJz6w&oe=6A145301"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NWmdxfeM_QQ7kNvwHsgKXI&_nc_oc=AdoAC8zbN3PKZmQm5XBJ0swZDxG72E95zeXtzxDqPdO2tAyUDiCSwObdRNg_16hSRH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hhd8GSIlUSNhGCJRd4JkPak_Y6FINgjGG9JnCgtYGAA&oe=6A146A4F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPiow-a0v8sQ7kNvwFKs70L&_nc_oc=Adrl9E1QnXhzSs0V2Uw3VvqrbP1lzwVu75jQQ8bd5QoYlh8_btPN4GbP5LUFHY9L3ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eigNGQfQOmZQpeCXSD-WkrJAZH9WMqUlkKEYRwo-BzQ&oe=6A14593D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tViXYss7egQ7kNvwFMzkPL&_nc_oc=Adp95tk-NfuSDF1XfBOb6h4fodnZzSa2Ot8Fb8X_5GMgS-_8McFO5SdEJoXj9NuAGsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlocsr1bXU4hSaqaq5zCIwhGbKTEkEdZ0wKxmAP0xNkQ&oe=6A9EE476"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fif5q1O9LMQ7kNvwECW43l&_nc_oc=AdrOQSDNJ6w0CW-LWM11LAiibBmhRI3HgC0XR5-pIoLg1vQx1DgbKGuJDMqTr-8hFhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyvWu7sgHCmexOBikLOCfGhlzKtKk07YpJhLZL7EEVoA&oe=6A9EC9E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wasFLoe-MiQQ7kNvwG1heaa&_nc_oc=Adqkqm4_N_2gU_WWIuTRyYT_T_a-AZrsmpmk2Dy-WUkvxR7yMM6HgLl1FKA7ULHQESg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ36pVjM54Sg1DeIUgJOivRHuF8UGz2ajFjbhdiTPWZ1Q&oe=6A9EC081"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAaAWcI6wrAQ7kNvwGjosdw&_nc_oc=AdrIfOVHSvUtSTxKP799wLrSFt3iOYMYOfe-zmwS3i75TNGJ6JrwLLoH31zOTREqmyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqTIaiudHuZWrTvnBC7nSDOmVYwnUi7NDiJNHG2cpBaQ&oe=6A9ED7CF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMOKFgswz1EQ7kNvwHq1BiF&_nc_oc=AdqVUPB1043wFSkADjvN5iA8gGm9aKK8dsD463ab8jCBSagcFbHc7L4UUHLmhuD-V_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMb29AM7nylevGZ4hC2VIdAxYghfqbnx61eY4A1vfHMg&oe=6A9EC6BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryb1NTjDe3MQ7kNvwFYFf6S&_nc_oc=AdrkqwLLeb1Q4-xoCRFyapyY2Kua67TZi0yAL40bZwvChh6HyIerD2o4ZK_hZJ5whQ8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHy2cG2qoVl4TaZwr3rPD50t5JgJ_kwzVALuyZk9Xk4Q&oe=6A917D36"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTFLEON4iwsQ7kNvwEoKiwA&_nc_oc=AdrEvukmH5ySY10seREPzJNo0xKg_asONL4AQqOEUeLsjmQwTL_yEa0_IG8IPbTYX1w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf5Jf-X9PnKwKVo1iUE4SX8zqzY9uwOMlw7DfzbTqLlw&oe=6A9162A1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMMrExot5IYQ7kNvwFbcOVb&_nc_oc=Adp1X1A4B0HLO_bkVH0rPdzCSOMcCffHGC6nVwEUysxKGUb2-EPDpyNYS11nFoiAU04&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYvk2FZsyeKptPbkMmK39NwQE7yoY8UEkCv0pcxQZWBg&oe=6A919181"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgMbx3G1CxwQ7kNvwG7Ymtu&_nc_oc=AdqD7tP17N8ZHpWSVBrKXju0a3wPf192K1rwDc-Zdpn6vA1Y4zagsymWa0RwVORuS0o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn4O2mBgnVAxb7Q0aS8xKCAE786Q_j3figbUasin-bEg&oe=6A91708F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8C_bSAYF6cQ7kNvwFWOX6K&_nc_oc=AdruiqR-6eM64prIpMZUwhMU_tcYPRayzWhy8bc4M38SiVFYzNK4LnW1oKtmaKFBLAk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhhoeb5db_ubVBcqHknmHvMt2zcoah8XCRE-FG52VGVA&oe=6A915F7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
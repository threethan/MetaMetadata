c_ohc=4MCSaWNLcQMQ7kNvwGD8EqJ&_nc_oc=Adq3bttfIjERrM30B0OPcGj0onlGLlIvdj_Jeb-2x3ibECpqNw5k1Ig7acAOLc2zQbg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQgLpselHczxDf1An-hQ6PIXAHHsPOOGm2ejvIuEXFIQ&oe=6AD0FD76"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRPPGMysBSAQ7kNvwGcUpak&_nc_oc=AdrmoJzypiqhsB8VPm3qpZH6Z2F9QMchtfxOHwK6gk0oQB0yNRMXxDRyeOap149tXZg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo5KHBzwoTvG_sP0BmZjZaiIxfbXG4vslfUZEDGwI2dg&oe=6AD0E2E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsEvEBxAraoQ7kNvwFiw3qn&_nc_oc=AdqcmIhS6ZyOXWN8R4_jiHsVgErZB_FdwFPJPTATEco7rLxWiSvceNKotg15OLr2Lgk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLN-B9Mi6bu77RX6cYLNtggFjSOU-rYL-2AxDUc1krpw&oe=6AD0D981"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYa2y_dW4oEQ7kNvwFOKAPd&_nc_oc=AdqkaA9InMxpbk09pAvvV36InN6opsQ37iPXKofWBDpEjR8AbJ85-FKTMaEwK1SHj_0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQyghonDEGfYEKBmKo5mfTIQ43607MJoMCXkg5Zt2sPA&oe=6AD0F0CF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifp2vdgl0-EQ7kNvwFrXe0K&_nc_oc=Adq2jpGAaMLvo1eztP6oEQOB4SGTai3gSoUmBsluX2_9Ue_hI6l-9iOzSRDJth15W8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8plu3mGem5v6A3Q4oLqvcEU427cSETs4PZ5w3fJc_fA&oe=6AD0DFBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.humai.llc/privacy-policy", "developer_terms_of_service_url": null, "publisher_nam
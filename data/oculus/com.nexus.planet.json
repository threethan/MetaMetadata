.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slvJzy6hmUMQ7kNvwEAyjlp&_nc_oc=Ado85Y1CDI3S10IJ51DUPV7J4Ol_Qnh7XUdLv01l6y3u6r09LHfkUOW3QD23GwQlG5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJxLIrJ54rzzpt6BAeL7ESOc1P-ZZWWi_8rYqQIJsPYQ&oe=6A4A8476"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au2g7ImyjVYQ7kNvwEpzR11&_nc_oc=AdozKZr5u0Vnvxjn-ljxfrH5G1GL8ym8um_UmhmeA-guZ9LggC6lgoKwYmuzB4a94bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7VJOc-3lSEx9t3FhsBX8PzxADQFkIbANv5hMQf_guuA&oe=6A4A69E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp2Ke5G9tH8Q7kNvwFg4nr-&_nc_oc=AdrbGnjwjUpXteS2Tva_cdVIqw21hOUmO8rD_gL0-xAuwsKnIOuy-3kjFW5maqIKkVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4vppLP2ToB2mR2Pl87txyA3FIYSRfcDpg0u221iV4Zw&oe=6A4A6081"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pNz8Dm1MvQQ7kNvwH61Byc&_nc_oc=AdpMkrLkuk_ctSh275XeNgcpRcOhXCGdHYA4VN9EGE9mCKJAFhwf2eMk-Jb7Q2egyvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRJCOrdwcRNg8on9KvnuuAGyZTyomg6cyCvh1oKDURvw&oe=6A4A77CF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hh5I4Ti1Qd8Q7kNvwGX8UNi&_nc_oc=AdorwFPJHB2gaWwpB_iCKHrBXS70VDWUxtnWG50mjRPsJ63MBGOIxoYY7FPG4lu1MSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7w2RCB5YNrE3n041wkY5LNcOJ4fcPXnto92h6HDD0DA&oe=6A4A66BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
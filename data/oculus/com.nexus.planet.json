57771802130092", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0X1lAUfKl0Q7kNvwE1dpb4&_nc_oc=AdodkA7bT3ZAAi3GUjKLC79i7Xlee7t-izqITLpXru8_3vBrfodIPclL1h_qiASmT9Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrvKMbzJiIv8KWY62d3y42SLSAhrTNqoikbfjuOJhjBw&oe=6AEC9261"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcc4eVYEM4gQ7kNvwGz_vEI&_nc_oc=Adqp3TUL0cBgcqhrJlARE3TA36G0xmaKAxpCYCJLflsZ3OJJK0OUfPHRDcV9X1CrJfI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqLEqkA8ZneuqBoi7F7XgHeO9MECP8LPUgbLtAQJSBTA&oe=6AEC8901"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp6bWwmpP8sQ7kNvwFCPRZ3&_nc_oc=Adogv4eOq8TfWG4KLyBPIL25h-WAvlco6c86_Z-QsEfb5p7eMJVSVyLFz9W5LonZArE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8NgJ_Y9OxCCvnMXSyb3yIloJ1kcSmaE2OHEsGY7JnZQ&oe=6AECA04F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrOqCdIHwxcQ7kNvwHP0EHK&_nc_oc=AdqgcZnFUtJLAZoJf9z16a72RmiAd91OWI7E6DTspCIyu9ekOfjglDIZx8ml_YnX0jQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcaCHbAP5xCC09oYyqEMhY2M4dR5hKcUkhV1x1szbUuQ&oe=6AEC8F3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nexusplanet.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "HumAi LLC", "support_website_url": "https://www.nexusplanet.app/", "website_url": "https://www.nexusplanet.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "c
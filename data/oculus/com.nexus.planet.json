YThD1YWSIRgC4WmvDGWEQbjY35DxmIuHRDHv-mPbl1CVxl2bJg1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk8IifWfQ1K0gQiijgkDnDKk_b68omdrSJldZa7OLNTg&oe=6B07049C"}]}, "id": "1565250448147128", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_4.png", "id": "1560118502398983", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdt46mODIPkQ7kNvwFi0XZX&_nc_oc=AdqB3Q7zCb9i4c90g5Y9_Y7FqZzyu0mEX7KZSqghCH9ryG4yAtmRbI7JBkmvTbsQxHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmaWthaQlC4hXwpexHnr84cwzN_0FnWQqzW-QPLoCa6A&oe=6B070AF6"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-FpGBUSq3QQ7kNvwFjLsR1&_nc_oc=AdrkEKlef3W5Rxvasy-0SnuHBgoNa1v2kRg3DQTlAXGn9CYj0imAabuwPj61oWaAYZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRIezgkQgLU65_QWQpbUiQpq_abZpyDHnfc60JrdVC2A&oe=6B0728A1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwBnHBTzw6IQ7kNvwEz3jjK&_nc_oc=Adolis5TLAeg3xDw3MiB22MbPPyriazp06llv20lC3dRkGthO-EZ0Rr99TUD57tMXSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFNMJy08lbKDGv4N_quOM2U4xWFHTV4JC0igvhQG7HCg&oe=6B071F41"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFMrdtKDu5oQ7kNvwGIkEAo&_nc_oc=Adp89vOg3YtDAO8TjpONsxyhQanAQ7pegjYo2Os-ZRyjBZUfJyLn36sAO9b-JbIjVTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_4lHPXyLPZ78ThiADNcaPNjNDY5QVemZaGNei-vzM9g&oe=6B06FE4F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2LvqLX_xnQQ7kNvwFCGx-q&_nc_oc=AdpEVMsslBxMXfdkgXTNfTiJomxsR7dS7bNvShIo4z0Xj8q9yRRUUXTDU2exrrU14sc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCaNc4r1pwkb2JnGvXFdL6MF7YhKZIU_f7nwIelyoJaw&oe=6B07257D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nexusplanet.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "HumAi LLC", "support_website_url": "https://www.nexusplanet.app/", "website_url": "https://www.nexusplanet.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28379475395027772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_2585128668619479_8684352116579744102_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DoX2s0LE-8Q7kNvwGSIHW_&_nc_oc=AdrCRCLF0wQOniCjDiT43NEhYydSdTGrKvJfDp0v0KHY7oV63_VMggWSQtdVGQ8kFVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjM4efeyWdOwtxkRs2XJTqFbFbha2xzce1EVKit_y0jA&oe=6B07032C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
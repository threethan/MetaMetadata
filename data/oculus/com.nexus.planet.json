.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHTJ1yGMCEAQ7kNvwFzhRvZ&_nc_oc=Adq02EwY5eNOi7dk_jYeOf-kD6ui_xjBn2ktmC5Lv55e35n0PzXm3z6wO6Cl-5HbYJA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVgW5dfSIFHGOy1Y804PeA9aFh_M_1-Xnbbw5-G_VP3w&oe=6A902BB6"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTFLEON4iwsQ7kNvwGCDeBa&_nc_oc=Ado_D68a00B_b3qMG7o8lpxGeCR4xikfdtHMd0t05J6dg3P1UkDRCCm1kizC08enNTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6OeHjXRVOsun4zkxqAHCfVSz4joUBoe_dOYhQ_Kgn3g&oe=6A901121"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMMrExot5IYQ7kNvwEJQI-g&_nc_oc=AdrJ39H5XzY4g_UP4AKrdRIEVCN5G4_YqwB7o0Gg54QOrcHwyxYHsL8qqguvApsC7KY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo7rVQpxeE1yTw09cu5wYR7rENxE9j-QxE-pUzk74Z8g&oe=6A904001"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgMbx3G1CxwQ7kNvwHK2zvE&_nc_oc=AdqfaRasp2I8_mY-Hiu3PGi6TFct2nAbU4nqUtRCNBrrkVugWHFe4jUvmIah4q8poqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgV2Ab0K-Itg1bsbM6wZaBQSkWAaYqcsNghblRh5GO5Q&oe=6A901F0F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8C_bSAYF6cQ7kNvwEOjoqW&_nc_oc=AdrWs3kvf0oLTPOSjC1qd8ERVrhCUNFVjQefrcXnKZDxC0X9jnPja4CUbi71pMpY2XU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD-j4kXwuOy2rgLnXE6mPXlfim3qR9McjhUuHobRZz2g&oe=6A900DFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
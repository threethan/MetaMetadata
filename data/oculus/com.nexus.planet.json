.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYKje2b1HE8Q7kNvwGWu3A_&_nc_oc=Adq_Ta_cXUXYjCWrDQ2A_9IJEseFn5gk8rIJcOHGG7ko8r_RM9IC7iOq5yJ-Sy27q-Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgiuzR7lUDQLd12DVgiBWtX571j6zY-cnGQ80oOHL3NA&oe=6A6F3636"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tl8erQDYtAQ7kNvwEG1Elt&_nc_oc=AdpIlrjHAV1-PN17f7IsZ5SJfEZ1tGXtIIfRkBaNEPsdF8vMixUh4j7j5KkkjzPzM9Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8YpXY6blA3cQVHtmQrJKyOINgtAPlhDPK6ahRhvTd2w&oe=6A6F53E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEpo9qau2dgQ7kNvwEOZ82A&_nc_oc=AdqGFszsa44ulH7MH_EAt3RxDVsLp6KPrbW6u6wQuzLOivger9BDzzAzBslxgCl9Lbo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtlFdPETJJU1JKYyFkcZkZP2jn4k0x7aAHLP0Ug0aN5g&oe=6A6F4A81"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP-PpB0QOSsQ7kNvwH_phFh&_nc_oc=AdqXSD5GZ_XMYS2b7nneUpEqcss-5r7OuFiit51ZOHGDk5AJYzBZPqV3lMh3SZrZfEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvdcCzEONIHa6DiuKRv9HuAV5UQhhnRs8qQAA4lxfZqw&oe=6A6F298F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5yi62FheSQQ7kNvwFZ91oU&_nc_oc=Ado_maWTHI_57s9rEoR87ANKoWxWW-3tGmmMW_92LHeARLw9Iwm6Y2rcRmTYQ2heXkI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfUzBz4kLAv8F2CyPlkToB6M7XMZbA8n4m-v8TQ7-LKA&oe=6A6F50BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
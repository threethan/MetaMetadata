2Gd64Gs7ijVSdMNn4UBe_LObgS_WN21WFrmvOokyRXVUxAsUJmUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwZvI3oD6znpp6UsKM-e6qIWhoSpdabuia7IlCPYxmWg&oe=6B0EED9C"}]}, "id": "1565250448147128", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_4.png", "id": "1560118502398983", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLiA4c3cDH0Q7kNvwE-VyIN&_nc_oc=AdrQb_SQhXiBmhptGrqn9A-mQkmo9JX5GAg5QMEu_77GBqyIKNO_bZN828i-ZuTfRNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXX-Uk9XTZENYhrIZOBbTNyPWG-nvbTeTNCNfOPhoHUgA&oe=6B0EF3F6"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wry8OXZhRSQQ7kNvwHVs22P&_nc_oc=AdoXl2_WavzwQe7LtPEJxlAWBNDjgkQaN1f2d0B_OOYQPZq_LQ6wFn0dZG_JIyLJnGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5my0dVSiydMh5PXik62pGfl2KCxLlT1ySaXu6suvvvQ&oe=6B0F11A1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0YouAT4hmAQ7kNvwHcn0IM&_nc_oc=Ado8eHy1fuB07PQNBWVY8hlFHGX0lLYXKtQYO5a5kP5PuTiv_8WO3J0iTE8Dm4rvg5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZp8JtKiyz2X3YBTJlunRoqREsrHFuEKD524wbP36v6Q&oe=6B0F0841"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZU_D_eCQlxgQ7kNvwE7cvN1&_nc_oc=Adrs3seIxiblydVrLn9hwv_-Vj29sx7scMdbFjFQb7UWnOTh9rY1RB4aC_CvuQMvZHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWaowRvx1by9A_l5cRMr5Of3DvQcFM4vQtav7yc12FcNQ&oe=6B0F1F8F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv1iRw6LTZIQ7kNvwHCoozK&_nc_oc=AdpxgYRtrmtAaKcIqxeQRy6U9U5X6oYec7wP_HDmOYiYYWpsIitlI-KIqANiYDA3RBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKed_TDxcuWz81tCXKRPnxzE1ITrtztDgAX7fh402YOg&oe=6B0F0E7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nexusplanet.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "HumAi LLC", "support_website_url": "https://www.nexusplanet.app/", "website_url": "https://www.nexusplanet.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28379475395027772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_2585128668619479_8684352116579744102_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJD1i0cApJAQ7kNvwGfwJDe&_nc_oc=AdrTr2gpygsYTF8PPWU-zgEJze6moSa_mGp6Qmj2M3F82N-E0Q5LicwBbdWiQcECuf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIyh-QnOW8gCEfnX-wK2FlaYTSUrDLMLhclAJxDZqjXw&oe=6B0EEC2C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
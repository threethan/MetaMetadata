57771802130092", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnwqaQvsulMQ7kNvwEu13MZ&_nc_oc=Adppb8beStc5sUi0IOPxruZ9kAq_4o1Phc9bIlllMKFsKNXgspNZGOp9S9-4X4pifCk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2L-7-X1yhFJxdi5ckkqcqYQdMXDN6Mys93PFhxqQHXQ&oe=6AE357E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZfKQlKxWCEQ7kNvwEogMYq&_nc_oc=AdoPN1Em3xpj3WbjMottpMVKMLJ-hqnF973gHOueUaE00Scgg8EzUjcX8DWeNfc4U1k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtZqDD0t3YPKodJY-28Xqjvwt0WOdUsiVyH_zU2HYkQg&oe=6AE34E81"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igc5PK2J36wQ7kNvwEXAmqe&_nc_oc=AdoGaaT1kwpk9l8fc-7GDsjeo8bD557Jhd0mtaPytb--SZ3RH-nV4McQrBSJtIQW-Xw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEGKWzcg0BorYY5i9fBjDWJUz48HgKsaVppYP-qhkFoQ&oe=6AE365CF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFPYWsOPkhAQ7kNvwEF7E77&_nc_oc=AdoP7cQr8EmP-QYg4_rDboGD6Y-uVGm8cgm2Kz_CIZ5tO28chRB-8_fXKDIZTN7pFqo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP-XpC1AlJL6w6iNi5XT-5rAmhsPirWS4SpFDTn2URdA&oe=6AE354BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nexusplanet.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "HumAi LLC", "support_website_url": "https://www.nexusplanet.app/", "website_url": "https://www.nexusplanet.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "c
.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Iqqcm79t80Q7kNvwE53t_K&_nc_oc=Adokm3HGlm5h-YNBC7srgy-m74k-7VAFmPwAkROEapZQz6oRySrn5L0k39tfoGPKZcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-fwUKC4XV2FrbniBnxpDkiJbKuU0t0nY0PrzxFLoGog&oe=6A5CC136"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5EDMTwCviwQ7kNvwE1fEfk&_nc_oc=AdoYQr5gRpmMemJ3zzAF6RAV7x6yahqwPOCaOvOp67XDxLfOhfP6ffBMMRi4u2wK6RM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX1ZGaREMmepuMPGmhtWZpZHIitI_Gr_hDxilMwtHHPw&oe=6A5CDEE1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joC1vv_FMlkQ7kNvwEvOYpi&_nc_oc=Adpe8VAANAYKreOXlIFssZi2kZcelwiodrBKhf7BoypPoHMWZ9sMMtS-BfYtIUnFlw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA3ZiIYtwnV2tqdtLwzavNIvWQ7abqt6YBwdt6WzrGEA&oe=6A5CD581"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcDgytBjD5sQ7kNvwHg6ZBa&_nc_oc=AdrcOAwBV8rMpzUDiPTySh7WApXQdt5RR9PY5cyJwcjx5QNv7JlNc1w8__2tBilTkPg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3VlV1ey32Qm_p1AIxygt4epg_RXIc6t5rTnzKD4BdAw&oe=6A5CB48F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vi9NDCPekYQ7kNvwEsqMID&_nc_oc=Adoa7lOhvsgRnV2bikso2AnXmAoRv6tVXPG1zxnYqVcW3poVbi_zGN655yEaDVfvIGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ1Zj1v3DlLzXR8ccn1gEvEGrtOtAkisBLl5DnT3lb0w&oe=6A5CDBBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
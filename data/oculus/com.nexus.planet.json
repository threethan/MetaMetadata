c_ohc=ldgaxoc5atQQ7kNvwESQj28&_nc_oc=AdqyVvJscEqW4WJG8rdR-1uH_CYh356o67u5j0lwBVRkrjVrSYg-4BVZ1woPrtarrwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMWusVw6uPWNBSgqBt61UXEPgxek4JZexcHvUhez9y6w&oe=6AE1E8B6"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp7EJc5duGEQ7kNvwGCSLku&_nc_oc=AdolRi728ClogJfPbHASC4RsjiiOtIG1J6fTCJE5lRUt_7oRj7PRRjwG5GY44fuaGdw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUCVx2SGRF1wKBzJxLsvcvNQ7hzPMR71TKP2vVJVJ_MQ&oe=6AE20661"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZfKQlKxWCEQ7kNvwE26KQX&_nc_oc=Adr-2ngIcdfEPJLeQMZ6h4uW2GPr1t2gxSIYE5kP4nZPrAU1W02evKJzeIdIduk_jvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDn2AoDjbat4NoD2i0t5WyNf6rHuEsjLlOKXdLoVQ8QA&oe=6AE1FD01"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igc5PK2J36wQ7kNvwF4s-GP&_nc_oc=AdplrPF46emimyMRxMCzRsU7kBZEbsNxntli8PEG4Szn0gawFbfVqCIZ8Pcqy-VDRe0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf1TAf4kXT0dQifQzGk5g0pQY3MYg_yT8SnGhDMtUzDA&oe=6AE2144F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHRCVw9VFDUQ7kNvwFQzl3f&_nc_oc=Adr9lliOesHJcqtbextIP7O_zrtyOoLHTeV_stjOi1aUzMwEsi2bqaEe8woHQYvC2mo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdYR7a61m6lJtQG7Xnq-KzWczeFbjKYeqmlMJ3IuaAFg&oe=6AE2033D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.humai.llc/privacy-policy", "developer_terms_of_service_url": null, "publisher_nam
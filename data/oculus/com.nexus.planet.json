.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ1nZILERmIQ7kNvwErVF94&_nc_oc=AdogJi1vMVhNevpWakSEzMgxwBoJnt-Utjpd5yqAZiit76YtQ3IqVQlWlii5fWlqMFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM-Q3HD8aBqwYtvbT019mpKQNXG47VGTKSpM32lGEdjQ&oe=6A9C4176"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fif5q1O9LMQ7kNvwFokGS7&_nc_oc=Ado0UpiOy_Uni0MNa1kS9tZDTSBPIHj1K82gt-eo3mm2jtPea_NXGM0fqMNa18cwnPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCPwig8thnRy8zxiyOXn8PZg9KsYjN6V4gX7Ir1hXQOw&oe=6A9C26E1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYr8-WfKy2wQ7kNvwEkV8Xk&_nc_oc=AdpFolO8aVa4ro6eEiRqJsGjU8XQUd_REFzmF07m4KgeY_QTgoOLIVem7MY866yfVp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeSyRnk5ulHjiGuRdFYjjLTejiW6LCa4FM58iZjWIa8w&oe=6A9C1D81"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hObyUFHY-toQ7kNvwH5gwyW&_nc_oc=Adq7CEVAD0HjlAsNOMim8gqAlQDGVWvuoTTteUjunFtOeJBgWPZ7fiR5QTtAxgAOyPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBo9Feo22UG0cY2dpGo35tJOZtDg9k-S7jxrB2VJtsZA&oe=6A9C34CF"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMOKFgswz1EQ7kNvwHaGZNz&_nc_oc=Adr80-xFpcC5BZJLA7lxxuE7gmMgM_pXKXnFp7R5N72Z11s7Xth_xjbmkFd9VP3K-Fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm_bz4fvIENCcsStI194GEkEYwPhggoXNCcNQwsUnQEg&oe=6A9C23BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
57771802130092", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=675LJ_QJTCwQ7kNvwFewuLu&_nc_oc=Adp4VxIcwJAjc1KLC2GWRlKSol_qSKGNfwEPbk4L3QDsZifa16-m1yjDuHkSrLWBBGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV3bwy1ybjYAMVz0Nzsbjih3YRMUGd3-0hu289QbshzA&oe=6AE74C61"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32Qi_T8-EHkQ7kNvwF_7_6-&_nc_oc=Adra-l8bHWovTx5s-VzREw54DyT3DPZwGwcQPr0Cj85bdP-QgCpG1t9SVqU_0HmtiEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwQDgLzEUw-ZAFQmW6lDsoXpU1WGnQQCfMJbyZNG_ZmA&oe=6AE74301"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF_CHbokbd8Q7kNvwHRk_wI&_nc_oc=AdrEAfJTfVxQIKjp118fhY4AyAqexuJ8J51RCua9FXVu5G-lpSJoBFtLAiWaD6tnwAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvbfSpNZt6tei44hLkOiZFu_zFM4Yd-I3g2ohab27N9A&oe=6AE75A4F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsbOZCXBggkQ7kNvwEqm-GY&_nc_oc=AdpSdqyG63RbsEm-4cD0pjnT8HTM8HhscJlyRVbMu_9A_8CTaKog854fU8nc7VftkOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsFrAmmQcCygEE_DoxvRnV8GmNIBX0gQSLom6Y27ZQ6w&oe=6AE7493D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nexusplanet.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "HumAi LLC", "support_website_url": "https://www.nexusplanet.app/", "website_url": "https://www.nexusplanet.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "c
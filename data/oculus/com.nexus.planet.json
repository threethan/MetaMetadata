.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMZo5zqgPs8Q7kNvwFhdI9S&_nc_oc=AdoO9XqoJO5dUtHMp4sI2gf0d97mjZ09SDIdmFdGahIpQgjrFbWYbJfkqDLpeNkiQL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDs6gGveXA5fv8rCTKI-tnuHHeiVxg6OP-lIsVi7Jeaw&oe=6A95E236"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBGZyJj-YvgQ7kNvwEF-LuY&_nc_oc=AdoJm4dUA_Jq96CJS6vHbZ8FoJV_P86df5WeyB5QiPwwUkHgqOq-x38eQewniJYirTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4s54wu3kx8_DYecClfNGVUnOMUj507P_0JZnxQZfUQA&oe=6A95C7A1"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqmWe7q3wHIQ7kNvwGS3Upt&_nc_oc=AdqC92m60ypyxXY4RHyR7lumG0tQMuBdzD1gag13E3w5U_AaRDPDw2EJSBxYM2-EymU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGUM0_9RACNMb18h7SZOFwxulD_4XVvl2wukIvqSGxgg&oe=6A95BE41"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Alff-UOUbsAQ7kNvwEy5xPm&_nc_oc=Adpn09w53Gwi-hOxROHkjxRYGZxs6QxAyxvuIqEE_Cv0uLOCyBqGGTI1PjG3tKwDC0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtGpc5qst1za9VB4dJbDy1aqFWvbgz1Av0ZfP-PUtQTw&oe=6A95D58F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5OyGUdzSfMQ7kNvwGTyJNA&_nc_oc=AdqA1ZbzCP632ZgdbqnMAle0aCTEe78WbDHBZ1LtavGDNh663xAwCLvsHElXgCCrHUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2sGSUDljCdfRO_1KpkNz923VEJVlwIWigGV1kVYYVsg&oe=6A95C47D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
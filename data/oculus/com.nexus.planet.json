.oculuscdn.com/v/t64.5771-25/499620817_1560118509065649_2773011021006173323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAY76wGBTBEQ7kNvwGqu0x2&_nc_oc=AdpHfUIFCg6i3Y101Lmwh0lT2FKKSjLr18OgJoUsZHqpIL9skvKogFfTcHm1h32-Zhc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrUa99GqIpB6yzLW8a-la3b8rEkjXvsnGAEflVeVZPgQ&oe=6A8842B6"}, {"file_name": "Screenshot_2.png", "id": "1657771802130092", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618251_1657771805463425_5710817363939403387_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikFzy_uTmRcQ7kNvwHk6bz8&_nc_oc=Adq5Kdv1AL_XVQ6OPpMTyyf3ZI97PYx8At09f0uHOnpiAutHvXd6au5C-NWOxMDi26Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHOJSVpDFUY-7z8j6dIHzLEgCiOTESuys_wCjq489GMQ&oe=6A882821"}, {"file_name": "Screenshot_1.png", "id": "966365689702397", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618274_966365693035730_7770093745004937336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhlXlOnx-4wQ7kNvwHj13xI&_nc_oc=Adp7_yzIFOvEEKsGurEgxozVvRhsVfs1rFCxwBm9b_KWD4WLDpo-KGRFpAFY8nf68MQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfIiG6fTQce7EwsgdbI8j8c5V6NpARt4iA-AgxZJgAwg&oe=6A881EC1"}, {"file_name": "Screenshot_5.png", "id": "2143552986422222", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618515_2143552989755555_7209456047043989911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcYY0tDFcIsQ7kNvwEDjtef&_nc_oc=AdrKBF3mIsyCrwD8wmSf6MKDwBmFdidriAnzatt20OQSEYMaL4hEcWTAA7Oqe5v9yN0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9eP6ExELpCFhZan7l3UfU9BYGerz5JL9oghK1V-ECAw&oe=6A88360F"}, {"file_name": "Screenshot_3.png", "id": "1438034308093953", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618093_1438034314760619_5109060006368110330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmZBiqpCVpQQ7kNvwFCqmAx&_nc_oc=Adq-7akoMpA4QjZFwyvE3jUiKj0LEPQY9Jdne1lngA8MIWBbsaVMdKo_aFLDHGQ12ms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEslla0sKjMK-eRqyjLYQMdXUaYXmAjJ7AyW8Jq_KInSQ&oe=6A8824FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Planet", "keywords": [], "long_description": "# Land on Nexus Planet\n\n**A multiplayer VR world for meeting people and sharing what you love.**\n\nPut on your Quest and you've landed. Walk to the campfire. Surfaces are everywhere. Pull a song, a video, a whiteboard, or your screen out of the Companion, hit Share, and everyone in range is in it with you.\n\n## Where you land\n\n**Crystal Forest** :  The main hangout, where multiple groups can share to different surfaces.\n\n**Personal Space**:  Your private bio-dome. Sit at the desk and the virtual furniture fades. Passthrough opens a window to your real desk so you can use your physical keyboard, with a screen share floating in front of you like a monitor.\n\nMore locations on the way.\n\n## How it works\n\n1. Land in Crystal Forest: The public room is always open\n2. Sign in at irl.nexusplanet.app, no install\n3. Pair with the 6-character code on your dashboard\n4. Pull anything onto your glove to enjoy privately or \u2192 walk to a surface \u2192 hit Share\n\nFree on the Meta Quest Store. Compatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n{2087072748544190}\n{974694611831247}\n{1690407888976095}\n{4426212484322936}\n{1704505160741501}\n{2014717269174489}\n{858850103932855}\n{2492939874512102}\n{1632097071418238}\n{977179808022292}", "short_description": "Nexus Planet is a multiplayer VR world for hanging out and sharing what you love. Meet at the campfire in Crystal Forest, then share music, video, screens, and whiteboards onto the surfaces around you. The IRL Companion allows you to bring in media from any browser, no installation required. Step into your private bio-dome anytime, sit at your real desk with passthrough, and bring up a screen share like a giant monitor."}]}, "developer_name": null, "develo
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Guf2XDHYMjEQ7kNvwEnPUG7&_nc_oc=AdrA5Y5d13V80bTjYVvl76sDCDRqyhuOEJC2K1R6ZPbXmiqgh4QyGa5P9CrmHGgrebE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-GwygdA1FLujihNbpYubrQphJFNGhKAPu8GZqeSLUjw&oe=69E387EC"}, {"file_name": "BSO2_SS3.png", "id": "2411259715977106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507830479_2411259719310439_543754859527324704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy3AXdfvTpgQ7kNvwH7ViZH&_nc_oc=AdrTpEjFMD6PilLTXHdcBTP4cd76ZFq5mauoGmbBWUc139IWVzrtZ1dfoBkgJJaMIgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Kjvzau7wHyQfLf2JZttOvu1OHm46yMSs9GH_FaZB6KQ&oe=69E37ABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Offroad Bus Simulator VR: Real Driving", "keywords": ["Offroad", "Bus", "Simulator", "VR", "Driving"], "long_description": "Take command of the most realistic off-road bus simulation in VR! Offroad Bus Simulator VR: Real Driving delivers the definitive driving test for Meta Quest. Operate powerful, customizable heavy vehicles and conquer the world\u2019s most extreme terrains.\n\n\ud83d\ude8c CONQUER EXTREME TERRAIN & MOUNTAIN TRACKS\nMaster treacherous mountain climbs and high-altitude passes where focus is vital. Navigate brutal off-road trails, rocky paths, and muddy slopes that push your bus and skill to the limit. Every route is a raw, technical challenge for simulation enthusiasts.\n\n\ud83c\udf27\ufe0f DYNAMIC ENVIRONMENTS & WEATHER\nOutsmart intelligent AI traffic that reacts to your moves. Adapt to dynamic weather\u2014dense fog, torrential rain, and slippery mud transform traction and visibility, making every drive a unique survival battle.\n\n\ud83d\udee0\ufe0f CUSTOMIZATION & PROGRESSION\nPersonalize a fleet of buses with distinct liveries and visual upgrades. Progress by mastering scenario-based missions across escalating difficulties. True-to-life physics and authentic handling make each bus feel uniquely realistic.\n\n\ud83c\udfaf TRUE VR IMMERSION\nBuilt exclusively for VR. Physically grab the wheel, toggle cabin switches, and command your bus with intuitive motion controls. This is authentic presence, haptic feedback, and the most immersive driving experience on Quest.\n\nReady for the ultimate driving test? The terrain doesn\u2019t forgive. Do you have the skill to command it? Download the #1 off-road bus simulator today!", "short_description": "Experience adrenaline-pumping off-road bus driving in VR! Conquer extreme mountain ascents, navigate brutal rock-filled trails, and master technical tracks with lifelike physics. Battle dynamic weather systems, avoid intelligent AI traffic, and progress through challenging levels in immersive worlds. Customize multiple buses with unique liveries, tackle scenario-based missions, and feel authentic vehicle handling in this comprehensive off-road simulation - the most intense bus driving experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25732822769701666"}}]}, "scheduled_
pKJPot5EyPRi5gQtWKnxUgooQtdjUAYwNS1oOaxpoHRh49loaw0vN8pmu3sDuZkgE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH943dJANLXRK1kVVIv3ZAwZlj26U-KmULiQAm0nFnb4w&oe=6A971D45"}, "display_name": "MonkeyCrazy", "keywords": [], "long_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Gorilla Tag! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!", "short_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Monkey Crazy! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/presentation/d/1zJEVfC4i5MxkUdjWHT8C-f2fANq3lS6kAbg2RrxuChY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Sway", "support_website_url": null, "website_url": "https://docs.google.com/presentation/d/1Enq-PuF2-m8PYx50BpqrF5SaR07kRSmaHmzEpTWcW10/edit#slide=id.p", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMEN
ll, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-29 185514.png", "id": "464528736405010", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031622_464528739738343_4196416711191645283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGfNXBCmZAAQ7kNvwFXPDpG&_nc_oc=Admt4zJKHDzU40jKxQ7Gw-8qnVE3bKv2OumcU5CrWIN_5JG0io4K6znwfZf1gpGXjjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrHf8jxnq5c_LackR1hghqIs_jyRVNVWWkF7wxtw4CMw&oe=69AC01C5"}, "display_name": "MonkeyCrazy", "keywords": [], "long_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Gorilla Tag! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!", "short_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Monkey Crazy! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/presentation/d/1zJEVfC4i5MxkUdjWHT8C-f2fANq3lS6kAbg2RrxuChY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Sway", "support_website_url": null, "website_url": "https://docs.google.com/presentation/d/1Enq-PuF2-m8PYx50BpqrF5SaR07kRSmaHmzEpTWcW10/edit#slide=id.p", "category": null, "comfort_rating": "COMFORTABLE_FOR_MO
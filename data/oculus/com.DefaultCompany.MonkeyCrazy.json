8_1684759002297630_8960864788569769184_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIiNvvIYWWUQ7kNvwFuIAAH&_nc_oc=AdrXmzSo1RVKxR9G_tI-eI0GmbRCsfBBjT63YN3g7PoGl2PBY-VbcBiJnfm_8U2jZso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeWO_7TBQtpmsUN-DT3ilxMItvN_Jqd5MnWJhS0GaCtQ&oe=6AFDBC9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-29 185514.png", "id": "464528736405010", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031622_464528739738343_4196416711191645283_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElhZQnKmpDEQ7kNvwEampOD&_nc_oc=Adqt13eAwkSEdbD9iqMjvu97x7r_cXvGfgTJ9YIRXsOpbLOXZEigAv5Pi60fBL7F1kM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRifIpdT58fQXIe2Pt1UA6ecu0XArV8_28xnblNJt88GQ&oe=6AFDBA05"}, "display_name": "MonkeyCrazy", "keywords": [], "long_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Gorilla Tag! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!", "short_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Monkey Crazy! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!"}]}, "developer_name": null, "developer_pri
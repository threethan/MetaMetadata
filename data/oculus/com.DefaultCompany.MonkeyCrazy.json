8_1684759002297630_8960864788569769184_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXU9QOlspYUQ7kNvwEul-C-&_nc_oc=AdqE3y9V4zt5rvqNRD0uAD27WtnvEhyAtlm_FIek6oGisC2lyQRmuFGxWj89ANzd_xY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQk8oZ79a_0c_6YPvxsdFsVVVIKcnXcaH6iCvQmb3V9Q&oe=6B005F9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-29 185514.png", "id": "464528736405010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031622_464528739738343_4196416711191645283_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxxlOYwSmewQ7kNvwE31ELs&_nc_oc=AdqZ-nryvd27Q7rb10KoNw22k35w9vN6MYRSDJpE-oc62CyMN0FdBOFTHSZzzIMcpoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBf7c2wuTGigWcST6gycm_C39SLrMi6_6GWxh8I7Tz1A&oe=6B005D05"}, "display_name": "MonkeyCrazy", "keywords": [], "long_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Gorilla Tag! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!", "short_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Monkey Crazy! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!"}]}, "developer_name": null, "developer_pri
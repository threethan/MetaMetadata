8_1684759002297630_8960864788569769184_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTidYiPz9pEQ7kNvwGdCg8C&_nc_oc=AdobuxjlaWeq2-BOC4feNQXGjq90LohKlQHWVKkR1a2jwtkdhgqnq3xWlRLSv04tE5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQmwMhty0T58mP2FApSfO-hBMve8eYuZjoVk_ZpVG3dw&oe=6B0C755B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-29 185514.png", "id": "464528736405010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031622_464528739738343_4196416711191645283_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcP4jAdHjM8Q7kNvwHiFzmA&_nc_oc=AdqdpIZwqyS-ESlGIRgg4SC1f3WnfrngXeGU1el3VFvFAoxrs4m56UIhvX2jUr6c650&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRXrAf5_c0NBorFq_bhzQCTTl48Y1biGq2RWb_AUVGSdQ&oe=6B0C72C5"}, "display_name": "MonkeyCrazy", "keywords": [], "long_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Gorilla Tag! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!", "short_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Monkey Crazy! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!"}]}, "developer_name": null, "developer_pri
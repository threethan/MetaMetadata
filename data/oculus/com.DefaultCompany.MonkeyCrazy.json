8_1684759002297630_8960864788569769184_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7xV-uqaRCAQ7kNvwFWu5_a&_nc_oc=Ado6NxFX6AelHxWHYTeasUhEen7sAwzWzwrRDdIwpNgggykAZwO81ttuU0WEww-cxSI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt8Xu_M-5T6MdMen1ebft0NSDjb77lwBVFAGZmUsI8FQ&oe=6B09D25B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-29 185514.png", "id": "464528736405010", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031622_464528739738343_4196416711191645283_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jLBVFtC4qsQ7kNvwGbAc_p&_nc_oc=AdpcKTPi7CVdKsgPpIqE-T6OOBL4WlWmzCbCtKtK6duvXznljm6btdBPRLa0tjhyfBo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxIN7mcyL2tjiykhcsUEBCOWyZhAn-EJmwa0Qib6vdaQ&oe=6B09CFC5"}, "display_name": "MonkeyCrazy", "keywords": [], "long_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Gorilla Tag! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!", "short_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Monkey Crazy! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!"}]}, "developer_name": null, "developer_pri
8_1684759002297630_8960864788569769184_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53cZo14OVwMQ7kNvwFGjmEw&_nc_oc=AdpsyxspmXYhg1VWf3z0tS_6wJsbpON5z0RoFdRvr8GCmCQcs5VzfijuqW9zDL5NCNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0YAIIbmjchLon4QUNzV3l_3WolEBnz_zA8lDiacPVyw&oe=6B03029B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-29 185514.png", "id": "464528736405010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031622_464528739738343_4196416711191645283_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbXngf7Kf8sQ7kNvwEoFar-&_nc_oc=AdrIw0IBcvuDAZO89fNkj0TszHOQxk9ERtfYYCDunUBLgxEb8sNlm4fCNzZPOe0Gsbs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0UsaVEMimN1auFN1t0_9J2j3FF5mRd4aMktfR8jVr-w&oe=6B033845"}, "display_name": "MonkeyCrazy", "keywords": [], "long_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Gorilla Tag! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!", "short_description": "\nSwing into action in this thrilling fan-made game inspired by the exhilarating world of Monkey Crazy! Take on the role of a nimble gorilla as you traverse vibrant jungle environments, leaping from tree to tree with unmatched agility. Dodge obstacles, outsmart your opponents, and race against the clock to become the ultimate jungle champion. With intuitive controls and fast-paced gameplay, this homage to Gorilla Tag delivers an immersive experience that will have you swinging back for more!"}]}, "developer_name": null, "developer_pri
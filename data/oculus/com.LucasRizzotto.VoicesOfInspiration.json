mU_67Q&oe=69B959E1"}, "display_name": "Voices of Inspiration", "keywords": [], "long_description": "Voices of Inspiration is an experience that immerses you in the audio stories, aspirations, and artwork of children at St. Jude as you journey to the stars in a futuristic space elevator.\n\nBuilt in collaboration with the astronauts of the Inspiration4 SpaceX mission, explore beautiful virtual worlds as you awaken small creatures to reveal voice messages left by St. Judes patients... and reflect on their stories as you ascend into the stars.", "short_description": "Voices of Inspiration is an experience that immerses you in the audio stories, aspirations, and artwork of children at St. Jude as you journey to the stars in a futuristic space elevator.\n\nBuilt in collaboration with the astronauts of the Inspiration4 SpaceX mission, explore beautiful virtual worlds as you awaken small creatures to reveal voice messages left by St. Judes patients... and reflect on their stories as you ascend into the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lucasrizzotto.com/voices-of-inspiration-privacy-policy", "developer_terms_of_service_url": "https://www.lucasrizzotto.com/voices-of-inspiration-terms-of-service", "publisher_name": "Thought Co.", "support_website_url": "http://lucasrizzotto.com/", "website_url": "http://lucasrizzotto.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "SPACE_UNIVERSE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
53", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1000898010703719_8586270408601686302_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lM_1pEYbC-UQ7kNvwEsJv6R&_nc_oc=AdpDP8msfRJZDaaj5HZCl17IAbBTDTDeMs3w0PU4k7a_DaenNmF4xlFB0g0hxfJD--Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX7UrmL50B8vqj8IVwPpR43yQvHMZPRAbrIrXeigg-1wQ&oe=6B105821"}, "display_name": "Voices of Inspiration", "keywords": [], "long_description": "Voices of Inspiration is an experience that immerses you in the audio stories, aspirations, and artwork of children at St. Jude as you journey to the stars in a futuristic space elevator.\n\nBuilt in collaboration with the astronauts of the Inspiration4 SpaceX mission, explore beautiful virtual worlds as you awaken small creatures to reveal voice messages left by St. Judes patients... and reflect on their stories as you ascend into the stars.", "short_description": "Voices of Inspiration is an experience that immerses you in the audio stories, aspirations, and artwork of children at St. Jude as you journey to the stars in a futuristic space elevator.\n\nBuilt in collaboration with the astronauts of the Inspiration4 SpaceX mission, explore beautiful virtual worlds as you awaken small creatures to reveal voice messages left by St. Judes patients... and reflect on their stories as you ascend into the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lucasrizzotto.com/voices-of-inspiration-privacy-policy", "developer_terms_of_service_url": "https://www.lucasrizzotto.com/voices-of-inspiration-terms-of-service", "publisher_name": "Thought Co.", "support_website_url": "http://lucasrizzotto.com/", "website_url": "http://lucasrizzotto.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_t
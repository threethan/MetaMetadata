nt-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9WPFseQ9CUVkLk6kRw_9bE1MViQj9xX7UyVPvEXnt2w&oe=69B4032F"}, {"file_name": "Screenshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np2GeAvlwi0Q7kNvwHV-_ys&_nc_oc=AdmYu74qebBQOxpg8MDM-EVFu2f0hrXHIfoPj4t0IpvdcrC-3NGc5t8aanZYOD72Nho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOMse5suBm-9q19ff2ppQEo0cESGut48I5VdqgiwILBQ&oe=69B40818"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXpKNuSo3U8Q7kNvwF1z5b4&_nc_oc=AdknMrdMMOPs8vp2FNEz0bTk5WXN2Sz_eA9Y6WkZW6TXjszrXj6yg85hqitu47vpeiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afze6e-mR6hPFTE-yAnJH8uIG5Qp0F6ew9WgUiv8Zg68Lg&oe=69B420BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_1440.png", "id": "1805903733510330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392011_1805903736843663_8655120745908322571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlEjtAOchwMQ7kNvwFiC5mU&_nc_oc=Adk8S_gET8kbbqhDfGtjJA953GRCjNntuB4hRK45V1dYBCDDpoLDIcwUp5awrxHFHQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfieeWUbkjNeYDEviDy1UGywoKCSma8yR3ao77Z-c2EQ&oe=69B3ED81"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26339874758981408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392031_1336834453979363_5307226698956651382_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB0ZidwznFgQ7kNvwGeGKs6&_nc_oc=AdnMRXIXtmCYKcZ3FPgvtntw1WjHCQg4L_Igukjc9DW_5CICfIF_LxMwUyxvnORwaM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8aon8Uw8rWjpgqx5QXktiO7Vl39-jmt00NoQ20sbxNA&oe=69B41F52"}, "is_concept": false, "is_
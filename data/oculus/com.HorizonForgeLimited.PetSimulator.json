_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBtSF2YBp3wQ7kNvwHZDMDO&_nc_oc=AdoE0OtD3pGGBnlp1SFf0WWwIi3vUwB6UjuVyvp_LvpAbOnLUDHgRT2sIq8O70HYyX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAhK5AZgYUL2Jc2GHdmipGI0L_OM-3mDfsR--FVwY6SQ&oe=6B0F1881"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play
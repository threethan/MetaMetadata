nt-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhRKoD88xY2jPWun9Cwt2Do39PlVC5wOlgZ5aPkPmJaA&oe=69AEBD2F"}, {"file_name": "Screenshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AB-v_VcKAVIQ7kNvwFoqsXT&_nc_oc=AdkiFSoGwPJ_PkfHo0z1NjroXp-uamSCSmh755iomVEj2UEGVkkuI3FqGfq2iUrvrFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh59adnuI4ELkeEMjxacUyVrmDVpw1I74OpzoepC6Bwg&oe=69AEC218"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwJ18srtNXgQ7kNvwF5eMOk&_nc_oc=AdnB_7Tzpu7pFDSu4HIVD1jPZ5b_jCmfCI3u_ySYUKVwlg1pEt7cG8H2TZGja1bYoGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOmzXDVhz6MiTXklk0kbOigJ9YV9KyAWl_Whidm25BwQ&oe=69AEA27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_1440.png", "id": "1805903733510330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392011_1805903736843663_8655120745908322571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zWjPht2bVEQ7kNvwFaOzcz&_nc_oc=AdmrFI3twLhdb_sPrO3AEdGJcpbfqriAfqrfluXY9V2oV_IlIQ-wlPPNUZ2GQpTQWYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzouicj4udxLxu33C04htDX-w7ONrvRDPftO9Z7z49r_g&oe=69AEA781"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26339874758981408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392031_1336834453979363_5307226698956651382_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiBDUKTCTbwQ7kNvwFXfGYg&_nc_oc=AdlK_kHm0Nar0BWHFEzDjQCVx41N22vPs9BbfjzKAKZePZC2LnrqzvzWaMZIJ67-2Aw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyysfJlg_vbNpgv9WFGZ-PV-zM1Y5tpxbHwVfXMZhphw&oe=69AED952"}, "is_concept": false, "is_
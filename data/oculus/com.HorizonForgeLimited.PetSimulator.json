nt-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYzbvtC4-ipz88OEzpB2PapM5Olsx1GiXvZzlxylcLkg&oe=69BD3DAF"}, {"file_name": "Screenshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ6DckzO9LYQ7kNvwH46Soa&_nc_oc=Adn-hNUePlDlc_QldNJ2dqsgZtys8ulMkIL71ZD_vcxbPfgEKqCLsNIB8CglwVEzGGA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM9AjdvV-aI2eVyIo4j_cBSq7nXXCxaUGLfSfyvqL5Gg&oe=69BD4298"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spK4Jo0IlmYQ7kNvwFLNsEI&_nc_oc=AdmEutJj6EiP2larUCIRJ2v89o9lMcpSbcrIrvKgjAxJxqEtLvPdSGftr93RcWuDq8w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNgJRYKBFRvT1kjxty_nIGGTt5_K6pho64eUGBIuZBMQ&oe=69BD5B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_1440.png", "id": "1805903733510330", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392011_1805903736843663_8655120745908322571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvZObUVhwEcQ7kNvwFfNc06&_nc_oc=Adli9dFvTxRkLaSj493lUMBo2jso6Zjcxz_fsa6BE4uaeW2OkT9uS67wgQ-ar8juKQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfybHKFCkqO6VhNBiAxXCudxM8t6WVSNObynfx3mtknjzQ&oe=69BD6041"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26339874758981408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392031_1336834453979363_5307226698956651382_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPHWFIDn2o4Q7kNvwFAD35Q&_nc_oc=AdkhV4Bpsb3y0jPrrCxcTDLSpEdMiQNLmRz4ocnMV66b_85ZS17Va1o6nRH8cx7R9YA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaSXbUB-KfWioCpxFO_9KFgYFDYL5X_8N7ZKU8msgZiw&oe=69BD59D2"}, "is_concept": false, "is_
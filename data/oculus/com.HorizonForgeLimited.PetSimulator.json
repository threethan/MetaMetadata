_ 2.png", "id": "625214600038613", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392325_625214603371946_7224442020462093701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA5pgzy83F4Q7kNvwEzpgZQ&_nc_oc=Ado82WtMh8fCW3MQdaB4b3NOxBVRFzzv1Of73KqEwp_maMVzYabygt02SfLaE_a1lhU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaTPomLediT0zHGZM9kmEeDdS6GbGa0Hrr24AG8adarQ&oe=6A85A1AF"}, {"file_name": "Screenshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Gom4kE5zjQQ7kNvwGVD4He&_nc_oc=AdpVOWdi8hcAhrm2Q5MESkltClRbiiEf-jt4m8Eu6SUvSvYvBPbpdblT8Offdj5RzPg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-KXXXU6hjZOO4yXlVhZmmHB3h-bH6b9eO7WfdGi25iw&oe=6A85A698"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jx4DgDeZqtwQ7kNvwH7Q_C4&_nc_oc=AdqVM6q8wXbmyOfTE-gGPfmvULGvrkspfCsspnA99gKHeRx4nTlrmv6sdIvlkn_2IRw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTtDaTIqe0Vt3CvuBhz9BQX5DiUqS1FkojMfV0EJeSag&oe=6A8586FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_1440.png", "id": "1805903733510330", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392011_1805903736843663_8655120745908322571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mx_SdF2mm4Q7kNvwFj9tlD&_nc_oc=AdpSdNn-BWFlHHxCLZ_skCHXUDs96snAsP1BwRaT5pj78TQBN_meLNor8bqqAENtmEI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrsbxqSYoitf4plvV_lcjGBiLL9tnAAYsIKbQJK9rNtg&oe=6A858C01"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26339874758981408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392031_1336834453979363_5307226
content-sjc3-1.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChE-fzeu1RoQ7kNvwE2tm6T&_nc_oc=AdmDfzD4q96V1EytcgDcjK62u2Axvtauf6WxI5t3yxuJRdLF-UAU6zeOKyIqAb-P3GQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvovdFDLKLooOK4MBAQ4PimIfB_9kzqyd_hhL97WVh_tA&oe=69985898"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as6EabXl6bYQ7kNvwEAKKDl&_nc_oc=Adm7wQvxTO_I_k8sSE3eftPxos2S7VFTFvtplUR-SogovprCsWlUz2ScsaOhkdV2goM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsG3H6Euy5nLkNVOJF24GqjuuI6q88dubLo9RPAsJi0ww&oe=6998713B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pet Simulator - I am Pet", "keywords": ["Pet", "Simulator", "iamdog", "iamcat", "iamrabbit"], "long_description": "\"Pet Simulator - I am Pet,\" the ultimate VR sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n\nIn this game, you can cook delicious meals for your owner, feed them, and even have heartwarming interactions. But that's not all! Venture out and meet other pets in the neighbourhood, make new friends, and discover hidden secrets. When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures.\n\nWith stunning graphics, realistic animations, and a captivating storyline, \"Pet Simulator - I am Pet\" offers a unique and engaging experience for all ages. Whether you're a pet lover or just looking for a fun and interactive game, this is the perfect choice for you. Get ready to unleash your inner pet and create unforgettable memories in \"Pet Simulator - I am Pet\"!", "short_description": "\"Pet Simulator - I am Pet\" is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/petsimulatorprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9374847382577411"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1233901431405683"}, {"status": "PUBLISHED", "id": "868474362435850"}, {"status": "PUBLISHED", "id": "4378323242443065"}, {"status": "PUBLISHED", "id": "857925786757087"}, {"status": "PUBLISHED", "id": "1174604301379436"}, {"status": "PUBLISHED", "id": "685831287813734"}, {"status": "PUBLISHED", "id": "1077470234431780"}, {"status": "PUBLISHED", "id": "601005132976317"}, {"status": "PUBLISHED", "id": "895229446010110"}, {"status": "PUBLISHED", "id": "651489310885733"}, {"status": "PUBLISHED", "id": "1447261620054517"}]}, "baseline_offer": {"id": "601005132976317"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "i
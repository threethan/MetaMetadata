-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQvePRfUxtwQb14blGuEtUa4d2zjChFrlgAx5lQYMY3g&oe=6A8EC65A"}, {"file_name": "Screenshots_ 2.png", "id": "625214600038613", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392325_625214603371946_7224442020462093701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7GQz6EOKbEQ7kNvwEDR3Hf&_nc_oc=Adp3Dfa1t2ZOSqhe10P9C5R0nHA6wTjGRyAa6gjlgAvTfcEBZ_N9NQHhOdDGLPdsbmo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIE3Xoy_BBXP_JfPjoh2aphMZbGv7u4UgmUGyJX8CZhQ&oe=6A8EDC2F"}, {"file_name": "Screenshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnYiHX2KPNAQ7kNvwE9wJgc&_nc_oc=Adpfme2ea0UcLZ4ec4hOs3rmv2wsy7Wc0kdOfCCgSrlGwhZEFu3FKQEf1TH8ztrFBKU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1wSmK6fwHsBPmQT-MFWUPM759CEN7hLxnee8B9RPgXA&oe=6A8EE118"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHRnOCcxUAMQ7kNvwHhu32l&_nc_oc=AdrnudO9PdmYUG2BeJtJwp81Va87RZf3s-kPEulDz3kmLKT8Qp3k2vKcu3mNmyidTXU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvocmuoOGOU9ahvaHo1-g94Lw6-HIcgr65D04Z1_nCOA&oe=6A8EC17B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_1440.png", "id": "1805903733510330", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392011_1805903736843663_8655120745908322571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRdh5dYeMHAQ7kNvwHgi0cr&_nc_oc=AdqX2VNuhYkVqQ76slS5VcWZp8-kSCU0KcgHT7O122CIfR363BQMzXImTWI4RnLO7WM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRyFBhAFc7RyAxdhDsFN6TAlLium62aNluiDteDtitkQ&oe=6A8EC681"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26339874758981408"}, "review_messages": [
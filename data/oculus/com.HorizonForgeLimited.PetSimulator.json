dn.com&_nc_ss=7f20f&oh=00_AQJsOcrWZ3Zx4aAwTvTnqTlrbajMunkyyNvPkKiE6q0l6A&oe=6AA4169A"}, {"file_name": "Screenshots_ 2.png", "id": "625214600038613", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392325_625214603371946_7224442020462093701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqA8VfTAkUYQ7kNvwG2eyuU&_nc_oc=AdqJUmUl8qKqKTfi4H9ovmmpf0vVPi8YgNsEH59TAtEtt0tGmFFAc0LMCy0qYKPPyaI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaBBkPB94P-2hwTmypszUyMZN9LQJspnQcYifGw4jM-Q&oe=6AA3F42F"}, {"file_name": "Screenshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr4AOwytlRYQ7kNvwGsX_gr&_nc_oc=Adrw1ETD-mD8PLUqlMjfNKu0twVrLzJ7tI-lI148Hl_kxo0f-fPipb7Mq3tdlf37Rdw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-RecHawwYbjK2wc8jYz-Na-X6o1U6dGa3QEO28y_Gfg&oe=6AA3F918"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyxGRJCIKqEQ7kNvwHdRq9J&_nc_oc=AdruxAi7xpsYjsJmBSqca6MSH6XaPz6MLsTslXvFTTbpkWm_tKpxUS_7o3uIdWI3ImI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-GlefYuRo6sNr0O0od0lA-PZHNwuJxN0NYMd8aYg2Bw&oe=6AA411BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_1440.png", "id": "1805903733510330", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392011_1805903736843663_8655120745908322571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNQ83J-nE18Q7kNvwFNcwlr&_nc_oc=Adr0Z9lalycW9bP6fUImtGy1Z5sMvu8GnTzk03BCbYDi45vHHXl2OvDCSp9OTp8F9zM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKHxVOXbj5idimC_7-L_BIH4iFD9g1Pr5_zldKb2eQDA&oe=6AA416C1"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26339874758981408"}, "review_messages": []}]}, "cov
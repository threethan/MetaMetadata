nshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Gom4kE5zjQQ7kNvwGVD4He&_nc_oc=AdpVOWdi8hcAhrm2Q5MESkltClRbiiEf-jt4m8Eu6SUvSvYvBPbpdblT8Offdj5RzPg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-KXXXU6hjZOO4yXlVhZmmHB3h-bH6b9eO7WfdGi25iw&oe=6A85A698"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jx4DgDeZqtwQ7kNvwH7Q_C4&_nc_oc=AdqVM6q8wXbmyOfTE-gGPfmvULGvrkspfCsspnA99gKHeRx4nTlrmv6sdIvlkn_2IRw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTtDaTIqe0Vt3CvuBhz9BQX5DiUqS1FkojMfV0EJeSag&oe=6A8586FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pet Simulator - I am Pet", "keywords": ["Pet", "Simulator", "iamdog", "iamcat", "iamrabbit"], "long_description": "\"Pet Simulator - I am Pet,\" the ultimate VR sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n\nIn this game, you can cook delicious meals for your owner, feed them, and even have heartwarming interactions. But that's not all! Venture out and meet other pets in the neighbourhood, make new friends, and discover hidden secrets. When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures.\n\nWith stunning graphics, realistic animations, and a captivating storyline, \"Pet Simulator - I am Pet\" offers a unique and engaging experience for all ages. Whether you're a pet lover or just looking for a fun and interactive game, this is the perfect choice for you. Get ready to unleash your inner pet and create unforgettable memories in \"Pet Simulator - I am Pet\"!", "short_description": "\"Pet Simulator - I am Pet\" is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/petsimulatorprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9374847382577411"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1762706781426535"}, {"status": "PUBLISHED", "id": "2062393441375929"}, {"status": "PUBLISHED", "id": "842156068353632"}, {"status": "PUBLISHED", "id": "2022692828279076"}, {"status": "PUBLISHED", "id": "888114360732919"}, {"status": "PUBLISHED", "id": "1233901431405683"}, {"status": "PUBLISHED", "id": "868474362435850"}, {"status": "PUBLISHED", "id": "4378323242443065"}, {"status": "PUBLISHED", "id": "857925786757087"}, {"status": "PUBLISHED", "id": "1174604301379436"}, {"status": "PUBLISHED", "id": "685831287813734"}, {"status": "PUBLISHED", "id": "1077470234431780"}, {"status"
EYrNEvr2NM1RSSg&oe=69BE9418"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spK4Jo0IlmYQ7kNvwFwGwUZ&_nc_oc=Adnre6PwJcjxtV3gxRfgu3D4kEyz5FPNvomaVSoqpQPnQYz1boe8-LLsryGfBPX1uaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPv7JOVMSwGdGngjmad6aPYA5yZuA7HFr5e5cUlYGz8Q&oe=69BEACBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pet Simulator - I am Pet", "keywords": ["Pet", "Simulator", "iamdog", "iamcat", "iamrabbit"], "long_description": "\"Pet Simulator - I am Pet,\" the ultimate VR sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n\nIn this game, you can cook delicious meals for your owner, feed them, and even have heartwarming interactions. But that's not all! Venture out and meet other pets in the neighbourhood, make new friends, and discover hidden secrets. When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures.\n\nWith stunning graphics, realistic animations, and a captivating storyline, \"Pet Simulator - I am Pet\" offers a unique and engaging experience for all ages. Whether you're a pet lover or just looking for a fun and interactive game, this is the perfect choice for you. Get ready to unleash your inner pet and create unforgettable memories in \"Pet Simulator - I am Pet\"!", "short_description": "\"Pet Simulator - I am Pet\" is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimi
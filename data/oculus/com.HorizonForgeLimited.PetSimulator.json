&_nc_ss=7f20f&oh=00_AQQgW2x4wlPlcPRIgmGZZI5l1jXt5Pwk2Fj4FCplzfnMNg&oe=6AEF3C1A"}, {"file_name": "Screenshots_ 2.png", "id": "625214600038613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392325_625214603371946_7224442020462093701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUfLl2geSeUQ7kNvwGYHF_u&_nc_oc=AdqakiwS5VeFSzbZJXZA9VsmnMC0zC77DzZNz-ZRFHZWHF5DrHD4iq6RjjkliCI8ALs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQrNPqWPMiQ2XK_98g-B0xMKFNmFeVZR4zdJdQH9CBFQ&oe=6AEF51EF"}, {"file_name": "Screenshots_ 1.png", "id": "486933930779683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391940_486933934113016_2256889208964655744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kz8SEvjlx4Q7kNvwEnItaA&_nc_oc=AdqsZ9wScgD0qGmfWrwhBYMDgrIDuJCz7rzICAov_NgOHTAhwoe4nEjcmSVc2sGGLQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKIwnD6folUztwTYTMgkFdoN-UEQOH1OKYz739KzSzeg&oe=6AEF56D8"}, {"file_name": "Screenshots_ 4.png", "id": "2809681835858961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391905_2809681839192294_6555015124199425041_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1L2AgNaE_MQ7kNvwEEFNS1&_nc_oc=AdryDnwQNcna4XkeMmzxQ_gyBp74ygfeOcARj33jvkVKuWJzxRoO1v24b6bDBC1K1rM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGFSQp85dwLTjskytbpl2HTtVUTiipl_mUrxqa2D9UFw&oe=6AEF373B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_1440.png", "id": "1805903733510330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392011_1805903736843663_8655120745908322571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzG0AKlCBeEQ7kNvwGE7RP3&_nc_oc=AdrPFkti36QbZ6iv6iV8rYRASYOGGFo1QBwK0akcKo2bzeU7SYpcz47fV2o5OX_10qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Q9qnUVRqxy_KaaOm0M3lGh6wHDH6r7b79WSsjofs9Q&oe=6AEF3C41"}, "display_name": "Pet Simulator", "keywords": ["Pet", "Simulator", "CatSimulator", "DogSimulator"], "long_description": "\n- Cook\n- Feed \n- Roam in the neighbourhood\n- Discover hidden secrets\n- Open Portals\n- Use physical hand to crawl/walk \n\nThe ultimate VR fun sandbox game where you get to live the life of a beloved pet! Choose to be a playful cat or a loyal dog and immerse yourself in a world filled with endless possibilities.\n{651659507296890}\n\n**When your owner is not around, open portals to explore new dimensions and embark on thrilling adventures**\n{926377349694392}\n\n**Be the good pet and enjoy the sandbox simulation of pets who travelled from the future to complete their mission**\n{952558316974442}", "short_description": "Pet Simulator - I am Pet , is a fun sandbox simulation game. Experience life as a cat or dog in this VR sandbox . Cook, feed, and interact with your owner, meet other neighbourhood pets, and explore hidden portals when your owner is away. Unleash your inner pet and embark on endless adventures"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26339874758981408"}, "review_messages": []}]}, "cover_squar
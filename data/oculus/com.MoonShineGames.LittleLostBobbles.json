I0F1JzI0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl4Q6bX41ad3s3h9gGwxMlCmYDYi4EwrWqGNGGSsY5IQ&oe=6B01D7EF"}, {"file_name": "ss4.png", "id": "441387230691682", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570299_441387234025015_8312505519178068557_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITIPKvPULsMQ7kNvwFjOx2y&_nc_oc=AdpsJ8JiCN93N5LcO_sHHwr-MXdYzsAR3SUGfXddpYpP69NFjH7xZkhx-Yog1uECGFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSafBTTdmEqjSJXyqG5RWR4SYBI66kE8pshdY5jvuoxSw&oe=6B01DB6D"}, {"file_name": "ss3.png", "id": "3952470734852625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302219_3952470744852624_6124622359453872078_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQGfvy3K1sYQ7kNvwHDE6Cz&_nc_oc=Ado0SQ7F5l-mFhjQKE0jBcuQeUdCqS0TU6-u_-kJ145KHtwrPRcETogZeOBHu9A5l1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSvzJsK5gITDa6pmx2rJMxJDF0p5qFBW6Oeg2RLZ3EPA&oe=6B01D255"}, {"file_name": "ss2.png", "id": "648585429852996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031599_648585433186329_4525550948968473178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXMpTC65Ie4Q7kNvwEjHdtG&_nc_oc=AdoY3rt2xTKU-Yy_YXyKWCFzSRRKLgDHkRVRrOZrxhnmsRDx8waHMYQ0iEjBKLjQL_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPSBNsOuRdmiklXMIbCGPkLvSJ51TABdBTiho2azkTdg&oe=6B01BE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LLBMETA.png", "id": "457924883244807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031313_457924886578140_975223054548218567_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HBSLkCSeN0Q7kNvwG3c3CU&_nc_oc=Adp2j1HCf9nliaBfqDNt06KDeIxk0FifmE9t4udi3yePy2WYflGq4p5Gs8YMtNbSIdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3hiyQUG1slFtIEinMHEPboqogZljhvUILGm45Z2CYjA&oe=6B01C9AD"}, "display_name": "Little Lost Bobbles", "keywords": [], "long_description": "In Little Lost Bobbles, the search for the endearing Little Lost Bobbles offers two delightful modes of exploration. Take to the skies aboard the Jellycopter, a whimsical flying contraption designed for scouting missions. Navigate the landscapes from above, scanning the terrain for any signs of the adorable Bobbles. Once spotted, swoop down and carefully scoop them up, ensuring their safe return to their families.\n\nAlternatively, opt for a more grounded approach by traversing the land on foot. Wander through lush forests, and rocky terrains, keeping a keen eye out for any hidden treasures nestled within the bushes. As you tread lightly, you'll stumble upon Little Lost Bobbles peeking out shyly or frolicking amidst the foliage. Extend a helping hand, offering them comfort and companionship as you guide them back to safety.\n\nWhether you choose to soar through the skies or embark on a leisurely stroll, the adventure awaits in Little Lost Bobbles, where every discovery brings you closer to the heart of this whimsical world.", "short_description": "Search for the adorable Little Lost Bobbles either by air with the Jellycopter or by foot, uncovering hidden treasures in the bushes. The choice is yours in this heart-warming adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
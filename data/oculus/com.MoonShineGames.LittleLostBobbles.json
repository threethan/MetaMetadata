hnFL5JALo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR2j5J5Nn4WTt7MmAWkNZ-c_BuRiHVqOIa9fVuJgygpQ&oe=6B071DEF"}, {"file_name": "ss4.png", "id": "441387230691682", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570299_441387234025015_8312505519178068557_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRbMi_L-NJMQ7kNvwH9e1TG&_nc_oc=Adrricy1vMJSlGTdxnwoRhRDsaEugZT5YNquaE1EP8QBQ6t5C1hYAdPCQmr15KP5eyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSut5ladwR90xgRoLAAVOW1HnnezKiT1dT-Bj9CcIKt6A&oe=6B07216D"}, {"file_name": "ss3.png", "id": "3952470734852625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302219_3952470744852624_6124622359453872078_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYpJcaJ2KS0Q7kNvwHCeNPS&_nc_oc=Adr3-TN4jnVv3su-caSBxUJJJap33_cutaf8rVtFwUbdxz-4bDJUAu30E9EMx28d8yA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-n5k9wfvL6p1LVvMJUNCCes0T0tI0lKFDg3-GNfHAWA&oe=6B071855"}, {"file_name": "ss2.png", "id": "648585429852996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031599_648585433186329_4525550948968473178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChpW6QGVwqUQ7kNvwEJnrjt&_nc_oc=AdoPRRiyBTeSzW2rw7SY-j1fd9phjzHkl_HtxjrqEtNYOLlyKnZt9sTh0y_jH_uM8yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5QD0XL2SX90ACd-Gj6M3Q1cqZripoSOzjEoEK5Pm9rg&oe=6B070473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LLBMETA.png", "id": "457924883244807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031313_457924886578140_975223054548218567_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4R1VFLwDwEQ7kNvwHo6HI-&_nc_oc=AdqfsKkk-rBppZ-AhSyeuDkWysQzL5-Y1G6QonhVmSF9bI_7_xNHdykRuRTQ0h6OIFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7mwI8UVeSYvWQktypOaLqZqAFQuv5nOglmuu2t-kLVw&oe=6B070FAD"}, "display_name": "Little Lost Bobbles", "keywords": [], "long_description": "In Little Lost Bobbles, the search for the endearing Little Lost Bobbles offers two delightful modes of exploration. Take to the skies aboard the Jellycopter, a whimsical flying contraption designed for scouting missions. Navigate the landscapes from above, scanning the terrain for any signs of the adorable Bobbles. Once spotted, swoop down and carefully scoop them up, ensuring their safe return to their families.\n\nAlternatively, opt for a more grounded approach by traversing the land on foot. Wander through lush forests, and rocky terrains, keeping a keen eye out for any hidden treasures nestled within the bushes. As you tread lightly, you'll stumble upon Little Lost Bobbles peeking out shyly or frolicking amidst the foliage. Extend a helping hand, offering them comfort and companionship as you guide them back to safety.\n\nWhether you choose to soar through the skies or embark on a leisurely stroll, the adventure awaits in Little Lost Bobbles, where every discovery brings you closer to the heart of this whimsical world.", "short_description": "Search for the adorable Little Lost Bobbles either by air with the Jellycopter or by foot, uncovering hidden treasures in the bushes. The choice is yours in this heart-warming adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
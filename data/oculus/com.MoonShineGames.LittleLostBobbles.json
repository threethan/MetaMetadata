dL1td3VCI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNbu3E52tZkLfXNz9ey2FQ41SvzMMDCZ-sU5MfImIW9Q&oe=6AFC91EF"}, {"file_name": "ss4.png", "id": "441387230691682", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570299_441387234025015_8312505519178068557_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0SoCnu2LFkQ7kNvwHciZ81&_nc_oc=Adp2WM1bhVa4tDgcZH1I9AJQmvz_H95_9pqXMVYRYCGMteVlm8apydvcUbiedOyrRh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShlGsLi2Tlrz6jRntdgXL7kP8QIRNOcGa6qTfs4XqKRw&oe=6AFC956D"}, {"file_name": "ss3.png", "id": "3952470734852625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75302219_3952470744852624_6124622359453872078_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ4Et3PeKhsQ7kNvwGil66m&_nc_oc=Adr2YU-FgQsmEkb7uKCZ1MfelySUI14d2dhuqq5f3LtZdl67VAqdTmUx30IBobuEfxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDX-2xXgtqT4IPxgbsOG9HxHXEubirj4kR3JnApNLLeg&oe=6AFC8C55"}, {"file_name": "ss2.png", "id": "648585429852996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031599_648585433186329_4525550948968473178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ha6wYnCUna4Q7kNvwE1SwaE&_nc_oc=Adrk14SM3gZMTV_tS8nkMCFTnWUrEjQfD4oGiC4_wOGsux2aticKbNgXyH4px6r8ZEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD1OlxKxdKMLWdJT2VSw6Rpm-xmsiq7RKAlGOwx4rYYw&oe=6AFC7873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LLBMETA.png", "id": "457924883244807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031313_457924886578140_975223054548218567_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gda5cnziwREQ7kNvwF66huw&_nc_oc=Adr6KwxWJowDvnb2s48EdY2ZgfU0IO45XTROc-epklBtgw7qqb33Se-qNrUhHtSKTCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIAU_JbftDsw4ApEZMYIV2qH3qwmeud3t4pgJ7rJPKFA&oe=6AFC83AD"}, "display_name": "Little Lost Bobbles", "keywords": [], "long_description": "In Little Lost Bobbles, the search for the endearing Little Lost Bobbles offers two delightful modes of exploration. Take to the skies aboard the Jellycopter, a whimsical flying contraption designed for scouting missions. Navigate the landscapes from above, scanning the terrain for any signs of the adorable Bobbles. Once spotted, swoop down and carefully scoop them up, ensuring their safe return to their families.\n\nAlternatively, opt for a more grounded approach by traversing the land on foot. Wander through lush forests, and rocky terrains, keeping a keen eye out for any hidden treasures nestled within the bushes. As you tread lightly, you'll stumble upon Little Lost Bobbles peeking out shyly or frolicking amidst the foliage. Extend a helping hand, offering them comfort and companionship as you guide them back to safety.\n\nWhether you choose to soar through the skies or embark on a leisurely stroll, the adventure awaits in Little Lost Bobbles, where every discovery brings you closer to the heart of this whimsical world.", "short_description": "Search for the adorable Little Lost Bobbles either by air with the Jellycopter or by foot, uncovering hidden treasures in the bushes. The choice is yours in this heart-warming adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
vRZ302dfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8wkN43kkq8NO3AF_FOeY7vNOW_iymc-6_Zg4IzgQdMw&oe=6B0DB56F"}, {"file_name": "ss4.png", "id": "441387230691682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_441387234025015_8312505519178068557_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnCn-eM0xdYQ7kNvwGqka-o&_nc_oc=AdrNhqjThkEI35Uu7hmRs2XFA9UwsgpR46djBO89bXqZF3008xSN_uaLrDV_tK9qCho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMpoVr2ZZKlf15LLS_rJWSogv7tmFOw6868m9vJ0o17g&oe=6B0DB8ED"}, {"file_name": "ss3.png", "id": "3952470734852625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302219_3952470744852624_6124622359453872078_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NDu8Jl_az0Q7kNvwHYOYiX&_nc_oc=Adoc9l62M912cgdSJXxSaJiQ2pN_NI1Apr8leB6d_d07vMmCVxNjswFOyOWuKFAh-HM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxAJpTWGsauYQc-tTheT0j7JRRvvlSCiHHlouCbBbH9Q&oe=6B0DAFD5"}, {"file_name": "ss2.png", "id": "648585429852996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031599_648585433186329_4525550948968473178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPP-LTipBGcQ7kNvwHMyvAx&_nc_oc=AdqcLY6q-ep7e88vaTHVg7R_-jvITwqA7RWfscl2YC-RTB-_8Mu7fyLYxWy4qUW-n6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOVq4Io4yPBgo616vUJjjEQtm2qfKcrz2vO4FPfHajtA&oe=6B0D9BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LLBMETA.png", "id": "457924883244807", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031313_457924886578140_975223054548218567_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IRiIJ1baVQQ7kNvwEhz78G&_nc_oc=Ado9et_hpUrarx6IOQCcXJdaq8_q5hx6tAZmB341KxctSVdQwByZNa5YlcxZzCKUY0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_rsU_q99cUtufI_znEW7aAMXpKBH4kitrmrTPsgYcTA&oe=6B0DA72D"}, "display_name": "Little Lost Bobbles", "keywords": [], "long_description": "In Little Lost Bobbles, the search for the endearing Little Lost Bobbles offers two delightful modes of exploration. Take to the skies aboard the Jellycopter, a whimsical flying contraption designed for scouting missions. Navigate the landscapes from above, scanning the terrain for any signs of the adorable Bobbles. Once spotted, swoop down and carefully scoop them up, ensuring their safe return to their families.\n\nAlternatively, opt for a more grounded approach by traversing the land on foot. Wander through lush forests, and rocky terrains, keeping a keen eye out for any hidden treasures nestled within the bushes. As you tread lightly, you'll stumble upon Little Lost Bobbles peeking out shyly or frolicking amidst the foliage. Extend a helping hand, offering them comfort and companionship as you guide them back to safety.\n\nWhether you choose to soar through the skies or embark on a leisurely stroll, the adventure awaits in Little Lost Bobbles, where every discovery brings you closer to the heart of this whimsical world.", "short_description": "Search for the adorable Little Lost Bobbles either by air with the Jellycopter or by foot, uncovering hidden treasures in the bushes. The choice is yours in this heart-warming adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
Xhul4jL1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcsot8dBGZBBbLkG8LM7wJz5LgJUkZ1AEDVCx0CpM7AQ&oe=6B0C63EF"}, {"file_name": "ss4.png", "id": "441387230691682", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570299_441387234025015_8312505519178068557_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnCn-eM0xdYQ7kNvwGTChfd&_nc_oc=Adr0KwbZ5GEjA7gFT0Oim23Rq3hl4D0GlRCeRzYHXi-Au6YsQr681jL9KtBOr_h4NkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRaFk0esHuBgiFiMPZ2lWSybZaNnkabvhB09kPdKNAfGA&oe=6B0C676D"}, {"file_name": "ss3.png", "id": "3952470734852625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302219_3952470744852624_6124622359453872078_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NDu8Jl_az0Q7kNvwF331is&_nc_oc=AdqmGl8QEjdz4XRUlwuEhYLDDIkyWjLznndAUvY7_ZQtD_z2i2X7n54NJRUt39H7tHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPGX_dN4MQ7nzSk-GzVEbtbBw0hZmLSl8FeIM8L6m6cQ&oe=6B0C5E55"}, {"file_name": "ss2.png", "id": "648585429852996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031599_648585433186329_4525550948968473178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPP-LTipBGcQ7kNvwFaGyqQ&_nc_oc=AdrRk8M0edj-Q_8fNTg3xz3LdF3cjdwhmmQT4lXTRKhlaQ8kqwVbaX6rDY1C0tIzmbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpiIRQbJgFkm_jIyCFnDhbebfj2EMAvd8AndLRQA-8mg&oe=6B0C82B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LLBMETA.png", "id": "457924883244807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031313_457924886578140_975223054548218567_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_9L6BCHocYQ7kNvwHjUMmZ&_nc_oc=Ado6H_g5a4BnrFt1pbfvNr-vN8xTTFOw8S4ZkjFLKgS2H92PNlQFC04SyYp6EAYfVlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQK3JTSjZVG8Vz52a_ROvR5eK9if8oIg5bY6rbaLigpPA&oe=6B0C55AD"}, "display_name": "Little Lost Bobbles", "keywords": [], "long_description": "In Little Lost Bobbles, the search for the endearing Little Lost Bobbles offers two delightful modes of exploration. Take to the skies aboard the Jellycopter, a whimsical flying contraption designed for scouting missions. Navigate the landscapes from above, scanning the terrain for any signs of the adorable Bobbles. Once spotted, swoop down and carefully scoop them up, ensuring their safe return to their families.\n\nAlternatively, opt for a more grounded approach by traversing the land on foot. Wander through lush forests, and rocky terrains, keeping a keen eye out for any hidden treasures nestled within the bushes. As you tread lightly, you'll stumble upon Little Lost Bobbles peeking out shyly or frolicking amidst the foliage. Extend a helping hand, offering them comfort and companionship as you guide them back to safety.\n\nWhether you choose to soar through the skies or embark on a leisurely stroll, the adventure awaits in Little Lost Bobbles, where every discovery brings you closer to the heart of this whimsical world.", "short_description": "Search for the adorable Little Lost Bobbles either by air with the Jellycopter or by foot, uncovering hidden treasures in the bushes. The choice is yours in this heart-warming adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
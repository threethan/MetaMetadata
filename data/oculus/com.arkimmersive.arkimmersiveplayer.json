0867604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_520677394200937_8629845442165981560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFERt6dkwI4Q7kNvwFHn7ra&_nc_oc=Adq6c1n_ZbFCijL-VvMON5BT0oULIBiqcxA0v8fwItkxSAVmmWgIDN9l4oRBzjq4K-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy8r9H652jlMVuznTtaB1CJ0kiYakDId5fxEOWIcYEnQ&oe=6A54EF1C"}, {"file_name": "Screenshot 2024-10-20 at 14.30.14.png", "id": "1309894950388601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75540501_1309894953721934_8392658839381971420_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBBMHNR3RBoQ7kNvwHZ1doe&_nc_oc=Adp_lyFCj0xIYwLmJpFCifTX41MwZADscpfLikVjLS6OTNN2LWZhpGtmYeHlbkeHwcw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR-90h6PSctFIaLOL7ZwcTEqp9FH0o5JgsOiTeroAMmg&oe=6A54DEF6"}, {"file_name": "Screenshot 2024-10-20 at 14.31.35.png", "id": "1706254836838212", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984458_1706254840171545_5532800132405527481_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrkMF2uZUOMQ7kNvwERJ042&_nc_oc=AdqJrtVLV7Vxu5KVG3NC6ilKPxml-jVyIiDxW075Fdo0chjJcRXiw0Ic7uFmA3Xm7m4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI-L0qNdnL_jYqVUiPVhOC8oa6S6-RVw0gzOInxy-2NQ&oe=6A55028E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ark Immersive Player", "keywords": [], "long_description": "Ark immersive creates bespoke training, education and entertainment assets for it\u2019s clients worldwide. The player app is the gateway to those assets, allowing users to access and use training materials at will. It also serves as a vehicle to share education assets that are free to the end user, such as the UK facing Immersive Impact \u2018A Knifes Edge\u2019 immersive documentary series and the Ark Wellness suite of films which is designed for use as a distress protocol and guided relaxation product.", "short_description": "The Ark immersive player gives client instant access to immersive training and education assets in education settings. It also acts as the gateway to live immersive events, and provides access for schools to access the Immersive Impact Knife Crime immersive documentaries, and the Ark Wellness suite of films."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arkimmersive.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ArkImmersive", "support_website_url": null, "website_url": "https://arkimmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8578085942273735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982501_403828286071228_6446731270834161966_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxv37Bk6pAgQ7kNvwHrqDCr&_nc_oc=AdrfIeb2CkntwYC00g_xO9KG6PrcaGaCUH0CEq2CQlXWDJxOfPA63aOC7aBkwdGYgpw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTx_-IBZzh5S1MXzFKi5BsdHV6BJ3FfcyLijOUbXbR2g&oe=6A54D749"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ark Immersive Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_dat
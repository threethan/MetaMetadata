om/v/t64.5771-25/39001714_520677394200937_8629845442165981560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVBKuMUPs2QQ7kNvwHo0Cqv&_nc_oc=AdrJdw9fayIBKVO7jontktZZEMf_rBw35x5eiJM-eQRWZju9zjeKEWWeDnAfiyCr9Tg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1JgqCBJQsRvetF3jDn1lRVJllWUd7D86kQUjWdP9w31w&oe=69F20E9C"}, {"file_name": "Screenshot 2024-10-20 at 14.30.14.png", "id": "1309894950388601", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75540501_1309894953721934_8392658839381971420_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSHfDTLWxK0Q7kNvwFos2OT&_nc_oc=AdpbYeWcFGdY89uD5pZhbbf2WmYv29XI2VtR45wo06dwh8apqW-fPdDSW8hR0eO3_r4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dAAkfBDoOvMTPa2N3NsO6ONH6C4UPFxEwcIkrvvrahw&oe=69F1FE76"}, {"file_name": "Screenshot 2024-10-20 at 14.31.35.png", "id": "1706254836838212", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984458_1706254840171545_5532800132405527481_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqr_7HSlDroQ7kNvwF35eQv&_nc_oc=Adol--RGD4atlVJnjN9wchxzE2XwRfJZWolN0hVg0qMx4S1iO4Zf81rSxbM_OWojbYc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HXE5pA8NOOwlgxy5MQQiO0u5ajwcWbp8AgJOXJBqvlg&oe=69F1E9CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ark Immersive Player", "keywords": [], "long_description": "Ark immersive creates bespoke training, education and entertainment assets for it\u2019s clients worldwide. The player app is the gateway to those assets, allowing users to access and use training materials at will. It also serves as a vehicle to share education assets that are free to the end user, such as the UK facing Immersive Impact \u2018A Knifes Edge\u2019 immersive documentary series and the Ark Wellness suite of films which is designed for use as a distress protocol and guided relaxation product.", "short_description": "The Ark immersive player gives client instant access to immersive training and education assets in education settings. It also acts as the gateway to live immersive events, and provides access for schools to access the Immersive Impact Knife Crime immersive documentaries, and the Ark Wellness suite of films."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arkimmersive.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ArkImmersive", "support_website_url": null, "website_url": "https://arkimmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8578085942273735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982501_403828286071228_6446731270834161966_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW4CTG7HbBUQ7kNvwHMkIp_&_nc_oc=AdrcknDeKn_0tHZScHx4FzxwiADQdhJMCuHVYFrw89z4iBKUpaUTKwo1133i3vLai6k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af12PUwRJHzCZ1ycFLFvJsJhqITwqyRdVVaPalLyZAy-dw&oe=69F1F6C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ark Immersive Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1730121360, "lastRevision": {"nodes": [{"id": "8224276954321304", "release_
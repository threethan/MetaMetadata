0867604", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001714_520677394200937_8629845442165981560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61McH0zK_3oQ7kNvwH0fWS_&_nc_oc=Adqn7ewcyaExB7XNWl1KaQV-MLWPfwq4rXs6dHDAywMEYzwfC27raywLoupWITfRKsI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af945Ib8BRZtHB4nubVOt1hx0CQu6z14IGyW1gHtoqxseg&oe=6A26CA9C"}, {"file_name": "Screenshot 2024-10-20 at 14.30.14.png", "id": "1309894950388601", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540501_1309894953721934_8392658839381971420_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icIeocqki2cQ7kNvwGTivwg&_nc_oc=AdrZ9aDCqDqkO6eP8zwbM8StBzky4zr-m4iveEJiVaMyB6yTY8IbCrLHWkQLt0aszY0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TslqobMpzRie_Lsp70L8FyWIg3xYJUCvh0HhQq3VKgQ&oe=6A26BA76"}, {"file_name": "Screenshot 2024-10-20 at 14.31.35.png", "id": "1706254836838212", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984458_1706254840171545_5532800132405527481_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1EwhN8Q8X8Q7kNvwEH2fgq&_nc_oc=Adp8jBhj_6rp1GJjp92jq6o8EsrSpUe7eOrqjvqb_oymH5e3T-rgYgt9U2h4FuO-6Zs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yv7S97bJWfGkihIJILjnbTCeiXXe_511D34l20ZrKnQ&oe=6A26DE0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ark Immersive Player", "keywords": [], "long_description": "Ark immersive creates bespoke training, education and entertainment assets for it\u2019s clients worldwide. The player app is the gateway to those assets, allowing users to access and use training materials at will. It also serves as a vehicle to share education assets that are free to the end user, such as the UK facing Immersive Impact \u2018A Knifes Edge\u2019 immersive documentary series and the Ark Wellness suite of films which is designed for use as a distress protocol and guided relaxation product.", "short_description": "The Ark immersive player gives client instant access to immersive training and education assets in education settings. It also acts as the gateway to live immersive events, and provides access for schools to access the Immersive Impact Knife Crime immersive documentaries, and the Ark Wellness suite of films."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arkimmersive.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ArkImmersive", "support_website_url": null, "website_url": "https://arkimmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8578085942273735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982501_403828286071228_6446731270834161966_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO4BWz-g5d0Q7kNvwF_UYKC&_nc_oc=Adok9PGg6bCsQumfQC0opqUGa18whgQ5QcyBuOGL9Qkoqr315zuZoPE3QINEyao1dKo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8pv9q1rZ72tJmSfd_gyuxSkr34Lfm_7qkGjFh73qsWA&oe=6A26EB09"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ark Immersive Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_dat
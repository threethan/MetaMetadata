&_nc_ss=7f30f&oh=00_AQWKEZsSF11_vosawqbSkvFWTmxLUsNQ5tZXUXN1scvO0Q&oe=6B105674"}, {"file_name": "desk_skate_03.png", "id": "1637128721194379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_1637128724527712_7476965550223471869_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiHhEZS0SzQQ7kNvwE0iZjz&_nc_oc=Adood2Ugf4CiQLyJ4eWtYim3z_tTDR5H0t1jWlI9R0PH6m22ewrxriXhTb2grtbxots&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuiAdUrZaJJ-HitBotmguS7yXiS8S6CLJCuV7qiT9FGw&oe=6B106B95"}, {"file_name": "desk_skate_05.png", "id": "1796589138245709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1796589141579042_4524377931223592478_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-P4B5uVKtcQ7kNvwGmacuI&_nc_oc=AdpH_U27FkwuUxF_ai0EaB8iysKvgWJnTaMl2ctdFv9Ms2YJde-BVuRpipuZWmc2zYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbKA6HrncpbjthVSppZCzSMmKg4BHvVnuwTJWhDkqBUw&oe=6B105506"}, {"file_name": "desk_skate_06.png", "id": "1121587397312835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1121587400646168_6887050507986707739_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E-xkbWG6icQ7kNvwHkNvX2&_nc_oc=Adr0FeRP-FVX-BaLainVqc87ndWSPQxY-ngx2dBjqi9AhLLkdDOmrYlhGdJ2Kkc1CO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDEBQYlyNLEEFNuQo39An247pDdKwBCTYXMSSdXxA6uA&oe=6B105303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "desk_skate_06.png", "id": "1652337956529064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1652337959862397_3803584628946875853_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKJu1uwp9uwQ7kNvwH40uht&_nc_oc=Adrh6IJplY4PUjxK0_qauKC82PfGWQkQU3IqAPFrgreK6rm01Jw5OuZSVUZY_VAgGsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDpWlI2DyrchjYn_0dhPpyAjG-C3Xvuufajtri_UEV7w&oe=6B1066F7"}, "display_name": "Desk Skate", "keywords": [], "long_description": "YOUR DESK IS THE PARK.\n\nDesk Skate puts a mini skater right on your real table. Using Meta Quest 3 mixed reality, scan your desk, draw your skate surface and build your own park with ramps, quarter pipes, halfpipes, rails, benches and guard rails.\n\nSKATE LIKE THE ARCADE CLASSICS\nOllies, kickflips, heelflips, varials, grabs, grinds, slides, manuals and stalls. Chain tricks into big combos and push your score multiplier.\n\nBUILD YOUR OWN PARK\nPlace and rotate pieces anywhere on your table, save your tracks and come back to them anytime.\n\nMIXED REALITY AND VIRTUAL MODES\nSkate on your real desk with passthrough, or switch to virtual stages.\n\nFEATURES\n- Mini skater controlled with Quest 3 Touch controllers\n- Track editor with ramps, rails, halfpipes and obstacles\n- Multiple selectable characters\n- Overall scale slider to fit any desk\n- Comfortable seated or standing play", "short_description": "Turn your real desk into a skatepark. Build ramps, rails and halfpipes on your table in mixed reality and shred with a mini skater using classic arcade tricks, grinds, manuals and combos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fabgames.com.br/deskskate/", "developer_terms_of_service_url": null, "publisher_name": "FabGames", "support_website_url": null, "website_url": "https://www.fabgames.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
HKCaXW&_nc_oc=Ado9mdRpIXRWDRHt0uECxOYZiro7TM-OQ0kjW_PdNAAjJquwIJ-GaXVU0KbnntWZYU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVV2EbfueUM46K5kePuGeOo8VtrQeoSvFU4YLCsGpipsA&oe=6B0F0386"}, {"file_name": "desk_skate_06.png", "id": "1121587397312835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1121587400646168_6887050507986707739_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E-xkbWG6icQ7kNvwHJv_gF&_nc_oc=AdpMqf-z4JNsMpwrqE9hwj-hrBOUHTrHpXFTSwyVQJC5UDlQ0FRvtzGWDpRjPJs3Jr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6fArsR_y5aHDFRjzpmavbh9h_U0AcjitKSsdjccLZoA&oe=6B0F0183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "desk_skate_06.png", "id": "1652337956529064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1652337959862397_3803584628946875853_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKJu1uwp9uwQ7kNvwG-1QrC&_nc_oc=AdrDQbDMjbT8BipycYTIwbfIlEbusDKBU-OaCfcdZ_ApxqZcru01TxOiITUybQ5CtG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUZcMF5wVB5_N-Q-aO294q87LPkjv1jvY6UUIROHVamg&oe=6B0F1577"}, "display_name": "Desk Skate", "keywords": [], "long_description": "YOUR DESK IS THE PARK.\n\nDesk Skate puts a mini skater right on your real table. Using Meta Quest 3 mixed reality, scan your desk, draw your skate surface and build your own park with ramps, quarter pipes, halfpipes, rails, benches and guard rails.\n\nSKATE LIKE THE ARCADE CLASSICS\nOllies, kickflips, heelflips, varials, grabs, grinds, slides, manuals and stalls. Chain tricks into big combos and push your score multiplier.\n\nBUILD YOUR OWN PARK\nPlace and rotate pieces anywhere on your table, save your tracks and come back to them anytime.\n\nMIXED REALITY AND VIRTUAL MODES\nSkate on your real desk with passthrough, or switch to virtual stages.\n\nFEATURES\n- Mini skater controlled with Quest 3 Touch controllers\n- Track editor with ramps, rails, halfpipes and obstacles\n- Multiple selectable characters\n- Overall scale slider to fit any desk\n- Comfortable seated or standing play", "short_description": "Turn your real desk into a skatepark. Build ramps, rails and halfpipes on your table in mixed reality and shred with a mini skater using classic arcade tricks, grinds, manuals and combos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fabgames.com.br/deskskate/", "developer_terms_of_service_url": null, "publisher_name": "FabGames", "support_website_url": null, "website_url": "https://www.fabgames.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2486883368386629"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300661_1069796569399445_8526115244754332814_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdR2v2Gg4FgQ7kNvwF5Z97d&_nc_oc=AdqPw-4-SEWWlBHoqpA1h90U9IiIjmXq6Rw0ac9-oLvAOMqgniYW827UXYWNVBiD8Vk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFaR0clt2sVZkmt5tMPoUp5wqkzSN-W_u8_pHffaCvHw&oe=6B0F1694"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Desk Skate", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "c
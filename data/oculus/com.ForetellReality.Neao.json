&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hHIwADttWgRintSti1TMuvnCo2oN3XoSJlZDVF5ueRg&oe=69FCAD96"}, {"file_name": "38982533_293198043571933_8596478235430145082_n.png", "id": "1222599278861935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203618_1222599282195268_7543529969959741226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVz8806WILcQ7kNvwEGv7C9&_nc_oc=AdpvQg88d18UPDTpZEnUl1t6YXYwljanPTvJTBjtQWryWKx7_ogQJ2ZMv9OyukdbCVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ee7B1dLyqkl0FR5OeAurkhHvi2HqmtHSB7KZHaJeVEA&oe=69FC9E8F"}, {"file_name": "86653846_1511662882914046_7441619705300833097_n.png", "id": "408918818917948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031452_408918822251281_925653654580631949_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNO4DgaKWeoQ7kNvwH8B7hB&_nc_oc=AdoH6L5fwvaXQsXshnICLBdRT-KAZWcZiyUrBicP-a1KKKe3MiYMboItUbF4mJvnpXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zfvGXRyrX6F7j3fqUiUgIHK5cgNb81Ewdreg25jGXUQ&oe=69FC9B90"}, {"file_name": "38974528_300985632637458_6044806980667952672_n.png", "id": "453499873812461", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_453499877145794_8306574212514530433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukmzvKrYrpYQ7kNvwGpm4_9&_nc_oc=AdqEaKt2FQhHncrBYypvGozaV5vxsurvyPSsajZ1gZuKq4eo67SZQ7dO7kt1bVGEEjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r-KQDo65z2MCno61YvXnKQIyur2pqn6fyBcGZ_LwJqw&oe=69FCA8E0"}, {"file_name": "39035412_1424002995154831_7627870931299930738_n.png", "id": "1197650474672785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622009_1197650478006118_4379851118877732930_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsE-Y5V2iB4Q7kNvwF8KDu4&_nc_oc=Adqcf0sCjVHEIGMziKGq3TZr9qcXm0lVWywUmNxHTlfD3FEbYW5TnFxQb2mzFIFbx-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZF6d2Jn8ygieSCkNeqpAWSh0ICxryUWjUTcbYYBfX8Q&oe=69FC9D58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neao", "keywords": ["Neao", "Health", "Therapy", "MentalHealth", "GroupTherapy"], "long_description": "# Revolutionizing Group Therapy with Neao\n\nNeao's cutting-edge VR platform transforms the way therapy is delivered, fostering genuine connections and personal growth in immersive environments. We set a new standard for mental health support, enhancing both group therapy and individual sessions.\n\n**Unlock Potential in Every Session:** Immerse participants in supportive, virtual spaces that encourage authentic communication and healing, enabling individuals to connect and thrive.\n\n**Empower Therapists and Participants:** With realistic simulations and personalized programs, Neao equips therapists with tools for impactful sessions, while participants benefit from a deeply engaging experience.\n\n**Enhance Remote Therapy:** Facilitate remote sessions in VR spaces that foster strong emotional connections, regardless of physical distance.\n\n**Data-Driven Insights:** Our platform offers analytics that provide therapists with actionable insights to tailor treatment to individual needs.\n\n**Accessible VR for Mental Health:** Neao\u2019s solutions revolutionize therapy, offering a more effective alternative to traditional methods.\n\n**Join Neao:** Explore how Neao's VR solutions can reshape therapy, driving better outcomes for both therapists and clients.", "short_description": "Neao is a pioneering platform delivering end-to-end VR solutions for group therapy. Our immersive VR platform with unique treatment programs creates a powerful tool for therapists and empowers individuals to connect, grow, and heal in safe and supportive virtual environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neao.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://neao.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8222701301141190"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3905311736382240"}, {"status": "PUBLISHED", "id": "1078267453958495"}]}, "baseline_offer": {"id": "3905311736382240"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733501520, "status": "PUBLISHED", "id": "3905311736382240"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26070870412564338", "version": "7.8.5"}, "id": "1033561921481045", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8222701291141191", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26070870412564338"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776792102, "id": "26430348099949899", "version": "7.8.34", "version_code": 1070834, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename
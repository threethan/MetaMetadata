, {"file_name": "38982533_293198043571933_8596478235430145082_n.png", "id": "1222599278861935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203618_1222599282195268_7543529969959741226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4-OuyOXuDoQ7kNvwEqIOuZ&_nc_oc=AdqvE8qixFPyEbjryhP4YmekDM3kc8r5zXId7KHLJzEqDRwuZzDSbXUKK0qqtQXlz78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2G5d9KAQUbE1us2WMICZ-HeM9YqWSWV-F4fzX40NbUiA&oe=69F0C10F"}, {"file_name": "86653846_1511662882914046_7441619705300833097_n.png", "id": "408918818917948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031452_408918822251281_925653654580631949_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYj-dOdZrjAQ7kNvwHiqC56&_nc_oc=AdqlolcBhwe3dZUtXcBuUIiGOvfruyl72gcBO3vpqNN3gA5_sBfXJ-N8kxu96C_npLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0dPYBt-ewaxXIFLv6wGaWKYwhjb6CWcgreer_PwqZyqA&oe=69F0BE10"}, {"file_name": "38974528_300985632637458_6044806980667952672_n.png", "id": "453499873812461", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_453499877145794_8306574212514530433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZWlFzhhSMYQ7kNvwHMTPgl&_nc_oc=AdqgCrH_CGDj-qSYFhDkTXLGB6ull35WnyCMCvMNfaCH17ZvJQMBPfGZcQyQTkXViLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0VCc-m5xKtWgZl1akH3UKEa_jvWDrHuAOLWRVkcsA-bA&oe=69F0CB60"}, {"file_name": "39035412_1424002995154831_7627870931299930738_n.png", "id": "1197650474672785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622009_1197650478006118_4379851118877732930_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o71dZWzsmVIQ7kNvwGepkD9&_nc_oc=AdrCuoPrfc1NwbgGQF4dLziIX-LZ9WgXQUR8-MxDjF81oqQUuM7ZbEcJvZtdlQDGyvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1br3WT-O4IlyNqr-FcXG_m3lQXk5_x3LJS8caxqyK7lA&oe=69F0BFD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neao", "keywords": ["Neao", "Health", "Therapy", "MentalHealth", "GroupTherapy"], "long_description": "# Revolutionizing Group Therapy with Neao\n\nNeao's cutting-edge VR platform transforms the way therapy is delivered, fostering genuine connections and personal growth in immersive environments. We set a new standard for mental health support, enhancing both group therapy and individual sessions.\n\n**Unlock Potential in Every Session:** Immerse participants in supportive, virtual spaces that encourage authentic communication and healing, enabling individuals to connect and thrive.\n\n**Empower Therapists and Participants:** With realistic simulations and personalized programs, Neao equips therapists with tools for impactful sessions, while participants benefit from a deeply engaging experience.\n\n**Enhance Remote Therapy:** Facilitate remote sessions in VR spaces that foster strong emotional connections, regardless of physical distance.\n\n**Data-Driven Insights:** Our platform offers analytics that provide therapists with actionable insights to tailor treatment to individual needs.\n\n**Accessible VR for Mental Health:** Neao\u2019s solutions revolutionize therapy, offering a more effective alternative to traditional methods.\n\n**Join Neao:** Explore how Neao's VR solutions can reshape therapy, driving better outcomes for both therapists and clients.", "short_description": "Neao is a pioneering platform delivering end-to-end VR solutions for group therapy. Our immersive VR platform with unique treatment programs creates a powerful tool for therapists and empowers individuals to connect, grow, and heal in safe and supportive virtual environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neao.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://neao.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
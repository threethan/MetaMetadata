&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy45xdDl-pv4OimgWe7Cmgs86PEG40xiqVstbawo1JA4Q&oe=69C90AD6"}, {"file_name": "38982533_293198043571933_8596478235430145082_n.png", "id": "1222599278861935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203618_1222599282195268_7543529969959741226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRVBMyF6u9gQ7kNvwG6PShC&_nc_oc=AdrliQSQazO1dIny8c3GL_Iq1y322qkabT_GxX5Iyy9mTTCshlq1CZ7zx70AiSsV0tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxolr0WYijEL8zjK6sOQI20yApRacTYP44weM5P_9EnmA&oe=69C9340F"}, {"file_name": "86653846_1511662882914046_7441619705300833097_n.png", "id": "408918818917948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031452_408918822251281_925653654580631949_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k36j2TyJdLcQ7kNvwHV-Ngc&_nc_oc=AdqIBoWuazRJEw6EnDDPFAwjly0oz7orJY0r4H8TKHfa1cpFXFJGuc-XjPhnkz9ZgvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPFTXZGqBTR2JdLsnzEdjDyTBRLn0PJOQaVrz7ch1BoQ&oe=69C93110"}, {"file_name": "38974528_300985632637458_6044806980667952672_n.png", "id": "453499873812461", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_453499877145794_8306574212514530433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBphcJafEgoQ7kNvwGO6zVS&_nc_oc=Adr8bQ5kmQGv_q2YF6g1NtGsH2pJRuOa4ikvkiO9Y_sP3GpbOJeWJn5i3o5hg5CXxEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyV6g15zN2AOuEi7Iy3a0-YeOeoB_SpCAb5aQvVmZEzVQ&oe=69C90620"}, {"file_name": "39035412_1424002995154831_7627870931299930738_n.png", "id": "1197650474672785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622009_1197650478006118_4379851118877732930_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1eKbcIdC-oQ7kNvwFEC68I&_nc_oc=AdoFcNY8BrZdCgm4YyDuIoYaVN33t5gqTdgoSIaZ-BIL5upOaSfTBTmC4sfoSytNVZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4x6b3WKyvok1ITW_wk7FIb0KaHptGSs3eMsCQ6Wo_sg&oe=69C932D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neao", "keywords": ["Neao", "Health", "Therapy", "MentalHealth", "GroupTherapy"], "long_description": "# Revolutionizing Group Therapy with Neao\n\nNeao's cutting-edge VR platform transforms the way therapy is delivered, fostering genuine connections and personal growth in immersive environments. We set a new standard for mental health support, enhancing both group therapy and individual sessions.\n\n**Unlock Potential in Every Session:** Immerse participants in supportive, virtual spaces that encourage authentic communication and healing, enabling individuals to connect and thrive.\n\n**Empower Therapists and Participants:** With realistic simulations and personalized programs, Neao equips therapists with tools for impactful sessions, while participants benefit from a deeply engaging experience.\n\n**Enhance Remote Therapy:** Facilitate remote sessions in VR spaces that foster strong emotional connections, regardless of physical distance.\n\n**Data-Driven Insights:** Our platform offers analytics that provide therapists with actionable insights to tailor treatment to individual needs.\n\n**Accessible VR for Mental Health:** Neao\u2019s solutions revolutionize therapy, offering a more effective alternative to traditional methods.\n\n**Join Neao:** Explore how Neao's VR solutions can reshape therapy, driving better outcomes for both therapists and clients.", "short_description": "Neao is a pioneering platform delivering end-to-end VR solutions for group therapy. Our immersive VR platform with unique treatment programs creates a powerful tool for therapists and empowers individuals to connect, grow, and heal in safe and supportive virtual environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neao.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://neao.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8222701301141190"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3905311736382240"}, {"status": "PUBLISHED", "id": "1078267453958495"}]}, "baseline_offer": {"id": "3905311736382240"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733501520, "status": "PUBLISHED", "id": "3905311736382240"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25686685720982811", "version": "7.7.1"}, "id": "1033561921481045", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8222701291141191", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25686685720982811"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773875050, "id": "26072361369081909", "version": "7.8.6", "version_code": 1070806, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename"
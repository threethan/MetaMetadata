, {"file_name": "38982533_293198043571933_8596478235430145082_n.png", "id": "1222599278861935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203618_1222599282195268_7543529969959741226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJm8MmUU-iMQ7kNvwHMCQra&_nc_oc=Adnb0w44FGDr2ki39cL_Df8BZ8iYzrpnkSK2owSOc2YH13ebJPp9tAf2ZL_Sx5EilJw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZVHCNi-jGN5FqIPrUfICVoXmZy3vYr___U0g-_HNHsw&oe=699C610F"}, {"file_name": "86653846_1511662882914046_7441619705300833097_n.png", "id": "408918818917948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031452_408918822251281_925653654580631949_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phlFJggYc_YQ7kNvwEJ4Hla&_nc_oc=AdkHyDW_AlNzbOfK5pgWomIlyPH8_K5qXTQ8CjaQhirq2RSH8GSjudeI0cuMsiBh7_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsF_yIt8unbYfQMVzbRxbNF2WB1JrFLiWRVFkeyUsINpg&oe=699C5E10"}, {"file_name": "38974528_300985632637458_6044806980667952672_n.png", "id": "453499873812461", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75356794_453499877145794_8306574212514530433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoTuj-_6ZVkQ7kNvwGe2dGP&_nc_oc=AdnAv0M_dKVy-9G9G_D54QgCzjYgnSN9086l4A2_mOhc57qH-XnhwovhgBUfLYGbf10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftN8wbrg6E4gmAh0QKT_S3GJFtN-5Tikmi7DF-xhYDQNA&oe=699C3320"}, {"file_name": "39035412_1424002995154831_7627870931299930738_n.png", "id": "1197650474672785", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622009_1197650478006118_4379851118877732930_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTT0nU1szroQ7kNvwG7tyoX&_nc_oc=AdlS0JLxZ135GjmECc8kbzxc1i8Jihgfirbihk0FZoOEl-l8R_tKtXCYPGUOaVG4a5k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuI8XzfujEqr2lCGgOotApD37g4rN65W9wAhle-g5zwHA&oe=699C5FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neao", "keywords": ["Neao", "Health", "Therapy", "MentalHealth", "GroupTherapy"], "long_description": "# Revolutionizing Group Therapy with Neao\n\nNeao's cutting-edge VR platform transforms the way therapy is delivered, fostering genuine connections and personal growth in immersive environments. We set a new standard for mental health support, enhancing both group therapy and individual sessions.\n\n**Unlock Potential in Every Session:** Immerse participants in supportive, virtual spaces that encourage authentic communication and healing, enabling individuals to connect and thrive.\n\n**Empower Therapists and Participants:** With realistic simulations and personalized programs, Neao equips therapists with tools for impactful sessions, while participants benefit from a deeply engaging experience.\n\n**Enhance Remote Therapy:** Facilitate remote sessions in VR spaces that foster strong emotional connections, regardless of physical distance.\n\n**Data-Driven Insights:** Our platform offers analytics that provide therapists with actionable insights to tailor treatment to individual needs.\n\n**Accessible VR for Mental Health:** Neao\u2019s solutions revolutionize therapy, offering a more effective alternative to traditional methods.\n\n**Join Neao:** Explore how Neao's VR solutions can reshape therapy, driving better outcomes for both therapists and clients.", "short_description": "Neao is a pioneering platform delivering end-to-end VR solutions for group therapy. Our immersive VR platform with unique treatment programs creates a powerful tool for therapists and empowers individuals to connect, grow, and heal in safe and supportive virtual environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neao.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://neao.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
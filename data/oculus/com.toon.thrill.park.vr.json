oQD3Ahz_vgPFPOLs3WnaPY7D6Z1DfKn1_m30egH1fKBmoVyC6V6XUDRAS4nU_BRd4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-bB1CU3swfpl3vKQTzlPH668MQ9H4RZ-qkzc3CKHz_A&oe=6AE8B08E"}, {"file_name": "33.png", "id": "1564164005435887", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310731_1564164008769220_4268935356657191830_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hml3p7Jz2OoQ7kNvwELKFuj&_nc_oc=Adp7GZ8W2UduGsA1i6fmUxS0aQZWdmmw744sKug1vYrYH76Vgow5Epnd4ofJxtwbpR0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR61lHSsXmL7P-UxDDjQD-NPbxCUqzshf4VVB-LjanhFA&oe=6AE8B3B0"}, {"file_name": "22.png", "id": "1355063386097047", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304952_1355063389430380_2742811657235432177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fnZncsIojIQ7kNvwFJvIiN&_nc_oc=AdoOWDtBlpK6WNIJICp9qWwayGoosURXt5DB_qs1ZBpKx2Wx_mJ5N-HpB2nf39bFq9Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSic0K9qV5AWRPhkc_bhvu63_P6Y0vV5hoE24N3yX6qWw&oe=6AE8C16E"}, {"file_name": "11.png", "id": "1033823766120400", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310734_1033823769453733_7402632796716162128_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz9ijYx1k48Q7kNvwGi3-yc&_nc_oc=Ado3rQdjtAitREhcLORpgf_dJVX1oTiYeWto4K4B37kYTZrK2X0kXkAvL-nNlenkues&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxHV5_gOlRj9YStcTgs1hD991FrrAJg4TpB-zXsvSDYg&oe=6AE8AB97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toon Thrill Park VR", "keywords": ["Adventure", "Park", "Simulation", "Rollercoaster", "Rides"], "long_description": "TOON THRILL PARK VR \u2014 THE FULL CARTOON AMUSEMENT PARK ON META QUEST\n\nWalk through the gates of a stunning cartoon theme park and ride whatever you want, whenever you want. Toon Thrill Park VR is the first open-world VR amusement park on Meta Quest \u2014 a colorful, vibrant cartoon world packed with thrilling rides and unforgettable moments.\n\nNo other VR game gives you a complete amusement park. Not just a roller coaster. Not just one ride. A full cartoon park you can freely explore and enjoy with every classic ride inside it.\n\nRIDES INSIDE THE PARK\n- Roller coasters \u2014 hold tight and feel every twist and drop\n- Pirate ships \u2014 swing high into the cartoon sky\n- Spinning rides \u2014 dizzy fun for the brave\n- Ferris wheels \u2014 take in the whole park from above\n- And more rides to discover as you explore\n\nBUILT FOR EVERYONE\nToon Thrill Park VR is designed for all ages. The cartoon art style, smooth VR comfort, and simple controls make it the perfect VR experience to share with family and friends. No VR experience needed \u2014 just step inside and enjoy the ride.\n\nCompatible with Meta Quest 2, Quest 3 and Quest 3S. Standalone. No PC required.\n\nThe amusement park you always dreamed of \u2014 now in VR.\n\nStep through the gates. Every ride is waiting.", "short_description": "Roam a cartoon amusement park and ride anything you want \u2014 roller coasters, pirate ships, swings and more. The full VR theme park experience on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "sup
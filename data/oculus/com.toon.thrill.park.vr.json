_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBlawzQjHrQhojFFG9Lx3OcZnxfHUkhd-v3Y2PII_uWA&oe=6AE88D2C"}, {"file_name": "499313063_950108408104548_8610322330751079444_n.png", "id": "1392608725741183", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673652249_1392608729074516_4937071345485068224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60taCuUVTwsQ7kNvwHy8Wkk&_nc_oc=Ado09QvC5aSmIiaaJgUsKnDllgKnPghSrZUIbNNQJteHcvxcmPWh75Jtz68pCv6-TJE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnIZc6qluQVe6NFmsqTOPRu00SgdJtXuzCvW-Zw8nMHg&oe=6AE88ABB"}, {"file_name": "507833663_1724658182169210_6806361919422672273_n.png", "id": "1093972616418194", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673652249_1093972619751527_1856495485858640595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcBQIhrT0BQQ7kNvwFDzJWC&_nc_oc=AdoqmtPHkfU-POX-vzDaazFIAZR3NEccNcdH2Zi8tgyxmCBLmPgTf_FaeNLQKRk6MRo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCFLsBFlE9o8ZKoaMo6Gp77zQFg34ZZ3j-4eZ0Isph8A&oe=6AE898E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toon Thrill Park VR", "keywords": ["AmusementPark", "ThemePark", "RollerCoaster", "Carnival", "VRRides"], "long_description": "TOON THRILL PARK VR \u2014 THE FULL CARTOON AMUSEMENT PARK ON META QUEST\n\nWalk through the gates of a stunning cartoon theme park and ride whatever you want, whenever you want. Toon Thrill Park VR is the first open-world VR amusement park on Meta Quest \u2014 a colorful, vibrant cartoon world packed with thrilling rides and unforgettable moments.\n\nNo other VR game gives you a complete amusement park. Not just a roller coaster. Not just one ride. A full cartoon park you can freely explore and enjoy with every classic ride inside it.\n\nRIDES INSIDE THE PARK\n- Roller coasters \u2014 hold tight and feel every twist and drop\n- Pirate ships \u2014 swing high into the cartoon sky\n- Spinning rides \u2014 dizzy fun for the brave\n- Ferris wheels \u2014 take in the whole park from above\n- And more rides to discover as you explore\n\nBUILT FOR EVERYONE\nToon Thrill Park VR is designed for all ages. The cartoon art style, smooth VR comfort, and simple controls make it the perfect VR experience to share with family and friends. No VR experience needed \u2014 just step inside and enjoy the ride.\n\nCompatible with Meta Quest 2, Quest 3 and Quest 3S. Standalone. No PC required.\n\nThe amusement park you always dreamed of \u2014 now in VR.\n\nStep through the gates. Every ride is waiting.", "short_description": "Your own VR theme park is waiting! Ride roller coasters, pirate ships, Ferris wheels and more in a colorful cartoon amusement park on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381583845043984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604317775_1058286717212276_4237017001949740749_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KevrR4bVOawQ7kNvwGhHVUu&_nc_oc=AdqWRL7KJmDjZeEx1yxZOvah61_6oDKCeKIiEBqC2-haQZE8zntLtwMBCMf9l
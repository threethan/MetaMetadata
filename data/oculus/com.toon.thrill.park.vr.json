0a&_nc_ohc=qVO_6rvtcCkQ7kNvwFW4CWk&_nc_oc=Adquccf3BsHYCg9DGwjUdfAM1KH1Kpj9vRpXTqSe1Pl8m53c-jMgwHSwrjmVadtenKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGU1NwgyD2UqnrEzJO2hnPMbo3SzhEU7T2Kt2ImsgyEA&oe=6B0DCDD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toon Thrill Park VR", "keywords": ["Adventure", "Park", "Simulation", "Rollercoaster", "Rides"], "long_description": "TOON THRILL PARK VR \u2014 THE FULL CARTOON AMUSEMENT PARK ON META QUEST\n\nWalk through the gates of a stunning cartoon theme park and ride whatever you want, whenever you want. Toon Thrill Park VR is the first open-world VR amusement park on Meta Quest \u2014 a colorful, vibrant cartoon world packed with thrilling rides and unforgettable moments.\n\nNo other VR game gives you a complete amusement park. Not just a roller coaster. Not just one ride. A full cartoon park you can freely explore and enjoy with every classic ride inside it.\n\nRIDES INSIDE THE PARK\n- Roller coasters \u2014 hold tight and feel every twist and drop\n- Pirate ships \u2014 swing high into the cartoon sky\n- Spinning rides \u2014 dizzy fun for the brave\n- Ferris wheels \u2014 take in the whole park from above\n- And more rides to discover as you explore\n\nBUILT FOR EVERYONE\nToon Thrill Park VR is designed for all ages. The cartoon art style, smooth VR comfort, and simple controls make it the perfect VR experience to share with family and friends. No VR experience needed \u2014 just step inside and enjoy the ride.\n\nCompatible with Meta Quest 2, Quest 3 and Quest 3S. Standalone. No PC required.\n\nThe amusement park you always dreamed of \u2014 now in VR.\n\nStep through the gates. Every ride is waiting.", "short_description": "Roam a cartoon amusement park and ride anything you want \u2014 roller coasters, pirate ships, swings and more. The full VR theme park experience on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1225564500645920"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2081705489197790"}, {"status": "PUBLISHED", "id": "1870502437725954"}, {"status": "PUBLISHED", "id": "1577188433799271"}]}, "baseline_offer": {"id": "2081705489197790"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795138500, "status": "PUBLISHED", "id": "2081705489197790"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1227050323830671", "version": "0.1"}, "id": "1772524303769963", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1225564493979254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1227050323830671"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1772524303769963"}]}, "change_log": null, "created_date": 1784825293, "id": "1227050323830671", "version": "0.1", "version_code": 1, "release_st
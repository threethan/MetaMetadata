wFkq6TM&_nc_oc=Adoqf-UOAWafBe_3IypRDknhVLMAh06Q4UUmPUovwGvwa-pyG4hu611eg3HunJHaeJ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lvmzkYw2Pzua7pigGk6V4MOGcY_SE6dj6B89X-fCqsw&oe=6A3557B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Witchblood", "keywords": ["metroidvania", "exploration", "action", "fantasy", "platformer"], "long_description": "Clara Pathemore has lost everything.  Pursued by zealots, she finds herself scared and alone in the forest, out-numbered and out-matched.  She must learn to control her growing powers and gain the strength necessary to defeat the Hunters that have taken over her town. \n \nExplore an intricate diorama world filled with secrets, enemies, and powerful magic.  With 6+ hours of metroidvania exploration and combat, hundreds of rooms, 40 upgrades, and 4 difficulty levels to master, Witchblood shows how VR transforms classic gaming.", "short_description": "Witchblood brings classic metroidvania gameplay to VR, immersing you in the story of a young woman who must learn to control her powers to survive."}]}, "developer_name": "Hidden Path Entertainment", "developer_privacy_policy_url": "http://hiddenpath.com/privacy-policy/", "developer_terms_of_service_url": "http://hiddenpath.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://www.hiddenpath.com/game/witchblood/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_m
wq9GSalGnp84hgPpayCuh8qJVnzG8nAiAYPdCw&oe=6B007269"}, {"file_name": "migrated_image.png", "id": "247146786444124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1044171995713023_2810991967075303424_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgG0axe4FpcQ7kNvwEPNeKE&_nc_oc=Ado2m4x_iZ4SzAgzks9DGjc9yDZ9I1MtDBXXODIaS2KhBwL4BrkdeJYNFu74Qbpaqoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT61cpzRpsVswRTN_UQ0MkpXL0JfAIJwKXLPmwOGhaJFw&oe=6B005EB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Witchblood", "keywords": ["metroidvania", "exploration", "action", "fantasy", "platformer"], "long_description": "Clara Pathemore has lost everything.  Pursued by zealots, she finds herself scared and alone in the forest, out-numbered and out-matched.  She must learn to control her growing powers and gain the strength necessary to defeat the Hunters that have taken over her town. \n \nExplore an intricate diorama world filled with secrets, enemies, and powerful magic.  With 6+ hours of metroidvania exploration and combat, hundreds of rooms, 40 upgrades, and 4 difficulty levels to master, Witchblood shows how VR transforms classic gaming.", "short_description": "Witchblood brings classic metroidvania gameplay to VR, immersing you in the story of a young woman who must learn to control her powers to survive."}]}, "developer_name": "Hidden Path Entertainment", "developer_privacy_policy_url": "http://hiddenpath.com/privacy-policy/", "developer_terms_of_service_url": "http://hiddenpath.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://www.hiddenpath.com/game/witchblood/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connectio
6644267", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974705_330023519977600_1060457460336641245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFMs5sDLKGkQ7kNvwEj7uwM&_nc_oc=AdpiXnQIH322kdogA-8kT_caSktlVVssWIn9NPZhNI7RHHrTSFP4lrqoKE-1xnp8Wrs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVdfIgLsfmClrx9Y_2kmJG9SddHlmogG12QvCFzOHAQQ&oe=6A8D76FF"}, "display_name": "Moka!", "keywords": [], "long_description": "Moka! is an exhilarating and fast-paced multiplayer game that takes the excitement of Gorilla Tag to new heights, replacing the mighty gorillas with a mischievous bunch of monkeys. In this zany and energetic virtual jungle, players take on the role of agile and acrobatic monkeys with unique abilities, swinging from vines, leaping between trees, and outsmarting opponents to avoid being caught.", "short_description": "Moka is a game that is Gorilla Tag-Inspired where you swing round the forest, and meet monke friends!"}]}, "developer_name": "MokaStudios", "developer_privacy_policy_url": "https://sites.google.com/view/mokavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MokaStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/mokavr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6861385020614179"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
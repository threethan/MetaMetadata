dsQ7kNvwHVLDtj&_nc_oc=AdrMGQwb3-0yjn_x-IOHLaiTqdanGGyKR0wxKz6ykUzqn9Snk4LsWvIM7atQBG-6A6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXXM4BNSMn-9vOpkT2sPrbX5zlXjWx-2dDDwn4hB7-jQ&oe=6B01DC34"}, {"file_name": "4E912B6F-F4E4-40C4-86FD-80F02E0BF854.png", "id": "644678620629672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001702_644678623963005_500612251056301328_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvNP_oBFBjEQ7kNvwETqRWN&_nc_oc=Adq8B4vkXD-3eLdrGWT9ixIdw-_xDEYzXyKNw90_oB730Qe-7wJtUse4a7l3emlxKm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgbcb9eEB5jNjWzkxOulrO6v1JLJwy9e6RhZEakZ79mg&oe=6B01EE23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6F81E256-DCEF-4DF5-8C57-988C9E030CF3.png", "id": "620909299718749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982469_620909303052082_7936272622065240700_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0MEdLJqANYQ7kNvwFO4uQg&_nc_oc=AdqqnzImpP0D7HnGI_TyvJX3-us1YqWEaMBsxq5p6xI40xgvx6Cjez1kwiVID1Qd_48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8TWU1YJcS7uzfrDFLc33jMkAlEV8KE2Z4N7vegLS3g&oe=6B01BF98"}, "display_name": "Animalz Mixed Reality", "keywords": ["animals", "augmentedreality", "mixedreality", "zoo", "handtracking"], "long_description": "Create an interactive Zoo in your home with over 60 animals! Come enjoy this animal VR experience!\n- pass through enabled to see animals in your actual surroundings in mixed reality\n- animals are placeable and moveable with random spawn options and deletion options, with various areas including custom visual boundaries and save state\n- variety of pre-made and customizable animal placements:\n-- full sized animals\n-- half sized animals\n-- tabletop sized animals\n- animals include: tigers, rhinos, hippos, lions, great white sharks, turtles, bears, zebras, deer, lizards, elephants, mountain goats, farm animals, dogs, cats, many birds, t-Rex and other dinosaurs, boars, leopards, and many more\n\nMajor February 2025 Update:\n- new bonus area full of animals and plants with no mixed reality\n- new animals: a whale, squid, dolphin, turtle, and 2 new dinosaurs\n- added various areas with the ability to use custom visual boundaries or to save the position of animals and plants that you move", "short_description": "Create an interactive Zoo in your home with over 60 animals! Try this animal VR experience!\n- pass through enabled to see animals in your actual surroundings in mixed reality\n- animals: placeable & moveable with random spawn options\n- variety of pre-made & customizable animal placements:\n-- full size & half sized animals\n-- tabletop sized animals\n- animals include: tigers, rhinos, hippos, lions, great white sharks, turtles,, elephants, dinosaurs, birds, and more!\n\nMajor February 2025 update!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DINOSAURS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9151089734967243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
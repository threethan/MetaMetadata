4F-50E6-4D28-A5AF-89DEB0E4A7B6.png", "id": "668372381381047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262739_668372384714380_800470237049529823_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olN7ESFonOUQ7kNvwHbJzNZ&_nc_oc=AdoUIGCuzvvJAJUsUSapAu9pBEKYU_apBhezF1o06I42LhAynnh5FIJ1Tj7BSE9W0Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVzZh3NN9Uy4udtzkkQ43Z2WkzYZ2KE5zbpQOry7TJGg&oe=6B072234"}, {"file_name": "4E912B6F-F4E4-40C4-86FD-80F02E0BF854.png", "id": "644678620629672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001702_644678623963005_500612251056301328_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfj8otMKYkwQ7kNvwF_YX_x&_nc_oc=AdoZCRd--u6wyjcA6CoWVs8kJ17PzuwPz2hIa_W17rPYfMeh5J8WucQruTeOq2dvIPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0keeJ_Xm8TrhyGYbS91dKmZxBG9zpWmv0wHgePTg20w&oe=6B06FBE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6F81E256-DCEF-4DF5-8C57-988C9E030CF3.png", "id": "620909299718749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982469_620909303052082_7936272622065240700_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsSNesSyqUgQ7kNvwHvulLB&_nc_oc=AdrQ0mOuimGHS12B6k-QqTFVKofSsQhSGxNA23OEFuuJ5yZXSJAfM4j9ANPuD8nlBZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoV5z_f157uyAvZWE2QlHjB5O9FKEQRmlCRk-RXxx9mg&oe=6B070598"}, "display_name": "Animalz Mixed Reality", "keywords": ["animals", "augmentedreality", "mixedreality", "zoo", "handtracking"], "long_description": "Create an interactive Zoo in your home with over 60 animals! Come enjoy this animal VR experience!\n- pass through enabled to see animals in your actual surroundings in mixed reality\n- animals are placeable and moveable with random spawn options and deletion options, with various areas including custom visual boundaries and save state\n- variety of pre-made and customizable animal placements:\n-- full sized animals\n-- half sized animals\n-- tabletop sized animals\n- animals include: tigers, rhinos, hippos, lions, great white sharks, turtles, bears, zebras, deer, lizards, elephants, mountain goats, farm animals, dogs, cats, many birds, t-Rex and other dinosaurs, boars, leopards, and many more\n\nMajor February 2025 Update:\n- new bonus area full of animals and plants with no mixed reality\n- new animals: a whale, squid, dolphin, turtle, and 2 new dinosaurs\n- added various areas with the ability to use custom visual boundaries or to save the position of animals and plants that you move", "short_description": "Create an interactive Zoo in your home with over 60 animals! Try this animal VR experience!\n- pass through enabled to see animals in your actual surroundings in mixed reality\n- animals: placeable & moveable with random spawn options\n- variety of pre-made & customizable animal placements:\n-- full size & half sized animals\n-- tabletop sized animals\n- animals include: tigers, rhinos, hippos, lions, great white sharks, turtles,, elephants, dinosaurs, birds, and more!\n\nMajor February 2025 update!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DINOSAURS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
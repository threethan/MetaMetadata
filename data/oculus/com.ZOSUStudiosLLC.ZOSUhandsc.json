78620629672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001702_644678623963005_500612251056301328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_byVaBzkgkQ7kNvwH95s_2&_nc_oc=AdoaWPo_ZXkMhvPiYgjHYCQST4IHXU8ix0s1WxGjDFWmdEEYxk6LNahZ2CPBLDBdCHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlLnznbUc2TeFPK16oTlWDYMOzOzdgOHhT0MwQBCY_qQ&oe=6AF87B63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6F81E256-DCEF-4DF5-8C57-988C9E030CF3.png", "id": "620909299718749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982469_620909303052082_7936272622065240700_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrrNyWdWQYAQ7kNvwFxJXQ9&_nc_oc=AdoGawD8pvPw0TPeir8VkcVEGkz6dEMOBfnXqILFqGfbucI0u5YuJ_0KgBr1zfChdYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk6Vh_4LqXx_A0rOQr84JwmTe3tFNk677Ydkbm-F_Hyw&oe=6AF88518"}, "display_name": "Animalz Mixed Reality", "keywords": ["animals", "augmentedreality", "mixedreality", "zoo", "handtracking"], "long_description": "Create an interactive Zoo in your home with over 60 animals! Come enjoy this animal VR experience!\n- pass through enabled to see animals in your actual surroundings in mixed reality\n- animals are placeable and moveable with random spawn options and deletion options, with various areas including custom visual boundaries and save state\n- variety of pre-made and customizable animal placements:\n-- full sized animals\n-- half sized animals\n-- tabletop sized animals\n- animals include: tigers, rhinos, hippos, lions, great white sharks, turtles, bears, zebras, deer, lizards, elephants, mountain goats, farm animals, dogs, cats, many birds, t-Rex and other dinosaurs, boars, leopards, and many more\n\nMajor February 2025 Update:\n- new bonus area full of animals and plants with no mixed reality\n- new animals: a whale, squid, dolphin, turtle, and 2 new dinosaurs\n- added various areas with the ability to use custom visual boundaries or to save the position of animals and plants that you move", "short_description": "Create an interactive Zoo in your home with over 60 animals! Try this animal VR experience!\n- pass through enabled to see animals in your actual surroundings in mixed reality\n- animals: placeable & moveable with random spawn options\n- variety of pre-made & customizable animal placements:\n-- full size & half sized animals\n-- tabletop sized animals\n- animals include: tigers, rhinos, hippos, lions, great white sharks, turtles,, elephants, dinosaurs, birds, and more!\n\nMajor February 2025 update!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DINOSAURS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9151089734967243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031613_2111145385924860_5984541702713082355_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGAj7votT4AQ7kNvwGZKj2v&_nc_oc=Ado7DVDzsTBaiQqdJ6Nm7ClbWleWC7o_88iGnPFgZkgq0T5xdobHO00wap5n75v1O7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmM6WFSOwcTp
w.png", "id": "1812633166447767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628436_1812633169781100_1035914683275847825_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5pvHB3r2eIQ7kNvwE_qJOG&_nc_oc=Ado7tpDI3v9OuUYorA0m4OQWuTs16XSvuIY8wp0poxeBbWT3Jh3nWZk0hA_7ONKsBoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLxDngD1nEfpEzbhAmg8ONq9ic-HTjnFnTvdGk0mgk0w&oe=6B0C4EDA"}, {"file_name": "04-Contact-Point.png", "id": "1669139844573813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628411_1669139847907146_252805025715602351_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fufqVw70M0sQ7kNvwF5WpTo&_nc_oc=AdpmGAIqSp5PWXPevUBdSXcCdukB6UpLqQDeOQTPtJtTSMg-I07OidSnG5PY5LzRG3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQs3bG4WActPrFWaA-RCEttKBzxvwroZzekmh5ie-f7PQ&oe=6B0C5F0A"}, {"file_name": "05-Incoming-Pitch.png", "id": "1132677056410904", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619404_1132677059744237_3138055253029135937_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XK-Hlm8qsWYQ7kNvwGOwF6F&_nc_oc=AdryuBiswlgzP-aXTHY80bmh75pflCddHICwLm19X1DL-MHABsnGnYjKQD-CO2x0lN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUDduhEdRCKpM0--zzuX_bAAtqTkNUiq8cptfw0tLYlQ&oe=6B0C4CA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-Bat-Ball-Contact.png", "id": "2452140845520358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623558_2452140848853691_7860175044628188762_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Clozrc734OoQ7kNvwEwDrGb&_nc_oc=AdpDY0ZkgO6JE2ENzkrCHs8frTYVMzdAmVJ3eB3Y5PRqBvVXUzDEDegtKxWNGOrc71U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVYabiseExYqM-xScYV5dtu1L6LboIsygKyQFB11bJDA&oe=6B0C8150"}, "display_name": "Batter Up, Anywhere!", "keywords": ["baseball", "batting", "battingcage", "fastball", "training"], "long_description": "Your own VR batting cage for practice and play.\n\nBatter Up, Anywhere! is a single-player batting game for Meta Quest. Grip the bat with both hands, watch the pitcher, and time your swing. Practice your swing and work on your timing in a virtual ballpark.\n\nPractice at your own pace\nChoose your pitch speed for a focused practice session, or challenge yourself with fastballs at 160 km/h (about 100 mph) and beyond. Repeat a single pitch type or mix fastballs and breaking pitches to vary your practice.\n\nWork on each swing\nChoose the right- or left-handed batter's box. Swing speed, timing, and where the ball meets the bat affect the result. Experiment with your approach and practice finding the sweet spot in VR.\n\nSee your results\nCheck your hits and hit distance, then step up for another swing. Fit in a quick batting session or spend time practicing the pitch types you find difficult. Aim for solid contact and see how far you can send the ball.\n\nClear enough space to swing safely, wear your controller wrist straps, and keep people and objects out of your play area.", "short_description": "Turn your home into a VR batting cage. Practice your swing and train your timing with both hands on the bat. Choose your pitch speed, face fastballs and breaking pitches, and work toward solid contact and longer hits. Ready for a challenge? Take on 160 km/h \uff08100 mph\uff09 pitching."}]}, "developer_name": "Nii Games", "developer_privacy_policy_url": "https://nii-games-privacy.nysk07.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Nii Games", "support_website_url": null, "website_url": "https://nii-games-privacy.nysk07.chatgpt.site/game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "
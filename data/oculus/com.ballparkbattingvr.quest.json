w.png", "id": "1812633166447767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628436_1812633169781100_1035914683275847825_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDvQmALMTjQQ7kNvwEr3afc&_nc_oc=Adrff3mOerTEUqrUclrMJFyv8igQupIQpFpSRPx11pLmkhwNPJUlC45g7JcTR4cajYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKif3QeCvaMUAB0uqU4UzCXZwBDMAJAxsPvu287ImpfQ&oe=6B0DA05A"}, {"file_name": "04-Contact-Point.png", "id": "1669139844573813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628411_1669139847907146_252805025715602351_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fufqVw70M0sQ7kNvwFJ-xDI&_nc_oc=Adp-mOuj4dMZglM9yOGWcqnvIkV7TwSfowGNp72lYQ_cAAeUy5bD8bjeK6hHvRrt7II&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXtANucA2dglGrsm6MO7ebogup_JKFGsb5FbkUtmyY1Q&oe=6B0DB08A"}, {"file_name": "05-Incoming-Pitch.png", "id": "1132677056410904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1132677059744237_3138055253029135937_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xe74GMPWgUYQ7kNvwHvCReM&_nc_oc=Ado3n5l7CX1a382n3lJkbo7ePeqrNHR73THQ6Ye8GQSH1hGZt-dT79g-ozMTPJwfmUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQ2ziPYj4zJSYY3Ug-FJY2ApiaE6_Q3thkI8Lcw9Hvvg&oe=6B0D9E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-Bat-Ball-Contact.png", "id": "2452140845520358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623558_2452140848853691_7860175044628188762_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N9pVDPGEfkQ7kNvwFtNV6L&_nc_oc=AdoFzyAdq9F-uZ83CsPEM683V_QlLQdgr42q5ddyC5tVV6EVbNl-OlUjqZJQa9Pnlg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-BtEdJOd1E3hnYZlPhhr0PhIxgFZUEqB-zCnkklkeHg&oe=6B0DD2D0"}, "display_name": "Batter Up, Anywhere!", "keywords": ["baseball", "batting", "battingcage", "fastball", "training"], "long_description": "Your own VR batting cage for practice and play.\n\nBatter Up, Anywhere! is a single-player batting game for Meta Quest. Grip the bat with both hands, watch the pitcher, and time your swing. Practice your swing and work on your timing in a virtual ballpark.\n\nPractice at your own pace\nChoose your pitch speed for a focused practice session, or challenge yourself with fastballs at 160 km/h (about 100 mph) and beyond. Repeat a single pitch type or mix fastballs and breaking pitches to vary your practice.\n\nWork on each swing\nChoose the right- or left-handed batter's box. Swing speed, timing, and where the ball meets the bat affect the result. Experiment with your approach and practice finding the sweet spot in VR.\n\nSee your results\nCheck your hits and hit distance, then step up for another swing. Fit in a quick batting session or spend time practicing the pitch types you find difficult. Aim for solid contact and see how far you can send the ball.\n\nClear enough space to swing safely, wear your controller wrist straps, and keep people and objects out of your play area.", "short_description": "Turn your home into a VR batting cage. Practice your swing and train your timing with both hands on the bat. Choose your pitch speed, face fastballs and breaking pitches, and work toward solid contact and longer hits. Ready for a challenge? Take on 160 km/h \uff08100 mph\uff09 pitching."}]}, "developer_name": "Nii Games", "developer_privacy_policy_url": "https://nii-games-privacy.nysk07.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Nii Games", "support_website_url": null, "website_url": "https://nii-games-privacy.nysk07.chatgpt.site/game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "
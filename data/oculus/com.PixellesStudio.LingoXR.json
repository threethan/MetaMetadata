_1971902463322839_98461710702758520_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7cG3HNhF4IQ7kNvwFcg5Xt&_nc_oc=AdqiJNmQJvHzjaamPIzChzSBisM9AkvverH4NsTI9vj0v9qNgG06GnVZfRyxa9Mcrtk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxWEfhjUk_uzphCXB1zTSDlCgNTfHmEU07X6DEVxXxZA&oe=6AFB4A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusAppStore_Visualizer_LINGOXR_02_panoramic_video.png", "id": "1551303725816804", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86873410_1551303735816803_4745214447588552481_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuUoHG8eIT0Q7kNvwFP-COv&_nc_oc=Adou-tYjRS0oaxiH1j2a0E7C0Oa-m3BKh4TeSH3rdhV0AEMEpHIdFQG8vnQwA82-0Jc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0yaZGQhezGzyGS54hmTu_l7Deurm3fOFR9_JQe8G4Eg&oe=6AFB4B05"}, "display_name": "Lingo XR", "keywords": [], "long_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless. Ready to talk your way to fluency?  ", "short_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun a
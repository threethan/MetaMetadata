_1971902463322839_98461710702758520_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wns5aXFcrowQ7kNvwHh59O-&_nc_oc=Adoy3sS3AqNa70kBcmSJi1J4SKU268QvGJkum4bu13QIUMkh5MuudkKpLVgEqdniC3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRke0UWuhS8LGAbwWhtw6rylpKSk_4cEH9LDgWYimEeAA&oe=6AFF0656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusAppStore_Visualizer_LINGOXR_02_panoramic_video.png", "id": "1551303725816804", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86873410_1551303735816803_4745214447588552481_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8hExGOT8OkQ7kNvwE6R94A&_nc_oc=Adqtn0UKkboI2e41gRHLO49vp9m-7w7xJ_D3bGUQafP6_EPa2rSzsAh0RYzJ8l3kcmQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWSU0XRoRsM1V0fN8ksiJHWD16-Gx8ci5y5iH5GzvSww&oe=6AFF0745"}, "display_name": "Lingo XR", "keywords": [], "long_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless. Ready to talk your way to fluency?  ", "short_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun a
file_name": "OculusAppStore_Visualizer_LINGOXR_02_panoramic_video.png", "id": "1551303725816804", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86873410_1551303735816803_4745214447588552481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKhpWRuhDDcQ7kNvwF03OPe&_nc_oc=Adk9-zDbSh-hogwCd444OFkOyNKmIwRRNnGZ1Y5Y_VirAxkSY_eQEHeVKCg_-rRYXNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftJkux3BeyGUk_hTEE5RtuH0ncDd2v9X3iVT5MitWqvHA&oe=69A84145"}, "display_name": "Lingo XR", "keywords": [], "long_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless. Ready to talk your way to fluency?  ", "short_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixellesstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Pixelles Studio", "support_website_url": "https://www.pixellesstudio.com/contact", "website_url": "https://www.pixellesstudio.com/lingo-xr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categor
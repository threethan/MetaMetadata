456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusAppStore_Visualizer_LINGOXR_02_panoramic_video.png", "id": "1551303725816804", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86873410_1551303735816803_4745214447588552481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3avV6AFKWSYQ7kNvwF2_mfM&_nc_oc=AdqUVykNp9s-64iR2HUa7E9jIVV3Rzv7apPmCcbH9bsvUVsyIbsCXtdP6ZO4A27yBaI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sYWzvadoBUQj1a73lBwSXbgIleFwD-a2hRPfLV2hx2A&oe=6A467545"}, "display_name": "Lingo XR", "keywords": [], "long_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless. Ready to talk your way to fluency?  ", "short_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixellesstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Pixelles Studio", "support_website_url": "https://www.pixellesstudio.com/contact", "website_url": "https://www.pixellesstudio.com/lingo-xr", "category": null, "comfort_ratin
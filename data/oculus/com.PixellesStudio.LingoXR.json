_1971902463322839_98461710702758520_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgTP_trMEEAQ7kNvwHJ7mhf&_nc_oc=AdqM9D0EoIdLxeWrP0R7DmIvI6KwlVcVJUPQNOVeo55Uws7kvmY-vKk6Owj_vqVcNDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRld6WjXvkpXeaMxWVQ-jQO1JkVx_2aUC73I_4gWnIUwg&oe=6B0C6D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusAppStore_Visualizer_LINGOXR_02_panoramic_video.png", "id": "1551303725816804", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86873410_1551303735816803_4745214447588552481_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4ai9aW-usEQ7kNvwEgw50X&_nc_oc=AdoaL1NvxFoE4yGeodkLrohTKjusYuF-bYzV99qUdSTNazIQnxEOX1WKWNIr2nHF8Kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvm0T43BIWuqeBq8Zp2YZeOS_S7Te1N2gmox03Sywo-g&oe=6B0C6E85"}, "display_name": "Lingo XR", "keywords": [], "long_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless. Ready to talk your way to fluency?  ", "short_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun a
_1971902463322839_98461710702758520_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT9ZnvGRS04Q7kNvwFBIelw&_nc_oc=AdoDkuvZNlsd2mdheYZwLjE5iDG9AS3QJqRpuwCMxWO8GTVTONtAl6ZtDwl0GWKwmh8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5FNCp1aoqmI_EsE5WElAzWVc0TSzUap4fLnqtsP-PLQ&oe=6B0840D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusAppStore_Visualizer_LINGOXR_02_panoramic_video.png", "id": "1551303725816804", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/86873410_1551303735816803_4745214447588552481_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7wxoU8ivy0Q7kNvwFqZK6s&_nc_oc=AdorCC1JOARbCJYxQ1pFY74sZCKoxV50Yj_dc0pL_9fvYpMSVyvdK8v9dM1SXiJJfnw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdM1JMtu51Hqjqj4q74YkYtp7z7oF05JUpHOOTsiohOQ&oe=6B0841C5"}, "display_name": "Lingo XR", "keywords": [], "long_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun and effortless. Ready to talk your way to fluency?  ", "short_description": "Transform your environment into a language-learning playground with Lingo XR\u2014the immersive augmented reality game where every conversation helps you level up your skills. Powered by cutting-edge AI, Lingo XR lets you engage in real-time dialogues across multiple languages. Whether you're practicing Spanish in your living room or learning Japanese at your office, the world around you becomes part of the experience. Lingo XR interactive conversations that make learning fun a
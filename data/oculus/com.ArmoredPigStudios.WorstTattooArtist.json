15827478549_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkCyI-BzgicQ7kNvwG8F_3O&_nc_oc=Adppc6qMXw2SWWKMkkHY-4ur8-VnoyLGO1bGjkaCFpg5LrQslKsA4O50zVSy_T00IGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX-ru3d41NSXBk-GDkCWQ2u29W0UwffWYyc9ouE3dvMQ&oe=6AB51EC1"}, {"file_name": "Screen2.png", "id": "1265589668679260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1265589672012593_3658224455120532582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqZUNJn8krsQ7kNvwHdKJUy&_nc_oc=AdrLBMYSAvRxSrAPy7IIlMHOsJmmAsr1obSN-F1HAZ-u6Q-f9AaBaCjmnvNfb4kDHu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8LhocvhKFryTjcIQ6y12DJ9f08HpM_pNWc_6BTc-_Xw&oe=6AB5174F"}, {"file_name": "Screen3.png", "id": "1019679910584958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1019679913918291_3373713964438446187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLRNfr-Vm00Q7kNvwEI6INe&_nc_oc=AdqxIkgrfU1WQJMRJYockovgkt6h2nkuGJNxZuVmk2ZDGfpB-JQfn4oxHlk3TaetX2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlzok5NXdNJ-_gM666QoJhaUQ6RIY3ZQJpWNaVOWgUKQ&oe=6AB529E1"}, {"file_name": "Screen4.png", "id": "2097405577872032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_2097405584538698_8433309779683840248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifpvvcMT4f4Q7kNvwFmoU2w&_nc_oc=AdqkUiQUQ7twcwCvFPvI8copb9ItOypY1CX2zP5E2b99jvtJvH_a3NNMLsuetnCz2TI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4J3WPJA-03eyt884Aue-0TZlJAgmFT5CEMabFC5lVIg&oe=6AB5428E"}, {"file_name": "Screen7.png", "id": "2188781708609582", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313072_2188781711942915_4585520543831012120_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOP01fM7nLAQ7kNvwHi36aC&_nc_oc=AdodDVu24thjPHeN7nrzIHLzxh-E_z6OgSiq52Sxhe6hnjIgb7dzxR3HI63x0lkNUvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIlcFyPNKDGjb-gblye4AVL6hJSa8obosOrN0jE0lYkw&oe=6AB5380A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Worst Tattoo Artist", "keywords": ["tattoo", "drawing", "draw", "artist", "simulator"], "long_description": "**You are the worst Tattoo Artist of all time!**\n\nTattoo clients - anywhere you want!  Clients will come in and have you tattoo THOUSANDS of designs!  It\u2019s up to you to make them look good!  Your tattoo will be graded and ranked, and the customer will pay you based on how good you\u2019ve done.\n\n{1314372860663408}\n\n**\ud83d\ude31 Tattoo ANYWHERE!\ud83d\ude31**\n\nYou can tattoo anywhere on the body!  Use four different types of tattoo guns in order to bring your masterpiece to life.\n\n{1627968038263566}\n\n**\ud83d\udca5THROW your clients around!\ud83d\udca5**\n\nIs their positioning not optimal?  Throw them!  Grab your clients and hurl them wherever you\u2019d like.  Is their position too messed up?  Don\u2019t worry, you can always reset them!\n\n{1316371727104552}\n\n**\ud83d\ude4fSave your best designs!\ud83d\ude4f**\n\nWhy let a masterpiece go to waste?  Save all your best designs so you can come back and view your best works!\n\n{2144770492971247}\n\n**\ud83e\udd11Make Money!\ud83e\udd11**\n\nWith each tattoo, your skills are graded using AI!  Your clients will grade you based on whether or not you followed their request.\n\n{1294167298999165}\n\n\ud83d\udde3\ufe0fChat Away!\ud83d\udde3\ufe0f\n\nYour clients are very chatty, listen to them talk all day!\n\n\n\n\n{2880961195578913}", "short_description": "You are the worst tattoo artist ever - tattoo thousands of designs and create your own masterpieces in this VR Tattoo Simulator!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr/home", "categor
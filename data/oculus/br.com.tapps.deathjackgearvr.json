Gxwj-bGnNOPlslg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5QvRX5Ptz8u_wq1cBV_5BG8-p_aEwPXZT0MEluEqgKA&oe=6ABD2954"}, {"file_name": "migrated_image.png", "id": "213693316412083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162682_173826953195037_7486489933822033920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv4F0mbY88QQ7kNvwElE4md&_nc_oc=AdoIn4nWud3HCzSZFo7ZGWfcdy8jQ76x1y4jVQXO28KMZ__YVuOGhdOyKmPl1rzZlvM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIQ9QCUEEU-0kDFSE3JN6t2sNy1s8tQQQcM67obRU1RQ&oe=6ABD1256"}, {"file_name": "migrated_image.png", "id": "197214051581953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_118515752151029_8826815382837788672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0LLYoxapgkQ7kNvwHNQR-G&_nc_oc=Adoc_oYOrZlBTgjRtHz4T_sdHxqTcn7Jir8v6k8CCBdCQo3iPrG1_vTPGT7BBtxOkao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaU4Bw2kr19ohVKkkStosuQReOC3teKTzbN9B-VnqQmg&oe=6ABD3089"}, {"file_name": "migrated_image.png", "id": "633455984174331", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_1853101121685678_2538472864760201216_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkE63_bPySYQ7kNvwHaWdAH&_nc_oc=Adq3BErqGRjOImTKSjUd_jlvaHb6f2qwJZEoKuxgQsRhuvck0hf0nWnZaqWwUK8cl4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE4dRAartStkUh5wlkL50KqwKGqiojBIZo0rCRT6r15Q&oe=6ABD1D81"}, {"file_name": "migrated_image.png", "id": "655272981893835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_131037137639250_7144547053148831744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXU2DfIABkQQ7kNvwGEinyx&_nc_oc=Adp6ZgAvo5_AeEwH56IYVErMz-KrSMRQk4PAfI9XLzfjBc7i2kAtfyiQFmY0I4USXIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEu0D92w_5-HThqy2feh1Ofg2qwn1ZacfXSQaYJE4l4w&oe=6ABD206E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deathjack", "keywords": ["blackjack", "casino", "funny", "scary", "cards"], "long_description": "Play a game of blackjack, with Death itself as your dealer, to decide the fate of your soul!\nDiscover that there is indeed life after death, and it's pretty fun! If you win, anyways...\n\n\nUSE YOUR HEAD (WHILE YOU STILL HAVE IT)\nNod or shake your head to answer Death's questions. Remember, dead men (or women) don't talk.\n\nBET YOUR SOUL\nGamble away your chips, but do it wisely: they are actually your very soul.\n\nREACH FOR THE SKY...\nTry to get as close as possible to Heaven and leave your eternal mark on the leaderboards.\n\n...OR BURN IN HELL\nIf you lose all your chips, enjoy our consolation prize: a complimentary, very hot sauna. For eternity.\n\nCome on, you're dead anyway. What have you got to lose?", "short_description": "Gamble your very soul in the blackjack game of your afterlife."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "668840690814935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162690_266826583836410_7653494600346107904_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1
yqDxDXEsOmhztfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SS9XzsVLmgHjhxN3PrxQToGX-NVNGdQH4uB3vuBOKag&oe=69DF7514"}, {"file_name": "migrated_image.png", "id": "213693316412083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_173826953195037_7486489933822033920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhwxELi6SwYQ7kNvwEoIXLv&_nc_oc=AdpK6p9pY6GG2dnlarm4MZt-UbwW6wcqmd0zWLROEtMH5XAcNanRA8kwAvGiy0Qn-1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HpDOBiKGMEAGJcRfSCVH2SGJ5mmdFcH1j450ZqmvmXA&oe=69DF9656"}, {"file_name": "migrated_image.png", "id": "197214051581953", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162707_118515752151029_8826815382837788672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SiQZ3A11tIQ7kNvwFDBhdp&_nc_oc=AdpySvbK7go_Sy_Z_wETDk57sQYdrSV6zRhBnNKGeGoqKKAeM4mpbkEudPJknj3-k5w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Hm7gTRHKqVHvm8r3MQC3P-CU1vAOuIMnEuo01E4lTxw&oe=69DF7C49"}, {"file_name": "migrated_image.png", "id": "633455984174331", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_1853101121685678_2538472864760201216_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9Hx7luaqAAQ7kNvwGJMcny&_nc_oc=AdpsftR_XI-Sb6dB5h4Thd_IicVS5J0oxeZJAd_Z46LweU9_Om3HxBQE9o1oWDpEBZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LZTqWS4AteHkgNkcTNL5TfFFqV8deRlvQGEcKHGCbUw&oe=69DFA181"}, {"file_name": "migrated_image.png", "id": "655272981893835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_131037137639250_7144547053148831744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnQ6Pd565YoQ7kNvwF-eONM&_nc_oc=AdrdcsX0l5AV_pEFrKoR0LQu3YwoyOTROPgFvwzpAHYk1N_J1DzlO5XkutdaBSmyuPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iVUQbCWGGt99_oBbO0EyrhQ_Xg5sXAACwQ7FI6D08eA&oe=69DFA46E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deathjack", "keywords": ["blackjack", "casino", "funny", "scary", "cards"], "long_description": "Play a game of blackjack, with Death itself as your dealer, to decide the fate of your soul!\nDiscover that there is indeed life after death, and it's pretty fun! If you win, anyways...\n\n\nUSE YOUR HEAD (WHILE YOU STILL HAVE IT)\nNod or shake your head to answer Death's questions. Remember, dead men (or women) don't talk.\n\nBET YOUR SOUL\nGamble away your chips, but do it wisely: they are actually your very soul.\n\nREACH FOR THE SKY...\nTry to get as close as possible to Heaven and leave your eternal mark on the leaderboards.\n\n...OR BURN IN HELL\nIf you lose all your chips, enjoy our consolation prize: a complimentary, very hot sauna. For eternity.\n\nCome on, you're dead anyway. What have you got to lose?", "short_description": "Gamble your very soul in the blackjack game of your afterlife."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "668840690814935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162690_266826583836410_7653494600346107904_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1
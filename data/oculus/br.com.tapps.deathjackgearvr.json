f20f&oh=00_AQEgUpj6jsFdTusDWDXH4hYTtqUhaBat6MDY_ym9YO8RYw&oe=6A70A681"}, {"file_name": "migrated_image.png", "id": "1712429158900318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_131037137639250_7144547053148831744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2N7AtXN5XAQ7kNvwExInKe&_nc_oc=Adrn8fkaQf3SHLm3nuKF1wca9_1-CUWtaiLwoiVRVL_-zjm0dyLcfjutLMbCCgqId2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlnk8uk8w5xXieOv1w0kDQ4Ew9ZuLQuqUMBlH-6eN9qg&oe=6A70A96E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deathjack", "keywords": ["blackjack", "casino", "funny", "scary", "cards"], "long_description": "Play a game of blackjack, with Death itself as your dealer, to decide the fate of your soul!\nDiscover that there is indeed life after death, and it's pretty fun! If you win, anyways...\n\n\nUSE YOUR HEAD (WHILE YOU STILL HAVE IT)\nNod or shake your head to answer Death's questions. Remember, dead men (or women) don't talk.\n\nBET YOUR SOUL\nGamble away your chips, but do it wisely: they are actually your very soul.\n\nREACH FOR THE SKY...\nTry to get as close as possible to Heaven and leave your eternal mark on the leaderboards.\n\n...OR BURN IN HELL\nIf you lose all your chips, enjoy our consolation prize: a complimentary, very hot sauna. For eternity.\n\nCome on, you're dead anyway. What have you got to lose?", "short_description": "Gamble your very soul in the blackjack game of your afterlife."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASU
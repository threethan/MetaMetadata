k1saaMQjq4sZ3MQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83uMxZZURDhgJn9cNbUEEvyQKRUPSKukt8OJ0C6lAKvw&oe=6A3E9954"}, {"file_name": "migrated_image.png", "id": "213693316412083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_173826953195037_7486489933822033920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmnfXgHyJq4Q7kNvwGxngS4&_nc_oc=Adro3lKbJR4DuVyzxmCqEbga_FDlgXKY_WZneYj_6aOwaXZdk7Lc7Fzwj1bIXXCgBU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af829OF-XDAEYAwMm325R0dORHpp9NFjzD5iEP3KV8uhBQ&oe=6A3E8256"}, {"file_name": "migrated_image.png", "id": "197214051581953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_118515752151029_8826815382837788672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkKAMwHRojEQ7kNvwH-R8HM&_nc_oc=AdqcFlSI6vpEP7iBeC9BNV2yWpdTVYKfZpDDxGicKxLJrCjk4WcVMJo0crZonBy-n5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8GgfeizGOO7zq5zm0XQK9ZdrQyYABpAB2-jg5-zet_Q&oe=6A3EA089"}, {"file_name": "migrated_image.png", "id": "633455984174331", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_1853101121685678_2538472864760201216_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99Fl4k3YcpMQ7kNvwHNM8Ak&_nc_oc=AdpwCq9pkZcyWpA817E0I1gplJ3NXGuS06WSsBuQu_sPYLspf3dB9v_oBEOegIaCF44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gAmzPCkTYitpkgwBJTG6eqpoSe1xXQChZU5nTAQ8glw&oe=6A3E8D81"}, {"file_name": "migrated_image.png", "id": "655272981893835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_131037137639250_7144547053148831744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jT7DXSz7FQQ7kNvwHKP-ic&_nc_oc=AdqRU10KRM7X7jq0O4E0S788PefU2FQXKfxUXmH4FS_7zrDTC7-e7d9eKQH197OVels&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1xvPGMU-cry8XDD337o78zT4rq94ZUBUUo-dfOx8bUg&oe=6A3E906E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deathjack", "keywords": ["blackjack", "casino", "funny", "scary", "cards"], "long_description": "Play a game of blackjack, with Death itself as your dealer, to decide the fate of your soul!\nDiscover that there is indeed life after death, and it's pretty fun! If you win, anyways...\n\n\nUSE YOUR HEAD (WHILE YOU STILL HAVE IT)\nNod or shake your head to answer Death's questions. Remember, dead men (or women) don't talk.\n\nBET YOUR SOUL\nGamble away your chips, but do it wisely: they are actually your very soul.\n\nREACH FOR THE SKY...\nTry to get as close as possible to Heaven and leave your eternal mark on the leaderboards.\n\n...OR BURN IN HELL\nIf you lose all your chips, enjoy our consolation prize: a complimentary, very hot sauna. For eternity.\n\nCome on, you're dead anyway. What have you got to lose?", "short_description": "Gamble your very soul in the blackjack game of your afterlife."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "668840690814935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162690_266826583836410_7653494600346107904_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1
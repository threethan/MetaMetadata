Ij1oyPBM7JViMB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03NutFfhvO8KT23W0UZ-KZGRMc7ELS4KRA3M2s_wRLiA&oe=69EA3954"}, {"file_name": "migrated_image.png", "id": "213693316412083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_173826953195037_7486489933822033920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMSexPlGRu4Q7kNvwEPP9sO&_nc_oc=AdpSjwkeMXui82Axj8xFEsnoVmtjxNYPepF3YG5xzXykscK6epFGMUqBjtNQhgrIuKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PchinC876VBf9UNlnPEZRwFKottRDwdRAVRZPr7GDog&oe=69EA2256"}, {"file_name": "migrated_image.png", "id": "197214051581953", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162707_118515752151029_8826815382837788672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OCVkGgXj7gQ7kNvwFK6oAO&_nc_oc=Adr-BkiZMK-P_NecvGz2EGME616JTv3sh_4pxlfQdl2xsDmv4UKtMitl_idk2ZwM7SI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nr-qztaF4cIxRdYTV7vvEc92V5_uHUHuQQfLCNMo9ig&oe=69EA0849"}, {"file_name": "migrated_image.png", "id": "633455984174331", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_1853101121685678_2538472864760201216_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RTgCAzdsqEQ7kNvwEk25st&_nc_oc=AdqBUedGGQFKAmqJqCV3jkWbYPlmqKpP_V4ZPOI7Nk37p6i2EMk9LpzEbB1H6rv_R58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ep_j73OZoh3viaFqnfh2f3_DxFGGb4KEJbjUnrZaAlQ&oe=69EA2D81"}, {"file_name": "migrated_image.png", "id": "655272981893835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_131037137639250_7144547053148831744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh3f0W0ciMsQ7kNvwG_l1np&_nc_oc=AdrqAyPqH2bEXlBEQCkuA_hiSryn6EzJNm_dlMBhFW5QJwQA2dykvUOOBe8V2_xj660&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LTfRbtAXYGz37uwLqrN99zDvJpMc2v9yazKnkm4xYMg&oe=69EA306E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deathjack", "keywords": ["blackjack", "casino", "funny", "scary", "cards"], "long_description": "Play a game of blackjack, with Death itself as your dealer, to decide the fate of your soul!\nDiscover that there is indeed life after death, and it's pretty fun! If you win, anyways...\n\n\nUSE YOUR HEAD (WHILE YOU STILL HAVE IT)\nNod or shake your head to answer Death's questions. Remember, dead men (or women) don't talk.\n\nBET YOUR SOUL\nGamble away your chips, but do it wisely: they are actually your very soul.\n\nREACH FOR THE SKY...\nTry to get as close as possible to Heaven and leave your eternal mark on the leaderboards.\n\n...OR BURN IN HELL\nIf you lose all your chips, enjoy our consolation prize: a complimentary, very hot sauna. For eternity.\n\nCome on, you're dead anyway. What have you got to lose?", "short_description": "Gamble your very soul in the blackjack game of your afterlife."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "668840690814935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162690_266826583836410_7653494600346107904_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1
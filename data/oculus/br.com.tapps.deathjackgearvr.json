&_nc_oc=AdnLXsPxSn-iGkkN1xH0gOYz5oM9iZZvc5_oT3mttywSGzBSgrMZLtFpLhHusCeSEiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuB9ZAsS9U50-3_Buzvz6y6kjkOBOvAOSBSe_S8YNeYjg&oe=6999C4EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deathjack", "keywords": ["blackjack", "casino", "funny", "scary", "cards"], "long_description": "Play a game of blackjack, with Death itself as your dealer, to decide the fate of your soul!\nDiscover that there is indeed life after death, and it's pretty fun! If you win, anyways...\n\n\nUSE YOUR HEAD (WHILE YOU STILL HAVE IT)\nNod or shake your head to answer Death's questions. Remember, dead men (or women) don't talk.\n\nBET YOUR SOUL\nGamble away your chips, but do it wisely: they are actually your very soul.\n\nREACH FOR THE SKY...\nTry to get as close as possible to Heaven and leave your eternal mark on the leaderboards.\n\n...OR BURN IN HELL\nIf you lose all your chips, enjoy our consolation prize: a complimentary, very hot sauna. For eternity.\n\nCome on, you're dead anyway. What have you got to lose?", "short_description": "Gamble your very soul in the blackjack game of your afterlife."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_mode
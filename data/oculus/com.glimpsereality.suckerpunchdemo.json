}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW_z3Y-kKswQ7kNvwHKfLO6&_nc_oc=AdpLG4RmDot1Mb5SVp-BHyW73SWFGhBMa5CQ-Vus_loBTQEVfpHpm0J4HWJ8VEgPwQQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStqWH4bdDKDcS_ABo43pvN_PLx39rlnjM9vNWa-sRRag&oe=6AF9E09D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMgl9SSIEygQ7kNvwFos2up&_nc_oc=AdrLwVZi-UtKJbgQbOg0hMmzbZ7kB_ZndTF49jcxZt0zmz2-ketUvu40iK-6CgYFObA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxJRJg60AU_m-Fu7AQsZbamx9bWj1MSrfvDENQm6ASGA&oe=6AF9D056"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPE99EtvjAsQ7kNvwGpvi9S&_nc_oc=AdrxToYFIUZZtaWfsQvNjvdmMU6KxR_VV7wmIYOlo5k_xLK0DcJJYvp7wnqGgqULQPs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5wOJNrzwADIT9mJhFvGgsqLEmquvEFINOpsdt-XNrJA&oe=6AF9CEE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKMsuJ4eeAwQ7kNvwFCswsS&_nc_oc=Adp3XLd9JNXtxaUGqcehhbIaQvL30-bH0Pn4yrCUpH_K0cKky3ZJ_jF-NYQWp1Gaet0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE9lr5teiX8O4qdoj9Juvb7RPFQatD4nBwHpiJkre94g&oe=6AF9B624"}, "display_name": "Sucker Punch VR - Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sunker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
TZ1BsLojHMsQ6L9mtGtOHsUpOpx0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LdeTc0b25BBVD2DnAFx0tQ72XhQtqqhzhF4L4m5VVHQ&oe=6A2C2108"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0UB-CqgxZAQ7kNvwH8Ul0i&_nc_oc=AdpqQ6_oeE0auMRgQtP7yF3f8KjDg3zMeVcK3Hpn8szqbsNBmeeAKyP8mqEu46Ap1OQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KY0gDPeqiJY2rWT9fe036jdyyddVYLeavGITdS33zJQ&oe=6A2BFE5D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC-u7EXGsyMQ7kNvwHYzYXr&_nc_oc=AdrV2fGztTjfOWHt2Hs5XqinfyB5doS9aEA6Msge3Jnw65WmPnNVoO3iFoy1TsY47LE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98mDf0al97ruT8q81OnruI0Br-g35lPloLuzyfSlIuRw&oe=6A2C2656"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL0RCvxN_ZwQ7kNvwHi3v6B&_nc_oc=Adp-GlrxaCX5gfE-0akIKtV2XVEPpWOFjkDSPSc5f3R6RgXTrOEX6z4qJJGXYEWz29s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IaIonRK2ODdRtRN1D6YPpXBjeV1q6o3Lo-w40jqf_TQ&oe=6A2C24E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKaNzT3GO4EQ7kNvwFNDEbK&_nc_oc=AdockmWfCL9XGFkx3DLlRzrIG8PdGZjGJnFNoIPUxunsPhlvMdurQVsZsypKSUbx8gU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p78Nxk1QfpavgVlfT4baNjD6b8xJudo2B2rYVDtxxSQ&oe=6A2C0C24"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
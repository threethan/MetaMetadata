G47lB_kECU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsuIZSeBfEJqJKVgz7_gC4XbM2amCICScPpOIQbTSE9EQ&oe=69A190DD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPD0fEXr1RsQ7kNvwF32p4e&_nc_oc=Adm4MOLpGLZHkBUm3GocBXX0tg5pQA6IVRyROSwpqdtOdlt40YXLLE7L8TYr6PZvkB4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvL83EpwrjiQr9YRtXdIliogZrugzOsZ4dsi1af9IdVfA&oe=69A18096"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt5grlonRtgQ7kNvwHrkDyK&_nc_oc=AdlE0x5rz2uQtYOLxwtHOMRXhlcKgk3yCq0-HRjDGC3aO5WSE0FNAh-4Y3Hki1SlQFY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuTKnCovdzV39XpOg-ksJgMUMAXYJenwji9MTPGuP99_A&oe=69A17F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYX75sIf9-UQ7kNvwGCNC3g&_nc_oc=AdndVqZeBTJyNHEsw0b1SGtrimhVoxttWQtekIM1keZfdyJEQKGJpvwizuI-yABW5Jg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvOYW4342MXvVJ7K6ksDVr6OKMaBpNTDPHzhaA9iCC_0g&oe=69A19EA4"}, "display_name": "Sucker Punch VR - Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sunker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1216715385525433"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "495350395350398"}]}, "baseline_offe
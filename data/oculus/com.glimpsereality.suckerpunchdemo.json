hMkwJRZzL8p2VXrxJOXMj5bJwYvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x9nYdkLB_xr_YWLCtprswYpZKNnlynMk_jbbVfvFBbA&oe=69DE2048"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AAiPurf1AIQ7kNvwHP263l&_nc_oc=Adp4TFSl3uAvod34Dtdl8KRi68TpAxviWtxbDE2h9Tb8Q82me3z3JL5OBRi65PwbY64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EJYxlDFSpYvGX9CyOR7xGuPiyCV8EhNFx6v0vKGiI1Q&oe=69DE35DD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VlATPXrCJYQ7kNvwHhskDT&_nc_oc=AdoaTxDg-Ieppulsd1T_P0SQq5LD8HLeUnIRt7ZrZeLRxCZzOzS_E6qAy6ddERg-MRU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vz_YBv9bR307lgAtWm27P88_l_cFbcLUlne4X2xzcjw&oe=69DE2596"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KLhPBfQbSAQ7kNvwFEUUWV&_nc_oc=AdrjWaxHRFDIrxjWfnhMIytCPaK-byS7x0-QHLj2ob_brZ7UV74ZkgxbbpiJbY61oms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bCEHtI9a0N3PcA93WM7EcqfMUxXRuGCvJrlDz_DKAAA&oe=69DE2425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uce2gb_Yw0oQ7kNvwFk7GQg&_nc_oc=AdpBn7PMfztvo3XtzJ5dohQhJAtg2SQBPh7moJDtSJhj8huvjT4YuT60DvqQyj3fHgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fEXA0WQjc7GcRsXF9JE-auntVU6Jt6gV_ZH0bZHO-Qw&oe=69DE43A4"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
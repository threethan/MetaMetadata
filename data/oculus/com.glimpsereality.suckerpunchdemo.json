7upov035dG97zh5Uc6KASdsx4NVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PEu7EK81uroO51yZvyHWHQ98D6bjzLKjn3QWljYmI4Q&oe=69FF4E08"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLjatOxeCjsQ7kNvwGnDW0r&_nc_oc=AdqITUtEXX1pLd5Nd1uyDM5kdoyl8g3Wm6Hsn_aMz48cR69qcPzw9ozPKfaoxf6mABo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hy0Itd5WiQGR_RjKkHEDLw8ZwfF8ntmJ4ZPV1F-QIeA&oe=69FF2B5D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZskNfVvDFocQ7kNvwHcgVy4&_nc_oc=AdpbrQOf7-dKAQ7h5CqKx9_BM90iypQYzOb5GYj8oojTUMwCw7m4Y0OJNgwVw_-CQ4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iuOX4AqD1L_Zbgfj3NmlPyOUcAzyBsizEdXqFrQVCxw&oe=69FF5356"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGiMwcI2t5cQ7kNvwGe0Xb_&_nc_oc=AdpbtjJGWh5TBqeBqpRjq4HM4b5a0_W3nzhvM5p7Xm2nt_xqdi15kzt1eBJj8MW1gX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MG8iTMWa0b_i6HNJMmjE1SZ4yVkmltdjKz9VSTHgPKA&oe=69FF51E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zivBy0GMKBQQ7kNvwGbkrPR&_nc_oc=Ado1jsP4z0wiX_zuKV6T2n8cP46qAxyBrpada32GEQDYuJY3FMM8O1pJIaMcyyv099E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58mHzoTF-LGXL7ueMrPabhp3J8RORB1aBhyBK9MpacQA&oe=69FF3924"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
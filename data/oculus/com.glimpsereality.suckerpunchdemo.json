_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgEeHWJul9APbCA55lSCmtxfmWxzuXEDtx9znZQpx7BA&oe=69B541C8"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUCybRMZZd0Q7kNvwF1o_Om&_nc_oc=Adlq4mQ2z9s8XHKCXv0dP-CIHLMq2WY4h5tfRTy5hFwYXuyFm43NKSnWoAtHkbYAOVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-fVB1v5vAtpJqvPGR6-MWojQrdFgfLxLguq7T5cXM3w&oe=69B5575D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE-rNPJWE0EQ7kNvwFV3FdQ&_nc_oc=AdkA7M_V-bDXGQ3e2-tKY7XSIehJXeX0_WlOqaen0JkCIu3j-0m1i4Jj181DyE6PkGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOR7wxZdYki_8Ah2v1JAGz-CN76VGI3Rzu2V6m_58uJQ&oe=69B54716"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNO0HI9esTwQ7kNvwEoN1ct&_nc_oc=AdnzE22UpeG040qNwVkc2VPXkHfd-EPVGM86m4OW1u_yk_YZ2XKy1IBu8J7lSu4_zg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzR_-6o4zMWeuzGwaYTQhBQbuNmrMrh-muXNOwFpu3jgA&oe=69B545A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jsoUcrmsxQQ7kNvwH4-6RR&_nc_oc=AdlepCLUh5ODgE5S8Q2DZePgTt56e70LQ-w_0xUddKx1_YojaAJXry0Mh4YK_19JCLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6-n9Z2hP6HUsvPdjrhhFl0d_cZphSmgO6uSyclWgPhA&oe=69B56524"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
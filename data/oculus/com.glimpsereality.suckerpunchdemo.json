_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyaB0tzjq7Dnbr2mdzOwSDfAryBCUMeK2uHms58dzZMyQ&oe=69B7E4C8"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUCybRMZZd0Q7kNvwELNE7z&_nc_oc=AdnFoK1BO98Uu4HpPg1CGhD32ZF_RQif2O0kYkirIKK2T_e3mn-RvogKW8JxJctFax0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyn6-F3M11wQ4Sl7DxD7eXleFW9Hho72kHAWz8GbtA0hw&oe=69B7FA5D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3e59SGTGrEQ7kNvwF6VSBn&_nc_oc=AdmWOuCfwleQKzEeXHin-QAbg3X0BcIJmYhL3Weo6qCVIjHr4M3vueuN44tJcf4RGbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfweT1qNjB8j4Fjqu6NWBxWJRPxoRvFF2eVFEOHfdM-FXA&oe=69B7EA16"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNO0HI9esTwQ7kNvwFHEr2Q&_nc_oc=Adklugw-eWcBRmgCTB2WyXjKlQNUu8lo9EN-0orPSGu_qw705PZ_TSVIv00tEixjjiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUIBg6qK5yR95iGoqIEKm_Hb60t1vj3XInbbVPpj3Dkg&oe=69B7E8A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jsoUcrmsxQQ7kNvwFDKmZf&_nc_oc=AdnGx-_j0Esd0-Ur2zp_gofHJ9B97fIC9_G_hBd6zHvbaxeGKZAZcRY6zjSFexbRRWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMqlqnQqLP6JmIL7-yG-2jqLeCR_sy-XvEeYDNo4wr_Q&oe=69B80824"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
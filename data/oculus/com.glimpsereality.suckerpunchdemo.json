gYaHGKWhnU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftM7ATmBkBIrM8OWCK3IVgE4TzbZ9zzvAkcHzV07XOZgQ&oe=69A433DD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEhTwI-_n04Q7kNvwFCD1zM&_nc_oc=AdkC49d-P7lO182rZdMOV9tD5ldhDvWJS-5khjTZ9v1UaeWCnEowVXQThVjJalMtJ10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftdIAHfGV47r5tEnmHJnhEfv6dDNKkn8qvFUNsywycqZw&oe=69A42396"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt5grlonRtgQ7kNvwFoukS9&_nc_oc=AdnAXHzrPM4owf_uANt-IxswkTxs6m0OHfhO6_B5zdYPWo8cA5aD5Wm38MO5rUlxv0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsctXdGKWGxpZRt-a1Kl9P67llsDkghUmNZ0byuoGowgg&oe=69A42225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYX75sIf9-UQ7kNvwFyHAsT&_nc_oc=AdnjHp5J69tXgj0IrkL8_wRRtj8_eAKd4wNdWPjrma2U7E4AXfJDOlSXEq86GmxOAUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs85-IqrcoaHt2RlDXoaguTri8FNGmw0v8M4cQi-FqF4Q&oe=69A441A4"}, "display_name": "Sucker Punch VR - Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sunker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1216715385525433"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "495350395350398"}]}, "baseline_offe
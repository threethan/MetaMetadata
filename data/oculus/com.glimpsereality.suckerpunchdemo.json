8yJRJ5uGDu0__h_79lvpLMA1uckU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mxlzsULJ4xZcIRazFwkEv9S4hD6KOqukU2VOH1mqm2Q&oe=69E75AC8"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUG-6u_pFaEQ7kNvwHYLrz_&_nc_oc=AdoN0kzsC-ysG4SxDNRMrIQG1_n1lj-9EkhRIuol394KnehC3r6Fvoj3zzXpwIHpgWc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JA-521rPAduhZA5LRB6PExLqawj5A0i3iNzwMJbMejg&oe=69E7705D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BCtmFusd1EQ7kNvwHmNuJc&_nc_oc=AdpAMbJLZ_q4BGBDOF_XTif-FrHPnjjle504tuimDrunpcocLndqFMSo7lQuy_cWreU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qPJ_xc8kTGm2EVe4nRijFbyseEw__UHoaTfziuVR46w&oe=69E76016"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLUADtQhjPUQ7kNvwGM_t-F&_nc_oc=AdrEYWxZh9xhXU-zo7hIX_d_LUF0VZ0VK4pHHASQ8A2JySp5M3d827kf3K7EsG-dLPo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-HdXlF79syK54Fv5-3Tud9a9EW7RMxAMyTnzg6pvKlg&oe=69E75EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knt2LDA821MQ7kNvwFfS7M8&_nc_oc=Adp7xaBCCQo3QeRdu_A9HOaFQMVNoQR6am3xWE0HiXV6Greov1aV5xPknp9LtUTih0A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kZQDQLjuoeFGk2-BHrvjTnDUhbq4UQJTY2u8anGT4UQ&oe=69E77E24"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
j-0f8G7nhi2jJmqK0AedzZ9OZOxQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn7Tilno8T-0ef40s7RAzD2mj6OSbPO3FR75MLwtlmQg&oe=6AEC9C08"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca-ireR49w4Q7kNvwGSbQre&_nc_oc=Ado_0i1cfmDzrmAFU92-9kEz6yzsrEGpl2qaCBYVd_UVBQtgXfvUemj8VvE5KXFYxJk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2jxdpa2YUHjF7aJg1i19V0xncv1nvme8Avp6ZlyBjZw&oe=6AECB19D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riV_MW444lYQ7kNvwEbXxGc&_nc_oc=AdpbNSE3dq9a1V6Jwlv-O6rDHrpgYIbgmLI_loOs_rfyJC8JsleV39P91JvMK1GjIYo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6XejaNogFBjiOE2jRR5dXIh7d2Xo34iqp65guWJZkuA&oe=6AECA156"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUglcGO2C68Q7kNvwGlM-7F&_nc_oc=AdqEvsle-7OamQmvKQNgaFOcYxuZeD__mGNGe5UCSL3WSF2ZgxO1jkvU0v1RRiCJnGU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtggCOKfh_wrBY9qGh97dFLQSWklLudaaYmOYGQv5VSg&oe=6AEC9FE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XQwvHsDotoQ7kNvwFOae09&_nc_oc=Adph-JUbTC5bixfgx-qgnO4XN_WACIyEjfAAPPq2JYg3F-TQUBGspqkNB3QoX7o8icA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd9SZvhz52g6kQ7I4JlAck7uJwYibE15UL-Ml1IRwlhQ&oe=6AEC8724"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
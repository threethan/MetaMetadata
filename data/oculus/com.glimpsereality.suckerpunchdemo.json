}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK0H-4P2Qq8Q7kNvwFtc8OG&_nc_oc=AdrWI5-DxEg7zZXxwBDdnDBOPPTI5OBOU_3Ei9nHVmxb8XOlIkQfH-25Q6nx9fIAVfo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j3IY-yFh7sE0IWX7X9wqRJ-stfQFkXPbMpwYYdeMkJg&oe=6A21725D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw9v5EEUDQsQ7kNvwGeYmmV&_nc_oc=AdqDbIACoHKyrbBfDBd8FbnpRBfnt-VYtb8CSORVgi3dZCg7N8g8WMgRmBWRF93vqlo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0fvIW6BqS3CTXluk-5XWoEmVQVGqM_S9Lk-bVt3ATwQ&oe=6A219A56"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_fbO4t2CisQ7kNvwHAblnb&_nc_oc=Adp3l0Nxu3ySlALaoIuKsAV_U3gmaazuBnHPRnOtla06kACZn_19HK4xqJcBuSud3eg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xm9_p2qNu3dLh9bbXmiUFVir0mAdtgk73WYezb-WFeQ&oe=6A2198E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awnkiiHsYb8Q7kNvwHil4KW&_nc_oc=Adruyc2yDRVVhR7dTD-kFLUF0edJWAHjFI1UnjLIlxzCMoGA6EDwIcPsGEt4S0WPd6Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xtrD0vJFKAvN3xoV3-jfbh8_klruXgXa9Pjj18BnT0Q&oe=6A218024"}, "display_name": "Sucker Punch VR - Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sunker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
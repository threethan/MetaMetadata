ChEOVQ5H_LuielQo9u8r-mDi86Q0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIDUR2m8XT0Dbu4tUwfp94AFdEnQ_1Ncmo-78yJI_65g&oe=6AD23E08"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dwapfp3PhfEQ7kNvwF073PW&_nc_oc=AdqruM3269gXTzmh5Y_GA0Z3oyVop6rqG95jHYHsSSWIGmyrncSWmr5kZRwjMkGK8Nc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMo7WYsekSI69V7wNqwwYortgUYy4ZXFKZbyoD2-r3mw&oe=6AD2539D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8hjlncz9n4Q7kNvwG1xixy&_nc_oc=AdoC9k9MvFo2Ml9Wli8seDGpbYOPW0Osdtxq6-Dczwx7wVyvn7mhQopj7J2S9AzJJWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0HpIJfFgzh55RbzX6MKmlq13Tssel23YBeLM7xYEdmQ&oe=6AD24356"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piTjBDGh74sQ7kNvwFSr6NT&_nc_oc=AdrAJG7xKNIwRF1nMBRTRSxijZm5mTGBngrtGpHW94nOqaEYoCc7kSSwqKWz70T_lYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt97hwpPojywD87W_txYkCeb1Cjxe_n6ydP-2rBEsjKQ&oe=6AD241E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as6Ga3qwaXkQ7kNvwE9R2FJ&_nc_oc=AdpoS1nmpJxhKAeNG6EK3eLaekoJvMsT9wg7TjkeRQxKWTPev6tXnAOkhEWXhV1kBw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5iY1oHl6TNUm7u12cbSbxwt2GuSzBoq0tGh45acbdFw&oe=6AD22924"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
w3EZMpZvKG-pZ5PfbJoZi7g&oe=69A029C8"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxKB7o1JxPcQ7kNvwHNU1xO&_nc_oc=Adnmwah7fKCzmHWRLoZB0J858j2NMkhYY4mxqv4tsmxZTAjG4fH_4RNzs-5ngbLX2Vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtBZRfjYy6eqy6RZ7daq9l4MVzegSnxevrBtSYkGH1Pg&oe=69A03F5D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPD0fEXr1RsQ7kNvwFg9BDj&_nc_oc=AdmvCrmWEEYxRpD8_qDYSpKYzlW5Ks6sFV19f3RMHckk-nGK-7okeny9rOF0z5iYMKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJvp4TM3PTl12TaDfuneVqke5P_ZPK_G0u3_3tj_QUlw&oe=69A02F16"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3QGGHNR8TcQ7kNvwEjmRjo&_nc_oc=AdmqWNQ4hsddMl2GjhBubYKPqkVSBYuGFjaTIgqtiK86KFgIXhs4kqFZxJUsDOvLV48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuP6sxTvxUp964WDwrTfC7VOGGeCsz1EKrumMFYG-5dIw&oe=69A02DA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojsv3S7E0c0Q7kNvwEYHJ1v&_nc_oc=AdkB-TXMIUDhtycPkgct5PYteTu0Qc5vh8ccEaQGFdkqne2od0jIX9D0bntajOFsRmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuz-Jo_IZOiaP0UUPZuVj6s2NWL4uevQmOSy_qLNxHE9g&oe=69A04D24"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
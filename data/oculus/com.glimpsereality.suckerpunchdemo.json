QVQ0Yn9Y_wLbiH9OeHvpLXRb1wZk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEckxbEhSxUc7mla0jHnTJx2UuASbtOdoGrB-WCY3FYtA&oe=6A940F48"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgBX-UlJ4JcQ7kNvwFTzeKs&_nc_oc=AdrU4nF8l52afkIJc_MrRVWySluVEaGHFAXJABEkN4EWSx4wp83Wl9nW5E4SgbcYYZ4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBWzGUFCyn8jtLTymkpmvAgFHeu_JV2uDPIG8x0TZkBA&oe=6A9424DD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spIlBSzz5GUQ7kNvwE4W-sp&_nc_oc=Adrxzv6bLIMzgzFnHX0y_wmxezi9MSOvPUyFW7LBSkk2GLBLSVt2GFzcJzxmTCIXpfA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJhn_rfVyFB7eqa9csI4VnpoPz7kLEU5MVBdB6lnCa_A&oe=6A941496"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko334mRc_8UQ7kNvwHh0IEJ&_nc_oc=Adouy9qq36GOsrAkiY6j-U0OPjAwQj81I0FMG-YgDtKQoqRFATcz1_BGkVPZF7468PI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAgb4FRM2yNj9616NJ56EKWou-x9DLL0rF1DC6jVEVwQ&oe=6A941325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Oxvln_1NzcQ7kNvwGr3hqj&_nc_oc=AdpT0r8XRKFsmxtdecM7DCslGQEL5q58k0hdr3w9b9u2EsvGFhZWMgYAQe8wzxMOlCU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEODidqXoVcNR5oAQNpCORnicJ3fEKA6m7eLrerpwwiXg&oe=6A9432A4"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
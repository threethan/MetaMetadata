B-BJdsNkqhQaV0j1TRsLdtSovlFI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VV9SAfoiDdYQM4ySNUXJ3jNmJiI93OMyKA8do8cFUzg&oe=69E64188"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUG-6u_pFaEQ7kNvwEfg2Vv&_nc_oc=AdrFWj7LhN4Ya9U3a4jd_4Kv5XxxXZu0XSAUpT1rWVHJL316rIv_QlKHpnudnNJGECc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33phSFRtgspeiRex5InHRZMd7qXMtMmpK8VgTeXJPL7w&oe=69E61EDD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wICUYkO8kB0Q7kNvwEYjJKg&_nc_oc=AdpesAFhhswPU87OcmZfzXgIIeUhRDmZ9SN2M6HVWuFnu8JNGE5H3EL5r-LoBUEE7xk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vViAR4arF8j4a3hLdJlQqEK3x_oWmtnXwwS_qEFT0_g&oe=69E60E96"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLUADtQhjPUQ7kNvwGuYede&_nc_oc=AdowyGU-3zLjuEt-M5_TkigW66BgMJHNhPc59vI2WRojxjHDEmC3m7sPkp9sK3PKFEg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VXOnYGeKF52p1F_svYSAzshrmqcyyubV55CdTd6y5fg&oe=69E60D25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knt2LDA821MQ7kNvwF4yTpa&_nc_oc=Adqk1Oq1VCkj8Y4Vs5SFnFhsJ28TuAYZPZJCl7FZ8aL6RcP_Tv6RoRNQ16mytM9NCM4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pU_iGHKFXGIPXJotamipzvwKDI0uPzuzhIuzYbfT0Tg&oe=69E62CA4"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
EtZLTl7cDQDvIVG6eOkk7bzh9C2iQR2qE4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaPymQcc3rZBCSum635OygrNyTfyoAAuYF5SVdIuci6g&oe=6A7DA5C8"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTRJKrcCKvIQ7kNvwGFqjkb&_nc_oc=Adq4xGgmfxRk4LnP8vPzl3kexZt3Bzo-ho5TW_I6TW08np1lviOyGaGPRjSnIvN9I6Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAUQFVA2-boSe7YNxyr2BxFempi1h2gvcL1q16bAZ8yA&oe=6A7DBB5D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoAK-p46RGsQ7kNvwGhNprK&_nc_oc=Ado63Q0drYgH8yGWXnHI8-S5mZq_NRoMwjA0fIaX9Azsle-7zEu3NOp2lHUpcBS_pS8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbAj7Z53OJBfGrfzhfjSjWAB6oL8RYr3z0z_af0UuGzA&oe=6A7DAB16"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z_wKEXtNBQQ7kNvwGoUWDg&_nc_oc=AdpoU-Ia-bvPJ7fhziFW2eB876jFIIoB8CtCgY7lj5dYKwfksj4aSOz67qJ9JBLXvs8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3mHtpVNnhhw5zq7I3hRa1wa-hMm-uSOluQDdidkHdyQ&oe=6A7DA9A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQGgUf4WA90Q7kNvwFGKkVJ&_nc_oc=AdoJMCNjs8G063grjZiZkaBU39FQ4QJRtFEAccOS1y1idy333AaoK3qxw_9VN61Km_s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIQShi0xpioOVg-qMKFIOy7_lpK0fVD_Vg8YWLxc28mA&oe=6A7DC924"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_
p8CQEcfJVVD2QznX3mrc1uzJf8pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWrH_L8MXO5yX2_D-4axJreEa10a9N77Tur0svQfx6ew&oe=6ADE1B88"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_htXRznmx9AQ7kNvwGsregh&_nc_oc=AdqfU1_4LoW_fENYO-1BIKQKvQr_GJIAUOWmB7wu7oplfMM8Epjq_AC4MAGR053o35c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqLTtHZ23y9-ErNolJeUcttgz_UsOnyLIw6csOnCZM1g&oe=6ADDF8DD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4goobMv2axYQ7kNvwExXEiR&_nc_oc=Adp6ly0xHSiKZBExg_vGlo41CcY1WQVJ1wGqjIwmjoEmE0NaSEMHMVcXzbse42sgFEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYHR6YENh_aJ1WL6-yzaXfKSH0Z5otaPtwH8XFKILHQQ&oe=6ADE20D6"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RRELMNloL4Q7kNvwH07663&_nc_oc=Adr_s7v84Msn2omJibMQJiMKhUIik5mLlXTO0xXTqvOZ-Pfw1s5tR_aQLZ1cDrfkpEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsQba8dK57yIxQBeeb70ulkukZ1W32SMqzbD5klavXIA&oe=6ADE1F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-I0_pTGAekQ7kNvwFBSg9s&_nc_oc=Adp3oH37vripmKVb_D23N-YitTeWHpHs16nan6FpD4rnQ3LZWZmrvLCXAmWVF8tZU8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKAW4M_XBRaVEnbPZabFOv1PVd-qN0IGv9XAnlQCYfaw&oe=6ADE06A4"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
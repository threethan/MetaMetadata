kT-4WstJ0PudrOKpoE63Khe7OJjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA7wOuSbuaYNYokgNPQMRCCU6E3Z8dP7dw_Ly450lJhw&oe=6A54FF88"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ_eBI9DOvcQ7kNvwFwy5Fe&_nc_oc=AdrGIFHd4atquiTTUG7wD0Gpsxdt4dK7-3lSdFOzxOYrByfCXdQFCqvNWtMC-8_Ue4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR1LBxwebXJaAQOLu7Dg0gudty8jOBMKaRFtAS-d27wQ&oe=6A54DCDD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ-ALvDWBBoQ7kNvwGzWgOw&_nc_oc=AdoLl8cAx-BOsOk-T2kpNU4hHQNJmpSK8gSa12FIN7E5kt6kg53r2Bwu1YNVtBWTqGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZj8OdzElSG-ywWBA_AQmy3RpIDjdUjgWrLCnNTv8IcA&oe=6A5504D6"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHIIhzo_nLwQ7kNvwGHIWxw&_nc_oc=Adqz8MEkib5ekHrrgvUkANDgbPYqJ0pwwP2_qUnLSNI0nv37yToCIOGz6YvmzHGRBBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcXfekvraRvvHJGRVav-hgNmpd6ptb8DXK3duf-1uavg&oe=6A550365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOH3nBwCf2MQ7kNvwGl9_-D&_nc_oc=AdoRfl_JTONFQ-I6SDEBPX84S1mqIqvjKJSSYI7NjzaWZUAnJ_q1_6SfKfd1Fzf0Hks&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4g8bZFCd1UB1oBobmjpzxGF3MHWAiYyNG_dHbiYQHNA&oe=6A54EAA4"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
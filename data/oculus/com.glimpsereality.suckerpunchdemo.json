5eUV_v1lhEVHTCW74LV7rkn-eE1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZkfU37g80Fvyy95kHLq2or1wlu60B6K1J63KJ89jIiw&oe=69FA0808"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J64dWB2H5oEQ7kNvwFOKJ6V&_nc_oc=AdrL5NupGfV8PyvnBf2K5dN0RJFYroSUc2KscRu6zgjTFzDs9s-lbvu9rxyX2tjCWeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C29UCn3_HjfQdea6CkXxQNMdXHdEMtjIemmYXS7YqLQ&oe=69F9E55D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWrM9DnlVEkQ7kNvwFtQnFK&_nc_oc=AdqCAWix6HQ8yBWPU_E9TU-p9x4wWTGi-S5SCJAeZ49U5RmvwCu2dqFrqRhVPXiJCgo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7siTLtwrbeeurF5QTgzfzLK5nI9p-EfslQV9AKpbHOJA&oe=69FA0D56"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvsBopL0DtQQ7kNvwEBk2w6&_nc_oc=Ados0egLDz3LU2effbXBGWAntNzRrMD62p3uiPd9CCefqCBEbaWW4rN6jAV6t7Y495A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NkoztwHdV0KXOuf1vHoBVwm0Us3ieg1M8K0tBUu0wzg&oe=69FA0BE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEOFcsIg8UUQ7kNvwFU2eSr&_nc_oc=AdrE5oX3Huv0uIsykA2E0ClvR5yNEfISijbv-oc15Uy7KRl4217FARra5zHOG1wRPGc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oiGBgANark0KQeH-kTFFZamUj5KOK7uEaCOijb_92_A&oe=69F9F324"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
04cG00mjQw57OtXzTenPB9ijWEi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ewplt2Wy069ebxg_dNZh11vrJ4-XsisyDDBTD1nk1mA&oe=6A15B788"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-56ue-NM7nEQ7kNvwHxNdz4&_nc_oc=AdryX94fwoctK7WsyhhOjrnRcJ0H6u2NEnuBGB38BBZBmhWHjGSmL7ROJEPJ-3kM1PA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZDWVYxOByKEZ2th7vjnpCQeebNi-NxEPs2X0fVh-6Og&oe=6A1594DD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQEjW8wWLWcQ7kNvwFB05h2&_nc_oc=AdriB_abHZ5gY5mOiBjRN9ghXU_LlTznNQoYDAh75CR5Tj2sqTp-SjpeAGu2quODKRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OIixAAWHACJd6lbgEsMmArUN3YJWKRRuWYOF0C0EPfw&oe=6A15BCD6"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rWB3CwMl28Q7kNvwG-J1tH&_nc_oc=AdpHYH-RGwXGny2vGiR4r4t8UQUe3JWKHMTNsR1MrpJgsd8fYEedrkXgKC33w0kMV9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GCtVCDnQunLewwtbfpSR6_GsRV-t4BJIMq3cpAq_xpg&oe=6A15BB65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mixlywDceAQ7kNvwEAfgB0&_nc_oc=AdqKLbSwcCC4RcOQdMJQs8OiO1WA924DyiY_OVTNS7iaeSsfCxFa_LxKM0uju7pzypE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LuEE-bVFMu3Zl55oLf6gXPT0DPMKqB_LGZqD3zRvUSg&oe=6A15A2A4"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
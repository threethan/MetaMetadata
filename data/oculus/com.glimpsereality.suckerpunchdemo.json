_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBj4zgbz7caj2uTeTqHtAfuXh8JgEtl3wi-hK78YzMqA&oe=69C11F48"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMM0iXIhw-wQ7kNvwHiI3ZO&_nc_oc=Adq7UgStFUA37dm7tbbOegRuVRP_30lOdit9AXsULGVGLjuwQM-LazB25dvUntd_4rA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYv0tB0DbpJfFJoVV2-t2_T1mNGwnB8_NwPwQgG8Q04A&oe=69C134DD"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7t2Wma8t7gQ7kNvwGDHODU&_nc_oc=AdpipnK8oUxnPUeOvV9P50Im6Bfg7dBukTl4iIqMdFnvdonvoms_PW4qL2GpMHEPLHo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyCbWI5YlSewV_RjI5DDFgUVGuHSu8t1bWFuvqhMFaFg&oe=69C12496"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu8QVXqxnwwQ7kNvwGr1fJA&_nc_oc=AdpjB9d0QD44DWzIJHosZ4AgxkBSswXHzA3rEij3NakV-2ZVcdDgVdo7XNoNf5KMRDg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7Kpv47PkAAdUXUKMKnQ_DovVQ1TdFLvsEyqjOsQdfiA&oe=69C12325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8TgqGYf9_oQ7kNvwHDH9Am&_nc_oc=Adr83vhoBguFa7ohTuJp7hJtDIDpo9ouRE8JKEvcGOKiv8XhRSXGJVxbe7_8ANM4cbA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgF-GZiaw7vTeFbaWTXYm20RJcuEqEmkDH3CqWQJaBOA&oe=69C142A4"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
7HMyTvZbLkMNzq-Si1e-bslfBB3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzYM5TjWxHURqCCl4Yuh5fGdO4REvE1UQC2NUx7kNwIA&oe=69CCFCC8"}, {"file_name": "SSD_3.png", "id": "3051080451772344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974671_3051080455105677_4603791397004981886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQjhlMInHwcQ7kNvwHsIdXP&_nc_oc=AdrSjvgW3EIXxqH4YgzT0sNXzRW0uuWcDPL_Tf4BlutaTpriqBqVvWtj3xQVCd0w7ZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIYHJJnVJSAPP3TZseR17mfcpH2VCQeonxHba9osOPbg&oe=69CD125D"}, {"file_name": "SSD_4.png", "id": "409010397620138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974874_409010400953471_6320605527484466823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRy4bc-IS0EQ7kNvwExstk5&_nc_oc=AdoX5hRzIwmwbfRYqFWPgupa12BEPN9M6caHUm2DU0B5VwaeCuR-a2hp_vKLFik3e2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1oQgpjAGnEdAOjAZ4CwH_3pH7Y00mQKoqXxlz3rTsxA&oe=69CD0216"}, {"file_name": "SSD_5.png", "id": "250381913858534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_250381917191867_4031333320144728339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDM6R1AzSvsQ7kNvwFtyTro&_nc_oc=AdpGAP7jMv8uITRq7s-Hs87vPbIdKBCK1_s9uasm0VgFn7nyDYVxNw5SSMlQ9nnUPRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-VZ11qAi6T7QC77nGrjW9_UOgv3XjGvuqPziQiGWlYg&oe=69CD00A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunchDemo_TrailerCover.png", "id": "1303058460211254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_1303058463544587_31116198519094646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KldJIoIseYgQ7kNvwFe5z-C&_nc_oc=AdoT5NtTQcKnPnBHUhq4aLpGhThbCGp-W74hq3sGKhnz0WvKlKTXZ63cPbc4I48sMhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZfnLyuefG-hAgWGFp1gpw10W4KOM4I1W496v_HfkhTw&oe=69CD2024"}, "display_name": "Sucker Punch VR Demo", "keywords": [], "long_description": "Sucker Punch VR - Demo is a taste of the full game Sucker Punch VR, which is a heart-pounding single and multiplayer experience!\n\nFull game available here: https://www.oculus.com/experiences/quest/4283216598381414/\n\nBattle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Like Pong, in VR, on Steroids, with Superpowers! Sucker Punch VR is a fast-paced arcade punch-fest! Go head-to-head wielding a variety of powers, to punch, parry, and strike your way to victory! Score cubes past your opponent while preventing cubes from getting past you. Easy.....right?\n\nSucker Punch VR: Demo gives you free access to experience a taste of the action you can expect in the full Sucker Punch VR game.\nAvailable here: https://www.oculus.com/experiences/quest/4283216598381414/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/eula", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app
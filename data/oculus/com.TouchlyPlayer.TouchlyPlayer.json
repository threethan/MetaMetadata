x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=900neWxGcEUQ7kNvwH9OFmq&_nc_oc=AdqIvLIeXfubOpYNL_elXRX_uMohuAWVy2r76xXYHbfBufmMR4-eRiK70JSOd_ZyZeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQCklhZmhVbKD9R4B-sNgSjK_6lDooO8u2Ne4juocxgg&oe=6A6CB36A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlaxKFm--jMQ7kNvwFVpXSf&_nc_oc=Adr_UX5Dfuerl_RvvBjifkx9w0p5z1ePXN5lmTN-lUa12AYWnwQ5FD_AILs1R5sKXts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8PSixLgKgDt7SyOiIMKtb3NlfC1xeMS6Sxig7wfN96A&oe=6A6C9588"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrsiKJePksEQ7kNvwGP83jO&_nc_oc=AdoBd0uGs7sKbdD05M-2lt2oPRaNGhdkLF_JvLv-GX8ud0UrnRUoKjne2WqacybGOQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQJArNa2b9LiXY72DdGVWiSyEVEPB1-_dlGzkSlPdtzQ&oe=6A6CAEA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3z1nNngLOgQ7kNvwE-HIz4&_nc_oc=AdrpdyUM-BLyRNpTfA6Yy0ZK4ZtVYjHrIyPeRLqwhaOH7PjaTxU0cpZWb6FOIkSTzJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAIMVnmV6Se4POio6xJaRl5pqw1Ftni4QzMWFkBm-xrA&oe=6A6CA573"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrLpwev0n_AQ7kNvwEaqXam&_nc_oc=AdpS-rjI6CnBcFuNW4uMRta7IyRnHRDzA1W84-o_uC0YY3jqW0HMqjbJqFgDV_IoU7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlVxzDYtzwEVYwaHbZiyRCcSuU6sVzrisXiRwPBbI98A&oe=6A6CB8EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFXM5CkkQ2wQ7kNvwEwCmzb&_nc_oc=AdqBkgR30beBMbv-Y1fBBDyezfXqGVW4PYlZO2pBDVwqP4VRK6lko9WqAVtsUqEI3ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBo8ufyidlm92Z1i7zJcnhkWS-1ySkNqFhInaamWGkqw&oe=6A6CB37D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnu0IMUaoLsQ7kNvwHFbDW_&_nc_oc=AdoPX2wkMkKdSLtnsSrK2BUV4g4GP5LsNPwwOeUcStkXx-DU2MQP51jyxjC81nuj8do&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNTvlaUc2CKVVdSbTcQKYLNIulfmTBKr6HYO77NXikbw&oe=6A6CA4E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrIwy3NIMwIQ7kNvwGyEHUj&_nc_oc=AdpWUB4bRHXyQ2Psk6WM6CeZ7b1CcMTyvCBHrpOiG5cxOXBCQEyAmV
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFSnCdwBUSAQ7kNvwFpEuhx&_nc_oc=AdrVLL0Zze_pqUWYiZ2M1_zLnxXdvBPxwRnedd6fl1mr0krlj3yWWrtJChj1VNoTmxg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjs_Yx1tWfTobIOkpnSI1jTAolnm0jccsF0kTCeRriIA&oe=6A882AAA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeVyZj61NSMQ7kNvwGgg-Hm&_nc_oc=AdoL5g8athctSdkEa325H-Z0LTMpgG7N9A_Scs48opcA11fnF1N2KxTlT98Vl5vsFq0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-8JNKfVNIXAZoIoFykyqkoM59XS6-0Wn5Rj3C3SwnUg&oe=6A884508"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25YR-R9zBsIQ7kNvwF2JhxE&_nc_oc=AdqfrnBTKVmW8gTdfRbYIk0HmC9XkpAL5_IfwUO8hV1V2lKnd1mlf0BsRmrHslW2HXg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0LMzScVDwgSIoOshFmk8YyzYyxstoMdIdBXbzKjXvdg&oe=6A8825E2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih8KSiVbUDYQ7kNvwGcSzsj&_nc_oc=Ado9B7EWfaPQO4dOBoxsdvYORRWBf--iaqT8TGKrjGyCSWEQzyMk_kjAI1vtSAowFcw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKdk2WoNTk9tI3OVU1cy3e2Gnr9CA10k1cEPMBYg7BmQ&oe=6A881CB3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkhMMib23eQQ7kNvwG1Jd5p&_nc_oc=Adqv1r2TtamkyiAdfEvMFOBmkD9JuYKu5k7PUY2jryR-ObYxTDsyiYu1amTrs6DlYBs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7vWUhW7_tkY9G24F83f3LDpIx9MQqTMWJz3OC7t5oNw&oe=6A88302B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL1GbQI6X28Q7kNvwEbvnVp&_nc_oc=Adp6uxdC8JUyoW1XgkE1Kkmd5NAoPtn89GrZroicQZtmWaVukAEFYNod9Kgs6IGFZ10&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMKWpUpZI1xhQQmt4daP97DMBpbdwBmtiZGdqExPNj-w&oe=6A882ABD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwcdalIBcQgQ7kNvwGr61v3&_nc_oc=AdpXwUg9yPQ6wEt9y7S5TgZvn20WmseG76Jw_Tbe4FK312QvH7oUErjM_SS0xe_K_BM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2HH8SntPGeiF1BWN4fXqVEjrBG251vXX6Jl3IxLzvgg&oe=6A885467"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZ7ZfloF-f8Q7kNvwHKBsrk&_nc_oc=AdoPldcVcFuus-DwOBUd3Wl8zuiTQMchR5bebTOWSZhZl2ph1speS9
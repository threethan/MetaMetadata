x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgod6x7itBAQ7kNvwHMRlON&_nc_oc=AdqbcMW7pZpZ7kYRN2SbmAEukBHOcSRRa6PK2OJDp49XD3ho0HuHB5IN9vrZUz19k3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUhLCBrI9D-No8iu95L6GGkUcw4YDCeygzJza6s2zalA&oe=6A9013AA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8MAejNk8bUQ7kNvwGg_cVZ&_nc_oc=AdqLZsoKA9c1aF0VRbks0V3GVTZ-SURlrFHF3v5TVRLKLhqfbfG7ljUmsNFLfwJbZqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgvRSr24gUmvOnRASU8jtneEN_6oFx46bEwCNniZduEQ&oe=6A902E08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgEPRjmYQPsQ7kNvwEJ8XPS&_nc_oc=AdpLQFMXdY5rHJhmE12nmMRgGAKfY1wcFI6Kpew7Iy3IOBeFSqyPr46_kRiIialjeAo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgYjRsWdL1vLmkz6y98SCqRborfSdWtEaZ7H-FCSkrhg&oe=6A900EE2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bK7a_sff0x0Q7kNvwHi69L5&_nc_oc=Adr3Ua1Ovo4WWLGvZszwc8gJ_oFZb-_Ea1JQu-y-MqjYGevsjjM6VMkEEscB6yvlZpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQNOc-jOV_3LvL2OO7rzvQFXi2p4OIGj05EqEgEbCTxw&oe=6A903DF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP-Zsv54WFoQ7kNvwGXIhcS&_nc_oc=AdoGszaMD3OfvzxvS27otYA9NrSYUU8Dghgn_xcqmno1O09qFC0UqiOLJPeU2_5gdls&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECG6Oc_6gGnysRfYw1JzoLwlP-TlHClfe6AQWpEMxVMw&oe=6A90192B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-p6ciAfglgcQ7kNvwHOmEiw&_nc_oc=Adok7BcxB-fTZIQ36mvlEIS8Bs3TB12R_bUqu1vSiPuc3hA-M0XuMmOZeN1yZbgBRXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoDCDTdhPPreKBtnkrwRA_U9YsLjLB6SplIZaEEtxNbQ&oe=6A9013BD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlgHTW2_rUAQ7kNvwGm_NMH&_nc_oc=Adpn4JAVEEzNnmmj0V5c-Vs3zu34JgvXMQn5CfJI9iLktgAFKFz-8jSGCeEjLTG0CGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTx6b1a3S5Pq6yPMFJbw3b2NbxkhP2wTRp_WyqtWEenA&oe=6A903D67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY9Kal8qAl0Q7kNvwENMNyL&_nc_oc=AdoLoazwjVYB7sfr4bqqeRPLDqQoLMMKzaM8uzEYQ90yUdCHW2Le8c
_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTQlV2CMkJ8Q7kNvwHZJHqT&_nc_oc=Adpo5xg96ZS0G6USWyP4nArpSkVRABUKwNGfLvBj1zY6XrPki07j86e3lkMa235JLeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Fw0U41mu4PBCke2Z0iUx9l3joCwR7B8D6A_zgS20s0A&oe=69F0C66A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SycwFoSoh0Q7kNvwEgbL07&_nc_oc=AdpC7mddKR84QCmKc66AYqX1OGq9XAiHV8dIRPYj2TnoW2tc-gzg29aLQZCVbez03ek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3UVC8TjZMe6nPZWY3yAF8NacdCztYZOQQ3RzS8xasw4w&oe=69F0A888"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxgZuptCmaQQ7kNvwEMHdYM&_nc_oc=AdpIG6iwGwGdEzy9W9vPsZ53CTt7hgBJcQGHN7ZU4kQd2yYrqsPHNEZyMr_CkqQ8-v8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1H5AoAeYmEhBIHuZo_bHnaCPIy0dxeqtOnzv6nug7_SQ&oe=69F0C1A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTUALbgkV84Q7kNvwHq2-Cd&_nc_oc=AdrxcB1oq9U2nFDUW8Ja5f-ZyPZiKypHIZuOhUqXrGp1YfnfaRsZLl7nOL6uJq4DnJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2M0sbbKirDrw5V7q05IgW2pSioRlvWyh41axU-huZGtA&oe=69F0B873"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAm0o8K7fHEQ7kNvwHRx-SO&_nc_oc=Adr9AS1qS1UkVCqdMAY7StRJCweFkCSAdBDRR99dUD6JiOtSk0OxV5BTffiYShjqsrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0lp6J-dAfMX6rAzjOqH_6vlSMJDKwHbjxnXJtftGYX9w&oe=69F0CBEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX9MJFWUPZkQ7kNvwGp8Ob-&_nc_oc=AdqcB2yrNPTUA7SRA0SWlqh3lTF-TVWF3ib4VMW4srpuX5RkrZ_um7PKna6k3Mva4d4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af08s5q4YeUNl_ecKfO6P4ZlwDg5BRwYPxxhRubB2NWQ6A&oe=69F0C67D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87q-fJOBM_UQ7kNvwH5opV_&_nc_oc=AdqfrxFtOc4srGQO66zJKoqYZ-IQXY3re0fRcBh4Xqq6FckWqHWUQDdJsB7Tq3g09uo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1dRJrNG66PmbO75PPMEMVe6WWB3N-cIexBVCYocLJToA&oe=69F0B7E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uZ294pAYHUQ7kNvwHZHLll&_nc_oc=AdpglfsDW3e6_NxttlQDOXgjbq6-MYYmcxjWYMVsz7AGII4jYwvhhRLHkniP3oc5qvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2KrbVvhwZBAB-IURQUJu6DO_Qv1qQe1oFzWggn1-tI_Q&oe=69F0BACE"}, "is_concept": false, "is_tes
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7vybLT89EsQ7kNvwHDbwS8&_nc_oc=AdqP_3hAn3Td-dfmnDavcdk_oNJNbgmMq1mJNpUz0WT0wLuS3NRGPP44g6klWyd97CY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAOdZ-Yt3aDVMPMuk1ruXngM48t8C8MPBxlzfCTStS2g&oe=6A8ACDAA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfCW7CesULAQ7kNvwE162ZF&_nc_oc=Adp37NGThEt96ldEg7G_0lW8C1Eli6eQ1NsrW_TF_1mweh5Rknn3MKgH-lAJwbqpgzo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOzZtcmTRstI_9kTwODfMy31W9A3Q0rrUPWvacCry4dQ&oe=6A8AE808"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9nf3dNQpCUQ7kNvwHjYzDh&_nc_oc=AdqK5sWKxkV61gfsE7zOsVDVGgbwlfMAuKaHEd9Vsqz0G8WnfQxgt1sIVroEz3NSW3I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAEMa5vyMPRViUhQ03dFlfHDmul7SFxoezs2qk48rYIA&oe=6A8AC8E2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuRcj5BZwiIQ7kNvwE8EC5A&_nc_oc=AdpQKwLFf5joAnqxVmHgrkLfMozsH2W8V75NMP_H_Cvwy9Ex6vgcZE9Q4j6HzYMTs2I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-rbt4nKkTM0039mfrldTgAlVeDb7i55bAmnqHyPMaVQ&oe=6A8ABFB3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43aPPY_gRyMQ7kNvwEBnEIz&_nc_oc=AdrihYZRyHozL5igwltzIHKAc3SzNi0Y1I5qz8bejH-U__mCn3wBpuB9Tk8HT8mip3o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6PEN-b6V2v9G2uGOeUwPi5YFd9GPDFeEwF3Vk33g5Pg&oe=6A8AD32B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL1GbQI6X28Q7kNvwGRsofh&_nc_oc=AdqR0qoV2TbDkX0ZRfkNc2nmuFT2qD89I5ESDDZlgtFsXA45ldarbNq2LoDBD6I0r9c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxZg6LKZLMlnGJLO7XIYI254ow1YPxrj8rGwbDbLrMIA&oe=6A8ACDBD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwcdalIBcQgQ7kNvwE6ozw2&_nc_oc=AdqXgGt-Xt9tEi0EE18uhXVcex1SWZolr3Zm-0wJ46ZBr4CRr3n2yrdZ5T9rv-4J1os&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8YOpQ15rVZk_Bu1u1WAZuZ-yqNBtm8O8elil17bdDmQ&oe=6A8ABF27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mXKYp5YQG0Q7kNvwGonPKK&_nc_oc=AdokTnmpRjN3nHpl970n_i-Ig9v6Pz0NcJaXtGoBXmaYVrOvbLrd7f
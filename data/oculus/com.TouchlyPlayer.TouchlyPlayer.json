x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6unpUOOficQ7kNvwFvy6eq&_nc_oc=AdrUksceiKLcBT4NAhewrgchfTAR-Y-7mRfZZdZAHlHbADgrvhifezxbI5WO9sydWWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj9pJbQwNJVv5XnHCkNEqiAeykIp9zJEHiS5UH8-ZQhg&oe=6A82E4AA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XADG31d8QUwQ7kNvwGSqP3c&_nc_oc=Adq_o35AHcDXq7j3nNgmGpPa7Ri6vsy8cWZGuCeH5jfoPkL_hXnfDt-s_a6lqHwMsv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNXOup9ZVHUDuE4PZZK56G7VxlhgJ4hH9g_AcirByAjA&oe=6A82FF08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psKEPFRK6KsQ7kNvwEb-YLx&_nc_oc=Adq22iIKag7vBe_-XtZZ1O3AjApUePJtRqQshMQPiQXMfsJXW7leS-UB1h6Ian7-TYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF4RICHuL-uqa67THtJWW80-jmy1k1ZEWzLZXzQdnA1Q&oe=6A831822"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBKRSrwfx6kQ7kNvwEHmbI-&_nc_oc=Ado5gYtHoWyInVptFT3bWXDVA2N6tyuRrM1rpXSgFxGIjHBq7asYHOpsTmgKHKM5_CA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmJuju6bURGLXhEmvFkqN42nPMYHgNmJw25spCSThSGw&oe=6A830EF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyUK3bd1fXQQ7kNvwHoAF06&_nc_oc=Adq0scTBmOxZdgk8iChc1z3Mf1gow0-yUKxNYLzJpmilVyqDxSaFqzvf4QejLjzrGro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwKFflA3l-IWfpb4qt2kaY8p5yzeUmn8IqelUSN8DNbA&oe=6A82EA2B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXjbx73ZnzcQ7kNvwH4rF4x&_nc_oc=Adpl5vTEl1sm3LjIWse1yVoNDTUQ94vWtjrfjz-dyS-Zc5ep-Llwk0kLZb58Q8EJaZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqg8vIEUpVnRPATFggxbxTQIHn09f-s6XFQlb7F2dwBA&oe=6A82E4BD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4VOvd2tNXEQ7kNvwFMCepp&_nc_oc=AdpdmG4W8RBWCP6_qGJ_xWQkq0W18vjrHJMb3hC-Z0yyTvPwAZcCuYLXcvop5VGGjN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvdbKLPuNa-_cbrVVDmy3kf6-0LZ-Azn76SFKk7rA_dA&oe=6A830E67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqALCGKhZHUQ7kNvwGqNYNB&_nc_oc=Adrca2QQoO-ChMH8fBJyfxmq4WsA0v4RicTL9s_6wxAGrEq33zRQow
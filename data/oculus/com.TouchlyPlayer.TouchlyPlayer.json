x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCJTU7aPZ5gQ7kNvwExphDs&_nc_oc=AdqIDkP2p73E9JMqy_zv6AMGSRjPx16vLOhYQ6OvR5gw4Ld5YFdXNxvdeFK-U2d8zos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZXhpgrMRe8KU12CbduBQRdYmRdxIyZljSRuilL_tvfw&oe=6A033B6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oN4j2YjM44Q7kNvwF_Z68s&_nc_oc=Ado5yb8QU31uogtWjzk5M75i45xWNgMRJxzGY8LqlojBhk9_WmV-oB9bgJvGVaA2kBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c7-HTFK5xw-U28jjwa9ufxlvk4UH5MVSpch2UL7VMhg&oe=6A031D88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU9-XiLUxesQ7kNvwE1G3vp&_nc_oc=AdozojV0HX5tbrznJL2EeZ7GSmC4yzeHysJA_Hgbp_4BP0jt_Kqi8Btxz_UN93VVOJA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rx2cN36kCyLUqQfcs4VN9Nb_DbZzaBF6ZzhSrnYKqZg&oe=6A0336A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N9Z4kc4v8UQ7kNvwG7Dshv&_nc_oc=AdrDDbywjFUyc-s-f44YsvgTDF0IC0bOcnWWBkqWKqnVoAq_KZoQuVTxfrZdIM32gHs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x0Kxw3ZSOUtCSBg-2d5sPes72nGvQ1XH9LRMjcajS1Q&oe=6A032D73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAmzT8g-zmcQ7kNvwGX6nrL&_nc_oc=AdppDX62Gk6_rONORq8-CXaFhjllFsiRwNUg_3L3Lh45q-tYUhCrEhjLbxUGm9Wvyx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YE3jD8vwEBwG4yqL5bUY2JLRu6t33_J52tQ2aqGZ1Jg&oe=6A0340EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lFWi8rAFBEQ7kNvwEw0zZl&_nc_oc=AdruOFYlK0mDqwc-g-7ajO_aFPl5biMlopTlFMX_jL0H4Poo0xjHVcHqwBYq-U9YFlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rfTT6YnnuarQkGH0Kv86XN56nIq7ayshGcVXaADBWDw&oe=6A033B7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVeNKFhlmF8Q7kNvwHBnqzd&_nc_oc=AdrAQp1TObs_WmIdbDSRE1FADt57UYv5c8FiZgz5mgO0GAoY1t6pOHbLl8V2TirpPFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XkhxB-9UyfUQzQicUcCTMB-UR3qk_b8-mjXzAoXTLlg&oe=6A032CE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glXvFNug3xwQ7kNvwE3Xisw&_nc_oc=AdoiLZAyby9jtiLCP-58Il7Z4EllPao549v-d2nPzcKPLMiGufHyDk
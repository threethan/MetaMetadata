x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pnRr_8bWsEQ7kNvwH6jjDy&_nc_oc=Adrfvtk4tzpM3hgi7RKLVNBnmcYlN0w1o8KFAz59gT3gqV0pNvogIFF8MOR5WKydVfE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4icxzSSfh0gweZRiLLJzihYaHshQGhOEcciNSizAfdgQ&oe=6A09D2EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpRcOlNyjZQQ7kNvwEsUxLU&_nc_oc=Ado8zRnxtSyxrOUFkWl7svTWtsjstRYJgJBfbQXj0m3Xv0kyCEZ_r0Ck9eG5OSMo3e4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E9hyn05E5KCAo_mGqM_yVaJhWihuRjaxbzwUCKBLNqw&oe=6A09B508"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TxmjWRvClAQ7kNvwE-fhXG&_nc_oc=AdoVkx14fanWZT1G1cJ8d7C--LrEOnBPUkuBGU3pY4lOxJsRpGtEYBKLXy47c_4xaS0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n6T4AhtVxVMjWMLeWLJcxPdoKrhRSWe6gk6cFdG2cWA&oe=6A09CE22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkyuGr3k9rsQ7kNvwE-63BS&_nc_oc=Adr4CvwV9QY_cMm8WfyavDrAPFDG8CP5dDxeKJ2CPbvXTCKAGhcNoSZHwblypp1SnWM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60SQJD_cXhoKsdqWtWYf9uclaAOajU3pN5F_7uaM8YbA&oe=6A09C4F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKSBB344DKoQ7kNvwEql44u&_nc_oc=AdoQ8tIkPCOskpxZmL0pO3cO7Yd6uA27xBuTmgMnEhmJoAi0XxYf6BV46K_aEsGGF0s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cTKd2DhYaGPxbQRy8viDw-EkhhnQZLMbYTSaEusGwYw&oe=6A09D86B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixv8px-3WZ4Q7kNvwGEvYn1&_nc_oc=Adq4EMtuW3Jm_Qs_oBhpb7rzQEoHYB4RifKWFGaUahPwfv0U0fFVRihMOnBeTVRLB8o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NxlMu5JyXtCbYSjnftxHsCOGcLUj2oTcJial1tPCOkQ&oe=6A09D2FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0cjeFWx9nAQ7kNvwFQvdaa&_nc_oc=AdpeIdY8M-2ZWTi3rzbPC1aqqDF39uVrH4DXQCyXAxIY5sLXvTnKr8pW4-sZzbH2d_I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UUt_8cjzP1w9EzKbyXUZDb4oZ8SVRfQViI29gEDXuTQ&oe=6A09C467"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeysD8BbJU4Q7kNvwFTMTDP&_nc_oc=Adq2oimNL3SIqtfXq4H5LfVSmloae4HktC2jEw4JtMGBt8d7TA07A_
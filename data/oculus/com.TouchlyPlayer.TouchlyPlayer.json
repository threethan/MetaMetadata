x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2if12EcRocQ7kNvwGgEN5b&_nc_oc=Adq-iW9RvCUzrI2Yhl_H3O6_1qDlPBLnzVIqfXyk3zJK0MYKBA5OHo6UdfMsBYtYipo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97miHedcbb5kRakMKA_SXkKdSTQoT_ugC-Z11xVPHFiw&oe=6A2D6B6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDhL760o_v8Q7kNvwED3dsy&_nc_oc=AdryLlVPt9LeZJKHuv8oHBwXeIri8vaRfFF_z7NHSgPr8S3fm7t8kCsa4-vtv4A-QIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93wRiDf7DnbmDo3dKScVr5fG-EWQ1HbNV6njkHgwir4g&oe=6A2D4D88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLV11VYmL2cQ7kNvwEipB3U&_nc_oc=Adpsjc0lKdYHDV9u9SBlVVeaJB64XE_95XNeeVIPd7TRiUpbmETt5gg2-RjdfrYYaOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t_AtAEStqtj907MCnUDQAGScQIa8yLuHgOdkC4s1HsA&oe=6A2D66A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ONASfRASycQ7kNvwEa6Odj&_nc_oc=AdpsvOfkrKvmGzlfgQI_JR99aGfGNzrVQadL146T2gKOJgwhbqtpMZoVguQTk0q5d3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6o6DvNU4d6hTpA7IAr-6z4QHwUMWifjc6V1Hn1eVIww&oe=6A2D5D73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNuBru9A0NwQ7kNvwG0nuAv&_nc_oc=Adpo5doUNftDbisL4d5FNTPhW4oZfVzUVenKC_NmdDPorc-m0gM0yzXfckFDeHGeW6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lxWYAcZ_IM6KVUONMVKeWzXFEektEU9F8dPB8-d3kLA&oe=6A2D70EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFlI3DQfB4AQ7kNvwEjt63U&_nc_oc=Adq-rUineaMnpGD3EwW0ir-QiOKe0HVCHT5m_u3-D8slvMqcXlxULH5hnhHRghiJs0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sQhlR2zApq9t-DLTR6dxIcywtL7kOEiwq5dPiW1V_zQ&oe=6A2D6B7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ic3EPilQzgQ7kNvwFpfc7I&_nc_oc=AdpXmqV2jGFQEGZf_IocyG4o0hKccXPOhCgjrg1C6FAWatHDe36MC-Eyi5k-jyT57Og&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MtKV7h6Ucp-ToNkkPNwZ_84t8dp4ieBaSPHLvuKYSbg&oe=6A2D5CE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBiduWiJD08Q7kNvwG4q79f&_nc_oc=Ado4hQ6WMMhsATJC87Le6CTUxxUfuHQfPh3ZQ4pRTiyXE_C1BkbZpZ
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EamLdu3g-2UQ7kNvwFemo9j&_nc_oc=AdoiwEmgLfOCljEWupAhKBmc36OtQyZAUomx7tk2yxyCbM1QvUmxAm-8OcJBevUX3tQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1S056el98d8qpDMNfZJ-hbuE-2zODBYYGtgr5Yapjl4A&oe=69F4BAEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m923A57YyzoQ7kNvwHxhuEp&_nc_oc=AdrVugTF2iInyjuuzQJi2kIM-T-rwMeME4fmcWXfaip1XJVVBldsxdotPhcMdJnX_J0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MC_ql5PP8fDypeeJhd01O7GnVY8RZ7T3kntItRoWnoQ&oe=69F49D08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4NFqAOJWtgQ7kNvwEUnuPJ&_nc_oc=AdqlERb2mGJSpTGaUGi9hPm7LfL4a9dsF_oAjZBNp73MkodxR_jbUdrT_Zoo1V0bBk8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3I66jN6wBuDDF-ITaUFzWGMEOdgX8Ftj3c7RbuGeN2Aw&oe=69F4B622"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASbcaaQE-jEQ7kNvwHVLWs-&_nc_oc=AdoBZWE4zgi_wUvjwydAgyzOt7sb7IVlVK5qzimL1LbBE7mRUEMUZBje3vgl2IAOmNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jzK44kkpJj5ORAt5zByWVozw8mw-Q8HM2eqkTjEhj8A&oe=69F4ACF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAFkbzK8Kp8Q7kNvwE8ciV_&_nc_oc=AdqFqcTLb3wgUOQ6QlWDzEBC8TfNxfozIXHnjujZsN8bU597hEEv_L_LxbV43-n0uFg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YVXz3khUFJQhC83TD13r_Q4ypBxP9kqcmW6U8QAp0mA&oe=69F4C06B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lq7WjNo4ijoQ7kNvwFpsewA&_nc_oc=Adqe97UUYPkdVKRJFY4Lp2ciAkCKbneZgZ5iSN56a2MeEL9NfRwUSO9fVbkrlQMvB-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hs9RDxMUVBFb98WEOv1YgVqq9FrUQnFF-U7YimSjYAQ&oe=69F4BAFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40Lj3kGNzUgQ7kNvwFt4Uj0&_nc_oc=Ado3Ed6aZRRJ6Qn7df-TuHsFBssUSEu2FSVy4gUC7Sh1Yn8Rv3q6-ky6DP9FbbraDkk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fFJfnwAjFGS3z61xDSwKRCj5XnTLHuz-cHd8DhANXXg&oe=69F4AC67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_RBYEi0XcQQ7kNvwHslkle&_nc_oc=Adpi7qoTB4a2lU_e4s9jXi9xQdNBYJmoVhy5YXzHN9c3yniC4UcrO8
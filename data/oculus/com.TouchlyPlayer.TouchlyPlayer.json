ait_1008x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFSnCdwBUSAQ7kNvwEmEHBt&_nc_oc=AdrZhfahneYqzUV-4nmmrRavM3TyFNjYJCuXZ1IFen9_8zvvvKW3n6DK2ACfWnyQv0o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrsxwcVxgE9x0E_YrCIeb6bZ43smC_-W8P8vklcSNpFw&oe=6A8587AA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XADG31d8QUwQ7kNvwGYIKaM&_nc_oc=AdpKmMqiwToodI8iZXsvYlgc53J8hHg9Gp3yXSdBy-CBJ2lSsDOSJCA9u3hC6l_vEpI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3csu_9jBhEe6TmNZ5JTcfrJ4mGRQiZMN72wBf0kYKqA&oe=6A85A208"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psKEPFRK6KsQ7kNvwGB-loF&_nc_oc=Adp7wleds9WJBjgxJ8aQW7nSU4ysGEeOkZPF9zSGBcysW1fapIYAtSE2-8ffJd8aipg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUJQXg3jVzJ45UCRBCo-qJn4AH3EUpNIb_zuqOYLheMw&oe=6A8582E2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih8KSiVbUDYQ7kNvwGm9ugu&_nc_oc=AdoQ4_Cp8xhOpPXFtxlbRJvjL516SZB4MVRF8sTPuZVs_8esKkSF269qT7AobIBEPQ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ-A8iWIkmItZZXDyXZBNb9eR-T6xuL2nlBfS-mcQ64g&oe=6A8579B3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkhMMib23eQQ7kNvwGHjib8&_nc_oc=Adoo_MazwgK8tOJA_2lTev1TN71gJDLKPco9lRiBZCGyNfHr6Pe3sOPZvzQHpL-Qqos&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGZj_PmOFdf0fT7rLzqJCpCLkT042VBnQv89oerDpnfA&oe=6A858D2B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpTgR8w4T2UQ7kNvwGTCJJ9&_nc_oc=AdrWZ9qUo1hw3RIzDn1i6gvD46EEhpoiKsOZ3Wx9ONfxizAQ0MGK7sbYlu69zB9D3EE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG854d6TV5kqGSoKjAw7iFGVDxbf6LGUUH5B3MDXjD-SA&oe=6A8587BD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cimkOrEvdHAQ7kNvwE3gFLk&_nc_oc=AdpUOBel6hBjt6UZPbB1LSJCYiWHIo9z34pmwUp1S8Usexmzmb7SDjJgetp-8bImZfo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGttMMDHDHQSIx7HculW43q-aDev2NPyCc5oQmYgtBOZg&oe=6A857927"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqALCGKhZHUQ7kNvwH3jsjF&_nc_oc=AdpxvepEBVtkDdLrSxPPIa5igvvseXHYhOwl
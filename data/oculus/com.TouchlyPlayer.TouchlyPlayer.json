x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRKtRkQeh2wQ7kNvwEhMRg8&_nc_oc=AdrXpd-C8uOa2WAnFz9fdYvIrTfZj-AMPKUuX1x9p7JYEE2k9yy0bgt_fAP9U6-PysM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LgyXlraq0w_GSkn3Mk4WKgoGc_ix_WGAuXx-KkHpuIw&oe=69DFA2EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rtNAHNPC_8Q7kNvwEB36At&_nc_oc=Adpw45ZFQl62oNeMEpY_rPn0BKTQgUzegLUZK8piz_ZOb7tLBINjsDtX2i-f5-45kTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qRefS5FbVEno5gISZE90qTBr5SyR6zz_8TPTbLSWcPA&oe=69DF8508"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKaF0JqaEmMQ7kNvwGyV6se&_nc_oc=AdrZo0uKTi3cFapB3XOm5-twWRjxWziwyJrLewjjPJOxPS_up-hBdg0DZt4wZ2Dskl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0azov8Bym0dcj49cygR1r6oA4CzfNjWZi3AfSN_ahqgg&oe=69DF9E22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofT0jItnP1oQ7kNvwFTSbhw&_nc_oc=AdoOKK1cxxOle4sO9SNIR5D__8ut42L3r4CEtAZ9x__nr9uTLStwfZdUlRMnx0NMv28&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ClWqKxygKJ89NEISLr-JGEbQG6nLoCE2QIbvcVvD-kA&oe=69DF94F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK8F_1_ynjgQ7kNvwFx-PY4&_nc_oc=AdrFyHPx2EEbCLMrYaNG3AzGQERLZ3Fl7t0LSReofUJkWPWzafD5pgVgnnUp6RbXVlM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13_IzBZu1yHN3fG1Y9-Ws0PI_DWbSKGkiN7gE2BjLF8g&oe=69DF702B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoeNAFvVxtoQ7kNvwG7hxkd&_nc_oc=AdoFgYtZSJZ4IfbaYnCPXEACxxf2q7_xuff8ACzurueMh8kXqx5pKbzjhVLZ6_FOt1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W28qtkRHZEcy5-rzXk3Jkrtrq2qYPobvdtpRYKduF3g&oe=69DFA2FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FEebyCMxgkQ7kNvwFeT6xH&_nc_oc=Ado3co1QyqHFkE-_MVNDgBjC9c9ZQBmYAv0npSkxVvztE2UIIlVfcvqVu4FUu7XnvH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rfn4JmN3u9HBfIozEXIty3XDhqsMTeDJ_f9gCClG1Fg&oe=69DF9467"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N95zI6PvcOoQ7kNvwFCe9Lf&_nc_oc=AdqOuDPM_5gghyn9jPBRnmESsPEvaGnbU0rbB_pa1Aqo4lpEiCmzRJ
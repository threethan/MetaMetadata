x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmotFtaocD0Q7kNvwHX8hHP&_nc_oc=AdpHGx8uAZgRIoPXZ5tACw3IGUv8d5__9K8N-nYTLT8XfqoL3QQtxYUY7N_OkeBZyrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QNYudEhEMWohWwWpjcIwhxBUqS5qhVwTNMZZ7uHHjPA&oe=69FA00EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bq02c6TQO8cQ7kNvwGK7ylW&_nc_oc=AdqdlykoLTrk0aVaKVlikOWNDfUF72WIgKGaaMip74cnFijbz4LqJa-V_KxjM71ITz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pK87dCi5AXITcHK7jFBftxtcuwvwaLc78HwY_6KWqZQ&oe=69F9E308"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUXnfw0wpKAQ7kNvwFaOjPk&_nc_oc=AdrrGCoXifzRcEhd3Hqdhmty3hXpnygQBQnYuh--mzpB_tOR2tjQRkKElKaOcsTvYsQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xou9CPGxQPXUi5aGVSeDSJIAL8ZMEWgm36zbedX4zmg&oe=69F9FC22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD4iNaekYOgQ7kNvwGzrJ48&_nc_oc=Adp8I0z4L75vHWES6rwpJV2aU0ICAvMUNb6y8agNYfzuuo-V641s3-3B8--C44GdN2k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44WkRlKHNh8snAfksx2ZeWKQY_XkGMas97kUkB5MvrlA&oe=69F9F2F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94obItfxfaYQ7kNvwEUUiwI&_nc_oc=Ado1Zlzr5kh7lrnLurn1lVqfmPYZRK-ydyaSp6wDEeNLaUwiTmLeh_Jyt5S7NktdyE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wcm0dFggFEbDjBypILj7whjs03R5DYU3SyJmxYYbWKQ&oe=69FA066B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYdVX4x-w5EQ7kNvwHModoT&_nc_oc=Ado1Pp4L9ivMaQKDdA5zCwLyVFs59ng5yN9BJOMtj7EtqsKHcMzw7MLX8-qOibp99Dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60TnrExqGbmZAuTUvdmrUYVwIUs1Ue20J34NNtE66EgA&oe=69FA00FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vAIkidsdBkQ7kNvwGLlpWz&_nc_oc=Adqqkx9ANmXKUpv0dt_rdUZXf1t0R9jzEJ98cyLA0hI-cyuhYBUj8Gjgl9dxpYVsmcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JKU9eZR4V54EXhKGHo_HYZb0uNvmFPHNyhwR6rHnZfA&oe=69F9F267"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZTxjPoGv5oQ7kNvwGMhfjC&_nc_oc=AdrJvDJzu6METgnKhR5jVUP6Ik26iV99aoteUgY3VkdrILSlvIJSPC
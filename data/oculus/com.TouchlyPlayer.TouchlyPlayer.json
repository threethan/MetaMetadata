x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCK5i78apRYQ7kNvwEn-5zu&_nc_oc=Adp9y7k91xqRtFwANM2LZG6DI_lFo5s5TyXASiuZjpekizGYNAEB9qln9ToBvDXVfzY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2dmOiUbO8L28IQk-pYDXpErcRnYyzVrZyCdeLFijjXw&oe=6AE8A06A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEYFT_Sear8Q7kNvwG13mqF&_nc_oc=Adry6v8CDIuIFgLCWQW4UsemIaxalwDU8wn7NQQjcFP0jW1wAt7YQHXw1Eglt8Aabn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT33RsxQhoOtmOcuoE1WLF5P-DSUJSCdj2TR4KMBZTJyQ&oe=6AE8BAC8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sStGf1aNqjcQ7kNvwE8FtCO&_nc_oc=AdorZHYc6za-XIFOqQBJENjvU-jIUu6W8ay86KMAF5zth59lt0Vxlk_Ev7Vku9bxm5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXugsjvvXYXu9_TuxM4oiPxzKUs-HAlIcvOATkylBrdg&oe=6AE89BA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQAF7XC86WUQ7kNvwFMkbDh&_nc_oc=AdqAjbvBAzYmhb-8jYCwxdeJlgKxvHeUEYfeS-YwTzN1vrjljHu3B9c0RqvYgRHIe4o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrBv-1xRedxIZeOwC6UuP-rfhdtrwLetIPHoZ4tcVknQ&oe=6AE89273"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5fVqf6T1BkQ7kNvwHZs9jc&_nc_oc=AdpOuCu6DULACTdMh_S1zEMBtum9cbtaooYmLRSH0nwEypdR3WhrJ4WQL_te2hnkuLw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFPzBbjFgsCvYoXbT8jM6HUjv4lilYWHTfO0JjGE91pg&oe=6AE8A5EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtDj3TPmCnIQ7kNvwHDDh-F&_nc_oc=AdolhBohrXXU_xTX-NmdeJ9bsCu5p-Tmpt44xgKZU9U5pACk4coZbWkCCzFvtTCt8jo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReR0RXnsAnj0fB4sd2Y8z32uRn6CT8t_yv8iYrBfolRQ&oe=6AE8A07D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uztfVrBqWCcQ7kNvwFciiHY&_nc_oc=Adp2OmvaX6a5TyyZR96XKlcW9EEfVyWcSI8R_AUdUVvqHmrnO39wpwjW5dYaCtDXq2g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTogX7yO6N5bgc5t8nIawaGQKKws7ToR4QpqlsxtTFmVA&oe=6AE891E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHLpkzjhw3gQ7kNvwHEHLPL&_nc_oc=AdrNxH329FcOrCsBBI7I7Twr2To23wq3O1G1UmoU7iROE8r1uYL6T9
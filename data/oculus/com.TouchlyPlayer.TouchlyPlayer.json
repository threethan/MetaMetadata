x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omzmjcFxYKwQ7kNvwHhogKj&_nc_oc=AdryLpCW59qSvaL3MVUEkIJj5s5bVcz7GXVnUdA-GiquDUC28XMWNAzAL2H7Qgqwx-Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E1J35zm-HuSUGYON1ZQ_D2ojM2Gz2IXbbZ1cOAJxNIw&oe=69FDF56A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqtXHm6HrB4Q7kNvwGmpTDy&_nc_oc=Ado27iEdI6fsFB3tAcSW2aa73qrV5bXjQRLW03bYMAwC3hTNUPGfLncIRph7LRBJyO8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-D-hcahoGwXWQqL4JzUlTk3tNwwze77_rAevDDIF4hw&oe=69FDD788"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdaOU4L0g0kQ7kNvwG1RP8D&_nc_oc=Adpxl-Dvz4o_jaRzl0rUR-rady3yXPkvjR-4i1escR_qfpazB79CNoWOpSGX8oGx7Do&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z6eyvQ01bb_HiY_-rpPxfLJx7_FMso7ZNmunBXR4GYQ&oe=69FDF0A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWatKNz1_hMQ7kNvwE197K4&_nc_oc=AdqOzwOnuqwBzBs0eZu6SdGWOcnMnonas5w0816XCH78XLPQA67B031Kw8vQ39KP-QY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P08ZmepyymHVd8XDuGnHqB_RSIkgMe4qPpfs22tJGZg&oe=69FDE773"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJ1lVPXIQ4MQ7kNvwGziX1m&_nc_oc=Adp7eGkDd9buE3drjX_wK5V4EbSyY6Mvpqa0wmLxKIfNUP8dmchSfrTj1NYk3S7I-MI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s95EH3zvkaRWiBKS5tosRiwt9ncHHNkxrKz81WNKrbA&oe=69FDFAEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACsIKL8miuMQ7kNvwG75reg&_nc_oc=AdpnGOQJ7z7-bEwXwJ5ifHDC5yo33GOPVOwQLfWmYnTveT-GJCUeV5WLy6pZ1lbPXlo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z03Whl6QHdp3Y3Ra2eKzTkNIyb8EP1F_LeX3W6lTcgQ&oe=69FDF57D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3spyyLkKozQQ7kNvwEeuDn5&_nc_oc=AdrAubUbBgZpZMHZOsnGfzpHOi8V5HcdDBHtIhNNGlvBsrHDoKMEKlYBOfIx_VBOJk4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gu19MzK8UP7o4Wy3g_awbfRH_WDrehSecsP_Kw4VtjQ&oe=69FDE6E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3bURPUKyUAQ7kNvwEDUIO9&_nc_oc=AdoNOBOWDEisj73_lU4-k9tdZf8_2czFZgcIT4bt-HJ53BPTRqLBPr
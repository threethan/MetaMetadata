x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tupcIbsMQN8Q7kNvwEQQq62&_nc_oc=AdqJmsKijwUZ65TCRZ0YhRdJy3QFzrqbS8X35rhOZxwYYfcY_b7Cd1F2vutFjw939Jo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwnLSy7k1daUVfdK-CCZt6Pte9xkQE8-uAylOsRAQxig&oe=6A68BEEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_OAP4pMVTcQ7kNvwHZFucZ&_nc_oc=Adq9infMtMA2Bo64cRuJwzPvMqUN6HWz_DvuwQWcd_VRqbToc0w22O2joqbqr9KVgIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgTMSO8svokHko34bzVEkis1InmeP3pN8nsZdEFJJY_Q&oe=6A68A108"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnFv8bDOomoQ7kNvwHasjMe&_nc_oc=AdrX0tjCMmPdbZm4E_FRoKZl9i_9I7c5OgnnGu-kskhpfVVkf5LBbL5j8HQu7jooKQI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtV3PmV2-b86O7qlGnBT7ibCOml5NsNg4Qzb2286KI8w&oe=6A68BA22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGl74g5JcPMQ7kNvwHCmQY7&_nc_oc=AdqF2kBtxiu4masBnDf3V-lrCrd6HfvHQmkpj1NxaRPsOFsgmRFUh9Xu6Z90L7-yxa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3xdWexv0b6iYwWRkYgthPmwSrtSNjAtGZwKMKyg8wtA&oe=6A68B0F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSpTP9BQlTsQ7kNvwEvkCRB&_nc_oc=Adr_x4X47TM157RcfRRHZLANGXairU6uKD7OMLAvNTsVVNoUBIJS0F7bad-p1I5Jag8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeIMrkPdeGTF23e6xrsR6J14SBSPu4Ln0mF0_yz9mXJg&oe=6A68C46B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xMOSt-YMnIQ7kNvwFd6oR_&_nc_oc=AdoxrtzWKFU-BW0wlcN5AvXbPzcUxNFK3aCUWEseBfQL8lCHm7DpZh_imYd2VcjGKZs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR_1ebr7jFjH3LC4BeUItZdJGKaXv5Zes2eHWDLzccSg&oe=6A68BEFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW1CODs7BC8Q7kNvwG2ootW&_nc_oc=AdqT-Z9BmDeeib22vmrt58oWPPQc8xWcdkr3cgxoYPy2GjgP4aw5WOwEhGx7076oyDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWQmby6gC6qublm0mWmKR-CZ2UoxaS5SOXtb87gW8l1Q&oe=6A68B067"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCN4EMw8hx8Q7kNvwHnyZQI&_nc_oc=AdqvqN2gWvR7-QxJAcIhIZAmbAbfaKjLi7qy1Y6p0kCnwUyx5sLBrh
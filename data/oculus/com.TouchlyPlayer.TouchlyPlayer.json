x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7vybLT89EsQ7kNvwH9o-7w&_nc_oc=AdplLSBb8JsO-M4VmV6kTWtQIzwfk6t1bP94K-wS01DzoMe9BkbUykZwgg7P0N8aza4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLkqMhfbi4mzKX-Css5bvXrwjfTU_RD8OlzfXBQdouFg&oe=6A897C2A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeVyZj61NSMQ7kNvwERePOF&_nc_oc=Adpv63Bwr8dJg-fjRFzTAucc14uVsnTffTOL_bFdjNjFZabMjGnkSK1wtEHHVhyG1Es&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOuBOEkLIE-EUmafTiNHGfwfPQbu61n02LKzUPsln-Pg&oe=6A899688"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25YR-R9zBsIQ7kNvwG4iwnP&_nc_oc=Ado7OF-AochqxjuNMbCTvvHtdOzm_kpJlXYmcBYGZJG2ALePJ0FZtJQGeswJJ_wAAg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8hHh0nvgA1-vBJQ24f--rOV-S9n2MtN45ue77hYPNPA&oe=6A897762"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuRcj5BZwiIQ7kNvwEOaqfR&_nc_oc=AdqwrcgeeD7muDPYkywCyEgjn8J-abvwko1BVUVIRZ7adSZq52D0vleLDcM2Osy-H3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpq7il2TuztJdJEOfhE5D3lbGsAr_yQFt3XoBvfpBO-w&oe=6A89A673"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43aPPY_gRyMQ7kNvwF8cSnH&_nc_oc=AdpaxXY_vs5wGhhOJVu6-5dBKh-QG3PrBlGEJj0A13eJO2QPLIJoUuRJDfryBfulFrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAg2QBghpAjceczF7jYxg2balVVhto-m6lfmje5dIBew&oe=6A8981AB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL1GbQI6X28Q7kNvwG9Dui6&_nc_oc=AdqNJdVFh7Ehn7NtmtJ9P5eM5yLs2h_nz08o0sKeEJCD8uHu-yAhrkfXxnGNw6gb-jI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxaNirknkk0AscREMJ2_8J9niCWeLBP5ugbHsWnD9E_Q&oe=6A897C3D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwcdalIBcQgQ7kNvwHs-cvr&_nc_oc=Ado-Qn6I60nQFgzj9zqz-uumtd32MjrmjmvpuFCRBTgrErPXyHzc-7mA8G_u21QmKwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAE5Ps5myAGM7TD10GMyz0xM6h15t9FVE0UAzy6y77Dg&oe=6A89A5E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZ7ZfloF-f8Q7kNvwH5S1hp&_nc_oc=AdplghUfGZZC6wjCCbfRzSbwzNSWsuUu5mqlDJIRNYWTfP8RbM28l8
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2if12EcRocQ7kNvwFTMyK8&_nc_oc=AdqC1rl343IfehoryA1JCewwvMvWE1Rz8O-YUtpkv06JAL0n6Ou29s8rjckQrdZ86cw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mYMFqh0tRSNcA42d9XSK5fxzzUobpBZnqmdVCAcjGCw&oe=6A2C19EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDhL760o_v8Q7kNvwHPcA30&_nc_oc=AdrypRQtk6utdVbI-OqUeEE5nODrNPoPZEFckoO55k8CN74o9mPybtQz8CKVge1pr-k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W3HnHWRSZ6DUFzIDuXeRIZ6Hbl8gJqLqDfvdhUVK9sw&oe=6A2BFC08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLV11VYmL2cQ7kNvwFtqm8G&_nc_oc=AdpBG1Fsamg3gQGmdiks2h2x1XrnO1S73Q5K0NparAUBvtwTofeAvl2d7avF7pRDc-0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bWPH9QurcF9YpG01xWgQNaLyDia5adnRjMyYd8ScslA&oe=6A2C1522"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ONASfRASycQ7kNvwEqPXwr&_nc_oc=AdoJN4uym1hL5k94VS78CAdQMyeYGWeY7JyAuQdqOYEyx5RjswEwl4SwewrbrfDKiik&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UjKKtayIvyWpyv6SvWg7Uw_Wz3Rt7EVp1GX3zmg5yKQ&oe=6A2C0BF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNuBru9A0NwQ7kNvwGYmmuK&_nc_oc=AdqZxZnJ5G__4u8q5SZx5f5gBvdvFL7fCa-1Qy7G1pxNnRl_YWmq7C8LBOu0GH_ytPU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OrDu7yrDeeW_SnY4eCe6IHvNt75KiGRxXJg71aARzmQ&oe=6A2C1F6B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QQYuMKYl0QQ7kNvwFJd20Q&_nc_oc=Adqc7koS9HZZIGDYooNe21CGySZMD9zIuxxCEmReWkzalDtQyiqJeD8JuFHAJj8ETjo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KkgmX7UuCQRsATsT46x2Z7VoLc2bXANnJxrShy8ejyw&oe=6A2C19FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBmT5eSMPF0Q7kNvwE9klhq&_nc_oc=AdqwHsXvO6GF5kLLwarDZ5RajDafT31mgVmDMVGeh1l5QHJsYrEsG4ArjpjS5sbe1xU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1ciKC6EuyPw0f4-YZ9efxuRoGUoHVWOZepAOilrmozQ&oe=6A2C0B67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBiduWiJD08Q7kNvwERlXe_&_nc_oc=Ado_nm3RBhA23-XL9KrOY7FVe-ORztWFKuzh7JhQRBLp19n10YES-J
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCK5i78apRYQ7kNvwGKaUFa&_nc_oc=AdoNgTQF5eRF8x_GYmOP6Wa2YsaovJDgeYE726uGon_xMgBzfPjzT9o6Ko2gbvS3V2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmQH8PASHgOHSUX4_80DqmMh3XWdS_ZEN3QJXO3ycozg&oe=6AE9F1EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-ro0d0Yp1YQ7kNvwHsx6MD&_nc_oc=AdroKKEbyErxU19yfMUlz1I37YxYakdQ3_hPbMFcpXrNh1YLU58fujM13b0FHrrGj2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO1vBOfGtwrt-HE9-gFTEeutZzaE3J77WwhGXG71lkuQ&oe=6AEA0C48"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2De5CvLtVcQ7kNvwFrN90S&_nc_oc=Adqr63Jxjo0gM67PzqfGY-2VwNmMlK5OH5deRwJkZ_huF_ELguWabD3bQGcuvRT0rIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJCYuryunBAjuExkyFIi-3jo6mcpHpbZxMfb3ROAzogA&oe=6AE9ED22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQAF7XC86WUQ7kNvwFFvwUH&_nc_oc=AdpAWacrhLpqoyILKtDojJDbQzk6iPWNZwMMaE9FeB-CMYwEm94Czz6QwoRXblJqkm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYE4nqF3qS5QBOiINQMGzMMm-q62eHyXmg6uaO2nVIZQ&oe=6AE9E3F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5fVqf6T1BkQ7kNvwFbWNoX&_nc_oc=Adrec9hzJkxpdHHM7YvxrXuvtBHnk6ER2QSUrk1EBTYa2Gvw0lpriqW99px4LvwbdYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxX8RwYRokdxItkXAwTA_xQ4VyawOr0NyMmv4ofIEjvg&oe=6AE9F76B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e64409AtesQ7kNvwGaLpMf&_nc_oc=AdqMzc9H8LWmHDsFfFay29RxrEK-BBRNIwX5xh28rlguCh6FevShQPjLQpKIVTZvj_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlChMfcTFAc7Ex76P0mI7XVZQGYJ1t_oRmQg4pcjpiKQ&oe=6AE9F1FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uztfVrBqWCcQ7kNvwFTDdoG&_nc_oc=Ado9LiB5gzczOvQcHRTGNodVMq0eyu1Jj-5c1pDu_9MP7ODvQinsklHMwSmyQC5pnjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTPtQYt9eqXfgvsTpLzTtWx030Cwzz2GXXOx7fSHGbOA&oe=6AE9E367"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vniRkeBR-7kQ7kNvwGyRpiG&_nc_oc=Adq-i4T5na1s4Hay3-Irf3BP7-LdoPVdj2KDG_0ntuLZusMF-toG0A
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE0l1U5NlgcQ7kNvwFlhPpw&_nc_oc=AdoYZeTwDYciZRyBVxsXfqEes1mRaFyC-SiJ7ZPJJUZ_K6wrkkqJWcE6eHqcjWONiVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQteClDEOovZb4QDwa5DoitbLhXAegQx00dakYqBcmZQ&oe=6AAFEFEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiltuKVmwEgQ7kNvwFbE3vj&_nc_oc=AdrXPMr8jXvXn2DvYRHh7dw07aZ9YbE5I1BcCnQVzD7mIUS9kwqiGQLXXRCuA_lEdSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO9zreezNDpW2N2v2TxfZbS352L4qGKifPrI4crKdcUA&oe=6AAFD208"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=earYMKIFy64Q7kNvwGrxYPn&_nc_oc=AdoKcUJueCv63avwBHltK5_ewBdOcqtXoyxVmfnW4IgU5fazq1zxMPiv9swRuqDI4Lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqQQOtDZZAw-OS1CDclMWJ8jGHEHwz1s6ghHGm77NEOg&oe=6AAFEB22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHmKUZBxQLoQ7kNvwFOHZpy&_nc_oc=AdqLgzgzoQD5RbgfXzChi2ANqLjQY-OQ_kZ8LFyhEH-mMzE0AH5wz7agcs6-lWEges8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVY9Jcq6PDGux1vukW-5ErTFcV9ru9OdaHViMMJ1Rd3w&oe=6AAFE1F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWdYqWZrqgwQ7kNvwFPaQxJ&_nc_oc=AdpRnZVveJxj6QPOoTbfduowYr-Mp4Hnybxn1QU8cazMoVQSu4iLND6KMxrr6NtG06I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5wFd2LzNAZbt-IugGYzB9hxKvrnJLKQQ5HBz5jLs6cg&oe=6AAFF56B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ul9wPllkmb8Q7kNvwE5Q_nE&_nc_oc=Ado_6BipR9q8BcqzygrgSGIypAN4efDyh1YDGdlVDjkXEVsn4Av5ywP84_sl3vQIct0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYGBIphQ7wh69Q3Z3hbNpoM9Miqa0ZrSzXqq1GIhZPLQ&oe=6AAFEFFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p-VLmgW--UQ7kNvwGF5qNm&_nc_oc=AdpbBYRs081onYQ3VACJY6GISqkc7KENOYP7UlfMB_EFacxnDMQO2FJcpQRhX-qasNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx2WMsGaUP8ZJ1GY7jT-bTRF7T2hUdfTTIt6iXuyQhyg&oe=6AAFE167"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flBpiyo4vyMQ7kNvwFgq-qk&_nc_oc=AdrqzLEsHerD0nIndy5lrgCNGR67TPMCI4ryhc5duc5ou6RAXX0J2Z
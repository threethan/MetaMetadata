x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HmOqJn1j8IQ7kNvwGgoA9U&_nc_oc=AdqL1INrVIzZbcn-AZ0egIn2tQpEINv94KCpgVJrLr_Pyw5JSwpvt9I1kmTPVUB-09s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ISQYpx-6llTpRceh74b34LJSDS0n0kdh3C5gqeY8SeQ&oe=6A0DC76A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX3tIGHC4doQ7kNvwEuf5S6&_nc_oc=AdqP5QViK-0ReEydcEKnt9t745jFsH3HsgpCoRxvpZJSGre8mG4fM_zEu9PlBD5WvWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YKvPaWzvCJb0d5I6oL0D6vHaU42yunJVKYLlYIRru-A&oe=6A0DA988"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-nKhmPMp5UQ7kNvwGTAhPX&_nc_oc=AdpNLZBTmjUZ7FKuv7nf41lJu4TpN6pQCKV7vch6ejIHF0ljHLekYYT4pkY7sLIxe7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47yfHKsV0apjLePMo8ZhzyduDcDsTrAYGVfJ6g3V7KIA&oe=6A0DC2A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSsZOhdhOFwQ7kNvwHbn-uw&_nc_oc=Ado9r-2JyMLIXxSFv1rwVoJYnNegeX9ll79Fce62IXVSV8DS1zbdcSa1C11za2O1oK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XSJtzWH4oP_RlWmxs3eJlMwQ7tCynDv5uZrLk2HZa7w&oe=6A0DB973"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwLL4ntsF98Q7kNvwFGAK-b&_nc_oc=AdoZ_DqB1Tj6he4Za9A4DyVXb6SqfpF-0EHEMj2PaSyZeeTJNgnZalArUnA8LstSx6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hDMXr2fId7Rn3u-Xljhsw4JMcHfMc05sshrxnu14Z1A&oe=6A0DCCEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ_TmNPvN_MQ7kNvwEnJeGq&_nc_oc=AdpGvimuBUio7hXmAP0uQinzIF5FcCMfN1VxT0KSCaKm2-FgYXjOZ5cTlZd7Cmg3UO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fFthI9r_0pFeoBlhbXV0PdSDiIiwO2V6ejiN2SptZGw&oe=6A0DC77D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JF1y2TagEQ7kNvwG7k0e9&_nc_oc=Adr48qMMRLJx9Y_YiRSRYGCVUNbNWlaMCa_rtt0UGLtaYOmxbEl9WFo7XMdvjdQS3EU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a_usNl2blBlHRAt-wgapv6CgdYx6fwd5hEaYDSHMu1Q&oe=6A0DB8E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRpXExLfaS8Q7kNvwFzH5dI&_nc_oc=AdrgzW5LWkhU6-OsvxDBYhEOQEewTR1IaBnAzCb6gPwitTy7ME7FWf
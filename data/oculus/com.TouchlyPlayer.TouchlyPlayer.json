x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2N8QCUj5aYQ7kNvwG9FjnQ&_nc_oc=AdpGMumX5A8grxlcldDZZW1xDn-GDe3Z6BnU8RcgF5IjzZt-oE5Mg84HFDQGCHS3BWk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGifuMRFPqQxkzOGuzH0c2RHF-aijKGYfA_3E6dAJDog&oe=69C7AFAA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SejaqCVXMVAQ7kNvwEuURUS&_nc_oc=AdoMFNd-PgxH7YMlN7sjwPGt8LXZFCDoBPTU0O9ef4PD-4a5wC2n7IJKhvIuzAT1_E4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKCUEPsVBGUurqEZB5gS9l0AKA89iS7h3q-L29JbY6ig&oe=69C7CA08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efqVHmboV4kQ7kNvwFdeUJf&_nc_oc=Adplvd16049rwRSxyLbbpDyX6QLEh0Qd1CHQp9t4-6eLOrHFl0ivHXvNJK4oLZp-ZuM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUq7sODHafPcejxePzhZrGvf_GMCHNkDCFjJ9AvaPjyw&oe=69C7E322"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO63r-Uhhs4Q7kNvwG1NJ4o&_nc_oc=Adrm1w3k57mtgBd5n2M71Wl97t51rpQ0ft8h_kytb0p4PHiigjqH0rRuBJ7LC7HQD-E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLC5U00I1Ud3RmN2-VKWZN3YTSPagd9mrBhIU4qX83Qg&oe=69C7D9F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUiVjZUUhEQQ7kNvwHQRFUr&_nc_oc=AdoyqQSVUgWOsq0BJVduQiAjsTkVF90XVV-Uac0rZ7iPLzBFBjy-b7cTNrQ4748jRQE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiNy26r8mgxfrzZRsEIOgB2ExLgpVHdqLATpyj6Za5Lg&oe=69C7B52B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtoBJR4efXEQ7kNvwG-MzC8&_nc_oc=AdoopGboGiRgSUC3iF6z5BUt1GXTN0S22GIOL_NAlRuwNQpVXzWLLNP_dmDai7gISFQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNpkfHnM8RYXepBssslFISYDe90xU8T2HCnJPmCPFbzw&oe=69C7AFBD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg7oEAG4jY8Q7kNvwFw9PfH&_nc_oc=AdqdYOwTPUsi0Xj9ke14JCqhV10EVXh3rl5iGOPcCzzhIs5OsmR4Dnj8ZOVKsCYkpq4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwybc3mNr7xMsHowR40tTTITFRzipyxjj3GW9eJxTaVVQ&oe=69C7D967"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTvDBK-yJ4IQ7kNvwEqrakA&_nc_oc=Adrrzj3qjFmE4fp1umS5Yc22iN1jUPgYgumZTBIZzex6_cIvkfAXLF
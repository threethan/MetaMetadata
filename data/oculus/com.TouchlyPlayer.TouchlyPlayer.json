x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRKtRkQeh2wQ7kNvwFJB6jE&_nc_oc=Adqxx3f_2HZeh8gD3EBcwbPehy5bZgwbvCtvbJbMavu3mj0CmHtN5PqbPRRi_IUZR2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZPwm1CK31Je0XhE6dQboUlJzhEpaBLSvKHryKiBy17A&oe=69E0F46A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLGZgh7wvZ4Q7kNvwH_Ma0j&_nc_oc=AdpMTYuMAYW8RwqgXVsZ-BI71N2KGien4TDevrFOWjnunJQC1pOMopRCPRNKXbrkmLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iWTFBm0AvWrN0pKKZVIsgzDiToWt0T6pXn6P8wMj8og&oe=69E0D688"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTtrTEZt8a0Q7kNvwH493EO&_nc_oc=AdpiCaj-or_zufjwFVtoClnLgTzosuzRDAiNPS4wTAFm9a7MpP6RyrMM00g6-4-ODus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MjWwS_j72_L8AdvHXcZUDLDZqapQFug5XlwqvqhE17Q&oe=69E0EFA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofT0jItnP1oQ7kNvwFXpU3q&_nc_oc=Adr9GMCtm5RdLKpBF2-4dndt33ZHx1qyBq8PN9gnn482KDRXwo8lsNC3T2FZpDoc9Lc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yRifLTU4rIzzPOfzouxwehtONAHqUDy5P5jUQfzmmRQ&oe=69E0E673"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK8F_1_ynjgQ7kNvwE0_Utr&_nc_oc=Adohv-llmRDDiEUJ0ZFtyqIw2-AwrJ_mMBvKmFWvOUKdoZrzUuI9BNm4ZdnEhNYV85k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26aGYOwE22Xmwgv2qmdCq_c1vePNTIKggr5KduOTXXXA&oe=69E0F9EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoeNAFvVxtoQ7kNvwGADDag&_nc_oc=AdrIbsAh59WDQg9ApM0vMbg6qPZUCBez-oxgjwGPP0XkWydMFZVDdIZ2aGjWTIaattg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05egTTKvNaCbKfAGaDygAWd1HhznBBcbFGJ6h2oBKNXw&oe=69E0F47D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FEebyCMxgkQ7kNvwG6Gpzn&_nc_oc=AdoDSlVnFYWqjSeXu9kaWjZqoNnejZVBJKj0uRObDaRJWRUwQshUk5peUgsXJjN_YNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HodRdqUfn_mh-HLF_0yklWXmzq5WwVW672rRugo0PJA&oe=69E0E5E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2mqyyQXXG0Q7kNvwFf3R8d&_nc_oc=Ado6nUiKyyPlATEyO_vvrfw0SdrrCYGMc-YVfNX9M06nS5ZJW82cv4
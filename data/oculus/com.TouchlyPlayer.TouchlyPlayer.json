x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk-nZ0E-UQMQ7kNvwGOV3Py&_nc_oc=Adr12sAJpQ1c8i-FrsmECqXS2WGhPIJv2xQXOvq5SihpOzqQgLwl7N4-g_qs3K0TXwg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp_5fX4qRmkIxYCdb-l4RRzBL6xj8YfMYNZvT3Qr8ZLA&oe=6AA16F6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEzu2lkWx5UQ7kNvwFgcb0B&_nc_oc=Adp1qaQUoonI5EUIxwg-X0-oI3HWoJ5oPkdQIzylJs-63z4cQFhFMGh5FT8PN471KiU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmoLimZPTE4B6-tWyY8xF9iYvvHr3pjhrgfN505iWdOg&oe=6AA15188"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJdiYyLW8b0Q7kNvwH_QLsx&_nc_oc=AdrAxjErxVj1_wBnkV9J91aJktvshJfcCxI1myTEd_YAnecgWzdvBIdJ_EjJgo6C1ow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVQ2D8IqUIMcU4PCheBO_af7fUy6sXmKnl9yyxOaYmkQ&oe=6AA16AA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6ODFgrNR-QQ7kNvwHANlbG&_nc_oc=AdrPJs8Hui5Y2o1vEaBVEfKu_5qhVBMR_ra-06wmuudHbSr0nr-R7XuFTPiFSkKHYzk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCsGHdGWUbjEK7ej5EXv1bhSyTFDbfTWF4vai8rQginQ&oe=6AA16173"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZfRGhSc1DgQ7kNvwHmXRWv&_nc_oc=AdqTUWHTujGuU6RCIRX3hQX7EuJocbXOp3LK9_QVjoQfk6BZll3SolJ6MfkeUCWUiIg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVCSyh6zIqfk93QwSB6lZNMXiuMRg47EKTQll2R6-uLw&oe=6AA174EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQkxgC5-64EQ7kNvwH2_A8e&_nc_oc=Adq4PjJ7W0lKzBwM98-JxBUH2k_qEtlvTw7e4CizXttfbabO-mHVytDL3qvMOCT_E8E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6nyohNWV4a00IWbZzfWCM6fMWZbETMyhBUpqZB7kCTQ&oe=6AA16F7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn1f-WDy1E4Q7kNvwGb7U7q&_nc_oc=AdpYM4Uq1wqd_TrOLJSXAPomWFGe72_k8ON3EO5G1F7vd8HrbTrHN77rmFyhr6zz9Us&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4LtjBqT2HpuV06WwEICsCoLVM-wPvixv5F3pEGpej8g&oe=6AA160E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=758WCj7dC1kQ7kNvwGvf5JJ&_nc_oc=AdosqXJYSsEeodvKRy1GrcWXKq7QKU_IPRSONQIncUG47s_C9B0GIZ
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6nr_GvkAXkQ7kNvwFnZ_83&_nc_oc=AdqA7qjdZcLn2VwUm8lOMbyG7jSVmqyzdG_8oqOFPytjXOcWcIKsaqZCa28bITf-FGU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8oHFJA4kTbzfZ29DSuXJAN8VrotMZBL8MTo4ImlJEUA&oe=6A218DEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PajWa2IjIEUQ7kNvwGeR_Wp&_nc_oc=AdqVBM1nMO9JFPFeG8dxoFyjwEWbMUYXVLjVIvJsIMENgzMDnJXll6Lm6yvneisig1Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JptrS5gm1-6zI4WUClNlrzkfYQoYrICR5b1F7rZOyIQ&oe=6A217008"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGC0qqRlY1YQ7kNvwG8RTNm&_nc_oc=AdpI8mBJvXKOmUpcLAvMWfoINxLtHk8w6UdX9L8vfhDJXX0Og-1XMq470pr20-IAp0c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__vslV_FBKYZdFYneWuyo_SbmZu3ayK-pQp4xSKNnkYA&oe=6A218922"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd-ltsrw5WsQ7kNvwFBm1Me&_nc_oc=Adq_n18o8o-r3ERDf_5zeEYECcOwXJBV_TZP66J-sxB5oUAQyEbWCXkqx_jT2OvpWpM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Hu_xo0VBSV0edl2wa1Juny7gtBOWKMKqWEVo5-8R1ow&oe=6A217FF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXlkP46ZabAQ7kNvwGbT4Lb&_nc_oc=Adp-GD-3vFcwX1x2HUK39SDZQ1NPyImVbpo7jRY5nKKrF8C25km2LMxZBGKdHLVN7QI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z8jQKBUWukjHBoPkTydvfLjtYeLY9gjZLKOn8HcKImA&oe=6A21936B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztd09DJHebEQ7kNvwGj1zS_&_nc_oc=Adr0opfCoRZM7bujCDbE5dCYO3y7qdLk8sWtloN824vxyQYTq_Xc1J6QuzMr3WFh-8Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hhPTtl__6ueyXTs4KpxqIp-k5cOh58YHZ_AbvOvid7g&oe=6A218DFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNLosGqNIN8Q7kNvwEAwbKa&_nc_oc=AdrfU2CrGAe4ac-XOzTikkaEaHOgHkwNkK5ySfvB_tS0tdv-oLi5pB5hUZU-ZmE7Ojg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pqSn6F56w_qbNPd5nDQQP9QQbpLLbDdNOlp2m9YdZeA&oe=6A217F67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp5_pMGK24MQ7kNvwFUvK2t&_nc_oc=AdoqY5cqYjFVUwFuzzYx0l_5XXfCYu2dR3hdZ9RBfIgSls06ygWnHa
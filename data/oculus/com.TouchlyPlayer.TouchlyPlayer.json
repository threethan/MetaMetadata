x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52mXAdtP6FoQ7kNvwFA4gTU&_nc_oc=AdryX6ZMu-rsgLQ7pPY1unbAxDOkQ2-3dwVrsCEyp6ZLV12II9cH7GoO4iVWYRRpoJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EEK6TOxi4l_k0Zvu-oBPduiFjheFd5x1R8LHzeWR4OQ&oe=69DE516A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rtNAHNPC_8Q7kNvwHrR9Mf&_nc_oc=Adr6UoO-ncpSQslRDdYZUZ5S9-tP35HXqJJmS7xVZaJQ8IEBGDEW-kw8dmBQFUzNVtg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lEZTkAgO_xaCuSqtfntFg9q_yV077jThedmLY2OgLLw&oe=69DE3388"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKaF0JqaEmMQ7kNvwGlGdDP&_nc_oc=Adqz2SgcB9SlddOVTxe9uh8HMcpQhpspZaWgWJMZNkMhpM6Adx0SjwDkqrqsewPqvJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wmDI9IgPhTMjbBgleaSU-gyh4lVqlR1IiM4F2dzeONg&oe=69DE4CA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EP_OqLIr8QMQ7kNvwEX-WXS&_nc_oc=AdoZNA93911e1471iuP6vcvFRg5EfhvhACKwam1VGMLK_3vCeuVVwyW92X51C_a2Jqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3abAA2IJ3YLRoMA83wpVQyz3IniEALRu1pNeHjvkXF3w&oe=69DE4373"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ufc_OjI2kEQ7kNvwFp19Nr&_nc_oc=Adoat-O_OqZKuiF6qCGKYzLpZXqPOP9WUln1Hh7_U1TybFDu_fBVKh3O9mCc3KFqtwc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bqZ26WjRpUDC51ibXTfz_8m_ZN8xkOqy8bHQkBODs0Q&oe=69DE1EAB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoeNAFvVxtoQ7kNvwEROSJ2&_nc_oc=Adp-2IQ3BPoJGi60Ey-PTYiaI4xTB2D4s8kwsbmx-Rn1xJjTe2jmAMtAHegTfgDRAng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LAHJGO01wiXdW4ToncPZ4rp_xyi6MD9S18qAif7ay8Q&oe=69DE517D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FEebyCMxgkQ7kNvwG44Eag&_nc_oc=AdpYyvJPBych8MidQACKU4zbMer6udqx9O1yz_6T-YAxBB4PpHapuo_3d4NCGxVWTp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rjQ4M-yiq61xNQuhphV6PNiDl_CS1gnivniNQnudSlQ&oe=69DE42E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N95zI6PvcOoQ7kNvwEaZeqt&_nc_oc=AdocqiNL5XqFDAPYq3txSc1klKZ-UMQiF6ADqyv5oQH21EAYzZNyPb
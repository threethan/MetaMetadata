zta9OLa3WPjwfHPKszWCTPz9zIHvvYSEhZLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvHR_OEnUe6NdVlVOtgou4P3DsLdmg2TB-tIoeaMiQUdg&oe=699ED6AB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5Ehqk8RFbAQ7kNvwHQeFRH&_nc_oc=AdlwnH_XoovwyTGMYCo3O1xbOTrUlMZBM0Ys5pLl2ggh3mz6emk5rdcb7zyMqs1d3SY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsu1khJjBkhjj6E2BkrS83j5BTfhVI96dUO6P80NOx2sQ&oe=699ED13D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siyfF825TFQQ7kNvwGMdrbd&_nc_oc=AdlgaYerLWLJ7vgyaCLyLFmFKb5gfbt4fSJlz5n_w7IKne60HXz_5E_wqYFmfmUqc-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvyUvf1MDTVTp0PaX3JCFGa_KSqAVKh3r6-aHR1y9XkVw&oe=699EFAE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QA9EAAiLKwQ7kNvwGRV17Z&_nc_oc=AdkSIomJlyb-hhytKaY91W6zxkw-ipblnmDpm5f02UjWNfB7PCzayxrkkprm9oVGQ-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs-E7uBZQJmL_GGTnDytRmwSYxpbD9if5Lz0-4sC141rQ&oe=699EFDCE"}, "is_concept": false, "is_tes
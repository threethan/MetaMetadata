x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAG7NpoKgDwQ7kNvwE-Lbln&_nc_oc=Adp-Yy5Pig0kPnw1hLr2VZ94v1iUHUwY4Sj6W0S9IQXjM8ZZyXfZpDRqwuIXIe2TMT8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YlPQVMw3nbG7T200yO4ztCDU_G89_mR4vwg4LcxWm6g&oe=6A3D3D6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vAVtPGTCEoQ7kNvwGlIbtB&_nc_oc=AdqqcMgftpdhO1eeYesIH9-a0ROmdCekRgr612iv5ZVYpiLofOEA4jNaaUSeRjzND1I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_TgqK3EBkbiFOI3V6IlhQIOXhHCu1S0VEYRUXj8s6XQ&oe=6A3D57C8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0OPqkjcpYgQ7kNvwHRU8ol&_nc_oc=AdqS_ozuIDponiTVlb36UjXlwix502Ywx1wM3B6KnDoWJ0yan2SaST5Xu2_F_uyXQL4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SGGNKZ2ul33wRAF_iYIbwMh0rl8x1XppyC4UYV9ZkAA&oe=6A3D38A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMY9rz9oUX4Q7kNvwETluKj&_nc_oc=AdoVowfZ-wRyz-A7ag-mZyssK65w_oe2SdLDtsvS-SXGVTnyMmcPF-igwX9CBF2DRRk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MywVWYKcmtw5qjQ_TZPdyQK40umjdkT9SVX8qO64GwA&oe=6A3D2F73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9GOn_a1hfMQ7kNvwHcv1NV&_nc_oc=Adp47j2yrfBbpbBTC36H0Lo6TKQoc8z6uZrRGcqYXivJ-zcxmmKyYzVJ_KUcNVg63v8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wE8S0HrsjOEKOaYOFnRC145-ilYg4tkCpuSsMiermPQ&oe=6A3D42EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJE2kls-RooQ7kNvwEZu_uB&_nc_oc=AdqCv9Q2xCgHflUw80SN6OCUAG8jh0egMvdBJJni1xidEUq-VBLRpTeQtNGwFhcIRyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sHqbqKkSyrLMsL0TKg76XmBFQEX84Cavkhby7fC103A&oe=6A3D3D7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaxjn1MWnSwQ7kNvwE2INJY&_nc_oc=Adr2vJ4on7XkO6saEgR7TNGE5KYSgkm9q1PPYZUoFU88p8LmPZ61fbJVAcfctorZTBs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j21b0J_8Se4AkfO_lW_Odz7ffItfyTLFbpttOQgD91A&oe=6A3D2EE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_Q-R_Jb1M0Q7kNvwEZP-cv&_nc_oc=AdpgOPZCa5o3gRJoKZW7vFVNiOaayyKp6h3xAGAI6bYDiYx5q1khAH
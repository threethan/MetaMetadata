x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUS-KuwVaxkQ7kNvwEWNoGl&_nc_oc=AdqikSFLrieGDHLSVF7a3Cm_9E64zX0MH3pTZCDK9TrqeHgXnj0KxY82NSiAq5H0ZRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ecg9ekBi--KSJUHkJQTTiYfCqzlXBusv-RtiJ7rk8nQ&oe=6A3FE06A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JITHN6jGP8oQ7kNvwEDiicI&_nc_oc=Adq2Pc3WQ4JfXwr4wjk8VQaJzbUlAmE6_LMNpIpCe-HLYnpKib6p4dgt0Tl3PotBuTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5k_6aYH5CeSyW5AWvePDP7BijnHo1tf5zGSWiy0QxOw&oe=6A3FC288"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DchhZPdsawQQ7kNvwHg-yv5&_nc_oc=AdqLAz73ybReMypWUQ7jHwtH_ZQSrc7ZFhadjUqDGLTwtiUd1XndaknbTcJO454m1rI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KYPgE_CoFywJF2UNWzKBrJ7k_fUZYdlgy9QHNPkoOSQ&oe=6A3FDBA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScP1sfUSS9YQ7kNvwH2oTBK&_nc_oc=AdpGkRXv1_iRtsyzgBpgLjyKl-2Y7JfKsiWdaWwFzDgtXJgM8NY-exTaoFTNV_4sIwA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DkKfEPLnElzN6qZwdmUTDRNs--acOfvk2gTKEWc9Dyw&oe=6A3FD273"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFH4Elq7XacQ7kNvwGy84s9&_nc_oc=Adp2sTjZ2o1U9frSDgy6JWKKuQ4WFdRzbVVhtD0k2KC9a3nMkEyYtPOpHjo1fIYlCCw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5OjyaWXcuhkfZ3xE_7bWPv702SqaeGteSA48mPRzqRg&oe=6A3FE5EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJE2kls-RooQ7kNvwG9KX1O&_nc_oc=AdrNZbNfIbnWZbc9aEWSPKcI7XgRBHHIgA9o9HNyWvX6NCw8lydjVrkzVRcLgzMPjCw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v9XoR5o7Jz-1Bhra3_QkrFVD25lxlkXjnU_AdePQKwg&oe=6A3FE07D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaxjn1MWnSwQ7kNvwF14wBN&_nc_oc=AdrJRPpIPMpioCud_47dPkAlA_GSCFDbjhNzflpZWujr4Kz5dQn00ItRucpyNa6Vf6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S7-S0bgOUtBM7jaVPhPsEOa3T1_lNfCqMXrfeZUcFIA&oe=6A3FD1E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJCQxARoPusQ7kNvwE8pNz-&_nc_oc=AdqibHAroc7Q5scQ9xgR89c4HguERXBuv075kktS-hj00t_2c3Rv4f
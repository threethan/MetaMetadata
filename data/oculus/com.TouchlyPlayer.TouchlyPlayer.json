x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QeKTDjnfD4Q7kNvwHSZnvf&_nc_oc=Adra2i4fiFkqrBgxI9FK9b6g62yn7a9h39Qh3vs7Urj1gP6JVaIRnRuhK8HUOp1wacw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa-R35KGy_4GMWJ2Mih6nPg6LB9GT_ucY8pCfv1FQ7CA&oe=6AF8AAAA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsT5zTLB6jMQ7kNvwGwJYYc&_nc_oc=AdpTCfSEwLUGUATfit4qkRj_kymmG1z9BlEmC0kbp7n2jPF4q-16nnEj-odGhmutdt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsTpnTulB0UTiAY_Ka9FRwE_Ag_JURkT8XBAtEW-q42w&oe=6AF88CC8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPQZbaGPd-sQ7kNvwHQrVxf&_nc_oc=Ado0SVgdL-fN0waFSCO4s2V0TPdVX1rro4Gjv-BFhuR9HWPKSGnZS5NStD19kt4PNfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwBEz8K6fhTe0_NCmVCfKc6C0XvC-4IG1Cf1tbHcanww&oe=6AF8A5E2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBwpFGaKz38Q7kNvwHOM9WP&_nc_oc=AdrFfhOMlA5MdLsHX9bZyNfw9_ZRve2vUMKjkDA5E5WivDZLtVODDjq9JHb381-1FoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrnA6iSilH0WyIrAYtm1AdzdfVMbiT7-BfWKHYKwlgAA&oe=6AF89CB3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yhr1CMpc1wQ7kNvwFnoVt6&_nc_oc=AdoI_d4lNm7HmiOVCNcnn9rY17VNrtMWYPAES_Jv28s5ZovVHxi3SDKLOsQblpy8tj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTewQN-bmLSuBSapxkiwbkSlpiJp4D2qwrD5JJn7r5-5A&oe=6AF877EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXJ-DKdG98AQ7kNvwEQ56-V&_nc_oc=AdqU-Iq3YURs4WUVeGkkgEuafD36I-c14k4RidqXjn9Vlh-h97MQcKQgxAilc6-mpmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBCSd5bSRKGVIOzf_r0fpSiUa6fJMKT4E8Q4wdk-Z_Dw&oe=6AF8AABD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0CcbsKFi-UQ7kNvwEFepYT&_nc_oc=AdpJX3vWBgImSyTRq8KiNSb52RM0fJSM7wRgrRMZXIyswNRF59U3Y5OCbZDWzweWdf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzmNhe6jkPSrbtXDXvl7kNWStiEQbbONHdNbnwksn4LQ&oe=6AF89C27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZVOZyyCsQMQ7kNvwGKdJRd&_nc_oc=AdrKvfM_8XZQnj4IgP2yHX9Y52aQu03Z95_vTypSFIoOjytIuYi6fR
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwJu0jyr4SsQ7kNvwEpEtrE&_nc_oc=AdpPby0BJ6QIskNnw07_WFhzwT8Khp8VdIRxmUIHcXGuMxMIlgFT9mNXwDZQIBzjWnA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE70B24QcAeImq6wVEag8oGQz9FOkWzPJF5k42PJvrVdg&oe=6A91652A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8MAejNk8bUQ7kNvwHiPcVR&_nc_oc=AdrEav6u-uwrus4WzwZArU1xVJMNvIpvFwxkhbNWfy23jzv7rGfXXwvpcYBkl5Y_Vrk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHequW0hylQj0oK5A-umgLsHyTAzqcJ2nswtN4WuV4LaQ&oe=6A917F88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgEPRjmYQPsQ7kNvwF_AX9j&_nc_oc=AdqysRsb26R6FCMHA3MsYjpqAMS_u3iZ1xVDD8YbOLnCssa1u_qq_IP1GUwJLRLqqWA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdW0_9GCs4qBtju0DVobJPxm_DYln8zZysn01brCYIJw&oe=6A916062"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6TwyWCYI0MQ7kNvwHDn0rO&_nc_oc=Adr4fyyPMWL2br-s2qkj5gxmL0jM6TMtRIpD5Z1kiAIQqjuhgTdyiDGLqjXD0V4Dywk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELVS-MJUKSpNS6KRO_LLhyhUren67scppaVx0NvowRXw&oe=6A918F73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mUFbOmp4JgQ7kNvwHrJcv0&_nc_oc=Adrr1_FD1D0e612_9OkURqAES6pcPSLH4ce87irFjcNNwM61ntNxQVGiVQnedQqw1Zw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV-C35sd54PI2nkDsdl6zcrY0NgdYZU3H5JjefJ98bQg&oe=6A916AAB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-p6ciAfglgcQ7kNvwFRnfoP&_nc_oc=Adq0mqxhBiVm6Wp8odVpxkOBtQ28IguZ6uxV3dT0QMTOQjwKiogxQWR0FfjX4mcSU3o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOrFCgBGs_F6-OHpEEGQv1L51pIrbHTaVxyi8hC2wsHg&oe=6A91653D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlgHTW2_rUAQ7kNvwHiZfgP&_nc_oc=Adrhx1aYF2X0FnpiSH_G5t3_5FFz2Vl7nB_426fmV04x4PZRoIqdSDpqX5sft6pSoyA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP7iuEpfuCvP0CrTk90RNQot2-ZY9z8g4eznBUdCgP4g&oe=6A918EE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY9Kal8qAl0Q7kNvwG2vNT0&_nc_oc=AdoDgAjyoXtwkWI8CAARbTBJUnRzJ2XnnNif6WyfF4ZcsewsBn7TkZ
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlk3MIR8D7sQ7kNvwFjXe4c&_nc_oc=AdriVyPMY7a8A_094_MwptW5pmyFruR8xSflHeIX-rIZbnnphNJQdcx6sCXyz-FEjoc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOxG2K0M0Npwr5v7GZpp754OjRcnU1kT18iqhhwxtrfQ&oe=6AD0E56A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3AS6qIZosAQ7kNvwHILG2G&_nc_oc=Adqrd6xGaAEGWESVxB0QZ-qgFcvIOe4kx22H2ZilHoFwiOd-dzQpgWXAmAb6WdXecjQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9KTlAiBRDs3xds_zITKP2BaQgad6nM7vNqlr5qM2s1w&oe=6AD0FFC8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruq2o3HSuZ8Q7kNvwFI0rmm&_nc_oc=AdofVYrN9_vo1WgbDUmuK3gXXE6sZlWg2Sp6L51m2nGvVmQL7pp_EKpTgeC6oL4RSRo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxS58LYltS4SMpgwrZIaXfXKr5qaagRx1HA_E0qaUO8A&oe=6AD0E0A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkLyPmdWVLUQ7kNvwH9TbmQ&_nc_oc=Adqt4XUQFwIT6znLJBjc-DoMoL840SMnMrrHxtqB0hk5NovbroQR1rd8MJJauAt8RBM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeBLLJ8F_7nwXNy__QgbUXsmPeIV-7PE5ae5Yuroqj2Q&oe=6AD0D773"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ihGUcXo4T8Q7kNvwGWv8vq&_nc_oc=Adqilp83kQyqynWebokRTooIFofG8XWgwEt9Rxa0TJAAdfmMH-PM7qbFO27v3RSh848&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpVhyDwovwz6_InI3sUIQhKy8fFEB6E2kOp_k14zxWyw&oe=6AD0EAEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXV9przg9rgQ7kNvwGX-nbm&_nc_oc=AdrMnbrP5wgP-E-xp1N9Yvf3nice6Fqz0QNFNhYZ4RDgLXpQJEopdTblYMiAypeEPUY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3vb_ofyyXNAvfcSQ5C-2p3aylmxn3MVDkscLgQCF1Fw&oe=6AD0E57D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE2rTbbpnaAQ7kNvwHK9iWY&_nc_oc=AdqhcpdtO7dKcKK9DB17RbRvBSbDolGad6UGbQ5xp01LfUUYRSPjmvjoZr9V4UbXi68&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeJkUPnAWFWFObXO2pf0ajOPUirPYCZCLMgYEGc5zdPg&oe=6AD0D6E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZw69oselqUQ7kNvwFgLB4U&_nc_oc=AdpGjzTtrPhOn6bkt7kXknzsaf3hM3aaAHMNh__Ra4WPxWXFQHhgFJ
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1QcC1UMAkkQ7kNvwGEDt9g&_nc_oc=AdpaT4HcfENo3AOIEtNpgdejC3TgUViLBXI07qS0bFZLQMYBKGw3OHC-DFHpse0tmEQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLr5Hqif3SHJ9JuJw4Jm0k7Q4wFr1gNg1rTMZvR8CvZA&oe=6A54F86A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmOxA6PhHQoQ7kNvwHBL3h6&_nc_oc=AdqHNVxtc3WzqhJxSBML4zjjZS8i9_x90QCrmmio9MpI-ieldkJVeTMgdZf-uNHbREs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkLzLBSgOyRxn_ZYfT7AuYkE9l7qtwyReOY22Q7Dmf4Q&oe=6A54DA88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlnyW-i9nN8Q7kNvwEEjYTZ&_nc_oc=Adon6MrbXk2Yv2gDV9r_Av__lyfbfUJEO-MkCZyQ5D8dySYccf8Jv8u3I28G1E6h1Ww&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDczqBQvBAj-4_zlreC_cH5sYyqtlklOouM87R7hXFZ_g&oe=6A54F3A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6FXxr7z4JgQ7kNvwGFAGGz&_nc_oc=AdpIUaDdy0XPNd2myQYpYkSnHL7OuuUGbXFI8VEiPzhEwf1LrY1m8as_0WVOvYfYu7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEmqZcRjFCJ0nPrBp2jcIRiFHetsJVLdg2DU3ahGUakw&oe=6A54EA73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_NgIrZ6ivMQ7kNvwErT1ig&_nc_oc=AdpKM9dKwBo_bB9jcR8o5Vh8_6e3BQO3eS5MH7qCCKCwWqoCodCPvVgyf9Kq6yvTKlM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVsjhiUE9us-GHnibo4wawTXZccnhrMOThInXtHCgmAA&oe=6A54FDEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC1YkeaYdLkQ7kNvwE8keqs&_nc_oc=AdqaZTRcmJ44-EX83rEj87vooXlXswKGkE9vm1Glgd06NUkk9Eu1iYnXDCBN2l733mo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYJOJwL626jvfrm-1PW_jQJ0YWnoUuOm0O641Dw1UNBA&oe=6A54F87D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IopGMbNkn_EQ7kNvwH7VqJO&_nc_oc=AdpGonjf_wU4LcMc5Yv9LU3imELZyXP7xZOtsq8-Veh4nW7nWEzJ0EpuGGWYbZK48vs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAr6ShCJmtWY4ueYLy0Zgf54KUzLjoygwgdjyKibcUUQ&oe=6A54E9E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vWg9OiomHUQ7kNvwEIST7d&_nc_oc=AdqcMGwQ34AJw7SsXjYkfqGOh3L0Rbj82-36DL2tDWQgILRzmdy81S
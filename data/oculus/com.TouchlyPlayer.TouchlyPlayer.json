x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45qv26hank4Q7kNvwHppbkb&_nc_oc=AdqPgIUwoJnCc8AFE1cURnyzKaHRyjixvAr98xxUYooNSdAw98A-sFoH25nmVu2RMHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5XmzusC1XTJXMQM2WHplB_lR-koAQEZ-3t5VLT1J98Q&oe=6AB3E46A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjwtWvCH9qoQ7kNvwH49rEI&_nc_oc=Adqn_2qTz_9hFR4qSIwV3djKd_wRImnaRTTxSjOTy4psf2zfITNK0hmoQSEL5qo9V0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg3ncGnVOH3_LH4i3uwbyoGwY1F-DPLRfs0Qjr_H_XHA&oe=6AB3C688"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBwmVQ-NA2AQ7kNvwGEazip&_nc_oc=Adpd2E9eoU9t-kPj8xYdKExxbNN2tGF0pa5gItKo0gReGY_3A_Ad5HVhlApTiwotGWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8iP2WgcVN6zoeUUTycAg5OVeZnDlzhFO2aNoh3l3Afw&oe=6AB3DFA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEAmROrX__wQ7kNvwEHHrVr&_nc_oc=AdqOkPJZYOXEOectXylShs6_vt7ZL6dBGYgu_WGl-YgbKPMrcTUTjAdQgE3UatZExWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK22n-K7-ZWg0Wtc6rg6lchbX2u1I63NT9C20oPOnlPyQ&oe=6AB3D673"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzqnkA6lvr8Q7kNvwHzWQ_9&_nc_oc=AdrrkZQLolVjubgkEU5x_Xc5m8rTI-aOHzrwt3dz0q34U1a-W526mtm79Qt0hRhYVjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaPmiKp9bQa0kqRC5XJr2f0BcyYlxPqLG-5cSOZG-8NQ&oe=6AB3E9EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsjqVYpsTsAQ7kNvwFYkuEB&_nc_oc=AdosYllbYtgCxHCnx9Tet2KrC38n31lKkuEpfzHcyearC9PSuXAaTT36kMdnf8me9yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNv-68gcPhH0bjrC_5-xictD7Fqps9X-3EfCqasFD9ew&oe=6AB3E47D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTIVyiI_YR8Q7kNvwGoK4cq&_nc_oc=AdqKmNYRPLm2LCnssmr7cOq3QRlCDtZ-YXqv58TIizVwVMrgtsnXZkWGwFGPFkgKIVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8ufjbWBtxUEHS-FPfS4uOUzs4OY7Go5xpULc5Us-4wA&oe=6AB3D5E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tkh2afYYeG4Q7kNvwFeklrz&_nc_oc=AdqTM-9JXbMhL085m7RI3YuXZr0X6CatFk2aZi-yMtQ86w1LQ1CR1m
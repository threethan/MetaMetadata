x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC1mZjCBmW0Q7kNvwHnGTdG&_nc_oc=AdoDIMLybFDHO-kD1_s9QHIpF7PtVe4fPqA4V66UP_FSXFvmYJOZpLl15z2p3522ZlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LL5fGwwTqfZ67dnLwBpCwirrAWH4ns5gV4lwtgHQKiw&oe=6A315FEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxh_JDqdhaoQ7kNvwELESC4&_nc_oc=Adr5vX4AhCMNQE9W6g9LCr78Wtmp6zs_fzuIvODfjth1z0iojF4HS6n0BBd0wzHmtCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af968of8EYfe8IOeevnEyWSVMgLN8i_8Lp8xSUsfVFniGw&oe=6A317A48"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af_5eAnhFRgQ7kNvwHomD6a&_nc_oc=AdrxinONB0cymk3be47HqS6Vbw1I_-AywTcsu8wN6rf8K4s281vNPvJpxRmmpu3yVok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e2NfsWFGSkDNx_AhQ1gCDEVjvhRE0ZqiTNjbcMa5nGA&oe=6A315B22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkezLKr2tFQQ7kNvwHuTZB0&_nc_oc=AdroSC3acRO0kfYDAdbw6wKmYen1NqMd2ppwEs-f3lvHAVW8uEHCEdpwMZPRRxpfDN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c2LWPNLs-rbTl9KCuYDCeCH6NNids3gj_ezMT5NOosg&oe=6A3151F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ7vlspwvxMQ7kNvwFU_p66&_nc_oc=AdpEnSJ5FVAEfAFVe8pGV7Qxqb-nz_dxmWdqVsqF26cRr_w2-XrhxdJGNiEJ-FKL8kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93pAiamMB3W5Pr_tEnUmTsn2WIfI--ycfhTCstkPz16A&oe=6A31656B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0OaEKR_nRMQ7kNvwEgt1Pz&_nc_oc=AdoX_zgdAk7qmEHiPcSOIeWUAaTjlCQcgJJtKQn08QUdrzim2_SOzn0-sWysEZ-RA18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dpUsgxNmaU4LjA_hohMM22lVQn-j_jWd5PV-aUFRg-A&oe=6A315FFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ambrg4aTF8QQ7kNvwFo2gKz&_nc_oc=AdrA1Ojc16CFNDVqQTGevVUCMWUVv8thLKnEourELa5plqBJ5ez-c2H7-anYOimiSSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99TxTg1VtJfaqLddjqCm30nE5HZtCPlrZT4FRk1b5afA&oe=6A315167"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR52Sil8y-kQ7kNvwHS6QY-&_nc_oc=AdokUf3ixqFSvbBzxHA8MCyDeYkIRiKsNOnQ9Qjwv8MxAjkExQjfWC
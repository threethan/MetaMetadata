x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM5lfC-Zv6YQ7kNvwEcReLp&_nc_oc=Ado3CqXrVl2u31qBmlK5MmfXH5IUOPvFYCNrQRi1_Uirr0yGlKloV4dziqlf2ZhOZWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKKSoYmOIGjQp2TtF_a52VkYG9eP8BVEvnLg1agf9beQ&oe=6A7B33EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td1816jUEAsQ7kNvwFVPVLd&_nc_oc=Adqi05e-pLbht9_3yeolv21TDQnClEa2uidKUt9FRHajW5aSbB4ssjV0-iLdPuSlars&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD_ozvirpF6roQLxbLcCvw5m0eqIxuuIqjhNTZYnmfng&oe=6A7B1608"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orb89uN2fKMQ7kNvwHmg47c&_nc_oc=AdpsZeZpB__jnmzNDoRCirk_1UQ6n3I4UYOJlJvC-46RwRhyIHdyN9LE5JF5rqkJ2HQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbvfIYIGhXZN5NBIsqydJ7X0PrYf9T6--SEe5Y2XMrug&oe=6A7B2F22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTqQs3-SnzAQ7kNvwFVQfm5&_nc_oc=AdpSrbwo_-fYLyFrO-s7jy6wIeUCOYKoMHtrJkncBZPaM_oP6WcG8XRolx6I82sfPVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-T3QYEM6omDNG58eWd74QznHM-sMYCShhfp97szAK1Q&oe=6A7B25F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMFN8foFvkoQ7kNvwH0Rg2v&_nc_oc=AdpxRxLtHUTWJwFY3Y8GAuXiBLGLhiK4aWh9UeuqIb8eh6wd7kT8_iIM689WLKyAIYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPy0U8QMgTp3DTQOs13of1xb0hYJVItPSiyfiOTnq_Zg&oe=6A7B012B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_6RadEld4oQ7kNvwF2AC5D&_nc_oc=AdqvPginG_BZxERdOkFfPP9EOP4alFN5la5_uUCstDTarYmt2INJE2JqC22rRcI673M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlbE6vLyMsvD9wQWeaOUEQZ9SPKpyspU5uqnAcxYQkpg&oe=6A7B33FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3VwnQDCFygQ7kNvwHtaYL-&_nc_oc=Adrt4I3BWZftZWkE3DmjNTt8t6jLKdlUoq_R6TdLfww7kyCwSLTbwsYs__Is5vzlD0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyOULAn-x8Z98YSRI8s8MpzT6nF-8shcZ0_2h8wMHJ8g&oe=6A7B2567"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfS2vMYvVDkQ7kNvwFfVA0H&_nc_oc=Adp1n_9VutJbMPL5x3tsagP3_OWYZO54fnaI1sU7cxbrFc8Mi0P8xR
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuCza-UwpQcQ7kNvwFlwQIx&_nc_oc=AdqFDq486ABMj2ENyCv3MZ8UgBIsKmD1t2QLRKTFVXHRa8O3KMH6v-qAIbyXaeRHYBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aloto70GnIaCQKVpJ9P293GAa8iOImP9TsbDryxtPOg&oe=6A37F76A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daX0I0M4uesQ7kNvwFZxnqz&_nc_oc=Adph9pA_PqBa1nkLVbiSxts4RPo_2ejz6r7rqowwMqhASndg1qH7zoQxFvkgoCZJs0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c4ZtmMLAaTbo00V7CKe0iHGEOItAOyOnFGPIm-h5q8w&oe=6A3811C8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77kS4uzgaF4Q7kNvwGG5Y1E&_nc_oc=AdrLcDYOB47Yi9NuoiTXbtp3fhOJxxkclw5BkNPRPP4nSj6YKYkabiGmYRGKfG-t-ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oOF37QCtdhgp5wL167dcVuB-2qkXEe9xrfXT8RJGWuw&oe=6A37F2A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFxjk0ueYTQQ7kNvwHfQ6VG&_nc_oc=AdqMtzRMi1DwfS2jH5iyLip_VgSvsyJj2jsFh2OI2DH_3iw7FK65vlKVGC8Iqo9-ibs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WXs9hJ5H7lvetVBH-9Z6vxYpR3zR38CfZsAS6yRhwmw&oe=6A37E973"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrFp_4PgATkQ7kNvwFllWM7&_nc_oc=AdpJRQYnWHgm1NWVEvifDqIbD4tyyG9X6vZgcjNvlf37UQYQPHwfSJfkG-xxx_Hy3qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-abx-vOWsuf6rQEyvmX6xT-zOuRPWAVyYF7dxL9hbvNg&oe=6A37FCEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF3ACJd9sFMQ7kNvwG4vqFf&_nc_oc=AdoLWinn5vZkFdpryMZhI1rO7Cb-xSblsp7DoDj3mjK1wbd_9N01ErSmuHlkmwWVAw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aIGgDmBK3FQjCp6N9ugty12fQ-3Px6v4eGP6Igm32MQ&oe=6A37F77D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgD3SIKa3Q0Q7kNvwGoJe2e&_nc_oc=AdoJOZsUQAhJ_5T0VgIklI0In3wiEMya3IXioFaG7RNv_kYHvmBM9MXyXpRP8bArDI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MZ1t7fxJS9knqt2e21thvny8MO6yA_K20FW6Uc2ZsQA&oe=6A37E8E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpLw94z4vFIQ7kNvwFaAOrs&_nc_oc=AdrJdVDlUHyk-4lqFrAj4TVZCTY2f8lZbmwqUPNPd0-JFx1h6hj4Fa
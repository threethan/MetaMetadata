x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXVCKjFcWXQQ7kNvwGKO9_C&_nc_oc=AdqNLcJxymFSDMV_jBOoQiCTc7f1-nBmpUjVwF3rWsubqSx7Pds4NlV3ZPcefThlueA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh5X7-HDvTmnNGxJinSxn15GH00gvpjasjxZSbQNk0gw&oe=6ACE426A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3AS6qIZosAQ7kNvwHRA11w&_nc_oc=AdrQ3zzFfgX6ui05h5QidCxdTVsJ-opXRauFnZO0GcOx3Uu_ULF4JggoZtRWFgAt724&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNHRJpzp91zUgHvZ4vNehxkgqv22zc4Jif3bJnMudddA&oe=6ACE5CC8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruq2o3HSuZ8Q7kNvwE6UhOO&_nc_oc=AdqNcZKJmhJdXBsR5KlwNg7k6eb0Mc4wovPNFH7rOwACwKY9xRrQlaL5GMh-CwIfaSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ94pDr4h4M-oH_61PDYgqG13jJr2Zd2PrGF29-iWHNQ&oe=6ACE3DA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMqKh4Pnl-QQ7kNvwG1C25B&_nc_oc=Adq68BBMKdFM4zbwxoqfoPJQSY8A-YSRT3BcIOcXDg7FQ4K2IlsmRWy1XUL6_iLMIVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmH1WBbZZ5p6vok3fZmSUVobwOxsXIPMm4IrY3PgWppQ&oe=6ACE3473"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilECcSw-j4QQ7kNvwEeLKrd&_nc_oc=AdqymDbM_dYiQggT3I_XfnLeGWbIxmM-OlNZCcZWuElNbh_SEUiyDS8Kmcd-J3hZtgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmVVDTSmmIbFdkzgSKqVjCV3rm2aTLhPPnm2CoVQR_3w&oe=6ACE47EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXV9przg9rgQ7kNvwEG0Txb&_nc_oc=Adpy4aJtcGtsrjG2v6uA6I1BrhlbjZpss40q9KiYxbwjtJYCtA74hOYUqu_LoSypw7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOelPS-NqtZD8TDyOKTDDOKbzarnMn76fI1k5imbRnVDA&oe=6ACE427D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9NPwv7K5xEQ7kNvwEOw_z_&_nc_oc=AdpmpgzuAqKsznTMU7g2RaMqeLTaSy7mclQnFSPXDQLpPfFU9sGK3YFjqInlUAHqlY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPshXqzcBlJrfP6SbhoMCw5Ys1oLffMvqLPNWG-fn20Kw&oe=6ACE33E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZw69oselqUQ7kNvwEvqFIU&_nc_oc=AdpsRA3c74j3_s5eEGuK6fuby4N0cumH3fkoeWw0CPnB69j9ZrLqr2
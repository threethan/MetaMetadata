x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omzmjcFxYKwQ7kNvwEVPsvK&_nc_oc=AdoG-NWSDkzkwVhMcsaJDhqEwt0ApLcye8ZuPOPuafPiaNU2_DO46UN6MQr0IWJQ9mM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y17QgFhfJut899KXFF_3WI8GnJHKmOvBja2CQ14BwOA&oe=69FCA3EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqtXHm6HrB4Q7kNvwH2X0lc&_nc_oc=AdpRpeqMIEbOqDOm1UNNfCv_12fzM60eBUJKTDHZgBadwmGUL-ncdMjMhvZ8437vrTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55O-iKKEQNsRTj21XiBaroDPz1ZmhAzqtVcadoQJ-HMg&oe=69FC8608"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdaOU4L0g0kQ7kNvwGOkcB7&_nc_oc=AdqYb3cihW0yR-QmjYsiC0pqEvQhQMdq08GszYb-Pe2B5-ozpAxherGWaJjwMxUbO8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WNj-JR6jn-joPmSyYEPBXNpD60l4eaFkq1w_Wt-Bcyw&oe=69FC9F22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWatKNz1_hMQ7kNvwHH7YLD&_nc_oc=AdqUsb0gd9aYoOLy3Tzn6TN2sI6S_Nx7sp3ZbAoDASoeZwwdq52IatfCMWtFQXMvE8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aYMBoqK_m3FAxo65KVbYHXX2o6jG5qfkBzYAYxCkF2g&oe=69FC95F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJ1lVPXIQ4MQ7kNvwEqOu-Y&_nc_oc=Adry_TgteX8btjurS_SRqqfJNLp3eLxqnLwUsJzHdWSWHJGigFoE3Qym_tT00-pXZnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A4xmhOi41efyiogjsiRlxqS6BURZqKx20MA-rmL9a9g&oe=69FCA96B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYdVX4x-w5EQ7kNvwHLSydy&_nc_oc=Adrxmaf4G1R6n1OOT5sgAne99Rfvm8yrqhV-IzQaIWYcLxFIea5gs7aQBm45hgCxsqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C3wJBWSQdMVZM01I5bZ09G5XagJnc639Fal9uQmIf_w&oe=69FCA3FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vAIkidsdBkQ7kNvwGT0uP9&_nc_oc=AdosBxKwX-pc_lm8BgWFMOjUgSrm4_ZR64aTZKgclGcbP7ar_J8yvUy9QhAtkTxV_v0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af490KF-u1zeTYPGQ-8ubPa-cQwEbxLk89QnxP0oYhRDgQ&oe=69FC9567"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3bURPUKyUAQ7kNvwHz9TlN&_nc_oc=AdrLQwtF1qp32AbKtKP_k4HxjDgPFLKuPYwXEy3Bw2whQ5dFuA6yrU
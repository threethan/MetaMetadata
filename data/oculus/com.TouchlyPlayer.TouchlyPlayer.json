x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cck1wa4ZEd8Q7kNvwHF1b_R&_nc_oc=Ado38g5BfAl2KymMh093RIAAmWtd1--_W4QMp1S1E0WnQbuUAHajaqQ9NUsHkYI-sWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjDRVY8_KhfHluckmCEyNd5ARlUBKK0LXuoLCyU0PLEQ&oe=6A579B6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGVvUlCw-u0Q7kNvwHe5kNx&_nc_oc=Adr8IfI5ij_KhihQqRAIRJcQ3ndc1RvRzLTBQMxP1-o3y05q4aQwypV3ccGg-FwQ2EY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtLr9eIHPC6UUFsBQJ52q8JZXR9_kyiUbcdidyjIOY4Q&oe=6A577D88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-j0IK1gYS8Q7kNvwFq10PL&_nc_oc=Adp-Gnla7crgbZBJkp65SZyZEDGnvXh3vMtcPBNEqUkhaW4xTttjHAysPswx7Gg8z3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH7Cv-11qC5tZNVee8wsZp9WgR4fyNqTtWYpn5KOAT6A&oe=6A5796A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2enIo7Q7m8QQ7kNvwFSZaRO&_nc_oc=AdrPYB4rP-GMCUt5iqfklg3ql0yHwa9AVU09vcdCNy_ra8ZOLfLajiARESgSlgYAYY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8AbB3ZYZ7gN00FcRGItHDmKdUk4JdSmLI_JSdNwImug&oe=6A578D73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDRuYIRPyeIQ7kNvwFVExVr&_nc_oc=AdoFvCNzvTJhmco1NG5-P0lDEyroikL8SmeICmHmd92bDSabp2DznqlWhYm474p8c68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB57z9VzzFvFNQ3X07Njl2FUgFfLDP0_Vt6u_LEDAVcuQ&oe=6A5768AB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC1YkeaYdLkQ7kNvwFpsJBx&_nc_oc=Adrkl2UohNwX0pgLJt6sZlOoFlKHCFbJD9Ck-yuXO3t3XjS-9D_uufnl3KSCqi6PiXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuusYnoFO31rutThBVj9sCUkgdLRp87ZyrsDZvqvWzCQ&oe=6A579B7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IopGMbNkn_EQ7kNvwFWirvB&_nc_oc=AdrWepQ4VWIavTFGC9Vup6gG0umlUTDEMEeq7YbUVA_4txuBEyBoVGY0SNSTUcj-Y1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyIgNral6mPqfTk0ydWmhdKKj2kS9ZrQI7TwG8GU-7Bg&oe=6A578CE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we_uC74x5dIQ7kNvwFYw6OR&_nc_oc=AdpGMcgzkMWJWYpnv4VHif0VOoW6UygQXYYZCnOABEI43A7ZzAphOA
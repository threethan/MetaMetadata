x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1BUA9AVyF0Q7kNvwGsEf1y&_nc_oc=AdrySWFTbGu8ovSeNuV2pPjumZgtCzQ6Pm9Stz9ybHIta6nk_udK61CChXgt_TZqT2c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91VoZI-rOLq6uEDKll4wxGFIP8SY4H0SsERTLCoVH1AQ&oe=6A26D3EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZbYll7zSisQ7kNvwFYKv76&_nc_oc=AdpTPoOYkd2HO51fWEBe0myOkLx8mK3IW4cWBRjf95j9RtpWjXixT5NpaHnBlKZ4D1g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FOdFUpSsDrTHpPijhaXnGI8-TXZucqrsYBT97zF3wpA&oe=6A26EE48"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLoWaFHBWH0Q7kNvwG7g86Q&_nc_oc=AdpuVfpW1lxorLyjs4OF_pOVfwUKi7Pjb2vWZMP0k3QvbEpOXY_amTFEpXIKpOv96bs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GCHLzqHdY4JCP6ylw9-Yf650p6Xz7DKFPAM1z29qbzw&oe=6A26CF22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaOZAnEogA4Q7kNvwFaLI0O&_nc_oc=AdoKdtIzLCGp44DjbSvyGyTxZ4qxMHMCPF_kG1OlLcJHpz6brAXZUF5XKvoh54OLsqA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NlV8205h2S4C2kylvlpqtPXYUbt1rz6OWPjW8-rdNUw&oe=6A26C5F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_998RtaHuNUQ7kNvwFulFnH&_nc_oc=AdpIQe9GqXv78wXEpClaCRgu9jH4qAxsFLtRtrsPf253ElA63v2ualnnHbBwThXhRCA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v4OLSTtpG77Vh3A2ncEPkxV7QTAhzs1SSTVY1oz1CfA&oe=6A26D96B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msuhUO5xDZYQ7kNvwGCf7Ff&_nc_oc=Adp-4EQrpu9ahH4qqYbCxD0DLS2ohx8--vOfxOfoJW_itLb8wqR24ndX9-tFdFZFi18&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-BGaPNBFCDwW0c3_lGDgEqmEkxNEMYuP44BjmgxLG6Q&oe=6A26D3FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fAYtlbKplwQ7kNvwFHYdz1&_nc_oc=AdqTo0pWoGt950Wwucz2SDj05FTfcokDyxgCc9sNWLvANCOnAb5el8l-xZN5Epc-YdA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VAEoGW62LWZwd9L3FnWrRbkdO0TSNfqAeIoAC6cMjfA&oe=6A26C567"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8reytU_zVd0Q7kNvwEKx1VY&_nc_oc=AdqmUSnVEV-8TgTrc6Fkzi_oIWkct3IXXf_BTAAcZg1WkvGHzVONMS
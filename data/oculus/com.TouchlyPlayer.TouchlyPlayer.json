x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swW4lI8uLsYQ7kNvwF9HAjY&_nc_oc=Adq14iLoMiexQbBS30-giatApNOoyjvy9Vc_Y_yfHmIQVHj_weMEGhGha5-ccijIIuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw460INZOmBY_JGkMz-qxDrRe-Uj_dwtWnBUf2VEc8sTQ&oe=69CD2DEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKX06Hw2H_4Q7kNvwHVHRiB&_nc_oc=AdqptAfQTYk2AM8fY6jUjKvuRLbChtwzG9w_B2yGJ8ZQtqlNhcA3iF4cEckIvmSk528&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw__GB7b1DgbNMasWKP5C6f-4lIUstBlV6u9BY9ozF6dg&oe=69CD1008"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vJ7bHHh4lIQ7kNvwFUlvN1&_nc_oc=AdqFy-OnzPziKEFrLAj4fnvireyuEO16U7Lz0tEkud_EGXBPKa0hi_Fs59LE2VuqbOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylQin8uJvrfeYZ5BB5RFLV3cfGwb3NpivbC5Fd5yynsg&oe=69CD2922"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLB3kXVLHakQ7kNvwFIrxxn&_nc_oc=AdoeObT0X_Ej5mUI1hgxhINIMUoeiDK-OTvS5GB8Lp1UOGl9FUkBZRH_JSuo4pFqNFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBgBdPZydtHcPJYNJW7KLhGHGUzica_pi3xmog4et4Bw&oe=69CD1FF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m5dB59we_oQ7kNvwGhtlsl&_nc_oc=AdrgtZzPiZxXzjbzybb4LICK96LOtGvp6Uy13aevjLS1z8NMyRH3rXbr_a9ict_vYGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyc10l4dp-oX2M_oB6_Vm1xQhiBzqfvV8dzasxobyL50w&oe=69CCFB2B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOnmAV2b3pwQ7kNvwFzRO2j&_nc_oc=Adr-1Eifp7Mwgi9uFbC9C8OIOL8n9KMVsW-E7eX2qXtl-QqX30HxZMJD0piuYo0sihk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9PVOTcPiQfdew3pRlVWkqqel7OVbX2EJ0PlOrrXUChA&oe=69CD2DFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuuc76Ohy8sQ7kNvwHvw_bf&_nc_oc=AdpvKflZ2Zo0YgCj3FEuLq5Dk7EdqpuKSR-2kRUn2P6ls2es8BKestXoRWK4thtG6EA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxantw1fjuD5xzbEtw268i3DHyaPjTNzpfaAk6OIlg7lw&oe=69CD1F67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcT2dvEwvJMQ7kNvwGYaQVn&_nc_oc=Adp5LN4yypUyJBuxdjTdkawSNlzfgjoraiFk5H7GyiRDth_Cbe-Y-g
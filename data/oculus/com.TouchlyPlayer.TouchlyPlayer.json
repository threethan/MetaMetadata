x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD5uZh2Rv9UQ7kNvwEvV52H&_nc_oc=AdpBXhZnDjNfyOzYk_3-VYE47rvXAJ4EJlO6q48ncIGP6y0-Rr39I-t68SmZBNgjqdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5PJcQ-o2KFjeyNZCJ9iaqiGRtkTX4AJS9E2BwF4AFcQ&oe=6ACB9F6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQ8vEXCe8JYQ7kNvwHDtv0W&_nc_oc=AdqSOOF7G6a5NIGkGlv8lD9s7TMG-HST_Z6W_SsAzRckq2_DGjxXWBvcqRHHadOe26s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjHBjLtd8qAfBd9jaeAeQGUr0ESGtLdgmUL46p81mxsg&oe=6ACBB9C8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AMJSykMNPkQ7kNvwETGW8K&_nc_oc=AdqwS74y8i2XRIViP14X3Pi8hHCI4ISN8PXv_RZEa6xoW6uG3I4LKLe-RHRdUcEk0Yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzRHNBG5mF_Q9afYkXEi20aqa8mUBPnR_LHsIMdc_KvQ&oe=6ACB9AA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02duHBwWF0IQ7kNvwHraPRc&_nc_oc=AdocLAwvA5doKlnlfmtYuxmnLWqcTZgSVSNww4TZsOtH-lChbFxoMJs1vp42QZaND-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-NRaAObFzZpoxTuzaFOJSr7C6JVD7TN2WmgjnywZuvQ&oe=6ACB9173"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVvOlBgUh3cQ7kNvwFcHwE6&_nc_oc=AdqPEczlzifNCPhCi02Z-ZlRozKRqj6hG7j8_8xOcFsfuyzWP8O8sc5RykNdFDyZUok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuLeipdZJYSYhja8LRpwbgKXSXpAP5ZDVCvGrAoDr1TQ&oe=6ACBA4EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQa92vDDq5kQ7kNvwGBJj8Y&_nc_oc=Adr4UIwv9auYbmK_8nZZaynZxsQOdVdRPrFV3V4vhuugZh1mmBYU35wfgs-eePilvcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO7fF8OT7ghxkTNGK9psB6vga9fvygcQW0w4Vn62TPdA&oe=6ACB9F7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9NPwv7K5xEQ7kNvwFTm5an&_nc_oc=Adqs0Qxq7h1ZEiPKXvvuMeE3Xh_z8yHoay_bHs-bCuuEGXzj8NxkVOkJn-wUYacIejE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL0_ucZNf7nEUhpHs3FW2n_Ki9MDsCnzkUuo7rbg52zA&oe=6ACB90E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy-Jok6wWEEQ7kNvwGlCDOV&_nc_oc=AdodokzfHpEMDoaoTwx-WSrl7WUM_lFOgtxcsmuH5PwnhiXSNtiBTN
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLXwW15ehYwQ7kNvwEsecTi&_nc_oc=Adq-AC0KCtQzAipRaJg7AX5YBnW6T5g3X9c2y5K6sLEI94GUYlhbkXZBGN7iDRXeiqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bim7SOJLmqupUocqNsIRPpXM1SL7ENi7YlpEEGky3nQ&oe=69D516EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIxnatI7GqoQ7kNvwGHz-OO&_nc_oc=Adrnk0FbPfhFzDAL9Pd1KGfHlXXNMPET7nbvdosgDcLNrQZJ9P1_ZTTyO5BNjn6BF_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TgwGRkY7tyxhiUwfyNGcvrVla465Z8xzgMIxVxixCtg&oe=69D4F908"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToQuOr6zROUQ7kNvwEfFFC6&_nc_oc=AdrOO1KSIC0Fke5EemdefS1GvK4fRQ-G7z4IfK6UKs1i1LNEa--lk3pLY0eDo8pdAho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xVSabvzatFmLXTGobVNTFgogw7-N4tBiA280y_oj3nw&oe=69D51222"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCpZoq6HiPIQ7kNvwEx4ydR&_nc_oc=AdrUkzvLm6gshEJ1ukZw7LMIEXDVAJyj3fPFCwY9ReUMsyO6F_1SaDfZou76joiCCXc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jcOyjoHIvRvGxyYR7QWuFoDaTyiP1SvALS0Pf4fnuQw&oe=69D508F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRigLPzSmcgQ7kNvwEJPBCb&_nc_oc=AdrE9sq7pPnjcDwvDkzA7Q3Az5Enc-AE3vfUn1tOWA5Hdc9GXnRP_VqJS5FzudaP6Cs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O30bE6e2nzHiPNHjT4C7JcR10-ODZXhfdYfPwJWzJCw&oe=69D4E42B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUHxoVlBb_YQ7kNvwFqYV0u&_nc_oc=AdoCMTUw-tR6u54k0pal_DdVOf50I2HWB_a77QpHdN00Tm0PsnTwhxCBFOnvN2Gx4Iw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tsN5iJ6Tqj2zAOqAwS3b1kCQE0osHZoc3F5xNx0XJzw&oe=69D516FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tT3wkzh6FwQ7kNvwGqTgJj&_nc_oc=Adqu4ETO5z9MIgWzSGyjab0jTGmkyL_oNZxYUWaGm8k4-En1hm1l9oT4kJvYTl_-Zyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XqV8I3GaEzFmRIxFdG1UemiqQkFNcN5s1wK0QXg01aw&oe=69D50867"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR9497GEGdsQ7kNvwFBqDHs&_nc_oc=Ado_I0rfYin-ehmK1a7Nf8HXDRBMXRqOE2so37YnRLYhaiOyB80jHn
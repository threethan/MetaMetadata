x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGZwjIdJiWUQ7kNvwFBnKgm&_nc_oc=AdohhD6RDPp8JWAwdfkQRrQpsvGpEV5RcHGZAGDVFSEyRE4MrpPxzJO968z1zhGfh-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB96-yP1IxYPXXaLfh7N0HcAY1JvzjvQ08dbfQOvlWuw&oe=6A6F566A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOXS2hL1kLIQ7kNvwEbStlP&_nc_oc=AdqUZqur12GtqOgwaIdCli7O4H_kFpmC759lIPqGZAuvNuWzLEPHHgiCm8GrtM-d_I0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPUN5Vj6RWSfZiiUGVGvgOA1L3B-N7sWUtUWtwCutaNw&oe=6A6F3888"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LOns9VboxoQ7kNvwFxfO3r&_nc_oc=Adp7nhM8ozkOnY_NeGstDnm1ZMANW4iM5UA0uMYkjvkkHw6-bYpvQpiJVPBwfIZvYcQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUP9lQiYUgU-41xtWwZZNb4wt5bHQtA8yKHfksOQ1Vuw&oe=6A6F51A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnkMW7GUaJkQ7kNvwHjJlxm&_nc_oc=AdpECiiD6T_Fv4OoGRfqrpqW7A45ONqvwNVPqQXnSOy-0xDpCnYCbOzviJ_B6mnj62s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxBvz9pHEFjXEuKZLz8wzrAcPl4oi2Xpqr2ImYfM0VJQ&oe=6A6F4873"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VugdZ0iNnbsQ7kNvwFIqouL&_nc_oc=AdqpAJN1kfOlA5BEpdSuQ8Mb19uQDFy3xB88PSE-tYpj-eR_B6avC2ResNMjcgU4kXw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWGSjWByYk10tNa-dpq7wvZsYA4l2AuY9tfccRjhqc7g&oe=6A6F5BEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFXM5CkkQ2wQ7kNvwHu4qFw&_nc_oc=AdrxSslxWCqKZjQgQpPjJe_4sQv2LiEnyjn-HasrBHsSLodzTSFvNsXE-Ix6WO2s8ms&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB06x3KZhmWJbegUWIrJYwogpOpatfkspXi2BX5Lh-klw&oe=6A6F567D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnu0IMUaoLsQ7kNvwGZhowN&_nc_oc=Adown9RGJEvj8_RMq5A6WxvUBZoYqOQ-iNe3XdwafT-0v7EBpmP9wlUytdZprC3k2CI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbqsvT3c1LW9j8waDZd_idrGv9v9cM2Hr-q5G2MCgPwg&oe=6A6F47E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orlm8lky2X8Q7kNvwGijkok&_nc_oc=AdpKK8txe9M-LVMbIsJccxq4N2E22NgO2jUp_9Jwx0LVHs3XDdC2El
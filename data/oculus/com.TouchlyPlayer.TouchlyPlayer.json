x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTQlV2CMkJ8Q7kNvwE3bjz9&_nc_oc=AdoACFtlbHefzgiFEGbeEMZpBeNxpwPsmPv3dtaQA2UFZcEXuSRcUrhzQGp1TTo6PSg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kXkrJfc0j08eYHUPLsnsDOBOyPOraL3O4JOaz0jEVSw&oe=69EF74EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWEEnYtV8b4Q7kNvwGwynum&_nc_oc=AdpCJQI7B9zeXDmcY2mfjHnoe1CjzkAAGVX20ev4EXP6QHXo7O19QAxyus2xs07X1hg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uiDvhFWwunv-KIovwRBTVPj5JBxI9IIjV9CISpnAUUw&oe=69EF5708"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOi8UVvR4MwQ7kNvwFG7jUB&_nc_oc=AdpWfKs5jpUJmJCC0nGxExBmKZOROPfIp79JGY8jfzRgA2tVjdz7UrO1aCnuvcYfRhs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yrm4peU60SJR9ubdjP37W3xl75FTBbBz5zg1NtKLuUg&oe=69EF7022"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTUALbgkV84Q7kNvwEifqpT&_nc_oc=AdqGl5Wem0NWJoo7BJ7x5-nkrypPGoDUSPwwfsZiq5A52RcAkKxNo3FZRK0hUaToM-I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06s76Z7uK8faeeAi2yucUHro8O6Nc42e9M5E5oJUHhsg&oe=69EF66F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAm0o8K7fHEQ7kNvwHXRcRb&_nc_oc=AdoCERMUn8afGAAFvznEboSYHq2NXGOTYv6EE_M4hYfAMZ1hvoYMGfh4MZrzD5YGetQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2M7TgcX6p5UuDsnMOc54mJuHfTOUgzIR7GZxY4z1krHA&oe=69EF7A6B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX9MJFWUPZkQ7kNvwFAsXm2&_nc_oc=AdpcERCVdl0S6l3nFDyHpT0YN1Jc0MOrlDzJibdWiU1Spdq5gMHi9VL8qzwFb51-Hj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21Z3XUdyTz0_FOPr2XjnaHz_7Xq3-QZdfPu6c7O124Gw&oe=69EF74FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87q-fJOBM_UQ7kNvwH3CbnO&_nc_oc=AdrkYCGcHX99mveb1ymPffWgA8W63ngeuXDRbdYvrQt-R7N0ZvaAxVkr3JZCysE4umo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-WXlfVpO1aL39sd5Hu3Re83AvHDhLwF_cF23ODmt-kg&oe=69EF6667"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92g5jW0nEYQQ7kNvwE-feeW&_nc_oc=AdqbyEDzvYm2L7LOY1iMmpASQWP_vmRqw5sZJpskKhhF5QD_7r_FHI
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM5lfC-Zv6YQ7kNvwHui3SU&_nc_oc=Ado6kLyKHm_RE2rKwB4b6rtA6Bf6cm-d4s7MhI_OsMvfrRuRWAVOK4xBuzfr9SNvNdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqSAsEG6RKE7U0kS8dIEiByoXFT4KKvghrPW4GqMKm_Q&oe=6A7C4D2A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td1816jUEAsQ7kNvwFk0RQ0&_nc_oc=Ado2b_IDL8Ee0B0d01TubN00fPlstLqFNeZ0T1oCg16fQpL6jCDRA6p12Y2rLXCtor0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb0VjfRZ5_gNrguULoFLgS68r0IUYnD3jH7fGg-3pDmg&oe=6A7C6788"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orb89uN2fKMQ7kNvwFEfPHB&_nc_oc=AdpZG_FrDTahqvwyrPp80XgYDRgKpWNShwZQGi53wHXX2VxduR9kxO9Uj48wsvvZTnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSXtGix1lxmoHx4wsvDbNMsptisjIa9X6u5COpqsvpHw&oe=6A7C4862"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTqQs3-SnzAQ7kNvwEU7ORo&_nc_oc=AdrJnVvxDFSMZCUuwTxibg2ATqnqeGjQclp199PXhr1VzVPMeHL_nh_DYa2dAKDbOwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8O8S0e7ifvUwKqnvI0bMzu9AeamQz_x3G12zZyPfkuQ&oe=6A7C7773"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMFN8foFvkoQ7kNvwEdywJe&_nc_oc=AdoEs5dlDcOsg58Od4vLBxMCDDjld5qPwm3XFZSr7m_InYrRdhpM7n1BaHZqcfX2yDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOGZ8mLDMPLTW9ygo3fG1OHh2RfkWflKg4Opalf3h6TA&oe=6A7C52AB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFrs6qeUhTwQ7kNvwGeRafo&_nc_oc=AdopRoitbm_EMkvVmQXCLQ6WgYoOsUyhY7pBoECxH_ix9Xdjb8i9S2CoP0aP3iuyGv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV7oOeDq2UE_0sOVR3rGGGHRLGHZ6OiUTPC2H1c_49Rg&oe=6A7C4D3D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBD4f5Mmi44Q7kNvwF64y3q&_nc_oc=Adq6CE9z-d9lltXZAm1PwWgVY1wSgrbJEZc6SLy_ncqbhSR6eLkm0abxu1ZGK5k0TCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC4y2F3D8pmQVQMly0WPD4PDBiIJZZiUDQAwBimij9CQ&oe=6A7C76E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfS2vMYvVDkQ7kNvwH_P_Y7&_nc_oc=AdqXVMFH2E7-_TsRU5r2KWCUYidCLu6Gn8uo95n9K4mC5zLd9YZ1Wv
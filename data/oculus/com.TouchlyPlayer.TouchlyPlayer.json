x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvuLrrg_vW8Q7kNvwGNkZC9&_nc_oc=AdofUMh51OdrTFAY0hRD6ckhUTfWN8Mt7gD4ShY5B5qYT2i1XJyNckLadkHGTEw0-r8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sRXofdchyXr7FHK7NrmIkq8jA9UhoB2wnKZBwcE5KWg&oe=6A45266A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjq0-_FCapoQ7kNvwHKsVRT&_nc_oc=AdpwpVme1j1CCrAJetTHSgxuqubUtgRvKwQpuetByPKTuraafQ0kc8BiVxvSkzUpcBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8No8klF867czEHzh3oBvok41Y52HVMhS5KOOW6RsBKhQ&oe=6A450888"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wDGE-e33uQQ7kNvwFdpLq-&_nc_oc=AdqaBsPT1_ElnawhXowAKPiN0b8xZyrLw_37qtPuy27-n1lT6kDtbO5HTEfUZnOqrk8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fQiHlVxRG2VbFwqbLRPf94vhMk2dr1MW5KdnTf3lnvA&oe=6A4521A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXhg11Z2PIoQ7kNvwGRTaoO&_nc_oc=AdqNczHCopNEyS2XuGmVuSkAkLHAOjHAbISDX41iMHTnRmnDArvricXp__IVIh-wSxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lJ3YWzXWQFGRfXeM4xosswe58N17jTJqBB0eF1NUVIw&oe=6A451873"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s8wGrqEWwQQ7kNvwHZVbtK&_nc_oc=AdpkqyTMEaZc7bVJwZkHUX27fBMbtDcFOjA3je3NVExMZSAquASaXtJKObv52AplKCw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yM-UR6oQuvZ2dfEhkeOzJ7_OUbdSCexn1zHQL8yOy7g&oe=6A452BEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUBVINw0wa8Q7kNvwFww0cn&_nc_oc=AdrJghWUwpWc-yMwNBSWkXpDl9IgpkQ8YlCCKodHRa82H0_9-22CzNtJv4Ve-RilAqM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YoPpaUKRpniGQ4Ovny5hlIqrjZ3bDCg4AeasD2yVrEQ&oe=6A45267D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2VO2DWd1wEQ7kNvwFh6dV0&_nc_oc=AdqaddZFJ14AZnF2kKyoes6dLuDYWONZ1uHDbbRZcv_gg_usnZMloHWKpsCb2Zawkjg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cl4f7YJfK2QEDRUHF-R3WLm36sKKMyg4LE2Dhi67JAQ&oe=6A4517E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvFdsSn3tUIQ7kNvwEwb5Kt&_nc_oc=AdpOXY3BKv8ysfxiY87AUOMra7a2cM1AymHv4BSLJi_A5Y2iCx6irm
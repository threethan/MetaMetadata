x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkfz1noLQkQQ7kNvwFBrZEu&_nc_oc=Adpirw47QOH_gPjBKGkkqeDrn6Y5RrMbrEt_WOoBSqP5b7MMXzs1ZUZxHzOKCidbrKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcZBJArKh5exY7xSKGO-nksRw43jjexpfHXLmsLhxmmg&oe=6A71F96A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOXS2hL1kLIQ7kNvwGce1hD&_nc_oc=AdoIjxVE18kdRpKrkVuEf3uaGR7R2izdAau7RY-9VWMwFNvGSxJbwbxobUA7C7xYcDE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyKVuJi_O2MHZcE2nOGTuxZLFLlpZVSxghlGyksJNj3w&oe=6A71DB88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LOns9VboxoQ7kNvwFO5NJD&_nc_oc=Adp05TmsfDWW0KXjCxYa4SnaqhA6ytfZlxqsSD0Qca3euLMZeLeC2-HL9A8tl1ZPCik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIWzzscWG4YNFLm6YO-P90HB_sYIbnI3LWWbXblhgqdA&oe=6A71F4A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb4t50NZYIIQ7kNvwG7VBOb&_nc_oc=AdqdPKpxoFeWA4sn-JsuQbZdtG10MSTIP3OolYN5wxKLYC-gCxq8C0XofBOpauwbk9A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhjtvuuJQnOm__mzEAiUsc8uam5_rxYuuehG1UIknjgw&oe=6A71EB73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5330Wa_ENWgQ7kNvwFtkcYO&_nc_oc=AdqiNe0p9eD2l8z8BGDj_Sv1iGVcWE5Fl7k7xtbWWgjpMMuRCPCL6Ql-5Osimu0JPcc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw4M4ftcBy5QoZ_UEyERFbuNPP4DiMSm8s4zKwsUEaSw&oe=6A71FEEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDciWNm_fhoQ7kNvwHUJsEn&_nc_oc=AdqvUCq_7irw3Fn61qFMVLeTUw0nX4PBlVFOV7tkU4A3pc-DhkUP5q8P1fGHqbXfIXY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGACtSUd8hrTyIT4HzA9Ww1OyBlBx1yaBUjdvMNPnZhiQ&oe=6A71F97D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T60rp7ItQpoQ7kNvwGs-8fA&_nc_oc=AdrwQVuNFp9EVKQrib2ICLNEiKE9BKd5HFQ6r_-NXrZLduMUaE3bABUi0zmMLtRLH_g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOPH9M24LHnbNWxHjXPHF59Jqs-Q-rHQ5SFpGVCZ0Iig&oe=6A71EAE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orlm8lky2X8Q7kNvwEDGUlD&_nc_oc=AdrI8fEThN-9Q6-BAtrjjcLGZ1jyOxAsymO_QlXJKAGLxygX1mKjHl
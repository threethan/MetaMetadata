x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1EaQuBozogQ7kNvwFezi0n&_nc_oc=AdrvjGPMkHmBf_z1qE9jXYGIEi8MgOY1wHX9GGOKu5C7oEvFzsAsacUVUhstQhz6bPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDScZhoUdK8Eg6j-NUYY3_ZQ5mP7K9Nx7MTixE7l3pgOQ&oe=6A5F846A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJVj1LUBw7UQ7kNvwFoGfdD&_nc_oc=AdpbKeAl4l-fWLrI_8g96jGicfyr5PahgmzRrBDAsO6MWbMONKsuxGNvG5spYPJ8n5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0GVkgNl2o2UBMM7OznCoUAldvLjrxyHe6nKlt2WBCjw&oe=6A5F6688"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7qiYoTQGwkQ7kNvwFvBFTr&_nc_oc=AdqD2KsnLEGXB2VcISmkY5jZ2z4rUYPd2IdHka9ezlZ64k59U0Qp8G117jcg_EN8J2Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ2bcKASFI8Dh_dsBz-yLr-f9XzA0Kbbv8aIJ6PuIJSw&oe=6A5F7FA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQ6q8Isk668Q7kNvwF-LdaN&_nc_oc=Adqws2x5IWIOEU4iS3BrO3H7uLfaQ_ta2lKdHTkL9NYR8VHcMIlWdoMTr64Xy4KvuG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeABW5RKSYio38dHhYi0TDqyhpUzdzGiAKWgfEMkkFVA&oe=6A5F7673"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu3okeScLBMQ7kNvwHVZ1lt&_nc_oc=AdoM3-dPSXohMwSweoSkXsTUy_6s08bOFa10vIpi-hxMdZZhOXoFALD8AMZaDbKSp_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq3DUgn-r_DF-cn6MTbzXj0YbkUlwPUmtP9jwfCPsVCQ&oe=6A5F89EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goU1o2I97OsQ7kNvwFJCqHc&_nc_oc=Adp8Rm0DVNsbojdsU4dwG5t_ondMBqiAe5_YGxDJyBnbMnaIggIfN6vS_xzP-GfOpgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJbuOS3N98sK1GPzZmWF9W19WGWUbJsXiOaBGv_tS7FA&oe=6A5F847D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sj80fKotjUMQ7kNvwHMpzeA&_nc_oc=AdoB2PpYdakFrKT5WJGURQ0b3AHEm2QZpsxgJcPHLhj5Pqk7aRbSRroZD0O4s4JgIAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi1pMIOP_VPTBIkiGJnh7Dw5t0Bmu5tXU066hgUG44hg&oe=6A5F75E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teJyfrGYinAQ7kNvwFTxwcW&_nc_oc=AdpvHiyu07p4VC2-lRn3j3gzwBvWbTP7SNBiQR6z__SamLEG0O5dzm
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39TZ-5U9xUsQ7kNvwF1NI7F&_nc_oc=Adqm1MyY6UrbTqL34n8KouZZUq_3n-ypih9dW9cAFhJHEcP7JuIGC8VGTeqSABMWzW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEt5_ebfDbAzFnRW0xOP4qKC5VMdZwIF14Cpgv-xKdsg&oe=6A9C296A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl9B0dlEF38Q7kNvwGBviDr&_nc_oc=AdpGzfBn77ToP_GXr9ZaSZIxjZy3KOBzOHHrnwdVjipQWj0bpjtfVNZObZquZPgRtsc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3OFABfT1ZNjL7wjMEQZa-qyCMKa9BvzPyUDo_rYWpzQ&oe=6A9C43C8"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZrItYKWOaUQ7kNvwHFmteA&_nc_oc=AdrwXJEA0h7TbAGpmB8Up-tRL6qgGuS15kWqV5Ozv42Ax1kXFdopbByeBPkfoGDnbPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpjoHX0mlkTxL1GISNR4OgKZcZlNYbaibdpNZKqBgOAA&oe=6A9C24A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_Muf-E78L4Q7kNvwGwgffk&_nc_oc=Adojf94C0ejL7Zgl79IOrdfAXQ7frJMhD6oIsqUG4rJvnFfXFKYCmcJCovurYlHimQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsXWw1JkgmP-7r6sU08JskoU3d0bZOtGvjHqTUfy2-tw&oe=6A9C1B73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjTTqKoJkDwQ7kNvwH03Qup&_nc_oc=AdpSML0s80eXwtY44n2Y0vFQR2IDDlbKCFtWupiEoN2u2lr7Nq4XsYIzlRPHGkjUIYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ7GaoxqMwiyHwjDKL6vznVdkwniouQnHtoN-Na_JL_A&oe=6A9C2EEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CmCZvYVyS8Q7kNvwHJKWVb&_nc_oc=AdqpeEJFrlHd_wXL1pbfb4wUtVbZlmrPl5VXBXkOMXLEi6dhAcrQGM9N0l7gOXYdogM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk3a22J7OkCzNLziawTVtV8Lwr7Et6yraUh7fKcMsJug&oe=6A9C297D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSxHr4I6sZIQ7kNvwEfzysP&_nc_oc=AdrnOWIz7M3FGkKJrRYa1FkBlDDaE7mX2fsmSCK8tOyCyEvfjT7MfCjqZawahKeDoV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxbKITLdmUZI8Az4ofVzJyjT_9gQaX-cJheYAOFVDu_A&oe=6A9C1AE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0TNnA0A19sQ7kNvwG0YL6W&_nc_oc=AdpLj5oxlVF22fMw5ETZspwZkaNhUO8QHaLuMtket9NkEnHtUscdSY
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeuSOjlud0AQ7kNvwGqQ9GF&_nc_oc=AdqQ05n8nZU0lt8yUIcUcbaxUqztE8atxR_ZS-DFjT1Co3O8cpPPIzMmb4d_kWjPrMs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mnxj5qnWdZmn34mENLmMqudpNNDl0GINQHbsFVfSGng&oe=6A106A6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urprRvt1aYQQ7kNvwEnAhBm&_nc_oc=AdpBWGrg5JOrRyvuBaoTcna-S-oKiSqhQtIkNvYoCKicq5NpaQr5UZG21nbdtNt-YQM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XTN4j9fqv9NoW-9slInK2J5bDyagQlGypYzvbyRy6bQ&oe=6A104C88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbftd3cH2lAQ7kNvwGrbCbW&_nc_oc=Adq70VeEJqQnMcMmRxj_MOJKxxi5LKsf1WTlrtS1yYifrHfezx5oiMf8Xdn3oOlhEH4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af432jWWBoDLcMJECa_5F0rxFY8Oy65sWPuUnlp502fskw&oe=6A1065A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TgvYZhPiRkQ7kNvwGcreT6&_nc_oc=AdqmVjmcJ-yqh8uxMxp2mVYNNTjikAB3IRYO5RX7h4sWMSSOkIPV_hGTikcBzbcZz_k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BbbrbhuI8-gIntiiEMNX8iZw4tuscToajOPqbHPhmTQ&oe=6A105C73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n97R4v0YmuoQ7kNvwGcNs6B&_nc_oc=AdpfwxyN2g-uJ6cAdT7XPaFp-YqowDHKLa1Hjduhqb3kkJJ1nX1qlWg4tyBqZauEi2Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XlVE0kkN_K2jto_uL33nIqQLhx67VSh0fAf4Yuudapg&oe=6A106FEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ_TmNPvN_MQ7kNvwHzyUvV&_nc_oc=AdqkPF0jwGSJxd7lZzw8doix_B-8UrghOGQXcHzCsWLNisINq--Akx1jd7DdhVxqX6I&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g1XXyh7I_rfX0LiOkrm40OVnBjoxaZaiFzqkvEGzZQA&oe=6A106A7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JF1y2TagEQ7kNvwH2omcI&_nc_oc=Adr2Br1l6DnOVr8EE6Efp1dedy3mF49I5MhkxqasXbWArbmKD5bok9EZ_GDWU-LHWsM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M9rmCB37rKr0LKgmZS2TVs9Fs4fVznK5lqqo9nsycCQ&oe=6A105BE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXgO6PALlxIQ7kNvwHFPW8t&_nc_oc=AdpT7PD_IcZ2qrpIfLseymcHUKSWwJ4WvZePX22vMpwvypgJGeeN-7
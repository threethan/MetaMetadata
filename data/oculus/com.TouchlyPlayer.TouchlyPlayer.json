ait_1008x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgod6x7itBAQ7kNvwFoKnhu&_nc_oc=Ado75cSK8fpoKTwR-Yim4c75fV0hz76dxYoCk9cNARxwvqkaX3OddNAcclSgCcRTbkE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAL3ube4ZBmALwxQ3D7B6JwUBWhTT0XDRkXxcFioU6qg&oe=6A8EC22A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8MAejNk8bUQ7kNvwGlk7ZL&_nc_oc=AdqDf1DuYzXB7fGw4iR1sdkWUXpV1v-WOeMZ03FqgOmiMIx9s9TWQ5AKBJMhQhP_6QU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDdnrWZE6vp7AXCDkTDmpDWusg6pMcqstWS2esYgonzw&oe=6A8EDC88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgEPRjmYQPsQ7kNvwFx7PzC&_nc_oc=Ado468kXJggLanbDrUseSOCW-F9ksKlGWrvLTs0bngzrwVNGMyvrX7IU1fb6guI7w0w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbrPoiFZkhXgx1nfvrteT3_pSd-kiO5FehDcCCghn0XA&oe=6A8EF5A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bK7a_sff0x0Q7kNvwHbfAIN&_nc_oc=Adrxr6Gt8ZqpUy5HsaosZpDSD3OnsiHXn1n30RS1ybrI7-_5aV44dX0Vb86jYvZZvls&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFvkB_N3GUt7MGZrlIEWhIVY_KRrFhqn2VqW93t8ePGA&oe=6A8EEC73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP-Zsv54WFoQ7kNvwF3Sq_o&_nc_oc=AdrUqBvFC50iP-47omc_nhg5eeUmw-FxXTxM1p2EjJa6-N_CKkMdt-6DugX9IttpuFQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPM4TZe7X6xXNI31ebAHlsivxCy7uOfri_1QC4xiOseA&oe=6A8EC7AB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm4dyv1GTogQ7kNvwErU2fD&_nc_oc=AdpGCkjI-BVgygz9Z989HN0SJAXRlL24o1qOs9PjUqNvd_R4dn2F93PIS6h0GEtaJZ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkKVWE7rjXc-DcFK6p-e0_VczyXeC40AH8-UOzRsyYtg&oe=6A8EC23D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7uw8GEUriYQ7kNvwFcDUra&_nc_oc=AdpuFx-lv9OwUVRbNKoYsGqiwm_9vdCLTrXTNWUh2UCZbEGUsJ0mhZ9RIvtX094dAtc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEA6emJUsWwLT1WbFiytcTatfis9oYMI0FjC7UdEwi1w&oe=6A8EEBE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY9Kal8qAl0Q7kNvwHtXJah&_nc_oc=Adp0I0f7apzM5riKthDUkpGdNHdPU5sDhVXw
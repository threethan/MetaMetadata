x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAG7NpoKgDwQ7kNvwF9LClW&_nc_oc=Ado7EymhVzB57qaRKOb8xTd2tr5OsNw5kvwuECIikSZyGG95eHGQk-8GAq9XrHEhBYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86qNk2sPMHdUPJ5GCdeBwJ2IppPUGvNLu15nstYAap6A&oe=6A3BEBEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vAVtPGTCEoQ7kNvwEYSQq8&_nc_oc=Ado0nVyjgE5z82w2qg0qvJgK9VxYaV60B0tLH1qO1AoSRjO4eDZ_Vp40oD4ZrneYgLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90K1axcWOtqlLB-xLA58cW-_n1CdOEsaIWuMplzPC5uw&oe=6A3BCE08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0OPqkjcpYgQ7kNvwFMUnXZ&_nc_oc=AdoK_bX9I0Oqb7HedqA_ls_zTJpPTWOlAMeRVa_CyvyNpXIwncubd6fK7zMEeqRRm1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kdm4eP5z8FXQ_4-3Bh8rUcZtDAbuS0kza2ClC25qzqQ&oe=6A3BE722"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMY9rz9oUX4Q7kNvwFOVf7N&_nc_oc=Adq1LBrl9XSbtBpHhNjOPzAPXDOa6ui5jkwXyhVsYDZDz6s_xNTbdc9bOViRGB2ISEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tHZWRtjsvzIzY92Sz75aU2xCUV1fpmCSfy4bScljRRQ&oe=6A3BDDF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9GOn_a1hfMQ7kNvwEo2NuB&_nc_oc=AdrCl1De7l-nSRjpGv8fhSQTHo1POQbltZ70BaCScwtb7JJeCMjuYdG4oy6VtWw7vdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xILZz0kysYWN7GW7uFH2TrB0PujURTlqwj9Pu3dCeqQ&oe=6A3BF16B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF3ACJd9sFMQ7kNvwF4Tpr4&_nc_oc=AdqzQ8Al5dj6EmRtMaotjnezK8Lp8sZDgAgaGM1r-OCoowArTgO2hPQ_3vTvsiNZ0-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZSK64SbG90qWti99V05obv3fAEUMEcr7Q9VWZxoqIrA&oe=6A3BEBFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=554XKlKIIv8Q7kNvwF_I3Ww&_nc_oc=AdotYu-F2lea3k6U4ilrF5iPKm-gm1dXJdomDjmEwpoIWuNwtBBhgnz1exvTTm1ipW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W-81NU6I0c2gGBQHGUsAdbqOWPkh05dOdboZvoEQZTA&oe=6A3BDD67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_Q-R_Jb1M0Q7kNvwEkrQ8e&_nc_oc=AdrgLxXQiTD4EqdkdJ4epN36XGuxBpYG2S5qd6XC6ZY-_V0CrFD8pc
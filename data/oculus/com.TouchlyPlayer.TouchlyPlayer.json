x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72cZydW3OKMQ7kNvwHt9lZF&_nc_oc=AdoAhF5JfW_VuCXVJcq9pHQVUCrOlPRbMbBIjbS2KhjbUu4c9cmA0hDlMxJklj2z7WQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eq5VX2oCnXxNZrfb2d9qpsf33X9DWMkZe0HWauqK50Q&oe=69E63A6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suD436X-n54Q7kNvwHyMTtG&_nc_oc=AdrGUPfUbXp8DdUSSNDwWe6K4zbZGsLrYs84Qo5Z_g2cr80FPlpGHAvak61TaP-xOPs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jTmgYYi4TK4zgo2zVO1SO84nKguZSvu7ZRgMcSNJzdQ&oe=69E61C88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhGNk7pPPkcQ7kNvwFaqmmC&_nc_oc=AdrLnAEjEf8kFJxmXUFh5zgUoAlxE7a_Jqn30kDsELnX3PeqXuOns6wUj0Zj8bFYtRU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JNanQqmn3BusaZkGca6Kbc_QKhvyG69NV0GjRpm_4KQ&oe=69E635A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Odru9ZHsTAQ7kNvwFVjWvb&_nc_oc=AdqPRGhLhA1KOzNVBLjeSv38cNxsytoI-pAwlXVuZMKJ0dpfaO86dpc0ZNx6ZZeicPE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dlK6rBLJEaNuovF27aGpdj7b3mozLGJYn-D4aUxHSoA&oe=69E62C73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnL40qC_EU0Q7kNvwFKc-Yd&_nc_oc=Adof8AeJ7wi7iTuDT4Rx6YcOgYuJvO30P8G3nwCUFwHFvf43jD_q_i0eHB-qb6pMtMQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21EIW7tmhVamlkhsPUBr7vN5RwYG06Oi0fr4Dc3b4G4Q&oe=69E63FEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZm9pSXABLkQ7kNvwFLafj7&_nc_oc=AdoBrrgLNLWiTfhWY470ao9N59O0mloduOs1X6ir7BaoGZN3BM5WP-DoMtu63G95raY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UbAGlM3-9hbrOZZoT5hiJ-lOB3QZhhqOkhd_zwywHJg&oe=69E63A7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_nWgdjpHQcQ7kNvwHUrsvd&_nc_oc=AdrzjwXbMhY8-jF9ZgSgb58zpYhBmGBkntOqKKqnmY2LA4zhy-Sinv_7ohftmDu_Mi8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S7g-0WY9N2oXDgYzb7QBDQHul9cmS_vW6V5s2rky31g&oe=69E62BE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JvfVYJSreQQ7kNvwHMZBqo&_nc_oc=AdqhXVMhcR-zmuBCfXZyeFeimFdDodXECntpKNdzB3hpBj7uN4XO9z
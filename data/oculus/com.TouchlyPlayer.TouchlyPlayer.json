x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_cRAbAAlEkQ7kNvwFQq70U&_nc_oc=AdoQyEqT7aYkQQOHRR3g7gAUqRlyVmJ0iurNRi41p2CUDJgp_rl_CZHlGaVnqntxsps&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ra3bu8u-fX3v-NSq4NKjF9YeNJJ5b4BSjV-nZytJ9Tg&oe=6A1AF66A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEFYdLFtjDkQ7kNvwG2xwAw&_nc_oc=Adru2iuEZsEd1u71invQEyOB0L6x3cIPJ6Opwh2mgWzeP-41sXnrBWcqzHcc4aRNkF0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YS9LmIpokMAQVg4oWRz1npY9GH_PRN3UXbC9URZOS7g&oe=6A1AD888"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc0v3wySxGYQ7kNvwHHQjm1&_nc_oc=AdrzPcm8NoigaYFKEJW46ThYjLA1WAhr5ZaZ93H9rur2cz5vtKVTdjDs0N0aM-FwOfM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jXjstEVRCmKQHxwQHkVLAKyi5AM85tdxdcCwCjgXxkw&oe=6A1AF1A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh4qw7G4OqsQ7kNvwGK2OZJ&_nc_oc=Adq9AXnXRj5NPfF8R87cI4afo6nW6WIY6DMWAs9bHbwoquMMkt_H0v6cao_33AszwbE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m2nlNd-QpYF2j687eY9Xrcm92kU228-4V4viYlQQnYQ&oe=6A1AE873"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oC6w4-MCcsQ7kNvwFE2BiW&_nc_oc=AdqKscZodi1nfxHnE45onKmkIcfXaW1K0zHG0PdzGYu7rrANzElndKePpfJ_7bCUjYU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cqwfzN6iYM7RaMixFHIsZq9EI3uo7Pyx1beNCeiMBeQ&oe=6A1AFBEB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzN0G9LkQBwQ7kNvwGL7RZD&_nc_oc=AdqDkQFJkEBxCx62wpriNJnrjbBDEHvEDHYkaFyrqxA5tVn1PeR1zq6YPnFLMZ4gsY8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yQ-LHEAmPNODNP8nSqTXNKHHx6YtFqDG2zFrnxDnpKQ&oe=6A1AF67D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvCekl5m6gcQ7kNvwHkBBKi&_nc_oc=AdoURqRWRGEA8H2whbBukOKslq3zd4_dwV-rlsf2JavnS0TiakZhgxgmWiPPeY3g0fc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ri3NCdGN1AeIBpcrpUAZDenehCuDd8yrT-5wLy0dcRw&oe=6A1AE7E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4xFPZKcAb8Q7kNvwHX5KGY&_nc_oc=AdrS2OMZKiLuUxN06q8aNvwBA9AiPf814SPhPCcqsPD5J7zPATfl8v
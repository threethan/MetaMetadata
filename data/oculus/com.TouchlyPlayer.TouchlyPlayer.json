_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KJs_LCGuRQQ7kNvwGnmnmV&_nc_oc=AdnnhFMYh9am6m_K0L-3EZclL1MglfEYnTffNtG21McOgI1axOv_VdZTpVemNiFXxWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuGugbF3o4usEc34yjx5Cp1-f9cC4x_EZGwdDyCFzs_yg&oe=699C666A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yG2nzvrXUe0Q7kNvwG6rGRh&_nc_oc=Adl_EyHt24o8raJTyDLGLHBIHn4GnR0ALMDkG-WjuoPu5KhOkpiOZnyyL8cs8IL_FAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvAV64BhwjNfkqRiszXe9VewUj9n_5yU234aT4HxrYb4w&oe=699C4888"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvcN0i0FHTcQ7kNvwEYS-Km&_nc_oc=AdlfxN2uOrpsRec1yHE2OX14uxXPnOKF8RLRx3yliLDbbsldl486nbpdeZa46Z7DQ_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsWvRlb8CYnEU-j6kG9bFPyD_F47ZTJD962ldMak4bnrQ&oe=699C61A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhNd4i2K72IQ7kNvwFj_Kmd&_nc_oc=AdnByCUK0FL06Nb5wzHIwp4TaJiOiU_p4Ff3nloRqbZHdw_GlNcG7w8Ozd-GnHU6DQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftcWM8A40uczqZ401IuUPELcnYGobi7CVTzHg-UN7UEwg&oe=699C5873"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R9h9mV_UswQ7kNvwEDloM1&_nc_oc=AdlfIhGh0TxnzRrXzfVV8y9CGyqBjPAxAHPvM1mzr9tbr58sFLLZShhkhs-ESy3k0gw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs8SGJOhuRJnDRcc-NGx4Wz60ZaWjiUAJn0LYCjBFs-Uw&oe=699C33AB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3rr1mgHMSsQ7kNvwHvK8ck&_nc_oc=Adm5OAlQaWaXfxpyr2fDPKr34kONxHV3hr5tGm5FvaZUej2YvgSkT6QIn5R_Wh51mfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv49hGasHLWMrxqG4xM_VHUSlF4Dnk0jVNcYlQp3sVgpg&oe=699C667D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=542TSmLWrSIQ7kNvwGFMYcU&_nc_oc=AdmKt5OXLz9HY3irVToWpetjrxruGNDF_Ab4OHATKCR4GOCvkiLfx1ieYabm12q9qEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvhpSULZiatJ7uinmFUMj0FUqPMmz362mV8FYyz6oVWGg&oe=699C57E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_3NJd8RKWoQ7kNvwGThoyk&_nc_oc=AdkXcuPWkXsNSBXNN2Khp7-11zcveigFbWeRIm37MAUq7l0HTiXUd9hsnTPAOo-z3Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvWU1bDGnBiehSaXPh1Lbd70fy2Z6iYLPYOcS2nafmlrg&oe=699C5ACE"}, "is_concept": false, "is_tes
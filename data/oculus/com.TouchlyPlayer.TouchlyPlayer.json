x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8fBWOC7Io4Q7kNvwHUMJUE&_nc_oc=AdoVLBiSnQOZsJTk_cBOqvALEd__U15CSLoQQ8ITCZGTr99PrA3uJ1Cp_1E9amiPvnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBpy2lBi7LJQHLqUYF6fdSL_MsN2n2lU95v6gm-ya-YA&oe=6A95CA2A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYGtnYSlwfwQ7kNvwG8dvCU&_nc_oc=AdqZBigByKIPKn6lfMV63juTwbtZ7LyFEeS-057vUkXBWCqHnm19kK0-cp9w41uMYKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIu5EeT8icktHXrhvEM8yCXguSO4UKEOJB1lFzLfuFew&oe=6A95AC48"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLd-08IHjgQQ7kNvwExKmmu&_nc_oc=AdpvcNtcxmeBf0WEX9V2uy49nVODl8FCy1F0K8IcPBmKKA0WICgA23fLhXTcruSgsA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUA70Nb9jWyV8oiSUP3wTh6W9rTYmFm0gMvwMsIiYtcQ&oe=6A95C562"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVLaGZfcHZwQ7kNvwErbNyz&_nc_oc=AdqVmVOAGZczZRy3-psM8e9psWy1AFxhjPCFBKAfuW26KFf0gnRsoEZ0FClD802hJaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHToco6YmYlqaE-7fASuNgvLelMiBuqpMcQ2pNQKwxVEQ&oe=6A95BC33"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZp5kLCgpYoQ7kNvwHGVJrk&_nc_oc=AdoXg3iY6yjRFPhdDfHJDGCeaEdmehtGiHNxnLFYh4Gj4uz05cQ9KNTPFcOILSiwL7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIEuCGSRaQsDhOoc6J8h52k11F4jJ206FpBeyF1Ogt1A&oe=6A95CFAB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCCB43a-eJsQ7kNvwEuBwyN&_nc_oc=AdrF2uLeyTnwAsUA-9JckVDNC8uiqWnTqNiTon_V7TzWQSpwQKbTb0rFU5pvRjafo60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxE50ndZ46hun44GY0uVR4HAL2CuvP3RCBW7OViCNZkQ&oe=6A95CA3D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOor7xXxm-kQ7kNvwH88HZr&_nc_oc=AdoOjm22Tmq14OrnbKnY5w_qSFZuGwUITBH4r62ZXY7N54IvESGT5H0jNOsni7YlvJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9xDMVo1-uMYhH8o_QvKXvAd767TXWSRpa6qwlASpvXQ&oe=6A95BBA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKBDn9wusfgQ7kNvwFJUQAj&_nc_oc=Adq27J6wQHqq4KXRYqSa4EcNtFKCuO1qQ9eWVK__Ut5d7QNpd7mf-b
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qvdw8c5SAoQ7kNvwHcwu5w&_nc_oc=AdptUdvmnBD7goTzNrrQQ5f1s8t4oToMDA4mCY8lOD19ocTgXO22pQTNxqBnJsOsag4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG-eSSBQ2hN6zm2VoJ8cZzeTXy1MQsITIwV_Zg1qM3wQ&oe=6AE74EEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEYFT_Sear8Q7kNvwHR2Z9X&_nc_oc=Adr4Hh8mrIDZk0F-e_CberMtbWZUwnfjdwbbECgfnH3s9S_LojZ2KG0jXFuW2z4kYjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXCmvX3W8f-6NWw9i8N9VeXsAXbjNsdUwtf7v_mmjLTw&oe=6AE76948"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sStGf1aNqjcQ7kNvwFr1v8O&_nc_oc=AdpuRNe1Zh8LC_0Tu7846SBx0Ao4x9zbEYWpCB2Repnh5tOYjzHVm-ddGhO8BNhzHu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN7J0UlOAdTEkeZR0BBSHKR2D0dVEWI_zAYZOBf0Gmzg&oe=6AE74A22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOPmjmDRI90Q7kNvwGBvuq7&_nc_oc=Adq1IIuuFac0gLijO_Fy-o70U4amp-5IUZN7Cw6-ZHrHETnGvbiwtez6ahOQnOYyHnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiXLg-LE1WBdxl-IUpdy9E2EV6ZYKcGr3nVoL_DOY9sA&oe=6AE740F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2-Cw-8OMzYQ7kNvwG_MNw4&_nc_oc=AdrvA1DnoHQ07C8jh0vLCGCYWQfTWA6A599cKutMI4VHGLCm8PhVqc4Yp5RpO_TmTlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCnvBvwmqa_S523t5MyakeQoCOi9TPxXZMhbEbyjbsBg&oe=6AE7546B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtDj3TPmCnIQ7kNvwFPDQxq&_nc_oc=AdrZXTzg1dkiE7pz7G5wGDkztRZQVbKYy6uquMGejcm3w3sgioRsBVkAdpjqd-ytSU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMLEuolY5moHYxgC6cFimePehFIC-aH5-Jj2mLKWkgVw&oe=6AE74EFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uztfVrBqWCcQ7kNvwH1xlhU&_nc_oc=AdpO2eXtr8is2pm401Zpf6Hg7Vmo7N--KQNPlzjgXwmKAzRb2_JF0sJEC7suUtG22hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBP7WGU5ScQWA9gldFqEDZgLCFLOfOspfHceM4SM551A&oe=6AE74067"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHLpkzjhw3gQ7kNvwHsTD1U&_nc_oc=AdqmSUKxFrXqpxEiLY6XtaaO31YRtB7FKGRelQhNFT9mlPVj_4D1LF
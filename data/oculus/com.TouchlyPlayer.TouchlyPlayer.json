x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HmOqJn1j8IQ7kNvwHT_3iN&_nc_oc=AdohljtxXAgnIsNLqUej5yEZlR6dPD_5Xh3CVGzy-5bxc3H_CUWwamkmCY-HjXYvMl8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hxc4uW9fdPC0iVewyBMhpsvOKqa9ijFxv4JBI7HF6BA&oe=6A0C75EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX3tIGHC4doQ7kNvwGIAsrR&_nc_oc=AdppHEl8AboNw2f-9_T5BE73aT6b6pNfQhzanRr9diSTZJKMXKc2xQ0BuwVvpRlPdMI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HJiqLQp_Y_YEMsb_8J5vwI-OOPajjPPX1xeSuMlBITw&oe=6A0C5808"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-nKhmPMp5UQ7kNvwFXEz9N&_nc_oc=AdqeGQ8Q3JQptXdY8WzDgK7HyHbhHBCV1ZsM0FpVVE3jPv_JZQvu6ZEKCvUWIOE6YSY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dc5BS81KXRt5cXfwajweEIVDCu16HOt6-cIZhUlf4pA&oe=6A0C7122"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSsZOhdhOFwQ7kNvwHXAz2q&_nc_oc=AdrtSa_pn6fU6FFLJA89XVcufNmytNfoh7rZnOB0F61whJujaxT7HdjaVijfNDs7lOI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78uQnDIEKhD0lipJAyt3hqCouIcInqGAAMRT-elscL2A&oe=6A0C67F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwLL4ntsF98Q7kNvwF0Nivt&_nc_oc=AdpmXGM71Ahv5OhviEQVl5dX-T0LZxzMuSJSthD7pn2khRu_2IGmDXOPciaMECljML4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-7s6cgim6ASYypI_kccRIq3FoOey0PwYjs9vV6ktZ4g&oe=6A0C7B6B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixv8px-3WZ4Q7kNvwEI5nf-&_nc_oc=AdrvnYDpENN1lVvh4nfFvA0yqa-ul90NzusW6Lk9ERURSL8mo9yo6-G1IZlc9M76iFY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B5eWaZvdo833P8_8Rxy4PrRorqzwZWc1WMQ-3hpkbww&oe=6A0C75FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0cjeFWx9nAQ7kNvwGmr3XL&_nc_oc=Adq9FCpcWG_2gCqFEO8VuPTKYXDnMWzgsnXxR1OJMSAf5XhAuuaIY2e94ULaEYaQVSY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fkngOqHaCPQFvNw33kKHlY-zYY-20NdiK_gF0KDkUTw&oe=6A0C6767"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRpXExLfaS8Q7kNvwFlFgB0&_nc_oc=AdpptiXHUk9Sa_pril6BT7hAXE6lZfA1ibMpToHUwzx61BQ1_9Hrf0
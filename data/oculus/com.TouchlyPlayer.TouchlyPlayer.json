x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39TZ-5U9xUsQ7kNvwGYAs_S&_nc_oc=AdqLEYw27UqS9BptvmAxyYt0FVKc77zsEGwigPlOmVA2TgZihcGLkyx_nr5hr6xKh40&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRA5VieJltLWPXzDZbAOx9Kf3IvXGnTmYhhivC94uorQ&oe=6A9AD7EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl9B0dlEF38Q7kNvwFpqxGa&_nc_oc=Ado9bLsls0pgNtZnLL8kzA2gnUqYBm9qByog9g1UBuXw9Mdl8-4TMKLmZXdI9fRA5j0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_a6it6SggmWyyeg9-0Oy-5Jy6vlBG767uYGzeZhgAgA&oe=6A9AF248"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZrItYKWOaUQ7kNvwF2CYDr&_nc_oc=AdrMY_jaguSwR4grx9JSmjOqUcSObtXIpN1-FMBnxOEF45-lPvNmbkgM6hoiORJPjhg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZxHPAgJZxbHD1auFHxR6WB2O690Zpe9lj493je-H9QA&oe=6A9AD322"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_Muf-E78L4Q7kNvwGICUKw&_nc_oc=Adob6FFK9jCchgdw6xGoGqCRjDF0OLQm0BF-3uOacP3bo7yIObhblg7DNEBgsJh_wxA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2P41B5oeiJdB3C6JPE01i_ghQCHftFInI_w6FREtn1w&oe=6A9AC9F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjTTqKoJkDwQ7kNvwG6kdhq&_nc_oc=AdrN7pL6CWN33LhcwwNf81UxK6tj6PVs9AVwGK_WZ-UAX3sf0Pf18cTNeeD8BUjV_GA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMqn66RPKTIDoacC2hgSEQnFx03rFSrSU4_4MoSpdwIg&oe=6A9ADD6B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CmCZvYVyS8Q7kNvwGELKdu&_nc_oc=AdpHULh3GAhiPaCYAgck4-0aP56G3-9ZX0qLwIfoSdjKi4xrPah-KOi-eFEgyGeXOUY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsGaiMoDgNpef5LquZZfCpmJ6_bHZz4lnf_78mb4BrnQ&oe=6A9AD7FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4lvli-VdboQ7kNvwGlLHzB&_nc_oc=AdpN6wV7ITeKjg-hCNLYfUDzkyfwlptqNNWgdwFMkCLtiDywjiRCGNWOMgs2pBj_Oho&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLGdfkQGu-SEp7cLO4MJtfK3WoEWp8AO35OpGk-OOROA&oe=6A9AC967"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0TNnA0A19sQ7kNvwF3JVAV&_nc_oc=Ado6nZ2U_wshNGWMkmLEuALXSlmPEjsj0b7m8YUWZrQXUMqoJ6h4Gt
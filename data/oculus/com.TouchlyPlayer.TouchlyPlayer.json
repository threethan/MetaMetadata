x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tupcIbsMQN8Q7kNvwFilmiB&_nc_oc=Adqf58N1ZsniJ011U1OhWZEX41sAc8URKf_I7WDfPHKL4a4ILEjwTAXLuuqe6QZamMs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA6nFGUZpL4iZaTc-HSw5mOsE_EfhL365hUdma6zYBpg&oe=6A661BEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg0XTx4r1woQ7kNvwHjSJn3&_nc_oc=Ado6NJJvOxto1FNys56U48iCHpvdvABnS-HeLAPEoq0NThaFXXtlKRpgW1NSyO7cpbA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5g5MwmbgST_0G3cA0JdCeZX1KOoX9V85XlOp3mICLug&oe=6A65FE08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnYELhfopEgQ7kNvwEzzpe4&_nc_oc=AdrWhY8NvJLRab7D7QaJdRg3nrCtCVkhm18urSrOai70_mn9Vks1fvzY3vmpXn-1LDc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBxmN_c9P3-ng4Ru3aOC_zI_InzPURog3mKRLOAhVIMQ&oe=6A661722"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGl74g5JcPMQ7kNvwEEtlJZ&_nc_oc=Adrs6KpffPR1kD6V3QecnLAvAxBKSkmKoIBXp-SQ0cII34_3PbFR1E0Ya51kWKxBHFc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK1q6im0baBh54fDDi3y6UztrQVvR-WUaV23HaCeKbLw&oe=6A660DF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSpTP9BQlTsQ7kNvwELDFPn&_nc_oc=AdrIUupXn1cZvFakI-I-Sb4R2SwDrhZgAVIGGD82JpNlXwriNH0k8BJ24mOXgRelphw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBizTiEXJtcpmZ-WzcAuritliVGB4J3mj9a-AkZ9x0hXw&oe=6A66216B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrBbbC6y-EgQ7kNvwHHmr0t&_nc_oc=AdqDtAU_773K7oBb_SbhB8tVl4QPsPVxnmq9ZsJjEiyIYLZj1ZtxapGU0iox_SrE1vU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCommfr0cMu0WcpHwa6TCJ2L9xA5Dnip3l_JsVT0kkyfA&oe=6A661BFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_W_4L0zDboQ7kNvwF3mfGQ&_nc_oc=Adotcl9KXBc7O-x21fjSQa3PmJU9KOabTHdR1szanPmNXs9EDKS0BeMHaNW_djh7F18&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8m4QybNizYGKtaF1FXWJMilMEPDt3ezs6FayGcBCapg&oe=6A660D67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQXbrb1vp3MQ7kNvwE6E4V-&_nc_oc=Ado0RMgfmrHUq09pChrYe91y3X3iNIQxZx_zNJDw3Ke4gHJ00O7chm
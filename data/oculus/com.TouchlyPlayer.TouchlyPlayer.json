x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72cZydW3OKMQ7kNvwH4h2s3&_nc_oc=AdqRyg6MC1HHqxIJDoDDZesU245Y3EFpbFBSCU98nmcK8E6p-NXwYccdryaqQ7BiwNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xTVnnn5NLNhzxq8WMlNxp09yTb5VBrcO81raAm__BwA&oe=69E4E8EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suD436X-n54Q7kNvwGu3agq&_nc_oc=AdpV3Ty7zzi9Rp0Ng54duT5Vzs1od1SSwNTMDp0-hp_oQZy82_FYyjWSYuqJoUvFCRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rp4tnmXxRqWcfbLNopma338boS9---6zbjSCdaDIwhg&oe=69E4CB08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhGNk7pPPkcQ7kNvwG2IerH&_nc_oc=AdqBJ3NVv7yfsbzMj9VyKRtUISksZExMnhHwjsobji70qWWUdZVTJPAATQMxq2ojvRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RJfaQkWBQfgNVrk6XmAlSo4PuqrmkZpjzKG8lmRyrZg&oe=69E4E422"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Odru9ZHsTAQ7kNvwGOopT2&_nc_oc=AdoiWL6Eu4QymAMpAt9pcmMzf7wSM4nnqmw8xvGLVR5OlXZKxAB0Aif4KIi_5aDn4j0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2q66jP5FHiwFlDO20SLVPnWKyVgmrw7GX3qMk6u4HoMg&oe=69E4DAF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnL40qC_EU0Q7kNvwFPt0sA&_nc_oc=Adq-Kuj3WJ9z3Ny6PLmFCkiGLnMRPal3LXTll_U685Erg0-PaOG4ZtHtC285W7d0B8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OOdlC3NAgTyIDrJNADADyfJ_X0CM1cyG5RdDGLLOppQ&oe=69E4B62B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE79OacM4PgQ7kNvwHkKENj&_nc_oc=AdoHisJOfAs31XiAsB1U0ZKxL2C4X1C3EALr3hfmc-KFpWd8uU0UQcd6KWG_gPx98j4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38vuYoGUj57AaN0IKMEcx7S0FfeEGz9ibm1krnHmVxeA&oe=69E4E8FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wflMgmeXEqwQ7kNvwE4YahX&_nc_oc=AdoyLFwDtBCB7m6smzk6GAe1gj0idU_A1COWr2KVdUQlu0YUNj88V-tgU9z8Auf57GI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j0kf9BYSITn1fivVQIeH2S-UovJhtCM2GvZtLbDrNmA&oe=69E4DA67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JvfVYJSreQQ7kNvwHpIKvo&_nc_oc=AdqWyZ-SapkS_itkG1FKamClj16sKHNsMOsLl3LD6fLxT5mJRSpg3E
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUS-KuwVaxkQ7kNvwFsnkAF&_nc_oc=AdpccG5iJJwL6uExUXwiIgB_VRQs-pCW0cW4ihqMooCTZECRjJzScGoNaW4ng59Pk_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83d5gcyfaHtysqt7-pa4UEc05u4e7vGh9hVVxpDUWqAg&oe=6A3E8EEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vAVtPGTCEoQ7kNvwFiHPFF&_nc_oc=Adr5gNMFDH162UTS2-0xkwzFhP-X47giBKmeNEOpuL71mxy8G33cREgFO-v-LQzks44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HKdoYfpzYaNemtAxSII65Rg4PQCWNy-sgN8-32J8kkA&oe=6A3EA948"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0OPqkjcpYgQ7kNvwFhIo0v&_nc_oc=AdpvNG_YwYsKHHNi4lUdhXETtjOW1Omsp4BUNES-101kEJ1L74RWv4nKVyoI9mBK3Y4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WQ1MGgo4vxPYpflWq_Q70Je727VxVKv2fnQJLR52QZg&oe=6A3E8A22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScP1sfUSS9YQ7kNvwF8Zecd&_nc_oc=Adr-Wu3V0xzlgK-DPb3sc1pcPodLsX0P-Ov5eQZnOtDAVjVWTb5BiFYw5PIsuLkGrEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af987g77xJZEdJCJKdUpL5yJSXi69PJrddJBl9tgGlAtaQ&oe=6A3E80F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFH4Elq7XacQ7kNvwEqwvG5&_nc_oc=AdptZdqHdrq7ir-BwwC7Q7an6oil--cbOUixIrT4rv31S2I3F0Ta-BuIJrLGhkR1HmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y2YI_oOaJ1v_STwpjlpS5r1lJqhYuPvJmB1CfCzEjHg&oe=6A3E946B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJE2kls-RooQ7kNvwHANAL7&_nc_oc=AdrOc_lhccWKgSblqj1aYeNEGF6RGtyCSm36eWoMxzOOmURbR2HSKiGpDv5jfbSiGFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jg7PloudJZuUM5C-5W2_RweJzg61uewKAtIsM01ktxw&oe=6A3E8EFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaxjn1MWnSwQ7kNvwG2G5ZF&_nc_oc=AdqWxBJZ5_TpyAp0DhryDU2bgFZePvmHOMop0QALLkBSmx-r4bBKJBixSMH76TGOWLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YHK1qGq8YgHwJV-JjsKHv1dUuYAnkTFX_i-_QWldiCQ&oe=6A3E8067"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_Q-R_Jb1M0Q7kNvwEuf4uq&_nc_oc=Adq9v0r3ApF9EU7ff4a4pXRNTn3xiuF2gKw5qTc18j4hEuqDo33gLy
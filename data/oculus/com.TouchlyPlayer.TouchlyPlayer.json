ait_1008x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgod6x7itBAQ7kNvwHggNab&_nc_oc=AdqI2Jz7zHdGoe7vIPteTRjJ-l9q49lW36WmPwUPUkvSTMDHOogi6znk1gag6hwivQ4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL_zBB9hWgFAOzjWA31cyxCV3jasBlFjqxbCY6-IBmlw&oe=6A8D70AA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfCW7CesULAQ7kNvwE9viQX&_nc_oc=AdrKIxbE_AZsBQfxVWCLRPk4RdKtZh5Nx_b5A7VquUU9ZgpHmYzFa8_YjsRFsDBQJPQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLWFdJlA2q2eciD4cZynd0OWgFWTgkzr62RHotUvMQeA&oe=6A8D8B08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9nf3dNQpCUQ7kNvwHJZ8jh&_nc_oc=AdozL4j8fL3twlsQo2g1a9q7thzEBRCSzEM6132Tc5s--_NxTaFq9yw-MEgAf9mk1sE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfR4hJTEnlwF1GtRjOY5ppZ1e_yopKNuby6EJfbGRrQQ&oe=6A8D6BE2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bK7a_sff0x0Q7kNvwHOt2XD&_nc_oc=Ado1-m3rJ3QdcqDYiejq7b_d2Flm3FMY8s230BASl2oRK1zwHmcLYcuQ_pOm9mFrIMw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwRl4GZdfIGCJ_Z_ncB7sXmnul7H7F0aLun1GoUU9hoQ&oe=6A8D9AF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP-Zsv54WFoQ7kNvwEw3Pug&_nc_oc=AdoNAPc-P-XGe69IDPZOw1KPkic7rhVmpAJHOlazORAp_YpxP8X1oCGs0UOUwLVrmGQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEz5Z5nN87DRVYsBH3w6WyVxYckzdUxjY269fsttN6Mw&oe=6A8D762B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm4dyv1GTogQ7kNvwH2gNHj&_nc_oc=Ado1ZTel1cAYuzjhLKQDO1LKimc0FQLw_NfZcq7Y96hWmhRrXfpvGuYGBFzW2yVZFsQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Fw24fwrM3Haz0XLC0dsrZ90r-ceP3Nf8bZPKBxQ73g&oe=6A8D70BD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7uw8GEUriYQ7kNvwFs_FYV&_nc_oc=Adrw5kqK9BZlTZqhZ0JeBpJiVAO7i2gZNx3rdzA7PTDlMk_i4KE0vnYWYc_gg2hm4d8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFlwRjJB0FtV9h67DsY_aY4j6wM1RM_EJl6ptarG1leQ&oe=6A8D9A67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mXKYp5YQG0Q7kNvwEJWszY&_nc_oc=AdroA6eXnUYIhkqafq7tXn4K3LinEIOdUdNq
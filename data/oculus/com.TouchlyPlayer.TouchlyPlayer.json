x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X29rljelKnUQ7kNvwEmV3w_&_nc_oc=Adr4J0LdWzl5XruF5jIuGahbADmoyZIj72jIWAOTGIL3QW8n3tzi9PPFuOUlYzTU2GU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN0XlGO6s86CuYDpQxWPqeukyYt6BUHV5t1HyIKswnyQ&oe=6A5A3E6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGVvUlCw-u0Q7kNvwGGFpqq&_nc_oc=AdrmjCFK4wkSguZ8Bk-VFM4q3wGoZqAJI0LouITwCNEOZOQ1hKjgfR_LT-XollXw8rY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj5Q5YJi57XmHLbl0v-bPNh5Fk4hFjUlf5xJKd68r2QA&oe=6A5A2088"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-j0IK1gYS8Q7kNvwGr1wvW&_nc_oc=AdrfX-33WmPTs7cKnBJUj24g0VR3Iygdx-JOthRPbxnavJFwpUhg-H0Sna2S44z2328&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJI2Kdy9M0-2zYWh6goUjhZnQpPXwsLZ5yDPbVRKHH3A&oe=6A5A39A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHfr6vl-jYIQ7kNvwH-HKzX&_nc_oc=AdqUaJ-kQMLM40uj3Cs9zzhWbAnpr-WONfQljRl-qJ_C2csKGYCYF1qJZczg6bq_AdY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkLVV5vVayXsDFeGgnKxsBRTzQWjy-t3iYkjt5MHvfYg&oe=6A5A3073"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feeIxNb8jHQQ7kNvwGZymam&_nc_oc=Adq622TZiQ_5nkrCj-LIUpUlA-prEOFlswLjlRCmZTF_jtOykdGH8_cPk_cBP2WRavg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO54zD77osQ-_MaD-MltYE2lOo_z88XjmPaqUFhQfLaA&oe=6A5A43EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORPoT0CApuQQ7kNvwHOsHQu&_nc_oc=AdpXj88DHiDn4IS9GewneEnKtSfcQwbbugYRSTTuOsYl8_vGXLM8Y9S7R_Egs9Ze8mA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBovjI0QJCBYYYiInGKn1rpwIf283NtjcO8R_KNmt6F-w&oe=6A5A3E7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zQXFF4W92UQ7kNvwGJNd2a&_nc_oc=AdqyCgemZUxUBPwCgHSMPauVnxvzDQoKA0kRjraUEkdKoYop2B6tlPlbGKe2fcXprL8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuP9OPqoAk81F0zVBMOFGmjOihUayP_qsRRhX5CYUS0w&oe=6A5A2FE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we_uC74x5dIQ7kNvwHLZHXl&_nc_oc=AdqfQb0Btk67tnxsgGKC5akekIwrc8GgD9mFG-mXm3gjzmh8DW5sX8
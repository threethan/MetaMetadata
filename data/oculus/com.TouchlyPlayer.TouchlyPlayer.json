_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn7QgPND8p4Q7kNvwGekfkB&_nc_oc=Adnt1rbh2GTjc5kDVDryclSbs74eZjdO1HH-9ynWEZCE5nMNuEWqrSi9TghlTB890V0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuHzSOsjzlCYLz4s0KFNw585TmJGSrMt9YwgQMuoJ6srQ&oe=69A1AC6A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQJ7FcSs5GYQ7kNvwG1756A&_nc_oc=AdkH-ueB0Unopq0e5TYZbZd8Sh04ILRHjG_XfboxUtENIHwbrK98PINRV4atuo-2y0w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuaaMruwDwoxlUnUYJmMDOblu4TFvVwgqP4r-Rby071Vg&oe=69A18E88"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTimrfBTJicQ7kNvwHE67xB&_nc_oc=AdlrdXOacD7k-9QGpcLTJQVocgOlgiZNf6gSvqrcfnCNqL0S8KmftiHuMGjxDwba0CU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afue-q3cR_bLk_R6VMlrzcRM3aSmlHt15Dw7fJ-4QW3azg&oe=69A1A7A2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2owINO3GwpQQ7kNvwFhlDyd&_nc_oc=Adl4sbqevaNBTZhQ3Hae-YCPrJkEmx-504xTays9eAXPtJInI67QziLnRzRsHKeBUyY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afto18LpX0TrVSjZlS28L-Bx02_BYp60rNt6TFfbMOPHHQ&oe=69A19E73"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcRWZl1wCAEQ7kNvwHFXx66&_nc_oc=AdnToGGtTCpKAnD2Fu9gTdtKSo2qBsTObQS4veBnM_jmVOczAyGlZFJrfIt9JhfNZlw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvJLM5XCMmgvGzCpByYx5PCEAXDthS91c9m5Hac2ibj2Q&oe=69A179AB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5Ehqk8RFbAQ7kNvwH7dmUR&_nc_oc=AdmPNPUuU8LCEuJRPZ0m3V5M5NHYT0j4E1Nmhymz9eXPtjy8k6kKbE02O1IG7PDXCUA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfunQstUqcEblh_igyDrS2h4fMuNltBSlJP8pDpwsoDP_A&oe=69A1AC7D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siyfF825TFQQ7kNvwEdiod3&_nc_oc=AdkfsZdB0OIS1NOFVtkVyCc3jVphujLSs9VxLNFlUU8FgjMCDqNgApgIbWnAijBVP64&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuZCv1phe4oH1v63C9-8bSnsZqT4AtIa7rHcD2Xnw7GyQ&oe=69A19DE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bwv84jMLzoEQ7kNvwHYPASJ&_nc_oc=Adl4TwIDwHMWnYUz0PrzY3lZgcXLn7tde2J-InS6CgMFksu-TR4_c03plsEEizs-M9w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsZJwJH8Zb1eyk8Ax1g6mtWKJDkh52hXJfG2Qbe3saKIw&oe=69A1A0CE"}, "is_concept": false, "is_tes
x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkfz1noLQkQQ7kNvwGKQV6f&_nc_oc=Adr88z9hov1UnSjKeT2p0WH2ZNJbArivJpup6EYaW3tykrSIG4Y5YgOZ2UqJv62NuB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6Ub2wSm3W6UFu7Uh9l-GRDX2vpP0er7Ue8Y0T88i0xg&oe=6A734AEA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKULZUCNEsMQ7kNvwGmYITU&_nc_oc=AdppTPtJwaKFdQn1C6p61De987wntHp0S567pcFgoFiWZN7k7d-M0dbiR877vr70bmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXrcg4xT698YBez-GZzq54RBxensmnjuZlUjPVzevXRA&oe=6A732D08"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQA-sNqxdt4Q7kNvwHqPMi9&_nc_oc=AdrqqiMcMafDB7SluwU70pAcxYrhQBWr3SCfxNpiw0mBD3gSCpGt4Okt6-AhbSKE67Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX5eAmjTBVeM_B6H4dG2gqcWTvVn5ttFAh-MxhOZHhVw&oe=6A734622"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb4t50NZYIIQ7kNvwHmDy9U&_nc_oc=Adq76xJ6cGKyIkeT6g_tvuUuSNXaJJ-ubG4J3ZJyA3YMM-aIcIpIT3wV2Q3pTzImIkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaeKMtn_EWEtX9BdDDeR30K_KG3LMMKBLvPRO8E43zRA&oe=6A733CF3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5330Wa_ENWgQ7kNvwG6Cr35&_nc_oc=AdpLGbB-hq5Jjl2mMNgH4X9wIZuOoBNEWZ4kioWG5cZtPTQte5juAePEFD7Al9uWUrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERdU6fYZcm5c6X_veJcdiRNWxynQdJ8otsdiqZmaIDkA&oe=6A73506B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDciWNm_fhoQ7kNvwGQ6hBB&_nc_oc=AdprpJfgDxVUnZ3iNaltDLxBNDtIiAONfbcjMrX-h2wMBK-v3SBvldhVuukA2KxnG5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBkrFgZm2mRYA7B6cT3sUPhKu6OFP3RMuWQv92F9VsjA&oe=6A734AFD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T60rp7ItQpoQ7kNvwElEIZp&_nc_oc=AdohI-f2uvrUPxG0mwxWQIYgG6o8X7FtagIWMEXvcLTcWBGz6p-xzhwNoVldSSjrMvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKR7uBGkTvobVyiTg6w9MHv3ASy_YPraRmyqXJzAvxYA&oe=6A733C67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAu1KK3za1gQ7kNvwEOOTkW&_nc_oc=Adorg4DrSFNDpxGbhAzfYN-6zmlxE0h8jwkxkmqbPjQS09bADfwS3z
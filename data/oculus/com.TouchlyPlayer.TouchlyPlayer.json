x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxLGF_hkUiAQ7kNvwFitAXw&_nc_oc=AdojXpLtG2oJcaowfIWnhtrkFbvi54OlSmjkF2XuSn-8CROHQjacdFA2_qTP4bxq7o0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNoSgf2lpdirU_l7zCAd7X8BijeZb8AYdYib3WUK65Aw&oe=6ADCC2EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp0EIbcdtd4Q7kNvwFtgjVS&_nc_oc=AdoeDqUo-BbTOU35KG_Y1nDGsUiMzhhzSjSnbCKV6OroXM5YppLdc7wH0VfxeOSk5wE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3EUGHjIO5o0mHCMx4fO7BKiCXA7VJkflBf-oTPzeuug&oe=6ADCA508"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2apbsuFywkQQ7kNvwFW2A2e&_nc_oc=AdoQDNVMHrEKSqQIzqRxfInvvyOmbzcaFY_Odjam_yD0jL61czihuwFohPQ5gbKxSiw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtxAmPyo7V3mRJBqF9CwVtQXcOUMSf0F5OM70XaC6Pog&oe=6ADCBE22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJLqWrF_KTgQ7kNvwEOZhf9&_nc_oc=AdoQQvOrx2oKE7C_LRMSMKPsqe50N4DS7F_fuxaxwJS_4xadBDK4BmxSHxP9nr1C6C0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn3rrRZXXvR3gnzZhxD-D8f25gJt6EFAJc8wmupIksZA&oe=6ADCB4F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FiLRPreG-IQ7kNvwHVffEg&_nc_oc=AdrYYiIkLZo2ESWCkKAf7zWsfql899d12g2QUJ5kvSPruciqxKqiGjNtQVXW2oQUtu8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHdDqSuB92Mb0l-yZh2xBthS6CLOEfHM4sYwnLjQ-BOQ&oe=6ADCC86B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFHRF8vTlLQQ7kNvwEQRICk&_nc_oc=AdoP0d9ZjQA82ab4xwnGIaepA6oGMj6dI2SZ9PxaAXDbrOkuNo1Tr4sag8VfAvQSeV4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJsUg_NjnOzfg8Q10_eDEhTwgWJqXNze1CgKJc9dF55w&oe=6ADCC2FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oLgjMlc5R4Q7kNvwEvBcNA&_nc_oc=AdqPaBZVXvNEwaBdsKywpFqZOUTy-7ibL1CmJAvr5yLxs1B8zSPkyVSha5p8b-if3IQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLxCsOkdAdbKUWxdLAvVDktPy5gSd7-Jhz29GX6c9a6w&oe=6ADCB467"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5KJDLuCYosQ7kNvwFMhnHY&_nc_oc=AdofZkCrqHszYKiXVQgGlh9EhaCX6z9pmoPjw8xeDIsxbiOv5CerhF
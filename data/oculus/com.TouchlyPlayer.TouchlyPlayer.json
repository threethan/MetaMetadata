x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXVCKjFcWXQQ7kNvwGU33yG&_nc_oc=AdqdpACMw1yCjTfG5mfWTjGOwRXGpMTuPUYXtUAyaGQk6rryNEgRqlU2sStrLmpaAKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrZ9-6mN1XQTfL5g8EoYngeg_Bt_2HLQ-l0YvipHDCxA&oe=6ACCF0EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQ8vEXCe8JYQ7kNvwEHXCq7&_nc_oc=AdrTsrEYAjBFz9OGDOJg0ntVocDixVzDqVQdjFn3y3r2EsNvl7EjH2m7tKaSPLerLFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObrnHGp0-CteXZkgqM5c4jThCrlrEX8o38Sljpa6nTiw&oe=6ACD0B48"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AMJSykMNPkQ7kNvwEYWx5_&_nc_oc=AdpsbdD67PWV7O6UMUOIerMnj_p9VNH4PTBNbgo9TkoaQNW5RseLoRh0E3eWWEGW6cU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdxPpqfqkChMIhx5s3qdM3KEwga7m-kLmQ-YEZSCcOAg&oe=6ACCEC22"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMqKh4Pnl-QQ7kNvwGlcVEX&_nc_oc=AdofvCz2GYhaFe0F-jIoaazkHXoMKLxlmFoN2AJtZnrgd2TTjmbAikpBgXWP3RnuIDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrHVXEiqXXJI_ENKesURRvqsMW30rFJngN6I2WP3aXwg&oe=6ACCE2F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilECcSw-j4QQ7kNvwETzW09&_nc_oc=Adr8QKp_uXfXEcBop01A8dErv0bhM9exS2-At4sCCP6OEadN_8OLnsJ4-dhezFUSZ8w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd44BJbZoxVTSOsW6ZkeIO4ZFzOFIqtVNcITux3w5HmQ&oe=6ACCF66B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQa92vDDq5kQ7kNvwHxH3sj&_nc_oc=Adps67s3bSI4CCzQxUhb7U84w5BJA6u6rwqNU482YxgEsoIqPaTdp9dARmQPhXT3Kxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2VsepxIUzRZIp9T0gKGOj_XQWKVuf-5X1W_2XexceKQ&oe=6ACCF0FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9NPwv7K5xEQ7kNvwGo0gaC&_nc_oc=AdpmZxYpVvZ8AFcolYB9ow7CEcOm4u7swRgK0mLo4pOCY-bVC9TzsvpLAizPNiw0Z3I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCMcXEDKuMKLQgH-wdN2OklP7kzqsGK0a0Y_faAtc5kw&oe=6ACCE267"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy-Jok6wWEEQ7kNvwH4oIZJ&_nc_oc=Adr4_PDb-VKDL6p3kByb9X4tSs2V-Ll2YSFQGAIgHOIdsUukA9zm_Z
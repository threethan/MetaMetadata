x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1QcC1UMAkkQ7kNvwETxF2P&_nc_oc=AdqHxOsBYC5TcTsGi9wUnZyd0MSEeJIo2b4AXG3OGZUN9YM5_t9KlZMDjDO131WDbsQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8pAkGTrMC5T2sG4D2yjrPdZP8oWiolfN7jnQn8qFvUw&oe=6A53A6EA"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmOxA6PhHQoQ7kNvwGi9-65&_nc_oc=AdqCwsXRqPJb5WIkly0OdS_NwSqV11YUFAuDd0jV59JEs7dwBBeFSLEzKxXenbHeB78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDimxGGboSlGMTJXcHHudREYe0rfWWVALTie8j1m3z0qg&oe=6A538908"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlnyW-i9nN8Q7kNvwFLFFZ4&_nc_oc=AdonKCqmkiJiog6dkZQBLCpHk3oQ6IyV801DtVNEA0ttTL-yPJbvNXwBz-VGS2TYloE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFm0-4X0fyf7RvqothlZLzzIFWWF1ruwDn4V0pUdK0AA&oe=6A53A222"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6FXxr7z4JgQ7kNvwEoa1sL&_nc_oc=AdrPYX9VgwUXTNOGoHdGQkk3mwPVdkJvrqCRRygAlNwxihHZGlVP-EuZGoxwW5ICEvo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0cqy_MtKCyXFq7YpMxANNkKhnf3KPRgfTfo1ZZs4T6w&oe=6A5398F3"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_NgIrZ6ivMQ7kNvwFATQch&_nc_oc=AdpBPMQQxfggUEs-Y2WGVmuQyKuAyU4WighmvgvWCbgeF8w-YoHxTJl8xuRnfkOuugE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE4jx74NUrszRB-2enTAdDnNolwxJQAKDpnDbF7uV8Rg&oe=6A53AC6B"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJH8zFGhRxkQ7kNvwF6Lh4d&_nc_oc=AdoL8lhoEBA0VuJqUTDHdr65aQVNBkkwUcM9o966gYiEEeJgDbCiO7YUZeaVshMeKeI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT-gT-tb8pq9uCJ_0SgfG79pWwgdAxjATWKWpOEBToBQ&oe=6A53A6FD"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvXa8BGg2kcQ7kNvwGygOTh&_nc_oc=AdpZkPq2eyzZmE9OsFSCz7NNISXNYSFQmR4VvCYmQx8Qdj84ZpyF5g2SBLfhQ0WkcjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANa7witFrk1FYMyyDTLz24P2YMYFHoZC2t6pWL4uMDPA&oe=6A539867"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vWg9OiomHUQ7kNvwH-S8Bl&_nc_oc=AdqulgkApgGLsYqZJ4k3n6lkfRJ2VkXYDJheCVEy924UXiXE9h8gMW
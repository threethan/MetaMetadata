x1440.png", "id": "689214925857210", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003285_689214929190543_5643177486200567691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X29rljelKnUQ7kNvwEmk3_D&_nc_oc=AdqksDxivwtKqQUvE2gqEWr3t-S6qspDi4Rd61iGV5K3VGMbt-D9HpCjt2rBXwMKpUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb1R4AAFCYva3F0GzyUeCIc3O7d_K603MUxM7NtKi0Jw&oe=6A5CE16A"}, {"file_name": "HeroCover_3000x9002.png", "id": "461701126068230", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207242_461701129401563_8672844182522431488_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_QKa-rptR0Q7kNvwHA4U_e&_nc_oc=Adq_L3196jOv1vDnkeztfoWh_Ldpp4JRjKpJxm1TmG3_OLqIY_T7ycRh75U4yLJagXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVVAJWZFtr-hGOr9wrPalEN810Tly1oCUGOFCIyLIkSQ&oe=6A5CC388"}]}, "id": "280734714282447", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "814339426521486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974812_814339429854819_6369558032204571690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_3VMDEfsZcQ7kNvwE073Rd&_nc_oc=Ado9s1OQskr0SW5iPcZHNY6UhBIiqi7A1estbk5Roh1gGf2Wyh6zltqpsPo95h09oiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9A_jsBXOzBbo3tj9ehLGeJu4qxEWlDLUAcvwSbPQ0CQ&oe=6A5CDCA2"}, {"file_name": "2.png", "id": "502647738253174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_502647741586507_5004657426589419612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHfr6vl-jYIQ7kNvwEuO9T5&_nc_oc=AdoA-4eWLYg8uiMzNwlscxdPzlv5gzAb4Kot1C9ZSMw9eiwkie-qsFeXMKY3wx-QGQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIkZUVK_Q4k3BPd4lKHpMm8mvD_D7pG4JnQCEW7N2Lpg&oe=6A5CD373"}, {"file_name": "3.png", "id": "3272109159694171", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422391_3272109163027504_5744939719503962374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feeIxNb8jHQQ7kNvwGX0Hcn&_nc_oc=Ado1o9QM5H_Y7Ny36W0dbHZQODXl67XHJiOLp_mdPFLFE_9m1FbZzbTp_pNUpiUbfCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBECqd4TkeR_Tc4jP7NRk2i4njIvg6VgZKlS8BS9Eqt8w&oe=6A5CE6EB"}, {"file_name": "4.png", "id": "1076538199676004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234365_1076538203009337_4076126856633674673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goU1o2I97OsQ7kNvwEjb8Q6&_nc_oc=AdrIkDSf3Dfz2zufJew-sbps8iuahljWjMNctPUUKryf_12vtsPXAtOSmQIvDm_shSQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDueczDxxomcISvo3MLJvtnc5rf8buNORAWTRef_hcBFg&oe=6A5CE17D"}, {"file_name": "5.png", "id": "664149641982555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974554_664149645315888_1329152045526098657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sj80fKotjUMQ7kNvwGCdamJ&_nc_oc=AdqhGifv_uBOHBl4gZ6eeZOxbgrRY_QdP2G_PLzmNdeZMawWCvxmilVWuT2Kq_U_CQs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJkSG3hMgXIdU0MUlkk_Tf5u-QyZo2hYYZCyysJ3MUSg&oe=6A5CD2E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Touchly Volumetric VR Video Player", "keywords": [], "long_description": "Touchly is the next evolution of the VR video player. Turn videos into volumetric, immersive experiences.\n\nIt features:\n- Virtual hands that react to the video environment.\n- Six-degrees-of-freedom playback: Reduce eye strain and move freely with position tracking.\n- Passthrough mode: Bring videos to your reality. Hologram-like.\n- Play in most of the common layouts (180/360/Flat in Stereo/Mono) and formats (mp4, avi, mkv, mov, webm).\n\nOther features include:\n- Local streaming: With our new server app Touchly Cast.\n- Hand tracking support.\n- TactGlove support for haptics.\n- Advanced settings: Rotation, position, color adjustment, depth adjustments, etc.\n- Depth and Color matting for passthrough.\n- Watch local or remote files with streaming.\n- Customizable hands.\n\nImportant note: To watch videos in volumetric mode, they need to be converted first with Touchly Renderer (touchly.app/renderer). Only a couple of demo videos are included in the app.", "short_description": "Touchly is the next evolution of the VR video player.\nWith its own volumetric video format, it makes it possible to:\n\n-Boost inmersion with virtual hands that react to the video environment, haptic feedback included.\n-Watch in six-degrees-of-freedom: Reduce eye strain and move freely with position tracking.\n-Passthrough mode: Bring videos to your reality.\n\nOn top of that, Touchly supports most of the common VR layouts (180/360/Flat in Stereo/Mono)."}]}, "developer_name": "Touchly", "developer_privacy_policy_url": "https://touchly.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Touchly", "support_website_url": null, "website_url": "http://touchly.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266659659055759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_881936023170402_1455568698335658606_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_WDfMI5w0AQ7kNvwGjvwJk&_nc_oc=AdpFpKLC8AQ-0z934vRXd2N5N7pEuKv0x5yQPjalZnZPixe2ONBBI6
HhubvWDjRwNg&oe=6B104FE1"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeNck93tgmYQ7kNvwHE9diL&_nc_oc=AdpAPgy7dOOeuXEJI4_wqcS8qDlAdiqDnen6BDfh1q8-NiNCqaMq4ELdiomjWuUyo2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVY0tA3hYxKcMN5YBen4TeslUd2ZgFexJkn05JsxT2UTQ&oe=6B1042F2"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAfMzdKFqNQQ7kNvwGYuTeU&_nc_oc=Ado5DNRh1w4kexkDt7qNinGmMTW8Bp017CNXGfl6tvky-Bj80akGvbLoHwDlEMUjXj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVx6ZuvO9lfs9WaZHYd-tiQd-7sEmhmtXldOLc19i1LQg&oe=6B1054D7"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCz1g6GmWQgQ7kNvwHXWhUe&_nc_oc=AdoYoI_gcIB2qLwdtAJ9wgtBNYywuOm08GXX-S0iVuIlGMHjREjzg16hzkqRAmh4uoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIxs60Kwe5CmsbXsLwf1IeZWv-jtR9KrlwSHQ6ajMTMA&oe=6B105A25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_kHcqNIgKUQ7kNvwH5QDe3&_nc_oc=AdoORshFL4QdsKVPjgFdj8eFUyYZMDDq7EX031_1IP_3uUsMmAmiHRKVj7uWVQMkLvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDyBe5nw-LfYPWDDaPNH7qvOpTJgri88cEG4XLVRLibA&oe=6B106069"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/term
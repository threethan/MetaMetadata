Ez30-ZbekQ7kNvwGRqaOV&_nc_oc=Adq8ZBLNBMtoSSUuO-vLIQuiVZD4gQcKh7TWNIVKJDvR0iIsNbNArFXGpQNcRL1nI7w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuhw8X2tij_et4YDV4SX-edNgwa2FubXxRqy3gvgJ4zQ&oe=6AF9B8B0"}]}, "id": "1094496188704320", "locale": "en_US", "screenshots": [{"file_name": "screenshot-06.png", "id": "1928155274465745", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820855_1928155277799078_534499482197575229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2FfG9J9OzUQ7kNvwFmO-a9&_nc_oc=AdprfPBQU8NJeeBh9RZwmtytLCm_QMA4Qo0pALIDD9YYfdpzWIUIEmwryPqtdsl4D20&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLLW5JCKu32jw_aG6qQr8efhaWhmgh5W1Sailv7_oV4w&oe=6AF9EC28"}, {"file_name": "screenshot-14.png", "id": "929867369434924", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822550_929867372768257_1745107557357463615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoDMc1qlbeoQ7kNvwG4AQBj&_nc_oc=Adpwht8_ZW863ZdULtnVzXlKfLQ_5jCfvNDI23q7SvpF7QylhwpwjyKtHVR1wLyRNPs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFiAHUr0univ_H3fm3DiTLdDbJlX_r0mUevZrZv4DAjQ&oe=6AF9E661"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjvo2_QvkRQQ7kNvwHT4sok&_nc_oc=Adq8FeMM0D7gKkQyR57E0FGeY2GuJaKmNfq9F1Pb06hGnJ2S_vWNybXoCMhFzT4opjc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMXpKMyFoEp6iW46DwTKkgjOslkc8nXc-L1X6WC3ZQrw&oe=6AF9D972"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtQAwBj-WssQ7kNvwHSGDpO&_nc_oc=AdpcUfrGDkdMDHqQq9mQzyNRgkU8p6ce4E5VDes7gdLc7PYQCKI8GBVx1kDGyt1ztlA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxI9KjuYhGKmTXW11mpJo7sTF9Zgfe4xfCVst5cRM1cA&oe=6AF9EB57"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es-e2cPxvqQQ7kNvwHLKjXQ&_nc_oc=Ado6lDJJi2_XLAe66KsFxKJo9wwQxOHnSEkVcD6vVEVHw2oD08XQ9Bh_cjkVn_YgpTg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR93YYKL8j5i6Dop9oUtyab__8TJF3xgoeWIMu3LUg1fA&oe=6AF9B865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mizQ71ThejYQ7kNvwHzLfJL&_nc_oc=Adpto5mFWKzgHDBf3-VuCaZFCbwrYRHCHOOD7EH93qqwivIbvnfIaA9vYZSyAkc33GE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRev2yAskTZBvlT5Rap177U5wa0JbaDMkkSO58LnbAxOQ&oe=6AF9BEA9"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9288177234618113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1745790976561205"}, {"status": "PENDING", "id
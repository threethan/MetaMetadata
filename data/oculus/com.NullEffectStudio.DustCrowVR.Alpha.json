wF0yccf&_nc_oc=Ado0MKNZXYuL0LKl8Eb-1TvdoHZ9nnrEEDw85H9ZKvgyKJ3hSgOlsrNxIA6xf03eFTU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5bJLDYuyTyshtVw25YfQwF-kaEUdQeQLXKJVo5-EzHA&oe=6AE34F30"}]}, "id": "1094496188704320", "locale": "en_US", "screenshots": [{"file_name": "screenshot-06.png", "id": "1928155274465745", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820855_1928155277799078_534499482197575229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3ZJk5mIC60Q7kNvwHfcCzv&_nc_oc=AdqtI_w0z923tpLxoEhvaj_hGbPRdExlnWiRuPILZawQf0CDD92aGid8zl1B5MEsszU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfpaHH_2vocut5lULmh1TwHzN61ET1wKPI-1KUKJK2Sg&oe=6AE34A68"}, {"file_name": "screenshot-14.png", "id": "929867369434924", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822550_929867372768257_1745107557357463615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7myVfHNxbtQQ7kNvwHTSh7E&_nc_oc=AdqbkR2AcOhRaUkLyZ8-wJcOrb0CdijZ2HfJrUFtx9GckmI9m_ddeb7k8mJGLQ2U4ws&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlDx0q0rnHRpQPGHys8nj5l20J3pSYJ1J6LpU2TIfkaQ&oe=6AE344A1"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=000JCSpRJ1sQ7kNvwEizxx9&_nc_oc=AdqtrDVwMd5PjorQBWxyztSOIVrQEAKtn_mZv6-fjrmaP0JxyjKEo7G-JINJmv-E-bM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl5rD3dRTgQW-URJXnFgZCoR27G6nfZKP-o5uJQvtVog&oe=6AE337B2"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3P63t7hDZ0Q7kNvwEzM-WM&_nc_oc=Ado43Trh1QO7OuYyNUDIRakoNOJ2O7DNkIzx-TWvK4FI3d0xLbP7WqhHL6OZO79-gQg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA-BZyW3XC8wWMwWplFNxAdVw3-YeToq25-1gf6cr0_w&oe=6AE34997"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dARTaMdAdcQ7kNvwFgIvuF&_nc_oc=AdrzzGV75Nyb2_pm8u_KY4fJcPT9JUUYi8SW22X-0oPrT9pOQCvC_ooi6C9bN7K5mbg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZgKSh_m1zsoQr9et-rp9PO0-IvzjFOizbsg3obb8vzw&oe=6AE34EE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY2fqr5Zvw8Q7kNvwFzkP_r&_nc_oc=AdpCUw1PSEqv1zW_sbt7kcNWJKaPlXgXBwfb3nNv3tRygu4tja5Lrlxz8LPKOPU6ibs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3GOJLxkp_HQZS9ODYETP5UjdjgEv2BkyiuLKg-TPKDQ&oe=6AE35529"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9288177234618113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1745790976561205"}, {"status": "PENDING", "id": "2612166665
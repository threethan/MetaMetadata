_nc_ohc=nuzAsz5uaHEQ7kNvwGDCG97&_nc_oc=Adqv7o5nfOFDXvM3Gccxk-TuAucX_ibfcUaYeqQ6p3KSyfKhFX6Xv-zrpGyyxQkMqFs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa3yadXDmJkqDNz0ezTiKBNey4C1esxo7v0T8nTENVbA&oe=6AE603CB"}, {"file_name": "cargofield_open-container_cargo-spilling-toward-ab.png", "id": "985560770577216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_985560773910549_1262773902992184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=majRaTLyNckQ7kNvwHfHsvN&_nc_oc=AdroN1Q0SbHenRePhLB37S-pvBwYs6cHY2uNRUDiO7HC1IvJyVuc_3NztEFro4YfSNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-AJdGLnB8XHCX4vMNzeoBA9FCztKepVw1_T1J6icRhw&oe=6AE6142F"}, {"file_name": "vela_tank-frame_pulsar-in-the-cage.png", "id": "1122028110191516", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1122028113524849_4649415827606746318_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKeDdss3zRkQ7kNvwHiU4d7&_nc_oc=Ado1QstpGCmJ31ho1rqMGBmG_NeMrXPyVviN6EHcvSIYnLVH_yvhscP3p_N4LD-c2JQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXCGsH2oOe5V7TQsYZbGNL-EeUL2Hdska38amhocWU6w&oe=6AE60D1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns93ob6EPQcQ7kNvwE7TnEf&_nc_oc=AdpjGSpd5mw5p1A1Vyu8K56n7M8LDxNahmRtLcrxnCF7HNxNYGP-f1w0OCJD1AhxI-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSNHfq0BNq_-st7wIhLmqOLnuPLEQA1sfuHOF7ItOiDA&oe=6AE5F829"}, "display_name": "DUSTCROW", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. Head out to the wrecks, strip anything of value, and haul it back.\n\n# THE JOB\n\nDustCrow is a space salvage sim built around zero-gravity physics. You are a contractor for SARIS Industries, salvaging wrecks with industrial tools to drive a profit for a corporation that doesn't care if you make it back alive.\n\n{1130649379858677}\n# STRIP THE WRECKS\n\nCut panels free, hack locks with decoding tools, and set breaching charges to crack open ore and blow through hulls.\n\n{28733341329693827}\n\n# BOARD ABANDONED STATIONS\n\nPressurised, unpowered, dark and disorientating. Crack a sealed door and the air rushes out, taking loose gear, and you, with it.\n\n{1140745765179422}\n\n# WORK A LIVING ECONOMY\n\nSell your haul in a live economy where prices move with what every other contractor brings in.\n\n{1248789747450955}\n\n# EARN YOUR CLEARANCE\n\nTake weekly contracts, hit your daily quotas, and earn the clearance that unlocks better tools and further sectors. Eli, your ops tech, tracks you from the station.\n{1809616490177823}\n\n# NEW IN 1.6.0: THE STAR CHART UPDATE\nEvery star is a real one from ESA's Hipparcos catalogue, seen from Alpha Centauri. \n{2361527961331400}\nFly 4 light years home to Sol: Earth's satellite graveyard, Low Earth Orbit with the planet turning below you, the Moon, Mars, Jupiter's moon Europa and Saturn's rings.\n{28883546004599454}\n{1468907368500807}\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": "Null Effect Studio", "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "Null Effect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": 
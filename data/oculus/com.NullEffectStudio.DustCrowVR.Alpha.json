7kNvwFNaAPR&_nc_oc=AdpLiseyOLU3EaN0ndZitK6atakL523q-itQYtLbeSEt_NKbxth2cwFHlSp15wYosyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb_qPWoS6jGT59EntvfcjwhFPhdzhrrZag9zYYHnhrJw&oe=6AFDC9DA"}, {"file_name": "moon_earthrise-over-the-lit-limb.png", "id": "1783002872939710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1783002879606376_7257389725969580969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H22QjcxhEbwQ7kNvwEWudzZ&_nc_oc=AdqTTd3Ej2OA6tsTnTBNkJow8ljuovC0eUnex_PgZpDP6mxVu7mgznyY3KJGlpDimwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZDF6wUBek0jwCuIehCtIl5cRXsEu3bga42ucXeVM_9Q&oe=6AFDBECB"}, {"file_name": "cargofield_open-container_cargo-spilling-toward-ab.png", "id": "985560770577216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_985560773910549_1262773902992184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALK4TQHkTnoQ7kNvwHdLQ_h&_nc_oc=AdrbmJ5bbWOriRS2cKujyAlS3CFBYr0v-TYnTSCrfYFqrAE7V5KVnW4bIiqkcL4hDUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCD9WZnndVJ53TxxzDYbioBVxMOgGMCeOYzxwBqUfEKA&oe=6AFDCF2F"}, {"file_name": "vela_tank-frame_pulsar-in-the-cage.png", "id": "1122028110191516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1122028113524849_4649415827606746318_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYCeuYn6Z1wQ7kNvwGwPMCV&_nc_oc=AdprIOnmHGxFtkfjACLMEPfAOp4OmhUH65FxvAkWQnYiCQYPWyVCTryDUtK5k4tDZW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIAT0_ZjPG1LwW43elAi4QB9CrsDEzA4FE3HuwBMw4Bg&oe=6AFDC81F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustCrow_1.6_Thumbnail.png", "id": "1685832823106377", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1685832826439710_3633970962582972906_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i8dxSdgFjIQ7kNvwG5e68L&_nc_oc=AdpTAoxcpwFI0jK8tihcJx9xDJ8_lm1ZMwyD9CfYbcaHYxsUFx-4AZwrykMCUThHt9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-MlnApwJhhx3GTpH98HIkibILjnSVAqF0auL-TiY08g&oe=6AFDC6FC"}, "display_name": "DUSTCROW", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. Head out to the wrecks, strip anything of value, and haul it back.\n\n# THE JOB\n\nDustCrow is a space salvage sim built around zero-gravity physics. You are a contractor for SARIS Industries, salvaging wrecks with industrial tools to drive a profit for a corporation that doesn't care if you make it back alive.\n\n{1130649379858677}\n# STRIP THE WRECKS\n\nCut panels free, hack locks with decoding tools, and set breaching charges to crack open ore and blow through hulls.\n\n{28733341329693827}\n\n# BOARD ABANDONED STATIONS\n\nPressurised, unpowered, dark and disorientating. Crack a sealed door and the air rushes out, taking loose gear, and you, with it.\n\n{1140745765179422}\n\n# WORK A LIVING ECONOMY\n\nSell your haul in a live economy where prices move with what every other contractor brings in.\n\n{1248789747450955}\n\n# EARN YOUR CLEARANCE\n\nTake weekly contracts, hit your daily quotas, and earn the clearance that unlocks better tools and further sectors. Eli, your ops tech, tracks you from the station.\n{1809616490177823}\n\n# NEW IN 1.6.0: THE STAR CHART UPDATE\nEvery star is a real one from ESA's Hipparcos catalogue, seen from Alpha Centauri. \n{2361527961331400}\nFly 4 light years home to Sol: Earth's satellite graveyard, Low Earth Orbit with the planet turning below you, the Moon, Mars, Jupiter's moon Europa and Saturn's rings.\n{28883546004599454}\n{1468907368500807}\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": "Null Effect Studio", "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "Null Effect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27629910896684801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823270_2194493927990300_8584491391855060539_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOcEhFgS6EAQ7kNvwFhuj4z&_nc_oc=AdrkToyySyTnatcLzIqI5AY6ytxj78RAUM1Hwots_vawWF8m2uMIn-gxBGnIhqHYCaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkx_fI7wztGtuZpMhyQTkg__yAi15mgqtUohumoczdqQ&oe=6AFDCEB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUSTCROW", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1786100400, "lastRevision": {"nodes": [{"id": "9288177287951441", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9288177214618115", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1642504116862281"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Square.png", "id": "2194493917990301", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823270_2194493927990300_8584491391855060539_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOcEhFgS6EAQ7kNvwFhuj4z&_nc_oc=AdrkToyySyTnatcLzIqI5AY6ytxj78RAUM1Hwots_vawWF8m2uMIn-gxBGnIhqHYCaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYzJMn2WymOs56J0tjieWCwnaJ2LMYGzeDGTU5K99r7Q&oe=6AFDCEB1"}, {"file_name": "MainHero.png", "id": "1573323743924631", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1573323750591297_1015726121797960169_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPmsmMb8AZ0Q7kNvwF3p9hq&_nc_oc=AdpUepB31_9avAu4n_HHnPDpTdGqlXFjijVrRT2T2q6CmqKZvD9nJvpCpcP13W9N4sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMqPqKw9iwccEjqQ6Vbpv8BJiaPmqcN9kJPDMpzUEb9Q&oe=6AFDC654"}, {"file_name": "VRLandscape.png", "id": "1502287521562266", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_1502287528228932_7120502681051051878_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf6GMd8LJGsQ7kNvwFrasSC&_nc_oc=Adod0af0KAHNbOExmYW0njnu6_8VkbBXRmT6NG-tN-LLRAHiPa1lDN95So8FvaSZs4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6xzBqWGvtCIHw3Vj1iQJeHrtYXHS8F-2pfVvR6Klf-w&oe=6AFDC5B0"}, {"file_name": "Port
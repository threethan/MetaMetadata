ailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDanKWM6-HwQ7kNvwFz2g6e&_nc_oc=Adq0x8p4tIkd07U_W63zXdFAaH70dd1hk1YA0BaHQqU_biDgi1R2tfGAxuej7rZOw9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9uQEpWI6qQ5YF1-AQLno6saIsmoMQ9FO7n14ZIZK-zQ&oe=6ADE0F29"}, "display_name": "DUSTCROW", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. Head out to the wrecks, strip anything of value, and haul it back.\n\nDustCrow is a space salvage sim built around zero-gravity physics. You are a contractor for SARIS Industries, salvaging wrecks with industrial tools to drive a profit for a corporation that doesn't care if you make it back alive.\n\n# THE WORK\n- Cut, grab, and stow salvage with tactile tools.\n- Hack locks with decoding tools and set breaching charges to crack open ore and blow through hulls.\n- Board derelict stations: pressurised, unpowered, dark and disorientating. Crack a sealed door, and the air rushes out, taking loose gear and you, with it.\n- Sell your haul in a live economy where prices move with what every other contractor brings in.\n- Take weekly contracts, hit your daily quotas, and earn the clearance that unlocks better tools and further sectors.\n- Work with Eli, your ops tech, tracking you from the station.\n\n# THE GRIND\n\nThis is for players who enjoy the process, the exploration, and pushing further into the unknown.\n\n# EARLY ACCESS STATUS\n\nThe current build includes:\n- The full salvage-to-sell gameplay loop\n- Procedural wrecks and enterable, pressurised stations\n- A hangar hub with a store, your loadout, and booster tuning\n- Weekly contracts and SARIS clearance progression\n- Industrial tools for cutting, breaching, and hauling\n- A live, player-driven economy\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26263607116648526"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_2194493927990300_8584491391855060539_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y526j06k5SIQ7kNvwH9dqH5&_nc_oc=Adq5ml-QzVkykVeJQjytRhQ0n9ScGEAYud048elPf3CRME6eeODO0YHD6b1deY08u54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_TwdTSMvHmbL4IUkuRmvlrqfb7l58O5xfy6y9HDhRFQ&oe=6ADDF271"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUSTCROW", "platform": "ANDROID_6DOF", "contex
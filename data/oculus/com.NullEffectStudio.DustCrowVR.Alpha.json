7kNvwFHNAvN&_nc_oc=Adry6nBX7_JKGoofV3L3jJavaW2BO2aJMOqBPZ91Jl8OUYrxzNwZDjmoc_b6Tjh1ikQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgoJ37FJuVDlCXnjz5ckRNhpbN6GbvZc5bussXsZIF6g&oe=6B01BE5A"}, {"file_name": "moon_earthrise-over-the-lit-limb.png", "id": "1783002872939710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1783002879606376_7257389725969580969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfe_NFCyCiUQ7kNvwEULFhq&_nc_oc=AdorA-jpV2AfEaI_zUw8FJ5CoW2SmOeIU6N2PWSumx6wDU3i9WdIoIvb2BSyAKDbRoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMyh3NY-UWiTa-MlRssZUd3wI7Ia5YouF-XpOtEjLluA&oe=6B01EB8B"}, {"file_name": "cargofield_open-container_cargo-spilling-toward-ab.png", "id": "985560770577216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_985560773910549_1262773902992184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6fa876Hep0Q7kNvwEBSgIE&_nc_oc=AdqkWiErjC6azb_C4pN3QzrJaKJur1wcxX3z3jmTtjdtQNKCQy3nIem1gRYXaZI_lFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIx83-6xCJLu8A3xqmRJGk1yJ7dMh3-PBN-3SrKwKyMA&oe=6B01C3AF"}, {"file_name": "vela_tank-frame_pulsar-in-the-cage.png", "id": "1122028110191516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1122028113524849_4649415827606746318_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XCulIYBJhMQ7kNvwECVDuc&_nc_oc=AdohgsKqDxLw2gUwo0XKm9joGIW-iZewAcno8cB3HVNSTOSTR9LIf3RLyG5-JfODsbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1AbwaIrUV2y56CD73bo1phZK1URB_BApoOWGc-GNuKw&oe=6B01BC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustCrow_1.6_Thumbnail.png", "id": "1685832823106377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1685832826439710_3633970962582972906_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjPA9HIoOKMQ7kNvwEDe7pi&_nc_oc=AdqNnaIx4ayBAeC0KEuh4P30wpkvZdDKBPgYMb2j0J8V4IY90HJBXHhI8CXIz6Jm2YU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTxb12GsCK4EbAjzgKwhNw4K33cZGhTQ9YcmVRAewHXw&oe=6B01BB7C"}, "display_name": "DUSTCROW", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. Head out to the wrecks, strip anything of value, and haul it back.\n\n# THE JOB\n\nDustCrow is a space salvage sim built around zero-gravity physics. You are a contractor for SARIS Industries, salvaging wrecks with industrial tools to drive a profit for a corporation that doesn't care if you make it back alive.\n\n{1130649379858677}\n# STRIP THE WRECKS\n\nCut panels free, hack locks with decoding tools, and set breaching charges to crack open ore and blow through hulls.\n\n{28733341329693827}\n\n# BOARD ABANDONED STATIONS\n\nPressurised, unpowered, dark and disorientating. Crack a sealed door and the air rushes out, taking loose gear, and you, with it.\n\n{1140745765179422}\n\n# WORK A LIVING ECONOMY\n\nSell your haul in a live economy where prices move with what every other contractor brings in.\n\n{1248789747450955}\n\n# EARN YOUR CLEARANCE\n\nTake weekly contracts, hit your daily quotas, and earn the clearance that unlocks better tools and further sectors. Eli, your ops tech, tracks you from the station.\n{1809616490177823}\n\n# NEW IN 1.6.0: THE STAR CHART UPDATE\nEvery star is a real one from ESA's Hipparcos catalogue, seen from Alpha Centauri. \n{2361527961331400}\nFly 4 light years home to Sol: Earth's satellite graveyard, Low Earth Orbit with the planet turning below you, the Moon, Mars, Jupiter's moon Europa and Saturn's rings.\n{28883546004599454}\n{1468907368500807}\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": "Null Effect Studio", "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "Null Effect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27629910896684801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_2194493927990300_8584491391855060539_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdFf4g5ZjRUQ7kNvwHwsqIj&_nc_oc=Adr1VN51XWNZOg-0z-vw34nC4clpvRg3Yu0lG3c6eYHWpnDBSECSRhduep9pmeX7aBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvVWIkZ0kxUMn1fjYo6jvHUJsHBvithBMjc2JkuSlqUg&oe=6B01C331"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUSTCROW", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "33152918813227
C14JVVcHMQ7kNvwHXNdfe&_nc_oc=AdqOUeAGNY2ZyUYZRT_hjISbDSFXTEYzKIfmiXjjR0pry125reBsuaNI04t6-puGXLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC4wqf6Vgib5GRbDOf2sBt5Tfdkdl4o--YWffGYPkCgw&oe=6AF207F0"}]}, "id": "1094496188704320", "locale": "en_US", "screenshots": [{"file_name": "screenshot-06.png", "id": "1928155274465745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_1928155277799078_534499482197575229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyhMd3d5nesQ7kNvwGX4bcq&_nc_oc=Adq28rF_bbQrOO__6vto4Z0U2_l1sWbbEXaW8GebbQwSUypItZB9OPF8KVRGEjOqrhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJZ4W0JIiwTvuh6hOt6C7XwtygFBBGwgOPaWAu4rhmpQ&oe=6AF20328"}, {"file_name": "screenshot-14.png", "id": "929867369434924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_929867372768257_1745107557357463615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MXZLF6mWJMQ7kNvwGikm0q&_nc_oc=Adom1QHSDnTnmEphGxfcWyEVLaY1OhAXeFYsqxlsV6JiWN2Kd-8cS_kOFdpxypEgC4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp6PB15mQXvxD2QILKOrv_Rx7EEEJVuUyq8RIo9kbGSw&oe=6AF1FD61"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BB3IWS7BKAQ7kNvwErjPj6&_nc_oc=Adq5bNaW5Xgrov2HY6AmUxgDaXYtJSiNe79flKR4XND99mJ2HDfGPmOAk-qWxhDb3PQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLZaybfHxr39LNQq7SS1gnQq2UC59dy_j58yQ7iDJVEg&oe=6AF1F072"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm3pfLh7UUsQ7kNvwHON6i-&_nc_oc=AdrMKMfRpnL02oRXY43-u1cnLkS5bVNAJIdN67EHF7IhJ09hUQqg55wZmnBipvXHVlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB1WrwZRL_LqKqXbFG5eQdqOTc5q_T2YrdoI1QdWC1Kw&oe=6AF20257"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--JagjRFheMQ7kNvwEKUSVt&_nc_oc=AdoeLHvKXyPrfCdQ1SPt276BsP19kSduVvZBpA2N-KooJaiIBbqYXXDuuZjq1jsPVx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEQ2_EXFlm-fw_lCEagl3Jwkr1KNaJoaijlhn74DLYVg&oe=6AF207A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM7vnvtI-ewQ7kNvwF6SBWQ&_nc_oc=AdpSQDPQ0sbicfE_3HK_cgK116WzQevUXmANWnXtWOUCRVWJczs1oeorUFFEs7T3zeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROVQ7qWf4pWrnp8em4aJt6jpgoUDLdDR8tBbdMvqDM7g&oe=6AF1D5A9"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9288177234618113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1745790976561205"}, {"status": "PENDING", "id
GT_Z1G5UgQ7kNvwHOaczL&_nc_oc=AdpzCq3-fzvPDNttXtvIajmRUjXoFkB19tHpzWAXVY2Ysvt0mlnGntkW5FGXJmDd55A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5luuvKnGhXal4jf8qLp5cQBGr3EV2uU4A7T6-GecWRA&oe=6AF5C430"}]}, "id": "1094496188704320", "locale": "en_US", "screenshots": [{"file_name": "screenshot-06.png", "id": "1928155274465745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_1928155277799078_534499482197575229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns511DAUCzcQ7kNvwHqoiY2&_nc_oc=Adqq5hj_9bg_OFrTj9zTu2c3rgR8FHun3IthEh0xFxnHwH-lXjSj_FF5mZSVs0r-xsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRghw4uLo1kredzP5CdO_SzR0qSdlIwkBCCNwH--LxeXg&oe=6AF5BF68"}, {"file_name": "screenshot-14.png", "id": "929867369434924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_929867372768257_1745107557357463615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia8y2ptvk3gQ7kNvwFGStOO&_nc_oc=AdqMNKRWup9TPc16WsEvWMgBuMpUNOuASQUYjgvd4uiIkkzriZyVUqUn87HkxzCS13E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrS2cTQY5oLx6o09qgPYaAtRHI8ZthVpl7PYI1spQu_A&oe=6AF5F1E1"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVeJh6Qb-toQ7kNvwFfVjH7&_nc_oc=Adrh_8dQvvA0exYj8fjX8E_MxAM1HHKb5zTrMeHFQndX1ksA_0dFg5jbf5ilBuMJUX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWN0hch3Q9uBn1bAc6B7yGSO1FrA8XmoVS32keI0jOpA&oe=6AF5E4F2"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGIM_wGSSiEQ7kNvwGJBzHU&_nc_oc=Ado9VSiOT2IvgIRVZZXgzgNPxqOdLSif1glXYPjazy_G0TdVJZqjhIK7UUzXk9ciArE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm9otNARwaxteuF4YxXVqe93CVbForBx4hkjDb_DhzRQ&oe=6AF5BE97"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLUgL_vFti4Q7kNvwF7oLb-&_nc_oc=AdoWt1KMFWiHn_grAr3CKqcHAS36dbqkFcbceSwjNPwIwX54prgMXN1XKAJOCa90a8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdIJ0r2FIToCIffP-di5CIq-366Jl-XF3ZsuGC6ijXKA&oe=6AF5C3E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSX21FuOMuEQ7kNvwEZ0I8m&_nc_oc=Adolbvvh3iLDVbI56XVyjo4Ab71d8p-MZhXlJAi9YeRUNApZZzEoUOXEcXWuU26Shrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRODxf3FBEP9remHVylgWDYOEvGHjrxfen_bkB71Pwshg&oe=6AF5CA29"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9288177234618113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1745790976561205"}, {"status": "PENDING", "id
sEkJwW5dsQ7kNvwEgpuir&_nc_oc=Ado2zSAW-dlAXVPF_83kWqc66uTOZppWBJuHhl48sa1qPQ1Hyy5nKKeMhAmY_gN8kVI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6R7M1EDSPzcmJrE49Bv8y3RuOkihCNBdicW471EppcA&oe=6AEC89B0"}]}, "id": "1094496188704320", "locale": "en_US", "screenshots": [{"file_name": "screenshot-06.png", "id": "1928155274465745", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820855_1928155277799078_534499482197575229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmJKsNvtiyMQ7kNvwF9QWNQ&_nc_oc=AdrzX-VTi2PlcbmoBW7rAEfo7feRG5e011v4hvPlsIEWUO32Ge6Z9lhU2tIoEQeDqvc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj8f3otYQIU8RycEuDrvXTLLBduAM_C6WX32OY0rGrWw&oe=6AEC84E8"}, {"file_name": "screenshot-14.png", "id": "929867369434924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822550_929867372768257_1745107557357463615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En2P9TQoLRIQ7kNvwErXB1M&_nc_oc=Ado9ftxliudnYyJ3OSQ5no8gfFOqDo3MRhcYe5PCr8sYawrurRyYF9NrpREbjuTM0ho&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBIlBJuLvVT94q_a3NaP-CLftIcRyZlrG5-M_8FCLekg&oe=6AECB761"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoOpm0MCZ2MQ7kNvwEbpF0g&_nc_oc=AdpzQSKctniycQXYcqr5yU2Td7TDlEwowFW1DYr_of1FNehES6JYS_IboKvcX4HzFtk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSri4N86cQcZE3eAtXu-kr1IwqnPXFDAwOG6z4cce82Dg&oe=6AECAA72"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mo5pGamuUYQ7kNvwEbGxTx&_nc_oc=AdpW5Mu8YOrJ-dHmWmpC6-C_JsDRboKJEbYZqX2nkdwjRHNNL3v1SqB8DUm0tE6dPyg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqfIK_yqk-2UjhrRfTQlAq1aHDPxX1kmDcZVL3f5XQdg&oe=6AEC8417"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T1EXmZUJDYQ7kNvwHOo2Th&_nc_oc=AdpDHJWNg00A0BOKtAOzatnViDloVrBZG-R55nQJRVFOWkvGiZY9UZ6FstUImWT54uM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRch5TH8tjKnNpNpg4CzlKrldseg-gdb5xtjaVo8k9J8A&oe=6AEC8965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GCUNrHoaAYQ7kNvwEGa2T0&_nc_oc=Adqia3If-kqLd_h2WtcJu17UZVvj2PdCa6kiVf7VwUNziM0yfjEO3qI2UKV_KWXNCBc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPZB5HYMquPgM07lJmx2IXnHXiztLwbkDhWcmoPo-agw&oe=6AEC8FA9"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9288177234618113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1745790976561205"}, {"status": "PENDING", "id
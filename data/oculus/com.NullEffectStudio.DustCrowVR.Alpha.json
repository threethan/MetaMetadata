_nc_ohc=DfdKjO0cy5UQ7kNvwH-MGvf&_nc_oc=AdpRZdQerdkc-fNU3U4rSiUc5m81IVweNkSsUopzOa5GRf6UrVyKQpt6UMfsnisaPiI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVTb-WA-m_u5Lg7PiCigIK-9leF9a6qjZO8Jx1VtNOpg&oe=6AEC9B4B"}, {"file_name": "cargofield_open-container_cargo-spilling-toward-ab.png", "id": "985560770577216", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_985560773910549_1262773902992184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54rxjMpYnxUQ7kNvwF5S_Wh&_nc_oc=AdrEu3fe16xBWpW2WdbCn6hgce0q0INxpyjGlDdE5vHr31FjDblke0AKDQuV4PLFjL0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMVzLhJP8Lg-twaBAZOa2eiurRxxu_v1Rbyce3kvoVnQ&oe=6AECABAF"}, {"file_name": "vela_tank-frame_pulsar-in-the-cage.png", "id": "1122028110191516", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823812_1122028113524849_4649415827606746318_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DitThRkILE0Q7kNvwGjqYkX&_nc_oc=Adpp09u4Y4Lcy3DttVSmZ-_gd8rQ9yV-u8d8HKkhI0pFYm6CEpv6dZV9nNNmNNrikFw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuBdRy_YOSHnjDFrgU3r33m3kgBJe2B2QX0lnmveL0oQ&oe=6AECA49F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustCrow_1.6_Thumbnail.png", "id": "1685832823106377", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1685832826439710_3633970962582972906_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C_-YeNqQ7kQ7kNvwG220G4&_nc_oc=AdooWmQAwDM5Cwu3JKICgqnwC2gMt6kSdejj2wkQUUE_XCrruStgmhC6WsYsVsDUkaI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6FtXJ52MPMl4Usf7lGICBlTv8Im3szBal4RbbeAEqlg&oe=6AECA37C"}, "display_name": "DUSTCROW", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. Head out to the wrecks, strip anything of value, and haul it back.\n\n# THE JOB\n\nDustCrow is a space salvage sim built around zero-gravity physics. You are a contractor for SARIS Industries, salvaging wrecks with industrial tools to drive a profit for a corporation that doesn't care if you make it back alive.\n\n{1130649379858677}\n# STRIP THE WRECKS\n\nCut panels free, hack locks with decoding tools, and set breaching charges to crack open ore and blow through hulls.\n\n{28733341329693827}\n\n# BOARD ABANDONED STATIONS\n\nPressurised, unpowered, dark and disorientating. Crack a sealed door and the air rushes out, taking loose gear, and you, with it.\n\n{1140745765179422}\n\n# WORK A LIVING ECONOMY\n\nSell your haul in a live economy where prices move with what every other contractor brings in.\n\n{1248789747450955}\n\n# EARN YOUR CLEARANCE\n\nTake weekly contracts, hit your daily quotas, and earn the clearance that unlocks better tools and further sectors. Eli, your ops tech, tracks you from the station.\n{1809616490177823}\n\n# NEW IN 1.6.0: THE STAR CHART UPDATE\nEvery star is a real one from ESA's Hipparcos catalogue, seen from Alpha Centauri. \n{2361527961331400}\nFly 4 light years home to Sol: Earth's satellite graveyard, Low Earth Orbit with the planet turning below you, the Moon, Mars, Jupiter's moon Europa and Saturn's rings.\n{28883546004599454}\n{1468907368500807}\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": "Null Effect Studio", "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "Null Effect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "c
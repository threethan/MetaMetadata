SoQ7kNvwF1NluM&_nc_oc=AdoZuJflryZ5lOc4uc9y5L6x-V66wjEdz5CoXTI3MGsTa4erqrmWOmt77aTeZYwKdJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScBuX51c-J-0ay1qpqnZn4dOP925PM3RmHHPgAiPZYTQ&oe=6AEA0772"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eemjWbc23gcQ7kNvwFqnbRe&_nc_oc=Adoz5tzNB2R4duQTsPTXFrZMtyxFyuNZSUyKjHbmvemn7m2saRfGHeBU2Q_HPb74wB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyHKhGKXiWCoZTXAkaj4h2_j1A4NT6z8hA4Wu7mZeNYA&oe=6AE9E117"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyNjURfcYpEQ7kNvwFhEiFK&_nc_oc=AdpG5DMCXfo7_Lqtpcs9HSmfU3Z1RJuZFFNadYKnnfwBFTtslAsugpm-bd3moSW7U1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyLAfVmwUk0EQTIJNZVMpkp6qZCBEGPzPDPpvHJ00XDA&oe=6AE9E665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp8wDg22xDUQ7kNvwHlC-8j&_nc_oc=AdpuloW9EAEO2nSyxSX9MQ4rjF9jH-8W7prQMql9F_pUg6PmxRyFHOtmZauez-M-vgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD_N2y6tD9qlnD03hXIjpNrUDcEz5YBcOQoAoX6K3O6A&oe=6AE9ECA9"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "26918901644604
wGzFdz1&_nc_oc=AdpmxIFUR-WQD93DCRAZ_Jh8_iOo4GvKm9titEhLaO96-7HfWt6UG4Tm84qWuoKkibg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmkivMk2Nnt0BXBACO3oltCVIJdwFDdMclNO4plQwhlQ&oe=6AE0AC30"}]}, "id": "1094496188704320", "locale": "en_US", "screenshots": [{"file_name": "screenshot-06.png", "id": "1928155274465745", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1928155277799078_534499482197575229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RYwqNd3aCwQ7kNvwGsSjx-&_nc_oc=AdoufuLYS4aQ_AIPsgQDYrwdPP4ZPgc_XcS6Xf9msbqmbijlRQVsTmozgwAYFi9ZMGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMubbwPjdaQ39Y6ULmobiaHdh_JoloKlyaPgCdVAhuCMQ&oe=6AE0A768"}, {"file_name": "screenshot-14.png", "id": "929867369434924", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822550_929867372768257_1745107557357463615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7myVfHNxbtQQ7kNvwEROmpC&_nc_oc=AdrcAbhOQyBa3AMnUKMxGFdpBElLX5iLJ4HFe9AzLTlQvRV8N5Mx4h5XCK71U-rhaYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS3c4OCANfiVQbwYpM7kzooWrmSsvNAefqVg69LriC4Q&oe=6AE0A1A1"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=000JCSpRJ1sQ7kNvwHNo-mn&_nc_oc=AdqsIueW2kwFs0rvgnHGwd_hcvG5SgmcXl_rP2Q-Rol1jjTX1JlXJz3rs8qHTEc5rZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPfKuI1k2isRnDTScADjKwtzCXZkP3LuNUNxzjPcLq-Q&oe=6AE0CCF2"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibsFsdlHRvYQ7kNvwGFYJiX&_nc_oc=Adr4A8R1lmKcQ7SqelYm_T_Fr0MZxfeRveRXJpuiQSR4c8599spGlfy8_RSWHNI011k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKI1wvymjnzZldtIYi84NjXT6-cHIaMr8UQlW_NrgjgQ&oe=6AE0A697"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dARTaMdAdcQ7kNvwHkfNNb&_nc_oc=Adr3c2gpY2TqL1t6TIr21kLaXgU6PchD7LUuxI4W6t8qpX-Rrh0RN9nUKP30Ex1igv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsN4PkyVz00HfPzCSpw3Dr-aZVY2SbrgkvC00H71k9Bw&oe=6AE0ABE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY2fqr5Zvw8Q7kNvwHzypcJ&_nc_oc=AdqXgIqbHaL7eIMqj8KkwnARcAA8g7pOHTU3PfSgFM11z1caUUBGLkyeavSvxNqNAnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJf_R-HWzmWzJnfVrHX5_n-uii7iWkSa--5zMvaK16Qg&oe=6AE0B229"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9288177234618113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1745790976561205"}, {"status": "PENDING", "id": "2612166665
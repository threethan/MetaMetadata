ddlXst646ZSg&oe=6B047261"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G3MGcFYbcoQ7kNvwEiiiYo&_nc_oc=AdopnE8NbprNvWSJeIeHW9JttGZWZeqMBVrQkHC2wBTufjdoPBHkC09jnvX_dqPz1jI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPEWXt8eRXcGjpPssZFdQJj57Qy4sNYpOPcO61B6-37g&oe=6B046572"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlKcE2G33F0Q7kNvwHNUTWo&_nc_oc=Adopu6fjl3gz7UczCLCPeC98orqWocrFYhw5xI3Mgkk6NVfhzo6_r74Umn1id-ic0cI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfioYHnq_y1QdJrAmW0lwVKBtSQ2nej9nbiwi34xF5_g&oe=6B047757"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0T2pc7AqlwQ7kNvwGYSXOX&_nc_oc=AdoSq5crnncydxCMs5ykWfN_UCnW8YmkrI8IyjYpQsqZo-DDBjRjwpO4N00l_gs9qXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQeNfUWSvPogaD3gD32eZwLXfzio5gWfLWyZVLzlRlLQ&oe=6B047CA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG1fYqZIFsgQ7kNvwHkraf9&_nc_oc=AdrVIm2yqNwUKec0dBBKXaLFTE2hZ9jtgbbwpPzCUQWXF5iA12Y5yixGFfKUAlwtb_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG7pZs8AWh9V3wcUjWV6kssGeYGhk03e6LueVt74Dycw&oe=6B0482E9"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/term
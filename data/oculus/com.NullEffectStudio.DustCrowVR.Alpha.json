x1Mt9BczzXXmT7F_UYxDLTg&oe=6ADF5517"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1uPDFFwGicQ7kNvwE5v2TH&_nc_oc=Adr3iQwte-3_cDYVfolVc6-0u7o_t4m_igPDk8db0c5p3e_q8SbH4dRz7zk9SXUHH68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGIgsplpFLnUopspP_52B92mp_phxVFD38I7BNA2nOTg&oe=6ADF5A65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDanKWM6-HwQ7kNvwGxOYwB&_nc_oc=AdpHAaD_J_RHMWogcaJCcBmoQFYony1EdoCJyrMlwic8ESnqljUk832RIHkYEmS03nE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL_ex5XvoG1C3eWZYJjV8ZHOKhJ7YExVYLb4fLyhTbsg&oe=6ADF60A9"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "NullEffect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9288177234618113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1745790976561205"}, {"status": "PENDING", "id": "2612166665
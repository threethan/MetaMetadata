7kNvwEcm5iR&_nc_oc=AdqLUMJhiF651jGdjQhonxbKNRISVUtw67F3rVm4en0kAPWaVaRqYR5m_kaU-uIJ8YQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxmhNuSLtxOh_DO2UDNeuYmQfycJ5sKP6d9XsMxG8I9g&oe=6AFC785A"}, {"file_name": "moon_earthrise-over-the-lit-limb.png", "id": "1783002872939710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1783002879606376_7257389725969580969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smgLaLzEez4Q7kNvwFTT0tw&_nc_oc=AdqPxjFzhexK6_hIvaFW4uKXls_I4_5qOCC78fU0reJAxBlePkY6ij6s0nq7l6Qmce4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2-e_BCQZTFfVYWGzypnE6YKNAYzdQnxE6-lrkmBeAQQ&oe=6AFC6D4B"}, {"file_name": "cargofield_open-container_cargo-spilling-toward-ab.png", "id": "985560770577216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_985560773910549_1262773902992184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baxdVapOG0UQ7kNvwEHlIu8&_nc_oc=AdqAt5yMJPrjfWRtLva_fBTddaEoVNmO5t0rpkA2bGy775mYBWO-PHIdKzVpi87KdjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC1O5AHqq-Ll6y4pt3vnEWbRx245pg7VlCRmDScv-FQQ&oe=6AFC7DAF"}, {"file_name": "vela_tank-frame_pulsar-in-the-cage.png", "id": "1122028110191516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1122028113524849_4649415827606746318_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYCeuYn6Z1wQ7kNvwGqGERI&_nc_oc=AdrAUiDy2tUG33EA5xA6Fjj9mX53LCeY8o0KqEp-hMWyJ1Qas8i3BNJETvBNkR8DAGs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Bkh4-Nv3QXRX1XPI3lSUm9tr_JGY1ULB7ooZ9jys2A&oe=6AFC769F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustCrow_1.6_Thumbnail.png", "id": "1685832823106377", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1685832826439710_3633970962582972906_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i8dxSdgFjIQ7kNvwG-lt_t&_nc_oc=AdoTJafBukt_5lrprJa44ho6Si_tE416eum-nXaf8HuD0ctCsECARKLT16mBJH3XtVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR61MX50Q_tGiYSClP5sLUMf1Dx7C8RiwD46_8zx4FGyg&oe=6AFC757C"}, "display_name": "DUSTCROW", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. Head out to the wrecks, strip anything of value, and haul it back.\n\n# THE JOB\n\nDustCrow is a space salvage sim built around zero-gravity physics. You are a contractor for SARIS Industries, salvaging wrecks with industrial tools to drive a profit for a corporation that doesn't care if you make it back alive.\n\n{1130649379858677}\n# STRIP THE WRECKS\n\nCut panels free, hack locks with decoding tools, and set breaching charges to crack open ore and blow through hulls.\n\n{28733341329693827}\n\n# BOARD ABANDONED STATIONS\n\nPressurised, unpowered, dark and disorientating. Crack a sealed door and the air rushes out, taking loose gear, and you, with it.\n\n{1140745765179422}\n\n# WORK A LIVING ECONOMY\n\nSell your haul in a live economy where prices move with what every other contractor brings in.\n\n{1248789747450955}\n\n# EARN YOUR CLEARANCE\n\nTake weekly contracts, hit your daily quotas, and earn the clearance that unlocks better tools and further sectors. Eli, your ops tech, tracks you from the station.\n{1809616490177823}\n\n# NEW IN 1.6.0: THE STAR CHART UPDATE\nEvery star is a real one from ESA's Hipparcos catalogue, seen from Alpha Centauri. \n{2361527961331400}\nFly 4 light years home to Sol: Earth's satellite graveyard, Low Earth Orbit with the planet turning below you, the Moon, Mars, Jupiter's moon Europa and Saturn's rings.\n{28883546004599454}\n{1468907368500807}\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": "Null Effect Studio", "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/terms-of-service", "publisher_name": "Null Effect Studio", "support_website_url": null, "website_url": "https://nulleffectstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27629910896684801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823270_2194493927990300_8584491391855060539_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOcEhFgS6EAQ7kNvwELOBI2&_nc_oc=AdpOCnOKtWGsCXQ72hwZDJE0-88Gd06ai260VGyB2CTVqu5vgI-6q_SmK3bjensfS00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAThq1vRjzi3rkXuAsyVIgamcUhkb_UrV4DGPRXDAbkA&oe=6AFC7D31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUSTCROW", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "33152918813227
ivgS3M9i5JAA&oe=6B0C5B61"}, {"file_name": "screenshot-11.png", "id": "934153095819719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_934153102486385_341434832440931052_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLELVFdskLEQ7kNvwEGNhqO&_nc_oc=AdrwWu0z7NlcFcG6YJEMf9SVIseMEbYGzsQ_1Y68nTg6jw6OtZNzEYyREcGsyR4vrro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCSs76LPDDIp82wmbOz_zzBlzZlyoebyv9aM5apa5Nyg&oe=6B0C4E72"}, {"file_name": "screenshot-07.png", "id": "1080330658495695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1080330661829028_1720857723477002214_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-pkQyWmOckQ7kNvwEpqGqK&_nc_oc=AdqhvUvhLRC1puQIEMhElUyA8v-R5Me6cOhNtzOQaBHPCPmLt7IZMh7l3oP_LpA7qoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQf_qakwPF90X_qGrYGw6YpBgiX4Cv-PvgsAq0qVaqvvQ&oe=6B0C6057"}, {"file_name": "screenshot-03.png", "id": "907736915337764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_907736918671097_3835084709530844411_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGl1BTfwpCgQ7kNvwH-rYHY&_nc_oc=AdrKL7mC9WnMBssDX0GhGqQ4XSE3EIb60GHzs_F6CJpBtNA-logvlUSxunExzJkyrd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4NDW77PiyEmzNfmj9owxLQxS5q4NcpTrijv9zZYNDDA&oe=6B0C65A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainHero.png", "id": "2028621527692629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_2028621531025962_8689135822510397441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI9B4bfywqMQ7kNvwFrUS-x&_nc_oc=AdomQkT7fSscz2Jp-1CFSjlCz7Sap6oqq-fAoWQdg87J3KmltW3euTP5ehvB1ecX5wU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXohpdHKirtJNkHfRdhbrCg0U8dNx3akctfOaW7R5cYg&oe=6B0C6BE9"}, "display_name": "DustCrow", "keywords": ["space", "salvage", "zerog", "simulation", "exploration"], "long_description": "# SARIS INDUSTRIES IS HIRING\n\nThe job is simple. head out to derelict wrecks, strip anything of value, and haul it back to the station.\n\nDustCrow is a methodical simulation built around zero-gravity physics. This is not an arcade game. There are no \"heroics\" here - just the physical reality of moving heavy scrap, using industrial tools to dismantle ships, and managing your momentum so you do not drift into the void.\n\n**THE WORK**\n- Physically cut, grab, and stow salvage using tactile tools.\n- Navigate abandoned satellites, lost cargo and long forgotten wrecks.\n- Sell your haul in a live economy where supply and demand shift based on what other players bring in.\n- Listen to Eli, your ops tech, who monitors you out in space and provides support from the station.\n\n**THE GRIND**\n\nThis is for the players who enjoy the process. Enjoy exploration. Enjoy pushing out into the unknown, striving to go further.\n\n**EARLY ACCESS STATUS**\n\nCurrent build includes:\n\n- The full salvage to sell gameplay loop.\n- Procedural wreck environments.\n- Helpful tools for deep space salvaging.\n- Live player driven economy.\n- \n\n**THE ROADMAP**\n\n- Multiplayer support.\n-  Player Cosmetics & Customisation.\n- Player progression systems.\n- Lots more tools and utility.\n- Brand new POI's to go to and expansions on the current ones.\n- More voiced content.\n- Expanded lore.\n\nClock in. Scavenge. Get paid.\n{1502287521562266}", "short_description": "Clock in. Scavenge. Get paid.\n\nJoin SARIS Industries as a zero-g salvage contractor. Navigate derelict wrecks, physically strip valuable components with a variety of tools, and trade in a player-driven economy. No heroics here, just honest, methodical work in the silence of deep space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nulleffectstudio.com/privacy-policy", "developer_terms_of_service_url": "https://nulleffectstudio.com/term
-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sffv8ADQAgQ7kNvwF53WCy&_nc_oc=AdqyM1GVcoZssIQDmenDWwN6Sx3LSq-m-1DTIvt_dJjhhIPQdAwSVK1Z0xYSXgscENQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIstz4zfwVsnh5f742y7Zxj-DywjzNsWOMYbb4axBbsOQ&oe=6AAA95AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8dK-j-H8aMQ7kNvwErkRxH&_nc_oc=Adp7ZHYU9xeXb_xEkGguanm_iUn_cDlIyREJJRlhyszsoBWZioPZTVworzD5UczoThk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj1bqZwy4cWqiV4URgblZLzaryoA58eaZTPiJNUpuK2Q&oe=6AAA8D4F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_93IkJ35dBEQ7kNvwGGnjLv&_nc_oc=Ado6lioJLZPgKZpymVpHY-d0_VmO-Co8cpauPkJuDh1f2eSJ4R7bmzQfOAwtS0tT6yQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ7Up6XstpnLGk8LbOgFZR4Cqmh0IGI-WYWf8Ae5-eZg&oe=6AAAB21F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbbwghxCyV4Q7kNvwE02G8D&_nc_oc=AdpLS_Ox_UbJJ4Dx4fnYgR80fTKY3djwwu7IlEC5p7IwYQwfXutebsnhdcghJQVCyJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL50SRBfVzWob1uYWhFoJpWBwSFGkbwfsvcJgnBGSrckQ&oe=6AAA8DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz_1VQn7aY0Q7kNvwE6Rxsy&_nc_oc=Adr81DgwkIN7jjOeS9-0kBx2Wu6apFwWcrRr0TzxmoP6edgld9v_0B_2sCCqHfuxnQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpVS536FKsPjPl2ktmB1cXuRdA41uOLWsk7Iszv2M6bg&oe=6AAAAAAE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
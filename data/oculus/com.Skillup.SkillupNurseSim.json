-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnVW2vv_3AkQ7kNvwEI-Mz7&_nc_oc=Adr7nFGNg3BSoqOa_FyQoFbEGpfYg3u7-NtdRTjU1L2ykhXOe860Cy0W189ngvY-VNE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BxfLcfhNDJgZBBH6maLGOd3fhX-7h9--bDNof5kl4uA&oe=6A45122D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAg9ErtfCfwQ7kNvwFwZeyd&_nc_oc=AdpUEGpaturk7zMqAgEfsTau0S1W7X_d92gt_3KGdPWfs_v2nqmR5_9ZLr1fIjeerjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C5bEfKVynukdoM1hzzUEPtg9icpXIPKVfjcbwKpHjVw&oe=6A4509CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ozaktHm5HgQ7kNvwEIMrxX&_nc_oc=AdqP3FHo1OA6cHAbFJXWRv1ShC0apOQ0NFhpzV7i9S4CKWw76KV8m-dSYOSlZnDAaM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H_l7Diwjrg_McT5BMSBzkgd37lotzj8g_mZb7REG5iw&oe=6A452E9F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giEU3s3E8ikQ7kNvwG42TBD&_nc_oc=AdptvsdRdfRBBZIXZgnOijXmygiiK5IaZH9UVW12Dtn9skUjTjSU9SIZ5-lTnTlLAVw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83WB4DicnTzvN4C3v5Kr30CGKKBE8DOHt9aAm6Ui9MjA&oe=6A450A65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1zL-r_hAJAQ7kNvwFDJZ6a&_nc_oc=AdrbQ87cILCXw9YAusbf56aX6uUVfpXhg0yKUdwMhMpIPCmP8TdGbwIo7T-asWp4HPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ws9nkVZuXlzj_ZJmqba2yaKU2y2hUN4BGGNozQ2wi9A&oe=6A45272E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
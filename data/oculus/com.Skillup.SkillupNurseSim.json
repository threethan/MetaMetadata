-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bD1zS9nY58Q7kNvwGmtMm7&_nc_oc=AdpX8aS04Iw3c7RPIuettleAxvLcp-2sFueMcG8s9Z08GRgYXnC-hGfb-7XteAKC4o4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO8uN9F-sD_isCwNpFsR0lWMfGda2itECRVKw1Rxv7nQ&oe=6A71E52D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwCDedPRKXAQ7kNvwHkU3-5&_nc_oc=AdrJRhEyEJv_GnHYRKxYg-RroxFwdFYqfMtjMtSq0CxosLLGuFJHa2IudzPOVOEQkyw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmTcK52t4pwKL863VPpRbVSefUQeVikxeHZD5q3JSvkw&oe=6A71DCCF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cENUNOu0AiMQ7kNvwFxYkWM&_nc_oc=Adox4ndeVVBFzdl7bIs668Am2mvu6gfAfVVDj1SWKTboTMabkwHyulQsvQTdU1wyq3Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIrMhgyN9SwWUfyW5TC2wFKw7kdkq70WBxIFDKRI8gmw&oe=6A72019F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJrMv71cLWEQ7kNvwH7VOcx&_nc_oc=AdrmEdF-RP3e4CJIrXFSkaGRgHIRmICRP4Bp8NyO36UVVkqdiAQlB6y2ylogo6sIrF4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnnUC2fXbzxpWSJCu3ibdrpL0TBHsfXTFqeQtRduQGOg&oe=6A71DD65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrNn_l781VMQ7kNvwH_qQES&_nc_oc=AdpOOBkK6ELGFQ--VGWMQ_qzvMAC9y2jBpeQG_8VUrLfQiAcrnj5cJIlYDnpN59hxcg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWOSj-MY9piVQhJZZ0RXW6LqufFpSIXX2fF9jmzTDxBA&oe=6A71FA2E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
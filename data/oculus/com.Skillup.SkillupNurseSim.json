-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t5t8aeicuEQ7kNvwFHqHsp&_nc_oc=AdrgvnP3DPZ7GK2BrBOIeIUsa2i0-FKW1LEpxoKeqSdrbDKkcvb1j3MCDRp8mkIa2xM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfL2euGDjzq2BPBb2_cPoko958iNF8bWmhMjtTfBJ1cA&oe=6A58D8AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxkC2oDA2MUQ7kNvwH2KGNv&_nc_oc=Adong2yotOey1cfp6oZhv2T8i1o9isIG4E4g5UTtrtN5vwvpNdpNL6-fQ_r6s53RV0Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQHa5Z-JHCNfqoI-1dWKem23gJWeA5Ldh1x8zD34zb-A&oe=6A58D04F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpwA71skvZIQ7kNvwFXgdmu&_nc_oc=AdrY7vBUgzYhqkmnMoWNYDWigO44cPcw-tUCu-L_znZNjmAoaBeQYtfx8EU1wuHUmpY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcoBZaCeAWlLCtJLETQJvXGtDP73aM5lop4YOvdDWI0g&oe=6A58F51F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LScQtVUaMQQ7kNvwHEdp2-&_nc_oc=AdqdiKNwBxhgLnhkvtVdgQGH3NRi96QiHnCH7NfwvRcjn0W7g2r1LD45GW9yUiriZhk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxe-u6dMitty_19Nl1Q7yJKeUZgFInxvZ6PT_av4v3LQ&oe=6A58D0E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1n9YfL0odoQ7kNvwFQb3Pa&_nc_oc=Adqy5D55HxhFdPjw4lrdcIUFeQTMu858jJ2BvK6cViVoE7WBo0YyXJD--5XIacXM4Os&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAuCdAXfer94lUVg0w9Q20AxGfNfzrbebQquNjZ8JJCw&oe=6A58EDAE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
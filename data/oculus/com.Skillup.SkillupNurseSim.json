00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker."}, {"images": {"nodes": [{"file_name": "Skillup_Landscape_2.png", "id": "7544280682287039", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974502_7544280688953705_8308653196303593127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qye5t2lH4zYQ7kNvwE5wtBy&_nc_oc=AdnskeycXAyyxT2145eT58H6NKFMvQTC-yLvyDjeg-rchhfkD6XaL9zLRyyZAJtyzbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNdd2NQtRJxxACl7yerg1e0EuvQbRhxny4TBHBsB-sfg&oe=69BBF850"}, {"file_name": "Skillup_Logo.png", "id": "1175369937163070", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974510_1175369940496403_4643848346859594524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43A-rdNm1qQQ7kNvwHeoHUx&_nc_oc=AdlBY1VzzNFdAatX1-D5Z_Uqf_4oUxUryC9_VpFgrMV-SFQ2EUlX_QRGAF-M9Y3-VEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCrfw3dM37E8sWv5sQKxENmTbJ-tTDEr8vsl1js9-o1w&oe=69BBEB06"}, {"file_name": "Skillup_Hero_2.png", "id": "1109995243449629", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036652_1109995246782962_2272990399479780084_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9Ag-stZN_gQ7kNvwFg8Wp2&_nc_oc=AdnbcocZ35Gje4tphdUARgqmtNmRAKYS4GaposISi-0Zu2n5j44XmDYgE9GjVT28bAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyz3CaqYKBaxCusFOef4VquCJ-3UpMLWunikOvuy1C-qA&oe=69BBFCE3"}, {"file_name": "Skillup_Portrait.png", "id": "1081999302905553", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75451778_1081999306238886_7894111874177071851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74rorHBkfpMQ7kNvwE39_KQ&_nc_oc=AdkbfkhiexX3zgpYXmtksRNvZej0O2iC_kdMRLlHd0krM3X3ehHC3XwjNayD4066yq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0uWRdZtIBqjl8Gx-pfBbyJ_DAY8GjhORyak8GuSTNxA&oe=69BBE
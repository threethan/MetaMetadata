-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J6EcMI3aMAQ7kNvwHvBlvF&_nc_oc=Adqu5XsFEPELpeDvA1c8vRpd8SthuTDn_ECimtCxluodDx2TuUy-qf5O7h2XdvZfWJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGsEXTgjFIA7Bbmjn40ZrRN59Dheyypi7_RJwF0BZ57w&oe=6A99722D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsIeJRA2A00Q7kNvwGpfPbA&_nc_oc=AdpJMoFFwTDRTqG_vxInIykJgdVutCGAiTEshligHN6rkWP0NJvBtWEMvk1VOuaHDnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-2Wobux98JwSOfJ1NQPsU4PieMw3kyb8wpWytGFQF5Q&oe=6A99A20F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4IjOpoSU9kQ7kNvwHx0ROw&_nc_oc=AdpWA_FTjgfFmgIE48TAuYi4huZBveJpxOv29-kvwvVwa4P0Dnr_TEi2Y9OUP_edz2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqcLfqUp_mDSeo2cuy2raOsx9FnKOZySAiLoy6QkfSow&oe=6A998E9F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZimzpR5AaEQ7kNvwEN5lVf&_nc_oc=Adqbzf51lxGbSTIGy6imzuSInX50VUnA5n1fDyAkJwGO5VNM2CAbN_0d7h3ydEpgYu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvl3nASeaWN2bvW0K7oogneALdkHt09xyHIUN1xCaoqA&oe=6A99A2A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtGJ_Y3RCj4Q7kNvwH2m9iu&_nc_oc=AdossGL1JfT8do4nSdMv4cOA3ZLCcL59cIQXx2g_EZdH7qgJN9HJi7mxhMpIeOCuIgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdDmt5x7Ml2Z-Ky_IEVPlPsA299WyGgpdQv2WfF3UjKw&oe=6A99872E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrxyvpdIZLEQ7kNvwH-159a&_nc_oc=AdpLygF6kPbkSmXE3FtbLpuozsLw_qIihSe7O9nCAyHHf3zx4Wl6iYtWWQ9cTh-xnzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aWW43s4p53KvhpLgg27oNS1ZWf5k8-O_gE0pYiVVgVg&oe=69E0E02D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvwLtQ3hpmUQ7kNvwH1aNUp&_nc_oc=Adpp3epyncN4EAAiEDZbF19tM5H38sRnH6zc5GpZ7Sirimc43oL7-urhaY0LyvcAXfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LeVVrcQUHF8THQ8Gf3--NEshFdqS-lcvXswIntDXMCA&oe=69E0D7CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUXMyyTFuWkQ7kNvwGj0okP&_nc_oc=Adowmn-XfOzZWMfBxvhsZZXS7MQ1x7nqrhziF3W8QqzlN0aCh_LL_T_txoE2EuSAGvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xygKkM6NOx0WjIVWca3OqxfUBO4Hdoc_xQ7eSqpisuw&oe=69E0FC9F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhBxXBxQdjEQ7kNvwHQwWSo&_nc_oc=AdoEgyPNROb8Fu8dJmJZtuir_onicMpe4jlpibRu_PTRY1cnCuXKnNyGoOonio5PJHQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uossfPQbJkXfHIH81D_4mj2C7l1ILxy6mwoXKqJa3IA&oe=69E0D865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPjUhd5LrV4Q7kNvwEDMxHg&_nc_oc=AdqXlIpJYptOg65tUWrhRwc5brNba6qa7H-E45DWPTF-Ir01Ymrt0Ge_HbjD2ieJndc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yo5Gysiwv8mmoroiPvogiPc7xVUl5-9TpmKt1isldjg&oe=69E0F52E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
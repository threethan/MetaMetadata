-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq6Eo9eNfLgQ7kNvwFWPiq0&_nc_oc=Adr05aSqSmY0LTHjv6BtVigDiLiIfqXnT_mf2LeXuIdYYb5RFwKI_S_mpe0B1rqDOhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9GZTH_XQ8_SovWbCn-Jjl-ahjOzCCM2KbIqF2UCp7Vw&oe=6A95B5ED"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qOvDIjfdswQ7kNvwET87mi&_nc_oc=Adr0kzC-6k-aNKdC5TgxE_0NhfOzY0JMM18pGwCAuxBU9IJ8XzYUo76LD5XXAwQwqgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2UsnnRqPXUOzMOEjPaMXUHxAQeZV7Hn395Euyr3IQSw&oe=6A95AD8F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6o4zXQIT7cQ7kNvwHYvKU-&_nc_oc=AdoE2wNvt79xszaSHD9WCAnbI7aDla5eOcVvrqrMXhQKV1Jw372EuLmaxAe0GIAGEHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRW2LkjbWMCZQPYjTGSnRtMUXrzCJkYwF-_rHZJRe6oQ&oe=6A95D25F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9GBnNYFWksQ7kNvwHI_4sl&_nc_oc=AdqUFJE7CHe7kjThr86QpfYHOWtRiCwQchy0IklxU7Vv8_Rxvpo5qdoGLYqrmWyCpyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVKFFwWa33EO4skEIQrYljdu6YQeZu1_ISgrMpHeWSqw&oe=6A95AE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQJ-DpJXU0gQ7kNvwGtEMy_&_nc_oc=Ado0z8vDOHnOOyd8NoaKSJMtnuwvKoYbhkpu5ElmOLzb0qrA811Ii_YgOsqc8D6XjeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqRx433YTxmzbSXPhcqL9nuGQGkkgdJvdFdtc5VyGZGg&oe=6A95CAEE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
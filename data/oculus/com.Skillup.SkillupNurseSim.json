48_5202587497473315011_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiPdStq8EjcQ7kNvwH5Vsw6&_nc_oc=AdoOKXlj5Eq13Xc1-68_lNeCcsOw9LQKIZFAdLNX8QSLLVO3PWYS8KTd9VnVqdz--ys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK7VjLyepWhw-evL4X4KyC-pQI5NajTiFmaDBROGOyBQ&oe=6AE9FDA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NEW_NurseSim_Simlogic_Landscape_sep2026.png", "id": "1289918843184424", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1289918846517757_7025777987388135305_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K5MGC-yxsUQ7kNvwFGiE5W&_nc_oc=Adr7yejkZi6AoS-g7Fj8gBDqMmdzUlKZnq_cOT0W9qtKIDbbQ2yz-1Myathllb5-JlQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzLz5HhUyXclHIPDmqAvLwGZxHPeD5LvgSVLF9o21DLg&oe=6AE9FD1F"}, "display_name": "VR Nurse Simulation", "keywords": ["Skillupvr", "Nurse", "skillup", "nurse", "skillupvr"], "long_description": "VR Nurse Simulation is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "VR Nurse Simulation is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": "Simlogic", "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Simlogic", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27934799866202177"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_1070819085847140_1581412895312932655_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnSs5ypodK4Q7kNvwEPQYfS&_nc_oc=Adqzp-oJMtHpyU1wt1_smEjAxfNtsOq7mCuXQlcbbaAurg6As2HACHaPEP6nq4Cd8k4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAj9XzDPQjSKk3oXsneLbCzxP37GjhD0zKfJ-EDOsPmg&oe=6AEA02A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Nurse Simulation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1725624780, "lastRevision": {"nodes": [{"id":
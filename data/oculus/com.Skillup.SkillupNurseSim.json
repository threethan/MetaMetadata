-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BccO88izh5AQ7kNvwEwZtGL&_nc_oc=AdpjbTrQuZsIo_u7x5Uv16KZ5A2olHX7C3m7mhEqMgBLYWCRisRvgbH7Spb-h_rcYnk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ROBjHh8zHKSjH7zf1IlqVEA7Gkg-RP_LPYh1y7jji5A&oe=69DA48AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDxEjBwd_-QQ7kNvwEcRrhx&_nc_oc=AdoWBW0g5pylVqGEleGrdHdS9PL3e5eNhTObM8RqkHMMkdKfmITv7V_zFLE2keJXWeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DarD9n7zY6e4eZjKxw9seTROhggKpQ53suVvn2jOPNA&oe=69DA404F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSL8wcqb1SsQ7kNvwE7RvVa&_nc_oc=AdoJ7COgaS9jY7uMtNQ80fP6agHEAjzHr6UDccvMN0ef0E4N_L29JUJx4rxEZWsDITc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VSsCMj8wgzwqX6qOUt6pcCnKNjeCh5dkJvgOUX-CJmw&oe=69DA2CDF"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECwiG-lGhi4Q7kNvwF0YgVw&_nc_oc=AdoY0pkqkx7FNVTmEhSSXeK3A-Ru_GANJ7jJtZh-zCECAyyUIoGvsu7PyKaPFNL8qLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16GhGUagrUEsXQOx_kmL0bJS6qFgoIamc3BXMz_0rkAQ&oe=69DA40E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtmAxT4A4XQQ7kNvwEDOb2u&_nc_oc=AdqA2PZ9yIQNp90WTqHNYvpiP3bRqUhzj8ZsRDofBmmK5PiUSwPhRSiLv56Pff1ewCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lB7WN3mS-MFHRDwrTPPCLO67346SRwOPg97tOLlUc-w&oe=69DA5DAE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
F67PSBMADu7L_nMv2dM8R5VE83bDSVyim97XeOwuMk1ayxxXII&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FFeDi4Lpn4TGEcrVslSo8koaSf8MAKEbFpgfbbkLROQ&oe=6A11BCAE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
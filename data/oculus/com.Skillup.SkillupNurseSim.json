-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=472W9qhhbIQQ7kNvwEkx_vh&_nc_oc=AdpIf9XcZEbXh0ql4TU7V000TM6HaOrsfUTsq-Sg1QLUz-7hee64MFgX8zSunqFGsz8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10OvNG91ZUMHyJsTfHfD22OZZ-QVI1RhtvxYn-mZHZpg&oe=69F3552D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xjx0qPkAqMQ7kNvwHqWimS&_nc_oc=AdqyLnkCdjdziUFqDOnvyE-xUjFX12aawWbRNXW0AJZql8sCqj3Tda6lcU7pb-yMTG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PGLzJ3QdBJYosptipBo_OsghJ1jsvAXhnsFRA3AH4tw&oe=69F34CCF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_Fvlj6a5UwQ7kNvwHLNBUn&_nc_oc=AdpQPy1h7bO_3OevgOQLfjwSPKtcXo1DBusVyNevwiC2TnWj7EeFliL9Roc8ALOBikk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JlHD4L3ZfwnzIxyYJdJyHkUe1FWeC9rcj7a35HRPr6A&oe=69F3719F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij5IXnoe2PEQ7kNvwGHTe-u&_nc_oc=Adqdvn_k-omQIGRyt1BLA-xQAZP_CLhUGeOfTae-XVA-0EOzBEuF2pTTFJQ7ni0VMLs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3th-HWcjxstYf5arU8L-WmRZ8trl6NPBNhJ6QLnH-lVg&oe=69F34D65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtG3_YWPXmUQ7kNvwFBRKyF&_nc_oc=AdqsnDZbj5nfXGjq3BaHzvNpysHXYq4VT2ndYhy_06fQCof6cTO4rDW8l6bMWao1-Ts&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_B-9Ou0TmXdFyfgACqwI7Ej5gisoKv1HMjcdkiAVzgg&oe=69F36A2E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
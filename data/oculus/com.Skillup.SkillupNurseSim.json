00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker."}, {"images": {"nodes": [{"file_name": "Skillup_Landscape_2.png", "id": "7544280682287039", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974502_7544280688953705_8308653196303593127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biFHnGM-tTgQ7kNvwEjbiIQ&_nc_oc=AdlJfC8FzuqBpTfFw1LwAvvio2tQ1HCg7Bk6jSWgnwS1MbeF8JH1c5Mv7lludBKopRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6ZYbPc--CwnvAIQczK-0lG6h_NrZb_l2KX1DPJPPZiw&oe=69B803D0"}, {"file_name": "Skillup_Logo.png", "id": "1175369937163070", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974510_1175369940496403_4643848346859594524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTr25Znmw3MQ7kNvwHAnqRS&_nc_oc=AdniRPjoD6IKAs4lEUdAsnzbJQC4FzYYaOrrHMa0JYZdJG4f3c1ItISAkOagZEhWeDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxqW1x3r6kjWiCp5AXXRkUOjZfnDrauAZFNvA-aaeR0xw&oe=69B7F686"}, {"file_name": "Skillup_Hero_2.png", "id": "1109995243449629", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036652_1109995246782962_2272990399479780084_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-GT6CcjbBoQ7kNvwEu820l&_nc_oc=AdkV1Zbp6XEKtDE39pIC_VfoK9w8S2llEb5R6nT1QndoYUoNAGA_p16amINk1VFT1lk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFVKu0yT9UHNlVSJ1KsL9D3kR4hNKCmpk6EjfU2ZDC_A&oe=69B80863"}, {"file_name": "Skillup_Portrait.png", "id": "1081999302905553", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75451778_1081999306238886_7894111874177071851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-nanGe8AN8Q7kNvwHQ9vhH&_nc_oc=Adns-Gfue5516fzX5G4wiqZG7eiR0kWMTQLBt9dAPNc4a-Q1C58iV15EmAqIAXvzj8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxWvaSweMhsHHGO2zO1zTb5xNjbv_hgURgOzGNyMUKHw&oe=69B7F
-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkuvGeq6pNQQ7kNvwExjkEc&_nc_oc=Adr0GtgKeNZ6pNvVgd47G8ozP9D8b9iuotOV5D89yKOeMRmpcHuqGJH-kSleujAL76Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjRTZzcjCUJYFNqu-u9OnVK0bpOr4EdDESC5ZdHuxvCw&oe=6A60C1AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XETy6US36z8Q7kNvwHKQp1l&_nc_oc=AdoV17Pr_-ceh7bOX8C6wr47Aldlrn0muEeTtMtP-t0lsN4KK2Pmyyv80e9HwMTeFJU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcl5hMQw99Hju12H88kRn5D1q5Q2BQjvFB3p36nrGRsQ&oe=6A60B94F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFP9hNgIwhQQ7kNvwEKO5kS&_nc_oc=AdqAYEr6SZ_vXxHIdxlpkiJtgwvLDrq1pZhFzgqcsQazPUuh6tC4wbsfwz0JTnK-d2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-1ARGweY-TSiA0x-48CG_QgouPG2dT1EKnaFDEiIARg&oe=6A60A5DF"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viz22kcOwh8Q7kNvwFY15vu&_nc_oc=AdpiwncdtMtZCBdHMoEBXko50kAt2F7ii-IIeoSc1TDguzWHj_gSJ_s4LBXH1uVJXaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx7JcoC87-JFrXnKSCikVDkmUA8yLVpWOS_--tIjhjcA&oe=6A60B9E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WibVNRwoL74Q7kNvwFzv-1c&_nc_oc=Adqjr06PdtekmkC9u2wyJLuSA4ad1mYMOxOQg5u9uWYkPVjR4YbgfIUk013-sE7tyvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2eEkNAiyBkopF61z7nQdEWY3TJJpwBRSE3pkWsbi9cQ&oe=6A60D6AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MpTfue9FDEQ7kNvwEEER1r&_nc_oc=AdrdGhMxDHVHjeJDrSBicemHrwt7WS13L7Txi42USF1xWbLN4Puok2T6FiA38T8UGCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2W5XRMoKrLscUfYqEnw_Qf3BNSdjE68bvkJxG9-iBh4g&oe=69DCEBAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW4Lqsco5LwQ7kNvwFLfLMi&_nc_oc=Adqb726qDlurQOhhzbAIKzjwz2FBratFPtbLZzOMwoHum9-kgkZgwiFnL-qEAK8vkTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G0U_4v0vI4DH3qRKMkN-qQGOCOkhbCQlR7RBTPKqi0w&oe=69DCE34F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSL8wcqb1SsQ7kNvwEqjqAi&_nc_oc=AdqIilqIt8gvHl_0ymLBeqKuAcYJlySOqkpnd6xkakda_c8Pep9JnX_XullamzJK_qQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a6NUPxwoCXJSGmp1T3Pd0Psj8tg1orTSFQy6J9D3fsA&oe=69DCCFDF"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECwiG-lGhi4Q7kNvwHLWRip&_nc_oc=AdqexN9j08alVCh3Yo_nvXJeSv5nzP_v_hUBRlCqPz9kLaC0WQNs-pEwZ7UN4eCTwbM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xyA60bLgAFyZPCTmkgDYtSYOOtY5E9hy3Zgu7wFGy_Q&oe=69DCE3E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtmAxT4A4XQQ7kNvwGF4Lkz&_nc_oc=AdpfR__zZ8NrhawlhO2iqGAJ511UDillXy1iLkOK3_Zd51knIgi1vELYDVe7O2GiM88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z9OZammsd7IQ-tuTLg1b9IcK8yNoNMuRpfPbYSKsxLQ&oe=69DD00AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
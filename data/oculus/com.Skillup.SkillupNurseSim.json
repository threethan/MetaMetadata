-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MpTfue9FDEQ7kNvwHIlOtC&_nc_oc=AdqSdTBVDldpP0GWkWC8IAWFXAoq3b2iMdXdMKxy1IrIQORvEKgVSjgndwwflnnFyRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oV9JBswWw-tSEGWmTxC9bmtAYvSd_C9LvmbOredEG4A&oe=69DF8EAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvwLtQ3hpmUQ7kNvwFHIzO_&_nc_oc=AdqNrwfxZQg8aGYZ7qtTandW4wTPuTYCFYbcjLlhZXl9Xo92wY-S-XG5eoZnD1JM9Eg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EI_e0Z3kKR-XP_8UrRyLmw3c5yiZ9r5I3NAexKr7bLw&oe=69DF864F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUXMyyTFuWkQ7kNvwG-V19y&_nc_oc=AdoXygtEgVK-YS4R4ayDLxsWwNREyfQtunG9K2BIok8B4eMJ69jwNLqExpQL3lglOZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rVobz5sWnGy-brg0XYqGeaGbjcwCkHeNZgkxfuJyksg&oe=69DF72DF"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhBxXBxQdjEQ7kNvwGmy-cp&_nc_oc=Ado0BGNaghSNdoazXgFLgVCZNdCAOgHt838-6PWtHY2V2-6UhLzlC5jYhN-TTa4cmXo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0owLLv6joeRW9lvTJhtITCEC07kDvYYJsN0Ol-9gO8qg&oe=69DF86E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPjUhd5LrV4Q7kNvwFPOv9J&_nc_oc=Ado6QQzksaiLadQT-Sbn7Ql3JOVMXam3aFvho6LyKsC7bDMsqKcmkLsrxt7FteURwSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mLIJXWo7WFA96tvSdXO4MENC2YrKGTOrmRP31UjRfjA&oe=69DFA3AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J6EcMI3aMAQ7kNvwERVJ_W&_nc_oc=Adr2wBhEXMIIg8WHISapVQdSDvuRrI8M9cTn9V-V8uON8K44ptnG6YYFhV-mD3EOORQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlIHhl8IhFu_6OXGZMqebaafhaFDIOWlMMZrIe12RcIw&oe=6A9C152D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsIeJRA2A00Q7kNvwFGv9g6&_nc_oc=AdpftVzwmyxC_CEE2L8fH8fyJc4TKX9N0bfNX93U0JImdwmJYqXCnwF08BZzpxn6b3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR4ONoRkKv-7kvbnSWtTEQ3WWKGI2vIp_285KGX4pTeA&oe=6A9C0CCF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxgD9SWiTbIQ7kNvwEboIZa&_nc_oc=AdpbV3gZo6Gyw713AkSWvUhE7H6Q9YEQtHA50eKDIOXC1l6ozYEyHrXzKDGv1cfdwYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRNRxvyAo1xKRyWjZjAS8FEhlBoxy2KyGWimeLGmijnQ&oe=6A9C319F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlU3fPLXyAMQ7kNvwHynO8p&_nc_oc=Adq0myfIwuGrGB3_OIVXcoY4QYUwjlvHe6Z-ZKsQeCFJN3zhIzaIYJI_aXzIcwWCen4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQj9SheL8OwfryUPrAisoND9KEspks2lvikb9-YtKL8w&oe=6A9C0D65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXH9O38c52wQ7kNvwHh2DTO&_nc_oc=AdroO350xXLN2_ML1VS7i_wp41UGlubsyBuVZ5aSq2jZyEYXNXzq5DQmkkNeiYTaFEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfNnCRHVpQqaRA9V_DFQ_1GBaBzuL072LNKHoL7DCWpw&oe=6A9C2A2E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-C4NzJvDTIQ7kNvwEcHjrK&_nc_oc=Adrjo4IyiXjqdOkX9NXsIRrWdN5y5jTRmjPMSroRCRSE5cMJwFPdHOfES7EMzMPMMdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zOMrO1aZgxtO2kdmIkN6QoEIZ1_aHUvbTdpxxd-uc5g&oe=6A03272D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJPjk66GaQMQ7kNvwFgo27r&_nc_oc=AdpYXsQo3jZuxcpf9-FHzU6TbSz6vG006EjC9VtIkx72NcgS6SqIOSHu3TrmeI2GLZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RJG26GxAHjAP7A6MGzFudEu6A3ZQYRsu8zPXgXOkW1w&oe=6A031ECF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0BTDnYtupgQ7kNvwGOpZLd&_nc_oc=Adp5M2l2E0FVijkOuEXp_iFx-EVZeNKsHoycu7u-XJ12IdkWcSbX4st05fgwtH0UQQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GONCVKYPYRc_CUxYC_bgUfp82WhHm6dqA9fNBaq6cHQ&oe=6A03439F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgwzMAAvAasQ7kNvwFntrNo&_nc_oc=Adp_XOPCPaowqnE0J0mSsopa432VviUtrMvX5teqPF33b8FcSWnFmViEqEu4EeuPYgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zwm6FVtqg1Z-cQrd9r6dmf2gBKaSlbUZrKso53CiHjA&oe=6A031F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxwQpOVkatEQ7kNvwFRCVEH&_nc_oc=AdpzJAxBwDLloKO5SCz5h30uDX84AecXrrdfwzTudhYolL0J7V3aN9n0QOIldwbLG1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-fP1VcEixkZoxiFCaOgXhiSXprNoMJmYhQO0d8w7x4g&oe=6A033C2E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=polcUcBTKnIQ7kNvwFslVpZ&_nc_oc=AdrN98iVVLSAOkqu8rSY6G_dfzK0IxLFX28rOD5YOHaSfKgZuLapVEW4ynfOEdNxRG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H-3GInBB485pNsLp4AEazzsA0ZtRLWiz0UBXP9g0Ypg&oe=69FDE12D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRfuYG_c3GQQ7kNvwG69rEv&_nc_oc=Adofgdyk1NPI7K8qy422Q-Ip0NdVUXukjsZQ0vtSmQFTXnCncRtd7G2kE1jDrl0lcSo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57UsZ8mpNauQh9WnXLN3yFpiTFwvxxMwlNGgHQ9_voYg&oe=69FDD8CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg8QhMwtdigQ7kNvwEe2HZg&_nc_oc=AdqN1EIoUw94k_V67LrMwhsSJG9SlQT817MOerENwHQn3-m8FHROVpm10B0SOILJ7pk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LfSJDTlbx4kd9jEbvs6rxVbJc8t8j0dcX3WqUvn27jA&oe=69FDFD9F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxoAkPeNY8AQ7kNvwGaCiNn&_nc_oc=AdoyL0DXktMkc1OJqLQ94qqtqdFsLUZKmL9VKgIbq71RS9Urfy0tsdnNJij_6XeT0Pc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6066iDmMwMHRhLZesEArCB6l7bJbwmty_eqlyhsnlmRQ&oe=69FDD965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo79kGRYX1IQ7kNvwF0mGMU&_nc_oc=Adq9mMjLPxtyJ2OHK9lbMOFYBYaaUkUXqktz7xnt-9WDBbIlLL8M9tkCKPxuZCKdeHU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z13nW2y4uHOjoO07Ju3D0J-dE_twyIgRQDR35sT4Osg&oe=69FDF62E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zuGqkDfahoQ7kNvwHitxVK&_nc_oc=AdrM2SekuQHvWa5_4EH97XxuqajCuzPYkOZlcPaQmZZHBRLymIhVRXxJEV1nJoZmabM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af882kRCq9BdjabjABFRjRxMG9T7g1lUpGAcTvO1fFgjTw&oe=6A329D2D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcoTptFqWHMQ7kNvwFku06n&_nc_oc=AdpXSVa1mIBcUDlnvx-hrlgQyg_hnBrhronePxwpae-J8Ru1nJxo62lciif_rHszB9c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LnUz-TojEmFCtx9B8QHuJAevDwo3psKauwRhSLLfxMg&oe=6A3294CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIfC2xhaPDMQ7kNvwHwt3jj&_nc_oc=AdpyhI1fMF1Yc1r-mjBIZkOFYnLvQ3vzzExOe0DFcYk7WnTqFtTIi9STp7cWCFOOKao&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88KeOShjaXLPTe6I83brKJjmpxVbKz2o_Vtq6BOwnzQw&oe=6A32B99F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4yyAW955CYQ7kNvwHRRI_7&_nc_oc=AdrdWke691lQkRcL7-sYR8gPH-wRZZDFXtPUHeJH73PPzj1JKje_XaYtfOD4dS3-6gY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6XNmsqUotuUH2SJQkyzC-gqJNVRelaAEBJBYvXbz8Qg&oe=6A329565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsZ8hVa9i5kQ7kNvwGDQ_0O&_nc_oc=Adqo9BrpupiDZ9XC7_sgiJn9O72l6wcF_u9FAz-itVT_HQg-CNAcsK4qLLl8SkLzL3s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LXiWetkOPzjuDHNAqDeLZ739OY0SAMIEs65YOLuL4kg&oe=6A32B22E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
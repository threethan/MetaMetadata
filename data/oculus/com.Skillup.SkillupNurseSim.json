-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjIuW1lV-WAQ7kNvwEh6X8X&_nc_oc=AdqgUijRBPq1KSQ93mGKFNfaCyEci8il7eJ7uZFArezrzl4zgrZ2aOygL0dUtQAfFsg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEafbvZBSsObQ2qN3_aYJ2SVS2p0-YHTZL5er498k4Qw&oe=6A9037AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dydZ_N7gwM8Q7kNvwHcwMj4&_nc_oc=AdqNoXAX6ewKnpbV-xmvMPOdikq4Uq6ulEfVQXvF61MHwfsZkC38LYkWK7H6C0nFpFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeGOmLvguIg7hysSDWAsqrBML2dgJC0RV6qgxsO_16Mg&oe=6A902F4F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1F19tLeLvgQ7kNvwH74oTr&_nc_oc=AdrZLvDNCC9VXGsfm00xszbH0QG58QhvhVnRabGh5r9sc-VXT3eDdTb0K_JTw_QqohY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPT7pg6Cu7Dedky_xuPbqtSni3Y2WzGEfhSGZyJiK92A&oe=6A901BDF"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYJYeIdncdYQ7kNvwFjkk7I&_nc_oc=Adr73K5p3dFFJy5YPWh7SODiQLCeMj1U8ZwLOSxFuIsQZikjWb-JHisgQHlzA0pM-2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPt2XaGJvbrb81Kvbua6IK--V4OA8_EHUqu9bm-w2ktw&oe=6A902FE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcTuk2h-kmEQ7kNvwGBXjdO&_nc_oc=AdqdyUCva1LM_jcALBRelfmUUYDjYHVb8QEItHw0J_zR2d250CX7L6zYv24rz8p2W_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsQo2gpSGEmR2uo-H_XYPpycW3zSgqUGxBVgr1f0HqqQ&oe=6A90146E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
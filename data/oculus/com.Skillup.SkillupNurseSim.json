-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_VMiPLxVsAQ7kNvwG26K9O&_nc_oc=Ado2uOwVHeMPpMnddmR1QDQ_1l-PKTF-IQSf4oR_PFL1nGUGCjYfN7KlGyizZd1J_18&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPdWxkQGfB8AgIhrVZSAYS07NjyssgamdlDdZyx0p-0g&oe=6A8AF1AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cC-h_3tYT8Q7kNvwFpcnv7&_nc_oc=AdqlJRfUKQyHcRdO_aQcqoYNyKWrkno913qwX2vpiiL3xFKSsfbBty000CY9mWc2UCg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_zvodTpXfhQCTVZwI5C_jx6ro23wTGuWGLWdR_0QGug&oe=6A8AE94F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs_1AgnlsQEQ7kNvwF3bqKz&_nc_oc=AdotY8JpZynVAKfuKYk3jB-ygRAnvYmxWIjdrSmSQf-LJILh3UH3VkqzT4-3hHRskSU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsddDbTZz_gBI4JIojiPzYtGHpC26qfzkZECtAPyhtRw&oe=6A8AD5DF"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xONhpGaRop0Q7kNvwFOVOH1&_nc_oc=Adqtj351gA-fant_XoH8oro1K_knOgVndu1faF3SJCU-rwF9FZNwImZ14lYv0c1euWI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHct9zYYdv4VcNR-zt00KcOr-zKXXxWl1MSyILk8EkrSw&oe=6A8AE9E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj1x47nt3TAQ7kNvwH2Gwzt&_nc_oc=Adrp4g8DOp4-yuWID9d6LFsBXAU-yhXcurhl6Q94Yj_GoxMfRrBCac8tbHXS2Ozb3TA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6OGzj_guJm-E-JYKTIUmEoKnmAfPEy0Q9LOj4oPhRHQ&oe=6A8ACE6E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
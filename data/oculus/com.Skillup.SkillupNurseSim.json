-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JYyen5-a7cQ7kNvwHy5z1r&_nc_oc=Adra321lb5VhjCGbGjs0DlvwcCQHEse5_NF4seupRQdu1CCgDvJSjSGN0SzPHhptdLE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GPK6euM55W4Ml_OUbRQdnEXzF2djD10yGWpr7QAhShQ&oe=6A411DAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-5rTEKr15wQ7kNvwEkyhQt&_nc_oc=Adp8s_vi_FrGXvfFmFEJe5Hm4kaKq4Qa0KtBRmEkJg6LXdXmxqXOBBbBrLsRelw6zPc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95MUDK99YdHXe7LFxnyLf5CxbiG1xqd2IuuJZZ7q91iw&oe=6A41154F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO07dpmRIw8Q7kNvwGN5IWK&_nc_oc=AdrLkf_pz0fngodIdWBtbjmTDZoMXYqEcEwbWJyVjcMovGp-zoX_vgdmfIbLIvbQB9o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GfiW6grUoJOOu7qoKog0CaWBuKh1ECSb0f-pFRbMefw&oe=6A413A1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mESaJsVEZqkQ7kNvwHeF52_&_nc_oc=AdqJS8uaS9xX9ciKclio9iapLJdbnvHwKQYL6KtT9WtCfTZUZ6SgMOFOkU_v6LWXW6s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JKZBVSpx91D-3dugqbANf6qzdY5MBmFJVbQOsoacuzg&oe=6A4115E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h502JLIOflEQ7kNvwHHmg9I&_nc_oc=AdpVSV3Q_vZCKciS9kFETWpuRb_ReOrD-ZQXrvYhl9uhjUMjTfFg6G8gbZog-gzSdR4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wrqE2k4lskLX7vVLANzJRggDLzo5opmE5Z7_VzfpyIw&oe=6A4132AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
&_nc_oc=AdpWTmh_BCQD3TFYm1jzmipqeWt0y-ET1A-Le50fntxi5-JV4auGYxliA8EbsKK0G0o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpnjO6QMwAY6hfxXSLYtOr6zQkTCQUsgStSj9EOMeIxA&oe=69CFA4D1"}, {"file_name": "Screenshot4.png", "id": "3134923183379461", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819356_3134923186712794_9197490298282120956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYioGfSl_xUQ7kNvwHSkhrk&_nc_oc=AdrhS-Ehd8f71D0qB5hX9XWerStUqpXLA_m3bkKfGiOZLTbLI1WUnXn33Dgf_kzDg3E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFgVMCaH7TTIXqVGe8NFtG9is8nY-O93C-7Lp4VwW1-w&oe=69CF9D55"}, {"file_name": "Screenshot5.png", "id": "971211105529115", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824665_971211108862448_5202587497473315011_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcdN5YjcVeAQ7kNvwEc6cH1&_nc_oc=Adp55gWHZZLurC90AwVhTPFbKrN7EhlpVxS7_LNsZfecuihyqFouSt59CPMFoh_PpJA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwImPcoJWhZNLI0OTwGZqPMXMKKlVUeyk0DCn2-oBO_iA&oe=69CFA464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NEW_NurseSim_Simlogic_Landscape_jan2026.png", "id": "2027376377808802", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_2027376381142135_8703234581041733537_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7-cCt73iAMQ7kNvwG08fZi&_nc_oc=AdqVJGZwAdX_iMmWuTXAAw9WtuCQ5qjf4L1qwpvxL-tIQkwOPXSX3OCDs2n-vS7Fdw4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwjl9cr5DnzuTAA7GZ20w0GEeYSqSLuEGYp3S8LFXf4lg&oe=69CFA428"}, "display_name": "VR Nurse Sim by Simlogic", "keywords": [], "long_description": "VR Nurse Sim is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "VR Nurse Sim is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}, {"images": {"nodes": []}, "id": "1284399823595445", "locale": "nb_NO", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM er designet for helsefagarbeidere for \u00e5 praktisere sine grunnleggende sykepleieferdigheter. Utviklet sammen med en norsk fagskole, tilbyr simuleringspakken flere scenarier satt i b\u00e5de kliniske og hjemmemilj\u00f8er, for \u00e5 la brukere \u00e5 bli kjent med ABCDE-unders\u00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker.\n\n- 8 treningsscenarier med forskjellige pasientprofiler\n- Flerspiller\n- Engelsk og norsk spr\u00e5kvalg\n- Intuitivt, interaktivt og tr\u00e5dl\u00f8st\n- Kompatibel med Meta Quest 2 og 3 og PICO 4\n- NEWS2 Scoringssystem\n- ISBAR Kommunikasjon Rammeverk\n- Mulighet for fasilitatorkontroll, kommunikasjon og veiledning *\n\n* Tilleggsapplikasjon.", "short_description": "Skillup VR NurseSIM er designet for helsefagarbeidere for \u00e5 praktisere sine grunnleggende sykepleieferdigheter. Utviklet sammen med en norsk fagskole, tilbyr simuleringspakken flere scenarier satt i b\u00e5de kliniske og hjemmemilj\u00f8er, for \u00e5 la brukere \u00e5 bli kjent med ABCDE-unders\u00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker."}]}, "developer_name": "Simlogic", "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Simlogic", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25561247326890788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_1143988431101940_1472357127954071243_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCpD7Zi3l4gQ7kNvwEAyHkS&_nc_oc=AdqiIoIoldhw_wmmmyiskat97r0wIT2waZ4e-IzZrmpogflQ3TEHbqLPwGHUizvFyc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMxXzaBCiwsM1LoO-R3W4BFpVAbORJlJPSAdZrKAaN2w&oe=69CFD450"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Nurse Sim by Simlogic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Medical", "id": "4780893017
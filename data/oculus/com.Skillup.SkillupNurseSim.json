-3.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QadT8O0clS8Q7kNvwF-GoP2&_nc_oc=Adr2Q-1_--49j6tJi_78EjSO4WqFBz1Buvu_K8mDXyIN64qeT6CKmkiBkY8Bu6FqIjk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55WZ9WcwXLiVDUFbM3583EHSoqvirnV7wpYe6j7Dxw2w&oe=6A12F92D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR1wM06R4N4Q7kNvwEgueZS&_nc_oc=Adq3Br5_vTCyHLclZzRx0rsMIhPhVXnFOeiEqAJp-YFptOInYmyC5cztBLf2tdUbGAU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-yRB5qgywkwSNu19aH64Yab2zOiD4QHlQIIyDvHh0nA&oe=6A12F0CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HdeMkfsZ9QQ7kNvwHsC8z0&_nc_oc=AdofKnyXWKL1S3euMAMeyCcY9dpjQZfNDlxkzemtZhAOOzDcP0DVyuUOecFX46wTD48&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LhSpZa7tXfoirOCkrSkmWjvgteUTWyYGBKt-E3fvHpg&oe=6A13159F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbUvtJjKRAAQ7kNvwEwRB28&_nc_oc=AdpOucBGrbcdclJfOify5BXgp92j1sSFSTqEdKvb-0dN4vsp9dqdYG6LBmY0Fr2UvCM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wSTHL42twpHrEXFBTjb7Wf6WhbuMaqRkSo8FwYe6Mmw&oe=6A12F165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IljoyEU0WuYQ7kNvwGaLMAC&_nc_oc=AdqNPdXYukk_3gBy-mT4_4JZfYltx_i7KrwTtgyxNIen13nToSg7ZfMFQc0YD3S-UHw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af561fOVzAheckuw2dAMQyY7CNp5wS1CIT2MnSonxEnegw&oe=6A130E2E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MpTfue9FDEQ7kNvwFoe4-j&_nc_oc=AdrHrWM7KayTIPmcoXnD2RJ00JlFBd7UuaQVkZupJHcZ2iqf-dqJQnS1Fa8kF_Dsbik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HpzB_7X_JLFz2Ase9ULOmb40bKYCHN0L1CRfAfHfJAg&oe=69DE3D2D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW4Lqsco5LwQ7kNvwFtKDw6&_nc_oc=AdpTncgA91ve1ZsEtnJUB9m2V0PwDh_-40NRyhK3SmjqodFMMwxRp-CiY1H9oz2wMno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nHkwsBZ9QJc-aWpxcg5iJ83v-0awyS9V0jHYSdqFO-Q&oe=69DE34CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUXMyyTFuWkQ7kNvwG5eZhc&_nc_oc=AdrO7ajWIkaCqxzEoXR856bTskutBuQ0wLXb5cU9USRhR5tKyGYrz5nQ9JoK77vfF2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17ziBuBBnDnysgJ08wBK55H3ics_T7ZWvOqDZ5COt5-A&oe=69DE215F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhBxXBxQdjEQ7kNvwEQCUGr&_nc_oc=AdplW5NVmV5PEfqLLzKMIwl-JXru0mUqn2haqWWsj74wfcB_KevlaeC-5r7264X9zok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RukrmihVefGMz6FYMsZm6GPd13ZknJvL9GJVKzR8G_g&oe=69DE3565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPjUhd5LrV4Q7kNvwE8IKIB&_nc_oc=AdohHQriOi59aSoiZnE1cFMdFNnB4JFdj6-wh6Mt3uVTTcRicXu4gCh56GAcKyOxTnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oQbeuFjwh_1FDDSTwDTE0vRUlpqu2qkvyFfIQSgS5nQ&oe=69DE522E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
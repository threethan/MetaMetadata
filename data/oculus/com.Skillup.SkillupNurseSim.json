&_nc_oc=AdoOML-1fU8wztS1d8UHtVyRh_29HGeg4ab5dIdEIX7iGFrqOUE-OQN2rFNVPFXWArc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwbe5g2zA0awaJ0qRyY04m8WUhDlWmTPTwA02UEmgYynw&oe=69CE5351"}, {"file_name": "Screenshot4.png", "id": "3134923183379461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_3134923186712794_9197490298282120956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYioGfSl_xUQ7kNvwH8UzKR&_nc_oc=AdqImyC7JM7-bis9MGfmoGXUqAd7g4ZOD9i5UU0INjGkDfym_XmWES7zaSyPbVtzHcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwceUwnkNgYugMJ5RnQ0wPcoOIItlCB7ctx9noNWJ2eA&oe=69CE4BD5"}, {"file_name": "Screenshot5.png", "id": "971211105529115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_971211108862448_5202587497473315011_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHDoLPsYP2gQ7kNvwErzlBp&_nc_oc=Adp6veRTZZhK05ylNGiJT8Yw0sTxcbOIf6YQN3OnPlaedyAsZ3LmVJBbrHTXutRLrsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKfKv3QsujS3qje75ee3l_z-4yEjVEbZvuDRxesjCsZQ&oe=69CE52E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NEW_NurseSim_Simlogic_Landscape_jan2026.png", "id": "2027376377808802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_2027376381142135_8703234581041733537_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS3NhniMN6AQ7kNvwFAGMJ-&_nc_oc=Adqmo-OoxUcH7_v_2dDrUszKD3xDbWw-5rxMy7ougkiPM4OPXPqIzJLPtJH1eq6m5jA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6yzhhV24fGYDIvfNQCjfQ5k_QQxN6YmiA-R9TqdyN0A&oe=69CE52A8"}, "display_name": "VR Nurse Sim by Simlogic", "keywords": [], "long_description": "VR Nurse Sim is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "VR Nurse Sim is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}, {"images": {"nodes": []}, "id": "1284399823595445", "locale": "nb_NO", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM er designet for helsefagarbeidere for \u00e5 praktisere sine grunnleggende sykepleieferdigheter. Utviklet sammen med en norsk fagskole, tilbyr simuleringspakken flere scenarier satt i b\u00e5de kliniske og hjemmemilj\u00f8er, for \u00e5 la brukere \u00e5 bli kjent med ABCDE-unders\u00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker.\n\n- 8 treningsscenarier med forskjellige pasientprofiler\n- Flerspiller\n- Engelsk og norsk spr\u00e5kvalg\n- Intuitivt, interaktivt og tr\u00e5dl\u00f8st\n- Kompatibel med Meta Quest 2 og 3 og PICO 4\n- NEWS2 Scoringssystem\n- ISBAR Kommunikasjon Rammeverk\n- Mulighet for fasilitatorkontroll, kommunikasjon og veiledning *\n\n* Tilleggsapplikasjon.", "short_description": "Skillup VR NurseSIM er designet for helsefagarbeidere for \u00e5 praktisere sine grunnleggende sykepleieferdigheter. Utviklet sammen med en norsk fagskole, tilbyr simuleringspakken flere scenarier satt i b\u00e5de kliniske og hjemmemilj\u00f8er, for \u00e5 la brukere \u00e5 bli kjent med ABCDE-unders\u00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker."}]}, "developer_name": "Simlogic", "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Simlogic", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25561247326890788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823901_1143988431101940_1472357127954071243_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCpD7Zi3l4gQ7kNvwHir56D&_nc_oc=AdrhS086NwMgDb3ozleIUgwN_kN3y5_bqLj_JIryRNzVFdCEwqbAE3FRXCR3jsVy5sQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuzQJq5DtVVjSgtCu9DqH7vXsBIaVu_mXb3x1BptDzCg&oe=69CE82D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Nurse Sim by Simlogic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Medical", "id": "4780893017
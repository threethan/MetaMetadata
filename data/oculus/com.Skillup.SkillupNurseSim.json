-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1cm48BMcusQ7kNvwElshIO&_nc_oc=AdpR2zdiNJBrWwRHJyc2MdlU9X3cn3P25Jm-PTpY6IU8GM1-tMMP3hVkl-S-VwIdBiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XkXbg1xY-2lWuz2o4U2Ml20tjndVEIhWEW4t1onyWGw&oe=6A2962AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLiKnIboU9EQ7kNvwFBC245&_nc_oc=AdpdRmpgO3N5ZI2VDxECg0XBfaQrj_TIkoCLMH990kowE7_8C6kylcqUpI6eCh67iUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nFOcP8Z1H63K3G4CR9pM1yNSQgkC4orJvEOD-1X6GDA&oe=6A295A4F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9Qm7g0x92sQ7kNvwFj9VIr&_nc_oc=Adqyzl2l21vLVhnNDeSbEMt9Vo4hCtLURRJcTPQeqqC_WPhhf_ZtUINKKQIDxnKVVaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3f7nqw-mgU9OivRk4dJnxJrBytCvhG20_Jk6TmVmw2g&oe=6A297F1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-fKRp4veosQ7kNvwHxVY3O&_nc_oc=AdquvqjWbM6m8l_A5dIRHl9A_-2NyXSiQSJxQ4r2WpYRYfHM5DzfYQyTiTANzAQZ0BQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jTXpHgtvP3gZZDnH_GUbqteqrsIrTKXnbUhPwpmxRDA&oe=6A295AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm4e-AvXiywQ7kNvwG1dB3P&_nc_oc=Adrwj7AJZrm3UUS4sLdCleKlt633nTevQeBgaVGU5umUGGIrhLDFyODv3hkNWXlYlTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dnv9De6uqaRVPygRBbUj4qFF4c1wTFS-M1-OrNeUjaA&oe=6A2977AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
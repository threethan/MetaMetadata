-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjAkwia43vEQ7kNvwGfM6D8&_nc_oc=AdpywcnxTfiW-HueV66WLjzg3DBiwn5FD6V2YFbgBr3kB1oE292IDkN45Zdx9fHqCmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp8LLgF5pyDpq_30qAXv4PkQlG-7pOGXL9519TfbJMLg&oe=6A5392AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV_0Ad6BwAUQ7kNvwFJaRwQ&_nc_oc=AdrV__9E0mTW4iIrdwtd1f08vkPwEm-1kXeoc9Hf7RjoQLGZZF8lP2lCEWmKlRSDrJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgT89ILooq9WqFoWs6KKE2DXQnwLqRIXq_f29m4KtSbg&oe=6A538A4F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlYtQzh5AYMQ7kNvwFcqPkM&_nc_oc=AdoEAvtyoRTbBudaqkQroRVbpZ_KBYWx6x2eLUIDT-xJE0IuHixoCANVtGhrKXRTg-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Y4PQ-P9AAv0GSXqDgeeYkbSRAglm8MyHS4tXp14P8A&oe=6A53AF1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmuZNBXYU04Q7kNvwE1iARo&_nc_oc=AdpW1889UZARvSpD83mQHOR-fIDNzSg9xhNP5hihn5w10n-36yk2HL-1bQ59lPXnURY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqPg_axyYB7gdpDjeeOodlW9BRMBg0ZlYDkzIVpCu_1g&oe=6A538AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAP2aPp2JDAQ7kNvwHdq9Ur&_nc_oc=AdoXw4VrJs3KA1uO_P3ckMIrX1r6fDnNjqqjLEKQpu3h5j5v8d6eW3N8DSFUsg29r4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaZYYs5miDToMPUa8SUqZpAfVu3ptSi7Ib5ZEvXKzw8A&oe=6A53A7AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
CbBcoJcTNfPM1irJn24Eg0QQSNtoE0VvndgbZxft2Io&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHd3eX8V5syntVKi_Jn5iA2OoiGCBMa5X2DKeeqT5dgQ&oe=69BFD2D1"}, {"file_name": "Screenshot4.png", "id": "3134923183379461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_3134923186712794_9197490298282120956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBNeOpuvzUEQ7kNvwFO2HdJ&_nc_oc=AdnBFpUy5Amo5JNVjnJUedf4hohwPdXHIAQNmoDNoltWkeM2jahCfOwUMthhQijFSMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwx66_Lqbfa7MUWlNyCKczTrpvx2blJYxTIlxt21fBKjA&oe=69BFCB55"}, {"file_name": "Screenshot5.png", "id": "971211105529115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_971211108862448_5202587497473315011_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0ykizhvNFgQ7kNvwED1dTl&_nc_oc=AdkbmAwe9rxvBpq1UVqlz_-stg_3A-SCeCSSAM6tjx6_YFQxK67dfkbTdwNQMcR9MUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTqwfAxw_ojKOzefvBHr_pk9FYaXW5oZ710nYg-HoM8g&oe=69BFD264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NEW_NurseSim_Simlogic_Landscape_jan2026.png", "id": "2027376377808802", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_2027376381142135_8703234581041733537_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S7pRUOe_ZAQ7kNvwHcbmJK&_nc_oc=AdlKqhJnDlsklNxqYmBNySsUmQuL-crQ-y8yw_3OjKBJgcH1Q1BX4TRXpBono5F9qaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlPetVnbXcRmbNAR3aibGv9ybibNZqPUCW-MXCSNS9Sg&oe=69BFD228"}, "display_name": "VR Nurse Sim by Simlogic", "keywords": [], "long_description": "VR Nurse Sim is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "VR Nurse Sim is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}, {"images": {"nodes": []}, "id": "1284399823595445", "locale": "nb_NO", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM er designet for helsefagarbeidere for \u00e5 praktisere sine grunnleggende sykepleieferdigheter. Utviklet sammen med en norsk fagskole, tilbyr simuleringspakken flere scenarier satt i b\u00e5de kliniske og hjemmemilj\u00f8er, for \u00e5 la brukere \u00e5 bli kjent med ABCDE-unders\u00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker.\n\n- 8 treningsscenarier med forskjellige pasientprofiler\n- Flerspiller\n- Engelsk og norsk spr\u00e5kvalg\n- Intuitivt, interaktivt og tr\u00e5dl\u00f8st\n- Kompatibel med Meta Quest 2 og 3 og PICO 4\n- NEWS2 Scoringssystem\n- ISBAR Kommunikasjon Rammeverk\n- Mulighet for fasilitatorkontroll, kommunikasjon og veiledning *\n\n* Tilleggsapplikasjon.", "short_description": "Skillup VR NurseSIM er designet for helsefagarbeidere for \u00e5 praktisere sine grunnleggende sykepleieferdigheter. Utviklet sammen med en norsk fagskole, tilbyr simuleringspakken flere scenarier satt i b\u00e5de kliniske og hjemmemilj\u00f8er, for \u00e5 la brukere \u00e5 bli kjent med ABCDE-unders\u00f8kelse, NEWS2-scoringssystemet og ISBAR-kommunikasjonsteknikker."}]}, "developer_name": "Simlogic", "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Simlogic", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25561247326890788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1143988431101940_1472357127954071243_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYxgabnLSaIQ7kNvwF0Ph0n&_nc_oc=Adk8NBza94hHwd1Xpo5y0dhGflHEciaRjTAsuWyU74wGy5IQhBiSJHZ8lYHv9qSdSUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzK029LirHeaXQ-qkBupBdlhNDhZE2pIw2XyzP1OYay2g&oe=69C00250"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Nurse Sim by Simlogic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1725624780, "lastRevision"
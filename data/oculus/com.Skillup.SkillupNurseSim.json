-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjIuW1lV-WAQ7kNvwGI8xGB&_nc_oc=AdqfxaZuHdn35TJWGs-hXGme71p7NNJ1ysPbQt1Dgo44myvdUrHpxEdyTs-BZ_YTlEs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0F9C9NHgE3oTSLZmAxWhlYUBUcSlBN0-TTRnuNzNt2Q&oe=6A91892D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH3TJYE_2dgQ7kNvwFHZPhZ&_nc_oc=AdpgO3cuwFBzEebBqp4IWiTNKBO9LmCHxMBw6G7zpGdQB_CJ1oaqVUt23dBe3I5036g&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbIOUMoHPUGjNu6SIRW9XzthKycKPo2qw214sU_25wIw&oe=6A9180CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1F19tLeLvgQ7kNvwEGPNV_&_nc_oc=AdqHbibxPJX2ZCo19ew72TY6udesgcPnaDH8-F7Y81XibjvulyY92kpXhC19E-5uRzc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEogSmtpjy70KVmbgm7LDtBXMfmw23kJ57p9g8cT8MPw&oe=6A916D5F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYJYeIdncdYQ7kNvwFcM2Uk&_nc_oc=AdqRxLHsQi1_UIE0gJXCbvffNjtqyrD9SuqI7zgxka3_8EzA8CaEt9Dy0UqwUEC0kwM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNF_x4E6TroV3FBO4AcPUdNeNe7wjuOGtTzRS4ZTtvRQ&oe=6A918165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcTuk2h-kmEQ7kNvwFdMsaJ&_nc_oc=AdqYVv0Fruw7mmoh6vxm2SjFznUCuri0ffDEo-xTINjdgzljmjPe80URga6T0qbFgyU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKoiBII4BXYyJwg5PsEReT26COO7CTklfEb9NNom3Fiw&oe=6A9165EE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
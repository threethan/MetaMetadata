-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-feV6z_il2YQ7kNvwFaoHAq&_nc_oc=AdqKh8ZP90C8rUqXGOK1_-Nbsm18oZ2OHS9XwsTxiZwwg3lpeG4bG7ZwIhNG5sgJIk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7My93qvkSMvGo6wzgqo_xP0ca-yQDdwirwsYEcA3P0rg&oe=6A0B102D"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl_xw6EHvKQQ7kNvwGLK_sn&_nc_oc=Adoc1VrX42OTDhcYxIXgTuHs2JQowvimHPZ8SlboOgzCALRe0jPW7X1MmDX1G8raido&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zn7adk8psZ368BjOhfr9ZcaVBWh1VVj3ejQyhdXvYMA&oe=6A0B07CF"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6OrSuIwMwkQ7kNvwH6_iXN&_nc_oc=AdoD9887MyifihHw7-zckaEINtf38R8PEYRRqZ_RFyyKzYYiAJgjS2uztuQ_gtWNY2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qrBKRkjp95cHxOz9GiOLsEtugXcduNzQIayHNhGcm3g&oe=6A0B2C9F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7RFV6G46hQQ7kNvwFB3JoU&_nc_oc=Adrf115fT7JMlNg8ICqxCUl0AsAnFPOQT-RrVFfLTQn3tkUrdSOsD6T5VYRNjcGzXY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w_dxLlE_bHvPG-T3B9H7K8_yukkxOOARet_I8_nVL8w&oe=6A0B0865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLBm-iksZy8Q7kNvwHxA9G3&_nc_oc=AdpEXW2AEtGNI8zJm2XkPL0fvyA7AcJtm6xpAmye8Ixzfl_zEMNCd-5D7P4vQ-YCkJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yob1E_Rtp7r1HXA7iwOIVaCvBeBJiYg0j8yROVLD1FQ&oe=6A0B252E"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
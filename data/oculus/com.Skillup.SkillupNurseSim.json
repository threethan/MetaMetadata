-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRA0AaI952sQ7kNvwGMbspq&_nc_oc=AdpuIAx-_76ScSIhGu8g9H5jMLjtxcUvVvaotGsxPtyaiieWcHSjORsNC0t4RCTExIo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UbzVyephkAcczrzhH1eUAJCwJ6iye2nnxkCJPIA94Jg&oe=6A16EDAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C23UWjaoCMQ7kNvwF6K1My&_nc_oc=AdqVv2rTMWsIP_sklCjY3ho9MnJsLRT07ov9aDMoCfx5bSjd5hO6fAn_br0_Ynfjt88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5izuc8el__MIxHs12Fm-BsfZgyIhw7nP_mHTIk-vBekQ&oe=6A16E54F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u34w9NNcuAQ7kNvwHO7dy3&_nc_oc=AdpHjRkS7V8FsyekdgCo5uVZJAFc09lmBWsIyYth1m0cHq5zaCMCrL8jDvJrJyl-zFU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F7GB_9vd3-zk8N_Nzow6IjQks3MVF4MclP76UC7WCEg&oe=6A170A1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri58zKUubcAQ7kNvwHf902Q&_nc_oc=AdqLlMxDTxj8N_2KK5QPclaNxIdnatOfmsYcGgwHILmmYDG9h2jWYOWFXhmZ4bxVII8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HJTr8CwBOT9g3-ZsGzQXe_BJKHRceVEvplCgGFEWCYA&oe=6A16E5E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUZBXkgbQ2MQ7kNvwGDwvh-&_nc_oc=Adr9HvLKwGEKKN27AF5RzK5gVdQoQXgL39PTxxmZ2x6inCCXMexLqBBegzwUg62hl1k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_HAg5JI2vJBnTPdvrTlGeKv3Nctq_9ak3ERqnxlHqrQ&oe=6A1702AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
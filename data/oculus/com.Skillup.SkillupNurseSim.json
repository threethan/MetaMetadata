-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGYo2jGaE6UQ7kNvwEVguTx&_nc_oc=AdqJInQ6Ged8L05HPoCmPy-ZRCG39meQ5cpcQo_z1NCuv1mEDBclxlQlM_79aV5EaZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8Oski-cn362cHHLFYGkALjX0YaiC9hdtXoV6Qn29ktg&oe=6A6B4DAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7mWLoidcnYQ7kNvwFqmXEg&_nc_oc=AdpLm-1N-ZPjBzEb6i97dSqz2j-f-s0aR9ChWP_EUsfLDiDyJwEyQjz1p1bBwIpZXOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrpEefYzLxxAw1n6e4Tl3z2BNul1WlQsMIB3zhyQXGsw&oe=6A6B454F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHFZmCHr70MQ7kNvwF7Vq5q&_nc_oc=Adr4h7v3ADL_Fj_bU-L9_ABFSAz8FyZ-MfTRKR_OU5bZzQzM0Ly4H3TcfJIaEyF598Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_B3DEWFd4hpuZSuOqrALMBJM7amK7ltX8waaam8mgzA&oe=6A6B6A1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTaAytkqIjgQ7kNvwG683Mx&_nc_oc=Adp9_uEPGMQPkkrQU-mXOpdNoac2nc-62e89rcBDEfZgn7NIjm-FBzxFXeC7wys78pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-03-LhN2DV1k0zUCDpkzOV8RQaQymt56bUkkD41eOBw&oe=6A6B45E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sF_cN2eIHMQ7kNvwEqxR7I&_nc_oc=AdoqMcBDG9nORkm9Ld1gTDE79-HwIrwDUNypdFP-FsWmxLNuW2G13HESraPQBSwesIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8wYCd1VZ3SavEUX4ji80lCyk3EPUe3siHgorh3VqYJw&oe=6A6B62AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
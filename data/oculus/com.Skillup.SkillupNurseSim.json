-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxGjOZLOHlkQ7kNvwEPv4Dg&_nc_oc=Adq8nLwSnRs0QoZhwqx_f2J9yZXc5rjlfBUuA9q2ySc5eEZ19_Txneif0l5Mbi2L4RI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UdjayR9Yl4EYjsm_j4fRaVVGu5rYPx5XNYZs6--WuwA&oe=69EF60AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1lAHlYmDd0Q7kNvwGGQHb8&_nc_oc=Adq0M6BClxW-r5_TT2GbRcq3G1X5bgx71KCsHXx8BfSzwf6F6WrMmPg-oODkHsKf_gE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AIwFldUey9hOi2BI_EspeqxmPXFQsH8Zk3-I6gRfxXA&oe=69EF584F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUHOtzvuiEwQ7kNvwFsw0hq&_nc_oc=AdrKq5DkIFSiAMYpHcPRH-a8Vg2VZ0ul_ssmEOmFjZ1SIJlsPtMMlbuORbMsJNtg56Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uaQmU3UNtucsk6WhH_lq4xH0wBZS12EaIogY0CqfiyQ&oe=69EF7D1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPtER5t1bfYQ7kNvwF91ziQ&_nc_oc=AdqqCArMArjejRD-YQ1Zk2d0FTjgr3TC48LMVoDmFwwWVtLsKVtzWQFiWrCAwlk4Fjg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22jqEeO_mrAHSEZ0kQGbKO708udo14RI2hVEAi6HQkRQ&oe=69EF58E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kNmDyKhup4Q7kNvwEHMMf0&_nc_oc=AdqG2KP9WYm6poUjyXcN8QJsr9h7Tobgj7XhgGmYRxnYCLyMdbQZceP4KGmVV7T2Iio&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AAMzLpXpmw7r7qmleJznDAU35TYQcpJ2DDUdwpSQbnA&oe=69EF75AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dXBxkSSQMcQ7kNvwFUKCvt&_nc_oc=Adr58kk7XSOKkM4DXO7tgjkFxFW8SAm09SCj79_Uj0JyJHw8QKOgTKgK-QNgYwiNvrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TCEnUnujj0GrRpLuB6NPoIiKXcYlaSSVGJuFnBruiNA&oe=69EA1AAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47C-yB--my4Q7kNvwEMVc-j&_nc_oc=AdqB8qgpFMv6sTwStHzfPp3wNThjFs0L2JQ9qf50IzdZHeHL36l58KwTHDWBMQgvO18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MS_ubqpA3rGljMEpn40s0DxYZUovVnUN2eoW3ffKifA&oe=69EA124F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Sbh5-zpXAkQ7kNvwFK1n1l&_nc_oc=Adq2vtvZ6I1LeXQMJDVFvkIqI3ABhQNj9quX3I0cxC9AbxKeoPMn4bJcfrUZ2WNKxu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pkloWHjdWfBR8nESSO_MwDXXU5zlLSS3dLznAoZrZeQ&oe=69EA371F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYaNWqi5OrEQ7kNvwFivN4n&_nc_oc=AdrUYKLUUFlHFroZkhT43f7hT4hjQo5FOrK8L7zCrQr1pvxAPMZGEAkvmJMrQP552ag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JewANW4Zs7HTLWWrq4OsaR8AwTeq2fAM4HWstc9A1SQ&oe=69EA12E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwQH41jJeDcQ7kNvwHd_PPZ&_nc_oc=AdqCnP6kOYR7o4x02LD22SUjcfPqCjaNMkJVzh5ueDC3c6fwsXPIpI6wVmUFuxyWbpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MCN2dEsRYDuC-8w1v8fOaV6HUY0677MeFG1lYljkqhA&oe=69EA2FAE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
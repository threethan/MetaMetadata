-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fzT_27h6xMQ7kNvwHxGi2T&_nc_oc=AdpBK0xZMV-l7WdivJf-BnsJ_yuGfZNCfFVnMSOytVZpi996fgW-VyTkdahZAZNtGoY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8BWPnrK0mLEjM5HWKvpZExOg_dEr_z1VythvtQERdVQ&oe=6A33EEAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcoTptFqWHMQ7kNvwGrrV3P&_nc_oc=AdrbuU7SYCFF4aQhWv5xroPE1OASCMS7i_fhr24W7-wVZ5-NKM4aUGupn9guCufip54&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cwAbFxPexa9xBwzKzIAe6Hc3myeUhftdUT8npy4HkTQ&oe=6A341E8F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIfC2xhaPDMQ7kNvwGrcYE5&_nc_oc=AdokOyV643b19zIT4GIltkErx7GV2Tb1xpeTtOy2yD9AaevA-ZwtaisfbSPdjMcjsUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r2NQ1a-pptE2wsKkDlREUcAP7Im4yIG1OmcLd1ODvLA&oe=6A340B1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4yyAW955CYQ7kNvwEbK9ye&_nc_oc=AdqEsUwWo6pHo7AOa1cFSZsz34iikBMtE3tMXdxf3lFBpQedL23US-iccOE-2c7ybUM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g6XwsihvoUDQhyyAqu0u--uLkFVc-1vL3HVKjeH29yA&oe=6A341F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsZ8hVa9i5kQ7kNvwECzmLU&_nc_oc=AdqAOr9KmGKxLWjZL6Ud89-7c0Lxec1Z_og2sFdxPr9Ho7-ydwXz5aXcQ2kiK1WgBI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GkqtQSYR9qK4n2Ww2d6XKGiQaUoJ9LPW3m8ypQHlotw&oe=6A3403AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-1.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-feV6z_il2YQ7kNvwHrBGA3&_nc_oc=AdpJyRuRyKy-r7fiOjeAOkxa-asXgj4tcdKwIM_zzGnCR0jrE8FZPflQnQcVB9RXY6g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ssbEE4sIjfqNm6OPuINhkhutrP2tZJscDe04J5xLcMQ&oe=6A09BEAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBeERHAfdNIQ7kNvwGKxLGD&_nc_oc=AdpTH2emRFJ1yZ6N2aB7cQN6sj_mKdnlNPMKC6816sr5uRSdrUztqIy5gD1NkT6Ffik&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FCMTwEPPQ1NgDFef_BIuMqV1AQBb1u-qfrrKFovO33g&oe=6A09B64F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6OrSuIwMwkQ7kNvwH0vWWG&_nc_oc=AdpoxqLpZy9AJjvFWRqmcIDS4CivsqqAh8G4JVxv9SQ8ML4lrjypB1_9Thw-Nwd8ppc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DqYyAkqUlkk4OawS66j6DVe-VGJX1HNHzhWprTt0ENA&oe=6A09DB1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7RFV6G46hQQ7kNvwHwJ06V&_nc_oc=Adp7kIbN1LYwAVj5m3J9FmAB-bVMwnATUUWP6o4bTbbSfqLWRXawlg5CSO1vMjwxENE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AaMN5qdiYLYsJn0afxdZp2U1LABqSLW1wN4m-g8sn9Q&oe=6A09B6E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLBm-iksZy8Q7kNvwHrRIWv&_nc_oc=AdpyG8Wuskz3DpsWIBl1CL90gwTB9GrYo1vxH61S5k7A43q-VTNj5xXvDdxMaq9_ysE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zuFBHrgCsmXyMDAEPhnuFb-G83NbXXgQiVZHHDujrWg&oe=6A09D3AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
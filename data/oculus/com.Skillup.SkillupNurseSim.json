-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnVW2vv_3AkQ7kNvwFhglEp&_nc_oc=AdorUHgn3Q0Lqkvb7NXZ94GCnU4C_-YpWt9s0eDerR-gOiZPjgduXUWicesPZJ8GyV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gEmDX0LXEUxtjJbnSFi3cYHW8NnVWB8VUqYQ4p9t7Lw&oe=6A43C0AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAg9ErtfCfwQ7kNvwG6l-JK&_nc_oc=AdrkZ4Lr7dWjPGdu8U5au8O9VgwZMr9Qs-5stLXkQZRk_pU20njtV5Qi4P5C6G2O1iQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lc1sn9ph4enhjEjEzn-B9UU8cM06C--drXiIETER-7w&oe=6A43B84F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO07dpmRIw8Q7kNvwHaOvcb&_nc_oc=AdqXBxgZNmGj4eAufb2Dy3PMbSdgpqQqZB-DMzZe18OGZq1oWIxtG5VCHdM7DovTKD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dbrNpfIKSx9sRYfbKuW8Klk_fyTs65yz9_qNYtiTSBw&oe=6A43DD1F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mESaJsVEZqkQ7kNvwGqYkur&_nc_oc=Adrc8FJBy7jThcIAw_S4BNZbMgT5ojl75XeyZk5RBFkp7VZRl0IXtJRbaAP3A5eKxwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ksZnobFg4vWXRlEAklNGL8LX4rHGZn3v7Ty05oA7IBQ&oe=6A43B8E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h502JLIOflEQ7kNvwG-GAu6&_nc_oc=AdorsCBKqiBxnwFLjPrj1KEyTUygcz4c8j0rCrvTkeRtxr-I-yhVvQdQS3vOm2t_2J0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6xnI0FPY1is_iX_W-T68F5LmOykUu4QHqHcUSz2AUjg&oe=6A43D5AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7ko-Ko07oEQ7kNvwHW8sQu&_nc_oc=AdocIBwI2OYayOFdRCaTAu9mcWRG1TWc4lLHkEKNVRmK4hR4zX_kNCcwBkYCOo8HTok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40kjUlFTCBYsTj6C_T5_xinYOc2GBtuD9RanSi2cnD2Q&oe=6A071BAD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBeERHAfdNIQ7kNvwHB-_iI&_nc_oc=AdpS1I7zQNyn-Ydo4BWpFHB0PlDm4IYjEC1Lv5i53hhnrPTlT6Fx5kn40lSDWzc9VZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72mG8Xkz3SgjAty4EL6x-lFE1SBw79T9qMLohRvdOkpA&oe=6A07134F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4aATrlcbZIQ7kNvwH_YFiN&_nc_oc=AdoFsRwzZY_9t2QRRPosPVprsJLiwBceVg_PnzT8c05hCn6u7KdUHsZx6ysSyxY5o9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41mdfuq-TM4kFV4cuOteVSqea0m1MByQJhVhzooN7jXg&oe=6A07381F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H8xnjn82GIQ7kNvwG20ksh&_nc_oc=AdrmyUMdOhGma4AJGg8jbEhHdTOwbyvFAFB2aj6Du94V3L7s-4nLNyvd2QP7TDlwHaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WAvNnW_avFhAKikhiuPIISnnfISgI8YOhsoMCQ_8l2w&oe=6A0713E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du1ZZanDDM8Q7kNvwGpclWA&_nc_oc=AdoXn2Nw-AMJ8ZzXV3A73EiDctJ0nIyrYRTTYpYtqMdzlvOqR_FOGQfDnwPBTqYNAT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u29_Kykb7sZ3ZmxDRy8l_qRnaavQIaw8junKJx_qFdg&oe=6A0730AE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
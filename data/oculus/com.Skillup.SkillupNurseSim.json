-2.oculuscdn.com/v/t64.5771-25/38974820_1809457162864723_3216793532529676032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sffv8ADQAgQ7kNvwFJovZM&_nc_oc=AdoCX0jtiktjDTuWY-pKLI3GYOqC0lLHuyd93VmViugTHD--IRfpbszGyKAHebBcSec&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCGqL2yx2VlzuutW4o7cK0jmlk1huKRrlOv0pm1L1eFQ&oe=6AAD38AD"}, {"file_name": "Screenshot8.png", "id": "826640892611980", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031341_826640895945313_9074991141088349186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3u1brwrNZ8Q7kNvwFzkLLM&_nc_oc=AdpT-49alZQhvb0KUBFrXr_jxc5Br6B30M1vb1LBZvkrl8gG-pEd7cK6JUA5KNaGHLk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8SoUOfIqkFBLmhr24VMs49yUIi35MZBPLkWXKh0qjlQ&oe=6AAD304F"}, {"file_name": "Screenshot4.png", "id": "1081821106212576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_1081821112879242_8221193755338404534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Xno8sLZftQQ7kNvwGt9NMv&_nc_oc=AdqWYtbZ1BTqNnTG9THV0uxmsfz9ipiwlREBts6tHZt8ZzLfJWxSaFAWQDaDkukxg_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgHU-PBMU1slnHKLKVBZd_8dXfQ96eAQrhhBJP2n-j7A&oe=6AAD551F"}, {"file_name": "Screenshot5.png", "id": "3657639327849737", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031341_3657639334516403_5650115563546047514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl46i4-K0N4Q7kNvwGiygGQ&_nc_oc=AdpJsyB7TYw6f_3purjHi32cdH9qK7D224AMfSujgPSse0qbmQxk8Vk9KMQYLZz5ZjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgGpq882yEYhO5e3zfa3_LsVn3R-FWu14WGFrWa9tiOA&oe=6AAD30E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skillup_Landscape.png", "id": "348096568245352", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75451778_348096574912018_3005572446759952788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJTushobrfIQ7kNvwE1Ffwx&_nc_oc=AdrnealkOKmIf4hVoJORKQpUipgtLI3Pxk_v6dMCeVd2rVZjzyzkCYaADBiW709FMLI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZLl6tdf5jzjouqyXMqYz0-jKDIYRPkVB2lDrg0QHnlw&oe=6AAD4DAE"}, "display_name": "Skillup VR NurseSIM", "keywords": [], "long_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques.\n\n- 8 training scenarios of different patient profiles\n- Multiplayer setup\n- English and Norwegian language options\n- Intuitive, interactive and wireless\n- Compatible with Meta Quest 2 and 3\n- NEWS2 Scoring System \n- ISBAR Communication Framework\n- Facilitator control, communication and supervision capability *\n\n* Add-on application.", "short_description": "Skillup VR NurseSIM is designed for junior healthcare professionals to practice their basic nursing skills. Developed together with a Norwegian vocational institution, the simulation pack offers multiple scenarios set in both clinical and home environments, for users to familarize themselves with ABCDE-assessment, the NEWS2 scoring system and ISBAR communication techniques."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
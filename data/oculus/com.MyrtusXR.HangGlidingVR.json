b=1-7&_nc_sid=6e7a0a&_nc_ohc=oE7stCnOc1AQ7kNvwHa4jOF&_nc_oc=Adp-GqdSp-UAuD8WyX__EoF9PaT14Odt-dkrcj5Df-05TVSeN2_jA_teghcgn94PhoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaYn0EOxIfWId9lAx-Js4NdOmw73Pw7mmgetZeSg5THg&oe=6A998E49"}, {"file_name": "Screenshot_04.png", "id": "2334514420051268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031433_2334514423384601_5074813863790644858_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyWO9AiwAEwQ7kNvwEq4rXB&_nc_oc=Adrr0CUHyflzCh-AhiKtzaL3TCsjUaDuleNBTMasI7o-OpO8cUZ4oWLDc8Tt8n3Kbnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEKzU6dRLkFqSmJIUeIrKduAQXv-K35mIBU3VAEeH2MQ&oe=6A998CC5"}, {"file_name": "Screenshot_05.png", "id": "895084078427742", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974795_895084081761075_4459851669508957199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Wk7bQHmDPUQ7kNvwFNSUck&_nc_oc=AdqZ4N1sVDK_innJAsiUpeYCPZIvja0XTFTL7mQ7q_a209KxUb6S14-89T4nCjRmBkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-7KVFWD5EQntqwwT0VZSaNgrkHkNV7eHu_b32w2zmPA&oe=6A99751D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "204373708968016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982492_204373712301349_7617282035849167876_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUVZk6B8it8Q7kNvwEEzwVE&_nc_oc=AdoRnLB5RKhWKL9euFNIJfcbXqVUHBBXO0SxmSuGQotUR-fxCO_goh0aUgtu1uO2ccE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw2LdMsrpdkVn43lWLcLSv1kDR8tlSOCF3V37n-kb2sQ&oe=6A9983AF"}, "display_name": "Hang Gliding - VR Experience", "keywords": ["flight", "glider", "nature", "simulator", "relaxing"], "long_description": "- Explore a snowy mountain valley on a hang glider. \n- A relaxing flight through this stunning landscape with frozen lakes and forests. \n- Use boost rings and thermals for a longer flight.\n- Try to find a mysterious crash site.\n\nThree control modes:\n- Hanging: Just like in a real hang glider, use your body to control the flight.\n- Lying: Use the movement of your hands to control the flight.\n- Sitting: Use the combined movements of your body and hands to control the flight.\n\nSafety (Hanging control mode):\n- Do not use open hooks, lateral movements can cause the rig to come loose from the hook, use carabiners instead.\n- Do not use chairs with wheels, a wheel could lock sideways and overturn the chair.\n- Do not use improvised or poorly fixed bars.\n- Wrap the bar with foam and use a mattress below your body.\n- Never use handrails in high places as a bar.\n- It is recommended that you always have someone close to help in any situation.\n\nThis project was developed from the classic Unreal Landscape Mountains Showcase. \nAll credits to the talented team at Epic Games related to the original project. (The original project is available for free at the Unreal Marketplace.)", "short_description": "Explore this mountain valley on a hang glider, a relaxing flight through this stunning landscape.\n\nImportant: As in a real hang glider, this experience uses your body movement to control the flight. \nCheck the description for tips on how to have a good and safe experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://myrtusxr.tilda.ws/hgvrprivpol", "developer_terms_of_service_url": null, "publisher_name": "Myrtus XR", "support_website_url": null, "website_url": "http://MyrtusXR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
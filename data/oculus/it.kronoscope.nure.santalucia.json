3"}, {"file_name": "2.png", "id": "4491592561081731", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595136811_4491592564415064_6366226555950179003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypIxfDW-6rYQ7kNvwH0tNnD&_nc_oc=Ado3fTXMdHs3XiOVt5WH3orsYZINx9yMbnoTToeWl6l_nZCd_nlAxcep3D40K9mse8U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTm3hL8fGNyc4tKAWX9Klvm2bk3oNBXpWjwmo9BTxTmQ&oe=6A4A516C"}, {"file_name": "1.png", "id": "27526494036936538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_27526494066936535_3446241617816328179_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LPwYGEOricQ7kNvwGPiBA7&_nc_oc=AdpAJ-OkhqfmBYjuZO4f_kAkBg-39Fs6Gx0KXLQlyZEtwsRsLUtxHRt0nfoLZSmzHuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjyy_EI1_UkZD6Nbi06MPEekEgsxOr1Xm8jOyCpkOnVw&oe=6A4A78A9"}, {"file_name": "4.png", "id": "1299722601684463", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1299722605017796_6651062678196658512_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_oDcP6clCAQ7kNvwEr_2BJ&_nc_oc=AdrV0K78mNFuCJ2199mjxV-WxbpZNPov0PChHsrNVGauOY2jRhSU5vUNbtgbMMgwxrA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFDuRwSqt2Tfx91awNZCzwkSjCaUFreVhJzN1zBmNh3w&oe=6A4A822E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NURE Santa Lucia Nuraghe", "keywords": [], "long_description": "Begin a virtual journey into a Nuragic archaeological site, where ancient stones, forgotten spaces, and hidden stories come together in an immersive VR experience.\n\nDesigned as an atmospheric exploration, this experience invites visitors to enter the world of the nuraghe: mysterious stone structures built thousands of years ago, still surrounded by questions about their purpose, their builders, and the rituals that may have taken place around them.\n\nThrough virtual reality, users can move through the site, observe its spaces, and discover fragments of history, archaeology, and imagination. The experience blends cultural storytelling with a sense of mystery, offering a new way to approach one of the most fascinating ancient civilizations of the Mediterranean.\n\nMore than a simple visit, this is an immersive journey through memory, landscape, and ancient architecture \u2014 a chance to explore the silent presence of the nuraghe and feel the connection between past and present.", "short_description": "Discover the Santa Lucia archaeological site through an immersive experience where history, archaeology, and storytelling come to life."}, {"images": {"nodes": []}, "id": "1546165216919102", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NURE Santa Lucia e Nuraghe", "keywords": ["storia", "nuraghe", "sardegna", "archeologia", "nure"], "long_description": "Inizia un viaggio virtuale in un sito archeologico nuragico, dove antiche pietre, spazi dimenticati e storie nascoste si fondono in un'esperienza immersiva in realt\u00e0 virtuale.\n\nConcepita come un'esplorazione suggestiva, questa esperienza invita i visitatori a entrare nel mondo dei nuraghe: misteriose strutture in pietra costruite migliaia di anni fa, ancora avvolte da interrogativi sul loro scopo, sui loro costruttori e sui rituali che potrebbero essersi svolti intorno ad esse.\n\nAttraverso la realt\u00e0 virtuale, gli utenti possono muoversi all'interno del sito, osservarne gli spazi e scoprire frammenti di storia, archeologia e immaginazione. L'esperienza fonde la narrazione culturale con un senso di mistero, offrendo un nuovo modo di avvicinarsi a una delle civilt\u00e0 antiche pi\u00f9 affascinanti del Mediterraneo.\n\nPi\u00f9 di una semplice visita, questo \u00e8 un viaggio immersivo attraverso la memoria, il paesaggio e l'architettura antica: un'opportunit\u00e0 per esplorare la presenza silenziosa dei nuraghe e percepire la connessione tra passato e presente.", "short_description": "Scopri il sito archeologico di Santa Lucia attraverso un'esperienza immersiva in cui storia, archeologia e narrazione prendono vita."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kronoscope.it/kronoscope-privacy-app-vr-nure/", "developer_terms_of_service_url": null, "publisher_name": "KronoScope", "support_website_url": null, "website_url": "https://www.kronoscope.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27196767906620591"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2381370535605127"}]}, "baseline_offer": {"id": "2381370535605127"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780945380, "status": "PUBLISHED", "id": "2381370535605127"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27322008480763199", "version": "9.2.22"}, "id": "1290270016650331", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27128136260150423", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27322008480763199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LI
ypIxfDW-6rYQ7kNvwH0tNnD&_nc_oc=Ado3fTXMdHs3XiOVt5WH3orsYZINx9yMbnoTToeWl6l_nZCd_nlAxcep3D40K9mse8U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTm3hL8fGNyc4tKAWX9Klvm2bk3oNBXpWjwmo9BTxTmQ&oe=6A4A516C"}, {"file_name": "1.png", "id": "27526494036936538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_27526494066936535_3446241617816328179_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LPwYGEOricQ7kNvwGPiBA7&_nc_oc=AdpAJ-OkhqfmBYjuZO4f_kAkBg-39Fs6Gx0KXLQlyZEtwsRsLUtxHRt0nfoLZSmzHuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjyy_EI1_UkZD6Nbi06MPEekEgsxOr1Xm8jOyCpkOnVw&oe=6A4A78A9"}, {"file_name": "4.png", "id": "1299722601684463", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1299722605017796_6651062678196658512_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_oDcP6clCAQ7kNvwEr_2BJ&_nc_oc=AdrV0K78mNFuCJ2199mjxV-WxbpZNPov0PChHsrNVGauOY2jRhSU5vUNbtgbMMgwxrA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFDuRwSqt2Tfx91awNZCzwkSjCaUFreVhJzN1zBmNh3w&oe=6A4A822E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NURE Santa Lucia Nuraghe", "keywords": [], "long_description": "Begin a virtual journey into a Nuragic archaeological site, where ancient stones, forgotten spaces, and hidden stories come together in an immersive VR experience.\n\nDesigned as an atmospheric exploration, this experience invites visitors to enter the world of the nuraghe: mysterious stone structures built thousands of years ago, still surrounded by questions about their purpose, their builders, and the rituals that may have taken place around them.\n\nThrough virtual reality, users can move through the site, observe its spaces, and discover fragments of history, archaeology, and imagination. The experience blends cultural storytelling with a sense of mystery, offering a new way to approach one of the most fascinating ancient civilizations of the Mediterranean.\n\nMore than a simple visit, this is an immersive journey through memory, landscape, and ancient architecture \u2014 a chance to explore the silent presence of the nuraghe and feel the connection between past and present.", "short_description": "Discover the Santa Lucia archaeological site through an immersive experience where history, archaeology, and storytelling come to life."}, {"images": {"nodes": []}, "id": "1546165216919102", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NURE Santa Lucia e Nuraghe", "keywords": ["storia", "nuraghe", "sardegna", "archeologia", "nure"], "long_description": "Inizia un viaggio virtuale in un sito archeologico nuragico, dove antiche pietre, spazi dimenticati e storie nascoste si fondono in un'esperienza immersiva in realt\u00e0 virtuale.\n\nConcepita come un'esplorazione suggestiva, questa esperienza invita i visitatori a entrare nel mondo dei nuraghe: misteriose strutture in pietra costruite migliaia di anni fa, ancora avvolte da interrogativi sul loro scopo, sui loro costruttori e sui rituali che potrebbero essersi svolti intorno ad esse.\n\nAttraverso la realt\u00e0 virtuale, gli utenti possono muoversi all'interno del sito, osservarne gli spazi e scoprire frammenti di storia, archeologia e immaginazione. L'esperienza fonde la narrazione culturale con un senso di mistero, offrendo un nuovo modo di avvicinarsi a una delle civilt\u00e0 antiche pi\u00f9 affascinanti del Mediterraneo.\n\nPi\u00f9 di una semplice visita, questo \u00e8 un viaggio immersivo attraverso la memoria, il paesaggio e l'architettura antica: un'opportunit\u00e0 per esplorare la presenza silenziosa dei nuraghe e percepire la connessione tra passato e presente.", "short_description": "Scopri il sito archeologico di Santa Lucia attraverso un'esperienza immersiva in cui storia, archeologia e narrazione prendono vita."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kronoscope.it/kronoscope-privacy-app-vr-nure/", "developer_terms_of_service_url": null, "publisher_name": "KronoScope", "support_website_url": null, "website_url": "https://www.kronoscope.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27196767906620591"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830467_1498135881784600_9205503891446748202_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDzhxrlP4z0Q7kNvwGXViKO&_nc_oc=AdrS5J3vcpLA4ljVlwOLXsIH5b-G5Vk9eboDHapMhsoO1npiUmjff0yksXf0UfOX4tQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSQa_E19E_AAdVbw_hhmUgkji5pxqv8EgYlWYfuNJBoQ&oe=6A4A7CA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NURE Santa Lucia Nuraghe", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1780945380, "lastRevision": {"nodes": [{"id": "27128136360150413", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27128136260150423", "is_first_party": false, "enables_in_app_ads": false, "is_concept": 
9bRB4I8EW3ysfxyU9lRtxAkQv1fhubjx9NW8p06ZqwIqo26t09eaFg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2HWHTzRPMXXmdKmT_vbDjMJZn3HHdTBRPbDziE1lgtA&oe=6AD0FB60"}, {"file_name": "004.png", "id": "2139296036657858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824741_2139296043324524_2298619361691002226_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvzwjn_RumsQ7kNvwEXyvkz&_nc_oc=AdpwbKKFOmjIQLrIJSH7gFfVq5Z9wuXhQVB9QYSMEeWKW4B6qtyiBn8ZejrylmL8JnI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm4G-MW09aVBx7WbscyfSkbqXapkMh4Kke8CAMDDYkFg&oe=6AD0DD8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "4683928388497171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825575_4683928391830504_8135857367281461231_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUG3rLugjVYQ7kNvwGO75UZ&_nc_oc=AdrVCxig7S1jqiUwYfwKA0N8L8-aA1kzs826A7fSrhkf-16H76Ne216zetkHmWADewY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvn2A2FQazmjy3JkhJS2M7CMoxMfus3LXSahcXm53-KA&oe=6AD0E4AB"}, "display_name": "Flight Trainer: Plane Jet Heli & Drone", "keywords": ["simulator", "airplane", "training", "drone", "helicopter"], "long_description": "A highly detailed Airplane, Fighter Jet, Helicopter and Drone Flight Simulator for beginner and intermediate flying learning students and VR enthusiast virtual pilots. Detailed cockpit panel gauges and buttons with complete functionality and flying operations. Ideal for learning Flying from very basics with step-by-step guide that lets you taxi, take-off and land on a beautiful Island Airport.\n\nThe application uses freely moving VR controller Hand-gestures. You can turn on/off or operate various toggle switches and control. The tutorial mode explains each and every gauge function and use with audio and virtual markings.\n\nYou can select to fly in all the famous cities of the worlds of all countries and enjoy flying around 3D real world maps including satellite image height maps of terrains and actual 3d buildings etc.\n\nThe class-room mode explains different theoretical aspects of flying basics help you learn how planes fly. The hanger mode let you walk around the plane while each and every part is explained in animation.\n\nSit, in cockpit and learn to fly by step-by-step instructions and test your skills with different flying challenges.", "short_description": "Learn flying Planes, Fighter Jet, Helicopter & Drones in this Flight Simulator for VR enthusiasts & aviation students. Cockpit gauges and buttons with complete functionality. Taxi, take-off & land on an Airport. Freely moving VR controller Hands, operate various switches and control. Tutorial all gauges function with audio & markings. Enjoy flying 3D real world maps actual terrains and 3d buildings. Class-room mode explains theoretical flying basics, hanger mode explains plane exterior parts."}]}, "developer_name": "ABSTRON Private Limited", "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "SKIPPY APPS PTY LTD", "support_website_url": null, "website_url": "https://www.skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39041238748823261"}, "review_messages": []}]}, "cover_square_image
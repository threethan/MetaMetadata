_oc=AdqOU2xufNeieobqmFFDLqikXPW7OWxlfM9qe471k5tJpNgxX_1PqujkBxsljrI_2dg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYCuN92ahBP415OwyqF-r5a3SqAEiPX3cIpjme7smuZw&oe=6AC3AE78"}, {"file_name": "2.png", "id": "2364635701007732", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_2364635707674398_3344337771248304800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzrwgXGNFysQ7kNvwFFs49y&_nc_oc=AdqtRTcQ2gP8hFfizYF2l-wkm2HG-WKyRhJqMCzThejrys9gunB5QH91RGqxJn4mVzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtivPpfy_fHwcBOZRdM54otlfqAw18AZRJFpCENsflwA&oe=6AC3B865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "4683928388497171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_4683928391830504_8135857367281461231_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icqgq8Fr3OwQ7kNvwHTRWSS&_nc_oc=Adq-prbbKkSeg3dSNgym-iz9s84WutgFWS2JkBIAVoRE0pS9-5N_z5f-WBBr3x-ETxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7ZEYQsAXShV9Amk_2Xvi1eIL2-U2FypfDQ_iJMpwy8g&oe=6AC3B5AB"}, "display_name": "Flight Trainer: Plane Jet Heli & Drone", "keywords": ["simulator", "airplane", "training", "drone", "helicopter"], "long_description": "A highly detailed Airplane, Fighter Jet, Helicopter and Drone Flight Simulator for beginner and intermediate flying learning students and VR enthusiast virtual pilots. Detailed cockpit panel gauges and buttons with complete functionality and flying operations. Ideal for learning Flying from very basics with step-by-step guide that lets you taxi, take-off and land on a beautiful Island Airport.\n\nThe application uses freely moving VR controller Hand-gestures. You can turn on/off or operate various toggle switches and control. The tutorial mode explains each and every gauge function and use with audio and virtual markings.\n\nYou can select to fly in all the famous cities of the worlds of all countries and enjoy flying around 3D real world maps including satellite image height maps of terrains and actual 3d buildings etc.\n\nThe class-room mode explains different theoretical aspects of flying basics help you learn how planes fly. The hanger mode let you walk around the plane while each and every part is explained in animation.\n\nSit, in cockpit and learn to fly by step-by-step instructions and test your skills with different flying challenges.", "short_description": "Learn flying Planes, Fighter Jet, Helicopter & Drones in this Flight Simulator for VR enthusiasts & aviation students. Cockpit gauges and buttons with complete functionality. Taxi, take-off & land on an Airport. Freely moving VR controller Hands, operate various switches and control. Tutorial all gauges function with audio & markings. Enjoy flying 3D real world maps actual terrains and 3d buildings. Class-room mode explains theoretical flying basics, hanger mode explains plane exterior parts."}]}, "developer_name": "ABSTRON Private Limited", "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "SKIPPY APPS PTY LTD", "support_website_url": null, "website_url": "https://www.skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39016678904612579"}, "review_messages": []}]}, "cov
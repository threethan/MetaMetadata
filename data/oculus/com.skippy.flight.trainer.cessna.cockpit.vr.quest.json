_oc=Adrmua7Uvgt5LMbQmMhH8-bJEHpERe2LxX4WN6ESSzkvH2Jdey6m4EtYeiSlBUaHQj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbGDAssdJXTq05DOwd5QPxoDXTYTr9lRSEhjFJkLfOFw&oe=6AC10B78"}, {"file_name": "Screen-3.png", "id": "2134157990322366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_2134157993655699_8692881945732179326_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0iqSFJs-KMQ7kNvwFK9qSh&_nc_oc=AdrqKEDhCfUsyQDWHGvkjX-4XloDA3BMkcFXBdq-Jpv1dzzj27mIv_wQ8EI89mrhwIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb3jmLj3bFe4hHfZT2kr9Xf4CAKo11Z_fwm606zkGd1A&oe=6AC12A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-ladscape.png", "id": "1339148247160005", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499328769_1339148250493338_7745055856459717390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZsBFAQZltcQ7kNvwEGs-BK&_nc_oc=Ado3xoWQNWb5NoS7kcZi3Pcaw2AdCRGWP2-Ujwb8HGfJfyY1D9Im8C5fWrp1BOb8lqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYS0zqz8ZeTqvBkbDfaAFrwPk9dx4gsRuVkUE04ViNDg&oe=6AC11A91"}, "display_name": "Flight Trainer: Plane Jet Heli & Drone", "keywords": ["simulator", "airplane", "training", "drone", "helicopter"], "long_description": "A highly detailed Airplane, Fighter Jet, Helicopter and Drone Flight Simulator for beginner and intermediate flying learning students and VR enthusiast virtual pilots. Detailed cockpit panel gauges and buttons with complete functionality and flying operations. Ideal for learning Flying from very basics with step-by-step guide that lets you taxi, take-off and land on a beautiful Island Airport.\n\nThe application uses freely moving VR controller Hand-gestures. You can turn on/off or operate various toggle switches and control. The tutorial mode explains each and every gauge function and use with audio and virtual markings.\n\nYou can select to fly in all the famous cities of the worlds of all countries and enjoy flying around 3D real world maps including satellite image height maps of terrains and actual 3d buildings etc.\n\nThe class-room mode explains different theoretical aspects of flying basics help you learn how planes fly. The hanger mode let you walk around the plane while each and every part is explained in animation.\n\nSit, in cockpit and learn to fly by step-by-step instructions and test your skills with different flying challenges.", "short_description": "Learn flying Planes, Fighter Jet, Helicopter & Drones in this Flight Simulator for VR enthusiasts & aviation students. Cockpit gauges and buttons with complete functionality. Taxi, take-off & land on an Airport. Freely moving VR controller Hands, operate various switches and control. Tutorial all gauges function with audio & markings. Enjoy flying 3D real world maps actual terrains and 3d buildings. Class-room mode explains theoretical flying basics, hanger mode explains plane exterior parts."}]}, "developer_name": "ABSTRON Private Limited", "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "SKIPPY APPS PTY LTD", "support_website_url": null, "website_url": "https://www.skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38954479780832492"}, "review_messages":
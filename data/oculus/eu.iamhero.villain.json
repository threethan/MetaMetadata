u9J4hLiUDweeoFZ62QVM1UtedUsJP-1d-w&oe=6A8C4704"}, {"file_name": "61eae08f9fa441f4a8e425ee9a7b2060.png", "id": "1729880084285012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820382_1729880087618345_8521474408316401144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSNv8utxPFwQ7kNvwHlMY3F&_nc_oc=Ador0lc3ljAZ_gv5lmoi2ni0Df6tdsZgR5w6qp8Vqg-d14yeYPR6E1Wyluhp82wLXc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEgkXfLeOJkSrxuBeAs7BE4zwa8ELINteqRgSETMROLw&oe=6A8C3113"}, {"file_name": "f25c607e76684b39b49a2f35ae43f11c.png", "id": "1496984931270561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303746_1496984934603894_3824457001015156055_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fZBEv_nYQMQ7kNvwH_m5Ba&_nc_oc=AdrZQ3-3v0h7-s9yd63U_spbyfZ7qhKFOvBROWeJznbKoOqOW_TZvIFQWLz_Sq5Y--g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6TH_oMlLhO4R0MCDe07UpspdnRQk7flYuouqATv3tSQ&oe=6A8C379B"}, {"file_name": "360e00014a544b9888d9a3b48479464c.png", "id": "23951282537844166", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_23951282554510831_5273933930721333540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyIlayFtydAQ7kNvwFAb2c6&_nc_oc=Adpd_CGEFwMz7MQGH5vCO6cvrJB-IapF7F9Yz9X44adLzMwadowO9ztZI_80mAAOE1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfSeZXigbd-oAC8p8_HDLXZmuU3G6FlbbMoSgxICx0LQ&oe=6A8C36AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (2).png", "id": "1107786041171763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820980_1107786044505096_8861438075825302195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prGW-Ld_mJkQ7kNvwHxChd3&_nc_oc=AdqsvZay81QDeYdfXSYWcYYNbrm4adUmWS9cjgRh5wNiWvhkbphWOiai2RyOSRKL2sI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH2JFYZsAg82zZGh7N7Ea7e92b_C09Rk0j3vsW-iGRxw&oe=6A8C11B3"}, "display_name": "IAmHero", "keywords": [], "long_description": "IamHero \u00e8 una piattaforma terapeutica in realt\u00e0 virtuale progettata per supportare bambini e adolescenti con disturbi del neurosviluppo, come ADHD, autismo e DSA. Il sistema combina ambienti immersivi, gamification e strumenti di monitoraggio per stimolare lo sviluppo delle funzioni cognitive ed emotive in modo efficace e coinvolgente. Attraverso scenari interattivi calibrati sulle esigenze del paziente, IamHero trasforma l\u2019esperienza terapeutica in un gioco motivante, migliorando la compliance e il coinvolgimento.\n\nIl prodotto \u00e8 riconosciuto come dispositivo medico di Classe I secondo il Regolamento Europeo 2017/745 e pu\u00f2 essere utilizzato da centri di riabilitazione, terapisti, neuropsichiatri e professionisti del settore sanitario. Il cuore del sistema \u00e8 BRAVO, un ambiente VR creato per allenare funzioni esecutive come attenzione, memoria di lavoro, pianificazione e autocontrollo, sfruttando anche dati biometrici e comportamentali per adattare in tempo reale gli esercizi.\n\nIamHero integra inoltre algoritmi di intelligenza artificiale per ottimizzare i piani terapeutici e fornire analisi dettagliate dei progressi. Il progetto nasce da un approccio scientifico e multidisciplinare e rappresenta un ponte tra tecnologia e salute mentale, con l\u2019obiettivo di innovare il trattamento dei disturbi dello sviluppo e migliorare concretamente la qualit\u00e0 della vita dei pazienti e delle loro famiglie.", "short_description": "IamHero sviluppa un innovativo sistema terapeutico in realt\u00e0 virtuale pensato per bambini e ragazzi con disturbi del neurosviluppo come ADHD, autismo e DSA. Attraverso ambienti gamificati immersivi, il software stimola le funzioni cognitive e comportamentali in modo coinvolgente e misurabile. Registrato come dispositivo medico CE, \u00e8 pensato per centri specializzati, con percorsi personalizzati supportati da intelligenza artificiale."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iamhero.eu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nessuno", "support_website_url": null, "website_url": "https://www.iamhero.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9232991910129389"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1717926288861378"}]}, "baseline_offer": {"id": "1717926288861378"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750922820, "status": "PUBLISHED", "id": "1717926288861378"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9839590066136234", "version": "1"}, "id": "1299015898029562", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9232991886796058", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9839590066136234"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1299015898029562"}]}, "change_log": null, "created_date": 1748593204, "id": "9839590066136234", "version": "1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count"
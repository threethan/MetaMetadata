WmWeBbCGYKamFN23IjbLmdIB24WPdCYaWnJyDAR1at94y4wDwSnnXDj_Y30Cdlg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI3lxSvmG1kIe8rX5uJPvvQskWJEfro-aijOuWygALQA&oe=6ABA5B2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (2).png", "id": "1107786041171763", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820980_1107786044505096_8861438075825302195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juIqdsdmVDIQ7kNvwGsHQws&_nc_oc=AdorPUHTZeq3gr__ulDf8UJ6yRpo3aflapT-7axHGwg9-cOp8BE2dKwdCdUsLkkhN9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrdkQol5astb_UtFf6GG67513ta6dTg6FwhPvVLBAdmw&oe=6ABA6E73"}, "display_name": "IAmHero", "keywords": [], "long_description": "IamHero \u00e8 una piattaforma terapeutica in realt\u00e0 virtuale progettata per supportare bambini e adolescenti con disturbi del neurosviluppo, come ADHD, autismo e DSA. Il sistema combina ambienti immersivi, gamification e strumenti di monitoraggio per stimolare lo sviluppo delle funzioni cognitive ed emotive in modo efficace e coinvolgente. Attraverso scenari interattivi calibrati sulle esigenze del paziente, IamHero trasforma l\u2019esperienza terapeutica in un gioco motivante, migliorando la compliance e il coinvolgimento.\n\nIl prodotto \u00e8 riconosciuto come dispositivo medico di Classe I secondo il Regolamento Europeo 2017/745 e pu\u00f2 essere utilizzato da centri di riabilitazione, terapisti, neuropsichiatri e professionisti del settore sanitario. Il cuore del sistema \u00e8 BRAVO, un ambiente VR creato per allenare funzioni esecutive come attenzione, memoria di lavoro, pianificazione e autocontrollo, sfruttando anche dati biometrici e comportamentali per adattare in tempo reale gli esercizi.\n\nIamHero integra inoltre algoritmi di intelligenza artificiale per ottimizzare i piani terapeutici e fornire analisi dettagliate dei progressi. Il progetto nasce da un approccio scientifico e multidisciplinare e rappresenta un ponte tra tecnologia e salute mentale, con l\u2019obiettivo di innovare il trattamento dei disturbi dello sviluppo e migliorare concretamente la qualit\u00e0 della vita dei pazienti e delle loro famiglie.", "short_description": "IamHero sviluppa un innovativo sistema terapeutico in realt\u00e0 virtuale pensato per bambini e ragazzi con disturbi del neurosviluppo come ADHD, autismo e DSA. Attraverso ambienti gamificati immersivi, il software stimola le funzioni cognitive e comportamentali in modo coinvolgente e misurabile. Registrato come dispositivo medico CE, \u00e8 pensato per centri specializzati, con percorsi personalizzati supportati da intelligenza artificiale."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iamhero.eu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nessuno", "support_website_url": null, "website_url": "https://www.iamhero.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9232991910129389"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1717926288861378"}]}, "baseline_offer": {"id": "1717926288861378"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750922820, "status": "PUBLISHED", "id": "1717926288861378"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9839590066136234
.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUGybmQa89AQ7kNvwF-9LHk&_nc_oc=AdpaIqaBYQTr7R5eltDzBKDA3SX3iNJ-1V30OTYFN5yYA-Nrznjw5x0OFCO7l_kARwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoFE1HIraNVdbZCdiw2CgqHX__9j2-th7U2Yd6QRaK8g&oe=6ABA686B"}, {"file_name": "7cc655bb17064159865fa0cd0f0627e4.png", "id": "1906514173520605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1906514176853938_5180766970801533468_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFttnz54epwQ7kNvwFUKLkm&_nc_oc=AdrVEwVeWsxTn56qOMHVlIyWOtwXSaOUMUy7lQ-dpIlNHYyZUfqLRxZYZ6K0Jdu4rf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1YF6GujGdhfB3GtsXj_oVfOtqfrgyMo0ZFdMxyBHbDQ&oe=6ABA5D07"}, {"file_name": "6b40d2e2d09945f78ef7799c79a17ed3.png", "id": "1036786635266979", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818938_1036786638600312_6712049231397222352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6zj1JBjS7gQ7kNvwGfQkdR&_nc_oc=AdqzYxDk257y_ZPZcLAIcoN6vor8STkAkgaAQSyyjVcpQkBCywzZmHPXsaG6NyIdWQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbfXwBaMeYhl6SczcomZGLzvEHkeTeIWCzP3aSQPEnUg&oe=6ABA8952"}, {"file_name": "360e00014a544b9888d9a3b48479464c.png", "id": "2014721359342338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304764_2014721366009004_6117075962231128505_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-QFiprZjwsQ7kNvwFVG6RW&_nc_oc=AdqlTnKlYb5b8Lto-T9UuvTDvMUXMT_eiqCpQ668PYOiFSuz0j1RbSrjVcR0TBl028c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvj43eRga3LHg0-bBl-g4607tiXHY4OISqhBTEdYtiIA&oe=6ABA63EB"}, {"file_name": "6a85909c8e514c68a99f7518cad7f24f.png", "id": "1203088374893228", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821955_1203088378226561_3439836831623854716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsYmXGnT3hYQ7kNvwE6HxvD&_nc_oc=AdoEhyfJ5xwq5OyYm3-btSJndih3RnqNj4fOmcdVQEB1Wrk0dHCwVrqvII2OK4f3ldA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI5teWFkpgbT6JQ4hyIDVYuxxjrkDGBpxOooAOCxNx5g&oe=6ABA6A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (2).png", "id": "1089432373248795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303386_1089432379915461_6547276381702989327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-16eR5VC5UQ7kNvwHKBj00&_nc_oc=Ado75_2Fr9HxwOu_bcjt6pIqQ7z8eelPnf1M7AFgUGz-uTIVqvFXuv0Zfeq9gANwfx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLISZ22YmxmebCkwCgE4DTCsUAmAIquN4EdeQUOBx4tlA&oe=6ABA6E1F"}, "display_name": "I Am Hero", "keywords": [], "long_description": "IamHero is a virtual reality therapeutic platform designed to support children and adolescents with neurodevelopmental disorders, such as ADHD, autism and DSA. The system combines immersive environments, gamification and monitoring tools to stimulate the development of cognitive and emotional functions in an effective and engaging way. Through interactive scenarios calibrated to the patient's needs, IamHero transforms the therapeutic experience into a motivating game, improving compliance and involvement.\n\nThe product is recognized as a Class I medical device according to European Regulation 2017/745 and can be used by rehabilitation centers, therapists, neuropsychiatrists and healthcare professionals. The heart of the system is BRAVO, a VR environment created to train executive functions such as attention, working memory, planning and self-control, also using biometric and behavioral data to adapt exercises in real time.\n\nIamHero also integrates artificial intelligence algorithms to optimize therapeutic plans and provide detailed progress analysis. The project stems from a scientific and multidisciplinary approach and represents a bridge between technology and mental health, with the aim of innovating the treatment of developmental disorders and concretely improving the quality of life of patients and their families.", "short_description": "IamHero develops an innovative virtual reality therapeutic system designed for children and teenagers with neurodevelopmental disorders such as ADHD, autism and DSA. Through immersive gamified environments, the software stimulates cognitive and behavioral functions in an engaging and measurable way. Registered as a CE medical device, it is designed for specialized centers, with personalized paths supported by artificial intelligence."}, {"images": {"nodes": [{"file_name": "1008.png", "id": "4207921189437981", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303675_4207921192771314_6931756898710806319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFJgrjnhhzMQ7kNvwFb0Mn6&_nc_oc=AdrTcgHKkrSXpbEGUdXyEv7uooHY7qPcQJVkvKTSt-UCBGapmXNzHDXuJ8XkVJ0hcz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1gyLjxEt6t5f2qZ3YuDPAIBH0icwhJXMRJ7OVDlo-hg&oe=6ABA6203"}, {"file_name": "1080.png", "id": "1470136521009715", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299842_1470136524343048_5495665460888668453_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziWdkwtpKXQQ7kNvwEO7ao-&_nc_oc=AdpeaseS8ed55UuH3ooc1BWjVbk3FWQTKuY3I2jWG60MtyhzSROj6Tdog946nnNRxgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsg916D8BR9fvi3_XD5pc_c_F-RlNeUJSKR2gFIWwS3w&oe=6ABA70CC"}, {"file_name": "meta (1).png", "id": "1418443955969309", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300574_1418443959302642_5034630465786252081_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgnwO2ZcFXUQ7kNvwFS79rf&_nc_oc=AdrO6RX9f3fdgrfifJJAn1zl_V3nKoW_1IjTq-FOjQQ4Y5SR3hmmkT9vmKfB0BJdGto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICx8Kr0c8vm7IhXLE-WWJ-X6eytGMF1CvXNTHtcZuUFA&oe=6ABA6F0C"}, {"file_name": "iamhero-logo.png", "id": "1301430141986872", "ima
//scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303386_1089432379915461_6547276381702989327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm2QSmEjMX8Q7kNvwE9aAOS&_nc_oc=Adql-hpA-igwPvqH0yHse8e5kCR4U2WPwPUmfj30hXy-xfQ7MMghckz3XizOrblLcpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNVy-EcCk2PtFpRJo9vRcYpDzXIQD2dFQZwWLaDwj5WQ&oe=6A8C115F"}, "display_name": "I Am Hero", "keywords": [], "long_description": "IamHero is an interactive virtual reality platform designed for children and young people. Through immersive environments and gamified activities, it offers experiences focused on skills such as attention, working memory, planning, impulse management, and coordination.\n\nIamHero collects data exclusively related to interactions within the app, such as response times, activity results, and progression through the different scenarios. This information is used to display the user\u2019s progress and adjust the level of difficulty.\n\nThe platform uses data analysis systems and artificial intelligence algorithms to organise results and suggest activities suited to the user\u2019s current level.\n\nIamHero is an interactive digital experience and does not provide diagnoses, medical advice, or healthcare treatments. Any results displayed refer exclusively to performance within the activities offered by the app.", "short_description": "IamHero is an interactive virtual reality experience featuring gamified activities focused on attention, memory, planning, and self-control, with difficulty progressively adapting to the user\u2019s performance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iamhero.eu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nessuno", "support_website_url": null, "website_url": "https://www.iamhero.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [
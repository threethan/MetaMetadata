24457001015156055_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fZBEv_nYQMQ7kNvwH_m5Ba&_nc_oc=AdrZQ3-3v0h7-s9yd63U_spbyfZ7qhKFOvBROWeJznbKoOqOW_TZvIFQWLz_Sq5Y--g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6TH_oMlLhO4R0MCDe07UpspdnRQk7flYuouqATv3tSQ&oe=6A8C379B"}, {"file_name": "360e00014a544b9888d9a3b48479464c.png", "id": "23951282537844166", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_23951282554510831_5273933930721333540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyIlayFtydAQ7kNvwFAb2c6&_nc_oc=Adpd_CGEFwMz7MQGH5vCO6cvrJB-IapF7F9Yz9X44adLzMwadowO9ztZI_80mAAOE1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfSeZXigbd-oAC8p8_HDLXZmuU3G6FlbbMoSgxICx0LQ&oe=6A8C36AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (2).png", "id": "1107786041171763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820980_1107786044505096_8861438075825302195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prGW-Ld_mJkQ7kNvwHxChd3&_nc_oc=AdqsvZay81QDeYdfXSYWcYYNbrm4adUmWS9cjgRh5wNiWvhkbphWOiai2RyOSRKL2sI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH2JFYZsAg82zZGh7N7Ea7e92b_C09Rk0j3vsW-iGRxw&oe=6A8C11B3"}, "display_name": "IAmHero", "keywords": [], "long_description": "IamHero \u00e8 una piattaforma interattiva in realt\u00e0 virtuale pensata per bambini e ragazzi. Attraverso ambienti immersivi e attivit\u00e0 gamificate, offre esperienze dedicate ad abilit\u00e0 come attenzione, memoria di lavoro, pianificazione, gestione degli impulsi e coordinazione.\n\nIamHero raccoglie dati relativi esclusivamente alle interazioni svolte all\u2019interno dell\u2019app, come tempi di risposta, risultati delle attivit\u00e0 e progressione nei diversi scenari. Queste informazioni permettono di visualizzare l\u2019andamento dell\u2019esperienza e di adattare il livello di difficolt\u00e0.\n\nLa piattaforma utilizza sistemi di analisi dei dati e algoritmi di intelligenza artificiale per organizzare i risultati e proporre attivit\u00e0 coerenti con il livello raggiunto dall\u2019utente.\n\nIamHero \u00e8 un\u2019esperienza digitale interattiva e non fornisce diagnosi, indicazioni mediche o trattamenti sanitari. I risultati mostrati riguardano esclusivamente le prestazioni ottenute all\u2019interno delle attivit\u00e0 proposte.", "short_description": "IamHero \u00e8 un\u2019esperienza interattiva in realt\u00e0 virtuale che propone attivit\u00e0 gamificate dedicate ad attenzione, memoria, pianificazione e autocontrollo, adattandone progressivamente la difficolt\u00e0 alle prestazioni dell\u2019utente."}, {"images": {"nodes": [{"file_name": "meta.png", "id": "3896909683972560", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308518_3896909687305893_4786362895792635386_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUN8gXVV6lwQ7kNvwE9ONaB&_nc_oc=AdoEnjCf8h1lA6ETR8gbi281vptEnREP48s-CY7bc6fnFfmqqnuC-TG0HE62PmMslj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx1St2GM7O4iPYkESKyH4vBWHJEQkzSLvbRozZfxtaQw&oe=6A8C328B"}, {"file_name": "icon.png", "id": "2514576592256108", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820067_2514576595589441_4634253453983413541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKO67Se3hVEQ7kNvwGgfIW4&_nc_oc=Adqp_fYfUceQASx6StapilSgJb_QsaqeD7qiG6Xl1N0uxkNhSFAg6Wac1A3SA1zn0N8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaejuiLmy1iiyEi2DJwiCbe82_Pog99azbuPQld5uqng&oe=6A8C2AA3"}, {"file_name": "1008.png", "id": "1881612335923708", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820067_1881612339257041_8398923751832053673_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTgDxWCO89oQ7kNvwE3qabw&_nc_oc=Adr-JVQzVLPk4AsCJ-3Tu-njjwFtLb43jy_y_cVmAhBhMH_3PTGgH0ljXMgAq714irg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_
3_4203142064269962940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OJ6L_Kz_HQQ7kNvwGe7uRl&_nc_oc=AdpJ3LqOOujjjIZ849zuD_JYIdDBaqUDjb4sDYxQ9UUEYExHNXH6pEmMv0PT8HkJ2fQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtgEcVtmYmIQ-iHP4wUnsLMntKLM6eon67314N2RIQ4w&oe=6A97487C"}, {"file_name": "_big screenshot 3.png", "id": "1619590828717013", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618432_1619590838717012_4796560995061288565_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onxR9LlYcHkQ7kNvwG2AED1&_nc_oc=AdoUe-IYvHeCtKahvHxfh2P6sS99wMe1O8dy1VC_ZGRA0x2ShO-qKPU_xeKe1Pjr_A8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDj9Xanuuj_sqUJ-9GBnzvi-XxeSojXnIGwQoI5vDVLA&oe=6A974D60"}, {"file_name": "_big screenshot 4.png", "id": "541733695599188", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618065_541733698932521_7627572240919923852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A42XYvpEgV0Q7kNvwGLRzdD&_nc_oc=AdoQhbbZTM_s6-ufu5F97t8_uV7H_xi7JhIXwZVm4FuEcf0Lf_EfqfoTYIv-I7MX9ds&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBIT7GoABsL6FW2etC4ITrflCCtXMeSMxIzxISaGXsvQ&oe=6A974E0E"}, {"file_name": "_big screenshot 5.png", "id": "1266789418292382", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619729_1266789421625715_5935815097983858465_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtCqXZgeN-wQ7kNvwEvfZZ0&_nc_oc=AdrDPoeeY1-8E3Ujho10qRcVdJHxDTFft15LMxVU5gpM17vC4pv6O0JP54wfTcIpg_c&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtD6hbU-Qy5yHkxXFQMlGOdqLz4RGWEJOxnpEXD2KWbA&oe=6A971E43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Alley Dodge Cover Art 260.png", "id": "2114311109093041", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618928_2114311112426374_7778150625822674201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vesmFg865NIQ7kNvwHCZCIS&_nc_oc=Adr7ptkkX5CB750ut0RqgvtUnfcd0gifbZ2Nu4KozqkYbmv2zaI6XvKfarNPdsDYHWw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT2NDS9YWI28CormT0PAg_05Zdp_4IJVEPvetgqRdQOA&oe=6A972A3D"}, "display_name": "Alley Dodge", "keywords": ["arcade", "casual", "endless", "runner"], "long_description": "Alley Dodge is a 100% free to download, single-player virtual reality action arcade game with two simple objectives:\n1) Grab yellow coins.\n2) Move your body to avoid colliding with a stream of steadily approaching giant red cube-shaped obstacles. \n\n\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\n\nNormal Mode:\nDodge 3 uniquely shaped red obstacles in normal mode, specifically selected to make you sidestep, duck, and climb\u2026\n\nHard Mode:\n\u2026or take a crack at hard mode, which adds over 40 additional differently shaped red obstacles to the mix. With so many unique shapes to anticipate and avoid, this mode will have you squeezing your body all over the game.\n\nCustom Mode:\nAnd if neither of those suits your fancy, then tune the game to your own liking in custom mode, where you can select which objects the game will spit out toward you, adjust game speed, and more.\n\n\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\n\nGame progression:\nEach time you grab 5 coins, congratulations, you\u2019ve made it to the next level. \nThis slightly increases how fast objects move toward you and how many are generated per minute. \n\nDefend Yourself with a Blue Shield:\nAlong with all the yellow coins and red cube-shaped obstacles flying your way, the game will also occasionally hurl blue shield items at your general direction.\nTouch one, and you\u2019re safe to collide with a single red obstacle without it ending the game. \n\nGame Over:\nFinally, if you\u2019ve touched enough yellow coins when the game ends, then nice work, you'll be asked to add your name to the offline high score leaderboard.", "short_description": "Grab yellow coins and move your body by sidestepping, ducking, or climbing to avoid colliding with a constant stream of steadily approaching giant red cube-shaped obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kangarootreadmill.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kangaroo Treadmill", "support_website_url": "https://kangarootreadmill.com/contact-us/", "website_url": "https://kangarootreadmill.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24277312945262904"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3682633932045234"}]}, "baseline_offer": {"id": "3682633932045234"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754873100, "status": "PUBLISHED", "id": "3682633932045234"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27099060343088136", "version": "1.6"}, "id": "1021446223156006", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24089785104015690", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27099060343088136"}, "release_status": "RELEASED"}, "binary_release_ch
7572240919923852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSvXvHeNlv4Q7kNvwEWoaal&_nc_oc=AdpIdEPqueRP7gnRgQf7khju34jvkExD3OEuUZbECnX3PwysrI0p2JkQGvlSDT1YSrg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16P7uKDhNNuXRhRmaX1DG2b7lFMoDpseip4Q5AQ2GmLw&oe=69F3638E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Alley Dodge Cover Art 260.png", "id": "2114311109093041", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618928_2114311112426374_7778150625822674201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJC5MFuuZa8Q7kNvwH3hptb&_nc_oc=AdqQy7RQPPAE_FBA-1yhtDz13P36tZpFnuHSKrkeSd5t9Z5xbkjF__fJPTs74tLDb6c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29u035oyMidNfWa31s5y1yRxhnqwqt2JtmJNNAdR6ImQ&oe=69F33FBD"}, "display_name": "Alley Dodge", "keywords": ["arcade", "casual", "endless", "runner"], "long_description": "BEWARE! Giant red cube-shaped obstacles are steadily approaching. You must lean, duck, or climb to avoid colliding with them\u2026 or be exploded into smithereens!\n\nSo get ready to get good (or even more good) at getting out of the way in Alley Dodge. It might even be fun!\n\n\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\n\nEnjoy:\n\n\u2022 Easy to learn VR action inspired by classic arcade video games of the 1980's.\n\n\u2022 Highly customizable game options able to entertain total beginners to expert-level players.\n\n\u2022 Cheers of the in-game announcer's excitable words paired with colorful bursts of confetti.\n\n\u2022 And maybe even getting a bit of exercise that doesn't feel like work.\n\n\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584\u2580\u2584", "short_description": "BEWARE! Giant red cube-shaped obstacles are steadily approaching. You must lean, duck, or climb to avoid colliding with them\u2026 or be exploded into smithereens!\n\nSo get ready to get good (or even more good) at getting out of the way in Alley Dodge. It might even be fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kangarootreadmill.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kangaroo Treadmill", "support_website_url": "https://kangarootreadmill.com/contact-us/", "website_url": "https://kangarootreadmill.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26623034177357424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303455_786319633830135_1307602971965594831_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJXFCxFaqJUQ7kNvwFkdhtz&_nc_oc=Adrr5IMHp-_VwpVRAVOc_WiBNckbi9DgjffA9JOgD9j5DA9tWh1u_ntu8BWqSJczCEI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1byC41n_HSmhCY4xtack77f4yL7zDzLx34FKUE1TCRFA&oe=69F36B32"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alley Dodge", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1754873100, "lastRevision": {"nodes": [{"id": "24089785197349014", "release_type": "SCHEDULED", "
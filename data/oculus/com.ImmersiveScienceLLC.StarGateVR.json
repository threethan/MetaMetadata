7kNvwHWHTds&_nc_oc=AdkxeHaITgCFb_y7f_nxlfm3dIqO5wPqAya5ZUegquEB71_rqQW2ncipTWcXPzrEhYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgYulz8pfEREOSKS_GXdqn6rjn1Rn9ptYn0_roOKqv2Q&oe=69A829D7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0TeN_KzPXoQ7kNvwHd-DTI&_nc_oc=AdlKMQCLiH42c6VCtKfPDl6ispoxT6AzjPhQKbYdMJ5yCL5X8XNF9psFlFV8BTHRIEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft9-8jwOcsoS5c-ht2Ml703arCXg0iZso2VioC8xhhUEQ&oe=69A81D57"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zTNMDeTt6IQ7kNvwGP2wmX&_nc_oc=AdlxZf7To4mCrcebQAeMiFcv1o4_Pu1HjEuaxNYr8xiEZpjNsE2G0q3g7cNdwk_7vzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftgMmREih3ltdSK7aZQ5_-SEXsKeDwBRkliNPvN8JAx1Q&oe=69A80B14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGsgnwz19ggQ7kNvwFT1crM&_nc_oc=AdkEKWujXkDBVfk2KgTgitTSwmx9ovN1F5u46AMwpJXBdNWFrm4BJ2SLFDIoNs6zUBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5K0yTAb4zi4b8pkjhu1O8RM_sT3NU_httmnXcU0uudA&oe=69A83A9C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is an advanced virtual reality platform for interactive exploration and analysis of astronomical data. Designed for professional researchers, educators, and advanced hobbyists, this tool allows immersive visualization and filtering of stars using the Gaia catalog and other astronomical datasets. Collaborators can select star parameters in 3D space, filter datasets using gating tools, and examine cosmic structures together in real time. Ideal for astronomy research, education, and collaborative scientific analysis in immersive VR environments.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience designed for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25057718527199592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWBjoSdg9HIQ7kNvwEWfURh&_nc_oc=Admmug-S71G6zwBfqhAsLMrADDU2ew55Jav5D3UhxWHfSyNAn6ysd5Nuz8fCGROKMRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5rBBIk5Sa18QAk2OYLNQtmTn_aJZjKkFKdVJSLdvKmA&oe=69A81F41"}, "is_concept": false, "is_test": false, "is_trial
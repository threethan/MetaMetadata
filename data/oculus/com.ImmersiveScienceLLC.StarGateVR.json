hsalHloPmdxE1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsdps3DnAGcMg72VNNPiXNFKMtDjWMX8vKK4TRa77PC-g&oe=699857D7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgcQmod0pAIQ7kNvwGoHkJ_&_nc_oc=Adni4IL32VhnnyEGRJ7wBixvvRvy6n-w9EUwjvZZOginbyv7oCqMUMmPwkOmI6_CjFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftCXfDlQ8NQa8Nbf2_Bq5lTpPv1K2FlMmnsp7hSYS2P0Q&oe=69984B57"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K59lwkq-cIcQ7kNvwHwif50&_nc_oc=AdmPE-s7XSyMbrVazIPw5cBf1VCy9gBbQexMVsJ3WommT4N4JnSZOcPkA74qRZRhbuQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvqWjn0OCa9kdyU1nFJyW8PCO6tOtKEOIf-H6_iO_tnRw&oe=69987154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkLF0Hk_nnsQ7kNvwHl0l9Q&_nc_oc=AdlVj6ffowg6sVHFDJEIjLdb6E-yRCsVCGN6iCIEXmKtN-GFe9qn2PzLFFxZZGzvXtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs1XAr0Dq2oQ8XvlQg8IHWj4SCq59nRKqLZD1dnnbhc9g&oe=6998689C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is an advanced virtual reality platform for interactive exploration and analysis of astronomical data. Designed for professional researchers, educators, and advanced hobbyists, this tool allows immersive visualization and filtering of stars using the Gaia catalog and other astronomical datasets. Collaborators can select star parameters in 3D space, filter datasets using gating tools, and examine cosmic structures together in real time. Ideal for astronomy research, education, and collaborative scientific analysis in immersive VR environments.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience designed for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25057718527199592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j50bhLsaBgcQ7kNvwHAJ2UB&_nc_oc=Adl5CuPOaP3ggWKBMd8gKSdJq4l8Uwa2SN-m1Ga1-fZkV3teY-SnOpiORdjkzeF1Ack&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft4qmtj_jOq23KFXfm1mSS4eN1sdMp4cezZYojHxQnSPQ&oe=69984D41"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_categor
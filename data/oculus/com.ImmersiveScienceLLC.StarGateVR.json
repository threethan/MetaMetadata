__IVUqA16Vr6cA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvcPrlaqxymb_ROopOKLSzQ5NbM1IM_13ET-hmSArlEQ&oe=699C4C57"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-nfmvZ82fAQ7kNvwHbjMTg&_nc_oc=Adn5TBv3FP5ibCaRnHmNUduvqFOVHb_bewAkpoohKz2tE0GkniuXHnyKyotTji39JTk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu3s9SSSk88F2D70VG7YSNlPVMRR1Qu21mrHu_tp3daNw&oe=699C3FD7"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKAlUiZrcd8Q7kNvwHs3Z7-&_nc_oc=AdmfZ5-E_kdz2nRtf5iYGtwAFXxjt1XfJASMM3N2TQqmeFjBsMb90bJSmIyIbhxddAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsdXtwD_8g2wqM1fyPYCAXKHTLhq11C5atbaAwLjKD0tw&oe=699C65D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBsr_l7frI0Q7kNvwGcXRqo&_nc_oc=Adnu3foOCsZN8leVvB-CTeE2VzsKD2xK5QMlLXPoYFfz1YlSPICQ8Q06aYso5emQRaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsk-HwL5GZsYdCHWqp4S4VftRfyAv29ThmBgFAhD_iQgQ&oe=699C5D1C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is an advanced virtual reality platform for interactive exploration and analysis of astronomical data. Designed for professional researchers, educators, and advanced hobbyists, this tool allows immersive visualization and filtering of stars using the Gaia catalog and other astronomical datasets. Collaborators can select star parameters in 3D space, filter datasets using gating tools, and examine cosmic structures together in real time. Ideal for astronomy research, education, and collaborative scientific analysis in immersive VR environments.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience designed for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25057718527199592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nJPYTII664Q7kNvwHzOvJm&_nc_oc=Adm_bFR9tjc8SCnvifSMe7U4G-4l0VM82Fy3inCSZ_RGlCtNGJt4rjqpYWZ3ZVn5SPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv_fUcpiujQmxq3puJDgiV11kBbMjt_x9gg-a_-5Zh9WA&oe=699C41C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_categor
X6WqaxKo4LKyB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfupPpfHilYtAd5ep_UhEEAxnFgjflV1m9bDPnqvkOwCGQ&oe=699EEF57"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSoz1tDDmAMQ7kNvwET_XJm&_nc_oc=AdliNedbeSohmS8kLksxjd-nj3J8d5-6EoQzYFX7rJ0CqIYMaTna59drbRzJUshlIvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftev0TzZ41d-Q5pBXKoaWKb-VBUoRJbUo-yNZxl7h_nVg&oe=699EE2D7"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTTW2KZPzOMQ7kNvwHX8yk2&_nc_oc=AdlkqFXp_m3AI7oFRhL_C9xSo9ejv3x_OS31uOPzSzy-c7n2dGYCnEP6lMm-jQ3f2Ro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft5KRkR4oiPg2D2p-HSRkENg4wFX4VvksvSiuL7yq7KJg&oe=699F08D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkvngQ1QJQoQ7kNvwHCch1h&_nc_oc=AdmUDDeR79aOvtLnptmq41MnapZeMKD-5nedsPeFQi0ioIsPT2Mzs2muP9rJhabpkkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsoQpi1u4PBADHVJamV8AVxaKq1MFFoLdeYjt3Xv-zUwg&oe=699F001C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is an advanced virtual reality platform for interactive exploration and analysis of astronomical data. Designed for professional researchers, educators, and advanced hobbyists, this tool allows immersive visualization and filtering of stars using the Gaia catalog and other astronomical datasets. Collaborators can select star parameters in 3D space, filter datasets using gating tools, and examine cosmic structures together in real time. Ideal for astronomy research, education, and collaborative scientific analysis in immersive VR environments.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience designed for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25057718527199592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uXc0fx-CasQ7kNvwFAIIY5&_nc_oc=Adk2alSO7LKLRb6BLtlk53Y2HBmnXwu3j3IzosnWdLTXY8zHHwTwdGU-acuh9c-Upu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvRbEiDzTCZRC2ct_LLtJCSws8_hcIpdvZij5UG1Aj_DA&oe=699EE4C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_categor
o_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VALajAuy_mYQ7kNvwGm3NX1&_nc_oc=Adq7ymTo0xD-LbBnbmoPGL_KZZmhs0O2F-cawizk6_P2N7NEcHvaASRUR7j0pIvrWw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElBBJGB3jFGwEYNmKDPLOJvRHAI7de6y44lHMEWvvPXA&oe=6A83139C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR represents a breakthrough in astronomical research and collaboration, offering a virtual reality application uniquely designed for the exploration of stars. This innovative tool allows users and their collaborators to immerse themselves in a shared virtual space, where the vastness of the universe is rendered in stunning three-dimensional detail. By leveraging the power of VR technology, StarGateVR provides an unparalleled platform for interactive learning, analysis, and discovery in the field of astronomy.", "short_description": "View, explore, analyze, and collaborate on Gaia star data in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7126747980723255"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1494543572471061"}, {"status": "PUBLISHED", "id": "1528095444681146"}]}, "baseline_offer": {"id": "1494543572471061"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772480700, "status": "PUBLISHED", "id": "1494543572471061"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27939116275726455", "version": "3.5"}, "id": "333513379492481", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27939116275726455"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": null, "created_date": 1785975152, "id": "27939116275726455", "version": "3.5", "version_code": 531, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27939116275726455"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "StarGateVR Build 527 -- Gate management, display fixes, and AI upgrade\n\n\u2022 Gate hierarchy is now fully reorderable: left thumbstick click + up/down swaps gates in the list, letting you reorganize your AND logic without deleting and recreating gates\n\u2022 Gate point counts now always reflect the correct AND result -- a display bug where a child gate could show more points than its parent is fixed\n\u2022 Spheroid gate save/restore is working correctly across all cases\n\u2022 Blue gates are now cornflower blue -- much more visible on the Quest 3 display\n\u2022 AI Assistant upgraded to a newer transcription model\n\u2022 Flight acceleration moved to right thumbstick only; left thumbstick click is now reserved for gate reorder\n\nNew to StarGateVR? A full Controller Cheat Sheet is on the website.", "created_date": 1785634187, "id": "27892258040412279", "version": "3.5", "version_code": 527, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27939116275726455"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "StarGateVR \u2014 COSMOS-Web Support\n\nAdded support for the COSMOS-Web JWST galaxy survey: StarGateVR now recognizes COSMOS-Web magnitude column names and correctly displays galaxy-survey magnitude ranges on plot axes. Fixes a long-standing axis-label issue that became visible with this dataset.", "created_date": 1779165812, "id": "27007283075576451", "version": "3.5", "version_code": 508, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27939116275726455"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "AI Assistant is now responsive on large datasets \u2014 no more long pauses before replies. Questions about the selected star get answers tailored to what you actually asked (exoplanet potential, variability, companions, identity) instead of a generic catalog card.", "created_date": 1777361093, "id": "26755532494084845", "version": "3.5", "version_code": 507, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27939116275726455"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "\"New collaborators now auto-sync the master's dataset with clear status feedback, and the app gracefully handles stalled syncs, missing master data, and oversized files with actionable prompts. Loading from Downloads is also more robust \u2014 ZIP and compressed CSV files are automatically extracted/decompressed, stale cache files are cleaned up, and the VR Conversation Log has been decluttered to show only astronomer-relevant messages.'", "created_date": 1776835656, "id": "26681038851534210", "version": "3.5", "version_code": 506, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
Q7kNvwFYswAw&_nc_oc=AdnXJrAz9xfMymsIeuMWpXxB3Y8ZgOCSk6VTimg-7N57sPSo5WJKn86ZqptJ5wN7Ty0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzeENqklem5BfIR3X1wQyUm1J-r_6nSFnvZZpeqYYObSg&oe=69AC1E57"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRiklX7VtmoQ7kNvwH1GlQI&_nc_oc=AdlkV6I_LJZU8B3qCdGYE6yzLsVIF0oaBz1Irt4pClEdQro6esgSNwbyEIr3w2SKTlA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw80Ejt3ZHI4DV_0Q-dbaUOYcxhczpj4dT9v7ZB7JFbkg&oe=69AC11D7"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5AYAR15yrgQ7kNvwHS-QmR&_nc_oc=AdkHiAKGsy0GlOjPVGxQO45l9UcBzyov4DAwYoMK47tBIbyqQ4zwwGhW7Ody_XgvBrk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-4u-lrl1xihF5c0eoKdzx5pvNaMdblbL3anD21ltjFA&oe=69AC37D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHLE8OwfrkwQ7kNvwG3ywHW&_nc_oc=AdlpYcKMFInn2hyzyZxq34gRonjpAIwrAhGKu-qEENEwDSZUBD_RaV2Eae5pX0fkdGE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzxGqhlpkYywj8Atz6aZne8Wd05QDhJRcGpLcmz4Arovg&oe=69AC2F1C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is a voice-driven VR platform for exploring astronomical data. A built-in AI assistant responds to natural-language voice commands \u2014 query your dataset, cross-match with multi-wavelength archives, or describe a new dataset and have it retrieved from the Gaia Archive automatically.\n\nVisualize stellar data in immersive 3D with real-time catalog enrichment from Gaia DR3, eROSITA, GALEX, 2MASS, WISE, SIMBAD, and MOCA. Map any parameters to the spatial axes, switch between physical coordinates and parameter spaces like the HR diagram, and color points by additional variables.\n\nCollaborators join shared VR sessions with voice communication, co-navigating the same environment and sharing enriched datasets in real time. Import your own data in CSV, VOTable, or FITS formats.\n\nDesigned for researchers, educators, and advanced hobbyists. Identify features and patterns in immersive 3D, then export findings for follow-up with traditional analysis pipelines.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26144262018545232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1
Q7kNvwEKIIeb&_nc_oc=AdnBdtLv4za75GnL647SHD7BWS7O_CsHs94nuJyY18TbdB2RVd2LFpv8GA5LNXz4UXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxiox39D00b_bHN8VdyEIjg509DP_WHyx1zDuraMEN-mA&oe=69AEC157"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4acWkRZYBwQ7kNvwHvj7b1&_nc_oc=AdnLtpH-kU69Kj4xKIkJR9UGX86HnonWYIqINVZGu31erYn1LYubJ07HwlSyM8UoLOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLHAc2OL25IdsHxKrdiS7euKAE35zB7LDmi1dodJQvHg&oe=69AEB4D7"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT79z5j1phgQ7kNvwEqDbGd&_nc_oc=AdmUs3GQQT4bBpPx-j41Aqaof6p4gE5L9eaAywfzl8XynmT-XVRqOT6YBhH6IV5g0zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7kUK_qfYUayxFm9SWz6rZb4ny92XOWGbsXYTyYIfejg&oe=69AEDAD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI7nxLO1kqIQ7kNvwFS3TLG&_nc_oc=AdkBYfLs8tGqWDQQ6xaN_i7SZ5bhP5QWl5nvKsZ_6Are77jhGtVqwT37rpOe10XaH-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyU_7jcMwVb2N8rpdlIh0SPpEVSlkkr8KnIdqnY7biAnw&oe=69AED21C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is a voice-driven VR platform for exploring astronomical data. A built-in AI assistant responds to natural-language voice commands \u2014 query your dataset, cross-match with multi-wavelength archives, or describe a new dataset and have it retrieved from the Gaia Archive automatically.\n\nVisualize stellar data in immersive 3D with real-time catalog enrichment from Gaia DR3, eROSITA, GALEX, 2MASS, WISE, SIMBAD, and MOCA. Map any parameters to the spatial axes, switch between physical coordinates and parameter spaces like the HR diagram, and color points by additional variables.\n\nCollaborators join shared VR sessions with voice communication, co-navigating the same environment and sharing enriched datasets in real time. Import your own data in CSV, VOTable, or FITS formats.\n\nDesigned for researchers, educators, and advanced hobbyists. Identify features and patterns in immersive 3D, then export findings for follow-up with traditional analysis pipelines.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26144262018545232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1
gHOayZEC7fuU5VblQjaVFDDxApaQ&oe=6ABE7017"}, {"file_name": "OculusScreenshot1702168621.png", "id": "1417106885903761", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222941_1417106889237094_8505880443188676782_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rCH9Hx0lsMQ7kNvwFmsBPK&_nc_oc=AdrCiQsohOgOvYjql8Bt2r-AMEP6U3CSU5hDbWe0DMkiaJR1zByQS8cPHD-tR4NiZ9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIRaMglpbwFK2HAPYn-JY-yAzi6bMzccF2iSevEhY7uQ&oe=6ABE5657"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hri_PuTuzz8Q7kNvwFv9-8S&_nc_oc=Adr77q3r15_8jcOrfbtfykg4wbt6EQBrMfed-CcZ88PFtvy56VNX6w92PB8YVEwtWxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAg0sz6_cALysX-5bpIJKG48vKRfOEqNLmM85QKL5WrA&oe=6ABE8217"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc0YfIhhqTMQ7kNvwF6Bo4i&_nc_oc=AdpJ1aCjwGK_MQy74CxAnUxgwNqVSaldAHnw4H4tq2UMbyHEcXf3X0lrcYqejY9u5KA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITmDm-wBBg2uXxJsyulgghydOaZWFkVnGWSes7LIGwlQ&oe=6ABE6FD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGKuLae7tp8Q7kNvwE7Hc4n&_nc_oc=AdpzfSlLgmA7Sc3RKspQvtC16Fe8NHdHU8bTOZenUPMMlRlcgVG9lr__3HTDjHIUUxE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJazr2jXLRsYARTgrh6oBKLL6J203gm463JUBPYSACN3A&oe=6ABE671C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "**StarGateVR** puts astronomical data in your hands \u2014 query archives, visualize in 3D, and collaborate in VR on Meta Quest.\n\n**Live archive access:**\n\u2022 Query Gaia DR3 directly \u2014 describe a dataset and retrieve it live\n\u2022 Cross-match with multi-wavelength archives in a single command\n\u2022 Integrated: Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n\u2022 Map any parameters to spatial axes\n\u2022 Switch between physical coordinates, HR diagrams, and custom parameter spaces\n\u2022 Color and shade points by additional variables\n\n**Multi-dimensional gating:**\n\u2022 Select and filter data interactively in 3D space\n\u2022 Isolate populations across parameter dimensions\n\n**Collaboration:**\n\u2022 Shared VR sessions with voice communication\n\u2022 Enriched datasets sync across all participants\n\n**Your data, your way:**\n\u2022 Import CSV, VOTable, or FITS formats\n\u2022 Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\n**AI Assistant (Early Access):**\n\u2022 Voice-controlled \u2014 query datasets and archives by speaking naturally\n\u2022 Requires internet and Meta sign-in. Improves automatically, no update required.\n\u2022 In development. Feedback welcome: support@immsci.com\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try **ConstellationsVR**, our entry-level experience with an AI astronomy guide for STEM learners.\n\nNote: StarGateVR is a scientific research tool by Immersive Science LLC. It is not affiliated with the Stargate media franchise or the Stargate AI initiative.", "short_description": "Explore, analyze, and collaborate on multi-dimensional astronomical data in VR \u2014 query Gaia, SIMBAD, and multi-wavelength archives directly from your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_
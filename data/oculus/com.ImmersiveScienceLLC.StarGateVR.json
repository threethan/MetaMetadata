=00_Af7SH0DgfdHcdNYEv2UlmkX62Za1Qbem95Vab5fvgEeS8w&oe=6A0F0F9C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR represents a breakthrough in astronomical research and collaboration, offering a virtual reality application uniquely designed for the exploration of stars. This innovative tool allows users and their collaborators to immerse themselves in a shared virtual space, where the vastness of the universe is rendered in stunning three-dimensional detail. By leveraging the power of VR technology, StarGateVR provides an unparalleled platform for interactive learning, analysis, and discovery in the field of astronomy.", "short_description": "View, explore, analyze, and collaborate on Gaia star data in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7126747980723255"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1494543572471061"}, {"status": "PUBLISHED", "id": "1528095444681146"}]}, "baseline_offer": {"id": "1494543572471061"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772480700, "status": "PUBLISHED", "id": "1494543572471061"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26755532494084845", "version": "3.5"}, "id": "333513379492481", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26755532494084845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "AI Assistant is now responsive on large datasets \u2014 no more long pauses before replies. Questions about the selected star get answers tailored to what you actually asked (exoplanet potential, variability, companions, identity) instead of a generic catalog card.", "created_date": 1777361093, "id": "26755532494084845", "version": "3.5", "version_code": 507, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26755532494084845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "\"New collaborators now auto-sync the master's dataset with clear status feedback, and the app gracefully handles stalled syncs, missing master data, and oversized files with actionable prompts. Loading from Downloads is also more robust \u2014 ZIP and compressed CSV files are automatically extracted/decompressed, stale cache files are cleaned up, and the VR Conversation Log has been decluttered to show only astronomer-relevant messages.'", "created_date": 1776835656, "id": "26681038851534210", "version": "3.5", "version_code": 506, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26755532494084845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "Fix: UI panels on left controller now correctly hide when grabbing the Gate for placement.", "created_date": 1776729575, "id": "26667292132908882", "version": "3.5", "version_code": 500, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26755532494084845"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "StarGateVR - Build 498\n\u2022 ASK AI redesigned: Early Access panel is now hidden by default - tap\n  \"ASK AI - Early Access\" to reveal the voice interface.\n\u2022 AI answers now play back reliably and display without stray markdown.\n\u2022 Questions about clusters, UVW, and stellar identification are routed to\n  the AI more accurately; fewer hallucinated answers.\n\u202
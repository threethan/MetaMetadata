1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThAInYs-pGfk-Lpf7d9zsO9NmSeztcrDLeKyciZHYdhA&oe=6AE9F154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxfOPpMOJMAQ7kNvwHl8DWp&_nc_oc=AdrtkfhIhFOiSkeJqLseCntg2VYcNRYKrSB9cMUDxXh8YdmLzdsRNfyTACqr8ygmTSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2MzBRDiPWS19ADUcf5C1UzjIT3U61a8vK9rhTYLCyqA&oe=6AE9E89C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR represents a breakthrough in astronomical research and collaboration, offering a virtual reality application uniquely designed for the exploration of stars. This innovative tool allows users and their collaborators to immerse themselves in a shared virtual space, where the vastness of the universe is rendered in stunning three-dimensional detail. By leveraging the power of VR technology, StarGateVR provides an unparalleled platform for interactive learning, analysis, and discovery in the field of astronomy.", "short_description": "View, explore, analyze, and collaborate on Gaia star data in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
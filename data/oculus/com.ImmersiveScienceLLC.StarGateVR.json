cjdC3JPxwMiVQJ6tBgv9dsAEYGiMkYsmuVUSCGqWyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq4kj5pDvBmpJ_xsANLMP6ceWaIaIXt77WrmnRYSdrsg&oe=6AEB4317"}, {"file_name": "OculusScreenshot1702168621.png", "id": "1417106885903761", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222941_1417106889237094_8505880443188676782_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05D1A0DkbaUQ7kNvwHnbIRr&_nc_oc=AdowYCSYhHFCzRLYTiV9tbLfyUCxS312f9puWLlgrtgAiY2K9VpfbUd53wY_SKSOM4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEMsNGmnARhqDg8-XfswxiKxRLDLTJ-bDvkP9gWTghLw&oe=6AEB6197"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lVeqQmG_KcQ7kNvwFPve49&_nc_oc=Adp1ZhqXVYPkCKLX7MRnupndpq1SX0aQ8ZsqvgfkZb2miadayoP6Sv1j2jM3wkfDJZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrH8d3v295pWZmV3fcxwtsOZYTx83-r2rPeIFOBis0uQ&oe=6AEB5517"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwsOWT-PoGQQ7kNvwECAz07&_nc_oc=AdrDknO06S3J5P46Y4K2YeVB6krb13X-KA85Z1SlEnf-7dAPERka5IwoqjqTZ3b0GTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR71klK7CO1ms5Gv_8kP69U5wdjh4B79fRid9YM5gn_tQ&oe=6AEB42D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxfOPpMOJMAQ7kNvwHv5G98&_nc_oc=AdqmHg9EuC4Y6uCi8vRrXDNPpf2mgnqLhq81jmraaAln3NEIcHD5Na78whpv2Kdnyto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScZynFzUnftDrP2Rh5h2AEp9w4g9P4p3koIOMUo3PzGw&oe=6AEB3A1C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "**StarGateVR** puts astronomical data in your hands \u2014 query archives, visualize in 3D, and collaborate in VR on Meta Quest.\n\n**Live archive access:**\n\u2022 Query Gaia DR3 directly \u2014 describe a dataset and retrieve it live\n\u2022 Cross-match with multi-wavelength archives in a single command\n\u2022 Integrated: Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n\u2022 Map any parameters to spatial axes\n\u2022 Switch between physical coordinates, HR diagrams, and custom parameter spaces\n\u2022 Color and shade points by additional variables\n\n**Multi-dimensional gating:**\n\u2022 Select and filter data interactively in 3D space\n\u2022 Isolate populations across parameter dimensions\n\n**Collaboration:**\n\u2022 Shared VR sessions with voice communication\n\u2022 Enriched datasets sync across all participants\n\n**Your data, your way:**\n\u2022 Import CSV, VOTable, or FITS formats\n\u2022 Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\n**AI Assistant (Early Access):**\n\u2022 Voice-controlled \u2014 query datasets and archives by speaking naturally\n\u2022 Requires internet and Meta sign-in. Improves automatically, no update required.\n\u2022 In development. Feedback welcome: support@immsci.com\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try **ConstellationsVR**, our entry-level experience with an AI astronomy guide for STEM learners.\n\nNote: StarGateVR is a scientific research tool by Immersive Science LLC. It is not affiliated with the Stargate media franchise or the Stargate AI initiative.", "short_description": "Explore, analyze, and collaborate on multi-dimensional astronomical data in VR \u2014 query Gaia, SIMBAD, and multi-wavelength archives directly from your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27892888597015890"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xef4y-SCnVUQ7kNvwE_3qQ6&_nc_oc=AdondOVldzb628alYJ_KnN7RArOAjpu_rv2vTrCXL0hBappf6KLjxY4SYK9uly1kYI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9MlOEeA8GyI20R28vsPWHPrYJVA-HXl3tpDJn78zClA&oe=6AEB5701"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1709752380, "lastRevision": {"nodes": [{"id": "7126747984056588", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7126747977389922", "is
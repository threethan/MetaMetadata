Q7kNvwElX_tI&_nc_oc=AdlVhRKsLC_FCX4jBmEEfT9TrRveeMFrpTP9Z-1wSwS4gWK4W3KHzmDNqyMPQverKiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftAtOh_yAsD8-v5E9HD28HKi4SoypMntEHdJ6MyHhNRgQ&oe=69A97B57"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0TeN_KzPXoQ7kNvwGmR5UI&_nc_oc=AdmeXJ1Mdkynuq4aGnBZ6LXD-hHHYdbT1NKMG_59BmQYc18OtG3pEN1GJjDsqnhTNCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuBcjqbnLMpGLUGJKDlruxiB1mdDpVjgaBmqmC6pu1D2g&oe=69A96ED7"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zTNMDeTt6IQ7kNvwGJbhFB&_nc_oc=AdkuMzPv1zhAxF2b0aur4K0c7j3bA-4Z0DY1uS2gJ3KnqSDjeauhVCjfSMOBKMQ1vpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuIDflKwcOFq7FHojE1J4MlEIAMt-oIFIn7Osgdw2_3wA&oe=69A994D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHLE8OwfrkwQ7kNvwGNxDif&_nc_oc=Adk3QKE-ddBZdF2VzEX-fmC2bCELDb3bptMCmt25svzGkn_ltTe3PFEE1S-z51Cb3iQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuUokFYWLNPdJeQ6huWvtqgpF3TQXQo3GU8TwmJVwguLQ&oe=69A98C1C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is an advanced virtual reality platform for interactive exploration and analysis of astronomical data. Designed for professional researchers, educators, and advanced hobbyists, this tool allows immersive visualization and filtering of stars using the Gaia catalog and other astronomical datasets. Collaborators can select star parameters in 3D space, filter datasets using gating tools, and examine cosmic structures together in real time. Ideal for astronomy research, education, and collaborative scientific analysis in immersive VR environments.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience designed for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25057718527199592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWBjoSdg9HIQ7kNvwFZ30eZ&_nc_oc=AdkM7RLhKciwmFMIqObbmaHmnL9mYxnlThZPqWg_En_S8Tcs0KpWncx2tmuHq3SDP8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftvxei9RSuPNMuQwgGY7tvI5hj6EHVaPsdsgOzkUN4E4g&oe=69A970C1"}, "is_concept": false, "is_test": false, "is_tria
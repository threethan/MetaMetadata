MkESRNUOEObXww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs8Cxxo7FKPQdZhqFRhVc5F6N38bLtU2DCWNJwqWtNa6w&oe=699AFAD7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-nfmvZ82fAQ7kNvwE9V0CD&_nc_oc=Adk_eanmkWZzdDU_Xv1BbeBO_KAZHocZIxWIJBdV4jrPAJSRsBssyFfDodpki2lMeD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMU9lGxGelna22scO6L4qiqfjD4OWt6D5GgF0Fo5ROBQ&oe=699AEE57"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKAlUiZrcd8Q7kNvwHDCQ8P&_nc_oc=Adl4JUtFeI_owI9BT7sMMl5ImuHxnZRJZ-YKpEYnINA9lVBrIDPOeeFrroPYiiWHHVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvhEHGVdTCp8kPhRtsxSmmayNXoWejNTE7FFyrfSoCh2g&oe=699B1454"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBsr_l7frI0Q7kNvwEh8si5&_nc_oc=AdkltfQkepwrnwt5HdtSolyU3ptDIFHR0_RyBBW9VfT8deVYuYulTnWtjk-HGt_M_a0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs7sVoGDLWRMVZwYoko4-wVm-8oNTrfL0Q_eGodyvwHYA&oe=699B0B9C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is an advanced virtual reality platform for interactive exploration and analysis of astronomical data. Designed for professional researchers, educators, and advanced hobbyists, this tool allows immersive visualization and filtering of stars using the Gaia catalog and other astronomical datasets. Collaborators can select star parameters in 3D space, filter datasets using gating tools, and examine cosmic structures together in real time. Ideal for astronomy research, education, and collaborative scientific analysis in immersive VR environments.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience designed for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25057718527199592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nJPYTII664Q7kNvwEmZ13g&_nc_oc=AdkB1bppU4uffPNDZqEoff4Hnyol7xlg3fvsQ_9xCfTkOlPpgz1L1vkUI_DgjNrTx4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs2f7uL770_T5NxaN_2SEHr7_JBiXxoosbNiFYXgacxbA&oe=699AF041"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_categor
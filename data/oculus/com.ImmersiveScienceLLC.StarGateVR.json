Q7kNvwFWrbwI&_nc_oc=AdlpJw4BBqVc3qfZsjT-rE5VET5wOCu6yGE5aAvZRg48Tya6XmDkTUP9TOhzK4V2ttk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhqSzn0qqWEyEK5pw8FfaWw6aKD1ZRNBDPYWkYkPwx9Q&oe=69AD6FD7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRiklX7VtmoQ7kNvwGTiCbx&_nc_oc=AdmEl9kMR41LbnKmeg53QmCINECQ0Yoynvko3IlwJlZn6OTAkaOuW7BA7kskya2Q1Gw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMn5NamUcNoF-MPTikS_Zr9UqLAfJJirPdEcSJQvKaFA&oe=69AD6357"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5AYAR15yrgQ7kNvwGCW8W1&_nc_oc=AdlAEfTPBZY0f_Y36TLUt34of2NsrMzikbmjk2fjykeo--1LzrPPCtx_FlUuZaa4foU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3axmB9E8s487hZjhG8hry8CQszOl5EmeiKOKD6a0-hQ&oe=69AD8954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI7nxLO1kqIQ7kNvwE93-UA&_nc_oc=Adl5HL8e26nIn9ZijHprSOzQmbRgHr2mGBzupVFZvPE-ZfDf3b0Im8BuC8NRsKEHNDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfbqvXoWTGL37FqOS2dr9zWFAKO7jUhzBDEArvBZ8F9Q&oe=69AD809C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is a voice-driven VR platform for exploring astronomical data. A built-in AI assistant responds to natural-language voice commands \u2014 query your dataset, cross-match with multi-wavelength archives, or describe a new dataset and have it retrieved from the Gaia Archive automatically.\n\nVisualize stellar data in immersive 3D with real-time catalog enrichment from Gaia DR3, eROSITA, GALEX, 2MASS, WISE, SIMBAD, and MOCA. Map any parameters to the spatial axes, switch between physical coordinates and parameter spaces like the HR diagram, and color points by additional variables.\n\nCollaborators join shared VR sessions with voice communication, co-navigating the same environment and sharing enriched datasets in real time. Import your own data in CSV, VOTable, or FITS formats.\n\nDesigned for researchers, educators, and advanced hobbyists. Identify features and patterns in immersive 3D, then export findings for follow-up with traditional analysis pipelines.\n\nLooking for an educational introduction to 3D star mapping? Try StarGateVR \u2013 Constellations, our entry-level experience for STEM learners and classrooms.", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26144262018545232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1
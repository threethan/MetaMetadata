la8n72FC92FbX8zcGPaIKBYzb0YQ&oe=6A75ED97"}, {"file_name": "OculusScreenshot1702168621.png", "id": "1417106885903761", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222941_1417106889237094_8505880443188676782_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVYwzhf-HL4Q7kNvwFm8duI&_nc_oc=AdqqX7CXEDXVmCoyfDnSyCFoeGx8SPGXaMdl3AHu2r8MgwpVNhRrl5CPaw8Laf8HY3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgm96vnHaSzV0lsbFAFm-rcitEmSUAtWKiIhvQaPeS5g&oe=6A75D3D7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBbRSpNCbLUQ7kNvwFLDzgV&_nc_oc=Ado3e1idSmH_mmmSNaRr4KW9aNQ6_8Ij5OImRz5a5KiydLtqhWjshbyihrcifSlT5sM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAEsHEDbmySwUd1HRo470QN93X9_ta_9EAH2PNSLN0jg&oe=6A75C757"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUxhslE4pLgQ7kNvwECaBw4&_nc_oc=AdpZygNBXwkj-G4CBwKHf_qiKbmNUlC2dKQXokfeybC8wKJRdQ45-Pc_UZzJn7jCflE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEitaTSOzYZFp3U3BJorU5oMDaQcnwjlh3V0VuLOasqKQ&oe=6A75ED54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy9Q85HxK5QQ7kNvwFC3Qeu&_nc_oc=AdplHcdCpM3AY0ZycLpYGYyZ8DNE3D4TELYta3cpB9NbVb6lDtK96lIA6P1B8rWSKnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4KdssqhRPl8vj-aIJUdvnllmDb7WtQwjLivWPJUMyBg&oe=6A75E49C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "**StarGateVR** puts real astronomical data in your hands \u2014 query archives, visualize in 3D, and collaborate in VR on Meta Quest.\n\n**Live archive access:**\n- Query Gaia DR3 directly \u2014 describe a dataset and retrieve it automatically\n- Cross-match with multi-wavelength archives in a single command\n- Integrated: Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n- Map any parameters to spatial axes\n- Switch between physical coordinates, HR diagrams, and custom parameter spaces\n- Color and shade points by additional variables\n\n**Multi-dimensional gating:**\n- Select and filter data interactively in 3D space\n- Isolate populations across parameter dimensions\n\n**Collaboration:**\n- Shared VR sessions with voice communication\n- Enriched datasets sync across all participants\n\n**Your data, your way:**\n- Import CSV, VOTable, or FITS formats\n- Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\n**AI Assistant (Early Adopter):**\n- Voice-controlled \u2014 query datasets and archives by speaking naturally\n- Improves automatically with no app update required\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try ConstellationsVR, our entry-level experience with an AI astronomy guide for STEM learners and classrooms.\n\nNote: StarGateVR is a scientific research tool by Immersive Science LLC. It is not affiliated with the Stargate media franchise or the Stargate AI initiative.\n\n", "short_description": "Explore, analyze, and collaborate on multi-dimensional astronomical data in VR \u2014 query Gaia, SIMBAD, and multi-wavelength archives directly from your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com
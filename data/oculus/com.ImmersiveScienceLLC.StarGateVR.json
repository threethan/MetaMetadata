=00_Af2xffic4vLA-JhM5m9A0XApVvqj78UYBoX6RxdFm1ST3A&oe=69EE1A1C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR represents a breakthrough in astronomical research and collaboration, offering a virtual reality application uniquely designed for the exploration of stars. This innovative tool allows users and their collaborators to immerse themselves in a shared virtual space, where the vastness of the universe is rendered in stunning three-dimensional detail. By leveraging the power of VR technology, StarGateVR provides an unparalleled platform for interactive learning, analysis, and discovery in the field of astronomy.", "short_description": "View, explore, analyze, and collaborate on Gaia star data in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7126747980723255"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1494543572471061"}, {"status": "PUBLISHED", "id": "1528095444681146"}]}, "baseline_offer": {"id": "1494543572471061"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772480700, "status": "PUBLISHED", "id": "1494543572471061"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26667292132908882", "version": "3.5"}, "id": "333513379492481", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26667292132908882"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "Fix: UI panels on left controller now correctly hide when grabbing the Gate for placement.", "created_date": 1776729575, "id": "26667292132908882", "version": "3.5", "version_code": 500, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26667292132908882"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "StarGateVR - Build 498\n\u2022 ASK AI redesigned: Early Access panel is now hidden by default - tap\n  \"ASK AI - Early Access\" to reveal the voice interface.\n\u2022 AI answers now play back reliably and display without stray markdown.\n\u2022 Questions about clusters, UVW, and stellar identification are routed to\n  the AI more accurately; fewer hallucinated answers.\n\u2022 Improved Quest Downloads folder access - CSV, DAT, TSV, TXT, and VOT /\n  VOT.GZ files now surface correctly after granting file permission.\n\u2022 Under-the-hood build/versioning improvements for consistent store builds.", "created_date": 1776663659, "id": "26659786900326072", "version": "3.5", "version_code": 498, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26667292132908882"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "Auto file access permissions added.", "created_date": 1776447732, "id": "26635958962708866", "version": "3.5", "version_code": 497, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26667292132908882"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "Minor UI improvements.", "created_date": 1776444444, "id": "26635502356087860", "version": "3.5", "version_code": 496, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26667292132908882"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "StarGateVR's AI Assistant has been substantially upgraded. Here's what's new:\n\nSmarter AI, better answers\n\n\u2022 Now powered by GPT-5.4 \u2014 OpenAI's flagship model \u2014 delivering significantly more capable and natural responses\n\u2022 Voice interaction with spoken responses \u2014 ask questions and hear answers in VR\n\nDeeper data access\n\n\u2022 Query Gaia DR3, 2MASS, AllWISE, eROSITA, GALEX, and more by voice\n\u2022 Stellar association queries for kinematic analysis and cluster membership\n\u2022 Use the cursor to focus on any star and ask \"tell me about this star\"\n\nMore natural interaction\n\n\u2022 Maintains conversation context for natural follow-up questions\n\u2022 Real-time progress feedback during database queries\n\u2022 Shared AI responses across headsets in collaborative sessions\n\nFree to use \u2014 100 AI queries per day included. Add your own OpenAI API key for unlimited access.\n\nLearn more: www.immsci.com/home/stargatevr/ (http://www.immsci.com/home/stargatevr/)\nQuestions? Contact support@immsci.com", "created_date": 1775351907, "id": "26502446859393411", "version": "3.5", "version_code": 495, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
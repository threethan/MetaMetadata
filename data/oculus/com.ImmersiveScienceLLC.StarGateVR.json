et": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7126747977389922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28064341669870581"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333513379492481"}]}, "change_log": "Fixed: the AI Assistant now re-syncs to your current data when the visible point set changes, so answers always reflect what you have selected. X-ray data retrieval is also about 10x faster through the eROSITA cross-match table.", "created_date": 1786761956, "id": "28053452847626130", "version": "3.5", "version_code": 548, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
7kNvwFR5IwX&_nc_oc=AdlVP1kyznfpk6pbYQGGosKVYYH8wv7HUW8qhdOxaMgMRGw9Dgd45mrd4CbS4MgiXKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOC1fWX_QXiF655ms_3SGsKR3fXvmHcHZ8-TxNx4Nkxw&oe=69B558D7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPTG0W0FchAQ7kNvwGiR9WA&_nc_oc=AdmT39S_1sd2a6br3slLatcOxaIClrWLkKTYVrSY16QNYgXQ1PCvkhPmgUnfolJfwQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-6oPVEvtz_xHNIf5-u4BrfMyEHDsyhVRDUMXKExh6AQ&oe=69B54C57"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WptjWX34vGoQ7kNvwGUtG80&_nc_oc=Adl2h1v1wkya04cfWgVogd-ov0gJIHxbSmOfbBL08tXhDPnktGI7MKV9f9qHyjOyukk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfFHm8S9pllxSW_fi1fZzOpbR02WnTUuauj8PGBCUYpA&oe=69B57254"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agh5mj9UIdQQ7kNvwGkUGKv&_nc_oc=AdlDO6aR2phPaf5o0svk7KEZT3tTe5mUjrRmxt3hxCCagzpqLKFIGbZiTuGve2KV_GI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5vykXXu4UEioCfpxSwfJ7_OR1QM2nx-Qu0ZaxBmpKGw&oe=69B5699C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is a voice-driven VR tool for exploring astronomical data on Meta Quest.\n\n**Voice-controlled AI assistant:**\n- Query your loaded dataset by speaking naturally\n- Cross-match with multi-wavelength archives in a single command\n- Describe a new dataset and have it retrieved from the Gaia Archive automatically\n\n**Integrated archives:** Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n- Map any parameters to spatial axes\n- Switch between physical coordinates, HR diagrams, and custom parameter spaces\n- Color and shade points by additional variables\n\n**Collaboration:**\n- Shared VR sessions with voice communication\n- Enriched datasets sync across all participants\n\n**Your data, your way:**\n- Import CSV, VOTable, or FITS formats\n- Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try **StarGateVR \u2013 Constellations**, our entry-level experience for STEM learners and classrooms.\n", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26177557541882346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/
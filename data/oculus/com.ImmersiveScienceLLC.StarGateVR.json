-2.oculuscdn.com/v/t64.5771-25/39031608_1046096449981750_3965317561878913230_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1JReJRp4IoQ7kNvwFz0VIN&_nc_oc=Adrt1xIAbynodutpDMywGnTSwqZKWOYzNXPrK9ZUO6eJHp3QXLZQKQshPBbAZBoT3FA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTY8hKSOwQ13E104OqFjW5wlOGx8qX1Xr6-QWS3TcDcUQ&oe=6B0B1F57"}, {"file_name": "OculusScreenshot1702168621.png", "id": "1417106885903761", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222941_1417106889237094_8505880443188676782_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YkF36KV3NoQ7kNvwE4bUjb&_nc_oc=AdrTLctHxPusLGFZnOjZA9_xPtybU8HQjyriBkuX_MvkC_Hx9IlsdboGv6ujJFp2A0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTacCWB94H_yaXnCkObQZYX80JNBdVO-iLGrLEEUa1NHg&oe=6B0B3DD7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a4C9LbzpUMQ7kNvwH3Thmt&_nc_oc=AdpX3VFFKZ7Ivygdo3pWO3mpNa34_0xp080p-ZL8K4gydeJrIzW1KaWYXd1q2byMeEg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkJCZbg_VAfyWYPMoWyXaUDQ-bHbOIZ6QEw8jkVcxo2g&oe=6B0B3157"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiF3kqjBPgUQ7kNvwFtJVi7&_nc_oc=Adqxq5m_dKxjmEAK124Y8h1pEUbsZYX7bc8n5LxJ7_nZqe4atCkUhcUXUOScjMbmbnE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRl7_32WrkLt1ahRos_GlB7ohR0W0wrL55FkftqZy0_Fw&oe=6B0B1F14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWKviwfy8XwQ7kNvwFYhTa2&_nc_oc=AdpTHRk4QOopMD1MoW4htEth9uwWgRuOwPzwIuhUJwD5c2s5ADEp0xSyY57AyrZgg0A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSA07GuV0PR3vB5r0cU7LI2IOLCQTtag95W4pHOBFjIfA&oe=6B0B165C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "**StarGateVR** puts astronomical data in your hands \u2014 query archives, visualize in 3D, and collaborate in VR on Meta Quest.\n\n**Live archive access:**\n\u2022 Query Gaia DR3 directly \u2014 describe a dataset and retrieve it live\n\u2022 Cross-match with multi-wavelength archives in a single command\n\u2022 Integrated: Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n\u2022 Map any parameters to spatial axes\n\u2022 Switch between physical coordinates, HR diagrams, and custom parameter spaces\n\u2022 Color and shade points by additional variables\n\n**Multi-dimensional gating:**\n\u2022 Select and filter data interactively in 3D space\n\u2022 Isolate populations across parameter dimensions\n\n**Collaboration:**\n\u2022 Shared VR sessions with voice communication\n\u2022 Enriched datasets sync across all participants\n\n**Your data, your way:**\n\u2022 Import CSV, VOTable, or FITS formats\n\u2022 Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\n**AI Assistant (Early Access):**\n\u2022 Voice-controlled \u2014 query datasets and archives by speaking naturally\n\u2022 Requires internet and Meta sign-in. Improves automatically, no update required.\n\u2022 In development. Feedback welcome: support@immsci.com\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try **ConstellationsVR**, our entry-level experience with an AI astronomy guide for STEM learners.\n\nNote: StarGateVR is a scientific research tool by Immersive Science LLC. It is not affiliated with the Stargate media franchise or the Stargate AI initiative.", "short_description": "Explore, analyze, and collaborate on multi-dimensional astronomical data in VR \u2014 query Gaia, SIMBAD, and multi-wavelength archives directly from your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27892888597015890"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLOQbf5NyiAQ7kNvwEFznxz&_nc_oc=AdrZg5Qf4w_7rGqbCxIJcAxHIHwZSX1mc1B-aDrpMtsLHRCh9sF2lzrzNDSEFOKChr4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMOGdYdvdLdmNs_7P6mK_5CZwqC2T8WwzN7WPSbN_JEw&oe=6B0B3341"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_na
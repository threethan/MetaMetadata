3JCKydjsD5smNogxJRz-HYQbJue0BCgCng&oe=6A8EC1D7"}, {"file_name": "OculusScreenshot1702168621.png", "id": "1417106885903761", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75222941_1417106889237094_8505880443188676782_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-0ZBX85KcsQ7kNvwEZSZY-&_nc_oc=AdorKAw0OfbNDaS5H4ksnIdomN0hWqaqjmH-bzFDcO9t1qZeEY4ZZCpFTe3BTTc-WgU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwBPnIMSX6GGMMv4Ll0waZfUuMDTvgrWOon3pxhhGzpw&oe=6A8EE057"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um015jCfu6EQ7kNvwFaIorE&_nc_oc=AdpLbdLaV_mmJ0vr-2CE6ejRjIojfMGtuX4rRjy7oE9C5i5vyamVP-MYsZvaFLoLa98&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrj1p5uPrNrUY_mFmwiBKOskhH_dZg_Mwr_iNlfpB4DQ&oe=6A8ED3D7"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJK143CAre4Q7kNvwHf1ykU&_nc_oc=AdrZP_WKUbOIHpn2Q8-NaG1wZQ0RdBl_FWwfeUP_64Nsewc39rOy0Vcl3BGsvoRQmzU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWrZAuJS1cwJ1n5i-qfJkXrrU4AFcraZgWMvWM0ciitQ&oe=6A8EC194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTv8lNXQzOwQ7kNvwFzLNPn&_nc_oc=AdqjuPnANv1TKsUBV5ESobiGrloWOvzgGX22kLu_U4cox55jJegJClY4nt9g3uS0zSM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvuCOZUGH4MH7ZWJKu_7GbI2iWnPOdgnibWSj1q5WDHg&oe=6A8EF11C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "**StarGateVR** puts astronomical data in your hands \u2014 query archives, visualize in 3D, and collaborate in VR on Meta Quest.\n\n**Live archive access:**\n\u2022 Query Gaia DR3 directly \u2014 describe a dataset and retrieve it live\n\u2022 Cross-match with multi-wavelength archives in a single command\n\u2022 Integrated: Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n\u2022 Map any parameters to spatial axes\n\u2022 Switch between physical coordinates, HR diagrams, and custom parameter spaces\n\u2022 Color and shade points by additional variables\n\n**Multi-dimensional gating:**\n\u2022 Select and filter data interactively in 3D space\n\u2022 Isolate populations across parameter dimensions\n\n**Collaboration:**\n\u2022 Shared VR sessions with voice communication\n\u2022 Enriched datasets sync across all participants\n\n**Your data, your way:**\n\u2022 Import CSV, VOTable, or FITS formats\n\u2022 Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\n**AI Assistant (Early Access):**\n\u2022 Voice-controlled \u2014 query datasets and archives by speaking naturally\n\u2022 Requires internet and Meta sign-in. Improves automatically, no update required.\n\u2022 In development. Feedback welcome: support@immsci.com\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try **ConstellationsVR**, our entry-level experience with an AI astronomy guide for STEM learners.\n\nNote: StarGateVR is a scientific research tool by Immersive Science LLC. It is not affiliated with the Stargate media franchise or the Stargate AI initiative.", "short_description": "Explore, analyze, and collaborate on multi-dimensional astronomical data in VR \u2014 query Gaia, SIMBAD, and multi-wavelength archives directly from your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27892888597015890"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974469_562871216674605_546280032924196071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpPYYzb8OiIQ7kNvwG7PpvU&_nc_oc=Ado86Lz8oj7YW8pdWU9W5WCVAZPAh47lec_TJd4zawJrFTKdU8PjZCGSP5twRs9F3lc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSv7e_vSO4O_9PuK7obe51ztnZzWP0pT9dkjWFlXZJcw&oe=6A8ED5C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StarGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1709752380, "lastRevision": {"nodes": [{"id": "7126747984056588", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7126747977389922", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": 
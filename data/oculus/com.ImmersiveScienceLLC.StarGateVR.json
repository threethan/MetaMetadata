I3JII1V41OI9xQdA4p_tBd1fqQ&oe=6A0F1897"}, {"file_name": "OculusScreenshot1702168621.png", "id": "1417106885903761", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222941_1417106889237094_8505880443188676782_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEhhkpLAu58Q7kNvwGcMd_Q&_nc_oc=Adqu4Ayp_nIs6TFVipzAAQKFGSu_AKqX1ycCOMXvEsEc4gHiKcdjye95LleMdicfa28&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47WDFkwvgTjtl755aqMCz0T9gE5QFLafg-tIUcbJa8QQ&oe=6A0EFED7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THt9Fpm6DR0Q7kNvwG2rkKy&_nc_oc=Adrnvbioqg6P8sHRCtNcikajfHuvoUPGTB4bbkWlKR2NU-Jfq2klfMuNZZ2CumQck5A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z17aa4l15EQsO_-zlyzHb8P9AADz7PVkn3EROwDn4kw&oe=6A0F2A97"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttDFCKCZ-hQQ7kNvwERdof6&_nc_oc=AdrtT54H8pT1LLupmv-5Hz8UnyF9N7oKGGoxKhKYQ0pGPgLoorN5WoHbQ8lSvy1DdQ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MokqWSBnxkP3rk521Srp2rHpWFmXq_mP7n50yhnzOmg&oe=6A0F1854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv9O4byp_UgQ7kNvwEXgnxs&_nc_oc=AdoP4bf_HfYctk1nWRsvLTZ-S-6xOdm__gJWujm27xgI0QwH8t9rUL_Ty1gvmE8xLYQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SH0DgfdHcdNYEv2UlmkX62Za1Qbem95Vab5fvgEeS8w&oe=6A0F0F9C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is a voice-driven VR tool for exploring astronomical data on Meta Quest.\n\n**Voice-controlled AI assistant:**\n- Query your loaded dataset by speaking naturally\n- Cross-match with multi-wavelength archives in a single command\n- Describe a new dataset and have it retrieved from the Gaia Archive automatically\n- AI features improve automatically with no app update required\n\n**Integrated archives:** Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n- Map any parameters to spatial axes\n- Switch between physical coordinates, HR diagrams, and custom parameter spaces\n- Color and shade points by additional variables\n\n**Collaboration:**\n- Shared VR sessions with voice communication\n- Enriched datasets sync across all participants\n\n**Your data, your way:**\n- Import CSV, VOTable, or FITS formats\n- Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try **ConstellationsVR**, our entry-level experience with an AI astronomy guide for STEM learners and classrooms.\n\n**Note:** StarGateVR is a scientific research tool by Immersive Science LLC. It is not affiliated with the Stargate media franchise or the Stargate AI initiative.\n", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", 
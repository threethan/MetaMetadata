7kNvwEhaaej&_nc_oc=AdnXhhCD3N-Vout-XPEDARPnlGm8bpbflnjWtDW9LbsMJo5lYOZ7pCiXdYDI9q2zPoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWi_zD21Ph2rOwi-qQqNdoj1lgKfJ0ahrEpsZodSMHEg&oe=69B012D7"}, {"file_name": "OculusScreenshot1702169640.png", "id": "1024146142213818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_1024146145547151_3805722331130364725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4acWkRZYBwQ7kNvwEoGbCP&_nc_oc=AdnBkUE307vQ56e87urJ_VegLfa5eMoDPkO5ERvFPLGcPocbGlrg2Ukw8OPmcsR_iA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6PT0ohufvKyKjpA3me1I5CiBYWM5aYg2OOZbtosKtHg&oe=69B00657"}, {"file_name": "OculusScreenshot1702168716.png", "id": "1045546456768821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031557_1045546460102154_8869584294705848419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT79z5j1phgQ7kNvwGIH79I&_nc_oc=Adnq8iL5hEejM9bv7dQX7MM-nIsoYwbPMi7gKq94lCWP_8eI5ki7JpTYIb-ZdMw9TaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaDB0Uv_QvnO50ckHcKlxOE0-9FiWlscfDYwFZCVgxaw&oe=69AFF414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusScreenshot1702169579.png", "id": "1421996451722456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974657_1421996455055789_5575213174514540843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI7nxLO1kqIQ7kNvwEnBzY9&_nc_oc=Adkik5-jskDQINy_tGyhdJUHGRRLkLYfShzcAHqzuPZbvU2WLv7s9ntTxNClrV7H7IE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyR6ccoWjPCTwwOqNBgU9oHjcNAdafh1cowoj26Iw2HzQ&oe=69B0239C"}, "display_name": "StarGateVR", "keywords": [], "long_description": "StarGateVR is a voice-driven VR tool for exploring astronomical data on Meta Quest.\n\n**Voice-controlled AI assistant:**\n- Query your loaded dataset by speaking naturally\n- Cross-match with multi-wavelength archives in a single command\n- Describe a new dataset and have it retrieved from the Gaia Archive automatically\n\n**Integrated archives:** Gaia DR3 \u00b7 eROSITA \u00b7 GALEX \u00b7 2MASS \u00b7 WISE \u00b7 SIMBAD \u00b7 MOCA\n\n**3D visualization:**\n- Map any parameters to spatial axes\n- Switch between physical coordinates, HR diagrams, and custom parameter spaces\n- Color and shade points by additional variables\n\n**Collaboration:**\n- Shared VR sessions with voice communication\n- Enriched datasets sync across all participants\n\n**Your data, your way:**\n- Import CSV, VOTable, or FITS formats\n- Export findings for follow-up in TOPCAT, astropy, or your own pipelines\n\nDesigned for researchers, educators, and advanced hobbyists.\n\nLooking for an educational introduction to 3D star mapping? Try **StarGateVR \u2013 Constellations**, our entry-level experience for STEM learners and classrooms.\n", "short_description": "Use VR to view, explore, analyze, and collaborate on multi-parameter Gaia Archive star data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26177557541882346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/
esv2yyiMnE-L6iDYUWW4PleaaYSacDRYrYnQ4cG55pvOzhr407DKA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Li3IVSgKuQKHhmnaTAwys-h_m93ZUjhTucp4Wora6gA&oe=6A2C1A28"}, {"file_name": "Main_Custom..._26.01.2025_16-55-54.png", "id": "1519079598762859", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391986_1519079602096192_988834220899970055_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5KO9s6BGMoQ7kNvwHFDNWB&_nc_oc=AdryneF7zcfOA_sjfIYhve3VCkCBgYa6dsABXZHvBvZWXwvmIpBF4wPG3wt39K0x7Co&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sqkFZ_Y21UcbCI1GbvrLxTR-BPh9sFxLPx9I_VzQ39w&oe=6A2C2BFC"}, {"file_name": "Main_Custom..._26.01.2025_16-55-01.png", "id": "1123965539215747", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393887_1123965542549080_5172870853261199655_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpRTxIJW2FYQ7kNvwGLj7K1&_nc_oc=AdoepjwLIWB_gA4bNr-sO_wY4XVnGBByajKSqRdZHHDFCcQX28h2fExDGDrNvVIQMnc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xsR3zYFwAKINdfU7nmeg7Au0g9JQLWGuS14FmmV9BBA&oe=6A2C1715"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Monkes", "keywords": [], "long_description": "In Primal Monkes, you're not just playing tag\u2014you're fighting to survive in a relentless game of life and death. The pitch-black world around you is teeming with terrifying, primal monsters, lurking just out of sight, always on the hunt. Every shadow feels alive, every noise sends chills down your spine, and every step could bring you closer to danger. Your only chance lies in your speed, instincts, and ability to outsmart your pursuers. Stay alert, keep moving, and use your wits to evade capture. It\u2019s a pulse-pounding game of cat and mouse, where the stakes are nothing less than your survival. Can you navigate the treacherous darkness and survive until dawn, or will you become the prey in this harrowing nightmare?", "short_description": "In Primal Monkes, you're not just playing tag\u2014you're running for your life. The darkness hides terrifying, primal monsters that are always hunting you. Your only chance is to move fast, stay alert, and avoid getting caught. It\u2019s a constant game of cat and mouse, where every sound could be your last. Can you survive the night, or will you be the next to fall?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/c255961b-582d-4d68-a575-f046b4ca14b5", "developer_terms_of_service_url": null, "publisher_name": "Galaxy Productions", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1qqMdBSBGyJYySxC677hIIwHZUi_GCZwJtabQX9XJMNg/edit?usp=sharing%5C", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28487209967589984"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187794676050262"}]}, "baseline_offer": {"id": "1187794676050262"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738196100, "status": "PUBLISHED", "id": "1187794676050262"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28605623095748670", "version": "1.2.5"}, "id": "1565418504151377", "channel_name": "LIVE"}]}, "is_for_oculus_keys_
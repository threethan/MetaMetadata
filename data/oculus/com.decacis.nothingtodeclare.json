ttps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294243_755937455479399_1665848571294266799_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fILHFPbgxv0Q7kNvwH6SP5R&_nc_oc=Ado3eLO3ZIuGdSKdTIuCZtkLstZD1PD0WqW7T9vJIW7oXRu41UEtmfD6qbkp_wa-gzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnzVnM4da_TN8ik77w6cZg1WF-nb38L-ngcxQOXLmKog&oe=6B007B9A"}, {"file_name": "screenshot_4.png", "id": "831169071382613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196226_831169074715946_1086214916508556949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOQRJIhc3H0Q7kNvwH310CG&_nc_oc=AdptpyUg1sYLAeVo-Drniw-8dA1mHkf2uwwz3MqEreFITYFigO9_FYi-0_LuMTIY37k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUxTqN_trICbnLyi17Z5wFgJmXtk9sRFCrCT3i0MY1HA&oe=6B005D3F"}, {"file_name": "screenshot_5.png", "id": "819207169426657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982542_819207172759990_3216667851803813049_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0chQll6a7UQ7kNvwGSV_-5&_nc_oc=Ado4leqf56HUS7Pmy3kyDNXj_RhVqXgun_060P1J6w8dHigYsGdNaGsfR_-d7f10MKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJhhS_uEviroKEAKNnGW0gZtDdwgfdpujun8SeVmLceQ&oe=6B007964"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nothing to Declare DEMO", "keywords": [], "long_description": "Congratulations! You just got a job at the Populistan International Airport, but this is not your usual airport\u2026 You'll have to prove that you are capable of being a security agent at this prestigious, absolutely 0% corrupt airport.\n\nYour job will consist of checking passports, making sure people are who they say they are and don't forge documentation, pat down people if you need to, find contraband and above all, follow the orders from your superior.\n\nNothing to Declare focuses on accessibility, and as such, you can play with one or two controllers. Both controllers are interchangeable to provide the best experience for every player!", "short_description": "Nothing to Declare is a story-driven game with multiple endings, where you play as a security agent in the Populistan International Airport. Your job is simple: check passports, frisk people, find contraband, make sure documents are in order and most important, follow the orders of your superior."}]}, "developer_name": "Decacis, LLC", "developer_privacy_policy_url": "https://nothingtodeclare.decacis.com/privacy-policy/nothing-to-declare/", "developer_terms_of_service_url": null, "publisher_name": "Decacis, LLC", "support_website_url": null, "website_url": "https://nothingtodeclare.decacis.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4834497869985303"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "813288149981680"}]}, "baseline_offer": {"id": "813288149981680"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1667523600, "status": "PUBLISHED", "id": "813288149981680"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6164926773554777", "version": "DEMO_u49_230430"}, "id": "2247667695385635", "channel_name": "LIVE"}]}, "is_for_oculus_keys
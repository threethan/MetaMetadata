NZYIzpyB5lCwILVEq8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afth4fM60R6rxFaOUqtxwxRsww3Gkbj79cQ2EtqLHcwCfw&oe=69A588DA"}, {"file_name": "screenshot_4.png", "id": "831169071382613", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196226_831169074715946_1086214916508556949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbGsaVZSaNoQ7kNvwE58hWP&_nc_oc=AdkLJBI9NSu1Egdxb2AEiQpTjBfCO9VcmQjxywZ0EtTW2F_XbnuU4lKKQfMGxKyPUrc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuXYUU85zIoodZUmW4rLPKbUSlPPKfj1sj4gogoQhwcjA&oe=69A56A7F"}, {"file_name": "screenshot_5.png", "id": "819207169426657", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982542_819207172759990_3216667851803813049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CghxmW9g2AQQ7kNvwFYz-jh&_nc_oc=AdmIqlBTBm92t7pZ5FeZU6x5wde_CSK-G3Qf4aHFrQir4S_iL7p-olxwqZOjEoS5zE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfusLMZ2nmGCEXh2rz5a5L1-qnlQcN1lCyfIHKGXdloJgQ&oe=69A586A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb_2560x1440.png", "id": "1998864696971128", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003243_1998864700304461_6892444997371386519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HktE39Oy6YQ7kNvwEgXlRO&_nc_oc=AdkcqA3YcvVLH0eXEfuB1bIiQVBsSb43A8uvsXnwIB1v6peP6Umx9VCK8v2KRWmkFr4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvUX_uqORanAdfdQsmPpIUS6bOwMDqcYOWhGfqQmftfPQ&oe=69A583C6"}, "display_name": "Nothing to Declare DEMO", "keywords": ["airport", "security", "border", "declare", "customs"], "long_description": "Congratulations! You just got a job at the Populistan International Airport, but this is not your usual airport\u2026 You'll have to prove that you are capable of being a security agent at this prestigious, absolutely 0% corrupt airport.\n\nYour job will consist of checking passports, making sure people are who they say they are and don't forge documentation, pat down people if you need to, find contraband and above all, follow the orders from your superior.\n\nNothing to Declare focuses on accessibility, and as such, you can play with one or two controllers. Both controllers are interchangeable to provide the best experience for every player!", "short_description": "Nothing to Declare is a story-driven game with multiple endings, where you play as a security agent in the Populistan International Airport. Your job is simple: check passports, frisk people, find contraband, make sure documents are in order and most important, follow the orders of your superior."}]}, "developer_name": "Decacis, LLC", "developer_privacy_policy_url": "https://nothingtodeclare.decacis.com/privacy-policy/nothing-to-declare/", "developer_terms_of_service_url": null, "publisher_name": "Decacis, LLC", "support_website_url": null, "website_url": "https://nothingtodeclare.decacis.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8093227344058034"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035336_1359448581251053_8245519270665912291_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrTowwE1fccQ7kNvwH70rub&_nc_oc=AdkihDLgyKeBaqY34xGwP_hxseFIaz-96RjjtamUQupQQAR5VSo9AaepvYAPv-3PeNg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=0
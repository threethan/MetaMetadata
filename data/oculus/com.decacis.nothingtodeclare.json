NvwG8ZCdV&_nc_oc=AdpRAoKhz5Gn0tiSKNuuW-4sm__YxHOp_qamKnUVqvLIiG47wYhd--25j1T-jubgXqc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YWuDVTzNwb00YDdwW7Rd9dupO7n9iNAeVNM0L84rvRg&oe=69F4BCBF"}, {"file_name": "screenshot_5.png", "id": "819207169426657", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982542_819207172759990_3216667851803813049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8YOCso7-cUQ7kNvwF3uatt&_nc_oc=AdqOp9bo4bLRE_utfmDl3zzQgo4djO-8cSvJK8NZbBKV_1VBpoNGhresuVo9MASh8e4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OYmdzZThKaE_7MXuGMocancFPf2v1DB8klSE-x6PMHQ&oe=69F4A0A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nothing to Declare DEMO", "keywords": [], "long_description": "Congratulations! You just got a job at the Populistan International Airport, but this is not your usual airport\u2026 You'll have to prove that you are capable of being a security agent at this prestigious, absolutely 0% corrupt airport.\n\nYour job will consist of checking passports, making sure people are who they say they are and don't forge documentation, pat down people if you need to, find contraband and above all, follow the orders from your superior.\n\nNothing to Declare focuses on accessibility, and as such, you can play with one or two controllers. Both controllers are interchangeable to provide the best experience for every player!", "short_description": "Nothing to Declare is a story-driven game with multiple endings, where you play as a security agent in the Populistan International Airport. Your job is simple: check passports, frisk people, find contraband, make sure documents are in order and most important, follow the orders of your superior."}]}, "developer_name": "Decacis, LLC", "developer_privacy_policy_url": "https://nothingtodeclare.decacis.com/privacy-policy/nothing-to-declare/", "developer_terms_of_service_url": null, "publisher_name": "Decacis, LLC", "support_website_u
g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbmhlQTW3h0Q7kNvwGhbAGj&_nc_oc=Ado31YlGgyUK35MIIKsPKN3G-esWCJNUW8aOrJ5Pkh9yDwEZwa__IujWfXcp6z5VFcg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pSKut_CbpuEfxj09yfCCUePJT4bqmSYDsyDTL1zFBPg&oe=6A11A3DA"}, {"file_name": "screenshot_4.png", "id": "831169071382613", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75196226_831169074715946_1086214916508556949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw20Hqun4rMQ7kNvwGL-1Ip&_nc_oc=AdpZUirgKTyVMNJwtXwjRQUXpxn9wC9UzXdIZb-jRUhxcSCwLPqwnfpbUy6_K1EMooE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iyXQVTtI9yED4q3_5b7sdrBZxIsEOWofo6NCz4Kaz7A&oe=6A11BDBF"}, {"file_name": "screenshot_5.png", "id": "819207169426657", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982542_819207172759990_3216667851803813049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i5jW_oT9OUQ7kNvwG9N464&_nc_oc=AdpeRv0a1QH2mtndot0KewP67YUhFcgmlPtZI8KFkeVDIA2DiGmNCyg-FtZ0_7dYf0I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WEms5XGqdUfiaUIFJp2dTaO8bOOuLAAK4tD4ZRya4hA&oe=6A11A1A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb_2560x1440.png", "id": "1998864696971128", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003243_1998864700304461_6892444997371386519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7QZWQpZDikQ7kNvwFKv4uL&_nc_oc=Ado9CWV9cQuGHTKNQFgKuAlIb4_iWwf58OU6ru_Hh7wYn2rxV2MiS5Gz_PVKqG51jq0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o9BEWhScjn1mGyMVXfW37_AaTPOOo5zd0heX7urJFIw&oe=6A119EC6"}, "display_name": "Nothing to Declare DEMO", "keywords": ["airport", "security", "border", "declare", "customs"], "long_description": "Congratulations! You just got a job at the Populistan International Airport, but this is not your usual airport\u2026 You'll have to prove that you are capable of being a security agent at this prestigious, absolutely 0% corrupt airport.\n\nYour job will consist of checking passports, making sure people are who they say they are and don't forge documentation, pat down people if you need to, find contraband and above all, follow the orders from your superior.\n\nNothing to Declare focuses on accessibility, and as such, you can play with one or two controllers. Both controllers are interchangeable to provide the best experience for every player!", "short_description": "Nothing to Declare is a story-driven game with multiple endings, where you play as a security agent in the Populistan International Airport. Your job is simple: check passports, frisk people, find contraband, make sure documents are in order and most important, follow the orders of your superior."}]}, "developer_name": "Decacis, LLC", "developer_privacy_policy_url": "https://nothingtodeclare.decacis.com/privacy-policy/nothing-to-declare/", "developer_terms_of_service_url": null, "publisher_name": "Decacis, LLC", "support_website_url": null, "website_url": "https://nothingtodeclare.decacis.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8093227344058034"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035336_1359448581251053_8245519270665912291_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb
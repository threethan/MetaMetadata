NvwGyG2_u&_nc_oc=AdopKrHF9y7q5rhUGHsX1uNaijqig9Ae-bA0geFm3ie0sNeyltZF09Q3B1R0YsIeQOM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nd_c7WMmICwV3TIYxzRFQr8rTqEHohq5wARbqQVK2kw&oe=69E78DBF"}, {"file_name": "screenshot_5.png", "id": "819207169426657", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982542_819207172759990_3216667851803813049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyGEa1_D2qMQ7kNvwEIEx8x&_nc_oc=AdpGJc6rWw13Tz0K_zX4rOjTumVH4V1ISoJCpNYgOZcFpdt8jsiGz6nTjDILjzTmdKs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lZS8GOnyBJ5hSPCBEGouDExdiYkDD47hdXAmRSyg0rQ&oe=69E771A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nothing to Declare DEMO", "keywords": [], "long_description": "Congratulations! You just got a job at the Populistan International Airport, but this is not your usual airport\u2026 You'll have to prove that you are capable of being a security agent at this prestigious, absolutely 0% corrupt airport.\n\nYour job will consist of checking passports, making sure people are who they say they are and don't forge documentation, pat down people if you need to, find contraband and above all, follow the orders from your superior.\n\nNothing to Declare focuses on accessibility, and as such, you can play with one or two controllers. Both controllers are interchangeable to provide the best experience for every player!", "short_description": "Nothing to Declare is a story-driven game with multiple endings, where you play as a security agent in the Populistan International Airport. Your job is simple: check passports, frisk people, find contraband, make sure documents are in order and most important, follow the orders of your superior."}]}, "developer_name": "Decacis, LLC", "developer_privacy_policy_url": "https://nothingtodeclare.decacis.com/privacy-policy/nothing-to-declare/", "developer_terms_of_service_url": null, "publisher_name": "Decacis, LLC", "support_website_u
NvwESkP9M&_nc_oc=AdpWWVTW9IYUcp-NzTjMrXNIcN1yvB6ImUmz9f9QTQt5zboFqg76E9yTr_unfxZe_hI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0j4C4hhIAgstMjmK0VedDuQvYgoObXu6UBBj475aLgQ&oe=6AB3E63F"}, {"file_name": "screenshot_5.png", "id": "819207169426657", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_819207172759990_3216667851803813049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-N4fhKugeoQ7kNvwHemo3S&_nc_oc=AdoQGAK0trCSRT7zZW4QiS1BnBMmTibQqC2QKeK-SS6NyISOsfW0KkDbOEvshqHjHOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgBEVSjwoIFOk1F6kWoJCeFm9U7r3hGyU9KjqgmJ8WTw&oe=6AB3CA24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nothing to Declare DEMO", "keywords": [], "long_description": "Congratulations! You just got a job at the Populistan International Airport, but this is not your usual airport\u2026 You'll have to prove that you are capable of being a security agent at this prestigious, absolutely 0% corrupt airport.\n\nYour job will consist of checking passports, making sure people are who they say they are and don't forge documentation, pat down people if you need to, find contraband and above all, follow the orders from your superior.\n\nNothing to Declare focuses on accessibility, and as such, you can play with one or two controllers. Both controllers are interchangeable to provide the best experience for every player!", "short_description": "Nothing to Declare is a story-driven game with multiple endings, where you play as a security agent in the Populistan International Airport. Your job is simple: check passports, frisk people, find contraband, make sure documents are in order and most important, follow the orders of your superior."}]}, "developer_name": "Decacis, LLC", "developer_privacy_policy_url": "https://nothingtodeclare.decacis.com/privacy-policy/nothing-to-declare/", "developer_terms_of_service_url": null, "publisher_name": "Decacis, LLC", "support_website_u
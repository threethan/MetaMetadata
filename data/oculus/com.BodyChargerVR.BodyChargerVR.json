4783_6974058498067562148_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQqhOKfzQ78Q7kNvwE1wzgB&_nc_oc=AdrWE1yNZHGlQW4URZJobj0IQKONEUzqkcSK4RYgWVfLKXuINw0US_kUwSZvCVEnLlY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvTWDuFxEmrlt77NJVM35FKDhrkl26p6rOlGn69ASqOA&oe=6B09C5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440kongchangjing.png", "id": "3040693376250291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207234_3040693379583624_2685610695742636474_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPpLMXZCp5kQ7kNvwH3w1RF&_nc_oc=AdohI0VG9Umggr70IeIVBM4POCogBSZcVPPbENQ7CTWYJu0PvgzJ6pXyHaPFIach02w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFMumhRgl9rV_Sew1uiEYl9DLzfFredxOv2mC49Tpyzw&oe=6B09BC26"}, "display_name": "Body Charger VR", "keywords": [], "long_description": "1.  Song list: \nhttp://www.cqplanb.com/ccc/Bodycharger-songlist.html\n\n2.  We use microphone to react with rhythm, So If you refuse to open microphone permissions when first open app,there won't be reaction with rhythm. Never mind App still can work.\n\n3.  Make sure to review your surroundings and clear any obstacles in your play area before starting this game.\n\n4. You 'd better have sweat proof sleeve on your Quest headset, you will sweat a lot happily when playing this.\n\n5.  Due to Copyright of music, we don't include music in this app. But we support custom import .mp3 into Quest and play. See how to https://www.youtube.com/watch?v=QfIdWHGalTY\n\n6.  If you can't keep up with the rhythm at first, please be patience to practice more times and also click 0.75X to slow down.\n\n7.  If there are songs you wonder which are not in the list, Please don't hesitate to contact us immediately via E-Mail: 408077086@qq.com\n", "short_description": "Body Charger VR  is an zumba VR app on Oculus Quest. Also friendly to beginners. We can see clearly virtual characters do by your side with pop songs.  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cqplanb.com/ccc/Body_charger_VR.txt", "developer_terms_of_service_url": null, "publisher_name": "jijia", "support_website_url": null, "website_url": "http://www.023d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702579937565199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031414_535343271162433_7066741113254913407_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ythUpGuRUIwQ7kNvwFisyr0&_nc_oc=AdrjWRFPwCqq4VSqD7ksTrLuw4pw2iixZ5raik7Otu6tkpg2TGsqKIUHuh5BAD-tIPY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWaRZknyPpX4bCCL0YBSy9cV2C5X5wN0jUiBy8zdRbdA&oe=6B09C5E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Body Charger VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1637609703, "lastRevision": {"nodes": [{"id": "340409561197639", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4711482972209957", "is_first_part
cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElKLsFbQipcQ7kNvwGGcvkz&_nc_oc=AdrlYM6Zf-IWF4yKsYm5t7IltzUFeGrUeGR5ZeNJ0e_D_NAEoC-rueyUCT14JNF-5aQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83zU-LEuIUhIK4C8bSSbfj7p_CDULRFKA7kUvyMKfJ4A&oe=6A22FCD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1213257256629908", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75221329_1213257259963241_4170333879234760385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC1WIfQyeEEQ7kNvwF7-eUy&_nc_oc=Adq_GMzdfjFMzNdnmsN2LvNKqCgj9cPmD7mscjNLCiG2wHlnS-2IgYEobQvAruGhswU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q0KQojak_WVzm0LfPJeUSmds5RlLD7nshzCdq6C0EMA&oe=6A22FE0B"}, "display_name": "Arcade Ranger", "keywords": ["Casual", "Simulation", "Social", "Action", "sandbox"], "long_description": "Welcome to the wild world of Arcade Ranger! Get ready to squad up, customize every corner of your arcade, and bring the heat in this epic multiplayer adventure. Are you ready to face the craziest arcade battles and prove you\u2019re the GOAT Arcade Ranger? Step up and show the Game Over Gang who\u2019s in charge!\n\n\ud83c\udf0e **Enter Mixed Reality**- Step Into Your Arcade! Blend the real and virtual worlds in thrilling Mixed Reality!\n{1501489483835742}\n\ud83d\udee0 **Build and Customize Your Dream Arcade!** Arrange cabinets, change looks, hang posters\u2014it\u2019s your arcade, your rules!\n{1016542880248136}\n\n\ud83d\udc6b **Multiplayer Madness** \u2013 Team Up and Get Messy! Team up with friends! Fix, clean, and fight off the Game Over Gang. Cooperation and chaos!\n{337324279470637}\n\ud83d\udd25 **Arcade Mayhem** \u2013 Fix, Clean, and Defend Your Turf!\n{923206586326338}\n\ud83d\ude80 **Wacky Shenanigans** - Shoot, Throw, and Go Wild! Feeling stressed? Let loose! Shoot, throw, and have a blast!\n{561356076408815}\n\n**Key Features**\n\n- Build your dream arcade\u2014place machines, posters, and pick the soundtrack.\n\n- Team up with friends\u2014defend and have fun together.\n\n- Build, clean, and fight\u2014save your arcade from chaos.\n\n- Go wild\u2014resize, throw, and have fun.\n\n- Rise up\u2014be the ultimate Arcade Ranger.", "short_description": "Welcome to the wild world of Arcade Ranger! Get ready to squad up, customize every corner of your arcade, and bring the heat in this epic multiplayer adventure. Are you ready to face the craziest arcade battles and prove you\u2019re the GOAT Arcade Ranger? Step up and show the Game Over Gang who\u2019s in charge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://quantaar.com/privacy-policy/", "developer_terms_of_service_url": "https://www.pumpkinvr.com/terms", "publisher_name": "Pumpkin VR", "support_website_url": null, "website_url": "http://www.pumpkinvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "fr", "de", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8720780204652797"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1634556310820274"}, {"status": "PUBLISHED", "id": "1088846402892730"}, {"status": "PUBLISHED", "id": "919589477244338"}, {"status": "PUBLISHED", "id": "1154950699681463"}, {"status": "PUBLISHED", "id": "1199132724505724"}]}, "baseline_offer": {"
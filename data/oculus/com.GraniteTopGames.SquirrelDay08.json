102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdp8ei_082IQ7kNvwHsi0G9&_nc_oc=Adoh-LeEtEC55Fxf1Cct1XPh7yB1ozK7QL-qC9dvO2W7PNLEX6eP2Rinh4-BsXhzaVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMTvj-qRMC8TpESBH_wUPv5IDyH54rWb6SiJpY2f5oFw&oe=6A689FCD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNkGuJ2P8hkQ7kNvwFE3pp8&_nc_oc=Adq8Ue7EneGw3Yypi4zvV-rYZ8S9fXifnnUjUVu3XLJpKKsf3VmkgPtpbkG0frJK6jQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIMPxhhyPurkz6shSK4lmOZRjXDS01T41i-8yT9yyJ9g&oe=6A68AFD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TCwPSvj6MMQ7kNvwFaZsJ7&_nc_oc=AdothUBzYJGXehKfwQkIjx44k8Dp0vii8RuXOUk10fZpTjuB-MDl0JR4VhxIqCgzgG8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5TOw3KvRtTvA5V34Qqaq4ngTxlIqqXT5L86euoZFrJA&oe=6A68B75E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbBgPY3b-C8Q7kNvwHE6WPq&_nc_oc=AdrEmYbkgw_fYuWeq7pwQtGdckbxCztTErL9bTr15GtO2ucKmqj0xsgXwc_Gojuy_2g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_SKIKRmwRdu2hON2eB3LxrtfR4IJj42lcixFYls_jGw&oe=6A68A784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1m7IzlBhE0Q7kNvwFlDEkL&_nc_oc=AdpkINMLeinHS3xOD-UjKLs4gJC6waDP9DhawGJY3fxhhrTWySjwF1mHxKEVLdrEuVY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPPsqwA4AyGiicPHEXXndTHqpZHmvUlHGri1MlamNk7g&oe=6A68B5B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdcen8hE7LQQ7kNvwELN1Sk&_nc_oc=AdqNVgpFouhhRHiN5W_jbt0-MrTJnTQgtRRNcC23ZQcxARuVRujHm9i__EK7NvRIha0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBkzufkpv0Qv1u2u5VawGQQj5brpEX6CxqW5hdji6JBA&oe=6AB3C54D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIMbtH6epHwQ7kNvwGeEOdx&_nc_oc=AdpJsdhZlhqMwYezBTANZ-AXBrr7_KoAASMl2YDdnalB2SywLLoAUrpA6MhRC9PngfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_n3pkc1zExbwlUrYnJDRDl9ObLnL9GTMl9HbEOgMz0w&oe=6AB3D555"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izktOvjNWMkQ7kNvwE_TcgL&_nc_oc=AdpCc75vpAFJkC9ySLyz4aR8FJio3uUetnBr7aJ6sHmP1sWohRTTkP94bwnXRoiPDZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPzBn2Ga16tX0CtWKJszI8XexdRIKtKiEiMegdES_UOA&oe=6AB3DCDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYElaOrlAHUQ7kNvwEBTwms&_nc_oc=AdoggL0kAjwgBFQID8t7NUI_OQyuCgfGZ_tQlbquRbVEaqi3Shxc9gBkTI3uHYTSV0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4mdXZA-wWgKx36MVltp3_YeK6DKPVSGWM8xQ8zVPDTw&oe=6AB3CD04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT07zJihLnQQ7kNvwF4bp_-&_nc_oc=Adovtz7r9tmbl7A6CqGG7tYF_TN0cTddBFZdSNu2rpY0WhBS_D5x_yE8taz8kY5BbRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7JQgXTUuQ70NvNcMDn1-2oFWwQa5k2d-wjxkTmCcsRA&oe=6AB3DB35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
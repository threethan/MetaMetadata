102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBBtNZiCnr4Q7kNvwFi9Hgp&_nc_oc=AdqhuqGFtCledeTgTz3Iy-4WDGT4FCvlz-Ob3ic654abpzg0oEu0mxT4lmc6S4R7xLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTokveICiq-miTSZ_q085b-8d-XWHO7aa2cWFCR5pEyyA&oe=6AEF510D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48JkR6me4vgQ7kNvwHwFqQk&_nc_oc=AdprW7i-9agkZTZQrdsRupuyqPzOFVyyV7h6r5e4ctZzuK88JZ2vipPavOn2E6oPBPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsj6p247Zva2YQlr05QAJRKqdgWEkOi_KinBR2Tw_nig&oe=6AEF6115"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6HWvAfuqaMQ7kNvwFeN4i5&_nc_oc=AdrbB-XgAJEL5Fb8sLyWsVDaDCpGZTn2v1anVImAvG8W2QzPrw5vrKDAb5wfUXVZuHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR86SwRIQot_CFxn2nUnrqi7kuTSb001_Nb1FuO-luKig&oe=6AEF305E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf5dxaT3RTAQ7kNvwEWZ8tb&_nc_oc=Adrel97w1rWuW_WQ3f-5rtimn08TUhjKCdWaPEIf-lXVGgTAyhAAe3PJKnD-t1vNwC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDzJsFvpHoAAYBgUnkdG7B31zKwx4XRFCGcKcgnry1wA&oe=6AEF58C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3UfvR7wvLoQ7kNvwFIKW6r&_nc_oc=AdrQh-Zdg6mWuQGZBLsfAgo7DZA9PU_Y-1va05cD46yimzpuktF6wzeH3zXVuhnwm7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7XYvI00tQB_DjhTniGgXCMd7aNB-MgRePaJl6UTtOfQ&oe=6AEF66F5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjOsaFW6uMYQ7kNvwGMBMV6&_nc_oc=AdrCTz-M7sP8F8Oq6rONq7DCWd4FHp3_JCSEBOJSoExlrv0q7Wclz5Dd6U0w919Ayoo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97et9Tn1mlXqq8fIdi_zm1rRDvMykTQX-WYiL8z_zRzA&oe=6A2C330D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG22z6evLlYQ7kNvwFx3Ngy&_nc_oc=AdrEx1BdRcF0psMNuSZuk4leYs2GTGRdXqz-q8DJoO91gRh8jROyqmLa-mpmZLBKnyQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ih1VhGYamLwYsoogF6VDnAYxB9qyre7lk-G2q5gee3w&oe=6A2C0AD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TMyULvPS7kQ7kNvwH1ZEjI&_nc_oc=AdoFQjJonrgK44Q-WFuEeieSRkPCSbAoBREcc7A_XPloACxpX-wH--5N5CoPwgHOJG8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sg7KqZLT874lBewHbsFz9B_6OBNvaj81qCTCQ3pVckQ&oe=6A2C125E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac3kATwRx_sQ7kNvwH6TncD&_nc_oc=Adq4LA_H_onkXoryRemQ2ZW6DrAgD2yhznL1FGjQbBtQkIOQ41IkVNFc3iCfsIWEl-4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H2tiyRZGFSTibzyqFNY4-qYZ5SOVEtfgyHLuBKi3PxQ&oe=6A2C0284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jX95272Bw0Q7kNvwFrdMds&_nc_oc=Adp097_g0sb5Lr2VAKUmTlNFu_9hIkF5hxQ4OU5j16aXdbCcRqEZWfQ6einZ6YtEA7w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af904UPxrk5nMm63w7HlBBaYyqZdksKQSByyeUdteIR9Lw&oe=6A2C10B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
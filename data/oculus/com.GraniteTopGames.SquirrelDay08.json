102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhU4PWWrMSsQ7kNvwGUUl4G&_nc_oc=AdodsAjcFp6aYNJdlx6y60T6EwhKVju75btLjnT3WvR14P-0Gt0hrhsqfGF9A8Jf0Nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUbXkhy8iXDmn74O3HAyJIbpJqUbdBpkYvra3FccOGKA&oe=6ACA670D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBbrypsWkZQQ7kNvwEAv_nV&_nc_oc=Adri76nnmaC5dqUy7WCrk1JR665SUkPy3eRbMgcs8F3oOHYvBXkWzeNVkNjGqouzJzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqHHfQt-EN_ky4DGj09gkwD-yCjnaCI509NbTh0xDQKw&oe=6ACA7715"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzfxwRXmCyYQ7kNvwEHF05z&_nc_oc=AdrYBAst3MY_aOwxwmi7FtvEsGEmRG0-HhdeLV2hMgceUVMmyK2G4JfsANDF1iowleo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS2HHYoXAJcMjs9QHi3wioFTs-RQwB7cAVTWXesed9jA&oe=6ACA465E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaRoiYHEjY4Q7kNvwFhe6lM&_nc_oc=Adr-hMhWygM4AI5DKzeDycVu_XGNmXduRK6SSrWuvC9YkkKXyRwBa5A6bvnJcgS0iHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3Zfx_Qn4FB9BnDqIkav5fa7RPc87buQ4Mzt5zRMALww&oe=6ACA6EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsC-Zmb8kDwQ7kNvwHIfTzi&_nc_oc=AdrYSicmUa1BFe77ujIA6dnKukUTXGI3s_z_L-HXPHP9T5p-CUOE71WXBGL3nnGYDJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnCnycZIPF1kq0tMY-cyCUtGQVSLoOIp10-71FZWuXRg&oe=6ACA44B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
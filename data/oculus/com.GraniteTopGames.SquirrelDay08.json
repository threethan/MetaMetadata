102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDAFe5WrddYQ7kNvwGWo8Op&_nc_oc=AdoZPg2Hva3BUXq-68r7B2g_1J8vMSkPd7xXn0DwB7G9LBgJu6JCttydYz64ZsefL2A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oyT6LmN74mfk8x1E7WR7dhw49-FQX1-hhz-I13OEZ0w&oe=6A1AD74D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEfJkJKZocoQ7kNvwFAoEQ8&_nc_oc=AdqJDKxnyeLv-Iho5oZ6pOXWnnwsl1TI0aVjjDciqsmORewsmsem9_TUPuKx-gO7xLs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TmdN_GwJoBL9ExIKLFTDinRaYy198TlyX9zV6NZ7zzw&oe=6A1AE755"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bc1DIOBSJc4Q7kNvwG_PWCy&_nc_oc=AdpxO8StFG-yUJ0LGpeJAqSGvWV-RGDAwTpYD6UodMvzWwtOrWLyt-7xxqKtdogzi6c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NMS4Pc-wsezyjFNis9HC-kikD-rcUVfP68H7b4IGi7A&oe=6A1AEEDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5N_MBWOoNoQ7kNvwEV0XVu&_nc_oc=AdrxH5a-0r9FOHBvEesWw3uP9cR8-21ZfJbdczsJzqg-H8p2Rt76IyIubJQ3_WSScTE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-LX30Ol71gzYRzJQtCHInznHGBdquFuwTcAtNCg_FKQ&oe=6A1ADF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArIphy70w2AQ7kNvwFMEbZZ&_nc_oc=AdqkcBKJZkGBGfgOZG8ktb2xpBwxWi4v0V6TLahwGwzM57dmXhkcdvjSF6sTKLFoGTU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E-l1jD1q3202OwxVEObUzwbptgLhw_3hexgXmKH4_gw&oe=6A1AED35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
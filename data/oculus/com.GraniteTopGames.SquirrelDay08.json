102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSqBhVifPjYQ7kNvwE0WsZc&_nc_oc=AdoIWoRs4CS3zHejsinyuIOyrf5mVGi-9vNNgrFA8J93nB66yNn8xYRh89aBuskeUAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3aoJu3eCwkbPfPXf8CPrvExN3sBouKz3Lnncd-nsexQ&oe=6A92CFCD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUTcdMnzFoQQ7kNvwGotEBb&_nc_oc=AdrY-XxG3FA02CT0e-LYTpxQb5taVCD4PpHUiiGBNsPZDo9tbZgI86ELNdocly-0RF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEux4GBjNbrnJcRIFGA1bz0Ta8UYVQDwib6W9cJbqJUhg&oe=6A92A795"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXtWD5cV_rAQ7kNvwG5-_JC&_nc_oc=Adob-L3FzE7yIETUm_Z3tWYrzsBy-keePMRaCQudHUXRjrKcOqKXdx-DSw1ktbYhcec&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgi_ZdULPFNxddrFUcA6OBEFqbm5nnXyeco5somICH1g&oe=6A92AF1E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_H5dkuIhJgQ7kNvwHhnggH&_nc_oc=AdrZH8HU7GXcl1_aQG78dwFhpmWKb2VE4QCWR1VinT5Dw18iM8DSEQdQBCM8rW3l35Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCw80hoLorh5GPNJeYVGQWIF6GU3Pf87rQzr4t4Qtf7w&oe=6A92D784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pay6yJRLjMQ7kNvwFR1zg7&_nc_oc=AdoCjzlMKBmKqRjfPw-EC8FTff01r7v1COskuQHLv8SAWgbTRnwroYXiXYQm4_Vv3sM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk7bYm_K6h-I-Qju9UjPzOvUxOZxYyVjiOe4RLv_gIlQ&oe=6A92AD75"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
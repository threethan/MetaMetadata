102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwIoaNW-JB4Q7kNvwGX3Zz7&_nc_oc=AdoYRvtX-wGh4oB9cVJeVpQ34n4GhASHMhMgAiEVrVkaFC1gl-s_EK864viXROpQnnI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiHW779sa33T7Micc8yu4iUb3-y35NCCKpUAnPQY_O_g&oe=6A9734CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GIgB__3sJIQ7kNvwGKuwLY&_nc_oc=AdpbfLwfa0E5b0KsW7UNJj0wf5i-AXFbFtpJB6h_L5kISfpE1Rfv4XeDQptnhBAsQT0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxu25Dy_iMlWGxRWu5aNQVVOkB1_tiE8QtEJUKjs675A&oe=6A9744D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ox6xvl7IXQQ7kNvwF3QXHt&_nc_oc=Adp_qoUCI1zKKg9AUkCB5jAIXSQZLgksaCBGnIhF0ThpfrOCGXo2bP5XKdVFWYMVgmE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQZ25Y6zAxhlytKt45DR7h9vJs5Re2es_ZVPgYwEsO2w&oe=6A974C5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyorwkgXMmEQ7kNvwHU8gV7&_nc_oc=AdqgbGsqCBRjgB95p09FOs5T9Hvjdf5mVy_mjWz3EPS570IZ1SmRE44VkJeU3HSfFIA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdBuKAqpix01uUSEMAtzFYCDfJOd9PqQvxBemTv0ZVUg&oe=6A973C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie7xUfEb6sQQ7kNvwHcgyAb&_nc_oc=Adop-g1BVZ9zuoIzMpkiyMoXTvWwBJaign8xkkwAfdPRgc-7VJwYOlwWzQ9nLDn_Sv4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN55tAsddw4i9uXjeVEzYcMHqT_Ii5PghAXXBi5fEF2g&oe=6A974AB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-mYNbsd8W8Q7kNvwG9xNsb&_nc_oc=Adrsusb6TkSQdnrpmRrRNgHc73cCcVti21daH2vTpCimttVPRAQJY1d75_M6j-Iyeuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3tOFI5MFBqlNXRm4XGju__vF_6q3wnoaENwV4KiRZ-w&oe=6A71DA4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsO2G5zsw1QQ7kNvwG-IN4u&_nc_oc=Adr9Berr1L8cBY5rw2vsaCJMyMTk2xcWGiyjWYZsk0_zeZ5mCxKm5NncGvPLebI-9og&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8TShM9qZGlEauIpoD1G4v8I3gKSaQLiY-69yYw1ogug&oe=6A71EA55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs8U5LOkMKcQ7kNvwEJ0DTc&_nc_oc=Adr5MP2tE6fY-luXohzonqUpiC2s7dwjZ4tbqqksqO-6od32Xl1GscZXDK0C_ElrabI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpwdUfF-_XO7PlZKl0ESCcTrcn5X5AWgAJrWWlbV18sw&oe=6A71F1DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9huP2-pzResQ7kNvwHJlXbn&_nc_oc=AdrEfGB7t5Y0OIyA81twn4GzrsBIoK6tpUJz97l7tYEu4kfHgTolhlvsgVsCFbter-k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDD61nvhDcTCGLkFnflEhLw8c8tDsSZrUjlNnX3QOUKw&oe=6A71E204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCxKMh0Jc4EQ7kNvwETLMep&_nc_oc=AdoLb39nxgUCALuiyKCWAatzpaTMs4SGHCYyd1aTp42dnQa0gAXxMk4wA2lbKTngvV4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFE8rIQ7PWg0bQHMdFphGBJROZ-FRKeIRtBhoIBCRqbA&oe=6A71F035"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=133eEHYfyVoQ7kNvwGBqlCL&_nc_oc=AdpUXvls0DbDKvcxyF8tMq7R12d5rhsjCI7a_QcgXbr6-gA1bsnJvv62M5YzKuQvaGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBuUiOlawbdC4u9Dfm8x91ppErikOwQ-9GcHZiufwh6g&oe=6A9D5BCD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6MWMLT-_9IQ7kNvwEfdYgJ&_nc_oc=Ado_jdXKSjg8XcApCj85KKRe8wizoDg19pBni0eg6S2nvpGHgivArS1lbUY4oyQXMqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNqXZP7U7L0Z7QGrOhdqUrYyFl0E-CnnbdEv_ftVGWTA&oe=6A9D6BD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1CiMmXFGgAQ7kNvwHmtgWV&_nc_oc=Adq3KWwEk_XPPbf6-ICjj8t5wuCGBbB9agCXSUcucIoeMqA7p_McoeLnetL_2wwU0z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPp1BuqK22LmsUky3R141IUS0l1vpMas4NqCqLSRHCDw&oe=6A9D735E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN3ul6GfPNMQ7kNvwG8tBqB&_nc_oc=AdrA7yZrb-p-kRJG84NmKc-0GlGQ48DJLZpYWjE1U69Ji4RqaLy2YF6CovXOGyRUZk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrb3nc4VcdXU-kjF5Vyg7MnXtXarEM-nWUyKlb-KHOLA&oe=6A9D6384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngs6wNo6xTAQ7kNvwHLhLCl&_nc_oc=AdqfYrLsnkKdBQGEukq21zCXHmHpZh7KpES4_-ZEZFxhe0CpJf43PvPDnPyrtc1Pclc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItL1gQNqdJ1pHFwLwNEllNPfD8KDLgncS0G1ITYC_L7g&oe=6A9D71B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
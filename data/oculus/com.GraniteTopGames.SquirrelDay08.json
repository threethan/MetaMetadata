png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZAgo7SZmPAQ7kNvwGO2Ma9&_nc_oc=AdrGw1hfoOSAzq8gdQbtyWS7Ljy1PsN3bx1-nVP-8JF4DUqJpncHbrwg2vgrCb-v6ag&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVcwjImwKixeQp9NtVHwS0F0zPvj5pJzs8ziLA-c6tzg&oe=6A8D89CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIF1djLxGYIQ7kNvwF2hAD0&_nc_oc=AdqswEHuG0ziUOOvAdiGf4bXdcWVBkgjsf-vXFmK8ZW8QvOiISh6VfdEltF70JwGs6k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1g4sbo6UCudOncOw-TwYmXTJZIVXF1s8zKLDkcndDmg&oe=6A8D99D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w9p78-MpPQQ7kNvwEkIryZ&_nc_oc=Adp2QnEYER2XXhN-ZbU-L67T7o3_D8enerWGgwMJcEMGVEeAFNR0Qi0JIjW-XqziFX0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpm6BAcSa4fogjerfhKAMoEZOoxfUR5cX-Sk8_TurRRw&oe=6A8D691E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh82ptThTjEQ7kNvwFwIyUD&_nc_oc=Adq5ZNcFDDKitZq1med8PbdqmTJCFhfa3fUPe1qTF5nxA2vncctxVphZ5HT05cG4XAc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhCeFgzuMPenjwJN2MYdXwkP1kvxB6MDHvdUpp15120Q&oe=6A8D9184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wk54qR6gL8Q7kNvwHfkOpU&_nc_oc=AdpYR6LxZXhOJQapxnYx_YdSAvnrde6zNB0h126coWNKJqoAO5Xa2prWLO5hOT8yOY0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEORIgGLerwqIO6nMfNbEXmXkbIfRhjpQhCpYNc65L1Tg&oe=6A8D6775"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
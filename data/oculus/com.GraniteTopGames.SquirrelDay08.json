102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ins3u6Uk3esQ7kNvwF2Aw0Q&_nc_oc=AdpAnNi2msk1CiADD_FmmxcdwAaxLUFNgP_22FtBs3xPWUunMhfs2NUxltZvcjIGab4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63M3j1v8BBRh6sefinSXwpgOtRA5hcmJXffLe7c3yaBw&oe=6A09B3CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNQZqeyHcuEQ7kNvwFAqmx-&_nc_oc=AdrefxX8sY2ducn08Fl54ENW82UuRrshE-NJK8GRySrRih0t_dZx9oBOXYGVHRIvEIs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tkoSR3mCWX1RfraA4h_LYO8pmA5aeG1rhO0GCZwhFUA&oe=6A09C3D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DgIBMiTKfAQ7kNvwE4OFJ9&_nc_oc=AdrG-FV_XgNbjr641kVrlX6yoITKaXuzxa0MMf150hZEPFnvq1hrgwhJySCjI-Z2wcs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VAViGdoZUL31epocz9K9QvcR594BM4LzCFJZ2b2R58A&oe=6A09CB5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeO-Fib4M8cQ7kNvwGbMdw7&_nc_oc=AdrLkcFq1TdsA0GXppbc_bO5gPSrhkahTJoHwMlhQqir5znyEttxPefGFJVL_sNo2CI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hkpv-Bdq6UWV8iGMbWEZC_4enfqDiLSPZN5-sYEzBoQ&oe=6A09BB84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuaGFMhukz8Q7kNvwGxwO7c&_nc_oc=Adrb2lzQYqphIorU7pzBdnz0a_ErPv1WXVfZIVD7ijwlEKTOHRXCelHsMi8OsShn4wo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62HTz1R1e4kdRbmzQBIAkqytaI--XmMc2KYcHQorx_Xw&oe=6A09C9B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWU27RTXr2cQ7kNvwFXUTpV&_nc_oc=AdpEuovQh_tNRfHoPtmXoCbn9lbrUOwaokcGmQ-ox1gS-cObcJHBIE4027EhkOTQvN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDugfSQkV-GTBhm3AuwGnHgomRnStSaHemcXV6s3nk0AA&oe=6A64AB4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY8ovdry1UsQ7kNvwHCqdbm&_nc_oc=AdqS8oLhUwjDLPoFHZYnnwS8WK8VsHzs6utgHxBrs4dA-10bB5AhazCw62xHXb3Hudc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCps7gbOnDwwzab5VXhp-5D08gSuMP0rqdYKxlUD44E5Q&oe=6A64BB55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptBm7P_PITEQ7kNvwHmEV2w&_nc_oc=AdrSH4xyGhlUqJNxZn_7FqW3iXL-I2SH3i_j_MNQJ6BhP8_jTBkrU0_72hjpnweSkIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJh1vedNf24IkzjpKey_U88lHFhEdwFjSaxW4xHJf3fA&oe=6A64C2DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hv7wAoqXYQQ7kNvwEq4-YI&_nc_oc=AdrlQktA3xyiTV3OFgLenxzArmANM-64grRnJ3GptBeHupBtrdy3VcaPEuYjVtlaTBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2eGSW2bi7MAV69NIP3aEdzdYUj_EL6Dy_uZ8fuZVe2g&oe=6A64B304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0MnSC1jUi4Q7kNvwFQNGTa&_nc_oc=Adqnl_HX7BFJLklWbIlhC5bfn7szyNSRhmQj2FT2bBN1GlIekT1s2azHS8M5qRv4Au8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyJc8oeKR9qX2BY95Q8LA8bAM4UIs_0Xfo62Iw2uULeg&oe=6A64C135"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
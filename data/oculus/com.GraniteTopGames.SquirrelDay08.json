102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgUOJ091wx4Q7kNvwEe9zqj&_nc_oc=AdoOR3vsCggt0xdlZDb_GMp8k0JfcqH0_Qq6hsIYD6Qfcwk6EFY_3gcj_IwQ_WVWMDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN_CtcJqUGnHj5K24eQAT9YuiHwjXwlqqIbXfreDaNzw&oe=6AEA0B0D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSPB_nZLIKoQ7kNvwGwTeO0&_nc_oc=Adrs9BaSBdM-zkCdpXfN8bQexvuQfoqL_6mXjB3NYUkOnlK4fwJylmDmEe4W-Mwyj-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR33CM1vaL-1HhH9sRtcGzc5DRIRC0SKW8LXpXkRLcChQ&oe=6AE9E2D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd05CEJd3asQ7kNvwG0N7N_&_nc_oc=AdrzfjEpO-jkemQYRNtE85FfFUJRPNMzSk-C3oXh9MXx3AEdQETGQ-tL1fRfsy0h4M4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOfPrnXaj1HQMsJRGRDHtAmEO_tiH55eo6i5Etk8Fdlw&oe=6AE9EA5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSJovdiUCYcQ7kNvwEwNuCb&_nc_oc=AdpIGZowduULLLb6kXACGPTfPlmwA_ja0HNQdHdenqc4ydoJ8f8d9dLbPQFrwqSl7iI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNuk_JAolLzgoMcqz5VghIAm6uo62rSYid3I21-vjVng&oe=6AEA12C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK7l8rcECtkQ7kNvwHLWqIk&_nc_oc=AdpJIflbE9F2ebDknQbl3LRvh8tvq_uvWlaub61LmSH6Hg7VxlmFM5ymjQKO_5Erxx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Y8zO8xtszc3j911CqgNtT3UtU08TuC5u3-VTAh6ZDg&oe=6AE9E8B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
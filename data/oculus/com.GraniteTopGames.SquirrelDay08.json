102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhU4PWWrMSsQ7kNvwGIMByq&_nc_oc=Adodhq7fsCTE3MDzqA20siZLrEDsCIXNraviyqDZczglBpEQnu2a9BFir_UQJaHQdp0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm8fl9hRQEiqG5cqvEq2BapKm5gXRLBUaYeO9fNXLODg&oe=6AC7C40D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBbrypsWkZQQ7kNvwHlSCSq&_nc_oc=Adrb7DmJ3frGN_Rnr3it6EbOZCGr11MhrMbdGKrF8LCV1cm3TCN8nnPv7KM6Zps-2bA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeWBtwdqx7LSlfuP8RpTyB6eDDbHUEIAtBHfdGDJsc4A&oe=6AC79BD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzfxwRXmCyYQ7kNvwEMZjr5&_nc_oc=Adr7nJJgyh-DrdTvcM27vfJ-LdB9iCA8V81UUYnOFVVaJBl_GRSJRU9tcbF__0P4nic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjYdfawL6R_lRmLeAoWnUZ5eCOHRtjthJc5w49JR_uSQ&oe=6AC7A35E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9AfIZpDdN0Q7kNvwHRLivI&_nc_oc=AdozyqmBAqUPW2z9NsnWvPyx_NJBZfADfY3h0Xu_mbJgZvj8CCcZtJPrytjHfAazen0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc5Lo_Lhx4aGVgvBMOuBjtpAmVs-BrkyyuVfw3i1JNMQ&oe=6AC7CBC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMeRQYdlkF8Q7kNvwHFq0Cd&_nc_oc=Ado0x1yluO3LhdBrkgXFP_8l0OOYqRsTGLzFQfbSEeL97ryQfj82FFVTtvvIfaa0eKI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj9KJJtLo3rEsXdg-Q8-KBZ8ak8oZ_vC4iABLFOCIe4g&oe=6AC7A1B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hnz23xKcJQQ7kNvwGUq5Am&_nc_oc=AdpXBNArYhOy_EDZ8atwl4QKrJ90PkGhccVDviDa0XvpLS8gcPS7ob7vPviob58LlqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTh5UpOSKBj0dhvWJyNopd-4LqhD2k8MbDmKeOj92faw&oe=6AABDC4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OpCo1uBlpIQ7kNvwEfih4q&_nc_oc=Ado7HFHCeclEMuxQlE8Ve62Lqj00MOppvzCBimkz19VcrNxRRPnB8DhmZwGZK4Syw5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpFujFovNoTNhaOEBWSiENp_lOmfU3NUOCyXuSGw7fBA&oe=6AABEC55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6wsLhTyOmwQ7kNvwG-iiBk&_nc_oc=AdorIfBmSjt0U8JovfehcqiGL24dJGI6EGsYdleSroI1-TMZi4IfYaeMP6xHjYZX8iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIToZQCTBIebffxy86MrQ25AxwQXVxiAeewoDqe6Ui8uA&oe=6AABF3DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdQCP9hfD74Q7kNvwF0ZTgA&_nc_oc=AdpkNc7qRx7PfPDqgBhtlVoXYg9ODBNhckXLTy4O4JNyp2Sxf7tiT92TddFhzqia3og&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKavKVQZpJgi1kVWF_HrWhSTkNkONM8usV_5LjnZDKI8A&oe=6AABE404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxGhEqD-OE8Q7kNvwFRqdpr&_nc_oc=Adppq-ykdtV9LYGiLLnKF-SDe7JuFVm0FzY_Znk5bI2Tt_2JqAUTc_5tgPgqHe0bSSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX3rWLowaeNCVvWLeXqC2XkrZqAFFuL1oTlmXp1pipmA&oe=6AABF235"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
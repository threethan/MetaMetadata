.com/v/t64.5771-25/38974880_146375168296332_6788622436762448252_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDnBA4Nx29kQ7kNvwF_aepw&_nc_oc=Adry9Aks6LHJ3ujdZZwyRbrt1_NDb7vRSN1cWscLw29mHgnMNQFWAajdPZBoCUmfGBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9oe4pn33mTTsnXWSRKhrVh5Yi4Ns-2iLPdIOpqCwqcw&oe=6AFDD18D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jStWCKXKnUQ7kNvwGFu3vy&_nc_oc=AdpFao21ucxbj6guiN5uT2Vb-KR0KGcz74Qy2sjP4UAZZUBEa-GBsRYCkHGluQlXRWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQewNAnK0eTBA3D6IOMqAxNGHstQXA98-xkc4WsDtm2Fg&oe=6AFDE195"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWie69p2akwQ7kNvwH2a5Fc&_nc_oc=Adp10a1fN6CTOgxzUfAwmU4hxvxjdgrsWxnLIrpFt3mk_jVK3cMcvtd_WoaKpFJ-gmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZWc2hJq76udKb9vZwPjZ2Uf8mSc5PUD-BCSzfOEmG3A&oe=6AFDB0DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_MKDTM0PjAQ7kNvwGD1d1s&_nc_oc=AdqqceTq2zfxF-1ULSNmf2xP0Ci3qVZ1Xcvm-IP288nCoO1IiHWAkvBxq8AkOFZX8Ow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQINgG6p1HOrLGxedsLsM87oG047w7djQ749goM5RwzDw&oe=6AFDD944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAltR82IedAQ7kNvwHdlKx8&_nc_oc=AdoFwzcp4QAk0COKuIrE5bzc8TOhFu2pyY2Pw74t3b0COmfY_1fShOURa0STrjZcYZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD4WGcEGoahAHWEMPSeyCRJk7DSUj5bFn3wnIQ87JPag&oe=6AFDAF35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://granitetopgames.squarespace.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "https://granitetopgames.squarespace.com/contact-us", "website_url": "http://granitetopgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZTq155HoEkQ7kNvwGp2JTx&_nc_oc=AdpIpnrFmOAb_ah8yufZekENAMwWAV6h5ehNBSy-I-svlyyZkqoP_OWIXpdfbYc7l18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7r00zpFAaZrX8pdeYws1hcd91aFBi0iZhviqW4VgkEQ&oe=6ACFAD0D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjksUr21yIAQ7kNvwEc4T3b&_nc_oc=Adry_7rGXbiJSO2iDPnCq2K-xCq82__iUM7zlmAdV3nlYAB1bWbxb3yh0yYTQUwWhIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPspxZ0LJt6cFW75g0qJCYT545iz5zZ1zyR8IgF9Qt0qw&oe=6ACF84D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ytwB_JsBCEQ7kNvwE1Npr4&_nc_oc=AdqEGzUk8jDqRPSHXswcvX1j-6nQqhRSu5yAqyVlfYKOkWUNceXnIn3-j0XzhTg43NM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzAGuWwFfC0KMu4jSgkBSC6rHaa7HigjLwSwFAFE3wVw&oe=6ACF8C5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlhIGyMKRL8Q7kNvwGr4zAa&_nc_oc=AdoUPiNRSCQPPYlzG_aKheewbnTJqksKc0rsCrIz3eUwYt-_bzysBuzBBlqxTj9ZiCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx-X-xcWyHjjASfgFxREeNRCJfVKQ2wNhjaBNK-4WPdQ&oe=6ACFB4C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEZ5gY9WY2YQ7kNvwGaYAxS&_nc_oc=AdqnWLixLlExeMOyztZelPfwIyInve1mirWO6Z0Da8kc_3mXdgm2DGrEecjXO6amb14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCJsHukv5ERnJ06f4KQpD6EykYSbima-XEIuP0J_yooA&oe=6ACF8AB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
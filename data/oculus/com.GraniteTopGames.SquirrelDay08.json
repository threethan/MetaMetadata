102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUTCG6vG47EQ7kNvwELbz9M&_nc_oc=Adr16mQ8INJ-JQIhVz-UNzenzfXoUnhLIWo_4pjQYiC-gpnyvvfWVbucGIDhcgvjAiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN32hoAX10E2vhXk5rmAwBCgbdC006joaMD64HhSHgI8g&oe=6ACBB88D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb0okVrAlgQQ7kNvwE0EGdT&_nc_oc=Adq1qT-_pF-DIsAfRaGItv8fCXGlTI6F-I00QrtHQDPEbDUnhfV4GF4it2WsaW7ZYdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOANOe8hkH6vrvahbtk1S0km12lHb5t4S-QXr46_d2vXw&oe=6ACB9055"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G0tkw_02I8Q7kNvwGQzLF6&_nc_oc=AdpVK8TVVpSR55ekFvqu5RgARIPGMOw6TJTyiKZ88VhQFbyv05UGqO6ZoLaidLIPJTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd8qtV5916UGzA4G1foPsQSh3t0cXkV-1C3GfPP026oA&oe=6ACB97DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaRoiYHEjY4Q7kNvwGlJPc3&_nc_oc=AdogGWGtGcwaM4D8I64a2BHKXZO244OI4qJXA2z2whU0Rfp7E4oa-JT8ZrTehVLJwiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5l044uRuCfX43HnuJKA_3FJf-WXSnOHG19KUOR1toXA&oe=6ACBC044"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsC-Zmb8kDwQ7kNvwGfY2-V&_nc_oc=Adp3SXKEbpu-YTdeIqs-OmjaEqZFfdLv6j68rH28W0QqOUjONS2AzkopCYPjcdWt-14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdyAB3HGnUzbGZ-AQ7kMA-1cmzVctMcrFvPlwrrKAwQQ&oe=6ACB9635"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
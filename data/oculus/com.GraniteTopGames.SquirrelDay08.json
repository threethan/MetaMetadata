102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTlOkMq1AnEQ7kNvwE-_dir&_nc_oc=Adqm7CtnL2GtzSUG6cbonOjsOMeh_UTOjpVd_LdalwGJoGrq6kSktQiAC8zTLAYE7VM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5shPy4J6mgZ9DKIBPcx53FKflh6m_DdgZ7qg0c6wKTw&oe=6A86F24D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vdQZtwE_uEQ7kNvwGRQg78&_nc_oc=AdqVtMWdhXJDOYIqA7j3IXWoTo_4txAwhr3X8VTF6vTiMstW2ugJgO0LdYhN5JfsjgU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtYE42h8fDx2xAjfy-h44W69S7mUzoWYuXTTI5FVKMvA&oe=6A870255"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eO71dC9x74Q7kNvwGapkhe&_nc_oc=Ado7Ujq4zcUppJcM536dt5sPXS46gi-RYrr54DifrI_V7Yz_fmKN_NQzPrwxCg4f-M0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHueK5XAqiJIU0hOL-z0RdRJTcyiF7oRBgDCItjlFzxaw&oe=6A86D19E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNmupzy96BAQ7kNvwH43qFC&_nc_oc=Adosb7C8H0GhokcMzrNWPVygyIwdS8MqMeygO_BZ6rrc1wsbYTFyhYgp5ZlNQ0BxvHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQv9158an0szrh0Ugxt8g9VIn5AEb_KEy0zzAT49jTWA&oe=6A86FA04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ2G_Nxhb1gQ7kNvwHKpO8g&_nc_oc=AdrR4WddDZEolWs7BfWgHLOSSHcWwRym3jDjoZ6rckFBJYeWLhfkkniu0ZFrKSWGpj8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE83n-arMPqnV1JkZ9p1BJr5mWv8zoOlpdKZ0NxC6Hx-w&oe=6A86CFF5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
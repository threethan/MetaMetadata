ers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://granitetopgames.squarespace.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "https://granitetopgames.squarespace.com/contact-us", "website_url": "http://granitetopgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1015097849111332"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1626713524512248"}]}, "baseline_offer": {"id": "1626713524512248"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1684168317, "status": "PUBLISHED", "id": "1626713524512248"}]}, "liveChannel": {"nodes": [{"latest_supported_binary
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvE0Cwhg7iYQ7kNvwFrj__s&_nc_oc=AdqHULlRitx7XsVgWT41CYMlHf_A-ftdN4gxJpFTxhigDraUZ1kPRj1sRJ8UGldsxRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNAZZoD2OM2QdWOe8Wv59CpG4zBkbHSrMsIa8OpqHCMw&oe=6A77204D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoJ8SYP1XYoQ7kNvwElL5ri&_nc_oc=AdqDIus3zpHrlMI-OffXdd0dq6BYXSofBUVqkla2U5rYoP6cmG8lGViJJrZ8XqK3WQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr-slnJYeVVY5x-0vnma6PLkqsFOK-iV4GtTC5sufIWA&oe=6A773055"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA7GLhqkaBYQ7kNvwE82mHv&_nc_oc=Adp76mi7ysiOtZ_a5pU-d3jxg_Zfwg-kzioz1Bi74ARfn4a3DhboqjDCns9ywSKsvN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjI9Udtvi-sOQjznQVwlab9PKNcxdrHCtrwCRicSHcCA&oe=6A7737DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCp7g57-kBsQ7kNvwGRN2Ib&_nc_oc=AdpHoUPr7-YqRO5NL7UjflWj4KE8YXeTs86aL-BBzjddB5WVf-SZ-cBKOz5v1JAUU5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWRBYEmckL2Xz_WsvHPW2W28s7_QqQlxySfI-Eff2Tjw&oe=6A772804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Rgx2ybyrjYQ7kNvwHZWalT&_nc_oc=AdrtE8HUyJjDIdxTLr3LbkY27Gtw6sZJuiuazikzItWaOZaa5CI1gZBp1T9JUfNmvbU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNQ2JSczP0qY1Ga5_X5DHVkjl774ooA2pO91scHOGcfQ&oe=6A773635"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
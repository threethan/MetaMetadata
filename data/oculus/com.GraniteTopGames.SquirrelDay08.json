102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBBtNZiCnr4Q7kNvwGyKhmZ&_nc_oc=AdrIKEd1qu6rh1wwnht2oGx47Mu2H3319PPzxPrcLIskKkwedugJbqyxlNt7Ee7EB9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRi6gwnAGFiavkkmgV8I-ABueVy6S9GPSelx-mIyf5Xw&oe=6AF1F40D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48JkR6me4vgQ7kNvwEWYKJg&_nc_oc=AdpCEkLHZHozVtSEs1xW0CqHeQs8OJrW_oKLZG2RS2Z6sziaSxGTn9IVxLrBc8V7XEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvGlfRx_gS8LQt6O3VCKdr8_PCM268euTwpAtAm-UsjA&oe=6AF20415"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6HWvAfuqaMQ7kNvwHI-4ha&_nc_oc=AdrxD0tlW--iooOxsmzXB6Maq0znDjzYe1ypdMP0RTZ0ohHQnUeczQ0W1kMASNReXwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHrvVJNv_DUtlUo2Zjz8YxDseGmGchvEGshS9naB3pAQ&oe=6AF1D35E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BjYLl-U8aIQ7kNvwH6uquq&_nc_oc=AdraUUVIjNg7rf4d508qe2___LYP2Q5oHf-umJtwM5aInjayxufPMThfJr2C8vteo10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS4R31u5ZUC7oaeivwJGnH10rnU_H6cLHIwSHmfR2vuA&oe=6AF1FBC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWNBffcb0lcQ7kNvwHjLIPt&_nc_oc=AdqUr1_NuviaG5E-gNc27W6GDyxRHAqqZYmkjq58CuzTM4qzGqakoACNCrY2ThhAdUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxq5w9rNiNez_Cx9WAjjDWyfKHDpg8iarQO95zBfub3Q&oe=6AF209F5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jx_0m0v_QJwQ7kNvwFl3uu6&_nc_oc=AdqV3kpndLOG8AapPpdBl2kBFJmYSjfJtA12NXncicGp9NdYmIzPkK-4wlyfcsuKqp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xmNFS7ihYtURnUKf0M2mp5GtTCmri1MJdEs8kxtFQMg&oe=6A1ECBCD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYUAJVQnSQMQ7kNvwGeKbwm&_nc_oc=AdqF_9_CVeprmv8CprgPOOsDlRGVhaYn2QdHWabGbURPZi08X7Z-YXunZPTxCP1LR-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vptx4kNfuCdf_djqJwg6jHROQhaCQeCuLONcbbaPvdw&oe=6A1EDBD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C7l5y2tbXAQ7kNvwFMCHAa&_nc_oc=Adprj2GPbrBcACeYUzoolptkJjCpZ09S6oSy7q-KEYO_mAh07x1va13dZMyF7rCWUlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6muY1oUbLUB6_ZVTEDRgkXQxVeYHgH0ntj8hyvQjAhSw&oe=6A1EE35E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBUgWO-3qfMQ7kNvwFEb3Q9&_nc_oc=Adr9GNmkiWfqbU6AOR0lc0a23UCDyE7v2OtSWuecjJRGNYdgEQh2pE1s8I2d1OkIq3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vGEKcUESWUF9FmZUGe1-yBT0uoQ_Pk4NIbqTlp97gzQ&oe=6A1ED384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-OLIDueC_oQ7kNvwHXt-Nj&_nc_oc=AdpwmQ3Gy6fDDbiv7Bg6lnxDiOKK1fWMsWvyfcSfTbGGtXX3sO2sEOEguRrYQOO4dng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7znEz4nQOsxIyuNXSDDaWoEAogwZq3Ifr3HR47zTTkfA&oe=6A1EE1B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
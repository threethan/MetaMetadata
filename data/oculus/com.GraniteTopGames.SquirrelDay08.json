102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSeD32aLJyYQ7kNvwF9vkOp&_nc_oc=AdqRNGlsYfPTCpf6Ol07PEBzoWjdlGXBP51aMWT7UfBo07HFQRGMYzTnyerZi3d5wKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMsO94wleW_g3aPQefEhJ7mI0eqXGKHtkUwWEnmcdvqg&oe=6A60B6CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awe0mLivo_oQ7kNvwHMcyz8&_nc_oc=AdrzxSJ0s5dcg8YG0A5HjmESuyDpTq44TRIY5DlH3wzZcCNWuMghDJV99RQ6yhrEqmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6SDaOmMLDIxa7XNq45pAMICyOhUMKGRABH1E3GFJolA&oe=6A60C6D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W-16jI3TsYQ7kNvwGoXVI6&_nc_oc=AdoQzd_XqzLS4hT3wU3aJPKziAvu0M8VjNBFQVBlrwKdAt13P4EWpTqlhGjzQXp3KiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5jGH0j4EXpXdHxSqU-eJXXU2YjQI4KrmDhL59sEHz9g&oe=6A60CE5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Y4fn1kjU4Q7kNvwEX3Q6R&_nc_oc=Adr8PPQlMesdXy59KJkvvE0F8ukwP2VqzD3UlVI2YuQQxu2eNSwOcJgVpj9R1i4_c60&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqR_Zog1x5HZfFb3JZueCRcZXOGJKOat0prAkV0w4VyQ&oe=6A60BE84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPkTdixN-64Q7kNvwFKpepO&_nc_oc=Adrduf9vr5MnxaqCTbFOPO7QZGpICYgdNcBseFdT1yad7x35qO6R4TB3VDKlhtPqd1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkUP6da6hoct6Vy2162J31nbm5xZUKS5-SWB4k_BxVvQ&oe=6A60CCB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSj6BNi22wDd4_f8UVgbHzQTAzagE5yHOnioTwc6U1ig&oe=69AC194D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JL0cYjY7SYIQ7kNvwGU6uxu&_nc_oc=AdlBiLMj7o-_xGCUvmuB61jFqTpxItZVZG63FPOf2H5AVWmJ3kHFlPKneRuEAz53xbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxMpcH9gx8J-TfjuiPiq6v6Ic-oSh6nCimGuUzRQlTRsA&oe=69AC2955"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOK0goZpfJkQ7kNvwEyZlIu&_nc_oc=Adn1tCJGEkfb0zh_OvVaJ0l545vyKZYXK7xMt9gqS4bzUr7dD6ikTuheU9nN76yHeJo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyiaEn5ju3BNdzVFzKUiOsR3CTK33H042eA_s1LaiOP7Q&oe=69AC30DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eoo30FqcZcIQ7kNvwGrlMW6&_nc_oc=AdnsL2wj1DNRt_BbiiAFHHzn1-E17KIyZM3DD29dTH4v5JD8pDdIgLBfOxDDhh8bql4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwjfbUcCl32qtEjV1C5TKXKFB-qcI9C-dsN44ygHJ8aA&oe=69AC2104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-vbNCzPgQoQ7kNvwHq1UHk&_nc_oc=AdlKWyWuP3wwoP31D9gHIAzmZtRIkJkSA1nqRsUQTFj2Ure4jsmCTRemSQEf68YTrsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPXDhs1AagDKoC94T2QrcaELBa9Wo6jAIzW3QCIgxvIg&oe=69AC2F35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9464413566941155"}, "
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URCryXpy4BIQ7kNvwGLsRKd&_nc_oc=Adr5TsF0Q-5VnpfDgtcjkLnNGzx2ruWy2YSDd_EtvhmMSMAoKQ-zS-zYM5cVoPvyRd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zt_9VWxh1BKG3UEb3YkwjH1eapMBSDldB3C7yRj8w6Q&oe=6A3AB38D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDqVMhhVNrAQ7kNvwHfSCwE&_nc_oc=AdrguwNRVLxS3f-XNnjD0KHlnnMjt2iirf0kQGhYMZ1uggw0s16gpmR8y563wrB6qd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GVf0D3QGSZiDzhoPbdCeUla-qzJ5fZ_KbP3Fn_OGwRw&oe=6A3A8B55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gub41JxTCHAQ7kNvwGEg-QH&_nc_oc=AdqFmlfy2-Jgm09LHi5PDV_1xRUBBdy1kOQtyE3EaDQ0l9_QBwWxKZqsiiPRnmmdpCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0VZnch_bmHnDacl5su1SQE_I5ZwMJjXhOyUKw2nnHbA&oe=6A3A92DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wua_W65wjUwQ7kNvwESJYlC&_nc_oc=AdoK96r3EOMOL4TfYpzunKNEcB4fyIT5AL9abI0V9gQFlNX6uYDHzSgf0FNpTyuSIj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K8J1yW_H2bQM79thDD3YpJvfPf-iyYWq4nwyOy_2fBw&oe=6A3ABB44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YK97SQD3sRgQ7kNvwEpVDLz&_nc_oc=Adq61FaflZU6HBKUDOsK1HyGqLB7DcKOpO1N-h23y7_JsKK4PFGS70T9EUZM2DgVbvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v9YoOgNR-jjWj51IQbpYfA0XN5Onkr09-zJB8qT6eUA&oe=6A3A9135"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
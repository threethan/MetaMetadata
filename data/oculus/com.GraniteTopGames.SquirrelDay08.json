102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYToeCdSjVAQ7kNvwFs7IP3&_nc_oc=AdoZrQcpg3sqRC8yAGW_ZLP7OycITX8DrE9B5geqOTcDihbAgCY-O3VBIBZqd7ecv4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM5IEmkxvdvOlkqS1KqCjSWYrbD_Y-A_05gTH9K55GJw&oe=6AA2A1CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-qziioK0o4Q7kNvwHX4bLt&_nc_oc=AdpTGm3LXoHkLfWlCREvOcWe_rCDuizcGIt0C5e0OtAl_HUWA1dMG_clvYqCDU5YZk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWs6M3si4njCX1R9JI99ECeJ7zbIbDEEbHnr09uil_mA&oe=6AA2B1D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t93VN-JAoc4Q7kNvwHBaUtu&_nc_oc=Ado4a11hxPNwF2cvYpdsH5GjWb1xuvZkfbLgyd4fCS7lt3GR07j6IFXYCX1jatefiEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdvn067zFSGpkLBURUBULxwxAc_LPgYLLcm5vaADMoFA&oe=6AA2B95E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HozWWo17GkwQ7kNvwHa46lQ&_nc_oc=Adr250uY3K_0isuADEqUfKI_MgDpff0PK7Uk9uZqDTXUmoguD9FN_3mM8x2VDrF_2Sc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI68ssCg3hciQFhoxemDqBuHUGQxiM3JMPbeGH_80SD9Q&oe=6AA2A984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtrqfgt5UzIQ7kNvwGJL17m&_nc_oc=Adro9w7qaTP7QPqMdSEQ0QZCnDrUPphOet4joO7bgbwAslUp--IpHUnseajXWOnYY-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItClhJaJxrNv8a3ZMN8ro9DihHDYl-IOcqmALUsTm7OQ&oe=6AA2B7B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
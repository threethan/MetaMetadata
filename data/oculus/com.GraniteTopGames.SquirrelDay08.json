102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC511KjGhfoQ7kNvwHUm2EO&_nc_oc=Adq0DMAHL5S5Y29qWGtGMWvPbRDaQJrNeFhdZV_u7a3sFtZaU3JN0OsAzQza7GxryEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-INTYH3Yv_ygz5ZlFZJ5q-nksneJdFSktv0VtvlwGZw&oe=6A15914D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TZ18erdW_8Q7kNvwFBSa5J&_nc_oc=AdrjuRBXn-IvAd_9I2s9yHFtUHtOvc31h5MfaAQlFWEFFxMmkml6S8CHJnZ7yRq5HHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fS4g-S2KaibXjWvkMZ2GslC1eP917M8RsVeGMsgOJ1Q&oe=6A15A155"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRAjHO9UBA4Q7kNvwGC_Uus&_nc_oc=Adr3vTD3tCgrqopkkNe3SZNIYhQ9XeTXk04s6M1oz86KzvzgmLTRsCr8xouJkVwcWW8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z8KvgJ-3gHRrfau6XKll5Cx4w-A-MvxcNVWod9ldCiw&oe=6A15A8DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YRuTbWraEoQ7kNvwE4IK46&_nc_oc=Adr3AMc8yn6EHheQlDsUrq-xTDXw_F3osQMstKIm4kn5-0JXAqVoshF5oerdsJHZoZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48RmrQplM_Ri7Orc2kJZ792lFrVpF9IsTln9lVXkkfyw&oe=6A159904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X58pAObvPzMQ7kNvwFtJdk0&_nc_oc=Adow3sDQ6wNMrM2eadgE35clVWP2PGA86dmKCDIsVRIJe-q08I0NqBk0Sujy6rIINLk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KSsZoJ4BHWFF90Lx8MNLSYuK_4Q3-yQFSKye7ZT6s4Q&oe=6A15A735"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
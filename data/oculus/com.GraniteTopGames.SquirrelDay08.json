102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWU27RTXr2cQ7kNvwH7U2mj&_nc_oc=AdpAM6tOFSmTQpSOJo89omaWHuIUc_jcJACo68ePmjsQUJkjjoQywaz8dsG7mWHcMMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZvZ0xkAoZgw3gkla8rHhXkEBTX72Q0FZukkzR2Svk6w&oe=6A674E4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY8ovdry1UsQ7kNvwHzxze1&_nc_oc=AdqNSXRqA6Ennm1_XR7EP5P34_rAwi51HR1BdK7X2lHCEvogzZBkmWiit4jtsQQxdvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8mI9Q9cNelW36ajU_JO_qmU2u1Sr3WKA7q3u78EpYZw&oe=6A675E55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptBm7P_PITEQ7kNvwEjSEym&_nc_oc=Ado-QhGwaBANVJaLENsx-1qPn0aVrS7mPWbVxjT154Z-OzpAFvp-1TJAkxIOAWUzv7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzjOchzf7_Q0m23STWdcxQ2XAAsnyK_VXRU4oV13X-kQ&oe=6A6765DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbBgPY3b-C8Q7kNvwGBoSTL&_nc_oc=AdqZhh3lqmRe0CJaAk72RKkVSgTQmRdJlPUjT1tuD8LcbO7beNFagd94Cbyez9vDp7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpJWkqMxfe02QyQXejap4Sx452U6w62qlL_-ghlEY6Aw&oe=6A675604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1m7IzlBhE0Q7kNvwHiEJxr&_nc_oc=Adou8t0KKNNqra260u6nZnoFVRt6Xq65bMrUU2OHcWbLOw83l0coSK_Tx7aQwYtdpSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiMIpmTh71QCaJWWwwdSG6k5DkabA3dGke5you108gHQ&oe=6A676435"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
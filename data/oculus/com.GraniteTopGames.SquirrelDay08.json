102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKFMONdFI_4Q7kNvwHSpYO5&_nc_oc=Adoi7LExRlRWU2CbxoGJvkQcUC64o1krxW6EFXS2xBBhqm9Nkw2WHdq9w-tNgTI_f3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqyMrytAITY9U_l0MbjBCYfTkJGQ6_BqolyMfC13-06A&oe=6A7F094D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BMnxVb0R7UQ7kNvwErtRHa&_nc_oc=AdreKqf1a-CZBiOX7V-umf-fDkd1G0o7d8847PUEgnkTJcJ39MaUDxzjFXnu5h29QwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj3lynpnhyfv98hdKdSUJoHoGS4fN3T1rS0EhtnsaqCg&oe=6A7F1955"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jl7SwJgRiU4Q7kNvwEoqAl3&_nc_oc=AdqWfegEgZvQpODITycYSCSBe_632XIXPhN12oBRFxG9_h32oMAQKgSAH95Fkyuh0cc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5YPFHnW3Jb6f9vyba4xBkc7ejMAQhhUkntjV2IBx3tQ&oe=6A7F20DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXYUNBaPLqgQ7kNvwFanLCw&_nc_oc=Ado1SorK9h8Ix2VMDePkHNKM6FzJ5p0tbdsHEJpllsDUnXOur5GT2viKSWGnwvhtVRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgVUG7DSlCDVidggj65sBIfqQR2itcK7HWHpMKiuJwfw&oe=6A7F1104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSOKeh0et6sQ7kNvwGk6rOB&_nc_oc=AdrUeDO-DAWempT7JdEJRL4AItelD8zElYLUFMp7rpGWL9uwCiDmqkF4tBIvoYTe-XM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpXCFXhMzHn7Lqdpks3G1SxxQIVdVRyvVvD05GCD3sCA&oe=6A7F1F35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
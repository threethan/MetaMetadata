102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeTGoqqZxo8Q7kNvwF7W5Jb&_nc_oc=AdrzDPfwIvd0qzFi9BaobgakgIXiS6zK8wAlRgsd-myuDw88OLQoEKGdVVIF4u9C9hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2VN2A6H-TqUsAW_p2-tWue9b670QWemI0mSiHi2xXjQ&oe=6AC6728D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sroHS5-XP9AQ7kNvwEri7v8&_nc_oc=Adp9tqSWeDAKuTat-BHg3pl1N-6cXbIJGNjMczMyrIHTsRp4sjYHKd_lNMe86GkgBU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM-UdV1PFYSca7BQuDbMoJlUXrWEwMmVVlrVAFNUqOBA&oe=6AC64A55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_1-obmjGl0Q7kNvwGGE1Jt&_nc_oc=AdrqVSbKqOXu_pzK_dUTwAd7eU1_zP6TJ8kY1fgh4JXwgVyzp0QlEKc9Iordcfdd844&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0Plr22JIQpLKLHSCJrpnRiegNZ3gyklISPwyFGc7h7g&oe=6AC651DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9AfIZpDdN0Q7kNvwFRZdwU&_nc_oc=Adqyn0et6qpS8E_dNJ3AW6angUHfE0KjnC7_j-rN0ySmtZgyYQ5fhZAq_Nk8BmSsPEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUh62Z94cOduJkGLgvoWQxG9wYtvDgEJsh6IgQ_z3jgA&oe=6AC64204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMeRQYdlkF8Q7kNvwEjwGts&_nc_oc=Adrl3UTCHvDYdYVLT15G9K7ioti1xxzsIg4mHeQOXfdbu_6TDKp6MZSNGkLpB2OE4WE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJmqA79RPz_1jstSKSNFb5DaPKYyGTQnRFie3f9hvKAA&oe=6AC65035"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
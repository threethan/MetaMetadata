102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FCPgSpRQsgQ7kNvwEy2w3U&_nc_oc=AdqT_uIN1Au9GF2UHbA73Dp8r4noYcagR-2gpUb9j9mROigToW36Q1oEBlusSi3K9s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaxs_z34X4gwRwXTEty4nskakGlo3xrUZvaoytdmYHiQ&oe=6AEB5C8D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35FbPAky8y0Q7kNvwEDvgWj&_nc_oc=AdrgH_pbM4Ogm5S0qL_VrV48C537hd8YOerXyyhRnAWXdVFI-8EL2UhrpDyIwxZZVmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVpK2T34ah1RiP_59tgxCWHt2pkpVJqRhCR06nWZJb5Q&oe=6AEB3455"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prhbiaHidO4Q7kNvwGIfYJ4&_nc_oc=AdroPWIiSNKIbv4cysi0ryeUo30WRsOKTCOLKPMKK1Kz2zUa5TEliEYccfToCw9P2jU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtKEZGmMX613YHKcFKHT_OJaYSfSr4szZtnB-QMEmx1Q&oe=6AEB3BDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSJovdiUCYcQ7kNvwGd5CrG&_nc_oc=Adpx8vQexu4iYeiqzn7E-rCF3zB6Lu4UOBK1cadsNVhKnIGsq-_cXIhLM8FlZARZSEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLpZtT7ZvnhHT_IMGFqm6B6KFWXOLyVpN-geRogzPyCg&oe=6AEB6444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK7l8rcECtkQ7kNvwHEPM7B&_nc_oc=AdoRinTwM1cq7CgpzyV850LtKdlD3NfstubxLHtesH_2PxhaFbvnAQ9cC0xTdopBzv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH8fwPRevI2ehHiCE_qRNMOevATx2ZCVovWb8sILWPiA&oe=6AEB3A35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
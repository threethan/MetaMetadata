102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZAgo7SZmPAQ7kNvwH06xJI&_nc_oc=Ado19Ob1lI_eLf2idU95mG0iYJIVOb5Bah7jrhzw6pGYhQhc3x80ixo5XAXgaqriH6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHamxCkcLkL3fJSHUOq6G56B1RczGztkKay4Jri4vnA6A&oe=6A8C384D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIF1djLxGYIQ7kNvwE3oVxO&_nc_oc=Adq2GDfau6drAuBgfw-0SbU0zD3iVWK6iDwLsGiLal3Nx3p39yHl1p8vi41XE8os2Wo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtDYRdCX--fUjeO6nR4EaDa1g6ENzuxnpzflgTDaJzuw&oe=6A8C1015"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w9p78-MpPQQ7kNvwFIsDKN&_nc_oc=AdpM1lKPZjZN_P11rRog4TjvSbq21g3-kEfOp2p9hapySDfHyO6zTJD69bdW0W9Ls4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH02pOnbP5lR921SUfETE4nXnZaYwVi-bKip53-02v6ZA&oe=6A8C179E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX6QKZAE6dcQ7kNvwGqNHor&_nc_oc=AdpBlq30wHtIPx-1fcVXY5Ql3Ion5M7RpG_2r8yEajlxSu9pSs_tDmRSrJ1iVaw6TLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnHE3bcO_CBGeLXfgUQxNVqjlKHaMdRu-rmaY7u7EY9A&oe=6A8C4004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wk54qR6gL8Q7kNvwFs0eHO&_nc_oc=AdrGaY38GqGPW19Wf-QWaTss4ISnjFC9oozHMh55373j_RB-WS6U5oB4g7zGg7KQa4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTMG8GO1ODSUPSJuGjmJkKJ_2HHktyku4cscDNylKN2w&oe=6A8C15F5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
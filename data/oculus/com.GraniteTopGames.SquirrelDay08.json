102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZTq155HoEkQ7kNvwEQP5JZ&_nc_oc=AdqvJKjKi_fZUAL2J2T0iJFhqVSj9KhKMj962DP-DMqY7X3fDDvv1B-P6E9SOU_qC-Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM92c0zu9srt3c3q7Z5LPnrkU-58SPSfLeofMcU4qG9lQ&oe=6AD0FE8D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjksUr21yIAQ7kNvwE8_gBm&_nc_oc=AdptduqvDDcEuQwt7NGbFn_MgJikGWEFo-V8k9uqcClFsVR5Btdu01LQDy31PaOniVs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu-ZhcS-s0UGtkrqkKFAxGZjFTWiDbrd1jn1GHtWIkxQ&oe=6AD0D655"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ytwB_JsBCEQ7kNvwFokaHu&_nc_oc=Adp2-f1s5U_uXUxgtVxam9cpOkfE-fMh3Qr8UYEW71zaQRrXQ6iqOMFXeDtuBS73JTk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOE1gdUe3GRl1J7zrie6RBuhPgxH7q4e8gLZiYyiTU1g&oe=6AD0DDDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Igg_TPAHHQQ7kNvwHDotqs&_nc_oc=AdppMyK2cTdMBAbJ5U3lhWrRFyPsmCYycoVX3H3OLVnPRcx3aY-bQ1-kTqMeYsNa2pE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5G-0TFNOI3bleCTzt6u1U_6DEkGPhJzFvy-LpXQNl0w&oe=6AD10644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEZ5gY9WY2YQ7kNvwEq6nyS&_nc_oc=Adqt7usUdQsAw0NJt_TYURA5GpjqWk5D1H2grZTlv1Di6SqmUMOFVg78oN14nacfpwM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNS1PbqNHcLsY-gLELLTinGRudR-gv0C4QjFeFQgGv3w&oe=6AD0DC35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
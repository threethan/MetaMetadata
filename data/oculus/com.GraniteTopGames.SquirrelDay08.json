png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZAgo7SZmPAQ7kNvwH7p0NZ&_nc_oc=AdojdyYAb3qMhBxFnxFBqb88u-xmZ3-chOVQyiu8DRx2q7mlg0csIDj-MB6VjFpwJ90&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVO5COp7ly3V3ktWzaA4BEr1db2E7PmaAitGW0sTUcYA&oe=6A8EDB4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIF1djLxGYIQ7kNvwEgJw3g&_nc_oc=AdrPpM88UD8XHlOPMz0I0KLVLHoAcXgwTuqxKlaqkPNYWMpyJX46gdTnV_-hxsQpe6Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFC4Iu4QUiUbuDkOLbUCVvw8T51BJidWWKH7rmcMxYI1w&oe=6A8EEB55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w9p78-MpPQQ7kNvwGNW9zu&_nc_oc=AdppkoM2laAYJMqa5nNOdZb5SAt-tKgXdlcdPtau2H02Bao08lmfGG8-VPJOjJIYWH8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJOdWOkIQCmeoCPR22kW3JGf_5hos7NioB2Xs4BxsQbg&oe=6A8EF2DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh82ptThTjEQ7kNvwGCoLi6&_nc_oc=AdrveJXtOPJ9MsWJdkXtIarAOKeiXCPDEBtvNRcaBCM_RmoJmjLo8Ctrk_Oq9choUqg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmWbTGg8jfiM-4LB1l3V9Zh13FVKND13p2Pdn210br8w&oe=6A8EE304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIi2deoa6JQQ7kNvwGiOhBy&_nc_oc=AdrQlSK9GsglPe-_fgvHG3lRUbA_Cf4772Zu_IwmjH5-W5wmIOfIHVuO3nDLZB38Qdc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp24PTbIH5-VczsZRALexkXjLUA9R1JZD0R0Yh-B2Jjg&oe=6A8EF135"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
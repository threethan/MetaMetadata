102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYToeCdSjVAQ7kNvwFwE-8y&_nc_oc=AdryOsPYsOEwBUOqikMqyHuUxDt8HmpDIWFeCXhRXaeTUprP94FPmBOnXfSTRKJ_S0A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhDiP1RLpxj3nmz08tmsNYaGHaIO9WSBAdT5G1gIVXXQ&oe=6A9FFECD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-qziioK0o4Q7kNvwE2Filb&_nc_oc=AdqYrjpXUysVNd2LFaOk-X79nm36pMDtrfHszkDJ2_Gvjkf4gomvx3y1JVXmPUHZrrs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQB44E4-HN0_2_mToFBmAn0Pd1kRNhsgPqLL-l7e8ceQ&oe=6AA00ED5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t93VN-JAoc4Q7kNvwHYTQi5&_nc_oc=AdrFtGBAxZ8AgKzI_zomTFrdA6vFYo8F8ORwF2KEAuFlTw1yMEAIaFDL7I-VQI9_aI0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkDUppt-4DMqjkC5BAa9BQVE2pabu67AvF133GiWy-mA&oe=6AA0165E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN3ul6GfPNMQ7kNvwFPHdpQ&_nc_oc=AdpePw9Pb7AgsUcB9KUhx7czJupRXdcvEZmutbkGprGyzHjEEQ-tt68r-EEUFSIVC28&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_2DryP24Gec4l-f8xfzAdTrju4Ahtuht9OQR0L1YpFA&oe=6AA00684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QZa1_TSSyYQ7kNvwF2hnwd&_nc_oc=AdrZfJcV-iAWNoFHVGRN0KJtFiEgRareJzRXDk5MxvrbToawX5W9oh1us2w6NtJE5xk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIelltZEKEPnaaOtw9V7YqTxFBVgXfXt1z-ygOwq5gjFQ&oe=6AA014B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
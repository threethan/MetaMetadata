-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvTiTUE6oWhNhPV-6uQGgCkbcyZXzGrEdVq5iUoJX-QDA&oe=69A824CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMyyCgaZ3mUQ7kNvwFIDcoP&_nc_oc=Admb66mM0ZPCU3uVl3m1QfG583koPrHjn8LOYsdX3zeSYfkIde9ImwQBvtzB7L6M1x8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs14YO_aj_w7LHuPGZmmJXDZgB_I8yrduQPDh02WDz70w&oe=69A834D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll2jxkKmN44Q7kNvwEyLakG&_nc_oc=Adldfi5F3uq8Sn2AWbGsvgxscKtHQqYTI8ufEewpawLXuz8bbqJLx6ZV8bZjR9iW-fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvrJ6NmzNlH8wqdJe2BzRQVoG1n3oJz3qkRVcNZD9PVrQ&oe=69A83C5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAyQLhx_9Q0Q7kNvwHBM5F3&_nc_oc=Adn7OJailn5MsH_whdy_fpQVVkZECefSMmtshZniyGxzyW92gH8viFczMABndcAxq10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTY4RN27CA1oULKjdcsuLLINCsVKBpG186qAETYmbGlg&oe=69A82C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJXBQ9J-vnAQ7kNvwFQ0rLm&_nc_oc=Admi9yLuIU4MT8e4PVYC9TNRI976TiMzHzIFgUNQyDfJJ7tNyw2ihuB8Dt9LdVbXWGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJZeHnLpVevOmbKuV1FkHq12IrAsM2gLaFq_NjUqURVQ&oe=69A83AB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9464413566941155"}, "
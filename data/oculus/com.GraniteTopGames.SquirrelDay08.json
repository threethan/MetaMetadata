102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTRFkVt-DIoQ7kNvwHalfl-&_nc_oc=Adp9YhrnZG-8N-yQZ3TTveoJeJ-a9xzhfAXw6e7DIZ9jIg0xugqZJpS_wVi1Rt5fVAM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_YcqPUnes9F9tcYqYdyU2FlH7hbq9tgSzLeaQ66495w&oe=6A4112CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgoZS2g5NEgQ7kNvwFbbi85&_nc_oc=AdoFj6JRpqtuYIkULqrQg2OPuVGdeLaIRkmIReExGEBTheQusMsaUHMKjIxs9Rh39nk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HnovbFCHC1TjGo1SbRjxLlPb1riJQ1XzhLZxH8O3QBw&oe=6A4122D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vAYwzj4XBYQ7kNvwEw8kHA&_nc_oc=Adot371Y53G-wNw9eJD-DQKUDc-dxmboPlqKyr6qf6r4A1xALYXgM5U7HEWmc2ejS1Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af983rzJyQn9irRXLGknGfHyL6Bl2HBmHc3G6aymU5om1Q&oe=6A412A5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8P8dBdT4NwQ7kNvwHrDnVB&_nc_oc=AdqmFx2bupVLMEAHwwbn5uzqf2BGBud3IA57qLN3k1dsV0wlT_CjEFMNkH9q-S2YD9E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BoAGKOsDW05SNTr8givWAw4ocARYYgBkfA9Lzu2rQ7g&oe=6A411A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0HlcPAmndsQ7kNvwG4IEvP&_nc_oc=Adp4FcS3WKn3gNXqsLBfEIFfiTIGWFFmzOqGAP7S8bPBPG67yQrzLTaAaVYUP3E44Fc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8JUzCS-pIE0Cs7Jlwp8VWlsM1f3zycl5W7bdBSFYjLQ&oe=6A4128B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAd9fSFX5TUQ7kNvwFienPb&_nc_oc=AdppEaScWcbXGvvt1hnE0FCEAC-YB7BRTDiq0X7IoP-dTQJk_yeBdWnjvdBh4EGfCc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe7wQSvQC39Drs3bFbkPp0XCnEUaAC9923LO-VXZNq2g&oe=6A52364D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nKPDB2CAp0Q7kNvwH4e5o_&_nc_oc=AdqY9sV7_GnSnbCJNEMwSqAGZNUCTbyLnIkNg6ckWOp1oLhY7HWFDGp7X9OAwP2dhIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7qU8bKnjbRT-0kY53tkiB3sAXCxbxtibLFF6IACjkCA&oe=6A524655"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZxToj-DJQQQ7kNvwFUrOt_&_nc_oc=Adr6XKD6UNTp2uzkJ6tOc-5vf76oVmHUnqoiic7hrhdrZwFfBS2OQgGW_j0tiNLfP4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzTC5GTZ3vL79X8WCtPZAxbX0udTpH0uNSY3wvEuKAZg&oe=6A524DDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI-F3OBsOzMQ7kNvwEfjPFR&_nc_oc=AdrSM2p7WlrZk-1XibNQO5Lr3M9CYsxU76eAOX0kfdNW7Z1GTYrndUMER5GxO99Tqy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-fN0ld2XBAKzsgKFqSDobWlqx7oY92lHwfU4SMHlXTA&oe=6A523E04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEUnFCIg4r4Q7kNvwGJBUbD&_nc_oc=AdqbtonxZQiRCEgZOdPZj0SmUhX5PmdausRvH-NeSGThCjoFAIR_IZZ8WcXT4leDC0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBG6M6kmbjhF_GvOJCs0Yvlzw61_P3lUfLPSJAZl3SaQ&oe=6A524C35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
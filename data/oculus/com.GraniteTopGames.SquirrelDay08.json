102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSqBhVifPjYQ7kNvwEHAKnZ&_nc_oc=Adq7pFTzEb2VdhFc9Mb0dYUPxwtbEafdmSAH6DYhs70n2pzQ_U5-7jSHPT6-XYo5qmE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8ftGCT4Zqz6f1sF0Yd423tb3FkKwaTc9Fa8ZmAf0b2w&oe=6A917E4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUTcdMnzFoQQ7kNvwHkaAoO&_nc_oc=AdpRzGt-WantWP-wii31BcBmMGsxqj2Uiki-MDVcpEF7HR76yTdlH59AC39NPthJVAM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDMsmwU7ob5_vIq1jJwu4FK_OKlgBGImBJHt_fiBI61g&oe=6A918E55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXtWD5cV_rAQ7kNvwEKP0EB&_nc_oc=AdqI8aRvTTb2DO_txfUVXfc7XX58Q0i5jqgLnrQgVundNWzGf2RIDgR2A4_PgXYxBEg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErLYVICLH-oO7bzGOToeGQtGaj9JfH5HilBpdgzlqyLA&oe=6A915D9E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_H5dkuIhJgQ7kNvwEshHeK&_nc_oc=AdplHxHWPBz5e5f6b80v5MronkjEEoN7LKpJW-Zy-ny2DMExddLtAWDqHOHQ7VYnMw0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbTvfUinPPzC82diIcbJDJWOateIV-blmtFNB2AQ-g-Q&oe=6A918604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIi2deoa6JQQ7kNvwG4PFJw&_nc_oc=Adph8hAL8KQQsXgMqE_5ncRl7f07oxYtTYjSrGQ3eGgzzv1T8tUjwdsr8KaUy7ckJKM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETe14zagzfgNmgepM9oFs82csDQjOAcg8oJ_gPdiqS4Q&oe=6A915BF5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwIoaNW-JB4Q7kNvwGwsGGw&_nc_oc=AdrT_W-U7C6yM7Wsb6zYRyxDrBeD38EcEfgccbbN4TE1OJVLfB9z4B-D0xwMq-3WYvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9EbIoUD9tdLe4V9elCk9oWaRrFibQ46nBbSm-lt2GGQ&oe=6A95E34D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GIgB__3sJIQ7kNvwGULnMC&_nc_oc=Adq6NecSpcHucLVblEX8VYFDalBCLX1O6bKNnBXfLEjPNXvbAbVbAJat0BcofpjQWxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIro9wXhAkNcLesTtN2-dI6Bdqgajp5I_PbHgb7Pq5pg&oe=6A95BB15"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JMTk_l0qyIQ7kNvwErLC9B&_nc_oc=Adqromdtup_ClZCZZwo21ZND5Emv-2MQivXlUmWglYpUGndYdDp_wlflUA469YaUFEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMweTOxdDtG3T_ceXctRVMntAR6hXD0QRWF1RgvQY3UA&oe=6A95C29E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyorwkgXMmEQ7kNvwE6MDz1&_nc_oc=AdreCSP-Wd8IwKjg6lQyj41DLl6e043ICu2rwmbuAz9-J1ZtcS2_Gu8Q_YDXuaRhswo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWOO6CmeAyAmQNjXpl2VzqcFwVw9r5pnxCi9ZXgmVZ2w&oe=6A95B2C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pay6yJRLjMQ7kNvwH3MgFk&_nc_oc=Adp4pws-rbN6IVbLSjvrp3moRWW3KBtH_KGkyj-8GLTaGpeIcXS1vsMdjNjcMn9IIs4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdMMa-qHZgR4Ch9_pbtVZlyQ4dhzdu3ep-rX7qM3Nu5A&oe=6A95C0F5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeTGoqqZxo8Q7kNvwGBci4H&_nc_oc=AdqxNOAF7CHCX62fqDO1cZJxZErgnPzEldQ71Q_l6WtxRt00lB588ObflkYlIarjyyg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6KqeZBsDEerxMFeHArQh1f9OaA7rXrew1N2u-AfS3yg&oe=6AC5210D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sroHS5-XP9AQ7kNvwE7tVct&_nc_oc=AdryTgg5viZAMf6A5cgQ09xiCLiQgvFA2_BrGz1sWP4G6_SuPaO6CCaYh7xB8WCVufw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNx9-GoIoedHnffUt2fyxxoi-v-DgsYqtrl_SNXeTjoA&oe=6AC4F8D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_1-obmjGl0Q7kNvwHU8Qbu&_nc_oc=Adovv8Lxt2kFcT7jbzQDCugTE2BNaL6Q86i29zs2nux0U9TNRGDPlGzkkCTRvFnGhMQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNgpH7dVunSiCaJGOBU0-6meewZbjVWBhnckGgsVQvzg&oe=6AC5005E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9AfIZpDdN0Q7kNvwHacTkt&_nc_oc=Adoe_oE7IqDO3AyOjHIlE1Xc6mVD1udanH0Hy_EjcmuEkI-z5vCYVIHg8wFwev-tTlY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdCAMnEMU_GJzwTPRReZKL0WM3iO7zVP8O3rtmXTVh8A&oe=6AC528C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmtATVEFEQsQ7kNvwHVVb29&_nc_oc=AdpIdIk_7VriBPYJhedYGoLaDe9g7X_XABiEXpvhzXYFs6_6E9zFIyw-DzICQdhDU2o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3sbJgeuQit3RH_21UtBlq4X7wP4c_6j6RW2uyLi8QkQ&oe=6AC4FEB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
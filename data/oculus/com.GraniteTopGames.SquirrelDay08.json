102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOj_GfHZ4v4Q7kNvwHFRQUd&_nc_oc=AdqrYnvfnVLjEUfcmNqT0ZsUyKnrFQI9T6cGbgeK1873VzudQ-amKXMSizHgLsqML2g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7qMZdR8Bo6dg7nLczjLlqHvf-5sTVdm9cztAUt059vw&oe=6A805ACD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKVtBKMMHYgQ7kNvwGUKK-Y&_nc_oc=AdqppVBqpegtq9QyoxiJU1KPyiCeFk4EqUyVT04j_fAcEOgiE-5PFWqu_M0JqTRU7IU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFNGiHFJ85JrOYl_sC3Kot5BTJeXhp26QjdGzRWsnnsA&oe=6A806AD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFX5H1jG75MQ7kNvwGXLnCN&_nc_oc=AdqQd1mHBm3HqxLqHTLY4yKQkIItzrRUZRHljhlqnpdzaPPBrG1L3UkvB2dll5nUJbc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEejq3OGcaZmvC0MxuKV7ecPKhlbFFTv5akUaFj4hS-Sg&oe=6A80725E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXYUNBaPLqgQ7kNvwFhsulE&_nc_oc=Adpg0wuo1WhoFATzrTbGQEYPzN9R_3pXJugoJqAqsDeOV_ouv22smmKILDdBZu1utyE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX3ZUJMAtOReAU0tYW_0yOvSAxFp_U_5eZ2E9NkY56UA&oe=6A806284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSOKeh0et6sQ7kNvwEIyURL&_nc_oc=Adpb5ryYn4YSuLhxpPaH5yLaqBkmzX637JFsAJABaaea5od2hAoio5dSBrrvA7m0H7U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBubr60PuDBLz1g9s7a2NXQ6KBctcDCtrIB0VVmcVbig&oe=6A8070B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
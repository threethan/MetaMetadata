102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWU27RTXr2cQ7kNvwFo54yn&_nc_oc=Adp-GckdOMIlFKAWk9HoWZImihVrE8G-dV_55SRoOwyTuGdo-bf8GGcHUHvEnVxJSS0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv4N8e08E6VrlD3HTvGn0_QKWQ_2L2Edeki7zxmt5GWw&oe=6A65FCCD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY8ovdry1UsQ7kNvwFIvTp7&_nc_oc=AdpfvoUcw9PabxteG_ROA9mjqvfyh0LJWNERu7eAaVrKn9zZkXipdNdzNNCzl1xYbgk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByhQSyqINlJeZMSSoarK6GszqiJKePzV6uRo4n87x8uQ&oe=6A660CD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptBm7P_PITEQ7kNvwHYtVaj&_nc_oc=AdqQK4Zl86Ydhi-h47J6ElO5FMC36fJFJzgwZ6B4sKBBRxJfwsQmK_LAEA0pFUXeoYs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxATurhw47nRaXmRYFBkaqkdr6bTlVBtO4SSE1i8qnFw&oe=6A66145E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbBgPY3b-C8Q7kNvwFIubjr&_nc_oc=Adpe1QSn1CRA9dCsG1r_gzIUbDjaFi9itj2YTNtypYdtJiV0M-0xT3y3aq3Ro4hKIdQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsjrTScLOdNGZDn5ARDOn88ei8bwSIcwrQhrTOMY1UBQ&oe=6A660484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0MnSC1jUi4Q7kNvwH4gw1z&_nc_oc=Ado71pbNrxf-K9diHzU3a5pPT1LBvfJTYjIwTmI5_c-pCINodOozyw2aZVFG-bMU3Ng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtjQuvMB37Ip86XFOsFK_KzFxCnBcwHDpmrY_zZyAy6w&oe=6A6612B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
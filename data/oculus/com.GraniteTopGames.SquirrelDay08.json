102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvE0Cwhg7iYQ7kNvwHAmXBi&_nc_oc=AdqQy1w23VdFpurosQswIvJ9Et_Nb8Y00eaYto9_7h7ZOruwp0SPu8liYdKJUBsHEOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzR1wzplsZ2PMPZTHqEGTA4XfNK2NI4v2xplL9tJP9Gw&oe=6A747D4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoJ8SYP1XYoQ7kNvwFPMDuL&_nc_oc=AdrlRq6SbwmrrkHUl_x3EIWnVByILGsCtZKKjIDDyI3Zs8wwHLh0YkQIZ2a5XVUykMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFopjyT6d3_h-ar7YHS2cQ9hVIOLY4xMnqeJl9yfIehvA&oe=6A748D55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA7GLhqkaBYQ7kNvwED4AHf&_nc_oc=AdrHwRXTi-9_DMNLVJugaarb2zmKRE9l43_gsjJbFtIhQVDzWVN5B458WbOhKPDWpgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsdreKFjbZlf1OBr7qqmjcWzWVc2uL_OWAn8ZMx_lkvQ&oe=6A7494DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9huP2-pzResQ7kNvwGwhk59&_nc_oc=AdqDQVifodxriqv2hzcqke6ouJ0Q8ZVYlRbFJ0uPRosmBVacHAW9C0PzWrxtG90Tp1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc6rJ28X1FLEcnXYjxLU3JR1skCbGFLLjg_kSBqjYk3A&oe=6A748504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI_fUdh801UQ7kNvwFNV58d&_nc_oc=Adq9rRpiemaooUsGdNP7UFOIQDOEE0MwKUuGM9cqvjzIvxHua7LlaroRzQ0hMK6eSdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQvEdCQUEsbfeeFpvHVTtpeI4T1vOyMsLtkK9yQESTOg&oe=6A749335"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
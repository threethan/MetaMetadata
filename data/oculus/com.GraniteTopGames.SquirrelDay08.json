102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTmDx9U5ZTkQ7kNvwHc8WZ0&_nc_oc=AdoPbIzggJpe0VrQZZHa0kIl3AuVFCX3aOpwpMK_CBs0TvJe2n1W3cZ_fK0IkTHPHDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dNYIzuzbfeOSoVstrfjooRdo02S9RqkJou7GfKPQIGg&oe=6A3EA80D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KVlxh3K25YQ7kNvwGCxSQN&_nc_oc=AdoSlRGIuaRWFpo6HTYYfi3y2ZIu5k4Pc7ShVDJy4Sp1DyymIbVluoavQiJxcGJ0L9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_A-R2t42VTEtzUXT7FrcFeCw4I9kwZC2k5_H8szYphA&oe=6A3E7FD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3Fg-HbQIAUQ7kNvwEMnyWZ&_nc_oc=AdpInWKtdDESPyYwjuAVKTEPlKUaaVhzIScxl6HAdzeuQwKBOWD9spRUgBQQmG61dhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ulczfc5ofzaHNQs2p7H332FqiOOYcnnE7bVZHqy3Csw&oe=6A3E875E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8P8dBdT4NwQ7kNvwHwMTTX&_nc_oc=AdqjN4wBBnj6tqS8lHxY9-gn8lUunbQAHl_1PytXwQaCHv1SS5H0hkbFQ8XSc9Hueck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9APze7GPT5XqeHq2kCEMGTFrpM9o21MU_tSERLvgkMBA&oe=6A3EAFC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyUZK0MYtwcQ7kNvwFUv_px&_nc_oc=Ado4iW-uLhhH5-lu0SxB-9RZuHLEyD3amAXIbDsXTB3FCMwFzU6bRCH0QRNt1i2XYhU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MzcnAjFR4zNJirWTMFGVSudVYHo7IDKEx53JULdCVow&oe=6A3E85B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
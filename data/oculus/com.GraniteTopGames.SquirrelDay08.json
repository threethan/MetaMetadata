102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJxGcmmDbGgQ7kNvwG2fpVl&_nc_oc=Adp1eaB63D4yID7I8CxmvX9F2q9iyGyeujuxm5-atw5O7gIx806XWMyRxiGkuJBn9h8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nTGXDuChnm3zeLuwJ1nbuMmAbB9U0ny4p23ZpN1X2QQ&oe=6A26ED0D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXm_4HDozgsQ7kNvwFnAA2E&_nc_oc=AdpKsimZV3zy321WgxsUmF1doeKbMGXBiuVkTGuZeiTYq11qwmN0VAxRlkKaTC5NiQQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DdQ8lV8b-Zctlt6Pv32WtP6BcNsGbMakd3KH5LdPJDg&oe=6A26C4D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GKUROWbi8wQ7kNvwEpo7m6&_nc_oc=AdqAuaIAvIIwg8N6DiRnrLCPREFUH9oeR-Tp3g2m8ZJ28D1MgrFDpg_AaUJZOkQJqx4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lfQUyZ1p-Q-7pYaP4NLHelYtr44eit0t6qzDCj-vZ1A&oe=6A26CC5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3a-JdYUm4oQ7kNvwEl-b1g&_nc_oc=AdpwndZMLC2-MvlGeHbrCgmuDh-9w1EA1ip4APhk76cPpbToBBm5gj6JfhQ1CLmAf7Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UWzniTneRoFwJ3gjNso4yL1e74iGkFu8rJXL_Yn0TYQ&oe=6A26BC84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaDXvdX7G24Q7kNvwENzMQ5&_nc_oc=AdrlZQkCaIfy-Q5xIJVzeUkWx7KOz77Xle6Lda49l1Al4UpwYKch7KjSIkKS9Fk7hYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fz7hjeUKHMolUfSgzP0v_Sa8S08H3mW2QSxUtiVC9WA&oe=6A26CAB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
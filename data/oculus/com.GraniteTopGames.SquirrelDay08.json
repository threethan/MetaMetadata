102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8VwCCJKz_YQ7kNvwHvyGg7&_nc_oc=AdpKw_GqS932kjPUbWwIAS23CkpU4fFA3dbl2KhVMGoeSCUKF6XIEbZF79P3FvYssvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIl6ZaYaTIrA4fGR-AAYZKEvgLU8p1EKx76324RsVn4Q&oe=6AF88B8D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSxyXftDkxUQ7kNvwHhDheM&_nc_oc=AdqI25Q5FXdMjFfmmX5OwJ4YhC6nLtoHKydkhqNyM4LVBDJriVFqPMmC6tXBMjethHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRmowt1VBEb6jLqMaBMuevtipdffG_iNVwdbqBbFFSkA&oe=6AF89B95"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYKhetvL-scQ7kNvwErLgGy&_nc_oc=AdqgqoQeaqQJJ8kNIoLN8pe1g_qvu3fhP5h0KMYbNFiI6GOJPpRysvVPD8OmgsrIIz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl0G32yk_B2iQSwk4dHj_mZYF3UPV1n3YN_Q0b360ATw&oe=6AF8A31E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr3-vgabCcoQ7kNvwExuhaZ&_nc_oc=Ado2rRtzqQL8Rka0wlNfg8B1xA267J5WZHDOHIWr69GGl5JC2fYVJYaFDlsFSR3Gm84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFj0_BTa-58fwvWNYXC__aMKPxQMCWchBnYe8WKs_dmA&oe=6AF89344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTIbHkEvrGMQ7kNvwFyPNtu&_nc_oc=Adr12SqihnB7a-9Au5fXUgxraS7EMTXEXxJFpPnzTP330fvN60eR5J5KLN5AQCVWXPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAziH-OeQNX-uHCC3K2kkt60dEAlnjKjgx3p5xshlT7Q&oe=6AF8A175"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
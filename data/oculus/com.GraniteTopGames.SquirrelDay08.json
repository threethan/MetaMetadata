TISXfJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-m98gzN1rnwVobVdeN3qSmNZfmxrvHGOjQNa3CW90Jw&oe=69E8BE4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDqm03VXO6EQ7kNvwGGFbR0&_nc_oc=AdrR5Cc04vdxpSCkh-8g4cskJxhlWKW5ILWI88Pr-1G8Q-G2SYIEeJD12JAw7YtiSMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31mtz_dplYpllqsHp3YyHEdbTA7pM3serKGFfiGQVqnw&oe=69E8CE55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9afclsB1RPkQ7kNvwGZD4EL&_nc_oc=Adrioj17GJ8TURbB2lWX4M5vCnns3j5q-NdBMqlqa1HO1k9ls8fG5cjEfsJCpC1nPBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20e8zqJGDelrTNeumuHOUhc3Fw7x6uPLADrKPGauY06w&oe=69E8D5DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw-ffD3dmMcQ7kNvwFcyzDw&_nc_oc=Adrzo5ciLcY8nyXYGcMqTrhahnm2JARJ1pAU8KqZnPpzzbm9bNz-fHyis3CwhVAyj-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y6KGKDRNWYhH4Bq2GxUcoEanrfAEbpp18tP4xfXK2Og&oe=69E8C604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ukp-B8XP_HwQ7kNvwHPoMsx&_nc_oc=Adosi4Wc_orbB9A1DJSVjTardRjyOQmAxBfz74f8m7t3ZqC4Hj2KlgaNSF-m_-Uu1X4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15xmvZpFyE-Hk2IN4_1_N-1FkPJonCPFfJGPOB2Fs9Bg&oe=69E8D435"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_m
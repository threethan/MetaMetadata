102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-91_Ru7MckQ7kNvwF6Gkb6&_nc_oc=AdrVbZt8pJwLpyw6ugEfdqsh_o4yreb-DHgUjHyW-_-Nj8b_LDba13AsTXb2hfDmxno&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G1SGoMbY4clUhbCWIFtxbVnGvBiATFi1vfOU99FGIsA&oe=69FDD64D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jqjDXSUx3sQ7kNvwGDSAjc&_nc_oc=Adrv6YW9wVWPdfM9aHJQKRTctrAZ77Otym6lM4nZLcn6iPdkRDcxpgnRG0eeB8etpEw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TR5YySDfqrgoHokivJKXHAVhidhfkuRhIIn-2GC3ASw&oe=69FDE655"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn0GBWxj4esQ7kNvwHX7jp3&_nc_oc=Adq7ki5GrXq96C1ZIXH5Txc35CgeHJYaHrhvGt6LbhUZuhU5N76XtN_2vOmOi_BvBW4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58mwZCOEqV1Nr-IScz86Lnw33T357Ef2gxSvckl66fCQ&oe=69FDEDDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bBd4bRZfHMQ7kNvwELCNhN&_nc_oc=AdolOJiUTNM1w7MCw64uhgRMtFEV-MO9Fvx8Q_FQQlAOR4MKZNCC7U2ul2C2n_8D0eQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SVDJGaZCDK1ct5p6U6ursvL5BW9g9eUr6-YovEHPq0w&oe=69FDDE04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Fh28KWsp8UQ7kNvwG82eMR&_nc_oc=AdpRgefJllzDSP7p0GHllnC6dtqTkMhEi0OdkjuA2jORFqjtxlpXT9Lapy9pbzIJlQE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55O_DFLNl7otVv9ka_fi5Oo5kLrM-LKmRARq8mhsTXlQ&oe=69FDEC35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
&_nc_ss=7a30f&oh=00_Af0t_4qlPrAYQY9-14sLIhqT1-TQq0HQNIiI9MGvPeBXyw&oe=69DE4255"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW830J9zKfsQ7kNvwFodjCy&_nc_oc=AdpIgs9UQJz6Fjk_UH8GRvgQLbgoRV-8AfKAwjwv3PemEOVMr6PB6k1mFCXGvzL0Mn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q7zHoZ83yXpZH7arPLNF-P8I1I7gCkk9cYywipRNKDA&oe=69DE49DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmTZhUtQgGwQ7kNvwGi_k0d&_nc_oc=Adq2gEUaQ35yRTwY8LGpQjXoYk8rjNhtXgWKUzwYbdBMD5fGQrQ0aieW4ju9PMwWIY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZuxForLHWjrfwyWl6LN0FFGpvZ8xNZjRSjmnx1MF8YA&oe=69DE3A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34qUR2SS6wAQ7kNvwHsXTsR&_nc_oc=Adp-Ti4l5DDQ3RwBljBAoYfVQ9VPz2XLkudU5fd0PVMPQUmx9MJn5FqHy9FjJvMv4SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UktdQ0ZPPVGI6iyAWK1H0thhMhrZ6wjAhshNIW2roYQ&oe=69DE4835"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://granitetopgames.squarespace.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "https://granitetopgames.squarespace.com/contact-us", "website_url": "http://granitetopgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1015097849111332"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1626713524512248"}]}, "baseline_offer": {"id": "1626713524512248"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1684168317, "status": "PUBLISHED", "id": "1626713524512248"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6940102922705578", "version": "0.9.0"}, "id": 
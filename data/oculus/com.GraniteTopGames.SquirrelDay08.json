102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7yJgMYliPgQ7kNvwFWc2Q_&_nc_oc=AdqtSKdzlwhuh40yEsXORaLulbNqSiHW2To0_U1o-hqS42eRSVDS5DI-988BMIXIwjo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJRZ90IpE8YO_66rnuP3J_t_gdv5EQ9qXMH04oChhQkA&oe=6AE1E9CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGRhxk9TSi4Q7kNvwFDBIG_&_nc_oc=Adp5ZjWH9aiTIMXksBDuG6quxFBGW3tTiQvB2zp3Ji7j1DlcfrD0Ww8irTNxo-1lPHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN6tdf0UxK8sZXsVFjlkNDNIKj8Fpqj8GgyMZibRGiBA&oe=6AE1F9D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-ofbCAR4KIQ7kNvwFSeEer&_nc_oc=AdrVNrLWvngWH2HfIhWmlYKAnhXBSqA-igZKDfoxapDC53N0RcZgyrHesNnD8Ccts4g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMeQJHXf7q651H7h0wS4ez2ZNQq2sDPHpsyy50XIAcPQ&oe=6AE2015E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmKuDLp5zwEQ7kNvwEGX0OS&_nc_oc=AdqqTwg7whJuP5wnmXRuZ3Oe3rCkDYw_NuEs9OVDfY5lHO2zxmBZl99cbcM7sgi1H0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdWif_x18OZryL_88BfI__pRc7G3JiVDaradJBtOTZzA&oe=6AE1F184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70RoCzgtYqAQ7kNvwFbgBvJ&_nc_oc=Adq9b7Dup_E9VB1fL8Ke82Iohh9U3BoSveyo3dyeQB3lW1g3FlRLkl_R8RbqxkRLIzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3GV1YL54SQ0Y8HXGAqa6rXYg1b5_1qIlI0KHIqsLQLw&oe=6AE1FFB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
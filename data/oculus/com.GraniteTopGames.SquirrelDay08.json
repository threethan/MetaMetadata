102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu_WxxNap4gQ7kNvwGFFVyZ&_nc_oc=AdpZFY8-0m2ljdz91f6LCSFvUu5_C9XnUfNr4uEhoOuzrtIjWhtHLv02qRG5SLKuaBk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII9P3OOtl9Czj-kwPskGkofOg-YKma2JeCvPazoxNPUQ&oe=6ABE898D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7p0SWr1_g8Q7kNvwFM4t1j&_nc_oc=AdpkQk1juIIaEGSR5K_0BxnKtw70n9WOw_nQc16wEaqIAz9deSnqAcay0H8FAK6dVHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpyCGlrPlfJ-eQbAOJZvdW6Akdoky_LQTqeNJYGcVTeQ&oe=6ABE6155"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHQ7MgVyifIQ7kNvwGN1zKv&_nc_oc=AdrBPQn7OxqjCePhq1ebTBR6LrXc35aYBDt2KGpRpWZ0v5K_M9SD-Vv4p0yDzwbS7Jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqU19Iu_iQWm0hTHt_2axJKQHyfX-dJQI4uvzAXpTKIg&oe=6ABE68DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09gzjWYJCzAQ7kNvwGjrfUU&_nc_oc=Adr2aIg_E9m2RmnFAsmzAKh4lGlFC1_osNfk3x7GeRNLri2qPpMGobp1oo4QRbkPXMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5hSWFR_WALTBj2XvZUGxt5d0vRuPPfCDq8Ad_pCIxpg&oe=6ABE5904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XA1y4zs1fLkQ7kNvwEBka0g&_nc_oc=AdrnrLOhC2QVmfOpCr_8Gmf1230RbVs168ArUgnvBmAyAPqyZDN463dqFB_E_-hvLXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzJB-LXomORO4wWbNSsd-8WCshlRBRl-hjFWb83o0sAA&oe=6ABE6735"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfTeLqbxzj4Q7kNvwGNPapC&_nc_oc=Adplr1rD5pJK8RLqLavpPI4qv1_a4vHXX7vHnq8cinQoSFvgmzAwBsddHa-NHafYNvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qMd8ifc79BmjHlpe236GcFE17PylBigmykrtrw3cD9Q&oe=6A2D4C4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRIOwB8aDQcQ7kNvwFAG67y&_nc_oc=Adr5qMC08rZvLRjyMyxDW2wjgVrzB1SJER3_YJSaVKIv06Xb-6QegbFpnAzs1jkEV3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B-Z_M-S_qyBHZJWemfrmGCiKsNQ9xelAdPsNw6NQCYw&oe=6A2D5C55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-ZrzQIAAi0Q7kNvwFK7dHo&_nc_oc=AdrK-9xOQnnVY97DeobML6DEvyOlPlpcqbx58b8iT-znBoPGExlRpMvq8nUKl0FckSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c-7A5uZNIpY9o3Jqr91AmB14sN14NacbPoURrcNhTnw&oe=6A2D63DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac3kATwRx_sQ7kNvwHzV_ec&_nc_oc=AdoLkbE-C45Fl0B0h6X1jf8Ufjwk2bX0iavchR2jeJ9weUixp0TRDSDGzP4GLnCeO90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B25K_nxeI-OIemlO_icxZ2Chei363Yw7cB4WAHkO0gA&oe=6A2D5404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jX95272Bw0Q7kNvwFpQtCh&_nc_oc=Adp7Fax07N16mlGwCgGwbgCxf16knb32uD15jSd8_XPFqdsiUWuPdfRW4S-i3o_Inzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o9Ra0deeJ_W1OkZZuXZL_8NhxQ6_jKAEPhnz_WViFjA&oe=6A2D6235"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
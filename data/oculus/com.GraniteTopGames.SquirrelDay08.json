102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QueaGxHMZRgQ7kNvwFaq15E&_nc_oc=Adr8NJ9M4782aXCmFMnnpUJCk-iUYxzdjHVV3icUjjgimRH-o52F8Iulo8SzYIxonf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuJwKPF0MfWfYrfIVAnhtnJEzULPk2GMpq34HJDEcrrQ&oe=6AAA8ACD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIJqDg99x3MQ7kNvwFQLvcr&_nc_oc=Adr0vohAshyX3dhbr-MgX02qRYoOlq2sfyZS6LVCq_rjEqTiSicfMy0cJI1xmQ-_D5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGhwcwQOLnHbIZfNNU_0P9OLlh_HbaLYv70nY0UpldXg&oe=6AAA9AD5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXBEOr-utmYQ7kNvwGcoB8B&_nc_oc=Adr1uRptxY9QNuOfAVEraes4xiVvT_Znwoeu-5g4kNSqL6gCJ-9oyiFKIjLAgewSKpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNuqzEIVWfOiivrdxe-VImIEaOcpDh4MpahbvrJP99EA&oe=6AAAA25E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdQCP9hfD74Q7kNvwFMIXjg&_nc_oc=AdqFmYbB2ZJFpnAEkk7ImM3gB4yOCXIjQ7XBCXen9dsjqcsUDRfSlByKJifub6YGCo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWftq-1dZMcVbENdz4_IBnEp-vpYFPFz8eic3kM7TvGA&oe=6AAA9284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxGhEqD-OE8Q7kNvwEXSpqR&_nc_oc=AdoEmmdjF4ghwvilgujVRBwBLIH0LWzBqyeP27bHzr50VqGUS6gsWSRpKitIur3QZa4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGJ0HuB571UtdQF2tuZB9xjtVyVSUh3czHKamYffgHaQ&oe=6AAAA0B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HgvBGs4bioQ7kNvwGUBA0y&_nc_oc=AdqlmtL9t5lknJ3cVzlKokl4AlOAMbkExXJkoln3HlfwZGMc68-nsMWxozmQpa8xkJA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Dz_Ojozkyy_xJ2CcCNzuLGBvDxbZnCEcKnger7yi-g&oe=6A32924D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSWR5SnpLT8Q7kNvwEKv_w9&_nc_oc=AdoI21BwzUDT8_xPen3Qla6_Q97wR2mv6iaoJr2MmdPyyfl9yJTKXiHYp_qLHhgJDr0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98TjjhEZwHZ0HtCGkCBGTjWaDuEno8QoBhDAM58WRoXQ&oe=6A32A255"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZMiaecBWxgQ7kNvwEwNGP5&_nc_oc=AdpSr8zeY_yTqVm3weLoQUatSYZ9gkJw95CAJ4glyGM_oEVYINr3yoCK11E6dJYHRIk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-pEOq5yDQoBWJTUrcXlXFxSAE12nSN6qyc_WHe7xa8w&oe=6A32A9DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcaMd6OaECkQ7kNvwHoA_rj&_nc_oc=AdrbNQKTpbGqmDbg5OGCJ7iDBglmzqVDpFZa05VMmj-_eZZARQQXxdMvRPyTXUOuagw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mxEf2tXk3YP1r-bKUu87OYn7_YyxAl9HupU4-Mp0o9g&oe=6A329A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CmR7Mr2OpoQ7kNvwGeNz6t&_nc_oc=AdqC8XBAHVN1g-_r1AEgju6mnpY5a8dpK2QZ7ryZ7JD8t1kK8Trv-7WLvFTXT0E7UDY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99bAhtkAJ6J2F8CSv6zheH-a4w9srgjSBDchMEfN8OIQ&oe=6A32A835"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
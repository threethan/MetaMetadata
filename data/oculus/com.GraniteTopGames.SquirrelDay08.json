102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgK00z_LRBIQ7kNvwGTnWTu&_nc_oc=Adr1RLtIim_vP2redU9XUXS5Jxgp12AV8tv8oDuOHb9lEPC74YxUylaXJ7YFK0O7-W4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLyByDlNhwLKne5nZ--BtRR_HbJgWrxxf0XRB_KYvfgw&oe=6A9AF10D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSGAnC5dA0kQ7kNvwFluhMJ&_nc_oc=AdrTssURdQpqPNMieLiipVRY6AcPCB9zCvlYu1vekgrJKgvYvZvItIsiHfG94Qp24GQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtucxd1dkg9UiTVvLyVulduovJfS6a5lVtb5nXu3OohQ&oe=6A9AC8D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ox6xvl7IXQQ7kNvwGYVLF1&_nc_oc=AdqouuANelNj2ImsbE7XEKR2AtZ6ujAHbwQ10RneB7bq7fLAtNZyl496iv8iwnekb6c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsuMqgIBd3FNo7EmW5heAKK70bBksXjWJmNL4391eq-g&oe=6A9AD05E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OGmlTWhZ28Q7kNvwHnXgbL&_nc_oc=AdrAo7D_FelH2800aqqKX2zg8E-7dN-Y74UQJb4iMd2rRXA6bthFjAnoSmYGDfRGixo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKih_P_xMOD_36AKXmn5vVZG8dcfuRyVDy2IjMXrt3EWA&oe=6A9AC084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngs6wNo6xTAQ7kNvwFbX-jm&_nc_oc=Adq3G8copYjoExbhvM1Eva2YYM4t3lbEZ6q_0dciX7uonTO_J3SoYRT02qa6qL83pu0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITZ9PrB-qwHZoR6gMkDZ903Sz_G73caNFTx7nepEYPiw&oe=6A9ACEB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
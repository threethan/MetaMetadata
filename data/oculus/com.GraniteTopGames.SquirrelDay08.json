"GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll2jxkKmN44Q7kNvwEwLFJa&_nc_oc=AdnDzybs1NV1ZLHZMafe3PEsE6q9OomJAICsq6gYTO6gfPpBILMmlq6egKHsRAnXpJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv6wnwE-qdRTyt-hoceNmNcx4p_a55wlQQz0oDPE7OQGg&oe=69A98DDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAyQLhx_9Q0Q7kNvwG6WLNB&_nc_oc=AdlEhVG_ZYWpB8Pq8-_9aQscpv-PmC1ksrP_0b2zVpsuARp5N_b9BBNr8j5CimEmEgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_M2Gxhc6DqNGRmnkdK8ZPNKkLavGYsWmrA-tj_X16Dg&oe=69A97E04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-vbNCzPgQoQ7kNvwH0PDN5&_nc_oc=AdmQyxAPbxWVT72huSVIOwvwyNtoOiuwDrFifU57gs3H4-XoseuDAu6SR9BpLVZw37A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsw247h-bX3Wz7VsS3grXda6ihCsyibTUdMUCxhQJ6T5A&oe=69A98C35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://granitetopgames.squarespace.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "https://granitetopgames.squarespace.com/contact-us", "website_url": "http://granitetopgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1015097849111332"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1626713524512248"}]}, "baseline_offer": {"id": "1626713524512248"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1684168317, "status": "PUBLISHED", "id": "1626713524512248"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6940102922705578", "version": "0.9.0"}, "id": "736921681021994", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hnz23xKcJQQ7kNvwH7Sq1C&_nc_oc=Adobu6xtWKVfMSAG8EYSU52GCQ2eWltRMoyTpi_Dr6mNqs6jKgQjxZ--p7a2GOOHEEs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDCZpNk4qg1hagIDbd0QfGpRd_V5IDahYqkue-aVnT1A&oe=6AAE7F4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OpCo1uBlpIQ7kNvwH3LB3D&_nc_oc=AdqKT9byqZKE06goOsQdHl8fx9Gtedz5nl-fAS_5swS3ED_K40nc0WUQ-cRcWeiYI-A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi9dJPDp-CG_rIoOJjLyjXUXmNi8cdiwjqr7Hsay448w&oe=6AAE8F55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6wsLhTyOmwQ7kNvwGqQf-A&_nc_oc=Ado5nbR77ApjCp4DhAlTntjg_Jqbeu01bGrk8G5pbCUaMyFpKIilN5mWc_MowFITRFY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8u0umuICKRpK9eBcxFmBXhVcb-T9RaCylbNIMxwLMXA&oe=6AAE96DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBRhtm3cxnsQ7kNvwFi1ufz&_nc_oc=Adp9iYwDuDyYNsq_2Z9JtTI7SjPixfQHP_5iIAAo1hOQg7q-7F3Fkk1eaU4hmCqdAjA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG4ROzBfTEz6hOuj_7v1vRyJw9OuQysr_tn09shlnjsQ&oe=6AAE8704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2x0jd5t0DusQ7kNvwEABaCn&_nc_oc=AdqXU6hh4ikQg-fYsT0ss9atoW1-PX_xUDKjc2U7Z5XDIimDjRjDBDTCsAH--Opm8LQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeUAM6xm31_VrZdhrPjuLoHor-npuw5dlz1skG1XrCPA&oe=6AAE9535"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
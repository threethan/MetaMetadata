mA3XI80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xi3qceyvpQIWAb1dRpYbLA9Jemu23NYBJIn3OD_TgOw&oe=69E4C9CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UserLpEUmdEQ7kNvwGYqVpM&_nc_oc=AdonBWT-GxyVA1BYrQnH3JRw276B7Jf8L3wV6XTjpLQHd2FSQJLTDaTxl15gHBOYCzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pSla7oVGNogT7Zi6ysZ0fN-tyk67PO7uEAnhLUbAfqg&oe=69E4D9D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc6GfK2mvjkQ7kNvwFSqr-N&_nc_oc=AdpxaL7bedI0rP9zmYffAp3fiQ4JnxUYV9UmPVRQLJgWw6IIfds47ypTMxuyNnjkNUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C3cySskLOr4S_FfEaftwdcpBSpsXj3ZbSjah-WOKZGQ&oe=69E4E15E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w52lD0term0Q7kNvwHwFZQN&_nc_oc=Adqb8pHcVg5DMhIggEAVAgi7V3NrWwio1obsKILiCu1C_VjV-sNM-Mb2NjL6yz1GuOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iNheO2agyNetIFlkN7K9voHYWa1ugHNomBoNs1fi3Iw&oe=69E4D184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdpt5ZhUvRkQ7kNvwEwl5gC&_nc_oc=AdrcbxoS1fOqS_5PBhaUshWTRqTtTRvhiL10efbWHAh3E9ARqp8c9-fVuUf0F5czBDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iVGee8PvJZsBlKc6m8Gag_GVSssVMm89FRR9xXKQMhA&oe=69E4DFB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_m
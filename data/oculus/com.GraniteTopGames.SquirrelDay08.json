102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=133eEHYfyVoQ7kNvwH3JLSl&_nc_oc=AdppuSTWjJwgmFeK6_ijys-XuDEz0V936DQswmldyIkQJ9m1_CQyyNX_UDD4oqmaDQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg1jzJVgrJliaoIu0oE3dB8GztFZ6w6mByYOF2h7Si8Q&oe=6A9EAD4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6MWMLT-_9IQ7kNvwHuxkJw&_nc_oc=Adq0VO8ziiS7WUuTR7nXPID480EvWQw5aZjEmPZAefEurY99XInK0sL4qVhj1W9vNI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISzWzUbTpILU9G00uhCNV4rlx6Ku1Zmu28ayC8A8qvsQ&oe=6A9EBD55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1CiMmXFGgAQ7kNvwEbooCq&_nc_oc=AdrRHuA9WnxY1RSaxPsfwFIT8Ld3FcoWBohIjX0dzgAe3p5IDWsPGeyWqnqIxYnEiiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBrRQZ2nU8WXcBS_QSx226-VowYVGDBbjjGA2TmuYNcQ&oe=6A9EC4DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN3ul6GfPNMQ7kNvwEAfYY7&_nc_oc=AdqG-2y3T6SJJ2D5pLX-rkWxT4YNqJLguCy0rF7FrjdfFe6U0-k12ZhnFLqmqkhbeoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjpq7yzo986wF5K4ZzuH2oS8pIWFjDGsZzP0qQ6qDZJw&oe=6A9EB504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QZa1_TSSyYQ7kNvwHSEnoX&_nc_oc=AdqSj1HTC2-jmIKaX3ZY6WtL6GtZU7iMgvjoKPbEb8h4nkr2OymOpqceNi_6YgQXZ1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjz4qPlXu9AAwkizWJeRUkQzTGwwKBef96xdHxiimNEw&oe=6A9EC335"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
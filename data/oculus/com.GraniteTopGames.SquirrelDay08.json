102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUuUeLjIutcQ7kNvwG0vSlj&_nc_oc=AdpCp8aZVqe6Ysgdv4Gc6HolhSnPiQgFapt_CDyCj06e0l33puwqRCzB7eMxOv1P4VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmXQu-u96qVlVZ2B-m-oaRXeqHm2dzwtrrcMe56HuVhA&oe=6A4CF04D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqhm6OMeZwkQ7kNvwH8iJnl&_nc_oc=AdpXeYGy6Rr-0LfEj1w0qqfVFvYw1_aOhf7sdDCcUgFqNGqUXijkTcGXUf67yTlHZE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGlaTg5JQe7l-2Li_aTVfAFR21zvio8nUoI5TO3YmYSg&oe=6A4D0055"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpvW4J4p8XwQ7kNvwFIcalV&_nc_oc=AdrFTxcGD45H45uuabL9gB4uha6CqPcKOMn1tkgApsVfVPMcyC9LH5p9shnYSGSxEm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLDXz9Cdldri7FefrNvQoz1XN48n4JdLKS_uA_u8DQLQ&oe=6A4D07DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn1Z1gJZrlwQ7kNvwFbKVA0&_nc_oc=AdpeWXltVhpdsCBRho87EVlMLb0YOsDeWSc50zMM6YaGqzSh7Y98QQ_q9SvD618hX1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB_iWCD_5eRHMbzrNE1i4_0DWKsuZ2XUQfsZS6CtRYhA&oe=6A4CF804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anJx9I1zCWYQ7kNvwHHN-GM&_nc_oc=Adr3HmvINGYKccvyU0ll45RODBzpH_dpocRe6Mx7VRVzTGZUdZIFc-m0HK0Zp9o-HvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCECYLuTwmB7Y6ebv4DvJmtW1OVlOzRwlr6bs83i8_h1w&oe=6A4D0635"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
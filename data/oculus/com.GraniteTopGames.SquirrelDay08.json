102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7N3ofKz36gQ7kNvwGHGN1v&_nc_oc=Ado8uYW2DX2VXlO6a-lVwXo0d8FXW3RDb5GIUycZ0ACl7OohNMd-zDD_Ka4cF0XFSBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7lKhlZJu2NLoimvuUJwhfXB202pX98CAg1JgXpg-vBw&oe=6A4A4D4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etaER0XyoOsQ7kNvwGJXsDF&_nc_oc=Ado1yryluG0jqkZD_1lflZk5NQSVtq5UsPxJRy3afPxsGro-Zq9DBa8xvrPEX4HWQag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4EESQ8ECAcNpnuxQzR2c4b_1AdHGtCDPR_ZGbftZyKg&oe=6A4A5D55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz3AemY5bU8Q7kNvwFvrcV1&_nc_oc=AdrC576BlwDkBD3j9QnnL_t4yfFCtAUzAcB-czLcrFXRSBFkMqdAb4CSI7AzfDSOSJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAoeLFOmpdpcv8yulry8bk2o2i8hqJ9BlNCKufD_vMww&oe=6A4A64DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn1Z1gJZrlwQ7kNvwGSb94m&_nc_oc=AdpepeSQCRMaBEv2zh6Gup360DkEPetJktqkuos_0FNXfFtwPP4qrlLdg1JDBC_UbRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs9Z1uhNvhLKR0N_0McxIhu_cMJVTBCtXXIZtJfKexrQ&oe=6A4A5504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAml5gWZcAkQ7kNvwFyc_7b&_nc_oc=Adq2c6sAIgWwIseAtFcJNAygCnxxv7wlzOi1kLqW-AyvzZyq0LOw1OiWZoYhtNHoUOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzIRjyVCpGrcQZq-a0aG7oQZjMzNzYngyIpCHGBu83jA&oe=6A4A6335"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
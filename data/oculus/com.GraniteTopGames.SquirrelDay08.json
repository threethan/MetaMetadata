102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A93ujZzpzl4Q7kNvwGTyl9S&_nc_oc=Adq4VdFPW7umNpt5vAapJG1S-CQZglxSMW8s1hvu9QBElVNN3HXA0zBQZOfdSExzMtI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Kn7yd7Ts6C29w--7W7JBXwpszr-HnRTEfGBhspNQXA&oe=6AD3A18D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLzJ465-ojMQ7kNvwHoIUZf&_nc_oc=AdqXpz-0vz5ymJXGVGfOo6KSEDelc7eTAUknf8CoLH_XG75T7FLbxzDmxIL8MLKXL_E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5gPPHIQp_cJ00FUM44zI8ncNvdQL8GVBu_6b9rNAarg&oe=6AD3B195"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTQQIvnYRBEQ7kNvwFvDtbj&_nc_oc=AdrJRafouvH_cUoXhrPXsTopIq7Wt08ru9hzxzi2oNvhZXJsXH5dUxerqd_60KCm64M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhlFnLv1ZUo2wFyGLfXtSugn-QEhaJddKB10ZsIbM_PQ&oe=6AD3B91E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Igg_TPAHHQQ7kNvwGHfTrr&_nc_oc=AdpqMShE590LBOnl3T572lzgtVzjgeljkGV5k3f1A3PbNcrx1WikRc1WrBpnOh12qy4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkl1nx9xni_9tIYDMzkXvSVtMW-NPJKVMG6HHZEXmFqg&oe=6AD3A944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05Xbr2X2QjoQ7kNvwEPdZof&_nc_oc=AdqFJ5MIJYeU6icwEAxdGci3zF4wS-ItVpC_Mk3s3pVToPJg2sgzk45dSmV1tifS5ec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc8h0GVRYOoKYwNGttf-LGw8bia6aM7k2rKz4qiYk2hA&oe=6AD3B775"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
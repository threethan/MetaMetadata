102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7joX0lukYwQ7kNvwHsWagM&_nc_oc=AdrYp6kM396oaTiZxjfqZrhVqqAunzHSTsp_MJAk91dqkDTbajndSmt5WnXSEnnD3-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNmj9QQUYjJOof-atpyTudivXCcskF6DXrL0pkGH_dHQ&oe=6A89954D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWXgM4jG6TUQ7kNvwFMqzEZ&_nc_oc=AdreMYfAggUdFrHrjQg8Try8QLQGJFNfvonAHlRzBRdMDZsZ8DLrFCvSjPSR5rVaj1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWjNkBC8awjSFK-8ikJQSL7N9V7Fph-Qvbl1mbBICY1A&oe=6A896D15"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XK2R_9YY48Q7kNvwHSTqDZ&_nc_oc=Ado-YfI4opX_4dvnDScgtsv86sOPpLQScIPkJEwMpKnjr8UPTC8mg2ed3vXjOl8tO20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH_O5fcuLLTreeI5vhX2zWN-OHYNuipSXg7KRXgU-zrw&oe=6A89749E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX6QKZAE6dcQ7kNvwGNXkcQ&_nc_oc=Ado6BnSa6sDnSEbc0AC-ufJzGZTNovLGuAlc6wFZbMl76QgxlSCEfgX2ipqPxUe4FYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpgl041u4uor-_HXjKhzwylkDPCjCdx6gdHAXd7nmvhQ&oe=6A899D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ2G_Nxhb1gQ7kNvwFUYp0b&_nc_oc=AdpEvHCCx69ArVBuIgokULPAoiHsoIMxCRghWj0k4r5AcyCQBXRVNr38eT8wL6w8PoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ9uPV1o13xcz11VqD6Qn6tdeYUzd_bMgXb9dw4rMM7w&oe=6A8972F5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
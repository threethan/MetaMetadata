102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeTGoqqZxo8Q7kNvwHjowSm&_nc_oc=AdopCSNFzEvE8d3r1C-8bTItqsjrd2yzSyeM_W_Df91_6WMu3WXm48D1U9TmkUqoC3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPkb9lDYCsgh7vaZ-COtIqE-cupyDdhbCBOT19ctIT9Q&oe=6AC3CF8D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sroHS5-XP9AQ7kNvwEdaKeY&_nc_oc=AdqijqZgizCDR0WUGLMM2y-i8hwbK7BMxAQXWGZjslayV17amLEKb7tT0_Pvrn-K5H8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhnsffMd5C5Q2IUqv3Aupvn-7cMK25VKhBmp3py-sRaQ&oe=6AC3A755"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_1-obmjGl0Q7kNvwFz8R3a&_nc_oc=AdrP_zyl9Bv8t27Pv8fw7DxZwd_9hw5lxwwObaLgr8qA5imrp2_vBn4zbRpaBNI8dWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmlvQ1FFOP1R7djQExSQD9pW1oufseo7RAew0VNRd1vw&oe=6AC3AEDE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7A5gX0FJD4Q7kNvwF_dVPi&_nc_oc=Ado_JJ_aES2tXwAT7Jo1iwK5_m3MRdrS3jYnOA5QgM_odThiCynTJXisCgZLPwHoJ3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyPLXlLnHCIZQO2w_ZOdl5Y2ERxVyeJAzsys5Hs65a_g&oe=6AC3D744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmtATVEFEQsQ7kNvwHmXTCe&_nc_oc=AdoWMxdsRLWPLg75AEBAVNW4qwWMWwdrM_DJAAmyqvjloh6r8AXOQp6ZQAb-VJ-RJFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVEX01sNAb5zveWylQjcRMGJA2yWcDCxboW-a7sxySVA&oe=6AC3AD35"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdp8ei_082IQ7kNvwHn-2Me&_nc_oc=AdolYeq02sDIvqudNrSav46jQWdw4ID1VsBqmcABbeFoS5vjWatnEiqmmiVJQU7mdLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEp4nbJ894hMaQxxw2a3cwEIDv0CcmyVI00pcV95CMSg&oe=6A6B42CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNkGuJ2P8hkQ7kNvwGx5kDB&_nc_oc=Adori2Fe5PtWU693xE9WVvKKN6S-ZSnHBgWBjnJuCr_2XVmzvjM-Hmx9KdovsFimPA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaIlhyloMcISe31XwPJmp3lQSZGL6y9QVWvUkJM9ggOg&oe=6A6B52D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TCwPSvj6MMQ7kNvwF07Riu&_nc_oc=AdpyyrTJx6DNaA8nK7w7BcOF1-XlhAVrNbrdljbp-rjZtx8mUUvRh1Tr1z_6sI2bIzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB-MnksJE_-f9W1VRXxK5d6XVEdJeD8opnKn0gfR5pZQ&oe=6A6B5A5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPcj0C2mh8AQ7kNvwFsy_9Z&_nc_oc=Adrhed9SB2t05CBxKk8oh-jrvXnM29yD77Ajilp6ky7uqWJQbLk9M5g-Fvb1laxBcFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmfs4-qmL-WZlYUA11RTSqm4dZllmJ5r19RDHsQPCcWw&oe=6A6B4A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHixRvn8MzYQ7kNvwF-HH98&_nc_oc=AdrVhpZA9UlYCKHgpC8sJOKKs7lOmbxWPES-kNMC3bzeHcs85owq9pwMCBmKAc3AGWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVlPriMdZeHSNgRByj-gPUnNdlecL1tfNLyd_cAkPscg&oe=6A6B58B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
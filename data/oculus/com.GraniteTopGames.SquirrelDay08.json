102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUuUeLjIutcQ7kNvwEqpoIm&_nc_oc=Ado72hH7iT9b9Q57NFkC-_ExAUAuBtC2VExXBhJM_dOizHg9_q26BYQ4ncUN4t-yoRg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqFKlt5z5o1ZMplrSZ1VhVZN1_hwYrI-8cEErRwk_lAQ&oe=6A4E41CD"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqhm6OMeZwkQ7kNvwGEo2O9&_nc_oc=AdpP1pLRaf8rY-c4VIXce8D8Vbjjel7N4vLclw2gaFYf7kYBwfJk_w0dUGDjjYa2LwA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBdg2A9NeDSvc9qjKnJZQ_7Ro7_4uTUkDvGpQzzhsWNA&oe=6A4E51D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpvW4J4p8XwQ7kNvwHDK6Lr&_nc_oc=Adpdv9cL8LO0pr16bVhMIvVQ8lZr881J9fAH7eEexjmi13jPpL3l_SqHvEyHcgYK3iw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOBz7OGpA8p7zXzWbT2bkndWdSA_r3esjDT5ARCtN0oA&oe=6A4E595E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6hZAEvNpj0Q7kNvwHh1qHJ&_nc_oc=Ado-Jmz_5YiJSH9BPNR5TYVI3Az1G1r5VsKj4k_n7DDwWyHQsmc1x1cmN77GG1jP1b0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0fKZonSWFiQwu_phLSdlRzCkAoAmxvPkE9ZEYvHi02g&oe=6A4E4984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anJx9I1zCWYQ7kNvwG3XcIR&_nc_oc=Adr3ycXgphHq_tTI4Fl-mBC1VsWKJf4vPWyNM5KAWsLA7VtdKu-EXQhGHR7SvDn_Lts&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2XhX3SoN-qY1s3kKmeoLo9Pmv1n4YJsnhJlw6LSDFsA&oe=6A4E57B5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
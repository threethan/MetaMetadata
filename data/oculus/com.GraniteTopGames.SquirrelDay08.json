102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KP4fMHoXnkQ7kNvwH-xoik&_nc_oc=AdpsyLj-WaQkXTQXwDhfzIGthsy7NYe9RYhtidkSD3uR8Kw_5T9WCLpOcJIV2bJc_dM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wTM8jy97z6r5olNwok0RkC4EEWf12xWyuBmDchnZvzA&oe=6A031C4D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lw7hBRCXMAQ7kNvwFIIQ1S&_nc_oc=Adqd7JUsGHkJ0QpBN4oixdsKJAOHKypjov6VAlARojVrKVIYzsVRis0VcpdDRRhVlew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mDJ4VFIE_UblpugVeTfAWpamd_0I0IpS3_bnTZkaZMg&oe=6A032C55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6TrBcdGsrkQ7kNvwE4v0E1&_nc_oc=AdpwK7JALsTrRfJGEZDqBnUHkjbRGs6W6tYGP2Wr_Kmjejtu9bspXFsKtHr_sxv-YIQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45ajlt8EwD7AEZdzeY591W-6d5P_RZ4S-MKMn4Tbc7tQ&oe=6A0333DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxMeh5JtWGgQ7kNvwFr9icB&_nc_oc=Adoqwx4f0-7LVYvpSXZTdonmUVSDKv1E0sUA4m9PXCU6EQBPPbMntvAE6eVZAHzpGmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RY0vAH3L7-hi22orRvMeNxCy_0AqOBDK9zjFQTccBEQ&oe=6A032404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7S8LiqpRxgQ7kNvwE0DGcw&_nc_oc=AdrOM4m0BrdKD6AqKxvY6sM6u2ZGuwqXgBpnRFWobuLswB656ldp3Lcnmg309TFN_Yc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57D6qw4RQDYJNFjPSDO0SpsSH3UE0yXXKZk2BNjInMIQ&oe=6A033235"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfTeLqbxzj4Q7kNvwEnqk0l&_nc_oc=Adp375aSmlvzyGsm6mYef39wBx8M__jhu7cq4IVO-OrfPJ_koyFM6i5XtzGhGe66QTw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w17zwVea9c4Mr_GckKbZDmor_kAvuNkEUt4-sY-XyPQ&oe=6A30278D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRIOwB8aDQcQ7kNvwFsr8PI&_nc_oc=Adrpz79E_uZ7m-HXAqJhYET_0RY_eULWrFocuJRDL9E8CabYK2098VEpAwEkpJaMW2I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v8u1DmBZbR9EZjSZk1UWWfL_XwSo6WRtRTjHy9IQdOQ&oe=6A2FFF55"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-ZrzQIAAi0Q7kNvwHlpDEf&_nc_oc=Adp_c7Cv_Bz3EdIrelyVaN65kNPpGxN2JNSjIGsY3IeR1--hFQNInl0lL8nJEGN9XW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dPj_yzv8qmk1M4FYbf9_yQwAqzJDz80AfkJXoENCJ0A&oe=6A3006DE"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW3UMZzUqYoQ7kNvwEF4mfO&_nc_oc=AdqR4f_sNZ-t7Vm41LHKhCDo1QFkngFb9vkopMMdj6gT721Z8K_p7bXZZJaqkIeB4_k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xPHO3r2VWefNlpDwBLtt_U4WAummCObuTjaUVoh7i3w&oe=6A2FF704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CmR7Mr2OpoQ7kNvwEh7AEh&_nc_oc=AdoZAm99BM_vjGklBfd-cKQotBs4HkQe4Rsz73PCQu7whgS-_fB4M5JBcpvNupOrADw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mQDJVDIokWRRL7UPT7Vm2pLJ_euVmiLjKlGlgoIY95A&oe=6A300535"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
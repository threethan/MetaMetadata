_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9dcZo6PAS8Q7kNvwHInset&_nc_oc=AdqD2ANLH8B_7gzTDgMUDsNkuzt3YADzeRD6ac-YWw6tULMAOys5Bi2VsZMszKJD0sQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j3nbAtkeccaAGkt3kcdUMLsFOFpYbIgGLOpDLPaQAXg&oe=6A36BF0D"}, {"file_name": "CactusGoldNut0.png", "id": "205515035611987", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_205515038945320_2869654996925203880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqDE9qk1JLoQ7kNvwEWA5vf&_nc_oc=AdqSm1bTre-e8XtjqQIwOG2J8R7Fb83TKd5Yzc_YEmhX13BubrZs0kmBf9IM9NdP48c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QWgjscYT8p9G04X4FFEIcTkwAqAaAzPL0BmngjMmhVA&oe=6A3696D5"}, {"file_name": "GrabbingAtPecan.png", "id": "957046472283099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001718_957046475616432_1645005642188217851_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbK9cvCFsEEQ7kNvwEEfqc4&_nc_oc=AdpvUOa-obiqgBuarSA5_onn0mkt5Lwmyi_4RhhGmXPD6e3pNX0BOGABEfaTq3RuWec&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kphklhZ2dkmPLUYZCQS7b1SxjQaQprycE6DSpTQ8y4g&oe=6A369E5E"}, {"file_name": "Foliage.png", "id": "800297351172625", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974549_800297354505958_8952812755140472445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0cdQbxDpF0Q7kNvwHAerEE&_nc_oc=AdqyCA8ZMe3w5T8hMvsTcMUJeiDjCowsuraPXbV3ufy-BqRtcieaQtJoADx3oSVCAoI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_drNeQrgv2kAUYvTaO98s8N9JC6gYA5zYvqxn2WX5hGg&oe=6A36C6C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2337683466433503", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974905_2337683469766836_5984765557162439058_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4lHKZf7EOEQ7kNvwE4nzq9&_nc_oc=Adp8ny8VyJgSMDrqEImrjGucpiI2IAqk5Jjm4642OnRqW4CxKLsu58cQHKUpKVmxZ5Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5rWTVRxrkKDlR-J9qj6NiI0WCqdsygvxaZVGFM1PDAw&oe=6A369CB5"}, "display_name": "Squirrel Day", "keywords": [], "long_description": "Squirrel Day is a VR platformer about climbing, exploring, and collecting. Use your paws to crawl, jump, and grab to travel around the tree branches and collect the nuts as fast as possible.\n\n-- Physics-based movement system. Move your hands to move your body. Push off of any surface to move in the opposite direction. \n\n-- Use the index triggers to grab any surface.\n\n-- Use the grip trigger to point and interact with your watch\n\n-- Use watch to change display refresh rate (72 or 90Hz) and adjust snap turn angle or enable smooth turning\n\n-- Use either thumbstick to rotate\n\n-- Arrow indicator on watch will point to nearest nut.\n\n-- Timer starts when first nut is collected.\n\nATTENTION! This is an early version. I'm still optimizing art and finishing up the level designs. Hope you enjoy it! Email granitetopgames@gmail dot com with any feedback or issues. Thanks!", "short_description": "Climb, collect, and explore from the eyes of a squirrel in this single-player platforming game. Let's get nuts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": "http://www.granitetopgames.com/", "website_url": "http://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
 "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1116686314572391_4119213446887809371_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsABk57N5t8Q7kNvwGPrWzN&_nc_oc=AdqoKHINI9hK5OCSmarMgmMLCxIdS9lYGBL6lVZc-r64WwyS2ZWhPbWyZrBzBxJ8d5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWny604DePmblYsrYuZxJAjBir-iSG9V6zklyL_HAznXg&oe=6B0EF64A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1748924326405833", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831299_1748924329739166_4245750083142451041_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_4YXNhHDOAQ7kNvwEWNFU7&_nc_oc=Ado5xOY34joSFgIykibXSC_6_MQWJDe1_4bUUnJfauskpLbLHqtj0nAnvjmDeA12mKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdY48XCsnPnDxsALgwr_6l2Ru0aIwgeyxl9rxiEvOBjw&oe=6B0F12EE"}, "display_name": "Cosmic Crossfire: Ironwing Armada", "keywords": [], "long_description": "Break the formation. Block the barrage. Bring down the Citadel.\n\nCosmic Crossfire: Ironwing Armada is a single-player VR arcade shooter inspired by the '90s. Defend a space platform against waves of Kestrels, shielded Mantas, and charging Shrikes.\n\nHold the trigger for automatic fire, then raise your shield when incoming shots close in. You can't shoot while shielding, so choose your openings carefully. Health, firing-rate boosts, and gold fly toward you automatically.\n\nFight through looping squadrons and advancing rows that grow faster as you thin their ranks. Survive all three stages to face the Ironwing Citadel, a massive carrier that launches fighter attacks and charges its cannons for a sustained barrage.\n\nSharpen your aim, collect gold, and push for a higher score and an A+ grade. Continue after defeat to keep fighting, or start a fresh run to challenge your best.\n\nA standalone episode built around aiming and shielding from a fixed position, with no locomotion required.", "short_description": "Hold your ground against a fleet of enemy fighters in a VR arcade shooter inspired by the '90s. Open fire, raise your shield, and break through sweeping formations. Face the Ironwing Citadel carrier, collect power-ups, and chase your personal best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluejayvr.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "BlueJayVRStudio", "support_website_url": null, "website_url": "https://bluejayvr.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1487421574444533"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1164972812695310"}, {"status": "PUBLISHED", "id": "1727532675015258"}]}, "baseline_offer": {"id": "1727532675015258"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1164972812695310"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1509136132273077", "version": "0.1.0"}, "id": "1444912037577859", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typena
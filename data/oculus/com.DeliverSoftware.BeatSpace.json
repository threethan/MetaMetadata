3339_3096152693724196306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYSIhkSMfwsQ7kNvwGMXP5T&_nc_oc=AdnhTKiNbrdFFxk2Z_CyM4WAFt0Q5glukVNIEn5ivQrDYIaya8lmDQZtri-JeRoL4js&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsTwjvZmCCja8XxBxiy35tykLBL1HFT8Gw7M7db--qjeA&oe=69A57C5A"}, {"file_name": "screenshot3_1440.png", "id": "1037573881788344", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499293972_1037573885121677_7275417076880085859_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2J3_i-970YQ7kNvwHIwdIN&_nc_oc=AdkZ4Y4rb5MIwXsp2dfEwMt7hMiYA6wx47sPSQ-o9Y_vScz84MUiEJ-7yYyIcgI97Yo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft5OlwBO9-P2EX3G5EzAXvgWU0NU2t4pmqRyA7yMCz62A&oe=69A57143"}, {"file_name": "screenshot5_1440.png", "id": "740531835516509", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499297259_740531838849842_2312162031892085804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=199ruNRDytUQ7kNvwF1GfaB&_nc_oc=AdlTaQ6MElhAd8rP_dggv7kt2z5J8HvmyZrKb6puGsDS1-4i4LQADfDaBUTxWwNyihs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuhmsrmuOXr5u8ilJS4joSA9cqfrErMnJFe3Fiof-YAXw&oe=69A59F69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatSpace", "keywords": ["meditation", "relax", "binaural", "focus", "classical"], "long_description": "# Enter Beatspace\n\n**Beatspace** is your immersive VR studio for sound, focus, and flow. Step into a responsive audio environment where binaural tones, classical compositions, and reactive visuals create a powerful blend of meditation, creativity, and focus training.\n\n## Modes of Experience\n\n\ud83c\udfb5 **Tones Mode** Generate pure binaural beats with three states of mind:\n- **Prepare** \u2013 gently synchronize your brain for learning or transition\n- **Focus** \u2013 sharpen attention and sustain deep work\n- **Soothe** \u2013 relax into calm, meditative states\n\n\ud83c\udfb6 **Classical Mode** Step inside timeless compositions, enhanced with binaural layers that bring new clarity and depth to the music.\n\n## Immersive Visuals\n\ud83c\udf0c Watch your environment come alive with glowing waveforms, ray-marched walls, and generative light patterns that shift with sound.\n\n## Key Features\n- Scientifically inspired binaural beat states\n- Interactive 3D visuals optimized for Quest performance\n- Intuitive VR interface with simple, large controls\n- Multiple soundscapes to match your goals: preparation, focus, or relaxation\n- A growing library of classical tracks re-imagined for binaural listening\n\n---\nWhether you\u2019re looking to **focus, recover, meditate, or explore music in a new way**, Beatspace helps you unlock deeper states of presence \u2014 all inside VR.\n", "short_description": "A VR audio studio for binaural beats, classical immersion, and focus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatspace.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DeliverSoftware", "support_website_url": null, "website_url": "https://beatspace.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584415704547780"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618277_4132869690283781_8565947947188558805_n.png?stp=dst-png_s360x360&_nc_cat
c_sid=6e7a0a&_nc_ohc=f5fbv0VaTzgQ7kNvwE0cgzI&_nc_oc=Adp7ZD3YeFmoF5c72JeZFppQ4S7kcxfFGmNG8GJwpL1d6KNJxKB9OXFePyeDxsuiEHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDA-R7tQji743DrTrMR02W5Bd1oPdjBfiJBMsMd6-c8Q&oe=6B0EF2E6"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcFWo_8fFxIQ7kNvwFuteId&_nc_oc=AdpqVrDeWoCct7PjSisZqbAAcW67B3vHCVGLgTDMK7GcdxSvQ-NNSb-K138KNNB5Pnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCoqQYEhGLtafzM3vCFkmz9SGXlTbrmxrzTOft3XFL6Q&oe=6B0EF8E9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp7sZooYKFQQ7kNvwE_-4md&_nc_oc=AdqVg3BnXID1y-foYjQrKwDo_3i3P0-x3oEVcVJzFUdYV2Zrh4YkaCvixvQupw19VYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7vHhzermk3eezBtRha2yQr-eovd01CAm1memOhWpK5Q&oe=6B0F1E5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41pCm7cc_YQ7kNvwFIy1fH&_nc_oc=AdqNQAk2jjiInDvBAKOdZ3Ler-honCa1uyL__xUK0Tjh_wUza0ud8esuYYevg6qBzks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5K5xmzYIeihNwKBUrAgdP31tcB2-VpLek995o92Zk3Q&oe=6B0F14DA"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfGdOdt9T6EQ7kNvwH0ibiG&_nc_oc=AdpWE3f84vi736WbOqev4Qu_GI5rpZpkFxt8n7vHfW0FRHvkmGIA8EuDjYnmpCwCnhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFaqx7T5yIfTYpIZBC9r5xsxyqAWhPBlrQgO7MSDTxpQ&oe=6B0F1520"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oc
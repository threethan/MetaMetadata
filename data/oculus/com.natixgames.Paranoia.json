c_sid=6e7a0a&_nc_ohc=DMUJuCPMzRMQ7kNvwGjCWhS&_nc_oc=AdptLttqLmWoa7cIjRPjC6gnJ06jRNfohYX9yUQ2sMbHHcrP0QRJCeJxyb4XBQltw9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShlcGuZIT2DNI94mJL-8pOf3fq3gpQ8Gx2tRhcbIWqPQ&oe=6B0DA166"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Fy2LYhiUcYQ7kNvwGir2yG&_nc_oc=AdrqslUBCQPyOblu-WH9D9VAQZ_olENy9c_nWkfE-xw3OlHUs0l61ekN4QaQyGbJ0-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSa9prBYK54GEszTZUUaewi8hiwBcKxFPEK7gqc0vSQ2Q&oe=6B0DA769"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFsdbd6KHT0Q7kNvwFAQLfE&_nc_oc=AdojQ7i9x8Eixu_CVC31qKM34nz_ExLDp7DA2b4JN_FtSHZKDhZB4t9J_ybmeG7qMAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdSvccD5mGkStGQCItMVMfG4IchQJG9En9-K6pfLACOQ&oe=6B0DCCDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41pCm7cc_YQ7kNvwF_cR_d&_nc_oc=AdpWp45vsvKPO77BV94_6VVC4pP21t6PzRxqSvSNpre_TbKR0q84rVYhoHcQnULZuqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1obfAXui0lb-5-F3Nwc2wAGthoS9by4ajV9ZElGGDMQ&oe=6B0DC35A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfGdOdt9T6EQ7kNvwFr-3O0&_nc_oc=AdqjZs-qyqW1bHdgezruCf2SiEh5Blv-YqnydFs0auctYedkQRPPdAAPeVXyK8FI1x4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkLpohVvC5sqOD6L9pRzzc68fOGC_RZ-TM7n1ECnNhGQ&oe=6B0DC3A0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oc
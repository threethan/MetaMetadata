d6-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjcdVnyKgJoQ7kNvwEtSAZY&_nc_oc=AdqS-FA9WtM9tCGIpqWhwcjHv4zpenir4sr7FQ-rimMuDaXC1tX92m2B2-U0xSc6WEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtQVeiU1n8JO3Bh2FQMIUO7a7xzbx4f-FzPsweyCVeWA&oe=6A9EB129"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGvBY2PlQsYQ7kNvwF5Pu2f&_nc_oc=AdotqUy3JZeDIdb0TIP0XJyu2j5q4AqjxkQ6Qyvi92VBLgTEc-v1Nf6QDzI2kSjY6_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMyUe-Ql142C_znvU-sBnHoIAsC6O2ALhkP6XbMz-6kQ&oe=6A9ED69F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XkFTw71KOwQ7kNvwE23ItH&_nc_oc=Adr8NVwSeZI-EH3MxNSOuGRe7OB0F6FZF78eiAz0yWA7jkD2n0QRuxsbFx6T9RNZX34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOpBn8f21w1vph8yw7ll_eAvRbH0-j4GEsvWZb_x-_cw&oe=6A9ECD1A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfBtI8mlfaYQ7kNvwGiNJA3&_nc_oc=AdqM050IU-jdQ6_yeg4ArH2c5sW97_1v-XiubItfLSSktFcDBtAv6ERMC-IX4HJ6S3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAY5T5DSUdOAvx_clsd4q5ttWimLjHpQQuhc88VelKUQ&oe=6A9ECD60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEJkmpwwFJ4Q7kNvwFsg9MN&_nc_oc=AdrfRTbrAbaWm7fdkpQ2OawMXUNTmef-rg41FtijWNUNO_OxB0gYtMoGHtSsSzjmokQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIQOoBzEamfLGR823o2FeTVGuaQHBSI3CgfTjQqOEByw&oe=6A9EDA44"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
c3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U73H7-jPOxkQ7kNvwHfdI6F&_nc_oc=AdoLNOY5qv36kWmMve-_ssVPkh4AbDer0HenIN7qQFkbyk7jlsLQXC3XDcts8r0b4Zw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSp5Eas1KZ1EWRf0CMoGZmC--qYX6Tb_nmzHOAX6RyeQ&oe=6ABA60A9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieUZU0p392oQ7kNvwFE-9n-&_nc_oc=AdrKEkDcG937ErFhR1dFPLX1EAwA-TNExrGy6LJ69C_Fp_rfCbTQtcjByP9w1VoDuiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6KdVSBt6LDReObCcJ3zFFtgxAEpgK5FlXYLYFW0vEVQ&oe=6ABA861F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IZSb5YqifYQ7kNvwEPTS8d&_nc_oc=AdqnkJchK7kXz7sALlNOc1yGYXvM4pfkU7uVkGUAnss4Q-U1ScRwitfMvdjgV3b3IsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnUj8xihWiV_RjXnSpQXJTIH2BGdW4ZOrF6phaskNpLw&oe=6ABA7C9A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_TGqKNzHO8Q7kNvwE9fcO8&_nc_oc=AdoZOLDkcZI8qY9cR2YZ1zCORhgGvprYTx6lXmEuU4Q6dw5Km3coT6ZKAQuzpVywrlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtaqIp60YWxxax-fS3VJnjOw0ZFPUlrO2HZQ9uZneqXg&oe=6ABA7CE0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ywgx__Fr4MQ7kNvwEQTDOI&_nc_oc=Adp1dZvJr0Ya4Zjvrzg9yF5DcNhkl_VZzo6GH5UdPvI8EqGNwD4I08caGRDpmSSG6uY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWsh6H1ObD3vsoE5KNJQOilQGxx18vlvFtdduo0h1YpQ&oe=6ABA89C4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
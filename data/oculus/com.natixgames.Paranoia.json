content-sin6-3.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adumjASqtq8Q7kNvwEWZoxb&_nc_oc=Adq17XZp61G_ZhJpKidH-C8lHH53X47Un4tkrRhdTbL3ywuN3u89ppSuvh6owmqgyGg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Vp2wOMz9IsSGZ-cStyTo2OSSZ3PqiuEDOYqINVk8eA&oe=6AA93D29"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhJGLR_voFQQ7kNvwGYrygZ&_nc_oc=AdrSUwxwtiIqNQtPE9u_oYTo6UMCsUtvQ0zMSIDpuS5oCT_GUH8joGx3nCWV2oYbYH4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxJrrfbap28SEwBG_m0hUJCF6e4ZjLYCHEQXN1wyFz1g&oe=6AA9629F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBhZQWC5_UIQ7kNvwF2RzeS&_nc_oc=AdpYOIyi83JjIb0sQvwj_VIoRsQns925bCRrpZ5c_uVcLl_SY6vxM4tbtuA6ROevrrQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN41MXvSV4bqhcbm9ZmbtV-7Psrpq9aIbGkPohKp3ijw&oe=6AA9591A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3fcfKySvaQQ7kNvwELJu40&_nc_oc=AdoauS0UD5BJhgzLMA76ILONkqlCC6BXzxP_1NAnOY8cYz12UqNdxMjVl2-3uOKAdCk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgpbQheFjyX1ywrVT5AVgTddFNott0iFfgQJSN-Gc2Jw&oe=6AA95960"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP9ALG4LnhgQ7kNvwFZNaJy&_nc_oc=Adq1YhtaZEMyTYiufa6QPwQMWj4Bmkn2lYkeWtmC4ufjhDioi_b6Wpe9ihDEiVjOrUs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYwQSfOqvsn3XDU86OAb1DrWthuffSPQDMgQtBS3vfSQ&oe=6AA96644"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631
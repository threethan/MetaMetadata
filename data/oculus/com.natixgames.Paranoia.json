l3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPZq3JRWcF8Q7kNvwF0lWiT&_nc_oc=Adq_csXgWsYnhKd1biU433pWrZT2VmT9D1VNMabvU9KihXYZrODUX7L9y7zQczVkf7M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMGyOgHL6Pw7ORtA52S439ksXz5d520itTZYvorJl82g&oe=6AAD31A9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYny4mgwMusQ7kNvwE9_n_d&_nc_oc=AdpswIxa2xw_LFpZVwr4NPEh4j_BoT5YlcstJKg7QveRD6Icn02rribYezESmvhFq7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr1u4BKqVEyI9vn9M9Ht8623dbF9L9I1MRXokCbKfj2Q&oe=6AAD571F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex2UHx5coAwQ7kNvwEtHLgw&_nc_oc=Adq6243-ZQNvYA6s_wpxdAwJHnjcLvPgiMiRNkguE36S_ZXApZTR6GeEmW6Y0KIAyFg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-yksF6IyXT3QpuXk03semshFu9COkeTLI7ZzD9Ry0Og&oe=6AAD4D9A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9D4RWOlYXIQ7kNvwEwNGGA&_nc_oc=AdramZyDeSdFGiq0Gq2CMFvkEX8SQxHqIdsHfP-GwKn6czFf8Luc-DinNr_0NtIFPA4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxAaQ9IoFOv_7LEuxkR16MJN33a9vHqdKCc_6bOMWLkA&oe=6AAD4DE0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbT_Td7lKTEQ7kNvwHh4Fht&_nc_oc=AdqiSG3yJWOg_Q3oJnNBoNPWi_tikcwOi8xxUdKPIQ_d7hv7WHllCdThbYmA0KAHmTU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaCcDqgPaSrWDHhV3gJAHd6-usrkqL7JzIO5nV_kOMlw&oe=6AAD5AC4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
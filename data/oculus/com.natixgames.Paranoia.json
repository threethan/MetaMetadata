ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=723AfNUHsLEQ7kNvwFXgCZo&_nc_oc=Adrb3fEzUVG6MaXgjeoBaOjBPr28zcG5mmZuqsT0iZhUScOQgdG0yWXug-u8Qj1CwDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM98RfnORcFG627Jhdceoq_oZKzmPZa_jC9I-uLgofbg&oe=6A997173"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5se5lAKG28Q7kNvwF90d3K&_nc_oc=AdqPANeff1z-86wk3S4580YfCA3O0wTaDHozb846Ld4fPR3oTnliAWf-VHHO-SktVY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_teIJWBNXPFbBrAKMvdRapqyqT_T7p-bz6OrNLrP-Eg&oe=6A99A369"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kylzl70L1HEQ7kNvwHmJP77&_nc_oc=AdoQTqEa-KtM5QZmdqYDYQocEKz1AlYvHUObc1tHJ-_z2Jat5AyHVpoxBaGROFjEYAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxaA7W6Jx5jFV8UpJFy6HxUpnY5fDANE62HlzGAfE75w&oe=6A998281"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hC4lfDqU7GgQ7kNvwH2fc7p&_nc_oc=AdqilzWaxe2LITlujhDMYQ2GvTT_w6FlB1SFBK9K1B3d0D5L24Nn_l7QByKGWBcaIEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU2M3Lqo-vaA57jeB-80Bt5zhs8d41BEUmgzS6B-S4cA&oe=6A9988D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wwt-4W0Oy0Q7kNvwGe3gwZ&_nc_oc=Adoe94VZjfmpjn4AerROdYJng172rhjLFtkJFLXwNLN8lGt_rl-iE3lHfpaZ90-e55k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJObsMXffKG_-z7b05RkoH6k-ICxv_Dgt5cDf6juSn3cQ&oe=6A998760"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
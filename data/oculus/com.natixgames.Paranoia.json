d5-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arwZejAEsxkQ7kNvwGY9v9H&_nc_oc=Adrm5x6L1qwPynXDuSeYliX8ppt_dMCKwAOaXPQHBlaCJxIlemxb1RIWWHV-lIbKGB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx1OrteK_mlJTJTELBTKdGXiUZxiP0f8PqkOJ4of9gIg&oe=6ACA6AE9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6qRhngbiq0Q7kNvwFLUQym&_nc_oc=Adob2n-iIZfTVHV8uSQTKKLRj_dFVeiWKoS8R4m_p5zFShwsX0gnollMpKYJIAwDHR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWShnMEP-wvJlJwV4RX4Ys6Cbskje7SUHa0boKlX9-Mw&oe=6ACA581F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzIcY_TpL3UQ7kNvwFoB5OC&_nc_oc=Ado8dRcWzr41wtbmoY5M5U8bA50K_u54MxZw6cVRfYWnIsNzm3hCi_INvpzEBnYMFyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdpFM7kI0CGXO_ypOhqiBKo_mwgRnHBEqNlLOxAhxM_Q&oe=6ACA4E9A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3Rg9RmUtZwQ7kNvwGaIx_L&_nc_oc=Adreigjgs280nx8ufkssNYisLtlAQpRkyRPCthVHxrUawllisYjhU3gtjCugRq9mvxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaIN4bt3lBx449tLQi6q05cX9Dj39qIOoMzXGYvxKJpA&oe=6ACA4EE0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ef9GIkVy04Q7kNvwG5_LTm&_nc_oc=AdqqHuiLbyamsCbGnasDXBvW8JsgPY56cUsLxICQ0T4Yrcx_up70IKd70zdj2YeP0vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3MCRfuKeZ-pE_RbtsMgnOMigiqaGMzsFVFWFIqQo-Qw&oe=6ACA5BC4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
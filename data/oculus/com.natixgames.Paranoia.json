w5-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-JmAi3N_aUQ7kNvwHw7YW2&_nc_oc=Adrbr-i3lXQnyvUFmHAZBhZrwAPEo0_Nrx_SJ2U5wHphgh83Nu1X7H3irmKOHO_cHV4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFBX-Cus0OHa9-IccuqLcQVI_4zO1MVz9V25txUxWV4Q&oe=6AF9E0E9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxchNOgjoMoQ7kNvwEw1eCs&_nc_oc=Adp-RbyyP4hNrY2qafH8CaQT7sGtGF7GDnMGzPgODtiLRTKOiwO1KUk3ThE3CE_IXPU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIbGh24WD7xPTvhkIWfM_6o1-64zWzcX9GqKAbAtK0Iw&oe=6AF9CE1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsGEx3tP2TMQ7kNvwFKZR1X&_nc_oc=AdqvMq-oWHC2kYFYPiIqIxAwjplHadk0LgY5166X1POF9e6WTSBVIekzycDWrJfbNqs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvUbXxqTxZpp_5GOazXwMa01C5JGVTL8AGrUvU7owIAQ&oe=6AF9C49A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27AglFsdJ-sQ7kNvwGx-zXS&_nc_oc=AdpwK4KR4ztwS_J3NHRIqVTm2t1f8uiKm6BzObYajWQ-Wnp4w1jKgpHcBYdits8zVFM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO7iQ-FLevqZynEeDuxD__khff976zJdsj3x7x1xTf0A&oe=6AF9C4E0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aizNR1LmqkQ7kNvwGV5mM2&_nc_oc=AdrZ444g0TS3xMCSxfcdv3FwGagblH6_PL7lMwQ6tdaL8Ai_XatCuow2K1hYvsxLaGM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtobwrm6Ugj0evUZALBBDJ3vEZEAZEXjua7OJNsE2WBA&oe=6AF9D1C4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
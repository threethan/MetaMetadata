c_sid=6e7a0a&_nc_ohc=Oqpnx42LtsgQ7kNvwGWMe5_&_nc_oc=AdrFN6OfdVs985-S3_faZz_dcgsYyT-dPOsGgNzxxZWco_jc_oJOCX7l2sacyTqWX8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY5N-UXZnyHO_17p-KBuk1EGVIkYptIQJVZcwf8Pmj9g&oe=6B0466E6"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuZjhJsoouAQ7kNvwHcRJ4_&_nc_oc=Adr0kbCSrTztpUNAkiSr-tWSgITk1tUuIo_r_fqzTGxfp_1ZdLpPBHBG8iOQg7F3_ME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXYveDCuz40oo9An5APFZ-Mvd646xf6xvG_WhuziRIGg&oe=6B046CE9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuVbx2Kx_M8Q7kNvwETBzkY&_nc_oc=Adp-PdbJRyPsJuzczWE2ARfH76UxRbVk3Ddz2J4XzvUt5Onq2jYMwQOtueVjL4MSDdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1feb-GvyquBQNu0FSgkdeRqmGie23K3qBcRUw81WukQ&oe=6B045A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aubhu3jvC4UQ7kNvwH4Yn7d&_nc_oc=Adoxu-hLcS4URJOF-bDs3eYe1Y5RJC-ivbzcacaulg-Io6bca6Zox3yblM08aHU7rGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0HqqnqNi_sHJKKhKL8doX7hK29Bht9ZnFzimlV3dHgQ&oe=6B0488DA"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usSVyjtB09kQ7kNvwGsKv3D&_nc_oc=AdqPAiPVdU8gEckwfAyPJ73FaGWnfGuC1vFfPe1ANbSgROvlTfVQc8VgiAw5ll6idGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFXQ_XpvhkzWndcQ04egjehKls-myFuPQUZbcaRzArPQ&oe=6B048920"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oc
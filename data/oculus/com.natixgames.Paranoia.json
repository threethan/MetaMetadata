c3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRo8nVe3ye4Q7kNvwEMn8qA&_nc_oc=Ado-Q9eMW4P4LDPQEuRgC6E4ScDrN71TeVqLsP-P7aan3OfLeCahe0HX0ANQYHVsZpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODgG3m_SHE7S5nPFmcJ_EQLiajB48E8kwmwG9q9LrqOw&oe=6ADDF929"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuULCCE9oRUQ7kNvwGvquwY&_nc_oc=AdoDTj1pFXexn21ZIV6NdZg5cY3bclBoNbKnwWA0ZWYRaY3hL6LuFttOJ2Vhsly0QDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfthwaYwNA2xu0D1U13k1q_lgB973Dz22gq6i5Bs5FHA&oe=6ADE1E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buSF2Lh0tb0Q7kNvwGgcZ28&_nc_oc=Adp-bptW9YLnvMkmcb-TWk7Shg3E0c2yLvJQGs604TJsHVBIkLOvICSVqUMMea0NXOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnyMAsRL381hlpT85pYFcwEl2cymUR_i56zUyCM2_88w&oe=6ADE151A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycjtZZtqlEsQ7kNvwEH5KE1&_nc_oc=AdoAWknEYTtKgNpufJs0YM4oPYMt63Z2xTLweS-Fzfw9UWuEymYkWCkxtAl0phLfIlI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCqJCKg0JgkRGy8-KICD4K-qJh62xt6vUKwbRi_61KHw&oe=6ADE1560"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haJkGGDgNnYQ7kNvwGlGfSu&_nc_oc=Adrrar5z1F5mt64umR9k4tH6PXtzYMIkRMCWQfmqDutPyeHGxexRsy3vdv2eD2dcXl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnANRsHIAzQTNB7CEv06Lvguzvk883hIbVDDaHIgpRuQ&oe=6ADE2244"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
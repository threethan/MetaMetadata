c3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDoZj376yeMQ7kNvwFRkSOv&_nc_oc=AdrzNUTDR2820mo_ZxWWgxwDoxn697kyADg12-Jm06s_JwjcTy2O975JYVfIoPkQkNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4sNRd2XYaZ5qF1OLcpSwE2BXyVkDeXHhIoSiSyF1iXg&oe=6ACFB0E9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZqnxGXEOUgQ7kNvwGsdkkf&_nc_oc=Adr8KqZXxANtpN7DN-6nUypg-hbB--H7X_rRBKJWNcXkI4-JRVtO-bsIqoTAZuiVvtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOY_6ZFzRlCDOGggncqhGAclJEaOQ5G6Rt4udZjxzLeA&oe=6ACF9E1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaYdArieWY4Q7kNvwH9aUO0&_nc_oc=AdqbctNMesoUi3Z2OjEBi4FklbItBkJ6yxgFh7N0JgnZMuXUY1nzHTkJ9tT1RW3VfMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1scbY86Wd_6h59uW54AxnRV7Nnqd3hkkcPkg9gzOvZQ&oe=6ACF949A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8BuWnhFRiYQ7kNvwGy9fvB&_nc_oc=Adq9lVxllS47mIY4zTdZsqNu9zIxNSZSwFB6T3dO8-D7Ee4N9EEWoao5qWnf7kGGLvo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkbBcZ1m9ZQ_ZWidd2dbVbsn98NmerwGgeYwpTdm1udg&oe=6ACF94E0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HQAvK7Tjd8Q7kNvwFGLUm1&_nc_oc=AdpLBxRsDW-pPq9x-vBMciwTA_JP73GhZS-2A6oYo94rlxP_MEc3rj3B-SC-KjaeQ9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_bnltZ96oel-1l-im0t-nN2JJav-xr1f9vMMSeSWi1w&oe=6ACFA1C4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
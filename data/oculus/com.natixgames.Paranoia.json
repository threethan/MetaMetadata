ps://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4qdjR0emn4Q7kNvwEN72ei&_nc_oc=AdqQ-iI0MdLJLxiDTWj_bCzJrY-BYzKe0WRFhRoGQgfUDKPJlp-6DOTl0-11OYSX_Dg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlQaAhF9Vt1rvxv1gbe4lEEgTP5XmU40kBtnvYzOKikg&oe=6A9036F3"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVqttsEPaz0Q7kNvwE2mvDB&_nc_oc=AdpmEU2BUsH1Wed3qlAo0WWBDvJtkpqKGERi2KX5lng1lQHJ-BjPJR892dnOc8yWOLs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4oFNwvoIRwbet1vnh8Btkyi1PQBIdKveOtuV9MPheug&oe=6A9030A9"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23F6jW4VWJUQ7kNvwFWTsOB&_nc_oc=Adp_8B1R_NDBBrfyTXyzYshXgFNB225r5LpY5WsbIElwwVZeJmGT0SRxBLgskWlKld0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRWD9-hZHhstpksljDM83oYzfhz_1yeuxjuRaED4h1SA&oe=6A900FC1"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khd9yQIAnS4Q7kNvwFkZR7n&_nc_oc=AdqobUbZoiECt8Wa4T2KDLsR8MfnofuFUGPWlzbjAVrG1n2X89MgFX8N66XM-w3eDzU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoY8syYej1Y2-XdhPu4FJVimvSSpDqhxongVKMA7AuqA&oe=6A901612"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbKw7rQFT0AQ7kNvwE32ydU&_nc_oc=AdrFGtyjRVHnECEX0eS6q_igDEqVpoP0vXcBiZ1QSa_uUczzdVJhlf_AY4zX_7iWSmE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFScVsjRZb-FIIpAZ6-fAsDLJnUpc_xoi6q0ZUMjaC2cw&oe=6A9014A0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
c3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzX4Ua7LDscQ7kNvwH-EcrV&_nc_oc=AdoSIgzJhxigRrKgJd3zui7GecOI8O5Bo7sH7iZTs-KQ5GXS1VmLZSBopWrd9_J0pWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAYDH-72GBF94czJF4w4118T9HBBDAFF5_Az0J-VMscg&oe=6ABD03A9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ec-Puni8hQQ7kNvwHWl6-n&_nc_oc=AdoVSVxjQUn18ULre9gwsLzNPZV_YjMV_BQNG2qlgIZML_IoCUjNfUMRqSRQbUSziuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZIVMUVJ53qam69VFiQnLX2eu7Fg4PzVNpaNEbGeUXqQ&oe=6ABD291F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dXLjAFOrrAQ7kNvwFnZbMd&_nc_oc=Adoux2UPhAbEGZrp-tnxunSb9_LTUajlZthGHvTMjlV8UYD7tUqhYd717A_gQiyRko4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpt7F_ZtaFUJYpZNya_K3OiVyGmmZir4as-jg312OSYw&oe=6ABD1F9A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbxQ7Ja3Ql8Q7kNvwHLsdc1&_nc_oc=Adr2bj6ukrZAPab_xsXb1aM96FUajP3Pzw5-x3H05MsJ2VuFJO6GMbj6lYgmRYAUK3Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwUPCnxfDL961HYIUYPrh93cuVc4gcCqob3eNflTDrvQ&oe=6ABD1FE0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhs1NkiG_hkQ7kNvwH8AK8L&_nc_oc=AdpTxQkxkCDVYra__e_0R4ZjXD_Oe3-lAE7ufeBdSEVDZY_eE2DgD0sIj9pljL3dHLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd-7Sku7zoLZWozeHqfUUD36WYT9EtLEeTA4Jy703Ubw&oe=6ABD2CC4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
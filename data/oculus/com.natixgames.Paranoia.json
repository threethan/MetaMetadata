c_sid=6e7a0a&_nc_ohc=hKXv7VG8mg0Q7kNvwFvp2vQ&_nc_oc=Ado-uA2owSTNuTach4jlGv0sEAgsgJhR0Ea9mwTSCQ9diIqR8Am8AQDYQcdbUCUzGKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpxaAEgDhUhcnWxMgyEkHg5LJ6aFYcuGGPHjI0K2rMLg&oe=6B007266"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kpuj7rehVTcQ7kNvwGg5iBc&_nc_oc=AdqT0R9_i2oCQnDKKVcvztnKQN-qYrlDkQ6z8UmKi85VHhOmxfTQxpSwPbtrAwyM1bE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfSvAhrWva-qjQMMAuEof1x-864OHkPQyLogUV0Bca9w&oe=6B007869"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1_oM_-5cXcQ7kNvwGuPqAg&_nc_oc=AdoSRi6f43OrHp_h96R3zQRp-gofEQMxeZxq_qmXG1_6Q1O8eqemSbSbTg1vbhangEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQDbXB0k1Daj_Lzp9o-dr7Cj75NJqjR0tMCbg6Jxfonw&oe=6B00659F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpFhLukv1HQQ7kNvwHOyeiX&_nc_oc=Adr0vIJ0esQpQiI3qZIF0jji8H4nyjJ-WHEI561HYjCyntg94-TD9nCjAhpzsaCSom0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYPOMgdLzth4KTlb8as9-7INToqq1nLj5ZqB4iKFBjPw&oe=6B005C1A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr1zPMtnzRQQ7kNvwFvTp0s&_nc_oc=AdqqGZXljtSwauRYkymidpNUYc0MZO3IfLWwBiiyxf8_8TR3DUUkdKRIm5Kt-N-M5G0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfUwHIm3B4a2khswNSF8RtVLESdSQwa3XAIisc7t6cxQ&oe=6B005C60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oc
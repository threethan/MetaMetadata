c_sid=6e7a0a&_nc_ohc=Oqpnx42LtsgQ7kNvwFbOEiU&_nc_oc=AdpsaLDQPp1wcaMxi_jW39P804HHN2CdjDafvLgqbvHGVk5Z6oppkSJ5HWzU7Lywbc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV0A8Ko-B_8xXniSpaePzYY_t2eW-R4fDA4OoW_fdHbw&oe=6B05B866"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuZjhJsoouAQ7kNvwFmtyvA&_nc_oc=Adpy9nNUsxeinte1bLoM-RQGU0b7RO24tTkLlllaaYCLdsTXHWDap9Ypsf7v98efGGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFLp83c53fETpKFcsDm3kKLONQoEy7EXb4IFvRENzsiQ&oe=6B05BE69"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuVbx2Kx_M8Q7kNvwF9HYXv&_nc_oc=Adqs5dELoMc-6Nhshr58DuLMlUNK5JTBXpiRhTNaWTuYPvfbxEAausBjaRz8qavzYWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc3NNO49Jq2PEMGUoyUV0fp6as1bgE_3z3hheuw_D9ig&oe=6B05AB9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aubhu3jvC4UQ7kNvwFw5zN1&_nc_oc=Adp2vkTyLApVXi8isbglLiAzQUleRNii90oSQywhiw2IfjAUcjA1f-z_lUk0EF-jaWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvsjNbZhhNm-EkJIGTztQnR5u6UN-JJ4URvx7j4p_GPg&oe=6B05A21A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usSVyjtB09kQ7kNvwFFNjDy&_nc_oc=AdrMSrOfJBWrIk6aZt6BHD2QQSpoYKFdRLW_C_XD29O9APJ9_lwYb8eM01RB3bG_iYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcvsJszfeV6reCThVq_XtFT09MACFvJeUeF5o1VOdrcw&oe=6B05A260"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oc
d6-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr3Ucabcb7wQ7kNvwGbI0mV&_nc_oc=AdpGhx2Q_pGmsyaBfwDOsVt2rlI9vNLnbDAHamS7hBRUbZToBNFJ1eVuuG9-TvRo7dM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl5_8KInPXPIomc4zgbg7UGS3ImLbp3dMa7OOd2M-SfQ&oe=6AF5EC69"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WH7TeZS8J0Q7kNvwEi79ju&_nc_oc=AdocyR_xKq-BCbV5Rre4oJVJoF-bxcMCfAt2LU0bVsD3ZvPe-QgsIvDdZdy-ntKZ4o8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0jDBsFO4C-q1VKebMDcaP7KmC4ug_xzZtNNR5L7VcBw&oe=6AF5D99F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2tLK46TpwkQ7kNvwEjVG21&_nc_oc=Adq3CbxsB28CjtaR6oReHwiYoc81tdFTQpmymvm-i5Dr9eKkECefFsLi6fbCtRIt-CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFvQeQoNVwe4GchuEhJ9pDvWj_1is9xWJ0IiIb4GvVZQ&oe=6AF5D01A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxUZtRBnvtUQ7kNvwEBXN4E&_nc_oc=AdoKwBYJ9y8fyW-9tfLjOWx2OjeP_NSZYe1VZ2CTDFV1k6L2wAQkw7p2IzF0Xi_uo70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK-wXWAFcFtrPUruPL6F4V6QeMLQliw9vaze-4l5IZ5g&oe=6AF5D060"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNVBn0FgGr0Q7kNvwE5AVP3&_nc_oc=AdrDxEiiV-EiLf79fJmEaTqIq1LjkbOLfF-ysESaiGR5I8M22FaJShFZmREHJGB58Oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRREwYLBlE6qmF8ydjR5P1cPYrql3dgHNL1WpUFxIk8JA&oe=6AF5DD44"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
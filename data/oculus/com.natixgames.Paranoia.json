c_sid=6e7a0a&_nc_ohc=lNhmdMZOr7AQ7kNvwHSSETq&_nc_oc=AdpR46400NXuDHX1wieo6DtZaH0Hhle5mooPxh19WgrhiuGZ4odVl8Z8FFidpQcVdHU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH326CYMOpnUep1VfwgcrAmn48G08WTcj2EWJms0hLpA&oe=6AFB2C66"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXZURlX2gwYQ7kNvwEal-9j&_nc_oc=AdqrpVF0NhiQKj-UPxrJnsMsLgVLkpCqlCmydJ8gogUjTcwPuhKOJPJruHOzEgqm304&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjpCNyjmYpVEgySp4gYgJbAgl573BEIBItF0sMbqU12A&oe=6AFB3269"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgGPxT74G_wQ7kNvwEvSNBr&_nc_oc=AdpbZeEvUQp0de4StL5CAZvTUsH6tBdRbjpwD87y5QWUTUPKhdxDUgIvvcr_N_UtTuE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW1lERfzM3lGk7cq4a4aRuu4kuKJhsPF4QVtbDYQUY4w&oe=6AFB1F9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsGEx3tP2TMQ7kNvwEW8yWc&_nc_oc=AdpbrNUg_d0EtpPBw60XFcoHLVB7jG3lOFCuAxtU4y2MlaLiSPoW_bUh4950qYXHrbE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAC-6DXs7otivr0_66rdwjlOaBvoK0cXNxslqlwS7VoQ&oe=6AFB161A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27AglFsdJ-sQ7kNvwE-EbWa&_nc_oc=AdqFvlHKWw7rGFNyhCZvHXKCL8tLacVnr_FMzZR3esJzZPDK_QrSGV-KJbE0OkWoST4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5CbBSsDlNsNTj9Ie1ot6R9cjhFUnErEC5Ail3khafPw&oe=6AFB1660"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oc
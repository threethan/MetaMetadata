c_sid=6e7a0a&_nc_ohc=lNhmdMZOr7AQ7kNvwEEccih&_nc_oc=AdqywsX1GqZbk9WZPM9QZ71bhaUtKMGa9SFhOsm_lZfdf-EKAidOpmjinB6EKlj9fQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq0fcE2vCf3M-emt2ZdX3fec5TYCrzTY75kFk0GpH7LQ&oe=6AFDCF66"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXZURlX2gwYQ7kNvwF8pqEb&_nc_oc=AdqLWAS6VXmXclrTKNWDIDerak7fzta_zHTwmcaDmhqg-RL5YC_ibZ1-4DW6uPXAQeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrG5J2JOm4GoGcMGIZ49-7VRrouZ-B3IUc7yVolI3Xyg&oe=6AFDD569"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgGPxT74G_wQ7kNvwHrXwbu&_nc_oc=AdqOjfbFLPOwKcdgTV4YitD3XjcHII7FrxVQWVN1T10yASZaQeu1TvcRVKwMn-nVy9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkNUq1KZGx3PAehUX7EKNHheVOj3rbBxrQtIOGlOZRHQ&oe=6AFDC29F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nSTy1W8kNsQ7kNvwGZ6TRq&_nc_oc=AdoyRBF0gHw-oxE5bAmq-kgS8jxSawdc3mona0aMjQ-eSToj1gJlk1p796ZFFpJUUnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKaro3pAphAbzJ8L5I8fFQhr7QDv9rYPBBtAwpc3BMEg&oe=6AFDB91A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSjQohM15LoQ7kNvwG8CCIL&_nc_oc=Adqdn-ANjYhtIpEUIl3ufUciH2Mhham586uZi8lXNw05zpmurqXq2x7EBsF20XQ0HDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjteTPclmQkv1gyxMA-_zFhOrXjicH5VUSesTgY98EmQ&oe=6AFDB960"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oc
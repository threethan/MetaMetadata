c_sid=6e7a0a&_nc_ohc=DMUJuCPMzRMQ7kNvwHAasQX&_nc_oc=Adr5WossdiKXuTtfID2CEkstfwAjda0RzsVBQGomfFRYrGdGGjxzMNEyBMbeuH0We3g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5W9R8frFtjWxw0PK58ntZ1TCrU-ULj11ngIp0tT0ltw&oe=6B0B36A6"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Fy2LYhiUcYQ7kNvwFb3dHn&_nc_oc=AdqdTj9GHt8yOk5tfKjLwB4iI2aGp-1SY2u1ZdlXiDWGqCkNcLhe40Bk74-UtOR36JM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMJ00pwxgojKRZR3hhNMsuyXNNyQM1oAKJuQFAsHCciQ&oe=6B0B3CA9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFsdbd6KHT0Q7kNvwEVKufN&_nc_oc=AdoaDfBb6U4M8aM9iB64_daXdJJFzLrK4bSdCb6TePwVVVMohw8Pgj9XHTyjfjiUFF0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTN9VI4gpn3Ax7AyqDaoJFZsZyOWDjAYOGA8qMLEdlDxg&oe=6B0B29DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmUF7AkE6ikQ7kNvwET9NmW&_nc_oc=Ado7sAi83U61s7FD_w-OUa5XgSj279JftE2CKwuyJDajr4BRwpTfdqrhqliQpNAqNCY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXBhsR59MZWVr0oTBxHBtABXyMJnATdQYQgXLdSGxYSw&oe=6B0B205A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLN_rRJWmDUQ7kNvwEW4a2O&_nc_oc=AdqFn2FBB_XvceLdFCGSrscUw3uyrKunJni1PYyxEQuqUR4YdHOKcZKIwO3PhJ-iUpU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjn_4pN1cHKAMcYcuUMNuJEf058rKkDjEa2Gl6htxsPQ&oe=6B0B20A0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oc
ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRf-CYa-L58Q7kNvwHAIplw&_nc_oc=Adoj5zJv7q9Dwa_e48s_gqrStguox6Fv1iAhE1KbaUEphKRuD9zOB2dUcIEMgTsJHzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RbUuBkvnePGPAqchu3_f9LjN7djPctctSsQETWTkI-Q&oe=6A0B0F73"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLPSBIlwFIIQ7kNvwEzcLFJ&_nc_oc=Adrc7sM-7p7TWlYMvhQRLub5M6-P53pSagoNsjv6LK15sJuToZCY20ZefcH5Dl_eFrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iYd1yzfRJSvIqdardaGLBU-B0ADYfTeaOEVrvGO8uIQ&oe=6A0B0929"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Yof-t-mgdcQ7kNvwHQ0EEh&_nc_oc=AdpEItCpxpv8pJauCyLf0qo_M2CcmoXCcst_lhIaDTt_NPgfaZ0itzs8_K8wPYI5Gu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bSFMOhF28rNl8dlnllyDfy7o0lbmibLIABfrk0gr7tA&oe=6A0B2081"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5ZHSiCWCLUQ7kNvwGZ0ane&_nc_oc=AdqHLpOiQqlJnaALLWW6fj_wKzs40lTc8o-2lfthO2l1KhzATBny17S1m6skReq1U0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aySD31MzMz57bjyBys9YLisYkDFlq7r32f-0YCtTzIw&oe=6A0B26D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p120ps96PuAQ7kNvwH3Wb76&_nc_oc=AdrFGSEU2tzemkCqXQmfjuWG3oL_M3v3H9EZaeYQR0DIJlGi7tchq2JF_JoqOxokhVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zpzGLy5rVUpyCI-RHqIX_b3LZ94Q-Gs2Z1TH9SxbXBA&oe=6A0B2560"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
l3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRo8nVe3ye4Q7kNvwEUWzOA&_nc_oc=AdoCOSx9UetpUGZWx-ogMfbkp3hSEGbsk1tTFCAe5BjOzkf4nTRCr-A0RD9kpewqxfI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMylJDHEMH3dUsdEzSa81pFaNORSnxFKSA6xZ_3zRaISA&oe=6ADCA7A9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuULCCE9oRUQ7kNvwE0lh8O&_nc_oc=AdomFmVvpxBNSKAK65WcCjI66eUfL-_mAgo7-e_BgGBN6zlfliPlOpo7vQ_M3xKZBBY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCqu6FN57KZmtZV8kmnGa3grDzoZh3UXPcKhDgQIboFQ&oe=6ADCCD1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buSF2Lh0tb0Q7kNvwGK_mLr&_nc_oc=Adq4_afSGFSzioMfCV6iBWOtHqwc07XeRmXIU4BPRvccHWmgG3AqTIUMC20TyrwmdXg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjZOUcppck_8Q7M2HHlv_DnmfDyIE-5VZh9WwBkAH8Ig&oe=6ADCC39A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycjtZZtqlEsQ7kNvwEaesbj&_nc_oc=Adqm6mSQSY7qz0R4HNzxoxcUSYeiJY6WcFd-PiPYAFU13H1k5plx6JS3ctF0ZiWTKC0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO76h4_KL-iCUap2iF8MsQkl9Lnm9MT1A88TdVw13zrCA&oe=6ADCC3E0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haJkGGDgNnYQ7kNvwHuRSWS&_nc_oc=AdrRWqFSiSBi-cmv0tZSFR_WTwwpeUlyf_FJkDHFW2IKPu4lim8gp0HvM8Ax_ic23bc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPueYYAP0ChZ-YUQYlhV2SaP-a7yD7R9wIGACI4Kz7slA&oe=6ADCD0C4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
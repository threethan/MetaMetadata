ps://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4O8erQa5_NYQ7kNvwESAkfc&_nc_oc=AdpM06KHtDjEyFNaB0munjwB5QeCHd6JRYg8UgHQYrG1sMxmdVzpDwa208q162d_l9o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C4TKc1wTAWcDjGn8nxhxZpu-bYn5MnOlKMkmEWIJCnA&oe=6A451173"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyrl0FoDDakQ7kNvwG87eIc&_nc_oc=AdpatMO7T9uiX38XZvLno507lGAPHRJ4e9zCsT9GN8oo8Am8RadBwYtxx1O-HN_YP_Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IGW43HO8Ft7hhbWcfPD8vh5XWNK8eQj2amRR8kTYD1w&oe=6A450B29"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ksw3MeWAAYQ7kNvwE102Ru&_nc_oc=AdrySJ0F3sZ5Hf-yxFVr5iLlQSN0huEE7ElVjUO-s5kqR5JtTjqe9S5RG3YvB5Mqh3A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cKnBFEcXiFzSaj4R4yf6_KaxjIubgZWN6nJ9mwV7-uw&oe=6A452281"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvJviCdjUZUQ7kNvwHHDVVW&_nc_oc=AdrRLmyH-0a6N5DAXHMdQkFBzRY5FrxXNe6okC4Ktqhe8gOyAiXvsr2uqocFaJMG6wE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8jDA9OuaqCibb6TQwk8puLegIVRJkNktaKFuYcAVP0A&oe=6A4528D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKDj-scbJogQ7kNvwGU_Lbu&_nc_oc=AdqQpQQmGrM2Fp9PqH2TL-iR8f7GWObBNQ3vscTEh0NV_KXGdC1rXbZo2JptrnfYLn0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0oGd4kD7CVDrHPFjspx3_qdYVYmhjltwBWbG73ZuGHg&oe=6A452760"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
d6-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxJ8J7jDBS8Q7kNvwGhDT2H&_nc_oc=AdpWmZ4oqX4ntDOxLPfNdtjaWJFb3Lzb4_r8Mvktnzxoyo-sRk2pCNR3al-BCk6p9Uo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfLH3G4s8x4JtFerU6NhuOiSxiubS2tu53q50WJad0tw&oe=6AEB6069"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_ucD33cp9AQ7kNvwGlkmXM&_nc_oc=AdpwAW8gmqA7PPBoAU7BipumksplXr1TOadiy2FP7YR7vAqi_IMGubS2dZc4aqNEJAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVWd6KCLuCxl2N-i4cAdnpbKXD2J4rnvcO9euFOK1cIw&oe=6AEB4D9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Lwxh_6SmHYQ7kNvwENVJPR&_nc_oc=AdqqixfXoPZIQuL1rWco3nP5aQ-evup6iOcE012xmZ6kaYBCg2AzPEFiP6FPGf9-CMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTSmuUPGrLhUtTsJ50dctl9KUkFJOSnNscuKJfvgS4EQ&oe=6AEB441A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDIGwS3oTmQQ7kNvwG-a_3k&_nc_oc=Adq6IhS2vm3jBk0kTzqe7ED2uUFr8ogxjZtmwwY99Karxjd606fEGQpVXKIYC9Br4h8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0l8L6qJC6oXFgjNSev2gftyrz1LoaPJvtahu_rbKDnQ&oe=6AEB4460"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVP7TdbMDOoQ7kNvwH0R5nv&_nc_oc=AdqRKFcBQJGswpD2Y6JMVWKZsvj_elR8Kx_lns29lmRDqLebt-wV2s0tX4YLredsq3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqeqy8KbpSaGD9H90nM0pQj_xYO2R7Elw4BAktk0-Zkw&oe=6AEB5144"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
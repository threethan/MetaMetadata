d5-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzZVFJYyABAQ7kNvwEzQ2Er&_nc_oc=AdpJ6ZXH1uv1XmwdYZG1U1bAQKGtpTYeM4qaf9-NpKJtZXqisdq7ufNfCa44jLmZDuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD5JtpUndY4KzgBue2ZnaYO-TwKzmXQwu1XVvhxdZggg&oe=6AB3C929"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeYZaf3Y1rcQ7kNvwFVT4QY&_nc_oc=Adr9U-npakRPdyg7Jt8Pwz7w6qUGQzDUeYq85BD-OQww_1ZsJa0fKSppOKTEDgPh9A8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtJTi8zdakmPZEM_Swt3GMzsv9aGSFxZIsU3_XdIL7Ig&oe=6AB3EE9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DARJ8lSaarEQ7kNvwEMWFPO&_nc_oc=AdrpAQO8g3kaera-8egmbrZ2H40apqJVfysRVpT8-C-55wiiIoXW01oIg98pFkYHJgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEJHNyuBIFYamOTGzVV8WXwdLSEj4ACQFN2AuMARsvQg&oe=6AB3E51A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSWiUkB6hdcQ7kNvwExV_kA&_nc_oc=AdrAzPrNV9Mk-Kfivai6EBYc8SMYV2AyDk-haXxiO0kthRMGi-r_VUAe1ylk1Gj_nsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtd8wLhXiRK4hmuO2bHBc7R0C6pQi9d7FSyDb-OVHzRw&oe=6AB3E560"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLctwmBzD_wQ7kNvwGmfcf7&_nc_oc=Adq0gL_w9ij4-n148XamywjjEptVjI0uX6mf6hGX6HE0qDUaMTIMO7xLnWdG0Bf_oB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2vclk47pVxab5gfVujW56VjjM9dT5pCC4TSHo6FIXOw&oe=6AB3F244"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
ps://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROb-INGpLVMQ7kNvwGGDp0I&_nc_oc=AdoYrPfCYjo-NXjL_c27HFcVEv4BdjuuER8rTmGLdD8lnmFcCrHYInmMJC_Q6-dwxgI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YYBSy1MK2lDGtatdh0YdEwl19BJQ3nfcHE-lZTt1N1Q&oe=6A2FF973"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmMDcpYo6A0Q7kNvwHtq4ip&_nc_oc=Adp8XV-7Og_Jy51KJlB44dA5LWTdoEUzcegQY5NJwiYx4eX-9pOOPGidNHjMW-8j7ik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ArU68FhlrHM-YNmTh5NukVLnBkae-JV1oBM6R4F0BHQ&oe=6A2FF329"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9GnEFs7gSYQ7kNvwGLT7YN&_nc_oc=AdoXtDGsW8uozH_g_PZJVBZvRFXOaTwM26HqPThf9Mxe5KfVXf_CsaNBxolorR3nufo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lRG5iGHTD6Wlj4PeEDq6GqVJ2q36ee0rIYMADiTtZZQ&oe=6A300A81"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWaESU3LajwQ7kNvwFs8Q-R&_nc_oc=AdpcoWcfaI6mOzo9IhwK8WDPIMA72uiMB418oIYFARTUpSUwDP_joFsfle96fW4gpa4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e3hNmG2zLi3CEXRsHm7i41oBVsfoHCyRczPmd3r8J3Q&oe=6A3010D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxioIHrLCpsQ7kNvwGDDzER&_nc_oc=AdrpLj5dSaliRiD6N88BI5KDVtTHmlposBDrCGs9o6zrT_9xp0MjCLId31ZQgjODpM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fOnBrxrTkd0YQsG985NESBygJHU-4Ffnl3lasSNWBzg&oe=6A300F60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
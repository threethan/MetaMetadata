content-sin6-3.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngow-xXu2-MQ7kNvwFWzB1x&_nc_oc=AdqPUzyhY4B_9gsIpG7CccSOGXaDebtZ-iR65gn-3Hqo9vkYLZCLt4sg5gkAmnFFhJ4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOi1AeAve18Z2FcZuRkJbASwfM4E4mQwy-qftE9_zppQ&oe=6AA3F729"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xD81A40uVo0Q7kNvwEabf37&_nc_oc=AdqvlhdrylYamjWxU-yITN1KE4XIw7QtRnY_3kJVRJ2Zga4tRjExpdHzN6Y8VGCTb5A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX0AnjRhy32LpM4GV1Ks7a49hy1GV7xtvQ1b5foR7I0A&oe=6AA41C9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SQB3vAuqIgQ7kNvwFuJps4&_nc_oc=AdrbVtboe3HUTyoX-QEKf2QoJOz7nsfJGIyUNbIccNtorwnVbUgF6T3c2ej4gBylcyQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO3N6oUq4gxuCdiVMBSARGoppHg9DBWNCOaPIySW6Mdg&oe=6AA4131A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcxINtS9onYQ7kNvwEWerGu&_nc_oc=AdokxGelgoIP0qIE4KcnGuBhEM2waXcnIfkgtu3xtGd95ZZow6CAxBFkLpRcAEqSj0g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdvBKT3ieKoI5DbVCGim_X795hn9H3CeSNPbCOED9Jfg&oe=6AA41360"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ky991FOVS40Q7kNvwEYl1bf&_nc_oc=Adr9Nx1ofT7guiv_xmf34u79CoOGCZUcqB9c6xXOgIT6jC1zSFH4BuGc7xyEf4Cq2ho&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBXk4wpdxaTo_7ljHuI1MCPgF7KQEIpMvqsHBlQGt25A&oe=6AA42044"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631
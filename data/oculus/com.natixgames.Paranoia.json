c_sid=6e7a0a&_nc_ohc=votptgF6g0QQ7kNvwHf1ZqG&_nc_oc=AdryqqNcxxKcAexiiVsh1R0qlV8R9ul-eOpijiNIHRFiiR5b_50U_aIvJVqFa9Om0Yc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP_kGZIRPXlKElMYaKBF3POcnYZ7m-5r0zGRV5-ursYg&oe=6B09ACE6"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF8Z0fR17KIQ7kNvwEsw8O8&_nc_oc=AdqfvW7FWV1cifHgi1kqLXF5VLJwbmcL28aCHXM3AcY2x0NRgoXK38PFjJBYsz7s6qU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1bXwXU-dtypAkEPD0-f_DtJxLZpX73IBuurGXLyXmxQ&oe=6B09B2E9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e6sdMKNbl8Q7kNvwGh-VGU&_nc_oc=AdrEwgvqR7l0RxszwI2r-M1SOO1cawAE7vYptkK3nYhDTQtQNshaGLbdbitHPbMxhhU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9UwnvoBPkGgEoe9lxn6Wkv7_KKVVeiATq1LHs514emw&oe=6B09A01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmUF7AkE6ikQ7kNvwGru0pf&_nc_oc=Adp8VvIstBIkMOYn6qMtVXe7ZhwZz2T4H4me0TCqKmOiC1wYKIpVptpsvNjzaa5_Oz4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4rndnh4jr1MLvJGSS8r09I-BGWDILjJBnWF5t_96zmQ&oe=6B09CEDA"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLN_rRJWmDUQ7kNvwG4DRpt&_nc_oc=Adrv8fVkx7YrLixUxkEvsZ7LmiycbYiF9ajkFfAG2gHDcreSEpGh1d0WO0uFD2yvmfY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXlZMMEVNBRUnnQSnsLQ8XBSIfRFJPkGjHEfSEag3tVQ&oe=6B09CF20"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oc
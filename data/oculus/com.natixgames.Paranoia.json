d6-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo2JBoES7YIQ7kNvwHNk0uQ&_nc_oc=Ado7nyXNYJv8Gtt6Lc1nxRpHl03RntraVt6SeWdhkTSnQDVokl5XZejwWTxqwuEYwBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN8l-h-G5Q68krWkox68a69H2rsc-N8GQ_n0gdwLzhAA&oe=6AE490A9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZqni8shoNQQ7kNvwFYZBn8&_nc_oc=AdpcqR_mKYIiCIvsMX8-TWpPXsXR_GZu2xEBJRPs0DfJsh8vR_Ui_BUWVFaEmD4Gy4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9Riiz88LPmgDU8xzFkgPJCmFC_fQc57iNWbwAc1djBQ&oe=6AE4B61F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vcxr6hFXS38Q7kNvwE7oj2_&_nc_oc=AdqZVBFTXL6nZgWsq_DvcxqAWDi1owSks2t0Z59JtXQsaVrqafQ-QvGmE8bPFUfzTkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOh5LV_rWBC7tQI5IZiLnzncQYOnD-anPI-b57hiRYWw&oe=6AE4AC9A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qw7vZ3VxGHoQ7kNvwFbILcE&_nc_oc=Adr2TVhFFoqG4-aUUlR7LBISjKRAvLP3dIzHHbIoPwzEJhqfueYhiYn4t_X3O5usnds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE_szB-vMEqIWPWqHSH8k42rlwKXguInyqkhMjVnRDkg&oe=6AE4ACE0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIrXCMGRRLAQ7kNvwHBMeVv&_nc_oc=AdpDjCuTXltP0ZlrYLFzpxgNyKNjzf4aXCYjir_kfYMZhIfw4Z8K6LTDYOI803kIMnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO18WHco0PwWdVFq8tqkGSaffYus633_oIoGauIH9X6Tw&oe=6AE4B9C4"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
c_sid=6e7a0a&_nc_ohc=DMUJuCPMzRMQ7kNvwEQ0Cer&_nc_oc=AdoBLiGUkPLOWWtZAIQ9GR7U4_8vMNa4lvwKPwqVHQ_4AfJO7AzBI_fCbkQBhfUXEFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQd8ATRCaRumitiVJgS5covyJ1gHUBOREq0knZHlmOD-w&oe=6B0C4FE6"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Fy2LYhiUcYQ7kNvwHO3t1C&_nc_oc=AdqED4g5murKkTUzydfqKZd94w0KOGKH5462dN4qLqeQTB8QCGM_e-8zr_xMARB7C_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSl7AA3c7B_zMmloZAFKvdhyl9B8OymyZ5x3JWB9_b9hg&oe=6B0C55E9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFsdbd6KHT0Q7kNvwGcTfx4&_nc_oc=AdpjwzUD1lNykWy8B7zk7bgKqPer7oHgV549zqXMQez6qoYJRsWpgl3sGUL2OTVbsTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbFgcMVo1zwV5sUXi8cbeqFXdl0S_QIZH65xHMEWLwNQ&oe=6B0C7B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41pCm7cc_YQ7kNvwFG8jrR&_nc_oc=AdrmZF5ett3puq0LVdQhU5a1ayjOiSnynxWDu8YR79PB0JY43o2jqYFuTfrrv1HWql8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROnUeqV8AVS0YVYnc94JJommIfx2nm9WLHmhvo4IMkIw&oe=6B0C71DA"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfGdOdt9T6EQ7kNvwHI0Pcy&_nc_oc=Adp0zrtVt9z0c7AxjdiMltTuEjYGXQhoOqia1n4cFelMq32rfGfKtSfUL7b7ODJtQJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRapOjlS9H0k9I5gQJ9aB81RfzjW0ErYLwqUmv8F5tcQw&oe=6B0C7220"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oc
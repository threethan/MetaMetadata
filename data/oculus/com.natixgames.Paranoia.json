c_sid=6e7a0a&_nc_ohc=votptgF6g0QQ7kNvwE66-9T&_nc_oc=AdqUTlvW_PCv9AskdWF6jFyPuIXI2M934KMio34JH3bRWcxAtwiu4uD21XOWRp8VGM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWUGNy2rLfB0bKb_kewVWioCprZPRWUOmxZqIFh6kGSQ&oe=6B0709E6"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF8Z0fR17KIQ7kNvwFFVPK-&_nc_oc=AdpcDfBnkfuLEJouo-sWsSJv28WFtfEivYFZkQdIS4ojVuN4hfitqU8XGarDwEDNexI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuEAoWHBA-HWG1xTXGUfiv5vmy2WiQ921gGxk5sgoFYg&oe=6B070FE9"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e6sdMKNbl8Q7kNvwG0CSYV&_nc_oc=Adpv5xVckSdUKQiASJxbTBlVkUxan2b4IJz_FpIEtMB099hWVxZJTOYoRTwupvlYnmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9OJg0VY84_KBzKRkq65yqspcRzwGFXyrjTjObBKH6HQ&oe=6B06FD1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aubhu3jvC4UQ7kNvwFCnAzc&_nc_oc=AdpgBNwif0bbCcbrJ-EubOBoqBCfNS7NaPS-_tCWd0ueKoT6ovx5DkLfjQ-8BFtcxkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzwtS_yEuynON8TIuHIWYksCx-fUoSTaHq69L1vImOng&oe=6B06F39A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usSVyjtB09kQ7kNvwGLv37t&_nc_oc=Adr-uid1VM13hUJDWqDJYHiRDwDZtuDmgcBtABsqicQG9OeQqDfU8rQ8f4hbsLsYvgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAe__BI_7THbNLkS1kDYttDEKGQf_3et_ycS1VJYaTSA&oe=6B06F3E0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oc
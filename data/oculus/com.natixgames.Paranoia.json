ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpNXPcbIWSAQ7kNvwEODM2S&_nc_oc=AdrTSe_Cg2Uw24SPuUniQPfcF5RDN6KU9WTcM3FWHVhU_F4n6KtcbDpFqlsuj4PhwM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTgWRVRQnyUFKXBPOzxOe5sBWj8VHRSmXqvjQl-Hf9Mg&oe=6A675873"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f29KfMKcPEYQ7kNvwEnrPPZ&_nc_oc=AdpELsF3O3yc2mnOOPuB6i9NcyWSz6o4zeE8AbhX_41cUK0wvWzQf6IPSaPKGs11rhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7UQk2SAPL82Ab5pAJEMJMdN66S2MjQMmMGQ8-YI3J2w&oe=6A675229"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRch4s_nMtAQ7kNvwFDGoHl&_nc_oc=AdrksHeqNajPOQKepwmQJ8KInDNeOx3pxEhBrpQBr5FKzz1ObWcuLRlKglHeH9DH-z8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfnvqOGjo_ESauh19xCAmRzv1btbqbZuvLSotJwsA1Kg&oe=6A676981"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmpwahkeewYQ7kNvwHJr3JJ&_nc_oc=AdqwblW_Nqgin4YJ7xHbV_y2qZ_cJ3NBt0LvGE-GDVUeLoOAWkWqfhAXbox9QsC7Ft4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqywBnwW8AXqjarO4WPxBv31sVRihqHyseNqOtgufm0Q&oe=6A676FD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqC0ScccCvEQ7kNvwG088XP&_nc_oc=AdrPDnBVc31eu_ySxpAKPFuXPexi9hsKLJIeTKav-PmHFv0PtMnnw9VuwoDKv6MVClM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrYFpWQgx_ip39ZTaeN40sbP__sO7gSSxqXZvcfqyXmQ&oe=6A676E60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
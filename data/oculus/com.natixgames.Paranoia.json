content-sin6-3.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPZq3JRWcF8Q7kNvwEtSlVI&_nc_oc=AdrOmwAkpy6g0umPQrzy4hDRV763pOGeWchoXuSA0xy3lgJLtucOMg7XfByg0-_axfw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpEOCIZchZbhja0wAN9ZeLRJ65Ait6U20KPZ0mtkb89w&oe=6AAE8329"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYny4mgwMusQ7kNvwFU9huW&_nc_oc=AdoX-FdHMKYcLHXWtes8jaODsQpFSm7Bok9fUOvULHkkMfHqrfw9z0HPNxlB4sRpD68&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWhuNOFKRJcKw5s-y7d9mUCvgCHzQXewfAg97F1qq0pA&oe=6AAEA89F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex2UHx5coAwQ7kNvwG8q2_s&_nc_oc=Adowl5rkAcusQao5znr555tdDhv2Xk-n3QLr9DP8h5KqC8JSEbe9OixkLtMCMc_dtMI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4EbbK5-cU1mYvXWi6prcXHDatnzccz3GeQYrxsf3X7g&oe=6AAE9F1A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9D4RWOlYXIQ7kNvwHvhvZb&_nc_oc=AdqYXFYs3X0oD8m-YzaLmObCBataEJ57KuQc8filgcQX7Y3H1GJVG3uAS2AZWYuTMuE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM-x5ZNRhI97Ud9r7DIbfJeEjZK5t1iRE5B5Vo8Ym0lw&oe=6AAE9F60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbT_Td7lKTEQ7kNvwGAok9C&_nc_oc=AdoHX1q0XxnJDpXDI0PVjxkFNoYZKVuviSzVSZJIHpuOsxmUu8R4wSInWuGhYeVcZMI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqjVkDslf6j5ZZVLZDCMloIO6_o3d3noidYNQTQokUYQ&oe=6AAEAC44"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631
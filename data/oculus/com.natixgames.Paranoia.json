w5-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo2JBoES7YIQ7kNvwG1yhQu&_nc_oc=AdpGVzBfsX2VWuX8G-q54G-TSch9Gc4YprM7vGn0lWq3D-TbujvNiKnhUw4QqlsRtdU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRS69Z0ZvuZVOZhkWSlHcXG3qlbtynvFfx4va5Lz30ew&oe=6AE33F29"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZqni8shoNQQ7kNvwGzu6Rc&_nc_oc=AdpIcr64ubaFR5JHtYwrf9-n5I-PvxDMgF6UR1hML_C9T3zkLfATOcOWhgdPjZbc-TU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC5yPJ31xh-GV2391zwv7LetjFo8u8Q8PUElODohjQvg&oe=6AE3649F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqwK4MWNnf4Q7kNvwFbPili&_nc_oc=AdrnMKRc1iDF_kT3bOg3L2Oeo421we-Z4f71vtPELlOnVepOAZJk3keVbSwcI7Iafyg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9DE2dQkz8H5r-w5RgxoSBb2jOXDDXTjexm3pLKcfwQA&oe=6AE35B1A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lazay46H8YMQ7kNvwEshLry&_nc_oc=AdqO9BVXnLqK_Q9YzJ0gxipBTU8gXzpZw-nWJPHvs5YsZf9o5S5CkCHhMuP0GoDQyak&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpwX266D934uyGaT5rBxjG00gEsKZHtBT3UlaoxdvhyQ&oe=6AE35B60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIrXCMGRRLAQ7kNvwHlTAx8&_nc_oc=Adp24r8_Hh3SvZ_Mbe7vuwh6oC8pC3Bv8Pa1gSxB8lgyZlRJ1lGZPU4xZ12EyPTAags&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaJyni2RRFZD_aq1unLbVDRD1JRFJ0pZJ1PvIlwE66Vw&oe=6AE36844"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
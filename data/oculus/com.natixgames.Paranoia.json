c_sid=6e7a0a&_nc_ohc=Oqpnx42LtsgQ7kNvwG8DBk6&_nc_oc=AdrEhQWHwPZa5qVQibFwzQS43cSo_CyrQQRKpL6jB3EI80yHyL9Fqisw8mOPxzZkVU0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR91mMp1aNGHpsR2Swi4HUTS6W1ca0jcHR_JzMyDH4cew&oe=6B031566"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuZjhJsoouAQ7kNvwGtOVGQ&_nc_oc=AdobO6i1hZ00EYiWoEoZRG7uFmnp8d-mlznI7tHCDcoanL-csB8qY29qW6FUbs5VcaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ88Yue0WhBdj8DgOo96krp9E70APxff8sRNHV0FkWl1Q&oe=6B031B69"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuVbx2Kx_M8Q7kNvwFPmGUv&_nc_oc=AdrZhRCpbV9695ma7qWeLTiFduJSpFAmCCOup6bb9nAxFF0CiqLzQkykoiHdrIB3IKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe_vcJPOEFvhtGgghLBTVFwc9nns0PjRwpErbOmoWtoQ&oe=6B03089F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpFhLukv1HQQ7kNvwFLN_rV&_nc_oc=Adqr5mrBH_ROKsYUkS6HAjmXhNz_-50qdUDCpN0LHqt2137C8NtxEGP-wVAt8JN9Poo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKFEymHc8OU2HQ0wVkqNzQRYMebnmtR6jlmVeWRMB9KA&oe=6B03375A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr1zPMtnzRQQ7kNvwH74FEt&_nc_oc=AdrOShm7X5Tckc0p7ZLRXb1d-5STvHRC7jmMgKCZI-56X5Y78NIEwn4NUXspIKSKdPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScbQJokQ-CeDD9Io6_U119k6_qhwjdL7-sudNNBpHRrQ&oe=6B0337A0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oc
d5-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzX4Ua7LDscQ7kNvwGb5om7&_nc_oc=AdpLpln6rlif0ZZmoFTC8bwbZ83SvIZMB6CyVw-6F26PeBN5joJZFUWi3keL01PDMf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjG8oAMP8JGoBX7NEFHfreuXfzGQmKAB--ImhURkfJtw&oe=6ABBB229"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ec-Puni8hQQ7kNvwFNaDF5&_nc_oc=AdqA5AyvKlMmPC9xCfzrFH4Dpyl58VOo781Cy2mm0qxRSuE3FwvPu4U3zf_A1XInydk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFkWQk2TsvYJBUOfpvgOW7-mdxZFhvfxoIRDo3VaOjOw&oe=6ABBD79F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IZSb5YqifYQ7kNvwEzarg7&_nc_oc=AdqAxjW9GkP1NBdXBUdQJpIKstpeDzmhCBDkwBO57IEt32o2ouvGhGaUN5jsDyJlFGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpqJhiILZBzEOjv9D3ix6ak0O4ki3SPn08H_CfBXVjQw&oe=6ABBCE1A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_TGqKNzHO8Q7kNvwHZBIjq&_nc_oc=Adr0RIVoohLi3abHPLQzYTxR8-RBRw6Cwaxl4S7N3ziI3OR3vLvhYW8it6Xrree1hyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1L8MDwC5ybrE2y4-T2mh8dEzYBD-_YBIKuzhzuD9aCg&oe=6ABBCE60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhs1NkiG_hkQ7kNvwEDR2OP&_nc_oc=AdqIDZ5lpeJ99vq8kGibf7r4E-BYXDn51Kj1BXGBtuetF1c0p1cGaMNm_cAr8YAjblQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEfcytKGrBGoMvsiiO-Ps7hQyyG8zY99ohvYl5drgTlQ&oe=6ABBDB44"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
d5-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-JmAi3N_aUQ7kNvwE5jqHa&_nc_oc=AdrIwhmn8Jn98y9850K-46ilCIUshyfa81LvzUTgVMME3BFJRobegyLQurwfhtIf88Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjt4swSCL72W9gUNv8qoxHYlUqmHAC3AOGeL4888-rDA&oe=6AF88F69"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxchNOgjoMoQ7kNvwGKjEB1&_nc_oc=AdpyGsfxXroWE-g03Ay2zinf4TAJRSFiOlrpOq0RmlOohoN8A4wiKtwalrB9vqElSQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeCeqN3LxeHxxi4hud6o6YRbKSw2SZxYyg3hR8T7iv6w&oe=6AF87C9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsGEx3tP2TMQ7kNvwH19-26&_nc_oc=AdqpF3U5bW9H7MnKwqTSkUR7syImKSAz-yXmfX-CRMt21lQFA8NUzqKxbcjfO3FjDGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQAixI_WX-x-T_rv-90igl_XiDQlATYtcZKPzpekS6hA&oe=6AF8AB5A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27AglFsdJ-sQ7kNvwGQl7Zv&_nc_oc=AdqSt5g8fuvAQ8hFUNxAwT27Qtf7si_7p-l-rKqpzQXCZ2bXuwBPdd2U28zAYEBewVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrHgM-_53auY3pCX7rlO6WVqJiF0OhS2SqL11z5wcJ3w&oe=6AF8ABA0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1705714720055805_2395337190842649006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aizNR1LmqkQ7kNvwEjPXH5&_nc_oc=AdrPWCm7XlqFaEqatIwLgjc2t7i6QogwpsCOjD4mSWe6uTEmdIyQVKdBnF017StZX-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-1fdCqZUjQWVuLZXIBaj0fdaqaLCwDs3-RIk6whLC8A&oe=6AF88044"}, {"file_name": "ParanoiaVRprealphaprofilepicture512512.png", "id": "1457150868631396", "image_t
c_sid=6e7a0a&_nc_ohc=votptgF6g0QQ7kNvwGaRcl3&_nc_oc=AdoFAXKYjxtPUw4Ao0tbSv_TYrMseDHd1wmcW5vn7b6oTo1GaMDwxWlpwolwwAwa9YE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjRAaWjn8UdPFM8RfGJ5kkgc9wdWdJtiCHG1LOykvrKA&oe=6B085B66"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF8Z0fR17KIQ7kNvwGnfIci&_nc_oc=AdpnpKbl0cGo5z60s_4D-D7dA4K35jcNTWTt9F8q6wFpURQwckVxqe_fB0ygY09QXBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd4GGoQrKlMlwsE-FVTylaCqZ3a--d_54aK875vVUHTw&oe=6B086169"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e6sdMKNbl8Q7kNvwFpahjV&_nc_oc=AdoEl1_kJPwtLbY56gheFJtl1iBTXCDBi5HyhJwXeBl4eKTOsevrDY157XmShsl_pic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWjZBrVoP44eium_G3SlMoeYHcoHbYXZgPX1oaDsw8tg&oe=6B084E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmUF7AkE6ikQ7kNvwFO1rNw&_nc_oc=AdofYd5GDFTNH4weN7Irtgbq_oqIUc1DylFbH-fBGGCRiSXLj7YVaE3hfeIeqngQJhs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Z012aXglnFs-20Ax2nivg3K-kxdEq-TIpsp87Ffb6A&oe=6B08451A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLN_rRJWmDUQ7kNvwEVolVk&_nc_oc=AdoGXYhkhdFX7Nr-q7DU3enIuXI3PE240XBFlZNW6oFRrJMpGbF3z1uZg5Qhl-u3MW4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt0Ov-Q-6iKxDLfppWh8N4-_nMxQ60aoTpRSRmMSdpVA&oe=6B084560"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oc
ps://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAxAmp4e0YMQ7kNvwHhJfbV&_nc_oc=AdoCgPp2tL7XTdG_fCazsTSoNPEkUHRUqq_q_4Izcji1YI8nwQ3m12OwRtqzqGLX60k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG55m3ahfnTjLI0KoO3xHPSaDY6YP7Q55mFstlhy-rxVw&oe=6A71E473"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnvKMgzt8yEQ7kNvwG8bF-R&_nc_oc=Adq9rVnLYKoG-a2CcSap4uJcG3hrkbjkW2q_wWAwl0XtDiId0dwW2V22YGRGNRWOZVo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQF9maqL1elAoY-50ADMpwlTDx3RH8dh-wq2MZXU02kw&oe=6A71DE29"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV0KZb1FyPoQ7kNvwHf9R7a&_nc_oc=AdpLOsrLCWomscrqa8EyVfzbi2ae7tHiuharJ7zRbZrlnj1AYsgoAf8u_F8n6zdLSgc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbWjcQNBNK0KFJw7gtC12CUuYDelGDFsimUT3GCnR8iQ&oe=6A71F581"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBOMYOsf3PgQ7kNvwG8ELIX&_nc_oc=AdriDJNFMTJl4ws_0ze8GnOoq_UgmGZFtLtVkEeBGoRY_Mow8E668IkB7s9PF2szp44&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtlYJIhKAZ0pVTHYlNYzoWfzwbZZyvRpApHuwCsuyOSA&oe=6A71FBD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1_8IT4zb0MQ7kNvwGFuPoa&_nc_oc=AdpIfBdThSfBp4GHyeYTBz_l03U-9Fka819yw1Buj6dDMyN6LX1d0qaIfe4kZPUlbuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_UWlZXRBrAGSsVkiPCnmiqRXi7Vg0WZNyVV-ooUBkIQ&oe=6A71FA60"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
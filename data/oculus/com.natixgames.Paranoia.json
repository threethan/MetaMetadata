ps://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821194_4371697566492029_541857455963213860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNx_HjhjX8QQ7kNvwEda8dc&_nc_oc=Ado9HgRTBnRv6ms1HiCsNHyPFtXRz-tuAjIO2Hc4jWK-ffaXtLogCC8xvl0VcWNN2hM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSreQZ-phUgooKg6N8c4MkwHbpCG0d4qaokeJL2-T0og&oe=6A54E373"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3MG9RNr3OkQ7kNvwHsLgE0&_nc_oc=AdqvFsNWVSfZy_7_k2mbp564WNK2nnTAP5180aJP08OFGgA5UvrssrcsaBmk3IeXa1s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXIwDmo579lW9-pBTuSDPSkvfCbE_S1VpBe4fAVjOMEg&oe=6A54DD29"}, {"file_name": "KittyHouseForMeta.png", "id": "2314808122379173", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310731_2314808125712506_8010140038250007301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyMMRvLIH9YQ7kNvwEcgH-8&_nc_oc=AdpI62gNuqPCCZw5JhzvkVFR7R70pQJH_tQfMKTgVthSLZM9LMAd9fSbVyqQxmGvMPo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtObz61wOeegKnHQ7F-wBSVbjcoGUj8ZxlEDoAp4DyQw&oe=6A54F481"}, {"file_name": "TheEndForMeta.png", "id": "1623893172092881", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307326_1623893175426214_1144043362062611293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkSSK9ufMOgQ7kNvwHCGVXS&_nc_oc=AdqWPdY_38oCwxeh8RVZ2AxIQDJjhz58bUB_3veq0BoMdYn4NEYX4eOfXpglSlRzUzs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYH4IFvhH_EkAhBozLpPOpm1ZM25Dp2e3MoZklesuHUw&oe=6A54FAD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 10 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 10 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMh9UkyBz1MQ7kNvwGGxm0S&_nc_oc=AdqvNHTpeuuAG4orm5xCToQIo5e-sCp75ttI17DpCJxWks8t-BpJrOpuZcblYIsfq80&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATRlj86DtC3i-HePjWzONA548ckT3RpPyPlKcP2OZBVA&oe=6A54F960"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scon
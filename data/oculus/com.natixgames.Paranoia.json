c_sid=6e7a0a&_nc_ohc=f5fbv0VaTzgQ7kNvwH7Ex6A&_nc_oc=Adodd_5WquOG6rpVl6XUnzPijmnOoUayEKN2AuWDuhoMTgcGOQNL_5YQ3hmAf2yMFpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfJEbM4G0fF8pxrY3SrvZUJnRLxpCpa4R4EjqP_Vn2wQ&oe=6B104466"}, {"file_name": "LevelRFYLForMeta.png", "id": "1474896480932128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1474896484265461_3163817813111565521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcFWo_8fFxIQ7kNvwHeFN0T&_nc_oc=AdqgjYSREoIpoxBk3A07C28uwxQCAfWXX7fNZXDPtd05yLNMBeBmBCnxs9W2NF5p6LM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIkCdHaWCfJU-7POQNqtwWsVNio4NVv5Ete1hwoQbajw&oe=6B104A69"}, {"file_name": "HighresScreenshot00045.png", "id": "1041753642109736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296209_1041753645443069_7276873126208003404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp7sZooYKFQQ7kNvwHERgTV&_nc_oc=AdqSYLM1SSTN3ASpyWFamFDcrU7WtbYC7TfOS2sok2VGDyLb51OHnB1xCtLW0jEVm_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFKufF5VIzLrnaA0Pb-IC5EVcteTDbKb5-tp1FaQCOwA&oe=6B10379F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paranoia_EA_Trailer.png", "id": "1409128957439368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_1409128960772701_2211004428159692293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC9Zn6_GwOoQ7kNvwEoYShu&_nc_oc=Adqc-aM7Hw0GyyIIlBILoHhfVnQCHQZ4TWU7RZVdp-N0WKSpZ9YhQMukVvSKjwy9Lb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUObua9NhzoB_Zhy5XTPKMDY38JPdNvh7Jvq4AdMw0dww&oe=6B10665A"}, "display_name": "Paranoia", "keywords": ["Backrooms", "Horror", "Action", "Survival"], "long_description": "Paranoia is an psychological survival horror game designed for both single-player and multiplayer experiences, with a focus on replayability. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe with entities where nothing is safe. With over 12 levels to explore on release, over 3 game modes, and much more! \n\nTHE BACKROOMS (FREE-TO-TRY)\nExplore the vast world of the backrooms, avoid entities, drink almond water and run for your life.\n\nSOCIAL HUB (FREE-TO-PLAY)\nHang out and socialize in The Hub! Also known as the social hub, crack open a cold one and have a good time with friends and players from all around the world. \n\nEXPLORE MODE (FULL-GAME DLC REQUIRED)\nExplore the levels in Paranoia.\n\nRANDOMIZER MODE (FULL-GAME DLC REQUIRED)\nPlay all the levels in Paranoia in a random order every single time so you don't know what to expect!\n\nBe sure to join hundreds of explorers in the Paranoia Discord for info on updates, challenges, giveaways, and sneak peeks! discord.gg/paranoiavr", "short_description": "Paranoia is a psychological survival horror game for multiplayer with replayability in mind. It is set in an original universe inspired by the Backrooms. Enter the deepest trenches of an alternate universe full of entities where nowhere is safe. With 12 levels to explore (more to come in FREE updates), and 3 game modes. The game is free to try with gamemodes like \"THE BACKROOMS\" & \"SOCIAL HUB\".\n"}, {"images": {"nodes": [{"file_name": "PDPCoverArt_Pre_Alpha.png", "id": "2201954843590226", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2201954846923559_8079116199461756385_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROhXtoSQ6JkQ7kNvwFc9qit&_nc_oc=AdokoS9yQH2Igdnwp4Zk-2FfJx4JNd032Abwbo-9Kp56ujpSL3sCAB9M_y_SPQAScfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXlKQ85TYzYB8gro-P1s-ycvQSU9Gq0uaHIdYqP4UKOw&oe=6B1066A0"}, {"file_name": "CoverArtFOV150ParanoiaSquare.png", "id": "1705714713389139", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oc
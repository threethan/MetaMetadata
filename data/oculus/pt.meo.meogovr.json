.5771-25/11162773_1027115764055412_5793701579957731328_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPm_iWhAC8UQ7kNvwEJrFv_&_nc_oc=AdoyLutiutNy40seANeV1bwaz33ZIbyqCKOsBkTEpBgKllASdWS9XVj1IRRcbZuQK6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRepLaYsIcaUgoO2bjIYQWdjy77FF6xe6w4-ybRdY18IQ&oe=6B09BCF7"}, {"file_name": "migrated_image.png", "id": "233528857789169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162773_655175418019106_3169672120552652800_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5pF5vHV9AAQ7kNvwGvyHS2&_nc_oc=Adov38bqJevRZQ6wUbSOfM53-jSqdkAXV0_QCbGdCsNbKphJHbPc2Lr7Dz9qOdRILZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6yvWWLHedzdk3vF6r62oX8ni1GnJKKUcyp-5ob1gqgg&oe=6B09C3AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEO Go VR", "keywords": ["MEO", "TV", "LIVE", "REALIDADEVIRTUAL", "VR"], "long_description": "O MEO Go \u00e9 o servi\u00e7o de televis\u00e3o do MEO para tablet, smartphone e PC, eleito produto do Ano 2015 e distinguido com um Bronze Stevie Award na categoria Best Entertainment App nos International Business Awards 2014.\n\nExperimente tamb\u00e9m o MEO Go em realidade virtual.\n\nNa App MEO Go est\u00e3o dispon\u00edveis as seguintes funcionalidades:\n\u2022 Ver canais de televis\u00e3o em direto, incluindo canais de desporto, informa\u00e7\u00e3o, filmes e s\u00e9ries;\n\u2022 Ver conte\u00fados 360\u00ba atrav\u00e9s de uma experi\u00eancia totalmente imersiva.\n\nO MEO Go \u00e9 gr\u00e1tis para clientes com TV do MEO atrav\u00e9s da Internet de casa, consoante o pacote subscrito. Para aceder \u00e0s principais funcionalidades em qualquer liga\u00e7\u00e3o \u00e0 Internet em Portugal, \u00e9 necess\u00e1rio subscrever o MEO Go Multi.\n\nTr\u00e1fego inclu\u00eddo na Rede M\u00f3vel MEO e nos hotspots MEO WiFi.\n\nPara utilizar a App MEO Go, fa\u00e7a login com os seus dados da \u00c1rea de Cliente. Se ainda n\u00e3o est\u00e1 registado, aceda a meogo.pt.", "short_description": "Experimente tamb\u00e9m o MEO Go em realidade virtual para ver TV em direto e conte\u00fados 360\u00ba numa experi\u00eancia totalmente imersiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meo.pt/politica-de-privacidade", "developer_terms_of_service_url": "https://conteudos.meo.pt/meo/Documentos/Condicoes-Adesao/Condicoes-Adesao-servicos-comunicacoes-eletronicas-MEO-Mod-C1000600.pdf", "publisher_name": "MEO - Servi\u00e7os de Comunica\u00e7\u00f5es, S.A.", "support_website_url": null, "website_url": "http://meogo.pt/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "505872081124696"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1727512230655517", "version": "1.1.0"}, "id": "231108740690757", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1405542799519130", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1727512230655517"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2
D"}, {"file_name": "screenshot_4.png", "id": "4719257298360960", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_4719257301694293_1799390879344031057_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5vFkGEofZoQ7kNvwFY_ytO&_nc_oc=AdqrTIZQIWG_AujIA5NZ1fO_veyDWEywwGf-ajDJSoWe0Alp_bC5y57If2QGJ913o5E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE1XG1zFroKU5cXc1SFmS_yAfx32AdRLl-qejTjFTKTQ&oe=6AFB21EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1526723459489111", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823279_1526723466155777_3887127345007788511_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0iiZmL16DAQ7kNvwES-P5m&_nc_oc=AdpK2055mAbLFE2w6Oo7C4a962wzO5i0b4MhlDpMNUqsAqcNnXfRL43F2n02mcv9PXk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuIw_c_6VG-USQObB0PbKShN-ptyhn0D6ZGAdOXtF5ZQ&oe=6AFB3866"}, "display_name": "Flight Simulator New York", "keywords": ["flight", "simulator", "nyc", "jet", "pilot"], "long_description": "Flight Simulator New York puts you in the captain's seat over the real New York.\n\nTHE REAL NEW YORK\nBuilt from real aerial photography and real map data: the Empire State Building, the Chrysler Building's crown and One World Trade Center, Central Park in autumn colours, the Statue of Liberty, Times Square, the USS Intrepid, the Brooklyn, Manhattan, Queensboro, George Washington and Verrazzano bridges, the Hudson, the East River and the harbour. Four airports: JFK, LaGuardia, Newark and Teterboro.\n\nYOUR GLASS HANGAR\nEvery flight starts in your own glass hangar on the Brooklyn waterfront, Lower Manhattan across the river at golden hour. Walk around your aircraft, repaint them, power wash them clean, then choose one and fly.\n\nFOUR AIRCRAFT\nTwo private jets with glass cockpits, side-sticks and walk-through cabins, a cozy midsize jet with yokes and a club cabin, and a twin-engine supersonic fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: landings at JFK and LaGuardia, a sunset hop to Newark, the Hudson River corridor, a skyline run up the East River, a harbour run past the Statue, a fighter scramble, a night run over Midtown and a New York tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join up on a friend's wing or ride in their aircraft. Voice chat stays off until you turn it on.", "short_description": "Fly the real New York, built from real aerial photography: Manhattan's skyline, the Statue of Liberty, Central Park, the great bridges and the harbour, with four airports. Start in your own glass hangar in Brooklyn and take out two private jets with walk-through cabins, a cozy midsize jet or a twin-engine fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatornewyork/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatornewyork/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1366122266580636"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "fi
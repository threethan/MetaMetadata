scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV00B6PlZhlLfsQB7YvzTZ-AYSaY9XKnvC4FKRTjU4VQ&oe=6AF35663"}, {"file_name": "screenshot_2.png", "id": "1104107505976324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1104107509309657_7786485010060373822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzxRgTNqOYIQ7kNvwFhrYdY&_nc_oc=Adp_aoZToBojK83wJlB1dZbvXoVHVS7zMltNmUWb6hxCbQ_Ile3n9w9m3dkiDzbQJaE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJHwDEa2UkAda1wIAjrOfyHjEGsU9adSZyokzy72btIQ&oe=6AF3563C"}, {"file_name": "screenshot_5.png", "id": "2564261457410883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_2564261460744216_1888540399726162712_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScxZYVwgX_oQ7kNvwEWTT1X&_nc_oc=AdpZPXgCR2-kNTEDy64vxJsoiugon7PNPeskuTGslKuNCp5VSzu_25WsyFu_5FWyUqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQngwRxMmA2itiKvtHed0V1ze7KqCDNbcmk1B5YZQVMEg&oe=6AF348ED"}, {"file_name": "screenshot_4.png", "id": "4719257298360960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_4719257301694293_1799390879344031057_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdKwb_3a-OgQ7kNvwFjObpp&_nc_oc=AdpvtYY1tVIJwqzn-uLEtG3cwyDZHq5vKiKMBEDMUnvACC8H1ejYzmNMkXUwQyOoZXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw3ycT5c38s2S_lbqYVzV6Y2zCCc3u6nYbMr35NXkvfg&oe=6AF338EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1526723459489111", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_1526723466155777_3887127345007788511_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW3-xtItfkkQ7kNvwEKUwkc&_nc_oc=AdqUJAJ5a_Wbx-533eUNQ5XfRzEEafZDtF7gkS4obElCscTkthIr9fjyxBxXLd739VE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf_aOGdcKj2oGprLdpejykXKiiobqCfWm8paDOhwlJvA&oe=6AF34F66"}, "display_name": "Flight Simulator New York", "keywords": ["flight", "simulator", "nyc", "jet", "pilot"], "long_description": "Flight Simulator New York puts you in the captain's seat over the real New York.\n\nTHE REAL NEW YORK\nBuilt from real aerial photography and real map data: the Empire State Building, the Chrysler Building's crown and One World Trade Center, Central Park in autumn colours, the Statue of Liberty, Times Square, the USS Intrepid, the Brooklyn, Manhattan, Queensboro, George Washington and Verrazzano bridges, the Hudson, the East River and the harbour. Four airports: JFK, LaGuardia, Newark and Teterboro.\n\nYOUR GLASS HANGAR\nEvery flight starts in your own glass hangar on the Brooklyn waterfront, Lower Manhattan across the river at golden hour. Walk around your aircraft, repaint them, power wash them clean, then choose one and fly.\n\nFOUR AIRCRAFT\nTwo private jets with glass cockpits, side-sticks and walk-through cabins, a cozy midsize jet with yokes and a club cabin, and a twin-engine supersonic fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: landings at JFK and LaGuardia, a sunset hop to Newark, the Hudson River corridor, a skyline run up the East River, a harbour run past the Statue, a fighter scramble, a night run over Midtown and a New York tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join up on a friend's wing or ride in their aircraft. Voice chat stays off until you turn it on.", "short_description": "Fly the real New York, built from real aerial photography: Manhattan's skyline, the Statue of Liberty, Central Park, the great bridges and the harbour, with four airports. Start in your own glass hangar in Brooklyn and take out two private jets with walk-through cabins, a cozy midsize jet or a twin-engine fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatornewyork/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatornewyork/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1366122266580636"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1413982900120084"}]}, "baseline_offer": {"id": "1413982900120084"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791384180, "status": "PUBLISHED", "id": "1413982900120084"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1373930979133098", "version": "1.0.2"}, "id": "1089293340631778", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1366122263247303", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373930979133098"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1089293340631778"}]}, "change_log": "v1.0.2 - cockpit stability at altitude, seated fighter stick, bizjet interior fixes.", "created_date": 1791649101, "id": "1373930979133098", "version": "1.0.2", "version_code": 8, "release_status": "RELEASED", "st
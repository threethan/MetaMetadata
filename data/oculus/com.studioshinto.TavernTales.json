XIIQ7kNvwE2ejHd&_nc_oc=AdqMdLHOrTo8mI0sh8nHDcX0tHcF-bf5Q9EZRqEzMSpDD_xJp28eg5IW-h37KG2b414&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT13Nc6FWKlKgSstZv1jS2VsglX6LG36U7o4SfEsRkN8w&oe=6B031CBB"}, {"file_name": "Screenshot2.png", "id": "1163948477507147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_1163948480840480_989692459859933806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w37f-6VPpWIQ7kNvwGzgxFP&_nc_oc=AdqW7hWvKs5kp1j0Gp-lXzxaEtvKU5uou7aCOfKPQmSXhmfupZ9osudFSKo2tMKO_jY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTINocFyRMlKLjY-I4jM3v8UsuLrm2gG38CYeYKgHaAA&oe=6B031EFA"}, {"file_name": "Screenshot4.png", "id": "819017035747911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974672_819017039081244_4344006924153884709_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4boNOiCCbYQ7kNvwEAGYHD&_nc_oc=AdrDxBjbp-QLDSXFgyGBXXyV_7afy6Y3LHsLQnQVtCh0KzIvNQUxSKcV9OBAx3iFLGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6mdfFvvO71TYQ7aJaJmmPWqJuTBm469w12dvRUzpADg&oe=6B03329D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail - Oculus Only.png", "id": "1211224272969387", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_1211224276302720_7251089283550905626_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x_omnynHK0Q7kNvwGcNnbE&_nc_oc=AdrVOEJnbW6bdHQH3nRrwiGQ-sc9DUj3Hh3GW7OyGE-DRpnEUZooJ93aKJv7hsLUfQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsV2lA5RFqY3HJuR2VlnF4jMllKfnmQ0l93zDQk_FpDQ&oe=6B03159C"}, "display_name": "Tavern Tales: Tabletop Adventures VR", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "490047973122444"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved
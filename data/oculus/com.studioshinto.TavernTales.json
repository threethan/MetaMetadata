_lsQ7kNvwFho1je&_nc_oc=AdpH6G2N_b5bVTteJQo3zopRSvl2Gv4DAYvhheCabEvv-BcQx8zwHsBk7lHxDmuY4QQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Ja5GcPZC6Y8ppZgG8FTRJ96bYZYUBZi5-MlmIVMLBA&oe=6B07113B"}, {"file_name": "Screenshot2.png", "id": "1163948477507147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1163948480840480_989692459859933806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itB4DwcWJUoQ7kNvwGB3y_8&_nc_oc=AdqmtF3xeGvHSlILZWYktpYHfkSas4GEQGDZywYuMIXRJGwHnyQImUSd783GvK5dgIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSkxz0yiV-fL9KYnTfjA432YoveoA1qyuI3Ab6v8hNLQ&oe=6B07137A"}, {"file_name": "Screenshot4.png", "id": "819017035747911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974672_819017039081244_4344006924153884709_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKhm20TRZbUQ7kNvwF4UeGV&_nc_oc=Adqo0rqMREnwIyZaKbLEhjn15mpraufbxDEzmvA-wsN5rtPz59RJdMM4BFhMTvqkGXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYgm8yxAj9fHB2XHzFTRjnte-Qq-D7rEKNFBtWVyhMUw&oe=6B07271D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail - Oculus Only.png", "id": "1211224272969387", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1211224276302720_7251089283550905626_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxyaS6ApFAUQ7kNvwHvXw50&_nc_oc=Adp2ecg7xPKoNRBhJd2BIiRudb-_ds2NupOrti8AwF43RHDdtdzPO53RAP3ASXm9ljw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy7x7DIa6aI0HSFaddFcwZafD825UNQkFZIyxYGtDg0g&oe=6B070A1C"}, "display_name": "Tavern Tales: Tabletop Adventures VR", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "490047973122444"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved
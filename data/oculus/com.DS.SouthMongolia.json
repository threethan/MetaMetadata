_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWKmsaVy_yoQ7kNvwG6oFY3&_nc_oc=AdrvGWQNqvh5G71OdhxrhByxOg-cF4eyLH5k28959XNK5CpXN2nApHTbinecomTOKEA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUvtkAxvZcab3p7kk4AyBYAAZbV5YKdYIt84helbROZA&oe=6B085B53"}, {"file_name": "5.png", "id": "535815539383363", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473393380_535815542716696_2694258091098906642_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNbqpqt7PkEQ7kNvwELQwKj&_nc_oc=AdpG8gwaBjwo2H5Qj5vkCusH3aVjplOZWspkmOm8QHOeFsyG_JqzS_vFfYnrltPDE4Q&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7tIf3BpA8khcs9EuQiInHyQ8K2e6EK_Qu5y-yG5CyOA&oe=6B084C8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nature of Southern Mongolia", "keywords": [], "long_description": "Southern Mongolia is a region of stark and powerful beauty, defined by the vast expanse of the Gobi Desert, one of the world\u2019s great deserts. This awe-inspiring landscape stretches across endless horizons, where golden sand dunes, gravel plains, and dramatic rock formations come together under a boundless sky. It is a land shaped over millennia by wind, sun, and time, offering a raw and timeless sense of place.\n\nTowering dunes like Khongoryn Els rise and fall like waves of sand, while deep canyons such as Yolyn Am and Dungenee Gorge cut through the rocky terrain, hiding pockets of ice and shade even in the height of summer. The Flaming Cliffs glow with fiery hues at sunset, revealing layers of ancient earth shaped by erosion and history. The terrain shifts from rolling desert to rugged mountains and dry riverbeds, creating a constantly changing visual tapestry.\n\nThis part of Mongolia holds a special silence\u2014vast, open, and still\u2014allowing for reflection and connection with the elemental world. Whether explored in person or through VR, the nature of southern Mongolia captures the imagination and reveals the profound beauty of one of Earth\u2019s most iconic desert landscapes.", "short_description": "Southern Mongolia is a breathtaking expanse of arid beauty, where the towering dunes of the Gobi Desert meet wind-carved canyons, rocky plateaus, and sun-scorched valleys. Shaped by time and elemental forces, its vast, open landscapes offer a sense of scale, silence, and timeless wonder."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9950182495040924"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "781668051660011"}, {"status": "PUBLISHED", "id": "591798126546460"}]}, "baseline_offer": {"id": "781668051660011"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773214560, "status": "PUBLISHED", "id": "781668051660011"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9959703180755522", "version": "1.0"}, "id": "1160147389243907", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBin
F6DE"}]}, "id": "1648259075826330", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "552331180891111", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393549_552331184224444_8334997988514631334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYusNMjN5XIQ7kNvwEt2GSo&_nc_oc=AdqUiFbJ-Eh3EV6cbR0aYy8PoG9YH46UaXbSMGR5_-EohGUuZyC6uxO_OKKNAdPkImo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nckcpPG5Cm74KH1cq_icuhb5UJz1qLzTQ7_mBfOKjsw&oe=69F1E8C0"}, {"file_name": "2.png", "id": "1226382565655190", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392179_1226382568988523_471409252289444084_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9a0Ys8tWusQ7kNvwGigINP&_nc_oc=Adr6ukpIVcl9xdRuwwmJoXN5_PZnf5U_AMVarMRWP2XpODe0CW210vS9HMm00oLVGl8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af124x026nHr36ZOcHy7DdEShPLpvmof2GBzQ_NDOuNzlA&oe=69F1FC80"}, {"file_name": "3.png", "id": "1354792979148831", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393567_1354792982482164_6183742860179659418_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bIwDXGceTgQ7kNvwHkN91J&_nc_oc=Adpfv-ZWmDzFXYNOquooN6SN13qRV1lbA4hB2dRML28UK4MDajB8T9Y3-3Xuffjwx5g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3CID5d2K_i-98Q310Ye02pjYnMFxPQDg1SlOqO4kwxZg&oe=69F1FE20"}, {"file_name": "4.png", "id": "1399610354684494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393594_1399610358017827_735884388946268284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSC8b__b9fsQ7kNvwFYtbhK&_nc_oc=AdqRvIA4LCZiK4UKEmT0UhmhEhYxlCM-IlNwk_ZjmKmaeRBBSxqgm_LRPO2W_p_B10s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3aiydeoFgQ-L2h5qY2vdHpIEiZsKEYhSVQN1U5ltNJkw&oe=69F1F693"}, {"file_name": "5.png", "id": "535815539383363", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393380_535815542716696_2694258091098906642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ennY6GvzgYsQ7kNvwFzbBQi&_nc_oc=AdoJaF7IGgZej7NaabSTwoXJEMLli1pHeje_uktbxvER9MVxQukvAtgNDZsrOtPRn4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0sPcdS6gQk7evuhmFJcqW-16HOjUB7gqjL40sFOO7BBA&oe=69F1E7CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nature of Southern Mongolia", "keywords": [], "long_description": "Southern Mongolia is a region of stark and powerful beauty, defined by the vast expanse of the Gobi Desert, one of the world\u2019s great deserts. This awe-inspiring landscape stretches across endless horizons, where golden sand dunes, gravel plains, and dramatic rock formations come together under a boundless sky. It is a land shaped over millennia by wind, sun, and time, offering a raw and timeless sense of place.\n\nTowering dunes like Khongoryn Els rise and fall like waves of sand, while deep canyons such as Yolyn Am and Dungenee Gorge cut through the rocky terrain, hiding pockets of ice and shade even in the height of summer. The Flaming Cliffs glow with fiery hues at sunset, revealing layers of ancient earth shaped by erosion and history. The terrain shifts from rolling desert to rugged mountains and dry riverbeds, creating a constantly changing visual tapestry.\n\nThis part of Mongolia holds a special silence\u2014vast, open, and still\u2014allowing for reflection and connection with the elemental world. Whether explored in person or through VR, the nature of southern Mongolia captures the imagination and reveals the profound beauty of one of Earth\u2019s most iconic desert landscapes.", "short_description": "Southern Mongolia is a breathtaking expanse of arid beauty, where the towering dunes of the Gobi Desert meet wind-carved canyons, rocky plateaus, and sun-scorched valleys. Shaped by time and elemental forces, its vast, open landscapes offer a sense of scale, silence, and timeless wonder."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publishe
_nc_ss=7f20f&oh=00_AQSJhIna6NQVqekr6cLwMvithjqYo_fSBrru4eIojsenAQ&oe=6AFDB46F"}, {"file_name": "Chapter1.png", "id": "1035378719176488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1035378722509821_4166782140710253991_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iY8n1xVTzucQ7kNvwH182xf&_nc_oc=Ado-IG_NYjuliDzPGakMyvphnxy052g2baT-4MRNx1jvsHPWq6WBAsokb35KPcIIRNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdye-jqO6zQlvutct3i-3u77VXxq2uAD_XPb2-qQqvAA&oe=6AFDE405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkiBusinessRemastered169.png", "id": "4416744848542634", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604302364_4416744851875967_7662424124251141086_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6EfgslXlzwQ7kNvwHB_6dY&_nc_oc=AdpkFNfOyxBkR0aryGhx1d5SusIPeHSk7sPKCJ7DZSeza2Rfr_UKbQ_4j_aUVOpwWeU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8khqEczgFoB7J74Jj44-mxg19Rj02bznwgCturAWmIQ&oe=6AFDD327"}, "display_name": "Monki Business Remastered", "keywords": [], "long_description": "Welcome to the world of Monki Business!\n\nSwing, climb, and traverse using nothing but your hands in a fast-paced, immersive VR experience. Whether you're playing solo or jumping into lobbies with friends, every room is a chance to explore, compete, and have fun.\n\nDiscover a variety of unique maps, each hiding secrets and new experiences waiting to be uncovered. From chaotic chases to relaxed exploration, there\u2019s always something happening in Monki Business.\n\nCustomize your Monki with stylish cosmetics, exclusive bundles, and unlockables that let you stand out in any lobby.\n\nCreate unforgettable moments, connect with others, and embrace the chaos.\n\nReject humanity\u2026 become Monki.", "short_description": "Swing, climb, and explore the world of Monki Business using only your hands in this fast-paced VR experience. Join friends or other players in lively lobbies, discover unique maps, and uncover hidden secrets. Customize your Monki with cosmetics and bundles, make unforgettable memories, and embrace the chaos\u2014reject humanity, become Monki."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusinessremastered/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "ZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusinessremastered/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26346893188334787"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1532211191619823"}, {"status": "PUBLISHED", "id": "1576178613951504"}]}, "baseline_offer": {"id": "1532211191619823"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785092400, "status": "PUBLISHED", "id": "1532211191619823"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27913042488386508", "version": "1.02"}, "id": "941321735285403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_
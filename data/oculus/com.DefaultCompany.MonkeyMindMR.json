985101"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLZG5kuN-tEQ7kNvwFNUyqh&_nc_oc=AdkHU5lXPpFgQhfeuLIF6e5tjmaR8QolQ_gj4a_ygSoCMiQt4o1wbcP_YWIapiuzj-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsur5Df4OjqKqu07LU1cxTaPU4xb4jvBqRbS5qqEjLblg&oe=69985C2F"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GKkWMfhcHUQ7kNvwFhhbty&_nc_oc=Adl2HklATGUetKr5vqFJXdy4JTNn1jYu6MBd8drAaP9_CsXp9H3L6nImI66_PRDE7iE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv0RMO1QOwzz7tCaW3vTtknzTp6_lSyE0LORyifzRxUMQ&oe=69985C7C"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlliZTt4YCAQ7kNvwFxxw0H&_nc_oc=AdkieSnk5I_LK-FTuZvg761RaCYMC9_qpoXo-ng2XZviRtriuMgD9nm5x54-FchkKtk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu9ba4cZxhIqpIYifxPuqLhsF9ojo4W7J-WrLJPRbit7g&oe=6998694C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XU60qEPShwQ7kNvwHNdmO2&_nc_oc=AdkKGI12o8acZ3alwD3vO0f6XYG6hTO2Lx5QyZU6Eunl7p5xkU_Ma9E7-2h0sWjNCrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftADqfuaJs5mLgZdR_D4twjgHDsx6paJE0kNHiBdNxJwQ&oe=69985C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RfnvYpS--oQ7kNvwFlmbXP&_nc_oc=Adk9b5nm2Jymx5UybFhr5tSOaXc5QdbKzqmn72s_kX--2qrnnrURknC8An5rbAqXICM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afszrt9P9HTn79Kf0RbfewEGMN9_OqLZEpwor3FwNDL_fg&oe=69986B0C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publi
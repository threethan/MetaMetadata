7&_nc_sid=6e7a0a&_nc_ohc=6s-bwhQtbEIQ7kNvwFcaSV1&_nc_oc=AdoE96ZiKi-I3U2qje_4TuRR5bSHwTbIA5nm2qUjbJgsmugRbvdQQIFrZCy6Jso4dDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzANtpLFclaICLPsbJ-5hZrUhV_5hLUz1TRhs9O01NnfQ&oe=69C91881"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJCKj5ZdmnkQ7kNvwGO1iji&_nc_oc=Adrk50Ehckp7S0SEsZDVVCsp9F_sfhE7TmwJJoI36b3kujtI-_zcKYa-PXGQijNw5aE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjVMPOAGZR_ZKqMk0IKHT_R1KAOVDaXAUolPojhUGhAw&oe=69C923AF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzAMC5mm5FYQ7kNvwHyG5Dl&_nc_oc=AdrJgB0FFHfk3V8nPIeOBBeNGiVwVdayvphJf8xV_vWV-bT5Sg6U5LQOznMfYmlkJhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMyY4iVpYyM0A0rLWEoorVZP6Tt7202ouVqzXhe7lo-w&oe=69C923FC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDDcIIWmC64Q7kNvwHwsKy0&_nc_oc=AdrGYqN_2QENmODliVLNFXwnNFe50yVQc_vj6VtyNG0kdsPXt4F1aJFyNVvJbQiUX9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3PcccqV6-eEbhVvmxZmz9N1fz0tLAcSsGaVhL7jAlHA&oe=69C930CC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcrFJ82HIxMQ7kNvwE6mq8R&_nc_oc=AdpivNTvwzoeJS3LUhujLJYFzK-v8JDbl2v29rF6b1lyJzs_ju4w9DU_aFoB32Ax6LE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCfmPJKY4L-LHQel8_GXSIaz_UOaxYj4dGZKhK0VGY3A&oe=69C9241D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRtCgj7V8PEQ7kNvwF9ZYug&_nc_oc=Adq1hSxT7xDi4_3nyyL_KyRtbug4ENGNqxrbqQC6KC23fft2zgMHlU9emiio8Op3Hmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoXb7Uqan4UAUJ91Ud9O8e6-JSfrXWQZ4kvStW7qEBkA&oe=69C9328C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1329198572093131"}, {"status": "PUBLISHED", "id": "984997160063227"}, {"status": "PUBLISHED", "id": "321848160845408"}]}, "baseline_offer": {"id": "321848160845408"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1329198572093131"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9615893088469165", "version": "1.0"}, "id": "1595788071170255", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7395323760526120", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "961589
391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9Z3zOgs6rgQ7kNvwED9E_X&_nc_oc=AdmHc1ZwcYjTyvxEu6qcOdNUVz6zNUuH0mLbF9l5mLeUy0o2WZraA4QgSY-8cM2qoiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhduyLm5tYmwjlBAH0zlU_UNxoKGrQhhfXCJ_2Tz5ivA&oe=69A6DCAF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zSZY6AUz64Q7kNvwEIlVhm&_nc_oc=Adln-5P2xvOZuZ1Zw9_KqqJzXjyD3sNjfm2eFiNoNMV5yA-Dysoky7hSAS5GWNguOQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2NS0ctDgV78-nGomoRVt8zUcB78aTx_pHFhuUEcOtIA&oe=69A6DCFC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig4SO9lKK_cQ7kNvwEtVSD7&_nc_oc=AdlrBzhPI4WlpP9ixQuwaEM9wC9C1jaiSAwP1kV08BerHU2yUnvmWpu456XNjxMCmbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvK_sgrVjzhJPjvYlEajT_8yZ-vIizwh-xiWhA7q-rEvg&oe=69A6E9CC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHyPox6cyXsQ7kNvwFI0QO-&_nc_oc=Adkp7JxXbosU1Cga3voABykWGDPpYrVT-q2IAMhV0nRQACM5si15YKFyFu3vbA5J0Ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afudg-GZGjF9KixQ7wz1vfVyq5JwGAxvvIjGkOuA6nd2uA&oe=69A6DD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U7WtqpSTE0Q7kNvwFs809W&_nc_oc=Adk_4Dus1AZjHjLgMds2CigBBLeDfw_T1KsRqu2WGNgAw-VnwiYhGBeq3oW78AgFlh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtCD08fYdtp__6_1fsKPtKuz1r41sk_0_vRMZ187HOtw&oe=69A6EB8C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "CO
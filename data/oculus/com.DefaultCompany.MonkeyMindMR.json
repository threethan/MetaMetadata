7&_nc_sid=6e7a0a&_nc_ohc=VALHp1ZBa5QQ7kNvwF_LYt2&_nc_oc=AdoX6n9xUKE7WeJuIKXjNjsvWSb9B4i7nHIVsYazGHcbNRnijd6sq9I14gPp3QXhods&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkdmaIKUSaRsWLzEYrYzXK7GnBSzq6_KR7O1Po2yUBcA&oe=6A4CEE81"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KygqjpPxqckQ7kNvwH9n-0r&_nc_oc=AdpXqOaNyYq-IX3TCKLXYUE1p9nxk1LRw5UxMUIyDEBZHq-x_6jxYJUklkM1h_42Ku0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-UIYu_xHUQ3FnJBk-ZSKW3ZqNs_lArg9tjLJUyAfZvw&oe=6A4CF9AF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZnMktDWv14Q7kNvwFwPVjQ&_nc_oc=AdqzHPubPpSAOa2Duy1yG2SzZcb2ndkzN_gZ58SR3MH62YfloXvbWzLjpNPgFAw2sFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuiA2edc3KB0jnMo9_NzS4Kky6kbtaaL_S7MO_LKEyvA&oe=6A4CF9FC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnR_A67uGuYQ7kNvwH4tU6w&_nc_oc=AdrnNX6YoolYud4F0D6FhlJsDi1G9iwXMYx73eqQIi6-dd2fIffcQ9GNJNjAfq_S3rI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdrOg_ZeuZfwJha2t64K2Eq_3O1fL5T0rlQLu8IGzKIA&oe=6A4D06CC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWcnyYRt9dAQ7kNvwH3z-QC&_nc_oc=Adpr4Jhm1cUCJEIXUFFSsmJ4AEv1_B5z3k6jGapTE_Q5gcveFGwG3336MxbU6tOYdSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNMkbPkJ-imCH5DX-PRDXSp4m-lkf4ZRLI6Mz33leeUw&oe=6A4CFA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFyO1sZjpmUQ7kNvwFJxIvA&_nc_oc=Adrkks1D2lbpWKCKAns5hx9XEb8fzfMJBf88DDOIbYyq5GnzW-je8rdyE1GizsTGOgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6rPx1ePka7jqlT3tE8u6zMBXk4DF88asVarvhavSSHA&oe=6A4D088C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9615893088469165", "version": "1.0"}, "id": "1595788071170255", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7395323760526120", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9615893088469165"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1595788071170255"}]}, "change_log": null, "created_date": 1740909273, "id": "9615893088469165", "version": "1.0", "version_code": 
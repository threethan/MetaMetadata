A2DD01"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwQAjs-EsvcQ7kNvwFkTe6m&_nc_oc=AdmkKG3i-wu934nukwwYtFWjqKOjnoWmpWwRi5ENByIB6xW4MVcLIqxStfrbqt44Fns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsU_czg4phBQCOtusDwa8a8q-aI81DIU8dbohQ7gT-Npw&oe=69A2E82F"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL4AJ9lHsTkQ7kNvwFdxT1c&_nc_oc=Adn_cWN_1zJIETe8buviU6l7zrWkjKg5yoN9Onty0U4TWWKRnY2fxFJKrRwapOBo-oY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsE6Y7dsSUfk8ta4pMtGmJwY7nJZi_t6T1qnGKIA64l6Q&oe=69A2E87C"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orvva5oXDOQQ7kNvwFIQaj7&_nc_oc=AdldNac5qwpnmJ1eKDuzncQ0BGTX-mcyvm7uh0eF9CWbkE4Yif-wwHiD_acdspXnlEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuW5_lxBCm_4PVvti6xOY5JpOVsl7UCoVNXmpzjvMgBTw&oe=69A2F54C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMlgwtnIkLwQ7kNvwHXNNqk&_nc_oc=AdmWglycecYWeMJzk9Vj7aBspu5F-FhAA2x2k1pTPr6Cj8V9EK6WzHGwsFDznPnHa5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHQ972yWGcNyuGaFgVo0BqyNSVkMJoqs_dS5CzEBj-GA&oe=69A2E89D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQ56aYdCBQsQ7kNvwF50zz3&_nc_oc=AdlPSMOVYh02O1rROwkoDePYgocWTOaFum_Fhk-VNcnUgE2oXkkys3n8Xi-VXQQ-vWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMgfCdi_ntHkXLEciro9o46r5apYLqWAT-vreye04rlA&oe=69A2F70C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publi
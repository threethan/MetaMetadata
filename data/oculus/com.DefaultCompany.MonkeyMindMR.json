t=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ86wpw01sezCTntCRDJxHzWpzWEYRaDZd_B2L3meHwA&oe=69BFDE01"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuSPGypC_swQ7kNvwGOHMF_&_nc_oc=AdmEKqfK32bAgmZG2x8rgoCetiag255ybCl6F3TMCwOOreiWL543M6bwaXzckHKGGtw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSR6I9Z9ohBADb3Cd0YYxU6Oy36EktOtGPRoLrTcRP1g&oe=69BFE92F"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABpj20RSqekQ7kNvwEDS4K2&_nc_oc=AdnJRDW-q42MnJzRoCg-FqNezDcX6dapCGZbWP9JgoYxv1ktXjbHj-X6zqDGX98ytkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO2U43Vb4Aas9nJCXOO6w_sDNH_ybbWhawRKJBVDO8Tw&oe=69BFE97C"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN8AF-KuCA8Q7kNvwE1O4dT&_nc_oc=AdmW1qUcqq4us3eDkyVkgNIoIH-x6lkEhSa4-X9zvCmqSm_U5sVcuFBxkUkWahn_vI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNh914Ajof1GE7VIxf8_MFQqBLEffi7fYSSEM1QtN3zg&oe=69BFF64C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4qkOgPTzboQ7kNvwFbSXes&_nc_oc=Adlq6WAGMFW3mPJTxqjpzI8TfAK7D1LKPqjuZjEhTI70AOKneqigwcx3GRmO81Qlyeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7AUSAZSzBFCaQgebNV_iglFX8HxDYGUwoGTUvnseVYA&oe=69BFE99D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypG14jhdR4MQ7kNvwFLIJH-&_nc_oc=Adk-LOUC3aw3DL_4IulBOwtHEQUirt7rcpLeAEUBMIDa_ETa32Kj1UwbevRfTHkHcZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwV-efM1Hu9UQSycgZww4cbsrWZC25hTZLyD02Q4wgUYg&oe=69BFF80C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392028_429592406810461_6687939514231589866_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB4ZCbs8BL4Q7kNvwEXmaMZ&_nc_oc=AdnvxYXYQg3CbYyRx_QlNGwySJBOoIZhqQE45AhqOjmWqeoRhmW130CeeNTA1yMVfKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK2nxmahROEeQWVtngjuJyHJuOvXmA5PdWpcy3jZhxGQ&oe=69BFF9F4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MonkeyMind", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1740761280, "lastRevision": {"nodes": [{"id": "7395323783859451", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7395323760526120", "is_first_party": false, "enable
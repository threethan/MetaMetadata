il": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMoNXp-5YSQQ7kNvwHPYjN2&_nc_oc=AdrjRozgdhLHmn-bDo_8zbDgxqj8bQs6V_FU0mTY1WSkLZRQMmSudud8le4XLfb2pZ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oa3kBmsF7m1QSQpSKZfNqPJ9qY6XpjGTIIWL8BZrWHw&oe=6A30078C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392028_429592406810461_6687939514231589866_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFDvAxHrBIYQ7kNvwG6MNlr&_nc_oc=AdoqRgn-GgLROckmteaRCpP1qDke2Ogs4Hg3ar7AKNi25IDl8SCY43ZGn6r5zYgYvd8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OOnD2KhSwgyoj3pGWji9wTaanhPDXZUw2iSQcgXHGlA&oe=6A300974"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MonkeyMind", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1740761280, "lastRevision": {"nodes": [{"id": "7395323783859451", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_loca
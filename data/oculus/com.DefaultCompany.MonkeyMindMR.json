02yOxePs6siMyUAFN_bwTNC_VHU4QIuyB5QzA&oe=6AFC896F"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lIceLJJu_0Q7kNvwH-Febu&_nc_oc=AdppF7H4_iWjfSmkQnm2Msc4gVZZtoKUhgT1CrAfF5YDmg-Q7E6RvTIDmeNI8khDWPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAFI_Czg7s4ho5Ska_fr43mpfqpu1xG-nuCwaO0HKIkg&oe=6AFC89BC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoDKHe9eq3MQ7kNvwHe_Ne-&_nc_oc=Adr8iPE8s_c0VY8j2xGEzHJL16EseHK9D_PgsiFyaNm921dh6aUx0ymxVjtz2tiQ86o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdziCZpmTp6R9MfvGN62Plfg1ee_8LIRUQO1rDsRWIUA&oe=6AFC968C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1LfRfU-ouIQ7kNvwEMqcqd&_nc_oc=AdqkdHz1aIC3RXILhXvE4ln76tztVmIE1imASdJeA0m9OB3AQyl5zdXQwPkaFs9cUPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT8d13oZkBPTKLgaXTUT3zojbQsos4SaLcLIX33bzN5g&oe=6AFC89DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AMSFuWoeXEQ7kNvwGI4D2L&_nc_oc=Adqgky7yjxr617zYCGZDzbg_OmkU202gLC24Jo5mxQtvNrq4tsJ6cTCwPwalYygNKm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSABvaZeESGXlKR4sB0vlbl22iqQYjt1J98nu2WHNHDiA&oe=6AFC600C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/monkeymind-privacy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
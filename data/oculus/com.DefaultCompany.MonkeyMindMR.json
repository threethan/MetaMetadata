BfCQh9MEfeKg0MxLQd-3pfTU7qTROjfgWy5Pg&oe=6AFF2C6F"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lIceLJJu_0Q7kNvwGsX2Wk&_nc_oc=AdrHUvj4Kyp8LJVnmnt7FnKq_EaCNXo-JjieXtJZ6UGnj2O4l8YWkDZu-laBcrT3or4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeuI8YcRNMNOBEydIF83hKjvIOQJwW2Tw8fddWrRiTFQ&oe=6AFF2CBC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WlHj9fYBdQQ7kNvwEYIN1j&_nc_oc=Adoftd8dXZgoxekQw_Szj7yTLtc5pWEGpL6G_3IdydLJAwjSPOQILTKo1VRu8foychk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIofZHps4uc3SgZhDcB6VjG3t__7Vw_TAC2eO6559f3Q&oe=6AFF014C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1LfRfU-ouIQ7kNvwHdHjB7&_nc_oc=AdrmYCfHIKXIqR2oPchuJJnnGb0-VydaAjntJvWFvhUz7xGASPD102iVjSv2W9mP6n8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-uZmm5cxKZr12P7_w6a-IjNXMKqH8_RMIb3SrJUBopA&oe=6AFF2CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VujYOE-X8hwQ7kNvwHxhpNJ&_nc_oc=Adq11dpjRNadShmZYVh5SqygzCOv62hnWsUu7EnbqzvD5z1pYKqdM2t4Qgk-A8lP8zM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfSrRPchZassEXFiVP0sL8IdZv_KQjbpyEMG17a4_-PQ&oe=6AFF030C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/monkeymind-privacy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
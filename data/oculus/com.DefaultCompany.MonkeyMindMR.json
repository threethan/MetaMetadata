t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-Pnfb3MMpXUrfkw9hXQyEji4fqjfUKhNofdzbO9WnNg&oe=69B94681"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WGFKen6lEsQ7kNvwGEwoMP&_nc_oc=AdmJBos1pcvTkGpmZc4-E2nhRw8ZGMjofo96hPL5xohUwMcJPND5n2-KZAdGO9bjEwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtP-vQAEy5lL2Eo9AjZ_hVzsYnj2jEWvz5GnXOgTH5Eg&oe=69B951AF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXR-gP1oVjYQ7kNvwEw9cH-&_nc_oc=AdlgpsLpid4q98R9afODMqWlm590sJTxIF--yM6jxp82kW2yGVIBFHhjOJVGgV4qTnw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5hiihKi4FnVNflYekj8WIhCvRnCmke-mEAk4QDy2XOg&oe=69B951FC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtYElALdOMAQ7kNvwF4AOdv&_nc_oc=AdkWrEQPJPprTgVG645P1fkhbU8iUlKskPPQc7KHsaR0XaFV3GDdLMsAq4HTizjijmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_9HrT9IEORrufigDvlzQTYjrS1-Gasre1URgPCrVP5w&oe=69B95ECC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KREJZ_jvpRQQ7kNvwFwkL3_&_nc_oc=AdlpZoVPAqkLLP4d2VDJBEwvwrsgETapWp7JMu-aJAS5KIYdu5nCSW16KmTKU7SU-hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsdGs14r2NiRGPC_9NkanAMFRb9TatcdZkZ-WEYuBdBw&oe=69B9521D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRquf_Bbmx0Q7kNvwGtVevb&_nc_oc=AdlxvNdjtMyLF8mVueuG-tJi1f8G3QwmCebWx-KjwrC2eEUqL20QzIwrHhK7A69ShOQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyEdmW8bZ-b0vXnjvii4R8WxvcpED9LAQVs2WQz-8cWA&oe=69B9608C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392028_429592406810461_6687939514231589866_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8bCwesBXkwQ7kNvwFdPkpg&_nc_oc=AdmzOl8XGfJFLeBcqf5OWcICN0ZbviWqXDv5Se70A_PReabtEq63sY0zAFHIkiFay5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzxUvyEkcSBAu60TpEed8eNnwuzGCejyQo1Akz8iawcGg&oe=69B96274"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MonkeyMind", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1740761280, "lastRevision": {"nodes": [{"id": "7395323783859451", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7395323760526120", "is_first_party": false, "enable
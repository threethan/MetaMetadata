-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7zgNnDYR9QQ7kNvwFcuSrq&_nc_oc=Adoxc8dxbQsH_mkxACGZydfzB1oPBA4PcCg3hGuh81bExsUjygGKe1qDO-mhAldWTUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHgLE060aFs4BCirHDk1kuWu1UJdpVHE0HEf4IviMF5A&oe=6AEB2DFC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1diWxYY9EmcQ7kNvwGa_3cV&_nc_oc=AdqJBmo1eXKwEcpQEnp-sviWKoxhyBP9ZMARER7mgSzeZN0sD62XnD8yv-gMbD_6_Ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDptSfl5chIdgv5NeT8u_arylhWicTvUxqB6kmnsZAzw&oe=6AEB3ACC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Iu5vODX_wQQ7kNvwEn1roX&_nc_oc=AdqDhTzyR4XGgpJBK7RE5nDChuCnC5WrH2W_rrNXcR5fR3ke_sgbPbGOQq0XlmKErF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST8A8A-TvGmAevdNGaU-3mZ9LAunvsYfsLTY3BzL-xBw&oe=6AEB2E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prO4z4rbyiwQ7kNvwFcfSnO&_nc_oc=Adr52k81x02aZIJY7XIuoJz5wA-e5zhXVXr8YoHCWwkuhHmImxi27QwVXpNkobdbRDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAOpq7Gi-UQrb8unteTwUEQwZgWz5xNfJy002QBauSmA&oe=6AEB3C8C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics
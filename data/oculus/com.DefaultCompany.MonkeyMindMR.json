7&_nc_sid=6e7a0a&_nc_ohc=a5CCE564Zg4Q7kNvwEQfkhS&_nc_oc=Adrmv3rKxqOVNKVW2V0d-9opqIdRDxIawsf-dgYfeUo6x5nTyHAaW9fdFTBJxWGi05Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAJbYXz2AkrYDSFY9nqzZmVr7em5PQJ11MzCqkCUGjnQ&oe=6A771E81"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AltZjRkboSkQ7kNvwGUIndR&_nc_oc=Adrn2ZRAAfaxdMov0VLvX-5ymnPdRDrpF5N8bawGyYItgdCGPC8GJMow8uly77EbCUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlvPvVX9gsAZxdQeGohg4_WxasOIuOelxwF4iN1_pOZA&oe=6A7729AF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLfJ-qYLyAwQ7kNvwELcdES&_nc_oc=Ado39oHCAQVmPtKRrwzkmivbbyXr3PrRkDGXmO8xK2rM-bzM6ebu-VhS5wmiAtCCeNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqbqj5xxyPSg50qxxhJ4yAG9gH5V_5GfatcboenvFV1A&oe=6A7729FC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9Gw5Am3KhgQ7kNvwHZf76k&_nc_oc=Adp-NWVD7l692hcNYKzOWt3nxiyg5cdDsvyMai1oBzdjUEPX_sK5v0Ux5n1z-koEBm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCv-sGzZVNw85RfSoQtQmCKxkoK_d7ik6WzFOWoHN3qA&oe=6A7736CC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSwW2cFvvtkQ7kNvwFmo8gG&_nc_oc=AdrXsddYK2gHhblK4xJsyUY-lkxnQSqGM2Xzhq084J2LJ6HajwW1T7hlO5s4zcGnbao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWA_efZ5fPWK356yyPGZc9H1tW8zcQyq5XjRY_1XrJlg&oe=6A772A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p0wDvIyWBMQ7kNvwGDO_-m&_nc_oc=Adr2XQZc1c5WfL3Cic23uc1lAjhkRZ4McOzD1Q1LF6Im32P5X7OPrrcakRjazpVI-lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWfTKSWBuWgqjsIZ0pQkqPFxUOGmwIpFUc5JNqJEkqmA&oe=6A77388C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9615893088469165", "version": "1.0"}, "id": "1595788071170255", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7395323760526120", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9615893088469165"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1595788071170255"}]}, "change_log": null, "created_date": 1740909273, "id": "9615893088469165", "version": "1.0", "version_code": 
9dsKjEn0j7iSbUrWT8FqF9tl5mV5xMsA7L0wQ&oe=6B0320EF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBU3ShUxBz0Q7kNvwHR-7-F&_nc_oc=Ado_c7Q3ZIFsOvqv7oLsIPJYO4nuGVpagt7KvpNua94VPNb4CprfoN_oTBh9-pVKc6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2j5PHs0WHAtsZtmiY5e4SunooZoMMqIDqWJjAP898sA&oe=6B03213C"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ys4btgoDvmcQ7kNvwGzh4xt&_nc_oc=AdrDOTU4YH45jYhTQLMS5swG7rHelSTuTdXd1jJSLqesHXEiyezJd_S0_kITAk3G6rw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYdIfXEwzZrO0-adNg4BBVfcWTM5prXTYP8OXSmTuzag&oe=6B032E0C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oz8if1p-KNkQ7kNvwHsXW2S&_nc_oc=Adq_3ALiVn-DOoUoQMfgydwO5oJTOYt5Et1vqCPeWAhrp60BIlmwjCvWedbQZCeAQWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWwRjgLP0wG_ffAyCIUjOgb-ujGGcmE4LHQAykBAhONQ&oe=6B03215D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isrDblET_X8Q7kNvwFkWMZM&_nc_oc=AdpdBnIJdhfxHQxN5kJfyUR2E1d7ixxL6Funz4AjmSnfBYuaQMs7n9uVOSGfxB3Yn4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHehbwez8loTa3W5JZiTX2siF32TYCqrdCSIXaGaUMUw&oe=6B032FCC"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/monkeymind-privacy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
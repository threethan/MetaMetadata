-2.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJpC1VU35wgQ7kNvwFXiI4v&_nc_oc=Adq3tlPljiWypZU4k6T2wY8OTw5hu8AU5gb_cpAyEbrhHfzLOXk-D7AkZXvQVSroqFA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgiKOStXqRze1aCUoYB3MbIwIMSWz9ZNjnCfUkH347qQ&oe=6AECB7BC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1diWxYY9EmcQ7kNvwFGnkox&_nc_oc=AdoM6057Xt1Lml0KG4AIZknGrsY4so4EkAEfL1chUN8OiLUAVx-vHNiZOXYJMNb6XGM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFAOIM8a6Oj-wm_wXD5Olp01WlcKhpCNG8sRwDITB37A&oe=6AEC8C4C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuGMIdwrui8Q7kNvwEMjVVp&_nc_oc=AdrciDalmQ6uTQwGVvSZlgt0UXQZFSYXroF0L39SfN24Nzn6_We2Th2g52wN_ilr_uQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToldSBOwdIh6NRTS0F4bBDzh_CmdjoadHbQ3ks8qDFUw&oe=6AECB7DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prO4z4rbyiwQ7kNvwEvY9tI&_nc_oc=AdrHNuL_89N8roMwiW3oD6BlSpZoci6I_WzfJkzcOp3ZbEnXzDuZM-uVzG4WMNy90WM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfaxd8ZmDntk4GChO-Pboop2dxqisqKST6v1Ema20WvA&oe=6AEC8E0C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics
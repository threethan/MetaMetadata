UtJN7hzUAgyFsQs0U46qIQ3cTW9EjRJMso7Fg&oe=6AFDDAEF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lIceLJJu_0Q7kNvwH82MHs&_nc_oc=AdqAXumklap15fPmR4hHV3daP6z82v94eU2gk6dMn8xLykCAfIktzhoNDcnMV-MIs70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQRczACYLlIzQ73KzevfsgiEy6a4auOKDF4y2MrUhOOQ&oe=6AFDDB3C"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoDKHe9eq3MQ7kNvwGK9AUu&_nc_oc=AdrV6WAz89zmFMp7j-U1jZ6p8VeZg_4GvySY51T-VpufRFihHAH65mlTaLlqOPm4k48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRG67KaFpRAubvuP9l70bt9wmsYl2-HGmKyVTADAr3gQ&oe=6AFDAFCC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1LfRfU-ouIQ7kNvwGyoR-M&_nc_oc=AdrzzlIpnuvMTFiLBWexSeNjlOgrS6gNle8H-163yIh9P4kcw2-TL4MSq6zkAtEV5bM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP6Av1XWRq2CkHeWPdMK0cgSVIQye5DQQSStmQ52ft1g&oe=6AFDDB5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AMSFuWoeXEQ7kNvwHfvaGE&_nc_oc=Adq8G91OVzt7pGV7xJPLvw3z8LMjCojShHmMVf6aKDneYXgqgBjj5Oj8ibgSP_-TusQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Zif6zNdqZm7ZQhSyzvtzID1tQbxpBpQ-AXPPWPCiLg&oe=6AFDB18C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/monkeymind-privacy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
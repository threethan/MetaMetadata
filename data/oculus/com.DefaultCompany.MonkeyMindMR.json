7&_nc_sid=6e7a0a&_nc_ohc=blKO2nHBpq4Q7kNvwGFaZ6H&_nc_oc=AdoQ6L3InNftR1_zxRYs_tBsc05haTyEVbbpkY3LstmUTtf8mW7AEkzs4wBRXhKnp2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70hb-USUHMEUI73FKJrhNVAKd4giiy9USghOSsyuo7Ag&oe=6A05BD81"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7OUZm1YH7MQ7kNvwFGxKJr&_nc_oc=AdrNWRrSv0NTbRqcqN6vUgas7MbJaVFvFnx-mJNGzx_nRcn4bC1Y5JeMsuE97B4u5fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L1Nrc-q51GeEBl2it_mE9UXA7KxFjF-I0viaILLgzYQ&oe=6A05C8AF"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtAJ7T0ZF28Q7kNvwE0dsB3&_nc_oc=AdrDdHcJrkwwFdyPbk6uuUcS0bWWOtp6zHc-JDxcpaqGR3uitVOj0L3TFHcAEIP4lV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MYlIoS1ST-fIFpNliMUPlWKnFnyLskQPrqDdtFY_58A&oe=6A05C8FC"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAoeE0BXvDcQ7kNvwEks9UH&_nc_oc=Adr2MEpM9TjhX5fkv5t4MGZLhN3IMJvS8bFEAEj-hA602-byBtjiYh5-nhgp5iMVSak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RjXW7CDbDKmUNNp0cPnmGAE2K64-Kj5aMZxkongoEmQ&oe=6A05D5CC"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOk1VTvGwTUQ7kNvwGomFBm&_nc_oc=Adp9jxSGrxHU73VqHu3EWxEub6VBwvqJonU84MacHKh0Hi4aERY3iH4qb8EnM5tcfLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MxzEG_7wgMJSWg3EQ5NF7w36lKIreY1yXwPrac4lQ6g&oe=6A05C91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otTJ6nJ1OYAQ7kNvwH7NVpH&_nc_oc=AdqG2g8Fs4ya0XskPvhitcUKEF2_n9U1Ipig9tM5XNzuw5wrMLCBwHYwHdbZna31B2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7smhqrjVi3f5e6WKMFOnHuIZDtg-IM27zUB3lobKOBDw&oe=6A05D78C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1329198572093131"}, {"status": "PUBLISHED", "id": "984997160063227"}, {"status": "PUBLISHED", "id": "321848160845408"}]}, "baseline_offer": {"id": "321848160845408"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1329198572093131"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9615893088469165", "version": "1.0"}, "id": "1595788071170255", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7395323760526120", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "961589
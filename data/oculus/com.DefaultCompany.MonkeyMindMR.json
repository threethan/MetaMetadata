7&_nc_sid=6e7a0a&_nc_ohc=x0vD0qZJapEQ7kNvwF9uig1&_nc_oc=AdpZJpPqYTNWZVdKLo5Gof4jFd4766f-NxUH79qBE1vXm5pzjHssi3iEW7M9uhY1YsY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86PxjDcfCjhWtoBuTNyziSKe1FUXagqnayLAfDTviTbQ&oe=6A2C3141"}, {"file_name": "pixelcut-export (2).png", "id": "2501213966881851", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391934_2501213970215184_6968908616065261333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUNLGNJYeHgQ7kNvwFS9tHh&_nc_oc=Adp3pHf6Za5RHqY3XJqbOeI7DQDP2Wd_VOa_vbCmJWYLoa9sHIVLbLv4Us2US8u8n2U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W_Vhyso8BkScRFj19-JgVrJCD-g6DVvfqwjijTB7RFw&oe=6A2C042F"}, {"file_name": "pixelcut-export (5).png", "id": "474873108837178", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391904_474873112170511_7834016319139162429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UXpHSSFvt0Q7kNvwENPJPR&_nc_oc=Adr1eF-8lK4uAvLd9EgidUZcM0Yy4aCc6lutFj3_BwX65iYsABBdLTMgE8bbItAEH9M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eUYMXJNqDcGoG5y2azQDq0_HTG7ZSkGCvMu9pWP901A&oe=6A2C047C"}, {"file_name": "pixelcut-export.png", "id": "631001669344281", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391934_631001676010947_4085274097803152253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUChTYNWBXIQ7kNvwHPZSIN&_nc_oc=Adr8-M5txDNpw_9IyNpaXJBIKm6IScjcxFaWOWtJnIrRgkUv4yISA2CX2pjh2tW7RQo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B6wTxjbOZTxK1qZXrgb75HEiFOjy5dfU7eBTlKiLJLg&oe=6A2C114C"}, {"file_name": "pixelcut-export (3).png", "id": "1640613344002115", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392010_1640613347335448_1076697343793274548_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiAecffHOMQQ7kNvwF9Kfkm&_nc_oc=Ado5eOKBZ5_Mf3fi6xiJSGuooFNXbB5Kbu5ozHX-cowoDY44cUqvXKtQ2cxGHbKRMt0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96O5qOUognJodbb2sgXQnE8j4d4WMU9iE-HkIu6p2ytw&oe=6A2C049D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MonkeyMind_2560x1440.png", "id": "512098841902207", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391899_512098845235540_3872534316633838061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNMwicLmTsIQ7kNvwGM9juR&_nc_oc=Adov_n_TtvygWagVr8_a0KOnkNwUEL-fEQJdIivAqyWbGECek1fQ5zZTsOch2qfwq4I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FpC49ikNYi4lrf7LYG4jjVOxJHCr2AqgN93Y8H3SDHw&oe=6A2C130C"}, "display_name": "MonkeyMind", "keywords": ["Memory", "Game", "Monkey", "Mixedreality", "MR"], "long_description": "Welcome to MonkeyMind MR!\n\nA unique mixed reality experience: your living room becomes a stage. It challenges you in a world that blurs the boundaries between reality and gaming.\n\nTriesGame - The challenge of memory: Eight numbered balls are passed to you. After a moment they turn into question marks. How many tries do you need to reveal the numbers in the correct order? Perfect your strategy and minimize your attempts to achieve top scores.\n\nTimeGame - Race against time: Starting with 5, you have a limited time to correctly understand the sequence. From time to time a new ball is added and the available time shrinks. How far can you go before time runs out?\n\nColorMode - Colors and Sounds: Four colored balls appear and light up in a specific sequence, accompanied by unique sounds. Your task is to replicate this sequence by tapping the balls in the correct order. With each correct repetition, the sequence is expanded by one ball. Test how far your memory and sense of rhythm can take you.\n\nA game for all senses!", "short_description": "Immerse yourself in \"MonkeyMind MR\", a mixed reality game that transforms your four walls into a fascinating game world! Your memory skills will be put to the test with a series of colorful floating balls. Master three unique modes: \"TriesGame\" challenges you to memorize number sequences with minimal attempts; \"TimeGame\" pits your memory against the clock; and \"ColorMode\" illuminates your world with a growing sequence of glowing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "EAH GAMES", "support_website_url": null, "website_url": "https://eah-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7395323770526119"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1329198572093131"}, {"status": "PUBLISHED", "id": "984997160063227"}, {"status": "PUBLISHED", "id": "321848160845408"}]}, "baseline_offer": {"id": "321848160845408"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1329198572093131"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9615893088469165", "version": "1.0"}, "id": "1595788071170255", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7395323760526120", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "961589
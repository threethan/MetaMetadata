ary energy project undertaken by GE and Huaneng Renewables."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ge.com/privacy", "developer_terms_of_service_url": "http://www.ge.com/terms", "publisher_name": "GE", "support_website_url": null, "website_url": "http://ge.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "336338791550390"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533755_143025222872064_2757650865555767296_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wae9Qz6W04Q7kNvwE_jQP-&_nc_oc=AdqsHYL2Npp43tqzsIkfkH1E9BuOKs-7VLNftnJk67orFLa500E3-d3gGMY1L_5Gs-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrkkkWpZD_bIcBFrVACiRsnSTJjJoIGDYeTaYx6ZmsSA&oe=6AFDE0C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GE: Dali Windfarm Experience", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1488960000, "lastRevision": {"nodes": [{"id": "1391642650894521", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1471354659542963", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "633317673536391"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name
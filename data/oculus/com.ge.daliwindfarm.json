ration of wind power production.", "short_description": "GE: Dali Windfarm Experience is a VR documentary that transports viewers to a revolutionary energy project undertaken by GE and Huaneng Renewables."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ge.com/privacy", "developer_terms_of_service_url": "http://www.ge.com/terms", "publisher_name": "GE", "support_website_url": null, "website_url": "http://ge.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "336338791550390"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "324100184659886"}]}, "baseline_offer": {"id": "324100184659886"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1488996000, "status": "PUBLISHED", "id": "324100184659886"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1482614385083657", "version": "1.0"}, "id": "1075412419271740", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1471354659542963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1482614385083657"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075412419271740"}]}, "change_log": "Initial Version", "created_date": 1486764226,
e.\nPuoi parlare con loro, vedere i loro ricordi, condividere le tue conoscenze attraverso l'intelligenza artificiale e imparare da tutti quelli che conosci.", "short_description": "TWINCREATOR VR \u00e8 il prototipo da cui puoi testare le tue intelligenze artificiali che prendono vita"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.twincreator.com/api/privacy_vr?lang=en", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": "https://form.asana.com/?k=XC7S3JWQeIhnjipBuA3gbw&d=1199599736247413", "website_url": "https://twincreator.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1625448401213835"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "6293536404042295"}]}, "baseline_offer": {"id": "6293536404042295"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1680210540, "status": "PUBLISHED", "id": "6293536404042295"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25549163984673649", "version": "1"}, "id": "178144481201323", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "517
om&oh=00_Afu1wwblzyfaXkkIjQxFVYwyVnMv4jAeG95P-OaJFFdfhQ&oe=69A053DA"}, {"file_name": "image_001_0000.png", "id": "1214537275839972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001660_1214537279173305_6607413165084196827_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSsL4jlSbmIQ7kNvwFywSju&_nc_oc=Adluptf0uHh-wrZjNVx5sLhXmZRT6KUX-jmXu-MR6qJjQA5J3_AklOqG6HP9CkstKmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfteQhKgZrCrY9vA69j0sATIH0Je1wcSzHEnaZ2cMUE38w&oe=69A05296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1152676829257050", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75416841_1152676832590383_3837176811353795079_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fv2OG5gV2MQ7kNvwEXX68J&_nc_oc=AdlKw3R9RwPFU6JTkwA2ygEXws22aPsDesDfZDTUd4b45UoyO2lHxGoCHhvviGYD6CU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsEfHbegH1wwlaaT2AoIF6cW1cWRtFrDjE03BGrsyyjLw&oe=69A02571"}, "display_name": "AISURU", "keywords": [], "long_description": "AISURU VR is a virtual world where you can find human-made personal assistants to expose historical characters, real people, anything that can take on an identity.\nOn Aisuru.com you can create your digital twin project business or consumer and then you can meet it in this virtual world.\nYou can talk to them, see their memories, share your knowledge throught artificial intelligence and learn from everyone you know.", "short_description": "AISURU VR is the app from which you can test your artificial intelligences coming from aisuru.com"}, {"images": {"nodes": []}, "id": "704152759376701", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AISURU", "keywords": [], "long_description": "AISURU VR \u00e8 un mondo virtuale in cui puoi trovare assistenti personali creati dall'uomo per esporre personaggi storici, persone reali, tutto ci\u00f2 che pu\u00f2 assumere un'identit\u00e0.\nIn Aisuru.com puoi creare il tuo digital twin business o consumer, e poi incontrarlo in questo mondo virtuale.\nPuoi parlare con loro, vedere i loro ricordi, condividere le tue conoscenze attraverso l'intelligenza artificiale e imparare da tutti quelli che conosci.", "short_description": "AISURU \u00e8 l'applicazione da cui puoi testare le tue intelligenze artificiali create su aisuru.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aisuru.com/api/privacy_vr?lang=en", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": "https://www.aisuru.com/en/feedback", "website_url": "https://aisuru.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "25549376044652443"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_559465540125536_5180141204756201058_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIg9P0YrqbsQ7kNvwF_mqeb&_nc_oc=Adl6sZI-pa8PncGaN8BGMOqKmaq0TYlgZfr63qDpByMGaC7er-k6EZwNcFe9ZdyhpKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9YNPA-yepSZYExmsAWZnNNYVaVqPuUKEfnZ5RfV8-iA&oe=69A03C84"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AISURU", "platform": "ANDROID_6DOF", "context_category": {"co
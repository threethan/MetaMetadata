suru.com puoi creare il tuo digital twin business o consumer, e poi incontrarlo in questo mondo virtuale.\nPuoi parlare con loro, vedere i loro ricordi, condividere le tue conoscenze attraverso l'intelligenza artificiale e imparare da tutti quelli che conosci.", "short_description": "AISURU \u00e8 l'applicazione da cui puoi testare le tue intelligenze artificiali create su aisuru.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aisuru.com/api/privacy_vr?lang=en", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": "https://www.aisuru.com/en/feedback", "website_url": "https://aisuru.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "25549376044652443"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_559465540125536_5180141204756201058_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIoY9U0kRiwQ7kNvwGDi85d&_nc_oc=AdkZr4hS7iBehRDabBOVOfsXikX9Y-WafvzvQZ_qv9cWgshIvRb_7m0QEQTqO647VVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsxk4prW4wACMKEeOcWB4G4GrgD2b8FHXGODV0iWNlkBw&oe=69A6D404"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AISURU", "platform": "ANDROID_6DOF", "context_category": {"co
culuscdn.com/v/t64.5771-25/39001660_1214537279173305_6607413165084196827_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkynaP4BxwYQ7kNvwE0Bx9k&_nc_oc=Ado66uGippnTeVLUu84Mz628xczxeVkgAItquNvhvHOHD2h0AWW7ZbQYjWpi-g75Jn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qkso4rUjf07YbrHbxnf-FLU0xHwiGG-A8zA1AMvDLPg&oe=6A3BE396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "936208400855958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036655_936208404189291_4122538732802712494_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DX5GsvbUicQ7kNvwGJLRh7&_nc_oc=Adqu7Uawqc2OSmNahyPgxdpfMjKLw8rPaWPO7_sIK3Fcs9Y-SGsLvluuPX37_AWbWSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-THTzaIEOXjf9cQkjM2TLsVexGNI8e35g6b-ViX0Vqog&oe=6A3BCD8C"}, "display_name": "TWINCREATOR VR", "keywords": [], "long_description": "TWINCREATOR VR is a virtual world where you can find human-made personal assistants to expose historical characters, real people, anything that can take on an identity.\nIn TwinCreator and MemoryTwin you can create your twin project business (app.twincreator.com)  or consumer (app.memorytwin.com), and then you can meet it in this virtual world.\nYou can talk to them, see their memories, share your knowledge throught artificial intelligence and learn from everyone you know.", "short_description": "TWINCREATOR VR is the prototype from which you can test your artificial intelligences coming to life"}, {"images": {"nodes": []}, "id": "179112094901097", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TWINCREATOR VR", "keywords": [], "long_description": "TWINCREATOR VR \u00e8 un mondo virtuale in cui puoi trovare assistenti personali creati dall'uomo per esporre personaggi storici, persone reali, tutto ci\u00f2 che pu\u00f2 assumere un'identit\u00e0.\nIn TwinCreator e MemoryTwin puoi creare il tuo progetto gemello business (app.twincreator.com) o consumer (app.memorytwin.com), e poi incontrarlo in questo mondo virtuale.\nPuoi parlare con loro, vedere i loro ricordi, condividere le tue conoscenze attraverso l'intelligenza artificiale e imparare da tutti quelli che conosci.", "short_description": "TWINCREATOR VR \u00e8 il prototipo da cui puoi testare le tue intelligenze artificiali che prendono vita"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.twincreator.com/api/privacy_vr?lang=en", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": "https://form.asana.com/?k=XC7S3JWQeIhnjipBuA3gbw&d=1199599736247413", "website_url": "https://twincreator.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1625448401213835"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "6293536404042295"}]}, "baseline_offer": {"id": "6293536404042295"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1680210540, "status": "PUBLISHED", "id": "6293536404042295"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27940083608914996", "version": "1"}, "id": "178144481201323", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidB
\uae30\uae30\ub97c \ud1b5\ud574 \uc5b4\ub5bb\uac8c \ub290\uaef4\uc9c0\ub294\uc9c0 \uc9c1\uc811 \uacbd\ud5d8\ud574\ubcf4\uc138\uc694. \ucd1d\uacfc SF \ubb34\uae30\ubd80\ud130 \ud65c, \uadfc\uc811 \ubb34\uae30, \uc77c\uc0c1 \uc18d \uc18c\ud488\uae4c\uc9c0, \ubaa8\ub4e0 \uc544\uc774\ud15c\uc774 \uc800\ub9c8\ub2e4\uc758 \uace0\uc720\ud55c \uac10\uac01\uc744 \uc804\ud569\ub2c8\ub2e4.\n\n\ubc29\uc544\uc1e0\ub97c \ub2f9\uae30\uba74 \uac00\uc2b4 \uc804\uccb4\ub85c \ud37c\uc9c0\ub294 \ubc18\ub3d9\uc744, \ud65c\uc2dc\uc704\ub97c \ub2f9\uae30\uba74 \uc190\uac00\ub77d\uc5d0 \ucc28\uc624\ub974\ub294 \uae34\uc7a5\uac10\uc744, \uc74c\ub8cc\uc218\ub97c \ub9c8\uc2dc\uba74 \ubaa9\uc744 \ud0c0\uace0 \ud750\ub974\ub294 \uac10\uac01\uc744 \ub290\ub084 \uc218 \uc788\uc5b4\uc694. \n\n\uc644\uc218\ud574\uc57c \ud560 \ubbf8\uc158\ub3c4, \uacbd\uc7c1\ud560 \ub7ad\ud0b9\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4. \uadf8\uc800 \ub208\uc5d0 \ub744\ub294 \uac83\uc744 \uc9d1\uc5b4 \ub4e4\uace0, \ub9c8\uc74c \uac00\ub294 \ub300\ub85c \ub2e4\ub904 \ubcf4\uba70, \ud585\ud2f1 \uadf8 \uc790\uccb4\ub97c \uac00\uc7a5 \uc21c\uc218\ud558\uac8c \uacbd\ud5d8\ud574\ubcf4\uc138\uc694.\n\nTactSuit, TactSleeve, TactVisor \ub4f1 bHaptics\uc758 \ub2e4\uc591\ud55c \uae30\uae30\uc640 \ud568\uaed8\ud560 \ub54c \uac00\uc7a5 \ud48d\ubd80\ud558\uac8c \uc990\uae38 \uc218 \uc788\uc5b4\uc694. \uc190\uc744 \ubed7\uc5b4 \uc138\uc0c1\uc5d0 \ub2ff\ub294 \uc21c\uac04, \ubaa8\ub4e0 \ud53c\ub4dc\ubc31 \ucc44\ub110\uc774 \uc0b4\uc544 \uc6c0\uc9c1\uc785\ub2c8\ub2e4.\n\n\ubb34\uc5c7\uc774\ub4e0 \uc9d1\uc5b4 \ub4dc\uc138\uc694! \uc6d0\ud558\ub294 \ub300\ub85c \ub2e4\ub904 \ubcf4\uc138\uc694! \uadf8 \ucc28\uc774\ub97c \uc9c1\uc811 \ub290\uaef4\ubcf4\uc138\uc694!", "short_description": "\uc190\uc5d0 \uc7a1\ud788\ub294 \ubaa8\ub4e0 \ubb3c\uac74\uc774 \uc0b4\uc544 \uc6c0\uc9c1\uc774\ub294 \uc790\uc720\ub85c\uc6b4 \ud585\ud2f1 \uccb4\ud5d8.\n\ucd1d, SF \ubb34\uae30, \ud65c\ubd80\ud130 \uc77c\uc0c1 \uc18c\ud488\uae4c\uc9c0, \uc815\ud574\uc9c4 \uaddc\uce59\ub3c4 \ubaa9\ud45c\ub3c4 \uc5c6\uc774, bHaptics \uae30\uae30\ub97c \ud1b5\ud574 \ubb3c\uac74\ub9c8\ub2e4\uc758 \uac10\uac01\uc774 \uc5b4\ub5bb\uac8c \ub2e4\ub978\uc9c0 \uc9c1\uc811 \ub290\uaef4\ubcf4\uc138\uc694."}, {"images": {"nodes": [{"file_name": "1_\ucee4\ubc84\uc544\ud2b8.png", "id": "2160185658136952", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295588_2160185661470285_426331824165788443_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSTUkkKVsH8Q7kNvwHYYkXR&_nc_oc=AdqKZgc49391rFt_v-ADJF-n6NLzviq0UFu1aSRWFFnNDvIp8FJj2VlHuC9k1CUT_y8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqwNSphFcm8N-ar2GQeS6FvzqIl2h77lkoOYGiRVL7Yw&oe=6A4BB2F5"}, {"file_name": "5_Vertical.png", "id": "1930511554249729", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_1930511557583062_2103292066508109849_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8DUxYIO7dkQ7kNvwFpvQyZ&_nc_oc=AdrNU_x-gJsY_sZoieCLORgb1bywRUQT6LjSYBPdB0M4qAlGC9WB4uyo9x0A3JAji7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoMe_hs8ZMYUsuzg75pIE9P5YL_5127QQQVmgJXW7Nlg&oe=6A4BC8EE"}, {"file_name": "3_\uc544\uc774\ucf58.png", "id": "1265902559059963", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298137_1265902562393296_5919799718495512017_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJoxvIyG8b4Q7kNvwE8-n_P&_nc_oc=Adr4Hal1iuDyVDoGc6Ijl9QKhZlQjSJs-wPfeYaFyGfU9uO9V4E4RXKJubcaKyqrfMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADlpHQXt6Xbd6Z7JYCmFm7KOrOl-Eg1XfdEY0oV2ubvA&oe=6A4BB803"}, {"file_name": "4_Square.png", "id": "855158640201174", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_855158643534507_2988803113305843851_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rs5bm7I8XJwQ7kNvwE53CWO&_nc_oc=AdqSAw7NTP7oRK9Xt_C7z
uce59\ub3c4 \ubaa9\ud45c\ub3c4 \uc5c6\uc774, bHaptics \uae30\uae30\ub97c \ud1b5\ud574 \ubb3c\uac74\ub9c8\ub2e4\uc758 \uac10\uac01\uc774 \uc5b4\ub5bb\uac8c \ub2e4\ub978\uc9c0 \uc9c1\uc811 \ub290\uaef4\ubcf4\uc138\uc694."}, {"images": {"nodes": [{"file_name": "1_\ucee4\ubc84\uc544\ud2b8.png", "id": "2160185658136952", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295588_2160185661470285_426331824165788443_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBdJTjg2HdYQ7kNvwGzDt_e&_nc_oc=AdqEJ2od5az5rALf4VsgJgeli247v3-jPVEnFUI0fZCwULk33P2IXH126l2w1rgBQEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO8uf87PWvPkfi3VIbIqQuKaYAlzRCW_Fav4oVTAYkpQ&oe=6AE5F275"}, {"file_name": "5_Vertical.png", "id": "1930511554249729", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_1930511557583062_2103292066508109849_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23qgN4RI0sUQ7kNvwHb_R30&_nc_oc=AdqPKfEDmDZYlsnS5dHIl7pbz_kEEsM0mVOoCukwcqkMXx-ml4a5JBvIDu74I9_RnZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMahm-z6wnJxUABfnQqKD7t6mt1QLQN9F2FYcDBSsvOrA&oe=6AE6086E"}, {"file_name": "3_\uc544\uc774\ucf58.png", "id": "1265902559059963", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298137_1265902562393296_5919799718495512017_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oblbTlsmigsQ7kNvwFwSnPe&_nc_oc=AdpkILNtH1tcgY5ou9AuadPMq67G4z4jYxQSFSMD3hDvOXJuVP8PV-dOhnVGpkQE-hY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPm334tvPXnOrjUkWKPmeuOwjVmuuQ6z5wyHBhG0qH6g&oe=6AE5F783"}, {"file_name": "4_Square.png", "id": "855158640201174", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_855158643534507_2988803113305843851_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2LK8uQ69r4Q7kNvwE_KaRe&_nc_oc=AdoMQBUFf-DWuoRiYO0Rv
xxBR6VKa4ag&oe=6A4BB685"}, {"file_name": "4.png", "id": "2085837638815341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820058_2085837642148674_3883373595418986001_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xn8b4cva_cQQ7kNvwG-jAxd&_nc_oc=AdrxkCY_BUEzWPBGrZtjNJ1APTnnRk9ssYJwCvwIhIZHvNVPRhHdW0kG_l1RLEtrP-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwarC_rQ_4b4r3vnsIrkyWkqIeu1lm7OLe3iohzLlZzA&oe=6A4BD060"}, {"file_name": "5.png", "id": "930501073366996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307326_930501076700329_8914553696571908959_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JHxonZ2zocQ7kNvwGDINj3&_nc_oc=AdrX4ZQ-PXL9vEqN61A5U3UJ_LrlBAd3golnt8nWBmx72MPWColQnTpDdH0jlnD_t9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKNcb2yzVP1aJM3ikFF2_RoF6bPCa0Qc4TBl3FloWzLQ&oe=6A4BA06E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bHaptics Exhibition", "keywords": [], "long_description": "A free-form haptic experience \u2014 no rules, no goals, no time limits.\n\nStep into a space filled with all kinds of objects and discover how each one feels through bHaptics gear. From guns and sci-fi weapons to bows, melee tools, and everyday props, every object carries its own distinct sensation.\n\nPull a trigger and feel the recoil ripple across your chest. Draw a bowstring and feel the tension build in your fingers. Take a sip of a drink and feel it travel down your throat. Each interaction is built to showcase the full range of haptic feedback \u2014 from sharp impacts to delicate textures.\n\nThere's nothing to complete and no leaderboards to climb. Just grab whatever catches your eye, play with it however you like, and experience haptics in its purest form.\n\nBest enjoyed with bHaptics devices, including the TactSuit, TactSleeve, and TactVisor. Every feedback channel comes alive when you reach out and touch the world.\n\nGrab anything! Play however you want! Feel the difference!", "short_description": "A free-form haptic experience where every object comes alive in your hands. Pick up guns, sci-fi weapons, bows, and everyday props.\nWith no rules and no goals, feel how each one responds across your body through bHaptics gear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Exhibition-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc.", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26391123867256803"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4154828034829946"}]}, "baseline_offer": {"id": "4154828034829946"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778140860, "status": "PUBLISHED", "id": "4154828034829946"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26792055523830300", "version": "0.4.3"}, "id": "2958577207678964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26327891156913408", "is_concept": false, "latest_re
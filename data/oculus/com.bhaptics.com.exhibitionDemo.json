0Sb90Q7kNvwGKsnWS&_nc_oc=Adqh1h9I4yxv6ZJe8r6e0FGGoizbdDXtrZBNfIB2nXzfodEaGcfNroy52D4UrODaBdM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHFxJT_emeIsbVrrhuc8TkKl65dwVpzZhy1o9-x14qEg&oe=6A94140A"}, {"file_name": "2.png", "id": "1662271068252354", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307602_1662271071585687_11613342825444183_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQL9hKdPg54Q7kNvwFsAV6T&_nc_oc=Ado9AQGGG0a68mM9RZ1QcyLL8q_qOJfV2vBd1LwYV8r6oxm3beZJxvzIWXdAL7Tq2bc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElI-tbioYPlZT5mMpTWWIs_UxiFm8rq6tpWuXyDamMPQ&oe=6A9432E7"}, {"file_name": "3.png", "id": "1281650510203846", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499313074_1281650513537179_4956623956204477076_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM8gI691zaMQ7kNvwHclHGK&_nc_oc=AdrK7QyKpy6PL_Y9CjkRMcuxD3NoiX_OEcZ_jOUAragK5IMjmxriwmdAowKRIrH3C7c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG3Mf2exqE5eQLk_uGiYilE8mHlfhelhpd44hAaKloHQ&oe=6A9400C5"}, {"file_name": "4.png", "id": "2085837638815341", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820058_2085837642148674_3883373595418986001_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7j-Fr2_G3kQ7kNvwENzZl8&_nc_oc=AdojnzoOHtrEzzj6aMsk-QU0YEX1f_pu6gkqC17BlrG7GDSjkUMkdI-DW64z57jXY9I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqFrTeLHDN6huXA3yrvCWdsmx6YiVTAyq_1Pa2mUYsvQ&oe=6A941AA0"}, {"file_name": "5.png", "id": "930501073366996", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499307326_930501076700329_8914553696571908959_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkHY9wjrfaYQ7kNvwG6tiqn&_nc_oc=AdoF1VuUDfFmik6bkhAFhginIWOgB30bXV3ZcRyUp8TOhcd4l_qdZmetVs6Oma9rgC8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_s-YYVtofOpU0LFeiA_3x8w6CHCqC7w8kuME-EZRLvg&oe=6A9422EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bHaptics Exhibition", "keywords": [], "long_description": "A free-form haptic experience \u2014 no rules, no goals, no time limits.\n\nStep into a space filled with all kinds of objects and discover how each one feels through bHaptics gear. From guns and sci-fi weapons to bows, melee tools, and everyday props, every object carries its own distinct sensation.\n\nPull a trigger and feel the recoil ripple across your chest. Draw a bowstring and feel the tension build in your fingers. Take a sip of a drink and feel it travel down your throat. Each interaction is built to showcase the full range of haptic feedback \u2014 from sharp impacts to delicate textures.\n\nThere's nothing to complete and no leaderboards to climb. Just grab whatever catches your eye, play with it however you like, and experience haptics in its purest form.\n\nBest enjoyed with bHaptics devices, including the TactSuit, TactSleeve, and TactVisor. Every feedback channel comes alive when you reach out and touch the world.\n\nGrab anything! Play however you want! Feel the difference!", "short_description": "A free-form haptic experience where every object comes alive in your hands. Pick up guns, sci-fi weapons, bows, and everyday props.\nWith no rules and no goals, feel how each one responds across your body through bHaptics gear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Exhibition-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc.", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
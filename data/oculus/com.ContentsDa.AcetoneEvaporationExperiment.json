8&oh=00_AfxdyI018S6s3gEHTsB6fd1b0kL-hm1G_3MwiNmM6vFCuw&oe=69B56C83"}, {"file_name": "ApplicationFrameHost_yNla6ZWHYk.png", "id": "1794214631388269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240108_1794214634721602_8062949809752834202_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PduNYHI-F90Q7kNvwHkdCTd&_nc_oc=AdmHrb96Z4gX4KfdtT7QC_Aht7IlyRen-zpw8YZWake1DOSzJwHvnwG4_4D99zmf9N0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIbCSGuxNG3a5-KLeTs3AslqdSD9VE9dIqhCKESHVvvQ&oe=69B54A9E"}, {"file_name": "ApplicationFrameHost_CuHsalxYm2.png", "id": "1282825292921477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86667274_1282825296254810_4665597166230452501_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaO7uAqPZnMQ7kNvwFyiKJq&_nc_oc=AdmiVTtpb3nPPQutGa_hGONpJHko-8bMavqUqD7X6cQk7kHRvSjUrI2HTeI2w4-smQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8Um8266Y2qhrb93wmyX7uQIv7NHWlH_f2ifio3ETBhw&oe=69B5526F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Acetone Evaporation.png", "id": "2022018584865506", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575360_2022018588198839_8145259344353759369_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjyPZdxHakYQ7kNvwGuxb8j&_nc_oc=AdlXkt2fFr_lBPAVtstzmg4dguuVAfcbxx3hlppeUdSEg8cR4Admx-YTEiVoWUxHfIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYpQAGQfmmuKLbN0D9aFbsRe5wmcgKyaQeb0QDuxozrA&oe=69B56441"}, "display_name": "Acetone Evaporation Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "school", "contentsda", "science"], "long_description": "1. Line a Petri dish with filter paper.\n2. Place the petri dish on the electronic balance and zero it.\n3. Add about 10 drops of acetone to the petri dish and measure the mass immediately.\n4. Observe how the mass changes over time.\n(Create a scene in which the mass decreases over time from the initial mass to 0 g.) \nWhy does the mass decrease? \nBecause the liquid acetone particles on the surface of the acetone become a gas and evaporate into the air.\n5. (Result) As the acetone dries, the scale on the electronic balance gets smaller and smaller until it reaches zero.", "short_description": "Experience the fascinating process of evaporation with the acetone evaporation experiment. It's a simple yet intriguing demonstration of how substances change from liquid to gas, providing a clear insight into the principles of physical changes and vapor pressure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25661389260185402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974714_919806603134811_5947713398043604070_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj64mas7DPYQ7kNvwH5Ij2F&_nc_oc=Admmgek9eMnWFPDZnAvMKBPll8m2e2xb4IZ9bOAlJE6kTNkgKnyIQcSJmAOME44WHvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDXrQnElzFLAMnlImk-6tWI9ZCgHneX_GBxolcqPdCgw&oe=69B558D3"}, "is_concept": false, "is_test":
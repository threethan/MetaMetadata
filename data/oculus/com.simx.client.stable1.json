_Ls5HmjhKjDSGD2B_ApKyLDHAOYbVGoP-q7wyj5th8BPNKe5WlnbY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-B8tXeWbIQw0aqKf6qAVxnGoXVWICsWNUVUvNkorucw&oe=69EF538B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "958110805630636", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001678_958110808963969_8342358237180025272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiQr7C9RtfUQ7kNvwHDX3t6&_nc_oc=AdoD-UiM7mrcivUMtN_p_3LqLO42dkNScC2pXj_wINnANHwTSbNnpSn2iyx2SH1vH_s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oD1CoD7XIP46PuviC2CChgsyvPxe6AcPQbc_yQ30D2A&oe=69EF6176"}, "display_name": "SimX VR (Nightingale)", "keywords": [], "long_description": "SimX is the first professional-grade wireless, multiplayer VR medical simulation. Physicians, nurses, and allied professionals can practice their skills on any virtual patient in any environment. Designed by physicians at Stanford and UCSF and already in use at top medical and nursing schools across the country, SimX is the most advanced VR medical training system.", "short_description": "SimX is the first professional-grade wireless, multiplayer VR medical training simulation. Physicians, nurses, and allied professionals can learn their skills on any virtual patient in any environment. Designed by physicians at Stanford and UCSF and already in use at top medical and nursing schools across the country, SimX is the most advanced VR medical training system."}]}, "developer_name": "SimX, Inc.", "developer_privacy_policy_url": "https://www.simxvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimX, Inc.", "support_website_url": null, "website_url": "https://www.simxvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTE
cE1JWT5K7cGEKV7aQTH5eSDQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-WE5p_ubxwzCjPHE4b_KkJcHYfY-ANp8JXYBNKILQzg&oe=6AE8A549"}, {"file_name": "Screenshots_5.png", "id": "978308971565764", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818890_978308974899097_7966556806613387640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8ZIsRk7gf4Q7kNvwEtdukl&_nc_oc=AdqN_n_9wDHbwewh9r2hg5AQ8dsNmd9thCZb4pRJV5TEsg-pLJfFlDHcRVGzWff50Os&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5iNIwioxOSpvnOUZY0RaGplUv9M8hM-t3T5KbhFz3cA&oe=6AE89F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_art_landscape.png", "id": "1302527278413700", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304162_1302527281747033_4044763163086282368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_j5wfDrtZgQ7kNvwHGCeEL&_nc_oc=AdqPf1ks14dk8d0w91VrTpZJd2rfnpu-_Q04qgfY1gFnqQ8Oe1esweA73a4OPphUN6k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf7ZzndJxdel8VjFWYQWfspfiAvuyojjrrAh2D0An6Qg&oe=6AE8C0BA"}, "display_name": "Raiders Breakout", "keywords": ["extract", "loot", "npc", "pve", "monkeylocomotion"], "long_description": "RAIDERS is a fast-paced VR extraction shooter where every run is a high-stakes mission. Dive into dangerous zones, battle aggressive robots \ud83e\udd16, loot rare weapons and gear \ud83d\udc8e, and escape alive \ud83d\udeaa.\n\n\ud83c\udfaf Core Gameplay Loop:\n\nFight \u2694\ufe0f \u2013 Engage intense VR combat against deadly machines\nLoot \ud83d\udcb0 \u2013 Collect weapons, resources, and rare items\nExtract \ud83d\udeaa \u2013 Make it out alive\u2026 or risk losing everything\n\n\ud83d\udca1 Play Smart:\nEvery decision matters - go deeper for bigger loot or extract early to stay safe. Strategy is as important as your aim!\n\n\ud83d\udcb8 Free to Play:\nJump in without barriers and start your raids immediately.\n\n\ud83d\udd25 Why You\u2019ll Love RAIDERS BREAKOUT:\n\nImmersive VR gunplay \ud83d\udd2b\nHigh-risk, high-reward extraction runs \ud83d\udd25\nConstant tension and replayability \u267b\ufe0f\nRobots that fight back intelligently \ud83e\udd16\n\n\ud83d\udca5 Enter. Raid. Extract. Repeat.\n\nJoin Discord - https://discord.gg/UFnWEqJBx", "short_description": "\ud83d\udd25 RAIDERS BREAKOUT - VR Extraction Shooter! \ud83e\udd16\nFight deadly robots \u2694\ufe0f, loot valuable gear \ud83d\udcb0, and extract before it\u2019s too late \ud83d\udeaa. Free to play!\n\nJoin Discord - https://discord.gg/UFnWEqJBx"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/raiders-breakout-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "Blackbeard Enterprises", "support_website_url": null, "website_url": "https://shrouded-ringer-a1d.notion.site/Raiders-Breakout-336292b9e84880e889bac922fb8205e0?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26433007723047100"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "952235914017674"}]}, "baseline_offer": {"id": "952235914017674"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776264360, "status": "PUBLISHED", "id": "952235914017674
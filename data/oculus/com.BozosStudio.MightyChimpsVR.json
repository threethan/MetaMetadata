dn.com/v/t64.5771-25/491822045_810195334681302_8105131155463706553_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2yWC-ARXeIQ7kNvwFytos_&_nc_oc=Adn6-ITdP3p30FxiqaXK0jJCjMiGLYrZxnEOYMSdCD5gQDzILoooKPcFefQ8qbwCuc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsgrM65Mm9CdoPg61c6Ea-XecUakgxFJIHe4phRJ9_nXA&oe=69A5874C"}, {"file_name": "Untitled.png", "id": "1698848110793319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831569_1698848114126652_7361159994325479874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzy_gu1gl14Q7kNvwELknE0&_nc_oc=AdmZ6QUORXFQR-sDlWdpK0iYfrSW-tGIX7UUYNfm9bp0_wA4OY3GAnQbPJ58lZAnQUI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftZFvwGfcHTbahbt22Wc32KOSWwxONrMKNlO_SyuMrs5Q&oe=69A577A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-08-18 214911_11zon.png", "id": "1467346087637834", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831569_1467346090971167_7719583609683232094_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AFPMO5jcp8Q7kNvwFOfcEy&_nc_oc=AdkuG3U6XzpM4Rvh8Rh4XqBYU-63DnWwryBrjUsQibyYD9ZFG_QdxoXwRGTsj7LlDKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuvjxjaRFu3N0PFZE9QD3sXhnI0lO0jKzphO82YMuANVQ&oe=69A57BE6"}, "display_name": "Mighty Chimps", "keywords": ["chimp", "gorilla", "pvp", "sandbox", "funny"], "long_description": "You are a chimp and you move using your hands. This game includes different maps such as chill forest, a jungle cave, moon map, upside-down islands and volcano. It has cool cosmetics that you can use to customize your character and even use to fly around the map. There are many gamemodes like Sandbox, Glass bridge, Prophunt, Tag, Horror, PVP, Zombie defense and so much more! There are many unique and fun features such as guided missile launcher, working helicopters, grappling hooks and different types of gadgets to use. Stop wasting time and get to causing chaos mighty chimp!", "short_description": "Be chimp. Jump like monkey. Cause chaos and have fun."}]}, "developer_name": "Bozo's Studio", "developer_privacy_policy_url": "https://docs.google.com/document/d/188XgsCdFHaJnoXAmNOMrpxFm7K6t3U-jKzyjhbxP2w8/", "developer_terms_of_service_url": null, "publisher_name": "MasterBozo", "support_website_url": "https://discord.gg/dNSWP4n5K2", "website_url": "https://sites.google.com/view/mighty-chimps", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24260570346895745"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314643_2438267466566333_7238902990150356615_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynSGgo07r0QQ7kNvwFooQY5&_nc_oc=Adlw2O-gxnsr_zq0SAo6-AboZefqQ1F9K3kbY75wuwXMigV--H4J4z1yQDFbVuhRn_8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftcsCVrEtmowa7iKLM9rOeJ_TQyT5qzLLhQdzmmlDOMyQ&oe=69A59502"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mighty Chimps", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1705696501, "lastRevision": {"nodes": [{"i
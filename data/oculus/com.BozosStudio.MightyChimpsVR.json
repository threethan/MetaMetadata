dn.com/v/t64.5771-25/491822045_810195334681302_8105131155463706553_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-Fl7gQHDBwQ7kNvwHaO8jA&_nc_oc=AdmoKPMB8_pojdhguJwBkNzaNyvgDlqH6AJ3TBfsichSqSTZcjBkbZRCA48u26r2NtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft3DRSqwb1i4hdBMmO3ShvnUR0wfEHbBNrYFzFo4eTaKw&oe=699EEFCC"}, {"file_name": "Untitled.png", "id": "1698848110793319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831569_1698848114126652_7361159994325479874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSVd5nBeyYcQ7kNvwG1CGrr&_nc_oc=AdlNy-RXC3iJNT5jAbnrf2XGfPEAWmDqoIpFkcNcZhW16lhpbSH4kB1hW6b8pz_xw_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftw1hkhVuGHr9FdVGvWMUOipB8J1TdhCWe4cadOcHbaSA&oe=699EE028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-08-18 214911_11zon.png", "id": "1467346087637834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831569_1467346090971167_7719583609683232094_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwkav0zfGqMQ7kNvwGpVFEh&_nc_oc=AdnryFekF95gp8kTR7Nka8r8TKUYR0df53_K1WTT4-mw9wu5xdBqwJjDalUtvP4A67w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuo7M3CCRAyQ91yxd-zoSsUU8y-jay_DSCDlfPwyzXDhQ&oe=699EE466"}, "display_name": "Mighty Chimps", "keywords": ["chimp", "gorilla", "pvp", "sandbox", "funny"], "long_description": "You are a chimp and you move using your hands. This game includes different maps such as chill forest, a jungle cave, moon map, upside-down islands and volcano. It has cool cosmetics that you can use to customize your character and even use to fly around the map. There are many gamemodes like Sandbox, Glass bridge, Prophunt, Tag, Horror, PVP, Zombie defense and so much more! There are many unique and fun features such as guided missile launcher, working helicopters, grappling hooks and different types of gadgets to use. Stop wasting time and get to causing chaos mighty chimp!", "short_description": "Be chimp. Jump like monkey. Cause chaos and have fun."}]}, "developer_name": "Bozo's Studio", "developer_privacy_policy_url": "https://docs.google.com/document/d/188XgsCdFHaJnoXAmNOMrpxFm7K6t3U-jKzyjhbxP2w8/", "developer_terms_of_service_url": null, "publisher_name": "MasterBozo", "support_website_url": "https://discord.gg/dNSWP4n5K2", "website_url": "https://sites.google.com/view/mighty-chimps", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24260570346895745"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_2438267466566333_7238902990150356615_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytNE512cbn4Q7kNvwG-FndC&_nc_oc=AdmN5wVrYLJZhyZFmap9jlt2tvpW4tO_ki2JihN5zq0jYfPBGKRPGEssJrBgOK2vhxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuEtfNbbHAueBe4n4CDTJ6hXMiWX_HXR5vIJR3zMdd_qg&oe=699EFD82"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mighty Chimps", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1705696501, "lastRevision": {"nodes": [{"i
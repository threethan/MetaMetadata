.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlLacqs5XwYQ7kNvwEV4iPv&_nc_oc=AdqFnO6siaiNC3CeYCC-fiBdU_FXB0Fbs0hHGK7p7otgd9NGWw-r2Y8-S0XInV6HJ8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af672Y6wA24FYPdOtCJifxbcM2OuYlVKeb8G59VUIm5x0w&oe=6A01CB82"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw7k6BbBLKgQ7kNvwEg80sC&_nc_oc=AdqDm8qxSBEP8TY31FLvzD4NM50m-Tks4OvqxA5svJ1r3-FqiIwkjpU4ErPI6PDHQcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d39Zb_VBRUl2YqwlRGuG19ox4ggWs2VgoJ_JHRIYJ6g&oe=6A01C2A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_yn1p5PKXsQ7kNvwH7OEqB&_nc_oc=AdpG1bOfObsz7mSk3H6FbNOdjLZATjsPdcW30oH7rFoD1GJegwRjPY0P_XdZrs6Qzm8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h_xv0QQmTaGnxSC-XJZKLFgRZtDRhKtDtk3du7HMLOw&oe=6A01CCD6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxk1CXCVkSEQ7kNvwG5Ck6E&_nc_oc=AdrpOTvqkquhAAOeR6pPi-97aV_etqKLdC6tirgYeYUu1cF42BufCbArngM5AUrd430&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hj1-ECHtM3-ctXetN-pIrojKJMsE0cReq2Y08A1u8Xw&oe=6A01F348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbCZF3VZG9gQ7kNvwE-0vFC&_nc_oc=AdqnjhVHeOCM7xiLap6tXyc3fc_mGx6dhiNGlKNFNgMdvpRzZ3iQNBkGPTTovWrWCvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AMeWIdgPWYvcJ-N1eMsU5_-n2FxIXi_eZLp6e-eO2Ug&oe=6A01CF9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
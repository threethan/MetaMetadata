3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqO2W3EZQQEQ7kNvwGOgMG1&_nc_oc=AdlmhaooEKwWmIeZedoDrkeg88oS19bQGo0Jwip6DXio0XFvVvpUYd7qbBE51G_zeFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDgpFqq7GZbyuxd36yeylS6WxMgWnOxVDVFQEwx-5cfg&oe=69BFE082"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzG-Ti0hj1cQ7kNvwFlx1Jy&_nc_oc=AdnLAiZ1wuPYQhhep_bEOzId-Yw-XSv9KhH4Dhl7lnJ_EXY8HjlZLCfTuRn21DinnWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkVyFNphexLVE4JF__8XyWl4IOeQtE8MZYiPH41fiFkQ&oe=69BFD7A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUvDIcdjAwEQ7kNvwGA1Xuk&_nc_oc=AdmtWW4zqmxXQX3h4EKt_U_u2Xdz0GnNE0JQC6V3Pp5Ysh6Q9wKYtc1xL9chwPi3svE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4gJLbDIf3lOh264zvy95WnXdCzRwZMnqPEgAF3lW6pQ&oe=69BFE1D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiJ52K-KX34Q7kNvwHC0hTV&_nc_oc=AdnXdba6l_sjNE94G0gz9Q2gAzmnzni7Sjw2PBmEt2urfK8bjju1DOG-dWtAXTJT07I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3hItW6QsWosldCWzQYNVDvY1eWej6wjEdO7JD9629YQ&oe=69BFD008"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuXpQWR2pqgQ7kNvwEEB7Hk&_nc_oc=AdnrwVvkwDCSAtseFfRoMM2hvL8B7MGsimwUYtVtaS4Fc6dkB7VM61a5dN0oYOpOKCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4wHEQJ3QhQH4sr_m0J0VCAxtu3o2YpgkzN979jsTgJQ&oe=69BFE49B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
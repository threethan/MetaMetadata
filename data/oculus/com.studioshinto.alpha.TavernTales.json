.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76kV1454rYUQ7kNvwF-PQWh&_nc_oc=AdrgY-KWrch4epRa8IxISTW0Iv_Ol_S1xBvAVa-ArklM8qVz8X4_HaltrN_pu_SD2bQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EZsismyYASJat8U9ut123KSw3FLLtnruQiOMc4BbjRQ&oe=69FC8582"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qcs_3ZOXakQ7kNvwGKeLvj&_nc_oc=AdpDNaPqXOmaOobA9AhShYHVdzRP-_wJLdRb2d8-xFmoVoVL2a69t4o8wVePadJtD30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LdOUVB9noOBUMaiVDHF8BrlNw6tlbx38KGDEafEdEdw&oe=69FCB4E7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtT8BceOQ08Q7kNvwFKufPl&_nc_oc=Adpacj33j1BTzcIuExyTD2_FgaC76NS_fgJO2qDm6sK9xfIart_5E19Kna5gGcsLqfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nfJeor6kta4s3Nj-Cx7p1We9Oc3lvkKpIL7AWRnxA6g&oe=69FC86D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4I0VPbW5-sQ7kNvwFZZrLR&_nc_oc=Adqauf1QRPciVKkVHHbMKlic24BRvA4phbk3KroM2VItHYWwSFGc6kRjz3OfS2DmFYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50JzZRMz6S0ahJlclIRKxeDZP0quKcKBhdr-1a6IJz6A&oe=69FCAD48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHci6qGncQoQ7kNvwFkrmtm&_nc_oc=AdpYnAk8Tx1dqYhNmWUe4Ri_Jkn1_0Hbv4JAEECfHZWqCS3PcWl0bYFmGQOfExBvvm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48Uh-WoJ9JJusPrcHYjrDIwo3wRos_NTLiB7xf03aDyw&oe=69FC899B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
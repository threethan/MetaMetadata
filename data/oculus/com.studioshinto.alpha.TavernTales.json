3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQXaIG7NfD0Q7kNvwHIiH08&_nc_oc=Adl-MQ7qro314FsS5Hhh-ZmkrkU3ftYwwpXjubvHucKw4pxsD_YtFP3dQm3PK8ZHV8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf3rbIJ3kfyVu30gj3cvkwHrsJoPdIxQa_oGwkoRbYLg&oe=69B00E82"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFl-uyNYyMkQ7kNvwF2PmSi&_nc_oc=AdnytNQb4D_Y6ouuhNKYlWFrMjERKT4Ckf3KfrBYIuRnFJSQqS8DbNPkz5mMZascd20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy16VQL4bnSvR2viWL_LJOxq5wa5_GWsiVjs1HGq_WbFQ&oe=69B005A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQ69d8BX3IQQ7kNvwFhVuAZ&_nc_oc=Adls3IzhecDnoRbTz2sT9IlJbxvRfRcSYp1z9Y9nrZTp4JxJoZM4wQqKza5w-CRb_to&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyf9E7guUu8eKwOp_Sqk-vaVXX08MXw4QA9SEMQUgblYA&oe=69B00FD6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rov_g5J2muwQ7kNvwGziwh7&_nc_oc=AdktNDmHNQtLaoX-67Z2L-Bl7_fkL4rvsgKJL_QGi2lz-RFyBfVAxt6brsC4sz_RSIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afya4ZqjU5trefkdeU_HeqsqsW0D55MDiHqD2K_wvUlN7g&oe=69AFFE08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-ufUeP7wEgQ7kNvwFK-6UI&_nc_oc=Adm9bdZ7YKg1ugfCMZrFUwKU5XQ1gMuPEufkMu5mZeklnEUt_i7JYefDQrs_ViTrwCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtWoIZLJb-V471oBjygpalCfnO8UwZFBS31VSAMn4dfQ&oe=69B0129B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
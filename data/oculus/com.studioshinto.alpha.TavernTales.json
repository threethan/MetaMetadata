.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8ZRefqhcZIQ7kNvwF0G9f0&_nc_oc=AdrHPF2Mywx6be92FmNy-WZhCiVRqa2g4-di7oMpsK0zI7T1ggPlCopdpmpaSOogi0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Es0dsQxDeXoCfgR6h1eU08w-nDjIQiCB_jMSs1kOUpg&oe=69ECB382"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vRklxG2yXYQ7kNvwHCU2im&_nc_oc=Ado9gPaMI4qJDHowCOIETyZptu45e-qZUdOSlfJ9uaWJtv7uKXCzj0ejH7q6Viwnpn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36205gitfyDLWj4bVtck-Rih2YrR1UMy7iOL2FPnWZaw&oe=69ECAAA7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozse873xskwQ7kNvwGhnUMX&_nc_oc=Adr2S3M66vMCsmZvYZxPMb_d1W-999-bpR6z108xod04iLIVH6lV9elHZbEMMFP27y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mqRJWKY8fCnxqw05px6FBQFH_jupNhWqUx-ENTF37Mw&oe=69ECB4D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kK9KB-q0psQ7kNvwFJpxC1&_nc_oc=Adq7JPIX-DoO9vRTvw3JfViS-22-JwMzx4x0Rm5sfIbpbdnCPa0CS3wbCWhHi1Lf7z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PuaFneOrmiRBclU9ZdVe7_i6taBB3_pvTBubhMahOmg&oe=69ECA308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM8D4_sJ86MQ7kNvwFjHW16&_nc_oc=AdqrCOICKW0Qab5KoRMUt4ldgztEGE6wKfmbI2wEazWxfhbQFewW4uLAwc9_BJSWj4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XaufC0ohLBrLPoShABO8S2KksPXpeEOtDc1E9QdJkPA&oe=69ECB79B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
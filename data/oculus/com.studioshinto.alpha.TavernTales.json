.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-9zXoqt2XMQ7kNvwE0GFQW&_nc_oc=AdqXvqOGIUX5FV-woyxiDjue8SGG-KvM8a1NUFATuFF6fOtqvRRsD66FdvkEg9Eox7Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af787lw1EH_AvEDAwnja0tlmCHX957xFB9lsLg8KcIkWUA&oe=6A0EFA82"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Wm1FtkzSM8Q7kNvwHQURyz&_nc_oc=AdqGultOlQ-LaTBzYsaUpVa6anX23SeulU-zxOsQfmiXQWYIARK7A--PQwUHrL4y_xA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KJvtXVGQAjTFYsfiQDcICM1qcWLuGhvNieKEujKfmOg&oe=6A0F29E7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9bWhwdh2nUQ7kNvwHstF16&_nc_oc=Adr6W_6aQIJL603tH-Y49U09DSIbERFB13ReYq_JXCkmAUWZ7QT4DCgrSXigKHHkJMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AM5dQxjBpUSQ4rue5rS9UslfV6ae-IfIRfqCvbt7olA&oe=6A0EFBD6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt897EY4EQUQ7kNvwEbvYRE&_nc_oc=Adpw89PiJNwUuD7dQoHhKTJ0peSZLhnTOfMDq-7a6Y7lCqlrEAdgc6_NSxERdPHHDbA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lhYl7z1D_P-PTeFMIDELIW-7oPzxiLdDhHSJKT3Bl2Q&oe=6A0F2248"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8v2AhUDJDcQ7kNvwGzTtc6&_nc_oc=AdqtoF_FF1kxq6w1Tn7KVcRMU_Tm0ztYoHHQfXE6_-ZhunkEV0kzp88nGCCcrAkHOGc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qRIgi0Sa0QWzAr61hsLxSpmEDRXeNvqlHJ9XZxG77zA&oe=6A0EFE9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pX3U5GHMnQQ7kNvwGUMygP&_nc_oc=Adp4SPqjshDQhuRmuu5itlkmo7Yv64FW0PeTS3E3pH86hFGRlltqjfL1bbXjTaQ3tkU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MHn35KfMhgvFbEOkAvVRXxKjpL1GukRcmaq1Cnk8mwQ&oe=69EF5682"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87K2rrQpfPIQ7kNvwFwm-rq&_nc_oc=AdpEtCmkmDV8nVBxZVH9kTjMPVQSniAh8uMLywaNlcKSdew2o4JKb7Ce-BhDiNhap6c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bY7ipjh0s7BBXwFcrrXqRHvPJ_dsA6d53HPrgMTonpQ&oe=69EF4DA7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzmV6Ll2F2MQ7kNvwEzhMq9&_nc_oc=Adqxc-jtbZWwvGFD6QpjtfBHeFo9jTeHRW4H0zaA2ketnCdvECSm8siOuOkYSgLGAmA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NtLGOmD0xBwTjSZuOA7xZM5Cdjw2mISeLKsb9nS4ttw&oe=69EF57D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPqOKQ2jD1sQ7kNvwHrP6OI&_nc_oc=AdpJFCyn-1XxJj69yL1w3-Qq4lgkPPDYXsinVftwsjt4olBhc22VCMYiUKSU52XUTNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zzXg9lFrK2gTlN7IWJu4YlIktazF8d10Ux-7k2kHSjA&oe=69EF7E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UydWcudNbYwQ7kNvwHtGgAw&_nc_oc=AdoQmbvcKqp0Fwa81gDPDoOu8OF9v7n2MVLIWeiRlEa-FECbt2Jj2dkfO493IjSuZAI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JrIKx3DktA9bZpC9eERPJEQk8YGSc9CNJZfZ21KErJQ&oe=69EF5A9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2GmUrFO8-wQ7kNvwHbIV--&_nc_oc=AdkJdqpN_8_K2NTmHwhTe6p1Nv1F-ykQajLQmIemMugppoLGQuMbUWaTVFEWeM0KlTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfBiInaQ-PoQJhXoTVYEHrzdlMt8RT6ZGMkC6jP4AQLw&oe=69B7F782"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMeP4baRkgUQ7kNvwHoquB2&_nc_oc=AdnaBDR72zv02gwuswjOaL-sixJCXIRO5bSKU_UWODezJZFXR3NBe-FMP7-fz8QqDBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afywl2B3oYw_sQbW9zdFjNAxVThS0THiTlY5I_mHx6vo2A&oe=69B7EEA7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCLC0R0SBk8Q7kNvwF4dSSi&_nc_oc=AdmQVo98DrZjZWP1LWA_dVaxtUXiNgQsr0HzZtF0QJMBl3hHRdFzZNLfg314-ciO0AY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyCf8k6qI2sNCdqlBuqC8EzQP86dNB5zWC-7f-4M5OHbQ&oe=69B7F8D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el6T8XwxtFwQ7kNvwH14hc5&_nc_oc=AdmiI9tkE5Dc3s3vfHNC1xzFC3CNoxcmCMCmakTDgD00n4yEEOdW2NbZM6ODnXW9OQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy54yQmX-t8JdVxmZPGeYKXMexopgf61gFffGGnc6SHgA&oe=69B7E708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_pqoupBKngQ7kNvwFPhbNP&_nc_oc=AdlBHcU6hF-XAeRVoNcdrud1QF_HGbohkF7ESHwSLhLuhXH2pm5C0moc3_cHlNyxgX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt6Ck7sVnzB9jnS4mBIPWJWitWBHGQZXnDESGB-kH3EA&oe=69B7FB9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
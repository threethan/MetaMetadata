.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY0g45fveZsQ7kNvwFSd3rU&_nc_oc=Adp2C7vGofyBqrYiEwZeMvUB7oUHsUSoTCm0Zuu0rDenoSUFHFvc0rhOdMgGCH24gmY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IMsdDvSvs0uX4u0W_c6bC72K0t4Su5fPeL8SXsiMldQ&oe=6A071182"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvgZPnWPdgQQ7kNvwErZruB&_nc_oc=AdqoObEZOBq8nBgd89nq-Cc6r7mjpMjgcs4pNoEtxSM5IlqI3vmdEOHA8TxuP2bPvhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uRwrghrcngquTwuX_8apWdmuW8HHk0P8O2bip0C_ZYg&oe=6A0740E7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LErt17BxqpgQ7kNvwGXYIbz&_nc_oc=AdpcQa6LxQcscKOq_mEa2LVQb56lLoOozIJoyuaGbfMFqUwWLkK_jmOK9M8obHzLz8M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UgCnX7qoMSOd8fYad43HLrYeYZv6Wan25XPbu1px_qQ&oe=6A0712D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgxWfsXOEc8Q7kNvwFEIEme&_nc_oc=AdoxgjcJs8V_hPl4Ww6vRErB0VWcYzF17piAgCy7Pa9qS8Vc95geMzbmpUjz6WEj0uU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rft1ALJjFTGlD3lA79WVPc5qxALXDY1jYajpT1HXtng&oe=6A073948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgwZHxfUL08Q7kNvwGcoWUw&_nc_oc=AdrkYajtwQgxricW3Trc0ovLQqaQ3X2YsBfTP0tWUWaadV2ViHQ7ietCK2ShsUls_0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k0Gl1REmzScKiEaj_ZGU8ouEvPNEAs1QA9lVtin0c-w&oe=6A07159B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
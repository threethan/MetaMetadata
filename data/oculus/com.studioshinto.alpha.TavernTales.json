.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQDU-7cJCN8Q7kNvwGt71TE&_nc_oc=AdqQzjCdtvYB_NC9BKHAu5qk0YG4HKuRR2HaAm18EyDfeaoAt0qux9T1PzAMQFnA4Tw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98HSjDCAyEVoYWR0m_XgZ3XxvKaBnxijUsViZvTlKKiA&oe=6A381142"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbHWST2vxE4Q7kNvwGDN3CT&_nc_oc=Adru8vMm0lbFw155oL8pwBjsuyypZOaUUkIxCbZwEG4GnNQ-oFrNkIxGohIGI4DYhqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CeFGJgOlAwxJQf3rTJta_X50AOte46Wag37FCoBWK7g&oe=6A380867"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5_j_bsVvEsQ7kNvwG92KcR&_nc_oc=Ado2GNwJP4fEZp1VWrnDHVVrtduhsJP-sM0j4inbTvYR7LiteTIq4SqHwU7_ukw8r64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tjRYUBFvLqrIJOZKwHymwvhy-3WJZE1wepKE0idFP5g&oe=6A381296"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSmdb6HTcpUQ7kNvwHXfa6E&_nc_oc=AdojErqeJl8Gd_XX7DORooW38BXQ09txcWQ0Ib-xp48ihEiiyEoT6VKm69LmTYk65UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lkuvQ9sGiWwJg-4FxL2aCPapgEd2NW-YC6aDQ2oWNiw&oe=6A3800C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USV3s3ehd7AQ7kNvwFBh0Du&_nc_oc=AdooUhIb5tj1YCMbo8z4cj3pLr98j7wS0_DsoqmvhcoRMAxMZhJHfy7eETFLzGniSqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3QUQWm_g7hpSnqSjUvLcxs9EZ7fCzvtHNaE0CAze28Q&oe=6A37DD1B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
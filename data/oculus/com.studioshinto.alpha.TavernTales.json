.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPjoQgRW1FcQ7kNvwG-d-eH&_nc_oc=AdoIewXLEyiw96vIJmj8_cnMec2ps-f6lNee8bT_IQVbl87cavLr8UrEyE1TC4ssP04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ceDecyg-GOAgLU30qgksmovqnzNXS-WxvDlDjtRAp5Q&oe=6A201E02"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdXDzOrEGkYQ7kNvwGO92CY&_nc_oc=AdpOLrj3NgPc0r__KkTnfzW8RM1oFLx5T52pA9FLgcKjrVx-okiwiA0VLgcwto4xAcs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78dEUtLVAMQKTtvpAv1anqrUkhviTgSWhoPHI3rpVAng&oe=6A204D67"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uauf_QD7ELAQ7kNvwHw5pUQ&_nc_oc=AdpsA4HJG9qyGVkErc0ZXcnjfqLkyLqsUbTBeoas44_bJ8PeyoH1kyPn-UmsiVc22GE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5obWQFTrX_tZ7zEoRbQfoFZ2bkeN176jX60zn8LY05Lw&oe=6A201F56"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wj5WM0n8bmwQ7kNvwGKacU6&_nc_oc=AdqQQpcgaCeX5cHVTXcrZ1PJXN8npax6TNE7q-f5Wk7b7LV09tq1I-DpKDBauERr9SE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dDe_c5bgYOLmCDU_NpTAgtB7JQlybL_e_ipu0mkyG7g&oe=6A2045C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF8z8RhuDdsQ7kNvwEqC4AM&_nc_oc=Adr4PDKJM3nXxJIIPKLBWZ7t2P-2bSViWAQqfKiHW6jdKjyFMS-A4pzKVYZ82HDymZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XKcV1LMAi0PNHG53WUoOJHQNzoXweVTxwmx1nIjYTew&oe=6A20221B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
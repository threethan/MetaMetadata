3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RVYuh2XL2YQ7kNvwEa8e0s&_nc_oc=Adl8NU1GuJaRBH7lfkPKHgaUh_SrPOmhKk-nrtI6MaHrYDAucrzDTS78x0VKg_vthl4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw80AsACAOxuQpxRo3peOEjO64iXdIMkcT2RUnnvKuSLA&oe=69B2B182"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFl-uyNYyMkQ7kNvwGoKXd4&_nc_oc=AdkV_38GbKS0Ua_ML9atyN8iSePUXBCx9aHsA2Um0plPSvejrUaZ5Y6rS_5DZpr_TZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAAJHXxGK1sMvsVJFho9ORGluYPONv9kZDnY8ZFjwWHA&oe=69B2A8A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzh4hUEAbLoQ7kNvwEFUuvs&_nc_oc=AdkBkmwyz3E4v_e_aWK_uAVXb0FdVP3dK1W52R0M4RON60A0XqHACZ6xdss8jP4SErg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxVLFSOKKy_uCht0Nby1UE-PGKustdj6KVCQOznqi-pUQ&oe=69B2B2D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnJ4ZBkb0k8Q7kNvwGBBT2c&_nc_oc=AdlholASXEJcg5jy57ydm8YM1Ye1CgNfsl5x6nAwFKzETicF8yFwDdzrKjA-Hgn2vhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZsNYHwagPfE_kS4Z_GxU28SAQMSCFLftqyEpnHjJYpQ&oe=69B2A108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-ufUeP7wEgQ7kNvwGvUbot&_nc_oc=AdmihMBxarmcws6ndUT9PuUNZwGP6mowU4wIrbDXDiz6XP7P3HLKavllFBuMzdCRnLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRqBvgeVymEr26OZlNSXdgC0g6xk5IsA7JSfME9bQHKQ&oe=69B2B59B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
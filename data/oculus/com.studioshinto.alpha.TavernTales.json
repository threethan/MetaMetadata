.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh4ipqwn8DsQ7kNvwF1HUis&_nc_oc=AdqjehEWLTqh-gh4Yyv7qoftgNwgIPA6hzxr9UyRlLlngxDC2kHqlMIOhq6-dp1IMf0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8byP6xlTtgCO8Z4d8JEeTayRjRgF-ZDZmvlnLybndsmw&oe=6A329302"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9tCYva4mAAQ7kNvwFgGYE6&_nc_oc=Adplzo3ZyitnFfgzsxGz-_XVo_9AChBeWdxgvIhB5C-yGXBTev1O7OT7oxVAwboQlxk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-irAemtbuoz_vbF4ppP0996TlRnWVCUbFpqO_bA5WafA&oe=6A32C267"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuRVgON6OLYQ7kNvwF_dbDd&_nc_oc=AdpKR83hAr8HjUXpsQ18z-gABS3TpzqFrS3XtS3orea3rHL-mYruvCC2NOWUHoWAsd8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RrkTIenXvsi2-vCSV4vtkkHfZfNLJzpAWvqmpszAtSA&oe=6A329456"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-7Zqp4IlwsQ7kNvwEXJ2NL&_nc_oc=AdonkeKq-UDaoaJVoOi4RB9Iu9IvqI0PO0WLSTfn_5aPDLhFDqzWfDo9xYNSdhRVCsM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98PUc6e4KCC5pE9q39Cr8hywhrxhDKwHmbXfjZhiJ54A&oe=6A32BAC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHxAYmSA2b0Q7kNvwE8PD5f&_nc_oc=AdrRCxKZOeliFnVmQJnXxtMY2NgLy4W2yx9HMIWHQ39J1WWIIDxeDqYJyOEeMMn3XYA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wVVX-XTD_JqW0HuEIBDmXndHIptzFO1fmkBsWr8qvLQ&oe=6A32971B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
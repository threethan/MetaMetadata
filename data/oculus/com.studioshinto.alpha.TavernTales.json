3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2GmUrFO8-wQ7kNvwExubHH&_nc_oc=Adn7EVdz3A_iR8HaWgSO-P_x8_XxXHThcSD_eED2QPX7PsBDg6WriQSComDMDnaUGJ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFUu21ErjonVQVoJkIpY-5lHEvxmAriqQxoxGFzSGQyw&oe=69B94902"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMeP4baRkgUQ7kNvwGUS3TU&_nc_oc=AdmkvIq_Ec-5fim2tHtMYGQjhOQcUipbG8iazzMxYIgrux-nBrDVpJdwPdIOdx3wa-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyuh7KpemZaKWCt8BuUVRIs7A_K1HUgvK9IbBPST71smg&oe=69B94027"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCLC0R0SBk8Q7kNvwGGwmS_&_nc_oc=AdnMV5YuRd24GdbP-7JVwVZ5U9vLVxtkeaCTmjG36nXji7SlDg1z0OhdgXkul4qI1mI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfysOSBJMHidBhZeRfTbpZn9heBK5sf-edXn8NnxbHqtyQ&oe=69B94A56"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el6T8XwxtFwQ7kNvwE9hNK2&_nc_oc=Adnv3cAEb8s3jL8wHs6s3havMmI7TdtccwbtaGRnKkvmEfxrNLARwtcQJjx7AkISbxY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzovlUgcP-jLwl0RdHMc-9SNy79YOs1cDb834VMWDwXiQ&oe=69B93888"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_pqoupBKngQ7kNvwGjjt1o&_nc_oc=AdkoIkEmHJWVa0E5jlcnxPwQ3iyv6fmvjZXL1jhKBXvK5XZ1czyZ03mmkpQW3Zzq5vg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLiAXbZwXsKvRgDh32ZyH7im0Rnf3TkMPqb-xU1-uFmA&oe=69B94D1B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
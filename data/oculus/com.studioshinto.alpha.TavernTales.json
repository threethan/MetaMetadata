3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqO2W3EZQQEQ7kNvwFGmli6&_nc_oc=Adkp9Xm0aKM67Gnu0nL8j9cI_qN5WaaU-mdmBiBLh4bUD_aN__KGdYlhUbCtZuhMoio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMyC0s4Iq0Tcizs5xqJT4g6i_b_JUtVYByAyNELATnHw&oe=69BE8F02"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Iq97UPpY9YQ7kNvwHOrtCw&_nc_oc=AdnwTCcyZrt0IDm-0o2zjsRatsW-FRxSExv4M9NWwoVM5LSghJ32Ge5ttqOM0xIP0n4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyijFY6wATG_8kAK9mjUFdq-2wFkXPs3mAENU_odHQ4Hg&oe=69BE8627"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUvDIcdjAwEQ7kNvwHfPOy7&_nc_oc=Adn7V9zemGFrGvEp4XnLX0lyZZ-87iPlvrSjcNTs9BGBiXdvWIIz4j2crC59TU1kpsE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2YPQd8ytcIYpOhmvEKwv4_QbzU-fbb-Hoh3NxAa8smA&oe=69BE9056"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiJ52K-KX34Q7kNvwEmIsS6&_nc_oc=AdnL0Mm0CAUTUSyaMU5jVyElO76P44joC1JyRCdDu-70mtkaTP1k56Che2QA-TwXp6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVi-hyRVbC_u_fGwwZlfOpK_V9j1Mf-P5Mfn5vfsuo1Q&oe=69BE7E88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3AJUcfYcAIQ7kNvwGnV-D4&_nc_oc=AdlpU6I96ggEj-BcnF9CznvsqVWy5IS-QWhq-DnHvEZ5aoBK9BnZlF8m0fSZl9-3vMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAmOQc0k_Bxy_6BGWv7xjCB_BkGQcgfxGjMmx1l1j7sQ&oe=69BE931B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
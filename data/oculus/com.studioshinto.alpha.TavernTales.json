.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIE8ghJkW8oQ7kNvwE0UU7R&_nc_oc=AdqXWpcBXZMaqgkWbkoA7wxQ7JWB6PTqpZnpr-3JOshvceVJScfK2bkQ7rFfQu_o5PI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkUYW-PU6iLFILaSnveX8vObupYpzJoP2pZvnWH_Fmdw&oe=69C7C982"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMZdbG0NiAoQ7kNvwEyjCcf&_nc_oc=Adp2DgMpPDziHXVj5O-D1n37afm9Kuhht--rqdsY6Kbgm67bmdXvjRDUCcCH1Ez7qso&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwNgzSghcbv94YmrVQ2lUJlc6QVhCqYxg_LhXxTNcN_A&oe=69C7C0A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7X3_0F8ABMQ7kNvwGb8BPZ&_nc_oc=AdrBLHlgAxourZu9XdN4qOwgVXzIq1pfYgolBCsYu8H-DPkA_zE4QBqSGGXpv9HkYxk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxX1r1WBSioQxEHDURGfA3sB_p1CfxVPuBW4yNuyxw_OA&oe=69C7CAD6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UhBDjFkbUsQ7kNvwHFjnXj&_nc_oc=AdrpobMF3hHLvVMX8KbavY3C7T-05SEGT5IedF0UdZsg-V7d5TzAQ2GdZ2YJ6B0jFjw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPkF9uq-3d0jJxGtKzaeShlpl8jgobG0OE2tVsC9esjw&oe=69C7B908"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgMOP3RLMlAQ7kNvwH4wl_8&_nc_oc=Adp6jJKWYxH8pIMVTjB9H8OTJs1Vt8qVIoG6KgAGAmTaKWJdmmEaTNL2dn92NSQOolI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqkLKKnf1sxWWlX2oN59rT8jAS3N1f2VgxLfaTopKRzw&oe=69C7CD9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
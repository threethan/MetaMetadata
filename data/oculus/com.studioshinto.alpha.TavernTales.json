3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQXaIG7NfD0Q7kNvwEmyykW&_nc_oc=Adn44VCLV7fmnR-TyaQg_Oqc46_wDZ5cwEahejtzpTqeKjUYEqcl7RKf-LLKgXDtEik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDEQCg94u4-dL3kt_TsKCtO7p5isEB69LibGA1wN1R0A&oe=69B16002"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFl-uyNYyMkQ7kNvwG-84Dw&_nc_oc=AdmiiUj-_6ny80S-966PlNAce0qWhFLcyTnfvVvkNmrfeTlHPxDikAnNfa80WbGsAxs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzij7dJPMaFKmT7q1Vn0KtjP0Xs2K-QeNNaEDBTmsR1oA&oe=69B15727"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQ69d8BX3IQQ7kNvwHVkMp4&_nc_oc=Adk8i9yLjfKiOXvtipUIBiJ3rJ-2-MBYj67He9Gxt6ukyBlSpzzJqbVx6znWZNyQtk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwP--J9FRBG7RPn5fCz6vs8mcE4_IM7wjihj9tFnarFiw&oe=69B16156"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rov_g5J2muwQ7kNvwGPt_yi&_nc_oc=AdkNs7B_AFI2PpI3nokGxoYZnCLFNjdwj7_l9C56taZldimgCctDAMMWeQtmXPLzf3M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybAXcGdexBf0obFVwW8l2K_h2K6siMmhrXS3AKBVuRZA&oe=69B14F88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-ufUeP7wEgQ7kNvwHR6GLc&_nc_oc=AdnDwo4yoycG1KMR6sxzdoufdzK7AI2uZq30p6CNgSqov_wFyoqQ2dZdOmNFaKBEvpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afym4L561bHlx9cZxQwS809Wtg1Si0FSxKxT7Oj8w5e4Hw&oe=69B1641B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
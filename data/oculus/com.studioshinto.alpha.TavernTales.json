3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7ddjarvmc0Q7kNvwG0iOiW&_nc_oc=AdnjqakF4SC4rz1ZErfJ1Id71cpCmPL0h8KjBT25Msdc33JwAdg7gvVkwHRQcynu9eU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxW3g499kuWdqkdz-b8tB4oAekKynEnhMg_rQI_JtwRPg&oe=69BA9A82"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMeP4baRkgUQ7kNvwGV9Y_X&_nc_oc=AdlN_mE4au7GDHrcrSBYlfpzpYFZNuwF4kyBgB-3iia8DzvINaiOr2epVfLt97DV9_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyl5k1B8ICp7JQP3ThfsObpZZPyVwInafVqbxU7Ilk_Xg&oe=69BA91A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0bvG67YZFEQ7kNvwEF-Upw&_nc_oc=AdmExs9706Pea0hYSwbFFCkbELeI3UPW6XA7BeNPGS_hSlU2GmnryOXYNVbGZdMff-A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzU7RFd9mMH1is3N184dYDZRPdejem3QanW9pG42Vv35w&oe=69BA9BD6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsVDQhrIpX0Q7kNvwElBfFK&_nc_oc=AdmxyCWPlL9gj-J0KSm0qFE3beOARR02c-iwNbARdv-2V9clVHxMvTDhPVo2lkrhtZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmIhRGnM22pmYDZvt4LC9FNSFNO3T9kRkPTmytYwx1yA&oe=69BA8A08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_pqoupBKngQ7kNvwFl3aOT&_nc_oc=AdmDlcLH_W54V2o_kY-uQymbISFme5XwFGmqtCXOtTldYCo-tZm4QuuPcLnfVK9sH3E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzgTfK52K-4BYdD_POZjabtTiBNlZbpK5SttAFsk9n-Aw&oe=69BA9E9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJtMqxwJyNYQ7kNvwFdlNO7&_nc_oc=AdpfIcJAwsQ48jrpUsP0oMxU8SvjvxWcOBIAw7W-zKLykbUQTtLsSXAnhbrg580l7jU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sjbJhtgxue4Fyugf_Xrrzeajz0DV4tkBxpoBnLeFv6g&oe=6A198682"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s53XpopnszIQ7kNvwG8Xq0X&_nc_oc=AdqADVMnmt9smTj3v7bJ_Wc0068793xvx7xUrhp4hzHfBcGmGJNHJtXQZXl_FjDASU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ccCXQVD24l6GVdlJKnnzYxv7fLURFt2D1h8fqMLXbkA&oe=6A19B5E7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWYAYfq9Y2UQ7kNvwE06yhO&_nc_oc=Adq_Bo5C_nu5MSRUnb61d0Jj4dIPQapoUmqbabe4_700HfCTK2KOFeVKb16rZrSmPbo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iQJ5bT-SpJmAZnX1ClM1I5p2_TuOKmPZO9uIQWMH7AQ&oe=6A1987D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-p-ar0tB00Q7kNvwGjcJw-&_nc_oc=AdrEepiOJlAqFvyBgB5PZRB5gMI7ta92bxt0wO-3zM9kq9RpqXLN_WP6pKgS2mrukqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aF8xzrgPpGFS1-7znDN6Ye7gsFDDsbdleEtKpyfkoSw&oe=6A19AE48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tjuu7SMLhgQ7kNvwFkTzNb&_nc_oc=AdrZBGj6pR_NBaUoWrs0h86tFg9V_qU2A6R__6Cp9Of3uDcBeb4EA-Bg8sCSLL7_DXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68yFqIu03gbD45MfN49LpT4BBpDUfotITnpADEeh8CBg&oe=6A198A9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
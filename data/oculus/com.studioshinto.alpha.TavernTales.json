.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJZn6oTSmvAQ7kNvwFM7MT8&_nc_oc=AdpVMNxrYoVtqGSLXOsmnh77XRt9bBZP_ZcmIZ3cmPb5URsjFHJJMZID-NMbMTtquVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pC0WZ9FCrpApCvXPec2JcfxvhufAohkSbzjUzUM6ZcA&oe=69D4F882"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFeSJHYiLdsQ7kNvwFspLf1&_nc_oc=AdpffOEomqVS2bO9lnWpsKK6T3_oWPauJnEwiO78MmpYI89Wz18kNHcdNICLeyYO5lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cWl06hnHP7zJLUfwnj2QQzgeiAK9sY3zflIeGPM8tLw&oe=69D4EFA7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0MZBTsHF2sQ7kNvwEz41cy&_nc_oc=Ado1c-E6tZfoLTNFXzBTRfye7FjqrgjN7qtPkpbe0Be77-lCxZtMi_oxalZfrRMore0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TWB_Un2lUjebCn0NDHBlYPDm27PUr6uU_9RxEH37iFA&oe=69D4F9D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QkF-BNzMJQQ7kNvwH7nS2Z&_nc_oc=Adq2TyajsvSlIf0Nra_86Ek17Xaen8PzEyR-Q6PncghuXDFtNRA0iaFC4bv4MclRo_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XSuCWrsclwFxN9DQiYHLOaMpLQRqrw0NJGNADfAN6vw&oe=69D4E808"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l84i1ziz9-0Q7kNvwGgMZmE&_nc_oc=AdqbTZY60shkeYxrD0_X_qNH-mung5foLVsbIs1MveGH4ukQFaBm7SmF1Q6lTI-6GX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zGqHLJ35K6TNPOX5QzVQtdLRFpE4bGRZnzPwnGhom7Q&oe=69D4FC9B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
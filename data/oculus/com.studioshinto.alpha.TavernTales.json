.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zF49atwNJoQ7kNvwEm5HIh&_nc_oc=AdovmfCKM5ctIwbf5jmFHeWn5uQZZ9XBUZM1KMYa6cLZ1WID5pQIILbp0XEo1rY8Grk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FJVmnUfWCA-STkk4ojjOAjtwFp651fH6SeAhfjK7eGg&oe=6A283F42"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wO2PCPbHNMQ7kNvwGdUWOw&_nc_oc=Adrh0idalkelwxzAK9rxl3vb0v4bDuxQRDsaqnL85Go9cTlAQKyGxToIXxffewun5g8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6nQXX3HJ5TeoxnS8VhIAHijRZNwIj0f5zJtsS-iyITQ&oe=6A283667"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ84V5ECbP8Q7kNvwGylPTV&_nc_oc=AdoIt2pLKyzcF6OrTLIsOePHwsKWlvZ2UMljpHdayG-kpRBHaTXKutva2dxjnaV40oA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ush5XBrdEYrHuGnadEN3u0INdS4KTj2MaS__mQ5JAiw&oe=6A280856"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP_bCp4ltfsQ7kNvwFPGUGU&_nc_oc=Adp-77JT4d3DAbEKrbAkcrP-6ypwmiLLapdxX28aQ7xORuoDLcFlGiqJjvndisA5jtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oeBG5O3tgi07fZxwPpg7D3Adv8EaN1Sh2AE7fD6qFJg&oe=6A282EC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEH6u5cSm50Q7kNvwFMHMpH&_nc_oc=AdrIrfY8HVmZCiFnXSLIqbX3_N-ON-4XEHJO6yyySg5BFi_Oj7umQjTYcqHK9uOblWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yOe-jnKTis3HCETGYi-i0E4K6L6Z9Egf2I1ep1ltG0Q&oe=6A280B1B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
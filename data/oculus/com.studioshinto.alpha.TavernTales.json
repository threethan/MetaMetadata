.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy7E_7KkiqQQ7kNvwGFpikF&_nc_oc=Adp5xyN29pfeRDyRPynkuE_6Mf2ELyyCQhhvGlo8fcoemjdXdfRmKvaZqJLJ6VpuObY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GQQeKRvPmeoS4gx8CQAAtsv7AiLD4ZMZlRZEyEDNwCA&oe=6A3EA8C2"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRBofmmIX1cQ7kNvwEGr4Gs&_nc_oc=AdqiDkZlIRgHaSz4SbWVh5GfR_IEmuiWjyLteo353_3m465NqXJGzcbClqaxcdolibY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_clGEnushYyYO9G2n16dZVUWYf0uU2BFaiq36rfAxugA&oe=6A3E9FE7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PpF_89C7tsQ7kNvwGBaAZF&_nc_oc=AdqTeu8jr0HFhOpQ11h81V7L-aeu2ZfJen1RhGNfi9V2KCJgd7Xl4_8pUj7UIKe0bzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84opstVfZM7qStB0awEniRlpMd0MsuSQWbq5IjYz9ryg&oe=6A3EAA16"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKrgHQqzHaUQ7kNvwF0P8_Y&_nc_oc=Adp8y19rRnGAJSDqIy1BtH0FHSi1f_1FAUgo8boFRYpQf1NTpQm1QOXtfxHRsKv53kk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HPIXgpE8I6xBRH7aMnEHtlfN7hvFGlMAWpWXY4nNdUA&oe=6A3E9848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhHUscujA08Q7kNvwGfEs01&_nc_oc=AdpxvpEOQ6MaaOcMMWbPwjFZ1S2DzB0D2blBOlweYE_9e8BOrxdAbGAF8Edy-1aGu2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L6UIbaWWL0dFNaVme-ml2U7Uo4M74UzlLTc-vsjBpAQ&oe=6A3EACDB"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
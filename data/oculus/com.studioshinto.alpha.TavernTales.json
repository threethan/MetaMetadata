3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RVYuh2XL2YQ7kNvwEzOQgn&_nc_oc=Adma5mtqN6gzGecI38k9AcC7NSca7hqqgUvwo81jK0bxADxz39wry1pjOavZPFeaaJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLQIWyaP5J_Dh5HPkhtJGs7K4qsyEJV0hCK4bGeIpQ8g&oe=69B55482"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkv8sM4eoCoQ7kNvwGgquXJ&_nc_oc=Adm9BiQ5nyWeqP7qYtTpQtOfuNdOkq-lTCqo39cqiC_e8FdKVDe2t9aoDrYDuvn-R4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfztKVymXPgkgrw_lSOn0k2Yt2ZJuS0Hf2WHD0vEidD-hA&oe=69B54BA7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzh4hUEAbLoQ7kNvwFzXoPb&_nc_oc=AdkOjTPnXDakTqroaR9eApdyg1p1nZJ9-3Pib3xWGh-UhUQ98HI10b6HzCUgTEhspz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwctvS06eFzjvyGAJgr_xAKIe5s3kGmB5We4Jt7YR42qg&oe=69B555D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnJ4ZBkb0k8Q7kNvwElXC73&_nc_oc=AdkK7M-igKhitLmsSPXzNY9LTuQAdQ2GVyU3dsLKY7zWtP0ltx2Dbn3CqM3EqK7f_Uo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVxX1uZYKVdHtVR5RJnX0OlIc7H2wDXKwDmNdmylzMVw&oe=69B54408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPTBLmNN3ooQ7kNvwFs0wIp&_nc_oc=AdkXx-29EO01G14UGLh2WE7xZAefBOqnSq80CCalKBkdfAtowM7h7muEpuJyjVj8wgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyinM1y_fDnZYRSAppsbUskh9WvmboikX5BpVOW4MKKCw&oe=69B5589B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
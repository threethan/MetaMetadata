.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh4ipqwn8DsQ7kNvwGl5Eka&_nc_oc=AdqM-MEW_wjKhRH2lGb6Xsjj0WYa4CXmPNsNDdEgtLqoY6wU6erPcFl1UtKpMg9Kl6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6FCI1M7HiFew9nhgpCAWVytwqcZ7DEn54u-FfZBKI1A&oe=6A3179C2"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79EdpG5wCR4Q7kNvwHNPqcu&_nc_oc=AdqhgHk6kq0bA56cD-Fqen7pI_D1Xb4pDV6JKOtOsdAEv8Beu4BdD66l7v7lxI_fvKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v4LIZBdEkTrpSZAjCDcSrhaeJaVMgx_isgNyLt539VA&oe=6A3170E7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuRVgON6OLYQ7kNvwFGW-7g&_nc_oc=AdoxiN1aQXlQo_xS-2VS1dTBsQo0_Nfvh4wyJJq2kzWgrgQAA8Q7i5OFS5gq9fw5WPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wn-gl38SM_DZ__B616zC72XCtcMuS4oX-aI9bi3hMyw&oe=6A3142D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-7Zqp4IlwsQ7kNvwFrVyEc&_nc_oc=AdoRz7ihAXwWioaMUAoJYWqTQ-q_hV3dG2KWsKlCA8cj_P9e6HtoxPIPsRDUYOmdDbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rmOBL1D4fNFieLuCYQpniD9gBmi5boidyDhe2wVA-Eg&oe=6A316948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7xp0urvr5cQ7kNvwHEsg37&_nc_oc=AdqRXWUNFkpGVy2n6PO8L1sSkSmUy4Bo_mSapl2bkoMY-eDzHI0fQ6R-O0ipwlUdRC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OzlkIRgEx-qSnh99ses4RRyNJ2WNJczk2w5kDXRYl2Q&oe=6A31459B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7ddjarvmc0Q7kNvwEPXksE&_nc_oc=Admrq1CONCWCaVD0lJCLO14oRzume2iRKJ0QJmwKT_BPagk3rZh3Zbecpr3lSwLcY4E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxN_6HaPbTmEL7Q22213GolJDU4uyb4nezxOJOdYbV_5g&oe=69BD3D82"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Iq97UPpY9YQ7kNvwE4pAdk&_nc_oc=AdkNW1EJ8Nm9eO7Mtqb9Czaan55TOF2x9yDcaSXvI3v5KgqbFkzCUxFctu0cuR0GmEQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwo0KCKq9GjghICkXpmMHykeM6ae0bg4HxDhEj9NeltfA&oe=69BD34A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0bvG67YZFEQ7kNvwHRWtQh&_nc_oc=AdnVNLl75KfLLxdujd3WK_Q3OPI99dWU6J8zDOwDmJ-M9dyRmZR-KQznLCVbAk-wePg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzs0sH3EKDBxhE92g-tDKPO_LJYLoauOKWlUA-7JLHqAg&oe=69BD3ED6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsVDQhrIpX0Q7kNvwE5J-wB&_nc_oc=Adk95ksynrO-7aHNL3nRI3Sb6F-o-6V1VlDdRxW7xD0p9xSr2jDkxFJSuT3KHDNoLOY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtY5XdDgjLoB70rR6-x0730VaeU-0MyRdqZVLefWGndg&oe=69BD2D08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3AJUcfYcAIQ7kNvwFKb7fw&_nc_oc=Adkq8G1XQE2eghzLQmxUOaKFRSj5bLlmezwQfsJmiaGjhMxWD5--6NgaYyBN7faBqD4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOwNAgWjuxMIp6ZcQkgyTiesrR-51FIF5iaixG07XINQ&oe=69BD419B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
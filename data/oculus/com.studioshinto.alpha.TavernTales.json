.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl_b_Ny9YAIQ7kNvwENRXDJ&_nc_oc=AdqPj7iBnE_c3E15BvsHhEr3n8xwAh188P6q-fCShTq_hXmu37tQ4ihDTurrfGmKDRI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HBYyCUWPTbCN9wwYUlXtcqFw_dxoTmyFC0cc5Wxs1xg&oe=69F49C82"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZWSCy_5qGYQ7kNvwEgPvmu&_nc_oc=AdpFy22uorroidXdTgKlOBP1Fn1pos7UADxk5Jd34xtTlg3lQ3g5GOoiqb8gE7t9Sig&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j9NZOzwOkDBhSh6n0gJOdkH2UJId4Cabc-7pDxIshGQ&oe=69F493A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWvU45XAo_4Q7kNvwEypxVL&_nc_oc=AdrgF335MoKN-B4zz5z3bUrwcfXeq9sGcZ47vYagCpJDl4Qxcw6c3hhOD9pX48MSDGA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kJFBwXsE-CsHvwRpj4w9aOMqyn5UZWTOqpwdGlFkh8Q&oe=69F49DD6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTehnLiMV9wQ7kNvwG16IEX&_nc_oc=Ado9zUA1G7C9OYMukn3DA5TmNppH0GW_i8EBPB3pN5J1n8ZQdD02CGqla5fg_c7gExw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YnrQrn5ELPAa0B3s0KeA2zN7f9irEv6GPFdfxB7KVlw&oe=69F4C448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl603dwgN0EQ7kNvwGAeZ3X&_nc_oc=AdpXemFLbKRQti1WbMYc9pKOYFMWLl_0aDlLWLdTcp3wHu_Yww47VbtaoPwNcox66FQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dvgZZ2--6PzPC1ekrGKPeuCk2e8hokvEqrzTIqAOL-g&oe=69F4A09B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
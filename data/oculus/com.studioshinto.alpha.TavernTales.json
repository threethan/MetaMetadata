3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSxFW74K-lIQ7kNvwFcW4l5&_nc_oc=AdkUfl6Tic0Cg-XMAnfiSSTJ9aPnvvklfZ0mJ07bzAuKqvq7HIpN0g_PtJyjA5s2tK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftAB-j4EzY3g6lQ1MXjBZ1WS5t-WFfxwnzg_TnEqtyBXw&oe=69A82582"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO_38JxsxNQQ7kNvwEHtcfo&_nc_oc=AdnOeaWZtZM1x4I9OWc9W-fxpIlO56DFTCviyR-G_wNmM1xi5K6163vmBlbbPEqDtWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftv5fwqBE6NAdTCEO-u32PiVIiXEysvxduXfafvOsJM1w&oe=69A81CA7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfw1w8Yu_hsQ7kNvwFNu6qv&_nc_oc=AdklJm5yI1yskJ7bzvwsoKnBT_WPuCVR1EliNZwz-U4Z90qTaow1b4Sa95Urh8jvbpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftnYPtsYNLrpVeY9CZfkE5dIC0lj5GRk3IkaP2gB6jYfg&oe=69A826D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMHB0Q0nfo4Q7kNvwGeflIr&_nc_oc=AdmKH0SkHh9T0rtQxsRKDcDNcXxwWHXN4HIysd9w7tMRW5P7yXNj6u6h7aBo_VUduL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu6Xo2q0hLbnCkfYE0oQJX3I8r8F-Myi11DZXLf2ZCqRw&oe=69A81508"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXBGNTOAyA0Q7kNvwHkx7Ps&_nc_oc=AdlcwtRQZ6z6eS_ZHI_enukBTzhmq6J-arRh2pR1g5aVIYUnPl380-q8T289R5u_OLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afusw0gM6kOrKmUqd1xxnFDp89FxN_cStfboVS9RoKdYog&oe=69A8299B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
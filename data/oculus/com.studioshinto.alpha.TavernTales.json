.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIgHksXAN9AQ7kNvwF2sYBA&_nc_oc=AdrdW9WzI1IS0gIqccBm6hR9HTZTpy2WwOy8c9oeFn94pB74PuurkeLHwxzqL6BQEEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ggVNl9-3ovdAmmiy5evxKHZ80anFWRY7CY2poKGQuMA&oe=6A2AE242"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9V1-GzvRLAQ7kNvwGSXyyP&_nc_oc=AdqCD3E1MsrfraYfHN4qzUI-HZz5TU-YYj0jVzAGShio4_p_b0oUsq56F0-og-_lGUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ki_3aR3Zl25EFzxV1cqT6GDkV0vFl8l_XJLllupzRyg&oe=6A2AD967"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqx0-Rz9XtsQ7kNvwFRCAKm&_nc_oc=AdoK9mhtGV4ERWLQ6U5HvWEi8hASXZMx_NwbdQAcknX_t7R2KgDhA11bLEjz8QTLxEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eDT0JUCdJXFTIM3zoooGBSeTKtzvjCVpS0HfQy8Cj6g&oe=6A2AE396"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgGAIbWcnXoQ7kNvwG-UmvE&_nc_oc=AdoH9BeMns0LNq3NtmabKYJUQV6Ktn3jC4z-z5oLKq1JP1YS_DfUoVSriVGnAmjI4lU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EWjwfypCy3SZ-EuBDMqD2ERbc6avidir-jLPNVHP7hQ&oe=6A2AD1C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuOBZhQs9bUQ7kNvwGEYwHy&_nc_oc=Adpx-3Wz4v4zPN1v22TE-Z2P2rBQxWFPLS9gohCIMCNvnKowliFd7rDfzuOHAB_YqYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HCz5ig6mOJO4V7ESFGID595uKMxS2JPnvNZNPns9Dgg&oe=6A2AAE1B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y-_KB3vHDgQ7kNvwHDpR56&_nc_oc=Adp6x8wgfZDOkZs59NrI4Lw0fQ0idVp8kr_c5goj4n07feHtM-GXmVvOVNoWVZtumUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MFH7EyiiBsXjPYpWr4sV5t7Hb7rFSlKSXJYMPbXQFtQ&oe=69DCE182"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax5zDppCsggQ7kNvwF9oJ8I&_nc_oc=AdrO1Ptj7fs49-qzd6jhSr0SvLOR9HcejOcuMG6xzdiFwqpIgNsUoJZuwzCbAtXKy3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jvim0-MECU6a2cw-s-EWfs8TEMqKkuYYwY7qqQnwvJw&oe=69DCD8A7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-2gtIKp8yoQ7kNvwHrlVjn&_nc_oc=AdoSha3AnkiX-VBxm3oEiVp3Ss1m_7qy_ABxL-ZnhV6DiIh16xvCzf0PsmBWRGzPiiY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s7gMR4hSkcbZYVbVAeultMeb9aSbB2NTu6c_6NBgF9g&oe=69DCE2D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8azfnf9W3AQ7kNvwFsBF46&_nc_oc=AdpePU1EYTUqoXnZUeQFfACXHFUqpaMxc4CGv48_YvH0jZRKpygV61KbNVbZzVLQa4M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R96I5JyNdy8zJMsMOURhCRXoSe7j33X3Fsn_r2lYeHw&oe=69DCD108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52WCwhpaUrUQ7kNvwHqXeUM&_nc_oc=Adp8v-4bi-ouzpxlY-Zm-f0fYY9-IZrjIUjwftoNa4p52TZcEUjEnwrF1Lpt_7XPXmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wpsMRwqiVEuDUPMVE6BKrRXgft13LJEZIkk7ZYzbUdw&oe=69DCE59B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
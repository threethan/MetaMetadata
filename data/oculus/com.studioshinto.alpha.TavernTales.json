.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAE7rEqoSmkQ7kNvwEDgjgG&_nc_oc=AdoqwJo6Ra5UwId_iytp9OtkIvPplzdpozxRg-5jl53SRm-a8TZb4DF6gBPHPc8XpH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j32d0JXN7p5X1bKCewYF3vkgw9fqwiQ9gynsSN1YY0A&oe=6A3AB442"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIcxBGOLSeMQ7kNvwFovo5T&_nc_oc=Adq5dTZ_-IohAVA_ZCQ0S7e6rFFDtuh8_sok8r3QTJiSULZlYdRmElhyhf7Xnty-i6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yydwk_WpftXiD_Z1PHrVouYIdy6807dxnHdMNBPr3kQ&oe=6A3AAB67"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuIq3-3JoIwQ7kNvwEEC3NS&_nc_oc=AdrswEyzaruqWDjtvqP8bZTQ4sMjKnf-29AZhyphCrNu3T--hZY7yj2xKfF3W1dhMVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oDq_Dtmy5LHZSMCXv5rRo3Mya63ESHHz2HIOZjK3y_w&oe=6A3AB596"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sGV9GiQRkUQ7kNvwFGZwJd&_nc_oc=Adrv2s8yHKMmxKMSYn2np7XdvTuj9Qm-4vhDqjOAQLDalXBGzu6DWwNSH3g7YIK8rjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HPqhRTe0I_wCEVPcMDfNQMRhUga_tmHRWMTCwn-mAdg&oe=6A3AA3C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXQeIMLcB5EQ7kNvwHA7u-2&_nc_oc=AdrS4yIJQ_eJBAr1lq34vLTmdXIUqVVJZQRFzsEHhOC_Ci1sdYAafosTJfu-E-j_nfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l4pbGrdBph0WDflYH9M33tWkpRPVQ6p4BoG_jksTlAQ&oe=6A3AB85B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
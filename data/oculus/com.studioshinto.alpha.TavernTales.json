.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0cvY0JBKOgQ7kNvwExXsCB&_nc_oc=AdpbmRaEFCK_nTcCBDqAZF7vFmCL7pH0IixZqBmSbet77wSWwkLGitwmFwDA79L0eOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dsfkueBuha0EFhXWMNrF2MJ5Xb5pmgM4hPjLHG3uCQA&oe=69F89102"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRtsWnnTmukQ7kNvwEgWY4m&_nc_oc=Adrm-PzqmqohzHUdsfnMty2Ux5g-8hGe-GuE_59hjP5x5aICNS-WGgbW11ubqfkeWWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39RW9e-btEoMds4FzK3U3gDUfYF3coAklgyMeTXCnXtw&oe=69F88827"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ut2g0ewqXgQ7kNvwE6J4TC&_nc_oc=Adp98oe6G2eMtWVpRe_1rkA0H5VDDGzaKIPN-nwazDVWA9yrRd3Ya9ntupxwoQzldk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RlZ4uJxBkl5qzBCcmOqPrTsmqVZ3JHhgKumojBDA_GA&oe=69F89256"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR_Xig7OaG4Q7kNvwFTH79S&_nc_oc=AdrNoPf_URyf-LaGfcmapDmEe4rF9dvmYfvMTSbx2w-FpGCmnCaqnFotrEFwIaJNpNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LPgdDd6Y_2jiorRVk5EkmTtgg1jNfxYzbc1_0sYeniQ&oe=69F8B8C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slUPYeChj80Q7kNvwFvQxJg&_nc_oc=AdrnkwCmA86Z6SW6lVsKoORl68McBudwbhOFltTsAeduR6CFxhva_Y99nYdexeCEZcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HxkFI1nUiACBZEjfCZ1rL6moSv-Kc5DFzVaecAU-WAQ&oe=69F8951B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
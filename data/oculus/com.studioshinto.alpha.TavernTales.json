.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlueH_OuxhUQ7kNvwFHQtOT&_nc_oc=AdoFQXOZmprZcfohdV9yARuyAwbTQBOal3aKLgmCNaJTNgpproBYEUZSMwv_kaRH9-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z3ObPbjTMbGSdmkO9t1X90b1FNDIeLN3IBe-yxNEC2g&oe=69D8ED02"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii0bMJwkOJ0Q7kNvwEUdFg9&_nc_oc=AdqEYdIO4zbuGVeKWqnPrzXBjQgWAIrDM2Py-rhneKUX81YXCd9a8QohTnukz3_C0w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yek1-Jcb4rm5WV8jqySp-Lkqdh0NVObgJ_VAP0TY86w&oe=69D8E427"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFaMN--lXxsQ7kNvwG6z42N&_nc_oc=Adpf1LDBOg-t2E0Dicx3prQmtnTZMGFzU9CGybj9BY_BzapZGOuKmbrvWZM__G7W5rY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EO7MnB16RX_657U0leTKW-wmZsa7z5DQKBs6rYnBrGw&oe=69D8EE56"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXxR0na5G68Q7kNvwHwIq6d&_nc_oc=Adrmx7xKw3RdI1c0NaFMzdzoN_sUEizQrUd920-_2d0bTJXdnHqNOKSjeNI4mqtCxuY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XSB3Su-3H0LYPSwbD1t41WvA5znvEqGUtniJ0MS2BIw&oe=69D8DC88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jnv5tW0IGKwQ7kNvwHPkb0o&_nc_oc=Ado5CsrsBuFSnisbVfyYaWY8KUtoyHO-bi8oFD_R3KRxBzf4AzAEQiB0sW3YFiB_Ltw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dmhfPgDLvLx0K4vRVgxL9EmrEwN-U8g2WhxCs2Zn87A&oe=69D8F11B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
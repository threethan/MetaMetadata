.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT2b4eL16gUQ7kNvwEJxrnH&_nc_oc=Adq0mjHz48GfnjxzNUP-wNt2II87p3pI0OGoN1M25l6xUSG9W0vKoCdy6ftxTrSVjS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiSS95Bb1FimojOrj40WKU-575KO5u3vqxAC73FUPnzA&oe=6A4934C2"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5kUi397ju8Q7kNvwF8BUY4&_nc_oc=AdpiLkUmoXmF9VOYDVxnD4_sNAgix1dC1wNiNOiRC-rr1uv_AnF98p25AOIOtk7L4Uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW5Y01qnvmitT0vZwtjfsEbk9JLPqdjPS2dwiDeTF1Iw&oe=6A492BE7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1RG36rjzfIQ7kNvwHELZ-a&_nc_oc=AdrFf9nqdvFPdgNz6O-JdgDw7N3kg-deMaxBK1OxG7Z5WTacK-kMB8NCIiMLXzaoSNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVEjwb0B6NlFAwDMGtJJyg3CUOoMtdpDZa9K6wVy-_QQ&oe=6A48FDD6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL_X4aavlO8Q7kNvwGcnZ0z&_nc_oc=AdorN0U7e5v9btljRPyIcmDphasltkMePMen_Ew2_TeJIa-l6Ws-r5qBNuOZylcXVIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGIsWgAdz9CzsA85tOvSDg8tJP_gCmNR2A0zsNZHZM3Q&oe=6A492448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrrenNPm-RwQ7kNvwEUgRSw&_nc_oc=AdrFki53EDWkLv76ftbRwksV8YOIEXY3ljJYvFKvVfsomuHK4BwfNFST20bSY2ZVijM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALrjBegZ-AsCzOpfWgteTdrIojY1nPFFYPXooGavDQ1A&oe=6A49009B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
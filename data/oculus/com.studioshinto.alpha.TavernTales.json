.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4z5Aohep6kQ7kNvwG8T-3A&_nc_oc=Adpc0ZjeKmW1hzqDmzWVK7sa8xqwutHCi09kI7FQ9LuzpSS5bM2AW203ANxnbV8tG6M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwkve5rTSZKYBSiVKlVvA7b8SDsbhXHSKnu_6rN1sYtWg&oe=69CBBE02"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BZP4hF79QEQ7kNvwGPx9iL&_nc_oc=AdrqyMbbo-MM2WTs_vZ4gZRwJ3hubjxmEcKAMb2UpxAYiF3hjwnUDd7cD5NhbRnCf0M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNmu8VeIpnHG-VmQTPx2k353MVe0IBaQhk-OfqynQYkw&oe=69CBB527"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq9R0k3Ry08Q7kNvwF8oYU_&_nc_oc=Ado9BH2WrxCOMIywmDwmvlUkkxU1RWFD5r-OYmZzuIHNOzTMy6rZF55u8qfTxR3h0DQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxF1-Nsdil_pyNB9q2IpQgl_Riq0gvPWMvM94YsR8o8bw&oe=69CBBF56"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIvBuO0zQ7AQ7kNvwGRSGhO&_nc_oc=AdrfWZepWhEXb_VAWkj23PgmXvMtsEYI_qXD8CxsD92QTA0QXWNuv0Zt2VArvhtGS0w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1AWZZqxl63uTLGNferZkg7UTtgIVMLOxe2Eahi5F3aA&oe=69CBAD88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JApvxJS-fFEQ7kNvwFv1r6G&_nc_oc=AdqvYb76NlTkPonFoFFxOAksWUpJmYFg5MkS9cfz0bT8pHARJw7WuOhM4CbNJaLbEQ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7hBhBIIBStzUnLqyWfYAKGXBPCcJAtX7ZGTDo0hqMnA&oe=69CBC21B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-9zXoqt2XMQ7kNvwEG3v3c&_nc_oc=Adq0yCBmgPpWPpJjrUSOUTzy91aWBjUoBmkoAZuMX7qSPcRBLr8e3skifydUF1oX398&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rfgogv7WUB8fgCjliF4-vh8ccznE1xEnHx3nbDr511A&oe=6A0DA902"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP8uEBuiSwQQ7kNvwFeJzAM&_nc_oc=AdrFVH7v-Q-vubKoSOLRGCpAdyBT5xY-paPzKfIsq7nzXlTTbnpkkhB8C4ZPxd0gqjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IMZV96RuShQBMvis-aMMF5y5IXql5uetBe3AFgeyLyQ&oe=6A0DA027"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9bWhwdh2nUQ7kNvwGdb3bt&_nc_oc=Adr5lpmL2tabmQAuMRFWpstL-c-Sb_UZ6F6ZSQc-rS5NKXZhEsoe_9oq40129GD46pE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79IeKuvPfpz1C1UfRmlMOlGzxut7wPVMYShOWrh4WQ7g&oe=6A0DAA56"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt897EY4EQUQ7kNvwH4Yn-m&_nc_oc=AdpApQzRnkWjQNdcMFaUUZu2c5Ea8k9W5sQnThR5IuBm1BYQhCioA4K7yWj2cLU_0gM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wTBjyZtTopEku-F7Y99LOQTH6w7sTdH2YV7XzNY34jg&oe=6A0DD0C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQHzC_l-768Q7kNvwE4zZ_A&_nc_oc=AdptJUjhtI2pGgRyCUWxPs3kGbtWKZozYCrzyw35clMS_mEp4_oV71qJshKy-IPe7qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4quDTpe0MAmH_0eFBiDCqKSAoyp7qxPgtLpRL0mTb1yQ&oe=6A0DAD1B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY0g45fveZsQ7kNvwH86uoc&_nc_oc=Adr93gxHFc46ibhZEA7BIgt3qdLykjTgoxrQ8rJesHalqPD-BMbJZW57JvJDqZPJFFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CNIrsPzh3M6Fpy-0R11mcWE5ihSRSPxZQ_37Xk_cs-A&oe=6A086302"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvgZPnWPdgQQ7kNvwF6zPun&_nc_oc=Adofv1xddlkQloF7DQu1RHA3vnQJXJE5DPHT_vvxbZwGrmIJ6e6qjEvHZ7Hs4d7LnAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QQJn-4aycknrXTAQYB9_pgZmmwGkKhj9ur3Q5DB94eA&oe=6A089267"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LErt17BxqpgQ7kNvwFkoPfa&_nc_oc=Adrt_JAqnyA0W7un-90J4A9wpkniK1F9luFCNe7llhcayUmYGzDT534ssRWFRjMlvi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kNBI8yr4lUKxxEiZk0k9wFjaDmKfH4qffJFFo5zo9KQ&oe=6A086456"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgxWfsXOEc8Q7kNvwHoAW-a&_nc_oc=AdoBD-pWtozC_80D0MVrbTHccYXjRaVmr9Khq8mJ1RPe7tQoXU4rHqgoqu6fd6p5FcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40NRFJly4--055DnV9CN1dy9zWtkrwRwFTF_Ojg7qfUg&oe=6A088AC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgwZHxfUL08Q7kNvwGpptp6&_nc_oc=AdriZePVIjKOaNejO-XmjVKYioIW2ntG7YLbY-IxfQaLi70H3BZ8CgW7xgXF8J63sG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51PP1p1twcCyKG0lWToH8-RF9Y_hCvKGxUDU4ZOO6ecQ&oe=6A08671B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
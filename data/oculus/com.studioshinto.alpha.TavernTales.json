.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19XbaSUHiPcQ7kNvwGNZ79J&_nc_oc=Adp8S_8smmbMn_usEnyMGL0RwVI1r6ETCcyQljBFz1IQ5EjQv1VwDnM1E1OSD5b4EVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgE7nXM8at91D3Wo5-DSiuRwMWbt3t0hoZdqaiLhEjjg&oe=69C28382"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzG-Ti0hj1cQ7kNvwFCuZcI&_nc_oc=AdoIj15fojBbSJ55RfWdKcjerh3vVLix10M04WmOz5H7u6k9fVrNCVHrQxvok3UEzRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcAATAeLHNHQoHZJ2WdkKi8MKVe3G4HGeyF5DkU14cKg&oe=69C27AA7"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8f92zZN5TMQ7kNvwFHS_un&_nc_oc=Adoomk7iYUEQ4LZ82YKLgMEoaJsmgNRtDbPR0hLE3WRnyQimjfzTOMmUfnYjil3pOVM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZob0ZiPICr0ry_6U_mNkSfklNnYuw9j3c-sLjQ7YrEg&oe=69C284D6"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwgOSuER9EIQ7kNvwFWu0GN&_nc_oc=AdptlIe9lZ73P-TrAgqlRfAWV2-7B62AEWu2WWcvY8FRJVp8x0Tl9ydnAoVJUct0b_k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAoWFQGf1VaK4BUM4m4Q7iiOe8gnTobEOI-wp8vbH56g&oe=69C27308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuXpQWR2pqgQ7kNvwGGEjjO&_nc_oc=AdoC5Eydrk5UtV1nYtiIUYqwOiBJTxrd_jO7Bfu1JA27QBi0ZjIrZuSvj082ID6ZZGc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqsJKR9trdyexr6PI_IqbgjYh-nSZ1S1MfCCEqXrn5ew&oe=69C2879B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y-_KB3vHDgQ7kNvwG_GUAm&_nc_oc=Ado23QCe5rouSF_o01BSMFlREgkbNn2Fi3iS6MulAnEThJhb2Dtt-7RS6YbDZrGO6Os&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af349lkFOOdM11VCdWJghai0ooDXZlEfEyKA9efH_2jd_A&oe=69DB9002"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax5zDppCsggQ7kNvwFHA_5-&_nc_oc=Adqn26EN1lB1N9MDn5XYU-407h1ryO-ExQQI8FVkNIikGzXn7hxskesTOmu60k6yxnc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0STd3yHrrFdJDUDyG-Kmj9AqSCCV-kACb3OOlKnq2AEA&oe=69DB8727"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-2gtIKp8yoQ7kNvwHRI_TR&_nc_oc=AdoP5He9Ifw6zAsGZB9nw1tBOs3_E5cuxG_WFT0-D-ZpWMZT2VJvU4rBVJuFMy-fuRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cruCc5zzmmwguhT6_wJaQNVXkqMD9KP-Rfq6Uxo5vWg&oe=69DB9156"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8azfnf9W3AQ7kNvwGgbRn5&_nc_oc=Adr4QGLZwVNqbex9tblNfiTr7axJTsxLvKOF10IKPhbcecLU2AlJj92FNlfgzvieudo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YUMtGhuF5v1GB96oAjDYgFFDqD2Er1O8ikn0tiTWp_g&oe=69DB7F88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52WCwhpaUrUQ7kNvwEKtgWV&_nc_oc=Adr2Nr7OVYuhRdfuIefqvSpBlRWvI4Sfj0G_0ovoRmkSSdb2uE5_cJ5hW-Pp-YdijXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qCjnPC1Ij5-8SNvzZxXJLkBgkzeOJUDyG7P3FOktcKg&oe=69DB941B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
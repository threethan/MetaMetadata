.5771-25/75251818_806912099932903_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFdx908RwCUQ7kNvwHnB8AT&_nc_oc=AdpwI6DSd7ez1NgNPzvwJjIhnHu9tIGrwhx8iKsraOzBrY2df1wE6JgvwiwT8hMLLx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytdOO6VeyfCFzj4wrEva5FEK3aBi5ogfgBJpQU-mub7w&oe=69CE6102"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BZP4hF79QEQ7kNvwFTH1yF&_nc_oc=AdoKcpn7WHtOF-PIuxL0xObT2jhvge6ae1U27L-ifowpWsCX0Kh77Pj2u11GgbSfTvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydDt6cJGJOMIDJhkng3kS3KNjBern4tkjUlyN7m9hbjA&oe=69CE5827"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njOMXru7fyoQ7kNvwFe_OVT&_nc_oc=AdqFFvdr9j3LkN6oQAp16-3SSXFmoqPz5M1dYO17LK9xHtZdezRhVDxJj5ghMStuZCw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5Fgj00bNMsnR1SQP2NjEIvhAT4ke0MRPfkxS13kGC3g&oe=69CE6256"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy2xxRelk8oQ7kNvwF3i3FH&_nc_oc=AdorZm5163G9fgLDFvtKh1YfDKFkeSVoC53-j-gPE9rbStIjV1zdL4NMQkXxSS-cw-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFBGy1zlh_MeK_XKhsJ-4IME1Bjr5lPqwy8Bv-PKbXGQ&oe=69CE5088"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JApvxJS-fFEQ7kNvwEspGyC&_nc_oc=AdqCO8ieh8O1pmyzOZedmFBM6yRFK8nFdLF-BPs3FGqICkg16bd2TLBE5xBqXiuXsn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUdThQCthKnWrvVKwGwMAS9Pe8CC4P7ydfTaOsQgRBTA&oe=69CE651B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_i
3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7ddjarvmc0Q7kNvwFiqnYC&_nc_oc=AdkdOsHGJ5ZvGfKF9gOPqTtoG1U1tHOska3W7WPgIdeJj-2-S-Y6Po4-_abmG4MsWMU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy56QAWGtSWj4oot4GYHYfgeKg8TZVMyxQPBoBL7xi2Lw&oe=69BBEC02"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Iq97UPpY9YQ7kNvwHiRO9A&_nc_oc=Adk3lmWsnDi2TJFKQWUDq11BgspTFrin9qKtmUhc_xdhXirnEKfwlozioMNtVCYHYjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwoLf71_ZlsVw430OupIOPks6WSf_TeEohyHLcNqk6Ngw&oe=69BBE327"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0bvG67YZFEQ7kNvwFGRZ9I&_nc_oc=AdlKp00OSWHix1VxCUElFXNLYI3GO27Ve96KRBs9DbiYmvKbSRnyvME-7mUqPaxrDkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzmNlVJeVeIFN1p2B9Z3WWm1-nMDJOcdOmf2VDHPUVO-A&oe=69BBED56"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsVDQhrIpX0Q7kNvwHrpwlZ&_nc_oc=AdnhbeVeIldmUC6cx5MMELqZNU2pNIItWO_RBj8UyaCRBmcEPF1X2m9lrqKTiqIQmPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSb4HC6c5rY4fqdkXTc-XUFVXYU3TPP0dMDrq0bP-rIw&oe=69BBDB88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3AJUcfYcAIQ7kNvwGLdvbz&_nc_oc=AdndQY7pkfS0MgOmTwOsFhHDN3Y7stapXZguVdKfJ-zHE_4mTXEgJsAMTf0VuZXdTl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLVbEIUyquhPC_aFcfz9V2P2JuyJ-S4fBBwpSXjRN59Q&oe=69BBF01B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
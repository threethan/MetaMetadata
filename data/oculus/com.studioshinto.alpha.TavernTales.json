3_5153277802903495009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjWFzc-PylgQ7kNvwEcEQLI&_nc_oc=AdnVAM1u_woaLTzWO3E953oqm2NbHXvOkIKvCdqbtzyXEqyew87j0k8Jj5NqEv5C6lo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfweROCbJIWcRQ6DCqYkHv4qlIj0yupl3dTaEEQV02WFjg&oe=69AC1A02"}, {"file_name": "Screenshot3.png", "id": "179708467242436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617324_179708470575769_7498630158311757832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60pbMWXyfVUQ7kNvwE4omuy&_nc_oc=AdlPjmSnijzOrlu3X0jwCUI3YiPro30S47n76EfQiDS8RC5You-Scl5zHc9TLnR_0EE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy35EQ-aL13dRNF0khzG5QQCSI8_zuILR2HMD3ZmehPNw&oe=69AC1127"}, {"file_name": "Screenshot2.png", "id": "176701894229704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371509_176701897563037_343443106582238715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVB3wgsoAVQQ7kNvwH-1oMG&_nc_oc=AdnLZBKA4_Xm4YL4cCYaEf-yS-_iPZu9Eqfi2hqxLtFms23tNPLFq_-kOOPni8hMFnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyCNGTjTNnj_l7a2rHy8b_DDIY-J4O7BRPdcvW7d5rTA&oe=69AC1B56"}, {"file_name": "Screenshot4.png", "id": "457542562258245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221325_457542565591578_7079526994172252867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NktnmUiG5MoQ7kNvwH4csGR&_nc_oc=Adlqhv7qK6VYZGh4K6NVRaeQQAbkfoOss9RxZy2GoUfhMnBVLISR5XpRK315le610Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEkJZ3k9tKjdCSngrYAGH4vDbauHf0IvjKZTeDKgf8gg&oe=69AC0988"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Oculus only.png", "id": "787924701810211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_787924705143544_3583679679812245852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xe4bLS5ktcQ7kNvwGbw_aw&_nc_oc=Adnb-zGnH50FOu6wkCamD2o1LPejEOd6glIhOYTz14gwoX-lOI9ALK9fC4pXS206n50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTcYmjiiMUjhQTvFiOgBEJU0VkG6BSy31pJm3QuB60Aw&oe=69AC1E1B"}, "display_name": "Tavern Tales: Tabletop Adventures - Demo", "keywords": [], "long_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other.\n\nJump into your own personal tavern that\u2019s stocked to the rafters with all the miniatures, dungeon tiles, scenery, and set pieces you could ever want. Take a break from the story over a round of ale, or have mug stacking competition. Use a range of tools that make building and maintaining your world take minutes, not hours, and most importantly - get lost in your very own fantasy world.\n\nCome together, role dice, slay goblins, and tell stories that live and breath like you do.", "short_description": "Tavern Tales: Tabletop Adventures is every tabletop enthusiast's pipedream made manifest. It gives you all the things that you know and love about traditional tabletop games, as well as giving both players and DMs tools that couldn't possibly exist in the real world - creating an immersive online TRPG experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://TavernTalesGame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Shinto", "support_website_url": null, "website_url": "https://TavernTalesGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "1676485315806614"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["NARRATIVE", "RPG", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
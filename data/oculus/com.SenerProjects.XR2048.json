25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHeaPnvhJIgQ7kNvwHrOO9K&_nc_oc=AdnHS4aTO4subOfeO4gIJ3B14JSSwsTMxs4ccIpE6t9HWA4L31DPP6JzpwX3PoewMmo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmtK9YSY81dklsJ96spFAB4ryA9CyhEOPLcYjlkrLz_g&oe=69BD4183"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NnNcxuxmIkQ7kNvwFfXTjo&_nc_oc=AdnaTO9QWCsuEYzruz511f3NViIEygm-q5FOkkGloP6l6Ojk2eXX-kOZP46n5hdfb8s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWIWut0_yud8Q6YpXLwbXuoo2GVw0tt8jV5TS35Nq5Xg&oe=69BD2E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsmfFOvCkbkQ7kNvwH5er4w&_nc_oc=AdkoiI9L2yNIS_sVS5INm4esmBgQukB9y9Mp23CQ0IgKv2uV0GAegi8UsRyHm7oorQI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOOHvpQJA0xMy32lAEEzAOY5MX9DDjmjwIK5QnhLROqA&oe=69BD2D09"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli", "short_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps."}]},
d3-1.oculuscdn.com&oh=00_AfvxmRqEKf80prOky7dWBV_owtJqGLhcAvxKNYDwzQSHqA&oe=69A025A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1473879850826043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_1473879854159376_7814216358026304934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poN9moxE23YQ7kNvwH4NLzZ&_nc_oc=AdnAXD-Epq0VziK87OKwUeOhET_PNTAvbaS-u5QDiCeYWWhuCQYtqOTbn_emi8nQnZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTQ2zZlvtU6VIIDzmTj3E2RZYjImzG-8ezrAu2Y4IBDg&oe=69A03B09"}, "display_name": "2048 RPG", "keywords": [], "long_description": "Play 2 games in one app.\n\nRole Play Mode (2048 RPG):\nMerge blocks to create attack points. Then use it to defeat powerful creatures. But be careful they are getting stronger each wave. So you need to upgrade yourself. There is no end in this challenge.\n\nNormal 2048 Mode:\nMerge blocks to make points. Your goal is reaching best score as possible as you can.\n----------------------------------------------------------------------------\nQuest Edition :\nNo in app purchases and ads.\n----------------------------------------------------------------------------\n* 2048 is originally created by Gabriele Cirulli\n* Characters designed by Burak Ozturk\n* Developed by Sener Projects\n* Music and SFX provided by SwishSwoosh and LordStirling", "short_description": "Brand new 2048 experience with RPG features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-quest-privacy-policy", "developer_terms_of_service_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-mobile-terms-of-service", "publisher_name": "Sener Projects", "support_website_url": "https://www.senerprojects.com/support", "website_url": "https://www.senerprojects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category
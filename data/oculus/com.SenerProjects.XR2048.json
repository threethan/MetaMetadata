cdn.com&_nc_ss=7f20f&oh=00_AQAmkhe-zB5XjjBVRKSP9j_a86bEekdVXwlNod7CFtRiTg&oe=6A5F7B62"}, {"file_name": "ScreenShot 4.png", "id": "798578206679811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZAia3pecFcQ7kNvwEnyVL-&_nc_oc=AdrfbjsfMw8roF41-abMh6H-kfuiBtDM7hnTOd2EYW1u2ovR4IoclJkTSPpQS46o6Pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6SqvmLtwrMbvtVuUKEuUJr73D2QnEb3HKlObO4hMh-Q&oe=6A5F6A03"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlI864m22wkQ7kNvwH20oI5&_nc_oc=Adr9vAEYsdvZTGIk4GViroOo4cSlcxm_skCEp0oU4Ze01uhDRqx8_DYSJ9gS4cq8tqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtPVfVrzl-l3SUXmEr-lg8qRu7ozjnjuKMR2f58u1-0A&oe=6A5F56D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZQFbzV1_QgQ7kNvwF5HTv8&_nc_oc=Adqaw9clTplAQr44pyrX_jPyV2AfVDzpKVX_eKs9ZeH-y3sTjK3-yd-5mgMvf3-nous&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcVN0fxrhgf2iIuYjH15V3taStUuNbCFVhfErJGt1TUg&oe=6A5F5589"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli
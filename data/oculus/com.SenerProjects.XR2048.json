n.com/v/t64.5771-25/491823783_1457333422487799_9202308343086393095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ver6PT36w9sQ7kNvwHfa6X3&_nc_oc=AdpjC4ijr5zsC6kAAcvJQ7DeOZZawKHmAPgXN2OHue0HqIhUjwVyTTJUVuDUHGjIkRU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXYvEE2kPpXuMFnIo8-Oj5SUc6GzAv8xdahYylgvOnkg&oe=6A882DA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1473879850826043", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819982_1473879854159376_7814216358026304934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qvr0vPLj2YQ7kNvwEvbXVw&_nc_oc=AdrObq_NjFgosz_ZSrMSHVIMvmLO81oZR3FHD4Qr-xJ4_lRH5QXxpV0PE2qJ8g-bJos&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkG6AhK2tWrFguHYkBLws3XW5m3CMAPOH0_jdv4r6WHQ&oe=6A884309"}, "display_name": "2048 RPG", "keywords": [], "long_description": "Play 2 games in one app.\n\nRole Play Mode (2048 RPG):\nMerge blocks to create attack points. Then use it to defeat powerful creatures. But be careful they are getting stronger each wave. So you need to upgrade yourself. There is no end in this challenge.\n\nNormal 2048 Mode:\nMerge blocks to make points. Your goal is reaching best score as possible as you can.\n----------------------------------------------------------------------------\nQuest Edition :\nNo in app purchases and ads.\n----------------------------------------------------------------------------\n* 2048 is originally created by Gabriele Cirulli\n* Characters designed by Burak Ozturk\n* Developed by Sener Projects\n* Music and SFX provided by SwishSwoosh and LordStirling", "short_description": "Brand new 2048 experience with RPG features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-quest-privacy-policy", "developer_terms_of_service_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-mobile-terms-of-service", "publisher_name": "Sener 
25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfV_GnYoxdIQ7kNvwGOZucH&_nc_oc=Adkm7gEQ6luRFKo_Pcie0mLBqHPXt-oLNPEbneOJt7Pje9DMoew829bc4qekejE6O6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzHfAyzmqa6Igbgv44V_BE0551ObsRUC_1BtfWpU5qB7g&oe=69B94D03"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YOj_basQl0Q7kNvwH4N9Uy&_nc_oc=Adld7p6BeWFFP1EUmld7tLwsfmk-ofYf-FzyDCwCOY4c-AxSM_Waq6Vq4FGmHnOy3Pk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5Wp54BwN6Shnia4vYlaZ4iIUdLiOvuifAHBnYv9SKdw&oe=69B939D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAs9wKzL8M4Q7kNvwEiPtec&_nc_oc=AdmSMtJXKkbDmBgDLZE3yB_vYPRASKkjwE4tM8Ons3O7Rwtm0Ne-Avrqo3T2DHsQUAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwSPoPDPBupzg1UjHCUEyxZZPWNtCqnolVretq-_VxZ-w&oe=69B93889"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli", "short_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps."}]},
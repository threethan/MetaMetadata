25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG5vejijCEsQ7kNvwEo_xG4&_nc_oc=AdkN7_OYZdNJLp0W_E53r8mWgnWzMx5ETtXwfty1IPsYPOC06KAkVDDpXR5p2ahl_B8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx9mg21PSSvKQ5qo8ad1B2Qdh_vTvzPSM8XJ2PD05Diw&oe=69BE9303"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdSehyxH4IYQ7kNvwHktLE9&_nc_oc=AdnlQ_n7d_zOd6lW4Vc9rKvXDZiqEBnvRM0x0bwa9E4PhATJ9TlBDmmwx5p6ZYDHboM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAHqBwloshUu1gnfoxzhoewlOQvKNmQIh86u792lv6Rg&oe=69BE7FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsmfFOvCkbkQ7kNvwGFOQ2u&_nc_oc=AdnM0i8yhWfuUetdneZ22C5U8JaX9nYkO3SC4vcLSwZSWoEsiodnZGLQuJ8QAOIWxOY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzetAzrOdiTN6wTgYQ5V8iAIk2bg6gf4LojW94LiZXjXA&oe=69BE7E89"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli", "short_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps."}]},
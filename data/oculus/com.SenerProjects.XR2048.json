cdn.com&_nc_ss=7f20f&oh=00_AQCsk_0WpAvrG9_gjp24bvwc0sMvcAiZnwvRqkcSTWglxg&oe=6A5640E2"}, {"file_name": "ScreenShot 4.png", "id": "798578206679811", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxsrt2xRDLoQ7kNvwH_-dmp&_nc_oc=AdqMwKwNlUqWfc8msWsxp4slSW6ff378tOaBesut_4eWt7dV6JQbnDx8cafEAnf5mj0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbFs4AazsHbayyBnY6NqOsnH09o4HG42BPkic8YQX6KA&oe=6A562F83"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUYdm6d2bmIQ7kNvwHrPh4L&_nc_oc=AdoEmOcucvRG1mgwAulANPUzUDmfUayfrKcg9HzmqpH59QABbe-1Hd8xALiXKazrJY8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnz2Ml_MB-iH1dRJJOS6gejdFaqpgasxxXreEV1ijUyQ&oe=6A565493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Ia-Jtj6QYQ7kNvwGj7sPe&_nc_oc=AdrI_Z3Tr9spRmiBaIb9S7AZ0geaxgGiLbl7g5mpncjsxlf6MxysuTLwnfBwidZxk7I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBo0I8KZECzIAX8LGxI7EfNac3cxxpfjlbCZe2HoFgmQ&oe=6A565349"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli
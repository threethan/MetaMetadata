gaomJdK1DYrf9nR7LpXExtrs0dO3wEMWhMQT_2s60MiDSUoxYZnFiBwoXsm5Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6YuPO0rOMnfsHBCaNxrINCXXK5cxHnECb0x71cl-cdQ&oe=69AAB1A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1473879850826043", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819982_1473879854159376_7814216358026304934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK1u3e0v-zUQ7kNvwGnlEhb&_nc_oc=AdkU-_QApH8sWs-O402jJlpSNxQoKJ5ujWz33_HKbtejJalM4iXS9l37rAjMGMcrVKo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7FdLSJnfuAAYH-7-HzD3yR2XMElmrC_5W4bDRie6BlQ&oe=69AAC709"}, "display_name": "2048 RPG", "keywords": [], "long_description": "Play 2 games in one app.\n\nRole Play Mode (2048 RPG):\nMerge blocks to create attack points. Then use it to defeat powerful creatures. But be careful they are getting stronger each wave. So you need to upgrade yourself. There is no end in this challenge.\n\nNormal 2048 Mode:\nMerge blocks to make points. Your goal is reaching best score as possible as you can.\n----------------------------------------------------------------------------\nQuest Edition :\nNo in app purchases and ads.\n----------------------------------------------------------------------------\n* 2048 is originally created by Gabriele Cirulli\n* Characters designed by Burak Ozturk\n* Developed by Sener Projects\n* Music and SFX provided by SwishSwoosh and LordStirling", "short_description": "Brand new 2048 experience with RPG features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-quest-privacy-policy", "developer_terms_of_service_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-mobile-terms-of-service", "publisher_name": "Sener Projects", "support_website_url": "https://www.senerprojects.com/support", "website_url": "https://www.senerprojects.com/", "category": null, "comfort_rating":
0wQ7kNvwFwgdus&_nc_oc=Adqe9Hw9O-p636g74MUBUs-xTx_FOTRjJmtpcrvZRoi0Vgi90exNfZ1xde_f7Np6LJQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af409qEHqBfczY_6nWIV89t-NkJnZ1R2P0FOOl3wUopV7A&oe=6A1AF963"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1473879850826043", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819982_1473879854159376_7814216358026304934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CNqdzwJzdUQ7kNvwFu6FFg&_nc_oc=AdoxKiwJ-iKKh5V90Cc3OrkvYj2Qhp40lyJHeB9NiVOskJQP2OKLP5FwYYITHrUcwbg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79proQpR71ukFfGUWhDAkQE5fOb2FtjZTTiyAl5EKChQ&oe=6A1AD689"}, "display_name": "2048 RPG", "keywords": [], "long_description": "Play 2 games in one app.\n\nRole Play Mode (2048 RPG):\nMerge blocks to create attack points. Then use it to defeat powerful creatures. But be careful they are getting stronger each wave. So you need to upgrade yourself. There is no end in this challenge.\n\nNormal 2048 Mode:\nMerge blocks to make points. Your goal is reaching best score as possible as you can.\n----------------------------------------------------------------------------\nQuest Edition :\nNo in app purchases and ads.\n----------------------------------------------------------------------------\n* 2048 is originally created by Gabriele Cirulli\n* Characters designed by Burak Ozturk\n* Developed by Sener Projects\n* Music and SFX provided by SwishSwoosh and LordStirling", "short_description": "Brand new 2048 experience with RPG features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-quest-privacy-policy", "developer_terms_of_service_url": "https://www.senerprojects.com/games/2048-rpg/2048-rpg-mobile-terms-of-service", "publisher_name": "Sener Projects", "support_website_url": "https://www.senerprojects.com/support", "website_url": "https://www.senerprojects.com/", "
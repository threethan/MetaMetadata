25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0J6aad8rnAQ7kNvwG-IqXh&_nc_oc=AdnNbRT67L25oOgoLOpcY5LxZPk6ZO36Z-2dCW1OO2E-bzw5_hlG-q48Ymu46A4KgWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfRZDNmpEpsvIt1HpanX0TDBowtM5gycJtBdS5MYj3vA&oe=69B2B583"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZE8Fm3OwG8Q7kNvwFJfBOX&_nc_oc=AdmzzjxgjVb3uuHQ15lhV_0rSkMSQ7x3iJqN5cRa_MEwIKHpct2Vk8DJtNQLKrBSDAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEd3kSNcYkcuXd8-8V_kHAOo4GKRCCinn4VcEmUZXdKg&oe=69B2A253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9Syi85iUucQ7kNvwEIjMou&_nc_oc=Adkfdi4b8fUtP7fXU6osDppz3IqRlUEq8Hv6NRtPGZqdt9WP_txURsF9xlylNWB17sk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxDfm2rUBXBcwm_c4P8s66n8d4nZHN23Odcckm-aMqQWQ&oe=69B2A109"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli", "short_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps."}]},
cdn.com&_nc_ss=7f20f&oh=00_AQFHlUGn_bpEtwZuLYXZqkPcTF9lFrGhraXB3e15ghq0eg&oe=6A7341E2"}, {"file_name": "ScreenShot 4.png", "id": "798578206679811", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgNt67r2rwcQ7kNvwFMTT5F&_nc_oc=AdohZd2QsO5EaARzznta8ZiKhi7p8e4VKO91YGssEZ6g9RNpYu4WDGrgS3giTwLyMec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErNg1nVFPXqVHAWPx-CItvWcEx-tdNCeZEdL693_JtVw&oe=6A733083"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EffQCne2H58Q7kNvwElKi3u&_nc_oc=AdrPIBF0uKbkfFsnjMIh690MDMewLRf1TR6I7776BE0nYkaj9taWJYpm5eJBqHYhczA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwDsNJDfUsvKq2vYf_vj5OzjAD0DhHiVHSb-XMbyaE_g&oe=6A735593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPxYJbbxQdAQ7kNvwEPDVhh&_nc_oc=AdqC_BAtznrBrb-u5yM5RSbyKT3FhxB3UZkPazkAf5r8ZQ-J5CFGOvuplbAvPYTXCx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrW5a5YB_hudtVRqlqoDemUVHiGK8ppj43V-E9Xn-aOQ&oe=6A735449"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli
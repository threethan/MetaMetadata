25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0J6aad8rnAQ7kNvwGfdvj1&_nc_oc=Adk19rs1Mc3vjuII9vHY07lRgnPn3ij_pd3Co3LzOfmoa43zuCe_T1AG97F3H1JOcw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxqLiqOeucVQWo17_jf1Gm2zwh_efZvRVkkYCPJq3n6Uw&oe=69B40703"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZE8Fm3OwG8Q7kNvwE-UcjH&_nc_oc=Adk7JbOoYx9YRJcoLI96suJJQrj2aDr-qt2ebE5_KIPxFzFehgIevw9icjQ45TAGCYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfySJErRhxcYUNovMjrHNAkO9IHBMi9TPHAROixUH_xJtw&oe=69B3F3D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9Syi85iUucQ7kNvwFx3pQB&_nc_oc=AdnOz2eMEPUScPG4lKQEXX2j_5i5Q11uUvfIsF6o7uNj3cbU9osfgdXLkcpgVolIkjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfznSMaqRRJ_xQHyYz9I8_mxa49X303sJVf2VVVXaHPOSA&oe=69B3F289"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli", "short_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps."}]},
25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHeaPnvhJIgQ7kNvwGYIqGj&_nc_oc=AdlJiFEq6Czexduj9y3oFgvupVdLW29uUwm-iEKkgJ8IAU6I5i9XPawT5Q1LJqcj0YY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwO2AS9rWcyLzl9kgN_s1eXhpsNORfdmNMyAGIdjZwI1A&oe=69BBF003"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NnNcxuxmIkQ7kNvwFDUav8&_nc_oc=Adn6KR_uG8IevW0frplYk9Cfyz0R1QQqcFy4xW1qF5Q-IXrDHy4x3ljHamiQTI_CwOI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzejn7H-YlnYmXrtoLM6Lv5O3Xkkwj5X_LHhjBIxWcKpA&oe=69BBDCD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAs9wKzL8M4Q7kNvwFXTZlk&_nc_oc=AdnA4mxMYIB0MbUq6MQi-NATWoolFVgyfE4FC6BGnZnN_av7dKBmk_9HRRlNjRF7IFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8ytXlPudzVzWRScqUqkqwcuDodKBsk5GSn6cWMoF5ww&oe=69BBDB89"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli", "short_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps."}]},
25/499307954_798578210013144_4844458764880885292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0J6aad8rnAQ7kNvwGNyZuP&_nc_oc=AdnLk62PkOx-sqfmMucksIU34FKJMQN3gzleK-IZm_b2fiueZeHTOkAsKH6r-VrztCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfqLtU3j39vA3W1ArK_knPHhjhgydREcojnPQANSNJOg&oe=69B55883"}, {"file_name": "ScreenShot 5.png", "id": "3006863286164696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820219_3006863289498029_2573931090928274614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZE8Fm3OwG8Q7kNvwGxLO78&_nc_oc=AdlNCZBWualo9pnnD90pWsFuaV-o2f8Qi44pvd0v1B6GD3fipbtNp7HZxcWjp5B4wA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJaPm53yKbj8YDASDWfzOSYDeFF2gkPtG4lIu77PHvSg&oe=69B54553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1902893750276744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308575_1902893756943410_8062574031436074106_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hgq3H8s2pgQ7kNvwG5mUdD&_nc_oc=AdkkaUI-UJKy5ao0pIIcWpY7_etGDCNvhaMDIXxFMJEhcSTnFdciDOGdoMeouOmA2fE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6JHGWsrWTdAx9iRAhejF05_hB199R4oTJWWEkq0tAOw&oe=69B54409"}, "display_name": "2048 XR", "keywords": [], "long_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps.\n\n2048 XR is basic block merging game, just simply swipe and reach the highest score.\n\nYou can use your hands or Touch Controller (Meta Quest Controller) to play.\n\nGame screen is resizable, just simply drag from corners.\n\n* 2048 is originally created by Gabriele Cirulli", "short_description": "Do you want to play simple comfy game while doing anything else with your Quest Headset ?\n\nWell you are lucky because you can play in windowed mode and multitask with any windowed apps."}]},
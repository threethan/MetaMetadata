 Massagesitzauflage und erlebe verschiedene Massagetechniken wie Shaitsu-, Roll- und Klopfmassage w\u00e4hrend Du in der virtuellen Realit\u00e4t Reisen an Str\u00e4nde, W\u00e4lder und Berge unternimmst.\n\nHyperience setzt eine kompatible Massage-Sitzauflage und VR-Headset voraus. Mehr Informationen findest Du unter Hyperience.com", "short_description": "Trete ein in bisher nie dagewesene Welten der Entspannung und Meditation"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medisana.de/DSE_HyperienceApp_EN.html", "developer_terms_of_service_url": "https://www.medisana.com/en/Terms/", "publisher_name": "Medisana GmbH", "support_website_url": null, "website_url": "http://www.medisana.de/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "RELAXATION_MEDITATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "484439306366406"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2242654779118986", "version": "1.6.4"}, "id": "1774080606007939", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1935956886455445", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "
.com&_nc_ss=7f20f&oh=00_AQCgGCast0dwzCDLpmSkJISs0hi6BFtd9QgWIUtG9xAfvg&oe=6A61FF32"}, {"file_name": "theFinalExperimentScreenshot4.png", "id": "2304986056685007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299928_2304986060018340_3121498426383869536_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdMB9Yique0Q7kNvwGHXZdV&_nc_oc=AdreSKX1r64EM9Unxvjy3IlWz84-YCFTSaxx_R-Qd1Ee7xh_ZlLxEOxsEZy_V9cDS6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9_-dFH1Y70DNRCoWXQRr34wneYqrPq_iXnf7xplKNog&oe=6A621B33"}, {"file_name": "theFinalExperimentScreenshot2.png", "id": "1774517626503285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292232_1774517629836618_3378264543415465106_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQKznqoL9UYQ7kNvwEVXyBo&_nc_oc=AdoTd0lA1gyB1EWqj_hm0nnRl-35IRUo7SX21xIwdlg6YiKobJ3weaOelqh4nTBmezA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN7RqP9YDW6IJaXyeDVuovDQbDk-Sl9TGDe4WgTIkOmg&oe=6A62230B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Final Experiment", "keywords": [], "long_description": "The doors slam shut. The alarms wail. And then it hits you: the thing hunting you isn\u2019t just a monster\u2014\nit used to be your friend.\n\nThe Final Experiment is a high-intensity, asymmetric VR horror where survival is never guaranteed and laughter mixes with terror. One player becomes the failed mutation, a nightmare of claws and fury. Everyone else? Just terrified survivors, scrambling to outwit and outpace the inevitable.\n\nAs a survivor, you\u2019ll fling yourself down collapsing corridors, swing across cavernous hangars with your grappling hook, and climb higher and faster than you thought possible. Gorilla locomotion turns every escape into a sweaty, heart-pounding sprint. Every second counts. Every wrong turn could be your last.\n\nAs the monster, you are the chaos. Feel the rush as you stalk, lunge, and tear through your friends. Play with their fear. Make them scream. Make them run. And when they think they\u2019re safe\u2014prove them wrong.\n\nNo two matches are the same. Some end in frantic teamwork. Others in betrayal. But all end in screams and laughter echoing through the cold, flickering halls of the station.\n\nThe Final Experiment isn\u2019t just a game. It\u2019s a test of reflexes, trust, and friendships under fire. Who escapes, who betrays, and who becomes the nightmare? The experiment has begun.", "short_description": "You\u2019re trapped in a dying space station with your friends\u2026 except one of them isn\u2019t your friend anymore. They\u2019re the experiment. Swing, climb, and launch yourself across corridors as you flee for your life\u2014or unleash chaos as the monster. In The Final Experiment, every scream, every betrayal, and every desperate grapple is part of the story."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thefinalexperimentprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://thefinalexperimentprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26113644748223126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.ocul
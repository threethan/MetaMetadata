20111316317335_5986702760995292565_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4jjdiXJ3ZgQ7kNvwFATavu&_nc_oc=AdrMBAlqWhql86Uw2xJrw_he8npnQnCrpnxmBi9BmSc8KRoNYp9x5UbkhoqKVNvrL9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgcKwmk0i85t-7ynngmTRNx83Q6xxqtvKLTq7Sb61p7g&oe=6B085742"}, {"file_name": "screenshot_4.png", "id": "1132217192704320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499295279_1132217199370986_6520583299577137183_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xb96_FTTwYQQ7kNvwGogacs&_nc_oc=Adq77waztsCMARY_9lLFhvcebyyIfv0Sir7mjhnbaqjfCiqO4cEcLEhfK7rXdfwl5KA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjbmEBFYoY7QiNIVBC2MwGTJ2p7yE_DmEKcZpvvv0vxA&oe=6B086BBA"}, {"file_name": "screenshot_5.png", "id": "1117530874161347", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298150_1117530877494680_8090737054845096934_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MFqrYj3IxkQ7kNvwG8r84n&_nc_oc=Adr7en9Y8-nvVYYgzqoMyzC_dKpuFlo_eMRzdNVNQv8Dgol-XRU5saEOZrPYsvgLCqI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDkNkd82zhxPOFV5GHt2ZFbEl9xR5Apx5v2y2TzvQ5Mw&oe=6B08502B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simulador de Endoscopia VR", "keywords": ["endoscopy", "endoscopia", "colonoscopy", "gastroenterology", "simulation"], "long_description": "Un simulador de realidad virtual dise\u00f1ado para que estudiantes de medicina, residentes y profesionales en formaci\u00f3n entrenen las destrezas de navegaci\u00f3n endosc\u00f3pica en un entorno seguro, repetible y sin riesgo para pacientes.\n\nRecorre el tracto digestivo desde la perspectiva del endoscopio y practica los dos procedimientos m\u00e1s comunes: endoscopia digestiva alta y colonoscopia. Cada sesi\u00f3n te exige avanzar, orientarte y maniobrar dentro del cuerpo tal como lo har\u00edas en un procedimiento real.\n\nAl finalizar, recibes una calificaci\u00f3n basada en una r\u00fabrica de evaluaci\u00f3n de destrezas endosc\u00f3picas. La puntuaci\u00f3n se centra en los aspectos intraprocedimiento de la navegaci\u00f3n, para que sepas con precisi\u00f3n qu\u00e9 hiciste bien y qu\u00e9 debes mejorar en tu pr\u00f3ximo intento.\n\nCaracter\u00edsticas principales: simulaci\u00f3n de endoscopia digestiva alta y colonoscopia; evaluaci\u00f3n final basada en una r\u00fabrica de destrezas endosc\u00f3picas; retroalimentaci\u00f3n enfocada en la navegaci\u00f3n dentro del cuerpo; pr\u00e1ctica ilimitada para medir tu progreso con el tiempo", "short_description": "Practica endoscopia digestiva alta y colonoscopia en realidad virtual y recibe una calificaci\u00f3n objetiva de tus destrezas de navegaci\u00f3n al terminar cada procedimiento."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/bcc30b9c-3f0f-417e-974c-4f6d26c950aa", "developer_terms_of_service_url": null, "publisher_name": "AuroraPixelStudio", "support_website_url": null, "website_url": "https://www.aurorapixel.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CO", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1378554612002839"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn
38624075004572617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIScbABfl3kQ7kNvwFrc2SA&_nc_oc=AdptU0QDnhau95UdQE_mYYJyHJ7D75ByqKmx7fTjSP-3fSttefCq--9CToYYhhFV7Fc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8STRXjDPrmF-5kl71fmhTYu5nuABh5pyXPSIHGn8NU2A&oe=6A466BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440-HVES_v02.png", "id": "475157680169665", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036613_475157683502998_4146348651456345477_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmYghLDw0msQ7kNvwFLdrsL&_nc_oc=AdrkP78xMPde5PM2fpf-smGsAZaJp-qFTZSX2gbH1fI707F-zCcLUfeClyOz2gXa-W4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oTcOcIrZJSNtrqN3MLOswGGEocrlyOh5SsX2hWcR7-A&oe=6A466CD1"}, "display_name": "High Voltage Electrical Substation Training", "keywords": [], "long_description": "The training application represents an electrical substation environment (EU standard) and features audio and visual guidance.\n\nThe HV Electric Power Substation training will help participants become more familiar with the layout of industry-specific equipment, power transformers, oil circuit breakers, re-closers, and switchgear through exploring a virtual substation environment. During training, participants will be provided with information on substation terms, brief parameters, and performance rates.\n\nWhat skills do you acquire this VR experience?\n\nBasic High Voltage equipment\nThe purpose of each piece of equipment;\nInner components of High Voltage equipment;\nElectric Power Substation layout;", "short_description": "The Electrical Substation VR tour is focusing on learning fundamentals of electric power transmission and distribution, understanding the basic purposes of electrical substations and switchyards, identifying and operating key equipment used in substations and switchyards. The \u201cIsolated view\u201d mode allows users to take a closer look at the key equipment design and its inner parts. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalengineeringmagic.com/privacy-policy/", "developer_terms_of_service_url": "https://digitalengineeringmagic.com/terms-of-service/", "publisher_name": "Digital Engineering and Magic", "support_website_url": null, "website_url": "https://digitalengineeringmagic.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "471028744491863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982584_1106223669893732_6253036696415670825_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJ1keO72WK8Q7kNvwEj7X0q&_nc_oc=AdqFjgHeWx8Fej4qxpYqDj_DUC99pYxW9PUULuq1eUW0-xCAyqFWjOyqg_bv4TTnim4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z2taCHltlcmqZP7_9PM9ZqE7Fb3ABwl0uH5r2azjf7w&oe=6A466828"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "High Voltage Electrical Substation Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1627413092, "lastRevision": {"nodes": [
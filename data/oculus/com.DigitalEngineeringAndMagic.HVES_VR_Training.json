_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrOZ0VBL3Ei4v-T1PXEySzBn_FB04VtenbcwCsLkDkQw&oe=6B071F45"}, {"file_name": "HVES_PreviewImage05.png", "id": "768101337149248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75322604_768101340482581_338624075004572617_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjNbN_rIY0UQ7kNvwH2l3qY&_nc_oc=AdpLpsuEwgYCnZsLNI15em0CiC7aalnBmU4Xf5Z_xy9vSgPx1Fun2RHFh7iaHsdLkRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5DTKpfRHNfFede5EJLnrY4NAFY9jEInwLLGABiKiw0A&oe=6B071F2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440-HVES_v02.png", "id": "475157680169665", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036613_475157683502998_4146348651456345477_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGsl0wGjTbQQ7kNvwEH5gcA&_nc_oc=AdrBscKgBLJ_jIlNIUSx5lfsbZUAIHzbFxMVSufyHOXtraaokAstuq8IQssAvzAUdQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE8mvaMmYX6rLqGSkHHDNfR1GO2HTC9H72VotrORFf5A&oe=6B072011"}, "display_name": "High Voltage Electrical Substation Training", "keywords": [], "long_description": "The training application represents an electrical substation environment (EU standard) and features audio and visual guidance.\n\nThe HV Electric Power Substation training will help participants become more familiar with the layout of industry-specific equipment, power transformers, oil circuit breakers, re-closers, and switchgear through exploring a virtual substation environment. During training, participants will be provided with information on substation terms, brief parameters, and performance rates.\n\nWhat skills do you acquire this VR experience?\n\nBasic High Voltage equipment\nThe purpose of each piece of equipment;\nInner components of High Voltage equipment;\nElectric Power Substation layout;", "short_description": "The Electrical Substation VR tour is focusing on learning fundamentals of electric power transmission and distribution, understanding the basic purposes of electrical substations and switchyards, identifying and operating key equipment used in substations and switchyards. The \u201cIsolated view\u201d mode allows users to take a closer look at the key equipment design and its inner parts. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalengineeringmagic.com/privacy-policy/", "developer_terms_of_service_url": "https://digitalengineeringmagic.com/terms-of-service/", "publisher_name": "Digital Engineering and Magic", "support_website_url": null, "website_url": "https://digitalengineeringmagic.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "471028744491863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1106223669893732_6253036696415670825_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRtRD8HgKlIQ7kNvwH9f75K&_nc_oc=AdrXXT8xNDXT5HGBXeNNr_6WbT7PUxJA4GiaEOFnoLOiOE2GhDn8bYDoyaDPMEoZb8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTADWXmKZr10k_m5N8gUpJm5NMiY6mEyc2j5do1Pbf9_Q&oe=6B071B68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
O3MdMJkVsVtxhi27_bCQ9KyCCWdRlVL1SB-WQ&oe=6B045363"}, {"file_name": "com.Greenpill.vrclientapp-20261013-033813-2560.png", "id": "1773328740660843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623565_1773328743994176_2502689853369526195_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPEk_D9i8V0Q7kNvwFHcGn-&_nc_oc=AdpNUjXvCHvv5g01_dNB5g3KGW1pu3-GTND-pbfB0zL-nJtGvjVn7SXRfP9DHWk9RZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmkRGGn2ELIBAT8W6vnM2vtycRcafwhCznyTZbvv9Fow&oe=6B045455"}, {"file_name": "com.Greenpill.vrclientapp-20261013-071817-2560.png", "id": "1821578358997602", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624851_1821578362330935_8884384798107340086_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR47uJ_CNIMQ7kNvwHRjwKH&_nc_oc=AdpDK72p_6ykZvuZnK6jFkHwFk3u2tH8rO7ia96xkknQOG92W-XC8brYX-8r6BBGpjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNtDhmlm-EFVOSnq-bcrI4-16akiGjVZqZNQaJOCZYWg&oe=6B048A40"}, {"file_name": "com.Greenpill.vrclientapp-20261013-071435-2560.png", "id": "1159971579924418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624619_1159971583257751_5658449121001292533_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTYCmzG7UScQ7kNvwFmmKGa&_nc_oc=Adow5yLYdPtINVTZtzSWwB9qNZFPVz5HO1Yuue7ttLnEnSgC4gHnoz_LDtza2-KQbiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUERGbAFptROkjqoD4daXUIwg5tF_is8sMSxpX9TOTjw&oe=6B048AA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Greenpill", "keywords": ["training", "presentation", "communication", "simulation", "learning"], "long_description": " Greenpill transforms how professionals prepare for the moments that matter most. Whether you're training for a presentation, a difficult customer conversation, a courtroom hearing or a multi-agency crisis meeting, Greenpill puts you inside the experience.\n\nJoin a live session from your Meta Quest headset by scanning a QR code, no complex setup required. Your facilitator manages the session from a web dashboard, guiding you through immersive environments and real-time scenarios designed to build confidence and sharpen communication skills.\n\n  Key features:\n  - Live facilitator-led VR training sessions\n  - Lifelike characters you can talk to with your own voice\n  - Realistic environments, from a presentation stage and a bakery to a courtroom and a crisis team meeting room\n  - Hand tracking or controllers, your choice\n  - Secure QR pairing, join a session in seconds\n  - Session recording for the debrief with your facilitator\n\nBuilt for teams, trainers and organizations that believe practice in an immersive environment leads to real-world results.", "short_description": "Greenpill is an immersive VR training platform for high-stakes communication. Join live sessions led by a facilitator, talk with lifelike characters in realistic environments, from presentations and customer conversations to crisis meetings, and get feedback."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenpill.tech/privacy-policy-greenpill.pdf", "developer_terms_of_service_url": null, "publisher_name": "Greenpill Technologies BV", "support_website_url": null, "website_url": "https://greenpill.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
99623565_1773328743994176_2502689853369526195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcjsXfDUCYkQ7kNvwELafFa&_nc_oc=AdrH8CK6VZB3qRomBKLotvB4Dska88-y5bYpDaDVrK3enx1AuNAHtAbjEgahyAud8qY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRALZCp_Ge3xCL1N4gRlNyAe4nc0DeVGqiT4nT4PX5sA&oe=6AF48255"}, {"file_name": "com.Greenpill.vrclientapp-20261013-071817-2560.png", "id": "1821578358997602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624851_1821578362330935_8884384798107340086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eidltq9ILYEQ7kNvwFTHDwS&_nc_oc=AdqhR582v2Sshtaxl93Ggi0ELStAbtH9xwDwu-MUq2igpvlBZViVxkN-tn3debwqj-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoL-Uo4F8-F3LJHpPs0f80gfL2WKbNrrO2JOU16o2fRg&oe=6AF48000"}, {"file_name": "com.Greenpill.vrclientapp-20261013-071435-2560.png", "id": "1159971579924418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624619_1159971583257751_5658449121001292533_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHPWUNp7LoAQ7kNvwHARBw-&_nc_oc=AdqjSCw7ThEfL3HvLGG8zlS5iw1V6XV1u6InYO-cN3tiB6VUbmSn4ICcMK-w7HU9LwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKmBAQILBAOiyMVZriIUmzZdExfqJ_1AI46qAR_RexYA&oe=6AF48065"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Greenpill", "keywords": ["training", "presentation", "communication", "simulation", "learning"], "long_description": " Greenpill transforms how professionals prepare for the moments that matter most. Whether you're training for a presentation, a difficult customer conversation, a courtroom hearing or a multi-agency crisis meeting, Greenpill puts you inside the experience.\n\nJoin a live session from your Meta Quest headset by scanning a QR code, no complex setup required. Your facilitator manages the session from a web dashboard, guiding you through immersive environments and real-time scenarios designed to build confidence and sharpen communication skills.\n\n  Key features:\n  - Live facilitator-led VR training sessions\n  - Lifelike characters you can talk to with your own voice\n  - Realistic environments, from a presentation stage and a bakery to a courtroom and a crisis team meeting room\n  - Hand tracking or controllers, your choice\n  - Secure QR pairing, join a session in seconds\n  - Session recording for the debrief with your facilitator\n\nBuilt for teams, trainers and organizations that believe practice in an immersive environment leads to real-world results.", "short_description": "Greenpill is an immersive VR training platform for high-stakes communication. Join live sessions led by a facilitator, talk with lifelike characters in realistic environments, from presentations and customer conversations to crisis meetings, and get feedback."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenpill.tech/privacy-policy-greenpill.pdf", "developer_terms_of_service_url": null, "publisher_name": "Greenpill Technologies BV", "support_website_url": null, "website_url": "https://greenpill.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29446886434912923"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824673_1398955581960759_7445733592766819296_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_s
-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsohaLsHHjKRrXwt91GgGzgFkTr3g927u2EOEXh894WA&oe=6A897D34"}, {"file_name": "vlcsnap-2025-03-14-18h02m23s123.png", "id": "1778959679562478", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473397628_1778959682895811_1254343882605799702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swTm6bGVcWAQ7kNvwHHmszA&_nc_oc=AdrnxxluMKrZRK0zV3_fZF7DQFangbnGJLk465yQVkGpq9aEqFRSgT3IjKoJta0CC8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXoP5fJPa4D7fX4SNh992_RRq5guU0EyPQvrMjDylIwA&oe=6A89988F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpOwcQpSMUYQ7kNvwE_GtG6&_nc_oc=Ado7VumRGZqKJgiJZ8clAIZRTHhuVFaUfD0KmI1LrHaQxPAHuEiBKSStyhy07UHNHTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOEdF-kTYxeDluC0-aPAtGVuYGn3DPKKSsweFDUn0hvw&oe=6A8983E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y89skl8cU0Q7kNvwEevO9o&_nc_oc=AdoBwiBY44xuKhqsqBE3uPjMj2Ti8qKwuci5beKex55b_bt6tfaNk4v9SGWrCv1hyN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiEbXjhz9cIWgWIySio5k-Pw-WFt9CYqLQg6ljJ2W4nA&oe=6A897B95"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://www.holo-goose.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25212431618438018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828793_697142473301571_4648483731361869931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPZlSQkHJAkQ7kNvwGS-iDr&_nc_oc=AdpTmhe4ypiOs-NiLDSx8OK6_ueSfokTzU4ibsLMcaJVYXxzDulbEvh8tiLCnSY6U84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEegJqQoAMTULLJ2siA8X4-dih3Rwfl-wZrH62Z83L7xg&oe=6A89A390"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
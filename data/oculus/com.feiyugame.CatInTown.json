-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dhwTnED8uilpUuBWbIBwztSKpBDDJWqOWT93f9JrExQ&oe=6A09D3F4"}, {"file_name": "vlcsnap-2025-03-14-18h02m23s123.png", "id": "1778959679562478", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473397628_1778959682895811_1254343882605799702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev209DstAtwQ7kNvwFi7Lis&_nc_oc=AdpP9SrBs7paM96xE7wV-jbQW0R8qWURSZdagiCBtU3PraUqL-Jj4o3jF30yxX-Ngjo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50xp_ORMuFL_yTNt6NuqmargXa2w7jvo8f-c1PLW__UQ&oe=6A09B70F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kxv4r5J5zN0Q7kNvwENjWSX&_nc_oc=AdpE3A8RvMIeKJcA4S8gNT2W1s8s1IsvE-yDWZLwqVauEYGK5LBwENVtTBFo5UBfLrY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b34I7fCyxKNZkYFoZ0bNQdTJoCyYRXAYzS19CdTth_w&oe=6A09DAA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNaLdhiansMQ7kNvwFsSO_w&_nc_oc=AdruUSFV_quThnumqmzNaRAVqeh5KVzaDEsmwec-AVz38OWS-4er8GAFUg60dKAjtug&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TWbn5kc_9Z6hJo2mFFKjntfKkmcg0lcwMlxqn_rkCuw&oe=6A09D255"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://www.holo-goose.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25212431618438018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491828793_697142473301571_4648483731361869931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFSDdr0X8GMQ7kNvwEvqp1_&_nc_oc=AdoP5WZVbkiLpZjQGZavWDZATzc5WW5J6f2bAhTPkwbiMQrM9PtiITP4SWbeYDP51hs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kCJJAXRRteiYSnW_hlu69I2LSB5U3WWX8iBa5lTO4MQ&oe=6A09C210"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
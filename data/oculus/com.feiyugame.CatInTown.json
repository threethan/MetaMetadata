.com&_nc_ss=7f20f&oh=00_Af0dUL9jz0CewVI1kPSNc4r-iCEQtlsx_wMiKz4QqrwjCQ&oe=69F7420F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQS_W6nPG3AQ7kNvwF5af-F&_nc_oc=AdqcDKFP30TRNgks3ns_XQYaj8hFqM6o4gJIbmt8BdYyqK676CgGdzVC46wqxsWtr9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KpwnSAb7OfdBS0WORouHs0jsj1zG2Kwbh0lAvLe4Q6g&oe=69F765A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqd-9HiQft8Q7kNvwEm1Ivc&_nc_oc=AdpNwGquEQiweEDr8i5ikgLum7Z7FK3l4C_L7YCUfMH92KNbjpAnSf0df44rAi5L_e4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zWw2JpNEKk56ayB2HcDKY3D7k4j5rNR0vPvK6JG4OCA&oe=69F75D55"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
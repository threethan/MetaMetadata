.com&_nc_ss=7a30f&oh=00_Af2AWMBgI8_DhW3l2EeW6ES9DWzUCtMYBCOg5skfwcviTA&oe=69D79E0F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydC3EjRKbc4Q7kNvwFfE937&_nc_oc=AdrMV7gMoLKq4x5uz5ESpKJ4eVh548DPlVGyY0xfGBY8njLNsXNWoWBuHFYnA-5JFdo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZAUvoMJmagK8VF0AtgaXz70CV95NnDZAWfg4GzFRKLw&oe=69D78968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H8fXIIDe-EQ7kNvwF0cKVA&_nc_oc=Adrn8O_I0OAG2aDdYfRMjaeAsUJvYhc_Azxa3H4pPql2eyh3gceK84QpzwOmrxkZjV4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c3P3QbchuBhToeEGySnUjHvFPb_Vg4h6xDio0J7ZpOQ&oe=69D7B955"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
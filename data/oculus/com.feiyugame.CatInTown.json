.com&_nc_ss=7a30f&oh=00_Af3i3r6GL0JKvM0N-23J63mbM4yOP4wPMod1enE1qCqang&oe=69E61E8F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57eo2NSGOXsQ7kNvwH9y2Pf&_nc_oc=Adr1IjDzT4eap5zUX75JpQ4xzyOmSrGGkJeQsRzVOX1W1wkDj4SR13gsrOZmL8SytII&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32Q2UDsd9JqH4lxhGfwMrIl3qYGGtVzaYDdmKw_cUBUA&oe=69E64228"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewm-hAgyde8Q7kNvwGG4Z-h&_nc_oc=AdoV8n2Xwvf_dv0TND88g6rrlR7J7NIqqxDehOWOdk5bepAEtMTMFR9sp3jkK2CWlCs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S456U9v1JJptcXAvY6akYPrDcRWcK_BpWqU1TrbM40Q&oe=69E639D5"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
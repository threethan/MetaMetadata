-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lJQE8xgc8xvlT2eqJgKHe969LZ8VBeAr5Ly6_vNqK2g&oe=69DE5274"}, {"file_name": "vlcsnap-2025-03-14-18h02m23s123.png", "id": "1778959679562478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473397628_1778959682895811_1254343882605799702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlO0Xeiba9kQ7kNvwFpDs0C&_nc_oc=AdrdSKqsDotKGR2pDvd59uelE167MkZXjDU12Nn2HsDiRECB-slsZYBUmYgdSDDQt7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N_ZsnFXqLhE6ug-5TgZErY12qoJWz61D4O_uyhSWz5w&oe=69DE358F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAvKhlCiyWMQ7kNvwHgwapR&_nc_oc=AdqRy9W6ilZQBkRDcBOek5-FYjFYUd41zFikeJMXlGr2iW5gelKMNsVlDYBGHOw_EwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af228qaS86RuAkO6Ho5L5BnAkTpL0IB54_h9PyfcN4_fvg&oe=69DE20E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxtvxEDNH3IQ7kNvwGSzd3a&_nc_oc=AdrsLgCaDQWmt__lBZ0cHIC2lReOfE_plt5a96VVUysFqT6zbt3Yz5pSOATAPXnVQ5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ye-n0qG2QBEYEfqUK27L9H8ZIEOzT-JcO0VGjwKTFMg&oe=69DE50D5"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://www.holo-goose.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25212431618438018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828793_697142473301571_4648483731361869931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDRBGdHwxmMQ7kNvwFGjYyU&_nc_oc=Adr6Hle1JXSk79V3R98KhwnXj_iXRAnTF8tsAPONzVj3HCXiO5ViStbANmCFZTkdNV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21J1bChwW0T6U1QEuqryecniKn87aVb6XTuddv1SoYVQ&oe=69DE4090"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
.com&_nc_ss=7f20f&oh=00_Af8wCZVkDcPEEnMHx-ehuQ4eIXDknpZvbovGigzweE0SLA&oe=6A2FF28F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kW8nkUFeT4Q7kNvwF5dyoD&_nc_oc=AdpvbuwS5Fw8eLUC6tqQDocvAVGb6bZsILIdoBlRDnVExWrUd9UKytXFuRkf5erHkbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-geh67ByEyJ-3KKQyrv-pOdcI2za51N44S-xwkp9EHFA&oe=6A301628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yck7kLHLAMQ7kNvwEkF4Nh&_nc_oc=Adp6fluPqaDSWk4j_r88DsYD1bx-6iCaK8QaC5DFMlZbD3wakWZdgVnHKccLMNh20mo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w98Z8IQsamfSRR2hkr_03HN-JpJSyAeT57-criNy9lw&oe=6A300DD5"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
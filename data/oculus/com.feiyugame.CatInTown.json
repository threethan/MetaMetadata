-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mv9m5-LtbmAHwopqyNHyc5u0WKziUmUFzlmw6W9RN5g&oe=6A01EAF4"}, {"file_name": "vlcsnap-2025-03-14-18h02m23s123.png", "id": "1778959679562478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473397628_1778959682895811_1254343882605799702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LYJ2j4E1PEQ7kNvwGglgDy&_nc_oc=AdoSt1jRkiQvCT5-BFJeB6RcaH1i8RoV01AEcQjvRwzkazeDUKYbBDTNnJopcQZjVVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60Kwc9nSZRso9CCl8Kw29ojcJZIfpwvg5oL2o6_Vjuuw&oe=6A01CE0F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HUT0SnkhEsQ7kNvwFRGB7f&_nc_oc=AdoT7F-3zYnQqX583KA5CgUlpL1dF38AAl8rI4JstrrUfYOd63YmpzParCWCs09EhbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YxPs6MozomGz9Nm840bPPhnPdfOZQMmuPNsNPaCn9uQ&oe=6A01F1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITufCz02k70Q7kNvwHPrzEf&_nc_oc=Adplgldl2vUrl4IZjXbmbl_i--tvPexv46Nwy39WFjxGDHonpPri8Ktbl87GExmi9QA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tdruaS2Wk14_gs_RO3gQIk3QbA376IAWASlaLiF_c7g&oe=6A01E955"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://www.holo-goose.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25212431618438018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828793_697142473301571_4648483731361869931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVtysK_xf0AQ7kNvwHgJdg7&_nc_oc=AdppAbPA4Jwp52WsIG_KRdZXQwnA15T_idL_S-qwKc2fduXTrguEplQkqS3bXNMB33k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T1h2JMUlzxo19Z-ABVpeO4znYVBu0QDhS4DyVBo1WUg&oe=6A01D910"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
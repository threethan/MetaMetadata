.com&_nc_ss=7a30f&oh=00_Afzt3fEwZsNcqQ-JQPsUwhNOStZDwORwWuQL3ZKkboBLaQ&oe=69C5290F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR2ZWiGscIsQ7kNvwFBNagW&_nc_oc=Adpkq0SkMI6604L2-78Uh8vajxJeyS7cefE3fw44dy4L_qr71qRZIEzj8mIVJchtt44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz75DmPJMqn4y7u1PZtSKoFhVz4_5E4nMPgqVNMqB3yCw&oe=69C51468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EzBo-FWP5MQ7kNvwEsJ6M6&_nc_oc=Ado4eQXZhbMoP0bReyR9Jyhe35ZtzjlPgZbnm1Ah3yZpuc_pEjzr4cmW4251Vzd_HvA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztZeYTzC4rkOwF07Tkh5N6fL1VtRqYG1hYU7fTQs8dGQ&oe=69C54455"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
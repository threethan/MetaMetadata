.com&_nc_ss=7f20f&oh=00_Af5iip35KgVdBFfAGsTgImPerEhXKLdAPFoPVn4DebMPmQ&oe=69FC880F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKvvBT7Uj6AQ7kNvwFZpuXb&_nc_oc=AdrdgrwP5fJyHxvjbqB6raEuj0cS-4_m71mUAFNAMxEz7nOCLRtnnTnTpWoVaf7d6zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4whW7ve8dAMXh-w4qyhx13-sLNyMWQU6861hO_ba-f-A&oe=69FCABA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cwEfeCH42YQ7kNvwGikhTa&_nc_oc=AdqAV2TRxHiCDbicvF_8iVtSPFv6Y_wgvLBha9ZAhNv6fpwRe9tILvkuKc4WZwk5rzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XSdjrQ9QbEb-YTXL8wnTQES-880dQV7B5mB16Me7hBA&oe=69FCA355"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
.com&_nc_ss=7f20f&oh=00_Af506DFFvN7rA1SwIDwt7v-M-gAVZK9HMhB1ilYI0NG17g&oe=69FF2B0F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKvvBT7Uj6AQ7kNvwGzKVZz&_nc_oc=Adqx-MdDsP5nza5aZZhmyVNP2kPOXSMIdBhvOqjuwqr6v6EBo6pcsByZaYCpybY6R98&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7be7GJG6h9tE4DLzE5q5Mk6bjlGtjP1c5I1WGhRTy2uw&oe=69FF4EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cwEfeCH42YQ7kNvwFWpNWX&_nc_oc=AdoeeKuqFrUN8xDbgJBp9pv0n90h50sRs3AJCkLhSokPEgzmdZKYpra7beD9xQlDlCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DLnzBHHNHGgXZ6z36Dsx-kjL7506lqTVTB5NehFZaLw&oe=69FF4655"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
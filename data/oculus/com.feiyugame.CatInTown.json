.com&_nc_ss=7f20f&oh=00_AQBB0l36K7wdzSufwiNxXmRbgVZ8Ki7eAd0tfS_bwnSx8Q&oe=6A58D10F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgRrOpFkNsoQ7kNvwG344Ow&_nc_oc=AdrS-b3AEcRGMXmzbJbZu5qrRCMYDTqkcWf4W1HR4fqLfkUSBeygxOUlmPsS4nYNmek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7UlhJiDHdbvluF204xiKnJbUhDIBGOIabA9wA4VobQA&oe=6A58F4A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELd_Pne8Ds8Q7kNvwEnjcDf&_nc_oc=AdobmqHoZzUFl0gouyf92pPwyvqePi15iLQ7pnM8uXxbSHkHEQRXAK5RAlnmAmtRO3I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcrqZCILw4ExdNWnYzqDwrJdyEcP-Lf2-BrFzql6gF1g&oe=6A58EC55"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
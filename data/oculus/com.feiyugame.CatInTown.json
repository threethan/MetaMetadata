-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0bjU6SVccYZGtDX7KpcIbkdx-p3OFA08eeadXK53U7w&oe=69C2A2F4"}, {"file_name": "vlcsnap-2025-03-14-18h02m23s123.png", "id": "1778959679562478", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473397628_1778959682895811_1254343882605799702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rHeiKktVyMQ7kNvwHdqmbH&_nc_oc=AdpvFtHaCAg6Jr8mpePP8ALt_-kke7-AnW9FFbCS24Nl3RbcpC66XIS2LnkPBeGmagc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMJhjAZb1dVNA6YnOS5XxyCJUcJvZs5jcNCTJ_9stJlw&oe=69C2860F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUBU5_cDZ4UQ7kNvwHs9x2T&_nc_oc=Adr_t9uPL_nt_ZLodSA7S46RP8L-Hu7i-pl1PyPR34af50TmXfKF2U9hhFGn05fLark&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyu1Kn5XzKk3MnN3AdmPwAoJkleGMOFxykni6nq_i5iwA&oe=69C27168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icjvo4-7Dp0Q7kNvwE_TUfz&_nc_oc=AdpxvCbHqIBDlGPk5ApAlWMu8XaOcqaeAx12m3MujdeEX4lz3Stmri4MoIxSD8AuBQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyS4rRKGjdtzpRK9PyuvTqJxsNv3iCIgDJ27Nzdlkq6lQ&oe=69C2A155"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://www.holo-goose.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25212431618438018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828793_697142473301571_4648483731361869931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkd3tAGXnC8Q7kNvwF3X9Rm&_nc_oc=AdqwsSA3aFe22ItCjiCqzf6x4jEB-zEfBs-M4KOHopv-2OL9ejy7l0WZi9CyINEdsFg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhUmgkv_JDHOlycUHkPli7Bu2CDu26-xoSBo3lf_ZbDA&oe=69C29110"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
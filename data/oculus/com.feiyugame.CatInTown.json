-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvIrxO-YAGuh6Wh7HqcLObuzSSDSSMncEKuaFCQ7lr8w&oe=6A9ECD74"}, {"file_name": "vlcsnap-2025-03-14-18h02m23s123.png", "id": "1778959679562478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473397628_1778959682895811_1254343882605799702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzxUUWLpArUQ7kNvwGP2L0c&_nc_oc=AdrKHfpMDqlKBPrBYgH9HWGJ7dRic2YLTclAZ-nOBzQ5xg_RFUG4v3Vm6eECU78RDas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINHKk5HFHhuLesRKOd8vKKoyqAx3Pbh4IqOgISs4Jhfg&oe=6A9EB08F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80369mWkdrgQ7kNvwFeCB3t&_nc_oc=AdqfdsHnZqUGJrPBJfBhJTs_QdQiFMbl4Bqg4YefuncnbOGKDSTj28u0RwmyhO85pyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVq-XvII3rzSGRSRpla0BB9C_uenrXkU5Pm5jraWwncw&oe=6A9ED428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nLNwjiGpN4Q7kNvwFWcpVB&_nc_oc=AdrLaPptSgrgAgSk42FdKN1SgapBUs-_q2ysoMlgG7xL9lNs7iW84VTfnU57sx_OgrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLcJtPyCIUqE5U29Oo5Tm5eC5Tr4QXGmN_fp3klrBjmw&oe=6A9ECBD5"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://www.holo-goose.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25212431618438018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828793_697142473301571_4648483731361869931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkV5REUOV60Q7kNvwEEWcqd&_nc_oc=Adqtn-iP4tJpruBS0p6LhEWxEvWKmRdo4FYD5nsARmLPbGQGwNNDmDy2nUGmDEkjA8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlN2gfda6X-YXI1K4oEtDYbQhdzfW3gtZ_7wZe5iVzfQ&oe=6A9EBB90"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
.com&_nc_ss=7f20f&oh=00_AQHhBcBoIL30St4wTfyBse4yV1Ph_5rxpzRaewnzav8Tkg&oe=6A91818F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIvh215bCicQ7kNvwFF2tlh&_nc_oc=AdqTRxGKDrgNLRIto5BWyh0W4ioQ3e_xkYYt7jCvd4cbMrpXFkeQ924X-qENTi5DKGw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGMnOY-BrlJ5RfJZ7rWIJ0y2tZbQN22xgK0rxpvtyXSw&oe=6A916CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3J51_egRVAQ7kNvwGbKVif&_nc_oc=AdpTwIGDQtjaUGm55iXqLdem3v6IS2n5OnKyj0GEbnZgIrax9_6Ql5ZO4rRqGKzaZKg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPacOv6ehJJV4vuwuuAbA-8oPwWXbKiJxBMr1uhHYBnQ&oe=6A916495"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
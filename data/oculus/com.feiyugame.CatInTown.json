.com&_nc_ss=7f20f&oh=00_AQKwCSn8Q3h5SKmffJhyiyZXWsZCvvspvUOgto__WrTm2w&oe=6AB2770F"}, {"file_name": "vlcsnap-2025-03-14-18h02m52s239.png", "id": "3858292641167430", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397628_3858292644500763_6631730531060227035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgiCS38oSJwQ7kNvwGohpGy&_nc_oc=Adpt-31Umqil1MZDCS80ZnFqKiU4gtJ8FqL9S7vCHGsF2WotnSl9xLC0iQgPbRqfjYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeTo9qL8XaqPKMUWNopZVPhbDVM2o3v_6PyNeAMTvK3Q&oe=6AB29AA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4659145680893317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392329_4659145684226650_3106660382712700741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4wnL8UGIWYQ7kNvwFoBBsb&_nc_oc=AdqIQxI4KAMyW2EQ37YMCuQXNk8bxzlVaGhWHqxYRpZwCox8-FgBfv4FbHKxpUJ1PZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXkF1TRaQ0isKc9LiVguqGuhdfEMwHRh3_q1EfWCXzfg&oe=6AB29255"}, "display_name": "Cat in Town", "keywords": ["cat", "town", "role", "adventure"], "long_description": "Cat in Town is a sandbox action-adventure game with light puzzles and a rich storyline. You play as a cat exploring the town, interacting with the residents, and searching for clues to uncover a heartwarming story that's been hidden for years.\nSpecial Thanks To:\n- The amazing performances of over 10 town residents.\n- Sheriff Stan for his unwavering support and assistance.\n- The anonymous donations of mission items from several townspeople.\n- Dozens of town-approved achievements waiting for you to unlock\u2026\nWe hope you enjoy a magical and touching adventure in the town. Have fun!", "short_description": "Cat in Town is a sandbox action-adventure game, you play as a cat who mysteriously finds itself living in a coastal town, full of vibrant stories just waiting for you to explore and experience."}]}, "developer_name": null, "developer_privacy_
.com&_nc_ss=8&oh=00_AfuHkZ-gw8BS4p-d2xPSoNWaqGR058hfUJhgaR7Swe-eSw&oe=69A987B0"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdZnNIg1a58Q7kNvwHFXPMm&_nc_oc=Adk_9_47z_MbqmBmLEkmYotY7Rtrecg-6D4ul9DHUiLQI7Tz_VqhjC-T2l-LsIwFbM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvuwmQGXOp1s6cNWcjPy8AS1E5munJx4sTNytR10Xc3AA&oe=69A96C97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-IibO8uj8cQ7kNvwE3STeS&_nc_oc=AdnYZIrmPoQsdbZNmHBjFDy0MiFZI8Cc_IUN8GEB2iQwgvWiBUW6BN1QxaXD-twU42c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_726nZL_QRSkIcscpabRoRUhMhq3gX6-XR1rVwstP1w&oe=69A97D2F"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
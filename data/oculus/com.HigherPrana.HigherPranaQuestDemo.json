.com&_nc_ss=8&oh=00_AfxSkLr6xRLg9yttXtnozZ-aoMcGU4DqtCqlanWO-t6L5A&oe=69B413B0"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czZ_xriBtnUQ7kNvwEsa_s3&_nc_oc=Adk_HUoVBmRiHLw_1hlaAH5-5FlLYsELonJM1CCiXmkmYlynKzlVWLxL3JwGLmq-xNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvGk2QUbWK_w2j_P1vaRpAmlNzMKr8wqoQAvNXPTNV0g&oe=69B3F897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4ncEnMl2uIQ7kNvwGh8AY6&_nc_oc=Adl0t0evHg9YbiZYx2gk4Qr88wLlRtkvGLVv3TA9egbMupou7kM69j35tb4NiObojpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtexmCXtsEbsz1G20Z25Ohl-mMf8P_XJUucXZDuAGbNw&oe=69B4092F"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
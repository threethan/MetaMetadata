.com&_nc_ss=8&oh=00_Afy6pP-6tRe3BKCiOlm4oAzY4BIQfqXVF5PmsKjupogRlg&oe=69B56530"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czZ_xriBtnUQ7kNvwFh3-HT&_nc_oc=AdnyLY2PISdSCmVtOEQNnsY7yYzi_WuiQUCOXWj5hRbFFwVyuMCQkNKR8JwsKlqUSdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpA1eY_MqFwlLHRP3ifxMxM8OQZOue0q6hpV5mqNAtDQ&oe=69B54A17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rx-hP8cQEFQQ7kNvwGS4_Nn&_nc_oc=AdnsAyDDoUi5XGVDjnp6rKgaLcwMgo4NsV1-5hr4Dbl9SQFZ8Qez88O3mOBNHKb43sA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyp0dzfoaTAvWnIdwURS1Zr8z23DVBzsDE7E4Xq1Y8weA&oe=69B55AAF"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
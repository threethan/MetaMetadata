.com&_nc_ss=8&oh=00_Afy9rOav21a6UoVdjYD7-EZswos_dFUNsA8CNfZCwW0wbQ&oe=69B80830"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yzhTVkLgOkQ7kNvwGZJ1sK&_nc_oc=AdlYwYrCbr6-okDuqstbx9RjGoJyXePhjCbqtTAKwOZLeNcGHoJn1UwwZjapoouwAuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxIfngg2mXcLAi-W0ot2YnthvZh1mwQsOEFsW8-o6o5w&oe=69B7ED17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rx-hP8cQEFQQ7kNvwGYqhtD&_nc_oc=AdkOT1obA1Bq7Vh1jBlenQwAJbCr63Xv3M6MQYmZVPUqTf4WtXj9y3yOw3Zun75HFok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD5Ng4wpJwU6ZHUGGRccLMrUMt6QD4_n1uxHydTD8BkQ&oe=69B7FDAF"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
.com&_nc_ss=8&oh=00_AfsygTxM8sAVGBb-GOqtZN2TZiAqZ4cEUJcxMFD0-y_icw&oe=69A83630"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdZnNIg1a58Q7kNvwHbRnua&_nc_oc=AdlPHExaGq1omhinztP0vNuJYhHCVCJGDE3B-DSpX20IzZcuINEXjPW1TGJ9r5b5L_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft8JZTUvX66aS-rRLSfBPZOgreu0_Lh-zFDf4FxErsXCA&oe=69A81B17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UsP5pp7yo4Q7kNvwHZoiRK&_nc_oc=AdlfQxqvdlzDGZshD-o_qZyQgOm68rb62eLtqFGHQhWXJVC-fGH54NQeYEZlcpK5_3g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuAtBrc9ZicPYlmmdLUaVpxZN4l1--3XZ8AaQHAbazLYw&oe=69A82BAF"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
.com&_nc_ss=8&oh=00_Afwm3KG6_lLIdSgrDSXpV_sq4XFBe2OOTetxaLgEAZCD8Q&oe=69AD7C30"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHfV3y6YjsYQ7kNvwFTrATq&_nc_oc=AdlB4NneVJAL6nwTcQ3W4pCu2p5tRNWzIgqWdAHga76YIvaEoHFRnll2U7NLJW-3BA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3QzEMfOmUws4XIUdEnabXeGXx5_xlLdYtBuVXNsiLhg&oe=69AD6117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G31fmy0QcyoQ7kNvwHe3h4r&_nc_oc=AdlGFNh_JzqS6ihOTbIh6jIZI6NqhTZygu9ucrLEEjsFxfeC4E_ggcXY35MnDREF8Vc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUXlaQI_CoF29fxEpUvn8m0qjqKlh4HprSj1oKiZxyCw&oe=69AD71AF"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
.com&_nc_ss=8&oh=00_AfynLFA57LGYfdfskMyoJKkn_Kxz1lDa6X6qDe3MvEMBMA&oe=69BD4E30"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP6JwAN5AHIQ7kNvwHyL_zH&_nc_oc=AdlZ5O_ybWLx0G6DrqgNKCQU-OSbG6EY5C28urAFc2L6TXP_Sw5LY9mWwr3z-p0VSgk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfypANKZUtG5gTqQzpVpwMcxlpw6ab5uTMjHgkulkI6G4A&oe=69BD3317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPgPOisb1wIQ7kNvwHry_Zw&_nc_oc=Admp-TW-N266lsPvBMAi0AX7ezXp37owtcod7am2lDlRZw0ThrTVLh97kXy0QFC9xrU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0wqCmn0-EwRegbmAOAPV-Xloc0LJV2-eTArhAJRyHYg&oe=69BD43AF"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
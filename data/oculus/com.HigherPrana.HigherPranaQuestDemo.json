.com&_nc_ss=8&oh=00_AfyQiGV1euncEqLVwN1BMFjOncVofelcSF4Cdm0hhw4VzA&oe=69B170B0"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgxIcm0De-MQ7kNvwGYNUne&_nc_oc=AdlI_0KKi1tNZxtc-iQDr0r17wgY7GeqlNfmVkcaRVTdIMMX02RQ9eeAwVMrZ13s9jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXE8_ooYFvUlz-IE-B0v2nW015A3iW7v80CHN1iSfoKA&oe=69B15597"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4ncEnMl2uIQ7kNvwFE1D7H&_nc_oc=AdnV0DDwXv8bRHE-1_tRYp7Gc03sHI22F1vp3bHcttUqsO-vPdkxnjc8WUn_wMoOp8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK8QRFA-bQOH6lchO1FF8Vw5MCZPTagtqe7p_83eoq2A&oe=69B1662F"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
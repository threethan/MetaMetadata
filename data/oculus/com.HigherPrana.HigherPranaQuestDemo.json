.com&_nc_ss=8&oh=00_Afy_J7NEW1LHHdpZ__L6LJZ8Yt30LNGEEe2coK1aGVdy-Q&oe=69B01F30"}, {"file_name": "SUNRISE.png", "id": "7400035673378800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_7400035680045466_3828829917211616544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgxIcm0De-MQ7kNvwF4to9P&_nc_oc=Adk7tbSaLnjif3aYQMKYyiYjKXGA0y3Yxq2j9CtnXLMzd4bMt8zvsAn9DRDN8qXfpSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCdrkya9Ob14g5wlpZyiyxd2jApuel-ebwWSQnNCcKlQ&oe=69B00417"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1385957682796070", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568676_1385957686129403_4694405888777743009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G31fmy0QcyoQ7kNvwFi-xM-&_nc_oc=AdnaQ2nzm-YExaHxg_KWsoCsSwZgnKFseNNC4pLRcWgk9nDxpOLvUEzHYlbm9HwmBoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5DAu5-qgw8Ux2U9nh2O9Kja8vTzqbWPSN0-bfDuVzCA&oe=69B014AF"}, "display_name": "Higher Prana Demo", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "develop
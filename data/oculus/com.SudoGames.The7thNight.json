ntent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lB0osAPDLaZRXa313npRi36MUZpow5OEORbEgKRGQvA&oe=6A198F48"}, {"file_name": "screen4.png", "id": "736661552720965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_736661556054298_2361103382502496637_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf1VwHN58EoQ7kNvwGQ1TMb&_nc_oc=Adq8js4ZIK8xtAClH54dh0nO_qP5DjnsHxfgpTM55SEvcXB_xigZMyfWzOW3stUKLZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D0xQYQQRraFEM6S3_mUcsTj-WRpbu5B8H7WSHNnX99A&oe=6A199389"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "706530981778684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618071_706530985112017_1416271762036499916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkXeGwir6DgQ7kNvwEQ6lQQ&_nc_oc=AdoMPi4z8HaLyrnC-iq9kMNgKM_TDIMMTlilcGRaq5YK2NbAngIMhNC4M0Ej4tgqBkU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af423OqFuIylkkykqnsT_XcF3LE3KWQNjhm-zzD4Rfrrqw&oe=6A1985EF"}, "display_name": "The 7th Night", "keywords": ["Horror", "Immersive", "Dark", "Stationary", "Survival"], "long_description": "An immersive bedtime experience where you lay in bed and fight to make it through the night. As time goes on and bad omens occur, you must emerge from the safety of your blanket to right them - but beware, you aren't always alone.\n\nA VR first horror experience: feel the suspense and terror grow as you fight against the growing dark and stillness. Sunrise can't come soon enough, but as Friday the 13th approaches you fear you won't make it past The 7th Night.\n\n**Guide**\n\nYou never need to leave your bed - The 7th Night is a seated experience. Around you are a number of items that have a \"good state\" and a \"bad state\". If everything goes bad, then not even the blanket can save you!\n\nThe paper spin disc is used to measure how much \"good\" is still around you. You never want this to reach zero.\n\nWhen danger comes, pull the blanket over your head as fast as possible! If you die you can continue the night again in Baby Mode, but on Nightmare difficulty everything is harder - and there are no saves.\nBut don't try to fix things from under the sheets - if your arm is out, **it** will know!", "short_description": "An immersive bedtime experience where you sit in bed and fight to make it through the night. As time goes on and bad omens occur, you must emerge from the safety of your blanket to right them - but beware, you aren't always alone.\n\nA VR first horror experience: feel the suspense and terror grow as you fight against the growing dark and stillness. Sunrise can't come soon enough, but as Friday the 13th approaches you fear you won't make it past The 7th Night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sudo.games/sn/privacy_policy.html", "developer_terms_of_service_url": "https://sudo.games/sn/terms_and_conditions.html", "publisher_name": "SUDO GAMES CORPORATION", "support_website_url": null, "website_url": "https://sudo.games/#the7thNight", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24466621729658479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619571_652301494625221_443870974103019445_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4rAyZv-214Q7kNvwFC
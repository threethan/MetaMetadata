avqiuoLkcabufrUYrlHsALL1By9GKtoMM2FzvDX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdEPZwyzjfkraFIU05XUBtMAWqN4gfrDP8Db5qpyJhBQ&oe=6AF5CBC3"}, {"file_name": "Ads\u0131z.png", "id": "2441591933006445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828038_2441591936339778_7866751342916650500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kKSUtwgguMQ7kNvwGsgGQB&_nc_oc=Adr7QzD7ggHM9EedOd-4e1Dqvs_GJtlJbW2znCuBFUFwqhV2F8KYTMSOaMOYq_7Teho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr6v-4Aj3KToesPvBeddnFgtDBDF39q38gAMGRz2ejXw&oe=6AF5ECDB"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1555994635602031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1555994638935364_20279282336264827_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcOCPttUXjIQ7kNvwFdapGf&_nc_oc=AdrJAlbPXJILAooMGaHV5Ppiyadk5hiQi5B6GQGPUteMwOax0rsmxm1XGGPiihKjQcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9rpAarWDeqDUS-fTJPDRIMLE-bJjY_ouTo4IS9l0EdA&oe=6AF5D38D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "939080715691478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_939080719024811_7192187639204630309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDteSdfS9lsQ7kNvwGxxgSf&_nc_oc=AdpRVpmzikpNmPCyXZee38bu10tdnEkE645CgI0awrK87NWLh5uX1LKU_6HDU2iatY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuByggyhXqN1LVts8V6nBacQB6w3Jyc6POjWOjUo9c6Q&oe=6AF5C135"}, "display_name": "Escape The Cube", "keywords": ["puzzle", "horror", "escape", "room", "mystery"], "long_description": "**Try to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!**\n\n**DEMO VERSION Link:** https://vr.meta.me/s/yTzO2Zm7fJwdLIE\n- Playing the 2-level demo version and leaving a comment will help us a lot while we develop the game. We\u2019re looking forward to your feedback!\n\n{1516271360074646}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{1340574611222431}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{826274706669169}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**\n\n\n", "short_description": "For Saw & Squid Game fans!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28939218775711460"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_992978577213983_8764471648737841573_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiVmJOTRmFEQ7kNvwHJ6pIw&_nc_oc=Adplc8NXfqFCZJPZKzBRfQ0se8_TYgLbmctmhOW6K7RCBiBLQDAuoa9_61bL
ar\u0131m (3).png", "id": "1337300474591035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_1337300477924368_6126622841128164838_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPZWSXc0Fa0Q7kNvwFbvZOB&_nc_oc=AdqKZjulsd5Ydd0F5w8cu_hWWPIFO_5P0wrK6U0rZqzPFJETzYXebtr-7tMb5xvaerE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVW_r7KKWU0S41HE-j_-7r4vdkd1E_X4unK3TUtdt-zyw&oe=6B0F1083"}, {"file_name": "Ads\u0131z.png", "id": "2441591933006445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_2441591936339778_7866751342916650500_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDrlRyCsu8cQ7kNvwF5hZsi&_nc_oc=Ado17Q-0Rg4pt9nII8shOtUGwoQWYgTnmgHboVuNi3NVbvCPaxM6y_-psunDkF-JiHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDwSGaqursmKVX8rI2eHe0tiQpt9Zu1NoaY9MiYBdBFg&oe=6B0EF95B"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1555994635602031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1555994638935364_20279282336264827_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2J3zw1z7pFwQ7kNvwHY99KD&_nc_oc=AdqjOcSWqA-lnvdSSyxLPwo5-FnITCxSvPk0Jeagwgc7-vLfaMx_5e0n99fY29R-FR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8iqKq1LNjWHkB2FppuVyoUN-8w2WIkitbt43sbnoXTA&oe=6B0F184D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "939080715691478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_939080719024811_7192187639204630309_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R2C_OiCOhEQ7kNvwGjJcR8&_nc_oc=Adrrab9y2LYz2aJWoxBbmM_scTtzpZP1D4lEGxg4Pu5pvSF_gccOhSvAVSgkptQVFn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3k-ZH86Yt2A11MqpCeztQVMv-rXXcok0OGaMk1xanvg&oe=6B0F05F5"}, "display_name": "Escape The Cube", "keywords": ["puzzle", "horror", "escape", "room", "mystery"], "long_description": "**Try to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!**\n\n**DEMO VERSION Link:** https://vr.meta.me/s/yTzO2Zm7fJwdLIE\n- Playing the 2-level demo version and leaving a comment will help us a lot while we develop the game. We\u2019re looking forward to your feedback!\n\n{1516271360074646}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{1340574611222431}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{826274706669169}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**\n\n\n", "short_description": "For Saw & Squid Game fans!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes
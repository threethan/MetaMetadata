ar\u0131m (3).png", "id": "1337300474591035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_1337300477924368_6126622841128164838_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rUmOyBk1i0Q7kNvwG8wZw5&_nc_oc=AdopOGPPiWmSP6I7ZXV6nmwnlP040bVDZGXSKk9tZWVDqdivhUUGmkB7QqTVNJBQG94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDWWWE-YI-ctdZMh56Px5IrVtDVfDcAjSaiMbfZgKP5A&oe=6B048483"}, {"file_name": "Ads\u0131z.png", "id": "2441591933006445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_2441591936339778_7866751342916650500_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqMq5cidY3kQ7kNvwGe-vvp&_nc_oc=AdqiRGo8lMfkkqWJUhrGiVlp7oOImV4S8yKUlTpOQzkkyUK6chavNqy7rk4ovNsqni0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvXnzcBKQQnZlcbpptmQ5TezAgFWWq2wIGRVfoNFlOkw&oe=6B046D5B"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1555994635602031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1555994638935364_20279282336264827_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdSjpuTv3KAQ7kNvwEc-Y8Q&_nc_oc=AdqAKJF3zohGNSwZAHAVjLKCMDebylEM1ws8HLyaW7BV-ES9LGyETzhyXYss7V7ZKi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_BDvtNCHyai7XXZv8985vZY1VpPf0AHJd8QfIFoCfZg&oe=6B04540D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "939080715691478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_939080719024811_7192187639204630309_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pWtNf3U0ZsQ7kNvwGDW8UN&_nc_oc=Adq4MJ4lc_DxvP7DpuRxamk5D6XJFKQgqXlUBBPGWKH4t5an6VklxgxIZj5tKDvSebA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCn5Hzjp2zkDiExNtCQ47VFIIm393DSWOiR6I93b2Bmg&oe=6B0479F5"}, "display_name": "Escape The Cube", "keywords": ["puzzle", "horror", "escape", "room", "mystery"], "long_description": "**Try to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!**\n\n**DEMO VERSION Link:** https://vr.meta.me/s/yTzO2Zm7fJwdLIE\n- Playing the 2-level demo version and leaving a comment will help us a lot while we develop the game. We\u2019re looking forward to your feedback!\n\n{1516271360074646}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{1340574611222431}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{826274706669169}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**\n\n\n", "short_description": "For Saw & Squid Game fans!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes
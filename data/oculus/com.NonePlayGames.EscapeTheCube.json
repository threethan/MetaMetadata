=1-7&_nc_sid=6e7a0a&_nc_ohc=ijp9QQ6fWm0Q7kNvwFftaZc&_nc_oc=AdoOy0GkpFW0120I-FoOHtrnXVaqbDMj-2I2D8y8J09ndESdxw6vPXk6SlGAS9hhVCc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmMKErneZ8wWGIjSbgX9c7-a2OlUnIS2Wzqass9Bc28Q&oe=6AC50443"}, {"file_name": "Ads\u0131z.png", "id": "2441591933006445", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828038_2441591936339778_7866751342916650500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQvrh8yKyCoQ7kNvwFBmzi3&_nc_oc=Adp2nSB2k6xBW57nGZU_6gI5ynG1ZG-WPLt6d1cjG1RAUQAdXRuCS6rFXbDyplt9mok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1tQyMxiu28tyb1hHi7c5pFVkUT455_aY1jIvMFriTvQ&oe=6AC5255B"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1555994635602031", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823310_1555994638935364_20279282336264827_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFwlQdJAonkQ7kNvwEKFkSH&_nc_oc=AdotRQj3TNZRClLHpgF2Dxm0Mv2Wlfnp7n9tMLh4kbqNdQJNAwb5s2zP26hCPsaYqJ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhvjeE8ykEIQC9eLZsYkeOy4HnM53qBhNTKgeEy9oy3Q&oe=6AC50C0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491827601_1637437664484279_1845872449814238543_n.png", "id": "1807058660721216", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823790_1807058667387882_4625475844170542978_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9mosXHFpIYQ7kNvwHFGjaY&_nc_oc=Adpi-6RAYVHwRRvttzgjwatMWtli7yw6O0FcZSOGhPSabklaWwjIZIn5m33-j3SAVnU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2K2ah_zwq3UKAFHBNm0RGKSVsUKL1y49h8KGGYyhTew&oe=6AC4FE2E"}, "display_name": "Escape The Cube", "keywords": ["puzzle", "horror", "escape", "room", "mystery"], "long_description": "**Try to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!**\n\n**DEMO VERSION Link:** https://vr.meta.me/s/yTzO2Zm7fJwdLIE\n- Playing the 2-level demo version and leaving a comment will help us a lot while we develop the game. We\u2019re looking forward to your feedback!\n\n{1516271360074646}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{1340574611222431}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{826274706669169}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**\n\n\n", "short_description": "For Saw & Squid Game fans!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28567109039589104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824318_1594601391618013_6973430121323571070_n.png?stp=dst-png_s360x360&_nc_ca
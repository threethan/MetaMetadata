-QjYfNKhDhuYG0lzmUztIkT3NA7dkxKARJfEZW4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ZeNSC-B0coACKgaSFlGmMu3gz92wfWI4qCCMWmQ3XQ&oe=6AF085C3"}, {"file_name": "Ads\u0131z.png", "id": "2441591933006445", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828038_2441591936339778_7866751342916650500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L82mws6lgXEQ7kNvwHPzoM-&_nc_oc=AdrDXa0j3lWurYfHQS3AtE8IyV2EPUnrvajBTTaOEyTgTZxldIwbgG0UpBHNqsZNtA0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbl6FHXzK2Es6PuX5-QHSrutIHSjvpH1OXQb6arvjTag&oe=6AF0A6DB"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1555994635602031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1555994638935364_20279282336264827_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIV68lZi7J0Q7kNvwHAI72x&_nc_oc=Adp2euGe5wRHTlG-cuWPJgkK9Qb40HW5PTIqR9N7AgNHG-kfRqBbshFXZVp1Y3dlaZs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrEMTcCbf3bedb5gk9TopwZu4yWQeNYTYdMlueOU2-JQ&oe=6AF08D8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "939080715691478", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_939080719024811_7192187639204630309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDFUWJQ3kTwQ7kNvwEz8EAT&_nc_oc=Adp6bNFwA6wlfpimUzdZyWLAXjNLCnDL7NbwCprTh1QQwsoBGnh41HqGjXpZELGv5HI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPOcSY_JVjl2SE7WwZ6jOnwfXvROtb1rlFytC-76DfkQ&oe=6AF0B375"}, "display_name": "Escape The Cube", "keywords": ["puzzle", "horror", "escape", "room", "mystery"], "long_description": "**Try to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!**\n\n**DEMO VERSION Link:** https://vr.meta.me/s/yTzO2Zm7fJwdLIE\n- Playing the 2-level demo version and leaving a comment will help us a lot while we develop the game. We\u2019re looking forward to your feedback!\n\n{1516271360074646}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{1340574611222431}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{826274706669169}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**\n\n\n", "short_description": "For Saw & Squid Game fans!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28939218775711460"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_992978577213983_8764471648737841573_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frSVUhZdYG4Q7kNvwHLTUtE&_nc_oc=Adq-mx7eGWkOAtg8CNFLo147BGhSyE4YfnV52Mv63bQ8NXWsdHuxTFQV6nxZI
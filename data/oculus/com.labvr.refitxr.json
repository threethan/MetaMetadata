2071345517016716_3135079810610337833_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtURDFK_UzQQ7kNvwGzH1Rz&_nc_oc=AdplWzuIOTWGxYFt42hjix7c_SlCXtfFFjofmOzkMqRrkgzZPpKlxdSx2ricR6Om-I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJml2C3EB3w_BGu9i_2msyPHstl0pOK1mwIHegpMEzIg&oe=6B1066E1"}, {"file_name": "Screenshot_01_Arc_Hit_2560x1440.png", "id": "1127491133497739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771253_1127491136831072_8908636485818274699_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_sAEq7bsIYQ7kNvwFdAoMT&_nc_oc=Adp16e83OarzEyCBrFg2DcSfu69mbnXim5U1igqCxiVP7kO9HRCzqZQNLP3zpWL4tOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFmQaiHK-4hFN01s1yJiWw-RUsGiCjGRI6bdtThHU8uA&oe=6B105B2D"}, {"file_name": "Screenshot_05_Circle_Pause_2560x1440.png", "id": "1138702582398817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771295_1138702585732150_7343982115670483060_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg8F9IUg8MIQ7kNvwH-Imq4&_nc_oc=Adpu_ayaQVne3MntNG259mRgIx_uBdZbReC8kNwlaYYXaVg_Mbvd1TRMJw1W77w6mNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1FOZGkXVg6SbuHKkyXA-WIn0XOQ0QAmnEZ0XF-qjVVQ&oe=6B104431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1652135063625236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771278_1652135066958569_2784592227949186515_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG-V_50-lvcQ7kNvwEphg_V&_nc_oc=AdrzKbxzi4qX5mOXLeU3FK6dNeIv6SfhCmJjepcAmECJX6nvHycFNCPCvxeK-wr4ldc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0rAPYUjo_f3N1K5updGNmo-bZUFsAcpmI0r1msdW_Eg&oe=6B10652E"}, "display_name": "Reflex Lab XR", "keywords": ["reaction", "reflex", "handtracking", "mixedreality", "fitness"], "long_description": "Slap the lit target as fast as you can. Reflex Lab XR is a mixed reality reaction game: boards float in your real room and you hit the targets with your own hands.\n\nHOW IT WORKS\n- Pick a board: Hex, Circle or Grid (12 targets each), or Arc (26 targets around you).\n- Pick a length: 1, 2 or 5 minutes, or Endless (ends after 10 seconds without a hit).\n- One target lights up at a time. Hit it and the next one lights up.\n- After each round you see your hits, average reaction time, fastest hit and personal best.\n\nFEATURES\n- Hand tracking with cartoon hands, or controllers as boxing gloves with haptics. Switches automatically.\n- Pinch or grab the arrow handle to place any board or menu where you like.\n- Pause from the wrist menu.\n- Funk soundtrack with separate music and sound effect volume.\n\nMUSIC & SOUND CREDITS\n\"Funkorama\" by Kevin MacLeod (incompetech.com)\n\"Shufflin'\" by Eric Matyas (soundimage.org)\nBoth licensed under CC BY 3.0: creativecommons.org/licenses/by/3.0/\nCC0 music by Joth, Doge, Fupi, G_P, Of Far Different Nature and Archonic (OpenGameArt.org)\nSound effects by Kenney (kenney.nl), CC0", "short_description": "Hit the lit targets as fast as you can with your own hands. A mixed reality reaction game with four boards, timed and endless rounds, and personal bests. Play with hand tracking, or use controllers as boxing gloves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflexlabxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
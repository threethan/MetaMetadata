1-25/491823757_2702107596823611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrIzRivkDqkQ7kNvwHmSjGX&_nc_oc=AdrT1F0dJvYd80X972ftTZdKLfpuRiF7tTgvI5FmQmiIecfgDqF1wEh2B4Y8A2Tpts8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_gEaJD8BdTGe5Gi-Py6jMQXhAT7tn8g648ISckRGbYA&oe=69C3CFB2"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vupgeQUOhNYQ7kNvwHYzKXC&_nc_oc=Adr5hLFYbw3Rvu26Y7vdmQfz3s_ksecYofl5bG707_-huXoQueZy10uzNx7UDTt-jms&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyqse4IdYV7jcIpL_AwNadeq5Fw1vYsV-dQal1nI2rlUA&oe=69C3F209"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SSUGfpHgs8Q7kNvwFwyoob&_nc_oc=Adq9gjB3gt8a3AXmHxaARBTGvUnsaytzm4whr0OR9Jq1P2STCSeOtPbBPn56RluqU20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFUs4ejQsT0DOM5bW60vZH_3iM7apMGdHR9M4YyZn5qA&oe=69C3CF59"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoBjtKK1k8YQ7kNvwHVpe3r&_nc_oc=AdpVZAhHoj06iG_9CDDDKnOhV35pc5UHmhzRB-yi5onDEjkSijV6jNGW1YIeTZdcEBw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMohQAcPQ0qLZMs2LNTAmIycwtcKzhCYkI6tNUOdqZvg&oe=69C3D542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5BlJ1E6BQEQ7kNvwGqAMKM&_nc_oc=Adq4Lvy5uFGWCOP9oT4twin8vVuWx1q81U9a-5rb5tDlzsRrTuJjESeGxNSAzLLvyzk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxDUy5-07r7zmcLSzjksJxX_QJJuZKBSwV2-PZoUtqtA&oe=69C3C2B7"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"
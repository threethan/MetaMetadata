, "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34NnMtYERKEQ7kNvwFHylVY&_nc_oc=AdpdZck5AH1nRuX2aTKzvAJliYmzgETnnaDzuJwH4R5J9JcxfAt5UI28ZC5lyQGdoP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU1J7WwP3gfR-MlVCVbIe4nnOkdGue9tzW01HfQsr7wA&oe=6AF7479F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DspQLC1EF0IQ7kNvwH9H34k&_nc_oc=Adq0b0gWfeEjfMexs-A1itbbFapYqcQBMkB7ibG5kpYdTkGZQsm3nairXx-GRxUhRrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZOBZyTKyosU8SqnF5GXnJSxPW8Y-f4WtE7ZaYZzJ8_A&oe=6AF72DE9"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I45HondfI4Q7kNvwHnr0NQ&_nc_oc=AdrW4HpVWA-9O3nW6sPLV8N-t-sCuM5qyS19uCBpnWMByJxiwqITjtekY9uN3iD2o-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBL2DZbD2N99Nzv-Z5qIZw1tqeqnI1Hbt8JZWJAbnj0Q&oe=6AF73296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2_8MSfrilwQ7kNvwHvQ_TN&_nc_oc=Ado1I9sjzlOTkMXfSAhbZFqwHUSqfUof1n13koOGnIan3vV6Jz8kbbjMcj_ajkq6fI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdnbBtkYs0FAsXOL6RjEVJrAoO7WrFYWjCJeFTRjKnvw&oe=6AF72877"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"
ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La0a8Hg78V8Q7kNvwEz-k9r&_nc_oc=AdrIYI5vJJHSmUlWkhuNYWg--8ZeeWhXA3TNAB47o868QlHhxjvR_yBJ_ZkFA2pS78k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2QPYhIVMI_U9ilxy0hcYJd8YhWYKrdK771S4N9pl1Dg&oe=6AFB3D70"}, {"file_name": "ChatGPT Image Dec 26, 2025, 02_18_27 PM.png", "id": "755962197524137", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818885_755962200857470_3425473467943796473_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=411WUoBpRQYQ7kNvwEK2PQa&_nc_oc=AdrFozEMtl8MVRk_WJZM54w1uWmw2J-q3pk6hLf0n7gKka0hn6PNm-OIS9mQRSVy2MA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHChOxH6bV79-Vs-U3GLfIWE6S3SioTqnKHFldPRXHsw&oe=6AFB1E96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Refit XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Refit XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Refit XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nRefit XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Train your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/refitxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25238313369172300"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1850301186311380"}, {"status": "PUBLISHED", "id": "2320019148830758"}, {"status": "CANCELLED", "id": "28028423903491279"}, {"status": "PUBLISHED", "id": "1760372075042522"}, {"status": "PUBLISHED", "id": "3339503716437582"}, {"status": "PUBLISHED", "id": "2996225034054932"}, {"status": "PUBLISHED", "id": "26645952241692587"}, {"status": "PUBLISHED", "id": "1511159777104016"}, {"status": "PUBLISHED", "id": "936121258787119"}, {"status": "PUBLISHED", "id": "934566909390583"}, {"status": "PUBLISHED", "id": "2912258118972952"}, {"status": "CANCELLED", "id": "1214050846968283"}, {"status": "PUBLISHED", "id": "692066670507333"}, {"status": "PUBLISHED", "id": "1142578864618275"}, {"status": "PUBLISHED", "id": "873647138585938"}]}, "baseline_offer": {"id": "936121258787119"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797796800, "status": "PUBLISHED", "id": "1850301186311380"}]}, "
nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvufvssWn9Y2Ps4yp404lb0lcxJVLBapd0HAnk1ggv6A&oe=6B05BB69"}, {"file_name": "com.labvr.refitxr-20260515-122440.png", "id": "963743046573315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJhKc5x53MsQ7kNvwE7xBSI&_nc_oc=AdqQFFazekQ1hY0FXO2ew1NMoVV9g4bB9SW0ybWUk8FHguaKjRowvGLQp2v8pkA8CNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjanvEbXkyIgyjrqiL5g0ucJZnZvNcpE8znVLcdRRd8A&oe=6B05C81F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2ZmhqYM4y8Q7kNvwEm-j0k&_nc_oc=AdowmdOBbZA-1U2u9e4ID5P1HGpyWxYfq5EE-63vYHKPwhkOChPFdfnppouAV2HvtBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh9nFaOoOB4BB3uV_wF6Hrsd-Vg2yezR07FIfZCRjAMw&oe=6B05AE69"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjDXmCbCiEEQ7kNvwHuHdLp&_nc_oc=AdoZ9OSIJEtq64BLLpgGkgcukCP3K6WGqHxbI3VSfLVabHkBg5_2m-pTl1Cdt8Yjvr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyyqUC_1LQU9c5M1WObM6Kkd0LoQkOyYzsafTsx6iH4Q&oe=6B05B316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReflexTrainLandscape.png", "id": "1874057643786897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828104_1874057650453563_4553619126810934041_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEJY9n4DFXEQ7kNvwGc4ehc&_nc_oc=AdopjaFGwEg3NYu9o2OZZ2oJNMpzh4QnVh-pXzxur7Nc0TfU_EtKNqwRuoXeniyT12Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEejGMtyT9HzjIQ9IJXdRBfuooc_heOoNTCt1-8coJyA&oe=6B05D7A9"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
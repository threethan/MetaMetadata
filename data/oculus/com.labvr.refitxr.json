, "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34NnMtYERKEQ7kNvwHuOUZr&_nc_oc=Adp6N4A5hOXV5UoO7MGWm1n2KrdiTLKa4A5vOKwa72i0FzJgpserzGQ8OP6xYa7ICus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs6nxFZIllFKEFOyHfYKnIfnr6TosRSWcnLRr_Dw9XPQ&oe=6AF4A49F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjG3CmyIHWEQ7kNvwH9LHVx&_nc_oc=AdqPBEATELG3943WmVxQllDRfpRyBPFloG06x37O-rqn-kzA08Dhj6-wPMIxYDkMq3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1m8jK4gnh3xV3K5sHqPou6YXrRRhLRvat7E6ZQ4MN7A&oe=6AF48AE9"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_mo_eNMS5QQ7kNvwGvxaY3&_nc_oc=AdpyEDgs7LXT1K1Dkjza64EtgXS4Gks2FF-I2NQIKtRrKvN4LxT_aqBXIJgAtH8V94I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCCT6dLdaB4M7sbO8u2wH8xKY_a7WJXcoLAI55zdN4sA&oe=6AF48F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2_8MSfrilwQ7kNvwEUdXnf&_nc_oc=Adqyg8oWO8K3ZThsubqPaka1J3eNdWAQwUwHbjCDeAPvaHl2c9ZqDtsas8gd1O3UI-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4oEow9xu4i831PtsRx2Pk22u35c6GKwd87CLbsUqfOA&oe=6AF48577"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"
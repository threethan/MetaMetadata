nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8-DAQshOc9dHME02gZjntzMDocNiKQrO0dYIEm7FY7w&oe=6AFC80E9"}, {"file_name": "com.labvr.refitxr-20260515-122440.png", "id": "963743046573315", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNgHIoVBu4QQ7kNvwEmyp5u&_nc_oc=Adr-Q3aQElh3VgZAevDySPGraX-vGRsAlWxSHRMfL7gkbpHet-YjMJ1IEekFzGHTSN8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe97TqFcV89zqdWFMmuiSm1JFgxZ5a9tnbsWa7EhV5XA&oe=6AFC8D9F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_QmqxymhdAQ7kNvwHwE5G9&_nc_oc=AdrZ0AicpleqINlJQBolsnY6GBQQ9eX88eHobDI6zm8keAwIriGWW2GhrR4W8L71FU4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR46rLzzY_UngjqOYeIQk_Mix5jhwkMe_QUW2ylVflHbw&oe=6AFC73E9"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKMuYvMwgVQQ7kNvwHUv5vF&_nc_oc=AdqJHUVJuuyVRJdjPnYegI9Y274WI3YUuABwu1J8BLkkPa6RA37fCGOA7AMS5tG-BN8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjO1G3SeAeDzrEBKlRk4xPcISjNVxYZZ4dGe_1Y300hA&oe=6AFC7896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReflexTrainLandscape.png", "id": "1874057643786897", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828104_1874057650453563_4553619126810934041_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWym_k51IBwQ7kNvwHlChD3&_nc_oc=AdpGcb9Rbnvi5yRqOfSkZidQhS_Wgk2GUvGno6eACofqv6k4IGVv61ijz3aS2RBCaqc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNbTFK2oQ4hL4A90HiYk8qWjVRwjJUWb8QeMek_KMTzw&oe=6AFC64E9"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
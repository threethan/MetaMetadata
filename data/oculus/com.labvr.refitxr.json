1-25/491823757_2702107596823611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS8hs9S52AIQ7kNvwHpDk-i&_nc_oc=Adqz5cb6ECNL7EKlucMa6LrJ97hzXZbn5TYgZOuvRwWMiLGUIn0mRiB7MrTHrmLHjAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhIJNzLP2v7nWO_LZxorZBIdG11Ul4ie_hW8hbWrlAGg&oe=69CA6732"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37fvl98YN9MQ7kNvwHnyzmm&_nc_oc=Adqn4I-nM-78q9KWXmXT-T5izAPuGDHAoCUc0dKaLyHSFGzBTzb9p1zR6rDMuoUVyCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx18ko9kNFT4IYPsGVPkSf7cHvaKrmZCJ_GQ-nkx0r5wA&oe=69CA8989"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN-iVQvyu1IQ7kNvwEjfPxn&_nc_oc=AdqMWKN6HS-RlN9S9_jQB1vxU41dx-IbElhVRVBTCDBpcEappBS1EGEiiBa7VBC_fNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9a-TxNbU3cZ7LXA-JC_IxUlTDJwYaLG-UauAVO_Kzgg&oe=69CA66D9"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFd0mXNpVncQ7kNvwGyQekK&_nc_oc=AdpaaKH8jZneEQhQ9Nzxy1oWeeTYLmgAWw_u8ot-IfU2yuGAwZB6cL0Yo9llcMFjAPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz33f6Xi1Txbw-a_DNgXapxLqg4mb9oDEw_xx1STEASbw&oe=69CA6CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZrtBNgk7okQ7kNvwGlZN8L&_nc_oc=AdpERg9O12ggFSxFynMeUz6cQzvibJM3MiWwpKOpmRlcTWFWCZ0eQYP7vRtZaJIqGQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy20pK2VRyIMTlW4yOgVlQfXZEeWyoK0JaEx3wuvDlIPQ&oe=69CA5A37"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"
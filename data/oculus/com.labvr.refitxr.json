2071345517016716_3135079810610337833_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkR6zlJTDysQ7kNvwF5YUnZ&_nc_oc=AdoGF6stFRNFJBlYGuLJhRdFAtzbBROSrAOerB80tRFzf4VqXbEnYwRxcCVuy0KH0bY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVG7IzULUbWXIuqid-7cC54PmgiAUArWAgjizy11d0Q8g&oe=6B0F1561"}, {"file_name": "Screenshot_01_Arc_Hit_2560x1440.png", "id": "1127491133497739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771253_1127491136831072_8908636485818274699_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_sAEq7bsIYQ7kNvwGFXRI5&_nc_oc=Ado34zK0xn2rAxva5g7ESXSGR54LYVn7S4TU0mQEmGSrZMHRho592uohFdZvnGy_Kao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUttzhe2vi96TscJZfqdKywWSJdbC_D7h1MmxM5GGT8wA&oe=6B0F09AD"}, {"file_name": "Screenshot_05_Circle_Pause_2560x1440.png", "id": "1138702582398817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771295_1138702585732150_7343982115670483060_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg8F9IUg8MIQ7kNvwHfbE5G&_nc_oc=AdqR3XcU2B6cEvqp4ZeHDAD8TqpacXimVrpQgmNV7t3kLphEXQujSOznkcP7DTGtifA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVi6EC9KgdJ-6Whhc0glX8O7bh2hPwC-1-RRRv4G52yHQ&oe=6B0EF2B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1652135063625236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771278_1652135066958569_2784592227949186515_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG-V_50-lvcQ7kNvwFeLGKa&_nc_oc=AdqZ_f8Mkt_fQjf5AdFGB0aShnbYwM5_ZiOSEUyiFacrudnUTe0OkLm_ItjNmKRiPb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVB-Y52aw_lOpu2DAUsQ8oes5X92CSSnH-YMpdDkJYnYA&oe=6B0F13AE"}, "display_name": "Reflex Lab XR", "keywords": ["reaction", "reflex", "handtracking", "mixedreality", "fitness"], "long_description": "Slap the lit target as fast as you can. Reflex Lab XR is a mixed reality reaction game: boards float in your real room and you hit the targets with your own hands.\n\nHOW IT WORKS\n- Pick a board: Hex, Circle or Grid (12 targets each), or Arc (26 targets around you).\n- Pick a length: 1, 2 or 5 minutes, or Endless (ends after 10 seconds without a hit).\n- One target lights up at a time. Hit it and the next one lights up.\n- After each round you see your hits, average reaction time, fastest hit and personal best.\n\nFEATURES\n- Hand tracking with cartoon hands, or controllers as boxing gloves with haptics. Switches automatically.\n- Pinch or grab the arrow handle to place any board or menu where you like.\n- Pause from the wrist menu.\n- Funk soundtrack with separate music and sound effect volume.\n\nMUSIC & SOUND CREDITS\n\"Funkorama\" by Kevin MacLeod (incompetech.com)\n\"Shufflin'\" by Eric Matyas (soundimage.org)\nBoth licensed under CC BY 3.0: creativecommons.org/licenses/by/3.0/\nCC0 music by Joth, Doge, Fupi, G_P, Of Far Different Nature and Archonic (OpenGameArt.org)\nSound effects by Kenney (kenney.nl), CC0", "short_description": "Hit the lit targets as fast as you can with your own hands. A mixed reality reaction game with four boards, timed and endless rounds, and personal bests. Play with hand tracking, or use controllers as boxing gloves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflexlabxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
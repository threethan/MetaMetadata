1-25/491823757_2702107596823611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqVl_DYx1wwQ7kNvwExgjIB&_nc_oc=Adod1qUozxPNTQdHtgBAeXP-RyjFAVMUaXjNplYQB_tFHLt3EfzlZqZ6HVsAXAfcQbA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-nc34fiJfbple0tpA7NXAlKtQqcyOglqnlQmSXDvqqw&oe=69C52132"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSHixtyKDqkQ7kNvwH42G3U&_nc_oc=AdqOMtlEbnuK4vmQwmRgwCdzJ5x6OS87_luTmPu-Xwr8V9mJ0BvVQKWWKH_UnBJgaoc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNRH8M4paXi-uCZ3IN1TSWuSJChhZc4afIuK2DWQeygg&oe=69C54389"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SSUGfpHgs8Q7kNvwH0gbsZ&_nc_oc=AdrlSE3PuDVwg5bBarRrHoVISClryMU9uYhDpzA3mnYJuO1sCCNFMo4hL-M_4i0DePk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGMiKZB5ZtuuaZoYu-xe_ioGfl4WFEuyKXqzpLw51h7Q&oe=69C520D9"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoBjtKK1k8YQ7kNvwGJ0KJ5&_nc_oc=AdqrJ22UX5adhSeTimBhlJjQKSqpJQCyavEbjWlWbc_3BEnydhaB6oJEvOoqZRXWY6Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnafwH9FrgbkB-kE6Eh5sfhiFlBEYAafo2qJlPseicBw&oe=69C526C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5BlJ1E6BQEQ7kNvwE7wkPs&_nc_oc=Ado_bBXEGOI0NWuJp0U62rEWKFsBxhULW2OAAeBP905es8rD1sSmILtw65CSIL0rqzA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjoCD9PPTD1q2UMkcse415BUXlpJsAureFEHMvbM0vzw&oe=69C51437"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"
3764460688_3695065618538864201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYJUQftALHAQ7kNvwEo7wJ2&_nc_oc=AdoPwhXcf98rPMNciY2lYTJEdAz_G6gOMO6WmSBK9w8Vkfn9ZvbJ3ovrly8MlNrudMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0MBNCNGFDbNYk3hAXCWSIjYbz-dFzy4A-Bdg0iind4NA&oe=69F0A9B1"}, {"file_name": "bba2f815f95933f8b5a6c067afb1375b.png", "id": "887576637020781", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827973_887576640354114_8341346893325234731_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxxxgPjgiLAQ7kNvwEpYuEt&_nc_oc=Adqr2JKOERbZAlntU88wtOOQy2EHlD5790SlatLphpRBDaSSn6kuKuybZlPh0f179nA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2QP0huQl8YzpLUfUrt9M8TuOHAiM5SYS_jtSiygzhO-A&oe=69F09E55"}, {"file_name": "ChatGPT Image Dec 26, 2025, 01_32_46 PM (1).png", "id": "1200443228945633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_1200443232278966_295284920760343079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvLQEIVD0tQQ7kNvwFpbrJU&_nc_oc=AdrTLx8Snq7hCTz17TLuK9Ht7OMej4vLJG9eKyJ5vkdNoLA2Pvl2OfoNibtlK1v47JM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1alaZ0krgl2se2IprEJJty4v3PXz1Uqx67iMAlocYU3A&oe=69F09F66"}, {"file_name": "ChatGPT Image Dec 26, 2025, 01_30_55 PM.png", "id": "1512247496733003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_1512247500066336_223141300308722407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCVL-v6yFecQ7kNvwFE2cXC&_nc_oc=AdqwjQKOPJWC2oAFiRQkhgGyFp8Ww_CFAbGmwAFYjA93griFEngjtAb0evbCF7rd3qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3FGU9NJ7cYpmfmgzj7dRHapPXz3HcymC3ziA0NDW1Ywg&oe=69F0B630"}, {"file_name": "ChatGPT Image Dec 26, 2025, 02_18_27 PM.png", "id": "755962197524137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_755962200857470_3425473467943796473_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF9kBUuLnFYQ7kNvwGQNAf6&_nc_oc=AdqTiZPlRYFApCbQo7p9MPzBl8qq4fkzWdv0ZGZe2ygOitoYVzzM1AESL98Bp-aQnwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0aCQWDkyDRkaj_kpdC2K0BOzjoBPy9n9_UYmvAOVqTlA&oe=69F0CF96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Refit XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Refit XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Refit XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nRefit XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Train your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/refitxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I5pVGa709gQ7kNvwGYkzy3&_nc_oc=AdoF42Okrv-zsFYDa0pT5rSlnfeHZW3MPw8g9xX9WadkuGi-556nBpekkiK1TB3tVu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXWYKJldKaBHuwzOZEMpzvNdVrmn4oCfDlrMHlqZ3fkg&oe=6ACB8DDF"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4elqbyQTJKUQ7kNvwGXm_Kq&_nc_oc=AdrveG3EoeV2hQI15r5BZJ_QDI467o7Rn5er9JzvpTZ5KOTWa6HH9aEeWDIMGcrcg2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7hYgc8KKrfjQ7quO_RD3eEVOE-N3HJTid9yza0mV-KA&oe=6ACBAC69"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb-jgidW-ywQ7kNvwH5U2rh&_nc_oc=Adra6794OtYsTgNEl7zPcrPqzcMylXmdx6_hSMtHkxx6vnaxNAwSbdtYjHgEOT0T5FE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNctpdOeuANRkkyDObgl_67B-183lRdMwyrBCpreDdAaw&oe=6ACBB116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbz6uHO3HVYQ7kNvwFZ-MfO&_nc_oc=AdoI-Hc2rBpYaBFqTUBOQvJ_n0uc7kMALJoohlLjkCWD0AU1aLbLSPSliD3raRNf4e4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpB3cmloEJ5CmT6iFVPyl7d_YKbQumCnhsRCvIQ1VwFw&oe=6ACBA6F7"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27120902794246672"}, "review_messages": 
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csgtZa1tM4cQ7kNvwFDy8sv&_nc_oc=Adp5KTB9gvB8oM70nTsjjt9L7tQ1om_qVAaIqLIGOhoiU5UbeiAyE3aoY2u5Tu8go08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc5lyyTCgH2sOPaK5LiOtH5qxk0SEUcyYbhLfyfvjC0Q&oe=6AE49A5F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p-Go4hScoUQ7kNvwGYrEKj&_nc_oc=AdozyEZwDiE5u1WpJZq2MjcFx5ZNN3xcl_GrE_hF2ceVp_VApeWZ1-p2wgv8YL19TzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE4epvCvTaSyjmoSZZPffz7Z-6B0a46672cwDenNfLWQ&oe=6AE4B8E9"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GniQz9B9D8oQ7kNvwHJ8MMk&_nc_oc=Adpg31OH9D8D0i-HdD6FHlCmlNxzrfHzMRNEeyB05WE_AFBHhDvQPpYft7tbf40g4_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa_tjWP831Fzp34k7uaw40Wive9KiXLZ4bKoplQyBR0g&oe=6AE4BD96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4qcRWEprB4Q7kNvwG2RbHP&_nc_oc=AdoNRPrVbmyxp8Qjq2S_rXoDOzu1qo2abBr2SuSw-NBv2xS0YfFAqYdQsPfRB54cSPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0x8O0YkKKgPGMNeI5MR6PbzbBVeB72pz2-YSEK0eUXA&oe=6AE4B377"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27120902794246672"}, "review_messages": 
1-25/491823757_2702107596823611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrIzRivkDqkQ7kNvwG9qyVh&_nc_oc=AdqpmyDHm5z0vDNNAVXgkz9LEomKieIrwQlWS3XH9KAkV3r6SfxsM9jzHrEsRVs7hi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzc66WNGd8ukbA8HxN5byu_jvIpgNdt1O4LorF7Jjbb7g&oe=69C27E32"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vupgeQUOhNYQ7kNvwHrwgQA&_nc_oc=AdopwH72zhnK_u3f1ygb4dWxqmo_BdtkTHAEzQkE9vhwvINdkFZqgSNIkikasezy-QQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxokZ9EnryC1p-56TUp-gO3p8AuDyG-RnxBFAfbDJsC5g&oe=69C2A089"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T0UG7wgP7EQ7kNvwFPzcaF&_nc_oc=AdpVcs0EEebzEug1nLkfjgMJVcIhu-AhrmF7n9_C22AkbaGMnjCiicpySatNn64lvfw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTt_1aMYy9jt3zNeZqkyiI2hOjJen4Gr7YKKaQJ5A9ag&oe=69C27DD9"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBGppgzrISUQ7kNvwFuxQDi&_nc_oc=AdoBTZ7EOMcSzTdVW5oUl60-I4ihcSuSHXZN1yptSyVegh4cUFUgJDvixJrAyt0qsxo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCM3BER_xN8zP1Z-RvMjo5bj5PfBCZr4wmc1og4rPlkQ&oe=69C283C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Iilc50FLyoQ7kNvwEJgMjI&_nc_oc=AdrkbTSjj2iyjdl3fJ4aMZGiUaQOa-Mg49FREPYEfzc1o_dQ4B82XnlOJFbwFrpVxoc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbsH1UUTCz1LO457AREJvDoj1Bu4KZgSVymOxK7onNdw&oe=69C27137"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"
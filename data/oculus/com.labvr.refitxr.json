15468", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuCpGqH0lHoQ7kNvwE8XiCT&_nc_oc=AdoP31wE4IG_OuZpiaj8GteJuHa8X6iRQWzeYGeC0dz44N4erkgYjFyk0eTIiQ5ZPqE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BPWWPnG2KJ6JV6K_jy-RuT33m7vv_alDDmqVW-SBnBQ&oe=6A0C8A19"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjx-VCSPiOUQ7kNvwF-fudS&_nc_oc=AdouI6Nuc4ICDN5n5WmnJ4MM0gb-vK4Q5xETRA3MximMTURTNQTrRjj8Fx9AeoEpACk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qR6pBvPkapmDDG5PzvYHHGVNoNyMmP0hXSGMTccF_NQ&oe=6A0C57C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI1R1r-UHB8Q7kNvwGefZ35&_nc_oc=AdrCpf6TqS9SCZ3ShvDX4X47ifklP_1l0f7ETO7haCX9J1QD_j4PtHt5Tl21YMpkB8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AYUWKo_o2Ro-FbLwNXBrJGLCTFaJzaeYIEpVDFxuPuA&oe=6A0C7D77"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26479494311720860"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822307_1512771500653335_6466542680410496303_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-0FUSN6y5gQ7kNvwGs_QIV&_nc_oc=AdoVcBefJAxz0VCH14M0F8BRsH0f3nbKvWeGi-B15ZJq3qcuCjiQbEyrvgRIV_tofxc&_nc_zt=3&_nc_ht=scont
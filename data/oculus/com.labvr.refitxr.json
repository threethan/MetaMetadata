1-25/491823757_2702107596823611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS8hs9S52AIQ7kNvwG_nTQ1&_nc_oc=Ado0fvG_0iQplisMEAmoz5OhxwPy_0GC7btl8MJFopIyKzsD-QrFhhmMjJHWh4jjW8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytNuTqdy0jJ2G30Ud36nBClAPNIQvQwhXfZsZTqmzIAg&oe=69C915B2"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37fvl98YN9MQ7kNvwGx1G8m&_nc_oc=AdokjSRdJh5jm6uaRsikEBQObt_E-j3Q8u33AVIaC7vunZMqnJxVuWE184c3F8bWZl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgbYz5KfxWOljQ-Zlo_1L253AgsEa2IVBimGrPKQ4GEw&oe=69C93809"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN-iVQvyu1IQ7kNvwGjNjoB&_nc_oc=AdoSsbA_BcQ--0M91J-CCcN8F0GWMTJXUgEYb6Xme6XhbIAl6NewSftSC6jGQ6WVRTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAHvP4TBTN94HCymA7YyEwkzz6Y0sVdXT-Wo_--ZVFuw&oe=69C91559"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFd0mXNpVncQ7kNvwHgNkL-&_nc_oc=AdoeYOdgGSi6HATPOrOw63jzQBQtky1qIL4d0XT_XOuFPzNQJv6rPcCfC2j91F3OJ28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHy5TWNox01Vw7WYJpYfuFBnFD9KM7vUxl9Noow3u8OA&oe=69C91B42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZrtBNgk7okQ7kNvwFWPnMh&_nc_oc=Adqmrt8YmOnMY8eBG9HyY2zB7uwQJikfXHnOUhcXr-VaXlAi_ug7OXvgmJ7edanGDMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwhh--WV4g7u7SUukoyaW8635gnXMND9PuxwV1nFJq76A&oe=69C908B7"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"
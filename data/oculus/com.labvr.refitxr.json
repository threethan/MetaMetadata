6e7a0a&_nc_ohc=kzqOCItDKqYQ7kNvwG9BkqN&_nc_oc=AdmycHYQK4GtEPFJ0L93vPomtY-0vfGgNa92WKp0vzdAVjQEoMtl4Mu-EfKWCkT0B8k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvkKnIqqTajmV3S7V3evXA3h04UqrovvSa4ccTZ5HX2Rw&oe=699C3E55"}, {"file_name": "ChatGPT Image Dec 26, 2025, 01_32_46 PM (1).png", "id": "1200443228945633", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_1200443232278966_295284920760343079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIOVHiS8nEQQ7kNvwEZNZzY&_nc_oc=Adm6RigYDcOWSvXW89f3Sq45QTJGmdtxaH3X9vwg1uVtg9SQQi-rtX6QhGLLc5cP1Z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afupqg76VWZd1HUw-5tjRZk89DgFVVO-ouM8-j6iD3Ab0A&oe=699C3F66"}, {"file_name": "ChatGPT Image Dec 26, 2025, 01_30_55 PM.png", "id": "1512247496733003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821782_1512247500066336_223141300308722407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlGtyECRAycQ7kNvwFCfjO8&_nc_oc=AdkuugsnQF15DzJSt-_dU0XqVBWwPPittfVJLBHAQBov41C1bBsInf79h_Gvs7m1ryM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu62DtY2WLiQwI8znSwP2hiJz4hI9bXv5ydAQdLMQs6nA&oe=699C5630"}, {"file_name": "ChatGPT Image Dec 26, 2025, 02_18_27 PM.png", "id": "755962197524137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_755962200857470_3425473467943796473_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn7oMMIQuokQ7kNvwGTyOKM&_nc_oc=AdmThk3kOLJZsEbcTJgatDEfuoB2nOHtVulQB9xgfohv-zpH9zPo0hmUD4UB-y1OWwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuDNh1SDmTPgjPZTALT3bISat8vbwtzZkfyXmy9mzLOPQ&oe=699C3756"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Refit XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Refit XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Refit XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nRefit XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Train your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/refitxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25238313369172300"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2912258118972952"}, {"status": "PUBLISHED", "id": "1214050846968283"},
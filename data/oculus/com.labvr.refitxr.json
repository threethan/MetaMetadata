nt-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUD5kBAhdZa11rSADY4GnQSesflKqS6pWddZONniD-9A&oe=6B085E69"}, {"file_name": "com.labvr.refitxr-20260515-122440.png", "id": "963743046573315", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSQlCzRJyC4Q7kNvwHwii-V&_nc_oc=AdrCf41xk-zsHAoVaDD_4zBQIvNh1O-G7n3R7BKmgnFjpkGDhvPCfE8JOdBkiwcGv4w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThqOJnu8_1FMBdzxrLfLCjmBwgYrlRxDr004kVZR7utQ&oe=6B086B1F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqV1VTcfJKEQ7kNvwFsYJFu&_nc_oc=Adp5vkdzw-yUT9x2s7czdfQbXbwlHWn-0W_ovp03-5_3U_1hhHryPPIxVNW4GH1nVMA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRsVsm_Rxp88vX-JVv_dybtzcL4eJcedJzwYta7inRKA&oe=6B085169"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YU01pZ2DMFQQ7kNvwFsbvhg&_nc_oc=AdpVSLymXArzID5i-62hciKu1KkYjOw3kDmotr78F2DAm6xMge16tQ8vRo03NCQe2rM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuUkral0vYrJYzXe4KNiMT2CXr32BCljzQyqrkoeL92g&oe=6B085616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReflexTrainLandscape.png", "id": "1874057643786897", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491828104_1874057650453563_4553619126810934041_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEJY9n4DFXEQ7kNvwF95jvQ&_nc_oc=AdqHIP4OCzoTuaC72TxM9Ns5y6L-L85wC0FiS7_m2QWY0sCdAzpKPi0XmMil46wcaAw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz-7n_b9kaPLZ4C_9QkRksSWVm1jwogVnwIF34JoFnjA&oe=6B084269"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
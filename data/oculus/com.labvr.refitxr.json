", "id": "963743046573315", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVqIPW-9tiUQ7kNvwEk7Uf9&_nc_oc=AdpfYsGTPuK7lb0HHUQgFgYl3Hd4Zi805Rya2OdTe8yJEV1gdEqlKTkQBpbU7GlCR1k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LQjj9O9-mwRzymL3iJt_LnGW0PlXNH8l4DDADWv4ClQ&oe=6A11AA5F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNrqJiazQokQ7kNvwGErXYb&_nc_oc=AdpXBoBg3KFsdtVEmq5iWimkM2OCqmqoGBFFUTGG5XRl3p17YNQoUmcrpUKcuX9pn6A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75yroD18prvhWJ6DJXY4o-8xfT7gEJfuULbadTfPFQCQ&oe=6A11C8E9"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY2ghZJaEk8Q7kNvwF2XEuS&_nc_oc=Adoh4We8MEU_L6-WZS_XMDwdrEs8MH7KfGLyGX1gooF79TpesZfdYtoZMUwYJVUHPb0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CLgUM6W28S9q1mwDyA8w3Rl4rvrFf6-OOcs_3PIc3lg&oe=6A11CD96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyvGKpJs2LgQ7kNvwEHX_Kx&_nc_oc=Ado9J3EdJB3PQeOnwenSalqsmrpv-nu5NaTTf4VQdTw3y4_0TIRythM0yVb7Bh_HeKA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M9y8TYo37ztw8IpwsJoW5botsKLbwMUzgvOMfefezug&oe=6A11C377"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_mod
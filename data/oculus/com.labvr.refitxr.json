1-25/491823757_2702107596823611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS8hs9S52AIQ7kNvwE6x23X&_nc_oc=AdquSQ2VrzhCd_h3pPOBFQ_YKHg7LhEAQDnVhr4SlhoUsOnQCRGvrmOfEIKMuH8TVFM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwATevQqpwE_9YfV8GnzQz6-I_4NSSqZAT8Skfd3-4UnQ&oe=69CBB8B2"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37fvl98YN9MQ7kNvwG2VoFZ&_nc_oc=Adotm02v0NE367attUZ5PDHZIV7J5LvplQOXFdMYNSkzXlRyqiN7Ky3nno8C9X-gV1A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwC252nf3IHe-IymOnNfCfg71z2dQoSVLbDFBYpQMpZMw&oe=69CBDB09"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66s0CQv4_jQQ7kNvwE30Ml9&_nc_oc=AdqdXUyK2TaFALZAuP2CBTIUDclteVfxYphW9HvH9aztn2iejzb3UVjRVqFvMAKSwR4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTQ-WyI5jL-HPWP8N1J-QUwm8kGDM-0zObgezw8mx5qA&oe=69CBB859"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCqIz0f7UpkQ7kNvwGoLlDu&_nc_oc=Adq_ACe6HRgOmgJq5MG0GeBBrV0tUFguxZG4Em-bN9UbUQtIYgQkmBk0fO7EmdOeF70&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZIsJM2PYdfbLqANd80fhp3dEyfN__yKmhW1DW7CG5BQ&oe=69CBBE42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMwFnROmK4IQ7kNvwFI-lzN&_nc_oc=AdoeChiXS7h5w4kxbw5zety4x1WrI-FKhM7Qg7QkCXPLSnMLWjVr0okvNoTj3RGoMLY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwISV-t0KEyOAgD3inKCEoYWpPU9Hz0b2pceRkhoaIuiQ&oe=69CBABB7"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"
tl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzq105WC_7pCHRfP9AzdB1ad2ji5eU0z27ZUccZTNHSSA&oe=69BA9AC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuPLJ-SttL4Q7kNvwEKN9iW&_nc_oc=AdksfqssiposhAoqlKXsSMTh4JxrnOyOyXLWHXtJpnw_SkNChs0WLgd4UfkZwhHSWzY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJB9WhA1xUzmWsUQNVNw0vUhlWDtn9hiKTltPEdB9xxg&oe=69BA8837"}, "display_name": "Refit XR - Reflex Training", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Refit XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Refit XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nRefit XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "- Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/refitxr/privacypolicy.html"
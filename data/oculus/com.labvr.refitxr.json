nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdeskpnD8P50jc1V7QEGUgW-66pLbYlZaoL0tgX1ftCQ&oe=6B0469E9"}, {"file_name": "com.labvr.refitxr-20260515-122440.png", "id": "963743046573315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJhKc5x53MsQ7kNvwGYYWdv&_nc_oc=AdoKD-8F4xXsw4Jq-WcABYhJaNh-s1_EzkfzEd9dMc8jISseg9N1-j6RDv3hv9Lu67c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTugcXpWaxkLKO8ymywHGSojKKiOJzTqBe4G61r4RdogQ&oe=6B04769F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2ZmhqYM4y8Q7kNvwHjpD4A&_nc_oc=AdpjPpkXIzj-zAp6r_BLmh6RDJOvUcnywCpILFJTpttZpVqYBwL7-2BtxMOtuaQH3bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOrw1ydukIno12pxuCaugUizgp33fDaMqwIq8RxrZCqg&oe=6B045CE9"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjDXmCbCiEEQ7kNvwGLQ309&_nc_oc=AdoIIRWRVNRZy4TgYto8LLG0SGzgGPzzIBXSXYi1GS95VJpk3RPL7cnAiL_NXTNJ-eg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2AB981hyVoxh7x0LW3ueo3L1p5x2g15DM9VOwVWR-SQ&oe=6B046196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReflexTrainLandscape.png", "id": "1874057643786897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828104_1874057650453563_4553619126810934041_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20xMKBW39rgQ7kNvwExTgTc&_nc_oc=Adq62D7RoZXLWeMIlcFHOmkS-SCyseT4eQTeMKvRmacxwu5S_Q_19h3BH6DDF-m_-J8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkjPywOAydXdmWByel2q-gVxc0PaAm0URgME_0gryo_w&oe=6B048629"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
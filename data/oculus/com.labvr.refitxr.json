611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrIzRivkDqkQ7kNvwFK-qoa&_nc_oc=AdrUIxropMih0Xao3mMORts6phRutMs6Baso_wACy8u7k87ak_81OAVgUmJ26iLv6gU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8kJpupVlIijy48dF2uu_OQZnEuBy_HJ2rmdZDlLB8xg&oe=69C12CB2"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vupgeQUOhNYQ7kNvwHtENRW&_nc_oc=AdridQAjwTQmoN-KlPxq_kC00_aBkyPJ4SQo5YqCIhnqTsVy7gHyE4ErOsoNXDKhPQ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDo5fBBGkkSMPYSHBCZ6LhFbizLJtSG4lbURN7ypIURQ&oe=69C14F09"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T0UG7wgP7EQ7kNvwHXoOfI&_nc_oc=AdqnYMgAjjxRInEH0_4H4BAOp7FLgNrWudDY2wf5YM_I8KuP3pqqL9BncsqX1FKHo10&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfysY4YNvt0OiOGPJwvDuD0H_DEtTJDkxftYEmFZDTJo1w&oe=69C12C59"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBGppgzrISUQ7kNvwHP_xkK&_nc_oc=AdoRoSD0GcS4F0SlRF-NNRzfH1UbIm6gUEXEejPqQdx_5hrTaWedF38L95W1NY3XwuE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfypV2_7-NdReIy0PjH7QOz6nnstCwNWP5kmXopMIcGrUA&oe=69C13242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Iilc50FLyoQ7kNvwF_DUYD&_nc_oc=Adp22VWTRuvo5jeyUZpjO9WtQErgdClPEBzIwfOhaXkz0e9bfy88R5Hx1_gdl_SydAQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4H9FfJryK8Ktmo0Aby7ofCBRfFl88F3MlRmiAb2zCqQ&oe=69C11FB7"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED"
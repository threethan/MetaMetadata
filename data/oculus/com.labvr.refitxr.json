_ohc=8R2EsBcfSPEQ7kNvwHDOOha&_nc_oc=AdpkKV9lro1rYrZOOMlf-7SwRCfdpr7EIYhON004pDEP5PIWBCQ_wTAuJhtJZs3MzS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmn06-se65tV7i7WylMUKPr5l0s5ZIbvz3ciyE8UBGLA&oe=6B0C52E9"}, {"file_name": "com.labvr.refitxr-20260515-122440.png", "id": "963743046573315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAHzM6Gts58Q7kNvwG4naYn&_nc_oc=AdqdmOsgXFJwUrkQhZzuXFXcnfUQbIs4QmRrODXmXcCugXtNvMhM0i5tBcYjQx-Wg4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqEr0xmlfh3b9g4merQs1-AWPSNffoBEE-uKb-wcdgIA&oe=6B0C5F9F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHHu8umSvQcQ7kNvwF3XDEF&_nc_oc=AdpQ2K5I_hiiMLDKWYjjvAflJ-1Rf1L4ne0oFhB27QShIvZFPALfBwTIXelGN8pBHN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyUsO-NJ2JUISG9JGCGtOnI9Bpx2EaFwPA9nM6Pze5tw&oe=6B0C7E29"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD-s-oJL8YUQ7kNvwF4YWl6&_nc_oc=AdqJaNdDjrHf2jLGt-igTiKQtHsgQSXZGjL3QPPeocVeUyprm1wudR177XBFybixiIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHSgGvQNtI9-ZvBuE94s0mxZPQkXIFCa2c0t5sSm7I0A&oe=6B0C4A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReflexTrainLandscape.png", "id": "1874057643786897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828104_1874057650453563_4553619126810934041_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ_hcE1OZaMQ7kNvwGFdt_4&_nc_oc=Adpmx6fuJ3xV1HmaCE55OwugUawNgUEhK_8YarkE0074V5gKNQ_6K1hBLDSRolNe_54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEDn_mffzk25STtcMURY9i4ILqflG8C3jlM87D6al6Lw&oe=6B0C6F29"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000
40354114_8341346893325234731_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOGcCzOh3poQ7kNvwEG1-KO&_nc_oc=AdkEJvLwuF7lmr84cjV9WkpmuaR1ojnmOg0mAjk_JIH-sQVfx02oXywmCZ4Hw5ZosA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsq33o1BTwnEYjq8Uuk5-mpyVWN2kA6WGNnAsjLAq1rmg&oe=69A96D55"}, {"file_name": "ChatGPT Image Dec 26, 2025, 01_32_46 PM (1).png", "id": "1200443228945633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1200443232278966_295284920760343079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ_iJysnD-EQ7kNvwFw9DR4&_nc_oc=AdlE2r_CtZ_IjQg30JoUOjxkLWg5Qv8kYsGHG_OcaSmOQZrStk8_bbyK3H-Rya2ObVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjBkMIm12OzFlqkgI00N2Rj9LCe44fCkJr2IGnjoed8g&oe=69A96E66"}, {"file_name": "ChatGPT Image Dec 26, 2025, 01_30_55 PM.png", "id": "1512247496733003", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_1512247500066336_223141300308722407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAK_ID35drIQ7kNvwGpGRvP&_nc_oc=Adnmu7a4q9XHjuIdXaR3Mt1pTmgtIT8roos0zqzg6Pca1T7VpvJd4eNK38lVRg-FCCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvRrbRcrmCpbaUzWipBDQ7BvdheNPvCtGUzj82fE7CRow&oe=69A98530"}, {"file_name": "ChatGPT Image Dec 26, 2025, 02_18_27 PM.png", "id": "755962197524137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_755962200857470_3425473467943796473_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1xA2mlHBc0Q7kNvwFEq6qJ&_nc_oc=AdkvLbdzJyK_8DMASyN25ACA-yMKTf_8xtuToUyQdqbMHCIQrA9r9aFpMMizjSg5nz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftqIU0fOFOAeVixpasvJIkipZvYIU2Oveeeek_X50TNQg&oe=69A96656"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Refit XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Refit XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Refit XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nRefit XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Train your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/refitxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25238313369172300"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"
nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8HqCSSj_Emj_Jw5lkRXzplyPq7UsTlKQ9X1kDq74pOQ&oe=6AFF23E9"}, {"file_name": "com.labvr.refitxr-20260515-122440.png", "id": "963743046573315", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824307_963743049906648_6215053807610514901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNgHIoVBu4QQ7kNvwEpUK6r&_nc_oc=AdrAvsMSUFXTFcDFzdhnbRur7hsiMul-vnAUMLpFqau-R_Urd3F8WofJt8Ig0RKwLP4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrN5kgPhmvyfivQTfmPkb7_GidSKPYMdnpb6bN0dZfTg&oe=6AFF309F"}, {"file_name": "com.labvr.refitxr-20260515-122125.png", "id": "4447258572170149", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819323_4447258575503482_6603205681850543903_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CdLupEU6tkQ7kNvwGMZkb3&_nc_oc=AdrBpporO20zFI3-3fH5FqJ2LGTyXsN8Qaa-Sy3SrH_XC2QULs_eL4BvmINqA-0yif0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjCdhCQ3kUSkRpiKFRfQFYlq0X50zAhNV5FiFggdD3Rw&oe=6AFF16E9"}, {"file_name": "com.labvr.refitxr-20260515-122305.png", "id": "1612375423204627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_1612375429871293_6997282124026144241_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Infwm009Q5UQ7kNvwFPURrE&_nc_oc=Adrhn4sCnW8cGxAYLpCB5PtWTA2ivoiJ6ajBTAzqLlAgau-c_s5DORfkKg_4R3npmcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6HuTiePgaqQ6k3oUL0o8-Xu_IEi39oR1ASnGVu3SqPA&oe=6AFF1B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReflexTrainLandscape.png", "id": "1874057643786897", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828104_1874057650453563_4553619126810934041_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=991pD1yOrwoQ7kNvwF0mgNK&_nc_oc=AdrNTdKFcMdkIYGwJj8ZqOnwLHuSgj6CG9Vd75eR05l-wIFKKD0hUPNLohXEOIF_UyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUJnZuiO3lmWo1xtecvFLi2NBRSts2BBE0dQLVBDagcg&oe=6AFF07E9"}, "display_name": "Reflex Trainer XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Trainer XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Trainer XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Trainer XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.\n", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
1-25/491823757_2702107596823611_1400324716514486075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqVl_DYx1wwQ7kNvwFwUY1q&_nc_oc=Adomp8hjojyVaXYNIjznmNgeHIqxM_gyTkRrHR70dKcyxjING8SOG7MM8mWvU-UcOnU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw63updAPvVQya0y00eEvBMg3ebMw8pkQx2Tr5auEzDSw&oe=69C672B2"}, {"file_name": "com.labvr.refitxr-20260127-155053.png", "id": "730607986540028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_730607989873361_7466671200556127136_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSHixtyKDqkQ7kNvwENAQsk&_nc_oc=AdonAKoJG5P2vUs6v_KQrUbUyoz12lWoNfd_yGUPmMQpkDHdoRE0qTvo8AKlQn69c2M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8vMTawD4Risl6KSVWA7I0XMOeLIE6FZ660t_UXp5iMA&oe=69C69509"}, {"file_name": "com.labvr.refitxr-20260127-155005.png", "id": "1379924497215468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819356_1379924500548801_3403935029594739991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SSUGfpHgs8Q7kNvwE0tNZK&_nc_oc=AdpPpld9AD2SazCw1H1gNc337XfZkhCH_U58hanBEsauoSmBNyU_mKzTlZxn9LfdG1g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH-W_TQqXiEt0Xfs5l3Mri3ghIpbkrCe8df4UFcE1p3A&oe=69C67259"}, {"file_name": "com.labvr.refitxr-20260312-112010.png", "id": "4367282183493050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_4367282186826383_5818431220443269635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoBjtKK1k8YQ7kNvwHstj1I&_nc_oc=AdpeJSkomrTiHKgAv7FVHXF3oatCsGNH3U_WmJgJ_BCtp-YOW4wDJmOLKm3hGL7Mjmw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykxaqfHRKIkAA8z7ziSi4xZKOU6J7QsZxvYqlT4qQtEQ&oe=69C67842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2e118dbec802987f7243edd2a33e813.png", "id": "1408106670751025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822550_1408106674084358_171347241145516321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5BlJ1E6BQEQ7kNvwHQ0IX6&_nc_oc=AdozWuEySMmVocQfaFsFL-uMFt0h4WB9_oR3U0_JD2WAdbITviItmB0t9ve4u2Vwqkk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPbJSUGGfYPsHO3wNsdeDeOW04-_1XnBqpU6MmExbnFw&oe=69C665B7"}, "display_name": "Reflex Train XR", "keywords": ["reaction", "fitness", "training", "simulation", "xr"], "long_description": "Reflex Train XR is a fast paced reflex training experience built specifically for extended reality.\n\nWhen the game starts, targets light up randomly in front of you. Your goal is simple: react as fast as possible and touch the correct target before time runs out. Every hit counts. Every millisecond matters.\n\nDesigned to feel natural in XR, Reflex Train XR combines physical movement, focus, and timing into short sessions that are easy to jump into and hard to master. The experience encourages hand eye coordination, reaction speed, and spatial awareness without complex controls or overwhelming visuals.\n\nReflex Training XR works standing and is suitable for quick daily training or longer focus sessions. No locomotion. No artificial movement. Just you, your hands, and your reflexes.\n\nPerfect for players looking for a skill based XR experience, light fitness engagement, or a fun way to sharpen reaction speed.", "short_description": "Updated Gameplay Visuals.\nTrain your reflexes in XR by reacting to randomly lit targets. Touch fast, stay focused, and improve your reaction speed through short, intense sessions designed for both seated and standing play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/reflextrainxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"
-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F5oYU2vsewu3pAs3Awe_WWGVufKnJ187bgHqbyVlnGg&oe=69D78C5E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWQ4I6sBE5EQ7kNvwHixEdN&_nc_oc=AdoKhNsFnZq8SYg0WVxMmoymnaM5pS6_rmRmicMpfx2iPA0hRnXlCul9ceK4rLTnaeg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xPgYjusHeaKgHQmq8xFykG8Re6CqMdripefePva8XPQ&oe=69D7B6FC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1pYki51eqsQ7kNvwEpT8LG&_nc_oc=AdrST-ni9HpqeICFktNSBq7bfUV02ruT9hEvk4a56100O5_xnmtUig0GHVao0z0XWaU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kEVj6RqBCaXlxZARlm1PBhmX19nNPLQHq9cbWTxhJdQ&oe=69D7A944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK_LT8QpecMQ7kNvwEhv9k6&_nc_oc=Ado0BNh2iOHy81CBe_ZWzkEZG_uiiL7OaDqOF9avs6tvmHMAwdOPzIK4ExNbCU-SlB0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TZptOfRDLc2gi6_FFgFE4LkCZ2IxuSYtm3m34aA9R6Q&oe=69D78897"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465571575096919"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "979529176182955"}]}, "baseline_offer": {"id": "979529176182955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1626472500, "status": "PUBLISHED", "id": "979529176182955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24835448139429748", "version": "1.3.0"}, "id": "224410712448001", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary
97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Pc2inWwor0Q7kNvwEQE04A&_nc_oc=AdozbiWNZdWjuHcv0xdCekd-HlhnpPIHkVdlgS6PhSSN1RFIAyccoadiYENrAqujLqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOssT1gwITxyprjzF3DWbQDpIMYYn6vKnqQ8iyFFw4T-w&oe=6ACBABC2"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYlQKPw25qwQ7kNvwHbVeYj&_nc_oc=AdqhhXTgXVkuiV28tgNV7lXd8gg4iFhGB-B9KVxO9iS2vZhBVCtW82cpDF9QHbcAlcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTOYvbWvXswJ0nFeKv4LWNSBkpI-d_H2CBLMmjpoP1ow&oe=6ACBAA1E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PgTcCmbskIQ7kNvwFndZtW&_nc_oc=AdqCzSmObt_QJNwCWg2A8UOWk-HUrZ_F0t4xpVaKWEyGfLg6e_NaMwC43bzqmZlj0ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9F-oOmuywbtPJ49ASBze9jDqvbbsBLjBlwhMzeg9-mQ&oe=6ACB9C7C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7-NHxVKEawQ7kNvwGC3BKm&_nc_oc=AdpvFGUYiM1fDxFGILc16zJE-jP3dUbUbut1I5TAmy0ZZfZqSU-ZtfsWsk4kP1zqvDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_EEZYOJZsi9DCrcNhjAiCZhb2PAmAxUCPCoyNdBGZMg&oe=6ACB8EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0wpS1XLN8cQ7kNvwEdvrdv&_nc_oc=AdrWq9apWCjQRbmR3xNtfqxA0qbphWUAlA8BTPz6TC6aKHqvDYhpwb9XOGSb8W4yU_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoKJo4lCB5jMVY8JSc_DUSfiannIZx2yJRvlEWuIGHsw&oe=6ACBA657"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
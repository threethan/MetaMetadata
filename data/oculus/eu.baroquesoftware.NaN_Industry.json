97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl32u9wSrmQQ7kNvwHbKSn8&_nc_oc=Adpb2PATFrfdhNgm7_MwRhviH5PInQZdQL3cEtj3bBw4zSqYSv7cIbQVxDTM0nmIeog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21bFYTa2t9e6PgYRn0COusNC2d9OfSzAwRg0KExryxjg&oe=69D24802"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov2lpCN5N1gQ7kNvwGooo0q&_nc_oc=AdrZaThMKwH3_hoGGmRZznIabDf87hW_n7t1EG35Eqe2nrAQ1dLp2J_M-wuJbF4iLKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14Bi9sZxsUGoS_UxFEbZtM5TYGcBjwNjexFdh_Fm8jrg&oe=69D2465E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hyh32akNpFsQ7kNvwGGvwuE&_nc_oc=AdqC-GWphFP8wtna-t76Gkyoyto8b4QxBqf1X7TP_zQiPrFk1VBrYDmtBl1Hi7W-4dI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h-9obLPLXdwoiYIHAJTivKshfBBjEFdPIgpl6ozFrjg&oe=69D270FC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni1Tom89fgYQ7kNvwG6sKbH&_nc_oc=AdpLRTVex46pNCSRn53HWLB0hYIslVQW0wllSC6meKAM5Xwt0ryuyECOsFrANdv2v-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gQDDi-bSbsqp8CtsOXhkADzK1Knvv_gpsdhDzo4LWkQ&oe=69D26344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayv14b8tLBQQ7kNvwF-VW9U&_nc_oc=AdrbnQ5Or8UAy4cfSZh1eCE_6ad1xy2CRP-3hIyQQbrB1VpXeUk5EpZyh3dv1xTV4Hg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c892oq82PEarMCIqc5uutTS3pQjdiwUmtS_LSrgEzRw&oe=69D27AD7"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
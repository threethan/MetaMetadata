97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxQFXXBoHKYQ7kNvwEeCYm2&_nc_oc=Ado3D4s6LbhEKtfWo6kZH2F8v9rltQbbM7uOFSj-xl0VQWSNbP5jFeL6EelqogTeDjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cp6pl8-qjBnKB6fiE5UalNeywPWALeig7LNVddMs_aA&oe=6A0DD3C2"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqHmFjAnUT8Q7kNvwHXeXAa&_nc_oc=AdrpgIIZtQ9-7i9HphM0sJ3rN9KGnG4Cusv_jL5hhCMq4xXUZl9A18iCLQuHfFk8o_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KsCn5CXaGC86H591AQTFHYkp8Qzv_fnDoY3fPcv94oQ&oe=6A0DD21E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPTEYb0FO98Q7kNvwFufxQM&_nc_oc=AdoGJpWk4jFVdfoo8ZNkWdhTkPfbzUacG1IZDkIu_9EblT0tJ5wHf-dgf3-LfBW8EAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xCOyI9FC6FgMqCWniXWNyCMounZsq3ILv1OkoPXp7ew&oe=6A0DC47C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBo3k3gLj44Q7kNvwHYfTBD&_nc_oc=AdpHbbHHXrbt12K0X1hlRFM5fSw7HFarkTNccgf4bjQE6wMJ_BNaY-OVTkwQkDkhAeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-eibqSB2EkzOIo8h1h2aa_rJKVpriSWifyNGgCqsBlg&oe=6A0DB6C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBczB9jzCc8Q7kNvwE8Zzo4&_nc_oc=AdpCuvpHG_2e_gIYhz4T15NsDcNB-7fuEi_StUwoAlDoXHsRnHFj8_BegRU4sGkDsIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fyUiKWjnrK4kqzMYYQdm5IoYWPJ9s739vJCa9Vfsk4A&oe=6A0DCE57"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
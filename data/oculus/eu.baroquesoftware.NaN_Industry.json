97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTFr4JLzWW8Q7kNvwGGZzEt&_nc_oc=AdoQKvAhomtcWrpBLED3TtHznTVHAvL_-ybCv43_2S75L4Ya_lw8XH21CUqMY2vWR2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyvc9QhLtYVQ-Oy6zPL6i7L8oBFka-qt87YWaC6lcg9g&oe=69D0F682"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii6mppaDn8wQ7kNvwEe2GTV&_nc_oc=AdoFeIGFIsrBEbKl3N84K6boaC2Xu-k7JyzBhTJY_KqwpQHlV9r-reUjlId44Pz3XCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxX5Mc8jk8M-oB6G_LE1YJmZwh7b91cMyvm4njuCNiYJg&oe=69D0F4DE"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hyh32akNpFsQ7kNvwHQN0Jb&_nc_oc=AdrI8QJcDQQhjkUKOY5idBGCEZ_gXTnUu-GBr5v5KH88CetRM6OvmQj49h_1KPkvDwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzaQUIr2ePHZoHkpZTX7S5fLOY1fEgVv4SKGoIiqdGyA&oe=69D11F7C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBW9eNKockoQ7kNvwHtLCI8&_nc_oc=AdrrPmNY_TzqWfOhH_6yNt8rlJUVARlU4ScYF78j754-ppZnqK0ORC7JtqRYX_m5oLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKJf2yIUAtWhOxWrDJib6J9iN7a2OFvwHSwz6w0prYdw&oe=69D111C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayv14b8tLBQQ7kNvwHqLxiz&_nc_oc=Adq5QKknkxp5e5W3vKSpKMFvV0Cm6XwnoHelhNfmO4f_zYHDNyhqbWj3vPjKxoPUwD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afybnl7l6co2oyTLIYx5zaVO71QvGkmKyLCJDyqstD4l9A&oe=69D0F117"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
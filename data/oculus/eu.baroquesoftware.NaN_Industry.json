97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jb1qrF-R-bQQ7kNvwFhuUu8&_nc_oc=AdpF414OWMMc5HiETnUbknvQKCNTgGk1tlBb-2CZ1nJVahWyhazPmYMFMxNscsRCeJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zHWPBshM_NKyBaiLhU21khTjQamhcOF8sMKzrbrpYbg&oe=6A47D5C2"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czOGZsnbWrkQ7kNvwFS15sp&_nc_oc=AdoGVTBJwBguu13w4R9IC5Y-OB9SiOq4RK_VM71XZoI0dbUn7Pik8tVgMxBqnaOgB7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i6xqdUdYKvu814RsLOhRND0iRYfsR73JGoHK3obXDfw&oe=6A47D41E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1HMw6QRaqwQ7kNvwEWgOjJ&_nc_oc=AdpZ_p0EQxw_hYoH3U7GrxtBde4Mv6HIJ5C1xYP2_AnDiK8Csa8kymJdPJRxWUcBA7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86uw6OEaT1dqEb5wvvJ280jEU_lg7MXZhrOEnMgZCWig&oe=6A47C67C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-4O2_86fZIQ7kNvwELHWwC&_nc_oc=AdrOkmw1yAuzAB2je0yKr2M1hDAo7JVVC2uOlEk2QyUu0G0Dt2ooLIrNmHAHGljrPx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NmIkrWhq9Tk2k6pvPrvzDauRqMMLrdVmnzlJbjXyz5w&oe=6A47B8C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1ILLBZKYkAQ7kNvwH6nY0C&_nc_oc=AdpGcRrDhiqEl5cDauJS84bA9V-0WoqBsx5ZgeTBjO1Cj4e2ebe7Mq0706yAKbFlLo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BvemtD0pAAx3JEpLMNqV9yRwycF2Js-4F_sTieaZzuA&oe=6A47D057"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
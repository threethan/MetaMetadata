97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NM4CmRRFjIQ7kNvwELJfUJ&_nc_oc=AdoL-FlSOnD8G8nCbEGoSxv6UQKgOy1ardCTP6Q1CUKMaRNvLFGr0-ws1AIB4klyh5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOdnIrUYFHVthX3yn5mUGCArX5lt-W8F4xoEqigIHsDg&oe=6ADCCF42"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaVVhar3VUQQ7kNvwGZVB7p&_nc_oc=AdqNb1MFVUrIctP644JUUw3RR8tSFkhorCqmq5Ge_DVRA54FI48JdjFO4asF1dsodY0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN72KicugiIsC1zXYnedIU1Hb4IkQeG7CMtIg04k1PsHQ&oe=6ADCCD9E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VwXxYeHxZ8Q7kNvwFrouvb&_nc_oc=AdoOfiRNBE5YxhyXVztM1QRNizd1FlnkeYU98OiRCsnpK1fL2kH-Jzx9kvxz5b4tIrg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqtjBgGexQ7iqKOXc8LI7Kp5d0OUNFWz1ing3cYS-96g&oe=6ADCBFFC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5r2fLw_0_kQ7kNvwFs0Lsi&_nc_oc=AdquLrX11ngyqrUH7tM-YMcV1duYUSXOI1CNB2JsEUYk5TTxPoKsI_G9MjHQM9CpZxQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLGHUYVCuK9kRid3fdBHngktjizOpsbgBj4OdvVmORMQ&oe=6ADCB244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIrk-SWb8kIQ7kNvwFFvEas&_nc_oc=AdroJ-sb7ATYrUuFs1sya4c5wXpH8xk1RTnJy5kLR1gbW0rQYsrQN8CLvD4XmXMCheI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMW4d8sq6LhXWpZArgKPVMuVVtBOvgfRsJyzmdr-7g6g&oe=6ADCC9D7"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
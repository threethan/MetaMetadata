97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDh_OW3lW7gQ7kNvwHfW2I4&_nc_oc=Adr3ziFAUZiDkahVdk1ikkJMsbZGRqryipYCuomgFaq6s2z0HTyF6VgjljPOgEXS42A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48ZNlAAhOp_6w6ZdJ6Q12Tio4hreD6nCovj3pK5x-_Fg&oe=6A0B30C2"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkBmOYnzDyIQ7kNvwHTnUoI&_nc_oc=AdoaxfVE_OU5kjTD3ds6Z8EQfhgEqMQmlIBlDyvMUnpEPnWkd1bB3z8dSHd9Dw1QcUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vhyprIrcTw-J_X8xi0fgXMJK9m8gWMvu0GQ2Myd8uXg&oe=6A0B2F1E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPTEYb0FO98Q7kNvwHYjxOM&_nc_oc=AdrJJ5cyPSJ4rXprdUhh97tqSV-axGQNXXOua5rAXUGsGBJEHBiMSR9n0OAIhZyH6DA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5blrH4pNNIzWyF5lk4tDreL-tD_umG3H3AlJQfMcIugA&oe=6A0B217C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PxeyzkQU8IQ7kNvwH33vag&_nc_oc=AdqTPFe0JrCy88524t5Dsg1xwVyfglPoOhJOAhYbqCsMSFnHO6C_lc_KsC79eTy-z5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tB4wNqpn1Y3-6hYIyK3cBS1iFzYte6q2ueP3_3NKueg&oe=6A0B13C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBczB9jzCc8Q7kNvwHSptKP&_nc_oc=AdqEunzEl4Kab-M1-n_tyQytQl0N0DwUnTUA2iDWV2ve9G_TbO63U9uX8f7vcDjyHoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pcHKn3FQxn002RX0xzXhBjSaiYCgZ3pQnVWyBlnGjBg&oe=6A0B2B57"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
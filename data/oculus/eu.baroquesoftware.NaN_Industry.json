97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Xbvxa5VguoQ7kNvwFbmYQl&_nc_oc=AdoVWoMLgr06IUnwGhOZo-QbKBXmE05hM6hhIihtKex6jp4ZqQrk1Lh80GF3WeWC6ZQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dBT5ZrlyCRJKuMHFDxDxL5Tg4LAO8T7sn8bPM0Ypn6w&oe=6A32BDC2"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYLalRoDqWYQ7kNvwGlWM3I&_nc_oc=AdpQQ6W0jeRYrPEjzOCIJ2WZ_Zq8hSE1y4jZBb5dxzrjz4qBotj89vz5uFUK21Kl68I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mbLUy3S8emhEZgDdHkroZbFcg-DoGWSvN4WKaFqXPIA&oe=6A32BC1E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1mwtjCMBIMQ7kNvwGMrYAJ&_nc_oc=Adr7QdAeO0Wz8k-tKfjV9F3i4yFtgXbokB2LmIYkqW-TcS5r4EtEJ6KYR95KaASDaVE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_tNxKQFgF_AZgFtqGLyB9gCFYXVQLLp4Le64yz3Z2Gg&oe=6A32AE7C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9DL-jlmdrAQ7kNvwG7XDD6&_nc_oc=Adr93kyC9u7ucXwyJeo91sJ-cyay4FRLNDxmut1ecqf7-IYT-ZdJs4ksP_gZt9EJ5qs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c0755Mbe7-0LCQ0JToHRrJUpzMr_LJUg8K4ITWxq50A&oe=6A32A0C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsHmgs3DHtMQ7kNvwFjKSmF&_nc_oc=AdpgjpnSe0mHpwb44QI5zYLQv5kHlslX1RB1D2T7dvRIqmX7Fs0kI8WelMDMWZ-5Msc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xkSj7aY_HiDQNHjYQrvjVG_5yLqyhi3mevGOOUBoi3w&oe=6A32B857"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
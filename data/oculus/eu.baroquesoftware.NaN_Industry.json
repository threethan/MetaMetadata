89_297846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igcR5E2H_rcQ7kNvwGHaTVN&_nc_oc=AdpBIRG-T7YJmXA6i9aJobCQubq3kVuQclnwuhzZJ4cVVolB23uzjepbv250mYm3sLk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1jZE_zbXheIR1vNuRhD3bcPrYKNZ9ixJBe2tTv8JbXg&oe=6A36B242"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qonu037tLPsQ7kNvwHfYzve&_nc_oc=AdoeshDlMmxnlhu_J-UiPaRYxFoWBItAqGA_1moEkPkxT02ErNEEUBnyqotjWiBgQvY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G1O0DJBvVcfkuMj9Jii7rWjIjyN5GFyejb1MXBHBsFw&oe=6A36B09E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlPp_Dsf-MIQ7kNvwGl53yU&_nc_oc=AdpRA3HYG7YszJHqbxnl7h1YQ9ZupCp-ncMiIP9wPZc5SIyS7xM5mqfcBkBmglBM3ho&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XQj4e8VfabPnYQ4DjIfFrWp1cK5lLRDlEusopXqUD9Q&oe=6A36A2FC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLTYb2FHGpwQ7kNvwGSYxuN&_nc_oc=Adqj5TbKeCoKUXf7Eg9Qwlqs0lNICy7hi7dp5jx3MBGii0MT5WfMH4rQjVDThEOTJWY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ol_wYp9Z_BGqWvGYEaybZG1PfeAYXIsmgNmdWC9Nuqg&oe=6A369544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS1mODzLQycQ7kNvwF7bzsB&_nc_oc=AdrgwdM1QzqL7388x_hjEZQKiRCv5nlq3XdmxePHzbA7aw-0FlMcxHSX7ySHA8Ish-A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oj7ccbHFfkafyJM3Nt6I7ENhdYyp8KjnNfCNAa4M4aA&oe=6A36ACD7"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "use
97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrkwHwXtbwIQ7kNvwGN743u&_nc_oc=AdqBgyHoYGbmedu2nHPFzCWnJS0CD2fIAji2r0M_YnjGw1blMEluZJYyteMeqExBobU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaeviVhk9_QFeAly0WpAWjWWZGJ_QsLcLfumRCi_JHpw&oe=6A79B682"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma0DVRukhRUQ7kNvwFwqYXX&_nc_oc=AdpZUxIEo3JumH7pxTjHjH4O_5RlgkxC9fvnpJh1SzZkHL4mYLMzwMM8PDq6UBWCTeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYJI7E7Iv8XhMnhbn-fy6a0LygACL4iQlLR3iozA9ANQ&oe=6A79B4DE"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3aq5rNGxGcQ7kNvwF76wZo&_nc_oc=AdrSMQLjPzgTcATN-fVIFqMKiiUWLYsMcGO38JCVnmILaiFSwElK5G5uytspEHu7GS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt66fo0HCDvO5bdfSzQJyMthD6q93o22eZ6Ow7MyL3UQ&oe=6A79DF7C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDi2ytnzbRsQ7kNvwHfSW8r&_nc_oc=Adp_VDTpiZTnBrLhhat1RVAN_e7kIexHztVnHDBRhbJpWRVkF-i67edAlX9SzrrBk-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0VWIze5kvZdX1-IZmuVzTNMJF_dYWTyHcnoG-1W8NGg&oe=6A79D1C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHW7ICRnsx8Q7kNvwHUy-jI&_nc_oc=AdqedcZsgMAURHa3IFhWb0kZptCW2hObeYAjaIwO5mxJ0ZexKPa_yNrRuclnzhgpK0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9IzvQhLcZ-90Jq3p4oyrLNVdwfAwyl3OBDiizOp4BiQ&oe=6A79B117"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
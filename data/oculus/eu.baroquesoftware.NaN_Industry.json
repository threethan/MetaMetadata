97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAoOramqCEkQ7kNvwEvJPb1&_nc_oc=AdoNTx55azOf4sPPtghGilc8z0aJyZrYYBDLsd5Q3_4JX-4c5Q8KyTKJJBL_TLAeMmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfDj_kD_Ya_WOrTMpXFevUjCgazjxshUrqcqUlmejQxA&oe=6A898882"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25BlZsdVXdUQ7kNvwE48Sc-&_nc_oc=AdrB-fN8Y6TZxlKBYmm0gH_M6_8TPKDiXsSyVuA-_AdZGHQaCcev7l8g-otS_1wMCYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETbsvFxD2ueyOyNIM2IQ7qoM_M-ZakVSNebcuBj1Mxkw&oe=6A8986DE"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mU6ELkiEkQQ7kNvwH6SaAz&_nc_oc=Adpaz0TeCmGY9yJfjyzPPrAY7_t9Sup8Zli1Y2vPHW2uezqLLBQFvnEvJv6-bA3aABY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDSzyG6Weuyc6TznoVicI18IIEotwXhPxjZfkHAc8a4w&oe=6A89793C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vYjz9WrugsQ7kNvwGxoedZ&_nc_oc=Adr_LGC8gD7drMyhJAt0Sz9rCR8qBwHkNb6Q-T-BX_a6ErIThshrkcorO0jIyrmKBiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9yP5euQLd7JEm5Y4hjK2qhlkyFsxpXot93kp38XT_AQ&oe=6A89A3C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zda5NlUvDHQQ7kNvwEsD-pg&_nc_oc=AdoVmOllapuL3a64izyvO3Kw7fIj5vHC0jxfg4KM0JEvhY2Gl-PWlxl9E73pc2cnIx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAsAtlTU3LIRxbFq8QXVTPeuhgwi2I2Tu0g3itsocpUA&oe=6A898317"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bPOSrMUtNgQ7kNvwFP_iR6&_nc_oc=Adrm_e9KK_yp1f2iOvvCUUV21Wi6hX2yggPqrlkeQ5DlFKWcIMfWd19d5lpSi4eqWbU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPg1bh2i_65NmYnVLs1wFgm1gw4ue9za4l8lLGBYhNbQ&oe=6A5A4AC2"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4QtcU1cV3sQ7kNvwHQLnLP&_nc_oc=AdqzBYAvtnONm62HT93NmzUCrcX1HzSGaM4RuvyjYu_8bbGzJv6KaiQvGyCE-hx0BUQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKGHYaFITIDEXCs8tdHvHVQvY9S9gY_-d4kd0rtnkvQw&oe=6A5A491E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaSXoO7tFF8Q7kNvwHxSuIi&_nc_oc=AdooJuVsG-x1oAvl3DhTuQgZEpf3BBrOjmR9k0N_m5jNenrYNZ4MSjDbidD_O7yqxqs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnFFoJXxrfbC5NYZs2WSztko_7LNAjC5XAEjLXY2maEQ&oe=6A5A3B7C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wp4yWYlM78Q7kNvwE10FWA&_nc_oc=AdqGxHx0mBfdEiCOqrCw75lgrJEvXesLQBqlN9zUiSAQXYuPu4w0KzQdh5SE3Fmpb3E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbg_h6KGvaNZRuX0sEUcXXCdPkeb5bIhhQhBr4-NirHA&oe=6A5A2DC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJH9JleTZ_MQ7kNvwGfPpSe&_nc_oc=AdoB10WgakMY9XDwrO03yZbbVp6f6scm5mmNU2zFwDFczmT9dSp1zkYoaT15gOOIW_g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH8in5gn4axt0pk5fJrKv0asphwnH30QjFNXI87ya5pA&oe=6A5A4557"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsoqpdrnYCkQ7kNvwFi_4hv&_nc_oc=AdpaOg0BDjivpmW_Zy49VXheK5yUFOBrfSJSzfnNNW6JKzzpWAYDUSVCHGFTXuCLpak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MHgW2ZjRzj-OCytAa4ynKbht7R4QX3wpfJEMGLPYetA&oe=69ECA602"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHfoKtdEIJwQ7kNvwEGaAZ_&_nc_oc=AdoHhH9_6PuLPLKAXcphlLKyCNqfn7gfNY0udC7kjV-SpAIbrO6SeF3zqSpGYRNcPt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uzNZdrg7nv60CWXlZd7CnHxrI-fvx8-ykSxti2AKzLQ&oe=69ECA45E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uReqQ3PT3xkQ7kNvwEWe8ad&_nc_oc=AdoZVz29EkhvnXGX-3BfUL5cRsBhv073XkWoptenpSC8ys9J1o6zF49jQq-9KPgInCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PS_76HDWHH3tiO0oBQgBGHFDTiQ6ctf8pu22iEkawFA&oe=69ECCEFC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN6dF4iHEogQ7kNvwEQbn6G&_nc_oc=Ado_v63at_WMqMTyjU62He_s9XUuijSJ6JEva7gO4uguORhFvoPklk9bNBl4GAnyV0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DbgmxtnMFG7lJLG8OkRtXfSouUNImLUnLszZQl5giaQ&oe=69ECC144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhdwVDYgM7oQ7kNvwGqkgSs&_nc_oc=AdqyPeSvURVxJ5-KSJDbDOl1I_XlfaOw3qjEaC1-Ke6GoPjv6QKyOSEvLB6OAUflFxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c50mVedqdFDuuZemH6aYWiVQ4Ml-n721EELmCL-1Wrw&oe=69ECD8D7"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
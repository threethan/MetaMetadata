97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yIq38HlkREQ7kNvwEBx7iq&_nc_oc=AdqOs5HLfB3YsJMTEE2ZBzhmAqeYKyBuwCg7wdONcom9-MJB_3kZOOPWY4or_6kzbd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7XtUphDKxn6xcVHCs9SkAq6Q8PKBZ-HqVsDE67fI00A&oe=6A7EFC82"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R47Jqq6uq2cQ7kNvwEaFAjx&_nc_oc=Adrzc3R13Tecg-z7FhKBiBmvkTamTiiVBAS2H2MVqH7UgqBjRaiatxgKkEl7OTwcaBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy73z1H1pT8K26FJ91BQ5Kt24_TO0Ypo84Xo6hPEHNow&oe=6A7EFADE"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bEQNEHAeBcQ7kNvwECo7f3&_nc_oc=AdodLHakfQRE5hJrMfNBjWXLaziQVt5LM8wc4jj1mgBPbHv2u5BzmrHUpeCDyNYOyWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvAJYGO0DOVgdvjTevwM4dzzm0h11LnBeob2UB9j8lCw&oe=6A7F257C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOFYaaLuKsQQ7kNvwHqlA8b&_nc_oc=Ado0UpQPghqgwtOBs2Kg-MyaXJ9_j2mk0kXoeo5x5Bb0TTu3vgt0EBIt_KJKKmmtSGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3dXzslSwJ07jKnf_87CvBjgZJhxyRSz5ZErLhAH-7cA&oe=6A7F17C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLJ8LbpWeoMQ7kNvwEka35p&_nc_oc=AdoUxatHhZLwp0uHCCeLlm7aqXThnegsZcizZi9hxr5af3vSzBcnjNbwTnBt_cLm160&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJVqjH_hh1sJxmXv74dWdy0zW3S5xDEhn7huBmnsNuNg&oe=6A7EF717"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
89_297846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-dUjRy6l84Q7kNvwHaHNSa&_nc_oc=AdpY16H17EXG25wsk1MKKPu2bs6JE1gQbPZ3D59xa123GJlJjYF9ZdvKz_KVYIkYlVs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RfddoDQW2iOKlqbsoooBFtMmuHZQE5U2eEMgGpoClTg&oe=6A11C842"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDDdXA_Q240Q7kNvwF_QGfI&_nc_oc=AdrTpnfumzbz3wE9EAsDiLIzCPTAaqPbDhDhWhOYgAsE71sKh5cSOas5TbXdkL_4xK4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oLWZdX2mXQZ_ERBk4RxqzgBXwqe8jCBuHsqW5YIamYA&oe=6A11C69E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAsYWjJRywEQ7kNvwGIMP_2&_nc_oc=Adr5h-Y12OSfI4hvIapPUjFDMSReCXDpA5fx2kqf0xZIu84_ew-K2FORufxB4dOzYbI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UJSE-AKY8ygKzDR08oQSKfg4C3FOx1b7WBbs9IdaWzA&oe=6A11B8FC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_BK4lFswtIQ7kNvwGKGYNI&_nc_oc=AdredjfuVF1SMfKy0xwp0v2Q4gV4LjpdyE6YRbZqmgAt7QYtGeQVMqdZUiFs-BxLL34&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M0uKLmrESDXDVxPTruKZVPAQmutp22YwocviOAzAF4g&oe=6A11AB44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWM388j88w4Q7kNvwGQWeb_&_nc_oc=AdqCYdUJHgSYsHKiv_9_jfUY1xoRNoGppQVBYVZWJtHrptR7v_OvkMcAfLCvO_-zwVg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SA5rEAnQX9Oz_W3HAQXgONNamGuIjPiVcDrxQzmltbQ&oe=6A11C2D7"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "use
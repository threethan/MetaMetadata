97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nmb4GrNRR3cQ7kNvwEiYBHp&_nc_oc=Adrxsh3pC6laLbMP0PQ9yKc6ga1Lgl1OBlZ-ejxhYhgki7m_5RrrlrfgQeEffgZtFSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HRVx56oldHUc1dxI3tIrV_1Y9h8hVSFlmpx2F6N6vjA&oe=69DF7702"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N-92bT6ikQQ7kNvwEMjrXO&_nc_oc=Adrxt87NJ1g_t3BufI2h9fjdvAzcfCLulUz9H5FClUVOxu0j0JAia1rPhc3EKKEpBPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34hEaGJJmujHdh1Cf8K0zy2T_SWkLvL-VNK2_6oLT3QQ&oe=69DF755E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PootRc2GN6IQ7kNvwFmAS-W&_nc_oc=AdrrKrZtPH5u5fT0pJu86sA9QXQJc73FfwvAi9vNvI5A33fz1HP108MciJl7lVuTvMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tRAzJ-qrojuQHMtVwmo0eP8II1e0peKxHL-ttc-jKQw&oe=69DF9FFC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st4x5uORIXMQ7kNvwE6U7U1&_nc_oc=AdpcZ5zyjZmKeVT8tGGC9ElX3u_ZP2NzCFm5vcrKIVn_-T2j4_amkpZLt65cX6oThJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E7c0z8kJ3LTyyPPTfUQQuZkxfX5aN36gTbtEkwBmpLA&oe=69DF9244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVG85A5HfocQ7kNvwF7coyM&_nc_oc=AdpfVCjqGO9g7BFqMWcQeA_Hxu8pklR7TFSmytrSVHgOAjoZ8AlB9c63vmZOcEt1lyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hQIoI-pTZg5WFpCh4HiOxF8WuFwPV_Yyw3co3WTv1Lw&oe=69DF7197"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
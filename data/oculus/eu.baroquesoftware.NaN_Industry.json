89_297846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQSqVXz37CoQ7kNvwFfPe6o&_nc_oc=AdqLdwDqMWIGPiJkNsk0-cePGG3KG4KWFBSqaPYIzjVY4tb9rRtOF-beKveZE2k2iEk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-EPxam770hAFc41OWfjuwVdJ-JCjZ7d0AGjPcP6MyHw&oe=6AA41EC2"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-1FstAXF4cQ7kNvwFZteDl&_nc_oc=AdpCgVJzEvOj0oSvCRQtoLV3-jRwp7xAy1qefO8Qin-hoHGMr_IP3D_mthBa1EoWMg4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCWgcuifMlymrx70aEhvTTP6LuiZhxSkxBxO2mgYRgCw&oe=6AA41D1E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvRgWTPHvksQ7kNvwGe_tgx&_nc_oc=AdrgL694yIv0hbDEEn4buAhrTRR70-a8R7VOsEjUIaysOTfX1FLgfqFkwG8tfZ2JgXk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ6zk_yn225Ag3LLkCHslJX_6RC2EOxWsfszVZVz5_eQ&oe=6AA40F7C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSVuHuWzAM4Q7kNvwHl5_dD&_nc_oc=Adrm1vQJoImZSkUFT7EM9mjZZeUQIHZS5psP5TUocOWLF9Wuv3eBJemaaj9biYwa9-Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5kC294CfvNEgbjROyCXs_O7AvAYLXmw6u8XKtikSzsQ&oe=6AA401C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lG2WwnAKggQ7kNvwFzVk42&_nc_oc=AdrZ3RwFEXxwnB5Ap0jPAsNzGDN-OlRLvTS2RBo53m1UbAt6Pr9yGnC3YGiEoBQXoEM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyD-y7N8oeyr2A7oxmlN7BYu6MPrtfZU9lFucItIfvwA&oe=6AA41957"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "use
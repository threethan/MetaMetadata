97846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKF4MEi60OwQ7kNvwEOYQwi&_nc_oc=Adp9vjr2W6fuOI6Gp34xnVB697qU2fuH-tgbZP1PRz2_qT32pWalGfnHEo1zke0_PXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHlmumwjmYIKqe6oohtKCnFysu2nKHKiD43bZDdmDy_g&oe=6A69E482"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4BV7OUzBWcQ7kNvwHILJem&_nc_oc=Adp0VjqzAcjJjHeD-LXbWLsyaKUVI5LM-jSQmxxNXciDoNNL_xrR0g9BBuS6L_Dz1H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyfuBFK0QlqbcbnGqGPIMf_Ng4kDH2WcgcpL5M-iHlDQ&oe=6A69E2DE"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IE3I2fIp74Q7kNvwFps2Z7&_nc_oc=AdpNQwqeY4bTKILRD96glSCzF-sJjDJjitIXik0se33uQoXRj17Y2UvEgXik48TXbyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVdXB4f7v9hFwooOSQrnSZCfSTqiCAHpuD6wikzPCEAA&oe=6A6A0D7C"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_Ec-og7RewQ7kNvwHp0tA3&_nc_oc=Adp-bbzIinGJxNR8npr0S9p7g9WEdD8--cPLDh9tmcHeWKfnZSmdUXs9JHPRXusvTHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-G-beF_iuEBb89qAFR3_Yc2AzCDzQLppk2LCNAcoJ8A&oe=6A69FFC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnHe-KXnaCwQ7kNvwEzl_43&_nc_oc=AdpKLL-0Qe2My4w8vpi4bLTWbWxfGeXB4dwAHVkc7v3a6Meb0UfxE7QuFERvR2IJdhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUne5lRuxJ4gc_IUkZi8ay91Bwr2n29bHBsYXBQ1gkjg&oe=6A6A1757"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
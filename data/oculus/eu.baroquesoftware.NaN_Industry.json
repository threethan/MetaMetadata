64948189_297846135786310037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvY52AEzOXQQ7kNvwGYgytF&_nc_oc=Adp6KMIgwVHCEon2bhbMPuY39g0QIFkqwwgJb_pHbsWtH-ERn9JQ7AcU8IJP4QGQ7I4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeLjCEtqHjIuFG-WcFA7CPbWSObEKjKKlQN1EOPh5pfg&oe=6A859402"}, {"file_name": "1440-ScreenShot33.png", "id": "1069423813585791", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982602_1069423816919124_778204992157148573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_ujS4onAwEQ7kNvwHA9swP&_nc_oc=AdrhyftCM6V7kbAv5UySecjW5hsF6h639Lh1DqY2PQd6ng5dp_Qs8CNRBX2tTJvry-w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGoXa7zvSylUjaTlpkQ_1ISZtVZkynYR4xC7rZZRJMHQ&oe=6A85925E"}, {"file_name": "1440-ScreenShot8.png", "id": "318527539655329", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86613168_318527546321995_4471550335629762999_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym-s3qLe-X0Q7kNvwHpciHf&_nc_oc=Adr00ATRjSjnYhXbyPHrs-E81_MHHa6x0JXihCE5I2MQUvYzmKOSmVIm1gPSxRZGA5g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGttSHRx57q4mQFReEuHVUetIwdIz8lPhFYTTHAfJTVZA&oe=6A8584BC"}, {"file_name": "1440-ScreenShot13.png", "id": "902714953794064", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031617_902714960460730_2931854413158517337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9wzJ1GzsjQQ7kNvwHNMzLQ&_nc_oc=AdpLKyvJIWZ_qB5K2iMcfW6FYX-k3fEn-VgvhdqgporU_PIvIbDefiooJjVdY0lCc4Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxsSjhEjaXfDApFq5tEA5ZfwmQKR_thiwnECrPpnwyBQ&oe=6A85AF44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1440-ScreenShot33.png", "id": "478769856749003", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982602_478769863415669_1634444826754880031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lpI69ydj8QQ7kNvwGRIW1W&_nc_oc=Adpro6lucqJRGPUJarwqgAwX8h6F6LCYodxcjM-9UvT4wcegiZChLIyrsg7ZLvQyg4c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBtmdxMYgqpXcoStmlTN3wIO0G7V16t_ivNzN8ppdDKw&oe=6A858E97"}, "display_name": "NaN Industry", "keywords": [], "long_description": "N\u2e31a\u2e31N Industry is a VR puzzle game where you build a \"factory\" in 3D by placing action blocks in space. Arrange them so that they will push, weld, destroy other blocks, fire lasers, and so on. The goal is to guide input blocks to output locations, possibly modifying, splitting or combining them along the way into larger structures.\n\n* 30+ built-in puzzles\n* 6 space locations, no gravity\u2014blocks float\n* increasing puzzle difficulty from easy to seriously hard\n* puzzle editor included\n* in-game workshop of published puzzles made by others\n\nThis game puts emphasis on the freedom of placement one gets from VR: there is no gravity; blocks can be moved and rotated along any axis and float along under their own inertia.", "short_description": "Build a \"factory\" by putting blocks in space which will push, rotate, weld, etc. the products"}]}, "developer_name": "Armin Rigo", "developer_privacy_policy_url": "https://baroquesoftware.com/nan-industry/", "developer_terms_of_service_url": null, "publisher_name": "Baroque Software", "support_website_url": null, "website_url": "https://baroquesoftware.com/nan-industry/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "u
10912_1576268100349704_6537871558125107140_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwoX9akYAskQ7kNvwHwOkLm&_nc_oc=AdoyuSkd3r7m4wJawbhR8tdi7OY0kcdV9H_7FXE_ItYXTc6ZzCfRGi-KUZDBNvitwRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHwTkMz4xKrLxvZD0pykAdPniQWc0e1XjCPvvr5VDc0g&oe=6AF5F263"}, {"file_name": "screenshot_4.png", "id": "1830417421471347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/806363909_1830417424804680_1368914153759206911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDcnirmbQBQQ7kNvwEf09fU&_nc_oc=AdoEmm5p8mXk6xnQa3n3MhDyFR6zuTLm9ZRID3aFfe6YVcckXykC2EOU2kJhLiFI4qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSreVrXotkuA-0ceDOo3MwEixcrx5Hm2F6ItOUYwirGeA&oe=6AF5CE6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "961532479761934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604328314_961532483095267_6645529977703538441_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjNu-eE2h78Q7kNvwH922ET&_nc_oc=AdozCrE5b7u_doQiby3z2ZeDsEwT1_mbZ_z0UNdrGwlWnq5K4_kA94S7HYb1J7pUE8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE2hF2_8DXrd9_VsOXIc7QLR6FpHQgvaQ9PrSIyGLpvQ&oe=6AF5D6D5"}, "display_name": "Flight Simulator Sydney", "keywords": ["flight", "simulator", "sydney", "jet", "pilot"], "long_description": "Flight Simulator Sydney puts you in the captain's seat over the real Sydney.\n\nTHE REAL SYDNEY\nReal satellite, elevation and map data: the Opera House, the Harbour Bridge, Sydney Tower, Circular Quay, Darling Harbour, the Anzac and Gladesville bridges, Bondi, Manly, the Heads, Botany Bay and the Blue Mountains on the horizon. Two airports: Kingsford Smith and RAAF Richmond.\n\nA LIVING CITY\nManly ferries, yachts, cruise ships, the navy at Garden Island, double-deck trains over the Harbour Bridge, the light rail, thousands of cars, airliners in the sky. Jacarandas in bloom; at night the harbour lights up.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the harbour, the Opera House and the Bridge out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the harbour city approach, RAAF Richmond, the coastline run, UNDER THE BRIDGE, Botany Bay, a fighter scramble, harbour lights at night and a Sydney tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Sydney, built from real satellite and map data: the Opera House, the Harbour Bridge (fly under its deck), Sydney Tower, Bondi, Manly and the Heads, ferries on the harbour, trains over the Bridge and two airports. Start in your own glass hangar on the harbour, talk to live air traffic control, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorsydney/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorsydney/", "website_url": "https://citiview-games.pages.dev/flightsimulatorsydney/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
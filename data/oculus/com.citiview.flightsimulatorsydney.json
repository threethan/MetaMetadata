1831964_2385308565544293_6065025278203101880_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4O0f2rVo7rAQ7kNvwHBj7RM&_nc_oc=Adpy-8vVSA7uFm45Mo0_iv4zE5ylDzb3crxm63bGxVvxzLWDqJWKvCpbtqofuUxO1Gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1RTQXFsZAnhNGsDhOQyN7bFLT6X99HcVPjWxvINfN5Q&oe=6B103AAF"}, {"file_name": "screenshot_1.png", "id": "1416880169881225", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/756589809_1416880173214558_7110158684699443857_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYJ9gEQ-zy8Q7kNvwEz20Gw&_nc_oc=Ado2gJ7LHjLpHJRofvOzVPkONyJ_rp2u2gt4iDE6Ey6jQSuz17CJv90UYkdPefucF_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVi6iRFLfpg3vkWnmQiBE4E7JehhfIQlzztLDFUorhiA&oe=6B105A69"}, {"file_name": "screenshot_5.png", "id": "1576268097016371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604310912_1576268100349704_6537871558125107140_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfhA5Ku7i9EQ7kNvwGpE97i&_nc_oc=AdqN39n13sXiPQjkpZq77H60JFUeOR5aKvZ3mavoy4dggHSifjRdyku5AeQX_mkeK3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWC7loGPGVXvr1ufIQ9LMeVVbNygSofYbLJFvHrhzYjHw&oe=6B105063"}, {"file_name": "screenshot_4.png", "id": "1830417421471347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/806363909_1830417424804680_1368914153759206911_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvEbpYSqIkkQ7kNvwE90QIg&_nc_oc=AdpviG2Y3I-yT6wGrzxahGCQlk-tDySbXuIUeHxTTfpIRiJk1FoQwZbVDGMySvx3iTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXnluG1Mt8oXQCJtKpx2ZvGg2UvhifgHIcPcuK7krJzA&oe=6B1064AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "961532479761934", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604328314_961532483095267_6645529977703538441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDanwMbxH1AQ7kNvwF-Tnnb&_nc_oc=Adr53eyhWxvFTG8h1L1TFwFvBBJ93aXzPycxpiySzbwT-vV4SBVvkmjJGAJpPHJhWb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQ4r0t7M2qduHLDjGPlW3VePUk4gPnpNDjYcd-tkPdHA&oe=6B1034D5"}, "display_name": "Flight Simulator Sydney", "keywords": ["flight", "simulator", "sydney", "jet", "pilot"], "long_description": "Flight Simulator Sydney puts you in the captain's seat over the real Sydney.\n\nTHE REAL SYDNEY\nReal satellite, elevation and map data: the Opera House, the Harbour Bridge, Sydney Tower, Circular Quay, Darling Harbour, the Anzac and Gladesville bridges, Bondi, Manly, the Heads, Botany Bay and the Blue Mountains on the horizon. Two airports: Kingsford Smith and RAAF Richmond.\n\nA LIVING CITY\nManly ferries, yachts, cruise ships, the navy at Garden Island, double-deck trains over the Harbour Bridge, the light rail, thousands of cars, airliners in the sky. Jacarandas in bloom; at night the harbour lights up.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the harbour, the Opera House and the Bridge out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the harbour city approach, RAAF Richmond, the coastline run, UNDER THE BRIDGE, Botany Bay, a fighter scramble, harbour lights at night and a Sydney tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Sydney, built from real satellite and map data: the Opera House, the Harbour Bridge (fly under its deck), Sydney Tower, Bondi, Manly and the Heads, ferries on the harbour, trains over the Bridge and two airports. Start in your own glass hangar on the harbour, talk to live air traffic control, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorsydney/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorsydney/", "website_url": "https://citiview-games.pages.dev/flightsimulatorsydney/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1378646561998546"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1387157894480746", "version": "1.0.2"}, "id": "1845770516589948", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1372594219270447", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1387157894480746"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LI
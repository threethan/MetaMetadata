-7&_nc_sid=6e7a0a&_nc_ohc=kpDTnAuUvmQQ7kNvwFlPHLk&_nc_oc=AdqsBQeXqNNHQ0uWt0zOT-HO8Ilhrq36KyMigTMpPJhSa0pLhLL7rwuxNQXbe1iXnWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5P3XRuFySvVQKDxSmRsyZbul7aJSwuFSJcrHqJWxhZw&oe=6AF89F69"}, {"file_name": "screenshot_5.png", "id": "1576268097016371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604310912_1576268100349704_6537871558125107140_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mu8XxKr4JWIQ7kNvwF-uw4D&_nc_oc=Adr6V9nqitrZx3gz4Y00uoI3ysUf1bJad6Ne9dvlT_TiLBzOuWDTVeSbeVn3_4d50s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNMRFlLH4Maj20-8JLrI9nsYUwDwnMpYOrC1b2qSIUaA&oe=6AF89563"}, {"file_name": "screenshot_4.png", "id": "1830417421471347", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/806363909_1830417424804680_1368914153759206911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEqKDdtNE18Q7kNvwHAQWWW&_nc_oc=AdoW9NmfCQc4ZPgcs9O2QQoXkhEqQ7lI8Pm1uY1TC488IEb-SG6AtKt5-KLvhPdpCI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQXfiYeCLVV0e8WOt9wkQS_uTmXwbtYYDNjcNyUbmOiA&oe=6AF8A9AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "961532479761934", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604328314_961532483095267_6645529977703538441_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjNu-eE2h78Q7kNvwFZ6Fq2&_nc_oc=AdovFRioS42GcCf5A-BOwzvX4igPFfqYCYTNQVuZSsna-6oV7x1W_v91lxGwUCym0aE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZpWY1t0wKfjoc8MdBRl9LOjuPq3kgtvCiwx0i068oEg&oe=6AF879D5"}, "display_name": "Flight Simulator Sydney", "keywords": ["flight", "simulator", "sydney", "jet", "pilot"], "long_description": "Flight Simulator Sydney puts you in the captain's seat over the real Sydney.\n\nTHE REAL SYDNEY\nReal satellite, elevation and map data: the Opera House, the Harbour Bridge, Sydney Tower, Circular Quay, Darling Harbour, the Anzac and Gladesville bridges, Bondi, Manly, the Heads, Botany Bay and the Blue Mountains on the horizon. Two airports: Kingsford Smith and RAAF Richmond.\n\nA LIVING CITY\nManly ferries, yachts, cruise ships, the navy at Garden Island, double-deck trains over the Harbour Bridge, the light rail, thousands of cars, airliners in the sky. Jacarandas in bloom; at night the harbour lights up.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the harbour, the Opera House and the Bridge out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the harbour city approach, RAAF Richmond, the coastline run, UNDER THE BRIDGE, Botany Bay, a fighter scramble, harbour lights at night and a Sydney tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Sydney, built from real satellite and map data: the Opera House, the Harbour Bridge (fly under its deck), Sydney Tower, Bondi, Manly and the Heads, ferries on the harbour, trains over the Bridge and two airports. Start in your own glass hangar on the harbour, talk to live air traffic control, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorsydney/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorsydney/", "website_url": "https://citiview-games.pages.dev/flightsimulatorsydney/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"i
4rYQ7kNvwEu3JRx&_nc_oc=Adpl1dyPWzCkY3C1izpomlhhFkpfA8jzCgO9hou3h9CP_m-3pRbIq22gr7AS35Mwyw4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-fgQKgF8x2lmb7BM8z5GRVTKqVelvDjHwle4AO9mgpQ&oe=69C525E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BUN7xJubzkQ7kNvwFgEzjR&_nc_oc=AdpH3HyOyijQ54alpkL1PwhygPi_jLdiTIJFqX4mc7tUATiEe0ubv-CACUNKd4hjeBw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdsqU6T7VwMWCY8jDSjG0kcEnv3qBzjkmtiYZHfo8qWg&oe=69C5424B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.cn/docx/Ri7Wdt3uZohkGgxApz3cgJJunwd", "developer_terms_of_service_url": null, "publisher_name": "IndieGames Studio", "support_
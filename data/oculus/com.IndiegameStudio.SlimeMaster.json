Q7kNvwFNjjs8&_nc_oc=Adq0xTMY6udsYKf947QRltisSHOQL6iu1YvEuWXC-GzqsGKFajriEFhMveYkbMj2KWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEKm0cTakUzPSNIeNRaf2zusC-gKVltLjiFoFcsH1LEg&oe=6B032211"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iEIVL5bRkoQ7kNvwF5Ys6r&_nc_oc=Adqp9M2DCTaOrrGKI_z-XHp-_NPi0ASGLERqXieTGD5HspXZj_anCgOqFhTCjMK4Z1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpDNnfsGL3g1BydgC9W7ufzy37iOaAie07FPmKJR4qag&oe=6B0317A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwJ92oEzt-oQ7kNvwGWV795&_nc_oc=AdonB_-8S7KcpbnYsl6mrI6kIULaInc-gVa4Iw43Oixqf3v-pFLWn0wHKhH8GLCj9JY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrxUh8v2BrsSfWDwx1Y0rAtKr_SvQ-hvMl8oMoSw5vUQ&oe=6B03340B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
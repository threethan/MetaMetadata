cdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d55SFXihHKoQ7kNvwGaa1xs&_nc_oc=AdqHlK9u5B6KmMTjep6U_vm_5OZ7UxTdrQpiq2uHOM-1A6YQJBD3eT0Lbpvy3TxjZxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SidL9IOUTvr1TyHUeysE3PEIJPzKVOjecgp_tHxaf_g&oe=69F73EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_FQUF1oTrgQ7kNvwFdc1D7&_nc_oc=AdrPPm4-21fFv3P9SbOwLCGO2cS-DfTcsZ_jbMpVsD5vIFSHqXPgofXgDYApsRmO8Cs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dxnBJRfy6AoxnDASZtsb32b0wrjLY3-UPdedhA1C91Q&oe=69F75B4B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.
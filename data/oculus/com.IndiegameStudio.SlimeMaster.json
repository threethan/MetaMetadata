Q7kNvwF6BfnY&_nc_oc=Adr9_D-CI7vW6rN6cwq_x4MxsWSnbtuxLlZ1XRCIgC6s0JPGdymYGKR-dWqcKwR2b3I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk7yQmmFRVD_4taY4cmGNyOCcOIh-pUWJjDHyXMoZTUg&oe=6AFB3911"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgwvtZfKkEwQ7kNvwGnIpQl&_nc_oc=Adov-e5S9tCyi_HwBttEp9sFw7hLG5qy1fenFroTBVGSdlBoSWv6uaUQhsDWBuMY-C8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFS8KXCCcHJU32UNJZVoz78Bav7O-bzVJw1RD7O6dqEQ&oe=6AFB2EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozFJOk_YXw4Q7kNvwFGcEMQ&_nc_oc=AdplOx0kscXaPV29dzFO_ss7EjvR99eZBI4yck6vw1mGPE1fuQllrzQoZFb_IEaRIBo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCk6zgczrlOAN0WU19qyd9nD95nmAVW9lfCX6iyOgNzg&oe=6AFB4B0B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
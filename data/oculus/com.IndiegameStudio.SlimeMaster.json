cdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km65DzCa0tkQ7kNvwFJ9Frd&_nc_oc=Adrlu-5C8a9jC05gUt6HJ3JvXyPtJIom_wJ_XBp_ZaZERhC7wJTzr2sJUeWNhXbDUCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F1Tu6U62CrnBVG1lvZlEsttBJr5NwJxGl2LTx0t6MMQ&oe=6A007968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1l7Ng5gWFEQ7kNvwHlE7oV&_nc_oc=AdpGCdc2BBnZHrKXzIWKVnjbembDHpVXNwjD6CeDCx6-YjsAL0pNIr7ae3_HstRoc6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70v4R2erzAGj6Z34hi6JXi5K3-GhqL7CuMv9GxDIQJAA&oe=6A0095CB"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.
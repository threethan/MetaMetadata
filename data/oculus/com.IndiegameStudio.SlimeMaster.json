Q7kNvwF2gwnK&_nc_oc=AdoGvCQDJiTOH7R3-Xh5evg3SXjdCDwmmjy09WSNb2P1c3iG1owGNfB_Ro-2oBpr8IE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqPPcuTQS_PyPMr9p3clHkN2lQwmZNMnNjN4lQdLKVHA&oe=6B0C5C91"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHn0cym6O8Q7kNvwF8W7CD&_nc_oc=Adp92BMGRWdR03-jp5csxC34yDSwQCJMuRTqxJDQh62FbUmSb6zEev-iwltoaZaNb7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6RZthADi1bSkEGHZxYlL2emJ7hmiim9w50ldzwIWx4A&oe=6B0C5228"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10tkq26D2GEQ7kNvwE7U_pX&_nc_oc=AdqqpcF5rBOYoEMaqTeZ6ZGfFB2M_VwtTGm1tPg5FccO3u3iBmLSB96KLcEu5qg8le0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZ-SRe2X9DSnOkFy8Y0iB8mQRpLT05ibN7wLgDb95Jjw&oe=6B0C6E8B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.cn/docx/Ri7Wdt3uZohkGgxApz3cgJJunwd", "developer_terms_of_service_url": null, "publisher_name": "IndieGames Studio", "support_website_url": null, "website_url": "https://kqh7q115do.feishu.cn/docx/JeHhdxpCXoHHTDxPlpkcVAlEnge", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9470188013092919"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "557390024103309"}, {"status": "PUBLISHED", "id": "1788107845248435"}, {"status": "PENDING", "id": "729775696583494"}, {"status": "PENDING", "id": "750796061441920"}, {"status": "PUBLISHED", "id": "1819712348573907"}, {"status": "PUBLISHED", "id": "1153277836810932"}]}, "baseline_offer": {"id": "557390024103309"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758225600, "status": "PUBLISHED", "id": "557390024103309"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9426992687412452", "version": "0.0.1"}, "i
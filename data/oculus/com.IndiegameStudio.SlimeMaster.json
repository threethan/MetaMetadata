Q7kNvwHxbDpT&_nc_oc=AdpIw1xbkxbgy8fO6vLuFtArWrqNvq9VCSl_wdSnqsPMPWZYKoxY1poxxUskiNOdklI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRECL08z_JzOEnouD7jy8GZ-hHT6W8hI8FjNkrsi6d2vA&oe=6B007F11"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM1A77WjfUAQ7kNvwGLH9sP&_nc_oc=AdpHz8BDZOW_HyTpZCTP4f4ncyMcdjH69Z8MOUCk4v08gEjb3kTzm3fVtjIX2z1lxzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCrcSWHPwAcsQIf_nkSuHKAmdPp9Jgx2ZnndkakTdoXg&oe=6B0074A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qn6XnjsdDMQ7kNvwHskWlm&_nc_oc=Adp4SgYSPAXYZyjbCh-lnK4VSKF7Wp1AiJZ6IrvzpOllh8B8oxH3Rqm37W6SZ2u8Dos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwAUqjgf_5aKbsKQ3vUVKARkvSTq9krqYAgVgg1_F4AA&oe=6B0058CB"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
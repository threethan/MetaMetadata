Q7kNvwGsSeKe&_nc_oc=AdrrSkpSl25vHaiuqJ6YjJ6m7TI7iuMERfJ8cZgFRnKSQrPSAb0neiO3ocv3_YEBrYA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLfBvfZxMMZeLYr58q49GFISZ8QMsjiRdhHU4V2PWM9g&oe=6AFC8A91"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgwvtZfKkEwQ7kNvwGBvgAF&_nc_oc=AdqUFEoUFjuVmVrSmx4P6JsDHxrig8woqTZx0Iwjgm8e5fAoScAb8PE4-7EgmYalPfs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Tfukb4XoOjuACI5YwFaOH9TKxzLj4WS1WXw19D_pxA&oe=6AFC8028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozFJOk_YXw4Q7kNvwEgO8X-&_nc_oc=Adq71c693yqY95_1U1PvEUly3mKrMVBck3olZWu2cCOzbFiwuErzGJ54xr00lPxbFSQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFpmuTUdNq8LcEzJ5U9U6BJljJ7XeL4npqv_ge8gYvtw&oe=6AFC644B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
Q7kNvwHnIafI&_nc_oc=Adrt_Y-aS5G_2AUwKTE-TuTcW4fYhTfBiHGfhr-3JQEGaCdBuvryZrKrfCo5UhNFxHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTigI372bDmRyqrctE3Q4h6NjtVJnPwkhCHQn7rrzPNiw&oe=6B01D091"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iEIVL5bRkoQ7kNvwGPzya5&_nc_oc=AdrqsqEoleP0vtDFq2IpxwkoVBpspAVpo0bhz0B912FBLvOHxKbA7asSP7X6aMe0jlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBVZhwuiXnXW-qqaUtChvVXKDEa67MkOICDTD5talxJw&oe=6B01C628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwJ92oEzt-oQ7kNvwGjPLzy&_nc_oc=Adrm7VBDZ4l7i2mJr-gVAwHHziqfC5TJxF8Faofz7X3fYcDVV1Os9rej__c91RjVESg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJvN1gCOjihVo9TasBQK8AVAnyGRGZD4qxMyOwDteIRA&oe=6B01E28B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
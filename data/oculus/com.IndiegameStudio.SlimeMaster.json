Q7kNvwGdgMYw&_nc_oc=Adr-4ugMOeO9AETRoSPHpNODT72FwgeXvHfpkLK0MWQdmguT978U6yKhQ_5DoQHWEhk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0gINpnTpXqJevcq_te2pxgwR95fQyrI1mV1mk9Rhn4Q&oe=6B09B991"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHn0cym6O8Q7kNvwGUzOgk&_nc_oc=Adobf_fhfvxgpTkZDKND1Ue7PUw0gi9gxn48Xb14TA8WXMNFMQoa9_5xndEstiPUdHk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdMiBL0NkjIOxtY8U1pUpRWQ8Kr3wCYgS-dpq1RnQY-w&oe=6B09AF28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijum8eMuGF0Q7kNvwF6TED3&_nc_oc=Ado7-7RwlFuFGvn5j7aI5JBwDm0HZh7A79CnFaAZ6tSgZ9W51UZd0xZ928nBucnnZBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMQHjaFqiDsMUNkaL_Z9nPVTP6EeqUJwXN5T-s1egSbg&oe=6B09CB8B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
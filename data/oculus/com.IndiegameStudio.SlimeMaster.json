cdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp-LDIvgX-QQ7kNvwE_q9Vt&_nc_oc=AdorNO44cxD_kCZ79w5kV06zn0BiD9TQ219p_ho6l5Iy-st80PqUy2kb5BU4fGlaLE8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4HD2okqO7Fh6ZBkXDnW9QQLpTZ4-jTHEGCxgj9puWHg&oe=6AF345A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRUkmMc1UiQQ7kNvwETH9IA&_nc_oc=AdoVi20lwZNnANUBO2DccVO4MoVJAKkcF2EfFfoevo8IcRtQ0NTciwK9PHoWzxiaTDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrGGbrmxNg0uUfCuir0kQQTN9msVmLrnTfHTzZ8Hs0cg&oe=6AF329CB"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.
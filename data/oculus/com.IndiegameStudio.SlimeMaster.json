Q7kNvwGKZn5-&_nc_oc=Adqb4NssbvtVGtAinew6fbYrMjbD06GjAsQmIZoh9k6Nb95K84jj1B8gOpAj4Fj4Uuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXRihwB6pmKnx464BnqsiEOD6_GwmgeJ2oi4qZqSjXg3A&oe=6B0EFF91"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yua0ZPAKm8Q7kNvwGnGWFO&_nc_oc=AdqUThhNF3QrnhW1Aoiy2wyF6UbKpYtC78SIfh_6NuG65ooULQ08KUeeQODn7_oNAKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyaxlvIMpBLLsu9S2m9SJ93Ngqup0AUXx2-9QzrcrEjQ&oe=6B0EF528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10tkq26D2GEQ7kNvwG7_GUW&_nc_oc=AdphoyMJieATQUod6ZTct2roeH0uQisQUsK345zqkFh8_w58iLoWm5iKgCsqBCRa5RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHNLLoOrBgPHuLXbvGmQGbV0XJl5dw1dzTyNgCSB_tCw&oe=6B0F118B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
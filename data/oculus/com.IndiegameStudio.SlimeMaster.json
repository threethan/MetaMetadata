Q7kNvwHQtnoe&_nc_oc=AdqD9pmHYyxKiasvTe-X8DUQ4pLrS27-_tdii3VS7DHNn5Zd1BOioU1iLeNs0nb8iXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCLvB_VkrnWqqlirpgFmLctzc8mrHxcHqUcKTpwaRZGg&oe=6AFF2D91"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM1A77WjfUAQ7kNvwG6ymfb&_nc_oc=AdrF6C3MKVWG2pd7EDrNJzVVo3a6F4U__6h_tQKicEuYTkLrqou3lT2ggr0ToK3jvTI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQydggLLJqzimLszVVWQIBpsnJibvTvCPjis-ndljaHXA&oe=6AFF2328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qn6XnjsdDMQ7kNvwG02kD5&_nc_oc=AdrFEs_koxUlDF26f0NjBn9Bpo-cszObFTreFpMetoVhZzW8xGpyTOYyzc6-01goHL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1-yypM2mn3PGorI5gvs7xh7kqK8rD41f2jLWNc2F8mQ&oe=6AFF074B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
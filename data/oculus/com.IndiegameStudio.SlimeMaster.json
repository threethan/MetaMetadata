Q7kNvwEncaMS&_nc_oc=AdpUgu6sZLTEnSraqHeJi8A4sxx8h1aZ4uO-v4cc89nasAOrASDtkP5i8zOa_Ngg48k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlK64K0b4WiQAE5kBTjlkx5XsP9zfRDykpaFFUuHP6Lw&oe=6B047391"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iEIVL5bRkoQ7kNvwFU4Pua&_nc_oc=AdpNbfGFLLiJ75NAxtKbtwYHP6wXe_qaqfTt8024ZUGAW4QPMEobS_X7uvJfxpEvFOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsxRY0RxS6QrN404H9tJG0AP3PG3_Bjd_BD4c7XGlmew&oe=6B046928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX4Sj0Q1GqMQ7kNvwHmAGH-&_nc_oc=AdqE7_pJoH2JmTuW8-uU-70uO4JknCzTW6fGpiZ1eHWKECgEf99n6wnhxDDFEm-qArw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTgw9aWL1vuRS3taGzbiwBhUIcx_EEuT-kolPOvW43Tg&oe=6B04858B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
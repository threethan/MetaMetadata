cdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgwvtZfKkEwQ7kNvwHflB7V&_nc_oc=AdoZXy7HGUduvRXUvTJWY9_oosSNOFnZ-RKOxQLfDu2HsHO-RmlkuARf7mirOhbnOVY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb_Ozw-qpNjcuTQLA5qkGLJhj2Zaaflm8lYi4fitom1A&oe=6AF9DD28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozFJOk_YXw4Q7kNvwH9TdMa&_nc_oc=AdpEuinBBaK3QL3ercj6vN0AW4r2wpdZZ2fBRJehqUyM0tYOaKspAalTBvGErHRD1q8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYzDCTEKgbMi0sYCjfFvOTvBAxSVlE0kssiwEAzY-8hQ&oe=6AF9C14B"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.
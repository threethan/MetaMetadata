Q7kNvwGELnBj&_nc_oc=Adqkjre69IdcoC1sIz0DhOJteYI8AWKfckfvowyqPAUBY0GcHG4lbfuophAimeIdkco&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnarYS7V_MMj3s44jVZsRCZTVshoFoDnmqjU7JDWWJGQ&oe=6B086811"}, {"file_name": "2560_1440_5.png", "id": "1226450125576533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396566_1226450128909866_3231023103920745487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oOrAvJ1XtUQ7kNvwHSU3o8&_nc_oc=AdqX2zCDsbGTk6MLGkcwQVuSXqR1OdBjNCv7OrPNoYvYRml8uR9cSkEFqjpLf6w8CWA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-M2Z2QWIwY0BwbGqYwD6qvpXG-QBEnJKzIRHuJG4kRg&oe=6B085DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "578970774609920", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820111_578970777943253_3292077456379739026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX4Sj0Q1GqMQ7kNvwEBxUdW&_nc_oc=AdrpqT6AdDg5-n1PKjDWOyXGkGdG4foaCzdzntaJyR7w_-RGysNnsoXTg2mgDHoo15A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC2TfK-fMuvITtVO9tHeXM67zzAYOGxLslppQTx5N8XQ&oe=6B0841CB"}, "display_name": "Slime Master", "keywords": [], "long_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logins.\nYour only \"quest\" is\u2014keep merging!\n\nLegend says a mythical player once created the Golden Crown Slime...\nRight after opening this very shop, they merged non-stop for three hours.\nSo what are you waiting for?\n\nYour true quest is to summon the ultimate Slime!\n\nWho is the true Slime Master?\nWho will summon the Golden Crown Slime and rule the leaderboard?\nDon\u2019t blink\u2014one merge could change everything!\nMerge, evolve, dominate\u2014it's your move now!", "short_description": "\u2728 Welcome to the Quest Shop! Well\u2026 actually, there are no quests here.\nNo coins. No gems. No daily logi
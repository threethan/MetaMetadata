&_nc_oc=AdoizF8PUXlOcDXsq5Fh6sKtlotf7T0rcWvcEFdfWaTUVz6CKwJD0jitms76S3eMmj4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qoiNPdLVcGNwwQYEXuULQh8FYek9pVjfM2J31FvSfBw&oe=69F8AAD3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIkxkDj-NTIQ7kNvwFjl-yQ&_nc_oc=Ado1rjwG8cAY6ohnx0Ia-VtvkBtPT4GrsQH-G-VxsIFe1fkiWEWVBWWMkOKFNV2Codo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3m1xWzqy4oRkOejPgnAmxIV0H-jffI2Zxw0bIePyQqww&oe=69F8B6B6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqFwU9BcL1QQ7kNvwHmZh_F&_nc_oc=Ado6wCTW_9lAIPmcWiUwUS8oIkFCZsVBkZ6h-xEM6ZtZvxO_Xs8Q3qv4NBEt_xS0ZtQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iFiKAlyH7Xj1YVC37xxthii2JS8cEOASJEHHg_qiSiw&oe=69F8B3E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-0GdxpVQ9MQ7kNvwHxImgH&_nc_oc=AdraNIia6KRx4HmNYt1dbiBByvNjpgPsE_63mLQq-arQzePDM5k5J8AYV1cmSvsYUkA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Bh3cTQKnXXXds83RvjYB0tbFg8-IR88tnzRNBIbPTCA&oe=69F89446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCUFPxoGEvYQ7kNvwGgVGgM&_nc_oc=Adovc0zv1p4TlfTBIafantPXrl_JPugHfgIu4YHsK0qDuMWkbCieH4UlChCttMPFaYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jeKYu9WBdvNA5Iuc3k9v1ebb4pB89m8xhkgqUL0uNQA&oe=69F896F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
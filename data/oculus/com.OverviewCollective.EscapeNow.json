&_nc_oc=AdqXjaUdMJm3Jl0yvZqqztOg_5cpCsbd6kjmnCC63DugfKm9S_3_zESPjPMt9D3FgeA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WzGDdy4QH27ax4FBINkA1zPo9zKon-CPlNDTT9vBRGQ&oe=6A0F1453"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEz-TQqKs7kQ7kNvwEztxxv&_nc_oc=AdoQ6epBTeSZshQiLRs2RPIEy_61W0nW6FI7Y-b-nw3sXpmxOeNicLKLcn6YnaNI8qI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YqFDU-UOMMhI0OX86whcaQ3CEZC7Cjg89YLit8Eo5sw&oe=6A0F2036"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-2DiT5E1JgQ7kNvwHQ5xhI&_nc_oc=Adq-qfk_8zZEyV6DfncUYShfQk95yM2UGMiejipZlUlZTu62B7T_Qx0l8znTF6_9jec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FdX8G8SU0lj_znLIIKp1JQroKoqp3jYXh7fg_vp8BpA&oe=6A0F1D65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edArQztOpJUQ7kNvwEVXjwy&_nc_oc=AdpMusDZ7OD5hQxe51cx60xwM6dFfOKi9sCXELZ32Xpvn9rjW9Oh_dp7z3FKDNiggVA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6peSAStdua4wyBAZrCpCMolF66EoE998VEA1iuw12B5A&oe=6A0EFDC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKn30AWpY_EQ7kNvwGgC70j&_nc_oc=Ado15Hr5DV_NIyww5bpsBegQDOz82MYdEJCSozOxp44emKt6bbABtZkF2tx20qROUVI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SVcrKuqz137LoI6ffb8Y5idrQ5EIKIC6dOMEBe9RzhA&oe=6A0F0071"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
"698025708429099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA3Pz4sDm8UQ7kNvwGJpBqf&_nc_oc=AdoMrlMK9XC-Hhsnox9IQWF1y5WUlHGk3PPc8PJIRd758ukp39j1_otzbp_caBesjeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PoJzBJPBhWDHIJ3pAmBdYUGylV29pwTv8iTE7uX-jUw&oe=69D4E325"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMClPDQjHcoQ7kNvwF8EV0l&_nc_oc=Adrv_BZQ0ePbJVh3BypA1uIbH-7YzgvDqawYnhoh4B_p1oLb8ktgzDpzzclw_CjXWEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pJ7aTC7vJm3WLNoA2dkfdLrX_DVEmfRL5hAprxoVF0w&oe=69D4FBC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHJKwRwHDjMQ7kNvwHaHLa6&_nc_oc=AdqAdOYfHU3IaUQKU32EA-nMS0DgaNRewbNf8UVMpUFWSxv2gkCxlIKx0QCCoWOlyUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xTkIYJAYMpF_NVf22NJZ3LPxKE4h-jX1XUCIDYvt52g&oe=69D4FE71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654071"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5683890508387016", "version": "0.95"}, "id": "479281587733012", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5538182862957782", "is_concept": false, "latest_released_binary": {"__typename"
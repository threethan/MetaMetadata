&_nc_oc=Ado0pT9Srk7ELcy1BJkMMxn_YKaFArQDmtVY8tQrT6aNADPPWPhI6UEfQ1oFNt3TmUg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYvdbCsAnbtWlDVBb_37zCIQCSFy_V8Dj-X2Z7PqUOOA&oe=69CBD7D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9siKDJjNKoQ7kNvwFiFCd9&_nc_oc=AdrlgZDeBXaWU_LFtdzRmJq1k8puI_vIzn8Apvy2qRfIzmzouBNPr9DiI742BhNVSm4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyliSizEkj578JWpj9ckshBaTfdBKlwULQ6QhRaUNtAqA&oe=69CBAB76"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmGtFvSZ25wQ7kNvwF89veZ&_nc_oc=Adrg0y6nvdJOlhyukMnyQ2dOWeUJfVhLc7O2fqR-swTMqYjlBSxLZ4T2Ps4Ltvk-mqc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVmwT6rtIi-DfnbQybof4ONVUfQT1pUAhNbGSTjWWaBw&oe=69CBA8A5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCS176v5PtIQ7kNvwGzqkjW&_nc_oc=AdqOwf1t3t6rrMj4-QBa761Wt4H0D0wpIrlOrSWICKZjsmtQggTsiLBd-wHV_RY7PIY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymSG-AG5kQKKSOjhM2irdbQQ-xaHkUel3r6BSTDVTLFQ&oe=69CBC146"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njkz9tPi38IQ7kNvwG9nVmx&_nc_oc=AdpgEo5_6i9FRcZrHVlWXY0N1ZgL9nvwGMw1r361soRcWNHtyRgNGfk5yOLhMcn44Do&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHHPZjZ-N7cIXUZ6reqFlzZwAhaWqjDkML3jLs-y-beA&oe=69CBC3F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
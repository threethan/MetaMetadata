&_nc_oc=AdqRfnP9rZBt6v6rSdwifTnlmBoCj12KHf7Wz6PBFJJ36ER5gs6C8VM6UjpFFMaTNjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATzShSfGh9XsHqyjTZ_CXGsaboCE4S81MQCEcvfYuzlg&oe=6A4BB953"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDgGkPeU3wwQ7kNvwHoEdT_&_nc_oc=AdrlKa39Xj9L_j7h870WK2349zYPpqhkxcPk86CjL5NSmDAK9qfP2IJJ58Nk3BvjrkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw9gTyjWPEfbjyI_xpoE9zV4WkAckJ4v6o-XOtk2PRlA&oe=6A4BC536"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrAZ5REh7HwQ7kNvwFK_m6i&_nc_oc=AdoQU97J0aAzSzeNtGWpSgXG7nXJuJqKNEhy9SWVE7LuCkmSU8qs7rp-Lq1SvrOW3wM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh_kx3rOtmSqiKuPUV_lVINgQdsJbZlkuMJouz8KEooA&oe=6A4BC265"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIW-FHs5GksQ7kNvwG9y6fL&_nc_oc=Ado6RZaaf7LDfOtdPyJmxYRKHP6UrTxfc1qzsNnGb-d14Y9vG2oc0UIUflgTmfUprRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuTBpTb3-6NTjg09DPtNRt6dinW_Gtyj0yOl_5Z2i6QA&oe=6A4BA2C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbjGrQ4BLcgQ7kNvwGwA3UV&_nc_oc=AdrYTzl7dNquu4qwUdpAlARM38GM820BeHHVzrBlKu95c-8SGtMQc__uyYJR3l-aPbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqIFV15qqZCZN9TKdAhu-OYs-GTcYyhsUC2Lvi6X2nqA&oe=6A4BA571"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
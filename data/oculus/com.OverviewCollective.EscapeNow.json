&_nc_oc=Adp3uSwiHEGNeYff55aR8q6TnRAbcAOo0nO7YFG_t752wTo47WXtWEQeqzJ7kFyFOSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzPp8d8lzWuO8J5BfK74lQBJaKaCdwyFNHnHAWcLIckQ&oe=6AEDE1D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2qjWWXrX8oQ7kNvwEvCI61&_nc_oc=AdrWlb94swRS-kpf0TooZxjUAAnmbqIbulp7dmIh4V0xTPIO_hcH2XNvwEghRRimmaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAEZCVvfXF_I3pnFYIm5OXGSjyGfgsuZYTbV0-YDX-Nw&oe=6AEDEDB6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcilnKsW03QQ7kNvwEhLsIy&_nc_oc=Adrg3jTGNI3Ew_Rtn2nWEnh5lOArMD0UWw_l8-6iXYvMLweBJvJnDuUlJt6RJUL5yfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVc1bIefPMV7PSfPRI1ajUt0-BgB8e_RayBNhR56A13Q&oe=6AEDEAE5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48qKm1_sApEQ7kNvwFSmZ6o&_nc_oc=AdpJuZOQt9ES0dptko61aJ8TGKpzDvHns0w634JOAsRoaD7A8p_bKMiRAcqfschyTqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyi4m85smBZmvizKYlR6dqSBLgQPxo31LXbn5VHAluHA&oe=6AEE0386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSeUvZd-8gAQ7kNvwH_L4Mh&_nc_oc=AdrMYPFXtdpNdJXzCOWAitY64sB4BI1qqM7hfmSsDdbe0Fn0XrR88lQkfWlCuDvmA88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZKIdz4tfVRMaoop2a8febg6oxOY3qzQhsdiVmIMcRrg&oe=6AEE0631"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
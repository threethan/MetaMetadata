&_nc_oc=AdpHbWCa9qqH99G8hUgjVUMxcS3hsEs6ojr1I6qmFyyCiz41fPJm0_YWStSX6O76Ngo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w70wWu1ct85pb2FOxLMy8xK7SxgDi7TkUscEsC-84Ag&oe=6A26CF53"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_qWdti7dzYQ7kNvwG1Cifl&_nc_oc=AdpXfDy16iBiFMYfKeYUNaz90_heMqb2nULHKoCghiTvjUtRbBFIk156v27qEWSqSqA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kjchltuAtNYgB7xDdXUlmE3qTYxq7wgY0VcQJWUJ3bw&oe=6A26DB36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPiUO7fMMOQQ7kNvwHuHsKg&_nc_oc=AdquqQFELWhUlo2EbyVIMh5lyWdAOBfNtlV2WMVBZsfByS_zfPjvcTNk8fATXBjLMjY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XFvcwei5SGkvaKXQ0aigGU6Lbo0zdFTRDnEH703Bnng&oe=6A26D865"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPzWfHenn4wQ7kNvwFnFkCV&_nc_oc=AdoazW62sUBmEOvU6nK-Z-nz1-sNraEVEgF8PY9jGwcsj64PCQ6Iw-VQaImuVr3CYv8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_dIj2mIBCGDKRYSktGFB0gAnennTqEOGDnFDTmlGIKw&oe=6A26F106"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIrm-g2Zgb8Q7kNvwHwGXro&_nc_oc=AdrqjNPAM7ryrD9e1Gozzrc-0v2ghH_N74PNgVv00dKpZ07CWFPwBZ4VbD1zhI9bXqI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eFpPgZjx_YVk8i2fVIvaEIWiA7UFKrRctdPu2m6RTYw&oe=6A26BB71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
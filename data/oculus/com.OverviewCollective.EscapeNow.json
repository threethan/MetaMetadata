&_nc_oc=AdqMlMt4Xtb8P4LzH4-OERNho9f4dCpkL6OZA50hrP_krQURZkjRoDkzkM1_50Hvp0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5wBH5eK1tkPXzIuL4Vyu4wcKnJjWLhvggKzg6Gxc56w&oe=6AC26053"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JikQujiAHYwQ7kNvwE5-Avj&_nc_oc=AdpzzMh5dkcZmWEyR81Q5Olt43ijHrJ8xyr_MdCaVNlQd4iVWsE9fjx1O8qgXte4qBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8f2IVUW70WtFLdGVXgSIoVHT7DqtezNDg83aRO9d4Sg&oe=6AC26C36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmPyliWWnzsQ7kNvwFEPL3a&_nc_oc=AdoQCvluNrkX3G-IMtaaLgFZZbAggk6CMlxWAN8ILaLVzC1yUKMhbpfMSUHYyRdRYcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGaftqNPKppuLCXj210f4UCdR-TI1yZ3CZxF_np95ktw&oe=6AC26965"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPcBNnwYJ0AQ7kNvwHRDJzz&_nc_oc=AdqoUfyuXtUrqtErx7v9L9ud5_GlH5cyvChX1iI5u4mQp6HOkSi5-LrMxLPfuJ9Q6sc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP3_w9C4IxNRDf3W6gvFdDWPnQFTELS5lIXb6juZyS1A&oe=6AC28206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW8K6dB3KVgQ7kNvwHqqifn&_nc_oc=Adp8Td7Q5AiAFT5FblTupC3bR7kSaZDyIC3D0ArRLUh12ByJTFXDWTJyxAtLYkjGJqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLZwYb_IdhQyXJ5m5yCjU1yfEgnMekGKY5XVk5oHbZkQ&oe=6AC284B1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
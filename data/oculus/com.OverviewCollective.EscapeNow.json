&_nc_oc=Adol3oFGwdjNVjilW5H6eJ2Ynww0E1KAVj7R1xQtIOQdy15Wr6c9U8vCw9kJM12hroY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt1qN9UyELeayssfSZMFvkvqBYSRGd7SwzVMU3aSZM5g&oe=6ADCBE53"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yN3uCsbHNvoQ7kNvwE9En27&_nc_oc=Adogag4b_g6lY9uEsJbVAKU3rV16lNxmkh4OOldakGKFBKWQ-MAAo3xR9RZ4nf6OQtQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKLFfo7s32zrWiSmOI8eciYoqv3PL5ZhpdYJM3nPZKDA&oe=6ADCCA36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZuOVrGO494Q7kNvwHpDNUi&_nc_oc=Adog00Lzd6QNNv9fHyW1gRpfvCVPFpYwQTOZBX9p0GX7ojYIfjjGi4pYR93xvpQB7YY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYC0Irigt_siJaRNC7y9ycUECkIV-dqDicJPKBUcXV0Q&oe=6ADCC765"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNPw-4xIDB4Q7kNvwF8Gs-p&_nc_oc=AdopYCnbLP2tHTMyuNGJUDehTuBWOeytr-pawlEJbs4J_Cq4pQ1REttkw4yEXtvPKto&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAZfb_7V6rI3T7vK5IVKNAdsdLzgMtd2hVUdSgqAEcrw&oe=6ADCA7C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ2shDkEcAQQ7kNvwGee5xg&_nc_oc=AdrCXefAhEdj9QNbihfFzA264qDf4i8-sWSSqbYmiV4rZxEQW1mghqspRJIuJ4zjHsI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn9u4lAFwRKHuymRCJNv3svj_kc9QlGdJfgAqeRCwt7w&oe=6ADCAA71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
&_nc_oc=Adqa1KPhyYkRKkSErwtmGXxkZbRLbOUCNeaR0JuCkT_e00rpNX9-_6_pBumKJw5pT9I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HqN2YYEaSOSFX7rwimdSzqAbREKbymRARTGa7AWGV6g&oe=6A0C7153"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEz-TQqKs7kQ7kNvwFx0A4D&_nc_oc=AdrxJEt7zaeU1CGrmECpMnu2RJmlgXeJYrFmoiakGl8jnsxW4fz5kCkG9ZeJvp0jvYg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b_S2Lyt1DRTacPOIfJT32JT9PkcRfVm-QDzMHXjjAtg&oe=6A0C7D36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-2DiT5E1JgQ7kNvwG2QXVY&_nc_oc=Adq1l1XPnwsnhkw_SEgqog_L6kY7HUzg4cMpkb9I9RSNbIzamGrniGhLSXiuS_kLwME&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W1ESAoJ0VzdN0hGFteJyVj29Z0pkeSKvhu-lgLKIRLQ&oe=6A0C7A65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_Dyfa5fXdwQ7kNvwHWdOKH&_nc_oc=AdraO4w55rIvfZ_6EitZzqrCaZRI0eBwoYGaQkWx-xGkKloVnuN9G6rYg3GrNWCzqMw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ViVsNyifGMiQ-tw8rfZfB6HZlwOG3F3x9RqVaOpIOLw&oe=6A0C5AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfTscdoNpYcQ7kNvwGdXQ7s&_nc_oc=AdrSb-uq3Vk-_5u3w-duEuoRke2Hv8kIr8pYc-0O7lcOrJbtDk_XS_mUd744XFVWDw8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bnae0d6CS-R4E-10NNCt8a1_oLcglvqHUUphJ2C4T_Q&oe=6A0C5D71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
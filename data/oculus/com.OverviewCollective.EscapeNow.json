&_nc_oc=Adr-mCI4gJvmpi5Umt0szanEZ7FIFvfGCbq0VnSyktvw3BpVBK_O2IhU-QCDARkrmc8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tWswXs0lhTNV06bUhs459fds_bj5eAXzKO1mU9pHmMw&oe=6A1065D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u56-82dpPAkQ7kNvwHTWNfj&_nc_oc=AdrgIVGjcnR3fO1aD0BE8okRexytGp9ym3POfVYvrmEfvMViIxe8BlXHdvqFCSxJ9CI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XYogLaNUr0uPFXPy6lqM92qYYTIxULdGecaB2Xqar_g&oe=6A1071B6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1R53APkgBMQ7kNvwGzx5YN&_nc_oc=AdpmNXp26pNCsJLY_QkTzgGofaWK7iDgMSNFxwxoE-2ceqWcmfpay_QTk0RcIcjqBzo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MAIQBlKvkNfYIm1GqYJ1SwAeOEmXrpM5UjvBM1FDmFQ&oe=6A106EE5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edArQztOpJUQ7kNvwEltawi&_nc_oc=AdoM_cSETud3khOp2Vdvsj9DXJBIlijH0jFbKHyb7IFSmnZ4rrx7h8lQsBDLWEDANB8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dtsmUEsXL4O58wSVZUEq-he6hfbeJqx8gPMamcpF1wQ&oe=6A104F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKn30AWpY_EQ7kNvwEZxEOk&_nc_oc=AdoLK_z2iOutplR6_P__gI6fplfdT6i_qDRtRrXHaSTJH9jvybfpIBlKCnGYklStSkE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N7O9rYcnf5RWGAP6bghwz5kJtpMOvxbsYT2o3s7MhEA&oe=6A1051F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
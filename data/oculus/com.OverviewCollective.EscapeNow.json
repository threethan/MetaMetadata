&_nc_oc=Adq2WKJH1BWyMe7WoB_irpB9YcUvvuwtDl_Q4nDFH8CMosxHKHgt-XWGM-y8HTDVPVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZMHNGiEY8n5x2C5o8TU6ZORJbaR2dUOVbbTk2Qh1eTw&oe=69EB7BD3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1I7Vuu4dIAQ7kNvwFGp5Le&_nc_oc=Ado29cQT6ybwgHWwoD8Ro_wSqweXXTuEKxfV1NKRuo84VOxe-lxXpX-zxl5FGDyPiGQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af287aAGMo5inEqh8dyV2lM9K8W8fouzklJJayWEbZwHew&oe=69EB87B6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5IDrDVkYT4Q7kNvwHa8fcG&_nc_oc=AdpQJHzW5XbqPihOwdRY45A6aqQJSuQ0aQ-QE2E-Dc8L6AA19g0ymcHVuAu55-GMc08&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gGMb9mSv3LtIFWDhPtjwCOTqmDIPG5VN9SZMLPtgmiQ&oe=69EB84E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0QcbvBkNCsQ7kNvwGK-e_g&_nc_oc=AdpA5PssieG7ioUS9UF66fWtT0EnVSbrbUzK1kfqRESMXpmOUR2OBWGY2tkoWoiPzZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36LrgiTCynfmNzWCRi2lWL3b4hGtCKkDCbc35QQdatrA&oe=69EB6546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8mm5r-GhewQ7kNvwHxAlCF&_nc_oc=AdoCkh7JMUoPIlC_IFXaX3TultiXZ0g86zBofIMhQ8hrBk9TW7Txa4QJgVx1zry825I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D3r1e7gJflIhFujwTMhrABOaI7K_2dLvf__tFKREyTw&oe=69EB67F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
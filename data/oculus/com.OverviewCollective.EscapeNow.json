&_nc_oc=AdpZAfDcSuQMfeZr-Qg3OLGdJPwXXQBR6LxCSVzXAn7FJtVraQ54cX3BkJQAJRCDLAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq0Kxaqx2JGAkxupz9MYGlZ4OBAHrQZxJF61BMKAKQ5w&oe=6A6222D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6ZG9PE4LuYQ7kNvwE8mUGM&_nc_oc=AdolbuLT0tRjMBZigpzw4915sbkeOnmmA3yOkGz8I3L7Hw60x4khuERa7Z-1w0jnzxE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKcS-JmKyqstjriWmtAB2WYTANjD0rU8cDeVS7amylJA&oe=6A622EB6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koDqEQlzogEQ7kNvwGk1v_k&_nc_oc=AdpUFr9clIBP2GLQjDDI9jzaGaTI-TXOXuD8wuCQtTrqaSJahdyHaUuh5ekjGwgSo8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIclMSzFfYbBlmzA-q6v2NIT6KglGFycMuA24fsr60eQ&oe=6A622BE5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHPdd0J2cL0Q7kNvwE5GnH6&_nc_oc=Adq34aKrFHaPfelk04eTYqUCKy4GQe_CyguKicMCJU_Ul6mE4ZKF9FWBVuqJNH5Oldc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuka8dPpZqteUaWxGhORJCN1nI9uozv7_ZFIIL7xsKrg&oe=6A620C46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZShMaY5mQ0Q7kNvwGflmKb&_nc_oc=AdrkB-HeKd5OBGwJZTqp4sep_Ce2qll41f1WkUI7DYIKek22653V5D1hS_X0VPrI8GM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbeRwyYSrgRxXb318ihDPXiFH1p7ZU0UkLx4sz_AYVuA&oe=6A620EF1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
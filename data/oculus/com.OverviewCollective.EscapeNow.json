&_nc_oc=Ado1cPOt3mzxgp_IA7wv6du9H0JEY4jsOrCSgZRm1ps3vArg5FctDtUfTOwQkKy0qeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HiACkY-Y0s9lKdTb6u7XUKv2C_fekdGuGcBoA_td0Cg&oe=6A2EB853"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptcKekYQ0RUQ7kNvwH147ih&_nc_oc=AdrFO9Ry7RIJa7Cn455UkLZt5Kr1MCbKdqXFXOI87TbdV7CWacCFOnRINhL75KRxomg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GKyd1ueJhaSXbZT74wwCfcleHYFtJeXIalFD48Czkgg&oe=6A2EC436"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qEAXxHeIK4Q7kNvwHaUlsj&_nc_oc=AdokZoFsQEnEfzwBtNTUcSBGJO3DnccqydNrD9cu3uPu945HFMyAmXcUmKBNpQIBJM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4g_FhxtmDs6ywox52HsVFEQuDPHrLHdoamT3MzgLu0Q&oe=6A2EC165"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGYddqC5ch4Q7kNvwGc9ifB&_nc_oc=AdrgyXUQefqMPiEVfrEKpS8Qyd8KS377O1Qn6xcrRrzrnu2p2FPjb8rqgCp-YmuzvK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6953n17YY8cyUQSKjQX_8edF1dYzZC0k1NQ4I8cVGwQ&oe=6A2EA1C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKnVDGbcmLEQ7kNvwHwtIoX&_nc_oc=AdriYaLsHIE_WCsKsCQti2d0HruJDWDPsH5MJ-RpF-2_ldXoDIs7IXC2YxjaHaOgxVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84OrEItk9jKQSy-nfx7KouWHNdCJHx2l7Hm09wI_139w&oe=6A2EA471"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
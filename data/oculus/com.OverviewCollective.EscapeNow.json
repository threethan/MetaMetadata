&_nc_oc=Adpr3gLSbKeE5Ak_uUu87PHC8qSuK1xdDBjCi5e9qnpL3jpPpwYYJZTmnAUCLuHKeTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G7TuQdfiC5bQhRYeMOf0MPb6TprX6vhE5ggcZLJJGEA&oe=6A297253"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKhKjCVlA1QQ7kNvwHutATe&_nc_oc=AdpNCXT_Mcu6mFxfFw0jNieDvzNjBDwm7ux5g2G1qJwRUx_gLKy6wY5nhuz2jqPLqtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XbbAk38JBFrxR_fWacFOBTSKz_zGBpHT3ODuQSXvJSA&oe=6A297E36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4WA0SwfyCUQ7kNvwFIX4ee&_nc_oc=Adrb4NycnpUFC6WN6SeL4joB68PCduiVMNNmwBm8IDPfKQjKVETq9JlmcXc3P4Gfnbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-coTm2iNsYptRcwLSOtwMn23wbovBS5Q2iol34r55ueg&oe=6A297B65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPzWfHenn4wQ7kNvwEVtDWa&_nc_oc=AdqD8pqKO8iGocQQl4pXV6DRdzvJ2FFpcqDn5LIm6oYb9jq9Ypyi2ooVdT4urL0MLqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--8kPDeYsEjK4fTTym9AH387LqMK3xxatHQJ7Y43hqWQ&oe=6A295BC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIrm-g2Zgb8Q7kNvwF8113I&_nc_oc=AdosnADIPygkeWobAGs6WEc2rlxzJ8KXkefinretla-bhNhcatq7DDappW-qOaIMakk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oOxU2WqYAckSOOarV2ZUGqm5j7u-lkHlth9ciFYz9eA&oe=6A295E71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
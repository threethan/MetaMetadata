&_nc_oc=AdoBH6p_LrDKStcjLFEkwmqghtUdCmfuDAH-Q_cg5MoVBuHfR2xw4ePIonR-s1GMuD0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g0J5ppcg3ibSdGITLwJYzyRH9XCByh927TTFhJrlPZA&oe=6A01E553"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccwbVyXJOjsQ7kNvwHsEf6M&_nc_oc=AdrHbT3hXmJLwhJfQR3yaG2duGrHxHuo4mTTNiaPPr3JrNeBoj2DiP9MQCBG_J3vsFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z46I4DxaYk5eDD0a4fyygWnv01I9L--afhizPoFBSaA&oe=6A01F136"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfzud5aRtd0Q7kNvwEOZ7_6&_nc_oc=AdrbsW4Aed_w-g-y0ibrbeFI9wTUIeeNm460oyXLFaHLMqddrcIo3gfB0i2Gh0mFPsQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5icx7mGroXKDK78NQ9UwDDs3Xikj01-y959v-er8eI4A&oe=6A01EE65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YSXeG4WLZgQ7kNvwHQP41q&_nc_oc=AdqCrvMKws3HyOsfBmKt_5HiDM2_5to9_xjI3MPhyyRhBAhLmmnbuJ0SCRkey5ZWPS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WdNI78wEA9JqTJ7PbrDxrrmK_GOA9suvNFervxf5XIg&oe=6A01CEC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inxy6M1SUboQ7kNvwFJJdsd&_nc_oc=AdqsKdvwRuoVQT6C8xAM5uAPsZRyxUlrtI0Q63qZKiSLaCHqu2gaIRpNGsbDgcjlY4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TCte2OkcT9_8vCBbHls0ApPQRgbPkbnxJlxZ46I_IGA&oe=6A01D171"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
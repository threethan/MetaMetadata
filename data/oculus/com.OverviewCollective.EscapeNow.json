&_nc_oc=AdpXX42-QdIJ6YIj2Sq_X7Uhyu6uCMeCN7I244zFLwid4uHjmYKF3mgHskPov7nu9lI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0-IJx6_1onAS4rDm7wtIzYPCf5pgwmR5-uTQhzRukcQ&oe=6A5B8B53"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEmDAp3tbJwQ7kNvwEMu_l3&_nc_oc=AdoOvSEVjuX9LctAndCyjGu57tfktpu3qnghvTawfGDRprcZDRJDd34SSYYOTV9eNmI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSQzy7lL8bqnoOUwLe05yCgU1CI7GhdELRsXoJPreAnA&oe=6A5B5EF6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBp6qgzyYPgQ7kNvwFIbhbq&_nc_oc=Adq6ffdNRJuuWhxJeoTtwCQNgiGj3oRDGZsA5i1dmixGWlsLDcstTjhZ4LL5VQ5fToE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUkKh_f9Gf8STHCHHX52VwFMgAjMAftvG30feEDIEIvA&oe=6A5B9465"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wYx0Ys89vIQ7kNvwFf0xSk&_nc_oc=Adrj66rPzHNGdqTkdGNOfhRIoH9Npw2a6MGr07oa_UC90bRSUIbYQSy6QZ1K9sf0-ls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfUxySTa0FB1zLrN85cO6N7TRZ7JkdHTdaatkZfTVCbQ&oe=6A5B74C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfoBAeP-VLoQ7kNvwHPo_Lo&_nc_oc=AdpwBB24gm4Wy-HhT_E5Z1OZZH65wbfyrxPtO8qXN0-pNDOUDyJOb1vu84FBNG9_580&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBISWw3aySQSYoG8hSssFJIAmgPpUcZxOvLvDnB9pSqPQ&oe=6A5B7771"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
&_nc_oc=AdqyxB_2Utt7Z7mPQVSpdbFsLuEzA7ec1XvlmfeN55Qfv6rL764vtYangW4Q2Kk734M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0_EKwllwusxXY3j4rCDft403rucWJxx3QR5kiz1iI5Q&oe=69C54053"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8k90QL4LGB0Q7kNvwF-iqPU&_nc_oc=AdpqPYt8KZimaEEytC_QdMcVdHcdtzedYJWMSVrrWn9Q1JuYL61d21LyTmiA7REu9NM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzddeXtWLHR_K_ZHYlmp1q6iK8LYhBczgeRd479fSjkpA&oe=69C513F6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecVG__tWMCkQ7kNvwEAJXj5&_nc_oc=AdpGxAbC6gneHdk0ZxWbI2Ry8weRninbQlbqqTzfvLZKS97bECnA7LjvZProQf5hs1o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziG-gquULtp20HlnoCh7XmH4WK3VY0T_wCtbSW8N46Zg&oe=69C51125"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqqwAPh4a3oQ7kNvwFoQnkx&_nc_oc=AdowSlUsCtyaOwE_d2angplxl_hxTi8JdJphRLlPvaSPweIH4msocj69cdOF5AWaqIs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtQXU0ODa3nwScwTGDaYxqbRVdWqk1nikvr7IA8BKuFg&oe=69C529C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGnuETSCBNwQ7kNvwEubPEU&_nc_oc=Adr0Bfg7-XJdzPkaCKDyuxLu5XKqrP2XfTJDuLDne18KUfd7ZWkOxBr8dwiIYOwrPPQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxt64YqX6cLwlXWJfX0yN8oKDz7XvXyHwwfAkvxxMW2yw&oe=69C52C71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
&_nc_oc=AdqMf7Ue2noLJ-vOYX1xB6PnhQPbi3XBsWC7Rhh6o2YrBw3vYUPYgcDCevEmrkyD5hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhBs9Zua5Fmt_-8XlvXfH_22cI9vGGTT95hI_fSmV3_g&oe=6A79DDD3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClUT3-lA9v0Q7kNvwFXNiW4&_nc_oc=AdoLTtycNB90P_M92mGONb-ZBKSb_sU18NF9_QjtnygJtnK_CctUsMXZwXskw2IJSg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTlPqqGKz2mq5a-qXLbJjLAxVgUJbJhfQGq29aactf5w&oe=6A79B176"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KZCkFjGReYQ7kNvwH3hYNd&_nc_oc=Adp9W7AwLjYVmQJIKpLSzP0QIizwZuNIDMXbVtd8D8Uwz2AsvMJay0bOXtSqf61WEcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz3YetTrt4PleCpid_VPiBcHmeP0bIDDV2c93Gx6YZJg&oe=6A79E6E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YMau9_Rwt4Q7kNvwHEuw59&_nc_oc=AdrTKGZSR_Hky1apZ4MDgrHBaryyjlINkdc2lzOlOHSHolxZ-FX561ju7G3G-FWx3HQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSEM6zcHyNmhsBlzygv_AVVGEtYBMN7EJHdrqr2wpozw&oe=6A79C746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR1sAd2sEsIQ7kNvwH85Ksc&_nc_oc=AdrzeYQJatZOntKEPZni9Jvu9eYqdcE-rfUx4EpxeRfRtE6YWPxQOZlp8IvebUiAHz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaX9lb8kpVnX9xUnZAEd9BOOKokz2oqlF46JBTb_z8yQ&oe=6A79C9F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
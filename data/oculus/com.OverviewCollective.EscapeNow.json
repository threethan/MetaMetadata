&_nc_oc=AdqE3y7Xy1A5kSC3_gBheXR6EZCI0uSUKAyf3gRJE7L3SBpk1TuKOvX2ME9ZzYsntOc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhy-k-gupni4rHKM_M_tdcAxUhziXwTUwc1ufyX2puvA&oe=6A734653"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aN-VWqlcMoQ7kNvwEhQ1qa&_nc_oc=AdqrmlvsX1DIVZE6O2UIibltmuHe4K1TnLfBRJ16wOXpXzvAqX3Y__S-PrlZeM4MaXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGblaanE-wAgXQGL-wo5UXYpG1up9K5itEfBT3ikMQdCA&oe=6A735236"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSIDMuLEOr8Q7kNvwFKXBvp&_nc_oc=AdqiSTAtIihDGR_P03rS-E4aIJOipoMpeNi-E708jX8uUWd93wjdICorpRV5M57vcC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPkGOScvLzAJHZKQ-QISR6TMGd6mAWhZFIiHJFNF5f8w&oe=6A734F65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yobzr9CuAvsQ7kNvwHTxRjF&_nc_oc=AdoI2P5CJXw7jgt3gHgcBLCSLFjuzo8w05uuZNFEbFTCvFxMxsd7w5nG4iAfedH3v9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEp_itJDu9xcHDnKksFZOSGWM4fEx4nK3Z2t75nSxCWMg&oe=6A732FC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYak6E5gEs4Q7kNvwHiLam1&_nc_oc=Adr25uVOCF8FnG8rqvrjU-Nmu5dgG8DTuxsX7vS0HmMt6YtHmfOEWrIymFqagaQSIHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG13PrUDu-3lo-kjTrRRF8Zk5O4iVISW7T-iNy4A761tg&oe=6A733271"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
Kmkjj1JfJGNW-56MWbo2ooecUCTg7kt4C-KtF5vHBak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftzyb-bUCNfWaDkev8ydSHEb0D1DrEG2qJ8FJAQgL67rA&oe=69A80713"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irkaiJjczlEQ7kNvwERyz7I&_nc_oc=AdnVoWQQxNuxepNl5jJAqQZDG-sYogdmx8XrXokOMy90UmMmp-Qh-Xolrps1ONxYNTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvHQOzoF5NzYJKmeEE6kpwuuSnuUO5hzBOSQkAY5e84og&oe=69A812F6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TuUTOO14d8Q7kNvwG6_vGT&_nc_oc=AdlGv3OKQCJWU7jjLhKCLZKIdA-R9M9krWOSJ8S5tdi8BgQFKqGHQ3VT0cPetCis8RM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvlgqBM7ICKAVJUpuwwVX-dGJnFv5nj1TfKWgzfwSqCYA&oe=69A81025"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK_ZbzFD71IQ7kNvwFBMHNt&_nc_oc=AdklpZEzHOS2vyZbmvUhas3SupaQYQCcTWlOd4Bsg2rfqnPsTKagB5_2Kyx6jpqufjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvnhRa05xxvGmu7zLSgajGOFEC6VWjfqXF-WKwC2m12Eg&oe=69A828C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yxmlbvCwEoQ7kNvwEqGIcV&_nc_oc=Adl5m5mmi4zACjQ0Fs_1jF68pOg-FE1HwvRxPxGXkBuP_EKsk5J6fM5lK2nNQ7XXhBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvMJRB7-xW-RNSwYJawehkn8YZEzm4xyDrUeH-z3NhGNw&oe=69A82B71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654
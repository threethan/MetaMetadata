g", "id": "1178427992807612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75500282_1178427996140945_6096798805373268706_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4f0A5-r68YQ7kNvwE4v3iu&_nc_oc=AdrAb_Rl4YnV3Ht-2YjPEjeR_4hI2tv_QrpBVMYRg7esxYS8uGYwGGVJFxZpsoJCm00&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0-BTHQLl68bsV1Fh4PNalLwhR1lHRlsiG9lfdC9ofvQ&oe=6B083FD3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSKkwF6uGoUQ7kNvwFVrYVf&_nc_oc=AdpHwTUm1JEmvTFLUCj_vb5D3931lY7CkeyNDYKFTQBfw1NUvp4cJwByq079jixb8zY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2fyyolQG7uenG8xMty9fCDjcv70pTv8LVQ6Ar_KtL1g&oe=6B084BB6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG0IaG69yhoQ7kNvwFKFZWG&_nc_oc=Adq_M7SXMtalW_GSeol0p7yKN4AQfbqlrNhfXrXZHMv_3LB0zsZVn5dJ-7G1PzFo1eU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtvlz8OPjoe9nMsKagN8ECqNmgmMO52WHEmoOOPN4gdg&oe=6B0848E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSmPT7ziSdAQ7kNvwHsZkyx&_nc_oc=AdpUpJ9jPoTkq5v-dOS2yNShaVYbfHYneDBEmdltxs0lzp0DZEnRnDnIVtdoThSwpxY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbEdo9tt89wi4Fyb2Kpx7hJKxQAv0IHbFt-KKDIKe_XA&oe=6B086186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2kidXYgk6gQ7kNvwGtbThX&_nc_oc=AdpJoaGxephXI2oET0aUbeyITfSLzwXN1uTXwscrqwpA-hMpVq4iK3uIiPBF7H1BnTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTOUhhB15Pea002gdgveNf8g0dmfsh752t4dEpU4NxjA&oe=6B086431"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
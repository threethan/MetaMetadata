&_nc_oc=AdqMQTJxKlEEcGnJDjJ_B9V5mn-C7775gmQvqVxkQwy3Qa3rdLICM5nvn0ZQlpCcozg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JpVFccaOD6EK10TxhaSAtAA9tN1OAhM3QVVhjPq_Y3w&oe=69D3C0D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dimLWBKTFUQ7kNvwGX4-J2&_nc_oc=AdqvxRc1MV9Ly_aDbpi4pZHCDAaah7M-_DvTOCWO_K_g48GrPjJ04wDsSjGj-eH4qJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AWNMjkMjvLzPzPat9GeJYb2mvgR47aaLHtcBQBrp75w&oe=69D39476"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc7ZmX4oW3UQ7kNvwEhcLAW&_nc_oc=AdrPks02rDctXcuRQwQu_AeE82vE-7l7idP0_Zrigja9q2LRCQfn1C96EIuupmxcFIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KScHBnnCL6IrPQpl3ucbusmvnF9TiopcY7SLrGTl_nA&oe=69D391A5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-bj5ZAQqpUQ7kNvwHRf2i3&_nc_oc=Adq2QzOn_BJl7Csu07RW_gI37-0idRUR8G-Ao3KojKUszcAyC-oNHGN8Z9qvKOPw2Qw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25J0jladudyUgd1dooI8Df_56UZFE0_srONVORNCZO8w&oe=69D3AA46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHJKwRwHDjMQ7kNvwFf3FTh&_nc_oc=AdohJM6IXHNDU-12obQhwxTUivkhDmWMITVd794tGEzG-37HWvRPyntLhn7JT-QEk-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pjeL3bqpQ5hf--5_CJXXANLbKVwJk_1nl-whKwztomw&oe=69D3ACF1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
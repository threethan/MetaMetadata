3-1.oculuscdn.com&oh=00_AfvscyCUIdPfzSICLht1nhzd1i7vRL7sdcaxLKM8AaVzZw&oe=699DB353"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI0tF3iMxoMQ7kNvwHT06Z5&_nc_oc=AdnlqOb0wovt5hhIiGflhxQJuJNc7w8_Li7wIWVoObZfk3iaj9ld88XNH2KMsk09WtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCuuZAv4KUUnjdhYP14fuEJRC-dy491v6NC0Zv9Zo4VA&oe=699D86F6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKOt4fJiPL8Q7kNvwG_lr7d&_nc_oc=AdkdyH5IALXQBWd0opwfRnVO2n0pQh3xtEjQBV1k_0uddcO1lGLO-6Umcrxz0D0oK3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGWWYLfA3TZhdEexj9ehGStqeOENaokx9pFeGv9g7UDg&oe=699D8425"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWeYN3WIg7EQ7kNvwEld9jm&_nc_oc=Adlo7TQZm26yCt8rA9ZITbStDyD4umOVOSKg6w_VHlZl71LgYpHJ-53XrmDclFH7tNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsI4uvOjijYAFifwNNhnKAgmvqvvhkt0eLPhN3M_MFoRQ&oe=699D9CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hT6oehk7GQQ7kNvwGArYpA&_nc_oc=Adm__Q6-eNK1-FtdihhdkWrcyh4hX-vw0_oNhFWISdSahjeCmgpMlwBrTls2Y80avGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvyYYFXu5A_RyIFEhfkODhZWUafSNkzbk_JCr4znq2lrA&oe=699D9F71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654071"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/3
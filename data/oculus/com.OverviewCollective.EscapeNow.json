&_nc_oc=AdrlvldZJolDrTtTnlvJsxzhrG7S9fc39amQU0OVl2AYMjgOWOoL4p9KW4_COWrHfug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLXSNOLEgI-GLN0CmtuMW55W_Y8JlfWkUnoh-DR3wUuw&oe=6AEB3ED3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDpiwsd4Ei0Q7kNvwFk7LVO&_nc_oc=AdpA7c496bOEGpEzwusadA7M4hK7y0FKGFAVZPfrAjihbh5Tm4RCO_yvyf2oiWS5Y04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeovmJktlVw1T6KgFSmGuc1LV85rFEjtCSu35yxBsiDg&oe=6AEB4AB6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opu5CTiUtEYQ7kNvwGagEgf&_nc_oc=AdoLJMvCbbX169e4jgVdlHn0Qt1wE7kbiR7SuiMbd1vC-1qqlZuEW7yDJGLAZzg_OJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5XFpQz4zIVAg7Tow8yMKOSlhcFxMDJnmLCkNqboK-ag&oe=6AEB47E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRXSlTUEss4Q7kNvwHghnKr&_nc_oc=AdpTWC-kyMblIAPagh9LIyCrLBzKsOpYTOh7Rn87hiI0asaw8lIFptr7wcH1sdl_lFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT23iTHJandKv9QQw4f218bfzAirTNuxPiT45ZtfzI7zg&oe=6AEB6086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTwQdD1zmGkQ7kNvwE2dUV0&_nc_oc=Adp5jvOQ62K2KyTMYFS9aXM6V7zkrc5RqfI9EKlIPiGmt_75jsTx-CMLVLbLh7p2PbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpy8dLtW711u6o4z6rAit9JrzQohTQQ17D-bL9-15G3g&oe=6AEB6331"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
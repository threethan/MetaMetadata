&_nc_oc=AdphJSNR00kQqFLKQwMshA_pX1hYb3Ppq7xvyKPT4-6icttt9S1h94xZg_Q9khscEoo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhrKYpA5I8zM80PxmBZk5srx83-8wn8Fe5APt0vRzdPg&oe=6A940393"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELh3gvVG65wQ7kNvwHn5-yf&_nc_oc=AdoRFsxm76ZYPF46T82Caxb_WXVqtb8j9YjILjd3KkL687xF1jBYJyh_K-AO4X1mbzc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaKJkvxwRA45mqkppv0iOOZCC4DwoDX-Haig8RBPdU3w&oe=6A940F76"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmBSrdeq5GgQ7kNvwEDgrks&_nc_oc=AdqCJxQeZCdmEsm6VfA-L6aW9BdSsxKb2v_nu4fYCTcqScotjnXHRG5OIlSyoDCUX_Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtpu2Ghs74GE2-gB62owYj-BBDa45IQU_Wis97qqF2Og&oe=6A940CA5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muffeyZPnZYQ7kNvwEu_kw_&_nc_oc=AdomNLpN7zT8lH_6LJLFcWTOBhimpx8Xi3HpK6WsaW0Hs-eIbIFJYoEJy7LoGgPzewg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNMwYhQsJKe-UN4eqA-mhKFaPRqKDQX7wwRq-SujT_Xw&oe=6A942546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN6yg4NSBT0Q7kNvwGTfptu&_nc_oc=Adq_Qh4tmwA-XStgZ-j3G5WHqUC_0pLM8GNoi211K7NbMYoxpxyTq_e6ri9SC6yubWw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7LFvvYpsYAesY4hAZnaGttg_Ph815rkavYxlO0ruPrw&oe=6A9427F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
UdpGscYDbRojyJ9YpBW2lYa8wdn00QbgJYMGe6nHZ5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfykFpgWbZZJ1_WeSOIRdfpvM_5UyzDv7TSKMPdXLwQMVA&oe=69B41CD3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VNAkIaX9gUQ7kNvwEVcm3y&_nc_oc=AdmVqHFKlfIEAE3xmqBvjIFuVgsaUItnm-qyhfMz6RG60df7qhoR6ou3pdoraiVd9RI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxx-CWLzRpX_hldmrGhV_cxGmrxCT4OoK8h8Nxdbhdtuw&oe=69B3F076"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baoqv-N0914Q7kNvwFoQjFe&_nc_oc=AdnYPNWiSXmIdkNYeNcFzJb-HBZC_LRtLmIWdGZNk4bpRHV4LT_X4fFF4P8Zl2D5CZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqtxIVkaJbewvFX_daciBVuUnVPK0RtXDSKfOVWhGlCw&oe=69B3EDA5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2lj1lQaplwQ7kNvwHha6wA&_nc_oc=AdlBANaK1FJ1JBUqHuf_pp9BojdaAeBIqQ_SB-NUOCuj_DEgoc6bm7qF9pgZol342ko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzxfvn3FO9PdiyRMGYLuIvnm98rgtgz80RZXoDD8-gibQ&oe=69B40646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO4Zk2qPKnYQ7kNvwEuaZxp&_nc_oc=Adkzc0ydgvG_1-auPqlR1EHPyfTyClP8JtniuQLdXHNK9nUqV6rhYoouCMHcgPRCUlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKuFvkilCNOQnB6pPt113YMcwIrChdOaRa2mBPpyWIjQ&oe=69B408F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654
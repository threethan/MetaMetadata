3-1.oculuscdn.com&oh=00_AfvGvwWST-NOb1ZnzI8DhMh4VvxTUtNaHI7VMVYWRKsxYQ&oe=69A05653"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI0tF3iMxoMQ7kNvwG6gu-P&_nc_oc=Admiz-ZiQMYdIm7tDQXcXKBDH2zuDuaRVMVR7PV1K19OLNRsWpia8Rfb1xWAZiOs_pQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuOPc1HlZXBFsvvsSYcJDaVsxze0_7c64pT0momyJem8g&oe=69A029F6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKOt4fJiPL8Q7kNvwEAAvdI&_nc_oc=Adm9_OHkBTZUBCBZ0cJ2QkldOvbZb4jnHWdPnvbOJshozmyJeL1og4pbh1-mllMza4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzdnpTzL0XDW4YD8ZddHZLQh4iDtDdp5egITzp4wS0Ig&oe=69A02725"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWeYN3WIg7EQ7kNvwGFjN40&_nc_oc=Adn97GgiFJosYWcJ5ZJ4eXW5p6Sc3kLRp8y_5myX2vNVATwNA8WvKIr0IY3WcKTA3W4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0IK-LWngYsSGPTEyOuiXU02AJM3j1e8ArYPhRsJOa1A&oe=69A03FC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRI5cXmJNkwQ7kNvwEL36ug&_nc_oc=AdlYzF0EebjdzJDx1BAcwD_rIJTTlfAOg2nE-uj-MK4jKeQSjfLwuzJ07_P-xc-CwSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvWhKBmWEhxoi5WTOn2c4OsqFl71cC1W31-Vo8rP_xOPQ&oe=69A04271"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654071"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/3
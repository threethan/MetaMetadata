&_nc_oc=AdqYx54JI_YYTl8olGdnoDjzx6Ya66DytpFFdIE8YZDaRoQ5V2Pfchh7PJqRut3Ef2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaDUHvlZG8Ocn-LuHd0SO0HHcx8MYLZPVz4VmOA4PV5A&oe=6AEF3353"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2qjWWXrX8oQ7kNvwHKMnwD&_nc_oc=AdquC247-ueMy7Pp01OobL5TKsqLi6zSqLKAN_9itlcI8ujDjNl6tACtrsrj1wVbcMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ__9DzoOB4YeivPU4yqKFoQM4Yv6PmBCz6T4gLGhdN1A&oe=6AEF3F36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcilnKsW03QQ7kNvwFus-dN&_nc_oc=AdrZCMAQBfF9Nn0gdxfyrcnLSmn-WPZmD14WHZpGV9yDUMwUQxQHdJLlhepG8gwFlkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO07i35zQGZU3PbSmJI6zVfbrby5JrNxeIS9MqJdwPEg&oe=6AEF3C65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48qKm1_sApEQ7kNvwG3oyM4&_nc_oc=AdpZT9C_AYEwL4osNtq_hevrgYrKfEbgjlMAIbJxf8QMF_wCdDOMxo2fATtiVJJYz7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIOcW5AYhAPbtztX67wD1HC7Dhj-_zezAFduEQZbVf1g&oe=6AEF5506"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSeUvZd-8gAQ7kNvwGgtMSZ&_nc_oc=Adpmg5ynYK8canyqJ--r_yomFpx_Y-QQEyv9DwWI93W-dnsfGTCbZqXmQU8lcBuC0DQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRFTOxoL0POTpqSZUy4UC1UXHIi7A_8gIe-qzN1-6mSg&oe=6AEF57B1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
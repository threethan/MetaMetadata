&_nc_oc=Adr8qmF84eDxwKOVkMY6k2Iu-EChSYJEmMC4fcGcmKbz4O9F31-HsXrSbaEfKfLnv08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqANA-F7ygLFS74nSUt-JzOze2Nhi9wIl6X173qQsiLA&oe=6ADF6153"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg33FMvtHRQQ7kNvwHmpZSO&_nc_oc=AdoBEWm_hWhljb0zL0kXR38kY9iaa6jY31CeMywOF67dahZdbwqoGtkawFTVFGUFwlQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8VJ_OB4VTTfZmP1TPpy5rm2fD9aMmTrghy67w6Y1q-A&oe=6ADF6D36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfU3vM1hz5kQ7kNvwEQn04O&_nc_oc=AdqYElmhwEjEgg6XI9XvFyjNr3jubJ6k4E5Wd0Amy-es7hRfhcQLaHSTgtybfFiKNIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_5UnKAyHxV8tHqTYFfZplSWlIrEvx8iafgDrR2NvBRw&oe=6ADF6A65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNPw-4xIDB4Q7kNvwEFjKgH&_nc_oc=AdrRFbDLyUMvz64-vpdmSWyT_jq-rZW0mIZxvaezmzob7XMojyjdCOPgnfzNUT20ZRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6cLERJmWnT1HztbNYVM8__Yg-stX_RSrdqueuwxx4TQ&oe=6ADF4AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ2shDkEcAQQ7kNvwFwepFr&_nc_oc=AdpIcZMJACBeuFsGUiY5FQH8rA0Ow-6_QAC46LmVSAh0DEFdZyMUVn-YzPGyry6gefI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVce4CnFXuPzYn3rZ11s7VxmBaR265Hc6Vi2TUKWz2ng&oe=6ADF4D71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
xOl8bMOZY2CB_dcn10_h2MZmD4Dbubvp-92yfQmThBg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo2pj8gh-tyNnFI8cmxU9tqLoYpf_WYx8dN95Y9nr86Q&oe=69BD5753"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ic2Mk8aLX4Q7kNvwHrmn_n&_nc_oc=Adm1GHs0vG-dKPFw5nrf2qUKS-BOITxzzOKanhs2UP8_YsFDDrsyIVMv8GiZpIEVq14&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDONOPDMndAAiiSS6aaSXcfWMQxu0YkvW75BphALq7fQ&oe=69BD2AF6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulRC_e4LFwMQ7kNvwGqljHS&_nc_oc=AdlA6g2QLW7EZqWCbGcdWza-NttoNs_mrh0-BOh4kbpnmjESXTKx-LsQUPb_6HCY7NU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxjjpeno581hI_1_naRM0ydp3bO-5cPdu_KTP84R4X7Mg&oe=69BD6065"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySrp_LxEGJ0Q7kNvwHI9ud9&_nc_oc=AdmCkIRtzdVhErVZzb7aeXygZgq25223FSlNWEepg0N4RfcEaBwmXJLPZ3scKuafzXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTZsjGACp_g5PQFo9Q5EFLgOsTVexI9bIBT9dFJjeL_A&oe=69BD40C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-NQHQ_3xoAQ7kNvwEIrnSA&_nc_oc=AdmODuNoS5mjmwih_e3fdIML6jXlotzTDLRt-4bWernm1hpzWnudHFqJB_2F5gACb9Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAdkAaJDets1MfK_qEI7I2TH96lZUq88UNA2Vhu0iExg&oe=69BD4371"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654
ET3h5N&_nc_oc=Adrn_ngZh2sF5F0WmhBn6QBMxvETSUbHAE5YBb4tssGUHyjuzAYwX7w-7CiZqIuEI8k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_U_Hpa9ehBmYeFDHetll1fQDkzOPTyxa0_SVHT0bFqQ&oe=6AAE99D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GghMU6EM_PsQ7kNvwEW2cGP&_nc_oc=AdqGTdiVFIjbdEqSly8i2L8egAKRZyKRi2vL_ZSNrWV0u0TupOTaqFtcJF62-M3fXRA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLk5-myw5KO7mQgfzQ4MRQekOb_mrD-ZUIWCxa603pwA&oe=6AAEA5B6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY-mZEBgnVUQ7kNvwHsHPXP&_nc_oc=Adp651cqGppjtZHCQyc7tctDl8399rwAIYmgI3rzsZEOZAyZKd5MI9yggim2Kw0CtOw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKmZqtc_n6nUwfbt-1QtGAM13lHEcig2IyEiEmFUkBKQ&oe=6AAEA2E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qieLJ8a2Tn4Q7kNvwGYQuFe&_nc_oc=Adrrq_xxyTWXzz92x6eZMFq_JvgwBYhPIlNOtGROS_b86aCi_pW1j6N4OOUcAfSPBS8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLabSCo4_59MwR5Jv8EJG6d8oduvS4LvseVQ-rD-l_smQ&oe=6AAE8346"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXQLMSxtDp4Q7kNvwFdAJLe&_nc_oc=AdqY47rKTAjNaqbYEluN_qXzk1pvpaLJqsjKScFnOgUfnEgzoez1Bu4YSbfRnEhrv28&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvhFB79K4tK2UE2EqrcY_AaSFFS6BR7Vmqf3VMbYVa-g&oe=6AAE85F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "use
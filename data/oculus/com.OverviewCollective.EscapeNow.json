&_nc_oc=AdqEemnZoG-drf66rQL1ZXBsjE3e7OyFemBjPVWUP7KUwiscSQodZ4QkOkv00VDqPRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xp5NhiIqwgDuhsL_jhtoAZUTW9gZ_9AizI5vqzQH71Q&oe=6A3A95D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqFYBDe2LSUQ7kNvwGNa2Km&_nc_oc=AdqG6QRpGMOD4obtXPBEG4FxukcZ1fkr07_NrMP0rVHu8CSnEnrOpOv-zORU9DYBsmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qf78QlNQ8-bh-l5hc61prEkMYlj3AckOB41X5uOVlWA&oe=6A3AA1B6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Clu5NiFY2-4Q7kNvwGlGrpb&_nc_oc=AdpQqs8JucysgtuHeUSD3lQa5gn4Vk9f6QIdfF4Qzh_nwziosy23hA8trX850hXj9Ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OMoSwfHnfoRivQmSB9qGt1dhL2KhSO1f4TWENZ61_PQ&oe=6A3A9EE5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qvdh5qArTt4Q7kNvwFHS_Pq&_nc_oc=AdpMDrmVdI3-IOoe0czjyEVa6-KnF4k1_cAP6b-hKzQPtCZEeacQmzoWb6FM_G99UoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W3cuDzb-IHUN-yOYh8gf_KAmwSDsv0NHWWUb_Ap-8iA&oe=6A3AB786"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCWCKRtsK1wQ7kNvwFxbh5_&_nc_oc=Adq0-RU_6cXZyd4CnftZPRrrLNSf-pM5JJv7GOA9ox-ZFWBQ1_GCV3HM7-WPLKv6t3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vYdeMhdSOPQgoi3fzm8oanVuURbP7aO1Dpwv5RQFU_g&oe=6A3ABA31"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
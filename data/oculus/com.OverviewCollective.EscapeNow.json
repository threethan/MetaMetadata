3-1.oculuscdn.com&oh=00_AfuTjpvO7fu6R0rnUYUEMKQcmHnXvxf-TUvvZu3VwTtgbQ&oe=69A2F953"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCc1NJ5aczAQ7kNvwH6k-tM&_nc_oc=AdksM3LVAqKtE_VSlWAMZDwEtgECIQV1xl3_48ynC3dmC5N3PRJTrVFhOnS6x8Jbfg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsB0Nae4bhPs7hSwbevp5_5Zozf-tQDtxmbjPixTWaVKw&oe=69A2CCF6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfRkQFzSoQgQ7kNvwEthwmO&_nc_oc=AdnnPWkulJglMCwjdI7KAtW0zkBG9V_dOuRPo_FZt5PYIle6K2Apq_rn5rII-dD-Tkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvOj03rUlnVi3QHGeOxxvvoKgHauz6jzCtXeSXaNppwsA&oe=69A2CA25"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdUYyqL4m58Q7kNvwG16zu2&_nc_oc=AdmmUlkZ1Qj8VR144sKo_WgF3OjidwXVAJEb8AQJx8rtKVNtUelqFWCwnFLs7qGkmjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftL-nHP9B8Fh-_V2z-ht9Da4wSZBoRTYaDs9zXJGH39pg&oe=69A2E2C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRI5cXmJNkwQ7kNvwHf_4pC&_nc_oc=AdnkoD842lDPqFrf22ZrOQ-g5zoB-0a5MxTWYksf8lJMbikvwFm9kyYlVrSGspBEMIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsNkE8Vhuo6oUYToAURBmitVGuH3Ksj5PiRBArbIOaFIQ&oe=69A2E571"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654071"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/3
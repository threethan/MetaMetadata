&_nc_oc=Adr_HndySR4XLfI8k15qWiS-7-p0pJyZFX9ZXR4mfDPm0ouvTe5raavc0y8boPOGJBg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNgB2K4ZanNnaH8EzczeT58Wu37QD_DiAVXwYOOA--Kw&oe=6AE0B2D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg33FMvtHRQQ7kNvwH55TzB&_nc_oc=AdrplobsJ8D8AniS4ssAXKu-y8UQtGdNM4vfor_5HlBozXIXZsXcX0P60N3_aXd9UJ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Ull60qkGMfOSi1YPQ7CysGHv7zPBttqAMUNW000syA&oe=6AE0BEB6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfU3vM1hz5kQ7kNvwFWwKji&_nc_oc=AdonrkryGOpC7s3-5s8c9HAeIZLgrGciL1RTdFyHoa4Etlzsinp2G89iMbQ8R7aaKyE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGm6nw5WuPPaE6W_q507lxxG_xGS1LoBGaWYwlnXe8lA&oe=6AE0BBE5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNDG37ta9pQQ7kNvwHkVIuK&_nc_oc=Adr9uyBzTStGeWtWGTa37_uPpRgcopDxAdptuEUwoIivyVOkUH-fBe0COdQAU6S_1ec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxWm0-krhdOvlpQ4FVevTze0uBrtRK7YK4XD6Ze4jVNg&oe=6AE09C46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8HJX6ITNz4Q7kNvwFSbiyb&_nc_oc=AdqVtyaka2iIjfu6D99oqYw5WnWBaYhbZOzReMxdaYLt6s6QBvVbqYmABUMkOECJsRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ8MPoeRb7agzqcE777rjmgjSTQI4NUs2mZJqCAbGJIA&oe=6AE09EF1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
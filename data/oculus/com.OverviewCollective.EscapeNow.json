&_nc_oc=AdroX_UPDRuKfbCLQZToqbCBeQrf-6YbEHLW1EJPw7xOX_0hlkh6afko595BmnlfMCs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F9hcXOzqNvH9ncGRIJAhMjUfiuNBVN4P3tL7yk7Oq2Q&oe=69FDF0D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK_fCneOW0YQ7kNvwHj3pJh&_nc_oc=Adp04hcXp2_rsFA6HlZaCTuEqvpKXEiTm02IIzQmyCovXUffizd86BGj4-vcdnOgHCM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xipDNjC41kDm40kW3cvZyKQeKOXHgQeDYsa5FKlHuKA&oe=69FDFCB6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnY2vmDbKC0Q7kNvwFs7Cuz&_nc_oc=Adr8XM6uvVvjqJ_m-VygrW2rvrhZns8kbO32xLS2YjVO-HscgtiVbP42LEARK5YbsTU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5feIUQvAyQCMPFyupoJ4w5XXXnPJyw6SPnZouJr8bXiw&oe=69FDF9E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPWYqMp8vQoQ7kNvwEyOMDc&_nc_oc=Adqbwqv65DsKl44dwhPYu49h0Acf8vMDGO83EX6shXnqJ_dunsahmwHu7celkUPPEP0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iDRYH5ymlSPF6kV_ELeKFXTW0OtLUqm5mshZGJi7XSg&oe=69FDDA46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fUmECCI1OsQ7kNvwG2yLb1&_nc_oc=AdoguxkW-LdY2iMa868P-MfXP0NGGGPcmbMCEeAaeOmLp_Cl7MlqEtwG3Zgke9vbeVo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jEHaEIh9d9UsvLZZEXpGWsdf4z6QxqrmDyaNJ8eoNbQ&oe=69FDDCF1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
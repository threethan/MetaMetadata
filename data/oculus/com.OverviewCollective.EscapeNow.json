&_nc_oc=Ado6Fc3QDa4zGKe5lezoPd6SeajQWdKeZWAajtR9C8i3om29fJfbRlBjcXd7bCi3ID8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj-qrDgx-FlrTIf1keg8o_XeQWNwANsolS5zyM0SDFcA&oe=6A4D0AD3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDgGkPeU3wwQ7kNvwFvLs2e&_nc_oc=Adpu8Df_MzARYz9YUARlwvVvD0bXV18sP4AKlazCT5iunU4DpmlUKWPze-y5M_7ylfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMVNw2Fp-mRjnifZhQlWZjCFFVMwjOK5glGGrfZ_FbJg&oe=6A4D16B6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrAZ5REh7HwQ7kNvwHMfCAy&_nc_oc=AdqMCAS3etVfVc22eo3-Q4R6wrcdefpj7o6RRD7m7zXvk1oyu99npedZw0Wr5c3JpiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtvxl9-vdIB-VchxAYYdWTCh2ofxHk43sqM2LjOpci_Q&oe=6A4D13E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIW-FHs5GksQ7kNvwEKwv5j&_nc_oc=AdrcgRiuRhI44qvqAUMLouAd2Y7W4_mOLeFujgbkpK5MuOMqP-ArlB2Ps3SJKlJkbv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmnGdVTwuk9asbO8ts73nQt48h7B_FJsjqeQWaquEO3w&oe=6A4CF446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbjGrQ4BLcgQ7kNvwGBCybZ&_nc_oc=AdqzRHVZGGx8K_H2-qn9bmaOqOBg5E3XgzjTJudQ3EVj8JgPriiAFR5NS24TYR8llso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPVHbwzOSjc7EvETG3ZjN-XcLiWCJO7ui2FdGYMspKzw&oe=6A4CF6F1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
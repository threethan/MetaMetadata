&_nc_oc=AdoFsb6G2jcDL-tBR10fMSTn1RPTnGlJws3yOD8GOISel0lANbnGuvawnEWhEaUt0j0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtwA7C43q2P4Zd5tDGrN435GosQmO07_ag2rRJ6BXJKg&oe=6ACE3DD3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZiPbvz0xr8Q7kNvwFbBfGy&_nc_oc=AdqNNQC6l1SI9q3_wmR0riVYeUU6_MQ8z_jL15JQ5osJRW0IiBAKr8LWG58YflrY7n8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKtkFfV3DkrNIqNfX0rdjkzMA50RK7fB-nVzAubZ-w6w&oe=6ACE49B6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7vVN-XDAfAQ7kNvwFJLral&_nc_oc=AdrZyOhLT7Syep_mm422SVup2t_xtLSxnWTSMGG2H8ttJMuuxrw1GTR4yWn9dMgz6Vw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYzhZg4gVvHUSjAIUEFE78BAbc7j4soWNUkp8lWsT3aA&oe=6ACE46E5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CyGQnw7NiQQ7kNvwGPbg5U&_nc_oc=AdrLETdzD7eVmmOtXslIccJQKRudT2sxXrMmC3NAQC6nNHQBfcfDTaky346URxB7QQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSkrw9EjcYjILwuBTvhZecGcIBhsFlJrAbwzYq1j19GA&oe=6ACE5F86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm5w_np_7XYQ7kNvwGi799l&_nc_oc=AdohHdrukqMii6coYR0l5eGOsBiRvJwI8-UAdsqFVSPzRhkxBAXE9QU53JcQE56PR-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjjuk_sK7Egafu_TbOG2717s4XlWPAN0BIQjc6nEkGFg&oe=6ACE6231"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
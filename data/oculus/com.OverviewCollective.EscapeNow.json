&_nc_oc=Ado4rXajhgvj0mEcnQsfQsTy1m7eqoVpzIkO_3n6HNyVhk2n3Ndu77iDKoBiToSAuEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7_AvTDonvCFfdf3dV6CRjVb1qumz6w2ei2r0m-NInxA&oe=6AF71C53"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuvIIQWvWNgQ7kNvwF43PNH&_nc_oc=AdqmmGySi3yTo30oXQBsy_Y09Qp9ZfSs3VoDsyzXpPIYnEncNSusUqIQBdxkW7WPCfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUQKoByNFPgvFS6LwPC3OWsxPZIQuPqP27BV654p8j2w&oe=6AF72836"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZEe6uBU6ikQ7kNvwFZmGn6&_nc_oc=Adq50EAWzTOO-MQu0iOkVwnz4vz7flkRij8OAjAUnejIiB-HyVb0hrt9t79bRhLeHYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1yDaCiy223ZWompVZhTUsRY6KYumJZQP4-LpEvqtvvA&oe=6AF72565"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8_KURhpKJwQ7kNvwFUbJII&_nc_oc=AdodeaD8ezL5wtV5vj407wpRq4o3mTBEp0L96FkQKjiQiMwhL8Iqit6NcoqGg7upiWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY80Qghi7lQfS8kTampe4lyGsI2KQ3e46U-Gk2kaB-gQ&oe=6AF73E06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7PubxzsnjoQ7kNvwE7x-kM&_nc_oc=Ado1tjoQO18YqbH-L0hsJ0ffckAZHdDC4mZGHqV4rwuWbyJdsl-peOv4Qs3dPut3trk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJUd9p6xWLxK6cWSe-2MF1nDTqaU_uIjd2JS7r6Qg_iA&oe=6AF740B1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
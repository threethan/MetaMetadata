&_nc_oc=AdozFryMkVA-EMz8rCbvisnPheP6sQsSZKcYZdVUkmKtNxpwc9tBQw4BXq6p_NuIwic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN3k-c8gGtxhBy2YkFv7CxDhex5_zJoctHdbiSnR8g4Q&oe=6AAFEB53"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GghMU6EM_PsQ7kNvwHexWSo&_nc_oc=Ado1QvDv6X0XtK-pD8cpZJRDTGKcS6CDWROGenS58krilqsUeeSZj2SGR1V5Gb6bGpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt3HzSSj0GylyjeikK_ie9BicMVs07Ycd-jIFa9irUkQ&oe=6AAFF736"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY-mZEBgnVUQ7kNvwGO0RUd&_nc_oc=AdpqbX7e0IihucEdL8qEivRQxrpg_GwsEINRYcL69CDP77ExkIgjNEctxq69y4DAmt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-ouGinFxMwlYbvc41BNMEWOPrrsZrJQDs5aT51uTlCA&oe=6AAFF465"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qieLJ8a2Tn4Q7kNvwGsqiGE&_nc_oc=AdoGCQ9h8TV62mr95rxqxZUtQtuFQoyLBN20bxd_dXVzjvCOxIIdYiAFmmmL7Rzgi9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMcmYVDWTx7_nS0lxIWVTNiRH_c3MCHpIOGJD0Ptt5ow&oe=6AAFD4C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXQLMSxtDp4Q7kNvwFnhdka&_nc_oc=AdoXg7g9JT55clMOLa9dVDEOTk4u2ezKrmxyvnwRkMS4DQX63IUAoOui5TKidnGP7rs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPiCmU8cP1YPvoPAmXxVxDVSpUvLSKRcIi7MJLTfxe9g&oe=6AAFD771"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
y8bF5TtLuPew7STRxNFxukO8EJFIyJctabUFOFk8voE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8EcGag-qCBVNTlAxrOpoT7aZHpS3TiZDzTogWCRxQUA&oe=69BAB453"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxJ17Fm1t_AQ7kNvwE4ONmP&_nc_oc=Adlp422Jc2d7L2s8n6ukQjHiB6aXd4fRCat4ezJ-GBkqWZW1dr1cbNe1VDgxZpmlHO0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9kuKfsTNTnftBHAKktOPmnIbRFNVurMAyjW3n3c_5rg&oe=69BA87F6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmhoBJui9d0Q7kNvwFmtIOr&_nc_oc=AdntbfQwYx0U0SAeDFkP26a-C_zyyHiWfk8ess9lh8jqsBvS2xs4JTPvLO0hcj94LEA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyr4heF1WevMIsXt1kjVgMQszrWrIWlHTX5UV6eETKTgQ&oe=69BA8525"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-BOKXApZ0UQ7kNvwEthB-2&_nc_oc=Adl21x2AtnwDxMGm-EIosdXcmjFJ8ZCYTq_0acBsnxeR0hv0PrLqw43xNfxPX_EAfKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXqcs4s4ioFNnobiNuXc-jyAVWJXDkwmvHTH5j16apyA&oe=69BA9DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ7pY9irX80Q7kNvwEb2EUv&_nc_oc=Adn4Htg85lLi50Kk8xfKtidFS73oGrobDObV2RHLjSurPhROa5A-2zCogokOJped5kg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm59h_qtY-HQ5QgQ16meN5YWEXIqphUzClveXKWxeUHQ&oe=69BAA071"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873175253654
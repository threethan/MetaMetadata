&_nc_oc=AdqIXAveLCvzMPdGKTcGSqrJ4ojGvyQ-zwc-q62bI00wjB_C7kSg6KJDUiPxofIcSlk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHarx0vWO0rqW2b1DcxvuwZTmXFfZRuvl2aUszpz0ikhw&oe=6A974F53"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d72U0eLSe8Q7kNvwFHF7VF&_nc_oc=AdqBy4b9xb--b9CKeljwU0R7ue1Tq-HfdhjmwVtOmTKaVhmmCkGbya7sabJ6sHNYBIE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq24eZjpU9Qc2Dijg9ObjSyosXb1jtF-iPDEK3efOEGw&oe=6A9722F6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-8LcDu0C64Q7kNvwGefAIY&_nc_oc=AdroUmm66MIfg8UZjyfZ1t_l-OItZ9y1I2qdw7dTa7cxC8SIfqUuKFLTSWVK2-HAmWY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHgVEZIEWKYN6q_gIlL00aBAYazuVhOPhozQiHvxqKQA&oe=6A972025"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T33Bd4vIGx0Q7kNvwGm6XZb&_nc_oc=AdoX7c5NLxS0WvDV5F3GRRxouFKs67AH64ajvdHnw9OvNby6o7R47RYElteo3I-BUnc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwHWWQmVFaBOXYTWoqwybZZxV4Xtcgr-g0gOyrzNTjEA&oe=6A9738C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPPIt9QnFwEQ7kNvwE57Hsj&_nc_oc=AdrwVEo8CVUq5D4w-CiK0MuBoczXjoDndg89Lqw34gIUm6jGQX4NoYPprGgoNMuyoyI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBBYEOVX_SsNT5XumkdRAtiuauVPfmY78uaPLQYslzQg&oe=6A973B71"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
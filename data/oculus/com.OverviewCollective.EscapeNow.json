&_nc_oc=Adr8OXy1LRYX32OT5uZBdZzy0fZqveveswqQsq8EGxStiNrl2V6Koq_j3_VeFG77d3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHAAYkSWyKfdtBQFA_Bp5FfeWaSGVWko7sXHX242RiDQ&oe=6A6B5D53"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZnk_eIq5DcQ7kNvwH1rc31&_nc_oc=AdqkooZ13fzywW-qonwyxYbmrAYsP2cPgBFCCfF1x4pmYQXIFn-tfhgiHWkrXveZBC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4pK2pQ2oC7_yXrNez2AM2xmOgspx9-IZf8j10ogLyKw&oe=6A6B6936"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15F5sA1KCyoQ7kNvwFGt42G&_nc_oc=Ado7ZIE2NuwE3hPATQxCaXuUYgX7GX-llLJtNyUEkriVVqPw0CIJ--si80xyzLDBbPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbcMOCYoO6a5r2WUMDXVrA-Z0J5-fNQ4P9rAhT4v0paA&oe=6A6B6665"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knmCdwkbsC8Q7kNvwFgScoO&_nc_oc=AdrNU-WrxU-4MFZa_euDjiGWMMuveDYpvpZFj3rhYHPCo6bj01g5x7y8R7XCamFf1ns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2WJ1yyefc1Lv-01u2z4gI1_d7KD8in4Oj19hrsOflQw&oe=6A6B46C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNYjOmIFo-QQ7kNvwGUsAJ_&_nc_oc=Adptkk2Zw9h2KPMkcwfGqdMYhJ5mcXdavPEE6v4DNtU3crhFPxXW-Lzh6Nx1QZ45jNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1NN-N6hPmVH6EJWsz6uW4ihOkHLM9aZsNpsIaorXavw&oe=6A6B4971"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
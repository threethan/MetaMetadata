&_nc_oc=AdpkLdMZWk57MqWFVqLgFeoYAQyOXWSj7ku2erpdwWzaQq3fH9s0Rmy7YU6EXmBMPso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9RI4I6otN_cKPnADe8y-1QQelGoCJ_vFc5m5F5_4Wqg&oe=6AD23253"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PJHxfHcIL8Q7kNvwHPKx2C&_nc_oc=AdpJK7-kRaUGJ2_bR-BXgEhR695KMBXibQ3xjXIovgT8v9xCDathipZame7xairvMBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN782MN4agf5SzwBiwv6aS5QhsMrgrRlIEM2O_fsFftEg&oe=6AD23E36"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCcbAp5ITbMQ7kNvwGjdmaC&_nc_oc=Adqg1LxQAsFe3BZToIPCpmvR_CkfKuXJ0rw5BMNp99jNxnLHAVaYQ3UFYJuULZUH3vE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7JkSaY8m47Q6SGCGu8eXy8AgHRAWh-iJn6t1Gj-AmyQ&oe=6AD23B65"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C_obPG3aKwQ7kNvwHkFG2b&_nc_oc=AdoIPMabkx-W_upq3_z6LWvpMQaldHACVTo4CXafwr8APzx0FCTVS77_pJOKvZQWyxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaBbi4v2BwZgZInMMjSMPj38OS_mb-QkmexM7whwkd7A&oe=6AD25406"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDxV8QbXqtAQ7kNvwF2AVYw&_nc_oc=AdpQ-Mfz2sokpcZMKaWhrr_3d0IvZ2zsv8BHXaT7MLcgnRSV76197x102Q__XiNNCec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWERXrZfGPDWck8fT4GVSE17vmwaWwx04jqqON0tu-mQ&oe=6AD256B1"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
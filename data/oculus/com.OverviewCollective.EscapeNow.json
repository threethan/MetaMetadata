&_nc_oc=AdpJpmaP9CA8nsoJPe4xKw_P2hbHImTC9Li0TZtu92i9I9NBf436oz7DJaZUKyoX6jU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhSVz_r5B9uO6PSrgGc-ha7fBYMkc5NwGk23PvVw_Odg&oe=6AC3B1D3"}, {"file_name": "pyramids.png", "id": "964547268263745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_964547271597078_6980519400447533937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JikQujiAHYwQ7kNvwG-MRjV&_nc_oc=AdqREGVyfucvqxE2Wx95_nCQWxBYGpb0paWBd6vfBcB2csjoktqq6G18sn-2wiLBtVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnwnwEhs76A4lYEN5qvNN3HtbxqFA5I2g53NVZbQubCg&oe=6AC3BDB6"}, {"file_name": "Mezquita.png", "id": "698025708429099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569450_698025711762432_2414664306191451059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmPyliWWnzsQ7kNvwGkOB6K&_nc_oc=Adq_n5NXyzF7Vcx8l6jM15n5vf6Gc22KZ1oTe10Rloce3iP0cU15SLMwMB1OKr0t_0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONqn_h08Cgp8gvOqKuU-bg-ThTulEsIWUJaQQANMF_6w&oe=6AC3BAE5"}, {"file_name": "CR.png", "id": "922968715725362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_922968719058695_5698721801370973028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPcBNnwYJ0AQ7kNvwH3JP0u&_nc_oc=Adr4V5JfgJAY8PBmGL10acNGvnX5KKvk1kNpAuObkCiIEcTm5weIcpodVoCcCwPxweM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxFe7NVHsoTxBAWN5wJHxNduNISkJLurRnXreXA0P2Eg&oe=6AC3D386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560x1440.png", "id": "701917011635928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036620_701917014969261_6083990002831708271_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW8K6dB3KVgQ7kNvwE2MrYt&_nc_oc=AdrstEOzjEByTHZuk5FPdz1pjNPS9zSbBZOcafhDHH7Bi4QzWvtyraKmuKJRbCFaayI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZMZ1bVJCyni908FgzmZcNJZrZ8vRuq1Lcnt-5Nc66tw&oe=6AC3D631"}, "display_name": "Escape Now", "keywords": [], "long_description": "Are you ready to escape to some of the most beautiful and exotic places on earth? Look no further than Escape Now VR! \n\nOur 360\u00b0 virtual reality series takes you on a guided tour with award-winning VR filmmaker Tarik Mohamed to some of the most iconic locations around the world. Explore the charming streets of Paris, the bustling energy of New York City, the ancient pyramids of Egypt and the stunning architecture throughout Southern Spain. And that's just the beginning! With new seasons coming soon, including Costa Rica, UAE, and Oman, the world is your oyster. \n\nDon't just dream of traveling, experience it in a whole new way with Escape Now VR. Download now and let the adventure begin!\n", "short_description": "Experience the beauty of the world in a whole new way with the Escape Now VR series. Take a guided tour to iconic locations like Paris, NYC, and Egypt in 360\u00b0 virtual reality. With new locations like Costa Rica, UAE, and Oman coming soon, the adventure never ends. Download now and let the escape begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.overviewcollective.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Overview Collective", "support_website_url": null, "website_url": "https://www.overviewcollective.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ttrU3e41GwQ7kNvwGIdXbT&_nc_oc=Adl-xiQx2aptT5OrbL9SuMh9iS3Jyiw6RWW8hN_ztV51dmCB7k1DldyZdVbG2DpM7Y0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfudH4dIHvnjLSkjRTzHBq9ys6t-QrUamN0k5LnDU8uHPw&oe=69A57D6A"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWzjmmArPuAQ7kNvwGk4QH4&_nc_oc=Adn3OcZWac3T5Fnr5TIM9yLhNb2inB0cQ_zYtn7F1oBxSt_Xdzd2zaLS7I5k2sGEjO8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftWMd97jn7kftyRZlAJQsHbwhw8LXZ0Ac6tkt6621Ol9Q&oe=69A5713F"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sH_JyXDVQ4kQ7kNvwFVhCDC&_nc_oc=AdmhZftlC_IlOgeayHI-82BznDO1BDUKnkYH1FYE3ZQVehw908j0BVTm7t445mlDXfM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afui2cM_e6T3ZDP4NTnK_fjYkK4I0Xy_BwMbSnTzVycrWA&oe=69A572BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tjtUu5F9eoQ7kNvwGvk0Mp&_nc_oc=Adlj1EIcFnNt9gdcFnHm7vdsEAQkGGYG4ZJe79x7emdxy1MeOW7jjbTqUVDwllNfWZU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvpz6Sv6A7N9p1LDmBnL8suD-C15Z26CTWtrVMOMJD7dw&oe=69A59A36"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "180486658265569"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974807_511518637636442_6763911284648868302_n.png?stp=dst-png_s360x360&_nc_cat=
-sjc6-1.oculuscdn.com/v/t64.5771-25/75630192_684994216749865_59859753522960244_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHKSrUa0_4EQ7kNvwEb4Kfx&_nc_oc=Adnr2eXHryJJt7wiF1gsVfnBZuKUFEyMibcjYYc87EkEjwsb8oJeHl3qsZt99PThnxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnxbW3nJHpwc6qF25oBPoCr7q7tM8kTZ7DO8Jc9Fhy1A&oe=69BE89EA"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyvI526pa0wQ7kNvwHivTAC&_nc_oc=Adl4G__sF1qE5ra_f-1dLJSp1qeJhsfMrcvE2AlPkAl2s0LMXzCnHpr0ychOpNFHbAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsVI7FbJGwm8Y2N69-GiCD6XLwMo51mDXKnr_293m14g&oe=69BE7DBF"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACVWxlHfZRcQ7kNvwFP_1Bu&_nc_oc=Adlws9XvCjGS8PHLpAZYD9yHPe2zH0KB_nBKAuszDPvmyGEthlWuDgZu46QPghOZHxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFVqb9sQeXvxf_W3ZlCx5grivvJqdsByjoasSr6ebKEw&oe=69BE7F3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUWV06yMKj8Q7kNvwEMC7Xh&_nc_oc=AdnQhN772khGoDFWhgNvq8alTaPqJI5mJ77ftqi3GLC918AI7iO2Qntue1kgmex3jhk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDOr3uPkoFmHaMRvHF2Uu2kQZpV0aQy4xScHUjQRC2qg&oe=69BEA6B6"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "180486658265569"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconten
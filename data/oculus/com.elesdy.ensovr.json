": "684994213416532", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75630192_684994216749865_59859753522960244_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R64lBRe-hEQ7kNvwGFiNee&_nc_oc=AdqqLFlDdXO7X8iVVgxZTQDFVkZGwR4lMkfjXZFNkQXnVjaAkUcS5rdKYSo3a1vOjtM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9OSUKksPLloZKjEph7Y4mAaUFvhQI2zJ-oHGaIpRYCA&oe=6A8ED6EA"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnpznBjp5KQQ7kNvwEncly3&_nc_oc=AdoBpMxjCl3hLRBJaC40dbTSh0axRGhiBAlLuHghD2sA5pJWHyygD3J_OPYu_-Sltdg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXZpeTlMH2pEulFew68csgoWlRq6jtIK8f4B2ixAj89Q&oe=6A8ECABF"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCrxrtmRACUQ7kNvwGQoLmL&_nc_oc=AdpIM97o6KeiPJgFuI08wXEzwnB5BlWlDhAWyLLcHDBqXZ3fPZ5VUnQZHSinsLikGH0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExW0IhriwcJkR3uRL_gpkzOllzjXjIqTW58wGsr8CFuQ&oe=6A8ECC3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciAZnvmdhbMQ7kNvwENgZxG&_nc_oc=AdpDPYyQxB8Y7zk_mDGbtNN7sttUxrCM1KKZ-t7I-JupgFd-BId32VFX6xzsZV7khSc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCRg998JNn9LGHhA4T_veOR2BSMe6I2S2mdaxC4rUxKA&oe=6A8EF3B6"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "180486658265569"}, "rev
213416532", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630192_684994216749865_59859753522960244_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfxBRc23PkAQ7kNvwE5Xkoe&_nc_oc=AdqCzrhokSszmx-QqdxVZfgJrTI7HXspG8BocdSRRnQsgBFiCtbJ13TGpwGWgd7cqqg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JlWcj-r1L8nISh0FuPTV2XS1uHprlYeCYCcIgEVvJqA&oe=6A22F42A"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNE8y550zoYQ7kNvwE_BMSF&_nc_oc=AdoNylCw0frnnWuPjxALLZC8cHfmKIEpGRt-PcLGX1_Ae-GegOL387TuxiPtCaTCUts&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DBg_5h6mJDOlv3q8dlvbIQPP0-out2fFDizd7UdCvwg&oe=6A22E7FF"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sledwUeqotYQ7kNvwHo--mz&_nc_oc=AdrlQN3uyb7I4U1oOmdJek2B6PBfzK7KRm3BnrBtMYOzyJhMlANbXK3-liLxlqreAlo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D6Dt-o0IxecLNZ-m8An_LYXw5wqz89c8nGEFNptUEGg&oe=6A22E97C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp69xXLzAioQ7kNvwFxbJZx&_nc_oc=Adr7FDza0GBO3rxRdB1pjixt4sQyp1uJppebS7p9YROGOZC2sxYsRs1PHUmGG45evGY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-amb39QRnTY4y33Pv7lWoo-0ykXp7rjBK48SX9RkVLxQ&oe=6A22D8B6"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "180486658265569"}, "review_messages":
content-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpj7XWCwzJeuNXCkpbQzB11uBvH9v_z0e3uAckrhmY8w&oe=6B083DB6"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
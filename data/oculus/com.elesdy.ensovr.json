213416532", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630192_684994216749865_59859753522960244_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhusdmxfKuYQ7kNvwFffdvI&_nc_oc=AdqJHPirTLO8zCbMgtI2ojRZULVFbwXKowu8l7nIbb3TZb5j040TI4PhUh_p6HJZpRI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vu8z-L0K51hX4fbWFfDu4T4mWchPZzPRsS6x6NBSZNQ&oe=6A395DAA"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqdPoy4o5uoQ7kNvwHjbei6&_nc_oc=Adp1NSS1W7BUOEvBhheCuZkfQhQo7DkggtNekPtHi8HdhMJdgpb9O0cSbCpN4kjet8M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A4jJ9TWKPWelQPLAd5XP1BaBexweOb_JadYsnDSjpCw&oe=6A39517F"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPzp_JTEY34Q7kNvwEgB5Ux&_nc_oc=AdqgApOAm5XVmD9AqmasxNkeRGRK6obpxOo5Rtjf-Ml8F6CiEJc4fSoADfMS-gHnXxw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ukG76Bus-5FKsvBhiTVa3QxqIwaWo3fiXDqpIGx72XQ&oe=6A3952FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZlMTtpX7eEQ7kNvwHE6DbJ&_nc_oc=AdrRZk0wQkV28btTtAOiH0I88yUtl_AuMci2SWopyUvrq1mn4noJo35cO8lgJz8961I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yxQI-1aDNMe8HFua7fMX5u6FEdEs30ttiNcgvGA58ig&oe=6A394236"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "180486658265569"}, "review_messages":
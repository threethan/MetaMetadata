png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lIZCTBf8foQ7kNvwFgarOS&_nc_oc=Admt3K9gsgYrvTn3sZEreK7sSsdwtB3QieJ6vmIpwugxmdpEPhepGZnJih-Km0NnFao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsABZjTLUyYVVGiLkGvMPaEoWpCxo8dBqmXSryVMm7qmQ&oe=69984E6A"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0acA0iXdG4Q7kNvwGPQZcy&_nc_oc=Adn4fKVgDzL6CxD--n_3NNMmfll5CY2dTAQsAbXmOK8sg2M7V42HZl7frWkfANJBzuo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfutnauyQqg8cchyvIUBFtTXtmVjXkHpdf5OetN9hoyFQA&oe=6998423F"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A4aXhPvN5kQ7kNvwGAqT_p&_nc_oc=Admuh_ngyLMSJBwDojAlskkZq-Bj74STswdljR7k_RV8MBMWxLeE5-Opx_z9l1VUt9E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsRJXaijr_JJVrxfSfunMY2t6Z5bZ9OFXzzlvGBJdV82Q&oe=699843BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1BiqCQsmPYQ7kNvwHM54Om&_nc_oc=AdnUWDqot1rSK6T9fn-H9M_cwoKB_qA-nrXto_2Aboy6fnAw9rN5WWN8ekEJob3SOs0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftf1EInb0KFqAM2b1Xc2q28VMNLWMkbUGPm_-OocIv03A&oe=69986B36"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "180486658265569"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_511518637636442_6763911284648868302_n.png?stp=dst-png_s360x360&_nc_cat=
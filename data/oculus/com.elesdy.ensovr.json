QijzXGYQ8PBvYNhl3rcVylddW9qdZBWAbfjuDa6Ba6G-gLRaceg5BzNe7MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWMLTCoDTjGzLCDdChsvPCLp433wT11jAkgDOY59uldA&oe=6B045B2C"}, {"file_name": "Screenshot-3.png", "id": "684994213416532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75630192_684994216749865_59859753522960244_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HtBEdaFbq0Q7kNvwFtb1yb&_nc_oc=AdoffVexuTqlDNPh5exg5qeGaoWtWcf-f-eMUdV7fbwNbTa7R6oqYkspYX-r4ZCTC4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUP_K8zerr1POqRSyOy6ikRoBrdUG8rvRpZih-6aWjDw&oe=6B0464AA"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IRZq2j3wWoQ7kNvwH166ux&_nc_oc=AdpMUD7s2ChBeoRuIzYUSGjVg_F95OudCuR3ZFrj5mR2NtDWnQOnwK5Vt51XQxdsJ40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf3bYGSvTWC-YPLHGEex_a2NjHiKfvLBT39J63D0Y-xg&oe=6B04587F"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_ONk6aqnvIQ7kNvwGOrQ4M&_nc_oc=AdrixkNTKI5E_uyUafbvKnJGXe1A9q7g9hvn2vIs7MlGaWCVa2TDYQKggpHLQ0KyHyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXTe1b5QPOo5WhohGtDA9RhAY5J34b9SdEiOB1aKS2TA&oe=6B0459FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg-frEqNLs0Q7kNvwEK1P-s&_nc_oc=AdrTllNApg56knH3vyOPDj6En_F4jBHYPuBvQ2D1XP1F57MsxOSn6ka7w_gIJBhGWFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzGM7ARr_BIHx1wUQBTztdOgEwcxA5qWfPDibpecg-ww&oe=6B048176"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
Ky2yAMNPcRLSZ0tl6TKUrZtLLriSlz_AbaPHwcW-VnFEfkIEVacclu-XcS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6ABUbPTzdwJXMaHkfrFDKdVmh1bCRb9vlh6qUL51bJA&oe=6B0309AC"}, {"file_name": "Screenshot-3.png", "id": "684994213416532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630192_684994216749865_59859753522960244_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdND6JTTKGMQ7kNvwGoo4Kb&_nc_oc=Adp-auq1rzQAm_ICaAj9hqousglCE6onD6l8_-RcX1bsTgCO0jhOm-6b0lDjFOdGBo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCSFp_Ut2eJIcDRgl6PNj5pHfF_ANG9mngG98uv1Ct3g&oe=6B03132A"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IRZq2j3wWoQ7kNvwFT0ZOo&_nc_oc=Adql1zPOWK5vMXcMMY7ACUJQlZbgWUE7KeXT7OQ0BILo-MSmt5gL_OmWOg8afL8CPXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6kiRR6CoWSMe5m8IgdX5KlEZwZWWxDy4wWTD3vcd0kQ&oe=6B0306FF"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_ONk6aqnvIQ7kNvwF9YBdp&_nc_oc=AdrM2_YcMxg5er9zcw1u1ruMufqo9uc7-vZ-fpGQezOQSYJAy53hgE21Us_QBtoQTcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKD6Un_f4tuxv2HcZ-cpL4nyVutYzly6Gmi1pQbaX48Q&oe=6B03087C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg-frEqNLs0Q7kNvwHPCRM-&_nc_oc=AdqM-g9UKC8RX1QuDDZfbH4USsVtdjODRmNdtb3OJ2YuseQvHTZGiVPTU3G7VMJaV8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRBXK5b_a4kbYqh2mNCtF7omSVutqv6JG68v2MqdDdTQ&oe=6B032FF6"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
xF2H2QJDk-2wudWVb2m4-_UANbzq1gsKT1CMSq5Y2qjcVh6mCFgJMCT3yn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQMKUWGUiEekZXOV1d_bjGYya0fvJybURiCnRbIfW8ow&oe=6B01B82C"}, {"file_name": "Screenshot-3.png", "id": "684994213416532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75630192_684994216749865_59859753522960244_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdND6JTTKGMQ7kNvwGR3Enq&_nc_oc=AdrbFt6Zq0oa2NJkGL6NM4lLtLzooJ-rGHfxmeLYgTsd1_irbYh4ZVC57wKenyLdgtA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN1ltQxb4q6RHqm3azKjRx6IjKECK6DnxWm0v3Ryueug&oe=6B01C1AA"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IRZq2j3wWoQ7kNvwGBYx_6&_nc_oc=Adrq-WwLRO0_GeIZWz240_j64z4TWL3I5MN0olCvn9EckErx4aqS3P7jENIbUKI_e90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpPdF-SoWGCNVbOXuckaBAbxfW9lHIkd82HFbC1BfktA&oe=6B01EDBF"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y4Y3J7y1oEQ7kNvwFNGX84&_nc_oc=AdoTvOISDSlEE2MX1Ou2zVvneWxor-yekAv9ICoTKVGDSg6uGVohOnXf3wmx89kMpWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbZVugpz6zgXLlitXw0_PEq4viQz76tVU2Bkj6ch1S2g&oe=6B01B6FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg-frEqNLs0Q7kNvwHBikkl&_nc_oc=AdqughgV5mawIWgSiwn3iAFupd-NzWuyvooeXluqavKV1YdbK_A12pXG6l9UqHhIUxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsNxvrVV8LX0WB-VMJ1ydOWtU-R3dKt0XGmXPOXCiEvA&oe=6B01DE76"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
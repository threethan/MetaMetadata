png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ttrU3e41GwQ7kNvwEDxZ2n&_nc_oc=AdmEAX5fgbesIJSoUIvT_9NBuzdeGX4OTEnIaJUu8O3-8IiKoipKVmm1xMcTwa6VKDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAnJgJ4wHcyyKyEfqrnqUMUkbfJcBMvmi0cb-VekR2Zg&oe=69A6CEEA"}, {"file_name": "Screenshot-1.png", "id": "653826669830644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031571_653826673163977_5885008424774805812_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWzjmmArPuAQ7kNvwGmylRl&_nc_oc=AdlaKfB1d8oV-kXY9oC-zXM93ip1KvO8C-aWuNL0HFltWwg2kZQPKuDHwJu-6d7QsaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPilZXTbryVZ_8wdVzZIqx4VhtobULT4HCIKViDKKhMw&oe=69A6C2BF"}, {"file_name": "Screenshot-5.png", "id": "538640868224117", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221316_538640871557450_8313866470354518460_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4a4MBTn3KIQ7kNvwE2BsMV&_nc_oc=AdnvY3bLz1ODqaVg9AHUeRvh4foRssv8HWNgHeQZHZstDGdIvySZXPS9cBGpgeQjSPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsN0pRBCGb_XSLBTKmdGQCgZPZVKC_E8_Bo03nH9Dg8mg&oe=69A6C43C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image-Enso-VR-film.png", "id": "1335798490599949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250456_1335798493933282_4596375010783402970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tjtUu5F9eoQ7kNvwF_Gx3U&_nc_oc=AdlE86AM5LESU4tLPkvm-bbcDcLkX_RoA8r1lnVtDWI_L3xJRbjs_H7A5eHv_t1vvzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNP_0Gvp8yaOJkYqO_33v8lff0dFf1K5K9ZEcrHZ1BTw&oe=69A6EBB6"}, "display_name": "Enso", "keywords": [], "long_description": "Embark on a journey to unlock your inner peace with Enso, the immersive VR app inspired by the ancient wisdom of Zen Buddhism.\n\n\u2022 Discover 10 unique meditative journeys, each expertly crafted to help you focus, reduce anxiety and reach a state of deep relaxation.\n\u2022 Let the soothing ambient sounds and immersive music guide you towards a heightened sense of awareness and inner peace.\n\u2022 No two sessions are alike, with each journey offering a unique experience\n\u2022 Track your daily and lifetime meditation time, as well as your streaks, to help you stay motivated and reach your goals.\n\u2022 Enso caters to both beginners and experienced meditators, providing an ideal platform to elevate your mental and emotional well-being.\n\nDownload Enso now and start your journey to a more mindful, serene, and fulfilling life.", "short_description": "Unwind and find inner peace with Enso, the ultimate VR meditation app featuring 10 unique journeys that reduce anxiety, promote deep relaxation, and enhance mindfulness. Immerse yourself in a state of flow and bliss, and discover a new level of tranquility from the comfort of your own home."}]}, "developer_name": "elesdy", "developer_privacy_policy_url": "https://elesdy.com/games-privacy-vr/", "developer_terms_of_service_url": "https://elesdy.com/terms-and-conditions/", "publisher_name": "elesdy", "support_website_url": "https://elesdy.com/feedback/", "website_url": "https://elesdy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "180486658265569"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_511518637636442_6763911284648868302_n.png?stp=dst-png_s360x360&_nc_cat=
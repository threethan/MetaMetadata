IWGRROQm4-O21RVi-4M5Z5chBc7fDeyQHyRphDP4TKtg_s3d2unA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYLnQHMDG2Bp87UJXy29sjQDZ5mMm8H1UVUDETsk23-w&oe=6B0F096F"}, {"file_name": "25659459307022160_screenshots_1.png", "id": "1004746835647911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828087_1004746838981244_6378279861877876053_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9axknRdCUEUQ7kNvwEfTNTy&_nc_oc=AdofRrMTxvZpgKPgSXxbIMzQ4cUNmYE9EHL3v_lDslO44EEkR2yvRMkC0JAsh09q5IQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyPFMOvl9sVDtRBD8vfYJ6ben8nqMG6AkU73cBRaKKvA&oe=6B0F0451"}, {"file_name": "25659459307022160_screenshots_2.png", "id": "1775073370455952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_1775073373789285_2909261544508868882_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUC0O7lghI0Q7kNvwEhj0om&_nc_oc=AdrdtWlGlOhfLk9h0CV5kd1wkyqEETK1hOF7Yb9yDv0bM-gMOvX8flWS5vAorLYT5tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWd1VRCFNHBaRG6MkCiVB7qQ-QrcZJ4-R020Rc6R7FqDw&oe=6B0EF41D"}, {"file_name": "25659459307022160_screenshots_3.png", "id": "1598179514994620", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1598179518327953_2918175869723012317_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1FUIKuvCJ8Q7kNvwG0gRDT&_nc_oc=AdrR-sSiswsfP4pMqHEOJQwpkEIUcGujV2fC5T1-bI4zZw4giKjD3PtQkwy2Cb584S8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEQAE1NQ9EF2PRtiPCPGs5byqB1tHUboORjbXK4nqPQg&oe=6B0F1F3F"}, {"file_name": "25659459307022160_screenshots_4.png", "id": "2312201229313425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_2312201232646758_1629777394853617693_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvzjg_GY4iYQ7kNvwHrKD7A&_nc_oc=AdoYGQD3CjsSY0gcSM5g3XoOfgGRZqqTq44JitMjgmv3Q9aGVCeqOQyx-r5LFxefq5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeR7xnyjqSSYbUQtzSc_dz1cRlNDzgATsrjzByGjZhLQ&oe=6B0EF84F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RTX Scary Baboon", "keywords": [], "long_description": "Step into the wild\u2026 if you dare. RTX Scary Baboon plunges you directly into a chaotic VR landscape where danger lurks behind every tree. This isn't your average walk in the woods\u2014it's a fight for survival in a primitive world gone completely mad.\n\nTransform your experience with unique modifications that warp the environment into something far more sinister. No two playthroughs are ever identical. Navigate through suffocating, shadow-drenched territories where your eyes will constantly play tricks on you. Push your adrenaline to the limit during frantic, heart-stopping chases that demand split-second reactions.\n\nEvery single mod introduces a brand-new element of tension\u2014ranging from disturbing aesthetic overhauls and sudden jump scares to entirely overhauled mechanics. Can you handle the panic, or will the jungle claim you?", "short_description": "Step into the wild... if you dare. RTX Scary Baboon is a heart-pounding VR experience that throws you into a chaotic jungle where every moment is unpredictable. With custom mods, you can completely twist and reimagine the game.\n\nExplore eerie environments, navigate treacherous terrain, and survive intense chases that will test your reflexes and courage. Each mod adds a new layer to the experience\u2014whether it\u2019s immersive visuals, atmospheric tension, or entirely new gameplay mechanics to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rtx-scary-baboon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VR Gorilla Mods", "support_website_url": null, "website_url": "https://sites.google.com/view/rtx-scary-baboon/home", "category": null, "comfort_rating": "COMFORTABLE_FO
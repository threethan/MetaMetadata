om/v/t64.5771-25/38974798_357212360114043_8870245353045085890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2SnNG4tGfoQ7kNvwGSrKe8&_nc_oc=Adm65JDH6nhj36oaW5g-WaCIYFyP_wpjmB2d7taYm2YZxMRAACOiE47C1vlgDk2KpCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYAvcKd0YszE_uobt_jQETBviN0bZ0VIS4rqxK4b3FAQ&oe=69A2C954"}, {"file_name": "sc11 (1).png", "id": "748117920441316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_748117923774649_4364177760068745790_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIzFcuo9y2sQ7kNvwEkdvW0&_nc_oc=AdnO49A1_e5Rrrz-_hpeNm_bwBNjzeDG0ff18aLekKzBmdCddODYbvJ8_ZcJnoJj4aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuo1mAAmkS9Wl4ioJgpMYm-AqljzkaYdtXeZ0B9xTqH8A&oe=69A2C679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "698424879019836", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974606_698424882353169_6437639616530020312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp8C0iKU4AEQ7kNvwFiLoTn&_nc_oc=AdlbcMbnoD6NjhFjddBSQJfWhg5bxxPnqf9z0gcb2--ZTxiBe8OGQuN7Whp-65xOVnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftqXKYj_ZzDOGTggfgjLDt_Gcjh8rLGpWP61MLiBDk1IQ&oe=69A2E568"}, "display_name": "Track Craft", "keywords": [], "long_description": "Ever dreamt of racing toy cars through your home, creating imaginative tracks, and sharing the excitement with fellow players? \n\nTrack Craft makes it all possible.\n\n* 3 Unique Track Packs: Each with its own visual style, sound design, cars, and special pieces for unique gameplay.\n* Arcade Mode: Race and conquer over 50 levels.\n* New Car Physics: Experience guaranteed fun with our revamped car physics.\n* Free Drive: Roam freely around your home with toy cars based on your room mesh.\n* Custom Editor: Build tracks with simple blocks, special pieces, props, various materials, and more.\n* Community Sharing: Share your tracks and compete against other players.\n* Unlimited Community Levels: Endless possibilities created by the community.\n\nThe game is available on Quest 3, Quest Pro and Quest 2.\n\nUpcoming Features (the current version is paid early access, and we will be rolling out more incredible features in the following months):\n\n* Trackmania-Style Multiplayer\n* Asian Style Track Pack: New design, cars, and special pieces.\n* Improved Community Levels\n* Garage Feature\n* Live Multiplayer (2024)\n\nGet ready for a unique mixed reality experience with Track Craft!", "short_description": "Track Craft \u2014 where you turn your world into a mixed-reality playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy", "developer_terms_of_service_url": "https://www.gamify.cz/terms-of-service", "publisher_name": "Brainz Gamify s.r.o.", "support_website_url": null, "website_url": "https://www.trackcraft.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "673505748021099"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1092938632913455"}, {"status": "PUBLISHED", "id": "2484502795231331"}, {"status": "PUBLISHED", "id": "692753636456592"}, {"status": "PUBLISHED", "id": "3467424300232647"}, {"status": "PUBLISHED", "id": "1857668675086376"}, {"status": "PUBLISHED", "id": "603846292518830"}, {"status": "PUBLISHED", "id": "1316776826028720"}, {"status": "PUBLISHED", "id": "588295
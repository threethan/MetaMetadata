vnOCdhtOAG7342Qyw&oe=69A57B51"}, {"file_name": "STILL1_1.1.1_upscaled.png", "id": "1224931248791958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974804_1224931252125291_3493519641516258670_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPrfICjTigoQ7kNvwHDNKON&_nc_oc=AdmVXjHwFrT4PMJfODUYctEaB04f3NDEGG-ShZX1JmbwN9Sy6J0-QHpbLK0ACmFv-VI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfujLSb_Y_qrhkZLAPa144BX9DhrfFzab_sd2ST_RyKcHQ&oe=69A5701D"}, {"file_name": "TJ vR still 2_1.1.8.png", "id": "1199027898001704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348041_1199027901335037_7675997282911940636_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb18sUz5UaIQ7kNvwHVVq7W&_nc_oc=AdmPMhey5_KMjNKS5Yg7IdSEkVw-NhaMv2BQxWpraqV_ZDKCo9_5ky0Qm3fveBG3cNQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu0DZpA2Z0aG9ijULpMGVC0SxaR7x-W37ehL6ZhQTKjWw&oe=69A59F53"}, {"file_name": "rd still vr_1.1.4.png", "id": "528545392967530", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75508952_528545396300863_1444802787237307590_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Da2ZkPnXc48Q7kNvwFGhgi4&_nc_oc=AdkQ4-UH499yBB4yjNZAYLUyLHuQtrV5IbCCTo5b8iP6fyiMGwgHUR4dE4gEbq30DGo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuuzZ5hj3rgiygAToKMsO2qkc05rL29egYVKjHjSI_u6Q&oe=69A56BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-RD (1).png", "id": "547191818112728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035448_547191821446061_8962058648831132714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm3BSF5_ZrUQ7kNvwE0X1NH&_nc_oc=AdmByDZDen94cHYPagg1RLD-C4RXGPF0O4D-m2TE0ojW08VhjvC-0W-AmU-V9c734Vc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvPHfNveVPco2_OoKGfd43BSX8jhzt2l-k0uyQgyoYdRw&oe=69A58561"}, "display_name": "Track Craft", "keywords": ["track", "craft", "racing", "car", "mixed"], "long_description": "**Track Craft is a mixed-reality racing game where you can turn your surroundings into a racetrack.**\n\n\n# ULTIMATE MR PLAYGROUND \n\nUse your surroundings and turn them into a mixed-reality race track.\n\n{1272215014134973}\n\n\n# EXPLORE DIFFERENT WORLDS\n\nGet behind the wheel and experience the 104 pre-built tracks spread across 5 different worlds. Each brings new mechanics, challenges, cars, and skins to unlock.\n\n{2499265100265459}\n\n\n# CRAFT YOUR OWN TRACKS\n\nCreate tracks intuitively thanks to full hand tracking and share them online. Or just race on new tracks created by the community every day.\n\n{1695057567991201}\n\n\n\n# ONLINE MULTIPLAYER\n\nPlay and Craft with your friends at home or online with players across the globe.\n\n{1046525373656002}\n\n\n\n# BUILD UP YOUR COLLECTION\n\nUnlock new exciting cars by collecting stars.\n\n{850050203892697}\n\n\n\n\n\n\n\n\n\n\n\n# THE FUN NEVER ENDS\n\n\n\nAvailable on Quest 3/3s, Quest Pro, and Quest 2.", "short_description": "Track Craft is a mixed-reality racing game where you can turn your surroundings into gravity-defying racetracks. Drive tiny cars, craft exciting tracks, and race daily on new circuits with friends or other players.\n\nCRAFT. SHARE. RACE. REPEAT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy", "developer_terms_of_service_url": "https://www.gamify.cz/terms-of-service", "publisher_name": "Brainz Gamify s.r.o.", "support_website_url": null, "website_url": "https://www.trackcraft.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
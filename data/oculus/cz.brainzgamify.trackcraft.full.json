wTTeF&_nc_oc=AdppKA1FCN1u4uiu0TViOh-ZONmOuGBMThA8_6lcxUquUdtjt655rev_PA0nizHr9qI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiAZDRgU2SCmlGm6J57VGk5fCTUqvtbMojjbC8YeiUfA&oe=6AA3ECD1"}, {"file_name": "STILL1_1.1.1_upscaled.png", "id": "1224931248791958", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974804_1224931252125291_3493519641516258670_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pASsWA2i0zUQ7kNvwEJhLu1&_nc_oc=AdoOR0D5zNFauBqTJq2Oc08M3hFpERlpLcyoV_sGPV1T7sjqSr0w1T-lTP1hwP26YDM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY46Vk3Z4B953BAtHBDRGVnsYTA29Z2rBp-JCOzF7G7Q&oe=6AA419DD"}, {"file_name": "TJ vR still 2_1.1.8.png", "id": "1199027898001704", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75348041_1199027901335037_7675997282911940636_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTc3VSpRnEEQ7kNvwFn4kTR&_nc_oc=Ado2kOGWYNewr4QthGSSAYFGw_HoCEZB_yXtbmBxjTLB_Hl3C2UXVMX8SZWxdUrZQNU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3ORKO5Ybq99MhbEQSrdCFvLYr9ueaBXCd_bBiJr_DHQ&oe=6AA410D3"}, {"file_name": "rd still vr_1.1.4.png", "id": "528545392967530", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75508952_528545396300863_1444802787237307590_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLxI5erDCKAQ7kNvwETFRgP&_nc_oc=AdoAdy0XntoV8sJ7Lsn9KSDERjXLKFXnSVfqv6dO-rDfi297NN904tdn_lfrEwMxNK0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqXZJrzsEvVCN0B1FSvU6Cskh5IdRX4RpMg6tJfMJ0tA&oe=6AA415BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-RD (1).png", "id": "547191818112728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035448_547191821446061_8962058648831132714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQAb5F4p61sQ7kNvwFyT9EG&_nc_oc=AdrlhUTtv5UKI7LLwMU-ut94xhWxeAhXLAUy2hgkZ4-v_cNr2mhLhj-RYmXEHPF2mHc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOs8g5ke04Gw6ZoD8nKZhS_yw1Skj_q0mTz9EPk2UEXw&oe=6AA3F6E1"}, "display_name": "Track Craft", "keywords": ["track", "craft", "racing", "car", "mixed"], "long_description": "**Track Craft is a mixed-reality racing game where you can turn your surroundings into a racetrack.**\n\n\n# ULTIMATE MR PLAYGROUND \n\nUse your surroundings and turn them into a mixed-reality race track.\n\n{1272215014134973}\n\n\n# EXPLORE DIFFERENT WORLDS\n\nGet behind the wheel and experience the 104 pre-built tracks spread across 5 different worlds. Each brings new mechanics, challenges, cars, and skins to unlock.\n\n{2499265100265459}\n\n\n# CRAFT YOUR OWN TRACKS\n\nCreate tracks intuitively thanks to full hand tracking and share them online. Or just race on new tracks created by the community every day.\n\n{1695057567991201}\n\n\n\n# ONLINE MULTIPLAYER\n\nPlay and Craft with your friends at home or online with players across the globe.\n\n{1046525373656002}\n\n\n\n# BUILD UP YOUR COLLECTION\n\nUnlock new exciting cars by collecting stars.\n\n{850050203892697}\n\n\n\n\n\n\n\n\n\n\n\n# THE FUN NEVER ENDS\n\n\n\nAvailable on Quest 3/3s, Quest Pro, and Quest 2.", "short_description": "Track Craft is a mixed-reality racing game where you can turn your surroundings into gravity-defying racetracks. Drive tiny cars, craft exciting tracks, and race daily on new circuits with friends or other players.\n\nCRAFT. SHARE. RACE. REPEAT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy", "developer_terms_of_service_url": "https://www.gamify.cz/terms-of-service", "publisher_name": "Brainz Gamify s.r.o.", "support_website_url": null, "website_url": "https://www.trackcraft.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "R
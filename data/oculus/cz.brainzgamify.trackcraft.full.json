lPLFWm_72HUnMoaRklKxD1KY_VNQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzzRJaffz-W0v8WQGV9detpU6y9NqI6f70vj6JcnMrjkQ&oe=69B93574"}, {"file_name": "sc 12 (2).png", "id": "357212356780710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974798_357212360114043_8870245353045085890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Oa1VuJrKiIQ7kNvwEiIKJM&_nc_oc=Adk0s3aLTzj423sseqln-61DUTScSmIS4rcilZ5z-s9wRdAXnaVs0fqR016oVEtrV1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWTme5wWMzpV96kb9GWpqmSzdcuXVUXBIuY3za0Ls_fw&oe=69B932D4"}, {"file_name": "sc11 (1).png", "id": "748117920441316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_748117923774649_4364177760068745790_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnAbU2cYRlgQ7kNvwGpi_Nl&_nc_oc=AdmXHp127XGNomSJx5upFJJO8rzC8k8TUH4wxViE98mhDdC_jyJMIYv2k72QLiTrmBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzroKx-Rdwr5ivOWfxoGdMgRt0Fo1uF1Ob0QUfPcz1eQQ&oe=69B92FF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "698424879019836", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_698424882353169_6437639616530020312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_aQiQjTypoQ7kNvwEx-Ka2&_nc_oc=AdkGezG0bl0ejc3fyeezTX2x7jZPYMJNsA4dN_l4GgxMKljp0rUj-Ep-DU93Taym-lg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9W4Ecvx4avbj72PGCCGSzp_xbe5LLzxbP5prdiIUy8A&oe=69B94EE8"}, "display_name": "Track Craft", "keywords": [], "long_description": "Ever dreamt of racing toy cars through your home, creating imaginative tracks, and sharing the excitement with fellow players? \n\nTrack Craft makes it all possible.\n\n* 3 Unique Track Packs: Each with its own visual style, sound design, cars, and special pieces for unique gameplay.\n* Arcade Mode: Race and conquer over 50 levels.\n* New Car Physics: Experience guaranteed fun with our revamped car physics.\n* Free Drive: Roam freely around your home with toy cars based on your room mesh.\n* Custom Editor: Build tracks with simple blocks, special pieces, props, various materials, and more.\n* Community Sharing: Share your tracks and compete against other players.\n* Unlimited Community Levels: Endless possibilities created by the community.\n\nThe game is available on Quest 3, Quest Pro and Quest 2.\n\nUpcoming Features (the current version is paid early access, and we will be rolling out more incredible features in the following months):\n\n* Trackmania-Style Multiplayer\n* Asian Style Track Pack: New design, cars, and special pieces.\n* Improved Community Levels\n* Garage Feature\n* Live Multiplayer (2024)\n\nGet ready for a unique mixed reality experience with Track Craft!", "short_description": "Track Craft \u2014 where you turn your world into a mixed-reality playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy", "developer_terms_of_service_url": "https://www.gamify.cz/terms-of-service", "publisher_name": "Brainz Gamify s.r.o.", "support_website_url": null, "website_url": "https://www.trackcraft.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "673505748021099"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1092938632913455"}, {"status": "PUBLISHED", "id": "2484502795231331"}, {"status": 
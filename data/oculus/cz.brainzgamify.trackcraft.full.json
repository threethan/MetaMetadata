_nc_oc=AdrceH8WvvzH6aVEtke_cbexB-sGxd60HUzOK5A04H4gm1ouhwB8_DlZmU3xs8QDGws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86lvs6B6YmUeWGzjhMHw1rx5awBkAnsn5NzKvKyuepYA&oe=6A356711"}, {"file_name": "STILL1_1.1.1_upscaled.png", "id": "1224931248791958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974804_1224931252125291_3493519641516258670_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6V4kGk4h94Q7kNvwHHnt9R&_nc_oc=AdoYEU7xA2sF8OxHNE1bkIy77sG4CcmgyQcGod6UzRLrCW1vzhJTSwKoK9eUthc9qPw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mpNUVVcB6NW7Bcq4W_kUQOwEGhlkPbNzHy-n7TrZa2w&oe=6A355BDD"}, {"file_name": "TJ vR still 2_1.1.8.png", "id": "1199027898001704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348041_1199027901335037_7675997282911940636_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLgY2bBtM10Q7kNvwFwm2wD&_nc_oc=AdpEuqdxiP-3XSxv1nbdd3S_L12t-tI9SnO7XHyQxfaH8RbsXT574y9AJ5T4ekeGz6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NX6FaD12umjxscKyEHwFh-fJahZrF8oBoCri01O8uBA&oe=6A3552D3"}, {"file_name": "rd still vr_1.1.4.png", "id": "528545392967530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75508952_528545396300863_1444802787237307590_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zUWrghNP-sQ7kNvwFeK8ze&_nc_oc=AdpYQ6ugQ11zdbxi9jcEcL6Ag50VoKJSQoF3nAyNimwgTv9uqKMc-vq8nTY171JL-nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o1kN3qhJuoJeR3v27Q0wW-4FtW6acjvuRFB6cxp_6gA&oe=6A3557BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-RD (1).png", "id": "547191818112728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035448_547191821446061_8962058648831132714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHx8Op4XYVEQ7kNvwE2LY9h&_nc_oc=AdptpkWKaXPReN7ApoWctecRo5MB5QdZpwHtDbsqdEr626n892FdFP6bJTxKizVlvjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6ws4ppYjpczJAIgMGkb9syPcuZwy1y2VnoSc8hk5pog&oe=6A357121"}, "display_name": "Track Craft", "keywords": ["track", "craft", "racing", "car", "mixed"], "long_description": "**Track Craft is a mixed-reality racing game where you can turn your surroundings into a racetrack.**\n\n\n# ULTIMATE MR PLAYGROUND \n\nUse your surroundings and turn them into a mixed-reality race track.\n\n{1272215014134973}\n\n\n# EXPLORE DIFFERENT WORLDS\n\nGet behind the wheel and experience the 104 pre-built tracks spread across 5 different worlds. Each brings new mechanics, challenges, cars, and skins to unlock.\n\n{2499265100265459}\n\n\n# CRAFT YOUR OWN TRACKS\n\nCreate tracks intuitively thanks to full hand tracking and share them online. Or just race on new tracks created by the community every day.\n\n{1695057567991201}\n\n\n\n# ONLINE MULTIPLAYER\n\nPlay and Craft with your friends at home or online with players across the globe.\n\n{1046525373656002}\n\n\n\n# BUILD UP YOUR COLLECTION\n\nUnlock new exciting cars by collecting stars.\n\n{850050203892697}\n\n\n\n\n\n\n\n\n\n\n\n# THE FUN NEVER ENDS\n\n\n\nAvailable on Quest 3/3s, Quest Pro, and Quest 2.", "short_description": "Track Craft is a mixed-reality racing game where you can turn your surroundings into gravity-defying racetracks. Drive tiny cars, craft exciting tracks, and race daily on new circuits with friends or other players.\n\nCRAFT. SHARE. RACE. REPEAT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy", "developer_terms_of_service_url": "https://www.gamify.cz/terms-of-service", "publisher_name": "Brainz Gamify s.r.o.", "support_website_url": null, "website_url": "https://www.trackcraft.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED"
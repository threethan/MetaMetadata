oprDhfkrVrkCl_OGw&oe=69A186D1"}, {"file_name": "STILL1_1.1.1_upscaled.png", "id": "1224931248791958", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974804_1224931252125291_3493519641516258670_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yns9sMXXlw4Q7kNvwHLDj7j&_nc_oc=Adlvg5PAScuZvpwpFl-Psv8ZzYmBAFiSCW7H3XxFzicPA5F9FCr7buw651pnv_aoCjU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsEhxL-5BakIWPWTwbeYZi9gfHUzKM40nYkA5ZHS1czag&oe=69A17B9D"}, {"file_name": "TJ vR still 2_1.1.8.png", "id": "1199027898001704", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75348041_1199027901335037_7675997282911940636_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w2H9L8WRJAQ7kNvwHgWpp_&_nc_oc=AdnYQRDnBAjV8XHeIw18kfj9uxxMmseOl0jrnKylGMn6PfhU87D1DDEmDVb1dscH0PI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftaiWW7Las8xjaNT5-EOLiLRzB3RhdAaRxqhRm0KfdIzQ&oe=69A1AAD3"}, {"file_name": "rd still vr_1.1.4.png", "id": "528545392967530", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75508952_528545396300863_1444802787237307590_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMsKacDr9mMQ7kNvwETWoMY&_nc_oc=Adm-LOSLEzVLuLOX1wdK_2k1HcDvFqxfVW9ec9DBKgzOBeG8FiNivWRy0Ge58HuEVWM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftgrn0hIfE_CD-Hzf2FBxMAh8DyZPp6woIVkIfX7rdspg&oe=69A1777F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-RD (1).png", "id": "547191818112728", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035448_547191821446061_8962058648831132714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkB2aIHTjV0Q7kNvwGT3vQf&_nc_oc=AdkZYxyWufnMXfPmUwfo_qHhW0S4yARk3fc4PEFbPebirybRQd9E03Li22O3P5DQmSo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftibwgV1wneGSxDjdjwRQSegMW6a_IKXePS0lHwIIkXOQ&oe=69A190E1"}, "display_name": "Track Craft", "keywords": ["track", "craft", "racing", "car", "mixed"], "long_description": "**Track Craft is a mixed-reality racing game where you can turn your surroundings into a racetrack.**\n\n\n# ULTIMATE MR PLAYGROUND \n\nUse your surroundings and turn them into a mixed-reality race track.\n\n{1272215014134973}\n\n\n# EXPLORE DIFFERENT WORLDS\n\nGet behind the wheel and experience the 104 pre-built tracks spread across 5 different worlds. Each brings new mechanics, challenges, cars, and skins to unlock.\n\n{2499265100265459}\n\n\n# CRAFT YOUR OWN TRACKS\n\nCreate tracks intuitively thanks to full hand tracking and share them online. Or just race on new tracks created by the community every day.\n\n{1695057567991201}\n\n\n\n# ONLINE MULTIPLAYER\n\nPlay and Craft with your friends at home or online with players across the globe.\n\n{1046525373656002}\n\n\n\n# BUILD UP YOUR COLLECTION\n\nUnlock new exciting cars by collecting stars.\n\n{850050203892697}\n\n\n\n\n\n\n\n\n\n\n\n# THE FUN NEVER ENDS\n\n\n\nAvailable on Quest 3/3s, Quest Pro, and Quest 2.", "short_description": "Track Craft is a mixed-reality racing game where you can turn your surroundings into gravity-defying racetracks. Drive tiny cars, craft exciting tracks, and race daily on new circuits with friends or other players.\n\nCRAFT. SHARE. RACE. REPEAT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy", "developer_terms_of_service_url": "https://www.gamify.cz/terms-of-service", "publisher_name": "Brainz Gamify s.r.o.", "support_website_url": null, "website_url": "https://www.trackcraft.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
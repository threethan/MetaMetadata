OLgAv38cnQtg&oe=6A8EDAA3"}, {"file_name": "cap4.png", "id": "1639875857014992", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619836_1639875860348325_4677499299977888864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO87KnXS7CgQ7kNvwGEf-ay&_nc_oc=Adpt9nTAWfzqavvsMmDw3_PefMokILJ7MbrHijqvnbJPC0upsOH1XtzfLIgMwmzmaTw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO1vnHTk6HDoIxF6i6v8b4y3ZLp_OQhA8x5v1j--4SlQ&oe=6A8ED0ED"}, {"file_name": "cap5.png", "id": "1558284135428920", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619518_1558284138762253_1696191126754452963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tjhfGzjjtwQ7kNvwEHupwV&_nc_oc=Ado5T3dCSIn16g72nCm_m0nt9SBcY3KiLS2dPADvyvsfYGCdBsmtOMcT2UqKBQBNsg4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFnnT6IIZNwIezliM34G3OnnZxI632UYCr4aingSaHBg&oe=6A8EC15D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["peru", "supervivencia", "experiencia", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}, {"images": {"nodes": [{"file_name": "512_512.png", "id": "9631048836974813", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820568_9631048840308146_509837651242745521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOgo92kb6acQ7kNvwG8i8-c&_nc_oc=Adqf29cZl2B2y0fPZgVCCkffuV9brJJX7EJ84xPubjNiVJvNaaeMKdsAF9ClrXP7vjE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcOxTKs8-x8CusmL5OxnAqCZ362XnfMsfZ2eEprHFmSA&oe=6A8EEA96"}, {"file_name": "1440_1440.png", "id": "1616373002704844", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618064_1616373006038177_7924286155699406709_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq5Dq-zeIy4Q7kNvwEP7JDI&_nc_oc=Ado-D_0pEBYWXtIMLGegztxZS0CpyAvXWEA4kAVkuY-zSns5pb7YokEUBUgA57JbZZc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgri162EaovHPf7hU4sUyFju_H6G_HBbgK63FCae9l9w&o
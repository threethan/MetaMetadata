9oU746MpZUeW1x0VPua2kI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrWiag3tU8IaPzItQaajRxLcobq96jdMfiF7TCMyO7AQ&oe=6B0701AD"}, {"file_name": "cap5.png", "id": "1558284135428920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619518_1558284138762253_1696191126754452963_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vtzF_QK-5AQ7kNvwFQxJii&_nc_oc=Adq8PFgG_Z1A9KWZNja_fbWUYZ2RiVfV2FBhIp_HU1btx_LND5SlXWvWEzx5EE6u3w0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4o4rMSdSscle-NVhzw7Cw_gZN-IlRlQr7o4S5r7YNXQ&oe=6B06F21D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["peru", "supervivencia", "experiencia", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}, {"images": {"nodes": [{"file_name": "512_512.png", "id": "9631048836974813", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820568_9631048840308146_509837651242745521_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O84AYBRsh0MQ7kNvwH1ICqL&_nc_oc=AdqrxcoyPs8YPWXu30YXpJ0htvG4Ye4haR34LVdbLGCFJLXYrYgVoBBSfSLT6juwnAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyT_PbrHbFvuQz7n8GNa16vTXryYHb2MyhQSFwHAM7eQ&oe=6B071B56"}, {"file_name": "1440_1440.png", "id": "1765454357708679", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822825_1765454364375345_7909604751711691604_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELtFE_BxZS8Q7kNvwF4qD74&_nc_oc=Adr_fB1_XBgJRkfNMTqlm3di2l0Avc2SwY8Vv0sz3zT40Y8AdKNl6FE9qNaTq6t69I4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxuOFdSVcoRvs0TmRP_4iMzTjm3NWKVaFoDKALEQzZsQ&oe=6B071660"}, {"file_name": "3000_900.png", "id": "972162071382507", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830017_972162078049173_5259530170694432986_n.png?_nc_cat=101&_nc_map=urlgen_buck
1V5bdbyRvmyhSMf2MWYJwDK_jUsfpNDZZDVdsGH32M&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfspK_a3eQz0Rd0zeJOgQEMn9JBkaCc22OIKA0eyDaSxxA&oe=69A176D9"}, {"file_name": "cap2.png", "id": "2236075723596868", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618254_2236075726930201_2833647435954867231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nSHm1pGX3EQ7kNvwGXroC4&_nc_oc=AdnEoLrIuknyzWi2J5ZWnLCa7JQEe3TG0DKaeuryXDz6MoAY0ZhNWkQx3FBx1BYqKPw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuKmEarb4Wf8G60dDcEFNROppd7Mmwi19_bzl3xd8DZgA&oe=69A175F2"}, {"file_name": "cap4.png", "id": "1255611369963759", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499620817_1255611373297092_96021354891555384_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odv3FDm34GcQ7kNvwH9FnKQ&_nc_oc=AdmSEBBL8b-Psi6UP5loYHaYICu-6QyhUUXoGiOMR5QnIRIsxDz7T6UFPnJYyBzmd5U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvbfUAjQJY_qR3USD35JD_DQznAUX3eDeXZNZ79l5mJ2Q&oe=69A195B7"}, {"file_name": "cap3.png", "id": "1669991597313701", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499622334_1669991600647034_8514468019372709132_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVKiTayYzjkQ7kNvwHzHrSh&_nc_oc=Adn0dEmWhIjMr6t7Sw0HG_uF7moGBf3TLV3sQKFP1koowvKdOANM4WguMrqcwS73Q-I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfueAitvWM0fZFvMfwHYOYJNEuIO2uSfaScR2jCp5XybiQ&oe=69A18C8F"}, {"file_name": "cap5.png", "id": "857406050437499", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499618103_857406053770832_3571194828216299378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG2_8XSIixoQ7kNvwHX5LPh&_nc_oc=AdlYjNpmWwpNlYxyLVg7XY-OYV_yMW4sCkzr2bgEQbQ3EN1lCJAQxdOautpiKfkcyLU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft1cldBpIutQvX0qXcXE9d6zgqtH5n4oFJ-vAUkfcBFWA&oe=69A192DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["selva", "exploracion", "peru", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}]}, "developer_name": "Brand
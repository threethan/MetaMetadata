t=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1SiD_7aDRPvjtx-P3YkUBn7iDIIAf4DbrMnbkWhYOZ3A&oe=69F0A5C9"}, {"file_name": "1008_1440.png", "id": "870700675553380", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618293_870700678886713_4371290832894485742_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVQxcFDnmtIQ7kNvwHX_XP2&_nc_oc=Adorhdnvnu29dN1BS0i5ntzJJxvXzJHVg66GtX053HFvObsPBWOFT8-CGjeegdS9C9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0uz43ZSAHI9BTVWLkQXEG9SCsJPFTTlOIKA_BSg5Etag&oe=69F0C4FB"}]}, "id": "1932676390653905", "locale": "es_LA", "screenshots": [{"file_name": "cap1.png", "id": "1269408368421356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_1269408371754689_4211036173785144041_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlIXn2_NPa8Q7kNvwGg4Xmw&_nc_oc=Adrgfh_hfpe-HPrfoddEHW_NoW7uHcpxuZ7n-f9fwYMsZh23chY4421w0qe-98bGsls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0KCGM8S-v8kE5-aoOweFPk63xyAuDQic588AgRDthdNg&oe=69F0B5BE"}, {"file_name": "cap2.png", "id": "1821628131820995", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1821628135154328_6297895040025155073_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no0eSFhyorEQ7kNvwG6N-cS&_nc_oc=AdoaQGvk7A_j-6MT6VX-XGuhJV6HeVfkvq_xKeDHfUfwdN3ZvXSXSWFqtPqL-MASGB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3qT046ijxvQ1L-5PbhDBpegyrAy3IdzZpANiA7IljqlQ&oe=69F0B7E7"}, {"file_name": "cap3.png", "id": "1365128974928645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618937_1365128978261978_5666572695309733802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJrtGUruS24Q7kNvwGN1gUf&_nc_oc=AdrxqmOFpl1GzutqWlxXplik3lVzuGFbuAJG7cmqUvydndBe4yp30gg76onxhDrzzAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ohnAur8z1OU_3i41ayTblEA7b7KU67dxLUHC5U0VBAQ&oe=69F0A6A3"}, {"file_name": "cap4.png", "id": "1639875857014992", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619836_1639875860348325_4677499299977888864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYpuoNPR90cQ7kNvwHTlIXe&_nc_oc=AdpWKxicoCn6DSvy1kdXUm7dMhCguxYMaSDz7SMxkYEkVGj9cj82yFnSgcrX9kJtrSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1x9H8JFpgL5_VXm6mLHFlDtTaPMhTt-y1ueHqiHs3UtQ&oe=69F09CED"}, {"file_name": "cap5.png", "id": "1558284135428920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1558284138762253_1696191126754452963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSBc-NyrKkgQ7kNvwEKBqTz&_nc_oc=AdrIGlGfPZ8_q3OCHVW1gAy1LPUyly0PtymMji94HFoLgBAwUKpW-CAxpJipF5X020s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1sCuVLeRNFVBgUyg3SACTzGwCP--_8nBD2StMEQIuojw&oe=69F0C59D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["peru", "supervivencia", "experiencia", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}, {"images": {"nodes": [{"file_name": "512_512.png", "id": "9631048836974813", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820568_9631048840308146_509837651242745521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqPXQgN4SHQQ7kNvwGlzgEI&_nc_oc=Ado_cXpcyj9xDThShqdUOAvTkn7GY0wxzH4KdW7SOV0FTyP6RCoRn03lkuxrB4x5Kvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0sW25jNIb8Nd4OLU5WPj-IktgCK8DTb3HpsZCaBTLCYw&oe=69F0B696"}, {"file_name": "1440_1440.png", "id": "1616373002704844", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618064_1616373006038177_7924286155699406709_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrBsWIVeuVwQ7kNvwHXlwR3&_nc_oc=AdrKGMdpoGL8_C5hUNs9YsUZV8TS1sJBm8SSq5lzOS3Hz145t3-drL7OAfGb_P4ZWx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af25k9hwtkxLNhw-hgE2GZ-N-52IWbAUPIz1zwKXaKWCdw&oe=69F0A92C"}, {"file_name": "3000_900.png", "id": "1371142624340637", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617729_1371142627673970_44
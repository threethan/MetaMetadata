/499618264_1595011085013077_5178071770855369696_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cRaxcTNqBcQ7kNvwHGg8JE&_nc_oc=AdmKVr_jsosyA9dKTUOJqPFGqRXEnQU8KsB2SeezrHgdSesvUxcrnHRqkRteOcCBy10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxu1mAhSftlwTg_eLX1GywWFnsF_gjvMTuJZPWt6cEiGQ&oe=69B29A59"}, {"file_name": "cap2.png", "id": "2236075723596868", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618254_2236075726930201_2833647435954867231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yL9bd8Y0NQQ7kNvwGqYfs4&_nc_oc=AdmUp2gWAGlQsiYPhXVhOgi3PMsS83EsoBVyAf6johk4nVuOzmINF_5cFviA9NLIszw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvHwWk2xIhlpPLHbCeiTj5XNsduy53MpHvBNespfIe5A&oe=69B29972"}, {"file_name": "cap4.png", "id": "1255611369963759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_1255611373297092_96021354891555384_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3r7jz3mqJsQ7kNvwE-oQd5&_nc_oc=AdmECbOePoXsFJAq7FT2-sdM9QHjAfS0r8zsQJ4nFC96W36bQPVHfoTiXpvVmrkS4WQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyj8NlulzmZ9o88Acc_91spngaaR9jbfiZGoJbW3Vzdyw&oe=69B2B937"}, {"file_name": "cap3.png", "id": "1669991597313701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622334_1669991600647034_8514468019372709132_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkdDQxK3hRQQ7kNvwGokP0q&_nc_oc=Adn-sMiiD9sajuQa8CaFdD-OsO1Yblq4rLfXm3mRMSj6jpDL3GHe1fyu-GDBSuIDxqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFERDvCpZb8MMSiKCKwFROp1ZyKBlFUhinE2LEixN7Cg&oe=69B2B00F"}, {"file_name": "cap5.png", "id": "857406050437499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_857406053770832_3571194828216299378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDVAaZEqlKAQ7kNvwGFdZoF&_nc_oc=Adkf2ZwpPJ228K2gDjIUf2KtjvIFQOBarFAyI59BvTROEIDr4qXNblskCpdK0EJ3ckY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3lG7ttyVLKHS1am0vL0MKbYqNc46vlrUGvheOmxIXuw&oe=69B2B65E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["selva", "exploracion", "peru", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}]}, "developer_name": "Brandkap SAC", "developer_privacy_policy_url": "https://drive.google.com/file/d/1K9y3utpLWAPBkSq9YkS03fR7l6Mpjf5v/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Brandkap SAC", "support_website_url": null, "website_url": "https://brandkap.com/realidad-virtual", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_PE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25947043464984794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618064_1616373006038177_7924286155699406709_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQDkbZBgpskQ7kNvwGcuio_&_nc_oc=AdmHJYG2Eb_bWUwhwCp-gD0rq_G3yM8ytgX4Z1S6HWirgJRQCAYVFlBIBZPcuP9i6Wg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFFy-z6gXiRjDoSpAFuX-M3rM8bi-uACTYc6JYt-aJ1Q&oe=69B2B2AC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Supervivencia en Selva PER\u00da", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id":
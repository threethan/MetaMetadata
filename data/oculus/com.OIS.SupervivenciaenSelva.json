/499618264_1595011085013077_5178071770855369696_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep1Sfd9vX7gQ7kNvwGAoImm&_nc_oc=AdlGTft75NrA0YxldljpkxbsZkGO68tJN9X2t-g-oPB94pdcN57UbddZRRVys0St9JA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvvCZ74RFwjMeK4VP10BdSJVLQKPcTYi7ChX0l85WWCvA&oe=69A80E59"}, {"file_name": "cap2.png", "id": "2236075723596868", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618254_2236075726930201_2833647435954867231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyvNx-lybx4Q7kNvwGpiQwC&_nc_oc=AdnVXk905DHt54MG-pvV0XownY4c8u9OgzbrNJhGJaH556nESlf0fQIFmWhQjaP_oXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCwGCP3OrO6H9lb_yDN0PZrlNb0THHeLkqe41gbqAqvQ&oe=69A80D72"}, {"file_name": "cap4.png", "id": "1255611369963759", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620817_1255611373297092_96021354891555384_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG6hNPpsJwEQ7kNvwGibRP0&_nc_oc=AdmEJ720Tvw6oJAABsJOsWFU6MTYSZKmMopxVxl6VU9XFWNZacC_SbfZKWWrTr20IcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu-m5_nS64-DvkcwsN1uUHY2Xq8WK-zTGleXJn6bT2qkQ&oe=69A82D37"}, {"file_name": "cap3.png", "id": "1669991597313701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622334_1669991600647034_8514468019372709132_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaBOROMoAYwQ7kNvwG85Ge0&_nc_oc=Adng_By_eZpaDBa6M3qJDFGP4MLzUya9Tu_s8SMw-D5kOthgt10WzosryRLlAYAWVRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsWT_bgwi2_Z7LVCAA4rCnr5AMT5hTWsjQN8QpjQEX2fA&oe=69A8240F"}, {"file_name": "cap5.png", "id": "857406050437499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_857406053770832_3571194828216299378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bi2c0_Nj-GcQ7kNvwFbnYU5&_nc_oc=AdnnpYqZc1V6X_Biwwf43usOv7vZ6qta21M9Ix6qPe14_ijpyV7mjq-RIJw98lSbaxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsFqakqxw7lC4BRWq0w14HbMfiG1ouWbvZ7iWCaayhJUA&oe=69A82A5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["selva", "exploracion", "peru", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}]}, "developer_name": "Brandkap SAC", "developer_privacy_policy_url": "https://drive.google.com/file/d/1K9y3utpLWAPBkSq9YkS03fR7l6Mpjf5v/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Brandkap SAC", "support_website_url": null, "website_url": "https://brandkap.com/realidad-virtual", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_PE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25947043464984794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_1616373006038177_7924286155699406709_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUEHRN913RQQ7kNvwH0BRuz&_nc_oc=AdnpFWc_WB0iKg6sylHkSG6fUeoS6V4aYezcNMeqziKdE-H0l6H0eYe9yeel8tbpOuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afspw1njWE4EkCBXh3agPDJuf2JIPRakDbeUQFBpbyy1Fw&oe=69A826AC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Supervivencia en Selva PER\u00da", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id":
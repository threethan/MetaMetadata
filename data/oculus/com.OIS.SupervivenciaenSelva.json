X_sPT7tFQrjA&oe=6A8D8923"}, {"file_name": "cap4.png", "id": "1639875857014992", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619836_1639875860348325_4677499299977888864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rpHVJ7FiYsQ7kNvwEEvDbV&_nc_oc=AdolvFta2-HQhQ8mnGufPLxLhh4HwClqkSl4c_n4Reg8nJcWeJrg-5ECZywSzwOnSEo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZD9J6shrIdoayWj5xivt_lJ1PdVdsFWSOQrqWIpRdBA&oe=6A8D7F6D"}, {"file_name": "cap5.png", "id": "1558284135428920", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619518_1558284138762253_1696191126754452963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9uMe0pOTEAQ7kNvwFVZrAB&_nc_oc=AdrwceqBJBdbylNa7wnK8VW39eCUpDuUsHn8nEBhzecqGnUv9RhrbgoOhVi7ADfliwA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfGoiKuv5p_VOV1eoOVKG9iWVLYFEkeAXdFTL8vWhPoQ&oe=6A8D6FDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["peru", "supervivencia", "experiencia", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}, {"images": {"nodes": [{"file_name": "512_512.png", "id": "9631048836974813", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820568_9631048840308146_509837651242745521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOgo92kb6acQ7kNvwH4jpeU&_nc_oc=AdpeOtcnqHmVak1hJ7xLx_p2zOutvKD8PbKXgXnTyElzFNdgrGhwidz8H_PIv-sHgaw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQDrO2LUf9PAW0_AQwJn0dQHeEVaa_TARveDzi4tLXng&oe=6A8D9916"}, {"file_name": "1440_1440.png", "id": "1616373002704844", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618064_1616373006038177_7924286155699406709_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTYwCsHRcIIQ7kNvwEcmlKs&_nc_oc=Adppp3J3y4lrD8B7jEgf2KeeUq7aWDHtWBZMd9b69yTpqTwHcs4zXAT-sy2B_xGJOyM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt-FaEZDuxoyhZdZINxY5z93VIVQbR1omgjM38rPHntg&o
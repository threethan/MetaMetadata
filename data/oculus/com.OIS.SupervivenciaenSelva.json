wFH7Qw&oe=6AA3F2A3"}, {"file_name": "cap4.png", "id": "1639875857014992", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619836_1639875860348325_4677499299977888864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGQU1DdXo-IQ7kNvwFSdhBY&_nc_oc=AdrxFgclaWXN8fvAcQoIP3YZvqmam-rlt_UVRGvQwzUm6U-GitJiyIoClz0eX6xUAQc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq5aYB44WeNk6go8_HgNstKnQr7UPiM7HW6I67eJjGAg&oe=6AA4212D"}, {"file_name": "cap5.png", "id": "1558284135428920", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619518_1558284138762253_1696191126754452963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPa19uIyDaUQ7kNvwHzh1mc&_nc_oc=AdrPX2qps1G6Cmn_OpcveyeR5bk8dB5wYPAGqG4xjlINQ-vcwGLPH6j0mVRritjz7HM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuFnaogz31JYT80aYsChFVBqDEg3u7vJMds67TZC6O9w&oe=6AA4119D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["peru", "supervivencia", "experiencia", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}, {"images": {"nodes": [{"file_name": "512_512.png", "id": "9631048836974813", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820568_9631048840308146_509837651242745521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W1PkQbpVekQ7kNvwGUbavp&_nc_oc=AdpGWbXLTVTKHSSy_bk4Fx0uDjzpOo_cPEBxBwIaox8KY3QJvtHCoPaRxN2Ahow34-I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeyXjW3PKlx0zae-yTJq7NApmtZ-RtnCIjDvYwLDpSxw&oe=6AA40296"}, {"file_name": "1440_1440.png", "id": "1616373002704844", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618064_1616373006038177_7924286155699406709_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHhvob0hm3YQ7kNvwFNLOAG&_nc_oc=AdqPF07BdVxIF5qimivOw1HoSFN_6tkzDpN7iO5-8u5sB7_ZYo7XC_YvSIJQf43sZ3o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLso44frLFFydAX_OqbYMdwedivXUXuT-Wu-q5rdRdGA&oe=6AA3F52C
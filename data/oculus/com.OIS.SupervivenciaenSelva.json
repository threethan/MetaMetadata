0a&_nc_ohc=iz1vVevCd_cQ7kNvwHkgJJ4&_nc_oc=Adrnz4g2cZOndNrZVxXEiQEfH0Pokxmal3xYwFw1Ypp4T_Ery1blEG_FdgG09ZajLLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRiNCuu5v6ZjUXY3z8pazaXO0Kk7qJPFguMgFhm8c_7g&oe=6AFDD0CF"}, {"file_name": "cap5.png", "id": "857406050437499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_857406053770832_3571194828216299378_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQT7n2C38UUQ7kNvwFuRY2h&_nc_oc=AdqxPzJCfGVFLrSfDp-ONM3Qvx8bnmhVOLaNmigmrliud8ppMuvhaDblQ0iKc_1mVGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpyzhF7W9L29SarLRgAmcUWoQ7SzI2gRO0BGKCdzlzvw&oe=6AFDD71E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["selva", "exploracion", "peru", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}]}, "developer_name": "Brandkap SAC", "developer_privacy_policy_url": "https://drive.google.com/file/d/1K9y3utpLWAPBkSq9YkS03fR7l6Mpjf5v/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Brandkap SAC", "support_website_url": null, "website_url": "https://brandkap.com/realidad-virtual", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_PE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25947043464984794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618064_1616373
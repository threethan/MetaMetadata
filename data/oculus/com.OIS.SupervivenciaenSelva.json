e=6A39383E"}, {"file_name": "cap2.png", "id": "1821628131820995", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618512_1821628135154328_6297895040025155073_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jnO5NHbSg8Q7kNvwG-tMXe&_nc_oc=Adoun4CBoITwK2iygrVjq2wVHtlxo2zeTgLkrYG3yd2Bjb2weIk0kHPZRWsFrYgRDrw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DTiBZcCHCzHn6LzNdB3b0OtDeqDVcCNZTkPUiNdYjxg&oe=6A393A67"}, {"file_name": "cap3.png", "id": "1365128974928645", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618937_1365128978261978_5666572695309733802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EVxJagugM0Q7kNvwFNGf8V&_nc_oc=AdovZbX9jhHp-0H29-8brzkVmNZT2deI8_EWno-PETJy-oYXxbI6He4Yp7hdd_lkJ3w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84iqJMFPh4knK7FFnSlmzHqvUCHmoFEvoYmoizzFgr1A&oe=6A396163"}, {"file_name": "cap4.png", "id": "1639875857014992", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619836_1639875860348325_4677499299977888864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4hlbquyWBoQ7kNvwHmrSlg&_nc_oc=AdocwaUW54v_8K-5BH9Rdm8_jwOGTOSKhuWiEpEWYRzBwF2f4xHCsW22p893yow0npE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7XzVabswbcS-vSpFb7XoCQkfaEVNtl6WJmZHeKq0KtA&oe=6A3957AD"}, {"file_name": "cap5.png", "id": "1558284135428920", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619518_1558284138762253_1696191126754452963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZaD2ON_HCEQ7kNvwE5aQbs&_nc_oc=Ado_6kqE3lRRM5Vc_cuznkV_hj9vuNX3xUBMkl0LU7oZpgW5wnPmQ7kXxBUdo10WFpA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MvXhfUlql3bl_ZM45cKjWiilGpcTfsHFSe4Z21cBYvg&oe=6A39481D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["peru", "supervivencia", "experiencia", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}, {"images": {"nodes": [{"file_name": "512_512.png", "id": "9631048836974813", "image_type": "APP_IMG_ICO
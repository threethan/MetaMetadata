oZHH0mPUj3hEr-tkSfEJeI0Am6oba177Eqa4laBknk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftz91F6CuaFEA-H8Jw96o_E9WRcK4UHn_yi-7jPmpOIbA&oe=69A02559"}, {"file_name": "cap2.png", "id": "2236075723596868", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_2236075726930201_2833647435954867231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_AsTJwqc7gQ7kNvwFU9yCi&_nc_oc=AdmyxaUeEqF37eEt9heNRTiIKiL1Y1NGmMR9aurAQgV-yJb7rzoxpJUpecKDmeAm2rQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aful4szErQ6J_wta5ranIpJd-97LvtKErftIZ54wn_B3CA&oe=69A05CB2"}, {"file_name": "cap4.png", "id": "1255611369963759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_1255611373297092_96021354891555384_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odv3FDm34GcQ7kNvwFTFNP6&_nc_oc=AdlNKk0_5RNESuxj0WuM5IsTcdP1Zqkduh15Wvfb2g2WqP2RoMcy-1xACe0wXpPCN6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-HBol_zbkEJVB2atVM0iAMAXNo3FemMCyy_2e5NJpZA&oe=69A04437"}, {"file_name": "cap3.png", "id": "1669991597313701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1669991600647034_8514468019372709132_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVKiTayYzjkQ7kNvwHJ8Iku&_nc_oc=Adkb13YA_TNi4gY5TWB3urSAVK8tT7HuATxU0HVrX37ONvwsare7b-sb4oyH7fxIoAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftadr9n6-k0sxZY0i2KrLrw3CzGxNBQJCUjN5wEcOb0mQ&oe=69A03B0F"}, {"file_name": "cap5.png", "id": "857406050437499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_857406053770832_3571194828216299378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG2_8XSIixoQ7kNvwFvdIZQ&_nc_oc=Adka7_6z6iCzvYybcCmaNRQ8SAxNMmuRABN6tE-YGZLyjau86zMvUTEZI4wNTtPQjow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHLHs7Cqwrw3jToJk6n5ASmfTgzjA8xq6G-6jdMSXZGg&oe=69A0415E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["selva", "exploracion", "peru", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}]}, "developer_name": "Brand
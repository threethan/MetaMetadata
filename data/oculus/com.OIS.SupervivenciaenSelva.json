bHFf_A&oe=6A22F7E3"}, {"file_name": "cap4.png", "id": "1639875857014992", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619836_1639875860348325_4677499299977888864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28ady2hCTzsQ7kNvwFQF6nR&_nc_oc=AdrUVd4YsOMgv98HO5fxGN86hEdYJ5-NebD-L3_raUjlmRVnjXY6AmTpS92JxtuP9qk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t_2RqF_96KlEzd3d9HGrQeFEZyTD4in7sRe2cpvoNTw&oe=6A22EE2D"}, {"file_name": "cap5.png", "id": "1558284135428920", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619518_1558284138762253_1696191126754452963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzNpqR4q-7IQ7kNvwF8OXhq&_nc_oc=AdrLhKYj8vsBw8RmXJa2KX-ok_zI_btwPmqTaQDtK2dZ-juxNFxhuXkBOacwgg01x2I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DyQNUGx87GZOXAFxyl8cQypORAtboROxstWxB6Wrj5A&oe=6A22DE9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supervivencia en Selva PER\u00da", "keywords": ["peru", "supervivencia", "experiencia", "inmersion"], "long_description": "Este simulador de supervivencia en la selva propone una experiencia inmersiva que gu\u00eda al usuario a trav\u00e9s de distintas etapas dise\u00f1adas para comprender y enfrentar un entorno natural complejo y desafiante. La experiencia se estructura en tres momentos que se complementan entre s\u00ed, integrando narrativa, exploraci\u00f3n y objetivos pr\u00e1cticos.\n\nEn una primera etapa, el usuario es introducido al contexto general de la supervivencia mediante una secuencia narrativa que establece el ambiente, el ritmo del entorno y las condiciones a las que debe adaptarse un superviviente. Esta introducci\u00f3n permite comprender la importancia de la observaci\u00f3n, la planificaci\u00f3n y la adaptaci\u00f3n al medio.\n\nPosteriormente, la experiencia se centra en la exploraci\u00f3n del entorno, permitiendo al usuario familiarizarse con elementos caracter\u00edsticos de la selva. A trav\u00e9s de la observaci\u00f3n y el reconocimiento del espacio, se refuerza la relaci\u00f3n entre el entorno natural y las decisiones necesarias para sobrevivir en \u00e9l.\n\nFinalmente, el simulador presenta un desaf\u00edo de exploraci\u00f3n que invita al usuario a recorrer la selva en busca de un refugio previamente instalado. Este segmento pone en pr\u00e1ctica las habilidades adquiridas, fomentando la orientaci\u00f3n, la atenci\u00f3n al entorno y la toma de decisiones, cerrando la experiencia de manera coherente y envolvente.", "short_description": "Este simulador de supervivencia en la selva ofrece una experiencia inmersiva dividida en tres momentos clave. A trav\u00e9s de una introducci\u00f3n narrativa, el usuario se adentra en la din\u00e1mica de la supervivencia, explora el entorno natural y sus habitantes, y finalmente enfrenta un desaf\u00edo de exploraci\u00f3n orientado a encontrar un refugio oculto. La experiencia combina observaci\u00f3n, exploraci\u00f3n y toma de decisiones en un entorno exigente."}, {"images": {"nodes": [{"file_name": "512_512.png", "id": "9631048836974813", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820568_9631048840308146_509837651242745521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc24F-gCiisQ7kNvwHUCR-b&_nc_oc=Ado8e7HT7wwZzu6fbV2Ew6UYZJZXprIrKqZYts3_zDAaQfQwmHG5cIXe3u2v97NrSW4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6EnhY1bcxPi3Ak57SWy4jeuKNtGXrtZsO57oBumjk_A&oe=6A22CF96"}, {"file_name": "1440_1440.png", "id": "1616373002704844", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618064_1616373006038177_7924286155699406709_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_W6kesHvl_IQ7kNvwH7ORu0&_nc_oc=AdrXN4Bb9A7SJUMNWR8wgcEWbrvV77AW64QOHsTnEIi13-4N2bjzZq0UVdu78IkKfV4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85OWwvcoMoNsqUALH73AHf-Q8RBARltERWEP3sWtLjbw&oe=6A22FA6C
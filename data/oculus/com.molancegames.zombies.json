906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2L-DfoXpjAQ7kNvwHOBV2b&_nc_oc=AdplQrjHfbRfNQBP32oHJjL-CgC_2SxtVvDP6xqaVbu0OL_hj1UYf6lAdslBivgAKcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtF2CsOSjv2wNVaoDHWx3hqXd1EQFbVN-aU-KrZMmG6g&oe=6AE8A332"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SRo7hPjoMkQ7kNvwG3fSr7&_nc_oc=AdroIu5MMixpEjPGNeoJTokFVhkuTvVnRcuraNhhIH6IUP5gg2Mzi2NGIklRJv8c4zg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTQQmPd_3PuJV5nAMMm5gttuH3gbm5QFrp8PIFTv9RSQ&oe=6AE896F2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAUczg92wqEQ7kNvwHpx-di&_nc_oc=Adqg6eB8HI55B4pGQyN5oVhrD1KjDvMJq1H6a55RScN85ie3GR-_Tn9neBHwxnh2GlE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaxvLipYOfCp396YZrdpXbhWGPZo73_zhdBih7XZkfqA&oe=6AE8AFCF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLjsr4nqY7gQ7kNvwG5spTI&_nc_oc=AdofM4iuGeSlzsmyTKrxgedgP5hq-CieVeDUwZmuUm-QVjt5ibYvdIvUWnASxneDPkY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRai4R3tkP3JcMcaCGNCP1algdOBDqmuZ55fIzwwf4HGg&oe=6AE8B477"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU-I3RD128UQ7kNvwFjYppI&_nc_oc=Adp3uwFgySWyIrf6IFNGZOkzYsXKFXublhXn1WpCJvkzbAQgPagbYZwqiE3kTJoMaNw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrkkt6QTspS0q574ri-S2aHTNu-dq7pqXBROG3wlPLQw&oe=6AE88FAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NKMZSdXHCEQ7kNvwGZAOFD&_nc_oc=Adq3SFZkiEnVSf-mrJJi2Wg_6oB-7dLZBIv5J3zK80Bt4x0qVU55k-oTnVjwenZQZAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXvTOvfdU0KgnaWTg3DAKryu2LLDfwaWpBxX-xm4VHeA&oe=6AD38B32"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3VPazNV3_4Q7kNvwHeEH3R&_nc_oc=AdrTw2L2RXoL_GXA5N-bG_hA3bofPDMXZH_c8MEG8iFqlVBDbUvASO2ty5a3rsXxcV4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSVgeXczIDLALI1wqtKNJrA1EWm83JsZlmbURWlJDUww&oe=6AD3B732"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okLuNOEqXEsQ7kNvwHYppHw&_nc_oc=Adq4fKSoczifgGAxT9agygvuvCb_bwTjffqlbqpVxvSnrRIAxI-s3q8ijruXdFMa5uA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXx8Ffu3lEt2EQp9n5Ueyau1PWJqnXrGaoBf-Yv1iyOQ&oe=6AD397CF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qvUPpZFjA4Q7kNvwGkTomq&_nc_oc=Adqp8ZOgyjKCbY4MAJWFL8aREPsMrVhRJz63-fYrd3aEL2Eo7ncwdl5BNetG1dAXhUg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqyuWTgWdW2ARK3Nr1zoxi_qjDZmgKfzEWRXduzfzE-g&oe=6AD39C77"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfmUTtlhB34Q7kNvwE3pTH8&_nc_oc=Adr3x1PtbPXdhvinGAnv3-Hsqn7qiokLiMz_9FYoBeRYaJL50QakjmFvKF42TtqRx-E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfXL_irsXOJia4jtIRXmqNkGusaIbYTDMSzPGhTw17hQ&oe=6AD3AFEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
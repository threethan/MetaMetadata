906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_HLDNgJTD4Q7kNvwGPvGTk&_nc_oc=AdoTKdV3mIRTfXK4Dc1_rLOKihd6zc1zZQX5APu7lgH2E0fbDR2lnF9d87eHPdoGzes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZwMS-lg0GTO1QbTyh802hCBPIL8AqLQq6Dp_WSWnpxw&oe=6ADE1732"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhhZXzun2XsQ7kNvwEHL2oY&_nc_oc=AdrDvhd2wirmRJWzJa8kwTK-EUSow_Ei8UZ8Z8ZKyV0lIgWWK1y0FxdbBz__B2AcWXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcKSzBQiTvoaaTonCldmbqKdKW9cxMuTYyELKMqXkhug&oe=6ADE0AF2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_xWqQXUMbEQ7kNvwGMTM1O&_nc_oc=Adq8EPt75Azhe7PKJAto8Z1pu8M8pmjFbqEciVi9fpR02HBnwPUpc0WZrFYFM444IPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfTyEwRNkjqnCRZiWLyk2-Y2SZmgdgieoaPyAoED2xeA&oe=6ADE23CF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlU3rgkz_oYQ7kNvwF2UWVO&_nc_oc=AdqgRtr9U-2e3DjvUwfN9oAPqm_iG8FPSo5-kb65AzaoL6xSWJHXHzDTb_ABq5y5L2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgSWe25gBqrjeRjURszsi5rJaRuGhiBYcUwS7MHP75rA&oe=6ADDF037"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzfUVV0OlEIQ7kNvwFwTFmX&_nc_oc=Adq-cK_GzZ67pLx1GPkoBfwXHDB1-Day7zhVN-Xw75-44JsH9wi9by74acfdClQF4wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk59Pmp3zMMNIjGPh0G31cMRy6BoCLItT6rPg07TGyYg&oe=6ADE03AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
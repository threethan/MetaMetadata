d0MhlOCuQ9Es_X8oT0jhziX0RNyJxKHrEPn0ds8u1cQm-U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGLNYAc9090B2vcg8ICK0XGwefk5mBEsvt5L1lZNxQ_g&oe=6AC8FF32"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR0-DnwI27EQ7kNvwHewse1&_nc_oc=AdoTzjU_tRAEm7djeoh9LimRsVqzOre_WncXGMktXpg4B-u73RfykwA7xIzERibNteM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3j2HxwnxYpFq9MFXqI2GDrLMWEahU5KEalHvZ56cGWw&oe=6AC8F2F2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14TG5b1U_SEQ7kNvwFITtlr&_nc_oc=AdoMFpWjKRAYAvrZXn6LijlBrIAiu5tjZAWKrw05ykW7vBRfSFDo7WW_1uYMzgl7o80&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLEigobByAKIrD5yZI_DId3q2DwsBpHocpsXu2VVburg&oe=6AC90BCF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIMdGCuBHG0Q7kNvwEc0LDA&_nc_oc=AdqwC57H_DEALyHSryJBD0ghMvDjRQRtAVTnfN3woPaNXgzqcPevhdkJrVVIhocm1Vk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf1g62AARhzFePndegUqcXVSkoawAouy3Yeb1O563CgA&oe=6AC91077"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLI89onYmjUQ7kNvwEMw8nZ&_nc_oc=AdpmzXhDC8jYcIM6hMFXGCTxf8_GSH352agDsI3SVFwu0ejVDfKeg59pCoNGl9M7bTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0rt-jU2eryIlAL6A4qTQJKW2IlDbQl-Jn__CTJ5ItKg&oe=6AC8EBAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
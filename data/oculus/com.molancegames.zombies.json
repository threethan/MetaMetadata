vSk8yL9pBRVROIiywISR3_qKHqDVePBA&oe=6A355732"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg5SpViEC5gQ7kNvwHrlkiQ&_nc_oc=AdqOuOFrZ4JUqHc8F-LtzUg2SMzMM0fwxCvYTsBMXhc2_DtwjKhEOc4jOZvnVkvXYQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Uqfg3n8F4Itz6haHZOx3lfRy5ncSEgWIs-PSEslSyRg&oe=6A354AF2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTaLUOvh28cQ7kNvwFnJo9u&_nc_oc=AdoI_6s9Y_Xz3IDVy7mrX5uH-8r7REIgoIDYTMA_3aipsxMU2XLvQdAAIO4lk61qPx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vbeWs6JlKJzIHHIIPIpDVnO1ZqvQHxqRUNrMjzJyKRw&oe=6A3563CF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqNGE56DReEQ7kNvwHAKd9Z&_nc_oc=AdrtvxscplQ5OgDxbu_hPBIrCep79tgMKeUdHF54Ux0Mjl8opubRfCgMsEXgMMD6CIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z95v53RuGOxuKf79yu73Knk4e_ie7rpZP-9FvwZ0-Ug&oe=6A356877"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHKPbxPhvTUQ7kNvwEz9aH-&_nc_oc=AdpNcRbMaOXv-Swv15sqYuKr7Z0CDZ6CeGHxdaWrk-w3O4JIrTgtE8d0ckqUdodkrrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jOTd_SCTUEYzePsOvxaVeAu_6Mv3bqjiyRAdji9p7_A&oe=6A3543AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_s
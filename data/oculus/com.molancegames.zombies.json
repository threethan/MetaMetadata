LpPbZAL82e5f4VPq1dP2ABxvYpc474KA&oe=6A4FB532"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnqqrgiEtpEQ7kNvwGdZAVl&_nc_oc=AdrTnjgQ_K-6-NlGsyYRwLee3C7VkI7KQjsGEoiPl5d36F-_Z8aasgsq3-ZOcL8oVSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF6ezcqwdpEtJj6-IGoJCNn8YALDFYM0gGII-sk0eDCg&oe=6A4FA8F2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaPUhe_l2_IQ7kNvwFqlM80&_nc_oc=AdpLAnSRtq_tEh6sPauOOxjZ1jKFND2s7eiJ1SrO29MOVFem9dVnOrsYBIL2eooIRhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGMGvrdjK_1sGDZxGCz0bNG900KdU-FX1SCWG7vEH36A&oe=6A4FC1CF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFF1mlPc0C0Q7kNvwFNNerw&_nc_oc=Adp7W-SriP-BNXV2KXvRjzXNu_yLFA_H5A7b0HtvmORdcQYVavDYgBBX22WgspJLHjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhwDH95k2J8Cwzmy7DZztBXgtHq37ZhRxf1o9zofWboA&oe=6A4F8E37"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8B1xIrVab0Q7kNvwHX8FPD&_nc_oc=AdpwOArIDySXnGsG1taA9GKv3zUCXM_FnCgw09pmJYvD5j2le6l-XmIcZRY2xLWSigg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMUGovFsb145exDzK4UnOt6C4436CYaWGqmt-aEenHNg&oe=6A4FA1AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_s
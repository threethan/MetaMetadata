906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQDKniJyFOoQ7kNvwEgUrzF&_nc_oc=AdpgITXb5HHO0Zkz2W4QPW9YMyAp-zimNOcHfGU886mczmfF7-3s1kP8U5DLz22Q7aA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkJUgdyW1VpFGi5pi1Std8YdLpL_nAZfosbhGCkKhiYg&oe=6AEF3AB2"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBroXWe4RacQ7kNvwFTcKTe&_nc_oc=Adp8HdzmRleMoIICRW1Qb5Wm7tMzGwqtlblpTDTGX4pj4h4sQqoe2UK1oRui1BNl-Tw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPausgEFdR4ZU7jsvk2Rh2Xu7g_4Om-9cIhUwj_HiE3A&oe=6AEF66B2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W28Nkm0PaVAQ7kNvwEbMRpA&_nc_oc=AdqVTuFZhaMYa9XSgBTynekhcioAaJB87yGcVkkDMFyRnwl4wLQEaxjNMp19HUW51BA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiQk2AMKH1cqgqiHXjbUWuK6ZQjtlBHhnn1SzKrDxMWQ&oe=6AEF474F"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYmYWvzkBXEQ7kNvwGWLRu0&_nc_oc=AdptVuxDXeS3X_s0k8joId2HU-e0CeqwvRnSzuWR89MlkYoQp4E4xYNgjIG2ZQdUIPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSmjFiuCRfqb95k_Agm4p1fhCwi7RhsRvVB7aXVGyUOA&oe=6AEF4BF7"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKHrqYjDYJIQ7kNvwETVRLN&_nc_oc=AdoC7MRBqbCmjBnGm-lVwW8rNZEjK7cfM4FqpVfLdNhdojpbV8AwvNKUpVCuJ_nhZAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGWD1FApEbDYPJyCmJ_H91s4u8FKcVBL1Q8Y8saSPQRQ&oe=6AEF5F6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
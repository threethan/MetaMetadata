MRKQhOQbJwr4GmvqPCSEIy-R9WuU9G-g&oe=6A9ADAB2"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4_eYwRpoOIQ7kNvwH-7LE_&_nc_oc=AdoBai95nqzEgQO1EukRdq2jKICfUPtvr4NY_w9ie87AnWKfOkSDzujkna8d-6e_pL8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiM7IfFV76SKKzl_ci2onqrkoI-dkOHQkK4Uj4owtEMw&oe=6A9ACE72"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBpz5YSor2oQ7kNvwFdkbku&_nc_oc=AdpF2uwcujKU9Sd3MnsBgc9VJP-hVkiyv9bmaEyrPNyq02O7kWJmNQYPU6vul-_lxk4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfrsudDHf3GhnZoQSqetjQWRSw87Gy4IFeZlFPcbqzKg&oe=6A9AE74F"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-Np9ivg2HgQ7kNvwFiZWrA&_nc_oc=AdoOuShT82y1-RdhIKLYU07cSwenSW8vEq778dvRcNWetKP6lZ4LVpGvDQYgtRO39qQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5iGhiltIIhZWiEAVP4W-GM84Xi3035n3x-yjVryy-cQ&oe=6A9AEBF7"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsUIaFbctREQ7kNvwE8djVq&_nc_oc=AdrSSrRwgjeWvowtOhMvKoixXgvNU84EeuZhJ4_7ocVpxvPzlmgf_S7PZtIrQ4ebUwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgCnlhm-K2qrckgy0WKH9UL5FrqVisY-ELjZNkh0Th6w&oe=6A9AC72A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_s
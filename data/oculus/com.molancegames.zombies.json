xzYiuQNGLT9GyVm_893ZMpBhufynoQqQ&oe=6A53A9B2"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7IhuraugkwQ7kNvwGQe7ap&_nc_oc=AdqEj3ApLi2KBHx-lYr6HUzEpv9OLDRatwq_rOWdsB9xX-D6zANbTAut8T1FgJKumjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbMQeL79OTAXj2Cbv51GCelNJ9mh9JLwxXfWWHGRx1JA&oe=6A539D72"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE4NjFDvRbMQ7kNvwEeZhgh&_nc_oc=AdqLj-ZlDIW5KIoJwsIFY0nOD3FBmiS0cWQxWl7dzHMaIxeYoKWfQBXsZi3KNrd3woU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcme7dCJVUvMiPH4A2oiaopP9DCkxsTCy1cPm9V_HI3Q&oe=6A537E0F"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0uMmBIQ9BQQ7kNvwF_WUWj&_nc_oc=AdqGh0pLmYisYtcsf_sKDBt29g6k7kTy1HtD9nOCsQPqFzhy9z1gpeuO8REtSuFOS6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPNcPqsbjzNrmbYcEZIovkbyP-RKMlFMMkmlvdcPDfYg&oe=6A5382B7"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHa5jxjkTTYQ7kNvwFssocI&_nc_oc=Adoohhw4raqIOibk23BzlJRkZ2zZE8LwFVzX-3GxnfdV8fam-xYIcLzhlSFCtoHxAEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm44KM-XOLxxs7_4h4g0hS9XqGp39W5xN7sOMyAyTg_A&oe=6A53962A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_s
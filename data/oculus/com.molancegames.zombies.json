vD6wsOQSzF-V38OCu2ecBV3zcAVyx8QIikCjpsiAJ8OS_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGZnBDG8ZN6QEWUxZwQYoBfIYZmR2VPifAw6mhELry4Q&oe=6AC267B2"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJmhnVJalaUQ7kNvwGHJLMK&_nc_oc=AdoTZ4qniDQ-_9bL-uxeFscbuIRbsJr3I2ZZcT3FAeXxKMIxHdUXSg3jDoAzYTm42L0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnJ2aM1P4ZKhjOSxrdEYEpTI_ImvZnUXGJ3Vl6zSh2SQ&oe=6AC25B72"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjCqmelkWfUQ7kNvwFR28HE&_nc_oc=Adqf6bDVodIhHlwnca7N4UuNADoP__OIIGQibGz0B7youHERWq3j6-mYuw3yLzE2ijc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD2e43NxzWnsLzc6fg-UGUyyA6OsSWKMRtqre5uyMXXw&oe=6AC2744F"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T94L7f3yHUYQ7kNvwHn_Yyi&_nc_oc=AdpHRoQ7f8oYFSb6lnRHBXbYi2S93gYHY1GFyI_VZ8TKRgbttdZvR-sQcfQ33u-jxt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMszPYgHA5wRPKUISKEHH5RiJ6JAEJ86Ebwe2cFAg8qvg&oe=6AC278F7"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG0I66_UKjMQ7kNvwGhbOWx&_nc_oc=Adpfs5wUIAXUCUGChhwMR578TZ3F2zpf_9rZuFvgbfAJT4UtJZTMNX1njas14_EnQ70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8NTMLty_gPV4K02X0V2ADq-JfYhCthZhext15hUIlcg&oe=6AC2542A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
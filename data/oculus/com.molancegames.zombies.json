906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC5AssKPDQUQ7kNvwF3E2uw&_nc_oc=AdopyM1qMp9mMYiuEBy9r380A-Hu_4QFQAe8FBIjEIJVBnTMP1fkiRa9rBJeFN0eijo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBsFTTu5bVK9PfSL7ZJg5tb2mpbCKYdDMckqtFw164Yw&oe=6ADF68B2"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ly2D6qp8GkQ7kNvwHQVHv2&_nc_oc=AdphOAhG9MWU94A3JYB4qeMnCWsMk8gUFJqF51HqArLKvky3hUrS0nttJgmfvGMd4-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1pqKFXpiivFax7lH9AhJ6f6tZ4rSUihkKvUN-ndHsgg&oe=6ADF5C72"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_xWqQXUMbEQ7kNvwFIicm1&_nc_oc=Adol0-Mas0VlvWgRppN1z1uDYiUvbprlnRNynaCuhNLr_dzDJSc_IUm_k7PvxT99F_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIZRvvW4eUlUWeBun6Ee_9ukVxRbP6EauAqIkMW63GXQ&oe=6ADF754F"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlU3rgkz_oYQ7kNvwGbIvjs&_nc_oc=Adr289Mp3h4h4C2JMOboxv4iEZJGKe_E1x3elINBhxHbzxlhXafav2sbxHu6Y2-ljCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsFGoV6_A7vF3h3WqeRtD1YDxYTuXlh_QhYemZLrfiuA&oe=6ADF79F7"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzfUVV0OlEIQ7kNvwFkmZp0&_nc_oc=AdpA_Z38drikE69aECoZHntUEje5M7AuzHB2UR6eFknPNSuwcqWvurROncxtBpPJGOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb29K_IXfNC66xYAbO0GjnAzLukZcaTChNsSrDsoAPrQ&oe=6ADF552A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2L-DfoXpjAQ7kNvwGta8qo&_nc_oc=AdpiM9sqAb0QRMdwxvm4pZdzi94BmgBdI-pgxvec02yGSA5EXuoFmD8SwcfigOm4L-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZXoPisTeTdwebJmVhVLebSHdko7GbMUOGfljR7iDg1w&oe=6AE9F4B2"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SRo7hPjoMkQ7kNvwFtTRZT&_nc_oc=AdpopVj1U3IwaNWGDj0H2qEcINlUQ8r-sRQRiV8ke6N-BrfRlui9k9ADRh5e4RdPbDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR_WpT3bfEYs8lUmrtjjcb11PQ7G28P2VqrUzLUHUCqQ&oe=6AE9E872"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAUczg92wqEQ7kNvwEDUtow&_nc_oc=AdqwHdEy9ZhL2czVVrQcUKdP7tXcAa0axbc_lujFJOAc1XDFKlRBH0px2ld8OYFzl0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRtI7E-bIhpVGDdQkGE5usjv6acg-g5X_mNH1lX_2cXQ&oe=6AEA014F"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfls2eD87nIQ7kNvwFQDhue&_nc_oc=Adrp3T_vwhYjfowwdgr1ye1HUiWQhFe7gyEVCz5x8UUUzYir-_bW313Fk4CbUPB04X8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6niECSY9en_c3RznYF-sdn1zLvcSSNsacQCy5bUlwdg&oe=6AEA05F7"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU-I3RD128UQ7kNvwEUFIhN&_nc_oc=AdrusxMTEeOYwi5388JaDfafwd08s4auaA7fsCTOyyXDjNCQTfnM6NIKLGs4-ilcPL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB_hf5gfDqNxT_dVVufvvRSMMiA_we_FogW7IBOx9tGg&oe=6AE9E12A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
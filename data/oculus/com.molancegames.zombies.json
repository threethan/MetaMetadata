pdIr3-e3e1KAsDCkqlgg8NZ-jakFHo6Q&oe=6AA6B832"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltf9iaSEsXcQ7kNvwGO1Xo7&_nc_oc=Adr6jjKN74bB7Z8R8j-2TxntGH0GDvJiO8FnkrcWovbQFyAYTJfgr0z4Nzgf3TLg5Zo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_wL5aPnGfja-NulfuIPlwkpboQerlv-ogIEBJbid3Ig&oe=6AA6ABF2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv99aivT5zsQ7kNvwEDBjd4&_nc_oc=AdrHFzPTnTEd1zYwbxLaz68BjrUBtK3j2npTX1n_bUOl8n4mzUDTG3RTV4xKBW3RKi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmlzwt3o0tcKD2vEyTIdexpQswO7bkcetkSnj6XRavqQ&oe=6AA6C4CF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zte2X-cUMyQQ7kNvwHZn5j2&_nc_oc=AdoWgpoDPASSVIv1k68eCTNA4V9Jfm-0LIC2HMHPkm1e85KqgjZwI0qP5RsfJtEYLqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxXr9UzUGuyNkrBNeks5Q5pM-w3sVKhf_App3UI4NmAQ&oe=6AA6C977"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3yYZZjPRG0Q7kNvwEOO2z3&_nc_oc=AdpgqB8NyEX69KWvx_hzQb0E529im3-JlMLuwxPonwszZdThwo5LSZrMtJvPPqKckVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOpZHA0ARW2vOtmDoJqYf5Fj9IB0dY-wr6WOK7axYWJQ&oe=6AA6A4AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_s
0shNwEHe9T4KF1yLfE8kbdGKxfz72DQpWVtvo8kmlBCa20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-91cYO30mCVyJZAkizw7OsWaHSl7yl19bht8ii4IZ_g&oe=6ACBA232"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_GQmoY3UMIQ7kNvwFIUDhD&_nc_oc=AdptkR8mQ7CyyeWECmqom-epgRQBraaXJyfKsl2RNqvvOnZ6GaBuVy2rfu1FqU-xUME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_xzliRpz6nYctKi459hsCs4-L2e_0sFdHt22dKtdX3A&oe=6ACB95F2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trWxGvjclmUQ7kNvwF1yL6_&_nc_oc=AdqHHYUphi1uBJnizoLRD_8lCSVredn22Tz6pVJOOhC0WTwSDQC_AqvxQ4hUQE9iDC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv9KNPk0xT2Um7fUH08dmnHOdAEyUj_95Qxs4ZEm3Lsw&oe=6ACBAECF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYKuAj4p5psQ7kNvwEidbH7&_nc_oc=AdoULP1x2r9N8VzUROTJ8oyQsCiAOBAbIjMNpnQqTIQMZEQnJ3w7tKvu2gpGuVnlhi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG0PbDSoDmR_aaGyqLY2F2mwv9vXcADQ_KXOmOxZFl_Q&oe=6ACBB377"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLI89onYmjUQ7kNvwGbjL4g&_nc_oc=AdpIf16lkNoPJFkhqpdyGmSicNeg_1gP9J5J9ntqDrL5hJHUlGsTb_eK5_yI7YSPXas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyANp1zX_lUx70YKbIwkQcy1uismWFqHXcj-IUKJ_jKA&oe=6ACB8EAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJDsv-K1HNgQ7kNvwHCiv_G&_nc_oc=AdrYx94iacOLpkmgpYvpaGJwdDu_BZPfI156Wk9XMerrvT9E-EHddTWawtZNs9eL4QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM19E6SmVJiNShLuOeHdN_h3a0E-lo-SLvv9F-bBpXKGA&oe=6ACE4532"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_GQmoY3UMIQ7kNvwGcKxyK&_nc_oc=AdokQF30bVTlfTrdoeN_ZFwAU6MkKyz0XSRTpFx7B5RZ-A2u4llkX0dSf5Qf1vfqTVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdkBuwKAtOMrJKZb7K2rS608oMIcGx9RPTu56BpNW1Yg&oe=6ACE38F2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trWxGvjclmUQ7kNvwHdDVJM&_nc_oc=AdocHMLPrvk6edypM8iPhZmFHN4q6IiF9R02uz9jBXgKIu4hcUjd6cuoQEfZHcxCzcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4qS5SwTcZv1LiAYr_rmGaHyQhK-VRjBlCYcFZg2UOQw&oe=6ACE51CF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJGcECBUEDkQ7kNvwHcGyKm&_nc_oc=AdptpYCHiVIph7cxjv4atmv85aWarXGffzM0hnkC6v_NsbKRjnRqYpb4Z0Az3Zm7A64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgQh_6Xem1AVBbqd1si2DZlWS3FmZQV04Mzj_XULI20w&oe=6ACE5677"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbRlO7V_bDIQ7kNvwEXZgF5&_nc_oc=Adp8o_Q4M3kLPJ6VksCCZfyaKpsGWyp1kMEt8BIooJJ3wwMZuMoCYfdWJz3wAWzFhmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg319DHl2saTvc78MY5QmxgJSZP1ZfayQnxlcmKTHMnA&oe=6ACE69EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Sr3yG6qC0Q7kNvwG3MYXy&_nc_oc=AdrW1CYeVeExgobFP_PWmxB1bxlGXjU-TSPJu2I0cHB2yf_reNeY9yN69TzqhLgx5t8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpsqhxzD0RzOYzrjmlylXqh8f5jRefoHL3XcEE9nZr_Q&oe=6AD0E832"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtfvfHNhpy0Q7kNvwFbAiam&_nc_oc=AdoASjro70zfLA6DjQBaO24J0T2q0M1tgsru_oe78b5edWaihW2Ixrt-6K9ZBUMJuFQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdbw-eb2PdoFjx2igVwGc2OIsqb4qJW19-7pAVUgGTLg&oe=6AD0DBF2"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOSdF8_-LJIQ7kNvwGwmZ-J&_nc_oc=AdpGn5MB2XUPnLCO8K91eql7orEV-KqSkA2EpnQ5LtarDEbTo9AK79vjS4w9CF3khOU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOA8BjsLcuLTQxxMrVHwwbsXj8TbvElzN1HhWF-rQlXg&oe=6AD0F4CF"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJGcECBUEDkQ7kNvwEbax2n&_nc_oc=Adrep__WSgXpBvmWWNz9lB9ZHjOBrM0a-rhAFGG5vOZxdvXF61nmRs8n6J8GQk82Uqs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIIi7olgm1lY5iXvRN9f0bjGDzTq-UmtR3VvNcGE2s7Q&oe=6AD0F977"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfmUTtlhB34Q7kNvwGnLVpT&_nc_oc=AdrRLITcSnUe53ZICt4cEVbCd6FdO7ikjwuuxubiNjIp4abw29_D2y51INLP3Eh_Lcc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkbj4_CHBfYI2vNRiP-ohO99ry1-k2SASGHu1pFOMXvw&oe=6AD0D4AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
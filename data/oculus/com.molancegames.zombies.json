906_840229317181390784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Sr3yG6qC0Q7kNvwHg4wT2&_nc_oc=AdoSnh1iZy8pVNth4mzgNn0AjfCged3KyOxrCBHohR_ZVDpYOehlKPsi0RU22sNhdec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhSGaN4euxAMRsBbYL3En4gDPoEkL_uOo3gavztH60yA&oe=6AD239B2"}, {"file_name": "1.png", "id": "4299448770304785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_4299448773638118_6198794168639950814_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtfvfHNhpy0Q7kNvwHQ16JN&_nc_oc=AdqpR_F54yI-ujaUxirxfRB7x0v6Hs6iDYOxg1SKZyOY1_0tCRj0BvhQ8z-7vT08Ju8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuiUn5_vF5VfczY_N6smqCUavnvVQjc-Eb3Xg-gxQkcA&oe=6AD22D72"}, {"file_name": "23.png", "id": "824209163781058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_824209167114391_7872222521021636363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOSdF8_-LJIQ7kNvwE6VcEG&_nc_oc=AdqOaXKZYGJN24jG26aF2_sHlaHKQZ5GxemFvUtLA5yeaFjdRb9JmI_yWlVlDh76OK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJpuPctZy1F9HY2A070Vq-AFQX_kLk9wr1vg6VtP_W1w&oe=6AD2464F"}, {"file_name": "21.png", "id": "967896346033576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_967896349366909_2954946301595757138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qvUPpZFjA4Q7kNvwG3jSc2&_nc_oc=AdqUthgQKeARWuOMVx5UHcuVl9Z0XpXP399J0AOuE5ZWQxzcAR2Lr2_CrsKdLPfFf9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNitfKUVrnBIz-tKJRvGAJ4hB0ZxAuaBEnHNd7xKC-Lgw&oe=6AD24AF7"}, {"file_name": "3.png", "id": "1531300608639730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_1531300611973063_9058646323360018751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfmUTtlhB34Q7kNvwFJ7P7Y&_nc_oc=Adqv_N93iIEdB9jfbnXdjDGQroyiqTHSQq9AuHBv86nzoLmKZKm5u4q0zuTJBS22GEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcHhxim9SIashMCuTQYD-LpF8J5IQMW4mnL35DiYuUog&oe=6AD2262A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombies", "keywords": ["zombie", "shooter", "undead", "ragdoll", "shoot"], "long_description": "Step into a zombie sandbox shooter where physics-driven gameplay, a full-body controller system, and stylized action come together. Experiment freely with a wide variety of weapons as zombies react dynamically, lose limbs, crawl, and collapse in chaotic, physics-based encounters.\n{1274756444826142}\nPlayers can physically grab, aim, reload, and swap weapons with intuitive motion controls, creating a realistic firefight experience that feels natural and engaging. Enjoy precise two-handed rifle support with smooth recoil feedback and interactive magazine mechanics.\n{1639174897351635}\nEnemies are fully ragdolled and react dynamically to damage. Shoot off limbs and watch zombies adapt. Losing legs forces them to crawl. Instead of realistic horror, the game embraces a stylized, exaggerated visual style with non-realistic blood effects designed to keep the experience fun and accessible rather than disturbing.\n\nBuilt as a sandbox, the game encourages experimentation. Test different weapons, and explore how enemies respond to physics-driven destruction. Every encounter becomes a small simulation where movement, impact, and environment all matter.\n\nThis gamefocuses on replayability, physical interaction, and satisfying VR feedback loops.\n\n", "short_description": "A zombie shooter sandbox featuring ragdoll physics, a full-body VR controller, modular weapon support, and stylized combat effects. Experiment with a wide range of weapons while enemies react dynamically, lose limbs, crawl, and collapse in a fun way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "co
-7&_nc_sid=6e7a0a&_nc_ohc=0HjjQtj2k4kQ7kNvwGE0nRL&_nc_oc=Ado1nwj_Vc0Nna4wCp2EKMTvRL7AchujKgOceTMEj-TxCUUc_PImCYK3v1HTxLgdNnE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDAlmGR4YsuDm7nvHtQ1YrngNRI6DjjWeabXmxbiD7Hw&oe=6B0B3CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RascalsForever1_Screenshot4.png", "id": "381278967729340", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_381278971062673_2785525287751613515_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOfsNt2PsgYQ7kNvwED0wg6&_nc_oc=AdoesKayM_57rKIoPH17srOKpdsY5YE6moS49bCi9ngekGracY44PJL-LVtmOPCc4pI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2UXyjQW9a3qrT3yBNjT7Y7mGNSX1CqRZ6snfWEugSjg&oe=6B0B277B"}, "display_name": "Rascals Forever", "keywords": ["strategy", "turnbased", "mixedreality", "boardgame", "cute"], "long_description": "Welcome to Rascals Forever, the board game that comes alive in your game room, the board game that lets you take first person control of your pieces to play dirty tricks on the opposition.\n\nTry different game modes and a wide array of power-ups, ranging from rocks and guns, through explosive bananas and dynamite, to whale attacks and insidious arrows that keep hurting your victim until they can afford to remove it. The Rascals themselves are both cute and creepy, lovingly crafted from exotic wood in a world of marble and granite.\n\nYou can battle against a varied bunch of AI personalities, with different skill sets and tactical preferences setting their play styles apart.\nThere\u2019s a single player career mode with 60 missions, custom games, hot seat multiplayer support, R/C toys and other distractions for when someone else is taking their turn.", "short_description": "Welcome to Rascals Forever, the board game that comes alive in your game room and where you take first person control of your pieces to play dirty tricks on the opposition.\nPlay different game modes and use a wide array of power-ups. The Rascals themselves are both cute and creepy, lovingly crafted from exotic wood in a world of marble and granite.\nYou can battle against a varied bunch of AI personalities, with different skill sets and tactical preferences setting their play styles apart."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ninjawhalestudios.com/rascalsforever_privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ninja Whale Studios", "support_website_url": null, "website_url": "https://ninjawhalestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7937210099720795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86625023_1446097435939536_2786468173385046142_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39JZFQ_iyCwQ7kNvwHf5MSS&_nc_oc=Adpc4Irh4WXE9uUIniJ0fr8Oe1uzyzB06uxPxqDyys4HFJmjSEM2PqvWq3Da93W4wUI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRes_LUPzxI8Ab2E3wpOKPke5Hx_6lOEwoMbKCYj0KXsw&oe=6B0B42B5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rascals Forever", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
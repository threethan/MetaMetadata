HbcX5pQB92fyKDJ4Luq7EbigT0SESFMoeUxbSQRYDJly-Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_1sjRf1Qror6Kc3K6zg5YWUloJHdoimKRRp8YJRABIA&oe=6AFB2602"}, {"file_name": "RascalsForever1_Screenshot3.png", "id": "734164851572753", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75429286_734164854906086_3626147000110107241_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ba-T3S3IFB8Q7kNvwHAIbFO&_nc_oc=AdpOqUyYeohhYa6JOMqJTt7HKEVg3J69AniMIKdms4QvW9EdMUBRvLcAby72V5Xt-aU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQEo-AfW48qPim1lSUoP3Wv2z_d42wRHjENQjwYJmwew&oe=6AFB3266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RascalsForever1_Screenshot4.png", "id": "381278967729340", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982461_381278971062673_2785525287751613515_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIgoQKk6fw4Q7kNvwGi8qby&_nc_oc=Adpv08ES2iZ1HZ2ojkk4-vj4Bk6wPPK790m1Z8-uDeq5kHrzacYz__O2VD8BTXEVFU4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCG77962oOIV-IoMyYuwN3s8GgMbfxt5i70lX92Yy53A&oe=6AFB1D3B"}, "display_name": "Rascals Forever", "keywords": [], "long_description": "Welcome to Rascals Forever, the board game that comes alive in your game room, the board game that lets you take first person control of your pieces to play dirty tricks on the opposition.\n\nTry different game modes and a wide array of power-ups, ranging from rocks and guns, through explosive bananas and dynamite, to whale attacks and insidious arrows that keep hurting your victim until they can afford to remove it. The Rascals themselves are both cute and creepy, lovingly crafted from exotic wood in a world of marble and granite.\n\nYou can battle against a varied bunch of AI personalities, with different skill sets and tactical preferences setting their play styles apart.\nThere\u2019s a single player career mode with 60 missions, custom games, hot seat multiplayer support, R/C toys and other distractions for when someone else is taking their turn.", "short_description": "Welcome to Rascals Forever, the board game that comes alive in your game room and where you take first person control of your pieces to play dirty tricks on the opposition.\nPlay different game modes and use a wide array of power-ups. The Rascals themselves are both cute and creepy, lovingly crafted from exotic wood in a world of marble and granite.\nYou can battle against a varied bunch of AI personalities, with different skill sets and tactical preferences setting their play styles apart."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ninjawhalestudios.com/rascalsforever_privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ninja Whale Studios", "support_website_url": null, "website_url": "https://ninjawhalestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6739566729485144"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1439358193309773"}]}, "baseline_offer": {"id": "1439358193309773"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1705008207, "status": "PUBLISHED", "id": "1439358193309773"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_result
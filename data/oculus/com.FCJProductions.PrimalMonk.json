b=1-7&_nc_sid=6e7a0a&_nc_ohc=te8gnF6weSIQ7kNvwEX_ZnE&_nc_oc=AdqwuBoF4KfXxu3bYcHYnpv9SfTdeqsMUMpDrrLtbSj-NseMSdzMJNAhnaNzEjMSnLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOakIbMl9RpjFI5HOf9dsSKNlz8jYGxGkY_7uZRD74vw&oe=6AF89025"}, {"file_name": "New Project (4).png", "id": "926582870386824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303679_926582873720157_668971916457924104_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxVV3suQAP0Q7kNvwF2HJWI&_nc_oc=AdrGMc_tNlx3B5X08dN0G3DdQoEAyHkWPT3lw44mNOGmF7H041Nl6qnqShOKisOaATs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2QemdONzIoxuJcZehpYKReXLS6UOWaxwtb0hmg5xMBw&oe=6AF89DA4"}, {"file_name": "New Project (5).png", "id": "1293428792923934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1293428796257267_7176657093463553790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z09WCyNYHoYQ7kNvwFIrC9S&_nc_oc=AdpEAlrqzFf1RPH1jhspNN5xS07cpZkx5KUFjOotbtLcHy9_VoA4zVLnvYmBZB1mKmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmc4TuR5lfLmodKcUHBamCXYsdNvr4RejqBr_VkxQO_Q&oe=6AF87CB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Monke", "keywords": ["Horror", "Monkey", "Fun", "Gorilla", "PrimalMonke"], "long_description": "Primal Monke is a multiplayer VR experience where you step into the role of a primal monke and explore a fast-paced world built for movement, fun, and chaos with friends. Swing, climb, and traverse different environments while playing alongside other players in real time.\n\nThe game features multiple modes, including intense horror experiences that test your awareness and teamwork, as well as fun casual gameplay areas where you can just hang out, move around, and enjoy the world. Whether you\u2019re trying to survive, explore, or just mess around with friends, there\u2019s always something to do.\n\nYou can also visit the in-game shop to customize your monke with cosmetics and stand out from other players. More content and game modes are planned for future updates, expanding the world and adding even more ways to play.\n\nGrab your friends, jump in, and experience the world of Primal Monke\u2014where movement, survival, and fun all come together in VR.", "short_description": "Primal Monke is a multiplayer VR game where you play as a primal monke and explore fast-paced movement gameplay with friends. Jump into fun game modes, survive horror experiences, and customize your monke in the shop. More modes are coming soon\u2014bring your friends and play!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/primal-monke-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Crid", "support_website_url": null, "website_url": "https://sites.google.com/view/primal-monke-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26892901533692907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_909107948831955_1846207396417240879_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GKNhKlbnO8Q7kNvwHCCBee&_nc_oc=AdrAYQhXFYbAFWTz7DomwfSZ4Vub1EQJrObimXs0NCKe-s14UaB20OrGEDDRC6nzfMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj33beYQGtEX-cCPqlnO8aY0Zm9BUEeAS7
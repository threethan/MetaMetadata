a&_nc_ohc=cC18xPZTziQQ7kNvwE71byX&_nc_oc=Adp-7etOZi1YpU5crdH85L33JcaRr--hXw6ctcUtA31_btZirXs5CJSmdI_n7Mh8hWg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsHUwnWKjQCETYRhDxdZj0tUTgJV-xOV3fT9S51GFF_w&oe=6A804F51"}, {"file_name": "Screenshot05.png", "id": "1370165478309429", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491829120_1370165484976095_8083047329744756493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sahZhjcOkDkQ7kNvwHSyhzC&_nc_oc=AdpckTEICtzc2P2gDpLc88kgiY5X2Iy-5bYpQ18S9sW-taM2vQ6ppfr-6P4L0lEGua4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxOBt2QYgOSjX5xg11GoMVO4UMGLG0H6REidzsAZp_5A&oe=6A8066BB"}, {"file_name": "Screenshot04.png", "id": "1535736538159864", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825415_1535736544826530_4016413559328759525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad5IEohr_EgQ7kNvwGoLyvz&_nc_oc=AdoL6M2POyAmV_ezUxpiMCqoRt-WTBsCFtmJUzFAztuaou9C1uoDENkFf62gP8bQsow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW2SrliIG4_B-zcmdB3Q9JxhJIp8QlSci3Yr_gcUxQWw&oe=6A805D66"}, {"file_name": "Screenshot01.png", "id": "974993768735462", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825563_974993772068795_3116712420112064562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjfI33IKxmAQ7kNvwF8TU9s&_nc_oc=AdrFVjnl-_9zu_ty9zEJ6SfZuMULboYH4OFzSLXN5X_50xDnvqV2SthRgCtg9nrH_gk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHQDLi9NBGt2fFyBcVcB63atuEQEGDdjnA0vTG1TryZQ&oe=6A804847"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "PC", "stereoscopic", "3D", "motion"], "long_description": "CYBIONYX InMotion streams your computer to your headset as a huge virtual display. Then lets you control it by moving your head and using your controllers as a mouse and keyboard. Play any PC game, work on your desktop, or watch movies\n\n- Giant curved virtual screen. Adjust size, curvature, and position\n- Aim with your head. Head motion maps to your mouse for natural look-to-aim control\n- Full controller input. Sticks and buttons act as mouse & keyboard, with ready-made mapping presets and gyro aiming\n- Real-time stereoscopic 3D \u2014 flat games and video gain genuine depth\n- Local and private \u2014 streams over a USB-C cable or your own Wi-Fi. No internet, no cloud, low latency\n- Desktop audio included", "short_description": "CYBIONYX InMotion mirrors your PC to your Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": null, "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1155798360948125"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1835056460802878"}, {"status": "PUBLISHED", "id": "1011155461295469"}, {"status": "PUBLISHED", "id": "1019919683740203"}]}, "baseline_offer": {"id": "1019919683740203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1835056460802878"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1261385280389432", "version": "0.7.0"}, "id": "1456809559806445", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1261385280389432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "Cybionyx InMotion 0.7.0\n\nWhat's new:\n\n* Laser pointer - aim the PC cursor with your controller and the click lands exactly where the beam points. On by default in Cinema mode, and it follows your dominant hand.\n* Keyboard in the headset - a full VR keyboard with seven layouts, so you can type on the PC without taking the headset off.\n* AV1 codec - on headsets that decode AV1 in hardware, the same picture at a lower bitrate. AV1 lifts the Wi-Fi ceiling to 120 Mbps and keeps adapting to your network.\n* Settings snapshots - save named sets of all your settings and switch between them from inside the headset.\n* Redesigned VR menu - sections in a side panel, hints behind \"?\" icons, and the menu now rides on your left controller like a tablet, with your hands drawn in VR.\n* Also new: right-stick look for games that ignore the mouse (Wreckfest, SnowRunner), separate aiming memory for Cinema and Game, wider 3D controls, and a manual bitrate slider that reaches 120.\n* Steadier connection and picture - the headset tries every PC address and uses the one that answers, and keyframes get stronger loss protection on busy Wi-Fi. German, Spanish, French, Italian and Portuguese are now fully translated.\n* Fixes: accurate clicks when streaming a secondary monitor, no black screen when reconnecting on a different codec, settings files that can no longer be damaged, and no controller input leaking through the VR menu into the game.\n", "created_date": 1786287464, "id": "1261385280389432", "version": "0.7.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1261385280389432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "Cybionyx InMotion 0.6.0\n\nWhat's new:\n* Fewer picture tears on unstable Wi-Fi - the stream now detects dropped packets and repairs them on the fly.\n* Sharper image - headset-side sharpening you control with the Sharpness slider.\n* Smarter resolution - the picture is matched to what your Quest can actually display, for higher and steadier frame rates, especially with 4K and ultrawide monitors.\n* Choose which monitor to stream - capture a secondary or virtual display.\n* Retuned USB-C and Wi-Fi bitrate for a more consistent picture on each connection.\n* Refreshed 3D defaults (depth, render scale and sharpness), and a simpler Screen settings page - placement, background and 3D controls now live in the in-headset menu.\n* Fixes: a clear message instead of a black screen when a resolution isn't supported, and Reset no longer wipes changes you made in the VR menu.", "created_date": 1784566338, "id": "1230490050145622", "version": "0.6.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1261385280389432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "- More reliable Wi-Fi pairing and reconnect (now connects on the first try)\n- One-tap reconnect if the stream drops\n- Sharper image on ultrawide (21:9 / 32:9) monitors\n- Manual IP helper when your PC isn't found automatically", "created_date": 1784049803, "id": "1221786561015971", "version": "0.5.1", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1261385280389432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "\"CYBIONYX InMotion 0.5.0\\n\\n- Much more stable Wi-Fi streaming: the picture now recovers from network hiccups, so far fewer freezes and dropped frames on busy networks.\\n- Sharper image with a higher bitrate ceiling.\\n- Lower latency for a snappier, more responsive feel.\\n- Improved 3D depth mode: smoother volumetric depth, fewer edge artifacts, and it now works on a wider range of PC graphics cards.\\n- Many stability and quality fixes.\"", "created_date": 1783278945, "id": "1208010482393579", "version": "0.5.0", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1261385280389432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "\"0.4.1 hotfix\"", "created_date": 1782320511, "id": "1190335984161029", "version": "0.4.1", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
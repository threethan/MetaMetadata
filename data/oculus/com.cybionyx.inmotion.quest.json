5/491823940_2569092440262167_5255524792372288824_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etj6UWBcd-EQ7kNvwGnp_1Q&_nc_oc=AdpkcUpPA-AjNsrKqT7XMALrv6uhPzeSj1K-WQfUZ7aTobYfoQW2Cbf9Evjc2aggeC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUsO30GEQOqIym2ho8kPnBc3VFDG_OL9lwm9eUOSaO5A&oe=6AF208E9"}, {"file_name": "shot1_snow.png", "id": "1000418102336972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1000418105670305_873669279393676670_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xnhewFwQm0Q7kNvwG_iE5J&_nc_oc=Adq2Y3H95GgMqAd7UmxPnP20tN3CpokkHEy9ytUvQXnVNv84duO46m6vpnH_GMTTmzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYCiaiNv_CtaAkbQBuCk1pALFJjhfel9qDCeZYnhNfLA&oe=6AF1F54B"}, {"file_name": "4.png", "id": "1521000359689633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_1521000363022966_7918197410626958616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzd6wWQZkQwQ7kNvwHpTInB&_nc_oc=AdpS9OFqGEHAfGNQUVZtc5asxAOJzCLdpotVU4hjHmrS-R4n3nIeoHvK628mQ8vUKDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqjK-RnZ2tG4B5b1tvXIGmkE7qiakGrPbsZjOMWV6skA&oe=6AF1FE61"}, {"file_name": "shot2_sandstorm.png", "id": "1435401348013454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_1435401354680120_6966891110600965069_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz_CxKCHhr8Q7kNvwHaZ_2d&_nc_oc=AdqpLilHF-3RoWhRI5iNxFwKUIEHaz6x_3SXenFr9-5e7VrJylIN-f-TkSjG5lJwiWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGyAUezn2lnOP7YmfWUj2UgDCMcJxQSypKfLp3TAsBJQ&oe=6AF1F635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_treiler.png", "id": "3757433404436181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_3757433414436180_4698271004306832585_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0Sp6rlAb3IQ7kNvwEvQSv2&_nc_oc=AdpCM_fPE4zQK0Y-MX98-b92RKXjpsjlgGQrjnKap7ozt5G8lDavZrexSzOWJKmLTyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqjEA40fuPloAauGsfBUCkH_x9d5sy_j-mg6zFXF_0xA&oe=6AF1E921"}, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "3D", "monitor", "movies", "PC"], "long_description": "**Any PC game or movie in immersive 3D with Mixed Reality effects**\n\nInMotion streams your PC to your Meta Quest and turns any flat game, movie or video into 3D in real time. No mods, no special VR versions, no file conversion: your whole library works as it is. Turn your head, and the world turns with you.\n\n## What you get\n\n- **2D to 3D for anything on screen.** On Quest 3 and 3S the headset can compute depth itself and leave your graphics card to the game.\n- **Mixed reality (beta).** Rain, snow, leaves, a sandstorm, underwater or space from the picture come into your room. Scan your room once, and snow and leaves settle on your floor and furniture.\n- **One or two screens.** Add a second monitor or a virtual one at the resolution you need. Grab a frame to move it, pull a corner to resize it.\n- **Consoles too.** PS5 and Xbox via Remote Play on your PC.\n- **Smooth picture.** Up to 500 Mbps and 72 to 120 Hz matched to your game.\n- **Your controls.** Controllers, gamepad, keyboard and mouse, head tracking or a laser pointer.\n\n## What you'll need\n\n- A **Windows 10 or 11 PC** or a **Mac** with Apple Silicon (beta), with the free InMotion desktop app: inmotion.cybionyx.space\n- **5 GHz Wi-Fi** with the PC wired to the router, or a **USB-C cable**\n- Meta Quest 2, 3, 3S or Pro\n\n## Good to know\n\n- It is a big virtual screen with depth, not a full 6DOF VR version of your games.\n- Protected video in some apps can show a black picture: the system does not allow capturing it.", "short_description": "Stream your Windows PC to Meta Quest and turn any flat game, movie or video into 3D in real time. Play on one or two big screens or a virtual monitor, over Wi-Fi or a USB cable, with mixed reality effects that come into your room. No mods and no special VR versions: your whole library works as it is."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": "https://inmotion.cybionyx.space/support", "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru", "it"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1421530844374874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_2237031703518406_7695653164625020733_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJ-69NesCVkQ7kNvwEx0olm&_nc_oc=AdptwcdPcRyAUXdWyhBIOcd3sq1Yy3s65jTH_KFNGzDJldNVnriV4EOSkNNTDZlqeGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc87xD7eSlOZYRUcD_CZoQI8k8ptcBXyBIN0EZW8AeOQ&oe=6AF1F920"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CYBIONYX InMotion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": 
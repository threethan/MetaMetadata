{"data": {"node": {"__typename": "Application", "id": "1155798344281460", "organization": {"id": "1067511569776805", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1155798344281460"}]}, "id": "2230631047710656"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1155798344281460", "release_date": 1780853400, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 3}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1261385280389432"}, "id": "1456809559806445"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1261385280389432"}, "release_status": "RELEASED"}, "id": "1261385280389432", "version": "0.7.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1786292527, "id": "1261491417045485", "is_initial_release": false, "name_with_fallback": "v9", "pdp_metadata_with_fallback": {"version": 4, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1179412845253343"}, "release_status": "RELEASED", "id": "1155798344281460"}, "id": "1179412845253343", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_4356430484596374_8097820113019868302_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi9e7NvSKwgQ7kNvwHsXOKY&_nc_oc=Ado1mvUARbuQCvUbXgjeB31o0fI2SBog8DbB-RJcWq7zWnc08-c0_W-H5HvNxPu5AhU&_nc_zt=3&_nc_ht=scontent-s
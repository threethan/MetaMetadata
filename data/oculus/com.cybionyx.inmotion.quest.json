5/491823940_2569092440262167_5255524792372288824_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yywl_tB3dCQQ7kNvwHcC8Tt&_nc_oc=AdqOLQrtV1Ay17E_-koa8TId3GE3i4ykIg8p55pvvOc9aCrxkdvagbRZLlyylbHNwtc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzVNss0CzmGmBWC1D7vjsfwsxeITz_ya6sTcM_iAc3uQ&oe=6AF35A69"}, {"file_name": "shot1_snow.png", "id": "1000418102336972", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_1000418105670305_873669279393676670_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xnhewFwQm0Q7kNvwF3jDLt&_nc_oc=AdpE_wBmzhd99dngT1XQwUcIaUa3Ka5KIxEzVkAjny-PhS35jzO1UXRl55VB3R2qIfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Gyo0ILSmpI91V7l2Wgn7Y5iwsI7ckBQ9nMTciEkOEA&oe=6AF346CB"}, {"file_name": "4.png", "id": "1521000359689633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1521000363022966_7918197410626958616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzd6wWQZkQwQ7kNvwFZSnmZ&_nc_oc=AdrIroopmPEmPsv6NCaMY3DgbCe9lwFWZXy3l9fnLudnRNxDCg6t_qNwuTnezpixK48&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF3QhVKmYGq8Olt7oz_fqveOYNX39UloJz-JS_AkL1gw&oe=6AF34FE1"}, {"file_name": "shot2_sandstorm.png", "id": "1435401348013454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1435401354680120_6966891110600965069_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aANYRlyr8NsQ7kNvwFtzy48&_nc_oc=AdqgYSvlTeCfegICJ_VhPsAK_tIBBSwXBpOEnqhhQcczBmZRl6NkON2df6rH4uy3XO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDqlOQwl_hCpdbR9JaJ2Glm47lG2bAyvXSLHPiuUfEYw&oe=6AF347B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_treiler.png", "id": "3757433404436181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_3757433414436180_4698271004306832585_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq_4u0h7QzMQ7kNvwHrMNV9&_nc_oc=AdodlWOAbmlIe70oFX-EazvoUnD5UZlbYImjmv_7dOZtQ0rXvNYilNfbHb2bLHaW50U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnSfuHH_zUCUdjuVIegwiu5ZznuxWBKStaeectKJ1B_g&oe=6AF33AA1"}, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "3D", "monitor", "movies", "PC"], "long_description": "**Any PC game or movie in immersive 3D with Mixed Reality effects**\n\nInMotion streams your PC to your Meta Quest and turns any flat game, movie or video into 3D in real time. No mods, no special VR versions, no file conversion: your whole library works as it is. Turn your head, and the world turns with you.\n\n## What you get\n\n- **2D to 3D for anything on screen.** On Quest 3 and 3S the headset can compute depth itself and leave your graphics card to the game.\n- **Mixed reality (beta).** Rain, snow, leaves, a sandstorm, underwater or space from the picture come into your room. Scan your room once, and snow and leaves settle on your floor and furniture.\n- **One or two screens.** Add a second monitor or a virtual one at the resolution you need. Grab a frame to move it, pull a corner to resize it.\n- **Consoles too.** PS5 and Xbox via Remote Play on your PC.\n- **Smooth picture.** Up to 500 Mbps and 72 to 120 Hz matched to your game.\n- **Your controls.** Controllers, gamepad, keyboard and mouse, head tracking or a laser pointer.\n\n## What you'll need\n\n- A **Windows 10 or 11 PC** or a **Mac** with Apple Silicon (beta), with the free InMotion desktop app: inmotion.cybionyx.space\n- **5 GHz Wi-Fi** with the PC wired to the router, or a **USB-C cable**\n- Meta Quest 2, 3, 3S or Pro\n\n## Good to know\n\n- It is a big virtual screen with depth, not a full 6DOF VR version of your games.\n- Protected video in some apps can show a black picture: the system does not allow capturing it.", "short_description": "Stream your Windows PC to Meta Quest and turn any flat game, movie or video into 3D in real time. Play on one or two big screens or a virtual monitor, over Wi-Fi or a USB cable, with mixed reality effects that come into your room. No mods and no special VR versions: your whole library works as it is."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": "https://inmotion.cybionyx.space/support", "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru", "it"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1421530844374874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_2237031703518406_7695653164625020733_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJ-69NesCVkQ7kNvwFgJwvh&_nc_oc=Adp94WZ9j34mSdG_RTMfXbjjnO7pHMMIkZ8VUYYGVznyiNhdqYy7qvvqqH2nJkOGWRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3mlM-bd-sgjr-p6dHVZxqwwd1tWvRCJgQR9rEtjYJ9Q&oe=6AF34AA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CYBIONYX InMotion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": 
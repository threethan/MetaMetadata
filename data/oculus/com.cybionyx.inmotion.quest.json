66935_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DFWECKq3hMQ7kNvwEP2ni0&_nc_oc=Adp-fYshcDld4jMpwMxPYxlFoX-5V1en9BPJplVPhjjEhB15nxNMCSYZpqnBCgAU9jQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBt4A54jrrlcLHNPtA-x95VesAa7PBwwn5KHuVZV644A&oe=6AEF5246"}]}, "id": "1426466832904253", "locale": "en_US", "screenshots": [{"file_name": "shot3_two_screens.png", "id": "1446917284059185", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1446917287392518_5117255988849796699_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPyiNoQHbjQQ7kNvwFL8d4C&_nc_oc=Adom3MRJatAsHM0NNRp_Eg5nUBLd1w7PE8w8llw3JYWso4X0f4LuOylDkExYuAgINw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgBLG_YsHFUhZnopzCrEeQhD0s20IfJ1WmpQTAeOX-qA&oe=6AEF2FB8"}, {"file_name": "shot4_sakura.png", "id": "2569092436928834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_2569092440262167_5255524792372288824_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etj6UWBcd-EQ7kNvwGrGcV_&_nc_oc=Adp_q1HQGaFYR99KRoQo5F_53w_IvvNKiza5ojHXyUwVFGZ30fjMNxfxMnM6WSsfyCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_QarViEiE_6i8-iCqytqxBzbah5XwxvValX7t6pS83Q&oe=6AEF65E9"}, {"file_name": "shot1_snow.png", "id": "1000418102336972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1000418105670305_873669279393676670_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tO0jGpyRNgQ7kNvwHPbnWk&_nc_oc=AdrjP68MEY5CNqrJJcX8dXWUQa2a0WBAotmQDwOq3WR81XtD1s7LvCLxITEb-dgVHWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnxa5ElBywdHLUS2mlt-Dre70Qyy-78wHXiK71UmlJGA&oe=6AEF524B"}, {"file_name": "4.png", "id": "1521000359689633", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1521000363022966_7918197410626958616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VTYcjgdaLcQ7kNvwFZwx1P&_nc_oc=AdqUIv4aiH266GUbwbzXlxCZcIopjEoEh4UEc9hZJaM0e5Y5njqMCppEN7PnQS7kW1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcVeOndM1Q1r0a2UlxHgAJ4rxLUZSFiVGkNdzWYLM92Q&oe=6AEF5B61"}, {"file_name": "shot2_sandstorm.png", "id": "1435401348013454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_1435401354680120_6966891110600965069_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz_CxKCHhr8Q7kNvwFihVg6&_nc_oc=Adpu50FMKj1DH1R8kYNxyWDXlMLRxHKaTZdnjVW4yN3_lYhbvXYjcPFB7C58gjJFtuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi20_tUCgG9whS7rKPkmOoAquY3HWqF_YK7IXg3ykZNg&oe=6AEF5335"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "3D", "monitor", "movies", "PC"], "long_description": "**Any PC game or movie in immersive 3D**\n\nInMotion streams your PC to your Meta Quest and turns any flat game, movie or video into 3D in real time. No mods, no special VR versions, no file conversion: your whole library works as it is. Turn your head, and the world turns with you.\n\n## What you get\n\n- **2D to 3D for anything on screen.** On Quest 3 and 3S the headset can compute depth itself and leave your graphics card to the game.\n- **Mixed reality (beta).** Rain, snow, leaves, a sandstorm, underwater or space from the picture come into your room. Scan your room once, and snow and leaves settle on your floor and furniture.\n- **One or two screens.** Add a second monitor or a virtual one at the resolution you need. Grab a frame to move it, pull a corner to resize it.\n- **Consoles too.** PS5 and Xbox via Remote Play on your PC.\n- **Smooth picture.** Up to 500 Mbps and 72 to 120 Hz matched to your game.\n- **Your controls.** Controllers, gamepad, keyboard and mouse, head tracking or a laser pointer.\n\n## What you'll need\n\n- A **Windows 10 or 11 PC** or a **Mac** with Apple Silicon (beta), with the free InMotion desktop app: inmotion.cybionyx.space\n- **5 GHz Wi-Fi** with the PC wired to the router, or a **USB-C cable**\n- Meta Quest 2, 3, 3S or Pro\n\n## Good to know\n\n- It is a big virtual screen with depth, not a full 6DOF VR version of your games.\n- Protected video in some apps can show a black picture: the system does not allow capturing it.", "short_description": "Stream your Windows PC to Meta Quest and turn any flat game, movie or video into 3D in real time. Play on one or two big screens or a virtual monitor, over Wi-Fi or a USB cable, with mixed reality effects that come into your room. No mods and no special VR versions: your whole library works as it is."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": "https://inmotion.cybionyx.space/support", "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru", "it"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1409621758899116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_2108413156464256_8335457717224385144_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd_fZU2QgK4Q7kNvwEk4tjO&_nc_oc=AdreqR6XsaTRtf8EdUCR5X7Jpvqwl0SlDVK8SQLbzw8dfF4ZP3szkQRkLU17Vgi
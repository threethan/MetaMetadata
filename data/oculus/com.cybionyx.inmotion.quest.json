"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "PC", "stereoscopic", "3D", "motion"], "long_description": "CYBIONYX InMotion streams your computer to your headset as a huge virtual display. Then lets you control it by moving your head and using your controllers as a mouse and keyboard. Play any PC game, work on your desktop, or watch movies\n\n- Giant curved virtual screen. Adjust size, curvature, and position\n- Aim with your head. Head motion maps to your mouse for natural look-to-aim control\n- Full controller input. Sticks and buttons act as mouse & keyboard, with ready-made mapping presets and gyro aiming\n- Real-time stereoscopic 3D \u2014 flat games and video gain genuine depth\n- Local and private \u2014 streams over a USB-C cable or your own Wi-Fi. No internet, no cloud, low latency\n- Desktop audio included", "short_description": "CYBIONYX InMotion mirrors your PC to your Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": null, "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1155798360948125"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1337674871505746"}, {"status": "PUBLISHED", "id": "1835056460802878"}, {"status": "PUBLISHED", "id": "1011155461295469"}, {"status": "PUBLISHED", "id": "1019919683740203"}]}, "baseline_offer": {"id": "1019919683740203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1337674871505746"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1409449462249679", "version": "1.0.0"}, "id": "1456809559806445", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1409449462249679"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "play your PlayStation 5 right in the headset over your home network.\r\nQuest 2: no more broken frames in 60 and 30 fps games, the display now runs at 72 Hz there.", "created_date": 1794344323, "id": "1436858062842152", "version": "1.0.1", "version_code": 16, "release_status": "PENDING", "status": "UNDER_REVIEW", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1409449462249679"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "PS5 without a PC: play your PlayStation 5 right in the headset over your home network. Sign in with Sony, link the headset with the code from your PS5, connect a DualSense and play in VR or on a flat panel.\nQuest 2: no more broken frames in 60 and 30 fps games, the display now runs at 72 Hz there.", "created_date": 1794063078, "id": "1430117893516169", "version": "1.0.1", "version_code": 15, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1409449462249679"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "InMotion leaves Early Access with version 1.0.0.\n\nUpdate 1.0.0\n\nNew\n- Multiple screens in VR: pick a second monitor or create a virtual one\n- A frame around the screens, the stats card and the keyboard: move and resize them on the fly\n- Virtual monitor at the resolution you need, installed with one button in the launcher\n- Mixed reality atmosphere effects (beta): rain, snow, leaves, sandstorm, underwater or space around you, matched to what is on screen\n- 3D computed on the headset itself on Quest 3 and 3S\n- Console mode for PS5 and Xbox Remote Play\n- Cable without developer mode on Horizon OS 2.5 and newer\n- Connection diagnosis with hints\n- Two sharpening settings, two VR cursors, more values in the stats card\n- New intro video at app start\n\nImproved\n- Auto bitrate finds your maximum, up to 500 Mbps\n- Smoother frames: the headset picks 72, 80, 90 or 120 Hz to match your game\n- New 3D model on the PC, Depth Anything 3, easier on the eyes\n- 3D turns on without freezing\n- Screen shaped like your monitor, no black bars\n- Fewer stutters after network loss, lower CPU load, sound stays in sync in long sessions\n- Faster connection and start\n\nFixed\n- An older PC version no longer resets your settings and paired headsets\n- A wrong PIN no longer changes the PIN\n- Forget & re-pair button when the PC no longer knows the headset\n- A picture instead of a black screen on PCs without a hardware encoder\n\nMost new features also need InMotion 1.0.0 on your PC.", "created_date": 1793383182, "id": "1409449462249679", "version": "1.0.0", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1409449462249679"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "New\n- \"Empty space\" cinema background: a textured floor at your real floor height, lit by the screen.\n- The stats card can be pinned in the room in any tracking mode.\n\nImproved\n- USB: bitrate ceiling raised to 100 Mbps and reached within 2 seconds of connecting.\n- USB: smoother picture, 10 ms closer to display time.\n- Wi-Fi: bitrate reaches its target right after connecting and holds; no more stutters from frames dropped on the PC.\n- AMD: about 15 ms lower latency, more frames in the headset, higher game fps in heavy scenes.\n- Windows: colour conversion moved from the CPU to the GPU.\n- Head turns apply the moment the packet arrives.\n- \"Blurred backdrop\" toggle now works in cinema mode too.\n\nFixed\n- HDR: with Windows HDR on, the picture is no longer blown out. Turn on \"HDR tonemap\" on the Screen page; the headset reminds you if it is off.\n- Closing or crashing the launcher always stops the engine.\n- Connecting the headset no longer wakes VPN adapters or drops the PC's internet.\n- Game and Cinema settings are kept separately and always reach the headset.\n- 3D: the depth map matches its frame; \"3D render scale\" no longer resets.\n- Leaving VR no longer shows a false \"Immersion failed\".\n\nAV1 stays in beta.", "created_date": 1789582499, "id": "1323903487470944", "version": "0.9.0", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1409449462249679"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "Cybionyx InMotion 0.8.0\n\nNew\n\n- Ready 3D (SBS): a third 3D mode for content that is already stereo: SBS videos and games with side-by-side output. Full SBS, Swap eyes and Over/Under settings for the different formats.\n- Keyboard on the 2D panel: the \"Keyboard\" button brings up the Quest system keyboard, type on the PC without entering VR. Input is sent encrypted.\n- 3D protects itself: if the graphics card cannot keep up with computing depth, 3D pauses, the stream keeps running flat, and 3D comes back on its own. A switch in the 3D settings.\n- Settings snapshots: a set can be overwritten in place, and a star marks the set that loads at every start.\n- Launcher: the window can be resized by its edges, interface scale from 80 to 150%.\n- VR stats became a window: drag it and resize it. On the 2D panel the tiles moved to the top.\n- The right stick scrolls the page in pointer mode.\n- The screen's edge fade is now kept between sessions.\n\nImproved\n\n- AV1 over Wi-Fi: picture tearing removed, and better performance over Wi-Fi and USB-C.\n- AMD: improved stability for AMD users.\n- Wi-Fi streaming reworked: fewer lost frames and freezes, fewer emergency keyframes, bitrate comes back within seconds after a loss burst.\n- Pointer: the beam is stabilized, a shaky hand no longer turns a click into a drag.\n- Better performance over USB-C.\n\nFixed\n\n- The PIN page no longer shows through under the stopped-system page.\n- FPS in the stats no longer jumps: the counter counts delivered frames.\n- A 32:9 ultrawide monitor is no longer mistaken for a stereo pair and actually becomes an ultrawide virtual monitor.\n- 3D switched off releases the PC graphics card, not only the headset.\n- Stats tiles idle on \"...\". The launcher's language picker is labeled.\n\nThe AV1 codec stays in BETA testing, we keep improving it from your feedback.\n", "created_date": 1787501745, "id": "1286565464538080", "version": "0.8.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I3QWCWXrR63D3o-1OmSn0A9Fak0f_NA7Ue-6VAnvcOA&oe=6A35580A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CYBIONYX InMotion", "keywords": ["PC", "3D", "motion", "immersion", "desktop"], "long_description": "\ud83d\udd25 Experience your favorite games and movies in a whole new way! With immersive presence and a real 3D\n  effect!\n  \n  \ud83c\udf1f Any PC game \u2014 now like VR, with real 3D! You're not watching from the outside \u2014 you're inside the\n  game, and the world around you is alive and full of depth!\n\n  \ud83c\udfae No special VR games or mods needed!\n  \n  \ud83c\udf00 Total sense of presence. Turn your head \u2014 and the whole world turns with you.\n\n  \ud83c\udfac Movies and games in 3D, like the real thing. Any video comes alive in true 3D!\n  \n  \ud83d\udd79\ufe0f  Play with controllers or however you like \u2014 no lengthy setup.\n\n  \u26a1 Simple connection!\n  \n  \ud83d\udd25 Rediscover your favorite games and movies \u2014 with immersive presence and real 3D!", "short_description": "CYBIONYX InMotion - play any PC-game with immersion"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": "https://inmotion.cybionyx.space/", "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
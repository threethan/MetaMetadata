&_nc_ohc=K0KV-TOiD2cQ7kNvwEq6NqG&_nc_oc=AdoI9CrcZey3HPsxE7Usp4OkXLUjq9hoFPHgUo_tqEwf2V4qTQCtWO2GSuEbsRsgt5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy5CfqbzRoYFTXkNWKeWhdl-UWjPpzvJ6Yz92lz13RuA&oe=6A492891"}, {"file_name": "Screenshot05.png", "id": "1370165478309429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829120_1370165484976095_8083047329744756493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnrdgZTExPsQ7kNvwFbU0DL&_nc_oc=AdpTGnYwWJwq1U9VBpu_GdoAE8FJ81BX2LqZR6xtjUlhde7DxFWtECypxmbMBa8GWjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtio9O1tfMBgXqxI_EFGFEEymjpCfNrfnK_7TO4k_f5Q&oe=6A4907BB"}, {"file_name": "Screenshot04.png", "id": "1535736538159864", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1535736544826530_4016413559328759525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5uwdxueVcIQ7kNvwEQXXH8&_nc_oc=Adq2vOqkGRAHOluTUtXO4m8jg6bwedKiWxX2Tg18TVOOB1jvlYOP15I5dtlx7lbYX4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfFhaYSQK-pPB8H4ojvnWt4BqogmyKvD_YNDWCyMu3oA&oe=6A48FE66"}, {"file_name": "Screenshot01.png", "id": "974993768735462", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_974993772068795_3116712420112064562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPaKgIUsnkQQ7kNvwHV1MeT&_nc_oc=AdrqZXbtOK9IMSaEFR0zKQhDxS8S33sNk4C85_KnkK1oHp2514SavUtkWTJD8CD6Hfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwvfffFlMHmluNgXJUnp13k-OVLT5c0aBOcqlMhag8fg&oe=6A492187"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "PC", "stereoscopic", "3D", "motion"], "long_description": "CYBIONYX InMotion streams your computer to your headset as a huge virtual display. Then lets you control it by moving your head and using your controllers as a mouse and keyboard. Play any PC game, work on your desktop, or watch movies\n\n- Giant curved virtual screen. Adjust size, curvature, and position\n- Aim with your head. Head motion maps to your mouse for natural look-to-aim control\n- Full controller input. Sticks and buttons act as mouse & keyboard, with ready-made mapping presets and gyro aiming\n- Real-time stereoscopic 3D \u2014 flat games and video gain genuine depth\n- Local and private \u2014 streams over a USB-C cable or your own Wi-Fi. No internet, no cloud, low latency\n- Desktop audio included", "short_description": "CYBIONYX InMotion mirrors your PC to your Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": null, "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1155798360948125"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1011155461295469"}, {"status": "PUBLISHED", "id": "1019919683740203"}]}, "baseline_offer": {"id": "1019919683740203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1011155461295469"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1190335984161029", "version": "0.4.1"}, "id": "1456809559806445", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1190335984161029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "\"0.4.1 hotfix\"", "created_date": 1782320511, "id": "1190335984161029", "version": "0.4.1", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1190335984161029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "\"Cybionyx InMotion 0.4.0\\n\\nWhat's new:\\n\u2022 Streaming quality presets: choose Sharper, Balanced or Smoother, with automatic bitrate tuning that keeps Wi-Fi stable.\\n\u2022 Gamepad support: play PC games with a virtual Xbox controller, including vibration (with an on/off switch).\\n\u2022 Ready-made control layouts for RPG and Shooter games, with on-screen button hints in VR.\\n\u2022 New in-headset overlay: see your FPS, latency and connection at a glance.\\n\u2022 More reliable: smoother recovery from connection and configuration hiccups.\\n\u2022 Various fixes and improvements.\\n\\nFor the new PC-side features, please update the Cybionyx InMotion app on your computer as well.\\n\\nThank you for using Cybionyx InMotion!\"", "created_date": 1782149121, "id": "1187210307806930", "version": "0.4.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1190335984161029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781722774, "id": "1179393868588574", "version": "0.3.0", "version_code": 4, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1190335984161029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "What's new in 0.2.0\r\n\r\n\u2022 New immersive screen with Game and Cinema modes \u2014 soft feathered edges and an ambient glow around the picture\r\n\u2022 Smoother controls and a larger default screen size\r\n\u2022 Refreshed startup intro\r\n\u2022 In-headset onboarding tour now available in more languages\r\n\u2022 Sharpness & 3D depth tuning, plus a quick guided tour\r\n\u2022 Stability fixes and polish", "created_date": 1781199594, "id": "1169262289601732", "version": "0.2.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1190335984161029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": null, "created_date": 1780675189, "id": "1159242307270397", "version": "0.1.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
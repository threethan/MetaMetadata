_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQQD3mC9sXG_v_OV-jWNKOxqOldjGua5LSgCbBiFGQNg&oe=6AB90C86"}, {"file_name": "Cover_image3000.png", "id": "964803699701433", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622227_964803703034766_1887971551488100420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOeiufSklXwQ7kNvwFRaOGQ&_nc_oc=AdqZmGi0KBM9zzEmmgyU3_gA0eO5lmVZ0r5aJB-8H18KApIc6MRojkP5SRaLKyE4xeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpHvc4VjCOEfe7XvQlI3ljoCsIqwQh5_cVkvfIV2BvAA&oe=6AB916DA"}]}, "id": "972636932039503", "locale": "en_US", "screenshots": [{"file_name": "Screenshot02.png", "id": "2909258826073574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_2909258829406907_7816999686469140167_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gDLZ1JCz0AQ7kNvwGeeu5A&_nc_oc=AdqcFze4Xo0IIelaY2meu3swV6jHWThMpIIQCDUPoHYVmwa2PX3Oyvq423ZMZLrJUKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs27TEoZBz2oOcOVFdvyooRM26Nuhdzbg19DiABCThiA&oe=6AB91E37"}, {"file_name": "Screenshot06.png", "id": "1540977060704065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1540977064037398_3520746141415158292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zApaxGUEFbUQ7kNvwFvupcL&_nc_oc=Adqe-fxNIyKBfs_j6rQdpoMeQNAmuC8Zxysr9EVNs_taobNVs7ZS_eZ9vh0aOnv8i2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzvJ1BHMZ80gxB3oT54Rz9l3xLlzhII4giL4Tlw4g2XQ&oe=6AB93811"}, {"file_name": "Screenshot05.png", "id": "1370165478309429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829120_1370165484976095_8083047329744756493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKHV2pT1d3sQ7kNvwG2Br_n&_nc_oc=AdoWQRtqPiCNXyt_LdbmVyrA934jceHd_VJ9tIG5EOmZyv6x45FxCbc5zNzuNLj433w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfYTy2TM1NdfMtRYo31YQdpz0LJUS5MPjENyIsHF5fWA&oe=6AB9173B"}, {"file_name": "Screenshot04.png", "id": "1535736538159864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_1535736544826530_4016413559328759525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AygpL1N6fQIQ7kNvwFWKs9w&_nc_oc=AdoZdN8vOg8UhC6Z6qn_oRB5xYEuJ2hS0LZVLN8CgPbfgokxvDhi6nK_ds1jmK_daus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_EfRPVu1I1TOHzi4LUHjt_z297AuUY3hiezjqQhgCog&oe=6AB90DE6"}, {"file_name": "Screenshot01.png", "id": "974993768735462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_974993772068795_3116712420112064562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_yfCZI2BicQ7kNvwGP7TRR&_nc_oc=AdqUQoBSkg_c7vJV-hlPwyIbj3tZjeJ9oAqUqGwDReIhXThIWUFVDO6NfAiojvEbeM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFgVAZlyNbvFUb-wyD_M8dIUCZsLMpALv-lW6heJAWVA&oe=6AB93107"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "PC", "stereoscopic", "3D", "motion"], "long_description": "CYBIONYX InMotion streams your computer to your headset as a huge virtual display. Then lets you control it by moving your head and using your controllers as a mouse and keyboard. Play any PC game, work on your desktop, or watch movies\n\n- Giant curved virtual screen. Adjust size, curvature, and position\n- Aim with your head. Head motion maps to your mouse for natural look-to-aim control\n- Full controller input. Sticks and buttons act as mouse & keyboard, with ready-made mapping presets and gyro aiming\n- Real-time stereoscopic 3D \u2014 flat games and video gain genuine depth\n- Local and private \u2014 streams over a USB-C cable or your own Wi-Fi. No internet, no cloud, low latency\n- Desktop audio included", "short_description": "CYBIONYX InMotion mirrors your PC to your Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": null, "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1155798360948125"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1337674871505746"}, {"status": "PUBLISHED", "id": "1835056460802878"}, {"status": "PUBLISHED", "id": "1011155461295469"}, {"status": "PUBLISHED", "id": "1019919683740203"}]}, "baseline_offer": {"id": "1019919683740203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1337674871505746"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1323903487470944", "version": "0.9.0"}, "id": "1456809559806445", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1323903487470944"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "New\n- \"Empty space\" cinema background: a textured floor at your real floor height, lit by the screen.\n- The stats card can be pinned in the room in any tracking mode.\n\nImproved\n- USB: bitrate ceiling raised to 100 Mbps and reached within 2 seconds of connecting.\n- USB: smoother picture, 10 ms closer to display time.\n- Wi-Fi: bitrate reaches its target right after connecting and holds; no more stutters from frames dropped on the PC.\n- AMD: about 15 ms lower latency, more frames in the headset, higher game fps in heavy scenes.\n- Windows: colour conversion moved from the CPU to the GPU.\n- Head turns apply the moment the packet arrives.\n- \"Blurred backdrop\" toggle now works in cinema mode too.\n\nFixed\n- HDR: with Windows HDR on, the picture is no longer blown out. Turn on \"HDR tonemap\" on the Screen page; the headset reminds you if it is off.\n- Closing or crashing the launcher always stops the engine.\n- Connecting the headset no longer wakes VPN adapters or drops the PC's internet.\n- Game and Cinema settings are kept separately and always reach the headset.\n- 3D: the depth map matches its frame; \"3D render scale\" no longer resets.\n- Leaving VR no longer shows a false \"Immersion failed\".\n\nAV1 stays in beta.", "created_date": 1789582499, "id": "1323903487470944", "version": "0.9.0", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1323903487470944"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "Cybionyx InMotion 0.8.0\n\nNew\n\n- Ready 3D (SBS): a third 3D mode for content that is already stereo: SBS videos and games with side-by-side output. Full SBS, Swap eyes and Over/Under settings for the different formats.\n- Keyboard on the 2D panel: the \"Keyboard\" button brings up the Quest system keyboard, type on the PC without entering VR. Input is sent encrypted.\n- 3D protects itself: if the graphics card cannot keep up with computing depth, 3D pauses, the stream keeps running flat, and 3D comes back on its own. A switch in the 3D settings.\n- Settings snapshots: a set can be overwritten in place, and a star marks the set that loads at every start.\n- Launcher: the window can be resized by its edges, interface scale from 80 to 150%.\n- VR stats became a window: drag it and resize it. On the 2D panel the tiles moved to the top.\n- The right stick scrolls the page in pointer mode.\n- The screen's edge fade is now kept between sessions.\n\nImproved\n\n- AV1 over Wi-Fi: picture tearing removed, and better performance over Wi-Fi and USB-C.\n- AMD: improved stability for AMD users.\n- Wi-Fi streaming reworked: fewer lost frames and freezes, fewer emergency keyframes, bitrate comes back within seconds after a loss burst.\n- Pointer: the beam is stabilized, a shaky hand no longer turns a click into a drag.\n- Better performance over USB-C.\n\nFixed\n\n- The PIN page no longer shows through under the stopped-system page.\n- FPS in the stats no longer jumps: the counter counts delivered frames.\n- A 32:9 ultrawide monitor is no longer mistaken for a stereo pair and actually becomes an ultrawide virtual monitor.\n- 3D switched off releases the PC graphics card, not only the headset.\n- Stats tiles idle on \"...\". The launcher's language picker is labeled.\n\nThe AV1 codec stays in BETA testing, we keep improving it from your feedback.\n", "created_date": 1787501745, "id": "1286565464538080", "version": "0.8.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1323903487470944"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "Cybionyx InMotion 0.7.0\n\nWhat's new:\n\n* Laser pointer - aim the PC cursor with your controller and the click lands exactly where the beam points. On by default in Cinema mode, and it follows your dominant hand.\n* Keyboard in the headset - a full VR keyboard with seven layouts, so you can type on the PC without taking the headset off.\n* AV1 codec - on headsets that decode AV1 in hardware, the same picture at a lower bitrate. AV1 lifts the Wi-Fi ceiling to 120 Mbps and keeps adapting to your network.\n* Settings snapshots - save named sets of all your settings and switch between them from inside the headset.\n* Redesigned VR menu - sections in a side panel, hints behind \"?\" icons, and the menu now rides on your left controller like a tablet, with your hands drawn in VR.\n* Also new: right-stick look for games that ignore the mouse (Wreckfest, SnowRunner), separate aiming memory for Cinema and Game, wider 3D controls, and a manual bitrate slider that reaches 120.\n* Steadier connection and picture - the headset tries every PC address and uses the one that answers, and keyframes get stronger loss protection on busy Wi-Fi. German, Spanish, French, Italian and Portuguese are now fully translated.\n* Fixes: accurate clicks when streaming a secondary monitor, no black screen when reconnecting on a different codec, settings files that can no longer be damaged, and no controller input leaking through the VR menu into the game.\n", "created_date": 1786287464, "id": "1261385280389432", "version": "0.7.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1155798344281460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1323903487470944"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456809559806445"}]}, "change_log": "Cybionyx InMotion 0.6.0\n\nWhat's new:\n* Fewer picture tears on unstable Wi-Fi - the stream now detects dropped packets and repairs them on the fly.\n* Sharper image - headset-side sharpening you control with the Sharpness slider.\n* Smarter resolution - the picture is matched to what your Quest can actually display, for higher and steadier frame rates, especially with 4K and ultrawide monitors.\n* Choose which monitor to stream - capture a secondary or virtual display.\n* Retuned USB-C and Wi-Fi bitrate for a more consistent picture on each connection.\n* Refreshed 3D defaults (depth, render scale and sharpness), and a simpler Screen settings page - placement, background and 3D controls now live in the in-headset menu.\n* Fixes: a clear message instead of a black screen when a resolution isn't supported, and Reset no longer wipes changes you made in the VR menu.", "created_date": 1784566338, "id": "1230490050145622", "version": "0.6.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__
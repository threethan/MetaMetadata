5Ui7wQ7kNvwF72IW-&_nc_oc=AdrryREGLVsPe87MAq0jmDhCB-7kpjNy3h5vArYcPlt4Eo8pWARPeQRqfc_0WIOE9OE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8RqXvUFUr7ODmmlCqg-ApZS9MWBBywoLmaO-tfgiyBQ&oe=6AFDB038"}, {"file_name": "shot4_sakura.png", "id": "2569092436928834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_2569092440262167_5255524792372288824_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYTxuqfD_B8Q7kNvwFsZkHy&_nc_oc=Ado-yRydRyxXQ2Y4pGRAO8gkCARVNjMi_v16eC7-ytTkD-n5qjSj8_XwalLZB8Mc63I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Tdad1MpnMFNln4infF20bACmtAhQRXveLPVHfmsjYA&oe=6AFDAE29"}, {"file_name": "shot1_snow.png", "id": "1000418102336972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1000418105670305_873669279393676670_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wLjCwc3ftIQ7kNvwEg0raf&_nc_oc=Ado0PoDT4Jis0aY0dsu9yg5o6KIZNhByIuR3Krc8Em6xtxHnMK2fk5AmxyZweSf8JyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9x_GzHD4oRXjyHeNTcjTT56mQFFLkacTNKatHc0rXyg&oe=6AFDD2CB"}, {"file_name": "4.png", "id": "1521000359689633", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1521000363022966_7918197410626958616_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucCErkCEmH4Q7kNvwEQUGHS&_nc_oc=AdpIkj6KRkF9cu1qPvAYN4cEmDQO98STKdKEJGzesoLxbEwYnhgiZw0YxcH2oNkB7OM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5En0jSHvnwKw_WR-HD6R0HoeWMHZxh7lJ6933IPAKXg&oe=6AFDDBE1"}, {"file_name": "shot2_sandstorm.png", "id": "1435401348013454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_1435401354680120_6966891110600965069_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSqrn3rorcsQ7kNvwEa5ZvA&_nc_oc=Adq6jTULRdsLIJgK2DpyUspMBxu7TVNVb_etN_fOb7HTsC7rN9GVP8zHq9DTFCSuNZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFeAk0C43UbO8kGGfPXVl9MwZ9gTP1xattdMb2S1TBjA&oe=6AFDD3B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_treiler.png", "id": "3757433404436181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_3757433414436180_4698271004306832585_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_n4U-alKzIQ7kNvwH3lrb_&_nc_oc=Adq_7gkeGeDIRKo6-ExOc7MKAd6-uhStuvEV4EAuRwcrM6somkYSi7ZiDskCjE-439s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuMyKibYCDa4Y1T-nq8KbLYJrateoNfnWzAvhcKMWUMA&oe=6AFDC6A1"}, "display_name": "CYBIONYX InMotion", "keywords": ["streaming", "3D", "monitor", "movies", "PC"], "long_description": "**Any PC game or movie in immersive 3D with Mixed Reality effects**\n\nInMotion streams your PC to your Meta Quest and turns any flat game, movie or video into 3D in real time. No mods, no special VR versions, no file conversion: your whole library works as it is. Turn your head, and the world turns with you.\n\n## What you get\n\n- **2D to 3D for anything on screen.** On Quest 3 and 3S the headset can compute depth itself and leave your graphics card to the game.\n- **Mixed reality (beta).** Rain, snow, leaves, a sandstorm, underwater or space from the picture come into your room. Scan your room once, and snow and leaves settle on your floor and furniture.\n- **One or two screens.** Add a second monitor or a virtual one at the resolution you need. Grab a frame to move it, pull a corner to resize it.\n- **Consoles too.** PS5 and Xbox via Remote Play on your PC.\n- **Smooth picture.** Up to 500 Mbps and 72 to 120 Hz matched to your game.\n- **Your controls.** Controllers, gamepad, keyboard and mouse, head tracking or a laser pointer.\n\n## What you'll need\n\n- A **Windows 10 or 11 PC** or a **Mac** with Apple Silicon (beta), with the free InMotion desktop app: inmotion.cybionyx.space\n- **5 GHz Wi-Fi** with the PC wired to the router, or a **USB-C cable**\n- Meta Quest 2, 3, 3S or Pro\n\n## Good to know\n\n- It is a big virtual screen with depth, not a full 6DOF VR version of your games.\n- Protected video in some apps can show a black picture: the system does not allow capturing it.", "short_description": "Stream your Windows PC to Meta Quest and turn any flat game, movie or video into 3D in real time. Play on one or two big screens or a virtual monitor, over Wi-Fi or a USB cable, with mixed reality effects that come into your room. No mods and no special VR versions: your whole library works as it is."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inmotion.cybionyx.space/legal/privacy", "developer_terms_of_service_url": "https://inmotion.cybionyx.space/legal/terms", "publisher_name": "Kibioniks LLP", "support_website_url": "https://inmotion.cybionyx.space/support", "website_url": "https://inmotion.cybionyx.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "pt_BR", "ru", "it"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1421530844374874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_2237031703518406_7695653164625020733_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq-5Y3cU-cUQ7kNvwEnagoj&_nc_oc=AdqK5iByJgUFpg
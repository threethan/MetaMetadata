file_name": "vlcsnap-2026-09-23-11h47m20s650.png", "id": "1792370368771604", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823259_1792370372104937_1311848144195871508_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge8WuyIWAyoQ7kNvwGkm9gY&_nc_oc=AdoL_QNFmgRrlKE4aSEvvw26ylZ7ZNrKukrv76tUOQP1x8Gp_geWImRMKbGF99ixzZ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk69AfVHXI_5nX0ex42_RKC4KUGf2tIkTO7fz7h7SGjA&oe=6AF9D9A1"}, {"file_name": "vlcsnap-2026-09-23-11h46m58s570.png", "id": "3346604595541558", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825257_3346604598874891_317172700290349288_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWSKZWOh50cQ7kNvwHZVOso&_nc_oc=AdpFleWTzpt9_87OUdI23g0nSJZwmA_exYWjTxnd-XJkaq4W5JoQgJxiWbtHe3mJOd8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkaZDD4w4qfVMeCZa0bejJRazycQ0jgBPVJT0IieOC1g&oe=6AF9E066"}, {"file_name": "vlcsnap-2026-09-23-11h45m42s393.png", "id": "1631182795040631", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823310_1631182798373964_3613391780924896043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds0g0xLYK-oQ7kNvwHX6Zaz&_nc_oc=AdoDL4CSMKoHdhzrU5lZy37BkErNGv5Vogs-24bxuvt_djJOng2_oaiBh4y6JfBUP-c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDQ5yDDJfG23jjXyJehE1IIk1Sqp6T7MqY_7teeOpwTw&oe=6AF9E733"}, {"file_name": "vlcsnap-2026-09-23-11h44m52s013.png", "id": "1998635227518191", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823837_1998635230851524_3341981790413832758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-3nMe_te1EQ7kNvwEaE_9u&_nc_oc=AdqpwmrPj_8-YG2lp12arzllZFxCZvW-xJvtqZOD-z7iICI5h69XjKkyqVqnubycvqM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYOAxJYgfb2fHHuwHz8dEuiGFX8GGanL9iJHcAXsyMhg&oe=6AF9DB17"}, {"file_name": "vlcsnap-2026-09-23-12h06m24s586.png", "id": "1076392291799396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823783_1076392295132729_320142557116443322_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXHSZaObew4Q7kNvwFZKgJN&_nc_oc=AdpYkuRb9LFS3STpEshntLZPU5nop2Bkhb3eHlj1M8ixfgkkX7-ABoOdZqiQQpwGpVw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfb21ywQE5ct4H7o_yizCLuvBWHmqJ0FqYTVwlQDOB_Q&oe=6AF9D2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2.png", "id": "1584058763044268", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823949_1584058766377601_7832919208048771240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCoqYRm3bloQ7kNvwF43CIA&_nc_oc=AdplMSpM3X-w-jpJuANLSR89sAHDJ0Yd8RqHh4qZx4VJms12Kd1vToULmB4-NQ1S9Cw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBvy8Lsida_2T1E_Ceylhy0apnFfy2_QCxv4V1Mkv6Kw&oe=6AF9CA17"}, "display_name": "Fire Response: Office Safety Training", "keywords": ["fire", "safety", "training", "education", "simulation"], "long_description": "**A fire breaks out at a desk in your office. Do you reach for water or CO2?**\n\n\n# **What you will learn**\n\n* How to recognise types of fire extinguishers and what they are built for\n* Which extinguishers are safe on energised electrical equipment, and which put you at risk of electrocution\n* The PASS technique: Pull, Aim, Squeeze, Sweep\n* How to approach, assess and put out a fire safely in a confined workspace\n\n\n# **Two modules**\n\n**Learning**\n\nA guided walkthrough. Prompts take you through extinguisher selection and correct technique step by step, with feedback the moment you go wrong.\n\n**Assessment**\n\nNo prompts, no hints. You face the scenario alone and are scored on whether you chose correctly and applied the technique properly.\n\n\n# **Why in VR**\n\nNobody learns fire response from a slide deck. Performing the actions yourself - lifting the right unit, pulling the pin, sweeping the base of the flames - builds the muscle memory that matters when it is real. And you can get it wrong safely, as many times as you need.\n\nFire classification and extinguisher guidance follow **EN 2 (Europe)**.\n\nBuilt by **Vector Reality**, a custom immersive training studio working with manufacturers across automotive, pharmaceutical and heavy industry.\n", "short_description": "A fire breaks out at a desk in your office. Do you reach for water or CO2?\n\nThis hands-on training experience teaches workplace fire response, built\naround the case most people get wrong: a fire involving live electrical\nequipment. Learn to identify extinguisher types, pick the right one, and\napply the PASS technique under pressure.\n\nTwo modules - a guided Learning mode that walks you through every step, and an Assessment mode that scores you with no help at all."}]}, "developer_name": "Vector Reality", "developer_privacy_policy_url": "https://www.vector-reality.com/privacy-policy/fire-response", "developer_terms_of_service_url": "https://www.vector-reality.com/terms-and-conditions/fire-response", "publisher_name": "Vector Reality", "support_website_url": null, "website_url": "https://www.vector-reality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ro"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1154558113760708"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1122016020265552_7382718789753896400_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc
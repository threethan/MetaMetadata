=7f30f&oh=00_AQQRNJHLj9kEz9eHmXyqkgxNu2vTZ8QDRIcQcAze8fO9Lw&oe=6B0B36D7"}, {"file_name": "vlcsnap-2026-09-23-12h06m24s586.png", "id": "1076392291799396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823783_1076392295132729_320142557116443322_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uge16R0GAvIQ7kNvwHi4QRI&_nc_oc=Adp6AtbnXdq-stFAxB5ZiBUNrwn0jIL0PLwLqwjy44hvUHvrHt5CV2ZCjxUkrmX1bls&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHn9LVywx-FhLd3_UdwUDU3hcj2Dkv0XyUzkAXvnbwiQ&oe=6B0B2E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2.png", "id": "1584058763044268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823949_1584058766377601_7832919208048771240_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKmtuWzAoswQ7kNvwEYj9c-&_nc_oc=AdozFYOSIF5PULnQ0IF6TEIZ917N5-JZWS-bombUOI2HYAN363tJjw5ll98LBjkqG4A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTd1T3WcDOOSXIxAR_dk_SdLykw8nHA1Vn9GZsgVTdsiw&oe=6B0B25D7"}, "display_name": "Fire Response: Office Safety Training", "keywords": ["fire", "safety", "training", "education", "simulation"], "long_description": "**A fire breaks out at a desk in your office. Do you reach for water or CO2?**\n\n\n# **What you will learn**\n\n* How to recognise types of fire extinguishers and what they are built for\n* Which extinguishers are safe on energised electrical equipment, and which put you at risk of electrocution\n* The PASS technique: Pull, Aim, Squeeze, Sweep\n* How to approach, assess and put out a fire safely in a confined workspace\n\n\n# **Two modules**\n\n**Learning**\n\nA guided walkthrough. Prompts take you through extinguisher selection and correct technique step by step, with feedback the moment you go wrong.\n\n**Assessment**\n\nNo prompts, no hints. You face the scenario alone and are scored on whether you chose correctly and applied the technique properly.\n\n\n# **Why in VR**\n\nNobody learns fire response from a slide deck. Performing the actions yourself - lifting the right unit, pulling the pin, sweeping the base of the flames - builds the muscle memory that matters when it is real. And you can get it wrong safely, as many times as you need.\n\nFire classification and extinguisher guidance follow **EN 2 (Europe)**.\n\nBuilt by **Vector Reality**, a custom immersive training studio working with manufacturers across automotive, pharmaceutical and heavy industry.\n", "short_description": "A fire breaks out at a desk in your office. Do you reach for water or CO2?\n\nThis hands-on training experience teaches workplace fire response, built\naround the case most people get wrong: a fire involving live electrical\nequipment. Learn to identify extinguisher types, pick the right one, and\napply the PASS technique under pressure.\n\nTwo modules - a guided Learning mode that walks you through every step, and an Assessment mode that scores you with no help at all."}]}, "developer_name": "Vector Reality", "developer_privacy_policy_url": "https://www.vector-reality.com/privacy-policy/fire-response", "developer_terms_of_service_url": "https://www.vector-reality.com/terms-and-conditions/fire-response", "publisher_name": "Vector Reality", "support_website_url": null, "website_url": "https://www.vector-reality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ro"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_mo
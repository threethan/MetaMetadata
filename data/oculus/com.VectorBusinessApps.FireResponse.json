file_name": "vlcsnap-2026-09-23-11h47m20s650.png", "id": "1792370368771604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1792370372104937_1311848144195871508_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIBCY3SPDMUQ7kNvwEjALcr&_nc_oc=AdqdLcRYsuAOsNrzhMsmNDWFUfguWx5qcAz05gjcrJVEG2hQ4YWDK8uu0OTm5tyy_yU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP95Y7lUAkrxgGG-uhLoHi_SaJ5kEXL8VV-5KVkYMDGBg&oe=6ADE2A21"}, {"file_name": "vlcsnap-2026-09-23-11h46m58s570.png", "id": "3346604595541558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_3346604598874891_317172700290349288_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx0qg8blzyoQ7kNvwF0bD-5&_nc_oc=Adr-gA39W_PhT0YMVPvFjkYM3AT5KAnEcqFRiZeuKt-2lq8mgIKt60gMHNmiP7w2ldg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLHuvbpSSvMh6QGF6FGfzCe8ovsUo845ZeSg5zVMXMSw&oe=6ADDF8A6"}, {"file_name": "vlcsnap-2026-09-23-11h45m42s393.png", "id": "1631182795040631", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_1631182798373964_3613391780924896043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpK9Y5b5GtcQ7kNvwGF_spe&_nc_oc=AdqfJS7f8iFelhQeGwUsCXmsZiT6QNFBnxyXi9cnVJ1Glcrad_xK7q4lC-xIQ3Eoq5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHbJF7DovxWA6NArM2vEqULOt1VHXXIfiEw3quYkXoNQ&oe=6ADDFF73"}, {"file_name": "vlcsnap-2026-09-23-11h44m52s013.png", "id": "1998635227518191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_1998635230851524_3341981790413832758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUl80Zjujs4Q7kNvwED-M9A&_nc_oc=Adp9O0pt6Rd71-_DY7F3FlA_rs-HxAY_lv-KjNSr_1RMcscdDV5D9FMT3Z5AauLuFy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWFdnKcl2c4B_vasFgxmRqmzjRJSYujvl5ZlH3SGySYg&oe=6ADDF357"}, {"file_name": "vlcsnap-2026-09-23-12h06m24s586.png", "id": "1076392291799396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823783_1076392295132729_320142557116443322_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIqBqFQm9eUQ7kNvwGQSwSg&_nc_oc=AdrqSCsy9-lFF-8hUTLIlyJaHWBxcr5P7_SDbO9-ANIicRg_1zavyx9KkVXg-IPtgN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwQklpa9avPuAamp6FgMIWMIQ1NkSfDqZiCRenKsxG7A&oe=6ADE235C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2.png", "id": "1584058763044268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1584058766377601_7832919208048771240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuvzgxB6QCsQ7kNvwF8t-2F&_nc_oc=Adpkpz3ROkyQ-VIZM8Z78ftGPsPAFM06m_Ew-CMqBFgem6RfDArI-5dTldt3jsyJbMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6TOW-_ufFcF46NZ1GdnO1qRDVpZUUUv1an2VF5Q9Oiw&oe=6ADE1A97"}, "display_name": "Fire Response: Office Safety Training", "keywords": ["fire", "safety", "training", "education", "simulation"], "long_description": "**A fire breaks out at a desk in your office. Do you reach for water or CO2?**\n\n\n# **What you will learn**\n\n* How to recognise types of fire extinguishers and what they are built for\n* Which extinguishers are safe on energised electrical equipment, and which put you at risk of electrocution\n* The PASS technique: Pull, Aim, Squeeze, Sweep\n* How to approach, assess and put out a fire safely in a confined workspace\n\n\n# **Two modules**\n\n**Learning**\n\nA guided walkthrough. Prompts take you through extinguisher selection and correct technique step by step, with feedback the moment you go wrong.\n\n**Assessment**\n\nNo prompts, no hints. You face the scenario alone and are scored on whether you chose correctly and applied the technique properly.\n\n\n# **Why in VR**\n\nNobody learns fire response from a slide deck. Performing the actions yourself - lifting the right unit, pulling the pin, sweeping the base of the flames - builds the muscle memory that matters when it is real. And you can get it wrong safely, as many times as you need.\n\nFire classification and extinguisher guidance follow **EN 2 (Europe)**.\n\nBuilt by **Vector Reality**, a custom immersive training studio working with manufacturers across automotive, pharmaceutical and heavy industry.\n", "short_description": "A fire breaks out at a desk in your office. Do you reach for water or CO2?\n\nThis hands-on training experience teaches workplace fire response, built\naround the case most people get wrong: a fire involving live electrical\nequipment. Learn to identify extinguisher types, pick the right one, and\napply the PASS technique under pressure.\n\nTwo modules - a guided Learning mode that walks you through every step, and an Assessment mode that scores you with no help at all."}]}, "developer_name": "Vector Reality", "developer_privacy_policy_url": "https://www.vector-reality.com/privacy-policy/fire-response", "developer_terms_of_service_url": "https://www.vector-reality.com/terms-and-conditions/fire-response", "publisher_name": "Vector Reality", "support_website_url": null, "website_url": "https://www.vector-reality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ro"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1154558113760708"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821704_1122016020265552_7382718789753896400_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc
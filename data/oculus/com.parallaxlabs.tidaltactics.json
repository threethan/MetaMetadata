D6D2"}, {"file_name": "24.png", "id": "642490048127827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393545_642490058127826_3346392086921032846_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DTfjEmTem0Q7kNvwHeWCH8&_nc_oc=AdofOQSRHMHJhKbCUToQAPP6BKKkRO-SWWzWIlkii9bYBPA9eoGimRMhgpeaHub0FJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0RSGs8Ci022vKNOY1g7bVmP-bwUxbPlky7-SIOUJS6g&oe=6AFDD512"}, {"file_name": "25.png", "id": "1148759066642548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391842_1148759069975881_5324017571307170397_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLQP1T9OCcAQ7kNvwGreFsl&_nc_oc=AdquM34sFLHyXiEo-TQFIvKAN4Yz8OIZQ-sESh3_z334UPLHF6As6NmyWbCOkQ72Row&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQT--22wfekniqP5drQ5QUf01gAbanF8qM2Smu9EfErQ&oe=6AFDE34E"}, {"file_name": "10.png", "id": "2121117478353113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391802_2121117481686446_3765153658084765789_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niz57xgk7gkQ7kNvwEJSXua&_nc_oc=AdqcpMJOiAXr0Xu7-voDopAfExYqGWVHojpiNpS__cP8B2NFi5H_p7qedaXFQSO2BIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw7J4HS9f8IJ9IoTiBn0mFySQSopkPklD42fBASSyAPQ&oe=6AFDD674"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tidal Tactics", "keywords": ["battleship", "strategy", "futuristic", "mixedreality"], "long_description": "# \u2693 DEFEND YOUR FLEET\nTidal Tactics, an immersive Mixed Reality game reimagines the classic board game, turning your room into a battlefield on the seas and where you command a fleet against a cunning foe that always anticipates your charge. You have a handful of weapons that require strategic recharging in order to destroy your opponent\u2019s fleet before yours! Every decision counts. Use your time wisely, deploy your arsenal carefully, and send their fleet to the depths!\n\n\nSet in a future where the rising tides have swallowed the land. Humanity in all its drive for progress could not preserve what it had, and instead has had to adapt to life aboard ships, forced to scavenge metal scraps for the maintenance of their homes. But there is only so much of this limited resource, leading to tense standoffs in battles against the machines they once built.\n\n# Key Features\n- **\ud83c\udfe0 Room Adaptation and Transformation**\n- **\ud83d\udd79\ufe0f Mixed Reality Integration**\n- **\ud83d\udca3 Intuitive throwing mechanism**", "short_description": "Tidal Tactics reimagines the classic board game, turning your room into a battlefield on the seas and where you command a fleet against a cunning foe that always anticipates your charge.  You have a handful of weapons that require strategic recharging in order to destroy your opponent\u2019s fleet before yours! Every decision counts. Use your time wisely, deploy your arsenal carefully, and send their fleet to the depths!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://parallax.co.in/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Parallax Labs Private Limited", "support_website_url": null, "website_url": "https://parallax.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "92174
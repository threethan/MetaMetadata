nWVJlDh-nepHgGPGM0ugKwakfTbs4TuEqy_NvQ&oe=69DB9434"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tidal Tactics", "keywords": ["battleship", "strategy", "futuristic", "mixedreality"], "long_description": "# \u2693 DEFEND YOUR FLEET\nTidal Tactics, an immersive Mixed Reality game reimagines the classic board game, turning your room into a battlefield on the seas and where you command a fleet against a cunning foe that always anticipates your charge. You have a handful of weapons that require strategic recharging in order to destroy your opponent\u2019s fleet before yours! Every decision counts. Use your time wisely, deploy your arsenal carefully, and send their fleet to the depths!\n\n\nSet in a future where the rising tides have swallowed the land. Humanity in all its drive for progress could not preserve what it had, and instead has had to adapt to life aboard ships, forced to scavenge metal scraps for the maintenance of their homes. But there is only so much of this limited resource, leading to tense standoffs in battles against the machines they once built.\n\n# Key Features\n- **\ud83c\udfe0 Room Adaptation and Transformation**\n- **\ud83d\udd79\ufe0f Mixed Reality Integration**\n- **\ud83d\udca3 Intuitive throwing mechanism**", "short_description": "Tidal Tactics reimagines the classic board game, turning your room into a battlefield on the seas and where you command a fleet against a cunning foe that always anticipates your charge.  You have a handful of weapons that require strategic recharging in order to destroy your opponent\u2019s fleet before yours! Every decision counts. Use your time wisely, deploy your arsenal carefully, and send their fleet to the depths!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://parallax.co.in/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Parallax Labs Private Limited", "support_website_url": null, "website_url": "https://parallax.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9217480628365815"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1317772490397433"}, {"status": "PUBLISHED", "id": "887146920626077"}, {"status": "PUBLISHED", "id": "1740596767325320"}, {"status": "PUBLISHED", "id": "844972601511949"}, {"status": "PUBLISHED", "id": "1535299187606270"}, {"status": "PUBLISHED", "id": "1354607246015387"}, {"status": "PUBLISHED", "id": "798649792923896"}, {"status": "PUBLISHED", "id": "2152852505179563"}, {"status": "PUBLISHED", "id": "1790365441563441"}]}, "baseline_offer": {"id": "844972601511949"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1317772490397433"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24758067327213894", "version": "0.2.70"}, "id": "1307673210119989", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8941120229335191", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24758067327213894"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "
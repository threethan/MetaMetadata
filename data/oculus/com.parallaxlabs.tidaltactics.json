1148759066642548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391842_1148759069975881_5324017571307170397_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLQP1T9OCcAQ7kNvwGreFsl&_nc_oc=AdquM34sFLHyXiEo-TQFIvKAN4Yz8OIZQ-sESh3_z334UPLHF6As6NmyWbCOkQ72Row&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQT--22wfekniqP5drQ5QUf01gAbanF8qM2Smu9EfErQ&oe=6AFDE34E"}, {"file_name": "10.png", "id": "2121117478353113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391802_2121117481686446_3765153658084765789_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niz57xgk7gkQ7kNvwEJSXua&_nc_oc=AdqcpMJOiAXr0Xu7-voDopAfExYqGWVHojpiNpS__cP8B2NFi5H_p7qedaXFQSO2BIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw7J4HS9f8IJ9IoTiBn0mFySQSopkPklD42fBASSyAPQ&oe=6AFDD674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 X 1440.png", "id": "789614556814128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819836_789614563480794_567469214930403718_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcoSWzYK1YwQ7kNvwFb8tca&_nc_oc=AdpsgWeYPQ4xJdAJ_j8_wrK5tzubfrdApniMq9nejVrp3SsEr32ewIJCsl12AZ9TgRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc-sB-gnDsvhzu2yHBwvDgvJPYjX4m5SORgjtb9vjbsA&oe=6AFDDC98"}, "display_name": "Tidal Tactics - Ship Battle", "keywords": ["battleship", "strategy", "futuristic", "mixedreality"], "long_description": "**Tidal Tactics** \u2013 Get onboard captain, for the most immersive and explosive Ship-Battle ever!! \ud83d\udea2\ud83c\udf0a Transform you living room into a battlefield and literally bomb your floor to discover & destroy the hidden enemy ships. \n- Single Player and Local Multiplayer (PvP) available \n\n{3756362711335353}\n\n#BreakYourFloor\n\n**PLAY SINGLE PLAYER** \ud83d\udd25\n- Challenge a self-evolving entity that comes back smarter after every defeat\n\n**LOCAL MULTIPLAYER (PvP)** \ud83c\udfc3\u200d\u2640\ufe0f\u200d\u27a1\ufe0fvs\ud83c\udfc3\u200d\u2642\ufe0f \n- Challenge friends or foes to a battle in your very room or backyard and become the smartest captain! \n\n{1044210494302247}\n\n**KEY FEATURES**\n- \ud83d\udca5Turn your room into a battlefield and destroy your floor\n- \ud83c\udfc3Move through your space to manage resources and recharge your weapons\n- \ud83d\udca3Choose from a range of classic weapons (Sonar, Airstrike and a new high-damage hammer!)\n\n{1119133509703811}\n\n**REQUIREMENTS**\n- \ud83d\udccf Room-scale requirement: 100 sq ft minimum\n\n**NOTE**  \n- Your feedback helps us improve. If you\u2019ve enjoyed Tidal Tactics, please take a moment to leave a review!", "short_description": "**Forget the board. You\u2019re in the game now.**\n\nYour floor? Ocean. Your space? A warzone.\nTidal Tactics transforms your room into a live battlefield\u2014where strategy meets Mixed Reality.\n\nDodge missiles, launch attacks, and outmaneuver your enemy in real space.\n\nA classic grid-based game, reimagined from the ground up.\n\nYou asked, we delivered \u2013 multiplayer mode is officially live! Challenge real players and rule the room \ud83c\udfc3\u200d\u2640\ufe0f\u200d\u27a1\ufe0fvs\ud83c\udfc3\u200d\u2642\ufe0f #BreakYourFloor\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://parallax.co.in/privacy", "developer_terms_of_service_url": null, "publisher_name": "Parallax Labs Private Limited", "support_website_url": null, "website_url": "https://parallax.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
MTL8LT3Pv14wI-ILURWs1f9F8DZk47E6QDGsLe4g&oe=6AAAA444"}, {"file_name": "Screenshot 2026-02-06 20-06-36.png", "id": "898900732930508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_898900736263841_6610868738088847134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXPPL16RYYwQ7kNvwF5D5uY&_nc_oc=Adrd5vTVWlYPIyMvHNMEx_ytBht3IMkavUPzADmzviUy7OvhIozrHZ_ZctW-v76yByA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2K2pxZfuG8eE99oVptiWE3-lM40yb0stZyR_U6M-WVQ&oe=6AAA9EB7"}, {"file_name": "Screenshot 2026-02-06 20-07-50.png", "id": "2048581302376666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618197_2048581305709999_3444229963708738890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0QecKxM0agQ7kNvwHbS26f&_nc_oc=AdpfZAx8S2sCa4BsDxDXtuQCCHHwReyZjQi8KRSAiMHiZdcgIjnZxaEns9ExWkmycfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuXDO4NqJwI3i_3Pw2DuOcKpimthod-STb6LQpcFGqwQ&oe=6AAA89C0"}, {"file_name": "Screenshot 2026-02-06 20-07-02.png", "id": "1558648311909848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297447_1558648318576514_9116444095924218597_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQx4euR-2sAQ7kNvwFcpzfP&_nc_oc=AdpVo6J2pekuUIO4LGZAc4GO6uRsYcqvexy0bN4o_HqSzI5dzcjaeC7Q30qaUyEzVVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlkxhbyzuGoSubSfyBFnE0nDnMUUq7rRCLxNZd3CXpzA&oe=6AAAA69A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiny Restorations", "keywords": ["Assemble", "Cozy", "Simulator", "Construct", "Build"], "long_description": "Step into a quiet garage where unfinished projects and family memories wait to be restored. In this hands-on VR experience, you assemble, repair, and clean a series of objects owned by your grandparents from small household builds to larger, more meaningful creations. Each completed task unlocks new tools, hidden parts, and personal memories told through photos and voicemails, slowly revealing a story about time, intention, and the things we mean to finish.\n\nThe gameplay focuses on tactile interaction: fitting parts together, removing rust, painting surfaces, and exploring the space for lost components. As the garage evolves, so does the narrative, blending restoration mechanics with emotional storytelling. Optional discoveries reward curiosity, encouraging you to look closely at your surroundings.\n\nDesigned to be calm and immersive, the experience emphasizes the satisfaction of rebuilding something with care. Every object carries a sense of history, and every repair brings you closer to completing a final project that ties the story together, a reminder that even unfinished work can hold lasting meaning.", "short_description": "Restore forgotten projects in a cozy VR garage filled with memories. Assemble, clean, and rebuild items owned by your grandparents while uncovering their story through photos and voicemails. Each repair reveals new tools, hidden details, and heartfelt moments in a relaxing, hands-on restoration journey."}]}, "developer_name": "Creeda, Final Boss Editing, Jeff Meyer", "developer_privacy_policy_url": "https://docs.google.com/document/d/12PmKTl7F9LSMS3Oal7ACxKiele43Q7WuDW4qvXntuZI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Creeda, Final Boss Editing, Jeff Meyer", "support_website_url": null, "website_url": "https://www.creeda.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], 
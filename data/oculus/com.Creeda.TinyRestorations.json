8_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZpuSVw_X2sQ7kNvwGLRwnX&_nc_oc=Ado_FAqQNqc2VW1Eem7-qGeY6DLXsxNRdKAa1oIIzAlVNEQzD2JH-tjHcHrRChRDqWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8lNlBBSY1X3zrkdXfewJNz2OLfTopaV3hrIkbOzeIhQ&oe=6AAA8C5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1298037465559100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507827918_1298037468892433_2498484182499252856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PdQPF4BDrkQ7kNvwFuHJb0&_nc_oc=AdpmEx_zqEltBDqud1fAcya4C72UPL0jtBv4kmejFdhOf-NKpwpAkA8RBcsU7KGmvHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhFZI1X6gbTrLvioHGjotwFQs7l7hyYzN94RsvQtdsnQ&oe=6AAAB6A0"}, "display_name": "Tiny Restorations Prologue", "keywords": ["Assemble", "Cozy", "Simulator", "Construct", "Build"], "long_description": "Step into a quiet garage where unfinished projects and family memories wait to be restored. In this hands-on VR experience, you assemble, repair, and clean a series of objects owned by your grandparents from small household builds to larger, more meaningful creations. Each completed task unlocks new tools, hidden parts, and personal memories told through photos and voicemails, slowly revealing a story about time, intention, and the things we mean to finish.\n\nThe gameplay focuses on tactile interaction: fitting parts together, removing rust, painting surfaces, and exploring the space for lost components. As the garage evolves, so does the narrative, blending restoration mechanics with emotional storytelling. Optional discoveries reward curiosity, encouraging you to look closely at your surroundings.\n\nDesigned to be calm and immersive, the experience emphasizes the satisfaction of rebuilding something with care. Every object carries a sense of history, and every repair brings you closer to completing a final project that ties the story together, a reminder that even unfinished work can hold lasting meaning.", "short_description": "Restore forgotten projects in a cozy VR garage filled with memories. Assemble, clean, and rebuild items owned by your grandparents while uncovering their story through photos and voicemails. Each repair reveals new tools, hidden details, and heartfelt moments in a relaxing, hands-on restoration journey."}]}, "developer_name": "Creeda, Final Boss Editing, Jeff Meyer", "developer_privacy_policy_url": "https://docs.google.com/document/d/12PmKTl7F9LSMS3Oal7ACxKiele43Q7WuDW4qvXntuZI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Creeda, Final Boss Editing, Jeff Meyer", "support_website_url": null, "website_url": "https://www.creeda.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27319297874363021"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313110_1741989256771428_2639611576082711809_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVrF3qspXWEQ7kNvwF2KAcC&_nc_oc=AdpIe1BCLV_suKRGtjDOiV3Z_Dg3Ns5fkDvy8nnU5pHQD3xD-ZgQFkQrvoy2oFg56Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd4OovarIan3OyvBTW9WrZWyJwKrD3kZzBGz-OhPAizQ&oe=6AAA93C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tiny Restorations Prol
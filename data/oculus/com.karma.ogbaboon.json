0f&oh=00_AQQZFMEe6AVjju-VGM4F3blP_Hbcq_260HShNHzox5vbqQ&oe=6AFC8187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "th (15)_resized.png", "id": "609527145377372", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391860_609527148710705_9067916871193083651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KV1QBKUuOsQ7kNvwE2m_hV&_nc_oc=AdrAMaK5y89fk89yWY7al9RTI_quBqbXuXxlHGdYv-UN2CcrFHh99B1JdnOrKRJK9Fo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2SnMPTpj-5SoyAQSqn12I3xscRo3OtU0-qlWx6OhCbQ&oe=6AFC95EF"}, "display_name": "OG Scary Baboon", "keywords": ["scarybaboon", "ogscarybaboon"], "long_description": "Welcome to OG-Scary Baboon, a chilling horror game that thrusts players into a nightmarish facility where escape is not a option. Set in a light, atmospheric environment, this game combines the elements of suspense, strategy, and adrenaline-pumping action. Players must navigate through treacherous hallways while evading various terrifying creatures in a desperate bid for survival. The game not only features intense gameplay but also offers an array of customization options and intriguing game modes that enhance the overall experience.", "short_description": "OG-Scary Baboon is a old scary baboon horror game where you run away from monsters and there's cosmetics and grabbables and game modes and all sorts of stuff to do!"}]}, "developer_name": "Karma", "developer_privacy_policy_url": "https://docs.google.com/document/d/1-j3qsigaUf3RMtH7xxkIZpo_EvgZbgT3EX-Ci9_6fpo/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "ZRMKarma", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1-j3qsigaUf3RMtH7xxkIZpo_EvgZbgT3EX-Ci9_6fpo/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id
310646_1799461288104267_7284540719430935214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvvK5e4lITgQ7kNvwESbYk3&_nc_oc=AdqbL8yHNRJLuHP-L5V10WIPFG4YY-kViPbisCV_xhK7x_FQTFWG0pyKZAWxCBQz5ew&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLxzTjAVxhAoywiu--HqaMbaZCGHBBlZgH58L0eSl7Sw&oe=6AF9DE87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "th (15)_resized.png", "id": "609527145377372", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391860_609527148710705_9067916871193083651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcK7WLybMCsQ7kNvwF0Hq19&_nc_oc=Adqt8ZcznZuI_g-rO7vwiAlUgPfNQzJugB7ica2W3mgU-v7CqZkZ_nbMam-DoUn73hM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA_AhIfDSng2oL5zpoWCIO7aLVRLG_ExoTjmL1hnZJbw&oe=6AF9BAAF"}, "display_name": "OG Scary Baboon", "keywords": ["scarybaboon", "ogscarybaboon"], "long_description": "Welcome to OG-Scary Baboon, a chilling horror game that thrusts players into a nightmarish facility where escape is not a option. Set in a light, atmospheric environment, this game combines the elements of suspense, strategy, and adrenaline-pumping action. Players must navigate through treacherous hallways while evading various terrifying creatures in a desperate bid for survival. The game not only features intense gameplay but also offers an array of customization options and intriguing game modes that enhance the overall experience.", "short_description": "OG-Scary Baboon is a old scary baboon horror game where you run away from monsters and there's cosmetics and grabbables and game modes and all sorts of stuff to do!"}]}, "developer_name": "Karma", "developer_privacy_policy_url": "https://docs.google.com/document/d/1-j3qsigaUf3RMtH7xxkIZpo_EvgZbgT3EX-Ci9_6fpo/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "ZRMKarma", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1-j3qsigaUf3RMtH7xxkIZpo_EvgZbgT3EX-Ci9_6fpo/
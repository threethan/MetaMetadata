5q8Ube3nBN1ZTMmew63M2cRsnSNSVpk4BUSp9So-TDu2P283tAno&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rwpY8io6nasmE0fGXL8xLiIE_-J6KylamPWWmG5F_IA&oe=6A1D902F"}, "display_name": "OG Scary Baboon", "keywords": ["scarybaboon", "ogscarybaboon"], "long_description": "Welcome to OG-Scary Baboon, a chilling horror game that thrusts players into a nightmarish facility where escape is not a option. Set in a light, atmospheric environment, this game combines the elements of suspense, strategy, and adrenaline-pumping action. Players must navigate through treacherous hallways while evading various terrifying creatures in a desperate bid for survival. The game not only features intense gameplay but also offers an array of customization options and intriguing game modes that enhance the overall experience.", "short_description": "OG-Scary Baboon is a old scary baboon horror game where you run away from monsters and there's cosmetics and grabbables and game modes and all sorts of stuff to do!"}]}, "developer_name": "Karma", "developer_privacy_policy_url": "https://docs.google.com/document/d/1-j3qsigaUf3RMtH7xxkIZpo_EvgZbgT3EX-Ci9_6fpo/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "ZRMKarma", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1-j3qsigaUf3RMtH7xxkIZpo_EvgZbgT3EX-Ci9_6fpo/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_mode
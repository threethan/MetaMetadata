8890_900511262410531_8058452727361575679_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNCRQEB5Ql0Q7kNvwE0Y9jV&_nc_oc=AdoUngakyCU4SBo7-0AwBSQVHrW1SrF-kw7GfEQDl09OicUnnR-U_0BcP0lYgKpAX1o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94T2-OJ6bAlUddjxEs1geOKd6tyDGwVjy8tbfk86ymzQ&oe=6A3D5410"}, {"file_name": "\u622a\u5c4f2025-12-29 00.33.00.png", "id": "1202839497933219", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830147_1202839501266552_6518269739086202660_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-OTl4Ji0AMQ7kNvwF0Y3Gw&_nc_oc=Adpy5PvGuUdHDLp9BUqpkkMZzWHj7D5432I5OuFDyrNCjl1v4sXFVMdDG9LfCNXoGDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jEusB7SONePttsFd7vl5KJGuYvyJG89KkzjOshFmtyQ&oe=6A3D25AE"}, {"file_name": "\u622a\u5c4f2025-12-29 00.34.08.png", "id": "2015080125721154", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819859_2015080129054487_8068389282404597371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKPnUzj-pMkQ7kNvwExRW6w&_nc_oc=AdqUs-KhBXHrOLf6cwur5yhGbY41hWrY7oqWKtkol-lBkcFIFR6TH18_pK_9LKYOjJU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q96QwOWTwwuHizOGM2atdqkWzyzJrUNPQ8YW9cIIOcg&oe=6A3D3714"}, {"file_name": "\u622a\u5c4f2025-12-29 00.34.47.png", "id": "1448566330024167", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819239_1448566333357500_4340923775832866343_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76IgdshffuQQ7kNvwFyLq1P&_nc_oc=AdrcK6Lj73Otjs1f3zxmvP4gizJHBDSIZ-v4gv3avQYKc-J_RGy-riPIu9fFacKhdK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VeKGGZPbFgjwp89Zq2E7bL-qBtmWoZyPLO5YD0HPXhQ&oe=6A3D54C5"}, {"file_name": "\u622a\u5c4f2025-12-29 00.35.42.png", "id": "805994212485811", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/585741071_805994215819144_5507402624573385999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8T89q9FtLwQ7kNvwF_oFvN&_nc_oc=Ado9OCf_1MZnuPYgk49DyYSVsoJnEIz-bKw1lohXVGzOJZP0ZbjIWBoBXCRhi0fH6Go&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Nd49ToFVJwJyTuk3-9s4PyB2z6DBvBy0gRHTDkwIoDA&oe=6A3D5373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "122.png", "id": "2048846992581670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_2048846995915003_2220623875527525150_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvy2jA5Yd18Q7kNvwHsAgBN&_nc_oc=AdoxTKZbAOSjsdKv1dKDLy5wNA3UTIqeSc5AgcQ5UuMa0tU4k5IOZ036vfujTT6zUR4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YOPKGJvdrXTlES-jpGyfR3p0C1WWOGGVLgvPTnm8WUQ&oe=6A3D3391"}, "display_name": "Mini Golf Mania: Mixed Reality Mini Golf", "keywords": ["golf", "minigolf", "sandbox", "putt", "sport"], "long_description": "Hey mini-golf enthusiasts - dive into a whole new dimension of putting action with Mini Golf Mania (MGM for short) \u2014 this ultimate MR mini-golf sandbox game is redefining the joy of mini-golf putting.\n\n**Powerful and creative mini-golf sandbox editor**\n\nWith Mini Golf Mania\u2019s sandbox editor, you can craft the mini-golf levels of your dreams. Use straight paths, ramps, looped tracks, and a wide variety of functionality modules and obstacles, paired with multiple themed decorations \u2014 imagination is your only limitation.\n\n{1941612960043212}\n\n**Enjoy the comfort and convenience of mixed reality**\n\nMini Golf Mania transform your living room or backyard into a personalized course. As rich course challenges unfold in your home space, you can enjoy MR mini-golf fun while watching TV, taking care of pets, or keeping an eye on the kids.\n\n{914886277636509}\n\n**Library of themed challenges in both VR and MR**\n\nMini Golf Mania boasts a curated library of vibrant, themed maps that are regularly updated that can be played both in VR and MR. A roguelike mode will also be added in the future \u2014 every round will be a fresh, thrilling adventure.\n\n{1494525764972704}\n\nMini Golf Mania is waiting to turn your space into the ultimate mini-golf playground. Don\u2019t just play mini-golf\u2014reimagine it!\n\n", "short_description": "Mini Golf Mania (MGM) is the ultimate MR sandbox game redefining putting fun, featuring a versatile Sandbox Editor that lets you craft dream courses with paths, ramps, obstacles and themed decorations, where your imagination is the only limit. It transforms your living room or backyard into a personalized course, letting you enjoy MR mini-golf while handling daily tasks like pet care or watching TV, and also offers a regularly updated library of vibrant VR/MR themed maps to keep the fun going. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW", "ja", "fr_BE", "fr_CA", "fr", "de", "de_CH", "gsw", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt", "ru", "ru_UA", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24722111057461881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculusc
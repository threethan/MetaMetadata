iler": null, "video_trailer_thumbnail": {"file_name": "JTree Cover Image Landscape 2560x1440.png", "id": "965306188237605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031447_965306194904271_7077200833149067803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsYi22JjEbYQ7kNvwHcr102&_nc_oc=AdnP3MvtlBu7h8s1nSN5mSBSSQYP_g5LnArSGxTtnwqWbYHV5soGCugto97blMpojRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFz9abup1V02QL7pfIY3FUpKMCrDPgfSQJ1uDPgA7sSA&oe=69B80C61"}, "display_name": "Joshua Tree Music Festival 2023", "keywords": [], "long_description": "Joshua Tree Music Festival (JTMF)  happens twice a year in May and October.  We captured and produced immersive video from six of the best performances at JTMF Oct 2023 and produced them in VR so that anyone in the world can attend this amazing event virtually.", "short_description": "Relive the Joshua Tree Music Festival in VR!  This app includes six performances from JTMF October 2023 from Nicky Genesis, Father Taj, Alcazar, The GetDown, and More.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pulsejetstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "PulseJet Studios", "support_website_url": "https://www.pulsejetstudios.com/support", "website_url": "https://www.pulsejetstudios.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
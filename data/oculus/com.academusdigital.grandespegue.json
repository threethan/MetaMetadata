culuscdn.com/v/t64.5771-25/499295992_1851259552548121_973354324516286681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsup0WtHUEIQ7kNvwHl4uJg&_nc_oc=AdrAZsOnGCztyKnnFfq-25XcbSM3-MXHlD9ped7PcpY7yk84EpPy4APFfWGkvBr4IAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2B50uKI1-0_X85GgUWnETdfHF0h0QRrBGOIl-yXRz6Q&oe=6AE0AF04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gran Despegue", "keywords": [], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}, {"images": {"nodes": []}, "id": "946817321835977", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "El Gran Despegue", "keywords": ["matem\u00e1ticas", "educaci\u00f3n", "n\u00fameros"], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.academusdigital.com/politica-de-privacidad-apps/", "developer_terms_of_service_url": null, "publisher_name": "AcademusDigital", "support_website_url": null, "website_url": "https://www.academusdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374799372393574"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1121562676938587"}]}, "baseline_offer": {"id": "1121562676938587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792003620, "status": "PUBLISHED", "id": "1121562676938587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "
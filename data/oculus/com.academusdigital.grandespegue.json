.5771-25/499294644_1638573614597149_3926426430947170408_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKc1MTzpcuoQ7kNvwE7AW46&_nc_oc=Ado9XRpTUAVHHSSAB-qnYxasfwsqxHAbE80iY13j6LA-i3mx6Annv6d2Q2tYF13eBxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe3OcL71279AMFhm4pvw07oveNVvP624m4p_bXtwt5xw&oe=6AEF3647"}, {"file_name": "01_Menu_GranDespegue.png", "id": "1335910585147646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_1335910588480979_658491387797832245_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mTW4eN0OW0Q7kNvwHXG2o3&_nc_oc=AdpSap-vfMHgCCJ0bavQLh1nHJb7pUBqjtsfvPIQcXtPEh7fylssNPj5XFhLNyA4MXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr-3LcuMpSyPc3ssLkFTiKpB5yaeaEvFfl_bdLmq7VwQ&oe=6AEF4046"}, {"file_name": "04_Agrupacion_Decenas.png", "id": "1851259545881455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295992_1851259552548121_973354324516286681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6bcVrCxL-0Q7kNvwHMPPe5&_nc_oc=AdpBF_5KK53lj1NAFCyy5mbX8IzLu3ketZIBrwEGE37O87L_xL66qTMw0kj013Sa3dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOKvuLiwvRQSwacSTB2rtcs67oQdNQFLiEBJJfFRi8lA&oe=6AEF67C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gran Despegue", "keywords": [], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}, {"images": {"nodes": []}, "id": "946817321835977", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "El Gran Despegue", "keywords": ["matem\u00e1ticas", "educaci\u00f3n", "n\u00fameros"], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.academusdigital.com/politica-de-privacidad-apps/", "developer_terms_of_service_url": null, "publisher_name": "AcademusDigital", "support_website_url": null, "website_url": "https://www.academusdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "
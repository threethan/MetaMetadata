.5771-25/499294644_1638573614597149_3926426430947170408_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nPr6W1YQWAQ7kNvwFbKpL1&_nc_oc=AdqCPpuWtUMDpwIH4j9HJcW39AuuwZVRmChZnFrZVk1DbXj-LIv9NGI8WV9LRNfcaOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSRMHI4BveyOmupUSvSYmai0tATLycyznXx60odyn6CA&oe=6AE9F047"}, {"file_name": "01_Menu_GranDespegue.png", "id": "1335910585147646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_1335910588480979_658491387797832245_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpu65Hx2MAcQ7kNvwGFXBhI&_nc_oc=AdpnlE6CKKdPcppxZI4isOKPC_nEk-prIaaRTlVmAkKxbLD0UH8Eyxk35d2DofMLksI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDVnKTYlma1eRRYWVN2LLypCiwJkYNcW4N-QGm5BnvMg&oe=6AE9FA46"}, {"file_name": "04_Agrupacion_Decenas.png", "id": "1851259545881455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295992_1851259552548121_973354324516286681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IbtBdBaj_cQ7kNvwGWgRSb&_nc_oc=AdoDlJgBIoTmKXhiUrgfbZNpayIQI5QUNz4dQ5RTxmk3hKg7ee1485tIlGqsaxKMo8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDk1Mdjbi1Yzw5Q-9_jkLq5853k0eLXWgoOxidgbIlmQ&oe=6AE9E984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gran Despegue", "keywords": [], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}, {"images": {"nodes": []}, "id": "946817321835977", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "El Gran Despegue", "keywords": ["matem\u00e1ticas", "educaci\u00f3n", "n\u00fameros"], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.academusdigital.com/politica-de-privacidad-apps/", "developer_terms_of_service_url": null, "publisher_name": "AcademusDigital", "support_website_url": null, "website_url": "https://www.academusdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "
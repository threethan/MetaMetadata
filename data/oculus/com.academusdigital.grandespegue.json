.5771-25/499294644_1638573614597149_3926426430947170408_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noWtwj-9No4Q7kNvwFe__qL&_nc_oc=Adp1NAypfMVhOLKrRo0LEnVL6T1zf3MQnTsPU77SFQtIpQdLL776l69o1OykpkNnvE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrBnGnD9qW7ETQHglUyT2sA-muUqwb0qpOeY9jqIjRuw&oe=6AF47C47"}, {"file_name": "01_Menu_GranDespegue.png", "id": "1335910585147646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_1335910588480979_658491387797832245_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Tp2NQzII28Q7kNvwFZGTAo&_nc_oc=AdokVi_aNhUmdBDe7OKiVR7kgKM3aamoE0y_PtlqPQgxHsk2jjwHHu8ox9HpLv1JarU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZZLH098Go0GA2wmzJin2ZzBdIdJB6xCqHDaSnGLAS2w&oe=6AF48646"}, {"file_name": "04_Agrupacion_Decenas.png", "id": "1851259545881455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295992_1851259552548121_973354324516286681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pb687nDFOhoQ7kNvwGOEGQ_&_nc_oc=AdpWzDFtHS9INrEV1l2bkWnJU1QwjDyhmnWI0vCUJsz8eyzn-RlqNaWxSq94Y87SbM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFiDxoYiceAcmQaApuW1Gmr5H6ZdQhY_ZBW7RmnUfntg&oe=6AF47584"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gran Despegue", "keywords": [], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}, {"images": {"nodes": []}, "id": "946817321835977", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "El Gran Despegue", "keywords": ["matem\u00e1ticas", "educaci\u00f3n", "n\u00fameros"], "long_description": "El Gran Despegue es una experiencia educativa en realidad virtual para explorar c\u00f3mo se forman los n\u00fameros a partir de unidades, decenas y centenas.\n\nManipula cubos, barras y placas para representar cantidades y resolver desaf\u00edos. Avanza por las actividades, combina unidades y decenas, y descubre c\u00f3mo se construye una centena mientras preparas el lanzamiento del cohete.\n\nLa experiencia permite practicar el valor posicional mediante objetos que puedes observar, tomar y colocar con los controles del visor. Cada actividad conecta la representaci\u00f3n de una cantidad con su n\u00famero correspondiente.\n\nUna aventura matem\u00e1tica que invita a aprender mediante la exploraci\u00f3n y la pr\u00e1ctica.", "short_description": "Explora unidades, decenas y centenas en una aventura de realidad virtual. Manipula bloques, forma n\u00fameros y supera desaf\u00edos matem\u00e1ticos para preparar el gran despegue."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.academusdigital.com/politica-de-privacidad-apps/", "developer_terms_of_service_url": null, "publisher_name": "AcademusDigital", "support_website_url": null, "website_url": "https://www.academusdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "
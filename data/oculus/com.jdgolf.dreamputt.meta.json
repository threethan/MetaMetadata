7a0a&_nc_ohc=0htdyxmvL3EQ7kNvwGpAY7N&_nc_oc=AdoUhb5QRNo6jQLB3kfq46EF3iIY9e4l_9uRabmIH4kZHHzpEd5vuKgmWpKg3uioIzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXYMRXuY2d5oacNDxmbcgKNLt8HVxoQffB5E5veJCBSw&oe=6AF20799"}, {"file_name": "meta_training_aids_screenshot.png", "id": "1889897958645982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654922264_1889897961979315_7505087733875023722_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWH8Vnv2AOEQ7kNvwG9j3iM&_nc_oc=Adpu5LMJ6oYF4vgKX61PWCD5XB_8yg_2chYt1zq6VskIEu6eE8sqOS_3MhyrO3O4ziI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_GjSIi9fJUlSUBlIdgLiS6-sFLFruPWg5QkFj5_7WEQ&oe=6AF1E9C1"}, {"file_name": "dp_meta_performance_trends.png", "id": "1041554925574440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303471_1041554928907773_4914293638558289651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yJ7EQ8SVkkQ7kNvwFLsX2t&_nc_oc=AdqXAqHRS-A9eEQdzjt73Pe7r1uzmQg-akp5iPdZ4pAqtEgv9vwx6BXAVpobysXXBz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnTcgv1xvwCDUFilR93jaM67KI6065uhQ6LadxkQ-H1A&oe=6AF1FCFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dream_putt_trailer_video_cover_image.png", "id": "2383960339079885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308043_2383960345746551_4828014599960428775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbKXgmiw9IkQ7kNvwHBVzBD&_nc_oc=AdoKdQU_nJqNOkKZSH0wE3yM9ekHduBprrCaq1p2KAxhjSiO-Ci08LpXzzbdeYWmfuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjMTZFHFuyDV4fLQId1EKBvIlCrpd2RCAzoMZphEPz7A&oe=6AF1EF6B"}, "display_name": "Dream Putt", "keywords": ["golf", "putting", "simulator", "putt", "putter"], "long_description": "# YOUR PORTABLE, INFINITE PUTTING STUDIO\n\nPutt with your real putter and ball on tour-level greens, anywhere indoors.\n\n100+ championship courses \u2014 every 2027 tour venue plus international and major venues \u2014 at full scale from real green topography data.\n{2191411091752523}\n# PRACTICE THE IMPOSSIBLE\n\n- Any pin, from anywhere on the green\n- Green speeds from 4\u201316\n- Custom hole sizes + ghost holes\n- Flagstick in or out\n- Wind at any speed and direction\n- Relive over 50 of golf's historic putts with Moments\n{28744232428520183}\n# ACCELERATE YOUR IMPROVEMENT\n\n- 1000+ drills: start line, distance control, green reading, mindset\n- Dynamic greens \u2014 any break on any slope\n- Randomized on-course scenarios\n{1434190562169726}\n# TRAINING AIDS\n\n- Alignment line\n- Tee gate\n- Customized putting arc\n- Animated stroke model\n- Metronome\n- Eyeline guide\n{1426051099495361}\n# READ GREENS YOUR WAY\n\n- Animated break grid\n- Slope measurements\n- Slope heatmap\n- Optimal line\n- Break zone and apex\n- Slope arrows\n{29721883677400919}\n# TRACK YOUR PROGRESS\n\n- Make rate\n- Miss tendencies\n- Strokes gained\n- Launch speed and angle\n- Performance trends and rating\n{958174776852402}\n# BUILT FOR META QUEST 3/3S\n\nMixed reality merges your room with championship greens \u2014 see your real putter and ball as you practice.\n\nNo launch monitor required! Just a real putter, a ball, and 16 sq ft of free space.\nFree demo; full access by subscription.\n\n**REAL PUTTS. REAL GREENS. REAL PRACTICE.**\n\nTerms: https://www.dreamputt.app/terms\n\nPrivacy: https://www.dreamputt.app/privacy\n", "short_description": "Turn any room into your own putting studio. Putt with your real putter and ball on 100+ championship courses \u2014 every 2027 tour venue plus international classics, built from real topography data.\n\nSet the stimp, hole size, pin, and wind. Sharpen up with 1000+ drills, training aids, green-reading overlays, and strokes gained analytics. Relive golf's historic putts from the legends' POV.\n\nNo launch monitor needed \u2014 just a putter, ball, and 16 sq ft of space.\n\nReal putts. Real greens. Real practice."}]}, "developer_name": null, "develop
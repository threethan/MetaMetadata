ex_screenshot.png", "id": "1979519389692775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/765553549_1979519393026108_5349470630797917220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijfn5mAoMCMQ7kNvwGc8Ow2&_nc_oc=Adp0-JWTw0U9g7oAowoLhCEQcuJI4hendYhJhAsz-LVjrPmuTYsAMxFcl2NGEGtA66A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4eB9WvHSZvjcZCIsA1MZCzjoCsLUpMsDt5UEyNFfCow&oe=6AF71A27"}, {"file_name": "dp_meta_heatmap.png", "id": "1545013340728840", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300725_1545013344062173_7719053898938564907_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI_SRuH-hrMQ7kNvwFYy4L9&_nc_oc=AdplPriWC3IMdBw8EuKikJYckCDDTScQ4sLYetKaily8ICDC1Xjqnl10FB1XKvrihLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmyUm1-I2dDy3xpzdytG-xpfimDhg0ZL2IDGqGPxYpcw&oe=6AF737EA"}, {"file_name": "dp_meta_drill_screenshot.png", "id": "1813165606497879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292232_1813165609831212_9195778264428708949_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZgMmR7JCE8Q7kNvwE7fTb1&_nc_oc=AdpsLlPUF78318yuuIM9IEV0drzOymBZKYm2kGUpFA5XWEUlD1XF12IjK24jUlm5Q_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2HL-AXOqaw4y70XBFttR0SMG_fcRzOExrWJ8NJ0431g&oe=6AF71559"}, {"file_name": "meta_training_aids_screenshot.png", "id": "1889897958645982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654922264_1889897961979315_7505087733875023722_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYAWrdwxOSwQ7kNvwG1fyrD&_nc_oc=AdqVWnxH1JnuUsyFfej-oQXnYR5IRLnEvOL83CiubYw8cEKG-GxOiqeRUWkiO-frFJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL4L-noNSsXNyItRarhaYcFBH2-NEvjCUouL3wN7V7yw&oe=6AF72FC1"}, {"file_name": "dp_meta_performance_trends.png", "id": "1041554925574440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1041554928907773_4914293638558289651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWnOpmlJzfwQ7kNvwFwzdfy&_nc_oc=AdqN0QOvbyII5LxNtpNohfbFxzZpPpKhMR7I-Aft1e4O8uQFkkSU8M-wt8e4KaRA6n8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOxJCVXOvfdgkVQtWgCbSVeduvjqPOpQtQNbGJPorRzg&oe=6AF742FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dream_putt_trailer_video_cover_image.png", "id": "2383960339079885", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308043_2383960345746551_4828014599960428775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvrC7LWP-10Q7kNvwGbfnKd&_nc_oc=AdqPhojvPfFrNqZrjDk81nodLkHXRubPLVIjiaf-5tR4YoyCS_TUzXD0Id_K0kajXfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqJCq5TToG_zsHCOk9-HTjTLkLSKu0scleHSbOFEcKhQ&oe=6AF7356B"}, "display_name": "Dream Putt", "keywords": ["golf", "putting", "simulator", "putt", "putter"], "long_description": "# YOUR PORTABLE, INFINITE PUTTING STUDIO\n\nPutt with your real putter and ball on tour-level greens, anywhere indoors.\n\n100+ championship courses \u2014 every 2027 tour venue plus international and major venues \u2014 at full scale from real green topography data.\n{2191411091752523}\n# PRACTICE THE IMPOSSIBLE\n\n- Any pin, from anywhere on the green\n- Green speeds from 4\u201316\n- Custom hole sizes + ghost holes\n- Flagstick in or out\n- Wind at any speed and direction\n- Relive over 50 of golf's historic putts with Moments\n{28744232428520183}\n# ACCELERATE YOUR IMPROVEMENT\n\n- 1000+ drills: start line, distance control, green reading, mindset\n- Dynamic greens \u2014 any break on any slope\n- Randomized on-course scenarios\n{1434190562169726}\n# TRAINING AIDS\n\n- Alignment line\n- Tee gate\n- Customized putting arc\n- Animated stroke model\n- Metronome\n- Eyeline guide\n{1426051099495361}\n# READ GREENS YOUR WAY\n\n- Animated break grid\n- Slope measurements\n- Slope heatmap\n- Optimal line\n- Break zone and apex\n- Slope arrows\n{29721883677400919}\n# TRACK YOUR PROGRESS\n\n- Make rate\n- Miss tendencies\n- Strokes gained\n- Launch speed and angle\n- Performance trends and rating\n{958174776852402}\n# BUILT FOR META QUEST 3/3S\n\nMixed reality merges your room with championship greens \u2014 see your real putter and ball as you practice.\n\nNo launch monitor required! Just a real putter, a ball, and 16 sq ft of free space.\nFree demo; full access by subscription.\n\n**REAL PUTTS. REAL GREENS. REAL PRACTICE.**\n\nTerms: https://www.dreamputt.app/terms\n\nPrivacy: https://www.dreamputt.app/privacy\n", "short_description": "Turn any room into your own putting studio. Putt with your real putter and ball on 100+ championship courses \u2014 every 2027 tour venue plus international classics, built from real topography data.\n\nSet the stimp, hole size, pin, and wind. Sharpen up with 1000+ drills, training aids, green-reading overlays, and strokes gained analytics. Relive golf's historic putts from the legends' POV.\n\nNo launch monitor needed \u2014 just a putter, ball, and 16 sq ft of space.\n\nReal putts. Real greens. Real practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dreamputt.app/privacy", "developer_terms_of_service_url": "https://www.dreamputt.app/terms", "publisher_name": "Jeffrey David Golf, LLC", "support_website_url": "https://discord.gg/dPS8AW6e7M", "website_url": "https://www.dreamputt.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1422046104323920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_1034528829612712_1316329885763647389_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JznsuBNwvQAQ7kNvwHfIWu1&_nc_oc=AdojbnlApAmT1cx6wXojQWkdxQjaIn7LoMTnYidMP2r31LBQp4x0OQQZCfAgSuwNNc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAcEGu32fe3ZscrQDMphpz6ooHf9X6p5TYswWbow5CLw&oe=6AF7192B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dream Putt", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1793505600, "lastRevision": {"nodes": [{"id": "1370821389446392", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1370821372779727", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1664594055030210"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "rating.png", "id": "29721883677400919", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314634_29721883680734252_8194996888081508506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGFKPgQfjBoQ7kNvwFhABGx&_nc_oc=Ado_lsgIJlRCpJBJ840kEenz8SMJ2Or3z0n6tble5zVoIEETJkx7KhLhSedZaSvy01Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2VYVotTnAP7b9o_SH83jXd5oGbRHh7rJCLIYkQCgj_g&oe=6AF74BF3"}, {"file_name": "app_icon_foreground_512.png", "id": "28921541590818674", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_28921541604152006_3782460385621378780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CadPCWXZDao
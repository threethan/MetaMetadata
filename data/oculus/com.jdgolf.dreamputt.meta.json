t=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjEjBudxG_i31JulOS3Uz6BROvzoHoBa4lYXNMZxCbfA&oe=6B09AA6B"}, "display_name": "Dream Putt", "keywords": ["golf", "putting", "simulator", "putt", "putter"], "long_description": "# YOUR PORTABLE, INFINITE PUTTING STUDIO\n\nPutt with your real putter and ball on tour-level greens, anywhere indoors.\n\n100+ championship courses \u2014 every 2027 tour venue plus international and major venues \u2014 at full scale from real green topography data.\n{2191411091752523}\n# PRACTICE THE IMPOSSIBLE\n\n- Any pin, from anywhere on the green\n- Green speeds from 4\u201316\n- Custom hole sizes + ghost holes\n- Flagstick in or out\n- Wind at any speed and direction\n- Relive over 50 of golf's historic putts with Moments\n{28744232428520183}\n# ACCELERATE YOUR IMPROVEMENT\n\n- 1000+ drills: start line, distance control, green reading, mindset\n- Dynamic greens \u2014 any break on any slope\n- Randomized on-course scenarios\n{1434190562169726}\n# TRAINING AIDS\n\n- Alignment line\n- Tee gate\n- Customized putting arc\n- Animated stroke model\n- Metronome\n- Eyeline guide\n{1426051099495361}\n# READ GREENS YOUR WAY\n\n- Animated break grid\n- Slope measurements\n- Slope heatmap\n- Optimal line\n- Break zone and apex\n- Slope arrows\n{29721883677400919}\n# TRACK YOUR PROGRESS\n\n- Make rate\n- Miss tendencies\n- Strokes gained\n- Launch speed and angle\n- Performance trends and rating\n{958174776852402}\n# BUILT FOR META QUEST 3/3S\n\nMixed reality merges your room with championship greens \u2014 see your real putter and ball as you practice.\n\nNo launch monitor required! Just a real putter, a ball, and 16 sq ft of free space.\nFree demo; full access by subscription.\n\n**REAL PUTTS. REAL GREENS. REAL PRACTICE.**\n\nTerms: https://www.dreamputt.app/terms\n\nPrivacy: https://www.dreamputt.app/privacy\n", "short_description": "Turn any room into your own putting studio. Putt with your real putter and ball on 100+ championship courses \u2014 every 2027 tour venue plus international classics, built from real topography data.\n\nSet the stimp, hole size, pin, and wind. Sharpen up with 1000+ drills, training aids, green-reading overlays, and strokes gained analytics. Relive golf's historic putts from the legends' POV.\n\nNo launch monitor needed \u2014 just a putter, ball, and 16 sq ft of space.\n\nReal putts. Real greens. Real practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dreamputt.app/privacy", "developer_terms_of_service_url": "https://www.dreamputt.app/terms", "publisher_name": "Jeffrey David Golf, LLC", "support_website_url": "https://discord.gg/dPS8AW6e7M", "website_url": "https://www.dreamputt.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1379401101921754"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4543715595956929"}]}, "baseline_offer": {"id": "4543715595956929"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793505600, "status": "PUBLISHED", "id": "4543715595956929"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1421963887665475", "version": "1.1.2"}, "id": "1481315867379007", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isApp
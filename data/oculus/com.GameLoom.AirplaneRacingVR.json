ng", "id": "2013937832612935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818874_2013937835946268_719551008223201849_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9YnX6qqCM8Q7kNvwEgMLY6&_nc_oc=AdoMRQpxJm0rgeB8kMT8AcIypIAw6ExUNgXnA1zkgB3us80vAEmDVjhe1dsRyYarrHo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzwnHVXcg8tz3WIBVb_v47URkAlVHylnyn2xIeIKQpjg&oe=6AA003C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1102304048890156", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499294644_1102304052223489_382379417273019157_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwJtbcUL7AcQ7kNvwFvXen4&_nc_oc=AdrRt3Dyex0kJbLa3NZcbK7Ot9tKOGl1TG_7zEIQB3feSZSrYs0bTuQGV_Wr4qPzeEU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKubSVPQXWoCdtu4M7q74HgjKKDoWJOVz2Q8G3WHstWMg&oe=6AA00B39"}, "display_name": "Airplane Racing : Flight League", "keywords": ["AirplaneRacing", "AirplaneGame", "FlyingSimulator", "AirRacing", "AircraftGame"], "long_description": "Enter the Flight League and experience high-speed airplane racing built for virtual reality.\n\nAirplane Racing : Flight League puts you in control of a powerful racing aircraft as you compete against skilled AI pilots across dangerous aerial circuits. Fly through checkpoints, take alternate routes, avoid obstacles, and use perfectly timed boosts to gain the advantage.\n\nChoose your challenge:\n\n\u2022 Championship \u2014 compete through a series of races and fight for the league title.\n\u2022 Arcade \u2014 jump directly into fast, action-packed events.\n\u2022 Time Trial \u2014 master every turn and chase your best completion time.\n\nRacing is only part of the battle. Use machine guns, missiles, mines, shields, and repair abilities to defend your position and disrupt your rivals. Every race rewards precision, speed, and smart decisions.\n\nKey Features:\n\n\u2022 Immersive Virtual Reality airplane controls\n\u2022 High speed aerial racing against AI opponents\n\u2022 Championship, Arcade, and Time Trial modes\n\u2022 Booster and cooldown mechanics\n\u2022 Alternative routes and challenging aerial tracks\n\u2022 Multiple difficulty levels\n\u2022 Unlockable aircraft, items, and tracks\n\u2022 Local leaderboard and saved progression\n\u2022 Support for seated and standing gameplay\n\nStrap in, take flight, and prove that you have what it takes to rule the skies and become the champion of the Flight League.", "short_description": "Take control of a high speed racing aircraft and compete across challenging aerial tracks built for virtual reality. Master sharp turns, alternate routes, timed boosts, and tactical dogfights as you race AI pilots in Championship, Arcade, and Time Trial modes. Win events, climb the local leaderboard, and unlock new aircraft, tracks, and rewards on your journey to become the champion of the Flight League."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamelooms-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GameLoom", "support_website_url": null, "website_url": "https://sites.google.com/view/gamelooms-privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1307830635743204"}, "review_messages": []}]}, "cover_squar
2023108429303_9038872985191932973_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Mi9BwCKdbsQ7kNvwF8Hm7J&_nc_oc=Adr312AfzNb1YZg6mgGtTovjaQaUXo2eqjhrD74T83h3BushYhZGsQY7TMhmYRXqw0g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoNINvZKpgwp6vMNAvBJphWYpPxP1L7-T6YdqnD3DV5g&oe=6AB2849C"}, {"file_name": "4-Screenshot.png", "id": "1080735124606257", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307962_1080735127939590_1114935284472975035_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g60zXpkSdoUQ7kNvwFi4__W&_nc_oc=Adr0faYyMUkv15s0Y_zMVQKgHDkEeMsUL7L-XcQ3I3dKE-LJDrh-3zxnb6WjpVFaNng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPsCyVEgVeb9mudl2SNRmXNnWyyUF62BxCFIjfbnmZ-Q&oe=6AB27D6F"}, {"file_name": "5-Screenshot.png", "id": "1674826283841892", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_1674826287175225_7737173430540726219_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr6cy2DS7h8Q7kNvwEVB83Z&_nc_oc=AdqP6yqnfJUjy8Fdcb3US8yfcjT6Bi4blOTD08bgjZ9VFZoRSux9JBC-6-TKwL2Y3d0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOrL8n714GTt_6IsyQmNZ2OejnNZL-QkKQnjxpmo3LEw&oe=6AB281A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_Ventura.png", "id": "1048170707576480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1048170710909813_4798510981555111941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMMzIAtEnRUQ7kNvwENQyR0&_nc_oc=AdpcwPOy7fk2cR0SEMIGX2ypuQ13SmXgUeL9xEsfpVnnBMvqmedj-wcE73Otb9jtl74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNYZL6znVm-Q1Z38xL9qp9gtCQbVYYiJ7rT47rcSkniA&oe=6AB2A21B"}, "display_name": "Sea Level Rise Explorer Ventura, CA", "keywords": [], "long_description": "Ventura\u2019s coastline is changing. Sea level rise and stronger storms are reshaping familiar places. The\nchoices made today will determine what endures for the next generation.\nThis virtual reality experience lets you see those changes up close. Explore the Ventura Fairgrounds,\nPierpont, the Ventura Keys, and the shoreline as flooding, erosion, and rising seas affect the places you\nknow. Then see what is possible: vegetated dunes, nature-based buffers, elevated and floodproofed\nhomes, and floodwalls. These strategies can help Ventura adapt while protecting beach access, coastal\nhabitats, and the communities that depend on them.\nThe City is updating its Local Coastal Program, the plan that guides how Ventura manages, protects, and\ndevelops its coastline. Tools like this VR experience are part of how the City is working with the\ncommunity to understand what is coming and to help shape what comes next.", "short_description": "Ventura\u2019s coastline is changing as sea level rise and stronger storms increase flooding and erosion. This virtual reality experience lets you explore the Ventura Fairgrounds, Pierpont, Ventura Keys, and shoreline to see potential future impacts and adaptation strategies, including vegetated dunes, nature based buffers, elevated homes, and floodwalls. As Ventura updates its Local Coastal Program, this tool helps the community understand risks and shape a resilient coastal future."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": null, "website_url": "https://www.virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
file_name": "04_2D.png", "id": "203862435217286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392880_203862438550619_8078015934605418457_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UzlpaE7LwUQ7kNvwHFx10Z&_nc_oc=AdorhF2KAm-7PelKPLJOAp0bYNm92tiR9qKxw9tp2zALqjWvsM33OCnIJgKhtcXmV3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlZO61TdjV463rkm7ql5NoxD7T-yC8ZYuzwBw0VGsDmg&oe=6AA55BDC"}, {"file_name": "05_controller.png", "id": "2972182143031996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367594_2972182149698662_6999703946360920926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yopjYB3_HiQQ7kNvwFFDcUx&_nc_oc=Adr1k9OIbAYfXAEaX1vqWvXbaw2RK-PSSO_N_9iSXPGOxowZt9OqWlStsAIdkvcqP7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjDPQ8DyjS0DIVcqhwKGXdUh3CmkXmEaPnSMOSzzIFbg&oe=6AA55B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "860737097931213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371510_860737101264546_3558069328880623798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opyurnYDzZsQ7kNvwHfP_dz&_nc_oc=AdoY-eFVxthjZ7CmYjCrEFeH3mmru01_V946AZwd9zrjoJyQY2E_hwxHamHBZ3lGUAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2BOrKxapY6UZRDK_lobtmWtuA2prlG-yUsl5qlF6mTw&oe=6AA54807"}, "display_name": "immerGallery Demo", "keywords": [], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos. In immerGallery Demo, you can explore 40 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The image formats are VR180 3D, VR360 mono and a few regular 2D images.\n\nThis demo is a preview of our upcoming app: the full version of immerGallery! It will enable you to view your own images in a convient way and to create your own immersive stories.\n\n", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos. In immerGallery Demo, you can explore 40 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest, castles), Japan and great beach locations. The image formats are VR180 3D, VR360 mono and a few regular 2D images.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immerVR.com/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": null, "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "304840815030643"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1284096382776145"}, {"status": "PUBLISHED", "id": "735942797358891"}]}, "baseline_offer": {"id": "1284096382776145"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733782800, "status": "PUBLISHED", "id": "1284096382776145"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
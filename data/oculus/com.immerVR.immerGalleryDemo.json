ent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTNhIee1HfvnSY_nTeqDPIYYstJ9PTCebnSfLs2HZs5Q&oe=6AF9BF58"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7kuCJc7aigQ7kNvwGbXkg7&_nc_oc=AdrZNhKWZcj_XNxEyg6ChE_T-9UDXfMufnSADxrobAn9Dqc51PIkPi8lmZXEsbJHnPE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn2q5mAV25-IPibR4eWP7fOsGL7ySLslYqtE7_AfbHXg&oe=6AF9DEFF"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rekr5LG_RAQQ7kNvwH2PeuK&_nc_oc=AdretmBgp7_px5f5nq1o46bXcZ97ZhQM250OIXQiIxbXNjsZiytwMMbnNopcYZB2Oz8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkGMmedSIF_vvV6Nhd7dCoGWY7KW0vudPGJ4rF_GIKJA&oe=6AF9ECCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hlFp-ap0M8Q7kNvwFlkCR6&_nc_oc=AdomBQPFf86l0Y1Fwxy8KYNmtsBPwVDbLqUXVBuKytywSJFsfqaaorChumGimxld-Pk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ23jG--bTaaB_uBiCokZK6OFjSQV9zrKILswyQXI2UVA&oe=6AF9C596"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28572404205723867"}, "review_messages": []}]},
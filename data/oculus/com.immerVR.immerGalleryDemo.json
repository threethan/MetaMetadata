9_1737361683363487_9004228099176793443_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhgclQanFTkQ7kNvwFLQNeO&_nc_oc=AdpD77vzFJxAIpxI8Y7XZd0h-H5VkHaG6TBM7wSdE71EFUeJ82tsv7RhEu5AaQcAKWU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhR3rfk8HJq2eLulY4A991jmDecQc8CEwSfDWRFLn8wQ&oe=6AFF0558"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kXDWWRFY8cQ7kNvwG8EG7R&_nc_oc=AdpIOWC0CD3DOjqqIQyhR2MaOujKYIzjH1N5Y1XezDwGn1jS9pB_631-6_FUyk-v4dA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ052wBOAnuA3Cw88ccHoT8ia74AFarsXvdXraOkrQVaw&oe=6AFF24FF"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sh_MCJUVdyIQ7kNvwHbKXpR&_nc_oc=AdrEAM46fhgmjtvL0B2Lq6G_EJou_DU8XFpIrQrmReghyPynrFGROGU5DhrKC01N3WM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4GuO9WpZAgabSfw2cG__ERp2dDeoJvu3qYByzwQi1FA&oe=6AFF32CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jV3ZhYQAngQ7kNvwE3Vxev&_nc_oc=AdoetmuSmT1QTpoS9PYfFZ26claZdKMetNURqmpsShZELKt-8vOIMV6QHMehw3f7jJY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5YDFmMzxWQXa_sEqzrAg7C9RQomeKrKocrSBforg7qw&oe=6AFF0B96"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
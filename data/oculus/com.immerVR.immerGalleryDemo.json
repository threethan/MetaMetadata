9_1737361683363487_9004228099176793443_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY1-YKK--ccQ7kNvwGbUB8X&_nc_oc=Adr9l6i5wNT2jC7zmHquRnVelFpOwh2-gg8zzh7ie4HG6l3JbBo2j3MjFAqizAGEZu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO7sWmdNWBw_y57epdgHnXIZGNeW3dxEuXjHhZRx-_Kw&oe=6B05D518"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI59c5C6h9AQ7kNvwHphAjv&_nc_oc=Ado2u0S73aQSkYHpbY8JXhy-HFMQxiA31HFzcW3JWs7dcwuCR6MIYRmMbmDq7KwtRQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTux6PS7Ac54r8U5MCbIRtnXU4gD3YM21T-UlmMVmWPcg&oe=6B05BC7F"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2mXFTtPFOIQ7kNvwEiHpB8&_nc_oc=AdqJAnAP4Nk2mNnOlAsSbaCG2AQ1COZdmxJWTdksgT38iJ27lkPXIbS-FcBDA1DfiG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEn5sEV4C3bqzA9UEcui5ONWA5S45tjjJ0BOAxVJnuQw&oe=6B05CA4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Beb0tu6hOnEQ7kNvwHAaQ8m&_nc_oc=AdqkU0Z1sdwAXmCM3Q29YczvxFgR4b-GkEEL6CDMz5HGoDAFUkt1rKJbnjdlEVv4gc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3YriGexDHduSL7PM2r1zMWiEIJn_RiltenA-RXTOWtA&oe=6B05A316"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
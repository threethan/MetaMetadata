A40B66"}, {"file_name": "04_2D.png", "id": "203862435217286", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75392880_203862438550619_8078015934605418457_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA8kV-nhc4cQ7kNvwFl0Qlc&_nc_oc=Adoz3jCYWy3SU0DljZTwEb5ck9MUBbt2E1juXGIrrCJXI8-lzNeFF9qQ-1V3hy_9OK0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-8w42R18cQEmb1PIgFXdeGcqVeR5ZFnwKP-9B6q7LuA&oe=6AA40A5C"}, {"file_name": "05_controller.png", "id": "2972182143031996", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75367594_2972182149698662_6999703946360920926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yopjYB3_HiQQ7kNvwG-wU1r&_nc_oc=Adopf4yDhjogytQqUMgDfYPpWSMneqxHFT2tCdd0odcswv5qb3PZsyfQk-MBykiLjAw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBihvWqSb2ivfgC2HmY8egRIqWxkR3V-oN4WKdmgFdDg&oe=6AA409BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "860737097931213", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75371510_860737101264546_3558069328880623798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opyurnYDzZsQ7kNvwGaZxGD&_nc_oc=Adobdt0RZtyXgSn5JZTvEDIvC66nhEpQLd9-U8SCbs3hCECBbYTrQ38tbSTPSkUcRjs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuhCGKWPUc2ZUpq8uElwLIx-d2Gdb8p44E9DFzte2CzQ&oe=6AA3F687"}, "display_name": "immerGallery Demo", "keywords": [], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos. In immerGallery Demo, you can explore 40 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The image formats are VR180 3D, VR360 mono and a few regular 2D images.\n\nThis demo is a preview of our upcoming app: the full version of immerGallery! It will enable you to view your own images in a convient way and to create your own immersive stories.\n\n", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos. In immerGallery Demo, you can explore 40 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest, castles), Japan and great beach locations. The image formats are VR180 3D, VR360 mono and a few regular 2D images.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immerVR.com/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": null, "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "304840815030643"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1284096382776145"}, {"status": "PUBLISHED", "id": "735942797358891"}]}, "baseline_offer": {"id": "1284096382776145"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733782800, "status": "PUBLISHED", "id": "1284096382776145"}]}, "liveChannel": {"nodes": [{"latest_suppor
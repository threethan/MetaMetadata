9_1737361683363487_9004228099176793443_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdEy82AuhSsQ7kNvwFuZJ1k&_nc_oc=AdqoN0mxow7oHo3HuZ9O1Li5gYWeOeFNJfM6qC2xbhbnSAyDDShvnMSY9usEJzicbcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5xozdk66VX_voCpVXVBjGQYJAlqCXcY3eX17EcPEEuA&oe=6B033218"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI59c5C6h9AQ7kNvwH8tNAB&_nc_oc=AdqIuWOXBuaNrEd-PS2jex4xhknG25WF_nKJ5vWQ7BU3mdz1_yD6eKIHTpiqZr8ElyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr_HpgNkYX_tKPB8yXQ3HEzQr33HvNxDe5IUJkE6s2pA&oe=6B03197F"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I410_HkKBaoQ7kNvwGaC1pt&_nc_oc=AdpKG1UWbVQ0kCN9rrHydPsfLCECIufFSR1XJk25b-S7KjCGKQjakGq6XxYU62XKyZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR83n2AcG260bWwv3kXxP7veoZDUOaSpOWJBtZzriiYdw&oe=6B03274A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Beb0tu6hOnEQ7kNvwHqqBCG&_nc_oc=AdokGjm61XyAmtIMDQV8zMnsBNPxwFIvfZs8a7zTJGZI7AA2evDoPiy33EwZzPeA-eE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpb1Vyj1BBR9jmd1NWlxP527-AwQ2PkaCQ3hYhtFb_fw&oe=6B033856"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lh5O-ZY162kM4Zdjp-mY5CkjVl7GZ3dP-pkKj8QLw4Q&oe=6A36A158"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B_KbB5HUWoQ7kNvwEATWyN&_nc_oc=Ado7vCCbK0bUnKsXXgG1_c5PlZku4RzLVRgy1mnX_45IBeHe681SuRf-pwvJCE-Sp5A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c_hXMsgs0tGPGkednT7Kv6tIOr2Anp6_TZLbqk8skhA&oe=6A36C0FF"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39cR9pSOVfgQ7kNvwE-QWIg&_nc_oc=Adr3_fPe8AhtsQIthSpWiWisMRPiurJGDzL-Il2OuvhkkVCjx6IPFzSI4NGrJQ-ENjY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eYt2mR5YsMi7CJwzhe9mBxKZ3IImjyH5oYMkv9KsVtA&oe=6A36968A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjltCbkeBE8Q7kNvwEUMN--&_nc_oc=AdpPGfsKVedFn2_nm3w-uyHL0O8-lHa_3m4sP8PPnguVrQJLb9rMOgIbARrcKtCtOSI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BIHzMHITeQ0jIl3WX1ifr3NQwZ_ow50_L2om-4QTm8Q&oe=6A36A796"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27285336034430697"}, "review_messages": []}]}, "cover_squ
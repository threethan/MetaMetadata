9_1737361683363487_9004228099176793443_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY1-YKK--ccQ7kNvwFCd7ZP&_nc_oc=Adp3j-VMNOextMKU2_03InAQyi0pcmyRXr8-hACAZmbzgj5v20D7cWnAB2oyZ-bZGXs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNLn5R3ML-Z0Uh9lSW2Kz8cVsrNw4ONdrWE47NKEumhg&oe=6B083FD8"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EnByy_84vUQ7kNvwEi-wuf&_nc_oc=Adq2Wgv7J-STYP3tvx9E7Nu58tB2D5j2LvKfAdZROH1lCxK5i3y6p8_fTjCynWzET_s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBcEqf0EJTFXxwj3jTP6gVtZH9w659-qrV8E4aOxua8A&oe=6B085F7F"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=417ZKoYJ83AQ7kNvwFjzcXc&_nc_oc=AdrSPEWGV9lUdk44TMPtjXmun7ny4Hnjprjo6zqmykBgo_arzDg35hsRnX0dpZTMt2I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtLITLm6cN2v7rRkmn8Vy5RZmqLSENyO1pk8isk3iYyw&oe=6B086D4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QGLH_l2xbUQ7kNvwFFWtno&_nc_oc=AdpW0m9kLJiaShTvki6AnRfsDBNHlP1altbquYKT-8HMICnExdB84u749P6mPYWuMow&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyrjjAL3US3CESjY-WIM_z0cTnEW8qjb8Kg6B-Dn7iUw&oe=6B084616"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
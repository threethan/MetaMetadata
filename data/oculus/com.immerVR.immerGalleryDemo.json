ent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs2d6A5NprFBSK7ZhSXFnqAyZdtbErucV3HO8Kft8JJg&oe=6AC26058"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5V9mIoh8bkQ7kNvwEVzh1L&_nc_oc=AdqeGolbKuqZ-ymoBxD1tOuX0vwBQ_xsBY08O7ZyYJ1tdJkO9HLGeKuQkmpoioDA4AI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMTn33B-Bj_9LHuO6y-qpVCWdJcwEgTlBd3N5vco7LoA&oe=6AC27FFF"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnjScEt4w5sQ7kNvwG2KXsr&_nc_oc=AdqSo5C9hkq8rbbzcmKc0m0J3EwW8-g-M45pgsYP-yBeJ3VFyfVuYIDwDUbtebxyndY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdHAj4wkVWepYyZtStMnV6BvZd2LFj4cawu6QXc0EnDw&oe=6AC2558A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-muqxnRMUQQ7kNvwF8uy6O&_nc_oc=Adq6hhVeJDv1H5kh9_4aKo6K2TrPVpHKEedcBHTq2XuoKoAQv8NU2GBK9Z_F4grMcng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlhFRkhLvKkE-kSTtAgybDEk-K8ig_qU7N9ffA1qreiw&oe=6AC26696"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28572404205723867"}, "review_messages": []}]},
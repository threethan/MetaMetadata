9_1737361683363487_9004228099176793443_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY1-YKK--ccQ7kNvwENfLxj&_nc_oc=Adr7vFEMAEYEdpywixjN_4MQiosbmLlAYaPqX_4xLM61rwdz5eKi0pnH-mPMjz5Yob8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcnVlE8_MXy0pwHXJHwB_UEIAvt9E5NtmP2Hy0cUFHSw&oe=6B072698"}, {"file_name": "rewards2024-06.png", "id": "1527358892269907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1527358895603240_2507367656510738307_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EnByy_84vUQ7kNvwF3AbEB&_nc_oc=AdrewULhe3kyH9K_8gudKbmfdAS4qpw_iMaWKpByKwpNVH509bTN7IXaRmcl4jrtPRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsztjQce8mslZVKgA-QNjMct2_KZUKlPRhXb8nhZLKpg&oe=6B070DFF"}, {"file_name": "05-Underwater.png", "id": "720846999478568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974779_720847002811901_6796397472608360735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2mXFTtPFOIQ7kNvwHchBAj&_nc_oc=AdrIFJhi5oL42HDI8aLIdiq7GSqe3FffIWiwruuQr7WNGDvwCRedNnw9MIOECJjj7mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTPnKmdVng1RSvHcxyK6rJ64zSLYjrkgdjrjYZRnqWew&oe=6B071BCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "280252877737423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_280252881070756_7701609784072185703_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QGLH_l2xbUQ7kNvwH4hd1L&_nc_oc=AdrUm8bNtaom9R_3QlN3YiRPIRnKtYeBHmVXtX3vp5XZSXBBribSJj17Lg87sHeIohU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLgi1kbR9frn_bGK-Aj7vdB6iezz5UpQ8ZPfB9LGMqKQ&oe=6B06F496"}, "display_name": "immerGallery Demo", "keywords": ["media", "image", "stereo", "panorama", "spherical"], "long_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest and castles), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\nThis demo is a preview of our full version: immerGallery! The full version enables you to view your own images in a convient way. Create your own immersive galleries by adding sounds and special effects through the generator tool on our website and watch them in our app.", "short_description": "It is our goal to create the world's best immersive image viewer for VR180 and VR360 photos (2D & 3D). In immerGallery Demo, you can explore 50 pre-selected images in a highly immersive format. By adding sounds, voice-overs and special effects, we open the way to immersive storytelling with VR photos.\n\nThe photos are from various places around the world, e.g. Germany (Oktoberfest), Japan and great beach locations. The example images are in VR180 & VR360 format and in low field of view 2D / 3D.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immerVR.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
scdn.com/v/t64.5771-25/499628092_2213199939618324_6484026051532087570_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7cvZzbMqCsQ7kNvwHaglYX&_nc_oc=Adq5Ea_QdPHrmTxuUOTHTQAx994cEXUmkN3VcB-RQDnmk_mX6kekMkJLAk1qG6qra7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4lEJrRyzNDX8rCFUkFlgwazSKCwES7IeyZ3y_ZolIyw&oe=6B0DBEC7"}, {"file_name": "03_kitchen.png", "id": "2040629303265975", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620403_2040629306599308_4155815698965941271_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhPfuYUmn9gQ7kNvwGLxgFV&_nc_oc=Adr_QK6G9QW4e5MXHlF30mrYmlpLVY14vbhXpxL6uLSWe2DsXOgSMrX0FYF2ruY3bIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTCf32QPzLXbiP8s315TDHAgmVg17ylzgvSwAJsTl7z5w&oe=6B0D9E99"}, {"file_name": "06_fireworks.png", "id": "1908623520546473", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1908623527213139_6744564252481938353_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHQDycO9uS8Q7kNvwEHWYz-&_nc_oc=Adp2I1OLPu0U7ZdRuXgA60RHrBFOHY_7C9wMoxZSlox6awzsNrzz9e2RFYKhy8wA7js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSkMf1k2tATjtwYZj1_JXPtdGlNlP51i97424xS0ifaQ&oe=6B0DC023"}, {"file_name": "05_outside.png", "id": "2173038466930370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593878539_2173038470263703_6665349769317668472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_839FczI7ggQ7kNvwEV1hV6&_nc_oc=AdpdT1RFLlWb1dC87sDjIe9woLzLPuqVOqc03f8AHy2_gk31-gF_sjgO2yg_a8XnSvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcf8FpS2UmE_1_dv9aYU-5hAZ4gWhp_yg6SyrRAiztjg&oe=6B0DA113"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "After Hours Escape: Japanese Beach Hut", "keywords": ["puzzle", "escape", "Japan", "mystery", "summer"], "long_description": "You dozed off after closing time at \"Shiosai\", the beach hut where you work for the summer. When you wake, the sun is setting, the shutters are locked, and the owner, Gen, has gone home leaving only a note.\n\nExplore the tatami room, the kitchen and the changing room, and solve puzzles by grabbing, opening, turning and pressing everything with your hands.\n\n- Pull drawers, spin dials, push levers \u2014 every interaction is hands-on\n- A lovingly detailed Japanese beach hut: pull-cord lamp, old register, safe and electric shaved-ice machine\n- Watch the sun go down as the waves and cicadas give way to the night\n- Three-step hints when you get stuck; your clear time and hint count are recorded\n- Shine the UV light around \u2014 there are hidden doodles to find\n\nEscape, and watch the fireworks over the sea.\n\nThe first title in the AFTER HOURS ESCAPE series. Available in English and Japanese.", "short_description": "Late summer, a seaside beach hut at dusk. You wake from a nap to find the shutters down and everyone gone. Search the hut with your own hands \u2014 seashells, a shaved-ice machine, a UV light \u2014 and escape to the beach where the fireworks are starting."}]}, "developer_name": "eliseapps", "developer_privacy_policy_url": "https://eliseapps.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "eliseapps", "support_website_url": null, "website_url": "https://eliseapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
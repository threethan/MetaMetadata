screenshot-10.png", "id": "541560648152353", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982642_541560651485686_4703487295186691878_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tyNqQY-ZBEQ7kNvwG-wjGa&_nc_oc=AdofbaVJf2RX208pTJNkJYAmq-5obzHY7997i_q7eVHLPXh4EQcQgPgZkV23DJ6MTN8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSyJY5ia6YlQiAVU87WAn-S6SWJNWGF258zyXZBRR0mw&oe=6AFC7FEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_landscape-v2.png", "id": "170042559159752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031311_170042562493085_6454853362454845722_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbdX9I6pKXYQ7kNvwH7r2Ye&_nc_oc=AdrVLj3PHDuLfKG_4hRF2s1QbCPSWL6nQ3vcsF-5pzY3JTIvdoKZP_X6yRGSLV6S-FA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPVs9w0j1ZrRqFiPNNH9QxOmApOteVY0ki7If43qc79A&oe=6AFC7A69"}, "display_name": "The Tarot Experience VR", "keywords": [], "long_description": "Journey with the power of VR and your intention to the imaginal realm of the Tarot archetypes. The cards have a message for you, but you must go alone\u2026 no Tarot readers needed here! The Tarot Experience VR is a unique \u2018second person\u2019 VR experience that asks you to bring yourself into the game. Powered by a unique True Random Number Generator, The Tarot Experience VR is connected to nature, your nature, and brings a whole new level of interactivity to VR. This is not roleplay, this is you! An encounter with the Tarot images and their message is an encounter with yourself, and the message of the Tarot is this... you are on a heroic and sometimes crazy journey to know who you really are! The Tarot\u2019s goal\u2026 is to point us towards the highest version of ourselves. The stories of your past, present and future are not fixed, they can be changed. The future is a creative act! Use the wisdom of The Tarot Experience VR to guide you! ", "short_description": "This is a story about you. A heroic journey to remember who you really are\u2026 the lead character in your very own story\u2026 about you! Afterwards life may never be the same again\u2026  "}]}, "developer_name": "The Tarot Experience VR Ltd ", "developer_privacy_policy_url": "https://www.the-tarot-experience-vr.com/privacy-policy-2023", "developer_terms_of_service_url": "https://www.the-tarot-experience-vr.com/terms-and-conditions-2023", "publisher_name": "Astrolabe Immersive Ltd ", "support_website_url": null, "website_url": "https://www.the-tarot-experience-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "782700653446171"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1771440880484320"}, {"status": "PUBLISHED", "id": "1248227957517222"}, {"status": "PUBLISHED", "id": "1560798285247141"}, {"status": "PUBLISHED", "id": "918676479354594"}]}, "baseline_offer": {"id": "1771440880484320"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777367280, "status": "PUBLISHED", "id": "1771440880484320"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25144716808543451", "version": "1.15"}, "id": "773708377203627", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
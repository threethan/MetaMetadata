761983496602", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821725_892761986829935_3646901499824509571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObduOownjUYQ7kNvwG7BzG1&_nc_oc=AdqwQKPGCbayZp3gmlQhnXbEMB7q4gJn6tv1AHIkEqsu9VNwavUINDQy5ITtcUDlX3Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlOYqZOQOvrjIlXs7iQS86YbYsON-9J7WL26rw3psLjA&oe=69C7D531"}, {"file_name": "3.png", "id": "259584503895636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031511_259584507228969_5931309425209862313_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HlLQRa39AcQ7kNvwHukCf0&_nc_oc=AdpbKJfm4r-P0SofFMqZcTMgy8pQgI5lI1UDTduOusYQjXliMYOpKnmWsHa9uYQLm_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYncG7Bxja90V9RJfU-g6OoU9-c_fRzA85wG31hl8vlA&oe=69C7B1EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "7350365691723899", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982724_7350365698390565_1633587124870304394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KESSxmONPjUQ7kNvwHAqwz6&_nc_oc=Adr2JlGOQX_itKpNkJWLsE1M2YLtwQUC9rp4_auuGEdboPG29VOpfJarWaB4W2MJvaI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_em7eiC62sHwQ1cYp5G3XxWPD1CWCCHaEF6fdLW2kyg&oe=69C7D1C3"}, "display_name": "The Tarot Experience VR", "keywords": ["vr", "tarot", "fortunetelling", "indie", "immersive"], "long_description": "'Experience of the Year' Finalist at the VR Awards 2023.\n\nJourney with the power of VR to the imaginal realm of the Tarot archetypes! The cards have a message for you, but you must go alone - no Tarot readers needed here.\n\nThe Tarot Experience VR is an authentic \u2018second person\u2019 VR experience that brings your question into the game. Powered by a unique True Random Number Generator, The Tarot Experience VR is connected to nature, your nature, and brings a whole new level of interactivity to VR using interactive spirituality. This is the future of storytelling in VR. This is not roleplay - this is you! \n\nThe Tarot\u2019s goal is to point us towards the highest version of ourselves. The stories of your past, present, and future are not fixed, they can be changed. The future is a creative act! Use the wisdom of The Tarot Experience VR, surreal visuals and symbolic archetypes to guide you.", "short_description": "Embark on a heroic journey through the Arcana to find the answers you've been looking for. Afterwards life may never be the same again\u2026  \n\n'Experience of the Year' Finalist at the VR Awards 2023."}]}, "developer_name": "The Tarot Experience VR Ltd", "developer_privacy_policy_url": "https://www.the-tarot-experience-vr.com/privacy-policy-2023", "developer_terms_of_service_url": "https://www.the-tarot-experience-vr.com/terms-and-conditions-2023", "publisher_name": "The Tarot Experience VR Ltd", "support_website_url": null, "website_url": "https://www.the-tarot-experience-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25738642682484191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974868_761839442571196_2671839550380943778_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90qIw8JO45wQ7kNvwGvMXoP&_nc_oc=AdpMTu3PhyeXWYToB44Cm9uWvBBBqkPjaOwWqQTFwj88OOdHa8Qa_efFjHjDCmPKTPU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculu
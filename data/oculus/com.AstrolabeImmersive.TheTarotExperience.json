S2rCZLbm_j5QEZer1-DPMNvddshuaN2ow&oe=69C7DCBC"}, {"file_name": "STEAM-screenshot-10.png", "id": "541560648152353", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982642_541560651485686_4703487295186691878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK3qmrX7n58Q7kNvwFZBHJl&_nc_oc=AdolzPbnpLwu7yLfnun72FFfhKZdLyiStVjgrAdl50jGfg2EBdB_QnlRlU7jcJVn2Wo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzu5TlPcKFHD-w1ERF6379i2J1z_YTOLG1dASWOoPtx-g&oe=69C7C8AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_landscape-v2.png", "id": "170042559159752", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031311_170042562493085_6454853362454845722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Dz0VKodWJoQ7kNvwHzd1yU&_nc_oc=AdqS04aIcEahK670cwEPyD6LgxTv1nPWsvroGdQ1uZ0qZaXnaSWubnSHzDmoCHPWhHI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz8cXBzUBcROWWh44B8yCBUSTvKjL7yBUlP2Bbs56ZDQ&oe=69C7C329"}, "display_name": "The Tarot Experience VR", "keywords": [], "long_description": "Journey with the power of VR and your intention to the imaginal realm of the Tarot archetypes. The cards have a message for you, but you must go alone\u2026 no Tarot readers needed here! The Tarot Experience VR is a unique \u2018second person\u2019 VR experience that asks you to bring yourself into the game. Powered by a unique True Random Number Generator, The Tarot Experience VR is connected to nature, your nature, and brings a whole new level of interactivity to VR. This is not roleplay, this is you! An encounter with the Tarot images and their message is an encounter with yourself, and the message of the Tarot is this... you are on a heroic and sometimes crazy journey to know who you really are! The Tarot\u2019s goal\u2026 is to point us towards the highest version of ourselves. The stories of your past, present and future are not fixed, they can be changed. The future is a creative act! Use the wisdom of The Tarot Experience VR to guide you! ", "short_description": "This is a story about you. A heroic journey to remember who you really are\u2026 the lead character in your very own story\u2026 about you! Afterwards life may never be the same again\u2026  "}]}, "developer_name": "The Tarot Experience VR Ltd ", "developer_privacy_policy_url": "https://www.the-tarot-experience-vr.com/privacy-policy-2023", "developer_terms_of_service_url": "https://www.the-tarot-experience-vr.com/terms-and-conditions-2023", "publisher_name": "Astrolabe Immersive Ltd ", "support_website_url": null, "website_url": "https://www.the-tarot-experience-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "782700653446171"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1560798285247141"}, {"status": "PUBLISHED", "id": "918676479354594"}]}, "baseline_offer": {"id": "918676479354594"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767729600, "status": "PUBLISHED", "id": "1560798285247141"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25144716808543451", "version": "1.15"}, "id": "773708377203627", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typena
2GE_M5X6LCNwTfulfKZJU-gdpOltPA&oe=6B104C5A"}, {"file_name": "2_hanging_coaster.png", "id": "1066932436358356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835860_1066932439691689_6123213129016148788_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H9FJ3lEyTwQ7kNvwEykXrA&_nc_oc=Ado-DsCWCR6k5gYp3S4VErmMSlKrQiKaK6vEL3urjFmNIrDvGXBSODHRwT7DfJPpNQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUC0cgfegbkwPujGe-0fmJ4EIn6JXnjGoqzw-PmnGiPlg&oe=6B103EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "4086449911649328", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835873_4086449914982661_4059082771102435554_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCIRtTXSBtYQ7kNvwE4KV5i&_nc_oc=AdoeVbHf_fmzSll1yVXY89sZ0rpp8hTkLdEYVYClgqVIFPjv8B9fg5yNmiKVSSDsNV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuSTgf-tYCGOUzeI1S-QUTnKPnFsFpp45fjEqFAUIWaA&oe=6B103603"}, "display_name": "Coaster Creator VR", "keywords": ["rollercoaster", "coaster", "builder", "sandbox", "simulation"], "long_description": "Build a roller coaster with your own hands, then shrink down to life size and ride it.\n\nGrab the track and pull it into shape around you: bank a turn, throw in a loop, close the circuit back into the station. Shape the land, place scenery, and sit in the front seat for the first lap.\n\n# Build\n- Grab the arrows to move, bend, bank and twist the track\n- Add chain lifts, launches, brakes and friction wheels, each with its own speed and force\n- Or use the simple build panel for turns, slopes and ready-made loops, corkscrews, barrel rolls and helices\n- Supports and tunnels are built for you\n- Sculpt the terrain, fill lakes, set the time of day and add scenery\n\n# Six kinds of coaster\nSteel, wooden, hanging, flying, hybrid and water coasters, each with its own track, trains and supports. Pick one to eight cars and the station grows to fit. Water coasters have splashdowns.\n\n# Test and ride\n- Run the train and watch it from anywhere, or grab a car and push it yourself\n- Real physics: gravity, lifts and brakes decide how fast the train goes\n- Live speed, height and G-force readout\n- Ride in first person, with a comfort vignette for big drops\n\n# Change your size\nGrow tall to reach high track, or shrink to 1:1 scale and walk the station and its stairs.\n\n# Share\nSave as many coasters as you like. Share yours and ride other players' coasters; the game works fully offline apart from browsing and sharing.\n\nMusic by peppermint_box.", "short_description": "Build a roller coaster, shrink to life size and ride it from the front seat, then share it with others."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crazychicken.top/CoasterCreatorVR/privacy.html", "developer_terms_of_service_url": "https://crazychicken.top/CoasterCreatorVR/terms.html", "publisher_name": "CrazyChickenGames", "support_website_url": "https://crazychicken.top/contact/", "website_url": "https://crazychicken.top/CoasterCreatorVR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1492289730633988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/58
07243_1447829875921180_5669273685137032215_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcZSj7z49TsQ7kNvwEb3gvS&_nc_oc=AdoAIgMUejmvbWD_kXg-Ofv9RwhYwqeSFpMq_SNqybCF93-1R6iEwzuXIvrxFrFz1-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtezaE3ASUqJD2SGLegyunCW7a_ginnEHdW-pA4Z3yRA&oe=6B0319BF"}, {"file_name": "Screen Shot 2022-07-13 at 11.05.17 AM.png", "id": "521592810533132", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974907_521592813866465_1859723888539701168_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxgl6J8HnuIQ7kNvwGQCeHR&_nc_oc=AdrOcWPkRNFBr7TJCGYc6ENlUD8x4PW7cLNMbPStPbkHY2sh_iVvqXwp_WdczgbKCxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3dmWGl5SIfV9UOcvao0wJ6YavCB3HP5X1uD4TfE2Ohg&oe=6B03167E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eCYBERMISSION VR Lab", "keywords": ["STEM", "Chemistry", "Molecules", "MOF"], "long_description": "A Virtual Reality laboratory taking learners from the problem a soldier might face in the field, to the solution, via scientific method. It is designed to introduce people to the problems a scientist working for the Department of Defense might face, and how they solve them. This is achieved with videos, immersive science, and working out problems by trial and error.\n\nAlong the way, learners will understand other initiatives STEM learning within a DoD lab has created. From the giant airplanes to being able to see thru walls, the eCYBERMISSION VR Lab introduces users to the vast possibilities of STEM.", "short_description": "A virtual reality lab taking people thru the process of Department of Defense problem solving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1IS97uZsO7t1VsQVKRywh70irnEUtDvKJQ-eYquisSOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ROAMVR", "support_website_url": null, "websit
.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN81R5Yybm4Q7kNvwEHQoe0&_nc_oc=AdmX0vadeMybGAO2eD0l02P7ZypYXwbC0BeNEFY7EeGHkvhY9GNOc7LZ7HkwQlmAcK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvC4W3mH0P-dnu5ZGg_ObFMD09VcaJIqYky7iqBpHzDww&oe=69A56AEB"}, {"file_name": "Screen Shot 2022-07-13 at 9.20.50 AM.png", "id": "1447829872587847", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207243_1447829875921180_5669273685137032215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB2kYRmZ9jQQ7kNvwHIJ6iZ&_nc_oc=AdlV50XII8rRyR75lxWHMX49aSdCO2vFNv05w7cgTqG1u8BrzZnRk2UgpTfvlcAnFts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuJ9OdcDI0odSmLKC8hj9MIjDdKZfD_njlwO_E01Jk_Jw&oe=69A583FF"}, {"file_name": "Screen Shot 2022-07-13 at 11.05.17 AM.png", "id": "521592810533132", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974907_521592813866465_1859723888539701168_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnD5VjIdV-wQ7kNvwHd3lwA&_nc_oc=AdkfM5a1wMOVcWMEDxXZLLzzenIXIMYyuSwq_5IkyOpFyTwXZOAg5SnvbxeqeYJAd4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftmOwV6tK0zuxQcriDwaACHMCPl_nYQAtyXa_aI9yJu5A&oe=69A580BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eCYBERMISSION VR Lab", "keywords": ["ecyber", "AEOP", "science", "experiment", "stem"], "long_description": "A Virtual Reality laboratory taking learners from the problem a soldier might face in the field, to the solution, via scientific method. It is designed to introduce people to the problems a scientist working for the Department of Defense might face, and how they solve them. This is achieved with videos, immersive science, and working out problems by trial and error.\n\nAlong the way, learners will understand other initiatives STEM learning within a DoD lab has created. From the giant airplanes to being able to see thru walls, the eCYBERMISSION VR Lab introduces users to the vast possibilities of STEM.", "short_description": "A virtual reality lab taking people thru the process of Department of Defense problem solving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1IS97uZsO7t1VsQVKRywh70irnEUtDvKJQ-eYquisSOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ROAMVR", "support_website_url": null, "website_url": "https://www.roam-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8674181782646137"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974591_588869836798626_518211285554474713_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yQzZooUZ_YQ7kNvwEgi62P&_nc_oc=Adlf6tDQqh3NbdWx7-sQbWIpHTnuVUnLgJ-xv_KTMn7T87farZRPUozzo5tXUqmj6bs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftZP09WRu-b38B4mveQT8ddtO8f0eBtCPRYWKQN_PK7cQ&oe=69A59A2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "eCYBERMISSION VR Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1727370000, "lastRevision": {"nodes": [{"id": "8266267113437608", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "82662670
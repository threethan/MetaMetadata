.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atONQeov5CgQ7kNvwG6xoXp&_nc_oc=Adkja4lSqHOv-qoNmEu_F9RkiYpAQorRtTTD_X9GCTWZuR8N_6NZpxXGjlPi1TnbZnk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsdC0b4jJp392dzXPOcUQOfkUhYXlTeiy1hHdNCfK9dUQ&oe=69A1766B"}, {"file_name": "Screen Shot 2022-07-13 at 9.20.50 AM.png", "id": "1447829872587847", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75207243_1447829875921180_5669273685137032215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYExFe0G9hIQ7kNvwGwT16J&_nc_oc=AdkMLGMgp9nrFQIskPt8F2MzJCtdT-fAeQIVTNmUbS88uJp-xIkV8-kDEa7DM7-Corg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftzJoV8qaquW9juhn7vRUM0TkT1zSGZIhd53Y7DrejeUg&oe=69A18F7F"}, {"file_name": "Screen Shot 2022-07-13 at 11.05.17 AM.png", "id": "521592810533132", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974907_521592813866465_1859723888539701168_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HE1cR1IoKoQ7kNvwFP8HD8&_nc_oc=AdmwoWhvWvH3F5q5kUKlwY3sJg4Ziwy-hODQ_vJ6o0MpDEqHU9NmjbhKUae4fHFivWI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs0wUp0tatjulUCLCEZQW8ANt09DMfr-iLYzVPuXCyLRQ&oe=69A18C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eCYBERMISSION VR Lab", "keywords": ["ecyber", "AEOP", "science", "experiment", "stem"], "long_description": "A Virtual Reality laboratory taking learners from the problem a soldier might face in the field, to the solution, via scientific method. It is designed to introduce people to the problems a scientist working for the Department of Defense might face, and how they solve them. This is achieved with videos, immersive science, and working out problems by trial and error.\n\nAlong the way, learners will understand other initiatives STEM learning within a DoD lab has created. From the giant airplanes to being able to see thru walls, the eCYBERMISSION VR Lab introduces users to the vast possibilities of STEM.", "short_description": "A virtual reality lab taking people thru the process of Department of Defense problem solving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1IS97uZsO7t1VsQVKRywh70irnEUtDvKJQ-eYquisSOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ROAMVR", "support_website_url": null, "website_url": "https://www.roam-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8674181782646137"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974591_588869836798626_518211285554474713_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PfDaAJlw0AQ7kNvwEipmF5&_nc_oc=AdkFi9Izc5p7Takx7I1NmCkYd71xeds2UGpCidfrdCb1EWjoc8q7PIZKuit0aoQ-AHs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvIbUtMU2RU-ohgO4J43sEpKUibK8CP63sOsLz5XFMCyA&oe=69A1A5AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "eCYBERMISSION VR Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1727370000, "lastRevision": {"nodes": [{"id": "8266267113437608", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "82662670
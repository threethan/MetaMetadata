61707567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356795_805089965040900_7535981822759806947_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWSWB3Wd0UIQ7kNvwF-dcUg&_nc_oc=AdrC_Zmq8Iv0c1HA-qx3NhRh3u7swie0MQbejt1-7jc_Cc1tpYOpM1isrw2aNcEB52g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxt7GbxgCFYJR-95sqJsgt8R_XWntZ26ozoSeUe0EhTA&oe=6ABBCFAB"}, {"file_name": "Screen Shot 2022-07-13 at 9.20.50 AM.png", "id": "1447829872587847", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207243_1447829875921180_5669273685137032215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R58SvP9EIsQ7kNvwG-dYFa&_nc_oc=AdofKhh8mToZlj7Vc9gpgr-xJkNNUwR_iDMiaipe7zIpLWuLhcSAZchvIa9aBhNjG7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrAl5zWJsOwnOVI4tjSB2Pes4yDnJZ3n_WxXF4gbcyzA&oe=6ABBB07F"}, {"file_name": "Screen Shot 2022-07-13 at 11.05.17 AM.png", "id": "521592810533132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974907_521592813866465_1859723888539701168_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIJ7EOL62WAQ7kNvwFi_LTN&_nc_oc=AdopINAhMSqqhKenbpfIfjjquR5W-bmhF8EvaBdovzk58GjmcDW37ZNtwU8XGQoODgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKso7wd3J_pYVnQuGi0s7NHGOSiFj6VipwW2z6j32qDCw&oe=6ABBAD3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eCYBERMISSION VR Lab", "keywords": ["ecyber", "AEOP", "science", "experiment", "stem"], "long_description": "A Virtual Reality laboratory taking learners from the problem a soldier might face in the field, to the solution, via scientific method. It is designed to introduce people to the problems a scientist working for the Department of Defense might face, and how they solve them. This is achieved with videos, immersive science, and working out problems by trial and error.\n\nAlong the way, learners will understand other initiatives STEM learning within a DoD lab has created. From the giant airplanes to being able to see thru walls, the eCYBERMISSION VR Lab introduces users to the vast possibilities of STEM.", "short_description": "A virtual reality lab taking people thru the process of Department of Defense problem solving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1IS97uZsO7t1VsQVKRywh70irnEUtDvKJQ-eYquisSOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ROAMVR", "support_website_url": null, "website_url": "https://www.roam-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8674181782646137"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_588869836798626_518211285554474713_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpvVPPXr3hkQ7kNvwG3fLgX&_nc_oc=Adro9qWtnLSZbNwIv9CCYSyEPud81ANUri25w8iSb-YwsgMeLq65a5lo0kUlpgxUSjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkivYFiIwoIq0rW1wUqLx3D7JDGScDM7hvoxglgwMGwA&oe=6ABBC6AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "eCYBERMISSION VR Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1727370000, "lastRevision": {"nodes": 
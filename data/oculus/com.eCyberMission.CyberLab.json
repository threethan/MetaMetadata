07243_1447829875921180_5669273685137032215_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J8Nxw6zkl0Q7kNvwECrFFM&_nc_oc=AdrHLmDbjDuCOkfEwwWxmipwxsqU228AWCwViQBGPtxPHGlaTdpDP_YdP6w-PMOVQEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2jETMAtJ5aX9NYmnu25TDj6mVu6C6BlBy2aL8RRmsVA&oe=6B0C543F"}, {"file_name": "Screen Shot 2022-07-13 at 11.05.17 AM.png", "id": "521592810533132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974907_521592813866465_1859723888539701168_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRNPAjXn_nQQ7kNvwF1ibMD&_nc_oc=Adp-h4sEAEXDnH7oMHlTrSWr7RbV0NH7VVVRegtZr1Hk6ez_Y2YU5OznBWa2C43vyWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFRGA_w-Oz5YoCDyOoq_4jrvEYKN6eHaQSjQtEmkYk8A&oe=6B0C50FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eCYBERMISSION VR Lab", "keywords": ["STEM", "Chemistry", "Molecules", "MOF"], "long_description": "A Virtual Reality laboratory taking learners from the problem a soldier might face in the field, to the solution, via scientific method. It is designed to introduce people to the problems a scientist working for the Department of Defense might face, and how they solve them. This is achieved with videos, immersive science, and working out problems by trial and error.\n\nAlong the way, learners will understand other initiatives STEM learning within a DoD lab has created. From the giant airplanes to being able to see thru walls, the eCYBERMISSION VR Lab introduces users to the vast possibilities of STEM.", "short_description": "A virtual reality lab taking people thru the process of Department of Defense problem solving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1IS97uZsO7t1VsQVKRywh70irnEUtDvKJQ-eYquisSOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ROAMVR", "support_website_url": null, "websit
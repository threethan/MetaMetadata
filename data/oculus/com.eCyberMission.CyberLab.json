.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atONQeov5CgQ7kNvwF8yjYx&_nc_oc=AdnprpZ2RFlPkVnueRNsZDe5WOuzOVPVQkkdSkbECPutwTrJGQdWORXLNZgZPhfgGrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftpiT1BnSinwU6FkFklh33iOXRZGvGVWXih_wrU-oXeBg&oe=699ED36B"}, {"file_name": "Screen Shot 2022-07-13 at 9.20.50 AM.png", "id": "1447829872587847", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207243_1447829875921180_5669273685137032215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfVUSVqqY3oQ7kNvwEsuNIh&_nc_oc=AdkK73U-vVSFeKJ9HYHARXV67CvfddStL62FIOUdvC4UaV-ZdfQBw9guJw7fc5Uaxkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftzlJQB9e_coj97C6vTOEGgFG5vnD_mhHW1vagPHHLJbw&oe=699EEC7F"}, {"file_name": "Screen Shot 2022-07-13 at 11.05.17 AM.png", "id": "521592810533132", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974907_521592813866465_1859723888539701168_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xknk8OHfMO4Q7kNvwH0Uyzh&_nc_oc=Adm3GysWE5L-SwAFC9BvWUlattQvoeh7Q2VCx3kB70DLldhGzuE_plIvBmttHHBRuhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsTQrctJNlIIRt6JDe1gDd_TelrozQ3GVgVzcF4NlI2Sw&oe=699EE93E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eCYBERMISSION VR Lab", "keywords": ["ecyber", "AEOP", "science", "experiment", "stem"], "long_description": "A Virtual Reality laboratory taking learners from the problem a soldier might face in the field, to the solution, via scientific method. It is designed to introduce people to the problems a scientist working for the Department of Defense might face, and how they solve them. This is achieved with videos, immersive science, and working out problems by trial and error.\n\nAlong the way, learners will understand other initiatives STEM learning within a DoD lab has created. From the giant airplanes to being able to see thru walls, the eCYBERMISSION VR Lab introduces users to the vast possibilities of STEM.", "short_description": "A virtual reality lab taking people thru the process of Department of Defense problem solving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1IS97uZsO7t1VsQVKRywh70irnEUtDvKJQ-eYquisSOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ROAMVR", "support_website_url": null, "website_url": "https://www.roam-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8674181782646137"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_588869836798626_518211285554474713_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PfDaAJlw0AQ7kNvwEsRM2i&_nc_oc=Adk4se0YoMnqVTzTtYnkkdxU8yRsUCh1WeUuPGYE10lscik7_TZp_cbDehcKuFcb7pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvPyKtIBdC7d1jpH33MmYWHETiQlRl77UfZrq0JfFOCeg&oe=699F02AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "eCYBERMISSION VR Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1727370000, "lastRevision": {"nodes": [{"id": "8266267113437608", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "82662670
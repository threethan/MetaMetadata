07243_1447829875921180_5669273685137032215_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J8Nxw6zkl0Q7kNvwH5C_tU&_nc_oc=AdqSL2zx8Hg-9SH3TSEVmNBNu1K456uWOfLCD6-b0qxCGwiTekqv8KNDN642_WG_Faw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSljwGtrkFGxFB36XzeZ684FUC_iB_VGBlNXIn2IasVkA&oe=6B09B13F"}, {"file_name": "Screen Shot 2022-07-13 at 11.05.17 AM.png", "id": "521592810533132", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974907_521592813866465_1859723888539701168_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0kgtWDELmMQ7kNvwFd1r7O&_nc_oc=AdpzLA9hdYisjsS0muXb7WhOY6CSlpNLDvunXfLnjABhcDjg3zaA2yFDyz-wiJO4fJw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSbCOQSqsnDDD6UFW8KT40Y4rDCd5QC3Vi2GoRAyVlgw&oe=6B09ADFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eCYBERMISSION VR Lab", "keywords": ["STEM", "Chemistry", "Molecules", "MOF"], "long_description": "A Virtual Reality laboratory taking learners from the problem a soldier might face in the field, to the solution, via scientific method. It is designed to introduce people to the problems a scientist working for the Department of Defense might face, and how they solve them. This is achieved with videos, immersive science, and working out problems by trial and error.\n\nAlong the way, learners will understand other initiatives STEM learning within a DoD lab has created. From the giant airplanes to being able to see thru walls, the eCYBERMISSION VR Lab introduces users to the vast possibilities of STEM.", "short_description": "A virtual reality lab taking people thru the process of Department of Defense problem solving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1IS97uZsO7t1VsQVKRywh70irnEUtDvKJQ-eYquisSOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ROAMVR", "support_website_url": null, "websit
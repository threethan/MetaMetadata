fSAxoeBu9pZ3W-P1IK3WB0V6N6zOhLhVCc_31EXTO8NjzbPKiMk7M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvyNmFZmmRO_wWgLlwrJA220j0Frv3Li9iJoXW3d7aJA&oe=6ADCAC37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt_OY0giWJcQ7kNvwHDt-pd&_nc_oc=AdrtCI7K9PG0KLkHCpu-kEocUrTNabnoAdysiqdfoz4owM5QqQi0s0nIuowfvQ71exA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZopOfY9YLxdIdvcHbCHzBtIvkFaO1N1A_QBtFT0yXdA&oe=6ADCAD4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bpvivvgYscQ7kNvwGxJRP1&_nc_oc=AdqdtwESgIs38HyhIbZ9BltMe7z0FdG3Yp9cLTKKW38m0_VI-5M8POCiwcKNpmNLM0k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6ktGkL1xf5C15XZn5faORnA2EtxqQYI0r4NkpFP2r_w&oe=6ADCABEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltU7XO_Dg_EQ7kNvwF-BMHr&_nc_oc=AdqMYWDRAjCdRxt9b5MuZ6XUxVM9mRBB96BBC1mjNi5uNCsUd52SaVyVaBipNilDHGQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKHDwt1JopWn5gq9Z5hFrwd6lZvDTy32_n2OEu-RDNaQ&oe=6ADCC02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIsKvDkOR1wQ7kNvwEfO_qk&_nc_oc=AdqZP63BjcUvibUdZvkKr4hpPdFLBomxpr6ySOrL2lFhECbG-QBARg1TCA_3wKtEs-4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzFE2aKvwjeFjKAxTFaBd8cLksgyUhGucivriySjFP8g&oe=6ADCB68B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.
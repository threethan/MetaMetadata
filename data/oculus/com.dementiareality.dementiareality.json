8H2U7Rte6hA4zYFe8TyEeqZTDb_tTfeV3dIfGqtbsRTjQMEDjo1_E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ubdeYlhaFF1bTcCBbe5k7PirYLhq8QuTBk_4C4SDUtQ&oe=6A450FB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ecjopt7pvUQ7kNvwF96kSI&_nc_oc=AdqPyPzCx2R3BMM3IYg9vLdFE70CEwPk5_f1wCY9NGWJ18cXoTtf94qqdyUQ6LebsEk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ulc02-tdOoj0ko-pVlPxLS6UVDsFghb1_6-AP44ehAw&oe=6A4510CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIF2m8AZ96cQ7kNvwELrLId&_nc_oc=AdonhhrSiiBfkNGKfgXvaCplDjaLV3utb6es8ryFfVhPlM4o_B7K-ic9IAfuToCh5Rg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fNjtCY4KOT7_GzfLvmQ6QHn45XxsilKkSVFe0CalVkw&oe=6A450F6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IDS11WSiR0Q7kNvwF7ete-&_nc_oc=AdoBb1cgreN5cMGoNCcQdlSDa63NJhSOoou7_7snS-bZO9xt_ONNcoSiLnqbknjAGwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A3ucvbGs6wH0O6nwalVy_mklsHb09l-Yyk1KbSqIQ6Q&oe=6A4523AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVwCqU31dgAQ7kNvwFGbOIh&_nc_oc=Adr4aS-TLfW1iZmMqjQQYz1yXXhdebryPeGmQ927A4z5NVnTIOS6rqI1LBi9QU815Vk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8ydRwj5b2erZ2ExcWt6SsQ4jhYUH9-vNVoztTQ81DLg&oe=6A451A0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.
0_AfudidX4yxrBJ3EZUtF4TOlEU6sB36KXIZRlFl8XY0MQjw&oe=699AFE37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMqD9sEKCk8Q7kNvwHbjkJx&_nc_oc=AdnP5-odkPSKWBw8aw0LKSCMhnQprUAVmNpxEwDapiJZ6BNdmbRmTNXBc0M1dgLF-HU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsSysePUqWW85KPKcmlDZGJlyvLFdYtDrAtCLVJRlefKg&oe=699AFF4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OlCAUF67KkQ7kNvwFsfnqX&_nc_oc=AdmvZNeev--KTuKv-_4nFI00Sc8O6tnLZ3GVwN5zrCH8Zh9f0rfZtkFkuOQTSPHEKUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuEiNRKPs_yB5eDbPY5uBSx8ABNVpLSCDjJuVrq8Zc73Q&oe=699AFDEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvd1ADJB8jQQ7kNvwG-1Jty&_nc_oc=AdlXj6hzdIMfxpEe4xNhT0q57Q_NWJouk0pWT1uC9zEYbnzhTQZOLNbqXzC_HobCtN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftcFpR5WLhsoKmmZ0QL3tDa33BhPkcNO0XDLWDeIVxU9A&oe=699B122C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tHYsJu5bV4Q7kNvwE_KLVu&_nc_oc=AdlW50mMdEJMv_XsHHvm6d5aqsWg5bMPDx27siQpGUlbS0ABoj0rn_RRKJuFza7YhoM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs7d_qTLJTpQHONnrMZtFqWF-wQsvVf1KY-3Vzl-Vn4aw&oe=699B088B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031431_709517551270928_6551352154271004206_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stLm6hdHDW8Q7kNvwFKOMLi&_n
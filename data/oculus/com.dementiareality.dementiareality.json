rezAd-N832rinLMlYNW7G8kR_wX64I2TKpNzunCs9BFBLExoU79lg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdIEh4GudOHA62gF2gOrQu7Jw4Xexzy35kSMAGIW-QmA&oe=6A9AC137"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pg6B6nLIWYQ7kNvwFJ4a9y&_nc_oc=Adqozk0QFk2RE5qi2rW4khW0ntgv1OL-4VlhOVQFR_rlaODihKzX067MTflaWWFDWiA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNeirkWYYUTrFsBjmCDtKiLiDiPKnSwyFGGyD0oGTl4Q&oe=6A9AC24E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcOkbNdR_4IQ7kNvwEf14QZ&_nc_oc=Adq1D9regoHxYdscrcS1ZNkoRNo5Y-aho4bBdTCCTfZhWYPvEogH0YXoAnl6hFQQKRk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOLsmHVr34wdoUTC5C43V63K7J_VFMSFgQ5YMCc3LzMQ&oe=6A9AC0EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkBnrHU4fikQ7kNvwG2IrOA&_nc_oc=Adp8Apk9Vv-Z41I7VGYl20MdV8xsj0B5_WcKIExQTHHk0hsxzhZyx_LMmWCjH0lgqD4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo9d8BdKs-ADX1NuxU7RDIpzHwz5jwnroNL1k3vMYiWA&oe=6A9AD52C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZF2ArxU8NQQ7kNvwHl38Pv&_nc_oc=Adokrfibe5geYK7cs2VRKHFejGsUfRXfoO2M-g_LQ40kRZPFk42ru8Jkh0B1Fb7NjrM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjEsZ1mMO2UuWSo2DV__sT9b-4rLSrrXjyxoDVZzDFyA&oe=6A9ACB8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.
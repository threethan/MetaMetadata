uG0FSh5qLCEB6Jl-sjRlGx1thOHMTv6div3M3geuGlH4tPEOS4Hxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTogV-4qxR0EV6-ndRV1fXOPItj69eXWhipOx-Ve6vySA&oe=6AEE07F7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcQP1mV-5i8Q7kNvwHkoZb1&_nc_oc=AdpML1Np7APlIpOSZzoBi6fnGp9yLGylJXxCCuHVp7AHTMWbU13GsZfwOCIEGfBR8zA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJramvnmnmDqOVWM-CU4pSSu2D6vJUQqur6QSL-mv5Sg&oe=6AEE090E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CayUvNgYQCIQ7kNvwFgeKFs&_nc_oc=AdozMG4xZ0xqbj0e1ommzOOGVu6OEeHTsJJHBF4g1EGvwkHQ7SQxh6bd7MU38uq_ljk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgJJoEZt9PYrdxHTIzqUkyjMGVaSY9qERgFfqsUP7RNw&oe=6AEE07AC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li-DI6JN0WYQ7kNvwGxNdN1&_nc_oc=Adp3Ly0-TcV0f_JYTZLq6UTpMHAhu0aa2bZMCskHINz9jrc5I9GTDglLuIR41iE-FwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_GFJHiOXbrigU2dvGxb5syfWJrG01fviC_ilvv9n_WA&oe=6AEDE3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9lRrKrzWrAQ7kNvwHSnzsg&_nc_oc=Adp9Lz24wf9FtJKK3hH_wWZWWNDvMUJueJrhYaRl0wi_47CKu7GUeMHpWf2V6s6rWnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjgaVU312krUJXPopXCr3zBYvszFvuSRGwXALeeEjjgQ&oe=6AEDDA0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.
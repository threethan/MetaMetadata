ul9X6DKo7Q0TnxDo7EkFPhINK4hnhWS3jFNN1FandlCSm8vOk-phk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX5ocO3jz8Lwx9NcQm9xcLtny9UXXECwOOeOcTsZa_jQ&oe=6A903537"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLnNRV0hrswQ7kNvwGlbj3j&_nc_oc=AdoHCFW6NxR8MiDoet3S0BjDWhgyG_jHPs1pCj9K_gJniTXG5xyw4NAdWQg3gnkQg_M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCZYImD8nCINiQKmhAmtPdwxO7yiJKc6lTRqdqzhthQg&oe=6A90364E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYPg5YAlzXEQ7kNvwHc4yQW&_nc_oc=AdpQKQatuPlvcvAHHyu0rjc3CDUW-z-ojeNs7JP5beabJRMKT7O2dELHP31yoZPh0tI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM5fgpSwxR8QyoQKv8Q1LqWwaPrwU_5mXfeHuMxEqi8A&oe=6A9034EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB8JXN7X5SsQ7kNvwFs-eNd&_nc_oc=AdrBJapPSSwmGsegvOXuhnlw-UjWmTJRfu90wkohZHdVqZ6QNxCRxpZuFgaz9gxk4Q8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTGWlgQIskbBPOez1moojVfMIz5xuUUeAI2k7nEdWyXg&oe=6A9010EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl-L8ip95QAQ7kNvwEeGVMu&_nc_oc=Adrf_LOTnCBdG3UnznbXGIk1glWxaB4TK-3eMqCTXyu2JSvRCoE7wYn39iFx_Z88o90&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLG6VwkUbmZ4oFc7gSDzW2lQty3DYUdDZhETsIdUeYDg&oe=6A903F8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.
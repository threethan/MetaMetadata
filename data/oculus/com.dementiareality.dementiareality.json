lHQalVbJtkX1Fqu0usseYySdBfNqJFVebT5gzWaNnOd0ecMXX26dM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE9_z5LXqMjOign4r6FKpO1I3HLoIz_BoHi2aO8ChrwQ&oe=6A8457B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI8p1vA8fOsQ7kNvwERrt1K&_nc_oc=AdpZHWJyNibYlDYB2Ag62Iqk8iHq1hC7uE_GJdzcOa7GBfLb618XlYbZZ8JQPAPqI-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO8vppbuZwsQiehcsv-xyLpz1d9ufwUmzX9S3tbxC3kg&oe=6A8458CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zDw-FeUxggQ7kNvwE8j7ka&_nc_oc=AdpRDuULyWNh1zYnFaMTX6x7DPOldmuPoxYrDGVcyVU1OPLAqeJOUltPBm-C9_lcZD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMeNP6kZgh7WgSP_D14IVOF4XhG7Spl_uxntVQYXa3_g&oe=6A84576C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw_-vSIaFB0Q7kNvwE4zNRb&_nc_oc=AdqRSq95UWU9PMlZOhFfzSnGS1mlJ104OPdKXkLCkGHgdvs2w1tJ6s-WaH1D8LKEWCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCkqDjQQ25JQlSJsvLS7sgO87gT7ZqJrW9lP5tDcE-OQ&oe=6A84336C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prb4xgkm6ucQ7kNvwGuwsMk&_nc_oc=Adrqj76QXYAhgXbghqTAoF6BSg1sccQ8WXRkIS57V9caV_sQJLs1FDUbxrNxhbJE10A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLqgj3yBToaieTMe1Covk31NJ_FMPLGccwL9TzSU2DFQ&oe=6A84620B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.
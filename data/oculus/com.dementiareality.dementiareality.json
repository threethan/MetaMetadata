WZm33TsUQVhWwC_VguYKikIEJH7EC9GEs9oKxRgrN8zMbNB1T6nlk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2atNo3LFOxYft0S8hp9-DccXU6PaAii-Kz3hJ2pA-0wg&oe=69F4A437"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53VOH4z1pGIQ7kNvwEKFYMJ&_nc_oc=AdqhlJ2vOjnewbscsoXeccT_ari4D9sPz2Kj3lRyW9gNT-qVC8ZqJEMIlvfkOzfosSI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OhugKJnp5iCuz68rVzkcWbTVi0-vmWEqZUKeTC5OJHw&oe=69F4A54E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y084RdItuzoQ7kNvwF3eRKD&_nc_oc=AdrCJ4hUAnpluhaB9zVZmhHAL1l3U_4jCSSWT-wkz5tQ5_z9jv65PoA07DSi_4D6pOk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HxrXSnjLJIrcffCU4pIhRDWAI0gMVHjSUW7J7iqlIFQ&oe=69F4A3EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4wRBww5F1EQ7kNvwG0t5dl&_nc_oc=AdpHx8kX7w-IMZIfPxwr0aa1mNo1Cf8sxkOmR3QxVyFY7XyKg-JExuoeXB03JUElerc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-QByOS030o3-LoHPfHyjgd2xwl1Ut_z8EgiaOjBzkoQ&oe=69F4B82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMuJFKPy7_YQ7kNvwFDHLTW&_nc_oc=Ado2UaWIH5S_zCLZ5JjNASj1WBthIgUszaybSYy89CYyRxiQy0Tam2PxbqnGcjucXP4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0D4e83r67BOBKbIhDdKjniZC9D7oHhmEQ53FN3Ind2Kw&oe=69F4AE8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
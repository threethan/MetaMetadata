gw_cmJTt2rkCCpMl8t2dZatYqJbCWFBkqZZJD-ymSCECEMxqTT9m0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuHxCN0J7i-zx1ZGc0PUToe0Xx5FokcLQV2UilwIg6vg&oe=6AA158B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLlS4AYTKQ8Q7kNvwFh1RPl&_nc_oc=Adp84sF48WKNFViJmkkNhuZPBfv_2O6QYWiP3W238axvGv_mJo5FFeGEbEIvQqS3GUo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf60WBCmb20UT7HekAX28cFhvS44j1iwP7J-vdBU0nfw&oe=6AA159CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQSDi3GmdfcQ7kNvwGciwz-&_nc_oc=AdrSkswCdCluL8XIxuW-EwMhaVFRFHLZtOL3kpWv9jHj1S6sIiY9uChNkSq6EQ5deIU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYQ8N7xKR1egidEoe1xYIIZwT5GxacxA7VvxKmyOjvWg&oe=6AA1586C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa5Nb5rclh8Q7kNvwFCeVfy&_nc_oc=AdrDYYry-9e7P2W32ntFKDhyYUSHdXSe_aTYWPBJUJDgxHDByD613KpWsRFREJ5ZWXk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEOnA-SvpG9EMagza01aVy56ssr75Yg5Wqbo_jdRlpgw&oe=6AA16CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBrzkPf-6QgQ7kNvwEhSM61&_nc_oc=Ado_UCzURXJvr6fnbTQg-SA1uYwCT5IyE0W3k-fQ-034bI_g6p80UtWmZp7uwaIOLn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Smz4T01c0tjMmY06LSGdEYVhxB40l7XK1J8IB90whA&oe=6AA1630B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.
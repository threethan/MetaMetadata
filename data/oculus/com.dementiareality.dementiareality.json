ckX_XwE_iY2BQPXyQ8DHectTXOPBFQBfwTWc-_a0bbsgicQUeoP7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwy4omxLmyFk9GOzXtjkxPNaWtSUAn0i-nZl8B3woegw&oe=6A7B1D37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edru585se8oQ7kNvwFUnkyF&_nc_oc=AdrX8OxfZTsgQ55VUZjKHqnzpfanUFA4XqDezybgttizv0J_Hq3M-9VydGOUE-gJonA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoGd95Rllm6hZsRpx3vY1RwtKDEGVfgIzdoqWN7ApKbg&oe=6A7B1E4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C0sopfH_0MQ7kNvwGtQbIY&_nc_oc=Adqag6LAFzaOOJXWxwSje7XTntbrAUY5n4eC9qJBM-ft1ojc-JyZo6XpWvXfmBIOdHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGsu0PJE0hlxPcz4ofIDYvmNCTGDIJnI36nxDGtUkw7A&oe=6A7B1CEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmQxN6go_JAQ7kNvwGvXdrO&_nc_oc=AdpRyrs3dmQQFPJq0QK1WhmfXdXkONg-igvR12DM-BWYPJXkTymcoXRdnZNFEX33DfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg_RF5Kfa2YgN1aPetgYFsth3Yjd8LBIqYZmppF0CnHg&oe=6A7B312C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh4l4PdDo54Q7kNvwHW16pl&_nc_oc=AdrbU-K8VZ8YbVkC6T9cqskWzBZ6_4HMnQT3HfkjJWnwkEZK3cgF_9w6CLWROXqonaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN55i3HZcuZcUYfaptgNoAhmcQ5gEWdQUoPMNFh6_kbQ&oe=6A7B278B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.
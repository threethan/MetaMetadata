0_Afu1ou2L7xbXZA8QJphPAIQEO4UZvpslpzEmFcO9VIjMFA&oe=699C4FB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaAk8I5s1ssQ7kNvwHhY-1Z&_nc_oc=AdnefX9wqvinEj6Mpt8SgVLnJaXZ0Q6CRKx8vVYK0DYxeBiEawO79vyjC0gjBOcrWGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsF7P5G0x3ZZh6bqGFEKXu56Lr4USZjDEH69271SZLYQA&oe=699C50CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z94d4nyuwGQQ7kNvwGyGF7G&_nc_oc=AdmIGsw0O-HLh3mpDYFWo63aPSQ_ZOp9qzFvu21i1mXydjFgBfYCfR9PEq2kRLV0__E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftah7l7BUz0MjCZqnzso-cQoZVmKy9Eq1rxcX3DzLYOow&oe=699C4F6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvd1ADJB8jQQ7kNvwGSNJrV&_nc_oc=AdmHDbkDx9R0CMwgqhNnwBbh3E0PeeDA-3RTyJzObc63OL3BOFhSug2R_vAQectvt_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftVO7OQu0hAaJ7OBPvR38U3UG6ZMkZaNS9rN60jXBWwMg&oe=699C63AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tHYsJu5bV4Q7kNvwFj9Tfc&_nc_oc=AdlRk4OaVizXBpUiZIj6eNmh-gz6KQO2G1isR1RNKex0USmhsIJUORAys1hDQB0WAHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvRhrMZUXhAWtJkKBv-cyomoXzzuLggOAuj0T9W_ujBZg&oe=699C5A0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031431_709517551270928_6551352154271004206_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hBLIf6VwW0Q7kNvwEU52K-&_n
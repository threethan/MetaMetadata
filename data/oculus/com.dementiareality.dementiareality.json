ZWoRQC9nKoIDcxbp5d8gNIBdmsa51LnU31P23YGyFahiZHwBeV0Bw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmsYsjmqcfOA0qU3k0TrfGAz0FAmrHSuIoxg3n5N-xSA&oe=69C28B37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0olRCwNbu0Q7kNvwHkQbFk&_nc_oc=AdqWpS7SExCvYEhHdrc2YBlwe0zptrSP_Sx55N9wfR52_Dh-RQTFehPjeQ0yJ6FDEE4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9Qz-KvQ-VT_-RWUbOnBsjkkLhLC5sUiJ4tef1UDcPTg&oe=69C28C4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_2wyYNnyMQQ7kNvwF7K8Xi&_nc_oc=AdpjLFM9QDzDH67x8WKk543WIv89L0KX3MBjPmsykzLbzoXk77mR8l8ntnXLnwNUbUM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcTnfGClKamkQ5RoiKTOSw_ueVUIJhbsRilSycdfNO4w&oe=69C28AEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnQoLK7PXRcQ7kNvwFiTjpU&_nc_oc=Adqqelro8F1V8CsP6keQmx_X538BUINmkYch6H7cD7wwtJvWghFmsRAvPIr9EfOaILI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj51ZsssHiYwlzZp_HgGQH77WXi9z8c9HzNHcm2SRG4A&oe=69C29F2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nENrmVUnOK4Q7kNvwEr0YZw&_nc_oc=Ado4J1pI2AS7edQNgKXdCZxnjptcbequQ9XPS8USfA55-Dj4pT5GOOyP2ORoGZe6ztg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJ7ErTQKSLt8A4tdBhZLTuXeyQ-xr6LVh2tGFOTZtswQ&oe=69C2958B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.
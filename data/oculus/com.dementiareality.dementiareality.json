aDTmqwIz0zVgtqjsEXBoYlHGR4-6C8I_Gi6UyFa-KlODuRAk84tvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rCYWSI_NE1kyVzBH5amq5Cnx9lt7wIzoBg5qbIkLaKw&oe=69FB3BB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxZcuwuWeEoQ7kNvwHhk9YG&_nc_oc=AdpZzNdyq-aqCgstkYviJRiMt80jn2yjiKuHobIk89hG0sEldPkhEmpfQkz_MCx2BzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ht_RBYfJmQKT0jOrki1xJJkJvTvSDFTG-4YnJ9IIkcw&oe=69FB3CCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VSsoWiRWxMQ7kNvwGi6-Y4&_nc_oc=AdpFt1MnbaL4eC9U9gjvWNMT3R8S-KyyKY0wkeVNXhG2TbcO_v-tyjsMt5zrkD3WukY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o1NGclmDhhOEmJ5XYOGYt8Mp-r1fWE-P9nFJyOtW6tA&oe=69FB3B6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9CUy62NWG0Q7kNvwGLUPWT&_nc_oc=AdqPVEqeuXbO9ImZ0LUT4keJ32EVsrBo_fpZAgNGV7uXKZp0ENF-_D6dn5X7eYgZ1Z8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W8fINmfVIc6Rg-hqydn7fVGTzFhSXCOvlzo3S3QBLYA&oe=69FB4FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGwX2tDEbD0Q7kNvwHdJtAQ&_nc_oc=AdrZURWFQ1wZ8ASZxln5H-udjdWiQUUg8bAgmKhLSVrTu7-c6Y-wW1sFdNNZFItP9VA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eq4WFQEOQOly6I_W6pSpm1ryXke3m4osaNwf1iJJkbw&oe=69FB460B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
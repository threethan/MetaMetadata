Yph8bzJ7q6xoYHwT8CP8tycw_iafsgAZ6nFhJznEw9l3IMHZQkoJs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gxLSr03kHiN7jNA2PMj2NyYICGvHje7KQRTsKVRuhsQ&oe=6A16EB37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpCj2vcQG6kQ7kNvwEu8IDB&_nc_oc=AdrC8FzAiBOUAFsg8EhM7svnRfpXfrrRhGo08bqaZddmlWjBMmpHjsBL0Ga_QqabjnA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D9BWiwHgxHP4gYcno-QkPmMioOA_W7gygbh0rGQXvFw&oe=6A16EC4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByFg7rBHsaEQ7kNvwHP-ngN&_nc_oc=Ado6n20SUTX413X0KeTXBr2stKv5ALPBoPVekwwhAW2Y_uw8sJXR2rVxvzM9Wv7_df0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7olFFQ-WCoFhLLldG0oUL4NuWvmTjp09escaCdStFbDg&oe=6A16EAEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoCqEZDnlqMQ7kNvwGhldUh&_nc_oc=AdpqoLLtxy6UidFUk7Cl1WeCwQUKVfGuwSmc1Y3AFUGo8P77H6DemfqtE8wX-0C-O40&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68fSZBfruAqr2uGhJ65oex4E6sKmk9U4Y6X9IOs6cPWg&oe=6A16FF2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPeviLhumlEQ7kNvwH2wj2u&_nc_oc=AdqN2L4CYuzazO3EJ7gsuz7rv9IFMXVF4LMgF2GIpcWSghIf0pPuCd1XmHWXkjt_6ZM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7es07aXtXt-BI6KZl1HW1vn-M3Gj4y04b5cNhIb2NVJg&oe=6A16F58B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.
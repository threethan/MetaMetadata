428085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce70NEFKmLwQ7kNvwFsfCu8&_nc_oc=AdoBoTyfKaKjrUHDJm_vFclR8PT2pwuiB6eWiBZBYMVecWhlO5nQ3wl-UsacG-NG6mQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa1sJkRciuoHgjGRieYvw2UHAj6useNpnvUvBiKd2xZw&oe=6B0865F7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q0_wUFu0L4Q7kNvwHjoUf8&_nc_oc=AdqNKOnuRbyzbPmgztSpUupSRj1EioYXA_KlMn5uL4wcOTHvf3fkDISJcsMG1qEybq4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwYsRvv_S9hbjiz6fUjBmpkEZGacbQlp7JGbVpcu_56g&oe=6B08670E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWflOebc_lQQ7kNvwFGX2DX&_nc_oc=AdoOnIRfh8uqZSLgWnCEBrYtRgod0pNu7_ayqSdcnqEfzqwf48wBakZXlNhs_H5tXCc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHLKlZ_cheL4GPZ9hCRAPQKcKa4B8X7r99pDvBzRD-2A&oe=6B0865AC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDUI7bS80zkQ7kNvwFRJIjS&_nc_oc=Adoswnar5AI4hoQr9GDCYbNzYYwB7sdF6WIDH1qDUQYwub1CYDUXC0WRSAJN4_GjxDI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiddsTQgyD2BpgA8yamTdt1zMNbPSEi-Zmo6H0QZDHpQ&oe=6B0841AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyekRFGI8i4Q7kNvwG2xVMJ&_nc_oc=AdrzW6lhCI36gHGQp4jVNSzGdxeycUMXC9eFSBjXIxaa330J1WGPEGHlB4RjbJGvyug&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiUp7qvmep3jQJrpkJcJcBvv9_jdsbLroPV7xQAZXs-A&oe=6B08704B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
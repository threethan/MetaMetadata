1wV3eGWIikYf76h0tynWDs13Xsv1txvRuWdfHAqOS-OAEl-28l7Hw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YddV7rB-icWvXK8D_jGveehu-v22BI4MDNh2tQK_0mw&oe=69D25D37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3wmigUqC9kQ7kNvwGPLLnK&_nc_oc=AdpydRFncfjHsBdK2zwy1NRmju-u37w7laFEJk1jcVXhWj36Bz5VGheo6-xd8MYDzp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24QYyALHoOiY9jIqFz8emCbsgj3eqWQTQXOjQJOhM0Qw&oe=69D25E4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v40RcWy1gcQ7kNvwFYnCCa&_nc_oc=Adqw-AUsypaCQ7egknLmUx0rFwWxSkuujIvX6yeptDsf195nXXM9_p-amSiRKogmqaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R_Xj_PYMThDFE5Kk_ggnDQcJCfTS81QjXn02WWPUpLw&oe=69D25CEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SHg-oKSBboQ7kNvwG66wyt&_nc_oc=AdrigfKB4q6zOjCQhlFV5hvSDHCR9o45En5HWGyn7Pa8wE5jcySne--XESTTJQtAhkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16aXMo8PbMZHGKsoJ8nCJLwDxx-7PoxaoYh64KTahqpQ&oe=69D2712C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZSLcBGMgJEQ7kNvwEGGC1S&_nc_oc=Ador-qMYEeyjVYYOXMKNQQBw5ExXSKzRmNuasQ7KZLEYja8ogjl71x6VHrPa1KLWSSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jVBPbxx3X2o_QlynYGmuvaiR6eq5Moi5qfdVBFpy6uQ&oe=69D2678B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
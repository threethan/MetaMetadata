cmkd3CTlkCp0yGYjIxNaVvpSA0JAn8Gy7w8H9IUSALnwmZ78atm5Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74H5FgdcReFazuqt4ZmcWQaoGpAOP1GDB2HVt901-A4A&oe=6A0F0237"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJZYwTkIxvoQ7kNvwGsvbTZ&_nc_oc=AdpiuKlwkHWpDTxwSRc71-D0a9Seete3uSSktelLkM0e786cLwwlP9YAWH9Z_gv4ZSQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_aWFcV01c7xX3rb4YAIEaywNKyhldNw-XV0BmatZ9_g&oe=6A0F034E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKidZcfnZ78Q7kNvwF_-aYl&_nc_oc=AdpD56HH1ywyJ9OhxrUPI1V2gK-220Mf20cftkvrXdMGbMECR30UKxbpyo4JxiTYL8M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YABXOTBXpjzpXWr_ksT-yCEb3P4_g9rUV2NDq0-lc1A&oe=6A0F01EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydX8n-GlekwQ7kNvwEbiog_&_nc_oc=AdqWumaYPda7tHib8_kTPoshiI9xM8um1fAZfX0lkKDdswdNGlcXKCfv17dzH94mkZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76uxKRzSJty27QpTRQjBAcmu6MF1PlIhQME--zM8sGxw&oe=6A0F162C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36K9gk9V6MQQ7kNvwH7EVsH&_nc_oc=AdrKiHJTaW6FvYByxnMdiVJXbHcpH_kisk9p0-lR3_L2M0nvtNQDv1OMDtZQnd2J2c8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rZvLaVTlqqIiWuSPfegQkJv4CkjU88WzQF5Z0wZrcKw&oe=6A0F0C8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
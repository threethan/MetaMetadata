_USl__GO91vpreS4V39-UqV-BOpyg-IRSKPSbN7Ikfjv0l7HvPmzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOV-fF-TKaQa3iBtoPOLz8JBW4N2czqqBUX4cyPDsPWg&oe=6A4CF8B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erOQQVchyMMQ7kNvwHi3WO0&_nc_oc=AdqVis0D8AKQ0H5U2zwtnDsJ2W4Y7nsi6CEaUxslpgiLXnhuQWA2LZhEqgMyX2Oc-zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSQb_rHVAS7PsQLYwnZpZi_croLeUawV4yL62sM4hsQw&oe=6A4CF9CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfRAAS8v3wcQ7kNvwG-O9pg&_nc_oc=Adp-iOkHCtiHJdd8imHvEWnjvaTiC2xotCC8HO6gKOrQgZ-1_8rkbj9Wh9pl8mhAlZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3ZKtUbFwxdSYDnli3pZe6GBxKx2j0vs9g41D5F8ztNQ&oe=6A4CF86C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYXSx2UFTlEQ7kNvwF0Izew&_nc_oc=AdoSMjk2wwEkEq0NPx6VPdPDEoAHjSUDdWHgfwRv5sHUjZWBeJvGDuu66wiriV98EaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrQ3uDouBYsyDSXlAth3gMAxU9It0XVYeAblrC-3xJZQ&oe=6A4D0CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7RKK5JKHQIQ7kNvwHajH49&_nc_oc=AdrJzzaGAaH840oCsWx1XzjtSjomxu5ksVJnJrhF6Ku2VT9Njuhgigp3M2NnKD3yFIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt71GmYCpetVctfJIL7i99yJMeEgL2zi-QgS8x6cyV-Q&oe=6A4D030B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.
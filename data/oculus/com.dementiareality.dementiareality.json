Q7kNvwFcSp9_&_nc_oc=AdqvAInVCLp89D61oPykmEdWFBIczwI3ro7hGQwNqM_PuzD8FUlDr_f4HHoBVOt9hB0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0390VByccX9IAvk34uAfCsoHhE0U1Fl6jt2W0LKBaVA&oe=6AF34DAC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5Xwke4dbNUQ7kNvwGHx7tY&_nc_oc=AdqvS579j46sv8CRs9AOdSXBiPTiYMa13kocU4XBkaYfEw8CmXezTZQD-tCgaqr9k90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8VZKRjZnsu8G8Ljm4xY6ZNevBu_VIgzEWDK91l1aH1A&oe=6AF329AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdfEV5OVhJkQ7kNvwEkypv5&_nc_oc=Adrfhnzs2HHmGr2tAI9qLD69d27OaB6OCG_wSgU-mKP24K9-lSFfzNU3XrRQvArJqfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV9_M8FEF_Gb7SqA8-I_CIreap_HOzUwgJb6WM7fTQMw&oe=6AF3584B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1184783355686091"}]}, "baseline_offer": {"id": "1184783355686091"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707512644, "status": "PUBLISHED", "id": "1184783355686091"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34151159661197181", "version": "0.1.2"}, "id": "1035037664214153", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24335839399395972", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34151159661197181"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE"
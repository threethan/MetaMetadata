0_AfudqiNGo9SstMfgnZLnsVhntxoQG3i3HH2_XxCfoqIoxA&oe=69A6DBB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_BoDII044gQ7kNvwGVjF1f&_nc_oc=AdmeXeZNVl-CWa2mbeUsoLFp0inxIHR2ZKqWGYWugwlsMJQh8FF5HO3DLMrObaeGWyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstlyZw29Pacp0aeLFH650rhZW-MLtjChK-zpC4yoaTug&oe=69A6DCCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4DVjSPhIuoQ7kNvwHdYjtH&_nc_oc=Adm_kdGN4_KSXO3ZxkPqEg7YLE-ms_E43soD21hGlHlH3bSkwUqxXFTj83QPVV7xu8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfttAz7JGnWVki2HL8nc9FGQNDtr4Vakpq31jbjUM_2THw&oe=69A6DB6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWb48J17LRwQ7kNvwFyP2KP&_nc_oc=AdkVCAWqKzCCEB7ujR513wqgHM4LqVuFb5nIRfiP0RIYHKgdI3XdREsrvNt8s9hSCfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftanK58867stijVytH-XfHDWm_Yq9-0dq0OTgxFglXqpg&oe=69A6EFAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_daVdm39LMQ7kNvwGxRLF_&_nc_oc=AdlhjTjVNJxuVk9ORQzr-rrvfvkTcI9JXw8Z-X4GyWeFDhrHNyhmc1AVNA4WdX8dvlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfutsPvSWYRYG0agseB4P8nv57JGOypVS5XyU-UN1NOjQA&oe=69A6E60B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031431_709517551270928_6551352154271004206_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbUPuoeBs_gQ7kNvwF0tWqU&_n
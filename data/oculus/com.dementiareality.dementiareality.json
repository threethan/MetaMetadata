6owNmR0T8mIUg1Uw29jtUkjSOR9R7CkYRUxD-3sHCIL3qA243c-ds&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReQmCRaA6SmfHGj2vqHlYY4Nhx4KGEYNkN6hLlQIW3qA&oe=6AECB677"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcQP1mV-5i8Q7kNvwHmWCiZ&_nc_oc=AdrWc7ZMP9fsOmjnLauIK3-ysX6if6c5jXvVNR4Pf0GFelrsRS_rjei58LhVwzKAVM4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoYtqzUUycJN9-OD0IYcpeEEPTtRYLJnKFqRSP6QPhVQ&oe=6AECB78E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CayUvNgYQCIQ7kNvwFfgv2v&_nc_oc=Adrg6wf7soW9Ss4S35lgeekFjJWoaeRId3b4b4Cn36UlmvV7NAjw5mkF39kjD803ygg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRigBrZZ6Wd9MWazgaz8Mx0vnfHvtu2SMYOICDxHu9ycA&oe=6AECB62C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li-DI6JN0WYQ7kNvwHwOGQX&_nc_oc=AdoGrGyWzDO1y4cqbCXZvKBQvDemZt97NVSfIHXFcXURCt4LtGZIt5qZkPKS1CfVDjc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWpR-IHTzxzAPTjOwjqoleLW-YqW2r_4QqNwPPve6nAA&oe=6AEC922C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9lRrKrzWrAQ7kNvwHwn5qv&_nc_oc=Adp6Tm2_bJnzfpzBBwuQAwpSGWGycoSvTucFFX_oBz-UT-aE1kDAWzkT1V1eAzvbHkg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaXt0_pRDTHm-GOJed5h8o9GBzT5r-gK5wiwvBIKms-A&oe=6AEC888B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.
Ad4I_vF-P_rpZSnfD8nRJOAy7sx6qokPhaOgbebbHMHpMJyHet7dM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TUEG3acX6XhTQq87b76phYy2UTUM1XB2wtxhAQvFPrQ&oe=6A47B2B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReDpfxbdqTwQ7kNvwHDH6Dw&_nc_oc=Adq-Np1EsWKqZ0QmgeYDQeDuXDxdSxTTEGyrnAai9wFWfcn-fGuJyjAATb8X9x8K2xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W7MgrMtYHSB9aFU76KNULHmRSdscHEMZT6BgNJLG6mA&oe=6A47B3CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81ozQ3XpmJQQ7kNvwEZZEVs&_nc_oc=Adp70KKS2-lmUfMd1yTRx53sdRrBiabcuV3YIdfPOGhYsD0gmzfTS1DlsnmYpCrhp40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97A__LBTHuRAAC2QveQ5zqm-j-RewOSzxHWww8d8xW8g&oe=6A47B26C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IDS11WSiR0Q7kNvwHcYHn9&_nc_oc=AdpmIYdTnzuozyqfbvi_LrndbQ3LrwB4s6Rmb1kgX3FCj3EaabJJMecD4TQBYzwtlx4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89v-usStYBwa-3yCJs2Yc1z_YrVO-N63CN-3TvuHAD6A&oe=6A47C6AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVwCqU31dgAQ7kNvwGCJU-f&_nc_oc=AdpopuVr2ELN6b6B1T-mdhYCvtf8imv59BQ4i23Slk9V4Jfya3bE1MKN3YWQOIwYVTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R6V9fBI1NhUxuZ_eCpfbsKtiLrrkbhqMcS5hljjX9GQ&oe=6A47BD0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
0_AftXBVtOzTo64cvbZJzNyhDLgIuvg6DVWfYjzVza5I2ILQ&oe=699DA137"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaAk8I5s1ssQ7kNvwEu4X4C&_nc_oc=AdkoEpxEeWuuAWEE08ADAflRKI4igmfV_TAedqO8oaH50wbmQ5zPR6xt_agtR_qYpBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrVIeQ_tNELhw-u-QYoi6w_Je9elkEslOJPHXVjVaGAg&oe=699DA24E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z94d4nyuwGQQ7kNvwHJjhVj&_nc_oc=Adn4gV1u3ch8z_T1sA-rIFaxRpfd2O19-unUY2lY5J-nMzf_aKnfuOb1GfYNCS68q_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBXvsrrPF7vQpxJXHFNOYSXeQ-YnyGNQA0RjNeGNBaGA&oe=699DA0EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvd1ADJB8jQQ7kNvwHUnuDP&_nc_oc=AdmUeWJdA0wi7P3RLLvMZMTn7dp6EXnv7cZKKs5eCIvCvyTsg0I0RYs5dvLh1gKXD3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBG_sftt5DU7dPMW7uwHgCFLIxO7j2Mub5GWfAqzsUWg&oe=699DB52C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tHYsJu5bV4Q7kNvwGxzJNo&_nc_oc=AdnWgC2IZUGfbkTx06ZB-ZrbjFzsQQX_vducPQB0wCTlsXLLDu0DLAHmrzF3CZThdMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5iSeAjqddb4le26fnKd2WYgO4iJ0R2fvyPDfOzdEdrw&oe=699DAB8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031431_709517551270928_6551352154271004206_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hBLIf6VwW0Q7kNvwFlKW7j&_n
428085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FojRdYCKiVkQ7kNvwFbP5TU&_nc_oc=AdrH7YAJtJRUG52rp3J6m0QilSrq4lhW06XSoZ_fQy5UMqQ7bafc5ZOSLPeSl7a3D2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_LKUu-ENt10bwLWKlPFTLFbo0fhB5SwFMJpxW3vdUWw&oe=6AFF2B77"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff8HPdqfoikQ7kNvwG8eyHP&_nc_oc=AdrYjh-JeEVcddADBVd29KYKuAFVzPlarq16EbfnSzYHVTLCo2zKDe51WL8c8--eouU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoRePnRkdLV4itc_mMNuDpll_-KzyV6y8l4rrYnS_2ww&oe=6AFF2C8E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1Yje9pNrKUQ7kNvwHZDAgK&_nc_oc=Ado0uzkpzc3taRHtJ8zaQXtnsjJEMkdh48VQeHk2uU2rbuySiYlqqgmDI7k0WfT3vzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBAzf4sCmTUULnkqnY1zDrgJTEMzfN36ceQSYjsHze6Q&oe=6AFF2B2C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4LntWNQft8Q7kNvwEgSQ9q&_nc_oc=Ado58BFAtG3-dq_M5_uVTw_5kZYQ6OqrFQfQhP4fia7t8TVObR7SkF56XTfvZO3_HtI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3FKkbNr3Ol0t7-ffyFcTSESCBPRNjOT7nA_d31BE_Og&oe=6AFF072C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeZIV8a6mgoQ7kNvwHjXs8U&_nc_oc=AdqlTyFfJg1x0bxCZyPcMLuScevrAuM3j2810wBviTaL7s4numqAzvw0ZEmuBTSnv4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpCW2ohosXFxa7rPQCjOvFMn5heyCinDbkheAQk0q1Pg&oe=6AFEFD8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
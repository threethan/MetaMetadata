C5rr1Tgu8IPK5hqWbEmBuEXehmKelH8-rAuQUqKTTv5bSva-sbJ90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gv3dY_nXqsuU9bSSPdCe8_kUenp98b907k1EAwn_syw&oe=69DF8C37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRzM3uz8gMAQ7kNvwE8Abb4&_nc_oc=AdpBQzFYQ4G3YFH5rJ2GJwRqzYK5b9rF4Zmmw8Y7C2GtecahkUpznbPpI8P6GRKBHak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06f3R22ux3hbQegXLrJ2e6iQ0wxDoAZZzXBiRK8JO50g&oe=69DF8D4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl2FtqY9HwEQ7kNvwHmyeOn&_nc_oc=AdqEmSwV5gWfyxBdzXaUdfp1iBEgr6fn2vekwsOhyI3EDG7sUjwjHhVf53886rwtTH0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e43qoEl03_9a6hKBVhUi0V3pgLMGm3kU7EyFYcFFsVg&oe=69DF8BEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzK6KFEzmOEQ7kNvwFqCOSX&_nc_oc=Adq05Q-2l7eEW-XrsPkK2LurYH2MnV3Cxavnh0JX5RR_cg4lWfFOBj3FADnnaX4xEq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35LyZoQnHZW8hl4KbjPzw9ajuqOQUQv_mnnmhAITXxPQ&oe=69DFA02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ_8b-EVYtkQ7kNvwErVfHS&_nc_oc=AdrAdxGtB5rfxUrtGM1opdx8_RdwIibRmXCg7ZMDJBLXJdWZbkipcliMigVlT2p_at8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-5YuVJMvZ1UFvqaN2VG73jRq7EF_2ekYmFHHjMg14oQ&oe=69DF968B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.
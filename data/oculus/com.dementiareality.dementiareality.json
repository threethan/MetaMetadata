010gkleBOHm0z0Tqk6SKW9qu-IL2wImUcgd13tszUvlDargsAF10Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyZ9FkiTxzhnzK5Xgr_FQpCLIT494PwZ-02LuTlzRkAw&oe=6A9429B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veeA6DDLsikQ7kNvwHchi8r&_nc_oc=AdprB7MT3BTCl5Ptxpjk8BHQdm6-KFJzVdYIec-6Spa3yL6KRYEsNO9_2rdrUCm-_WA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAcDBKR3LPXLC50h67TNoqPGUuxT-pQoQr3ZVcqlAZGw&oe=6A942ACE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pe9PcC8wS0Q7kNvwEa3Lta&_nc_oc=AdoTfv7G85jDHASe8-e0VFTTcFt0IpDJPB6byr_RSoKErgbB8Nd4LrlPip1zXAC2v7M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtWTdYn81exmgcZIbepx7r8Ubpzg4QBYIAX4QpS6Jm1Q&oe=6A94296C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu6z-erDtX8Q7kNvwEVcID1&_nc_oc=Adqks_w1Pfk7KfpH5s7SavZq7nZVTtpORjc3AsM9Wm1KHOHJOLZlNp9-yNFBETqr41o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgFikATZjRSb99ePfTIjGizIfRUxznZTZEb2wD6XXOwA&oe=6A94056C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyi2YTcWJ1QQ7kNvwEMgk9g&_nc_oc=Adpl5sYziZJfvoaNgBAQK5MNhOaVL582S_re11-jEM8EcC8J0KzGIAGuMOYSD-YnGoU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTtT3xWl57myxosmtdZH01kHdqqvbhvVUdOe4ZXpv0mQ&oe=6A93FBCB"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.
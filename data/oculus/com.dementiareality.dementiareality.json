I0MAjCBSvoeAWGU4YSvrLeFUHQMgg0rOo-XC9wnLqscIcpkRp1vTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxQ7wExlJNY838Z5POWNaEXv7g5IPO1FSOa96P0cnP6g&oe=69CE68B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_SZY7zvwcUQ7kNvwGcLImw&_nc_oc=Adqai7IqwYkwJNx3difPfU0C4xsbUdJpeGxm8KtyMKHXm2L921OxCZl9hT3UVSvYFok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0RIKMsavzNmmM6wq6U720ouiolOxfbm6lWqXUVz9xDg&oe=69CE69CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF7oNFFPwLEQ7kNvwHeZrwF&_nc_oc=Adrgttnp9hYSAxi6-RTbCGWgQNaAckLutvK1yZNsoPA_NTHG-WJnrCeBRFDMa_dDx4c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycM_uA9RVwQuJQqY03boZbMuVIbfvX4vqMOHkx8ulOQA&oe=69CE686C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOnJtmnckPwQ7kNvwFY54Mq&_nc_oc=Adp082IIb6GLnSZ2YYOyktEScyqOTAxbmTBXvwVlm8DPMpI3BLej17lJ4Pe359v2ujY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPPfoZK0b6JZ7o3sl8OnHHulyChIFqZV2hQvI6ieu9pw&oe=69CE7CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uajD5E9L9HIQ7kNvwE2UY3Z&_nc_oc=AdrLjQg5QltlhAIlgxqfLxM_drmpyllY50GqO5RpDlUu0WmTJiz-7uTmp0gj1jFpJrQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjN_pnPhM6Gt9edS1O6eNUdBbnllNVVCf-LFwt3sRLJg&oe=69CE730B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.
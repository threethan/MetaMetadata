He8CfQbMjo8QxozGGGS2hRh566TiLDxA-w8Vf10iafwW2hjdvj7uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmHT_3mJZp6aKCHBBn7Fc5RQTMIoR9UXKjlH8wjbyklQ&oe=6A523EB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7YGdVlPbb8Q7kNvwHUqwPG&_nc_oc=AdrPwbNi3fJ0UiJaKtD5V0eTGY_zJ2_wh5xz_VFPWOCGXOYLbYfbxb_-E44JgoVr7uU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJjG-Y0FgO0ovuT7OFnJ0DVkV2hVej4jihs7wEi8N_uA&oe=6A523FCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj7h2WtuaYgQ7kNvwE0bLg6&_nc_oc=AdpJZ9dCwA0geBSfo46n4O9SvAGLSZ29mJ6Y4j2Y_MuLyo0SkYbSZahsU3aP6XkNDsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXjNd8hjotEU8FWMcR-sqi4k7sQFm6NGUj81NkVwRsyA&oe=6A523E6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb_hyGr1DGgQ7kNvwHtjqTV&_nc_oc=AdoBuj_WlO0o9ft0NMDEyUIDleAFBvn8PlaFQ44Y9QJvXodoxR4YHKu4sLZvEHNg_SY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKXrdzRsowNez-mguR0hXsTSzF_eM0IUHIFKCpmQCzYQ&oe=6A5252AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OZB0v017ikQ7kNvwGdTwrx&_nc_oc=AdqofYVBV1xh-B9nvYLNnu9Ks9J4y7BIM8mFGEZJVfO-j3x3Dg2JqjoNTO_q5doE7ew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACCnaDOkPwI7HqhV-QD3vSj9vqcA_eTV7e_bpV_5DdmA&oe=6A52490B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
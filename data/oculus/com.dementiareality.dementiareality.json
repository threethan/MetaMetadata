ceOIpJLCYi9lnmBZkbib2TK_vWxX6TJIhNgLonjhTaCLRFiwzOSIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl2VUEyy8cL51RVeuoytkKkD5gZSBxMMDzArrHvXA2Lg&oe=6ACBC0F7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGb_1JGZgGAQ7kNvwEki2wh&_nc_oc=Adp8fbcXDjYWv6q7xT6jakKFOgiqDXVAJOZObTm0SXUT-g5Di_QIIQPZ7N2tN2lgSGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6bbeMBaoPI0hpPss0pboAu43fcEAwTri5_d1o_JK-uA&oe=6ACBC20E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWAdtQ7OxIIQ7kNvwEqRAz9&_nc_oc=AdqrpVasYqKZoumVbWvljVlDvTDP7GZqIxpYHuGLpoxAS5Y9QkFwiJKsYTfUtuC2Cak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9TajVuKd6Pub6-U_-eXiOIvJ4OVgdQJcg_GLY6TJKjQ&oe=6ACBC0AC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meGV3wzyY7kQ7kNvwFkfpkw&_nc_oc=AdrklACjWv1t3fko85cDQSCbEfTgcsTDjCepRDFLTQeJfZEbWgCv4eOHide7Ed1v2yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI4v7h1-gi96GdlYzy7s6iTtLOEXsgqYuo7oJtXOuFJw&oe=6ACB9CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gvmrHCr6nMQ7kNvwElkzvg&_nc_oc=AdqlcbEc4zl0HzZ7NupKZTlGQXa3n9WxMBZ4MFB-ODGWlifP3ge1Ze6ESvQq8bfsM4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUDK_UaUZpHpgAHQ1XCrv2ezyN_DU1T-oVX7BYoS18aA&oe=6ACB930B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
4LQMhRspqicXt3ziRpPWd8WzKK4ypycWav_NaEEsxjU_2CuvOtXew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QnT6mjS5pUyhHGvkWMlF2nMFBGjG8_Gg2EMYLk-JwkQ&oe=69DCE937"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9Vv7lBggV8Q7kNvwEsY9Rb&_nc_oc=Adq80vSaGjesnfjOhBUPXC_xAHnqlRr0uI0ONqnS1gBoOVhrSOS5P5WX565mftY82U4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0chceBWTuz-nVPnrlOpJQcZ6V7Ixs54EcfkFP73MtePw&oe=69DCEA4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1PIiOjEkgcQ7kNvwHeU0vJ&_nc_oc=AdrAEfplQJHF7Kc7ktx7kpGZEy5114I_nI4k_NegfJT1hm2bPLCRuH2QBnnZ6AdL_vU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K6vttwWWWKLEApoMKAKmHyq8dpUPOn5P0xZPn32nz3w&oe=69DCE8EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBQ0lpX8EOkQ7kNvwE_lNke&_nc_oc=AdqPerS_6BgauqY53CKKYA0abeqT5DnwYmOPqaHXXA61P1jHMtEPVMTgjC65w86OsbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RANO-53n1kJc-V5vqvCPm0e_VsP1gMWJyAXFS50S07w&oe=69DCFD2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=datL-fqnutgQ7kNvwG1gc95&_nc_oc=AdoMAk89x3l7s7Em0Vd80-7ySZxgrbfNJxwUur5ztksysodfL7gd4VxkzVmCa8mdS9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03YNSihv-F4qI6g0pydOYpmOkMw1A-h3gdI6R4O6BpnQ&oe=69DCF38B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.
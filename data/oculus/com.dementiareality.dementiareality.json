qNcq8TxUxW-0nqfC8JrNCrTtraNOsfRxPH2E-ypCckTWvgAjF0Bdg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWXvLMhJd9q6wzvTKHDZjfKubO0NiAj23l2kEBad87dQ&oe=6A539037"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7YGdVlPbb8Q7kNvwHThR2n&_nc_oc=Adrwc4mBaE8IIPbpYsliUQ9oxKhErsw2A7aHtRBo4UUx8nOiF8n0hoAHX1fCpDury58&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA-j6NKVSA5h8oHrUKdsEMBtgC9q8DPTS2td6phTnSlA&oe=6A53914E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj7h2WtuaYgQ7kNvwGAdwUB&_nc_oc=Adqq1RLhO_A-2u3eOyIDMSbHOgd03QvIxLWUZfKHuU_pt56n3YGhKQIA9CHhgcG3f6U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDNt1AVyYxekChgPrq2uApEZlEivudF-KVG3E_HcqYWw&oe=6A538FEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb_hyGr1DGgQ7kNvwF4iOIc&_nc_oc=Adq_t3eZM6GQSfHQkhjoyTRfyyvfgiEO6iTlrds555wO0jhKyOSr7celwRgfqNh-0mA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaKDJSEIPVV7WjmSgj4_wvT59lLliGiU7QL258gPfTIQ&oe=6A53A42C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OZB0v017ikQ7kNvwFQgW9P&_nc_oc=AdqGg3lc6E8iJidyYCChxBDhd1iR10sA5a3X3QPDAyglVDN96r1KWVJ7-5_oFUc39Ms&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy3U33S_rnpLLtVAkL8rFwuibE8P-Agt2QoGCec4HDlQ&oe=6A539A8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.
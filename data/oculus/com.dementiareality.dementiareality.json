u1nAJ5hY_l3zG5kW33_EWo0AcU5ZOpbPRlnQLBGsnSGt96OXvwXpE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TZwlt8Vlhvivof08oViSToI9YBuI_IQ9Qh95heJ_nfw&oe=6A183CB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpCj2vcQG6kQ7kNvwHOXS3q&_nc_oc=Adpp_m7SsIqBNgNkLzIp9dO_NLeVxPbWjVcqfcHjHVdk6rvlTAw_Ny1MWSpu75fDYMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56UKuoo310C4lk40LR4WZ8YO3xmJDt31lMn6a9hrDX2Q&oe=6A183DCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByFg7rBHsaEQ7kNvwGRRbMg&_nc_oc=AdrJwfGCdOC8tw-bTJSOQlNtLELnH9B60c4E8Lddoee6iL7X3XNfMRgAXH3ql_5jcBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JynkZQWjRL6mTugsyuwYpaEJjz-EpPcxQLLoOFnPrqQ&oe=6A183C6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoCqEZDnlqMQ7kNvwFbuvvw&_nc_oc=AdoHno_QAmLgl-J_ZWqhdIUAkFKKTRYiv3ghRvzeGI8Fq_sv5RsuxQBlrGgI7pDqLfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YNQMPciAvDOQ2X1WQQxYcEr6HSqeE0OOT-mUCeoF9_A&oe=6A1850AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPeviLhumlEQ7kNvwH6GZfu&_nc_oc=Adr2F8XjbQj5OnoBgWkLjXsWkwjCk8ljxjkdmUq1-6o3lwIFfgKP5CMxysXHDZmtBcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yJfS40w_RNKucLMUb_b4wgeQ0yj9GIJOD718veN_mZg&oe=6A18470B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.
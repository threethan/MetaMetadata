6rPKLXn2FmIVYxOjoglt-axdj_6H7qdyQ3FSYkiFFphHLo8c-vD5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYxFOzZVHvfxPBVoqik8plC_X4XC5BR-e6fvZfrvjhlg&oe=6A50ED37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE2kwf8s4E0Q7kNvwEHLIT0&_nc_oc=AdrpzsPQyjP8lFgOxEKiFiUKovQPaPSvkN3BQ2I3pHarNOmWyF4M1deQSxefLrgviYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBymrgvFSkZDnYwHR47Aozd3xGiNTFAFuCLMOLmYp6ASg&oe=6A50EE4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlHGHndP8SEQ7kNvwFUZ3js&_nc_oc=AdpPbBKiU2y_oNzYblUAMGirnfvCKQ6OL92OvVopkxsG9O6d2of6xjavHRbIVWqBGZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPIcSsPhJrv_CqY5KXjiDpLG-XUoTCQaXomfhPJt-ROA&oe=6A50ECEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb_hyGr1DGgQ7kNvwEtbgUM&_nc_oc=AdqKtFzeVutOakSZl0HmAMxqn9JH6WoqnLZzDVdX8vsbq3-VTc0uShbyLRIDnYpOeUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9eIPUrfR5WVfwK0_fYwgKY1cOMuH-6JTZcyJdbr6fjQ&oe=6A51012C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OZB0v017ikQ7kNvwFoZeSY&_nc_oc=AdqdC5AKW5cliNe1M3zk8m5ZaPe0FJZ0QEy6diPqlFRpgOALBYvCRM4r6ld3_o67NrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHLO9Fu9z4SpNtTthPtQA-C61LeheozldIExFcQcGk_g&oe=6A50F78B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
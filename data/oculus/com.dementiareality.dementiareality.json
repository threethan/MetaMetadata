0_Af0AtgE27A059MZpkJ-hy9G1PGpcAodUO4LxyWE-hRqq4Q&oe=69F0AFB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vDQN0Qx77gQ7kNvwH5c2GL&_nc_oc=Ado7n3fQo1eTnTodeO0-zOx8REaArMEPIr3s54s37JVORptQVtU3mzI6pILpcANQR54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3hAXNp5aSjQM1WOVTzOmGNiEhccuF5MqhUgfsx9VaMbQ&oe=69F0B0CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-UUTgD3c6IQ7kNvwEOaGR_&_nc_oc=AdqYPN9TVbdo2Qwy2GTFoQPNUv376d8VaNEacEXPQ5Ebu06Z25gD1_joulhoAfA7pAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2TaYeNZsTesxN3BLLpI4HsQzp3wRj5F-Qwoz631cyOTg&oe=69F0AF6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWZ5o3m1VrkQ7kNvwGJsoda&_nc_oc=AdpAwLY_l5opqH4J__SbP0-pgyXFdtO4IXIC7VeOVamWmcZtBDrlJTHob9PU3iw0jp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3o1Rx3S-T31yjdr7YrlcEuD3iVTSk0tQmyCI06j3pmXg&oe=69F0C3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmmhup-Q5kIQ7kNvwFVU3vo&_nc_oc=AdppGy1mj-3RTKXY0NToAMWhHorMTMzRv_GTqrMNXxKE3zRGrt-R6JMU7DT21b79x_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af29kHueQjw8f385G7QIz7pRkI012ZDMOUbQxs8X8VJ5sA&oe=69F0BA0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031431_709517551270928_6551352154271004206_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsFO2Ic6mjIQ7kNvwGj2h_s&_n
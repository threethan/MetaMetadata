0qwtQ17qi-CEobghAUE2agqmgxLhRlsa-_vZbww8zRynktLi9-GDY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHheQwyCc7m-w6KDmEwqy_9m2M5WWkNvfHnrmGcEK5djQ&oe=6A86FAB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdMvWLIlO_kQ7kNvwFhd3MG&_nc_oc=Adp3uPNr25CFRKJAikdsgpnrjv9G66tWrP-1UeIg5daQRDLRK4WHOeFAmsOmJ8P-Ric&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOC1CYODpH4fnIztAM7qyOSZ3eHJQJtiOHgkBEq1aAsg&oe=6A86FBCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-CEnP0kNwMQ7kNvwHmyplH&_nc_oc=Adq9I0p4YkeDGceAcqWvB14hLoRVsTM7GF_lSCcbzupy3-px2lFrUt2uY9vEoEBWLA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDUj6nCOfassoytsI1_keN6MReXaKICNZx7KxgJiMq-Q&oe=6A86FA6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw_-vSIaFB0Q7kNvwHUnTmE&_nc_oc=AdqwRdFD_M5mhRT3uXRonTTs5qgrX53WXOE8DZTREYXmwB3oQ4EYYRh6HNDzrB5THRA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg0TTwaoXPOKz_0KG-X1I7beTuEI9v86tVhXImDy7kgA&oe=6A86D66C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prb4xgkm6ucQ7kNvwF4j8we&_nc_oc=Adpp1F37gJx1a3rwB5uYFDaP1Won1uGr7IMsZaUqg_y1EzBiqs6soBDv5NQdK3XyGP4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIjmz5MA8NNEcQU_2u7-p2yBqblZW80r33MEflgTR84A&oe=6A87050B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.
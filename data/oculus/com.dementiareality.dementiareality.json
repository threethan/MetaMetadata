0GxmtqsIe2zXxTQcIeEApPCjGu-xs2JwCdb_a2ThCX1_7Q6QXYU6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxpG9h4VSzbAM2hbNV7jOjEylyRrqIvb29RpU35EhQ7Q&oe=6A6F3FB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfmxlhaEv1EQ7kNvwGfDuon&_nc_oc=AdpVVA6qK1nzC-XbHqKqubrA7MWoOlfXTRDvm0sfrqM9l1mOP9sk2Lk-i4oBxRB_JRk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsYIfwqH2x_6RD6VZrAvAf-8gqc1oKDBXjA217XlGCwA&oe=6A6F40CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFjRMx2teCcQ7kNvwHBNjM-&_nc_oc=Adpc59PiiDwl1gZCJ5mPhCVC8sqPEIDYBe4sZ6KTxcZC7lQpUsHTsvpfooBssyXt47k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIymUX6UTfIUIYrAUGREFcz8-2cu7e4DE4f6Xdm0oz4g&oe=6A6F3F6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZBQEAM-cNAQ7kNvwHY51tG&_nc_oc=AdrYdy5THBqq8uCgapNA1z6l6chHhQ1dUJt9YrU3FseottNhR2OOLT4uD_3QdACHfww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7fCZv2w3JCHsGYrI4pXD2meQVtK3rAdjapU3vkwsUAQ&oe=6A6F53AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wKIIIU7uEQQ7kNvwFHTHa8&_nc_oc=AdqB9fNH7JitapFY7iW0B64XVg5rqnzGsb_WvTSg7MZDXFyqvdP1QZ6ksF3UJuLZZxU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtMGv2mXZIua_OhDdONDCIMbiDYc4bp0bUZLFBcc2l5w&oe=6A6F4A0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.
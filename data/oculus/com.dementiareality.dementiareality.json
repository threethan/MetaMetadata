kNP6SbRJe4Uz1SFehBenPY5yAS4scbwpQatq7kYRr7_kZ8yd6kvMo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9v24aC5AqoBkOJ4q3hV1oeBKN7e1LK0T8gQLb9DnQLw&oe=6A2C0337"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVQxsYji-S4Q7kNvwELol_r&_nc_oc=AdqyiQ4O8tY6Qh4fnIMGxfqaO0oJWrbdRFbrMtWuhANKeD2N_-8YRo4kUlxb1REObFc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--4ZxiX2MpMdzwySQPsieV2v5VWtGB7Sgifx1iGitfEw&oe=6A2C044E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhNBJdPmZV8Q7kNvwG0QG5E&_nc_oc=AdrI1eJF85H6JXkEUiQrmemVVQKYOqY49nA4vXbKG0Asp7eEd8t82DYNu_6T4jEA5xw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DXiOedKi-vQP59udcsFjry-2hy7IgN6UgeRrAoGq5VQ&oe=6A2C02EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7gbMsULAj8Q7kNvwFE0Aa7&_nc_oc=AdrWan8-gBDw4TxO8XL_Q0mr6RuF8Nz3yfqqrhi7ZTXWt9kgr5JXu9P_t_UqH0Sniho&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cNcM-K4yJdKlefmCwX91TrX3a6DhqvvejU-A8GPUeOA&oe=6A2C172C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fje1jjirm4Q7kNvwHehnfw&_nc_oc=AdpLzMt5MBuIS7MOB75-KXQdJWTE-Z1zao76P3rSs2wP9GpBs1r0Sixj02llKz7wuCo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sCaJsUy0ZH8xhxQ8R8hpRHII3CgP1-guZ6B2Ju_m1rA&oe=6A2C0D8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.
-pWZxgxYrLkzwZlCo6yculIeqM1yqAgNW06DqscoB0bT_fGzfAJ2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl0WtIt1coVeRMmr8pUlrE6OIT7cPZum2CQAIJgSxtRA&oe=6AB3CDB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyZ5CmZfnloQ7kNvwFetP4G&_nc_oc=Adp03oR2DxcL-aowHXwFkvhwmDbV7OqqbwiuDKkOaDQ4SWl-TOzbdu6pTkFlbGb06Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP9rMVAnfxS8p2FdOu51kBUnzAqSVhNzFKT8rf82wkew&oe=6AB3CECE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfYEJOcMe-AQ7kNvwGzoXJl&_nc_oc=AdrvG9RfmCBbcZwrrpc4SSBTinZZLfHmFEGyMZfkAv59E-HyBlXCPJHC58Mhrq_qj1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0pQS0rTj3_bnTYAANnuT11kUwRHssfD_f9mpUVO_WIA&oe=6AB3CD6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nebMx7Sf5oQ7kNvwGqwLWa&_nc_oc=AdrGYIt-jtdw-u2maB57qUEqBA65JtTcD1hZtEL8ptNRAJXtlu-xisxfUyBztEWAgIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG4aMnUvoHlEZVJT4-nEX3ngcWwRb7wU9RLlD8p1wLYg&oe=6AB3E1AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0b2AcYdFoAQ7kNvwGd8fTk&_nc_oc=AdqS5FHiFbIXY5MoNcYVvquAmZRPyoDeNV3qu9Iv9OGGAIISBWQmqgVKgtbxdnFJ4aE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdojdyP2kjtpitYy35I824xer-JEVcGN4zvF_pEAlNcw&oe=6AB3D80B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
428085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0vuY4RY8McQ7kNvwHvO4bc&_nc_oc=AdpZb1Jjo3nlmxiR5q_-mLIPR559-7XzFYXSFEToeY1niQKsCrCyNFLdEvpxmieE-Es&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhxH6-mk1cbgJg7cTF_QsHBH2V8WH8wt41yrB_fLhiBg&oe=6B09B777"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q0_wUFu0L4Q7kNvwHUIEVY&_nc_oc=Ado22m1F_VvCEPcqv8pfAiqyiVVTPiGoJpKuP_yhuO6bdUSYrypHxXwyetgAmIxnUnQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvJ_NJdwGnNW-_ebJ5UVMzFLmiCBxLKN_gfTrgWDkn5A&oe=6B09B88E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWflOebc_lQQ7kNvwF9aLZf&_nc_oc=AdpEMEzuJrB27QRlLvRBDWxcPFWBHCYleCSQNe6gkAExEHWfuyNZjnVsPjJab3ZiPWM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3rqYyC_DJJqf_2LxUqyPBN_igD-Ne2pNns6U0by9Oyw&oe=6B09B72C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDUI7bS80zkQ7kNvwHgVymN&_nc_oc=Adpe2XZkHKFeiuehKGzPhLQ2PvNkLX-zHRBYd4U11OiU8fKJVg-O_7rnZwdiFedVdzU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnAXCPgRzfpThvbJ0ihmv6ffGVblZxWsSMtByR31dpeA&oe=6B09CB6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyekRFGI8i4Q7kNvwFGVB1e&_nc_oc=Adr2rfOzoL6CuapqPOR5pFtWMJ8TZMcLB3cqlwu2B6DIhp7QZ7Gu5dOnfQRJRug-LTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa3TZQDxb8yOKlFa2CJHPLoMCnome7syyzkaHxtZ0zuA&oe=6B09C1CB"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
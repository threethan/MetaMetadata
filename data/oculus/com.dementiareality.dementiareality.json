ni1QdmXKfdE2sDT8zYMLpw4UQbSn0swarz8mpG5ukPtyjJzPgNZOk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnK4_LxcjqQDSH_yQ6YRzaKLCWPDXR9HB8Oec9mEiIfw&oe=6A660537"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL6ofxpu-EYQ7kNvwG6s7nP&_nc_oc=AdpHT1zU6j725di8OoUSfIDBFHkK8k5x_7Ydk1b90zLo4D1OOJ2Scctht0W9rtmirW0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWBQGXwoclzepf_fjXuD0x2RbgAFoRqa2zBTsr7rYi5A&oe=6A66064E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZZx6mumu2gQ7kNvwEXqF6C&_nc_oc=Adq6sWX18KlW9c9jr3iWheWnVN5Ddc-bHorl0-xngZKqzDhuM-cq3piDsPdbgv8kGlo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACzmS3Z-ulGrQux5LdqdJ5LYPqvJVcqQYS49_fTGd3PA&oe=6A6604EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvqUZbe3sQkQ7kNvwEY-_Mg&_nc_oc=AdpxtgTjgyEfHvaYIMEu4HB5hmpdm8jUB1N61c4Jidk_2Xpz9nKVSOc8JVwvmm8xaAY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6f3sNepDERPj4Dr82WK3a5gwiPyUMQtfg4TGkSD0xwQ&oe=6A66192C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9stmP28CmMQ7kNvwEIDKL8&_nc_oc=AdoFI1XWEXFAT10ur6reZwkK2nyyWj5UtJEWqrLY_dH6uJXHYj0aysZBKMcYn1A1bqA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRTqtoU0C6m7w0P1XhT8H-fbYnJy7IZVf2I7orty4pUA&oe=6A660F8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
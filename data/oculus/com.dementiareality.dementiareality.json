GEJ0l7y9taKF_dSvSAIeuXnPskHZ6VUV0p-sdQSZRb2ijkHdrHLXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgCAYLc5iEPHOcio6TTx-RXHgqAgiBlWtmogOSF4CTQQ&oe=6A996FB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pg6B6nLIWYQ7kNvwE3S-ni&_nc_oc=Ado-VExw7-D0QaXsQx-dkFJXtxgZF0Yhlhk4vUBF_WLU7CnjS1TKB1t4MdSdZ69OIrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa0wa4XEfAXbb58fsvGBqjh6G5QhmJbHwOsx6ZM_N_3Q&oe=6A9970CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcOkbNdR_4IQ7kNvwHCtxKy&_nc_oc=AdrVgztOV8bbGopURmpfPLUCXQ0QKS9_RsHiM4gYTYAL5m1hJiaEjFxBC3jcTkO4mkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa4E_39ZzgoJeajaFdlK6kVBMFABl0qRrQJENjlht4NA&oe=6A996F6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkBnrHU4fikQ7kNvwFBLHiF&_nc_oc=AdoqyiUQiZHdozMs53EL2q5hJlFOW_RTbLXaZnPWCMQMBiRHkQdW0wZMmJVsf1hLYu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa8plCM3-9ZceHqgx6xUNORaY9GSASWhXogkUpH1PPeA&oe=6A9983AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZF2ArxU8NQQ7kNvwGLeAWK&_nc_oc=AdolUZkg8SOjp4fagN1ktIVX9d6m46obtcQ6e2JZo962bm13i_2KaygI3jprb8OmHLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWBSTJBrI7lV1TFX7QmIgOHoTa6-O6RwqH5loUC4cxsg&oe=6A997A0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
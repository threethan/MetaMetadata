ChmvpJPegCOVih0pYqEcoQiEg27_DUbCAXd8vS_sS-0fAYEBLOuvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXs7o2iwlysXdUCqtteY7JkQs7_qP_JwuL-hbfvSU4Xg&oe=6A733437"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSL0wDbq1ugQ7kNvwHnyuLL&_nc_oc=AdrPksD0zRQ5KjfgDIqg9WVyJAswPiYh3Ks4WthRcSWlwdZCVw2g9rPkxXlmQ-LGy14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6KgCt1qzJqKF1DM70yX-pyVN3HaaMtg8YiQHo_FwH3A&oe=6A73354E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-GHy_nqNTwQ7kNvwHyzmkg&_nc_oc=AdpTG_iDD8JAU4KrMd3G8eKw2kCCGkLGK1G7s2YFIRIDo1T4x2uhGFkgyr7a0ZPUixE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpnho7aIytE6akq66mnwO1R2LNTRHamtsOYhhFhuH_HQ&oe=6A7333EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPNj5TuDRpgQ7kNvwFnKt3v&_nc_oc=AdphKdQq1dpv3KoIBbHLHU4EgDbY0Tb-WlA3eE602YZVLPNaP80ktpPlKrd8xRMOo7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlJ1GBqWa8ou9yWW-vfiumd_v7GGwIWLYp34tZxeh-Sg&oe=6A73482C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auXU_6Gi5n0Q7kNvwHlbS19&_nc_oc=AdrMTbHJXCIAr0gGYUsh7SLF5HfbZ5e-4b5ZEOQIUHZcMZtE1QEqDBilK0aKcPElYWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeVXAeP2yG7kyYS2Rc2SAGxR8ko1gnQKTWZa-NxDY0mw&oe=6A733E8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.
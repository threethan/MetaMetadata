le90wYnVuasMAJpHHYSZytow0a9C-C-v7zlOQOLCvKSop5rh7TWIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hw-zyQ7oV_O4A6BnBAaLIVX80x-38lvf351B3lidgPw&oe=6A3575F7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlBZbwotqtcQ7kNvwFbzs8P&_nc_oc=Adqt4fARhDE-aE_nRWt1G-IosBknRHkTbbX_9wJJZpmfxCXXKbinNxX0xzV2aMDAX0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_soiA2h1ne8hIcYJZEyWKMW7q3XUv7EemZUIlnGs1C7Q&oe=6A353ECE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUe3PxXbdrwQ7kNvwHwLx1m&_nc_oc=AdpkITYH-qBs-D8usUJJA1LpwdLXbfNG-YA_Ix7VNIvX17BaMoLqIiPjC6CFvn_cWqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TcAZ_zh60Cfwp4GNGXKMFXxg-c5pUufiydtVaI2gTVA&oe=6A3575AC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tExr2CsNlFMQ7kNvwHd-Dcv&_nc_oc=AdrPNdWv0BBaVcGSIyCeR_YqHa48xUpmgECgbKoSjSgw_ovgJLUGtv4prBGfgtzIXEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XQX2NjRM7abC4R2WjxxNG4Y3VYHLaFnSIy7nK1PSB2A&oe=6A3551AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuTGLjeseDwQ7kNvwHFEHAx&_nc_oc=Ado7hjCAvLhmtge32xT16xjtpWAROWLBpPXjWXKw9g6UWfOYxheEq_vfF3D1l97-Igw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tmFM-tTpMd-z_FCrB-UtwC8utgi2R5CGvNFy1gusivA&oe=6A35480B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.
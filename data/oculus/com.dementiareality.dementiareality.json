Kvcs-yB8TZLO2FKwixFt-rLD1D2L5xilK9eK35119KbQtpCet2pyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH050cjFd8DQEYEKDOj2mtdNtgJYcCo6Qd9DHvbK0EyIw&oe=6A7F11B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5BqR-FNGqgQ7kNvwERFr1m&_nc_oc=AdpE5v4ylTFDROKF9alby1m3uSqVeuGggk0NISUJZHmcPUKwS1EESxFAc2tCe-uAz9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI37xN8NWgkA1AZFQVGKsdWpuFkuLQODep1FFfjxe8Og&oe=6A7F12CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kNBSFzyA9IQ7kNvwHXDfzn&_nc_oc=AdqebZ2_ade0A3ged9qQq9ker1JDio53ZHW25NlmKuHOC2HiIqb9rPBnergxNQK2oUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKOFfw-zyRCK3uPkiuU5gLl-d_2u7xm0Qo4VKjvccVLg&oe=6A7F116C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZsItJYL7aMQ7kNvwEssS55&_nc_oc=AdqCzmJSVdeVXHz3aT5OsHjyU8kr3Cpy2rfncAD2rsoexgQjNPHwqPry_ZCwTZ2mjMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfkf--Mjbd1dvrupfPz2_NnYPDL8yOgct1dAXF-5uaZQ&oe=6A7F25AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jduUHcMA9IUQ7kNvwHYB28T&_nc_oc=Adqi-eZsJTWEMhrCxDGxfzyBfU1SPNxtZvEsKgSTFJA_N7RQWbWjkDwWNxZe6OOH3pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDDPbpPG5J1SdwGnho6AiDaSdzP-k2Ubs5yzC5lAsX4g&oe=6A7F1C0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.
nvEhFXMrDOup-3NTzetkFFJemDXLcm58X_Icv0MosPPNC3oere-T8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPg5nFXzCY9XzaJkhFcIGV0vAERHF3FiO0jYwhk7YRww&oe=69D10BB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3wmigUqC9kQ7kNvwFm2qGP&_nc_oc=AdpLa77HaQNF5Zs_3nJ5S5Rv9wuU_5jRvTvA1vmHysZElALvMph5Q4cevXOWLboja6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsftzxsGhfsX7h1dlyMfTZbwwrYxKD1297jwLivnRiFw&oe=69D10CCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v40RcWy1gcQ7kNvwEggIoq&_nc_oc=Adph99qeMAPhbI6zzLHbXxTmN85MM9QM_a6X72EokcYEob4mwWy_setazuoCSNN_Xfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2gekigLwvQQolZ1QbW4jR7qzzizgCq_PN9Sym7so-VQ&oe=69D10B6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOnJtmnckPwQ7kNvwHjmPfn&_nc_oc=AdpHmBnlAu9XbRAe7dyzmiLDAy8UZ7Yjm3B9Sp3lXylNH9WsjG4Lw9mVFIxuxdUQqDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRShw5nTDHEf3x450n-UVf9XKo2dYWDlGfutBjFMdM6A&oe=69D11FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uajD5E9L9HIQ7kNvwGy02te&_nc_oc=AdriPdFfD6DlMVwCDS4eFT2s7rj765gLFHKPoJP2dR2lu1wGcLkIkJuI2TKDKJKrW2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlthB8a_dlcoGqg1KWIw-bXbj4etzuOdQsd6wRww2iaA&oe=69D1160B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
3hvl-sD2_VV8BHomBEbGBYv7BywUVv14QPdFyN_a8Kl57EdZj--xw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xTEg1TzgxCwC7xsQpMbIruf1d6BGSoxhCB_ELuvK4RA&oe=69D50037"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Hd1JmcbFVMQ7kNvwEe8h-U&_nc_oc=AdoTOAUP2eq75vu9_RlVw-CZja2M5e-8L5wC_mPZuq5FBUvzSnPpPEV5CqMVlpU0Lh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ljs9dCL7FF37zt84EQsKFRLz0uAz5ZkKg0AS6U43ASg&oe=69D5014E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcKgyFat5SYQ7kNvwHXEm2J&_nc_oc=AdorKOW_FVWHga5WC3mAVjHKl2Ag-nMQsJ8CNRRwStW884JlQwSnAV7zkho6bjzlVhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f8HzxamcbhEXzBMJlepPLHZLUIgI-a55zg5zQoArsGQ&oe=69D4FFEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SHg-oKSBboQ7kNvwEbVoJj&_nc_oc=AdqRnlRRawiQPqXlOeuQkOfK9kpQD31krlk7bRDX0n7PC7W6djLjcLuKVhlL9XZrnw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b5WNwH0T7gfaDQczen_zyqWHTdEAFsK8yGLrUhhkGMg&oe=69D5142C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZSLcBGMgJEQ7kNvwHtDiwp&_nc_oc=Adq4qJzwzHOATXBZmkcORcjReaNjTQXhIJlsCxFHgpqjyZk9v2pwzwsYN2dR2DV5eZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G6EfGG0Kzsxvsa73eoKcNjbiNJYleHHzWeRbYSfPnzw&oe=69D50A8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.
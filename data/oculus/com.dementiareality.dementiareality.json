_4yrSQAk7NSZVK0OVBYDzbK64HD8ybhdpwu8VIU-a4lQxOxIMuYtg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XbXMEpmsKu3i-Hip9TFxx_ny0Y7VCA7hsXxp-vTAoqA&oe=6A314937"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1vFQOcUttsQ7kNvwG-NFlT&_nc_oc=Adri-GkYtdgL83MYsBNH6JeZj8te2M5How56Ibmjp2PILAqwrI3bafZuG9o-oDL7DNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YNfoO7JtXVvqXtQdZUbmWSEY2S5hyS9e5CdGTjvLqPg&oe=6A314A4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrPRIIu2zoYQ7kNvwEgYYwt&_nc_oc=AdpaYnvikuSiN_Ib8aucGw3i3m8dBKMSMI_E5QJSLmx6IEZm2s_bxEgyo43hYVVvXcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rBYlGh_rpBl4AoiQaGL0BKb-VQ-U6J_0INyHCWDLMbA&oe=6A3148EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NPVNFv1_q8Q7kNvwF0wSxS&_nc_oc=AdoAiUno37PWNylabP332VNrOOTv8OZS7OnWKx-x3_T2as9jCxQ0k7dS4KIU-2KPvJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84ubWj_hfMhtwQwwZq44qwrHzUCXz1UFcNNOMNnWDjMA&oe=6A315D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ifXBC1a0EQQ7kNvwHgkIm3&_nc_oc=Adp7ea2rNPpSMYHr7v1yuYKKSgeBSlOPqS-NW-_K4l04xOmoVBKTLhvpp2wZa4EGHhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91lYbkJQh2gRz0koUROmoHA7rpAMtGGAsNr3FQaTkAMg&oe=6A31538B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
5o-2ZjlOTdaNLUNG4Wo5ATqjvWkDZoIneDpflWUBDSRZ8GLgrPS70&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MVdmfSZ6QwkUFS5_DkaGEdTCIz8rvKtw8zz9g9k7-ug&oe=6A12F6B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL7N4E2ZRQIQ7kNvwGAXc1h&_nc_oc=AdqKmz7Uj12a3oiNjqe0gbn9PVEct0fHROqRZMtDThN__RrhOieGJ9LnT5C06TSlJOA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dHhCn_hbLl-DXf-T8DJJjGFH5Zrj7GFZ6bjQjwGfHEw&oe=6A12F7CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EJprALOWWIQ7kNvwHCnL1o&_nc_oc=AdqUa9WYIM9y1DrEGEN1JgKGAwX1ZQhC0QwJt-91nJYyrMHG3F6CAUwZSzIPnOLgBlE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y4ks6_NIc2Pc6S7Tk7NQY3lI8sVcKPwzR5QAsp8xGzg&oe=6A12F66C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYadme3CHN0Q7kNvwEA-oiU&_nc_oc=Adose_Y9T9aDZzzM-eQ_Fd0Ua_YZUNtkL1aSc12JEP8biB9JSoCGUy-rVwQd-p3R5FI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PCwiDfYQPzR5ZOqCgvd1abUeACP1sANmPgXSoahBsew&oe=6A130AAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAP2ury_65sQ7kNvwET_KhH&_nc_oc=AdqSWqZxgXPfIuktthzDKk60ISyWg4zxDY_Xj_qxCU9cMZUQNLKbFlQoxvwPpSP5N5k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iJMFGUGnEF4coPWBqOsH4t5lPXlHixtZl9cnKi2Tfiw&oe=6A13010B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.
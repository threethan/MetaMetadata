OZn1aqvVAXzsDnnp0jlIZLPMwdRnQtWHHd3cOl-3N2lHBjFDD3Anc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWmhxugOc0D_E1EJB_rSihCRdVHcnfkQrMlAUUbUXcFA&oe=6AB913B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZntHDev0LgQ7kNvwGGlU1h&_nc_oc=AdqQdZh1fyO9UvqcDiFPCnT_UQZwgiM0eEP2eglp-Brxr931lHAhIB6_zq_zlqqIix0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVlFTgjNPEeqF0qJfdoq0tAoRQDki1UWLwTITVPRnpKw&oe=6AB914CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm2XMK1KEaUQ7kNvwFUS5GP&_nc_oc=Adq2Qg2jskHoGrKBHfhAp-FnxlZVYlhYbC8jzMISEYr2yoCkvXRwClolRb_QxS1bb1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJegoLQj-fCG_bAAD-hHlMydPVExy5UVbHbNNzoufd1hw&oe=6AB9136C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QVHGOSuTq8Q7kNvwHCeF3N&_nc_oc=AdqtSKfgdrV_HsrP358pcndIzVinFkdmtU5CAMOgv5QLNk4ah22LTsFBPgp86bjF4L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuDPgL0Z9owgUNsk83XKYe29cngIkDlYQFGLBC4c62zg&oe=6AB927AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlRx41wlHX8Q7kNvwHW1tXh&_nc_oc=AdotrZj3Jn5nCce3q30ohBuCa43xExJjA7HE0p5DnUVogZVCsG956XF4V4bDWZpTrgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFi291p-MCZW_V8zj4BFg0hh0fA8Q9uC1hnZJTt0qedQ&oe=6AB91E0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
8EM_UW1DtSgC54rnjZXt5dU1rd9nuQwD9INB2HHOaUORjyZB5qVR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zaVwke3934bHpkA57XKHrCa8BiJRyyBAw2HgRKzyt_A&oe=6A3E7837"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M4OGXAoIPAQ7kNvwGScfWo&_nc_oc=Adoyim6Tv3uGjzxxejtkhz5t8GWnrhNRhHGM3Oy3AUTMldUjFrFpHGFXGTCEY8vFjJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KLO19ggVOL3pcnpZ8OuVANeN1HdMZKy0LrNgbLYE87g&oe=6A3E794E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGcGnNh5zfYQ7kNvwGbvEhh&_nc_oc=Adr4hBvSyBFI9S4MRvRRJ4LfVOcFPOHrHsL0dDn1iwRmm9kmrEoZkGgubkm64jxsaQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7BReDW3UcnV1Gz3RJ2EGGPk81D6J8F8itPlvsl7VsOQ&oe=6A3E77EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsLjCqKfG-0Q7kNvwFK2jXP&_nc_oc=AdoabVnxZOEmIrJn0pvDCEcZ7Dg6Q1RluCXDv2fjp42YFMeIWpr6F1ddA3JiCOAC108&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R6dJ39CJ_JJWqCJ35zTpPVJ6HioMV_khhWgWYVJukOg&oe=6A3E8C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfQd-49vhjoQ7kNvwH0gvjX&_nc_oc=AdqFZIWYRMz_HBNkqFkhAgPswKXVnItJ4eiO7-lzsbSUa2DYw7sitR1SdjdUyG6svSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iXmJCrlt9ZGm29q-7q2n3LjkWrxcGLvij6Z7RQjGMcQ&oe=6A3E828B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
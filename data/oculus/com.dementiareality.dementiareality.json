428085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce70NEFKmLwQ7kNvwEk9uZv&_nc_oc=AdpKEy7zxhckMxbtSwgeablsjnRAojY5_Zt4T7RFllZjO9col2abO7g4yBLzXTG0BgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1fgNW-Dyi6UT_fEO80tJd-Uwu6qeTRzg6rHwRRciWfQ&oe=6B05C2F7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX2i97rAihMQ7kNvwGaaRNU&_nc_oc=AdrQGefpNtNxDBP4ERAsxP1PkBe8QorYajUMbt9tHBBB3_h8o8U46jo91F6JUTNcAV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcDb021r84jSoiZEt2X43dUgF1L1BaMTldXRRNkQdpXg&oe=6B05C40E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2qPavmi1jYQ7kNvwEYBIDl&_nc_oc=AdqugkrGXLolJtVxa0iMI0_5EJAED6AXq5QuLur4Y37YEWfZtBqIWRPA6KbbC3irHOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgbBAR63avEeVSEh4zuLjkFUwEtPgGgL1d8yNXgLVv_g&oe=6B05C2AC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaZnFEFF9x4Q7kNvwGsflNR&_nc_oc=Adpqhqg_YBaK_Il1pLCsKeYYXV8fq-Q7FoOB1qxw5RmrFrrkzWxg2_CMeAz4WUX20Ik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6hdgqCfM_x0q2NT8xEjsG1wIxJo9a8bn8u_D6ZvtkPw&oe=6B05D6EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBOClbGWUkUQ7kNvwHMfHit&_nc_oc=AdrcWjOwlg9VZF3fD39LzoxlDdyDOZNWUoYDhncA6xXqGFZYw-KlQZuOn0P3BWSvm1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiryqrN_RlxuaiwPIFOj6UyN6k2tebSh4oKjp6SbWpWg&oe=6B05CD4B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
PSVHgbTT2eSQIYQszk57RoMueGQ3PIgd55Cuz9Jb7mGubpkCZ_jXg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37m7iduxazsOmLRpAA0qrpZnkLbpfLOpcJDWGLDTLGJA&oe=69E623B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vp-QYhyYlUQ7kNvwFyVjPB&_nc_oc=AdrS9vIf3SZOOrvDjzMLm0PIXo4Ofhwh7r5D2VzdLrxj4ssw-s5aHzFQvpdIZ0ZtLm0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lZFqqsLuw90WPsdVbRXjTmP_Ha7gNwlsJThLIAvGmfw&oe=69E624CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOs-pRbNr8YQ7kNvwHO9Qn7&_nc_oc=Adrpwt9MjCg1HOg4Us8yqJD5IAYwPEhXiH59a1MwClp_5i9JTPKYIBfntT0HlgcMJhs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xrgOpZnQRKnEgv6LsBA5N6sPSZmIDsTiNIZcodQ-0jw&oe=69E6236C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Uewl_7XeAQ7kNvwHQ9Pp4&_nc_oc=AdohQDqaNVE_Hbn0V3QLUma3i0wsXhCIt9aZf3CvBE9Gj859no_S06bZr2hd_A08wpg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20L_ee9hFWuxfbZzzbfTewsc-HRrLWKJ1QpkbT1atYxg&oe=69E637AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuy-9eOMbZUQ7kNvwEqYJre&_nc_oc=AdoNPnwHml9tE4rE--F_Sy2OuqhdaIbqd_B55vwrENuX0pwHI5QrjcoNHqu8yvJXUXQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ln8arYr-rZn_qun9AoLaQJ4nwC5UIbQrPa7_GEq0uLA&oe=69E62E0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
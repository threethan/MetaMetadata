Y0ZwtmDGEVwDKPGOCY0_Q4n6pu8JtJilCAr1_YmcTF_fy03J8eplk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af574TyA6yo-q3f9ExuBOEMFlu1tmehOO07_pecYTtXrGw&oe=69FDDEB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxZcuwuWeEoQ7kNvwEAUQoM&_nc_oc=AdoazD1RPoJ_wKqY1gC34gRPGrbG0m74NVwUIa5YdFnSwBjteoBpqTv2FyzSVxo_2xA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40OkpEBZXFyno5o6IZ0gub854ab1lfT8osYjhHZ_qmhw&oe=69FDDFCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VSsoWiRWxMQ7kNvwFatQOs&_nc_oc=AdohJ9ds69aFe63q28VH3HWc0VhyP_bYyGPoR8zxK7bGUbxaHYAJ4zQ7btDoJta5gto&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BI-YD-QrDpONzUpbUrjRrVDQfXb4UDAG2wmNtMWnM5Q&oe=69FDDE6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGUfqOt8Mz8Q7kNvwF98Bw4&_nc_oc=AdqUSSPme7_HYt6Pr2SkYgHlOEqzXO1KnEbI426w7zWOl8Iy847F1dlZ9en4Rj_bPFc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VA2zBveuIYXuuTISwoLcFN86FYcC62BB9kFCG7lDi3w&oe=69FDF2AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr3KmjBIBz8Q7kNvwG7vs7k&_nc_oc=AdoFpCASO16oZe3v9dVw41EgWFLGV9m6nmJ8YXI7DrZABk1VWuaHX4ZpG2hMIskC3VE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x-dwc82UZ69Vq5eKMJeNnG9WSlIzsCilHZD6lF2p74Q&oe=69FDE90B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
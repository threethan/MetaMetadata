mwKZ0JRI3bVac8RRt3itfRGVTqyS_07esq0oqwE2pOcLCb3n8Oij0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIYPZ2_6QxYN2noVr0gEL98Bfd3guF_6dfd9TVINWxTg&oe=6A563337"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_ygl2_RBOUQ7kNvwExLxsf&_nc_oc=AdrD6K8ppsosHfhqbyRPnk05LXIisJznP75XO_GLvove_U-hW-RbNiMdBvUE5JBvhiw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN4V4oSD8_K5Yx02P6NQlriHmtZvrUIz5oG3eJW3-LDA&oe=6A56344E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbcUn-rhulYQ7kNvwGbs2Ad&_nc_oc=AdqkNtpwnhWOqw0SdDiyQzAMKbjDfzjPxi-6FLyigEeCvThKa7HNFULGOgG8Mxuhqpc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-d4FsRzCgSvwfO7SGp0mqDIKFGt-UcGVuMg619jDHzg&oe=6A5632EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_CTnMXdkJsQ7kNvwEX7CUA&_nc_oc=AdrDqGzz2bFuP9R83dS9Cq1i8VTEvS8qasoH3eerzNYCO8qE94-8_dPuF17S_mGRBAg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpGTbSYOqp2r8w0AsI2KU6P0kZ3gf47AnlZgrUs3XB-A&oe=6A56472C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5CAfhASQhMQ7kNvwHi_AeY&_nc_oc=AdptsflEmW5nygRHqfhzeyvK0-Xo0Xu0mua3wDBJIaAK2jpKqOwSsP6xuIdJ3XVbfAY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKyFMs1l4q3Im5EBqCX-Ly3CNvkoGOmSlVu2DHYbe6mg&oe=6A563D8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.
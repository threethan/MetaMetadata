428085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcU8O4bN21MQ7kNvwE2PdYY&_nc_oc=AdoJtwDQ6sVl87Rl6nWYhqY3Axw1cpMpnqgzCDhVm_1SxFF2Ptv8CH3KXiWLNrdoOVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV24OtPv19gMCgyWRH8C8QyAFBgGyZGLpYu1zJ2_qwJDQ&oe=6B0EFD77"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ekT-kpm0UQQ7kNvwHebsgf&_nc_oc=Adr-DItIQX6B2_ji0HPSTlE6-rMgJGGOGQtTw2YTyu-Ut_hKEL3OFL00XNioJCqp14g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTPk8S-ieZ_2Fdz9IZWolBqvf_QvaBZZvNgktKKZ42ug&oe=6B0EFE8E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEA3xGqpYygQ7kNvwE-sUfh&_nc_oc=Adp2A143nkleSSAAiYq-4RpMKQAXyYVEQ1THa1aUBlswUxKVuGym4r7qx-viyeB3pmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTgIiPhduOQR8Ft6b6JmyT6Jcn12X07KJUHTUT1aVuhw&oe=6B0EFD2C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UVJn98BUEsQ7kNvwF772Q7&_nc_oc=AdrblyufJMeI3AChv7QbLGnte7Jx-6t5wAxFvBvbwmxiofovOSlieRoBJjIMVeorLQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXj-Ux-YoLylGN5-lSFUqZQv4EkAKME-CVcB1SqBjLq9Q&oe=6B0F116C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA0L_-SGrRAQ7kNvwHepzo4&_nc_oc=AdoSOuQXqoQ1_UAwZp8JQTUPD0H6sJ-m2xIHXfp8WWBkhDFdbakmPG5z9tE8QFyA2aU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUcWihLfrP8uuXdG1QX7hNTzb1Rxrqj9Vbu7XJdyieIbA&oe=6B0F07CB"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
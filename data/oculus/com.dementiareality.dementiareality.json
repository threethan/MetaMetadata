3aznxHYeXTsMqL2A0P-qiE-ksSPHgYO4pz4p_zCJps93ZYRta40D0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyMucAKcPxHEburYZaB7hctUUMO7SMhMdhc5d16VyIqA&oe=6AC134F7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWwdTRZ2jLYQ7kNvwGqcWaP&_nc_oc=AdpdUvDr406VNKz7EJFWA59dl_qNvLf9RciGxLLKsIP7VlizHXVtHBeUw_bxeRFJgBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMOiRHF8K3ozsUiY3k0OQAzj-WZ6Og3I8m3LxpjL4syg&oe=6AC1360E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJPIMRSIyPkQ7kNvwG3DZQ7&_nc_oc=AdrCrez8oMsEpE1-nteuNi4M6KnpO-fFmjKHnaUVzWCxNOjcT8EwEyb80pRCiH0r0ns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvbS9w9Uj-06Wplqkjl2GP9W6LfqHWuOVeIIx4VK2ThA&oe=6AC134AC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuzpLexeWRAQ7kNvwEhgUyq&_nc_oc=AdpONSj75ZOmh0wdQcqbli99k_ySng0B2XAXjUa4S4Wd0JAsKt9q9UXgyDhY3StExag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoyXfHH5U3CSpUjhL6HfUbUaEMcvAXcAfsCoqcpWm1vg&oe=6AC110AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4ixnitcQQQQ7kNvwFuE10p&_nc_oc=AdpUL_xRi1_wvgjrP180cqKB8vLWiPq0-5sQ7VApDVYAXDNfUfVEGOBRNjqgPtJzYOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME-ElxkWQoCNY4Q77t98c_HXDAYus8WbmU9rbyAqNVHg&oe=6AC1070B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
kZJEJZpiGpEMxI-SR4vsLc9GPGVONghSBCDNgbtuoxtq-58xG2eBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ5wKsO5hWmgcgmplsFi_FWg9PdpUNRrM0lx_Kk8XjlA&oe=6AE0A0B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQnvNybfJbwQ7kNvwFTg6Aq&_nc_oc=AdoyrObFGF3BtGXLKM2B_nr7So5FK5TOD6iRGSxD05qjslnQCpbRxmkqFY_Bof1_mQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyKTy0_0G9giBBH7K_nwfEZG79FaLz6auw8WZYaRcLSQ&oe=6AE0A1CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X12DtIPWakQ7kNvwHUR6a-&_nc_oc=AdoL-VOO3W5W4yeYxWeZGd6ttC4Q0mzWGwlImfdNriXpWPor6lePfxFa-4UDTNiYS0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJc07iK1QPdGKfgTdPi02Q9jfoz4WizEE_camll7vgLQ&oe=6AE0A06C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bmSgPAJUywQ7kNvwEiJBzD&_nc_oc=AdrPh5U_WYuIcdkcx2gHeGJwqWiDUWI9eP-P65hmtMNjgbhv8iPfL_21n20XazMjizc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOQ0ZgsCaTgmrzOLsGFW3svhjm0LFnoXXHmdplmxiGfg&oe=6AE0B4AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9j9qzoi1CGoQ7kNvwH6bj0L&_nc_oc=AdoSbhOGox614rONMxamDM4bBEEA5UHuZdmUqTYkoQfbi0a7J4sRbhYbkXr5pwnvaO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0VZ4lE9hR5oowC1_a7OBt-jrFihWkU5Z5OYKTYXLh9g&oe=6AE0AB0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.
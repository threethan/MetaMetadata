b0nSaGb7ee68Rilg06cF8O5EFU0KnASIWjhCFi3ZGAowdbS8skPmU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1deU2kgKL-KbIsvUJpZ6PxR9agKLCy2gsW05xFllhzw&oe=6A9186B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veeA6DDLsikQ7kNvwHTWHQl&_nc_oc=Ado7AcnQHUA3Wxer9KLws5hIY4vhwac373DV1woGfd1rWrtuC0O9KkzHfpN2Qg6NiZk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuwWJeLjs66a0e3wBMBrL_f5-U6mZOYHKaYs0-FnmMig&oe=6A9187CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pe9PcC8wS0Q7kNvwGJc1Y_&_nc_oc=AdpKWsx5WsdA2tPIOU7NWjpLMa5241IL_HHUPkHheHn8B0LDE3wsPP_LK-HjfyhFAms&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW4MzYpdTsSSlhndCe_eiwPlDNOnMtFk3t5RVS_WNz6g&oe=6A91866C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB8JXN7X5SsQ7kNvwFSU8o1&_nc_oc=AdqXlL8nsKUIaKmhyRtr9cKhEx2tTF5iD_4wHTFyE9b1k7KW9mNULY6c9b92yL9jjyE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9lShOFvak0nh3_GcgpcrbK9LT8x9XCiinUcvSE-wbNw&oe=6A91626C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl-L8ip95QAQ7kNvwF6tALb&_nc_oc=AdpX--CzgIPZaaVsP7L5Qjm0cISbDu33LSCHziHUeJsItIm_xi7N8bONDJ4Ho-eta-Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjuw_TEBNc-VPo3xkmGUJ5wyNqe-3UBuYvEUEO9lp92g&oe=6A91910B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.
d-WLLB9Y6Siw86DpyjoUtGm3JUXIhj2kZa7N9_C8wp2a_EZX4xn-k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxbH3bC8ujjF7tRwd92SiGlxi_6-PmkmndiRpGWOnsHw&oe=6AC4F137"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFO-h1X9IAMQ7kNvwEJGCgB&_nc_oc=Adr90YA1U6DnJEex98vUF4YEqsvQ3TqIpTkPlOIaEcsQ0bB9_aVhZ8TglcfIXkv9lXQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1jj2ku79UM7VcYLR-Exjg6NYzuohHowgZFZouXodabg&oe=6AC4F24E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As7PL-JsEeAQ7kNvwHOWrah&_nc_oc=AdoaX-2FUmMf1AvxAOrkfwVAdG6BSvXIX-8VsbjNjaEHC8buD7CkM2fRZbElT9yaAtc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhyRbQTdhjyPKKuNUDou50A-Zp9z-Koii1SOp3q7xnjA&oe=6AC5292C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObwZxhNYOCkQ7kNvwFXUBbD&_nc_oc=Adr8BHZ-bzhmI7fxUzmOT3Bf86JitDl3Ql0zJL1VYOejzz__7Jn0N78JlOq1GcFweGI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm_8QXZTNnOs1ZoxOU4sYAvgBLx0DPsIG4AsrmZXAwQQ&oe=6AC5052C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isVsh-_nu6IQ7kNvwGQwL8k&_nc_oc=AdqpViNPzUQ-ulp0bW_7EzW914chlY0pb6vL6lNI3jFuooN4qKe6ueYGJ0NZGVxfTco&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3T0eDWDrJsl-nH6Q6GGUT8pt2JvKfYeKLLtupqNJ0FQ&oe=6AC4FB8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.
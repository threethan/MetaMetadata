XURVkTn0lYk6HHWM0CDvW6ROqbJRzDlTpCSIGelCbliOig5pk-OEw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxkq8MqAUBMXZzG3yztVsAblFb_79IDtYWHHcXg5GVbjg&oe=69C3DCB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDtf9FVF5asQ7kNvwEsc0jA&_nc_oc=AdroRglcBwAc4v5MaZICBpZQiKpVcNBdeCjpKYF3pnCNu2gfWhGkPToRxRRt_hs5dEg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuU_KUTtlf4d9GXLKQjoFsQvZIas329w3io29S_oAGsQ&oe=69C3DDCE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC9tYVMi_GgQ7kNvwHRpD3G&_nc_oc=Adq0zSs2d1cV98iU5Eh4l1rzYtg73I9IKuV2Tzqyft5DxQicjYh-8MtNeHZy2kZGItc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTvPGS3uHFkoBvhIqoO12TNFceuPqxoR4C4tALfWoRAg&oe=69C3DC6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnQoLK7PXRcQ7kNvwFeP4MV&_nc_oc=AdoaRCA9I-jAA9ceuaRiYTc-j5zxHSalJT4NQkMqeUJOURu2GgkvtrVGw4yonLq__lY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxrge8om7flDCpIrTFeqeg7ozypToF6BKQR2t_ufoIIMA&oe=69C3F0AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nENrmVUnOK4Q7kNvwEwjxMS&_nc_oc=Ado5KDV4NSdqAX0v3bzlzQBPYH3V4WWjUndA3bV6gMHYduF2rqlP12oJk_Igqv2PNo4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4NY-CrAWVo9q5YOToivS6e-wKmgcEyu-gv1-TP-JCLg&oe=69C3E70B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.
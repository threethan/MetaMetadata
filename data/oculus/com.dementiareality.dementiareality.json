428085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kjwy0upumEEQ7kNvwFxvH4K&_nc_oc=AdqwZrKKWnx4BAv0_2toszjbYE8T4fr8T0WUFPlhnUFbwP-_xxmj9DI2aXymDQ8R18w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSghQ1k9_MAnwZcjTa2J3OEN-WAbysKbmjA26vD5bss_w&oe=6AFC8877"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff8HPdqfoikQ7kNvwGX4qtd&_nc_oc=Adqki4Eq-L7nKhWd7CS-dZFp-eVlxMZovxdlA-3iVUDEvsEXk9HcK08JzKjH8KyBGpM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfUPt2ohbjVmPzX7GXI4f3jPfFaci_1CWIvvmI_6ILEg&oe=6AFC898E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZCsxahFxuwQ7kNvwHXH1vX&_nc_oc=AdqeGG8Z2X893uDM9IKOGIvaXoSdA5UZLYd-dkfz-E2RN3L1mLZZpvGLtNKU4mGOs8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR22tG27OCMTCkGOFmgqrUfdOEyQC5QEgFAk9rVFxd4gQ&oe=6AFC882C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWHAxAOTilAQ7kNvwGwNa96&_nc_oc=Adr60RLpa4rS1Kd-AMx_QCqWJjY07dtq-bRWDFIREuzngj0QWnu0asU8DDTdlZqYpxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5inHy_2quoTZpEUwADQGi3yAKFBsIH-MbSBiEf9ZJBQ&oe=6AFC642C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNMwXWqp-zEQ7kNvwEb6U49&_nc_oc=AdpJz2F43CiHc_qlQcxvB9V3fi0BJr9drjIzmWphIqTanjdA-2H6NoT5gQpaPzztoQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQest5SLCEGK6yXY73zqD6B-pL6UAPvRETzoqQU74PUg&oe=6AFC92CB"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
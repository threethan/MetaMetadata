1qYVOajyeUNjM6TUcSnOr6Nw4Zz7gKyPRAJ45dXrDOHvJbhQQ6lpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzP9mS52-QtDijoEUdV9yAZoqjRdP0MgR9n8nZQKTEfA&oe=6AB7C237"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzfGWxeFCi8Q7kNvwHoBrBG&_nc_oc=Ado8Tu9Y3vyTzqp3adNCGqRLM8ZVhWxuCu4-DLLi5KxkUx7A9UumxEuqqcZoC1N1dXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEJyiBRXgAUtpyKpAr20_xmiHkxE8KRuGCr-EvnjVPZw&oe=6AB7C34E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITYqYNOa_msQ7kNvwExCyNY&_nc_oc=AdrqJ8k5O-NVG1Uh1lizMdSl_LVQOmNvKCPlTVqjoUd7_4K2GuilxLhEFVOsVx7b6lE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSVTA-gvTD0LtU_BZSqbY9HL0lP8FKq0-fyEaukkcCAA&oe=6AB7C1EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QVHGOSuTq8Q7kNvwEr_cNp&_nc_oc=AdoSIGyuStLFi0VIbhPiR-VO8j3RalcjHWXLdKxYxzSSVt_hdRC4Mw8kVz4AdywTn-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc4ZKwHDh9QyT2h9YI4a6ac9xbbGxZQ3mNvcP3QAhOfA&oe=6AB7D62C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlRx41wlHX8Q7kNvwF-mtbg&_nc_oc=AdqOsvco4Gg-1l1vEQ4UpmEG7fpfF-8K0qggNGhPy-m2bjypYURuirAKpCiZbLbbD30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnOW6EUlNMTr-MYQANI5RYy71Yz6009P79UwtaiIR9CQ&oe=6AB7CC8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.
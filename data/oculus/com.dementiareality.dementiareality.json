pbSY9vZeR2UoEtODDud9rswwxUK4PZWVysgtuvhJUZujAjyod107E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xEaMjW0EJkCCyiLuHSxM-O_YPaqZ6wuDra9UqIRh6YA&oe=6A1ADFB7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW8B_PTACeUQ7kNvwHJT-uh&_nc_oc=AdowexkMPUb9LlzU_AMPB7qhSonSMkj_CTA_VPIVhDSuJPIQqVY466gGqkLx1Mh_dzU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OPbpLasiK1gxUNh8XC8LmAYd_pId_7acyi28gtIeMbQ&oe=6A1AE0CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIPTcOV7IQwQ7kNvwGrSeUU&_nc_oc=Adq_ZygNPZTtNqOI0YqypEb1X20-X30Qs-5H-hC2UMfXyUNyw0qS8eDZXuxl8qXOjdA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mXY-v5Pt5KqYAMphGwm0vZIKlG0L9vTt2oh23b2UY4Q&oe=6A1ADF6C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aY-PZLEOY-wQ7kNvwHNdy6G&_nc_oc=Adrs1cMePyZO-C09WxANz6qv3xsgLu7gQU5JbAUiSuHSqfMheKZJWSb-GmlUURyDuMo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xVElKEDOtcvWXrThnMji3wVK0sLA1GwWJZreNdBbzfg&oe=6A1AF3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-P34EvOcQIQ7kNvwGGqR5o&_nc_oc=AdpJy5wHwDNiT5FCW11tSNC173qmZE-qWCzGaKOnZ70o7T0o1ASeRInjGnF4AF2vh8E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pIA9FwdNosnhIBadStLWEYVs7CmXDbXxvJoSAQ14VVA&oe=6A1AEA0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.
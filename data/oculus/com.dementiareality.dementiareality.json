NzuAb-GbIzxfGO2AFeGe6Hw76pwi0net-0_nJQnPuDljhEpSnob20&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11I01itmjk2Kgx0VyhSqoCzPGBvOiMPTwmVy0StKgGbg&oe=69E77537"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kKzesRqOocQ7kNvwG2bTG-&_nc_oc=AdpJ4JNVxJqXvzMxBmFs4FEGMyu236fL4YxgeUF859c0SJHIDArsPmLITKTi0FkDXNU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nsczM2esiyP1I-kSAYTvjwnfxPIk6l4JYfYDDeOfLMg&oe=69E7764E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KhqLILV2oAQ7kNvwFTxC-V&_nc_oc=AdpwldTqTqYXdl0HDLeIEdgmDkuJRzVfjyXfRgDEp-IFTTscc6q1f7hAGGCu0LynOsA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uDS3ND2HLym3veceVJHck73E1v3CONHPpSPnKZ48fjA&oe=69E774EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Uewl_7XeAQ7kNvwETZet5&_nc_oc=Adp0Pn4kOISos0t5pnOPDMXSX5hjwCCBrrbsY7wkqPGHPITlc-OTZmwLWjQQuq1ecbw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u051aFQKJVBvicLChGDxd2o39GtXW55xQRweSkAoX7A&oe=69E7892C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuy-9eOMbZUQ7kNvwEt29Iz&_nc_oc=AdphORPnpB5amQPiGzg6eqccxh59SYgfmL1CmZLNY2ppd_MZkdeZUw9k4HC_frOKtYo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IEpokOF8xMovCIwgwB4qK18jv16NlSUQrcgUjJUl3Lg&oe=69E77F8B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.
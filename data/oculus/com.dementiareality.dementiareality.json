WPPu4Bz6dcjavgWfeRFltTFe2X-2weQWpQjl-cztZ0tlMHs8O8wpU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_hcesQQvwYjqEkxUk1Z9m9iGcH34ft4RgJgEYfjsMPQ&oe=6A09BC37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90DmELxQSP0Q7kNvwG9AqKh&_nc_oc=Adr-gvsf54wzjvtLiV4fBjhDY0Cb5HEor-o4l_RS5W24jtIyoiLMjzPtLm1hMuSB4BA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XOs6LEPZYlBxakduv9E8Zwu2cp7waomW6-aqerO7Txw&oe=6A09BD4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmNJLfIkGVQQ7kNvwFr-DiP&_nc_oc=AdqhdEWql4fPNW4X3wBgix15-ohPvQLRxkp7orf7L5woLikX74e94lNkiJYJDZjYClw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S1pGRsiNbF-uVin8Eb26lJFKXFujNNsWwBpN_NDLe5w&oe=6A09BBEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCChDfN1CSkQ7kNvwFB6CpK&_nc_oc=AdruNNgDHiclZgqMaz7MrW7iP6gkhYakrgfN4BzHi2ZU-dr1taEDZhGW5okKlM-QClM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H9Xm74GOfCOYtGgBjBuDipuC0ii5jREq_mJtf2m1tcQ&oe=6A09D02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5_uvatfawMQ7kNvwHXc53I&_nc_oc=Ado2HaIzeYJwKKInPYt5NNm2qzU1iuBsXSDsytDToIeXRBySh7ocMf7Ni2CdmircI4o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B1ebhKyBMhtmWmk3O8ER1sZ19aVtgSntA95EQwIFgXw&oe=6A09C68B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.
428085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FojRdYCKiVkQ7kNvwH502Tq&_nc_oc=Adpff1YV9s5fhJ3_mXjWFvLJkQgLQwDkqX21blmdwmF0gikUGXuItXq8FgC6AUfrxOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3xJ2MoE2JEqzp5gaBi1kxVDCkVQx3--lERLuLX9JBdQ&oe=6AFDD9F7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff8HPdqfoikQ7kNvwEY4MJ8&_nc_oc=Ado-h9FEiT4Ys3kpQ3nMv6Fm2bpwUdCkMIIMzRYNmsOZXLMEUbqpJMPFfhRTCc_pNtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_jlKRhTP6B8WdNz4neZeMrOt7DSwKqlK2Qm8mj73dug&oe=6AFDDB0E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZCsxahFxuwQ7kNvwGX2wpd&_nc_oc=Adp2OF8N_qnrvzwawDPUNQrz_hwbpBbEnKt2yEmamaDiEp76HfjS98N2HRaE6yVD2J8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_yw7dFu2A4wvmDtrubH9YqDL1orcR_Cn-qUGVWeQ2WA&oe=6AFDD9AC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWHAxAOTilAQ7kNvwHBFUkw&_nc_oc=AdqBfz2UAzFSzGgcIEyxfuOnBBRTx4K9kWwlLyOKbt2SyOvwKc9ofqckSR7bGFPWdHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG-dbZFlt-W7_4Z5Ru2iNUJ9eyJ3r7vIxQL7SvryEvNg&oe=6AFDB5AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNMwXWqp-zEQ7kNvwFLIfcL&_nc_oc=AdoUFSfwoL8A1D5lwOTUnogvFdQpRANS3ner0O8NbWAYu1te6d-cCur4r_03mSSYM5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLl0R4ih0qNp2A3YMH2C03F8m1H7Wq2qZxad_JQONgOg&oe=6AFDE44B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
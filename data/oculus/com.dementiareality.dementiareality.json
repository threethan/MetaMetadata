RRTuMrAavC9-ZugXBQtbJNZQiZ83HKhUKL8bV-Os3wKuECwnNDY4g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmcnNNol6xpRTd2E-s8DyaD4S2XjfUnZCJu9teUjDlNQ&oe=6A81B4B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI8p1vA8fOsQ7kNvwE-1R0w&_nc_oc=AdqqO8cnWzFGJnR55OP-EmTY5Lx_Pfs3DTnVxc8bfgTNjvL9weekRiKgvSegsiRlQgg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyhmFyieyIF0yOw0oQH-UFX28nsqoOkA5qJfOtnFDDzQ&oe=6A81B5CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zDw-FeUxggQ7kNvwGEdtY8&_nc_oc=AdpegczvGBSDXmjo2iW8ndXu122YSnpuPj-OFHRr488lDeYYQxhltx46RbYd1-xecDY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFqbldkLxpBRcF_BmXpf0lNhF_6uUmJAq5THxXoP8gKw&oe=6A81B46C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unoljep1zWkQ7kNvwH5moEu&_nc_oc=Adr1_8LUBq6EynXZctpMmNLU0W2EX6RKhkVhUQcU8dQbOC1_Pdv8u8ZgPpnWnvVfOyE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnzCOHC_p8jsx2mLdOYH6mWJgEBP5bKI9LWEDuH2Suhw&oe=6A81906C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwxJIhKxMIwQ7kNvwE4hJQU&_nc_oc=AdpR65jxidpmnZcHW-w2jUZ4XZgoyuPQpn-57g3OJLqC3rQ4nX8IGJ3oxI-E26YjMMM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCbp7HE56MijaG_4Jq5GcU47qxLnm9_LcysEvOzrfE6w&oe=6A81BF0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.
Ed6R2dYxDCSE8S--tOi_wL2SeEv3fhHSb-nbDacNrFopJ9y4EZNJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3byZ1uUoziYPw4Hx8mB_9QrfnNizlzSLQFQJPIfRSN4Q&oe=69D8F4B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBQkElfZUEcQ7kNvwE-Tf4C&_nc_oc=AdpBi695FOLlAbkfU_wOyKxW8vhFgF6k360nnpZj5faQ-JeDHB6ix5zXO3Hi7EVeB3w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25ImBkaxJ-USw3TyvvSkt0B1gIaIxZ9YEBTiFOWPewzw&oe=69D8F5CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opMxrWOBLg0Q7kNvwEJrdvp&_nc_oc=AdojaWePSGjxC3QIbLl7FOozi1nKM6Stf-Tz2j-qyW8K84W0TcIrN-EsX9gwu75-zG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DHE14v4hQO20pHlekc1SJ8wF-lPXyKk6tYtlfhv7iWw&oe=69D8F46C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWfS02PBwOYQ7kNvwFkeJA1&_nc_oc=AdrOf4grt4RkFBVD65NCLv9PjVWHDoap43eHuH3E2nXj3Swx6xltrSecef0IiHzoP7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00XoytOHo9BcFYezi2H76q1daWMihqddyeaoef7KPqBg&oe=69D908AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnNtUNDV3FoQ7kNvwHX5hnW&_nc_oc=AdpyMe8OZt9MoaSx6NlOX6PhYqxelNQujlscd_k1rpgEjoZBct9sVhmXpAHivF23FyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O0X8vKBhAWKEYbqb4D33FUuqSyDQKqlg39vtOXS_Fgg&oe=69D8FF0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.
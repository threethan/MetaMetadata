pEuU5S5YeGAoFaGDZsYcdvrnjG7fyEVgxzQ121SGk0fJaMnj5P1FE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFg-iV43ttdNCqh5COlO649SsQYCe6S9EPjMKUYZW4PA&oe=6A5A27B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIyS_Bi_HicQ7kNvwERJhiJ&_nc_oc=Ado07IS1LFEieBJVVBwye7eN2bRWYB4qMkRPd1eWi54GjziYrpnc0aWt0BkeJoBJXd4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSpgQFzXyT72Hym0EXjLrlmISzCf_g672vWxnP6VSwSA&oe=6A5A28CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7cHLb-hMiAQ7kNvwF3OGE6&_nc_oc=AdrJKM_uA7ead9mbC_PcH_PpmY9KDkn56pEG_KQ2m54Gqhf2PQ581V_-powEsLHPAfM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBYgdeWC0RmvbFA1tz35OfgKuTr0MgGHr0wkivr00DbA&oe=6A5A276C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fp2HpvNzaEQ7kNvwHqGgOS&_nc_oc=AdpShMMEGnTBPvoIrIfbzZTDUGkzfTADjgyWlHaGhcixTawgNTqDHONxq_Vrvwg4kYw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC8CckDLHf8uCFgLSXXy7WgPCCG5OHv_wrTh-y-k0UvQ&oe=6A5A3BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUndcBdzZMIQ7kNvwEM3K3Z&_nc_oc=Adpvay0-Js23YaJfbuP6Ab1y9wk1s3ebofEAW_-aAFgGma0WbWDwb43OXku2UpcmRJw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvSwlFHF-8gte-btcW6p3yZAtc5BMaAvs1qHWysfFTrw&oe=6A5A320B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
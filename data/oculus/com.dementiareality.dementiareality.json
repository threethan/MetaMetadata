z5vZCdC-j9q_scU6W94RhHlSAVbA0Z42R6Hj_DqWIIDD5s4ecaQJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrn6n4SM4Sglb3mz4AOeWINstFHUcuVd7K0b1A1p9s7w&oe=6A9C12B7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pg6B6nLIWYQ7kNvwGrgUhV&_nc_oc=AdpO7U17wA0KO0p0sF_hm1cncUTPfI5MtF4s925ZgGnGnsux3DoA87mK2Q3ebUMYRR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdMNLxz-DhQtHLazIj7FlRQx-jZfrFUK_m2r9G4yvaZg&oe=6A9C13CE"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcOkbNdR_4IQ7kNvwFtOjra&_nc_oc=AdrbbG8VZXQ8aGwu_tUPfPHmN-5uN_0xGIkuJ_cxHKkZKXp6ajKw77Q3Byd8IRjxkNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfj4RSVUlgAWelRxVuHgUTJZWdJ49wfnNMJk3EZumQ5w&oe=6A9C126C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLLaBmpZmaUQ7kNvwEd35Ab&_nc_oc=AdpkocyDw6F38uMrNIfcEtBqIJReDYbM1sFGFUNC_MXq5ojizaZIXkFvSoGyqvqNKQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFLlqMqRKEIR9v4O55TndxuYBzJ6E7owXQ4PyNwfe5wg&oe=6A9C26AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOG19wNbrfAQ7kNvwE9sWSu&_nc_oc=AdpIqy2EHEYXD0X8_QPqDBjRV5IeRzvYSa8cnmM4K0fZSnUqdDl9qAt-QUmMeGxX73U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHc-Djpuj9Fl19MN_cZRFuSQK0g7r7mkUicIG5KMUTPw&oe=6A9C1D0B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
T97eCuLyGJtY0zrlAyXGTK7buDz-_Tgyob8MbjBBDim8SZVsHNWP0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51Yu41HqbuEEODws2Ay-fGjl0TAmKZDRZrRxQmJvdtQg&oe=6A0C5F37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuMqC256E88Q7kNvwEWJ-Tb&_nc_oc=AdrYC8fczFjV2OTq1CWUzzskA8smGdyP7xvquqjgNIgW44Ihi0zuLp2K60uWxYWvTb0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af550iH5SjMTWBHFHFuZVp2xwe4Zwqd_04X9WA5M2DSaiQ&oe=6A0C604E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeelz46Y5ngQ7kNvwH61zRp&_nc_oc=AdoN7MqMpX4qRs6u3VR4UDZ0PCtE-WzcxciBNb9rBx4Mwa6dISjCRkbJW7a9NtiJ678&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ewectWDaFlMojwzpAVYNZhtVHX2SvYaPqsDi-36Utww&oe=6A0C5EEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCChDfN1CSkQ7kNvwH6pFg-&_nc_oc=AdoqMAlKX1TeQ3-VHE6K7FYiyrxUignvaiNEDNmgYH0n5C2IA-gIBZcmiMkqHnCGWMw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a44bA9GLAuWlgylXCrNfEPBOjLf76qxWwfcp-GgR_6w&oe=6A0C732C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5_uvatfawMQ7kNvwFaEoR2&_nc_oc=AdqMOYO96j8HKOS91STMghfPYNjkVCiwSlX4C1w_eps2mqLzi4-LRjQ0NvkHcqjyWlg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z_RNPFe-7gWgW74Z8mTf4mQri6U8C5m0frkSQdeLteg&oe=6A0C698B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.
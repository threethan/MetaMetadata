428085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64ugeOzhRm0Q7kNvwHFwDVk&_nc_oc=AdoRGRtkAGUKIDftrjRycnXPEeOJiBHc_pmjYAAVNmublfUSriCY1ohf8NxOhzIiN9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJrzhpr-bj_goOe3Ux3jDrsMONG0HVex_S4p3ufYtRIA&oe=6B01CE77"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqA6Ta6iIJsQ7kNvwEqzHQ7&_nc_oc=AdqxCyrq2OportKEy1tgoT_rXFIibY2yYctmW8mC0oEvRUl1FQsSydzOvizzN6xkwBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNXTQZSeltd4MoMduNbMUssv6QRlDUT1a0rPi9K9F_ig&oe=6B01CF8E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1Yje9pNrKUQ7kNvwE1wWty&_nc_oc=AdrwaP-Z6X-YTPbg-gJR1T2BUj1MZm4cOEItV5C4gDUBs_dmuG-z7d1LZAY4o9NgVmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQv6-iAU3HS3ohSiearusnZQBLn7wQlqZ5o519WbcmFw&oe=6B01CE2C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4LntWNQft8Q7kNvwF1v8mh&_nc_oc=AdqU5iOlD2U5LR8_J_t8ynmD2H3q4dXrQLsebCsSNf4dP3sKbetS4vu5wCAPjc3vv_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwlhB9eCrVqrxtnQ_8YeBlT_7ajCDDhRoRo1qhMtY-zg&oe=6B01E26C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeZIV8a6mgoQ7kNvwHf8NHj&_nc_oc=AdoIkHGozS5iV2_7rS9BvuZdrpl4is1c1aAn07-od0Q4MCCJhkiaFnbD04oMA-YPG44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFbnnTq8f7mZ_o92twxWWGD5AMGxJrtihNXIpzyOkpWw&oe=6B01D8CB"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
-amkuHwzu-5TucZlz1YLjg7rWGo_oaz0Eeyu1YIswIayd0LbcCPec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5DvhwSYCsD2kpVNa5_NT80Fs9X28m_zYK5y_1u_Yu5w&oe=6A5B7937"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIyS_Bi_HicQ7kNvwHv8I2e&_nc_oc=AdrulMiXrL1p62cOxxVVdVEXxJ7gXw4t60hD4jnsDDedi0KQwUOc0pNHE5AX5dHLVzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbCAOZhiow-XusI5dUCabQvdg3yghfk-M0snteaRV1nA&oe=6A5B7A4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7cHLb-hMiAQ7kNvwGCObmW&_nc_oc=AdqHDQ9f21XifgSqNYh62v8na_cqyvSoRNGunul105xSQaN-_YDbILIRy0HAQrpvL7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9SkBBlOGHOjrRPSuD4HeOxFAeBX8HLJhu83YPy0-Ktw&oe=6A5B78EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fp2HpvNzaEQ7kNvwFChOIR&_nc_oc=Adpllylx2ryMFlQMUr6RLEK1argfToSBbgKNp6AgzBZZznOocofgheBJhIHb4m_tID4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnhGfFWGpgSSk3NsWAErOAVeg4VJ6axjM90tySRyii5g&oe=6A5B8D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUndcBdzZMIQ7kNvwFQguTm&_nc_oc=AdqrjQKvxBGcmYhIevNMXjQi3IYUnD8ZnrryRYI1mkyLRQvAIuDrjiE3dNP8-XliI74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP8zFfgTikJHU0wwZPk04zAIQGm4qJS_ozVTbG5m2QNw&oe=6A5B838B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.
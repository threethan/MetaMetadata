v43hkJiWkUQU-MtH66k0U-FMZdxaboYikT85ij1dEhCIU6HPn7G7s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3w3V7lVrYiMZVS3ma0WMqJJ4wBizskXlzRIoEGOas0Aw&oe=69EF5E37"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vDQN0Qx77gQ7kNvwFb_99F&_nc_oc=AdrxmSdLfP1lWT7EmebRdvcUKV7sM6_sBDrmu4MajoeiEMndjlYg-9uk1Wya4agoOYQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VO-FM0i8Z-rv7dM1H74IsaUrckrX5ci_QeP3J6HE0bA&oe=69EF5F4E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-UUTgD3c6IQ7kNvwE1RSFz&_nc_oc=Ado-4SYhudgNyelnY9slduzaVcOYCxRVPG6IGTLJjQ_3s6Zus8JxcawndvjSCzyaDpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QQnW98wa7yunHA0l0K-C2jDY-lxtSRKvtIvPEqvvRkg&oe=69EF5DEC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWZ5o3m1VrkQ7kNvwFPXL8s&_nc_oc=AdomYrIf46bIwOmKvK6i25IbISdtZCMB8maZ6xQrWrCzDc4pCaSrjA8tPuOO7WjrhQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yOJilPHth9ACQ6kEHnPjgAIhPTzpEJxShID51T8_5Lw&oe=69EF722C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmmhup-Q5kIQ7kNvwEz__Rz&_nc_oc=AdqWFxcnhja97qqIy_BMB_V5iurjXQyMvmMp0b7yiThBAibe1ymZdCQIaDMyWzWqvfI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SmqWKkIC9euBDCDPErCjl2Xo5nhycBR1d2QO_qjICZw&oe=69EF688B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
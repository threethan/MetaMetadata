428085", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0vuY4RY8McQ7kNvwHddLRn&_nc_oc=AdrbE6NZOh0diKdvzDkkr4MlmNpU69W-X67i2iJ2xOmkgnnZHOAH6D7Z82ep2UWixHg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSqmK6d-IOeFVMEKYmd_FmsfavxO0x5V1L-Maf16tBOg&oe=6B0B4137"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5he52aaTPDIQ7kNvwE8gAm9&_nc_oc=AdoJqwjRsMPYJrnhd0II1ErBcaTW9vM4kkB9kqVp1dpfW11QVzdZ9gi4Wk2cTgG_ASI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3Uwfqg7TOdMhMpm1DtCRwRBc-_VD1rlx1VYm-SR6WcQ&oe=6B0B424E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fan_a82os4Q7kNvwHm8SSH&_nc_oc=AdrR13vzw1IRBQ3IOqS_ffVqku-sjUOGMxr4N5cr9StzUCX0MHjiCgWr5ysU7fqoY58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQ3AR5DXd2m1-IFMb_FWmjMXSE7CwfrnFDugGZHy4ogw&oe=6B0B40EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z21aVQFvitQQ7kNvwGEQTVt&_nc_oc=AdprwRrP-z3KTu8N4tsrD-MwwUlAQqJkAHNTo8VDXvNiEgjNLm7Pe2U0DG7tKoOowlc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2QWZpOHSff70FW69PF1XkpZXmU_r0Nymxf-z-pcnE7g&oe=6B0B1CEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEtYdAY4_7oQ7kNvwH1z0lb&_nc_oc=Adr8zWHqDeZNB6Sa0YqQQgvGUCV-xB8yYZMdVpAF5E7fMpksvw0WPjWBGq44Ebt1KGk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcyJDtVQcGYJUlqZJSfj0QwkGDWyiXMFPntzZmzY7a2w&oe=6B0B134B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
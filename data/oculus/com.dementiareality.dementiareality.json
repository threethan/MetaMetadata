428085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031615_386152890761418_7534005873915240921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcU8O4bN21MQ7kNvwHF7JpY&_nc_oc=AdqOlbfyNrgLzY9n_-U8sMJcvwh7FT7_CvsOIfOMica2OW0vN91naKVH7syRUddIcIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAJk3u3Lxbtu1kK7pTG-b3TbGuo0x-XKRGoOhTfWZKXQ&oe=6B0DABF7"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5he52aaTPDIQ7kNvwGu9onh&_nc_oc=Adp89NEblfKIJ9KeOCj3jw0DMFpGSjBqzG6MyJzj39qPqmZmPZmV5y5RBxF_nooGXCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSq_lUaVBD0maB2Y0CpO9ypM00Te-nEtCfjISTYOT97mg&oe=6B0DAD0E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fan_a82os4Q7kNvwHryBUv&_nc_oc=AdqtEn5bJaEO711Z8YHDq7k2T_pFuPflsoYUmdOt1r5Wbq6hGWG9hhcBH5KVoPwfGjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzrcm0NBakec6kml35wptxzr8BuudSPFE1p4PpVpA6xw&oe=6B0DABAC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z21aVQFvitQQ7kNvwF5vPUt&_nc_oc=Adqyg3eWyWmG3XN08ZpL8KkZGK4Ct4BF6c1dCa-94RUr6xU4XYn1-fxN8sWFoqz35kA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOMxqeCGW27Mv28HoNl_yDh_v9wNv_PJwYvZBicEfdZA&oe=6B0DBFEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEtYdAY4_7oQ7kNvwGRChw8&_nc_oc=Adqj6n9b15oC8_KM2ety-MRyxRaoFPbdQajIUymdUhT1ECEpI-j6BeIRI1K5aIB8Hvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzQQX2I09d29wZ1s_ui2AVasTa05jfS4YyLt3tnhQDJw&oe=6B0DB64B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
SnBn4P60x8HGpy7vbOm3K6SlUSxglCm-9TI4-XfJoLUhUwvWRRofk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwykNfA4iA99EhE0pVFHY0BNiYZcZUvHvmJtAEkyPwgDw&oe=69CD1737"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_SZY7zvwcUQ7kNvwFojwn7&_nc_oc=AdqQRP8_WqE9leYoZO6AzuK0hA2u_obyeNZr6_uzl5iyB9ds3pSv5YfS4QblGR31unM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2o5TGwFK4pQFx01PstEGISiDYsp-NjkwZoQyhl1b3rQ&oe=69CD184E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF7oNFFPwLEQ7kNvwHBD_BK&_nc_oc=AdobkXUSb-k9gwYH-ECiemyM5q8q2c7Y1-VkzB0IubjBw40t3Evzpsa8TUtpLgrOcho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFs3yW3xhSUYmaXY5XL4p6_e_TrDCBxt376ro5MHSu-w&oe=69CD16EC"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMQ-PTcHwY8Q7kNvwGiXQpj&_nc_oc=AdoD-lKyDBdRvbaFBYxRZiGZSti9p_lNnlwYP1_fgpwYBNjmJWMJpSW7A2aglqpnTxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyK8KvfM6zCpP9JhWrByxvPMsNTfxAmz2vHRee85GwyaQ&oe=69CD2B2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuDXy9MeyagQ7kNvwEP1RcL&_nc_oc=Adq6r3h7MzmHhFTFbN7ulaUPxaKYwu4kJ3t2tkqY1BeBZyt1xqyIcNaTQrs0neIBa98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZUmPNyOC_1J7wEhTYGTW4djKmK20uMu9kagjPRQ6PAQ&oe=69CD218B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.
NXeQnENEA4CimTOT2_RIc_Dpth2LWJvSaY4Zzk7RxJCYG-FVSHVzU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQORpTtFgAT_sHS4Oto1ww93a2NcVo_ZWHXyC68-sSDvA&oe=6AF9E577"}, {"file_name": "2.png", "id": "751141470270155", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569478_751141476936821_9006652485128227969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M0MI_0V7AwQ7kNvwHybS_M&_nc_oc=AdoIx43Fv-K6k_orm2snFl3l-38uGubktOZT5UZPbFyIq0mwC8yYvw2p-w_qcKxz5lQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfxW2BDZLgO3nJ4aQZXtazzOmo6LqHDC_YOYKF_5i5kw&oe=6AF9E68E"}, {"file_name": "5.png", "id": "1535952167193929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982614_1535952170527262_782045266895483020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SKKoRIEwrkQ7kNvwFq46WU&_nc_oc=Adr8_fHcjDEvb8Ox_vS_PTQ7cWfIHhcCsUacCWhSBBkufkoeq1HLAhj0GnjxnDbfjec&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8qFIei22JQwF0CauMOBMEX61BTFY9tSDI0o0qreMc0Q&oe=6AF9E52C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XoyuMQMylgQ7kNvwHvJRJq&_nc_oc=AdrPly5olOHl3wCGd0LQrrLaTVlpV_XbZwIi-xNrA6VyTBaYMxCHDTshA_wvgMK67CQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt6nKLx3eQCVjUcvxS_dOOzZDGHSe49D24QUORTI3kMg&oe=6AF9C12C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Dv3s3W36ekQ7kNvwHsQPn7&_nc_oc=AdriwmGjsJ_WEOSkYokrWeZnEipSzKR4XKz0uRFYFrarFmdwWJW-KAV1t64xcn8Sk6Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLjUn8Wpm0zUUhqfLQgWL1QmQJsF4NEvGxDj8kabMW7g&oe=6AF9B78B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
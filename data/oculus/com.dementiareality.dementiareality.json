Q7kNvwFOavSE&_nc_oc=AdrDPRQrmVgSHJyRkC6P1nHpkd8GNjINVCYiBaOeTh1RySYJ6Jyl4VzLH92oizWMtLY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sFheCuETSZsxGo-l30tY4qJxHSs0MV7VwLsT0iqH9Yw&oe=6A2FF76C"}, {"file_name": "1.png", "id": "1032424904492399", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974686_1032424907825732_3935096735865419117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thjoZvhEoYAQ7kNvwGpL953&_nc_oc=AdqAaQnxLmgg5hNr7qd9gdIqpYlyYjS2adESC2QCMUyzS62liwO4CmRIDp2t8AJN0LI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nK9KcKK4sYpjtbTLUXW8H7m-XwJDZPxdQW48qK9iylg&oe=6A300BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "1659326611266834", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035357_1659326614600167_5868832121069241264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_2Syp_ya7YQ7kNvwE9fr8G&_nc_oc=AdomByHMoe8U7tQMONNCnH6tR6NNjuZKgA37Ejw0DeSAWeAbsnqWpdPP-z8psuX4d68&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96TKWcgqS-Ma94ImAoNx3G5M6_kpBfcTDzstD80Zew4Q&oe=6A30020B"}, "display_name": "Dementia Reality", "keywords": [], "long_description": "Dementia Reality\u2122 is an innovative experiential caregiver training program using virtual reality technology to build empathy and understanding through an immersive caregiving experience. Dementia Reality utilizes both a caregiver\u2019s and first-person perspective of a person living with dementia to develop the skills and knowledge necessary to provide excellent person-centered care and improve outcomes. Each role specific training module is 1 hour long and includes worksheets and handouts to support the curriculum outside the classroom. Module-specific skills and learning objectives.", "short_description": "Dementia Reality is the first dementia instruction program combining skills training and real-life obstacles in a virtual environment. The outcome is more empathetic caregivers and happier, engaged residents, clients, patients, and family members. Dementia Reality\u2122 is a collaboration between CJE SeniorLife and Elderwerks Educational Services."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dementiareality.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dementia Reality", "support_website_url": null, "website_url": "https://dementiareality.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24743055358674372"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1184783355686091"}]}, "baseline_offer": {"id": "1184783355686091"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707512644, "status": "PUBLISHED", "id": "1184783355686091"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34151159661197181", "version": "0.1.2"}, "id": "1035037664214153", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24335839399395972", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34151159661197181"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE"
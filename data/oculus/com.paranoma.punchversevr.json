uluscdn.com/v/t64.5771-25/491824191_1704622970197287_886532692820474472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sm0DX4AiNcQ7kNvwFxdgaj&_nc_oc=Adr9KiMCdWewG31tgM-8JzQmKTXMSBWZvAjZfLIidsf7W9G8NkJ0NmXk1MQdDi5tvGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoJvue8ptwmDlBmd8k32-eelDDOW_Us2buXuc94HD2jA&oe=6A6A085A"}, {"file_name": "4.png", "id": "712938025117557", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499627482_712938028450890_7996894079493265399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JW04VGgjioQ7kNvwGzGl-f&_nc_oc=AdrIH1rDJ7-2tkOmbxFrFceqM7KkT8wlLgvMAqNZYRYOft7Rut6SUN0vzxW5eCHI3t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfPQdFWU9jCvc4qIBQwsvmq4uTNduGLQE7j12YyFC5aA&oe=6A6A08D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "3259264544227888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624744_3259264547561221_4452318315298865842_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih7LuxDGOc8Q7kNvwECn-f0&_nc_oc=AdrpifCAVW1if-FRDhlbbefaItmQCYL9ODGXCBADQQJPhrgUQBse83SIGK2fjg6ga1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6OeASS9P-54cwNqd6m3sYl7WALbHI8Q67i44HlKWeVw&oe=6A6A0877"}, "display_name": "Punchverse VR", "keywords": ["VRBoxingGame", "VRFitness", "ArcadeBoxingVR", "VRWorkout"], "long_description": "Punchverse VR\n\nStep into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test.\n\nCore Features:\n\nIntense Punch Challenges \u2013 Hit targets with precision while avoiding costly misses.\n\nDynamic Progression \u2013 Survive as long as you can; every miss brings you closer to game over.\n\nImmersive Audio & Music \u2013 Energetic voice lines, punch feedback, and adaptive music keep you pumped.\n\nLeaderboards \u2013 Track your performance and compete with others for the top score.\n\nArcade-Style Replayability \u2013 Quick to start, hard to master, and always addictive.\n\nWhether you\u2019re warming up, competing for high scores, or just blowing off steam, Punchverse VR delivers a fun, fast-paced boxing experience right inside your headset.", "short_description": "Step into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OCqMZ736rfvTwXnk_mAO73hXMKDrcTNWSAGpozxf2zk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Paranoma 3D", "support_website_url": null, "website_url": "https://www.facebook.com/paranoma3D", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903059866039267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1726074241874619_1282266223107701368_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e6qMjXQFNIQ7kNvwE5zPnE&_nc_oc=AdpcBMCgLWnVWBt4L3NjYNEmYLd4YrlvVwrwH_Fl1BEgukVGZ-HgiBl-5_s7hSPXYNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp4bweRso3U-w9I7ZErWZ4JhItfRfP2HxO0DyzSXiOAQ&oe=6A69F6D3"}, "is_concept": false, "is_t
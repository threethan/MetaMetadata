uluscdn.com/v/t64.5771-25/491824191_1704622970197287_886532692820474472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH9_UcmvHbgQ7kNvwGVKVIA&_nc_oc=AdpsJnD68Kpqy-vjM0BpIz3q-6kj5vLeiVTJGZDAleLt0bzSIHJ68wztFFei2FW1P0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK9Y_DO_wU_WnFVIMtbiXdvKlTelv8oUztn4sbZ1t6mg&oe=6AABF35A"}, {"file_name": "4.png", "id": "712938025117557", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499627482_712938028450890_7996894079493265399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nqt-_ZdiZa4Q7kNvwElm_rc&_nc_oc=Adon_jiVWoLH2bnov_VA1JtTOgkflh0jh5-d0QKlyfygj97mG_F4QIEFwCtGltnE5YM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDJKeN99wJDMYRnYLwTORSRralcd2lUhfRDqIo-ZeK6g&oe=6AABF3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "3259264544227888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624744_3259264547561221_4452318315298865842_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzghkEEp9-MQ7kNvwFdcXXe&_nc_oc=AdqkNOaCFqveFar-PtqtaNsU5Vc1w0lMpMEaXdB0yjwJkR4j_jvxmAXRFiMZJa7Vr6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLO3bCvu4C_oL6mW9eIafdZZWyXx1t9WHsCwEj4hvLPA&oe=6AABF377"}, "display_name": "Punchverse VR", "keywords": ["VRBoxingGame", "VRFitness", "ArcadeBoxingVR", "VRWorkout"], "long_description": "Punchverse VR\n\nStep into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test.\n\nCore Features:\n\nIntense Punch Challenges \u2013 Hit targets with precision while avoiding costly misses.\n\nDynamic Progression \u2013 Survive as long as you can; every miss brings you closer to game over.\n\nImmersive Audio & Music \u2013 Energetic voice lines, punch feedback, and adaptive music keep you pumped.\n\nLeaderboards \u2013 Track your performance and compete with others for the top score.\n\nArcade-Style Replayability \u2013 Quick to start, hard to master, and always addictive.\n\nWhether you\u2019re warming up, competing for high scores, or just blowing off steam, Punchverse VR delivers a fun, fast-paced boxing experience right inside your headset.", "short_description": "Step into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OCqMZ736rfvTwXnk_mAO73hXMKDrcTNWSAGpozxf2zk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Paranoma 3D", "support_website_url": null, "website_url": "https://www.facebook.com/paranoma3D", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903059866039267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1726074241874619_1282266223107701368_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEmJ3C5JOGEQ7kNvwENdNh_&_nc_oc=AdpFMYdMDRUR9eu9v4mGzQLgIgEU9Z4jtIQPkdyDVg8qim5hoG-GVQGw9f1epuMT8zY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcbPcXstrkT6fXNtPh5IfnTmB9wCoOuZUDYbYzrQvNWw&oe=6AABE1D3"}, "is_concept": false, "is_t
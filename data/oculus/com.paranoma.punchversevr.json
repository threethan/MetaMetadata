pfQcAdTW0tu5qAUZPUGjxR1Dw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cw1B9R8_hH6_2N_YshGtlh_eYly0RlQxdroeYNvyUgA&oe=6A03335A"}, {"file_name": "4.png", "id": "712938025117557", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627482_712938028450890_7996894079493265399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GVes0sUl6oQ7kNvwEaO-dE&_nc_oc=Adrv_Juy8NGgPx0wmPrvj05Ghb4bj6nAR5HdWqsySCQNRXGAg5682nptSLFBkOkMKjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Nz0FZpyTCzpR8hdhJmu2OfSmNrUnV3RWPn4xk-_mYLg&oe=6A0333D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "3259264544227888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624744_3259264547561221_4452318315298865842_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH-EZypgu7oQ7kNvwFSk3fj&_nc_oc=AdqxX_iLzd2bI4JFGiX8RGLj6GqaSySGwqf222pr7ZQ7-iOB0ARxyp4MIsYRLbsDPYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65WWzGF0RmKzgzd_hna5MuL_Yx1M4-WyrEIVShFiVFXw&oe=6A033377"}, "display_name": "Punchverse VR", "keywords": ["VRBoxingGame", "VRFitness", "ArcadeBoxingVR", "VRWorkout"], "long_description": "Punchverse VR\n\nStep into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test.\n\nCore Features:\n\nIntense Punch Challenges \u2013 Hit targets with precision while avoiding costly misses.\n\nDynamic Progression \u2013 Survive as long as you can; every miss brings you closer to game over.\n\nImmersive Audio & Music \u2013 Energetic voice lines, punch feedback, and adaptive music keep you pumped.\n\nLeaderboards \u2013 Track your performance and compete with others for the top score.\n\nArcade-Style Replayability \u2013 Quick to start, hard to master, and always addictive.\n\nWhether you\u2019re warming up, competing for high scores, or just blowing off steam, Punchverse VR delivers a fun, fast-paced boxing experience right inside your headset.", "short_description": "Step into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OCqMZ736rfvTwXnk_mAO73hXMKDrcTNWSAGpozxf2zk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Paranoma 3D", "support_website_url": null, "website_url": "https://www.facebook.com/paranoma3D", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23902544686090815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626754_1806232699977774_5499159922353044693_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5hGp7_TMvcQ7kNvwHy87wU&_nc_oc=AdpydfOLc9mlxc5zi8QkZiVtk1liiFHXj3ucY_45Vmmd_IXf6OmMKvx-X0V1O0ZOCo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hb8jz5v6yQt4dO_7sA4tQl--4ncfU1sm5Ynxe8Ev_eQ&oe=6A034229"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Punchverse VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_top
f&oh=00_AQQjU8A_PfJ3WvMKn-e_KoLr2GAiPHiGWYLZ-hlPZ-IXUA&oe=6AFC971A"}, {"file_name": "4.png", "id": "712938025117557", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499627482_712938028450890_7996894079493265399_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opLf8h7Oa9kQ7kNvwF60D5v&_nc_oc=Adq4lc-6owSSmTBflkgtx0tlNqAJ-Ic-ZyQVk7l_0yRDwFsQVKaMNzeT6bdq1KaPNFg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQywGALfybfrEu27bMmUTT-kihdins5pq9xCC7slR1WVw&oe=6AFC9797"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "3259264544227888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624744_3259264547561221_4452318315298865842_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfqk6MCLEuwQ7kNvwGr6750&_nc_oc=AdpIOblAR_swI5hOEjygAyHZsLxT8qXChA2MXadvL-eUFX88whtuNdaKUuQsphI-mGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoeosMXOzeyozD9Cku64zaI5z0Uh44WDnYB8gZKNAyeQ&oe=6AFC9737"}, "display_name": "Punchverse VR", "keywords": ["VRBoxingGame", "VRFitness", "ArcadeBoxingVR", "VRWorkout"], "long_description": "Punchverse VR\n\nStep into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test.\n\nCore Features:\n\nIntense Punch Challenges \u2013 Hit targets with precision while avoiding costly misses.\n\nDynamic Progression \u2013 Survive as long as you can; every miss brings you closer to game over.\n\nImmersive Audio & Music \u2013 Energetic voice lines, punch feedback, and adaptive music keep you pumped.\n\nLeaderboards \u2013 Track your performance and compete with others for the top score.\n\nArcade-Style Replayability \u2013 Quick to start, hard to master, and always addictive.\n\nWhether you\u2019re warming up, competing for high scores, or just blowing off steam, Punchverse VR delivers a fun, fast-paced boxing experience right inside your headset.", "short_description": "Step into the ring like never before! Punchverse VR is an immersive virtual reality boxing challenge where your speed, reflexes, and endurance are put to the ultimate test."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OCqMZ736rfvTwXnk_mAO73hXMKDrcTNWSAGpozxf2zk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Paranoma 3D", "support_website_url": null, "website_url": "https://www.facebook.com/paranoma3D", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10021749211263597"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2476806459431566"}, {"status": "PUBLISHED", "id": "974972168721234"}, {"status": "PUBLISHED", "id": "1517910800335129"}, {"status": "PUBLISHED", "id": "1558983158585970"}, {"status": "PUBLISHED", "id": "1433364675031773"}, {"status": "PUBLISHED", "id": "1208009574518495"}, {"status": "PUBLISHED", "id": "689914657504483"}, {"status": "PUBLISHED", "id": "1309737870500869"}, {"status": "PUBLISHED", "id": "1500665340926401"}]}, "baseline_offer": {"id": "1500665340926401"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2476806459431566"}]}, "liveChannel": {"nodes": [{
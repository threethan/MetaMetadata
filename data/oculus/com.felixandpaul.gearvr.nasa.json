ce Explorers is a cinematic VR series about the new age of space exploration. Witness the lives of NASA astronauts as they navigate the trials and sacrifices of their training and missions. Explore the camaraderie of space programs around the world, and discover the latest advancements and plans for deep space exploration."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "NARRATIVE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "254514570502122"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_2258643384523311_4048692614386831807_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3E6EOP9rFUQ7kNvwEfkG7q&_nc_oc=Adl3qAb2SOqpHWjqr0lT1fuKeLcc_G-JvtIydfrptsitHU6YxeMgdg9tnm5KKlgBOgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvlmAAVtVPI4u3Khba6-Q7jRxROxm34z9tiB4iy8Vk4Xw&oe=699C38D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Explorers", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1524349126, "lastRevision": {"nodes": [{"id": "1933154693421901", "release_type": "SCHEDULED", "administration_status": "APPRO
8054", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12427574_183051265872321_6132098677365276672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il8jAcXlK1oQ7kNvwFQDSXd&_nc_oc=AdphJYC_fI4BlrESJ2WzfLp6pukLugWFEV-rcD6ffe8A7cDRLqi1XGF9Pex_prror70&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVf11jaNmU0xGeKWlDmNJgskv3TonYxqb5uvCT52xPSg&oe=6AAE9F5E"}, {"file_name": "migrated_image.png", "id": "142501333802171", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12534042_371680596569289_1291321706119430144_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcqwHxMHSHEQ7kNvwH68qE2&_nc_oc=AdoU1xliv-VPocvu2CEZZoDV2SvWMpeucOY_u728Jt7x8FbewF2hEs3h3YhugLwy01U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm1f99O4f4sQdOdedMv6EJ4Cc2p_WY4W32CAiYbBldEA&oe=6AAE9D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nasa_graphic_main_Amaze_2560x1440_24bits_v004.png", "id": "869165291465000", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036604_869165294798333_2872983519313643631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmMf-dhFMi4Q7kNvwEKWQYr&_nc_oc=AdoQp6PKuSUA_wt3jMaoDpNW00slcOJwhzpaRsVDaoLn2RoU302IPBifspUURKpwaxE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2qIXx1EJXXhY4iekHC1PXgLgwT-EeJZrBYWqGSYyyhw&oe=6AAEACF5"}, "display_name": "Space Explorers", "keywords": ["Space", "Explorers", "NASA", "Felix", "Astronaut"], "long_description": "*** Episode 2 Live Now! ***\n\nSpace Explorers is a cinematic VR series about the new age of space exploration. Witness firsthand the lives of veteran and novice NASA astronauts alike as they navigate the trials and sacrifices of their training and missions. Explore the dynamics and camaraderie of space programs around the world and the collaboration between the public and private space agencies, and discover the latest advancements and plans for deep space exploration. Space Explorers will shine a light on mankind\u2019s most ambitious journey to understand our planet, our galaxy, our universe and our origins. Narrated by Brie Larson.", "short_description": "*** Episode 2 Live Now! ***\n\nSpace Explorers is a cinematic VR series about the new age of space exploration. Witness the lives of NASA astronauts as they navigate the trials and sacrifices of their training and missions. Explore the camaraderie of space programs around the world, and discover the latest advancements and plans for deep space exploration."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "NARRATIVE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "254514570502122"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982584_2258643384523311_4048692614386831807_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2btbginsxXIQ7kNvwHcUS_k&_nc_oc=Adonf0Bb2C0lttd0-i_nLU8jQd5T8DOIauuzl37YgXCJNisNYpRqRLwRWcHamSSkovE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDn8KzIERZN_eB8uvhZnCTpS55GAEfpxSCEW2bQ7i4yg&oe=6AAEA915"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Explorers", "platform": "ANDROI
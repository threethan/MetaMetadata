able gameplay. Play in your own space, enjoy interactive matches, and experience exciting badminton action. This is a beta version, with more features and updates coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackholeinfiverse.com/coming-soon", "developer_terms_of_service_url": null, "publisher_name": "Blackhole Infiverse llp", "support_website_url": null, "website_url": "https://www.blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1184757874712017"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622214_1004531645430157_5340540711405657527_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2_UfGnJ95UQ7kNvwFujMdN&_nc_oc=Adq9W9kDMXW1N3e0R6tfTxTab1IGDjvHSljnvevyLEXOJHsg5dD_rZt0riW-eBHXUIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PCMqMMTPzdOcnAmUPxuI-YRnQTEinVykAyfeZ3Ha_tA&oe=6A37F6DF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mixed Reality Badminton Star", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1780488780, "lastRevision": {"nodes": [{"id": "1184757881378683", "release_type": "S
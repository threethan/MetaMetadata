446524364084398", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974732_446524367417731_618428665154298935_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_c-__CtCk0Q7kNvwE7uogt&_nc_oc=Adr8w1X7lhsMjJja9HOAtnuDZUJwmn7_TrcZr2KsRfpyEIRnBvOak2YYy4uBGjRO1oI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPWsykpuIQb2onvQA3SLbwb25q3NsPXgw04g6otJOcvA&oe=6AC51B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusVideoCover.png", "id": "1122483805141916", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974920_1122483808475249_4313784318389251081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNZBgovX3eoQ7kNvwFUy2_s&_nc_oc=AdrwGYWot5i_TJke4Vqx3qw1banMlZfVHyWc0At-OI1mi-cQpGKEZ_BIvW261CIcvrA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjjDVDn94qvOIa0Ijis91Xq-TM9oUSjFOdmflxGOFKEw&oe=6AC523C0"}, "display_name": "Forest Farm Demo", "keywords": [], "long_description": "Open World Farming Sandbox\nWork your overgrown forest into a thriving farm! Clear the forests, grow crops, keep animals, craft fences and more! Turn a wild landscape into your dream farmstead.\n\nDemo Features:\n9 plants, vegetables and fruit to grow\n3 Layers - trees, bushes and root vegetables\nCustomised garden layouts - dig your plots in your own grid design\nLocomotion Options - smooth locomotion, snap turning and teleport locomotion options\nTree logging - clear forests with your axe and recycle lumber into soil\nCrafting Fences and more - to protect your crops and decorate your farm\nAnimals - feed, pet, and fence in rabbits\nSearch the land - Forage, fish or break stones in search of raw ingredients\nDay/Night cycle - Controlling the weather and making your farm scenic", "short_description": "This is the Demo of Forest Farm: a peaceful open world fantasy farming sandbox with RPG elements. The forests are overgrown, the gardens have been abandoned, can you bring life back to the farm? Grab your tools, grow some produce and create your dream farm to aid the local citadel which is growing hungry!"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "http://tonicgamesaustralia.com/ForestFarmDemo-privacypolicy.html", "developer_terms_of_service_url": "http://tonicgamesaustralia.com/ForestFarmDemo-termsandconditions.html", "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1796320834043440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974673_440921714768942_367622162713879160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30K1-yUBqXsQ7kNvwFvWrBq&_nc_oc=AdpZvrnCW8SYkZkkaAtYppfNAEY08ALfCZloC24KwFBMKf-dC8ZJn8txJex6Y5F8k3E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiudXp-0PozQMa2E23sn_0BX0vRbVrBovaWvqhbcA2xw&oe=6AC4FBB5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Forest Farm Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "19
f&oh=00_AQQfq4-gTIXy5k9Wuv3RYJv4sSfoL4G1nxEJIxF-zEnIsQ&oe=6B0C7522"}, {"file_name": "Screenshots4.png", "id": "328852915180562", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_328852918513895_7800079431753640225_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f4zJfTY8QIQ7kNvwFuZ7K0&_nc_oc=Adru6pd-c0asyx0vAhYDZmvG7QCyfLVcUl8RLg9N0vc5quAbmXBLP5D8ZrYnboiJ7F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0fiU_-JYe3iN7nhom-F4FrOJuY8tcDq8rF9jJNDvArw&oe=6B0C77A2"}, {"file_name": "Screenshot2.png", "id": "849111222610585", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_849111225943918_4380788916088467491_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTbxeNFBCjgQ7kNvwHB4uuz&_nc_oc=AdoscfWWohQ59m3QNQcez4BRXizDsZN7AWmHFCEEJf7WTSKOiPi06byWsvtIyMeWQ2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMFeoGyhu2tktGOB82eElFljCDO0Dn0QsUq9zJ44hD6Q&oe=6B0C730F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1366110197058613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245819_1366110200391946_3816135240634360029_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAz-nZVVlTsQ7kNvwGynXLA&_nc_oc=AdoksOAwTlDjKb1BAevShPts_in2iM8y8yhHa9a5A7WBHkol5EpWUpLZdxK0MKccWOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRD3ElBxRlYbRhVkoR_bhKk75ZKq2U700R2sc0IGrHi9A&oe=6B0C59D2"}, "display_name": "Forest Farm Demo", "keywords": [], "long_description": "Forest Farm is a farming game that seeks to be different.\n\nThe farming mechanics are based on regenerative agriculture and will encourage players to manage their farm intelligently.\n\nCut down all the trees? Now you'll have to regrow them. Need more vegetable plots? Then get to making soil.\n\nGet ready to bring life to the Forest Farm and make it a thriving ecosystem.\n\nEvery plant in the game can be grown from seed, harvested and even replanted.\n\nEvery plot can be moved to your desired location and this is saved automatically.\n\nThere will be multiple activities to master, from growing vegetables, to logging and clearing the forest, to fishing at the river.\n\nEach of these will mimic the activities on an actual Forest Farm and I hope it is something different for the gaming community", "short_description": "A relaxing farming sim, the demo of Forest Farm. Learn to manage your land and grow all plants from seed to harvest, including trees!"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "http://tonicgamesaustralia.com/ForestFarmDemo-privacypolicy.html", "developer_terms_of_service_url": "http://tonicgamesaustralia.com/ForestFarmDemo-termsandconditions.html", "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234608008761385"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "209569627613886"}]}, "baseline_offer": {"id": "209569627613886"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1616514480, "status": "PUBLISHED", "id": "209569627613886"}]}, "liveChannel": {"no
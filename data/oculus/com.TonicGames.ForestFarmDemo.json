2", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031340_328852918513895_7800079431753640225_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbvzgUBPXy8Q7kNvwEhObaA&_nc_oc=AdosUTbIMHGIa_FHzTSRareSreh06Ho-Z4P0hXWd_rlsrJ5XhZoG38fOlQMTpMAwgF8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLwTkGF1Hsc4BJu3N78tC1mOvcBlK4sJhZdV9Kc450Kg&oe=6AFB1BE2"}, {"file_name": "Screenshot2.png", "id": "849111222610585", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031561_849111225943918_4380788916088467491_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDBG2_O8jFAQ7kNvwFOcxq1&_nc_oc=Adq9uy_BDXSyulDhDl-T3MFT0mL-QI7uzX3ZlI0w-g3mdPCVBPzdXhJ8gEfcSpingsw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfapASW_CaLX_5NKHS_EOiAt_u3t6eHBypAahsoUoJlA&oe=6AFB174F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1366110197058613", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245819_1366110200391946_3816135240634360029_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-15DKqKEwEQ7kNvwH_6rUn&_nc_oc=AdpMktMXiaiOzmZGQs7I1Gkzjhqt8xnnz72XEoenOAANhoSFE6yJKgqom-p-2RYmHzI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfsHN0gtASWxLV9mOPaGmEnuVMbPcr5Gdc6i2ZOtlvdA&oe=6AFB3652"}, "display_name": "Forest Farm Demo", "keywords": [], "long_description": "Forest Farm is a farming game that seeks to be different.\n\nThe farming mechanics are based on regenerative agriculture and will encourage players to manage their farm intelligently.\n\nCut down all the trees? Now you'll have to regrow them. Need more vegetable plots? Then get to making soil.\n\nGet ready to bring life to the Forest Farm and make it a thriving ecosystem.\n\nEvery plant in the game can be grown from seed, harvested and even replanted.\n\nEvery plot can be moved to your desired location and this is saved automatically.\n\nThere will be multiple activities to master, from growing vegetables, to logging and clearing the forest, to fishing at the river.\n\nEach of these will mimic the activities on an actual Forest Farm and I hope it is something different for the gaming community", "short_description": "A relaxing farming sim, the demo of Forest Farm. Learn to manage your land and grow all plants from seed to harvest, including trees!"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "http://tonicgamesaustralia.com/ForestFarmDemo-privacypolicy.html", "developer_terms_of_service_url": "http://tonicgamesaustralia.com/ForestFarmDemo-termsandconditions.html", "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234608008761385"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "209569627613886"}]}, "baseline_offer": {"id": "209569627613886"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1616514480, "status": "PUBLISHED", "id": "209569627613886"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2530636156567
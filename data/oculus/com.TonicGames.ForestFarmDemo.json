=1-7&_nc_sid=6e7a0a&_nc_ohc=BvVyRP8cCXYQ7kNvwERnhYO&_nc_oc=AdlfRySIVbFzBMERZCipDeZ0GOllc5eoHx9ASS_Jo6epERP4h3sHk2ChMlZe138qhpg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu8qq1yoMpj_wHc-LckQKfo2DRYANocl9f-7Y_C4M1gNA&oe=69A18780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusVideoCover.png", "id": "1122483805141916", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974920_1122483808475249_4313784318389251081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtwm6oUZ4z0Q7kNvwF68F4u&_nc_oc=AdnuByG7xeUwmJ1E-BT-a6GrhV2F3Ub6TqVeWtP8GSKkkzfr_98nhFOgwMFJi0ESasA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfupbRqZX6MZSTNt9x-xkCBYZM4dDCOPpO-6rLEBDQv89Q&oe=69A19000"}, "display_name": "Forest Farm Demo", "keywords": [], "long_description": "Open World Farming Sandbox\nWork your overgrown forest into a thriving farm! Clear the forests, grow crops, keep animals, craft fences and more! Turn a wild landscape into your dream farmstead.\n\nDemo Features:\n9 plants, vegetables and fruit to grow\n3 Layers - trees, bushes and root vegetables\nCustomised garden layouts - dig your plots in your own grid design\nLocomotion Options - smooth locomotion, snap turning and teleport locomotion options\nTree logging - clear forests with your axe and recycle lumber into soil\nCrafting Fences and more - to protect your crops and decorate your farm\nAnimals - feed, pet, and fence in rabbits\nSearch the land - Forage, fish or break stones in search of raw ingredients\nDay/Night cycle - Controlling the weather and making your farm scenic", "short_description": "This is the Demo of Forest Farm: a peaceful open world fantasy farming sandbox with RPG elements. The forests are overgrown, the gardens have been abandoned, can you bring life back to the farm? Grab your tools, grow some produce and create your dream farm to aid the local citadel which is growing hungry!"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "http://tonicgamesaustralia.com/ForestFarmDemo-privacypolicy.html", "developer_terms_of_service_url": "http://tonicgamesaustralia.com/ForestFarmDemo-termsandconditions.html", "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1796320834043440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974673_440921714768942_367622162713879160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGA6pvITo8gQ7kNvwGhxn4f&_nc_oc=AdkfmQWhwboIskT0V6tvj6Ivb9ejErDIvANPdeaQUprLvz2v8tmNfdN8uRNIYsFSeao&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftxIdA0cDsVurViIhJxt_-c4i_OSll-Jc10P3ah7b7XSw&oe=69A1A035"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Forest Farm Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Role Playing", "id": "821934236779161"}], "release_date": 1621388164, "lastRevision": {"nodes": [{"id": "452467702558601", "release_type": "SCHEDULE
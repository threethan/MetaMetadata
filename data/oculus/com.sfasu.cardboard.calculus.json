f969Z6SBAQ7kNvwFQZvlj&_nc_oc=AdpeEsqPNpIPVhzisLBZfzYZkk0l-B7I8uGvQWUDwIAj_0Oun6RKQ6OPAZnDBtGczag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3buDsaJEQfXQwxmFsMaFmezWURF_0SJKQ8xtbuSxrn6Q&oe=69D24F1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Lk1o8oRcUQ7kNvwFFLxmK&_nc_oc=Adq9LXMva46kuIFv9JZxqgTIhpsSc8YIe0kIVExgImi9IEArbHjeOeHQAZlduhv5FRw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wX3XOGW6U-0CSaB_oUr_LPBprD67pws88-7nzPy8i1w&oe=69D25751"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moNU8lP3vG0Q7kNvwEXlL5i&_nc_oc=Adoc22kCkZGkLeWVLb0GC902RxYuwgpSol_bwTnbl3zvfSCpwV7OCUl8Hxuq3tYLW4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Iyoj1jb55g5ilI0axUOgMpdJxfNlNxtn09fyhkS1PaA&oe=69D26571"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9TKJp2VO44Q7kNvwGuy1nG&_nc_oc=Ado4GpVxi4-z-0V5wrY6qMC52rBqyyKSx4lopCSCB0SC5UTArBYaKg_Tk7vOCi66LVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f8J2e_2P17FDaX7Ky4CK5_sjC98NkScp-vJK0AlhkCA&oe=69D2698C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-9z94E6eZsQ7kNvwFa5Sxe&_nc_oc=AdrXwTUWkOBORCySf1lOKcHXKKre42iq-FZCF4OAgjlRVkgkQMN9pg5ML60_NmbLSV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3834pI8srJGNnWp7IamRb3tVzCbpRfDdIsL6RcohCNrg&oe=69D25E6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
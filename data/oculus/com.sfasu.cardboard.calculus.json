6RVOp4z1YQ7kNvwFjM5Gd&_nc_oc=AdoK9Z1NQ8UI49fKvHeuSFKbWpk-ROY0vQstTACrjQHyxIGJ0Pt9pVNV2AC-w5QwsOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI5Um6V_VBoN_OxfzbgwUwhT15NFYcfD0EdgaAXEo7JA&oe=6AEA055F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRmyMF_Atv8Q7kNvwEPLUGA&_nc_oc=AdqLkBeImst3HG2kMJVKanKQAkFMEujMBMCeBkAX4XIeoMrKyaz7OiX3kCH702A8i8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTD2DnLw4IjGzfCtQcGNCb2i24sqHZvq5CVfokI_zuQA&oe=6AEA0D91"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrsuAHVPQoUQ7kNvwGMQkdh&_nc_oc=AdpJevG0jRlju3mRF3ZXqfDhs9uG4wlB2_wVMfu7eXLjtvH6Dhj34yLFLm2_iPa-blY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbb_gtFY8UYigbxdYXyosvtmAC9miT32E9JhT-PpYlXw&oe=6AE9E371"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paa5oSnY5BUQ7kNvwF14b_l&_nc_oc=AdoHXtMnQj_00MGfEDceFRhU64CacYGmB1W2hpFsN41Rkktg-pzVt9Ud42V8BljKdO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqoZ8R1DzXU7Yj6dDwqyz1QCpN8xHLVOm0nswucMVxPw&oe=6AE9E78C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOAq9X3T2BwQ7kNvwE1C2dV&_nc_oc=AdoJ8mMz892rYXcsmHjtP16MMfuOSd8CsbL7oT5gpg08hDX3tlXvZ2fCnV1X_nrRNHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQGlGku6qj7mx7tU5SGKYyK0IVkGIaZPNAvAkFlEJyZw&oe=6AEA14AB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
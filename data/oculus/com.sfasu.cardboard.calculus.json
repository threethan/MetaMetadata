wd5P4lX9IQ7kNvwHn4Vs_&_nc_oc=AdoI7pFZ-Yw1ihBNCC6dqVWE4Rd0QH0Pa7aW0vjTH_r6e2h2jlIVPDQ4VqOe5fwAso8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAc-L9Vaqba4pg_cG5RmwitrInejNZBuE-5VXmZFj-HQ&oe=6ADF795F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2OpIoW4vg4Q7kNvwHb1MgQ&_nc_oc=AdqBcRkShfBDWT8hnPVlqq7si_69cCMaaduubsqkh5ztKqaP9saDUJ-RuMOZt8GyogU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLR24ebbGyPUiUk2o6FuiW7arZG5xA49SSJeTCsRNi6w&oe=6ADF4951"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDRnYOW43F8Q7kNvwGlOQyu&_nc_oc=AdqpmuYOtLEizaZFbNjip0X6J__cyghI5MbiHVweByavPWYTVuvI9D4w9XbKANVi57M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbOPF6ILRIbCgsQbZywZiDNuaP7mo1uGPGB_Q6Mk_d-g&oe=6ADF5771"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsfqZTdYK7sQ7kNvwFMROS8&_nc_oc=AdoeyRyIu8aM6BW0F2hfUBNstwZ9oXh7OHyqG5mCBbvf0hNEv-nwc1yJwfjcs5u00cQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxsKNsN17F6FzkaDdi68VF6G4g5a-3pzPf3Z79yzRrpA&oe=6ADF5B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAxi_V9LmDMQ7kNvwF4aT14&_nc_oc=AdoKHn5OId1JtaW7nqxSQ9bl1_hjVwcHdvymw81pl6-GufGPuPaTdBbVlJsIMJ5iZx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW-gXgxBeRlGBA9ckGvO6KfpTEm6khwaTGdBg5CIbDSA&oe=6ADF506B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
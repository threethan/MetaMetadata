wgjS6bd-4Q7kNvwHaHgK7&_nc_oc=AdqumnGaMpbhYmOBHO2NwzfYidFjWHejb_YxmA2eRn5ZAUhUwMRTjf5f0_gzHkPPk7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrG9TrP3m71H1YNtd4zz5A1aPuDcIPg5FdQ9nvDIQ6TQ&oe=6A5F5F9F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXAY4az3bwAQ7kNvwFlP7jV&_nc_oc=Adqa0Tq3ZtVDESd9o7C37Vv8W_wBk-O0D5F3uTKwA3xxH5TZ0SscTI65_JuucPZ4BgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvLRXLHcik3xP-mO5HMMVOJwxxUMfH22RwydR8Fc83Dw&oe=6A5F67D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D57io6cQ4-MQ7kNvwHXUx4b&_nc_oc=AdoRxVPH92KUOJqOgmpjZT9VtMhz3mzYNut_Cu2mEGaOWHol08dBnqIRZ-egfA7xMjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfItOQ7AVPY2J6JA5gVH-k_Gd4W5694Acx5yE2G5-1gg&oe=6A5F75F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3czfCq_jyvoQ7kNvwGrJyU2&_nc_oc=Adr6jNSeacyfDoy6OdMNiePabolbMYH-4w9WEuLFf1ZB6lF_xrmkdIGUrhFP17G5faQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCbRqsXtj3cHSL-F6zCK962KDuZlsTHjp0Qp6lwFYnow&oe=6A5F7A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPcxA24wnK4Q7kNvwHjRFJ-&_nc_oc=AdrL4fPr8A-qC0MyWLvExHA1MH32uVjfEz_rUXUq7aewtaDYiggKS-haI-sLIKvlUmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW-SF4IKdy4ycvZXxWT1q25SXARGrAJipEHNHc1ofJEQ&oe=6A5F6EEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_